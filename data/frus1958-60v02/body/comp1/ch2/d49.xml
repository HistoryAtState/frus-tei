    <text>
        <body>
            <div xml:id="d49">

                <pb facs="0114" n="84" xml:id="pg84"/>

                <head>49. Telegram From the Department of State to the Mission at the United
                        Nations<anchor n="1" xml:id="d49-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1958-12-04T15:51:00-05:00"><hi rendition="#italic">December 4,
                                1958—3:51 p.m.</hi></date></dateline></opener>
                <p>Gadel 162. In view status Hungarian Credentials problem, USUN should urgently
                    seek postponement meeting Credentials Committee until after plenary
                    consideration Hungarian item.</p>
                <closer><signed><hi rendition="#bold">Herter</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d49-f1" n="1" type="source" xml:id="d49-f1-content">
                <p>Source: Department of State, Central Files, 320.11/12–458. Confidential. Drafted
                    by Buffum, cleared by Nunley and Bacon, and approved by Cargo who signed for
                    Herter.</p>
            </note>
        </listAnnotation>
    </standOff>
