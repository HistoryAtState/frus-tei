                <pb facs="0465" n="419" sameAs="frus:frus1981-88v41/pg419"/>

                <head>138. Minutes of a National Security Council Meeting<anchor n="1"
                        xml:id="d138-f1"/></head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            from="1982-01-21T15:30:00-05:00" to="1982-01-21T16:05:00-05:00">January
                            21, 1982, 3:30–4:05 p.m.</date></dateline>
                </opener>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>Law of the Sea</item>
                </list>
                <list subtype="participants" type="description">
                    <label>PARTICIPANTS</label>
                    <item>The President</item>
                    <item>The Vice President</item>
