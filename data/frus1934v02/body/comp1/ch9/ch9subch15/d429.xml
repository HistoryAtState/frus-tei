    <text>
        <body>
            <div xml:id="d429">

                <pb facs="0632" n="532" sameAs="frus:frus1934v02/pg532"/>

                <note rend="inline" type="source">811.00 Nazi/99</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the German Ambassador</hi> (<hi rendition="#italic"
                            >Luther</hi>)</head>
                <p>The Secretary of State presents his compliments to His Excellency the German
                    Ambassador and, with reference to the latter’s complaint regarding the seizure
                    by American customs officials of certain literature belonging to a German
                    assistant paymaster named Kiem of the Hamburg-American Line steamship <hi
                        rendition="#italic">New York</hi>, has the honor to inform him that inquiry
                    of the competent American authorities regarding this matter discloses that the
                    publications in question were seized as unmanifested merchandise under authority
                    of Section 584 of the United States Tariff Act of 1930.<anchor n="57"
                        xml:id="d429-f1"/> A transcript of Section 584 is enclosed for the Embassy’s
                        information.<anchor n="58" xml:id="d429-f2"/></p>
                <closer>
                    <dateline rendition="#float-left">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1934-04-05">April 5,
                            1934</date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
