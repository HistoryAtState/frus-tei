    <text>
        <body>
            <div xml:id="d121">

                <pb facs="0240" n="140" sameAs="frus:frus1934v02/pg140"/>

                <note rend="inline" type="source">711.60d2/13</note>
                <head><hi rendition="#italic">Memorandum by the Under Secretary of State</hi> (<hi
                        rendition="#italic">Phillips</hi>)<anchor n="16a" xml:id="d121-f1"/></head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1934-01-19">January 19, 1934</date>.</dateline>
                </opener>
                <p>The President authorized me today to go ahead with the proposed Treaty of
                    Friendship, Commerce, and Consular Rights with Finland. Please let me know when
                    the Treaty will be ready for signature.</p>
                <closer><signed>W[<hi rendition="#small-caps">illiam</hi>] P[<hi
                            rendition="#small-caps">hillips</hi>]</signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d121-f1" n="16a" type="source" xml:id="d121-f1-content">
                <p>Addressed to the Assistant Secretary of State (Sayre) and to the Chief of the
                    Division of Eastern European Affairs (Kelley).</p>
            </note>
        </listAnnotation>
    </standOff>
