    <text>
        <body>
            <div xml:id="d78-a1">

                <pb facs="0182" n="82" sameAs="frus:frus1934v02/pg82"/>

                <opener>
                    <seg rendition="#center">[Enclosure—Translation]</seg>
                </opener>
                <head><hi rendition="#italic">The Belgian Minister for Foreign Affairs</hi> (<hi
                        rendition="#italic">Jaspar</hi>) <hi rendition="#italic">to the American
                        Ambassador</hi> (<hi rendition="#italic">Morris</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Brussels</hi></placeName>, <date calendar="gregorian"
                            when="1934-11-12">November 12, 1934</date>.</dateline>
                </opener>
                <p>Mr. <hi rendition="#small-caps">Ambassador</hi>: I have the honor to transmit
                    herewith to Your Excellency a memorandum and three notes<anchor n="18"
                        xml:id="d78-f1"/> prepared by the Government of the King, in view of the
                    forthcoming tariff negotiations between the United States and Belgium.</p>
                <p>I avail myself [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Henri Jaspar</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d78-f1" n="18" xml:id="d78-f1-content">
                <p>The three notes, enclosures 2, 3, and 4, not printed.</p>
            </note>
        </listAnnotation>
    </standOff>
