            <div xml:id="d501">

                <pb facs="0683" n="583" sameAs="frus:frus1934v02/pg583"/>

                <note rend="inline" type="source">251.11 Insull, Samuel/612: Telegram</note>
                <head><hi rendition="#italic">The Third Secretary of Embassy in Turkey</hi> (<hi
                        rendition="#italic">Berry</hi>), <hi rendition="#italic">Temporarily in the
                        United States, to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Chicago, Illinois</hi></placeName>, <date calendar="gregorian"
                            when="1934-05-08">May 8, 1934</date>.<lb/>[Received 10:50
                        a.m.]</dateline>
                </opener>
                <p>Department’s May 3.<anchor n="50" xml:id="d501-f1"/> Delivered Mr. Samuel Insull
                    safely to the United States Marshal for the Northern District of Illinois at the
                    Federal Building in Chicago at 8:20 o’clock this morning.</p>
                <closer><signed><hi rendition="#small-caps">Berry</hi></signed></closer>
            </div>
        </body>
