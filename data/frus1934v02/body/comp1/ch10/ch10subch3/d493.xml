                <pb facs="0679" n="579" sameAs="frus:frus1934v02/pg579"/>

                <note rend="inline" type="source">251.11 Insull, Samuel/470: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Turkey</hi> (<hi rendition="#italic">Skinner</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Ankara</hi></placeName>, <date calendar="gregorian"
                            when="1934-04-02T17:00:00+02:00">April 2, 1934—5
                        p.m.</date><lb/>[Received April 2—1 p.m.]</dateline>
                </opener>
                <p>28. I am informed by the Government that extradition of Samuel Insull is granted
                    and he is now detained at my disposition. Please cable instructions respecting
                    his return to the United States and payment incidental expenses.</p>
                <closer><signed><hi rendition="#small-caps">Skinner</hi></signed></closer>
            </div>
        </body>
