    <text>
        <body>
            <div xml:id="d440">

                <pb facs="0640" n="540" sameAs="frus:frus1934v02/pg540"/>

                <note rend="inline" type="source">868.51 War Credits/672</note>
                <head><hi rendition="#italic">The Secretary of State to the Greek Minister</hi> (<hi
                        rendition="#italic">Simopoulos</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1934-06-30">June 30, 1934</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I am requested by the Secretary of the
                    Treasury to transmit to you a statement of the amounts due and payable from your
                    Government January 1, 1933, July 1, 1933, January 1, 1934, and July 1, 1934,
                    pursuant to the terms of Part I of the Debt Agreement of May 10, 1929, and Part
                    I of the Moratorium Agreement of May 24, 1932.</p>
                <p rendition="#center"><hi rendition="#small-caps">Statement of Amounts Due From the
                        Government of Greece—January</hi> 1, 1933; <hi rendition="#small-caps"
                        >July</hi> 1, 1933; <hi rendition="#small-caps">January</hi> 1, 1934 <hi
                        rendition="#small-caps">and July</hi> 1, 1934.</p>
                <p rendition="#flush"><hi rendition="#italic">Amount due January 1, 1933:</hi></p>
                <table cols="2" rows="1">
                    <row>
                        <cell rendition="#hanging-indent">Semi-annual interest due January 1, 1933,
                            on principal of bond No. 9 for $130,000 due July 1, 1932, and postponed
                            under Paragraph 2, Part I, of the debt-funding agreement of May 10,
                            1929</cell>
                        <cell rendition="#bottom" role="num">$2,762.50</cell>
                    </row>
                </table>
                <pb facs="0641" n="541" xml:id="pg541"/>
                <p rendition="#flush"><hi rendition="#italic">Amount due July 1, 1933:</hi></p>
                <table cols="2" rows="4">
                    <row role="label">
                        <cell rendition="#hanging-indent">Semi-annual interest for the period
                            January 1 to July 1, 1933, on bond No. 9</cell>
                        <cell rendition="#bottom" role="num">$2,762.50</cell>
                    </row>
                    <row>
                        <cell rendition="#hanging-indent">Semi-annual interest due July 1, 1933, on
                            principal of bond No. 10 for $130,000 due January 1, 1933, and postponed
                            under Paragraph 2, Part I, of the debtfunding agreement of May 10,
                            1929</cell>
                        <cell rendition="#bottom" role="num">$2,762.50</cell>
                    </row>
                    <row>
                        <cell rendition="#hanging-indent">Semi-annual interest due July 1, 1933,
                            under Paragraph I (<hi rendition="#italic">a</hi>) of the Moratorium
                            Agreement of May 24, 1932, as authorized by the Joint Resolution of the
                            Congress of the United States approved December 23, 1931</cell>
                        <cell rendition="#bottom #border-bottom" role="num">$13,169.45</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell role="num">$18,694.45</cell>
                    </row>
                </table>
                <p rendition="#flush"><hi rendition="#italic">Amount due January 1, 1934:</hi></p>
                <table cols="2" rows="5">
                    <row role="label">
                        <cell rendition="#hanging-indent">Semi-annual interest for the period July
                            1, 1933 to January 1, 1934 on bond No. 9</cell>
                        <cell rendition="#bottom" role="num">$7,762.50</cell>
                    </row>
                    <row>
                        <cell rendition="#hanging-indent">Semi-annual interest for the period July
                            1, 1933 to January 1, 1934 on bond No. 10</cell>
                        <cell rendition="#bottom" role="num">2,762.50</cell>
                    </row>
                    <row>
                        <cell rendition="#hanging-indent">Semi-annual interest due January 1, 1934
                            on principal of bond No. 11 for $150,000 due July 1, 1933, and postponed
                            under Paragraph 2, Part I, of the debt-funding agreement of May 10,
                            1929</cell>
                        <cell rendition="#bottom" role="num">3,187.50</cell>
                    </row>
                    <row>
                        <cell rendition="#hanging-indent">Semi-annual instalment due January 1, 1934
                            under the Moratorium Agreement of May 24, 1932</cell>
                        <cell rendition="#bottom #border-bottom" role="num">13,169.45</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell role="num">$21,881.95</cell>
                    </row>
                </table>
                <p rendition="#flush"><hi rendition="#italic">Amount payable July 1, 1934:</hi></p>
                <table cols="3" rows="6">
                    <row role="label">
                        <cell rendition="#hanging-indent">Semi-annual interest for the period
                            January 1 to July 1, 1934, on bond No. 9</cell>
                        <cell rendition="#bottom" role="num">$2,762.50</cell>
                    </row>
                    <row>
                        <cell rendition="#hanging-indent">Semi-annual interest for the period
                            January 1 to July 1, 1934, on bond No. 10</cell>
                        <cell rendition="#bottom" role="num">2,762.50</cell>
                    </row>
                    <row>
                        <cell rendition="#hanging-indent">Semi-annual interest for the period
                            January 1 to July 1, 1934, on bond No. 11</cell>
                        <cell rendition="#bottom" role="num">3,187.50</cell>
                    </row>
                    <row>
                        <cell rendition="#hanging-indent">Semi-annual interest due July 1, 1934, on
                            principal of bond No. 12 for $150,000 due January 1, 1934, and postponed
                            under Paragraph 2, Part I, of the debt-funding agreement of May 10,
                            1929</cell>
                        <cell rendition="#bottom" role="num">3,187.50</cell>
                    </row>
                    <row>
                        <cell rendition="#hanging-indent">Semi-annual instalment due July 1, 1934,
                            under the Moratorium Agreement of May 24, 1932</cell>
                        <cell rendition="#bottom #border-bottom" role="num">13,169.45</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell rendition="#bottom" role="num">$25,069.45</cell>
                    </row>
                </table>
                <p>Accept [etc.]</p>
                <closer>For the Secretary of State:<lb/><signed>R. <hi rendition="#small-caps"
                            >Walton Moore</hi></signed></closer>
            </div>
        </body>
    </text>
