    <text>
        <body>
            <div xml:id="d439">

                <pb facs="0639" n="539" sameAs="frus:frus1934v02/pg539"/>

                <note rend="inline" type="source">868.51 War Credits/664</note>
                <head><hi rendition="#italic">The Secretary of State to the Greek Minister</hi> (<hi
                        rendition="#italic">Simopoulos</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1934-04-24">April 24, 1934</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I am requested by the Secretary of the
                    Treasury to transmit to you the following statement of the amount due from your
                    Government on May 10, 1934, under Part II of the Debt Funding Agreement of May
                    10, 1929, in respect of its indebtedness to the United States, and to request
                    payment thereof, either at the Treasury in Washington or at the Federal Reserve
                    Bank of New York:</p>
                <p rendition="#center"><hi rendition="#small-caps">Statement of Amount Due and
                        Payable May</hi> 10, 1934 <hi rendition="#small-caps">From the Government of
                        Greece</hi></p>
                <p rendition="#flush"><hi rendition="#italic">Amount due Nov. 10, 1932:</hi></p>
                <table cols="3" rows="5">
                    <row>
                        <cell rend="padding-left: 1.5em;">Principal of Bond No. 7</cell>
                        <cell role="num">$227,000.00</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell rend="padding-left: 1.5em;">Semi-annual interest due on Bonds Nos. 7
                            to 40</cell>
                        <cell rendition="#border-bottom" role="num">217,920.00</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell rend="padding-left: 4.5em;">Total due Nov. 10, 1932</cell>
                        <cell/>
                        <cell role="num">$444,920.00</cell>
                    </row>
                    <row>
                        <cell rend="padding-left: 3em;">Less 30% of the semi-annual interest
                            received Jan. 7, 1933</cell>
                        <cell/>
                        <cell rendition="#border-bottom" role="num">65,376.00</cell>
                    </row>
                    <row>
                        <cell rend="padding-left: 6em;">Net amount due Nov. 10, 1932</cell>
                        <cell/>
                        <cell role="num">$379,544.00</cell>
                    </row>
                </table>
                <pb facs="0640" n="540" xml:id="pg540"/>
                <p rendition="#flush"><hi rendition="#italic">Amount due May 10, 1933:</hi></p>
                <table cols="3" rows="3">
                    <row>
                        <cell rend="padding-left: 1.5em;">Principal of Bond No. 8</cell>
                        <cell role="num">$231,000.00</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell rend="padding-left: 1.5em;">Semi-annual interest due on Bonds Nos. 7
                            to 40</cell>
                        <cell rendition="#border-bottom" role="num">217,920.00</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell rend="padding-left: 3em;">Total due May 10, 1933</cell>
                        <cell/>
                        <cell role="num">$448,920.00</cell>
                    </row>
                </table>
                <p rendition="#flush"><hi rendition="#italic">Amount due Nov. 10, 1933:</hi></p>
                <table cols="3" rows="4">
                    <row>
                        <cell rend="padding-left: 1.5em;">Principal of Bond No. 9</cell>
                        <cell role="num">$236,000.00</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell rend="padding-left: 1.5em;">Semi-annual interest due on Bonds Nos. 7
                            to 40</cell>
                        <cell role="num">217,920.00</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell rend="padding-left: 1.5em;">Semi-annual installment due Nov. 10, 1933
                            under paragraph I (<hi rendition="#italic">b</hi>) of the Moratorium
                            Agreement of May 24, 1932,<anchor n="8" xml:id="d439-f1"/> as authorized
                            by the Joint Resolution of the Congress of the United States, approved
                            December 23, 1931</cell>
                        <cell rendition="#border-bottom" role="num">53,967.93</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell rend="padding-left: 3em;">Total due November 10, 1933</cell>
                        <cell/>
                        <cell role="num">507,887.93</cell>
                    </row>
                </table>
                <p rendition="#flush"><hi rendition="#italic">Amount due May 10, 1934:</hi></p>
                <table cols="3" rows="5">
                    <row>
                        <cell rend="padding-left: 1.5em;">Principal of Bond No. 10</cell>
                        <cell role="num">$240,000.00</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell rend="padding-left: 1.5em;">Semi-annual interest due on Bonds Nos. 7
                            to 40</cell>
                        <cell role="num">217,920.00</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell rend="padding-left: 1.5em;">Semi-annual installment due May 10, 1934
                            under Moratorium Agreement May 24, 1932</cell>
                        <cell rendition="#border-bottom" role="num">53,967.93</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell rend="padding-left: 3em;">Total due May 10, 1934</cell>
                        <cell/>
                        <cell rendition="#border-bottom" role="num">511,887.93</cell>
                    </row>
                    <row>
                        <cell rend="padding-left: 4.5em;">Total amount due and payable May 10,
                            1934.</cell>
                        <cell/>
                        <cell role="num">$1,848,239.86</cell>
                    </row>
                </table>
                <p>Accept [etc.]</p>
                <closer>For the Secretary of State:<lb/><signed><hi rendition="#small-caps">William
                            Phillips</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d439-f1" n="8" xml:id="d439-f1-content">
