    <text>
        <body>
            <div xml:id="d437">

                <pb facs="0638" n="538" sameAs="frus:frus1934v02/pg538"/>

                <note rend="inline" type="source">868.51 War Credits/660</note>
                <head><hi rendition="#italic">The Greek Minister</hi> (<hi rendition="#italic"
                        >Simopoulos</hi>) <hi rendition="#italic">to the Secretary of the
                        Treasury</hi> (<hi rendition="#italic">Morgenthau</hi>)<anchor n="7"
                        xml:id="d437-f1"/></head>
                <opener>
                    <seg rendition="#float-left">No. 995</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1934-03-29">March 29, 1934</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Excellency</hi>: Under instructions from my
                    Government, I have the honor to advise the United States Government that, on
                    account of present difficulties, the Greek Government is compelled to postpone,
                    in accordance with the option granted under Clause 2 of Part 1. of the Debt and
                    Funding Agreement of May 10, 1929, between the United States and the Government
                    of Greece, the payment of Bond No. 13, <pb facs="0639" n="539" xml:id="pg539"/>
                    dated January 1, 1928, and maturing July 1, 1934, in the amount of $150,000.00
                    on account of the funding indebtedness of the Government of Greece to the United
                    States as specified in Part 1. of such agreement.</p>
                <p>Accept [etc.]</p>
                <closer><signed>C. <hi rendition="#small-caps">Simopoulos</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d437-f1" n="7" type="source" xml:id="d437-f1-content">
                <p>Handed to the Chief of the Division of Near Eastern Affairs, Department of State,
                    by the First Secretary of the Greek Legation, March 29, 1934.</p>
            </note>
        </listAnnotation>
    </standOff>
