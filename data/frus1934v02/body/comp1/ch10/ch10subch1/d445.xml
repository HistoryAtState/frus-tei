    <text>
        <body>
            <div xml:id="d445">

                <pb facs="0644" n="544" sameAs="frus:frus1934v02/pg544"/>

                <note rend="inline" type="source">868.51 War Credits/678</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Greek
                        Minister</hi> (<hi rendition="#italic">Simopoulos</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1934-11-08">November 8, 1934</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I am requested by the Secretary of the
                    Treasury to transmit to you the attached statement showing the amounts due and
                    payable on November 10, 1932, May 10, 1933, November 10, 1933, May 10, 1934, and
                    November 10, 1934, from the Government of Greece pursuant to the terms of Part
                    II of the Debt Agreement of May 10, 1929, and the Moratorium Agreement of May
                    24, 1932.</p>
                <p>Accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps">William Phillips</hi></signed></closer>


                <xi:include href="d445-a1.xml" xpointer="d445-a1"/>
            </div>
