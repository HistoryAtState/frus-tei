            <div xml:id="d452">

                <pb facs="0651" n="551" sameAs="frus:frus1934v02/pg551"/>

                <note rend="inline" type="source">611.6831/139</note>
                <head><hi rendition="#italic">The Minister in Greece</hi> (<hi rendition="#italic"
                        >MacVeagh</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 260</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Athens</hi></placeName>, <date calendar="gregorian"
                            when="1934-05-26">May 26, 1934</date>.<lb/>[Received June
                        28.]</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: In reference to my despatch No. 209 of
                    April 4 and the Department’s instruction No. 82 of May 1, 1934, I have the honor
                    to enclose, as of possible interest’ a copy of a letter I have handed to the
                    Foreign Minister setting forth the effects of the present Barter Policy of the
                    Greek Government on American trade.</p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">Lincoln MacVeagh</hi></signed></closer>


                <xi:include href="d452-a1.xml" xpointer="d452-a1"/>
