    <text>
        <body>
            <div xml:id="d16">

                <pb facs="0113" n="13" sameAs="frus:frus1934v02/pg13"/>

                <note rend="inline" type="source">863.00/862a: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Chargé in Great Britain</hi> (<hi
                            rendition="#italic">Atherton</hi>)<anchor n="11"
                        xml:id="d16-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1934-02-14T17:00:00-05:00">February 14, 1934—5
                        p.m.</date></dateline>
                </opener>
                <p>Please telegraph a brief analysis of reaction in Great Britain to recent
                    developments in the Austrian situation.</p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d16-f1" n="11" type="source" xml:id="d16-f1-content">
                <p>The same telegram was sent, <hi rendition="#italic">mutatis mutandis</hi>, on
                    February 14, 5 p.m., to the Ambassadors in France and Italy.</p>
            </note>
        </listAnnotation>
    </standOff>
