    <text>
        <body>
            <div xml:id="d636">

                <pb facs="0847" n="747" sameAs="frus:frus1934v02/pg747"/>

                <note rend="inline" type="source">890H.001 Zahir/7</note>
                <head><hi rendition="#italic">The Afghan Minister in France</hi> (<hi rendition="#italic">Shah Wali</hi>) <hi
                        rendition="#italic">to the American Ambassador in France</hi> (<hi rendition="#italic">Straus</hi>)<anchor n="1"
                        xml:id="d636-f1"/></head>
                <opener>
                    <seg rendition="#center">[Translation]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1934-06-28">June 28, 1934</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Mr. Ambassador</hi>: By order of my Government, I
                    have the honor to transmit to you herewith an autograph letter of His Majesty
                    Mohammed Zahir Shah, King of Afghanistan, addressed to His Excellency <pb
                        facs="0848" n="748" xml:id="pg748"/> Mr. Franklin Roosevelt, President of
                    the Republic of the United States of America, informing him of the death of his
                    August Father as well as of his accession to the Afghan throne.</p>
                <p>I would be infinitely obliged if you would be kind enough to forward the letter
                    in question to its high destination.</p>
                <p>Please accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Shah Wali</hi></signed></closer>


                <xi:include href="d636-a1.xml" xpointer="d636-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d636-f1" n="1" type="source" xml:id="d636-f1-content">
                <p>Transmitted to the Department by the Chargé in France in his despatch No. 1019,
                    July 3; received July 12.</p>
            </note>
        </listAnnotation>
    </standOff>
