    <text>
        <body>
            <div xml:id="d667">

                <pb facs="0879" n="779" sameAs="frus:frus1934v02/pg779"/>

                <note rend="inline" type="source">484.11 Young, Reuben S., No. 2/16: Telegram</note>
                <head><hi rendition="#italic">The Minister in Ethiopia</hi> (<hi rendition="#italic">Southard</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">Addis
                                Ababa</hi></placeName>, <date calendar="gregorian"
                            when="1934-08-25T16:00:00+02:35">August 25, 1934—4
                        p.m.</date><lb/>[Received August 25—12:55 p.m.]</dateline>
                </opener>
                <p>11. Ethiopian Government offers 2000 Ethiopian dollars in full settlement Doctor
                    Young’s claim account of illegal arrest and will punish Bashawarad.<anchor
                        n="39" xml:id="d667-f1"/> This seems to me reasonable offer. Shall I
                    accept?</p>
                <closer><signed><hi rendition="#small-caps">Southard</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d667-f1" n="39" xml:id="d667-f1-content">
                <p>Ato Bashawarad Hapte Wolde, Director of the Municipality of Diré-Daoua.</p>
            </note>
        </listAnnotation>
    </standOff>
