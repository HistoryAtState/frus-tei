            <div xml:id="d6">

                <pb facs="0017" n="7" sameAs="frus:frus1944v02/pg7"/>

                <note rend="inline" type="source">840.50/3437: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in the United Kingdom</hi> (<hi
                            rendition="#italic">Winant</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-01-19T13:00:00-04:00">January 19, 1944—1
                            p.m.</date>
                    </dateline>
                </opener>
                <p>464. Embassy’s telegrams on Article VII talks background, your 56 of January 4
                    and 106 of January 5, very helpful. Please continue to supply as much
                    information of this nature as possible.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
