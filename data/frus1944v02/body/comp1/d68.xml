    <text>
        <body>
            <div xml:id="d68">

                <pb facs="0108" n="98" sameAs="frus:frus1944v02/pg98"/>

                <note rend="inline" type="source">840.50/11–1544: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Ambassador in the United Kingdom</hi> (<hi
                            rendition="#italic">Winant</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-11-24T23:00:00-04:00">November 24,
                            1944—11 p.m.</date>
                    </dateline>
                </opener>
                <p>9894. From Haley<anchor n="13" xml:id="d68-f1"/> to Hawkins. ReDeptel 9599
                    November 15.<anchor n="14" xml:id="d68-f2"/> In connection with consideration by
                    the Post-war Programs Committee of the multilateral and multilateral-bilateral
                    methods for implementing <pb facs="0109" n="99" xml:id="pg99"/> trade-barrier
                    reduction please report urgently anything you may have learned since your
                    arrival regarding recent British thinking on this question which would be of
                    value to the Committee. [Haley.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stettinius</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d68-f1" n="13" xml:id="d68-f1-content">
                <p>Bernard F. Haley, Director of the Office of Economic Affairs, and Vice Chairman
                    of the Executive Committee on Economic Foreign Policy.</p>
            </note>
            <note corresp="#d68-f2" n="14" xml:id="d68-f2-content">
                <p>Not printed.</p>
            </note>
