            <div xml:id="d706">

                <pb facs="0843" n="833" sameAs="frus:frus1944v02/pg833"/>

                <note rend="inline" type="source">840.70/10–2544: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Ambassador in the United Kingdom</hi> (<hi
                            rendition="#italic">Winant</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-10-25T00:00:00-04:00">October 25,
                            1944—midnight</date>.</dateline>
                </opener>
                <p>8904. For EITO Delegation from Berle. Embassy’s telegram 9167<anchor n="62"
                        xml:id="d706-f1"/> received late today. Please attempt avoid commitments on
                    controversial points until Department has an opportunity to study and comment on
                    your telegram and send you such instructions as are necessary. [Berle.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stettinius</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
