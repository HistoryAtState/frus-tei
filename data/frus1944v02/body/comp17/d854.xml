    <text>
        <body>
            <div xml:id="d854">

                <pb facs="1008" n="998" sameAs="frus:frus1944v02/pg998"/>

                <note rend="inline" type="source">561.35E1A/7–1844: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the United Kingdom</hi> (<hi
                        rendition="#italic">Winant</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1944-07-18">July 18,
                        1944</date>.<lb/>[Received July 18—5:30 p.m.]</dateline>
                </opener>
                <p>5683. From Delegate to Sugar Council. Chairman of Sugar Council anticipates need
                    to call meeting of Council at short notice and wishes to know whether United
                    States would agree to replace 3 weeks’ notice required under Article 36 of
                    Agreement by 1 week’s notice; also our Government’s attitude regarding renewal
                    of Agreement including arrangements for signature in London of the renewal
                    document. [Steere.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Winant</hi>
                    </signed>
                </closer>
            </div>
        </body>
