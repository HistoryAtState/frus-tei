            <div xml:id="d840">

                <pb facs="0996" n="986" sameAs="frus:frus1944v02/pg986"/>

                <note rend="inline" type="source">800.6176/11–2544: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in the United
                        Kingdom</hi> (<hi rendition="#italic">Winant</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-12-18T14:00:00-04:00">December 18,
                            1944—2 p.m.</date>
                    </dateline>
                </opener>
                <p>10522. For Bugbee from Haley. Embassy’s 10401 of November 25. Department has not
                    been approached by the French regarding admittance to Rubber Study Group.
                    Department is opposed at this time to such admittance. [Haley.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stettinius</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
