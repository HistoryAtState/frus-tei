    <text>
        <body>
            <div xml:id="d831">

                <pb facs="0990" n="980" sameAs="frus:frus1944v02/pg980"/>

                <note rend="inline" type="source">800.6176/9–2044: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in the United Kingdom</hi> (<hi
                            rendition="#italic">Winant</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-09-21T20:00:00-04:00">September 21,
                            1944—8 p.m.</date>
                    </dateline>
                </opener>
                <p>7704. For Bliss from Haley. Department agrees to press release changes suggested
                    in Embassy’s 7776 of September 20 including change in final paragraph. Release
                    to be issued here 7:30 p.m. Friday, September 22 (equivalent to your 00:30
                    Saturday, September 23).<anchor n="46" xml:id="d831-f1"/> British and Dutch
                    Embassies informed. [Haley.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d831-f1" n="46" xml:id="d831-f1-content">
                <p>For text of press release issued September 22, see Department of State <hi
                        rendition="#italic">Bulletin</hi>, September 24, 1944, p. 328.</p>
            </note>
        </listAnnotation>
    </standOff>
