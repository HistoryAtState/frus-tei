    <text>
        <body>
            <div xml:id="d380">

                <pb facs="0488" n="478" sameAs="frus:frus1944v02/pg478"/>

                <note rend="inline" type="source">800.796/5–1844</note>
                <head>
                    <hi rendition="#italic">The Assistant Secretary of State</hi> (<hi
                        rendition="#italic">Berle</hi>) <hi rendition="#italic">to the Counselor of
                        the British Embassy</hi> (<hi rendition="#italic">Wright</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-05-18">May 18, 1944</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Wright</hi>: Will you be good enough to
                    send the attached to Lord Beaverbrook in answer to his telegram of May 16?</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Adolf A. Berle, Jr.</hi>
                    </signed>
                </closer>


                <xi:include href="d380-a1.xml" xpointer="d380-a1"/>
