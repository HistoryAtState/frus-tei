    <text>
        <body>
            <div xml:id="d359">

                <pb facs="0470" n="460" sameAs="frus:frus1944v02/pg460"/>

                <note rend="inline" type="source">800.796/733: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the United Kingdom</hi> (<hi rendition="#italic">Winant</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1944-04-25T16:00:00+02:00">April 25, 1944—4
                            p.m.</date>
                        <lb/> [Received April 25—11:13 a.m.]</dateline>
                </opener>
                <p>3384. Masefield of Lord Beaverbrook’s office says that the British decision on
                    whether to discuss aviation matters informally with the Russians prior to a
                    general conference will depend on the result of the United States-Russian
                    talks.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Winant</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
