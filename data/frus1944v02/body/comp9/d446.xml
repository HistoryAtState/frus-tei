    <text>
        <body>
            <div xml:id="d446">

                <pb facs="0547" n="537" xml:id="pg537"/>

                <note rend="inline" type="source">800.796/9–644</note>
                <head>
                    <hi rendition="#italic">The Assistant Secretary of State</hi> (<hi
                        rendition="#italic">Berle</hi>) <hi rendition="#italic">to the Counselor of
                        the British Embassy</hi> (<hi rendition="#italic">Wright</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-09-09">September 9,
                        1944</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Wright</hi>: I should be obliged if you
                    would send the attached telegram to Lord Beaverbrook in answer to his messages
                    to me dated respectively, August 29 and September 1, 1944.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Adolf A. Berle, Jr</hi>.</signed>
                </closer>


                <xi:include href="d446-a1.xml" xpointer="d446-a1"/>
