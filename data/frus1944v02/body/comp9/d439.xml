    <text>
        <body>
            <div xml:id="d439">

                <pb facs="0539" n="529" sameAs="frus:frus1944v02/pg529"/>

                <note rend="inline" type="source">800.796/8–1644</note>
                <head>
                    <hi rendition="#italic">The First Secretary of the British Embassy</hi>
                        (<hi rendition="#italic">Gore-Booth</hi>)
                        <hi rendition="#italic">to the Chief of the Aviation Division</hi>
                        (<hi rendition="#italic">Morgan</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-08-16">August 16,
                        1944</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Stokeley</hi>: With reference to our telephone
                    conversation this afternoon I now have pleasure in sending you a paraphrase of
                    the Foreign Office telegram from London about the attitude of His Majesty’s
                    Government in the United Kingdom to the suggestion that <pb facs="0540" n="530"
                        xml:id="pg530"/> the United States Government should go ahead with bilateral
                    negotiations for landing rights for United States civil aircraft, along the
                    routes proposed by the Civil Aeronautics Board.</p>
                <p>Yours ever,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Paul Gore-Booth</hi>
                    </signed>
                </closer>


                <xi:include href="d439-a1.xml" xpointer="d439-a1"/>
            </div>
        </body>
    </text>
