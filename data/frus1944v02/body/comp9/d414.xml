    <text>
        <body>
            <div xml:id="d414">

                <pb facs="0517" n="507" sameAs="frus:frus1944v02/pg507"/>

                <note rend="inline" type="source">800.796/7–144</note>
                <head>
                    <hi rendition="#italic">The First Secretary of the British Embassy</hi>
                        (<hi rendition="#italic">Gore-Booth</hi>)
                        <hi rendition="#italic">to the Assistant Secretary of State</hi> (<hi rendition="#italic">Berle</hi>)</head>
                <opener>
                    <seg rendition="#float-left">Ref. 56/–/44</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-07-14">July 14, 1944</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Berle</hi>: In Mr. Wright’s absence I send
                    you herewith a message which we have received for you from Lord Beaverbrook
                    dated July 12th.</p>
                <p>Yours sincerely,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Paul H. Gore-Booth</hi>
                    </signed>
                </closer>


                <xi:include href="d414-a1.xml" xpointer="d414-a1"/>
