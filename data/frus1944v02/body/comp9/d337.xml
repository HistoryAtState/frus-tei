    <text>
        <body>
            <div xml:id="d337">

                <pb facs="0432" n="422" sameAs="frus:frus1944v02/pg422"/>

                <note rend="inline" type="source">800.796/656a</note>
                <head>
                    <hi rendition="#italic">The Assistant Secretary of State</hi> (<hi
                        rendition="#italic">Berle</hi>) <hi rendition="#italic">to the Canadian
                        Minister Counselor</hi> (<hi rendition="#italic">Pearson</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-03-24">March 24, 1944</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mike</hi>: Enclosed herewith is a summary of
                    the views of the technical group of this Government regarding post-war civil air
                    transport.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>A. A. <hi rendition="#small-caps">Berle, Jr.</hi>
                    </signed>
                </closer>


                <xi:include href="d337-a1.xml" xpointer="d337-a1"/>
