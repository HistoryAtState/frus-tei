    <text>
        <body>
            <div xml:id="d379">

                <pb facs="0486" n="476" sameAs="frus:frus1944v02/pg476"/>

                <note rend="inline" type="source">800.796/5–1844</note>
                <head>
                    <hi rendition="#italic">The Counselor of the British Embassy</hi> (<hi rendition="#italic">Wright</hi>) <hi
                        rendition="#italic">to the Assistant Secretary of State</hi> (<hi rendition="#italic">Berle</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-05-18">18 May, 1944</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Berle</hi>: I enclose herewith a copy of a
                    message just received from Lord Beaverbrook, in reply to your telegram of May
                        9th.<anchor n="14" xml:id="d379-f1"/>
                </p>
                <p>A copy of the despatch which appeared in the London <hi rendition="#italic"
                        >Times</hi> on May 16th [<hi rendition="#italic">15th</hi>], referred to in
                    the third paragraph of Lord Beaverbrook’s telegram, is also enclosed.<anchor
                        n="15" xml:id="d379-f2"/>
                </p>
                <p>Yours sincerely,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Michael Wright</hi>
                    </signed>
                </closer>



                <xi:include href="d379-a1.xml" xpointer="d379-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d379-f1" n="14" xml:id="d379-f1-content">
                <p>See letter of May 8 from Assistant Secretary Berle to the Counselor of the
                    British Embassy, <ref target="#pg470">p. 470</ref>.</p>
            </note>
            <note corresp="#d379-f2" n="15" xml:id="d379-f2-content">
                <p>Despatch not reprinted.</p>
            </note>
        </listAnnotation>
    </standOff>
