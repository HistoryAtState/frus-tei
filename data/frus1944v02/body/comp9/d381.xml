    <text>
        <body>
            <div xml:id="d381">

                <pb facs="0489" n="479" sameAs="frus:frus1944v02/pg479"/>

                <note rend="inline" type="source">800.796/5–2244</note>
                <head>
                    <hi rendition="#italic">The Counselor of the British Embassy</hi> (<hi rendition="#italic">Wright</hi>) <hi
                        rendition="#italic">to the Assistant Secretary of State</hi> (<hi rendition="#italic">Berle</hi>)</head>
                <opener>
                    <seg rendition="#float-left">Ref: 56//44</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-05-22">May 22, 1944</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Berle</hi>: I transmitted to Lord
                    Beaverbrook the message which you sent me with your letter of May 18th.</p>
                <p>I now enclose a message for you of May 21st from Lord Beaverbrook in reply.</p>
                <p>Yours sincerely,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Michael Wright</hi>
                    </signed>
                </closer>


                <xi:include href="d381-a1.xml" xpointer="d381-a1"/>
            </div>
        </body>
