            <div xml:id="d342">

                <pb facs="0439" n="429" sameAs="frus:frus1944v02/pg429"/>

                <note rend="inline" type="source">800.796/612: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in the United
                        Kingdom</hi> (<hi rendition="#italic">Winant</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-03-30T00:00:00-04:00">March 30,
                            1944—midnight</date>.</dateline>
                </opener>
                <p>2482. Department of Commerce has been consulted in connection with your telegram
                    2025 of March 13, 1944, 7 p.m., and indicates that it agrees such a meeting
                    would be desirable. It has no suggestions to make regarding agenda. Suggests
                    week of May 15 as tentative date of meeting. You are requested to inform
                    appropriate persons of the above.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
