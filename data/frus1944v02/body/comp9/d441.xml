    <text>
        <body>
            <div xml:id="d441">

                <pb facs="0542" n="532" sameAs="frus:frus1944v02/pg532"/>

                <note rend="inline" type="source">800.796/8–2944</note>
                <head>
                    <hi rendition="#italic">The Counselor of the British Embassy</hi> (<hi
                        rendition="#italic">Wright</hi>) <hi rendition="#italic">to the Assistant
                        Secretary of State</hi> (<hi rendition="#italic">Berle</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-08-29">August 29,
                        1944</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Berle</hi>: I send you herewith the text of
                    a message dated August 29th which we have received for you from Lord Beaverbrook
                    about Civil Aviation.</p>
                <p>Yours very sincerely,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Michael Wright</hi>
                    </signed>
                </closer>



                <xi:include href="d441-a1.xml" xpointer="d441-a1"/>
