    <text>
        <body>
            <div xml:id="d357">

                <pb facs="0470" n="460" xml:id="pg460"/>

                <note rend="inline" type="source">800.706/747: Airgram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the United Kingdom</hi> (<hi rendition="#italic">Winant</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1944-04-20">April 20,
                        1944</date>.<lb/>[Received April 29—3 p.m.]</dateline>
                </opener>
                <p>A–480. Reference Embassy’s 2025, March 13, 7 p.m. Jeffcock<anchor n="94"
                        xml:id="d357-f1"/> and Duncan<anchor n="95" xml:id="d357-f2"/> left last
                    night by sea for the United States for talks on aviation radio with members of
                    the Civil Aeronautics Administration. They expect to arrive in Washington about
                    May 1.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Winant</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d357-f1" n="94" xml:id="d357-f1-content">
                <p>Robin J. P. Jeffcock, an official of the British Ministry of Aircraft
                    Production.</p>
            </note>
            <note corresp="#d357-f2" n="95" xml:id="d357-f2-content">
                <p>William Aver Duncan, an official of the British Air Ministry.</p>
            </note>
        </listAnnotation>
    </standOff>
