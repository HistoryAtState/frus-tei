    <text>
        <body>
            <div xml:id="d12-a1">

                <pb facs="0075" n="40" sameAs="frus:frus1977-80v17p1/pg40"/>


                <head>
                    <hi rendition="#bold">Note From President Carter to Secretary of State Vance,
                        Secretary of Defense Brown, and the President’s Assistant for National
                        Security Affairs (Brzezinski)</hi><anchor n="3" xml:id="d12-f1"/>
                </head>
                <opener><dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            when="1977-04-19">April 19, 1977</date>
                    </dateline></opener>
                <p>To Cy &amp; Zbig &amp; Harold </p>
                <p>If Ethiopia acts as projected [<hi rendition="#italic">less than 1 line not
                        declassified</hi>], we should immediately terminate shipment of all arms—but
                    let them know now.</p>
                <p>See me re this if necessary—</p>
                <closer>
                    <signed><hi rendition="#bold">J.C.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d12-f1" n="3" type="source" xml:id="d12-f1-content">
                <p>Secret. The note is handwritten.</p>
            </note>
        </listAnnotation>
    </standOff>
