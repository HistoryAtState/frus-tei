                <pb facs="0099" n="64" xml:id="pg64"/>

                <head>27. Summary of Conclusions of a Policy Review Committee Meeting<anchor n="1"
                        xml:id="d27-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            from="1977-08-25T10:00:00-04:00" to="1977-08-25T11:00:00-04:00">August
                            25, 1977, 10–11 a.m.</date></dateline>
                </opener>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>Horn of Africa</item>
                </list>
                <list subtype="participants" type="description">
                    <label>PARTICIPANTS</label>
