    <text>
        <body>
            <div xml:id="d343">

                <pb facs="0412" n="319" xml:id="pg319"/>

                <note rend="inline" type="source">611.3231/1088: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Brazil</hi> (<hi rendition="#italic">Gibson</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">Rio de
                                Janeiro</hi></placeName>, <date calendar="gregorian"
                            when="1935-12-02T15:00:00-03:00">December 2, 1935—3
                        p.m.</date><lb/>[Received 3:35 p.m.]</dateline>
                </opener>
                <p>332. My 323, November 29, 5 p.m. Ratification exchanged this afternoon as
                    planned. Brazilian ratification dated November 30.<anchor n="22"
                        xml:id="d343-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Gibson</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d343-f1" n="22" xml:id="d343-f1-content">
                <p>This agreement was proclaimed by the President of the United States December 2,
                    1935, effective January 1, 1936.</p>
            </note>
        </listAnnotation>
    </standOff>
