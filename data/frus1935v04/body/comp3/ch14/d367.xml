        <body>
            <div xml:id="d367">

                <pb facs="0435" n="342" xml:id="pg342"/>

                <note rend="inline" type="source">611.3231/779a: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Chargé in Brazil</hi> (<hi rendition="#italic"
                            >Gordon</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1935-02-07T17:00:00-05:00">February 7, 1935—5
                        p.m.</date></dateline>
                </opener>
                <p>17. Department’s 15, February 4, 7 p.m.<anchor n="48" xml:id="d367-f1"/> Cable
                    whether Exchange Control has resumed allotments of official exchange for imports
                    from United States in accordance with the terms of the exchange of notes.<anchor
                        n="49" xml:id="d367-f2"/></p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
    </text>
