    <text>
        <body>
            <div xml:id="d581">

                <pb facs="0671" n="578" xml:id="pg578"/>

                <note rend="inline" type="source">816.51C39/365: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Minister in El Salvador</hi> (<hi
                            rendition="#italic">Corrigan</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1935-05-04T14:00:00-04:00">May 4, 1935—2 p.m.</date></dateline>
                </opener>
                <p>27. Your telegram 24, April 30, noon.<anchor n="38" xml:id="d581-f1"/> You may in
                    your discretion, and without expressing an opinion concerning any proposal,
                    express informally to the Minister of Foreign Affairs the hope that the present
                    negotiations may lead to an agreement satisfactory to both parties.</p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
    </text>
