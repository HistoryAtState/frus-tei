            <div xml:id="d713">

                <pb facs="0813" n="720" sameAs="frus:frus1935v04/pg720"/>

                <note rend="inline" type="source">838.516/346: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Haiti</hi> (<hi
                            rendition="#italic">Chapin</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Port-au-Prince</hi></placeName>, <date calendar="gregorian"
                            when="1935-04-10T13:00:00-05:00">April 10, 1935—1
                        p.m.</date><lb/>[Received 1:55 p.m.]</dateline>
                </opener>
                <p>28. My despatch No. 584, April 4.<anchor n="16" xml:id="d713-f1"/> De la Rue
                    sailing today S. S. <hi rendition="#italic">Cristobal</hi> for the purpose of
                    pursuing on behalf of Haitian Government direct negotiations with National City
                    Bank for completion of bank purchase contract.</p>
                <closer><signed><hi rendition="#small-caps">Chapin</hi></signed></closer>
            </div>
        </body>
    </text>
