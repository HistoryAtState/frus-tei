    <text>
        <body>
            <div xml:id="d763">

                <pb facs="0736" n="726" sameAs="frus:frus1941v05/pg726"/>

                <note rend="inline" type="source">811.20 Defense (M)/3496</note>
                <head>
                    <hi rendition="#italic">The Chinese Ambassador</hi> (<hi rendition="#italic">Hu
                        Shih</hi>) <hi rendition="#italic">to the Adviser on International Economic
                        Affairs</hi> (<hi rendition="#italic">Feis</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1941-09-17">September 17,
                        1941</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Dr. Feis</hi>: In pursuance of our telephone
                    conversation the other day, I am sending you three copies of a memorandum
                    containing the information I told you on the subject of importation of minerals
                    from China to this country.</p>
                <p>I take this opportunity to thank you for the pleasant and friendly chat we had in
                    your office last week.</p>
                <p>With kindest regards [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hu Shih</hi>
                    </signed>
                </closer>


                <xi:include href="d763-a1.xml" xpointer="d763-a1"/>
            </div>
        </body>
    </text>
