    <text>
        <body>
            <div xml:id="d770">

                <pb facs="0743" n="733" sameAs="frus:frus1941v05/pg733"/>

                <note rend="inline" type="source">893.24/1168: Telegram</note>
                <head>
                    <hi rendition="#italic">Madame Chiang Kai-shek
                        to Mr. Lauchlin Currie, Administrative
                        Assistant to President Roosevelt
                    </hi><anchor n="6" xml:id="d770-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Chungking</hi></placeName>, <date
                            calendar="gregorian" when="1941-09-28">September 28,
                        1941</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dr. Lauchlin Currie</hi>: Generalissimo requested me
                    wire you that owing to present critical military situation China in dire need of
                    2,000 accessory machine guns of one half inch caliber. Will you please expedite
                    immediate delivery?</p>
                <closer>(<signed>
                        <hi rendition="#small-caps">Madame Chiang Kai-shek</hi>
                    </signed>)</closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d770-f1" n="6" type="source" xml:id="d770-f1-content">
                <p>Received in the Department on September 29.</p>
            </note>
        </listAnnotation>
    </standOff>
