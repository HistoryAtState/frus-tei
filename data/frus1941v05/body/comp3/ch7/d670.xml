    <text>
        <body>
            <div xml:id="d670">

                <pb facs="0650" n="640" sameAs="frus:frus1941v05/pg640"/>

                <note rend="inline" type="source">893.51/7216</note>
                <head>
                    <hi rendition="#italic">The Chinese Ambassador</hi> (<hi
                            rendition="#italic">Hu Shih</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1941-05-02">May 2, 1941</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Under instructions of the Chinese
                    Government I have the honor to inform you that Dr. T. V. Soong has been duly
                    appointed and designated and is acting as agent, representative and
                    attorney-in-fact of the National Government of the Republic of China to act on
                    behalf of the Government in securing and receiving aid from the United States of
                    America, or any agency or instrumentality thereof, under the Lease-Lend Act of
                    March 11, 1941.<anchor n="57" xml:id="d670-f1"/>
                </p>
                <p>I shall be greatly obliged if you will be so good as to transmit the above
                    information to the appropriate branches of the United States Government.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hu Shih</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
