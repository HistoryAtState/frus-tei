                <pb facs="0880" n="870" sameAs="frus:frus1941v05/pg870"/>

                <note rend="inline" type="source">893.102S/2553a: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Consul General at Shanghai</hi> (<hi rendition="#italic"
                            >Lockhart</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1941-11-01T18:00:00-05:00">November 1, 1941—6
                            p.m.</date>
                    </dateline>
                </opener>
                <p>915. In order that the Department may be able to give full weight to local
                    conditions at Shanghai in connection with problems relating to the Shanghai
                    area, the Department desires that you report in a confidential telegram your
                    views in regard to the local situation at present, including the question of any
                    danger of attempted forceful encroachment from any source upon the International
                    Settlement.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
