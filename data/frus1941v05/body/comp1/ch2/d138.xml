    <text>
        <body>
            <div xml:id="d138">

                <pb facs="0148" n="138" sameAs="frus:frus1941v05/pg138"/>

                <note rend="inline" type="source">792.94/117</note>
                <head>
                    <hi rendition="#italic">The Navy Department to the
                            Department of State
                    </hi><anchor n="84" xml:id="d138-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1941-04-24">April 24, 1941</date>.</dateline>
                </opener>
                <p>The following message was received from the Commander in Chief Asiatic
                        Fleet<anchor n="85" xml:id="d138-f2"/> this date:</p>
                <p>To prevent spread Nipponese influence in Thailand and Brooke-Popham<anchor n="86"
                        xml:id="d138-f3"/> during Singapore conference urges our Government join in
                    mutual diplomatic <hi rendition="#italic">démarche.</hi>
                </p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d138-f1" n="84" type="source" xml:id="d138-f1-content">
                <p>Handed by Capt. Roscoe E. Schuirmann, of the Office of Naval Operations, to the
                    Chief of the Division of Far Eastern Affairs (Hamilton) on April 25; noted by
                    the Secretary of State.</p>
            </note>
            <note corresp="#d138-f2" n="85" xml:id="d138-f2-content">
                <p>Adm. Thomas C. Hart, U.S.N.</p>
            </note>
            <note corresp="#d138-f3" n="86" xml:id="d138-f3-content">
                <p>Air Marshal Sir Robert Brooke-Popham, British Commander in Chief, Far East.</p>
            </note>
        </listAnnotation>
    </standOff>
