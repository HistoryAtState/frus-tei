    <text>
        <body>
            <div xml:id="d335">

                <pb facs="0328" n="318" xml:id="pg318"/>

                <note rend="inline" type="source">894.24/1809</note>
                <head>
                    <hi rendition="#italic">Mr. Thomas K. Finletter, Special Assistant to the
                        Secretary of State, to the Counselor of the British Embassy</hi> (<hi
                        rendition="#italic">Marris</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1941-10-13">October 13,
                        1941</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Marris</hi>: I have received your letter of
                    October 6 concerning a proposal of the East Asiatic Company relative to Thai tin
                    and wolfram ore. There is no objection on the part of the Department to the
                    proposed action on the part of the East Asiatic Company which you describe in
                    your letter.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Thomas</hi> K. <hi rendition="#small-caps"
                            >Finletter</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
