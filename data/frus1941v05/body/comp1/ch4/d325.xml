                <pb facs="0322" n="312" sameAs="frus:frus1941v05/pg312"/>

                <note rend="inline" type="source">751G.94/384: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Japan</hi> (<hi rendition="#italic"
                            >Grew</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1941-10-06T17:00:00-05:00">October 6, 1941—5
                            p.m.</date>
                    </dateline>
                </opener>
                <p>641. With reference to recent developments in Japanese activity within and in
                    relation to French Indochina, the Department continues to hold the view
                    expressed in its telegram no. 441, July 29, 11 p.m.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
