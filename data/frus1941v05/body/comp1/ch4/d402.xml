    <text>
        <body>
            <div xml:id="d402">

                <pb facs="0383" n="373" sameAs="frus:frus1941v05/pg373"/>

                <note rend="inline" type="source">751G.94/407½</note>
                <head>
                    <hi rendition="#italic">The Secretary of War</hi> (<hi rendition="#italic"
                        >Stimson</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1941-12-06">December 6,
                        1941</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Secretary</hi>: I enclose the figures of
                    our G–2<anchor n="59" xml:id="d402-f1"/> estimate of Japanese air and ground
                    forces in Indo-China, Hainan, and Formosa, as requested by the President
                    yesterday.</p>
                <p>Faithfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Henry</hi> L. <hi rendition="#small-caps"
                            >Stimson</hi>
                    </signed>
                </closer>


                <xi:include href="d402-a1.xml" xpointer="d402-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
