    <text>
        <body>
            <div xml:id="d279">

                <pb facs="0367" n="259" sameAs="frus:frus1893/pg259"/>

                <head><hi rendition="#italic">Mr. Adee to Mr. Yang Yü.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1893-09-29"><hi rendition="#italic">September 29,
                        1893</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of the 27th instant, complaining of the imprisonment in California
                    of Chinese laborers, who, pending the hearing of their appeal to the United
                    States Supreme Court, are denied bail.</p>
                <p>In compliance with your request a copy of your note and its inclosure has been
                    laid before the Attorney-General for his consideration.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alvey A. Adee</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
