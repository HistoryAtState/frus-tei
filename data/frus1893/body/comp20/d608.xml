    <text>
        <body>
            <div xml:id="d608">

                <pb facs="0745" n="637" sameAs="frus:frus1893/pg637"/>

                <head><hi rendition="#italic">Mr. Adee to Mr.
                            Terrell.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1893-07-03"><hi rendition="#italic">July 3,
                        1893</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 12.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit for your information a copy of
                    correspondence with Mr. Fred. Perry Powers, of the Journal of Commerce, relative
                    to the <pb facs="0746" n="638" xml:id="pg638"/> proposed medical practice of Dr.
                    Mary P. Eddy in the Ottoman Dominions.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alvey A. Adee</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>



                <xi:include href="d608-a1.xml" xpointer="d608-a1"/>
