    <text>
        <body>
            <div xml:id="d606">

                <pb facs="0743" n="635" sameAs="frus:frus1893/pg635"/>

                <head><hi rendition="#italic">Mr. Quincy to Mr.
                            Newberry.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1893-05-24"><hi rendition="#italic">May 24,
                        1893</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 91.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit a copy of a letter of 20th
                    instant, by which you will see that the American Board of Commissioners for
                    Foreign Missions appears to be satisfied with the settlement of the difficulties
                    which recently arose at Marsovan.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Josiah Quincy,</hi><lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>


                <xi:include href="d606-a1.xml" xpointer="d606-a1"/>
