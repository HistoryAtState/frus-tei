    <text>
        <body>
            <div xml:id="d571">

                <pb facs="0699" n="591" sameAs="frus:frus1893/pg591"/>

                <head><hi rendition="#italic">Mr. Foster to Mr.
                            Thompson.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1892-12-15"><hi rendition="#italic">December 15,
                        1892</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 18.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit a copy of a letter of H. M.
                    Michaelian and of the naturalization papers to which he refers. Mr. Michaelian’s
                    family <pb facs="0700" n="592" xml:id="pg592"/> is now in Constantinople, and it
                    appears that their present address is known to the legation. You will use your
                    good offices to secure permission for Mr. Michaelian’s family to leave Turkey,
                    as desired.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John W. Foster.</hi></signed></closer>



                <xi:include href="d571-a1.xml" xpointer="d571-a1"/>
