    <text>
        <body>
            <div xml:id="d599-a2">

                <pb facs="0737" n="629" sameAs="frus:frus1893/pg629"/>

                <opener><seg rendition="#center">[Inclosure 2 in No. 78.]</seg></opener>
                <head><hi rendition="#italic">Statement of loss from the burning of the girls’
                        school building.</hi></head>
                <table cols="2" rows="3">
                    <row role="label">
                        <cell>Total expenditure for the building</cell>
                        <cell rendition="#nowrap #bottom">£Т. 586</cell>
                    </row>
                    <row>
                        <cell>Salvage—estimated value of foundation, timber, and other material not
                            consumed</cell>
                        <cell rendition="#border-bottom #bottom" role="num">86</cell>
                    </row>
                    <row>
                        <cell>Loss</cell>
                        <cell rendition="#bottom" role="num">500</cell>
                    </row>
                </table>
                <p>This does not include any charge for a large amount of time spent by Mr. Riggs
                    and myself in the purchase of material, superintending the work, and taking the
                    accounts.</p>
                <closer><signed><hi rendition="#small-caps">J. F. Smith</hi>,<lb/><hi
                            rendition="#italic">Treasurer.</hi></signed>
                    <lb/>
                    <dateline rendition="#float-left"><placeName><hi rendition="#small-caps"
                                >Marsovan</hi></placeName>, <date calendar="gregorian"
                            when="1893-04-03"><hi rendition="#italic">April 3,
                        1893</hi></date>.</dateline>
                </closer>
            </div>
        </body>
