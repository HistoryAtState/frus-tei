    <text>
        <body>
            <div xml:id="d191-a1">

                <pb facs="0266" n="158" sameAs="frus:frus1893/pg158"/>

                <opener><seg rendition="#center">[Inclosure in No. 35.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps">U.
                                S. S. Alliance</hi> (<hi rendition="#small-caps">third
                                rate</hi>),<lb/><hi rendition="#italic">At Sea, Lat. 13° 35ʹ N,
                                Long. 98°. 33ʹ W</hi></placeName>., <date calendar="gregorian"
                            when="1893-11-09"><hi rendition="#italic">November 9,
                        1893</hi></date>.</dateline></opener>
                <p>Record of a board of investigation convened on board the U. S. S. <hi
                        rendition="#italic">Alliance</hi> (third rate), by order of Commander T. A.
                    Lyons, U. S. Navy, in accordance with, article 1720 U. S. Navy Regulations,
                    1893.</p>
                <p>Approved:</p>
                <closer><signed><hi rendition="#small-caps">T. A. Lyons</hi>,<lb/><hi
                            rendition="#italic">Commander, U. S. Navy, Commanding.</hi></signed>
                    <lb/>
                    <dateline rendition="#float-left"><hi rendition="#small-caps">U. S. S.
                            Alliance</hi>,<lb/><placeName><hi rendition="#italic">La Libertad,
                                Salvador</hi></placeName>, <date calendar="gregorian"
                            when="1893-11-12"><hi rendition="#italic">November 12,
                        1893</hi></date>.</dateline>
                </closer>
            </div>
        </body>
