    <text>
        <body>
            <div xml:id="d234">

                <pb facs="0324" n="216" sameAs="frus:frus1893/pg216"/>

                <head><hi rendition="#italic">Mr. Gresham to Mr. Baker.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1893-11-03"><hi rendition="#italic">November 3,
                        1893</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 88.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit, with reference to the boundary
                    question between Costa Rica and Colombia, a copy of a dispatch<anchor n="*"
                        xml:id="d234-f1"/> from our minister at Bogota, and of the communication of
                    September 6, 1893, addressed by the minister of state of Colombia to the Costa
                    Rican Government, to which Mr. McKinney refers.</p>
                <p>I am, etc.</p>
                <closer><signed><hi rendition="#small-caps">W. Q. Gresham.</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d234-f1" n="*" xml:id="d234-f1-content">
                <p>For this inclosure see dispatch No. 19, dated September 29, 1893, from the United
                    States minister to Colombia.</p>
            </note>
        </listAnnotation>
    </standOff>
