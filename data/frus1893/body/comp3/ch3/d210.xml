    <text>
        <body>
            <div xml:id="d210">

                <pb facs="0305" n="197" sameAs="frus:frus1893/pg197"/>

                <head><hi rendition="#italic">Mr. Gresham to Mr.
                            Baker.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1893-06-13"><hi rendition="#italic">June 13,
                        1893</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 12.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose for your information a copy of a
                    letter from Mr. Lane, of the Pacific Mail Steamship Company, relative to the
                    pointing of a Krupp gun at the <hi rendition="#italic">City of New York</hi> on
                    the 11th ultimo by authorities of Corinto.</p>
                <p>Awaiting your expected report of the facts,</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. Q. Gresham.</hi></signed></closer>





