    <text>
        <body>
            <div xml:id="d210-a2">

                <pb facs="0305" n="197" sameAs="frus:frus1893/pg197"/>

                <opener><seg rendition="#center">[Sub-inclosure 1.]</seg></opener>
                <head><hi rendition="#italic">Mr. Cutler to Mr.
                            Houston.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >San Francisco</hi></placeName>, <date calendar="gregorian"
                            when="1893-05-25"><hi rendition="#italic">May 25,
                        1893</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Sir</hi>: Inclosed please find copy of report
                    relating to the pointing a loaded Krupp breech-loading gun against this
                    company’s steamer <hi rendition="#italic">San José</hi> and <hi
                        rendition="#italic">City of New York</hi> as made by the U. S. consular
                    agent at Corinto to Capt. F. H. Johnston of the steamship <hi
                        rendition="#italic">City of New York</hi>, under date of May 11, 1893.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alex. Cutler</hi>,<lb/><hi
                            rendition="#italic">General Agent.</hi></signed></closer>
            </div>
        </body>
    </text>
