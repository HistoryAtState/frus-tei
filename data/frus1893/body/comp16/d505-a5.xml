    <text>
        <body>
            <div xml:id="d505-a5">

                <pb facs="0631" n="523" sameAs="frus:frus1893/pg523"/>

                <opener><seg rendition="#center">[Inclosure 5 in No. 512.]</seg></opener>
                <head><hi rendition="#italic">Mr. Hicks to Mr.
                            Meier.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Lima</hi></placeName>, <date calendar="gregorian" when="1893-06-17"
                                ><hi rendition="#italic">June 17,
                    1893</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the pleasure of inclosing herewith a
                    receipt from the house of Messrs. Grace Brothers &amp; Co., showing that I have
                    this day deposited to your credit the <pb facs="0632" n="524" xml:id="pg524"/>
                    sum of 2,000 sols, being the amount received from the Government of Peru in full
                    settlement of your claim for indemnity on account of the attack upon the
                    Mollendo consular agency, March 25, 1893.</p>
                <p>Please acknowledge receipt of this.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hicks.</hi></signed></closer>
            </div>
        </body>
    </text>
