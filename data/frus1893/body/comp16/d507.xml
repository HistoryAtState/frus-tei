                <pb facs="0632" n="524" sameAs="frus:frus1893/pg524"/>

                <head><hi rendition="#italic">Mr. McKenzie to Mr. Gresham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Lima</hi></placeName>, <date calendar="gregorian" when="1893-10-23"
                                ><hi rendition="#italic">October 23, 1893</hi></date>. (Received
                        November 13.)</dateline>
                    <seg rendition="#float-left">No. 50.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit to the
                    Department of State a copy of a law in regard to “Immigration,” together with
                    translation thereof, which passed the Peruvian Congress on the 7th of October,
                    1893.</p>
                <p>I have the honor, etc.,</p>
                <closer><signed><hi rendition="#small-caps">J. A. McKenzie.</hi></signed></closer>


                <xi:include href="d507-a1.xml" xpointer="d507-a1"/>
