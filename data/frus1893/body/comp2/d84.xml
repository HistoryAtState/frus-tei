    <text>
        <body>
            <div xml:id="d84">

                <pb facs="0184" n="76" sameAs="frus:frus1893/pg76"/>

                <head><hi rendition="#italic">Mr. Thompson to Mr.
                            Gresham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Petropolis</hi></placeName>, <date calendar="gregorian"
                            when="1893-11-30"><hi rendition="#italic">November 30, 1893</hi></date>.
                        (Received January 2, 1894.)</dateline>
                    <seg rendition="#float-left">No. 88.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit copy and
                    translation of decree No. 1602, Brazilian Government, continuing in the District
                    Federal and the States of Pernambuco, Rio de Janeiro, San Paula, Parana, Santa
                    Catharina, and Rio Grande do Sul, the state of siege (martial law) heretofore
                    declared.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Thos. L.
                    Thompson.</hi></signed></closer>


                <xi:include href="d84-a1.xml" xpointer="d84-a1"/>
