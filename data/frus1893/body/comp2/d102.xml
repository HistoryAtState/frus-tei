                <pb facs="0195" n="87" xml:id="pg87"/>

                <head><hi rendition="#italic">Mr. Thompson to Mr. Gresham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Petropolis</hi></placeName>, <date calendar="gregorian"
                            when="1893-12-27"><hi rendition="#italic">December 27, 1893</hi></date>.
                        (Received February 3, 1894.)</dateline>
                    <seg rendition="#float-left">No. 112.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith copy
                    and translation of decree No. 1617, Brazilian Government, prolonging the state
                    of siege heretofore declared in certain States of the Republic.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Thos. L.
                    Thompson.</hi></signed></closer>


                <xi:include href="d102-a1.xml" xpointer="d102-a1"/>
