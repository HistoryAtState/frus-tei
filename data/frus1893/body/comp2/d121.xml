    <text>
        <body>
            <div xml:id="d121">

                <pb facs="0217" n="109" sameAs="frus:frus1893/pg109"/>

                <head><hi rendition="#italic">Mr. Thompson to Mr. Gresham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Petropolis</hi></placeName>, <date calendar="gregorian"
                            when="1894-01-20"><hi rendition="#italic">January 20, 1894</hi></date>.
                        (Received February 24.)</dateline>
                    <seg rendition="#float-left">No. 138.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit copy and
                    translation of a manifest published by Dr. Alfonso Augusto Moreira Penna, the
                    present governor of the State of Minas-Geraes, in which he strongly advocates
                    the maintenance of the existing government both as to form and personnel.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Thos. L.
                    Thompson.</hi></signed></closer>


                <xi:include href="d121-a1.xml" xpointer="d121-a1"/>
