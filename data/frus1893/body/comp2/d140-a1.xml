    <text>
        <body>
            <div xml:id="d140-a1">

                <pb facs="0234" n="126" sameAs="frus:frus1893/pg126"/>

                <opener><seg rendition="#center">[Inclosure 1 in No. 160.]</seg></opener>
                <head><hi rendition="#italic">Rear-Admiral Benham
                        to Mr. Thompson.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps">U.
                                S. Flagship San Francisco</hi>,<lb/><hi rendition="#italic">Rio de
                                Janeiro Brazil</hi></placeName>, <date calendar="gregorian"
                            when="1894-02-02"><hi rendition="#italic">February 2,
                        1894</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Inclosed you will find a translation of a
                    communication from Rear-Admiral da Gama, which I forward to you at his
                    request.</p>
                <p>Very respectfully,</p>
                <closer><signed><hi rendition="#small-caps">A. E. K. Benham</hi>,<lb/><hi
                            rendition="#italic">Rear-Admiral, U. S. Navy,<lb/>Commanding U. S. Naval
                            Forces on South Atlantic Station.</hi></signed></closer>
            </div>
        </body>
