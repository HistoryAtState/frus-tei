    <text>
        <body>
            <div xml:id="d168">

                <pb facs="0251" n="143" sameAs="frus:frus1893/pg143"/>

                <head><hi rendition="#italic">Senhor Mendonça to Mr. Gresham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States of Brazil</hi>,<lb/><hi
                                rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1893-03-25"><hi rendition="#italic">March 25,
                                1893</hi></date>. (Received March 27.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: It is my painful duty to make known to your
                    excellency the sudden and unexpected death, at 9:15 o’clock p.m. to day, of
                    Baron de Aguiar de Andrada, chief of the Brazilian special mission in
                    Washington.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Salvador
                    Mendonça.</hi></signed></closer>
            </div>
        </body>
    </text>
