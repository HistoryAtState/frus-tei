    <text>
        <body>
            <div xml:id="d176">

                <pb facs="0255" n="147" sameAs="frus:frus1893/pg147"/>

                <head><hi rendition="#italic">Mr. Gresham to Senhor Mendonça</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1893-10-16"><hi rendition="#italic">October 16,
                        1893</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the
                    receipt, on the afternoon of the 14th instant, of your note of that date,
                    inclosing a copy of a telegram received from your Government, reciting the
                    decree issued by it depriving the revolutionary squadron and the forts now held
                    by the revolutionary party of the privileges and protection of the national
                    flag.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. Q. Gresham.</hi></signed></closer>
            </div>
        </body>
    </text>
