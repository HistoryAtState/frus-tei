    <text>
        <body>
            <div xml:id="d175">

                <pb facs="0254" n="146" sameAs="frus:frus1893/pg146"/>

                <head><hi rendition="#italic">Senhor de Mendonça to Mr. Gresham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States of Brazil</hi>,<lb/><hi
                                rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1893-10-14"><hi rendition="#italic">October
                                14, 1893</hi></date>. (Received October 16.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to communicate to your
                    excellency that I have just received a cablegram from my Government, the
                    contents of which I herewith transmit to your excellency.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Salvador de
                    Mendonça.</hi></signed></closer>


                <xi:include href="d175-a1.xml" xpointer="d175-a1"/>
