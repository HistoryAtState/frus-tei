        <body>
            <div xml:id="d56">

                <pb facs="0167" n="59" sameAs="frus:frus1893/pg59"/>

                <head><hi rendition="#italic">Mr. Thompson to Mr.
                            Gresham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Petropolis</hi></placeName>, <date calendar="gregorian"
                            when="1893-10-14"><hi rendition="#italic">October 14, 1893</hi></date>.
                        (Received November 24, 1893.)</dateline>
                    <seg rendition="#float-left">No. 45.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith copy
                    of a decree No. 1560, Brazilian Government, placing the revolting squadron and
                    forts without the protection of the national flag.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Thos. L.
                    Thompson.</hi></signed></closer>


                <xi:include href="d56-a1.xml" xpointer="d56-a1"/>
