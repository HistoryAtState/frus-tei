                <pb facs="0245" n="137" sameAs="frus:frus1893/pg137"/>

                <head><hi rendition="#italic">Mr. Thompson to Mr. Gresham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Petropolis</hi></placeName>, <date calendar="gregorian"
                            when="1894-03-06"><hi rendition="#italic">March 6, 1894</hi></date>.
                        (Received March 31.)</dateline>
                    <seg rendition="#float-left">No. 190.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit copy and translation of decree
                    No. 1683, Brazilian Government, dated March 2, 1894, continuing the state of
                    siege in various localities of the country until the 20th of April next.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Thos. L.
                    Thompson.</hi></signed></closer>


                <xi:include href="d155-a1.xml" xpointer="d155-a1"/>
