        <body>
            <div xml:id="d152">

                <pb facs="0243" n="135" sameAs="frus:frus1893/pg135"/>

                <head><hi rendition="#italic">Mr. Thompson to Mr.
                            Gresham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Petropolis</hi></placeName>, <date calendar="gregorian"
                            when="1894-02-28"><hi rendition="#italic">February 28, 1894</hi></date>.
                        (Received March 31.)</dateline>
                    <seg rendition="#float-left">No. 182.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit herewith copy and translation of
                    decree No. 1679 of the Brazilian Government, continuing the state of siege
                    declared by decree No. 1663 until the 28th of February.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Thos. L.
                    Thompson.</hi></signed></closer>



                <xi:include href="d152-a1.xml" xpointer="d152-a1"/>
