    <text>
        <body>
            <div xml:id="d318">

                <pb facs="0433" n="325" sameAs="frus:frus1893/pg325"/>

                <head><hi rendition="#italic">Mr. Bayard to Mr.
                            Gresliam.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1893-07-22"><hi rendition="#italic">July 22, 1893</hi></date>.
                        (Received July 31.)</dateline>
                    <seg rendition="#float-left">No. 34.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a copy
                    of a letter which I have received from our minister at Constantinople,
                    requesting me to ask Her Majesty’s Government to allow the British
                    consul-general at Sofia to take charge of American interests in Bulgaria, and I
                    beg to inquire whether it be your desire that I should comply with Mr. Terrell’s
                    request.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. F. Bayard.</hi></signed></closer>



                <xi:include href="d318-a1.xml" xpointer="d318-a1"/>
