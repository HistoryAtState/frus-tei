    <text>
        <body>
            <div xml:id="d315">

                <pb facs="0430" n="322" xml:id="pg322"/>

                <head><hi rendition="#italic">Mr. Gresham to Mr.
                            Bayard.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1893-06-24"><hi rendition="#italic">June 24, 1893</hi></date>.
                        (Received June 24.)</dateline></opener>
                <p>Convey to Her Majesty expression of the heartfelt sorrow of the President and the
                    people of the United States by reason of the appalling catastrophe to the <hi
                        rendition="#italic">Victoria.</hi></p>
                <closer><signed><hi rendition="#small-caps">Gresham</hi>.</signed></closer>
            </div>
        </body>
