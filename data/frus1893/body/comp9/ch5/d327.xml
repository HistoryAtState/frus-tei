    <text>
        <body>
            <div xml:id="d327">

                <pb facs="0439" n="331" sameAs="frus:frus1893/pg331"/>

                <head><hi rendition="#italic">Lord Rosebery to Sir
                            Julian Pauncefote.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Foreign Office</hi></placeName>, <date calendar="gregorian"
                            when="1893-03-11"><hi rendition="#italic">March 11,
                        1893</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit herewith a copy of a dispatch
                    and its inclosure from Her Majesty’s ambassador at Constantinople relative to
                    the destruction, <pb facs="0440" n="332" xml:id="pg332"/> by incendiaries, of
                    the American college at Massouvan, and I have to request you to communicate
                    these reports to the United States Government.</p>
                <p>I am, etc.,</p>
                <closer><signed>(For the Earl of Rosebery,)<lb/><hi rendition="#small-caps">T. V.
                            Lister.</hi></signed></closer>



                <xi:include href="d327-a1.xml" xpointer="d327-a1"/>
