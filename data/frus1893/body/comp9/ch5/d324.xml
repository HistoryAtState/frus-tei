    <text>
        <body>
            <div xml:id="d324">

                <pb facs="0437" n="329" sameAs="frus:frus1893/pg329"/>

                <head><hi rendition="#italic">Sir Julian Pauncefote to Mr. Foster.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >British Legation</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1893-02-20"><hi rendition="#italic">February 20, 1893</hi></date>.
                        (Received February 20.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: At the request of the governor-general of
                    Canada, I have the honor to inclose herewith a copy of an order in council,
                    which was published in the official Canada Gazette on the 13th instant, making
                    certain amendments in the tariff of tolls in force on the canals in Canada.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Julian
                    Pauncefote.</hi></signed></closer>



                <xi:include href="d324-a1.xml" xpointer="d324-a1"/>
