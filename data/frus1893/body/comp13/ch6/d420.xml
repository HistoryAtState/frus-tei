    <text>
        <body>
            <div xml:id="d420">

                <pb facs="0542" n="434" xml:id="pg434"/>

                <head><hi rendition="#italic">Mr. Foster to Señor Cayetano Romero.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1892-12-31"><hi rendition="#italic">December 31,
                        1892</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Romero</hi>: I have received your note of
                    the 28th instant, and have hastened to bring to the notice of the Secretary of
                    War your suggestion relative to investigating the contradictory statements made
                    with reference to the Mexican soldiers held at San Ignacio.</p>
                <p>I am, etc.</p>
                <closer><signed><hi rendition="#small-caps">John W. Foster</hi>.</signed></closer>
            </div>
        </body>
    </text>
