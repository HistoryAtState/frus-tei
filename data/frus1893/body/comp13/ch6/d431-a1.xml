                        <cell rendition="#border-bottom #border-top #border-right">Men.</cell>
                        <cell rendition="#border-bottom #border-top #border-right">Horses.</cell>
                        <cell rendition="#border-bottom #border-top">Mules.</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">Third Zone:</cell>
                        <cell rendition="#border-right"/>
                        <cell rendition="#border-right"/>
                        <cell rendition="#border-right"/>
                        <cell rendition="#border-right"/>
                        <cell/>
                    </row>
                    <row>
                        <cell rendition="#border-right">Fifth Battalion of Infantry</cell>
                        <cell rendition="#border-right" role="num">3</cell>
                        <cell rendition="#border-right" role="num">34</cell>
                        <cell rendition="#border-right" role="num">569</cell>
                        <cell rendition="#border-right"/>
                        <cell role="num">32</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">Twenty-sixth Battalion of Infantry</cell>
                        <cell rendition="#border-right" role="num">3</cell>
                        <cell rendition="#border-right" role="num">33</cell>
                        <cell rendition="#border-right" role="num">559</cell>
                        <cell rendition="#border-right"/>
                        <cell role="num">32</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">Third Square of Battalion</cell>
                        <cell rendition="#border-right" role="num">1</cell>
                        <cell rendition="#border-right" role="num">11</cell>
                        <cell rendition="#border-right" role="num">116</cell>
                        <cell rendition="#border-right"/>
                        <cell/>
                    </row>
                    <row>
                        <cell rendition="#border-right">Twelfth Regiment</cell>
                        <cell rendition="#border-right" role="num">3</cell>
                        <cell rendition="#border-right" role="num">33</cell>
                        <cell rendition="#border-right" role="num">398</cell>
                        <cell rendition="#border-right" role="num">424</cell>
                        <cell role="num">32</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">Thirteenth Regiment</cell>
