                        <cell rendition="#border-right" role="num">3</cell>
                        <cell rendition="#border-right" role="num">9</cell>
                        <cell rendition="#border-right" role="num">155</cell>
                        <cell rendition="#border-right" role="num">155</cell>
                        <cell role="num">14</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">Fourth Zone:</cell>
                        <cell rendition="#border-right"/>
                        <cell rendition="#border-right"/>
                        <cell rendition="#border-right"/>
                        <cell rendition="#border-right"/>
                        <cell/>
                    </row>
                    <row>
                        <cell rendition="#border-right">Sixth Battalion of Infantry</cell>
                        <cell rendition="#border-right" role="num">3</cell>
