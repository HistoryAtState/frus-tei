                        <cell rendition="#border-right" role="num">3</cell>
                        <cell rendition="#border-right" role="num">9</cell>
                        <cell rendition="#border-right" role="num">79</cell>
                        <cell rendition="#border-right" role="num">104</cell>
                        <cell role="num">4</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">Fifth Troop Auxiliary Cavalry</cell>
                        <cell rendition="#border-right #border-bottom" role="num">3</cell>
                        <cell rendition="#border-right #border-bottom" role="num">12</cell>
                        <cell rendition="#border-right #border-bottom" role="num">89</cell>
                        <cell rendition="#border-right #border-bottom" role="num">94</cell>
                        <cell rendition="#border-bottom" role="num">4</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right #border-bottom">Total</cell>
                        <cell rendition="#border-right #border-bottom" role="num">36</cell>
                        <cell rendition="#border-right #border-bottom" role="num">287</cell>
                        <cell rendition="#border-right #border-bottom" role="num">4,084</cell>
                        <cell rendition="#border-right #border-bottom" role="num">1,646</cell>
                        <cell rendition="#border-bottom" role="num">213</cell>
                    </row>
                </table>
                <p>A copy:</p>
                <closer><signed><hi rendition="#small-caps">M. Aspiroz</hi>,<lb/><hi
                            rendition="#italic">Chief Clerk.</hi></signed>
                    <lb/>
                    <dateline rendition="#float-left"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1893-01-23"><hi rendition="#italic">January 23,
                        1893</hi></date>.</dateline>
                </closer>
            </div>
