                <pb facs="0551" n="443" sameAs="frus:frus1893/pg443"/>

                <head><hi rendition="#small-caps">department of the special staff
                    corps—mexico.</hi></head>
                <p rendition="#center"><hi rendition="#italic">Tables showing the Federal forces now
                        in the Third and Fourth Military Zones, comprising the States of Coahuila,
                        Nuevo Leon, and Tamaulipas.</hi></p>
                <table cols="6" rows="17">
                    <row>
                        <cell rendition="#border-bottom #border-top #border-right"/>
