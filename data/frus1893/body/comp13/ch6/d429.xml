    <text>
        <body>
            <div xml:id="d429">

                <pb facs="0548" n="440" sameAs="frus:frus1893/pg440"/>

                <head><hi rendition="#italic">Mr. Foster to Señor Cayetano Romero.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1893-02-01"><hi rendition="#italic">February 1,
                        1893</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the lion or to inclose a copy of
                    communications from the Secretary of War relative to the capture by our troops
                    of the bandits, Francisco Benavides, Prudencio Gonzales, and Cecilio
                    Echeverria.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John W. Foster.</hi></signed></closer>



