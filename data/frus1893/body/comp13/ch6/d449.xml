    <text>
        <body>
            <div xml:id="d449">

                <pb facs="0559" n="451" sameAs="frus:frus1893/pg451"/>

                <head><hi rendition="#italic">Mr. Gresham to Señor
                            Romero.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1893-06-15"><hi rendition="#italic">June 15,
                        1893</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of the 12th instant, in relation to the firing upon the sentry box
                    at Camargo by soldiers of the U. S. Army, and to say that a translation thereof
                    has been laid before the Secretary of War for his consideration and action.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. Q. Gresham.</hi></signed></closer>
            </div>
        </body>
    </text>
