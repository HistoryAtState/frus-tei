    <text>
        <body>
            <div xml:id="d6-a5">

                <pb facs="0126" n="18" xml:id="pg18"/>

                <opener><seg rendition="#center">[Inclosure 4 in inclosure 1 in No.
                        13—Telegram.]</seg></opener>
                <head><hi rendition="#italic">Mr. Hammond to Mr.
                            Gelletich.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Consulate of the United States</hi>,<lb/><hi rendition="#italic"
                                >Buda-Pesth</hi></placeName>, <date calendar="gregorian"
                            when="1893-05-20"><hi rendition="#italic">May 20,
                        1893</hi></date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Gelletich</hi>,<lb/><hi
                        rendition="#italic">Consul, Fiume.</hi></p>
                <p>Inform me date of birth, emigration, naturalization, whether summoned before
                    emigration.</p>
                <closer><signed><hi rendition="#small-caps">Hammond.</hi></signed></closer>
            </div>
        </body>
