                <pb facs="0613" n="505" sameAs="frus:frus1893/pg505"/>

                <head><hi rendition="#italic">Mr. McDonald to Mr. Gresham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Teheran, Persia</hi></placeName>, <date calendar="gregorian"
                            when="1893-11-09"><hi rendition="#italic">November 9, 1893</hi></date>.
                        (Received Dec. 15, 1893.)</dateline>
                    <seg rendition="#float-left">No. 36.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to submit herewith a copy
                    of note sent by me to the prime minister, as per your dispatch No. 16,
                    correcting Mr. Sperry’s misinterpretation of your instructions in No. 33 in
                    regard to the Hajie Seyyah case.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alex. McDonald.</hi></signed></closer>



                <xi:include href="d487-a1.xml" xpointer="d487-a1"/>
            </div>
