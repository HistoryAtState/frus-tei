                <pb facs="0842" n="734" sameAs="frus:frus1893/pg734"/>

                <head><hi rendition="#italic">Mr. Partridge to Mr. Gresham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Caracas</hi></placeName>, <date calendar="gregorian"
                            when="1893-07-25"><hi rendition="#italic">July 25, 1893</hi></date>.
                        (Received August 10.)</dateline>
                    <seg rendition="#float-left">No. 66.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to my dispatch No. 64, of
                    the 22d instant, relative to port facilities for mail steamers, I have now the
                    honor to transmit a copy and translation of the decree therein referred to,
                    which appeared in the Gazeta Oficial of last evening.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Frank C.
                    Partridge.</hi></signed></closer>


                <xi:include href="d692-a1.xml" xpointer="d692-a1"/>
