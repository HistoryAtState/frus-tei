    <text>
        <body>
            <div xml:id="d385-a1">

                <pb facs="0497" n="389" xml:id="pg389"/>

                <opener><seg rendition="#center">[Inclosure 1 in No. 62.]</seg></opener>
                <head><hi rendition="#italic">Mr. Combs to Mr. Coombs.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Chartered Bank of India, Australia, and China</hi>,<lb/><hi
                                rendition="#italic">Yokohama</hi></placeName>, <date
                            calendar="gregorian" when="1892-12-13"><hi rendition="#italic">December
                                13, 1892</hi></date>.</dateline></opener>
                <p rendition="#center"><hi rendition="#small-caps">memorandum.</hi></p>
                <p><hi rendition="#small-caps">Dear Sir</hi>: We are in receipt of your letter of
                    this date inclosing draft for $350, proceeds of which, at 67¼, $520.45, which we
                    have credited to your account.</p>
                <p>Yours, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Ed. Coutts</hi>, <hi rendition="#italic"
                            >Agent.</hi></signed></closer>
            </div>
        </body>
