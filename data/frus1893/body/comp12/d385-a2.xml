    <text>
        <body>
            <div xml:id="d385-a2">

                <pb facs="0497" n="389" sameAs="frus:frus1893/pg389"/>

                <opener><seg rendition="#center">[Inclosure 2 in No. 62.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Tokyo</hi></placeName>, <date calendar="gregorian"
                            when="1892-12-15"><hi rendition="#italic">December 15,
                        1892</hi></date>.</dateline></opener>
                <p>Received from Frank L. Coombs, United States minister, check on the “One Hundred
                    and Nineteenth National Bank” at Tokyo, Japan, for 520.45 yen, being the full
                    proceeds in exchange for draft on the Secretary of State of the United States,
                    indorsed to me by Mutsu Munemitsu, His Imperial Japanese Majesty’s minister for
                    foreign affairs, for the sum of $350, gold coin of the United States.</p>
                <p>Yen 520.45.</p>
                <closer><signed><hi rendition="#small-caps">Yoshiomi Seki</hi>,<lb/><hi
                            rendition="#italic">Governor of Tokushima Ken.</hi></signed></closer>
            </div>
        </body>
    </text>
