    <text>
        <body>
            <div xml:id="d531">

                <pb facs="0653" n="545" sameAs="frus:frus1893/pg545"/>

                <head><hi rendition="#italic">Mr. Adee to Mr.
                            White.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1893-09-21"><hi rendition="#italic">September 21,
                        1893</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 123.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of Mr.
                    Webb’s No. 134, of the 5th instant, reporting that Mr. Joseph Glowacki has been
                    again granted permission to enter Russia.</p>
                <p>The Department is gratified to learn that the case is thus closed.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alvey A. Adee</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary</hi></signed></closer>
            </div>
        </body>
    </text>
