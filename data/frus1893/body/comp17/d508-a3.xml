    <text>
        <body>
            <div xml:id="d508-a3">

                <pb facs="0635" n="527" sameAs="frus:frus1893/pg527"/>

                <opener><seg rendition="#center">[Inclosure 2.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >New York</hi></placeName>, <date calendar="gregorian"
                            when="1892-08-11"><hi rendition="#italic">August 11,
                        1892</hi>.</date></dateline></opener>
                <p rendition="#flush"><hi rendition="#italic">Hon. U. S. Consul to Kharkov,
                        Russia:</hi></p>
                <p><hi rendition="#small-caps">Dear Sri</hi>: This is to certify that Jacob
                    Goldstein, who is illegally detained in your city, is a member of our
                    congregation (The Congregation Adosholum Uriemtzer) of New York City. He is a
                    citizen of these United States, and we have known him to be a good and loyal
                    citizen. He has a mother, wife, and children here.</p>
                <p>Yours, etc.,</p>
                <closer><signed>
                        <list>
                            <item><hi rendition="#small-caps">A. Weinstein</hi>,<lb/><hi
                                    rendition="#italic">President.</hi></item>
                            <item><hi rendition="#small-caps">N. Beaurtties</hi>,<lb/><hi
                                    rendition="#italic">Secretary.</hi></item>
                        </list>
                    </signed></closer>
            </div>
        </body>
    </text>
