                <pb facs="0487" n="379" sameAs="frus:frus1893/pg379"/>

                <head><hi rendition="#italic">Mr. Gresham to Mr. Durham.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1893-04-05"><hi rendition="#italic">April 5,
                        1893</hi></date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Durham</hi>,<lb/><hi
                        rendition="#italic">Minister, Port au Prince:</hi></p>
                <p>Urge fulfillment in good faith of settlement offered and accepted in Mevs’s
                    case.</p>
                <closer><signed><hi rendition="#small-caps">Gresham.</hi></signed></closer>
            </div>
        </body>
