    <text>
        <body>
            <div xml:id="d380-a1">

                <pb facs="0490" n="382" sameAs="frus:frus1893/pg382"/>

                <opener><seg rendition="#center">[Inclosure 1 in No. 194.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Port au Prince</hi></placeName>, <date calendar="gregorian"
                            when="1893-04-12"><hi rendition="#italic">April 12,
                        1893</hi></date>.</dateline></opener>
                <p>Received of the secretary of state for foreign relations of Haiti the sum of
                    $6,000 currency of the United States, in final settlement and full
                    indemnification of the claim presented by the legation of the United States at
                    Port au Prince in favor of Frederick Mevs, a citizen of the United States.</p>
                <closer><signed><hi rendition="#small-caps">John S. Durham.</hi></signed></closer>
            </div>
        </body>
