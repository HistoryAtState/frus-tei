                <pb facs="0487" n="379" xml:id="pg379"/>

                <head><hi rendition="#italic">Mr. Durham to Mr.
                            Wharton.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Port au Prince</hi></placeName>, <date calendar="gregorian"
                            when="1893-03-03"><hi rendition="#italic">March 3, 1893</hi></date>.
                        (Received March 20.)</dateline>
                    <seg rendition="#float-left">No. 173.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to confirm my telegram of to-day,
                    informing yon that the President of Haiti had offered me $6,000 in settlement of
                    the Mevs case, and that I propose to accept.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John S. Durham</hi>.</signed></closer>
            </div>
        </body>
    </text>
