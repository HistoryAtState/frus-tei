    <text>
        <body>
            <div xml:id="d380-a2">

                <pb facs="0490" n="382" sameAs="frus:frus1893/pg382"/>

                <opener><seg rendition="#center">[Inclosure 2 in No. 194.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Port au Prince</hi></placeName>, <date calendar="gregorian"
                            when="1893-04-12"><hi rendition="#italic">April 12,
                        1893</hi></date>.</dateline></opener>
                <p>I have received from John S. Durham, minister-resident and consul-general of the
                    United States, the sum of $6,000 currency of the United States in full for the
                    indemnity paid to the legation for my account by the Government of Haiti.</p>
                <closer><signed><hi rendition="#small-caps">Frederick Mevs.</hi></signed></closer>
            </div>
        </body>
