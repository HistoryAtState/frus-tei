                <pb facs="0681" n="573" sameAs="frus:frus1893/pg573"/>

                <head><hi rendition="#italic">Mr. Snowden to Mr. Foster.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1893-02-28"><hi rendition="#italic">February 28, 1893</hi></date>.
                        (Received March 14.)</dateline>
                    <seg rendition="#float-left">No. 102.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose copy of my note
                    to the Marquis de la Vega de Armijo accepting, on behalf of my Government, the
                    Nao <hi rendition="#italic">Santa Maria</hi>, which was omitted in my dispatch
                    No. 72.</p>
                <p>I have, etc.</p>
                <closer><signed><hi rendition="#small-caps">A. Loudon Snowden</hi></signed></closer>



                <xi:include href="d556-a1.xml" xpointer="d556-a1"/>
