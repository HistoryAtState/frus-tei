    <text>
        <body>
            <div xml:id="d550">

                <pb facs="0673" n="565" sameAs="frus:frus1893/pg565"/>

                <head><hi rendition="#italic">Mr. Snowden to Mr.
                            Foster.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1893-01-30"><hi rendition="#italic">January 30, 1893</hi></date>.
                        (Received February 15.)</dateline>
                    <seg rendition="#float-left">No. 73.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose, for the
                    information and files of the Department, the chronological statement of events
                    occurring in the island of Ponapé, from 1852 to 1890, which was read at my
                    interview with the Marquis of Vega de Armijo on 24th instant, and should have
                    been inclosed in my No. 70.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">A. Loudon
                    Snowden.</hi></signed></closer>


                <xi:include href="d550-a1.xml" xpointer="d550-a1"/>
