    <text>
        <body>
            <div xml:id="letter-of-submittal">

                <pb facs="0041" n="XV" xml:id="pgXV"/>

                <head>Letter of submittal</head>
                <p rendition="#flush"><hi rendition="#italic">To the Senate and House of
                        Representatives:</hi></p>
                <p>I transmit herewith a report from the Secretary of State, accompanied with
                    selected correspondence relating to foreign affairs, for the year 1887.</p>
                <closer><signed><hi rendition="#small-caps">Grover Cleveland.</hi></signed>
                    <lb/>
                    <dateline rendition="#float-left"><hi rendition="#small-caps">Executive
                            Mansion</hi>,<lb/><placeName><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1888-06-26"><hi rendition="#italic">June 26,
                        1888</hi></date>.</dateline>
                </closer>


                <xi:include href="letter-of-submittal-a1.xml" xpointer="letter-of-submittal-a1"/>
            </div>
