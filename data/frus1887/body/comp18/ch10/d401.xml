        <body>
            <div xml:id="d401">

                <pb facs="0741" n="647" sameAs="frus:frus1887/pg647"/>

                <head>No. 401.<lb/><hi rendition="#italic">Mr. Bayard to Baron de
                    Fava</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1887-04-22"><hi rendition="#italic">April</hi> 22,
                        1887</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Baron</hi>: I have the honor to transmit to you, at
                    the instance of the Secretary of the Treasury, eleven copies of a circular of
                    March 24, 1887; described below.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. F. Bayard.</hi></signed></closer>


                <xi:include href="d401-a1.xml" xpointer="d401-a1"/>
            </div>
