    <text>
        <body>
            <div xml:id="d399-a2">

                <pb facs="0737" n="643" sameAs="frus:frus1887/pg643"/>

                <opener><seg rendition="#center">[Inclosure 2.]</seg></opener>
                <p rendition="#flush"><hi rendition="#small-caps">United States of
                        America</hi>,<lb/><hi rendition="#italic">Eastern Division, Southern
                        District of Georgia, ss:</hi></p>
                <p>I, Marion, Erwin, clerk of the district court of the United States of America for
                    the southern district of Georgia, do hereby certify that the writing annexed to
                    this certificate is a true copy of its respective original, now on file and
                    remaining of record in my office, to wit: The opinion of the court in case of
                    Frank Feol <hi rendition="#italic">v</hi>. the bark <hi rendition="#italic"
                        >Solomono</hi> and Marion Erwin, clerk of the district court, rendered
                    December 7, 1886.</p>
                <closer>
                    <dateline rendition="#float-left">In fitness whereof, I have caused the seal of
                        the said court to be hereunto affixed at the <placeName>city of Savannah, in
                            the southern district of Georgia</placeName>, <date
                            calendar="us-republic" when="1886-12-14">this 14th day of December, in
                            the year of our Lord one thousand eight hundred and eighty-six, and of
                            the independence of the United States the one hundred and
                            eleventh</date>.</dateline>
                    <lb/> [<hi rendition="#small-caps">seal.</hi>] <signed><hi
                            rendition="#small-caps">Marion Erwin</hi>,<lb/><hi rendition="#italic"
                            >Clerk.</hi></signed></closer>
            </div>
        </body>
    </text>
