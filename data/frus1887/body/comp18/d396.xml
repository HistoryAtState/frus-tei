        <body>
            <div xml:id="d396">

                <pb facs="0734" n="640" sameAs="frus:frus1887/pg640"/>

                <head>No. 396.<lb/><hi rendition="#italic">Mr. Bayard to Mr. Stallo.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1887-08-20"><hi rendition="#italic">August</hi> 20,
                        1887</date>.</dateline>
                    <seg rendition="#float-left">No. 74.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I am glad to learn by your No. 148 that the
                    request of the Department for the free entry of the consular property to which
                    it refers will doubtless receive favorable consideration at a near date.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. F. Bayard.</hi></signed></closer>
            </div>
        </body>
    </text>
