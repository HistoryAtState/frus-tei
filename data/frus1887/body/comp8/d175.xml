                <pb facs="0314" n="220" sameAs="frus:frus1887/pg220"/>

                <head>No. 175.<lb/><hi rendition="#italic">Mr. Denby to Mr. Bayard</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1887-06-08"><hi rendition="#italic">June</hi> 8, 1887</date>.
                        (Received July 25.)</dateline>
                    <seg rendition="#float-left">No. 382.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose a translation
                    of a recent decree issued by the Empress.</p>
                <p>It indicates the approaching marriage of the Emperor, but is chiefly an earnest
                    appeal for economy. I send it as a fair specimen of the utterances of this
                    remarkable woman.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charles Denby.</hi></signed></closer>


                <xi:include href="d175-a1.xml" xpointer="d175-a1"/>
