    <text>
        <body>
            <div xml:id="d295-a1">

                <pb facs="0517" n="423" sameAs="frus:frus1887/pg423"/>

                <head><hi rendition="#italic">List of the members of the life-saving crew who
                        perished while attempting to save the crew of the Elisabeth.</hi></head>
                <list>
                    <label>(1)</label>
                    <item>Capt. Abel Belanga; leaves a wife.</item>
                    <label>(2)</label>
                    <item>John Land; leaves a wife and children.</item>
                    <label>(3)</label>
                    <item>Joseph Stone; leaves a wife and child.</item>
                    <label>(4)</label>
                    <item>Joseph Spratley; leaves a wife and children.</item>
                    <label>(5)</label>
                    <item>Joseph E. Belanga, brother of the captain of the same name; leaves a wife
                        and child.</item>
                </list>
            </div>
        </body>
