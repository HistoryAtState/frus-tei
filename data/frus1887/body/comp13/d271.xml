    <text>
        <body>
            <div xml:id="d271">

                <pb facs="0463" n="369" sameAs="frus:frus1887/pg369"/>

                <head>No. 271.<lb/><hi rendition="#italic">Mr. Pendleton to Mr. Bayard</hi>.</head>
                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Berlin</hi></placeName>, <date calendar="gregorian"
                            when="1886-02-08"><hi rendition="#italic">February</hi> 8, 1886</date>.
                        (Received February 24.)</dateline>
                    <seg rendition="#float-left">No. 191.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose here with a copy and translation
                    of a note from the foreign office, under date of the 3d instant, giving the
                    results reached in the cases of Karl Simon Petersen, Christian Nielsen Hansen,
                    and Lars Hoeck, heretofore reported.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">George H.
                    Pendleton.</hi></signed></closer>


                <xi:include href="d271-a1.xml" xpointer="d271-a1"/>
            </div>
        </body>
