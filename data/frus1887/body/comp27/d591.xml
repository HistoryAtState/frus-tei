        <body>
            <div xml:id="d591">

                <pb facs="1051" n="957" sameAs="frus:frus1887/pg957"/>

                <head>No. 591.<lb/><hi rendition="#italic">Mr. Bayard to Mr. Lothrop.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1887-04-20"><hi rendition="#italic">April</hi> 20,
                        1887</date>.</dateline>
                    <seg rendition="#float-left">No. 84]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose for your information a copy of an
                    interesting dispatch from our consul at Odessa on the changes in the Russian
                    laws touching expatriation, etc., to which your No. 103 called attention.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. F. Bayard.</hi></signed></closer>


                <xi:include href="d591-a1.xml" xpointer="d591-a1"/>
            </div>
