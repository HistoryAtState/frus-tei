    <text>
        <body>
            <div xml:id="d576-a2">

                <pb facs="1037" n="943" sameAs="frus:frus1887/pg943"/>

                <opener><seg rendition="#center">[Inclosure 2 in No. 65.]</seg></opener>
                <p>I hereby certify that the undermentioned five men are American citizens, taken
                    from the schooner <hi rendition="#italic">Henrietta</hi> confiscated by the
                    Russian corvette <hi rendition="#italic">Kreysser</hi>, in the Bebring Strait.
                    They are not guilty of any violation of the Russian law, and are therefore sent
                    to the disposition of the American consul at Nagasaki.</p>
                <closer><signed><hi rendition="#small-caps">Chas.
                            Blois.</hi></signed><lb/><signed><hi rendition="#small-caps">Chas.
                            Giles.</hi></signed><lb/><signed><hi rendition="#small-caps">Thos.
                            Greenfell.</hi></signed><lb/><signed><hi rendition="#small-caps">Jas.
                            Hurley.</hi></signed><lb/><signed><hi rendition="#small-caps">Frederick
                            Nelson</hi>,<lb/><hi rendition="#italic">Captain of H. I. B. M’s
                            Corvette Craysser.</hi></signed><lb/>[<hi rendition="#small-caps">l.
                        s.</hi>] <signed><hi rendition="#small-caps">A. Ostolopoff</hi>,</signed>
                    <lb/>
                    <dateline rendition="#float-left"><placeName><hi rendition="#small-caps"
                                >Vladivostock</hi></placeName>, <date calendar="gregorian"
                            from="1886-10-01" to="1886-10-13"><hi rendition="#italic">October</hi>
                            1—13, 1886</date>.</dateline>
                </closer>
            </div>
        </body>
