                <head><hi rendition="#italic">Lists of free ports in the Dutch East
                    Indies.</hi></head>
                <list>
                    <item>Island of Riouw: <list>
                            <item>Riouw.</item>
                        </list></item>
                    <item>Island of Bali: <list>
                            <item>Pabean.</item>
                            <item>Sangrit.</item>
                            <item>Loloan.</item>
                            <item>Tamboekoes.</item>
                        </list></item>
                    <item>Island of Timor: <list>
                            <item>Koepang.</item>
                        </list></item>
                    <item>Island of Celebes: <list>
                            <item>Makassar.</item>
                            <item>Menado,</item>
                            <item>Kerna</item>
                        </list></item>
                    <item>Island of Celebes: <list>
                            <item>Gorontalo.</item>
                        </list></item>
                    <item>Moluccas: <list>
                            <item>Amboina.</item>
                            <item>Saparoa.</item>
                            <item>Banda.</item>
                            <item>Ternate.</item>
                            <item>K’ajeli.</item>
                        </list></item>
                    <item>Island of Sumatra. <list>
                            <item>Oleh-leh.</item>
                            <item>Beiigkalis.</item>
                        </list></item>
                </list>
