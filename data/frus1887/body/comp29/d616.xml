        <body>
            <div xml:id="d616">

                <pb facs="1085" n="991" sameAs="frus:frus1887/pg991"/>

                <head>No. 616.<lb/><hi rendition="#italic">Mr. Bayard to Mr. Curry.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1887-03-21"><hi rendition="#italic">March</hi> 21,
                        1887</date>.</dateline>
                    <seg rendition="#float-left">No. 181.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose for your information a copy of a
                    further dispatch from Cuba, showing the public dissatisfaction there with the
                    exactions of the passport system.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. F. Bayard.</hi></signed></closer>



                <xi:include href="d616-a1.xml" xpointer="d616-a1"/>
