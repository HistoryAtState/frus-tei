    <text>
        <body>
            <div xml:id="d622">

                <pb facs="1092" n="998" xml:id="pg998"/>

                <head>No. 622.<lb/><hi rendition="#italic">Mr. Bayard to Mr. Curry.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1887-07-06"><hi rendition="#italic">July</hi> 6,
                        1887</date>.</dateline>
                    <seg rendition="#float-left">No. 210.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have received your No. 222, of the 22d
                    ultimo, reporting correspondence touching the extension of the commercial
                    arrangement of October 27, 1886, between the United States and Spain, to
                    December 31, 1887.</p>
                <p>Your course in the matter is approved.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. F. Bayard.</hi></signed></closer>
            </div>
        </body>
