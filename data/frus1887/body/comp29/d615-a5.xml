    <text>
        <body>
            <div xml:id="d615-a5">

                <pb facs="1082" n="988" sameAs="frus:frus1887/pg988"/>

                <opener><seg rendition="#center">[Inclosure 4 to inclosure in No.
                    180.]</seg></opener>
                <head><hi rendition="#italic">Lawton Brothers to Mr.
                            Williams.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Tampa and Havana Steam-ship Line</hi>,<lb/><hi rendition="#italic"
                                >Havana, Cuba</hi></placeName>, <date calendar="gregorian"
                            when="1887-02-18"><hi rendition="#italic">February</hi> 18,
                        1887</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Sir</hi>: We beg to own receipt of your favor of
                    this date, and to accompany this with a copy of the “Boletm Oficial,” dated 3d
                    of August, 1886, which we think contains the information you desire, requesting
                    that you will kindly return the same to us, as it is the only copy that we
                    have.</p>
                <p>Yours, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Lawton Bros.</hi></signed></closer>
            </div>
        </body>
    </text>
