    <text>
        <body>
            <div xml:id="d619">

                <pb facs="1089" n="995" sameAs="frus:frus1887/pg995"/>

                <head>No. 619.<lb/><hi rendition="#italic">Mr. Bayard to Mr. Curry.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of state</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1887-04-25"><hi rendition="#italic">April</hi> 25,
                        1887</date>.</dateline>
                    <seg rendition="#float-left">No. 187.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit, with reference to former
                    correspondence on the annoyances of the passport arrangements in Cuba, a copy of
                    a note<anchor n="*" xml:id="d619-f1"/> from the minister of Spain at this
                    capital, anticipating that his Government will remedy the evil.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. F. Bayard.</hi></signed></closer>
            </div>
        </body>
    </text>
