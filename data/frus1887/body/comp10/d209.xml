        <body>
            <div xml:id="d209">

                <pb facs="0352" n="258" sameAs="frus:frus1887/pg258"/>

                <head>No. 209.<lb/><hi rendition="#italic">Mr. Rockhill to Mr. Bayard</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Seoul</hi></placeName>, <date calendar="gregorian"
                            when="1887-02-10"><hi rendition="#italic">February</hi> 10, 1887</date>.
                        (Received March 31.)</dateline>
                    <seg rendition="#float-left">No. 60.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to forward to you herewith
                    a translation of the provisional harbor regulations proposed by the Corean
                    Government to be put in force for the port of Chemulpo.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. W. Rockhill.</hi></signed></closer>



                <xi:include href="d209-a1.xml" xpointer="d209-a1"/>
