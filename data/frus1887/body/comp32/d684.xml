    <text>
        <body>
            <div xml:id="d684">

                <pb facs="1184" n="1090" sameAs="frus:frus1887/pg1090"/>

                <head>No. 684.<lb/><hi rendition="#italic">Mr. Bayard to Mr. King</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State,</hi><lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1887-02-02"><hi rendition="#italic">February</hi> 2,
                        1887</date>.</dateline>
                    <seg rendition="#float-left">No. 187.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have received your No. 277, of the 15th
                    ultimo, inclosing a copy of your note to the Sublime Porte in regard to the
                    interference with colporteurs employed by American missionaries in Turkey, and
                    have to approve your interest in the matter.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. F. Bayard.</hi></signed></closer>
            </div>
        </body>
