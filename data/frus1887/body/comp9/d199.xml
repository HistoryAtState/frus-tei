                <pb facs="0339" n="245" sameAs="frus:frus1887/pg245"/>

                <head>No. 199.<lb/><hi rendition="#italic">Mr. King to Mr. Bayard</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Bogota</hi></placeName>, <date calendar="gregorian"
                            when="1886-09-11"><hi rendition="#italic">September</hi> 11,
                        1886</date>. (Received October 6.)</dateline>
                    <seg rendition="#float-left">No. 70.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herein for your
                    information a copy and translation of a recent law of the Federal Congress here,
                    relative to the claims of foreigners for losses sustained during the late
                    rebellion.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">V. O. King.</hi></signed></closer>


                <xi:include href="d199-a1.xml" xpointer="d199-a1"/>
