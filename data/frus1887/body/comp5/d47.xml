                <pb facs="0141" n="47" sameAs="frus:frus1887/pg47"/>

                <head>No. 47.<lb/><hi rendition="#italic">Mr. Trail
                        to Mr. Bayard</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic">Rio
                                de Janeiro</hi></placeName>, <date calendar="gregorian"
                            when="1886-12-29"><hi rendition="#italic">December</hi> 29, 1886</date>.
                        (Received February 5, 1887.)</dateline>
                    <seg rendition="#float-left">No. 68.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Herewith I send you a report upon the
                    “Boundary question between Brazil and the Argentine Republic,” recently prepared
                    by me. A copy of the treaty of September 28, 1885, is also inclosed.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charles B. Trail.</hi></signed></closer>


                <xi:include href="d47-a1.xml" xpointer="d47-a1"/>
            </div>
