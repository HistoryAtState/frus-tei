                <pb facs="0148" n="54" sameAs="frus:frus1887/pg54"/>

                <head>No. 49.<lb/><hi rendition="#italic">Mr. Trail to Mr. Bayard</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic">Rio
                                de Janeiro</hi></placeName>, <date calendar="gregorian"
                            when="1887-01-21"><hi rendition="#italic">January</hi> 21, 1887</date>.
                        (Received February 18.)</dateline>
                    <seg rendition="#float-left">No. 72.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Herewith is inclosed a brief report upon
                    Brazilian foreign aft fairs for the year 1886.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charles B. Trail.</hi></signed></closer>



                <xi:include href="d49-a1.xml" xpointer="d49-a1"/>
