                <pb facs="0678" n="584" sameAs="frus:frus1887/pg584"/>

                <head>No. 375.<lb/><hi rendition="#italic">Mr. Bayard to Mr. Merrill.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1887-08-18"><hi rendition="#italic">August</hi> 18,
                        1887</date>.</dateline>
                    <seg rendition="#float-left">No. 58.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge, with thanks, the
                    receipt of your interesting and valuable dispatch, No. 135, of July 30, 1887,
                    giving a detailed account of the recent political events in Hawaii.</p>
                <p>I am etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. F. Bayard.</hi></signed></closer>
            </div>
        </body>
    </text>
