    <text>
        <body>
            <div xml:id="d364-a1-a1">

                <pb facs="0660" n="566" sameAs="frus:frus1887/pg566"/>

                <opener><hi rendition="#small-caps">Finance Department, Bureau of
                            Customs</hi>,<lb/><placeName><hi rendition="#italic">Honolulu, H.
                            I.</hi></placeName>, <date calendar="gregorian" when="1887-01-03"><hi
                            rendition="#italic">January</hi> 3, 1887</date>.</opener>
                <p rendition="#flush">His Excellency <hi rendition="#small-caps">Paul P.
                        Kanoa</hi>,<lb/><hi rendition="#italic">H. M.’s Minister of
                    Finance:</hi></p>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to submit to your
                    excellency the table of the principal domestic exports of the Hawaiian Islands
                    for the, quarter ending December 31, 1886. Also, a comparative table of exports
                    for the twelve months 1885, and the corresponding period 1886.</p>
                <p>With the highest respect and esteem, I have the honor to be your excellency’s
                    very obedient humble servant,</p>
                <closer><signed><hi rendition="#small-caps">Jno. M. Kapena</hi></signed>,<lb/><hi
                        rendition="#italic">Collector-General.</hi></closer>
            </div>
        </body>
    </text>
