    <text>
        <body>
            <div xml:id="d368">

                <pb facs="0664" n="570" sameAs="frus:frus1887/pg570"/>

                <head>No. 368.<lb/><hi rendition="#italic">Mr. Merrill to Mr. Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Honolulu</hi></placeName>, <date calendar="gregorian"
                            when="1887-04-06"><hi rendition="#italic">April</hi> 6, 1887</date>.
                        (Received April 27.)</dateline>
                    <seg rendition="#float-left">No. 114.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose three copies of
                    the quarterly report of the collector-general of customs, published, in the
                    Daily Advertiser <pb facs="0665" n="571" xml:id="pg571"/> of this city, showing
                    the principal domestic exports of the Hawaiian Islands for the quarter ending
                    March 31,1887.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Geo. W. Merrill</hi>.</signed></closer>


                <xi:include href="d368-a1.xml" xpointer="d368-a1"/>
            </div>
        </body>
