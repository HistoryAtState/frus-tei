    <text>
        <body>
            <div xml:id="d371-a1-a1">

                <pb facs="0674" n="580" xml:id="pg580"/>

                <p rendition="#flush"><hi rendition="#small-caps">Honolulu</hi>, <hi
                        rendition="#italic">Oahu, ss:</hi></p>
                <p>I, Kalakaua, King of the Hawaiian Islands, in the presence of Almighty God, do
                    solemnly swear to maintain this constitution whole and inviolate, and to govern
                    in conformity therewith.</p>
                <closer><signed><hi rendition="#small-caps">Kalakaua Rex.</hi></signed></closer>
                <closer>
                    <dateline rendition="#float-left">Subscribed and sworn to before me, <date
                            calendar="gregorian" when="1887-07-06">this 6th day of July, A. D.
                            1887</date>.</dateline>
                    <lb/>
                    <signed><hi rendition="#small-caps">A. F. Judd</hi>,<lb/><hi rendition="#italic"
                            >Chief Justice of the Supreme Court.</hi></signed></closer>
            </div>
        </body>
    </text>
