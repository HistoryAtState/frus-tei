    <text>
        <body>
            <div xml:id="d249-a8">

                <pb facs="0403" n="309" sameAs="frus:frus1887/pg309"/>

                <opener><seg rendition="#center">[The Baltimore and Ohio Telegraph Company
                        Cable.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1887-06-21"><hi rendition="#italic">June</hi>, 1887</date>.
                        (Received June 21.)</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">To Mullaly</hi>, 223 <hi
                        rendition="#italic">East Forty-ninth Street, New York:</hi></p>
                <p>Many thanks for aid and sympathy; please tell brother that his enemies will
                    render him lunatic if he is not requested and released soon.</p>
                <closer><signed><hi rendition="#small-caps">commanter.</hi></signed></closer>
            </div>
        </body>
    </text>
