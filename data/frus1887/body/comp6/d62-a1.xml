    <text>
        <body>
            <div xml:id="d62-a1">

                <pb facs="0168" n="74" sameAs="frus:frus1887/pg74"/>

                <opener><seg rendition="#center">[Inclosure 1 in No.
                    579.—Translation.]</seg></opener>
                <head><hi rendition="#italic">Señor Cruz to Mr. Hall</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Guatemala</hi></placeName>, <date calendar="gregorian"
                            when="1886-11-03"><hi rendition="#italic">November</hi> 3,
                        1886</date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Sir</hi>: For your personal information I
                    have the pleasure to inclose copies of the telegrams that the ministers for
                    foreign affairs of Nicaragua and Costa Rica have addressed to me in reply to the
                    notes from this Government offering them its good offices for the settlement of
                    the questions pending between those states.</p>
                <p>With high consideration, I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Fernando Cruz.</hi></signed></closer>
            </div>
        </body>
    </text>
