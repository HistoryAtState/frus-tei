    <text>
        <body>
            <div xml:id="d87-a2-a2">

                <pb facs="0214" n="120" sameAs="frus:frus1887/pg120"/>

                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Guatemala</hi></placeName>, <date calendar="gregorian"
                            when="1887-04-25"><hi rendition="#italic">April</hi> 25,
                        1887</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Pedro Molina Flores</hi>: In bringing to your
                    knowledge the resolution of this high body, we have the pleasure to renew to you
                    the assurances of our distinguished consideration and esteem.</p>
                <closer><signed><hi rendition="#small-caps">Miguel A. Urrutia.</hi></signed>
                    <lb/>
                    <signed><hi rendition="#small-caps">Damaso Micheo.</hi></signed></closer>
            </div>
