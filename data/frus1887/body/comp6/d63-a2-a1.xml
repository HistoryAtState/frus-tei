        <body>
            <div xml:id="d63-a2-a1">

                <pb facs="0170" n="76" sameAs="frus:frus1887/pg76"/>

                <head>[Coupon.]</head>
                <p>$12. Republic of Nicaragua, $12. Government bond No. 69 for $200 interest warrant
                    for $12, payable at the Bank of Louisiana, New Orleans, on the 1st day of
                    November, 1808, fixed.</p>
                <closer><signed>C. W. M., <hi rendition="#italic">Secretary.</hi></signed></closer>
                <postscript>
                    <p>Coupons from 1857 to 1876, inclusive. The 1857 is cut off.</p>
                </postscript>
            </div>
        </body>
