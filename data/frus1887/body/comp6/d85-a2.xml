    <text>
        <body>
            <div xml:id="d85-a2">

                <pb facs="0209" n="115" sameAs="frus:frus1887/pg115"/>

                <opener><seg rendition="#center">[Inclosure 2, in No.
                    648.—Translation.]</seg></opener>
                <head><hi rendition="#italic">President Carazo to
                        Mr. Hall</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Managua</hi></placeName>, <date calendar="gregorian"
                            when="1887-04-25"><hi rendition="#italic">April</hi> 25, 1887</date>.
                        (Received April 27.)</dateline></opener>
                <p rendition="#flush">Minister <hi rendition="#small-caps">Hall</hi>, <hi
                        rendition="#italic">Guatemala:</hi></p>
                <p>The Menocal Canal contract has been ratified.</p>
                <p>The President:</p>
                <closer><signed><hi rendition="#small-caps">Evaristo Carazo.</hi></signed></closer>
            </div>
        </body>
