    <text>
        <body>
            <div xml:id="d385-a1">

                <pb facs="0687" n="593" sameAs="frus:frus1887/pg593"/>

                <opener><seg rendition="#center">[Inclosure in No. 74]</seg></opener>
                <p rendition="#center">[Senate Ex. Doc. No. 64, Forty-ninth Congress, second
                    session.]</p>
                <p rendition="#flush"><hi rendition="#italic">Message from the President of the
                        United States, transmitting report of the Secretary of State, in response to
                        Senate resolution of December</hi> 8, 1886, <hi rendition="#italic">upon the
                        claim of Antonio Pellietier et al. against the Republic of Hayti.</hi></p>
                <p rendition="#center"><hi rendition="#small-caps">January</hi> 21, 1887.—Read and
                    referred to the Committee on Foreign Relations.</p>
                <p rendition="#center"><hi rendition="#small-caps">February</hi> 1, 1887.—Ordered to
                    be printed.</p>
                <p rendition="#flush"><hi rendition="#italic">To the Senate:</hi></p>
                <p>I transmit herewith a report of the Secretary of State in answer to the
                    resolution of the Senate of December 8, 1888, relative to the claims of Antonio
                    Pellietier and A. H. Lazare against the Republic of Hayti.</p>
                <closer><signed><hi rendition="#small-caps">Grover Cleveland.</hi></signed>
                    <lb/>
                    <dateline rendition="#float-left"><hi rendition="#small-caps">Executive
                            Mansion</hi>,<lb/><placeName><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1887-01-20"><hi rendition="#italic">January</hi> 20,
                        1887</date>.</dateline></closer>



                <xi:include href="d385-a1-a1.xml" xpointer="d385-a1-a1"/>
