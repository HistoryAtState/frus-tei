    <text>
        <body>
            <div xml:id="d431">

                <pb facs="0784" n="690" xml:id="pg690"/>

                <head>No. 431.<lb/><hi rendition="#italic">Mr. Manning to Mr. Bayard</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1887-02-19"><hi rendition="#italic">February</hi> 19, 1887</date>.
                        (Received March 1.)</dateline>
                    <seg rendition="#float-left">No. 69.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Upon receipt of your No. 47, of the 10th
                    instant, relative to the complaint of Messrs. F. Alexandre &amp; Sons, of New
                    York, I addressed a note to Sr. Mariscal, copy of which I have the honor
                    herewith to inclose, and trust that my presentation of the matter will meet your
                    approval.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Th. C. Manning.</hi></signed></closer>


                <xi:include href="d431-a1.xml" xpointer="d431-a1"/>
            </div>
