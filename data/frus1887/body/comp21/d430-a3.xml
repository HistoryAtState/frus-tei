                <opener><seg rendition="#center">[Inclosure 3 in No.
                    47.—Translation.]</seg></opener>
                <head><hi rendition="#italic">Debit note. Messrs. G. Amsinck &amp; Co., in account
                        with Frou Co.</hi></head>
                <table cols="4" rows="12">
                    <row>
                        <cell cols="3">Difference in the shipping of sixteen cases prints:</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell/>
                        <cell cols="2">Freight per Spanish line</cell>
                        <cell role="num">$56.23</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell cols="2">Freight per American line</cell>
                        <cell rendition="#border-bottom" role="num">28.56</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell/>
                        <cell>Difference value, New York</cell>
                        <cell role="num">27.67</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell cols="2">Exchange, 28 per cent</cell>
                        <cell rendition="#border-bottom" role="num">7.55</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell/>
                        <cell>Mexican value</cell>
                        <cell rendition="#border-bottom" role="num">35.22</cell>
                    </row>
                    <row>
                        <cell cols="3">Duties:</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell/>
                        <cell cols="2">30,603 yards, 24/25=17,141 ms., at 15 cents</cell>
                        <cell rendition="#border-bottom" role="num">2,612.10</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell cols="2">Duties of flag, 2 per cent</cell>
                        <cell role="num">52.24</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell cols="2">Mexican value</cell>
                        <cell rendition="#border-bottom" role="num">35.22</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell/>
                        <cell>Difference Mexican value</cell>
                        <cell rendition="#border-bottom" role="num">17.02</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell cols="2">Value in New York, at 28 per cent</cell>
                        <cell role="num">13.30</cell>
                    </row>
                </table>
                <closer><dateline rendition="#float-left"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1887-01-05"><hi rendition="#italic">January</hi> 5,
                        1887</date>.</dateline></closer>
