    <text>
        <body>
            <div xml:id="d445">

                <pb facs="0794" n="700" xml:id="pg700"/>

                <head>No. 445.<lb/><hi rendition="#italic">Mr. Bayard to Mr. Manning.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1887-04-05"><hi rendition="#italic">April</hi> 5,
                        1887</date>.</dateline>
                    <seg rendition="#float-left">No. 74.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose for your information copies of
                    two communications from the military authorities on our frontier which have been
                    referred hither by the Secretary of War under dates of the 25th and 26th ultimo,
                    in relation to the recent occurrences at Nogales, Ariz.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. F. Bayard.</hi>.</signed></closer>



                <xi:include href="d445-a1.xml" xpointer="d445-a1"/>
