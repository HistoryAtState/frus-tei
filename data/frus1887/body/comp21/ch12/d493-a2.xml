                <pb facs="0950" n="856" sameAs="frus:frus1887/pg856"/>

                <opener><seg rendition="#center">[Inclosure 2.]</seg></opener>
                <head><hi rendition="#small-caps">Article</hi> 124.</head>
                <p><hi rendition="#italic">Arresto menor</hi> shall last from three to thirty days.
                        <hi rendition="#italic">Arresto mayor</hi> shall last from one to eleven
                    months, and when, by accumulation of two penalties, it shall exceed from eleven
                    months, it will constitute prison.</p>
            </div>
