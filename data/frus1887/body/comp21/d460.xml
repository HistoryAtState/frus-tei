    <text>
        <body>
            <div xml:id="d460">

                <pb facs="0812" n="718" xml:id="pg718"/>

                <head>No. 460.<lb/><hi rendition="#italic">Mr. Bayard to Mr. Manning.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1887-05-02"><hi rendition="#italic">May</hi> 2,
                        1887</date>.</dateline>
                    <seg rendition="#float-left">No. 97.</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose for your information a copy of a
                    letter from Messrs. F. Alexandre &amp; Sons, of the 28th ultimo, expressing
                    gratification at the Department’s position as announced in its No. 92, of the
                    25th ultimo, to you, relative to the discrimination against American shipping
                    interests by Mexico.</p>
                <p>I am etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. F. Bayard.</hi></signed></closer>


                <xi:include href="d460-a1.xml" xpointer="d460-a1"/>
