    <text>
        <body>
            <div xml:id="d448">

                <pb facs="0803" n="709" sameAs="frus:frus1887/pg709"/>

                <head>No. 448.<lb/><hi rendition="#italic">Mr. Bayard to Mr. Manning.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1887-04-07"><hi rendition="#italic">April</hi> 7,
                        1887</date>.</dateline>
                    <seg rendition="#float-left">No. 77.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose for your information, in
                    connection with Department’s recent instructions upon the subject, a copy of a
                    letter from Messrs. Alexandre &amp; Sons, of New York, dated the 2d instant,
                    concerning the alleged discrimination by Mexico against the carrying trade of
                    the United States.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. F. Bayard.</hi></signed></closer>


                <xi:include href="d448-a1.xml" xpointer="d448-a1"/>
