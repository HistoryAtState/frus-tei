            <div xml:id="d476">

                <pb facs="0827" n="733" sameAs="frus:frus1887/pg733"/>

                <head>No. 476.<lb/><hi rendition="#italic">Mr. Manning to Mr. Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1887-06-11"><hi rendition="#italic">June</hi> 11, 1887</date>.
                        (Received June 20.)</dateline>
                    <seg rendition="#float-left">No. 150.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose the Diario Oficial of the 10th
                    instant, containing the published treaty of Mexico with Guatemala for the
                    regulation of the telegraph service.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Thos. C. Manning.</hi></signed></closer>



                <xi:include href="d476-a1.xml" xpointer="d476-a1"/>
