    <text>
        <body>
            <div xml:id="d347">

                <pb facs="0638" n="544" sameAs="frus:frus1887/pg544"/>

                <head>No. 347.<lb/><hi rendition="#italic">Mr. Bayard to Sir L. S. Sackville
                            West.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1887-07-28"><hi rendition="#italic">July</hi> 28,
                        1887</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of the 24th instant, in which you notify this Department that Her
                    Britannic Majesty’s Government has formally declared the whole of Zululand,
                    South Africa, to be a British possession.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. F. Bayard.</hi></signed></closer>
            </div>
        </body>
    </text>
