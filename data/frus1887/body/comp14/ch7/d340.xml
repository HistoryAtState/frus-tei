    <text>
        <body>
            <div xml:id="d340">

                <pb facs="0633" n="539" sameAs="frus:frus1887/pg539"/>

                <head>No. 340.<lb/><hi rendition="#italic">Mr. Bayard to Sir L. S. Sackville
                            West.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1887-05-19"><hi rendition="#italic">May</hi> 19,
                        1887</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the
                    receipt, yesterday, of your note of the 17th instant in response to my notes of
                    the 11th of November, 1st December, and 27th of January last, respecting the
                    cases of the United States fishing vessels <hi rendition="#italic">Mollie Adams,
                        Laura Sayward, Jennie Seaverns</hi>, and <hi rendition="#italic">Sarah H.
                        Prior</hi>.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. F. Bayard.</hi></signed></closer>
            </div>
        </body>
    </text>
