    <text>
        <body>
            <div xml:id="d331">

                <pb facs="0596" n="502" sameAs="frus:frus1887/pg502"/>

                <head>No. 331.<lb/><hi rendition="#italic">Sir L. S. Sackville
                            West to Mr. Bayard</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1887-01-28"><hi rendition="#italic">January</hi> 28, 1887</date>.
                        (Received January 29.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of yesterday’s date, and to inform you that I have submitted the
                    case of the American schooner <hi rendition="#italic">Sarah H. Prior</hi> to Her
                    Majesty’s Government for investigation, as requested by you.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">L. S. Sackville
                    West.</hi></signed></closer>
            </div>
        </body>
    </text>
