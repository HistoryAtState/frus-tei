    <text>
        <body>
            <div xml:id="d315">

                <pb facs="0562" n="468" sameAs="frus:frus1887/pg468"/>

                <head>No. 315.<lb/><hi rendition="#italic">Mr. White to Mr. Bayard</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1887-03-26"><hi rendition="#italic">March</hi> 26, 1887</date>.
                        (Received April 5.)</dateline>
                    <seg rendition="#float-left">No. 475.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith two
                    printed copies of a note<anchor n="*" xml:id="d315-f1"/> which I have received
                    from the Marquis of Salisbury, in reply to the proposals for a <hi
                        rendition="#italic">modus vivendi</hi>, contained in your instruction
                    numbered 459, of November 12 last, to Mr. Phelps.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Henry White.</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d315-f1" n="*" xml:id="d315-f1-content">
