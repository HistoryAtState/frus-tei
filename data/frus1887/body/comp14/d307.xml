    <text>
        <body>
            <div xml:id="d307">

                <pb facs="0552" n="458" sameAs="frus:frus1887/pg458"/>

                <head>No. 307.<lb/><hi rendition="#italic">Mr. Bayard to Mr. Phelps</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1887-02-01"><hi rendition="#italic">February</hi> 1,
                        1887</date>.</dateline>
                    <seg rendition="#float-left">No. 527.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit to you herewith, for the use of
                    your legation, copies of Senate Executive Document No. 55, Forty-ninth Congress,
                    second session, which contains a revised list of vessels involved in the
                    controversy with the Canadian authorities.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. F. Bayard.</hi></signed></closer>




                <xi:include href="d307-a1.xml" xpointer="d307-a1"/>
