            <div xml:id="d254-a1">

                <pb facs="0335" n="323" sameAs="frus:frus1946v08/pg323"/>

                <opener>
                    <seg rendition="#center">[Annex]</seg>
                </opener>
                <head><hi rendition="#small-caps">Article</hi> IX <hi rendition="#small-caps">of
                        Japanese Draft Constitution</hi><anchor n="7" xml:id="d254-f1"/></head>
                <p rendition="#center"><hi rendition="#small-caps">chapter</hi> 2</p>
                <p rendition="#flush"><hi rendition="#italic">Renunciation of War</hi></p>
                <p>Article IX. <del rendition="#strikethrough">War</del>
                    <hi rendition="#italic">Aspiring to an international peace based on justice and
                        order, the Japanese people renounce war forever</hi> as a sovereign right of
                    the nation, and the threat or use of force <del rendition="#strikethrough"
                        >is</del>
                    <del rendition="#strikethrough">forever</del>
                    <del rendition="#strikethrough">renounced</del> as a means of settling disputes
                    with other nations.</p>
                <p><del rendition="#strikethrough">The</del>
                    <del rendition="#strikethrough">maintenance</del>
                    <del rendition="#strikethrough">of</del>
                    <hi rendition="#italic">For the above purpose</hi>, land, sea, and air forces,
                    as well as other war potential, will never be <del rendition="#strikethrough"
                        >authorized</del>
                    <hi rendition="#italic">maintained</hi>. The right of belligerency of the state
                    will not be recognized.</p>
            </div>
        </body>
    </text>
