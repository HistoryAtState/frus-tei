            <div xml:id="d205">

                <pb facs="0250" n="238" sameAs="frus:frus1946v08/pg238"/>

                <note rend="inline" type="source">740.00119 Control (Japan)/5–2846: Circular
                    telegram</note>
                <head><hi rendition="#italic">The Secretary of State to Certain American Diplomatic
                        Officers</hi><anchor n="8" xml:id="d205-f1"/></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">restricted</hi></seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1946-05-28T09:00:00-04:00">May 28, 1946—9 a.m.</date></dateline>
                </opener>
                <p>Brit Commonwealth Occupation Force Japan given occupational responsibility for
                    Shikoku Island.</p>
                <closer><signed><hi rendition="#small-caps">Byrnes</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d205-f1" n="8" type="source" xml:id="d205-f1-content">
