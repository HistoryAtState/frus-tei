    <text>
        <body>
            <div xml:id="d211">

                <pb facs="0259" n="247" xml:id="pg247"/>

                <note rend="inline" type="source">894.011/6–1246</note>
                <head><hi rendition="#italic">Note by the Secretaries of the State–War–Navy
                        Coordinating Committee</hi><anchor n="14" xml:id="d211-f1"/></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">top secret</hi>
                        <lb/>
                        SWNCC 228/3</seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1946-06-11">11 June 1946</date>.</dateline>
                </opener>
                <p rendition="#center"><hi rendition="#small-caps">United States Policy in Regard to
                        the Adoption of a New Japanese Constitution</hi></p>
                <p>The enclosure, a study on the above subject presented by the State Member, is
                    circulated for consideration by the Committee.</p>
                <closer><signed><hi rendition="#small-caps">Alexander</hi> D. <hi
                            rendition="#small-caps">Reid</hi>
                        <lb/> B. L. <hi rendition="#small-caps">Austin</hi>
                        <lb/>
                        <hi rendition="#small-caps">Harold</hi> W. <hi rendition="#small-caps"
                            >Moseley</hi>
                    </signed><lb/>
                    <hi rendition="#italic">Secretariat</hi></closer>





                <xi:include href="d211-a1.xml" xpointer="d211-a1"/>
                <xi:include href="d211-a2.xml" xpointer="d211-a2"/>
                <xi:include href="d211-a3.xml" xpointer="d211-a3"/>
                <xi:include href="d211-a4.xml" xpointer="d211-a4"/>
