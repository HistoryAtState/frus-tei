    <text>
        <body>
            <div xml:id="d367">

                <pb facs="0498" n="486" sameAs="frus:frus1946v08/pg486"/>

                <note rend="inline" type="source">740.00119 Control (Japan)/4–346: Circular
                    telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to Certain Diplomatic and Consular
                            Officers</hi><anchor n="94" xml:id="d367-f1"/></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">secret</hi></seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1946-04-03T12:00:00-05:00">April 3, 1946—noon</date>.</dateline>
                </opener>
                <p>MacArthur has notified Mountbatten<anchor n="95" xml:id="d367-f2"/> of detailed
                    plans for sinking and otherwise disposing of large Japanese naval vessels and
                    submarines and requested Mountbatten take similar action.</p>
                <closer><signed><hi rendition="#small-caps">Acheson</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d367-f1" n="94" type="source" xml:id="d367-f1-content">
                <p>At Bangkok, Batavia, Chungking, London, and Singapore.</p>
            </note>
            <note corresp="#d367-f2" n="95" xml:id="d367-f2-content">
                <p>Adm. Lord Louis Mountbatten, Supreme Allied Commander, Southeast Asia.</p>
            </note>
        </listAnnotation>
    </standOff>
