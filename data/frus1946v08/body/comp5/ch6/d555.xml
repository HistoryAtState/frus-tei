    <text>
        <body>
            <div xml:id="d555">

                <pb facs="0761" n="749" sameAs="frus:frus1946v08/pg749"/>

                <note rend="inline" type="source">740.00119 Control (Korea)/10–2346: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Political Adviser in Korea</hi> (<hi
                            rendition="#italic">Langdon</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1946-10-28">October 28, 1946</date>.</dateline>
                </opener>
                <p>142. Cable from Kim Sung Soo<anchor n="63" xml:id="d555-f1"/> to ActSec asks for
                    true facts concerning press report that secret agreement made at Potsdam
                    provided <pb facs="0762" n="750" xml:id="pg750"/> for partition of Korea. Advise
                    him sole agreement at Potsdam which concerned Korea was provision in published
                    declaration that “the terms of the Cairo declaration shall be carried out.”</p>
                <closer><signed><hi rendition="#small-caps">Byrnes</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d555-f1" n="63" xml:id="d555-f1-content">
                <p>Telegram from Seoul, October 21, received October 23, not printed. It was signed
                    as from “Chairman the Democratic Party of Korea”.</p>
            </note>
        </listAnnotation>
    </standOff>
