    <text>
        <body>
            <div xml:id="d451">

                <pb facs="0617" n="605" sameAs="frus:frus1946v08/pg605"/>

                <note rend="inline" type="source">Records of the State–War–Navy Coordinating
                    Committee, Lot 52–M45, 091 Korea: Telegram</note>
                <head><hi rendition="#italic">General of the Army Douglas
                            MacArthur to the Joint Chiefs of
                            Staff</hi></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">confidential</hi>
                        <lb/>
                        <hi rendition="#small-caps">priority</hi></seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Tokyo</hi></placeName>,] <date calendar="gregorian"
                            when="1945-12-30">30 December 1945</date>.</dateline>
                </opener>
                <p>CA 56514. Following recommendation has been received from ComGen USAFIK:<anchor n="2"
                        xml:id="d451-f1"/>
                    <quote rend="blockquote">
                        <p>“There is great pressure here to send Korean delegation to UNO convention in January with expenses
                            paid by Koreans. Believe advantage in lift of morale of Korean people
                            would justify the authorization and warrant use of air transport.”</p>
                    </quote></p>
                <p>As the subject matter exceeds my authority, request instructions upon which I can
                    base a reply.</p>
                <closer>[<signed><hi rendition="#small-caps">MacArthur</hi></signed>]</closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d451-f1" n="2" xml:id="d451-f1-content">
                <p>Lt. Gen. John R. Hodge.</p>
            </note>
        </listAnnotation>
    </standOff>
