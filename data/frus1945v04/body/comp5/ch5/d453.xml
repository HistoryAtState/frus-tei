                    <ref target="frus1945v03#pg_281">Vol. <hi rendition="#small-caps">iii</hi>, p.
                        281</ref>
                </p>
            </note>
            <note corresp="#d453-f3" n="97" xml:id="d453-f3-content">
                <p>The Soviet Army occupied Prague on May 9.</p>
            </note>
        </listAnnotation>
