                <pb facs="1322" n="1310" sameAs="frus:frus1945v04/pg1310"/>

                <note rend="inline" type="source">865.6363/4–2045: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Italy</hi> (<hi rendition="#italic"
                            >Kirk</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-04-20T19:00:00-04:00">April 20, 1945—7
                            p.m.</date>
                    </dateline>
                </opener>
                <p>675. The procedures recommended in your 929, April 11, 10 a.m. are approved.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stettinius</hi>
                    </signed>
                </closer>
            </div>
        </body>
