    <text>
        <body>
            <div xml:id="d1214">

                <pb facs="1343" n="1331" sameAs="frus:frus1945v04/pg1331"/>

                <note rend="inline" type="source">865.7962/10–545: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Mr.
                            Alexander C. Kirk, Political Adviser to
                        the Supreme Allied Commander, Mediterranean Theater, at Caserta</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-10-16T19:00:00-05:00">October 16, 1945—7
                            p.m.</date>
                    </dateline>
                </opener>
                <p>899. Urtel 3799, Oct 5.<anchor n="82" xml:id="d1214-f1"/> Civil Aviation Section
                    War Dept was unable to act on Rome airport and matter was referred to Air
                    Coordinating Board. No decision has been reached by latter.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Byrnes</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
