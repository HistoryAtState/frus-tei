    <text>
        <body>
            <div xml:id="d1052">

                <pb facs="1137" n="1125" sameAs="frus:frus1945v04/pg1125"/>

                <note rend="inline" type="source">740.00119 Control (Italy)/4–2845</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Secretary of
                        War</hi> (<hi rendition="#italic">Stimson</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-04-28">April 28, 1945</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: It is the position of
                    the Department of State that the attached cable<anchor n="88" xml:id="d1052-f1"
                    /> to the Supreme Allied Commander, Mediterranean Theater, concerning the
                    establishment of military government in the Compartment of Venezia Giulia and
                    other sections of <pb facs="1138" n="1126" xml:id="pg1126"/> Italian territory,
                    should be dispatched as a matter of great political urgency.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Joseph</hi> C. <hi rendition="#small-caps"
                            >Grew</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1052-f1" n="88" xml:id="d1052-f1-content">
                <p>This message became Fan 536; see footnotes 82, <ref target="#pg1121">p.
