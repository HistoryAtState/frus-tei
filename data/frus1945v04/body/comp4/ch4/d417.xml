    <text>
        <body>
            <div xml:id="d417">

                <pb facs="0420" n="408" sameAs="frus:frus1945v04/pg408"/>

                <note rend="inline" type="source">740.00119 Council/12–1145: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        United States Representative in Bulgaria</hi> (<hi
                            rendition="#italic">Barnes</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-12-11T18:00:00-05:00">December 11,
                            1945—6 p.m.</date>
                    </dateline>
                </opener>
                <p>398. For your information it is contemplated that during conversations in Moscow
                    scheduled to begin December 15, we will discuss <pb facs="0421" n="409"
                        xml:id="pg409"/> with Soviet and Brit representatives solution outstanding
                    differences regarding Bulgarian and Rumanian situations.<anchor n="42"
                        xml:id="d417-f1"/>
                </p>
                <p>Sent to Sofia and Bucharest.<anchor n="43" xml:id="d417-f2"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Byrnes</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d417-f1" n="42" xml:id="d417-f1-content">
                <p>See <ref target="frus1945v02">vol. <hi rendition="#small-caps">ii</hi>
                    </ref>, index entries on Bulgaria and Rumania under Tripartite Conference of
                    Foreign Ministers.</p>
            </note>
            <note corresp="#d417-f2" n="43" xml:id="d417-f2-content">
                <p>To Bucharest as No. 644.</p>
            </note>
        </listAnnotation>
    </standOff>
