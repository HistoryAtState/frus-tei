    <text>
        <body>
            <div xml:id="d389">

                <pb facs="0395" n="383" sameAs="frus:frus1945v04/pg383"/>

                <note rend="inline" type="source">874.00/11–1645: Telegram</note>
                <head>
                    <hi rendition="#italic">The United States Representative in Bulgaria</hi> (<hi
                        rendition="#italic">Barnes</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Sofia</hi></placeName>, <date
                            calendar="gregorian" when="1945-11-16T02:00:00+02:00">November 16,
                            1945—2 a.m.</date>
                        <lb/> [Received November 18—11:05 p.m.]</dateline>
                </opener>
                <p>694. Remytel 693, November 16, 1 a.m. Both Prime Minister and Minister of Foreign
                    Affairs promise to be in Sofia and to receive personally from me contents of
                    Department’s 373 by 1 p.m., Sofia time <pb facs="0396" n="384" xml:id="pg384"/>
                    November 16. Request Department release communication at 12 noon Washington time
                    November 16.<anchor n="11" xml:id="d389-f1"/>
                </p>
                <closer>[<signed>
                        <hi rendition="#small-caps">Barnes</hi>
                    </signed>]</closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d389-f1" n="11" xml:id="d389-f1-content">
                <p>For text of Department’s press release, see Department of State <hi
                        rendition="#italic">Bulletin</hi>, November 18, 1945, p. 791.</p>
            </note>
        </listAnnotation>
