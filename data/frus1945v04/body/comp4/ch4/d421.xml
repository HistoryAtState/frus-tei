    <text>
        <body>
            <div xml:id="d421">

                <pb facs="0424" n="412" sameAs="frus:frus1945v04/pg412"/>

                <note rend="inline" type="source">740.00119 E.W./12–1445: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the Soviet Union</hi> (<hi
                        rendition="#italic">Harriman</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Moscow</hi></placeName>, <date
                            calendar="gregorian" when="1945-12-14T09:00:00+03:00">December 14,
                            1945—9 a.m.</date>
                        <lb/> [Received 1:25 p.m.]</dateline>
                </opener>
                <p>4159. ReDeptel 2498, Dec. 11.<anchor n="47" xml:id="d421-f1"/> Representations in
                    support of Greek claim for reparations from Bulgaria made in letter to Vyshinski
                    dated Dec 13 in accordance Dept’s instructions.</p>
                <p>Sent Dept, repeated Sofia 147, repeated Athens 65.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Harriman</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d421-f1" n="47" xml:id="d421-f1-content">
                <p>Same as telegram 399 to Sofia, <ref target="#pg409">p. 409</ref>.</p>
            </note>
        </listAnnotation>
