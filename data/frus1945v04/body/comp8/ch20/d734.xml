    <text>
        <body>
            <div xml:id="d734">

                <pb facs="0782" n="770" xml:id="pg770"/>

                <note rend="inline" type="source">Paris Embassy Files: Lot 55F–139 Box 2, File
                    631</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the French Chargé</hi> (<hi
                        rendition="#italic">Lacoste</hi>)<anchor n="91" xml:id="d734-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-11-08">November 8,
                        1945</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I acknowledge the receipt of your note of
                    today’s date concerning the understanding reached during our recent discussions
                    pursuant to Article VII of the Master Lend-Lease Agreement between the United
                    States of America and the Provisional Government of France dated February 28,
                    1945, and I hereby confirm your statement of the understanding reached as
                    therein set out.</p>
                <p>Accept [etc.]</p>
                <closer>[File copy not signed]</closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d734-f1" n="91" type="source" xml:id="d734-f1-content">
                <p>Copy transmitted to Paris as enclosure to instruction 1658, December 6, 1945 (not
                    printed).</p>
            </note>
