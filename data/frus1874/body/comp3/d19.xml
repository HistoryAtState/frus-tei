    <text>
        <body>
            <div xml:id="d19">

                <pb facs="0125" n="29" sameAs="frus:frus1874/pg29"/>

                <head>No. 17.<lb/><hi rendition="#italic">Mr. Delaplaine to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Vienna</hi></placeName>, <date calendar="gregorian" when="1874-05-26"
                                ><hi rendition="#italic">May</hi> 26, 1874</date>. (Received June
                        12.)</dateline>
                    <seg rendition="#float-left">No. 749.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor herewith to transmit copy
                    of my note on the occasion of the retirement of Baron Lederer, addressed to the
                    minister for foreign affairs, in pursuance of your instructions. Also copy of a
                    translation of reply to the same, received at the legation this morning.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>J. F. DELAPLAINE.</signed></closer>




                <xi:include href="d19-a1.xml" xpointer="d19-a1"/>
