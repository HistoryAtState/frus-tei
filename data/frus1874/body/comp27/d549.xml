    <text>
        <body>
            <div xml:id="d549">

                <pb facs="0951" n="855" sameAs="frus:frus1874/pg855"/>

                <head>No. 547.<lb/><hi rendition="#italic">General Sickles to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Legation in Spain</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1874-01-15"><hi rendition="#italic">January</hi> 15, 1874</date>.
                        (Received February 16.)</dateline>
                    <seg rendition="#float-left">No. 963.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the houor to forward, herewith, a
                    copy of an order of the minister of hacienda, dated 31st December, ultimo,
                    suspending the collection of the tax on exports, some time since reduced from
                    five to one per centum.</p>
                <p>I have, also, the satisfaction to forward a copy of a decree published to-day,
                    abolishing the tax definitely.</p>
                <p>I am, &amp;c,</p>
                <closer><signed>D. E. SICKLES.</signed></closer>




                <xi:include href="d549-a1.xml" xpointer="d549-a1"/>
