    <text>
        <body>
            <div xml:id="d540">

                <pb facs="0944" n="848" sameAs="frus:frus1874/pg848"/>

                <head>No. 538.<lb/><hi rendition="#italic">General Sickles to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Legation in Spain</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1873-11-07"><hi rendition="#italic">November</hi> 7, 1873</date>.
                        (Received November 26.)</dateline>
                    <seg rendition="#float-left">No. 802.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to forward herewith
                    annexed a copy of a communication, dated yesterday, addressed by me to the
                    executive committee of the Spanish Abolition Society, conveying to them the
                    reply of the President to their recent memorial, conformably to the tenor of
                    your instruction No. 388, of the 10th ultimo.</p>
                <p>I am, &amp;c,</p>
                <closer><signed>D. E. SICKLES.</signed></closer>


                <xi:include href="d540-a1.xml" xpointer="d540-a1"/>
            </div>
        </body>
    </text>
