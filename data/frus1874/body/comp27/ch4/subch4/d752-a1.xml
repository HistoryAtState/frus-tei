    <text>
        <body>
            <div xml:id="d752-a1">

                <pb facs="1205" n="1109" sameAs="frus:frus1874/pg1109"/>

                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Gobierno Superior Politico Secretaria Neg’do Politico</hi>,<lb/><hi
                                rendition="#italic">Havana</hi></placeName>, <date
                            calendar="gregorian" when="1871-12-02"><hi rendition="#italic"
                                >December</hi> 2, 1871</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Most Excellent Sir</hi>: To be used as your
                    excellency may deem convenient, I have the honor of inclosing the testimony,
                    taken in due legal form, given by two of the crew of the last expedition of the
                    Virginius, who presented themselves, and whose depositions were taken, in the
                    presence of the consuls of the United States of America and of Venezuela.</p>
                <p>May God, &amp;c,</p>
                <closer><signed>The <hi rendition="#small-caps">Count</hi>
                    VALMASEDA,</signed></closer>
                <postscript>
                    <p>His Excellency the <hi rendition="#small-caps">Minister of Spain</hi>
                        <hi rendition="#italic">in Washington</hi>.</p>
                </postscript>
            </div>
        </body>
