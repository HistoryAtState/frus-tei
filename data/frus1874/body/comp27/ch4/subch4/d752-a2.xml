    <text>
        <body>
            <div xml:id="d752-a2">

                <pb facs="1205" n="1109" sameAs="frus:frus1874/pg1109"/>

                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Fiscalia Militar Permanente de Esta Plaza</hi>,<lb/><hi
                                rendition="#italic">Plaza de la Havana</hi></placeName>, <date
                            calendar="gregorian" when="1871-12-02">1871</date>.</dateline></opener>
                <p>Examination of the Venezuelan prisoners of war, Anselmo Villarreal and Gervasia
                    Parra, who testify in the presence of the consuls of the United States and of
                    Venezuela, whose signatures are hereunto attached.</p>
                <closer><signed>Fiscal magistraten ANTONIO BERTRAM ARNULTE,<lb/><hi
                            rendition="#italic">Lieutenant-Colonel of
                    Infantry.</hi></signed></closer>
                <postscript>
                    <p>Secretary <hi rendition="#small-caps">D. Roman Pardina y Mur</hi>,<lb/><hi
                            rendition="#italic">Commander, Captain of Infantry.</hi></p>
                </postscript>





