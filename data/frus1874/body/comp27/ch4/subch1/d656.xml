    <text>
        <body>
            <div xml:id="d656">

                <pb facs="1059" n="963" xml:id="pg963"/>

                <head>No. 654.<lb/><hi rendition="#italic">General Sickles to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Legation in Spain</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1873-11-27"><hi rendition="#italic">November</hi> 27, 1873</date>.
                        (Received Dec. 23.)</dateline>
                    <seg rendition="#float-left">No. 886.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to forward herewith a
                    translation of a private note from Mr. Carvajal at a late hour last night, and a
                    copy of my reply thereto, in relation to the suspension of official action on my
                    request for my passports.</p>
                <p>I am, &amp;c,</p>
                <closer><signed>D. E. SICKLES.</signed></closer>



                <xi:include href="d656-a1.xml" xpointer="d656-a1"/>
