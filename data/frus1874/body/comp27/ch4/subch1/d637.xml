                <pb facs="1051" n="955" xml:id="pg955"/>

                <head>No. 635.<lb/><hi rendition="#italic">Mr. Fish
                        to General Sickles.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1873-11-19"><hi rendition="#italic">November</hi> 19,
                        1873</date>.</dateline></opener>
                <p>Your telegrams of last evening received. An instruction will be sent
                    immediately.</p>
                <closer><signed>FISH.</signed></closer>
            </div>
        </body>
