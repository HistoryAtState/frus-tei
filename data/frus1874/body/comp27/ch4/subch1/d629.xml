    <text>
        <body>
            <div xml:id="d629">

                <pb facs="1048" n="952" sameAs="frus:frus1874/pg952"/>

                <head>No. 627.<lb/><hi rendition="#italic">General Sickles to Mr. Fish.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1873-11-18"><hi rendition="#italic">November</hi> 18,
                        1873</date>.</dateline></opener>
                <p>If my departure forthwith is approved, please cause orders to be cabled to
                    Admiral Case, at Nice, to come to Valencia at once and convey me and my family
                    to a port in France.</p>
                <closer><signed>SICKLES.</signed></closer>
            </div>
        </body>
    </text>
