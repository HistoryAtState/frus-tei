                <pb facs="1069" n="973" sameAs="frus:frus1874/pg973"/>

                <head>No. 677.<lb/><hi rendition="#italic">Mr. Fish to General Sickles.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1873-12-08"><hi rendition="#italic">December</hi> 8,
                        1873</date>.</dateline></opener>
                <p>Agreement has been signed fixing the time, place, and manner of the surrender of
                    the Virginius and surviving passengers and crew.</p>
                <closer><signed>FISH</signed></closer>
            </div>
