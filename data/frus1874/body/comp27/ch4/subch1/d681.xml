    <text>
        <body>
            <div xml:id="d681">

                <pb facs="1070" n="974" xml:id="pg974"/>

                <head>No. 679.<lb/><hi rendition="#italic">General Sickles to Mr. Fish.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1873-12-16"><hi rendition="#italic">December</hi> 16, 1873</date>.
                        (Received late p.m.)</dateline></opener>
                <p>I respectfully request that my telegram of 6th instant tendering my resignation,
                    and your reply of same date, may be now published.</p>
                <closer><signed>SICKLES.</signed></closer>
            </div>
        </body>
    </text>
