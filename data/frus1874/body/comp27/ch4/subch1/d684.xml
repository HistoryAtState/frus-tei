    <text>
        <body>
            <div xml:id="d684">

                <pb facs="1070" n="974" sameAs="frus:frus1874/pg974"/>

                <head>No. 682.<lb/><hi rendition="#italic">General Sickles to Mr. Fish.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1873-12-20T01:00:00-00:14"><hi rendition="#italic">December</hi>
                            20, 1873—1 a.m.</date></dateline></opener>
                <p>I respectfully renew the tender of my resignation, which I trust may be accepted
                    now without interfering with the prospects of an accommodation.</p>
                <closer><signed>SICKLES.</signed></closer>
            </div>
        </body>
    </text>
