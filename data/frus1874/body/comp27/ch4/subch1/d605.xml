    <text>
        <body>
            <div xml:id="d605">

                <pb facs="1032" n="936" xml:id="pg936"/>

                <head>No. 603.<lb/><hi rendition="#italic">Mr. Fish
                        to General Sickles.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1873-11-14"><hi rendition="#italic">November</hi> 14,
                        1873</date>.</dateline>
                    <seg rendition="#float-left">No. 406.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith a copy of a telegram
                    sent to you this day, relating to the capture of the Virginius, and also of the
                    correspondence upon the same subject which has taken place between the
                    consul-general of the United States at Havana and the captain-general of
                    Cuba.</p>
                <p>I am, &amp;c,</p>
                <closer><signed>HAMILTON FISH.</signed></closer>
            </div>
        </body>
