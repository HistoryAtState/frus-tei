            <div xml:id="d715-a1-a3">

                <pb facs="1100" n="1004" xml:id="pg1004"/>

                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >District and Port of New York</hi>,<lb/><hi rendition="#italic"
                                >Collector’s Office.</hi></placeName></dateline></opener>
                <p>I hereby certify the within to be a true copy of the original on record in this
                    office.</p>
                <closer>
                    <dateline rendition="#float-left">Given under my hand and seal <date
                            calendar="gregorian" when="1874-11-18">this 18th day of November,
                            1873</date>.</dateline>
                    <lb/> [<hi rendition="#small-caps">seal.</hi>]<lb/><signed>R. WYNKOOP,<lb/><hi
                            rendition="#italic">Deputy Collector.</hi></signed></closer>
                <postscript>
                    <p>F. W. J. S.</p>
                    <p>Fees 50 cents.</p>
                    <p>G.</p>
                </postscript>
            </div>
