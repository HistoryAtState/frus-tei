    <text>
        <body>
            <div xml:id="d715-a1-a2-a2">

                <pb facs="1099" n="1003" sameAs="frus:frus1874/pg1003"/>

                <p>I, F. E. Shepperd, the present master of the above-mentioned vessel, do solemnly
                    swear that I am a citizen of the United States, having been born in Forsyth
                    County, State of North Carolina.</p>
                <closer><signed>F. E. SHEPPERD.</signed></closer>
                <closer><dateline rendition="#float-left">Sworn to <date calendar="gregorian"
                            when="1870-10-04">this 4th day of October, 1870</date>.</dateline>
                    <signed>W. A. MORRIS,<lb/><hi rendition="#italic">Deputy
                        Collector.</hi></signed></closer>
            </div>
        </body>
    </text>
