    <text>
        <body>
            <div xml:id="d700">

                <pb facs="1078" n="982" sameAs="frus:frus1874/pg982"/>

                <head>No. 698.<lb/><hi rendition="#italic">Admiral Polo to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of Spain</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1873-11-23"><hi rendition="#italic">November</hi> 23,
                        1873</date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Fish</hi>: I beg to inclose copy of a
                    telegram I have just received. I do not expect to receive any answer to my
                    telegram of yesterday relating to our conference before to-morrow.</p>
                <p>Not wishing to trouble you with a new call, I send you these lines.</p>
                <p>Yours, &amp;c,</p>
                <closer><signed>JOSÉ POLO DE BERNABÉ.</signed></closer>


                <xi:include href="d700-a1.xml" xpointer="d700-a1"/>
            </div>
