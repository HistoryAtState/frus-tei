    <text>
        <body>
            <div xml:id="d556">

                <pb facs="0966" n="870" sameAs="frus:frus1874/pg870"/>

                <head>No. 554.<lb/><hi rendition="#italic">Mr. Fish
                        to Mr. Cushing.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1874-03-04"><hi rendition="#italic">March</hi> 4,
                        1874</date>.</dateline>
                    <seg rendition="#float-left">No. 5.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose, herewith, for your information,
                    a copy of a dispatch of the 12th ultimo, No. 43, and of its accompaniments from
                    Mr. Hall, consul-general of the United States at Havana, relating to the decree
                    of the captain-general of the island of Cuba, declaring that island to be in a
                    state of siege.</p>
                <p>I am, &amp;c,</p>
                <closer><signed>HAMILTON FISH.</signed></closer>


                <xi:include href="d556-a1.xml" xpointer="d556-a1"/>
            </div>
        </body>
    </text>
