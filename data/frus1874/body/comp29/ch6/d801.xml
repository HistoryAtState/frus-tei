    <text>
        <body>
            <div xml:id="d801">

                <pb facs="1288" n="1192" sameAs="frus:frus1874/pg1192"/>

                <head>No. 798.<lb/><hi rendition="#italic">Mr. Beardsley to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Agency and Consulate-General of the United States in
                                Egypt</hi>,<lb/><hi rendition="#italic">Cairo</hi></placeName>,
                            <date calendar="gregorian" when="1874-06-01"><hi rendition="#italic"
                                >June</hi> 1, 1874</date>. (Received June 30.)</dateline>
                    <seg rendition="#float-left">No. 202.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith copies
                    in French and English of my communication to the minister of justice,
                    announcing, in obedience to your instruction No. 120, of the 28th ultimo, that
                    the President is prepared to accept, for citizens of the United States in Egypt,
                    the jurisdiction of the new tribunals so soon as he shall receive information of
                    their organization.</p>
                <p>I am, &amp;c,</p>
                <closer><signed>R. BEARDSLEY.</signed></closer>


                <xi:include href="d801-a1.xml" xpointer="d801-a1"/>
            </div>
        </body>
    </text>
