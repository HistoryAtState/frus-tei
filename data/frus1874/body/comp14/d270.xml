    <text>
        <body>
            <div xml:id="d270">

                <pb facs="0548" n="452" sameAs="frus:frus1874/pg452"/>

                <head>No. 268.<lb/><hi rendition="#italic">Mr. Nicholas
                            Fish to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Legation</hi>,<lb/><hi rendition="#italic"
                                >Berlin</hi></placeName>, <date calendar="gregorian"
                            when="1874-07-20"><hi rendition="#italic">July</hi> 20, 1874</date>.
                        (Received August 6.)</dateline>
                    <seg rendition="#float-left">No. 6.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose a translation
                    of the acknowledgment from the secretary of state of the note which I addressed
                    to Prince Bismarck relative to his attempted assassination.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>NICHOLAS FISH.</signed></closer>


                <xi:include href="d270-a1.xml" xpointer="d270-a1"/>
            </div>
