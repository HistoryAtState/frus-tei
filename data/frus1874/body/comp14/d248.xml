    <text>
        <body>
            <div xml:id="d248">

                <pb facs="0528" n="432" sameAs="frus:frus1874/pg432"/>

                <head>No. 246.<lb/><hi rendition="#italic">Mr. Fish
                        to Mr. Bancroft.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1873-11-03"><hi rendition="#italic">November</hi> 3,
                        1873</date>.</dateline>
                    <seg rendition="#float-left">No. 626.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    No. 527, of the 6th ultimo, inclosing copy of a communication addressed by you
                    to the minister for foreign affairs relating to the expulsion of emigration
                    agents from German territory, and to request that the Department may be informed
                    of the particulars connected with the expulsion from near Saar-burg of the three
                    persons referred to in your dispatch.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>HAMILTON FISH.</signed></closer>
            </div>
        </body>
    </text>
