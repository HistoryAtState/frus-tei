    <text>
        <body>
            <div xml:id="d489">

                <pb facs="0850" n="754" sameAs="frus:frus1874/pg754"/>

                <head>No. 487.<lb/><hi rendition="#italic">Mr. Fish
                        to Mr. Foster.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1874-08-07"><hi rendition="#italic">August</hi> 7,
                        1874</date>.</dateline>
                    <seg rendition="#float-left">No. 126.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: It affords me pleasure to transmit the
                    inclosed copy of a communication of the 5th instant, from the Secretary of the
                    Navy, making acknowledgments for the valuable assistance rendered to
                    Lieutenant-Commander F. M. Green, of the United States Navy, in his recent
                    surveys on the coast of Mexico, by General Mejia and yourself.</p>
                <p>You will be pleased to convey to the minister of war and marine a copy of the
                    letter of the Acting Secretary of the Navy, and of its accompaniment, through
                    the minister for foreign affairs.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>HAMILTON FISH.</signed></closer>



                <xi:include href="d489-a1.xml" xpointer="d489-a1"/>
                <xi:include href="d489-a2.xml" xpointer="d489-a2"/>
