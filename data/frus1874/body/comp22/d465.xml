    <text>
        <body>
            <div xml:id="d465">

                <pb facs="0824" n="728" sameAs="frus:frus1874/pg728"/>

                <head>No. 463.<lb/><hi rendition="#italic">Mr. Fish to Mr. Foster.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1874-01-29"><hi rendition="#italic">January</hi> 29,
                        1874</date>.</dateline>
                    <seg rendition="#float-left">No. 71.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your dispatch, No. 93, of the 14th instant,
                    relative to Mexican bonds held by citizens of the United States, has been
                    received.</p>
                <p>The statement of those bonds promised to you by Mr. Mejia, the minister of
                    finance of Mexico, will be awaited with interest.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>HAMILTON FISH.</signed></closer>
            </div>
        </body>
    </text>
