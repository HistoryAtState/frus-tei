    <text>
        <body>
            <div xml:id="d472-a2">

                <pb facs="0831" n="735" sameAs="frus:frus1874/pg735"/>

                <opener><seg rendition="#center">[Inclosure in inclosure in No. 119.]</seg></opener>
                <head><hi rendition="#italic">Mr. Watkins to Mr. Foster.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Guadalajara</hi></placeName>, <date calendar="gregorian"
                            when="1874-03-02T14:20:00-06:36"><hi rendition="#italic">March</hi> 2,
                            1874—2.20 p.m.</date></dateline></opener>
                <p rendition="#center"><hi rendition="#small-caps">telegrams on the murder of mr.
                        stephens.</hi></p>
                <p rendition="#flush">No 1.]</p>
                <p rendition="#flush"><hi rendition="#italic">To the American Minister:</hi></p>
                <p>In Ahualulco they have assassinated the American citizen Stephens.</p>
                <closer><signed>WATKINS.</signed></closer>
            </div>
        </body>
