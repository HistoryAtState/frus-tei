    <text>
        <body>
            <div xml:id="d472-a3">

                <pb facs="0831" n="735" sameAs="frus:frus1874/pg735"/>

                <head><hi rendition="#italic">Mr. Foster to Mr. Watkins.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1874-03-02"><hi rendition="#italic">March</hi> 2,
                        1874.</date></dateline>
                    <seg rendition="#float-left">No. 2.]</seg></opener>
                <p rendition="#flush"><hi rendition="#italic">D. J. Watkins, Guadalajara:</hi></p>
                <p>Send by telegraph brief particulars of the murder of Stephens.</p>
                <closer><signed>JOHN W. FOSTER,<lb/><hi rendition="#italic">American
                        Minister.</hi></signed></closer>
            </div>
        </body>
