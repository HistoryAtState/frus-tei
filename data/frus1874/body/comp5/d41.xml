        <body>
            <div xml:id="d41">

                <pb facs="0150" n="54" sameAs="frus:frus1874/pg54"/>

                <head>No. 39.<lb/><hi rendition="#italic">Mr. Jones
                        to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Brussels</hi></placeName>, <date calendar="gregorian"
                            when="1873-12-28"><hi rendition="#italic">December</hi> 28, 1873</date>.
                        (Received Jan. 15, 1874.)</dateline>
                    <seg rendition="#float-left">No. 218.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your dispatch of the 10th instant, No. 148, and to inclose herewith copy of a
                    bill introduced by the government relative to the transportation of
                    emigrants.</p>
                <p>Very respectfully, &amp;c.,</p>
                <closer><signed>J. R. JONES.</signed></closer>


                <xi:include href="d41-a1.xml" xpointer="d41-a1"/>
