    <text>
        <body>
            <div xml:id="d42">

                <pb facs="0152" n="56" xml:id="pg56"/>

                <head>No. 40.<lb/><hi rendition="#italic">Mr. Jones
                        to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Brussels</hi></placeName>, <date calendar="gregorian"
                            when="1874-03-18"><hi rendition="#italic">March</hi> 18, 1874</date>.
                        (Received April 4.)</dateline>
                    <seg rendition="#float-left">No. 229.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: The Moniteur Beige, official organ the
                    government, of yesterday’s date, publishes the law recently adopted in regard to
                    extradition, a copy of which I inclose herewith.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>J. R. JONES.</signed></closer>


                <xi:include href="d42-a1.xml" xpointer="d42-a1"/>
            </div>
