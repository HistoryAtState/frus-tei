    <text>
        <body>
            <div xml:id="d212">

                <pb facs="0489" n="393" sameAs="frus:frus1874/pg393"/>

                <head>No. 210.<lb/><hi rendition="#italic">Mr. Wing to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Legation</hi>,<lb/><hi rendition="#italic">Quito,
                                Ecuador</hi></placeName>, <date calendar="gregorian"
                            when="1873-12-30"><hi rendition="#italic">December</hi> 30, 1873</date>.
                        (Received Feb. 5, 1874.)</dateline>
                    <seg rendition="#float-left">No. 359.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: As evincing the intense Catholicism
                    prevailing in this country, I herewith forward original and translation (1 and
                    2) of an enactment of the late congress.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>RUMSEY WING.</signed></closer>


                <xi:include href="d212-a1.xml" xpointer="d212-a1"/>
            </div>
        </body>
