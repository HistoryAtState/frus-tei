        <body>
            <div xml:id="d528-a1">

                <pb facs="0931" n="835" sameAs="frus:frus1874/pg835"/>

                <opener><seg rendition="#center">[Inclosure.]</seg></opener>
                <head><hi rendition="#italic">Statement of Bassian debt January</hi> 1, 1872.</head>
                <p rendition="#center"><hi rendition="#small-caps">i. Consolidated debt.</hi></p>
                <table cols="4" rows="12">
                    <row>
                        <cell/>
                        <cell cols="3" role="num">I. Payable at fixed term:</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell/>
                        <cell>Rubles.</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell role="num">I.</cell>
                        <cell>Internal</cell>
                        <cell role="num">157,718,126</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell role="num">II.</cell>
                        <cell>External</cell>
                        <cell rendition="#border-bottom" role="num">272,420,400</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell/>
                        <cell/>
                        <cell/>
                        <cell role="num">430,138,526</cell>
                    </row>
                    <pb facs="0932" n="836" xml:id="pg836"/>
                    <row>
                        <cell/>
                        <cell>II. Without term:</cell>
                        <cell>Rubles.</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell role="num">I.</cell>
                        <cell>Internal</cell>
                        <cell role="num">281,479,475</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell role="num">II.</cell>
                        <cell>External</cell>
                        <cell rendition="#border-bottom" role="num">202,714,965</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell/>
                        <cell/>
                        <cell/>
                        <cell rendition="#border-bottom" role="num">484,194,440</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell>Total</cell>
                        <cell/>
                        <cell role="num">914,332,966</cell>
                    </row>
                    <row>
                        <cell cols="3">This was reduced in 1872 by (1) 1,523,000, Holland florins
                            £567,000. (2) 1,907,760 metallic rubles, and (3) 6,380,827 paper
                            rubles</cell>
                        <cell rendition="#border-bottom #bottom" role="num">13,456,266</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell cols="2">Consolidated debt 1st January, 1873</cell>
                        <cell role="num">900,876,700</cell>
                    </row>
                </table>
                <p rendition="#center"><hi rendition="#small-caps">ii. Uninscribed debt.</hi></p>
                <table cols="4" rows="3">
                    <row>
                        <cell cols="2">January 1, 1872</cell>
                        <cell role="num">463,673,009</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell cols="2">Increased in 1872 by</cell>
                        <cell rendition="#border-bottom" role="num">101,134,266</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell/>
                        <cell/>
                        <cell/>
                        <cell role="num">564,807,275</cell>
                    </row>
                </table>
                <p rendition="#center"><hi rendition="#small-caps">iii. Circulation of Imperial
                        Bank.</hi></p>
                <table cols="4" rows="5">
                    <row>
                        <cell cols="2">January 1, 1873</cell>
                        <cell role="num">724,214,040</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell cols="2">Less coin</cell>
                        <cell rendition="#border-bottom" role="num">158,127,643</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell/>
                        <cell/>
                        <cell/>
                        <cell rendition="#border-bottom" role="num">566,086,397</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell>Total amount of dept January 1, 1873</cell>
                        <cell/>
                        <cell role="num">2,031,770,372</cell>
                    </row>
                    <row>
                        <cell cols="2">Or $1,354,513,582.</cell>
                        <cell/>
                        <cell/>
                    </row>
                </table>
            </div>
