    <text>
        <body>
            <div xml:id="d161-a2">

                <pb facs="0419" n="323" sameAs="frus:frus1874/pg323"/>

                <opener><seg rendition="#center">[Inclosure 2 in No. 766.]</seg></opener>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <head><hi rendition="#italic">Mr. Seward to Mr. Henderson.</hi></head>
                <p rendition="#flush"><hi rendition="#small-caps">Henderson</hi>, <hi
                        rendition="#italic">Amoy:</hi></p>
                <p>Answer the Viceroy in a very friendly way, but avoid assuming any
                    prerogative.</p>
                <closer><signed>SEWARD.</signed>
                    <lb/>
                    <dateline rendition="#float-left"><placeName><hi rendition="#small-caps"
                                >Shanghai</hi></placeName>, <date calendar="gregorian"
                            when="1874-06-20"><hi rendition="#italic">June</hi> 20,
                        1874</date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
