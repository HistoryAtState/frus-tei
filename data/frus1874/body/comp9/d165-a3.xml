    <text>
        <body>
            <div xml:id="d165-a3">

                <pb facs="0427" n="331" sameAs="frus:frus1874/pg331"/>

                <opener><seg rendition="#center">[Telegram No. 89.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Amoy</hi></placeName>, <date calendar="gregorian"
                            when="1874-08-06T11:30:00+08:05">6, 8, 1874,
                    11.30</date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Seward</hi>, <hi
                        rendition="#italic">Shanghai:</hi></p>
                <p>Le Gendre is under arrest. What shall I do with him?</p>
                <closer><signed>HENDERSON</signed>, [<hi rendition="#small-caps"
                    >seal.</hi>]</closer>
            </div>
        </body>
    </text>
