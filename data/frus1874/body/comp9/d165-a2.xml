    <text>
        <body>
            <div xml:id="d165-a2">

                <pb facs="0427" n="331" sameAs="frus:frus1874/pg331"/>

                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Shanghai</hi></placeName>, <date calendar="gregorian"
                            when="1874-08-05"><hi rendition="#italic">August</hi> 5,
                        1874</date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Henderson</hi>, <hi
                        rendition="#italic">Amoy:</hi></p>
                <p>Arrest Le Gendre, if possible, without collision with Japanese. Advise and ask
                    aid Stanton and Chinese. Report.</p>
                <closer><signed>SEWARD</signed>, [<hi rendition="#small-caps">seal.</hi>]</closer>
            </div>
        </body>
