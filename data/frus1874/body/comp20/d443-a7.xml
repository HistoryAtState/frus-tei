    <text>
        <body>
            <div xml:id="d443-a7">

                <pb facs="0792" n="696" sameAs="frus:frus1874/pg696"/>

                <opener><seg rendition="#center">[Inclosure 7 in No. 108.]</seg></opener>
                <head><hi rendition="#italic">Mr. Bland to Mr. Robertson.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Yokohama</hi></placeName>, <date calendar="gregorian"
                            when="1874-08-05"><hi rendition="#italic">August</hi> 5,
                        1874</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I consider the rate of bank-bills on London
                    at sight, to-day, to be 4<hi rendition="#italic">s</hi>. 1¼<hi
                        rendition="#italic">d</hi>. per dollar.</p>
                <p>Yours, faithfully,</p>
                <closer><signed>CHARLES S. BLAND.</signed></closer>
            </div>
        </body>
    </text>
