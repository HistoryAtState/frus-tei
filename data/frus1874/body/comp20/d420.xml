    <text>
        <body>
            <div xml:id="d420">

                <pb facs="0755" n="659" sameAs="frus:frus1874/pg659"/>

                <head>No. 418.<lb/><hi rendition="#italic">Mr. Bingham to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Legation, Japan</hi>,<lb/><hi rendition="#italic"
                                >Yokohama</hi></placeName>, <date calendar="gregorian"
                            when="1874-01-12"><hi rendition="#italic">January</hi> 12, 1874</date>.
                        (Received February 21.)</dateline>
                    <seg rendition="#float-left">No. 41.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith a
                    copy of the speech of felicitation addressed to the Tenno by the diplomatic
                    body, through their dean, Sir Harry S. Parkes, at the audience granted them by
                    His Majesty on New Year’s day, and also a copy of the Tenno’s reply.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>JNO. A. BINGHAM.</signed></closer>



                <xi:include href="d420-a1.xml" xpointer="d420-a1"/>
                <xi:include href="d420-a2.xml" xpointer="d420-a2"/>
