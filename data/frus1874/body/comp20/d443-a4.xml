    <text>
        <body>
            <div xml:id="d443-a4">

                <pb facs="0792" n="696" sameAs="frus:frus1874/pg696"/>

                <opener><seg rendition="#center">[Inclosure 4 in No. 108.]</seg></opener>
                <head><hi rendition="#italic">Mr. Robertson to Mr.
                            Bingham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Oriental Bank Corporation</hi>,<lb/><hi rendition="#italic"
                                >Yokohama</hi></placeName>, <date calendar="gregorian"
                            when="1874-08-01"><hi rendition="#italic">August</hi> 1,
                        1874</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Sir</hi>: I beg to advise having credited your
                    account as minister of the United States with the sum of $125,000, being amount
                    received from the Japanese minister for foreign affairs.</p>
                <p>Yours, faithfully,</p>
                <closer><signed>J. ROBERTSON,<lb/><hi rendition="#italic"
                    >Agent.</hi></signed></closer>
            </div>
        </body>
    </text>
