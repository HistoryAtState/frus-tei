    <text>
        <body>
            <div xml:id="d412">

                <pb facs="0748" n="652" sameAs="frus:frus1874/pg652"/>

                <head>No. 410.<lb/><hi rendition="#italic">Mr. Bingham to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Legation, Japan</hi>,<lb/><hi rendition="#italic"
                                >Yokohama</hi></placeName>, <date calendar="gregorian"
                            when="1873-10-21"><hi rendition="#italic">October</hi> 21, 1873</date>.
                        (Received November 20.)</dateline>
                    <seg rendition="#float-left">No. 8.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: On the 14th instant His Majesty the Tenno
                    granted an audience to Mr. C. W. Brooks, an account of which is herewith
                    inclosed.</p>
                <p>This manifestation of regard to an American citizen I think it proper to make a
                    matter of record.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>JNO. A. BINGHAM.</signed></closer>


                <xi:include href="d412-a1.xml" xpointer="d412-a1"/>
            </div>
