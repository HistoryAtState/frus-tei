    <text>
        <body>
            <div xml:id="d448-a6">

                <pb facs="0800" n="704" sameAs="frus:frus1874/pg704"/>

                <opener><seg rendition="#center">[Inclosure 3 in No. 110.]</seg></opener>
                <head><hi rendition="#italic">Mr. Moore to Mr. Turner.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                            >Monrovia</hi></placeName>, <date calendar="gregorian" when="1874-03-06"
                                ><hi rendition="#italic">March</hi> 6,
                    1874</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge your
                    communication of the 3d instant, and to forward herein, in compliance with your
                    request, a copy of the opinion of the supreme court of the republic on the
                    question propounded to it by the house of representatives. With assurances of
                    the highest consideration and regard,</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>J. E. MOORE.</signed></closer>
            </div>
        </body>
