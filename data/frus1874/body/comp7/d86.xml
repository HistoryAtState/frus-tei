    <text>
        <body>
            <div xml:id="d86">

                <pb facs="0225" n="129" sameAs="frus:frus1874/pg129"/>

                <head>No. 84.<lb/><hi rendition="#italic">Mr. Williamson to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Legation in Central America</hi>,<lb/><hi
                                rendition="#small-caps">Punta Arenas, Costa
                            Rica</hi></placeName>,<lb/><date calendar="gregorian" when="1873-12-14"
                                ><hi rendition="#italic">December</hi> 14, 1873</date>. (Received
                        February 5, 1874.)</dateline>
                    <seg rendition="#float-left">No. 76.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose you herewith
                    copies of correspondence with the minister of foreign affairs of Nicaragua, in
                    regard to the proposed sale of the American steamship Montijo to President
                    Guardia, of Costa Rica. I expect to leave on the steamer to-day for
                    Guatemala.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>GEO. WILLIAMSON.</signed></closer>




                <xi:include href="d86-a1.xml" xpointer="d86-a1"/>
                <xi:include href="d86-a2.xml" xpointer="d86-a2"/>
