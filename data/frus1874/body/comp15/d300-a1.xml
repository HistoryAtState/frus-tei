    <text>
        <body>
            <div xml:id="d300-a1">

                <pb facs="0594" n="498" sameAs="frus:frus1874/pg498"/>

                <opener><seg rendition="#center">[Inclosure 1 in No. 452.]</seg></opener>
                <head><hi rendition="#italic">Earl Granville to General Schenck.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Foreign Office</hi></placeName>, <date calendar="gregorian"
                            when="1874-02-21"><hi rendition="#italic">February</hi> 21,
                        1874</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inform you that the
                    Queen has been graciously pleased to accept my resignation of the office of Her
                    Majesty’s principal secretary of state for foreign affairs, and to confer the
                    seals of that department upon the Earl of Derby.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>GRANVILLE.</signed></closer>
            </div>
        </body>
    </text>
