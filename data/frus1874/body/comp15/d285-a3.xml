    <text>
        <body>
            <div xml:id="d285-a3">

                <pb facs="0576" n="480" sameAs="frus:frus1874/pg480"/>

                <opener><seg rendition="#center">[Inclosure 3 in No. 472.]</seg></opener>
                <head><hi rendition="#italic">Lord Granville to General Schenck.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Foreign Office</hi></placeName>, <date calendar="gregorian"
                            when="1873-06-02"><hi rendition="#italic">June</hi> 2,
                        1873</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have had the honor to receive your note
                    of the 27th ultimo, relating to the alleged deportation of released convicts
                    from this country to the United States, and I have lost no time in referring the
                    matter to Her Majesty’s secretary of state for the home department.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>GRANVILLE.</signed></closer>
            </div>
        </body>
