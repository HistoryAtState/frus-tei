    <text>
        <body>
            <div xml:id="d319">

                <pb facs="0646" n="550" sameAs="frus:frus1874/pg550"/>

                <head>No. 317.<lb/><hi rendition="#italic">Sir Edward Thornton to Mr.
                    Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1874-03-10"><hi rendition="#italic">March</hi> 10, 1874</date>.
                        (Received March 11.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In compliance with an instruction, which I
                    have received from Earl Granville, I have the honor to inclose, for the
                    information of the government of the United States, copies of two instructions
                    which have been addressed by his lordship to Her Majesty’s minister at Madrid,
                    on the subject of the proposed blockade, by the Spanish government, of the
                    northern coast of Spain.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>EDW’D THORNTON.</signed></closer>



                <xi:include href="d319-a1.xml" xpointer="d319-a1"/>
                <xi:include href="d319-a2.xml" xpointer="d319-a2"/>
