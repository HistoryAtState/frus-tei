    <text>
        <body>
            <div xml:id="d307">

                <pb facs="0610" n="514" xml:id="pg514"/>

                <head>No. 305.<lb/><hi rendition="#italic">Mr. Moran to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1874-05-30"><hi rendition="#italic">May</hi> 30, 1874</date>.
                        (Received June 12.)</dateline>
                    <seg rendition="#float-left">No. 504.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: For the future use of the Department I have
                    the honor to send herewith a copy of the London Gazette of last evening, May 29,
                    1874, containing an official notice that the blockade of the Gold Coast,
                    established December 15, 1873, was raised on the 17th of April, 1874.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>BENJAMIN MORAN.</signed></closer>


                <xi:include href="d307-a1.xml" xpointer="d307-a1"/>
            </div>
