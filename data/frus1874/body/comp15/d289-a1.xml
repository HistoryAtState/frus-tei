            <div xml:id="d289-a1">

                <pb facs="0583" n="487" sameAs="frus:frus1874/pg487"/>

                <opener><seg rendition="#center">[Inclosure 1 in No. 483.]</seg></opener>
                <head><hi rendition="#italic">Mr. Ryalls to General
                            Schenck.</hi></head>
                <p rendition="#center"><hi rendition="#small-caps">national association for the
                        promotion of social science, with which is united the society for promoting
                        the amendment of the law.</hi></p>
                <p>1 <hi rendition="#small-caps">Adam Street, Adelphia, W. C.</hi>, <hi
                        rendition="#italic">September</hi> 2, 1873.</p>
                <p><hi rendition="#small-caps">Sir</hi>: I am directed by the council to inform you
                    that the sum of £300 has been offered through this association for the best
                    essay on the subject of a code of public international law, of which the
                    inclosed are the conditions, and to request that you will kindly favor them by
                    making the same known to your Government with a view to publicity in
                    America.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>C. W. RYALLS,<lb/><hi rendition="#italic">General
                        Secretary</hi>.</signed></closer>
            </div>
        </body>
