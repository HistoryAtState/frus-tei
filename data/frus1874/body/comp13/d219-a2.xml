            <div xml:id="d219-a2">

                <pb facs="0497" n="401" sameAs="frus:frus1874/pg401"/>

                <opener><seg rendition="#center">[Inclosure in inclosure No.
                        851.—Translation.]</seg></opener>
                <head><hi rendition="#italic">Statement of coinage for</hi> 1871 <hi
                        rendition="#italic">and</hi> 1872.</head>
                <table cols="9" rows="4">
                    <row role="label">
                        <cell rendition="#border-bottom #border-top #border-right" rows="2"
                            >Year</cell>
                        <cell rendition="#border-bottom #border-top #border-right"><hi
                                rendition="#small-caps">gold.</hi></cell>
                        <cell cols="4" rendition="#border-bottom #border-top #border-right"><hi
                                rendition="#small-caps">silver.</hi></cell>
                        <cell cols="3" rendition="#border-bottom #border-top"><hi
                                rendition="#small-caps">bronze.</hi></cell>
                    </row>
                    <row>
                        <cell rendition="#border-bottom #border-top #border-right">20 francs.</cell>
                        <cell rendition="#border-bottom #border-top #border-right">5 francs.</cell>
                        <cell rendition="#border-bottom #border-top #border-right">2 francs.</cell>
                        <cell rendition="#border-bottom #border-top #border-right">1 franc.</cell>
                        <cell rendition="#border-bottom #border-top #border-right">50
                            centimes.</cell>
                        <cell rendition="#border-bottom #border-top #border-right">10
                            centimes</cell>
                        <cell rendition="#border-bottom #border-top #border-right">5
                            centimes.</cell>
                        <cell rendition="#border-bottom #border-top">1 centime.</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">1871</cell>
                        <cell rendition="#border-right" role="num">50,169,880</cell>
                        <cell rendition="#border-right" role="num">4,710,905</cell>
                        <cell rendition="#border-right" role="num">15,456,574</cell>
                        <cell rendition="#border-right" role="num">4,261,629</cell>
                        <cell rendition="#border-right" role="num">479,591<hi
                                rendition="#superscript">f</hi>.50</cell>
                        <cell rendition="#border-right" role="num">186,640<hi
                                rendition="#superscript">f</hi>.50</cell>
                        <cell rendition="#border-right" role="num">112,695<hi
                                rendition="#superscript">f</hi>.15</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell rendition="#border-right #border-bottom">1872</cell>
                        <cell rendition="#border-right #border-bottom"/>
                        <cell rendition="#border-right #border-bottom" role="num">389,190</cell>
                        <cell rendition="#border-right #border-bottom" role="num">7,547,588</cell>
                        <cell rendition="#border-right #border-bottom" role="num">15,957,333</cell>
                        <cell rendition="#border-right #border-bottom" role="num">2,943,258<hi
                                rendition="#superscript">f</hi>.50</cell>
                        <cell rendition="#border-right #border-bottom" role="num">875,751<hi
                                rendition="#superscript">f</hi>.60</cell>
                        <cell rendition="#border-right #border-bottom" role="num">416,361<hi
                                rendition="#superscript">f</hi>.30</cell>
                        <cell rendition="#border-bottom" role="num">20,000<hi
                                rendition="#superscript">f</hi></cell>
                    </row>
                </table>
