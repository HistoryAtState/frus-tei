                <pb facs="0213" n="203" sameAs="frus:frus1919Parisv03/pg203"/>

                <head>Annex 5</head>
                <p rendition="#center"><hi rendition="#italic">Draft Resolution Relative to
                        International Control of Ports, Waterways, and Railways</hi></p>
                <p>That a Commission, composed of two representatives apiece from the five Great
                    Powers and five representatives to be elected by the other Powers, be appointed
                    to inquire into and report on:</p>
                <p>International control of ports, waterways and railways.</p>
                <closer>
                    <dateline rendition="#float-left">
                        <date calendar="gregorian" when="1919-01-25"><hi rendition="#small-caps"
                                >January</hi> 25, 1919</date>.</dateline>
                </closer>
            </div>
        </body>
