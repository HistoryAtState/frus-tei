            <div xml:id="d1014">

                <pb facs="1152" n="1008" sameAs="frus:frus1929v02/pg1008"/>

                <note rend="inline" type="source">851.4061 Motion Pictures/51</note>
                <head><hi rendition="#italic">The Chargé in France</hi> (<hi rendition="#italic"
                        >Armour</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1929-04-19">April 19, 1929</date>.<lb/>[Received April
                        29.]</dateline>
                    <seg rendition="#float-left">No. 9487</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to the Department’s
                    telegraphic instructions Nos. 86 of March 28 and 107 of April 11,<anchor n="28"
                        xml:id="d1014-f1"/> and to my telegram No. 161 of this date, I have the
                    honor to transmit herewith, in copy and translation, a note from the Foreign
                    Office, dated April 18 and received this morning, in reply to our
                    representations concerning restrictive film regulations.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Norman Armour</hi></signed></closer>



                <xi:include href="d1014-a1.xml" xpointer="d1014-a1"/>
            </div>
        </body>
    </text>
