            <div xml:id="d566-a2">

                <pb facs="0689" n="545" sameAs="frus:frus1929v02/pg545"/>

                <opener><seg rendition="#center">[Annex 2]</seg></opener>
                <head><hi rendition="#italic">The Chinese Legation to the Department of
                    State</hi></head>
                <list>
                    <label>1.</label>
                    <item>The Chinese Government to take into its service for a period of 3 years a
                        member of foreign legal counsellors, nationals of countries not now enjoying
                        consular jurisdiction in China.</item>
                    <label>2.</label>
                    <item>These legal counsellors to be Chinese officials serving under the Judicial
                        Council, and stationed at Shanghai, Canton, Hankow, Tientsin, and
                        Harbin.</item>
                    <label>3.</label>
                    <item>Their duties to be: <list>
                            <label>(<hi rendition="#italic">a</hi>)</label>
                            <item>To observe, without power of interference, the working of Chinese
                                courts and report their observations to the Judicial Council;</item>
                            <label>(<hi rendition="#italic">b</hi>)</label>
                            <item>To receive complaints regarding the administration of justice with
                                a view to bringing them to the notice of the Judicial Council in
                                order to ensure the strict observance of the Chinese law;</item>
                            <pb facs="0690" n="546" xml:id="pg546"/>
                            <label>(<hi rendition="#italic">c</hi>)</label>
                            <item>To make to the Judicial Council such suggestions and
                                recommendations as they may think proper for the improvement of the
                                laws and their administration.</item>
                        </list></item>
                </list>
            </div>
        </body>
