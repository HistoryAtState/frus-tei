    <text>
        <body>
            <div xml:id="d748">

                <pb facs="0893" n="749" sameAs="frus:frus1929v02/pg749"/>

                <note rend="inline" type="source">893.05/171</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">MacMurray</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peiping</hi></placeName>, <date calendar="gregorian"
                            when="1929-09-23">September 23, 1929</date>.<lb/>[Received October
                        25.]</dateline>
                    <seg rendition="#float-left">No. 2341</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to enclose a copy of a
                    despatch, No. 6132, of September 12, 1929, from the American Consulate General
                    at Shanghai, together with a copy of the Legation’s instruction in reply, of
                    to-day’s date,<anchor n="40" xml:id="d748-f1"/> in regard to the appearance of
                    American consular officers in Chinese courts. The Legation is in general
                    agreement with the attitude adopted by the Consul General at Shanghai, and would
                    particularly invite the Department’s attention to the constructive suggestion in
                    the last paragraph of the despatch mentioned.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">J. V. A.
                    MacMurray</hi></signed></closer>




                <xi:include href="d748-a1.xml" xpointer="d748-a1"/>
                <xi:include href="d748-a2.xml" xpointer="d748-a2"/>
            </div>
        </body>
    </text>
    <standOff>
