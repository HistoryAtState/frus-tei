            </note>
            <note corresp="#d751-f2" n="50" xml:id="d751-f2-content">
                <p>Clarence E. Gauss, Consul General at Tientsin.</p>
            </note>
            <note corresp="#d751-f3" n="51" xml:id="d751-f3-content">
                <p>Charles James Fox, American citizen and editor-publisher of the <hi
                        rendition="#italic">North China Star</hi> (American), Tientsin.</p>
            </note>
            <note corresp="#d751-f4" n="52" xml:id="d751-f4-content">
                <p>Demaree C. Bess.</p>
            </note>
        </listAnnotation>
