                <pb facs="0912" n="768" sameAs="frus:frus1929v02/pg768"/>

                <note rend="inline" type="source">811.91293/160: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Minister in China</hi> (<hi rendition="#italic"
                            >MacMurray</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1929-07-12T16:00:00-04:00">July 12, 1929—4
                    p.m.</date></dateline></opener>
                <p>229. Your 556, July 10, 7 p.m. Withhold action Abend case until further
                    instructions. After communicating complaint to <hi rendition="#italic">New York
                        Times</hi> Department is awaiting further word from the <hi
                        rendition="#italic">Times</hi>.</p>
                <closer><signed><hi rendition="#small-caps">Stimson</hi></signed></closer>
            </div>
        </body>
    </text>
