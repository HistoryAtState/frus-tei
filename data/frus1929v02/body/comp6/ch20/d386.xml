    <text>
        <body>
            <div xml:id="d386">

                <pb facs="0566" n="422" sameAs="frus:frus1929v02/pg422"/>

                <note rend="inline" type="source">861.77 Chinese Eastern/697: Telegram</note>
                <head><hi rendition="#italic">King Tafari Makonnen
                        of Ethiopia to President Hoover</hi><anchor
                        n="11" xml:id="d386-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Addis Ababa</hi></placeName>, <date calendar="gregorian"
                            when="1929-12-14">December 14, 1929</date>.</dateline></opener>
                <p>We concur in and adhere to the message which you have addressed to the Russian
                    and Chinese Governments asking them to use the provisions of the Kellogg Peace
                    Pact for the solution and settlement of their present difficulties. We are
                    willing that you communicate our message to the Russian and Chinese
                    Government[s].</p>
                <closer><signed><hi rendition="#small-caps">King Tafari
                    Makonnen</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d386-f1" n="11" type="source" xml:id="d386-f1-content">
                <p>Received in the Department of State on December 17, from the White House.</p>
            </note>
        </listAnnotation>
    </standOff>
