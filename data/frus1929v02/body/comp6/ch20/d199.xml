            <div xml:id="d199">

                <pb facs="0448" n="304" sameAs="frus:frus1929v02/pg304"/>

                <note rend="inline" type="source">861.77 Chinese Eastern/273</note>
                <head><hi rendition="#italic">The British Ambassador</hi> (<hi rendition="#italic"
                        >Howard</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1929-08-26">August 26, 1929</date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: In accordance with your
                    wish I enclose herewith copy of the telegram which I have despatched to the
                    Foreign Office today regarding our conversations of this morning and this
                    afternoon.</p>
                <p>Yours very truly,</p>
                <closer><signed><hi rendition="#small-caps">Esme Howard</hi></signed></closer>



                <xi:include href="d199-a1.xml" xpointer="d199-a1"/>
