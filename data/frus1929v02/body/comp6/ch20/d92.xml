    <text>
        <body>
            <div xml:id="d92">

                <pb facs="0344" n="200" xml:id="pg200"/>

                <note rend="inline" type="source">861.77 Chinese Eastern/27: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">MacMurray</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1929-07-11T19:00:00+08:00">July 11, 1929—7
                        p.m.</date><lb/>[Received 11:45 p.m.]</dateline></opener>
                <p>560. My 557, July 11, 3 p.m.<anchor n="76" xml:id="d92-f1"/> Following from
                    American Consul at Harbin: <quote rend="blockquote">
                        <p>“July 11, 11 a.m. Chinese authorities have discharged Soviet general
                            manager of railway, Soviet assistant manager and all Russian heads of
                            departments. Fan Chi-kuan, member of board and also Chinese assistant
                            manager, has taken over chargé as general manager.”</p>
                    </quote></p>
                <closer><signed><hi rendition="#small-caps">MacMurray</hi></signed></closer>
            </div>
        </body>
    </text>
