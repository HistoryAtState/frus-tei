                <pb facs="0336" n="192" xml:id="pg192"/>

                <note rend="inline" type="source">893.00B/587: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >MacMurray</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1929-05-29T12:00:00+08:00">May 29, 1929—noon</date>.<lb/>[Received
                        May 29—10:05 a.m.]</dateline></opener>
                <p>428. Following from American Consul at Harbin: <quote rend="blockquote">
                        <p>“May 28, noon. Chinese police on May 27th raided communistic meeting
                            attended by Soviet Consuls General, Harbin and Mukden, and held at local
                            Soviet Consulate General. About forty arrests made and consular premises
                            thoroughly searched.”</p>
                    </quote></p>
                <closer>For the Minister<lb/><signed><hi rendition="#small-caps"
                        >Perkins</hi></signed></closer>
            </div>
        </body>
