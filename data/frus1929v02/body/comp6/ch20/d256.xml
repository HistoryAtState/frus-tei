                <pb facs="0488" n="344" sameAs="frus:frus1929v02/pg344"/>

                <note rend="inline" type="source">861.77 Chinese Eastern/454: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >MacMurray</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peiping</hi></placeName>, <date calendar="gregorian"
                            when="1929-11-21T12:00:00+08:00">November 21,
                        1929—noon</date>.<lb/>[Received November 21—6 a.m.]</dateline></opener>
                <p>1020. Following from American Consul in charge at Mukden: <quote
                        rend="blockquote">
                        <p>“November 20, 5 a.m. According to confidential information received from
                            official source, Chinese lost 2,000 men killed up to yesterday on the
                            western front. Twenty-seven Soviet aircraft are reported <pb facs="0489"
                                n="345" xml:id="pg345"/> to have dropped more than 300 bombs which
                            did much damage; fighting still continues, with Chinese forces reported
                            to be generally holding their positions.”</p>
                    </quote></p>
                <closer><signed><hi rendition="#small-caps">MacMurray</hi></signed></closer>
            </div>
        </body>
    </text>
