    <text>
        <body>
            <div xml:id="d385">

                <pb facs="0565" n="421" sameAs="frus:frus1929v02/pg421"/>

                <note rend="inline" type="source">861.77 Chinese Eastern/681: Telegram</note>
                <head><hi rendition="#italic">The Minister in Norway</hi> (<hi rendition="#italic"
                        >Swenson</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Oslo</hi></placeName>, <date calendar="gregorian"
                            when="1929-12-14T13:00:00+01:00">December 14, 1929—1
                        p.m.</date><lb/>[Received December 14—11:30 a.m.]</dateline></opener>
                <p>21. Department’s circular of December 5, 4 p.m.<anchor n="10" xml:id="d385-f1"/>
                    After conferring with Foreign Offices of the other Scandinavian countries, the
                    Norwegian <pb facs="0566" n="422" xml:id="pg422"/> Government feels that in view
                    of agreement entered into between Soviet and Chinese Governments the suggested
                    representations would seem inopportune.</p>
                <closer><signed><hi rendition="#small-caps">Swenson</hi></signed></closer>
            </div>
        </body>
    </text>
