            <div xml:id="d183">

                <pb facs="0432" n="288" sameAs="frus:frus1929v02/pg288"/>

                <note rend="inline" type="source">861.77 Chinese Eastern/228</note>
                <head><hi rendition="#italic">The Chinese Minister</hi> (<hi rendition="#italic">C.
                        C. Wu</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1929-08-19">August 19, 1929</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith for
                    the information of your Government a communication from my Government relating
                    to the present controversy between China and the Union of Soviet Socialist
                    Republics.</p>
                <p>Accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Chao-chu Wu</hi></signed></closer>


                <xi:include href="d183-a1.xml" xpointer="d183-a1"/>
