                <pb facs="0418" n="274" sameAs="frus:frus1929v02/pg274"/>

                <note rend="inline" type="source">861.77 Chinese Eastern/193: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Minister in China</hi> (<hi
                            rendition="#italic">MacMurray</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1929-08-09T19:00:00-04:00">August 9, 1929—7
                    p.m.</date></dateline></opener>
                <p>263. Your 688, August 8, 7 p.m. The Department feels that the sending of such a
                    note at this time would only further cloud the situation.</p>
                <closer><signed><hi rendition="#small-caps">Cotton</hi></signed></closer>
            </div>
        </body>
    </text>
