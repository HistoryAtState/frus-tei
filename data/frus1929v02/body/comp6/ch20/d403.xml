                <pb facs="0575" n="431" sameAs="frus:frus1929v02/pg431"/>

                <note rend="inline" type="source">861.77 Chinese Eastern/755: Telegram</note>
                <head><hi rendition="#italic">The Chargé in China</hi> (<hi
                            rendition="#italic">Perkins</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peiping</hi></placeName>, <date calendar="gregorian"
                            when="1929-12-28T13:00:00+08:00">December 28, 1929—1
                        p.m.</date><lb/>[Received December 28—10:35 a.m.]</dateline></opener>
                <p>1196. Legation’s 1185, December 24, noon.<anchor n="17a" xml:id="d403-f1"/>
                    Japanese Embassy in Moscow has been informed by the Soviet Foreign Office that
                    all Soviet troops in Manchuria were withdrawn on December 23rd.</p>
                <closer><signed><hi rendition="#small-caps">Perkins</hi></signed></closer>
            </div>
        </body>
    </text>
