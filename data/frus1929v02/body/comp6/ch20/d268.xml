    <text>
        <body>
            <div xml:id="d268">

                <pb facs="0497" n="353" sameAs="frus:frus1929v02/pg353"/>

                <note rend="inline" type="source">861.77 Chinese Eastern/483: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Chargé in France</hi> (<hi
                            rendition="#italic">Armour</hi>)<anchor n="20"
                        xml:id="d268-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1929-11-27T12:00:00-05:00">November 27,
                        1929—noon</date>.</dateline></opener>
                <p>387. Department’s 384, November 26, 2 p.m.<anchor n="21" xml:id="d268-f2"/> I am
                    adding German Government. Inform Foreign Office.</p>
                <closer><signed><hi rendition="#small-caps">Cotton</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d268-f1" n="20" type="source" xml:id="d268-f1-content">
                <p>The same to the diplomatic representatives in Great Britain (No. 316), Italy (No.
                    74), and Japan (No. 119) (861.77 Chinese Eastern/489, 490, 491).</p>
            </note>
            <note corresp="#d268-f2" n="21" xml:id="d268-f2-content">
                <p>See footnote 16, <ref target="#pg350">p. 350</ref>.</p>
            </note>
        </listAnnotation>
