    <text>
        <body>
            <div xml:id="d255">

                <pb facs="0488" n="344" sameAs="frus:frus1929v02/pg344"/>

                <note rend="inline" type="source">861.77 Chinese Eastern/453: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">MacMurray</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peiping</hi></placeName>, <date calendar="gregorian"
                            when="1929-11-20T15:00:00+08:00">November 20, 1929—3
                        p.m.</date><lb/>[Received November 21—2:55 a.m.]</dateline></opener>
                <p>1011. My 1008, November 15 [<hi rendition="#italic">19</hi>], 5 p.m. Following
                    from American Consul at Harbin: <quote rend="blockquote">
                        <p>“November 19, 3 p.m. Reports of serious Red aeroplane attacks on
                            Chalainor, Tsagan and railway line, of which 30 kilometers destroyed
                            between Chalainor and Hailar and at Mutanchiang, confirmed. On 17th
                            passenger train fired upon, held up, and robbed near Tsagan by Red
                            irregulars. Trains running as far as Horhonte<anchor n="11"
                                xml:id="d255-f1"/>.”</p>
                    </quote></p>
                <closer><signed><hi rendition="#small-caps">MacMurray</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d255-f1" n="11" xml:id="d255-f1-content">
                <p>The same as Heierhungteh.</p>
            </note>
