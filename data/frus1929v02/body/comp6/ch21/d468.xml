                <pb facs="0623" n="479" sameAs="frus:frus1929v02/pg479"/>

                <note rend="inline" type="source">893.00/10552: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">MacMurray</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peiping</hi></placeName>, <date calendar="gregorian"
                            when="1929-10-08T13:00:00+08:00">October 8, 1929—1
                        p.m.</date><lb/>[Received 3:57 p.m.]</dateline></opener>
                <p>867. Following from American Consul General at Hankow: <quote rend="blockquote">
                        <p>“At 10 a.m. Thursday steamship <hi rendition="#italic">Iling</hi> of
                            Yangtze Rapids Steamship Company was fired on by Chinese troops at
                            mileage 219 above Hankow. Ship struck 6 times, but no casualties. I have
                            lodged protest with Commissioner of Foreign Affairs.”</p>
                    </quote></p>
                <closer><signed><hi rendition="#small-caps">MacMurray</hi></signed></closer>
            </div>
        </body>
    </text>
