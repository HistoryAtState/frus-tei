    <text>
        <body>
            <div xml:id="d15">

                <pb facs="0162" n="18" sameAs="frus:frus1929v02/pg18"/>

                <note rend="inline" type="source">711.7412A/13: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Bulgaria</hi> (<hi rendition="#italic"
                        >Kodding</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Sofia</hi></placeName>, <date calendar="gregorian"
                            when="1928-11-22T14:00:00+02:00">November 22, 1928—2
                        p.m.</date><lb/>[Received 3:42 p.m.]</dateline></opener>
                <p>30. Mr. Minkoff<anchor n="5" xml:id="d15-f1"/> informs me that Bulgarian Legation
                    in Washington was instructed yesterday by telegraph to sign the proposed
                    treaties of arbitration and conciliation without modifications.</p>
                <closer><signed><hi rendition="#small-caps">Kodding</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d15-f1" n="5" xml:id="d15-f1-content">
                <p>Secretary General of the Bulgarian Foreign Office.</p>
            </note>
        </listAnnotation>
