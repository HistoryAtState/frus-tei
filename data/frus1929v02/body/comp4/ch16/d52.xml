            <div xml:id="d52">

                <pb facs="0262" n="118" sameAs="frus:frus1929v02/pg118"/>

                <note rend="inline" type="source">711.429 Sanitary/21</note>
                <head><hi rendition="#italic">The Minister in Canada</hi> (<hi
                            rendition="#italic">Phillips</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Ottawa</hi></placeName>, <date calendar="gregorian"
                            when="1929-10-24">October 24, 1929</date>.<lb/>[Received October
                        28.]</dateline>
                    <seg rendition="#float-left">No. 1179</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to the Department’s telegram No.
                    101 of October 23, 12 midnight [<hi rendition="#italic">noon</hi>],<anchor
                        n="76" xml:id="d52-f1"/> on the subject of the proposed agreement between
                    Canada and the United States concerning the quarantine inspection of vessels
                    entering Puget Sound and waters adjacent thereto or the Great Lakes by the St.
                    Lawrence River, I have the honor to enclose herewith the original note No. 132
                    of October 10, 1929, from the Department of External Affairs, together with a
                    signed copy of my note No. 502 of October 23, 1929, to the Canadian Government,
                    on this subject.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">William Phillips</hi></signed></closer>



                <xi:include href="d52-a1.xml" xpointer="d52-a1"/>
                <xi:include href="d52-a2.xml" xpointer="d52-a2"/>
            </div>
