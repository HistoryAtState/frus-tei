    <text>
        <body>
            <div xml:id="d40">

                <pb facs="0229" n="85" sameAs="frus:frus1929v02/pg85"/>

                <note rend="inline" type="source">711.4216C78/9</note>
                <head><hi rendition="#italic">The Minister in Canada</hi> (<hi rendition="#italic"
                        >Phillips</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><seg rendition="#center">[Extract]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Ottawa</hi></placeName>, <date calendar="gregorian"
                            when="1929-06-01">June 1, 1929</date>.<lb/>[Received June 5.]</dateline>
                    <seg rendition="#float-left">No. 1015</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to the Legation’s telegram No.
                    106 of June 1, 4 p.m.<anchor n="54" xml:id="d40-f1"/> in regard to the proposed
                    power development in Passamaquoddy Bay by the Dexter P. Cooper Company,
                    Incorporated, of <pb facs="0230" n="86" xml:id="pg86"/> Eastport, Maine, I have
                    the honor to report that I am in receipt of a <hi rendition="#italic">note
                        verbale</hi> from the Secretary of State for External Affairs on this
                    subject.</p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">William Phillips</hi></signed></closer>


                <xi:include href="d40-a1.xml" xpointer="d40-a1"/>
            </div>
        </body>
    </text>
