    <text>
        <body>
            <div xml:id="d41">

                <pb facs="0231" n="87" sameAs="frus:frus1929v02/pg87"/>

                <note rend="inline" type="source">711.4216C78/20</note>
                <head><hi rendition="#italic">The Minister in Canada</hi> (<hi rendition="#italic"
                        >Phillips</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><seg rendition="#center">[Extract]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Ottawa</hi></placeName>, <date calendar="gregorian"
                            when="1929-09-20">September 20, 1929</date>.<lb/>[Received September
                        25.]</dateline>
                    <seg rendition="#float-left">No. 1135</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to the Department’s instruction
                    No. 583 of July 8, 1929,<anchor n="56" xml:id="d41-f1"/> in regard to the
                    proposed power development in Passama quoddy <pb facs="0232" n="88"
                        xml:id="pg88"/> Bay by Dexter P. Cooper, Incorporated, of Eastport, Maine, I
                    have the honor to report that I am in receipt of a <hi rendition="#italic">note
                        verbale</hi> from the Department of External Affairs conveying the decision
                    of the Canadian Government in the matter.</p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">William Phillips</hi></signed></closer>


                <xi:include href="d41-a1.xml" xpointer="d41-a1"/>
            </div>
        </body>
    </text>
