    <text>
        <body>
            <div xml:id="d33">

                <pb facs="0216" n="72" sameAs="frus:frus1929v02/pg72"/>

                <note rend="inline" type="source">711.428/1282</note>
                <head><hi rendition="#italic">The Minister in Canada</hi> (<hi
                            rendition="#italic">Phillips</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><seg rendition="#center">[Extract]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Ottawa</hi></placeName>, <date calendar="gregorian"
                            when="1929-04-23">April 23, 1929</date>.<lb/>[Received April
                        26.]</dateline>
                    <seg rendition="#float-left">No. 959</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to refer to my
                    confidential telegram No. 53 of April 20, 12 noon,<anchor n="40" xml:id="d33-f1"
                    /> regarding seine fishing in the Missisquoi Bay section of Lake Champlain, and
                    to enclose herewith a copy of a note, No. 38, of April 22, 1929…</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">William Phillips</hi></signed></closer>



                <xi:include href="d33-a1.xml" xpointer="d33-a1"/>
            </div>
        </body>
    </text>
