                <pb facs="1116" n="972" sameAs="frus:frus1929v02/pg972"/>

                <note rend="inline" type="source">711.60i12A/12</note>
                <head><hi rendition="#italic">The Chargé at Riga</hi> (<hi rendition="#italic"
                        >Sussdorff</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Riga</hi></placeName>, <date calendar="gregorian" when="1929-01-02"
                            >January 2, 1929</date>.<lb/>[Received January 18.]</dateline>
                    <seg rendition="#float-left">No. 5805</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my Confidential Despatch No.
                    5683 of November 6, 1928, concerning the views of the Latvian and Estonian
                    Governments regarding drafts of the Treaty of Arbitration and of the Treaty of
                    Conciliation between Latvia and Estonia and the United States, and to the
                    Department’s telegram No. 63, of November 10, 3 p.m., 1928, I now have the honor
                    to transmit herewith copies in quintuplicate of a Note dated December 17, 1928,
                    from the Estonian Ministry of Foreign Affairs concerning the draft Treaty of
                    Arbitration.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Louis Sussdorff</hi>,
                    Jr.</signed></closer>



                <xi:include href="d989-a1.xml" xpointer="d989-a1"/>
            </div>
