    <text>
        <body>
            <div xml:id="d7">

                <pb facs="0155" n="11" sameAs="frus:frus1929v02/pg11"/>

                <note rend="inline" type="source">855.413/18a</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Ambassador in Belgium</hi> (<hi rendition="#italic"
                            >Gibson</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1929-02-13">February 13, 1929</date>.</dateline>
                    <seg rendition="#float-left">No. 191</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: As you are doubtless aware, the American
                    Battle Monuments Commission established by Act of Congress in March 1923<anchor
                        n="14" xml:id="d7-f1"/> contemplates undertaking certain work of a memorial
                    nature in Belgium. You are accordingly requested to extend all possible
                    assistance to the Commission’s representatives in order to facilitate their
                    work.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State:<lb/><signed><hi rendition="#small-caps">W. R.
                            Castle</hi>, Jr.</signed></closer>
            </div>
        </body>
    </text>
