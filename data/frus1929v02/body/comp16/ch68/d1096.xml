            <div xml:id="d1096">

                <pb facs="1255" n="1111" sameAs="frus:frus1929v02/pg1111"/>

                <note rend="inline" type="source">662.11241/48: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Ambassador in
                        Germany</hi> (<hi rendition="#italic">Schurman</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1929-12-31T18:00:00-05:00">December 31, 1929—6
                        p.m.</date></dateline></opener>
                <p>118. Your 293, December 31, 9 a.m.<anchor n="92" xml:id="d1096-f1"/> German
                    consular officers and clerks in United States enjoy privilege of free
                    importation on basis of reciprocity. You are granted authorization to inform
                    Foreign Office in this sense, as requested in your despatch No. 5142, December
                    9, 1929.</p>
                <closer><signed><hi rendition="#small-caps">Stimson</hi></signed></closer>
            </div>
        </body>
    </text>
