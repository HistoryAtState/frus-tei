            <div xml:id="d59">

                <pb facs="0298" n="40" sameAs="frus:frus1915Supp/pg40"/>

                <note rend="inline" type="source">File No. 704.6167/3</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Turkey</hi> (<hi rendition="#italic"
                        >Morgenthau</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Constantinople</hi></placeName>, <date
                            calendar="gregorian" when="1915-05-25T23:00:00+02:00">
                            <hi rendition="#italic">May 25, 1915, 11 p. m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received June 1, 4.10 p. m.</hi>]</dateline>
                </opener>
                <p>694. Your 701.<anchor n="1" xml:id="d59-f1"/> Greatly prefer to decline care of
                    Russian interests and hope you will arrange my acting for Italy alone.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">American Ambassador</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
