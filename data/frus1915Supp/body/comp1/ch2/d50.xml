    <text>
        <body>
            <div xml:id="d50">

                <pb facs="0293" n="35" sameAs="frus:frus1915Supp/pg35"/>

                <note rend="inline" type="source">File No. 763.72/1786</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Italy</hi> (<hi rendition="#italic">Page</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Rome</hi></placeName>, <date
                            calendar="gregorian" when="1915-05-20T20:00:00+01:00">
                            <hi rendition="#italic">May 20, 1915, 8 p. m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 11.30 p. m.</hi>]</dateline>
                </opener>
                <p>285. Chamber of Deputies approved this afternoon Government’s program
                    overwhelming majority. It includes defense considered to point to declaration of
                    war within few days.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Nelson Page</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
