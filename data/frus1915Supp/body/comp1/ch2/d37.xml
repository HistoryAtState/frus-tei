    <text>
        <body>
            <div xml:id="d37">

                <pb facs="0289" n="31" sameAs="frus:frus1915Supp/pg31"/>

                <note rend="inline" type="source">File No. 763.72/1722</note>
                <head>
                    <hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic">Sharp</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1915-05-01T17:00:00+00:00">
                            <hi rendition="#italic">May 1, 1915, 5 p. m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 7 p. m.</hi>]</dateline>
                </opener>
                <p>137. Reported on authority which I believe reliable that Italy signed agreement
                    with Allies last Tuesday.<anchor n="1" xml:id="d37-f1"/> Terms of agreement not
                    known yet but are supposed to accord guaranties of territorial extension to
                    Italy in return for military support of cause of Allies.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Sharp</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d37-f1" n="1" xml:id="d37-f1-content">
                <p>i. e., April 27.</p>
            </note>
