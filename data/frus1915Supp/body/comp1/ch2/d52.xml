    <text>
        <body>
            <div xml:id="d52">

                <pb facs="0293" n="35" sameAs="frus:frus1915Supp/pg35"/>

                <note rend="inline" type="source">File No. 763.72/1793</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Italy</hi> (<hi rendition="#italic"
                        >Page</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Rome</hi></placeName>, <date
                            calendar="gregorian" when="1915-05-22">
                            <hi rendition="#italic">May 22, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received May 23, 3.10 p. m.</hi>]</dateline>
                </opener>
                <p>293. General mobilization called for to-morrow. State of war declared in
                    provinces along Austrian border and confines of Adriatic.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Nelson Page</hi>
                    </signed>
                </closer>
            </div>
