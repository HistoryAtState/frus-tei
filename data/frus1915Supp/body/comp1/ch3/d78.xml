    <text>
        <body>
            <div xml:id="d78">

                <pb facs="0317" n="59" xml:id="pg59"/>

                <note rend="inline" type="source">File No. 763.72/2148</note>
                <head>
                    <hi rendition="#italic">The Minister in Roumania, Servia, and Bulgaria</hi> (<hi
                        rendition="#italic">Vopicka</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Bucharest</hi></placeName>, <date
                            calendar="gregorian" when="1915-09-24">
                            <hi rendition="#italic">September 24, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received 6.50 p. m.</hi>]</dateline>
                </opener>
                <p>138. Bulgarian mobilization officially announced.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Vopicka</hi>
                    </signed>
                </closer>
            </div>
