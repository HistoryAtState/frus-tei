    <text>
        <body>
            <div xml:id="d81">

                <pb facs="0320" n="62" sameAs="frus:frus1915Supp/pg62"/>

                <note rend="inline" type="source">File No. 763.72/2184h</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in Roumania,
                        Servia, and Bulgaria</hi> (<hi rendition="#italic">Vopicka</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-10-05T17:00:00-05:00">
                            <hi rendition="#italic">October 5, 1915, 5 p. m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>160. Department desires your opinion on Balkan situation and frequent
                    confidential cable reports.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
