    <text>
        <body>
            <div xml:id="d76">

                <pb facs="0316" n="58" sameAs="frus:frus1915Supp/pg58"/>

                <note rend="inline" type="source">File No. 763.72/2127</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Germany</hi> (<hi rendition="#italic"
                    >Gerard</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Extract]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berlin</hi></placeName>, <date
                            calendar="gregorian" when="1915-09-16T12:00:00+01:00">
                            <hi rendition="#italic">September 16, 1915, noon</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received September 17, 2.45 p.
                        m.</hi>]</dateline>
                </opener>
                <p>2900. Hear on fair authority military convention between Germany and Bulgaria has
                    been signed....</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Gerard</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
