                <pb facs="0320" n="62" sameAs="frus:frus1915Supp/pg62"/>

                <note rend="inline" type="source">File No. 868.002/18</note>
                <head>
                    <hi rendition="#italic">The Minister in Greece</hi> (<hi rendition="#italic"
                        >Droppers</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Athens</hi></placeName>, <date
                            calendar="gregorian" when="1915-10-05T19:00:00+01:34">
                            <hi rendition="#italic">October 5, 1915, 7 p. m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received October 6, 8.30 a.
                        m.</hi>]</dateline>
                </opener>
                <p>59. Prime Minister resigned. Situation critical.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Droppers</hi>
                    </signed>
                </closer>
            </div>
