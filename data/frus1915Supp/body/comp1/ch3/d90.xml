    <text>
        <body>
            <div xml:id="d90">

                <pb facs="0323" n="65" sameAs="frus:frus1915Supp/pg65"/>

                <note rend="inline" type="source">File No. 763.72/2194</note>
                <head>
                    <hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic">Sharp</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1915-10-18">
                            <hi rendition="#italic">October 18, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received 5.30 p. m.</hi>]</dateline>
                </opener>
                <p>1051. <hi rendition="#italic">Journal officiel</hi> of to-day contains following
                    declaration of war:<quote rend="blockquote">
                        <p>Bulgaria having entered into action on the side of the enemies and
                            against one of the allies of France, the Government of the Republic
                            declares that a state of war exists between France and Bulgaria from
                            October 16, 1915, 6 a. m., through the act of Bulgaria.</p>
                    </quote>
                </p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Sharp</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
