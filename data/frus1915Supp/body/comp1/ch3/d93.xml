    <text>
        <body>
            <div xml:id="d93">

                <pb facs="0325" n="67" xml:id="pg67"/>

                <note rend="inline" type="source">File No. 763.72/2225</note>
                <head>
                    <hi rendition="#italic">The Minister in Switzerland</hi> (<hi rendition="#italic"
                        >Stovall</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berne</hi></placeName>, <date
                            calendar="gregorian" when="1915-10-30T15:00:00+01:00">
                            <hi rendition="#italic">October 30, 1915, 3 p. m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 10.30 p. m.</hi>]</dateline>
                </opener>
                <p>217. Former Chancellor Von Bülow this
                    week is in Switzerland. Revives rumor circulated that Germany is making offers
                    to Italy to withdraw from the war.</p>
                <closer>
                    <signed>
                        Stovall
                    </signed>
                </closer>
            </div>
        </body>
