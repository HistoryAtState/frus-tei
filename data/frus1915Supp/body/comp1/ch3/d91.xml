            <div xml:id="d91">

                <pb facs="0323" n="65" sameAs="frus:frus1915Supp/pg65"/>

                <note rend="inline" type="source">File No. 763.72/2200</note>
                <head>
                    <hi rendition="#italic">The Third Assistant Secretary of State to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-10-19">
                            <hi rendition="#italic">October 19, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Secretary</hi>: The Counselor of the
                    Italian Embassy called this morning to say that a state of war exists between
                    Italy and Bulgaria. The Embassy will inform the Department of this fact by a
                    formal note.</p>
                <p>Sincerely,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. Phillips</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
