    <text>
        <body>
            <div xml:id="d8">

                <pb facs="0267" n="9" sameAs="frus:frus1915Supp/pg9"/>

                <note rend="inline" type="source">File No. 763.72119/43</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Germany</hi> (<hi rendition="#italic"
                    >Gerard</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berlin</hi></placeName>, <date
                            calendar="gregorian" when="1915-02-13">
                            <hi rendition="#italic">February 13, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received 3.15 p. m.</hi>]</dateline>
                </opener>
                <p>I did not send my long cipher of yesterday<anchor n="1" xml:id="d8-f1"/> without
                    having good reason.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Gerard</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d8-f1" n="1" xml:id="d8-f1-content">
                <p>Probably refers to telegram 1579 <hi rendition="#italic">infra</hi>.</p>
