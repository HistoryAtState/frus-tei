    <text>
        <body>
            <div xml:id="d34">

                <pb facs="0288" n="30" sameAs="frus:frus1915Supp/pg30"/>

                <note rend="inline" type="source">File No. 763.72119/57</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Page</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1915-04-27">
                            <hi rendition="#italic">April 27, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received 1.30 p. m.</hi>]</dateline>
                </opener>
                <p>1995. Your 1472, April 26. British Government informs me steamer <hi
                        rendition="#italic">Noordam</hi> has already proceeded to Rotterdam.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">American Ambassador</hi>
                    </signed>
                </closer>
            </div>
        </body>
