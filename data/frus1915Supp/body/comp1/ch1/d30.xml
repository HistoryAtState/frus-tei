    <text>
        <body>
            <div xml:id="d30">

                <pb facs="0287" n="29" sameAs="frus:frus1915Supp/pg29"/>

                <note rend="inline" type="source">File No. 763.72119/53a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Germany</hi> (<hi
                            rendition="#italic">Gerard</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-04-08">
                            <hi rendition="#italic">April 8, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>1484. Inform Foreign Office for information Admiralty that delegation eight
                    American ladies and gentlemen sailed April 7 by steamer <hi rendition="#italic"
                        >Frederik VIII</hi> of Scandinavian-American Line <hi rendition="#italic">en
                        route</hi> to peace conference at The Hague.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Bryan</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
