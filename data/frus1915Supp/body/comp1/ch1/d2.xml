    <text>
        <body>
            <div xml:id="d2">

                <pb facs="0262" n="4" sameAs="frus:frus1915Supp/pg4"/>

                <note rend="inline" type="source">File No. 763.72111/1347</note>
                <head>
                    <hi rendition="#italic">The Minister in Sweden</hi> (<hi rendition="#italic">Morris</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 64]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Stockholm</hi></placeName>, <date
                            calendar="gregorian" when="1914-12-17">
                            <hi rendition="#italic">December 17, 1914</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received January 5, 1915.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith
                    copies and translations of an article appearing in the Swedish newspaper <hi
                        rendition="#italic">Svenska Dagbladet</hi>, regarding the question of
                    Swedish neutrality.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Morris</hi>
                        
                    </signed>
                </closer>



                <xi:include href="d2-a1.xml" xpointer="d2-a1"/>
            </div>
        </body>
    </text>
