    <text>
        <body>
            <div xml:id="d18">

                <pb facs="0275" n="17" sameAs="frus:frus1915Supp/pg17"/>

                <note rend="inline" type="source">File No. 763.72119/120</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Germany</hi> (<hi rendition="#italic"
                    >Gerard</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi><anchor n="1" xml:id="d18-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berlin</hi></placeName>, <date
                            calendar="gregorian" when="1915-03-01T12:00:00+01:00">
                            <hi rendition="#italic">March 1, 1915, 12 noon</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received March 2, 7.50 p. m.</hi>]</dateline>
                </opener>
                <p>1714. We cannot send cipher to London, so please inform Colonel House that
                        Von Jagow, Minister of Foreign
                    Affairs, said he hoped Colonel was coming to Berlin soon.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Gerard</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d18-f1" n="1" type="source" xml:id="d18-f1-content">
                <p>Repeated to the Ambassador in Great Britain March 3.</p>
            </note>
        </listAnnotation>
    </standOff>
