    <text>
        <body>
            <div xml:id="d21">

                <pb facs="0276" n="18" sameAs="frus:frus1915Supp/pg18"/>

                <note rend="inline" type="source">File No. 763.72/1553</note>
                <head>
                    <hi rendition="#italic">The Minister in Greece</hi> (<hi rendition="#italic"
                        >Droppers</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Athens</hi></placeName>, <date
                            calendar="gregorian" when="1915-03-06">
                            <hi rendition="#italic">March 6, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received March 7, 8 p. m.</hi>]</dateline>
                </opener>
                <p>King unexpectedly declares inability to accept program of Prime Minister. Latter
                    resigns at once. Athens stunned.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Droppers</hi>
                    </signed>
                </closer>
            </div>
        </body>
