    <text>
        <body>
            <div xml:id="d35">

                <pb facs="0288" n="30" sameAs="frus:frus1915Supp/pg30"/>

                <note rend="inline" type="source">File No. 763.72/1714a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Italy</hi> (<hi
                            rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-04-29T16:00:00-05:00">
                            <hi rendition="#italic">April 29, 1915, 4 p. m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>207. Please keep Department advised as much as possible, but entirely at your own
                    discretion, regarding status of negotiations between Italy and Austria.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Bryan</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
