    <text>
        <body>
            <div xml:id="d1254">

                <pb facs="1140" n="882" sameAs="frus:frus1915Supp/pg882"/>

                <note rend="inline" type="source">File No. 763.72111/3693</note>
                <head>
                    <hi rendition="#italic">The French Ambassador</hi> (<hi rendition="#italic"
                        >Jusserand</hi>) <hi rendition="#italic">to the</hi>
                    
                        <hi rendition="#italic">Secretary of State</hi>
                    
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-12-30">
                            <hi rendition="#italic">December 30, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received January 3, 1916</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Secretary</hi>: I beg to acknowledge
                    receipt of your letter of December 29 concerning the presence of the cruiser <hi
                        rendition="#italic">Descartes</hi> in the vicinity of San Juan, and various
                    incidents connected therewith.</p>
                <p>I am making the necessary inquiries on the several points mentioned by you, and I
                    hope to be able soon to write again more fully.</p>
                <p>Believe me [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Jusserand</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
