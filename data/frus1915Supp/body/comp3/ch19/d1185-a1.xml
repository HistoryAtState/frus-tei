    <text>
        <body>
            <div xml:id="d1185-a1">

                <pb facs="1090" n="832" sameAs="frus:frus1915Supp/pg832"/>

                <opener>
                    <seg rendition="#center">[Enclosure—Telegram]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">Flag Often U. S. S.</hi> “<hi rendition="#italic"
                        >Wyoming</hi>” (<hi rendition="#italic">Fletcher</hi>) <hi
                        rendition="#italic">to the Secretary of the Navy</hi> (<hi
                        rendition="#italic">Daniels</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <date calendar="gregorian" when="1915-04-08">
                            <hi rendition="#italic">April 8, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>I am informed by the collector of customs that the <hi rendition="#italic">Eitel
                        Friedrich</hi> has accepted internment. Necessary steps taken to prevent
                    departure.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Fletcher</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
