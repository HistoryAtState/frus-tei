    <text>
        <body>
            <div xml:id="d1190">

                <pb facs="1092" n="834" sameAs="frus:frus1915Supp/pg834"/>

                <note rend="inline" type="source">File No. 763.72111K92/18</note>
                <head>
                    <hi rendition="#italic">The Assistant Secretary of the Treasury</hi> (<hi
                        rendition="#italic">Peters</hi>) <hi rendition="#italic">to the</hi>
                    <hi rendition="#italic">Counselor for the Department of State</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-04-26">
                            <hi rendition="#italic">April 26, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Lansing</hi>: I enclose herewith copy of a
                    letter received by Collector Hamilton of Norfolk from Commander Thierfelder of
                        <pb facs="1093" n="835" xml:id="pg835"/> the German cruiser <hi
                        rendition="#italic">Kronprinz Wilhelm</hi>. This was telephoned by Collector
                    Hamilton to this office.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">A. J. Peters</hi>
                    </signed>
                </closer>


                <xi:include href="d1190-a1.xml" xpointer="d1190-a1"/>
            </div>
        </body>
    </text>
