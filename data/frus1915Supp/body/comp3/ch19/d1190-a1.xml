    <text>
        <body>
            <div xml:id="d1190-a1">

                <pb facs="1093" n="835" sameAs="frus:frus1915Supp/pg835"/>

                <opener>
                    <seg rendition="#center">[Enclosure]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">The Commander of the</hi> “
                        <hi rendition="#italic">Kronprinz Wilhelm</hi>” (<hi rendition="#italic">Thierfelder</hi>) <hi
                        rendition="#italic">to the Collector of Customs at Norfolk</hi> (<hi rendition="#italic">Hamilton</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <date calendar="gregorian" when="1915-04-26">
                            <hi rendition="#italic">April 26, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Herewith I have to officially inform you
                    that I intern. Awaiting your further orders, I am</p>
                <p>Yours respectfully,</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Thierfelder</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
