    <text>
        <body>
            <div xml:id="d1185">

                <pb facs="1090" n="832" sameAs="frus:frus1915Supp/pg832"/>

                <note rend="inline" type="source">File No. 763.72111Ei9/37</note>
                <head>
                    <hi rendition="#italic">The Secretary of the Navy</hi> (<hi rendition="#italic"
                    >Daniels</hi>) <hi rendition="#italic">to the</hi>
                    
                        <hi rendition="#italic">Secretary of State</hi>
                    
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-04-09">
                            <hi rendition="#italic">April 9, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to forward herewith, for
                    the information of the Department of State, copies of telegrams sent and
                    received by this Department relative to the enforcement of neutrality.<anchor
                        n="2" xml:id="d1185-f1"/>
                </p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Josephus Daniels</hi>
                        
                    </signed>
                </closer>


                <xi:include href="d1185-a1.xml" xpointer="d1185-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
