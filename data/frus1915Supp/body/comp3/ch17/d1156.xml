    <text>
        <body>
            <div xml:id="d1156">

                <pb facs="1066" n="808" sameAs="frus:frus1915Supp/pg808"/>

                <note rend="inline" type="source">File No. 763.72111/2941</note>
                <head>
                    <hi rendition="#italic">The Attorney General</hi> (<hi rendition="#italic">Gregory</hi>) <hi
                        rendition="#italic">to the</hi>
                    
                        <hi rendition="#italic">Secretary of State</hi>
                    
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-10-07">
                            <hi rendition="#italic">October 7, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The Department is in receipt of your
                    letter of September 27, 1915, enclosing photographic copies and translations of
                    letter relative to Austro-Hungarian subjects.</p>
                <pb facs="1067" n="809" xml:id="pg809"/>
                <p>In reply, I desire to say that the facts contained do not seem to constitute any
                    violation of the Federal criminal laws.</p>
                <p>Respectfully,</p>
                <closer>For the Attorney General: <lb/>
                    <signed>
                        
                            <hi rendition="#small-caps">Charles Warren</hi>
                        
                    </signed>
                    <lb/>
                    <hi rendition="#italic">Assistant Attorney General</hi>
                </closer>
            </div>
        </body>
    </text>
