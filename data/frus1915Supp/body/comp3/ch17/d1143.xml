    <text>
        <body>
            <div xml:id="d1143">

                <pb facs="1060" n="802" xml:id="pg802"/>

                <head>
                    <hi rendition="#italic">The</hi>
                    <hi rendition="#italic">Secretary of State</hi>
                    <hi rendition="#italic">to the Russian Ambassador</hi> (<hi rendition="#italic"
                        >Bakhméteff</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-09-01">
                            <hi rendition="#italic">September 1, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>Your telegram to-day regarding motor-boats. The collector of customs has been
                    instructed to allow exportation.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
