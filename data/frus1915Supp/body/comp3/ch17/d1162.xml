    <text>
        <body>
            <div xml:id="d1162">

                <pb facs="1072" n="814" sameAs="frus:frus1915Supp/pg814"/>

                <note rend="inline" type="source">File No. 763.72111E1 1/29</note>
                <head>
                    <hi rendition="#italic">The</hi>
                    
                        <hi rendition="#italic">Secretary of State</hi>
                    
                    <hi rendition="#italic">to the Ambassador in Austria-Hungary</hi> (<hi rendition="#italic"
                        >Penfield</hi>)<anchor n="2" xml:id="d1162-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-11-03">
                            <hi rendition="#italic">November 3, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>967. Your 942, October 15.<anchor n="3" xml:id="d1162-f2"/> After investigation
                    Department finds no evidence that any submarines have been built in the United
                    States for delivery during the present war, or that any submarines have left
                    American jurisdiction under their own power.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1162-f1" n="2" type="source" xml:id="d1162-f1-content">
                <p>The same to the Ambassador in Germany, No. 2360, November 1, 1915 (File No.
                    763.72111E1 1/54).</p>
            </note>
