    <text>
        <body>
            <div xml:id="d1107">

                <pb facs="1032" n="774" sameAs="frus:frus1915Supp/pg774"/>

                <note rend="inline" type="source">File No. 763.72111Un3/3</note>
                <head>
                    <hi rendition="#italic">The</hi>
                    
                        <hi rendition="#italic">Secretary of State</hi>
                    
                    <hi rendition="#italic">to the British Ambassador</hi> (<hi rendition="#italic">Spring
                        Rice</hi>)</head>
                <opener>
                    <seg rendition="#float-left">No. 733]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-04-05">
                            <hi rendition="#italic">April 5, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: I have the honor to inform you that
                    complaint has been made to the Department concerning the frequent appearance on
                    the streets of Detroit of uniformed Canadian soldiers wearing filled cartridge
                    belts.</p>
                <p>It is hoped that this matter may be called to the attention of the Canadian
                    Government and that such instructions may be issued as are necessary to prevent
                    the continuance of this practice.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">W. J. Bryan</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
