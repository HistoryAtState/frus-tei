    <text>
        <body>
            <div xml:id="d1108">

                <pb facs="1032" n="774" sameAs="frus:frus1915Supp/pg774"/>

                <note rend="inline" type="source">File No. 763.72111Un3/8</note>
                <head>
                    <hi rendition="#italic">The British Ambassador</hi> (<hi rendition="#italic">Spring
                        Rice</hi>) <hi rendition="#italic">to the</hi>
                    
                        <hi rendition="#italic">Secretary of State</hi>
                    
                </head>
                <opener>
                    <seg rendition="#float-left">No. 142]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-04-08">
                            <hi rendition="#italic">April 8, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received April 9</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honour to acknowledge your note
                    No. 733 of April 5, received to-day, informing me that complaint has been made
                    to your Department concerning the frequent appearance on the streets of Detroit
                    of uniformed Canadian soldiers wearing filled cartridge belts. You ask that the
                    attention of the Canadian Government may be called to the matter and express the
                    hope that instructions may be issued to prevent a continuance of the
                    practice.</p>
                <p>I have the honour to inform you in reply that I am at once bringing the matter to
                    the notice of the Canadian Government.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Cecil Spring Rice</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
