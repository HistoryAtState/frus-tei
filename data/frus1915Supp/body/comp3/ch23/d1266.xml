    <text>
        <body>
            <div xml:id="d1266">

                <pb facs="1146" n="888" sameAs="frus:frus1915Supp/pg888"/>

                <note rend="inline" type="source">File No. 763.72111/2710</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of the Navy</hi> (<hi rendition="#italic">Burson</hi>) <hi
                        rendition="#italic">to the</hi>
                    
                        <hi rendition="#italic">Secretary of State</hi>
                    
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-08-10">
                            <hi rendition="#italic">August 10, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to forward herewith, for
                    your information, a copy of a cablegram, received from the commandant of the
                    naval station, Guam, relative to the establishment of a censorship over the
                    cables to that place.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">W. S. Burson</hi>
                        
                    </signed>
                </closer>


                <xi:include href="d1266-a1.xml" xpointer="d1266-a1"/>
            </div>
