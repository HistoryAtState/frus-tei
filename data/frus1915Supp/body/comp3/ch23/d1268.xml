    <text>
        <body>
            <div xml:id="d1268">

                <pb facs="1147" n="889" sameAs="frus:frus1915Supp/pg889"/>

                <note rend="inline" type="source">File No. 763.72111/2790</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of the Navy</hi> (<hi rendition="#italic"
                        >Roosevelt</hi>) <hi rendition="#italic">to the</hi>
                    
                        <hi rendition="#italic">Secretary of State</hi>
                    
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-08-30">
                            <hi rendition="#italic">August 30, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to forward herewith, for
                    your information, copies of telegrams sent and received by this department
                    relative to the censorship of messages at the naval station, Guam.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Franklin D. Roosevelt</hi>
                        
                    </signed>
                </closer>


                <xi:include href="d1268-a1.xml" xpointer="d1268-a1"/>
            </div>
