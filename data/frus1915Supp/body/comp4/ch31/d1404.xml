    <text>
        <body>
            <div xml:id="d1404">

                <pb facs="1243" n="985" sameAs="frus:frus1915Supp/pg985"/>

                <note rend="inline" type="source">File No. 867.4016/79</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Turkey</hi> (<hi rendition="#italic"
                        >Morgenthau</hi>) <hi rendition="#italic">to the</hi>
                    <hi rendition="#italic">Secretary of State</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Constantinople</hi></placeName>, <date
                            calendar="gregorian" when="1915-07-20">
                            <hi rendition="#italic">July 20, 1915, noon</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received July 23, 8.20 a. m.</hi>]</dateline>
                </opener>
                <p>866. Your telegram 865. Embassy has not heard of any injuries to native or
                    naturalized citizens of the United States.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">American Ambassador</hi>
                    </signed>
                </closer>
            </div>
        </body>
