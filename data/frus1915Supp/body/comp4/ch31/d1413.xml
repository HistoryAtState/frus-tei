    <text>
        <body>
            <div xml:id="d1413">

                <pb facs="1247" n="989" xml:id="pg989"/>

                <note rend="inline" type="source">File No. 367.11/772</note>
                <head>
                    <hi rendition="#italic">The</hi>
                    <hi rendition="#italic">Secretary of State</hi>
                    <hi rendition="#italic">to the Ambassador in Turkey</hi> (<hi
                        rendition="#italic">Morgenthau</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-10-06">
                            <hi rendition="#italic">October 6, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>1165. Can you secure permission to leave Turkey for Armenians whose relatives in
                    America will pay expenses passage? Also please answer Department’s 1028,
                    September 8.<anchor n="1" xml:id="d1413-f1"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
