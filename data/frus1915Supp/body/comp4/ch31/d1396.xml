    <text>
        <body>
            <div xml:id="d1396">

                <pb facs="1238" n="980" sameAs="frus:frus1915Supp/pg980"/>

                <head>
                    <hi rendition="#italic">The</hi>
                    
                        <hi rendition="#italic">Secretary of State</hi>
                    
                    <hi rendition="#italic">to the Ambassador in Turkey</hi> (<hi rendition="#italic"
                        >Morgenthau</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-04-29T17:00:00-05:00">
                            <hi rendition="#italic">April 29, 1915, 5 p. m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>633. Department’s April 27 and your 608, April 27. Urge Turkish Government to
                    protect both Armenians and Zionists.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Bryan</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
