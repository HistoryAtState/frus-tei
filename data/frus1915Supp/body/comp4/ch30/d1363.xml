    <text>
        <body>
            <div xml:id="d1363">

                <pb facs="1223" n="965" sameAs="frus:frus1915Supp/pg965"/>

                <note rend="inline" type="source">File No. 763.72/1590</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Turkey</hi> (<hi rendition="#italic"
                        >Morgenthau</hi>) <hi rendition="#italic">to the</hi>
                    
                        <hi rendition="#italic">Secretary of State</hi>
                    
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Constantinople</hi></placeName>, <date
                            calendar="gregorian" when="1915-03-16T11:00:00+02:00">
                            <hi rendition="#italic">March 16, 1915, 11 a. m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 9 p. m.</hi>]</dateline>
                </opener>
                <p>505. Your telegram 499.<anchor n="1" xml:id="d1363-f1"/> Have definite assurance
                    Turkish Government will make every endeavor to protect non-combatants. Am
                    [accompanying] Minister of War and four senators to Dardanelles.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">American Ambassador</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
