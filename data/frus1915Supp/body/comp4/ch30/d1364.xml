    <text>
        <body>
            <div xml:id="d1364">

                <pb facs="1223" n="965" sameAs="frus:frus1915Supp/pg965"/>

                <note rend="inline" type="source">File No. 763.72/1600</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Austria-Hungary</hi> (<hi
                        rendition="#italic">Penfield</hi>) <hi rendition="#italic">to the</hi>
                    <hi rendition="#italic">Secretary of State</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Vienna</hi></placeName>, <date
                            calendar="gregorian" when="1915-03-16T18:00:00+01:00">
                            <hi rendition="#italic">March 16, 1915, 6 p. m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received March 17, 9.25 p.
                        m.</hi>]</dateline>
                </opener>
                <p>565. Your 569, March 12, 5 p. m.<anchor n="2" xml:id="d1364-f1"/> Had
                    satisfactory interview with the Minister for Foreign Affairs to-day on subject
                    your cable relative to possible massacres in Turkey.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Penfield</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
