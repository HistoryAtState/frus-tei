    <text>
        <body>
            <div xml:id="d1376">

                <pb facs="1228" n="970" sameAs="frus:frus1915Supp/pg970"/>

                <head>
                    <hi rendition="#italic">The</hi>
                    <hi rendition="#italic">Secretary of State</hi>
                    <hi rendition="#italic">to the Ambassador in Turkey</hi> (<hi
                        rendition="#italic">Morgenthau</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-05-07T16:00:00-05:00">
                            <hi rendition="#italic">May 7, 1915, 4 p. m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>654. Your 639, May 4, 10 p. m. and 641, May 6, 6 p. m. Department disapproves
                    member of Embassy Staff accompanying British and <pb facs="1229" n="971"
                        xml:id="pg971"/> French prisoners on board transport. Please instruct Philip
                    to return to Embassy.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
