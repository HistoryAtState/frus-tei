    <text>
        <body>
            <div xml:id="d1391">

                <pb facs="1237" n="979" sameAs="frus:frus1915Supp/pg979"/>

                <note rend="inline" type="source">File No. 763.72115/1482</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Turkey</hi> (<hi rendition="#italic"
                        >Morgenthau</hi>) <hi rendition="#italic">to the</hi>
                    <hi rendition="#italic">Secretary of State</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Constantinople</hi></placeName>, <date
                            calendar="gregorian" when="1915-12-14T22:00:00+02:00">
                            <hi rendition="#italic">December 14, 1915, 10 p. m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received December 18, 8.30 a.
                        m.</hi>]</dateline>
                </opener>
                <p>1386. Your 1523, December 8, 6 p. m.<anchor n="1" xml:id="d1391-f1"/> Persons
                    interned at Urfa are now being sent to neighborhood of Konia.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Morgenthau</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
