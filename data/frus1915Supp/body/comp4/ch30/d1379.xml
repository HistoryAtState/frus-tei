    <text>
        <body>
            <div xml:id="d1379">

                <pb facs="1230" n="972" xml:id="pg972"/>

                <note rend="inline" type="source">File No. 702.6567/2</note>
                <head>
                    <hi rendition="#italic">The</hi>
                    <hi rendition="#italic">Secretary of State</hi>
                    <hi rendition="#italic">to the Ambassador in Turkey</hi> (<hi
                        rendition="#italic">Morgenthau</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-05-28T18:00:00-05:00">
                            <hi rendition="#italic">May 28, 1915, 6 p. m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>712. At request of Italian Ambassador here, please request <hi
                        rendition="#italic">Tennessee</hi> to take on board at Beirut the Italian
                    consuls from Syria and then proceed to pick up the Italian consuls at Jerusalem
                    and at Haifa, landing them all at Alexandria, Egypt. Italian Ambassador at
                    Constantinople has been instructed to obtain from Ottoman Government all
                    possible facilities for departure of these consuls.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
