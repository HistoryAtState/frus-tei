    <text>
        <body>
            <div xml:id="d1370">

                <pb facs="1225" n="967" sameAs="frus:frus1915Supp/pg967"/>

                <note rend="inline" type="source">File No. 763.72/1679</note>
                <head>
                    <hi rendition="#italic">The Consul General at Smyrna</hi> (<hi rendition="#italic">Horton</hi>)
                        <hi rendition="#italic">to the</hi>
                    
                        <hi rendition="#italic">Secretary of State</hi>
                    
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Smyrna</hi></placeName>, <date
                            calendar="gregorian" when="1915-03-09">
                            <hi rendition="#italic">March 9, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received April 8</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir:</hi> I have the honor to enclose herewith copy
                    of despatch which has this day been sent to the Ambassador.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">George Horton</hi>
                        
                    </signed>
                </closer>


                <xi:include href="d1370-a1.xml" xpointer="d1370-a1"/>
            </div>
