    <text>
        <body>
            <div xml:id="d1359">

                <pb facs="1221" n="963" sameAs="frus:frus1915Supp/pg963"/>

                <note rend="inline" type="source">File No. 763.72/1567</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Turkey</hi> (<hi rendition="#italic"
                        >Morgenthau</hi>) <hi rendition="#italic">to the</hi>
                    
                        <hi rendition="#italic">Secretary of State</hi>
                    
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Constantinople</hi></placeName>, <date
                            calendar="gregorian" when="1915-03-09T17:00:00+02:00">
                            <hi rendition="#italic">March 9, 1915, 5 p. m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received March 10, 8 a. m.</hi>]</dateline>
                </opener>
                <p>491. Suggest that my proposition as to zones contained my number 470 should also
                    be submitted to French and Russian Governments and urge prompt consideration
                    thereof.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">American Ambassador</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
