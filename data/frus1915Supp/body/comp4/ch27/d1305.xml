    <text>
        <body>
            <div xml:id="d1305">

                <pb facs="1179" n="921" sameAs="frus:frus1915Supp/pg921"/>

                <note rend="inline" type="source">File No. 125.1873/88</note>
                <head>
                    <hi rendition="#italic">The</hi>
                    
                        <hi rendition="#italic">Secretary of State</hi>
                    
                    <hi rendition="#italic">to the Ambassador in Austria-Hungary</hi> (<hi rendition="#italic"
                    >Penfield</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-11-17">
                            <hi rendition="#italic">November 17, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>991. Under existing conditions Young should remain Belgrade under your
                    supervision. Give him appropriate instructions.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
