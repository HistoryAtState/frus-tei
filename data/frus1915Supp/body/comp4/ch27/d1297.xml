    <text>
        <body>
            <div xml:id="d1297">

                <pb facs="1174" n="916" sameAs="frus:frus1915Supp/pg916"/>

                <note rend="inline" type="source">File No. 125.0055/1</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Germany</hi> (<hi rendition="#italic"
                    >Gerard</hi>) <hi rendition="#italic">to the</hi>
                    
                        <hi rendition="#italic">Secretary of State</hi>
                    
                </head>
                <opener>
                    <seg rendition="#float-left">No. 308]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berlin</hi></placeName>, <date
                            calendar="gregorian" when="1914-12-04">
                            <hi rendition="#italic">December 4, 1914</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received December 26</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit to you
                    herewith a copy in translation of a <hi rendition="#italic">note verbale</hi>,
                    received from the Imperial German Foreign Office, stating the position of the
                    German Government, respecting the recognition of consular officers in territory
                    under occupation by the German Army.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">James W. Gerard</hi>
                        
                    </signed>
                </closer>


                <xi:include href="d1297-a1.xml" xpointer="d1297-a1"/>
            </div>
