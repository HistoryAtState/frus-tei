                <pb facs="1302" n="1044" sameAs="frus:frus1915Supp/pg1044"/>

                <note rend="inline" type="source">File No. 811.142/983</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Russia</hi> (<hi rendition="#italic">Marye</hi>)
                        <hi rendition="#italic">to the</hi>
                    
                        <hi rendition="#italic">Secretary of State</hi>
                    
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Petrograd</hi></placeName>, <date
                            calendar="gregorian" when="1915-09-20">
                            <hi rendition="#italic">September 20, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received 2.40 p. m.</hi>]</dateline>
                </opener>
                <p>1001. Embassy Berlin requests permission for American Red Cross unit to journey
                    Russia to work among German prisoners of war. Russian Foreign Office on
                    receiving application immediately inquired <pb facs="1303" n="1045"
                        xml:id="pg1045"/> what steps American Red Cross have taken to apply similar
                    relief Russian prisoners in Germany. See my telegram 235, July 23.<anchor n="1"
                        xml:id="d1507-f1"/>
                </p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Marye</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
