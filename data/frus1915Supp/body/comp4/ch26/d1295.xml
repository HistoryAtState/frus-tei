    <text>
        <body>
            <div xml:id="d1295">

                <pb facs="1173" n="915" sameAs="frus:frus1915Supp/pg915"/>

                <note rend="inline" type="source">File No. 123Ei6/96</note>
                <head>
                    <hi rendition="#italic">The Special Agent in Bulgaria</hi> (<hi rendition="#italic"
                        >Einstein</hi>) <hi rendition="#italic">to the</hi>
                    
                        <hi rendition="#italic">Secretary of State</hi>
                    
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Sofia</hi></placeName>, <date
                            ana="#date_undated-inferred-from-document-content-and-sibling-dates"
                            calendar="gregorian" notAfter="1915-11-01T08:15:00-05:00"
                            notBefore="1915-10-27T00:00:00+02:00"><hi rendition="#italic"
                                >undated</hi></date>.<lb/>[<hi rendition="#italic">Received November
                            1, 1915, 8.15 a. m.</hi>]</dateline>
                </opener>
                <p>Have presented letters as Chargé d’Affaires.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Einstein</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
