    <text>
        <body>
            <div xml:id="d1294">

                <pb facs="1173" n="915" sameAs="frus:frus1915Supp/pg915"/>

                <note rend="inline" type="source">File No. 123Ei6/94</note>
                <head>
                    <hi rendition="#italic">The</hi>
                    
                        <hi rendition="#italic">Secretary of State</hi>
                    
                    <hi rendition="#italic">to the Minister in Roumania, Servia, and Bulgaria</hi>
                        (<hi rendition="#italic"
                        >Vopicka</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram—Extract]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-10-27">
                            <hi rendition="#italic">October 27, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>176. Department’s 161 and your 157, October 22.<anchor n="2" xml:id="d1294-f1"/>
                    Einstein appointed special agent to assist
                    you in caring for British interests in Bulgaria with headquarters at Sofia and
                    not Chargé d’Affaires on special mission. So inform Bulgarian Government.…</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
