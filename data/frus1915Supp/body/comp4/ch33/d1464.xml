    <text>
        <body>
            <div xml:id="d1464">

                <pb facs="1281" n="1023" sameAs="frus:frus1915Supp/pg1023"/>

                <note rend="inline" type="source">File No. 763.72114/684</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Russia</hi> (<hi rendition="#italic">Marye</hi>)
                        <hi rendition="#italic">to the</hi>
                    
                        <hi rendition="#italic">Secretary of State</hi>
                    <anchor n="1" xml:id="d1464-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Petrograd</hi></placeName>, <date
                            calendar="gregorian" when="1915-08-09">
                            <hi rendition="#italic">August 9, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received 12.45 p. m.</hi>]</dateline>
                </opener>
                <p>253. Russian Government has given its consent that American Red Cross operate in
                    Siberia and throughout Russia in manner to it most convenient. Additional
                    secretaries of Embassy sent to us can take charge of visiting the camps in
                    Russia and are now engaged in such work.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Marye</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
