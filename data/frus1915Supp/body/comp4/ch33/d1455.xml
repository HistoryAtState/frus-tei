    <text>
        <body>
            <div xml:id="d1455">

                <pb facs="1275" n="1017" sameAs="frus:frus1915Supp/pg1017"/>

                <note rend="inline" type="source">File No. 763.72114/399</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Germany</hi> (<hi rendition="#italic"
                        >Gerard</hi>) <hi rendition="#italic">to the</hi>
                    <hi rendition="#italic">Secretary of State</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berlin</hi></placeName>, <date
                            calendar="gregorian" when="1915-04-16T19:00:00+01:00">
                            <hi rendition="#italic">April 16, 1915, 7 p. m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received April 17, 6 p. m.</hi>]</dateline>
                </opener>
                <p>2064. Department’s 1479, April 7.<anchor n="2" xml:id="d1455-f1"/> I have now
                    received written assurances from the Imperial Foreign Office that the assent of
                    the British Government to the German Government’s scheme regarding camp
                    inspection telegraphed to you in my 1824, March 11, is understood.<anchor n="3"
                        xml:id="d1455-f2"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Gerard</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1455-f1" n="2" xml:id="d1455-f1-content">
