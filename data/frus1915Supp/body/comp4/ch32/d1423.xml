    <text>
        <body>
            <div xml:id="d1423">

                <pb facs="1251" n="993" sameAs="frus:frus1915Supp/pg993"/>

                <note rend="inline" type="source">File No. 763.72/1872</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Russia</hi> (<hi rendition="#italic"
                        >Marye</hi>) <hi rendition="#italic">to the</hi>
                    <hi rendition="#italic">Secretary of State</hi>
                    <anchor n="1" xml:id="d1423-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Petrograd</hi></placeName>, <date
                            calendar="gregorian" when="1915-06-14">
                            <hi rendition="#italic">June 14, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received June 15, 11.25 p.
                        m.</hi>]</dateline>
                </opener>
                <p>193. Department’s 349, May 26th. Russian Government does not find it possible to
                    liberate German subjects taken prisoner by Russian troops on Persian
                    territory.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Marye</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
