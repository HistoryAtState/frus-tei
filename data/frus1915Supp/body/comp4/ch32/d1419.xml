    <text>
        <body>
            <div xml:id="d1419">

                <pb facs="1249" n="991" sameAs="frus:frus1915Supp/pg991"/>

                <note rend="inline" type="source">File No. 763.72/1410</note>
                <head>
                    <hi rendition="#italic">The</hi>
                    <hi rendition="#italic">Secretary of State</hi>
                    <hi rendition="#italic">to the Ambassador in Russia</hi> (<hi
                        rendition="#italic">Marye</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-02-01">
                            <hi rendition="#italic">February 1, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>186. Your 19, January 14, and Department’s 127, January 30.<anchor n="2"
                        xml:id="d1419-f1"/> German Ambassador here asks you transmit to Foreign
                    Office request that German prisoners now held in Astrakhan be liberated on
                    ground they were taken prisoners on neutral territory of neutral country and
                    their detention constitutes violation international law.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
