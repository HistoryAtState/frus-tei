    <text>
        <body>
            <div xml:id="d1322">

                <pb facs="1192" n="934" sameAs="frus:frus1915Supp/pg934"/>

                <note rend="inline" type="source">File No. 701.6311/149</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Austria-Hungary</hi> (<hi rendition="#italic"
                        >Penfield</hi>) <hi rendition="#italic">to the</hi>
                    
                        <hi rendition="#italic">Secretary of State</hi>
                    
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Vienna</hi></placeName>, <date
                            calendar="gregorian" when="1915-09-14T17:00:00+01:00">
                            <hi rendition="#italic">September 14, 1915, 5 p. m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received September 16, 9 p.
                        m.</hi>]</dateline>
                </opener>
                <p>897. Austro-Hungarian Government desires to know whether American Government
                    would consent to procure safe-conduct from British and French Governments for
                    Austro-Hungarian Ambassador at Washington in case he should be directed to come
                    to Vienna to give verbal explanation of the subject your telegram 887, September
                    8, 4 p. m.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Penfield</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
