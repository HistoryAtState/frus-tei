                <pb facs="1192" n="934" sameAs="frus:frus1915Supp/pg934"/>

                <opener>
                    <seg rendition="#center">[Enclosure—Translation]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">The Austro-Hungarian Ambassador</hi> (<hi rendition="#italic">Dumba</hi>)
                        <hi rendition="#italic">to the Austro-Hungarian Minister of Foreign
                        Affairs</hi> (<hi rendition="#italic"
                            >Burian</hi>)</head>
                <p>190. For Baron Burian, Vienna. I beg your excellency to
                    recall me on leave of absence for personal report.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">C. Dumba</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
