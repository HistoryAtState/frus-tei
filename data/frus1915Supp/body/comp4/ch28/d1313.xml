    <text>
        <body>
            <div xml:id="d1313">

                <pb facs="1185" n="927" sameAs="frus:frus1915Supp/pg927"/>

                <note rend="inline" type="source">File No. 702.6211/203</note>
                <head>
                    <hi rendition="#italic">The German Ambassador</hi> (<hi rendition="#italic"
                        >Bernstorff</hi>) <hi rendition="#italic">to the</hi>
                    
                        <hi rendition="#italic">Secretary of State</hi>
                    
                </head>
                <opener>
                    <seg rendition="#center">[Translation—Extract]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">J. Nr. B 1448]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-02-02">
                            <hi rendition="#italic">February 2, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received February 4</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Secretary of State</hi>: I have the honor to
                    inform your excellency, in connection with your esteemed note of the 14th
                    ultimo—No. 1183—that the Imperial Consul in Seattle, Washington, Herr von
                    Loehneysen, has been recalled from his post.…</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">J. Bernstorff</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
