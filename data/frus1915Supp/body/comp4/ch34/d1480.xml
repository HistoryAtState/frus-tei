    <text>
        <body>
            <div xml:id="d1480">

                <pb facs="1289" n="1031" sameAs="frus:frus1915Supp/pg1031"/>

                <note rend="inline" type="source">File No. 855.48/176</note>
                <head>
                    <hi rendition="#italic">The Minister in Belgium</hi> (<hi rendition="#italic">Whitlock</hi>) <hi
                        rendition="#italic">to the</hi>
                    
                        <hi rendition="#italic">Secretary of State</hi>
                    
                </head>
                <opener>
                    <seg rendition="#float-left">No. 47]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Brussels</hi></placeName>, <date
                            calendar="gregorian" when="1915-01-28">
                            <hi rendition="#italic">January 28, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received February 15</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit copies and
                    translation of a letter from the German military authorities informing me that
                    cattle and their food will hereafter be exempt from military requisition when
                    imported by the Comité National de Secours et d’Alimentation.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Brand Whitlock</hi>
                        
                    </signed>
                </closer>



                <xi:include href="d1480-a1.xml" xpointer="d1480-a1"/>
            </div>
        </body>
    </text>
