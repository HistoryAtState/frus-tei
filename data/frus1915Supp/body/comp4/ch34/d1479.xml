    <text>
        <body>
            <div xml:id="d1479">

                <pb facs="1288" n="1030" sameAs="frus:frus1915Supp/pg1030"/>

                <note rend="inline" type="source">File No. 855.48/175</note>
                <head>
                    <hi rendition="#italic">The Minister in Belgium</hi> (<hi rendition="#italic">Whitlock</hi>) <hi
                        rendition="#italic">to the</hi>
                    
                        <hi rendition="#italic">Secretary of State</hi>
                    
                </head>
                <opener>
                    <seg rendition="#float-left">No. 46]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Brussels</hi></placeName>, <date
                            calendar="gregorian" when="1915-01-28">
                            <hi rendition="#italic">January 28, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received February 15</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir:</hi> Referring to previous correspondence in
                    regard to exception from requisition by military authorities of foodstuffs in
                    Belgium, I have the honor to transmit enclosed copies and translation of a
                    communication received from the German military authorities in Brussels, <pb
                        facs="1289" n="1031" xml:id="pg1031"/> stating that although the agreement
                    relative to the suspension of requisitions did not state that exception was made
                    of the city of Antwerp, such was, however, the intention of the Government.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Brand Whitlock</hi>
                        
                    </signed>
                </closer>


                <xi:include href="d1479-a1.xml" xpointer="d1479-a1"/>
            </div>
