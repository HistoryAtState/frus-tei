    <text>
        <body>
            <div xml:id="d1482">

                <pb facs="1290" n="1032" sameAs="frus:frus1915Supp/pg1032"/>

                <note rend="inline" type="source">File No. 855.48/191</note>
                <head>
                    <hi rendition="#italic">The Minister in Belgium</hi> (<hi rendition="#italic"
                        >Whitlock</hi>) <hi rendition="#italic">to the</hi>
                    <hi rendition="#italic">Secretary of State</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 52]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Brussels</hi></placeName>, <date
                            calendar="gregorian" when="1915-02-02">
                            <hi rendition="#italic">February 2, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received February 24</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit copies and
                    translations of correspondence with the German military authorities in Brussels
                    in relation to the exemption of pharmaceutical supplies from seizure or
                    requisition, the need for which has been presented by the Comité National de
                    Secours et d’Alimentation and by the Commission for Relief in Belgium.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Brand Whitlock</hi>
                    </signed>
                </closer>



                <xi:include href="d1482-a1.xml" xpointer="d1482-a1"/>
            </div>
        </body>
    </text>
