    <text>
        <body>
            <div xml:id="d1470">

                <pb facs="1284" n="1026" sameAs="frus:frus1915Supp/pg1026"/>

                <head>
                    <hi rendition="#italic">The</hi>
                    
                        <hi rendition="#italic">Secretary of State</hi>
                    
                    <hi rendition="#italic">to the Minister in the Netherlands</hi> (<hi rendition="#italic">Van
                    Dyke</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-01-21">
                            <hi rendition="#italic">January 21, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>81. Your despatch 184, December 29. Department informed from Berlin tax removed
                    and money collected refunded. Please confirm facts and report.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Bryan</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
