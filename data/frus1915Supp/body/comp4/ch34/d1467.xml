    <text>
        <body>
            <div xml:id="d1467">

                <pb facs="1282" n="1024" sameAs="frus:frus1915Supp/pg1024"/>

                <head>
                    <hi rendition="#italic">The</hi>
                    
                        <hi rendition="#italic">Secretary of State</hi>
                    
                    <hi rendition="#italic">to the Ambassador in Germany</hi> (<hi rendition="#italic"
                    >Gerard</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-01-13">
                            <hi rendition="#italic">January 13, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>999. Ascertain from Foreign Office whether German civil commander of Belgian
                    Province Limburg is exacting severe import tax <pb facs="1283" n="1025"
                        xml:id="pg1025"/> on foodstuffs sent for relief of Belgians from Rotterdam
                    by American Commission.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Bryan</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
