    <text>
        <body>
            <div xml:id="d1474">

                <pb facs="1286" n="1028" sameAs="frus:frus1915Supp/pg1028"/>

                <head>
                    <hi rendition="#italic">The</hi>
                    <hi rendition="#italic">Secretary of State</hi>
                    <hi rendition="#italic">to the Ambassador in France</hi> (<hi
                        rendition="#italic">Sharp</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-01-29">
                            <hi rendition="#italic">January 29, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>528. Your 502, 28th, regarding relief in Belgium. You may present matter to
                    Foreign Office.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi>
                    </signed>
                </closer>
            </div>
        </body>
