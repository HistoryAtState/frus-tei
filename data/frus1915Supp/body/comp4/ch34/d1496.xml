    <text>
        <body>
            <div xml:id="d1496">

                <pb facs="1297" n="1039" sameAs="frus:frus1915Supp/pg1039"/>

                <note rend="inline" type="source">File No. 855.48/297</note>
                <head>
                    <hi rendition="#italic">The Minister in Belgium</hi> (<hi rendition="#italic"
                        >Whitlock</hi>) <hi rendition="#italic">to the</hi>
                    <hi rendition="#italic">Secretary of State</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Brussels</hi></placeName>, <date
                            calendar="gregorian" when="1915-07-10">
                            <hi rendition="#italic">July 10, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received 2.45 p. m.</hi>]</dateline>
                </opener>
                <p>Governor General has given assurances to Spanish Minister, Netherlands Chargé,
                    and myself that this year’s crop in district under his jurisdiction shall be
                    reserved for exclusive use of Belgian civil population.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Whitlock</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
