    <text>
        <body>
            <div xml:id="d1280">

                <pb facs="1164" n="906" sameAs="frus:frus1915Supp/pg906"/>

                <note rend="inline" type="source">File No. 138/87</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Germany</hi> (<hi rendition="#italic"
                    >Gerard</hi>) <hi rendition="#italic">to the</hi>
                    
                        <hi rendition="#italic">Secretary of State</hi>
                    
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berlin</hi></placeName>, <date
                            calendar="gregorian" when="1915-04-01">
                            <hi rendition="#italic">April 1, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received April 2, 3 p. m.</hi>]</dateline>
                </opener>
                <p>1970. Is a person who is presumed to have expatriated himself entitled to receive
                    passport to enable him to return immediately to United States to resume the
                    duties of citizenship regardless of all conditions resulting in a previous
                    denial of passport to him when he submits definite proof of such intention such
                    as steamship ticket?</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Gerard</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
