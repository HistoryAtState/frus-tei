    <text>
        <body>
            <div xml:id="d1286">

                <pb facs="1168" n="910" sameAs="frus:frus1915Supp/pg910"/>

                <head>
                    <hi rendition="#italic">The Minister the Netherlands</hi> (<hi rendition="#italic">Van
                        Dyke</hi>) <hi rendition="#italic">to the</hi>
                    
                        <hi rendition="#italic">Secretary of State</hi>
                    
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">The Hague</hi></placeName>, <date
                            calendar="gregorian" when="1915-09-06T15:00:00+00:19">
                            <hi rendition="#italic">September 6, 1915, 3 p. m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 5.40 p. m.</hi>]</dateline>
                </opener>
                <p>364. Your September 2, 11 a. m. I have complied with your instruction. Archibald expects to sail for New York on the
                    steamer <hi rendition="#italic">Rotterdam</hi> September 8.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Van Dyke</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
