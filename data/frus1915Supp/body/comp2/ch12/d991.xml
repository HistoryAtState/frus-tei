    <text>
        <body>
            <div xml:id="d991">

                <pb facs="0962" n="704" sameAs="frus:frus1915Supp/pg704"/>

                <note rend="inline" type="source">File No. 841.731/308</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Great Britain</hi> (<hi
                            rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-02-02">
                            <hi rendition="#italic">February 2, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>1061. Your 1570, February 1. Unless otherwise advised by you, Department will
                    continue sending copies stopped telegrams which you may in your discretion
                    submit to British authorities. Department still in receipt of many complaints,
                    but feels you have done all possible for the present.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Bryan</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
