    <text>
        <body>
            <div xml:id="d1025">

                <pb facs="0980" n="722" sameAs="frus:frus1915Supp/pg722"/>

                <note rend="inline" type="source">File No. 841.731/699</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Great
                        Britain</hi> (<hi rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-08-06">
                            <hi rendition="#italic">August 6, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>1954. Your 2447 July 13, 4 p. m. Please continue to follow as closely as possible
                    Department’s mailed instruction 1168, June 25.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
