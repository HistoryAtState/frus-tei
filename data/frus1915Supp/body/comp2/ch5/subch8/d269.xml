    <text>
        <body>
            <div xml:id="d269">

                <pb facs="0454" n="196" sameAs="frus:frus1915Supp/pg196"/>

                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Great
                        Britain</hi> (<hi rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-09-11T17:00:00-05:00">
                            <hi rendition="#italic">September 11, 1915, 5 p. m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>2102. Department’s 2072, September 4.<anchor n="2" xml:id="d269-f1"/> Department
                    reliably informed Mediterranean fruits freely entering Netherlands and also free
                    for transit to Germany. It appears unjust to restrict free transit of American
                    fruits.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
