                <pb facs="0464" n="206" sameAs="frus:frus1915Supp/pg206"/>

                <note rend="inline" type="source">File No. 763.72112/1952</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Page</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1915-11-30">
                            <hi rendition="#italic">November 30, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received 5 p. m.</hi>]</dateline>
                </opener>
                <p>3317. Your 2504, 27th, 9 p. m. Your understanding of matter correct. Foreign
                    Office state extract included.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">American Embassy</hi>
                    </signed>
                </closer>
            </div>
