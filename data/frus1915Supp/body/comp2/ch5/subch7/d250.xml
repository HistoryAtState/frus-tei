    <text>
        <body>
            <div xml:id="d250">

                <pb facs="0445" n="187" sameAs="frus:frus1915Supp/pg187"/>

                <note rend="inline" type="source">File No. 763.72112/762</note>
                <head>
                    <hi rendition="#italic">The Consul General at London</hi> (<hi
                        rendition="#italic">Skinner</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1915-02-24">
                            <hi rendition="#italic">February 24, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received 9.30 a. m.</hi>]</dateline>
                </opener>
                <p>Department’s 23d. Cotton linters are not contraband.<anchor n="1"
                        xml:id="d250-f1"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Skinner</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d250-f1" n="1" xml:id="d250-f1-content">
                <p>Letters conveying this information were dispatched to sixty interested persons
                    and firms.</p>
            </note>
        </listAnnotation>
