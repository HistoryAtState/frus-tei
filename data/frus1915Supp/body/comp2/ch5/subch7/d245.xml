    <text>
        <body>
            <div xml:id="d245">

                <pb facs="0444" n="186" sameAs="frus:frus1915Supp/pg186"/>

                <note rend="inline" type="source">File No. 763.72112/676</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Consul General at
                        London</hi> (<hi rendition="#italic">Skinner</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-02-09">
                            <hi rendition="#italic">February 9, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>Discreetly inquire whether cotton yarn would be treated as non-contraband.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi>
                    </signed>
                </closer>
            </div>
        </body>
