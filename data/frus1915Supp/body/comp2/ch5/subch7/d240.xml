    <text>
        <body>
            <div xml:id="d240">

                <pb facs="0443" n="185" sameAs="frus:frus1915Supp/pg185"/>

                <note rend="inline" type="source">File No. 763.72112/564</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Germany</hi> (<hi rendition="#italic"
                    >Gerard</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berlin</hi></placeName>, <date
                            calendar="gregorian" when="1914-12-31T19:00:00+01:00">
                            <hi rendition="#italic">December 31, 1914, 7 p. m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received January 2, 1915, 4.15 p.
                        m.</hi>]</dateline>
                </opener>
                <p>1234. Consular Agent, Lübeck, reports demand for cotton. Is it understood to be
                    considered as contraband? May it be shipped to Germany?</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Gerard</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
