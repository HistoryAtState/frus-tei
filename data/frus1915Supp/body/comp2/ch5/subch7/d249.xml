    <text>
        <body>
            <div xml:id="d249">

                <pb facs="0445" n="187" sameAs="frus:frus1915Supp/pg187"/>

                <note rend="inline" type="source">File No. 763.72112/762a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Consul General at London</hi> (<hi
                            rendition="#italic">Skinner</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-02-23">
                            <hi rendition="#italic">February 23, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>Are cotton linters considered contraband? Answer quickly.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Bryan</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
