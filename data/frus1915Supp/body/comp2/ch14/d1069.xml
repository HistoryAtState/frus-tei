    <text>
        <body>
            <div xml:id="d1069">

                <pb facs="1002" n="744" sameAs="frus:frus1915Supp/pg744"/>

                <note rend="inline" type="source">File No. 344d62/26</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Page</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1915-01-04">
                            <hi rendition="#italic">January 4, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received 3.40 p. m.</hi>] </dateline>
                </opener>
                <p>1395. Your 705, December 7.<anchor n="2" xml:id="d1069-f1"/> British Government
                    answers that although August Piepenbrink has declared intention of becoming
                    American citizen he appears from a legal standpoint to be still a German subject
                    if he has not actually taken out letters of naturalization and that in these
                    circumstances it is not possible for him to be released.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">American Ambassador</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
