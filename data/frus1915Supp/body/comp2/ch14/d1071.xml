            <div xml:id="d1071">

                <pb facs="1003" n="745" sameAs="frus:frus1915Supp/pg745"/>

                <note rend="inline" type="source">File No. 344d.62/31</note>
                <head>
                    <hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic">Sharp</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1915-01-22">
                            <hi rendition="#italic">January 22, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received 11.50 p. m.</hi>]</dateline>
                </opener>
                <p>484. Your 357, December 7. Foreign Office advises that August Piepenbrink having
                    at time of his arrest made no protest or shown <pb facs="1004" n="746"
                        xml:id="pg746"/> any certificate indicating his intention to become a
                    naturalized American, was handed over to the Governor of Kingston in whose
                    province it now rests to decide question of his liberation.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Sharp</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
