    <text>
        <body>
            <div xml:id="d964">

                <pb facs="0951" n="693" sameAs="frus:frus1915Supp/pg693"/>

                <head>
                    <hi rendition="#italic">The Secretary of State ad interim to the Consuls at
                        Liverpool and Christiania </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-06-12">
                            <hi rendition="#italic">June 12, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>Department of Commerce requests you be informed transfer steamer <hi
                        rendition="#italic">Lapland</hi><anchor n="2" xml:id="d964-f1"/> to American
                    flag cannot be recognized since vessel was not purchased by money furnished by
                    American citizens.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d964-f1" n="2" xml:id="d964-f1-content">
                <p>Bought by the American Transatlantic Company.</p>
            </note>
        </listAnnotation>
    </standOff>
