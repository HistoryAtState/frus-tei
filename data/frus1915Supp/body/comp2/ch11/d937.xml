    <text>
        <body>
            <div xml:id="d937">

                <pb facs="0933" n="675" sameAs="frus:frus1915Supp/pg675"/>

                <note rend="inline" type="source">File No. 195.1/248</note>
                <head>
                    <hi rendition="#italic">Mr. John T. Walsh to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Mobile, Ala.</hi></placeName>, <date
                            calendar="gregorian" when="1915-01-05">
                            <hi rendition="#italic">January 5, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received 4.40 p. m.</hi>]</dateline>
                </opener>
                <p>Will United States Government guarantee protection German steamer bought by
                    American citizens and transferred to American register, <hi rendition="#italic"
                        >bona-fide</hi> sale, loaded with cotton bound for Germany? Answer my
                    expense.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">John T. Walsh</hi>
                    </signed>
                </closer>
            </div>
        </body>
