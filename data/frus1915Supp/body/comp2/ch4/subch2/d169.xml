                <note rend="inline" type="source">File No. 763.72/1484</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Italy</hi> (<hi
                            rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-02-25">
                            <hi rendition="#italic">February 25, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>168. Your 191, 19th.<anchor n="1" xml:id="d169-f1"/> Department conferring daily
                    with representatives of neutrals on subject of your telegram.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Bryan</hi>
                        
                    </signed>
                </closer>
            </div>
