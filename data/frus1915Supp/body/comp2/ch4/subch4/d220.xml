    <text>
        <body>
            <div xml:id="d220">

                <pb facs="0426" n="168" sameAs="frus:frus1915Supp/pg168"/>

                <note rend="inline" type="source">File No. 763.72112/1349</note>
                <head>
                    <hi rendition="#italic">The Italian Ambassador</hi> (<hi rendition="#italic">Macchi di
                            Cellere</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Beverly Farms, Mass.</hi></placeName>, <date
                            calendar="gregorian" when="1915-07-16">
                            <hi rendition="#italic">July 16, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received July 19</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary of state</hi>: Referring to
                    the previous correspondence exchanged on this matter, between the Department of
                    State and this Embassy, I beg to send you here enclosed a copy of the list of
                    contraband of war issued by the Royal Italian Government.</p>
                <p>I also enclose a copy of the Royal decree stating the principles of international
                    law the Royal Italian Government intends to apply during the war.<anchor n="1"
                        xml:id="d220-f1"/>
                </p>
                <p>Believe me [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">V. Macchi di Cellere</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d220-f1" n="1" xml:id="d220-f1-content">
                <p>Enclosures not printed. They correspond to the lists and rules issued to date by
                    the Allied Governments.</p>
            </note>
        </listAnnotation>
    </standOff>
