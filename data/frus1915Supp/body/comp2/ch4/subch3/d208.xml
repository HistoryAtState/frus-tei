    <text>
        <body>
            <div xml:id="d208">

                <pb facs="0417" n="159" sameAs="frus:frus1915Supp/pg159"/>

                <note rend="inline" type="source">File No. 763.72/1571</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Great Britain</hi> (<hi
                            rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-04-09T20:00:00-05:00">
                            <hi rendition="#italic">April 9, 1915, 8 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>1399. Your 1762, March 10.<anchor n="1" xml:id="d208-f1"/> Important to know
                    whether British merchant vessels have in fact armed to resist attack of
                    submarines.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Bryan</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
