    <text>
        <body>
            <div xml:id="d189">

                <pb facs="0394" n="136" sameAs="frus:frus1915Supp/pg136"/>

                <note rend="inline" type="source">File No. 763.72112/835</note>
                <head>
                    <hi rendition="#italic">The British Ambassador</hi> (<hi rendition="#italic"
                        >Spring Rice</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-03-10">
                            <hi rendition="#italic">March 10, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>The British Ambassador presents his compliments to the Secretary of State, and
                    has the honour to transmit herewith twenty copies of a list enumerating certain
                    oils and substances included under the heading “lubricants” in the British list
                    of articles to be treated as conditional contraband.</p>



                <xi:include href="d189-a1.xml" xpointer="d189-a1"/>
