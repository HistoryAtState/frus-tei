    <text>
        <body>
            <div xml:id="d193">

                <pb facs="0397" n="139" xml:id="pg139"/>

                <note rend="inline" type="source">File No. 763.72/1585</note>
                <head>
                    <hi rendition="#italic">The Minister in Sweden</hi> (<hi rendition="#italic">Morris</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 114]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Stockholm</hi></placeName>, <date
                            calendar="gregorian" when="1915-02-18">
                            <hi rendition="#italic">February 18, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received March 15.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to the Legation’s telegrams
                    No. 21 of February 16<anchor n="1" xml:id="d193-f1"/> and No. 22 of this
                        date,<anchor n="2" xml:id="d193-f2"/> I have the honor to enclose herewith
                    copies and translations of the notes delivered by Sweden to the British and
                    German Governments, protesting against the condition of neutral shipping at
                        sea.<anchor n="3" xml:id="d193-f3"/>
                </p>
                <p>The Foreign Office states that these notes are confidential as yet, as the
                    contents of same have not been made generally known.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Ira N. Morris</hi>
                        
                    </signed>
                </closer>



                <xi:include href="d193-a1.xml" xpointer="d193-a1"/>
                <xi:include href="d193-a2.xml" xpointer="d193-a2"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d193-f1" n="1" xml:id="d193-f1-content">
                <p>
                    <hi rendition="#italic">Ante</hi>, <ref target="#pg109">p. 109</ref>.</p>
            </note>
            <note corresp="#d193-f2" n="2" xml:id="d193-f2-content">
                <p>No. 22 not printed.</p>
            </note>
            <note corresp="#d193-f3" n="3" xml:id="d193-f3-content">
                <p>Copies of identical notes delivered by the Norwegian Government were forwarded by
                    the Minister in Norway with his No. 74, March 15 (File No. 763.72/1636).</p>
            </note>
        </listAnnotation>
    </standOff>
