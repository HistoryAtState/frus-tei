            <div xml:id="d181">

                <pb facs="0387" n="129" sameAs="frus:frus1915Supp/pg129"/>

                <note rend="inline" type="source">File No. 763.72/1517</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Germany</hi> (<hi
                            rendition="#italic">Gerard</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-03-02T17:00:00-05:00">
                            <hi rendition="#italic">March 2, 1915, 5 p. m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>1305. Department regrets it cannot accept suggestion contained in your 1710,
                    February 27.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Bryan</hi>
                        
                    </signed>
                </closer>
            </div>
