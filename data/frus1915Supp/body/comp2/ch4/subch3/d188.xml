    <text>
        <body>
            <div xml:id="d188">

                <pb facs="0392" n="134" sameAs="frus:frus1915Supp/pg134"/>

                <note rend="inline" type="source">File No. 763.72/1547</note>
                <head>
                    <hi rendition="#italic">The Netherland Minister</hi> (<hi
                            rendition="#italic">Van Rappard</hi>) <hi rendition="#italic"
                        >to the Counselor for the Department of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-03-04">
                            <hi rendition="#italic">March 4, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received March 6</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Lansing</hi>: Herewith I send to you the exact text of the
                    notes my Government delivered to the British Government regarding the abuse of
                    the neutral flags and to the German Government regarding the war-zone
                    declaration.</p>
                <p>Yours very truly,</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">W. L. F. C. v. Rappard</hi>
                        
                    </signed>
                </closer>



                <xi:include href="d188-a1.xml" xpointer="d188-a1"/>
                <xi:include href="d188-a2.xml" xpointer="d188-a2"/>
