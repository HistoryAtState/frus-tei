    <text>
        <body>
            <div xml:id="d141">

                <pb facs="0361" n="103" sameAs="frus:frus1915Supp/pg103"/>

                <note rend="inline" type="source">File No. 763.72/1452</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Germany</hi> (<hi rendition="#italic"
                        >Gerard</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berlin</hi></placeName>, <date
                            calendar="gregorian" when="1915-02-13">
                            <hi rendition="#italic">February 13, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received February 15, 8 a.
                        m.</hi>]</dateline>
                </opener>
                <p>1594. Think Germany will offer idea of American ships’ being convoyed by American
                    warships which can wait in Irish ports and be notified by wireless.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Gerard</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
