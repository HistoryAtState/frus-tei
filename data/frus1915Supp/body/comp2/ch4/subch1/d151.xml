            <div xml:id="d151">

                <pb facs="0367" n="109" sameAs="frus:frus1915Supp/pg109"/>

                <note rend="inline" type="source">File No. 763.72/1461</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Italy</hi>
                        (<hi rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-02-17">
                            <hi rendition="#italic">February 17, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>164. Your 190, February 16, 9 a. m. Please keep Department promptly advised as to
                    situation.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi>
                    </signed>
                </closer>
            </div>
