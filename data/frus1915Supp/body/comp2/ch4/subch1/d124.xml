    <text>
        <body>
            <div xml:id="d124">

                <pb facs="0351" n="93" sameAs="frus:frus1915Supp/pg93"/>

                <note rend="inline" type="source">File No. 763.72/1430</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Germany</hi> (<hi rendition="#italic"
                    >Gerard</hi>) <hi rendition="#italic">to the Secretary of Stale
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berlin</hi></placeName>, <date
                            calendar="gregorian" when="1915-02-02">
                            <hi rendition="#italic">February 2, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received February 4, 8 a. m.</hi>]</dateline>
                </opener>
                <p>1504. Informed to-day by Undersecretary Zimmermann that as England was trying to starve Germany out,
                    quite probably a submarine blockade of England would be declared soon and the
                    channel closed.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Gerard</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
