    <text>
        <body>
            <div xml:id="d396">

                <pb facs="0531" n="273" xml:id="pg273"/>

                <note rend="inline" type="source">File No. 763.72112/1003c</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in the
                        Netherlands</hi> (<hi rendition="#italic">Van Dyke</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-03-04">
                            <hi rendition="#italic">March 4, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>117. Ascertain if Overseas Trust will act as consignee American cotton for
                    Holland consumption. Important in order to prevent prohibitive insurance premium
                    of 30 per cent.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi>
                    </signed>
                </closer>
            </div>
        </body>
