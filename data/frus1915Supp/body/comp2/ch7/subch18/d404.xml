    <text>
        <body>
            <div xml:id="d404">

                <pb facs="0533" n="275" sameAs="frus:frus1915Supp/pg275"/>

                <note rend="inline" type="source">File No. 763.72112/1169</note>
                <head>
                    <hi rendition="#italic">The Minister in the Netherlands</hi> (<hi
                        rendition="#italic">Van Dyke</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">The Hague</hi></placeName>, <date
                            calendar="gregorian" when="1915-05-25">
                            <hi rendition="#italic">May 25, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received 10.30 a. m.</hi>]</dateline>
                </opener>
                <p>270. Your 155, 22d. Tobacco from Netherlands colonies may come to Holland
                    consigned to agents of colonial estates for sale at auction without restriction
                    to both neutrals and belligerents. Tobacco from all other sources must be
                    consigned to Netherlands Oversea Trust and may not be exported to belligerent
                    countries. This is not discrimination made by Netherlands Government but <hi
                        rendition="#italic">modus vivendi</hi> arranged by Allies with Oversea Trust
                    based on theory that Netherlands and colonies are one country.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Van Dyke</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
