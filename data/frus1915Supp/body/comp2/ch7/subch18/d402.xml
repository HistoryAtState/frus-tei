    <text>
        <body>
            <div xml:id="d402">

                <pb facs="0532" n="274" sameAs="frus:frus1915Supp/pg274"/>

                <note rend="inline" type="source">File No. 763.72112/1162</note>
                <head>
                    <hi rendition="#italic">The Minister in the Netherlands</hi> (<hi rendition="#italic">Van
                        Dyke</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">The Hague</hi></placeName>, <date
                            calendar="gregorian" when="1915-05-22">
                            <hi rendition="#italic">May 22, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received 5 p. m.</hi>]</dateline>
                </opener>
                <p>269. Netherlands Oversea Trust forbids further imports cotton oil fearing too
                    much accumulated stock; representations now being made may induce them to revoke
                    order.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Van Dyke</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
