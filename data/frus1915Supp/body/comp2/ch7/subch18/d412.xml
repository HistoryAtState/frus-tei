    <text>
        <body>
            <div xml:id="d412">

                <pb facs="0537" n="279" sameAs="frus:frus1915Supp/pg279"/>

                <note rend="inline" type="source">File No. 763.72112/1600</note>
                <head>
                    <hi rendition="#italic">The Minister in the Netherlands</hi> (<hi rendition="#italic">Van
                        Dyke</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">The Hague</hi></placeName>, <date
                            ana="#date_undated-inferred-from-document-content-and-sibling-dates"
                            calendar="gregorian" notAfter="1915-09-20T16:30:00-05:00"
                            notBefore="1915-09-18T00:00:00-05:00"><hi rendition="#italic"
                                >undated</hi></date>.<lb/>[<hi rendition="#italic">Received
                            September 20, 1915, 4.30 p. m.</hi>]</dateline>
                </opener>
                <p>379. Your 199, 18th. Have endeavored obtain permission for
                        Martin consignment. Oversea Trust declines because
                    present supply of these goods sufficient for Dutch consumption.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Van Dyke</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
