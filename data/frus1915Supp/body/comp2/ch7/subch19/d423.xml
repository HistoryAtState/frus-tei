    <text>
        <body>
            <div xml:id="d423">

                <pb facs="0542" n="284" sameAs="frus:frus1915Supp/pg284"/>

                <note rend="inline" type="source">File No. 763.72112/1813</note>
                <head>
                    <hi rendition="#italic">The Minister in Sweden</hi> (<hi rendition="#italic">Morris</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Stockholm</hi></placeName>, <date
                            calendar="gregorian" when="1915-10-30T13:00:00+01:00">
                            <hi rendition="#italic">October 30, 1915, 1 p. m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 11 p. m.</hi>]</dateline>
                </opener>
                <p>68. Negotiations have been definitely broken off between Swedish and English
                    trade commissions.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Morris</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
