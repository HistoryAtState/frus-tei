    <text>
        <body>
            <div xml:id="d432">

                <pb facs="0550" n="292" sameAs="frus:frus1915Supp/pg292"/>

                <note rend="inline" type="source">File No. 763.72112/1657</note>
                <head>
                    <hi rendition="#italic">The Minister in Switzerland</hi> (<hi
                        rendition="#italic">Stovall</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berne</hi></placeName>, <date
                            calendar="gregorian" when="1915-10-01">
                            <hi rendition="#italic">October 1, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received 7.45 p. m.</hi>]</dateline>
                </opener>
                <p>199. Your 157, 30th.<anchor n="1" xml:id="d432-f1"/> Details of agreement not yet
                    perfected but trust proposal approved by Federal Council and organization will
                    probably be in operation within a month. I have reported fully by mail in my
                    despatch No. 209, September 29.<anchor n="1" xml:id="d432-f2"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stovall</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
