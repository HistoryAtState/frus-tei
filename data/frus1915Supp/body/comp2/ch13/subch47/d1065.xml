    <text>
        <body>
            <div xml:id="d1065">

                <pb facs="1000" n="742" sameAs="frus:frus1915Supp/pg742"/>

                <note rend="inline" type="source">File No. 124.0665/21</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Japan</hi> (<hi
                            rendition="#italic">Guthrie</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 219]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Tokyo</hi></placeName>, <date
                            calendar="gregorian" when="1915-02-23">
                            <hi rendition="#italic">February 23, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received March 18</hi>.] </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to the Department’s
                    telegram of November 25 last,<anchor n="1" xml:id="d1065-f1"/> concerning the
                    establishment of uniform regulations for the transference of correspondence of
                    American diplomatic and consular officers in belligerent territories, I have the
                    honor to transmit herewith a copy of a <hi rendition="#italic">note verbale</hi>
                    received from the Foreign Office in response to this Embassy’s
                    representations.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Geo. W. Guthrie</hi>
                        
                    </signed>
                </closer>


                <xi:include href="d1065-a1.xml" xpointer="d1065-a1"/>
            </div>
        </body>
    </text>
