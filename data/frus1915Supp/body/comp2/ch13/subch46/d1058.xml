    <text>
        <body>
            <div xml:id="d1058">

                <pb facs="0997" n="739" sameAs="frus:frus1915Supp/pg739"/>

                <note rend="inline" type="source">File No. 841.711/144</note>
                <head>
                    <hi rendition="#italic">The Consul General at London</hi> (<hi
                        rendition="#italic">Skinner</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1915-12-24">
                            <hi rendition="#italic">December 24, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received 3.55 p. m.</hi>] </dateline>
                </opener>
                <p>Customs at Kirkwall seized, 18th, 597 bags parcel mail from <hi
                        rendition="#italic">Frederik VIII</hi> manifested for Norway, Sweden, and
                    Denmark.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Skinner</hi>
                    </signed>
                </closer>
            </div>
        </body>
