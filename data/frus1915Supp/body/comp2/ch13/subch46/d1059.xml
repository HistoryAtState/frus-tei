    <text>
        <body>
            <div xml:id="d1059">

                <pb facs="0997" n="739" sameAs="frus:frus1915Supp/pg739"/>

                <note rend="inline" type="source">File No. 841.711/145</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Germany</hi> (<hi rendition="#italic"
                        >Gerard</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Berlin</hi></placeName>, <date
                            calendar="gregorian" when="1915-12-24">
                            <hi rendition="#italic">December 24, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received December 25, 4.50 p.
                        m.</hi>]</dateline>
                </opener>
                <p>3263. American Association of Commerce and Trade here request me to inform you
                    that 5,000 packages of merchandise, American property, have been seized by
                    British Government from Danish steamer <hi rendition="#italic">United
                        States</hi> on her last trip to United States.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Gerard</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
