            <div xml:id="d924">

                <pb facs="0925" n="667" sameAs="frus:frus1915Supp/pg667"/>

                <note rend="inline" type="source">File No. 611.479/153</note>
                <head>
                    <hi rendition="#italic">The Consul General at Sydney</hi> (<hi rendition="#italic">Bray</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Sydney</hi></placeName>, <date
                            ana="#date_undated-inferred-from-document-content-and-sibling-dates"
                            calendar="gregorian" notAfter="1915-02-26T08:00:00-05:00"
                            notBefore="1915-02-23T00:00:00+10:00">
                            <hi rendition="#italic">undated</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received February 26, 1915, 8 a.
                            m.</hi>]</dateline>
                </opener>
                <p>Commonwealth government advises shipment merino wool United States may now be
                    made as previously provided.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Bray</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
