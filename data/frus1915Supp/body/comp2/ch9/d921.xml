                <pb facs="0923" n="665" sameAs="frus:frus1915Supp/pg665"/>

                <note rend="inline" type="source">File No. 611.479/144</note>
                <head>
                    <hi rendition="#italic">The Consul General at Sydney</hi> (<hi rendition="#italic">Bray</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Sydney</hi></placeName>, <date
                            calendar="gregorian" when="1915-02-09">
                            <hi rendition="#italic">February 9, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received 8 a. m.</hi>]</dateline>
                </opener>
                <p>Department’s 6th.<anchor n="1" xml:id="d921-f1"/> Embargo [on wool] reimposed.
                    Permits issued prior 5th hold good.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Bray</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
