    <text>
        <body>
            <div xml:id="d917">

                <pb facs="0920" n="662" sameAs="frus:frus1915Supp/pg662"/>

                <note rend="inline" type="source">File No. 611.419/148</note>
                <head>
                    <hi rendition="#italic">The British Ambassador</hi> (<hi rendition="#italic">Spring
                        Rice</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 22]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-01-15">
                            <hi rendition="#italic">January 15, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received January 16</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to previous communications
                    with your Department on the subject of the embargo on export of wool from the
                    United Kingdom, I have the honour to transmit to you herewith copy of a telegram
                    which I have received from my Government.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Cecil Spring Rice</hi>
                        
                    </signed>
                </closer>


                <xi:include href="d917-a1.xml" xpointer="d917-a1"/>
            </div>
