    <text>
        <body>
            <div xml:id="d916">

                <pb facs="0920" n="662" sameAs="frus:frus1915Supp/pg662"/>

                <note rend="inline" type="source">File No. 611.479/131</note>
                <head>
                    <hi rendition="#italic">The Consul General at Sydney</hi> (<hi
                        rendition="#italic">Bray</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Sydney</hi></placeName>, <date
                            calendar="gregorian" when="1915-01-14">
                            <hi rendition="#italic">January 14, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received 8 a. m.</hi>]</dateline>
                </opener>
                <p>Comptroller customs advises when collector satisfied <hi rendition="#italic">bona
                        fides</hi> ship; shipment merino wool, hides, skins to United States allowed
                    in American ships same condition as British ships.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bray</hi>
                    </signed>
                </closer>
            </div>
        </body>
