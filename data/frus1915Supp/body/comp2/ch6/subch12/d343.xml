    <text>
        <body>
            <div xml:id="d343">

                <pb facs="0502" n="244" sameAs="frus:frus1915Supp/pg244"/>

                <note rend="inline" type="source">File No. 763.72112/1024</note>
                <head>
                    <hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic"
                        >Sharp</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1915-04-17">
                            <hi rendition="#italic">April 17, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received 2 p.m.</hi>]</dateline>
                </opener>
                <p>698. Your 665, 25th.<anchor n="2" xml:id="d343-f1"/> Foreign Office states that
                    the Allied Governments consider German laws and publications as one of the most
                    efficacious means of propaganda against the interests of their national defense
                    and that under these circumstances the Government of the Republic regrets it
                    cannot undertake to exempt books and publications destined to American public
                    library from the measures of decree of March 13.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Sharp</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
