    <text>
        <body>
            <div xml:id="d341">

                <pb facs="0502" n="244" sameAs="frus:frus1915Supp/pg244"/>

                <note rend="inline" type="source">File No. 611.629/93</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Great Britain</hi> (<hi
                            rendition="#italic">Page</hi>)<anchor n="1" xml:id="d341-f1"
                    />
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-03-25">
                            <hi rendition="#italic">March 25, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>1315. Please ascertain from Foreign Office whether books and publications
                    published in Germany will be unmolested under order in council of March 15[11],
                    when exported from Germany to United States for public libraries in this
                    country.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Bryan</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d341-f1" n="1" type="source" xml:id="d341-f1-content">
                <p>The same to the Ambassador in France, No. 665, March 25.</p>
            </note>
        </listAnnotation>
    </standOff>
