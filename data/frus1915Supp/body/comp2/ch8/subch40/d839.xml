    <text>
        <body>
            <div xml:id="d839">

                <pb facs="0860" n="602" sameAs="frus:frus1915Supp/pg602"/>

                <note rend="inline" type="source">File No. 763.72112/1802</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Page</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 2300]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1915-10-08">
                            <hi rendition="#italic">October 8, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received October 28</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith for
                    the information of the Department a copy of a note under date of October 7,
                    which has been addressed to the Embassy by the Foreign Office in reply to a
                    communication made to the British Procurator General by the Consul General in
                    London on September 27 in reference to the cargo of the S. S. <hi
                        rendition="#italic">Vitalia</hi>.<anchor n="1" xml:id="d839-f1"/>
                </p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Walter Hines Page</hi>
                    </signed>
                </closer>


                <xi:include href="d839-a1.xml" xpointer="d839-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d839-f1" n="1" xml:id="d839-f1-content">
                <p>See telegram from the Consul General at London, September 20, <hi
                        rendition="#italic">ante</hi>, <ref target="#pg550">p. 550</ref>.</p>
            </note>
