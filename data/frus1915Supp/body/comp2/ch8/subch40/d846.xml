    <text>
        <body>
            <div xml:id="d846">

                <pb facs="0865" n="607" sameAs="frus:frus1915Supp/pg607"/>

                <note rend="inline" type="source">File No. 462.11 H21/10</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Germany</hi> (<hi rendition="#italic"
                    >Gerard</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1672]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berlin</hi></placeName>, <date
                            calendar="gregorian" when="1915-10-19">
                            <hi rendition="#italic">October 19, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received November 1</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to the Department’s
                    telegram No. 2022, dated July 31, 1915, 3 p. m.,<anchor n="1" xml:id="d846-f1"/>
                    and to my telegram of even date, No. 3023,<anchor n="2" xml:id="d846-f2"/> I
                    have the honor to transmit herewith a translation of a note received to-day from
                    the Imperial Foreign Office, dated October 16, 1915, relating the facts of the
                    sinking of the American steamer <hi rendition="#italic">Leelanaw</hi> by a
                    German submarine on July 25, 1915.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">J. W. Gerard</hi>
                        
                    </signed>
                </closer>


                <xi:include href="d846-a1.xml" xpointer="d846-a1"/>
            </div>
        </body>
    </text>
