    <text>
        <body>
            <div xml:id="d890">

                <pb facs="0900" n="642" sameAs="frus:frus1915Supp/pg642"/>

                <note rend="inline" type="source">File No. 865.857An2/127</note>
                <head>
                    <hi rendition="#italic">The German Embassy to the
                            Department of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">J. Nr. A 8293]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-12-18">
                            <hi rendition="#italic">December 18, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>The Imperial German Embassy presents its compliments to the United States
                    Department of State and has the honor to enclose herewith one wireless cipher
                    message, in duplicate, to the Foreign Office in Berlin for kind transmission to
                    the Tuckerton station.</p>
                <p>Duplicate copies of the message in plain English are likewise enclosed.</p>


                <xi:include href="d890-a1.xml" xpointer="d890-a1"/>
