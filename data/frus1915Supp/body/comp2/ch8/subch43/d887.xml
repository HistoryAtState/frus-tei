    <text>
        <body>
            <div xml:id="d887">

                <pb facs="0898" n="640" sameAs="frus:frus1915Supp/pg640"/>

                <note rend="inline" type="source">File No. 865.857An2/125</note>
                <head>
                    <hi rendition="#italic">The German Embassy to the
                            Department of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">J. Nr. A 8257]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-12-17">
                            <hi rendition="#italic">December 17, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>The Imperial German Embassy presents its compliments to the United States
                    Department of State and has the honor to enclose herewith a wireless cipher
                    message, in duplicate, to the Foreign Office, Berlin, for kind transmission to
                    the Tuckerton radio station.<anchor n="2" xml:id="d887-f1"/>
                </p>
                <p>Duplicate copies of the text of the message are likewise enclosed.</p>


                <xi:include href="d887-a1.xml" xpointer="d887-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d887-f1" n="2" xml:id="d887-f1-content">
                <p>Approved for transmission.</p>
            </note>
        </listAnnotation>
    </standOff>
