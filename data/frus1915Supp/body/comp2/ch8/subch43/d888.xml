    <text>
        <body>
            <div xml:id="d888">

                <pb facs="0899" n="641" sameAs="frus:frus1915Supp/pg641"/>

                <note rend="inline" type="source">File No. 865.857An2/83a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Italy</hi> (<hi
                            rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-12-17">
                            <hi rendition="#italic">December 17, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>420. Obtain names of Americans on board <hi rendition="#italic">Ancona;</hi>
                    obtain names of Americans lost or injured on <hi rendition="#italic"
                    >Ancona</hi>. Cable answer to the first question immediately, and answer to the
                    second as soon as possible.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
