    <text>
        <body>
            <div xml:id="d886">

                <pb facs="0898" n="640" xml:id="pg640"/>

                <note rend="inline" type="source">File No. 763.72112/2057</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Swedish Minister</hi> (<hi
                        rendition="#italic">Ekengren</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-12-16">
                            <hi rendition="#italic">December 16, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the
                    receipt of your note of the 18th ultimo,<anchor n="1" xml:id="d886-f1"/> in
                    which you advise me that you have been instructed by the Royal Government of
                    Sweden to communicate to me certain observations made by the Royal Swedish
                    Government regarding a note addressed by the Government of the United States to
                    the Government of Great Britain on November 5 last, concerning the matter of the
                    interference by belligerents with neutral commerce and navigation.</p>
                <p>Due note has been taken by the Government of the United States of the
                    observations made by the Royal Swedish Government.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
