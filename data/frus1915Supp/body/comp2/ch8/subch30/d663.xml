                <pb facs="0716" n="458" sameAs="frus:frus1915Supp/pg458"/>

                <note rend="inline" type="source">File No. 841.115R221/5</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Page</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1915-07-03">
                            <hi rendition="#italic">July 3, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received 11.55 a. m.</hi>]</dateline>
                </opener>
                <p>2499. Department’s 1681, June 8, <hi rendition="#italic">re Helge</hi>.<anchor
                        n="2" xml:id="d663-f1"/> Foreign Office informs me this matter receiving
                    careful attention of British Government.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">American Ambassador</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
