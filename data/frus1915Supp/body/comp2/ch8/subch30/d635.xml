    <text>
        <body>
            <div xml:id="d635">

                <pb facs="0697" n="439" sameAs="frus:frus1915Supp/pg439"/>

                <head>
                    <hi rendition="#italic">The Secretary of State ad interim to the Ambassador in
                        Germany </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-06-12">
                            <hi rendition="#italic">June 12, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>1820. Your 2416, June 11. Department does not feel that methods proposed in your
                    2255, May 19, and 2369, June 4, can advantageously be brought up for discussion
                    at present time.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
