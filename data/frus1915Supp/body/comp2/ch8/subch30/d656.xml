    <text>
        <body>
            <div xml:id="d656">

                <pb facs="0713" n="455" xml:id="pg455"/>

                <note rend="inline" type="source">File No. 763.72112/1266</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Consul General at London</hi> (<hi rendition="#italic">Skinner</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-06-28">
                            <hi rendition="#italic">June 28, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>Statements in your despatch June 11, No. 533, are of interest.<anchor n="1"
                        xml:id="d656-f1"/> Department would like to receive earliest possible moment
                    all available and authentic data in keeping with your observation in the third
                    paragraph of first page of your note to Embassy.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Osborne</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
