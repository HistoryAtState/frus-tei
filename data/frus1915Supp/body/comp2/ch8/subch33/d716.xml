    <text>
        <body>
            <div xml:id="d716">

                <pb facs="0750" n="492" sameAs="frus:frus1915Supp/pg492"/>

                <note rend="inline" type="source">File No. 841.857Ib3</note>
                <head>
                    <hi rendition="#italic">The Consul at Cork</hi> (<hi rendition="#italic">Frost</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Queenstown</hi></placeName>, <date
                            ana="#date_undated-inferred-from-document-content" calendar="gregorian"
                            when="1915-07-31"><hi rendition="#italic">undated</hi></date>.<lb/>[<hi
                            rendition="#italic">Received July 31, 1915, 11 a. m.</hi>]</dateline>
                </opener>
                <p>Steamer <hi rendition="#italic">Iberian</hi> submarined. Wiley, American
                    muleteer, killed.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Frost</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
