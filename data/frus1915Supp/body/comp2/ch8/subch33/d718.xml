    <text>
        <body>
            <div xml:id="d718">

                <pb facs="0750" n="492" sameAs="frus:frus1915Supp/pg492"/>

                <note rend="inline" type="source">File No. 362.115H21/5</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Germany</hi> (<hi
                            rendition="#italic">Gerard</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-07-31T15:00:00-05:00">
                            <hi rendition="#italic">July 31, 1915, 3 p. m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>2022. Department informed American ship <hi rendition="#italic">Leelanaw</hi>,
                    after examination ship’s papers, sunk by German submarine July 25. Obtain and
                    forward Department certified copies ship’s papers with full report of facts.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
