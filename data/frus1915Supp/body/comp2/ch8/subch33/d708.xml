    <text>
        <body>
            <div xml:id="d708">

                <pb facs="0747" n="489" xml:id="pg489"/>

                <note rend="inline" type="source">File No. 763.72112/1408</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Germany</hi> (<hi rendition="#italic"
                    >Gerard</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1194]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berlin</hi></placeName>, <date
                            calendar="gregorian" when="1915-07-09">
                            <hi rendition="#italic">July 9, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received July 27.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith a
                    copy and a translation of a <hi rendition="#italic">note verbale</hi> from the
                    German Foreign Office relative to the reciprocity of treatment of claimants in
                    prize court proceedings in Germany and in the United States.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">James W. Gerard</hi>
                        
                    </signed>
                </closer>


                <xi:include href="d708-a1.xml" xpointer="d708-a1"/>
            </div>
