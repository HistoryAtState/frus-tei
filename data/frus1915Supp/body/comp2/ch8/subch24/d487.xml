    <text>
        <body>
            <div xml:id="d487">

                <pb facs="0598" n="340" xml:id="pg340"/>

                <note rend="inline" type="source">File No. 451.11B74</note>
                <head>
                    <hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic"
                        >Sharp</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1915-02-28">
                            <hi rendition="#italic">February 28, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received 5.10 p. m.</hi>]</dateline>
                </opener>
                <p>574. Morning papers publish announcement by Ministry of Marine to effect that <hi
                        rendition="#italic">Dacia</hi> was captured in western part of English
                    Channel by French cruiser and taken to Brest.<anchor n="1" xml:id="d487-f1"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Sharp</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d487-f1" n="1" xml:id="d487-f1-content">
                <p>For previous correspondence concerning the <hi rendition="#italic">Dacia</hi>
                    case, see the section dealing with transfer of ships, <hi rendition="#italic"
                        >post</hi>, <ref target="#pg674">p. 674</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
