    <text>
        <body>
            <div xml:id="d562">

                <pb facs="0642" n="384" sameAs="frus:frus1915Supp/pg384"/>

                <note rend="inline" type="source">File No. 300.115G95/9</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Germany</hi> (<hi rendition="#italic"
                    >Gerard</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berlin</hi></placeName>, <date
                            calendar="gregorian" when="1915-05-07">
                            <hi rendition="#italic">May 7, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received 10.45 p. m.</hi>]</dateline>
                </opener>
                <p>2175. Department’s 1612, 3d.<anchor n="1" xml:id="d562-f1"/> German Admiralty has
                    as yet no news as to <hi rendition="#italic">Gulflight</hi>. Will report as soon
                    as information obtained.<anchor n="2" xml:id="d562-f2"/>
                </p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Gerard</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d562-f1" n="1" xml:id="d562-f1-content">
                <p>See footnote 1, <hi rendition="#italic">ante</hi>, <ref target="#pg378">p.
                        378</ref>.</p>
            </note>
            <note corresp="#d562-f2" n="2" xml:id="d562-f2-content">
                <p>The statement of the German Government is contained in the note of June 1,
                    transmitted by the Ambassador in Germany in his telegram No. 2346 of the same
                    date, <hi rendition="#italic">post,</hi>
                    <ref target="#pg431">p. 431</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
