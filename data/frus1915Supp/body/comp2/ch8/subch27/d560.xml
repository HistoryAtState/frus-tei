                <pb facs="0642" n="384" sameAs="frus:frus1915Supp/pg384"/>

                <note rend="inline" type="source">File No. 841.857/97</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Page</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1915-05-07">
                            <hi rendition="#italic">May 7, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received 3.06 p. m.</hi>]</dateline>
                </opener>
                <p>2060. The <hi rendition="#italic">Lusitania</hi> was torpedoed off the Irish
                    coast and sunk in half an hour. No news yet of passengers.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">American Ambassador</hi>
                    </signed>
                </closer>
            </div>
        </body>
