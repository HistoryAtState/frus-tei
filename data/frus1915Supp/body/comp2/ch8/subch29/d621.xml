    <text>
        <body>
            <div xml:id="d621">

                <pb facs="0685" n="427" sameAs="frus:frus1915Supp/pg427"/>

                <note rend="inline" type="source">File No. 763.72112/1208</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Page</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1468]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1915-05-20">
                            <hi rendition="#italic">May 20, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received June 1</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to my cablegram No. 2129 of May
                        19,<anchor n="1" xml:id="d621-f1"/> I have the honor to transmit herewith to
                    the Department copy, in duplicate, of a memorandum respecting American ships and
                    cargoes detained at British ports, which I have received from Sir Edward Grey in
                    reply to my numerous conversations with him upon this subject, and also a copy,
                    in duplicate, of a <hi rendition="#italic">note verbale</hi> substantiating his
                    memorandum.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. H. Page</hi>
                    </signed>
                </closer>



                <xi:include href="d621-a1.xml" xpointer="d621-a1"/>
                <xi:include href="d621-a2.xml" xpointer="d621-a2"/>
            </div>
