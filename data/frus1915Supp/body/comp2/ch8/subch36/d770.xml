    <text>
        <body>
            <div xml:id="d770">

                <pb facs="0789" n="531" sameAs="frus:frus1915Supp/pg531"/>

                <note rend="inline" type="source">File No. 763.72112/1561a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Consul General at
                        London</hi> (<hi rendition="#italic">Skinner</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-09-02">
                            <hi rendition="#italic">September 2, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>Are you aware of any instance in which charges for unloading in connection with
                    seizure shipments have been imposed on neutral vessel? Department understands
                    port charges are imposed on vessels in such cases. Please telegraph.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
