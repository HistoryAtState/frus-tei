                <note rend="inline" type="source">File No. 763.72112/1642</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Page</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1915-09-28">
                            <hi rendition="#italic">September 28, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received 8.05 p. m.</hi>]</dateline>
                </opener>
                <p>2879. Your 2178, 27th. Saturday morning, October 2, satisfactory to British
                    Government.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">American Ambassador</hi>
                    </signed>
                </closer>
