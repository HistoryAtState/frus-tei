    <text>
        <body>
            <div xml:id="d815">

                <pb facs="0815" n="557" sameAs="frus:frus1915Supp/pg557"/>

                <note rend="inline" type="source">File No. 763.72112/1531</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in Great
                        Britain</hi> (<hi rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-09-27">
                            <hi rendition="#italic">September 27, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>2178. Your 2851, September 23.<anchor n="1" xml:id="d815-f1"/> Department
                    agreeable to simultaneous publication of Embassy’s memorandum of June 3, and
                    Foreign Office note August 13,<anchor n="2" xml:id="d815-f2"/> morning press
                    Saturday, October 2. Cable if this date satisfactory.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Polk</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
