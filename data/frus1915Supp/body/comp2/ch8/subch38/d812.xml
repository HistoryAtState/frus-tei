    <text>
        <body>
            <div xml:id="d812">

                <pb facs="0814" n="556" sameAs="frus:frus1915Supp/pg556"/>

                <note rend="inline" type="source">File No. 841.857/40</note>
                <head>
                    <hi rendition="#italic">The Consul at Cork</hi> (<hi rendition="#italic">Frost</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Queenstown</hi></placeName>, <date
                            ana="#date_undated-inferred-from-outside-research" calendar="gregorian"
                            when="1915-09-24">
                            <hi rendition="#italic">undated</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received September 24, 1915, 8 a.
                            m.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#italic">Anglo-Columbian</hi>, British horse transport, Montreal
                    to England, torpedoed after chase 78 miles, off Fastnet, 9.30 this morning. Fair
                    warning and time to take boats given. Six Americans in crew. No casualties.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Frost</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
