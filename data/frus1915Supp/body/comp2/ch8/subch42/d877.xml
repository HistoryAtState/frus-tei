            <div xml:id="d877">

                <pb facs="0883" n="625" sameAs="frus:frus1915Supp/pg625"/>

                <note rend="inline" type="source">File No. 300.115P44/2</note>
                <head>
                    <hi rendition="#italic">The Consul at Algiers</hi> (<hi rendition="#italic"
                        >Mason</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Algiers</hi></placeName>, <date
                            ana="#date_undated-inferred-from-document-content" calendar="gregorian"
                            notAfter="1915-12-10T15:20:00-05:00"
                            notBefore="1915-12-10T07:00:00+00:00" when="1915-12-10">
                            <hi rendition="#italic">undated</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received December 10, 1915, 3.20 p.
                            m.</hi>]</dateline>
                </opener>
                <p>American steamer <hi rendition="#italic">Petrolite</hi> arrived Algiers 7 a. m.,
                    December 10. Captain reports vessel attacked nineteen hours from Alexandria by
                    submarine flying Austrian flag. One seaman wounded by shell. After examination
                    papers and forcibly taking provisions vessel allowed to proceed.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Mason</hi>
                    </signed>
                </closer>
            </div>
