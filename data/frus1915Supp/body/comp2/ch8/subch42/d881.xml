    <text>
        <body>
            <div xml:id="d881">

                <pb facs="0885" n="627" sameAs="frus:frus1915Supp/pg627"/>

                <note rend="inline" type="source">File No. 763.72/2304</note>
                <head>
                    <hi rendition="#italic">The Minister in Sweden</hi> (<hi rendition="#italic">Morris</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 475]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Stockholm</hi></placeName>, <date
                            calendar="gregorian" when="1915-11-18">
                            <hi rendition="#italic">November 18, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received December 13</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith
                    copies and translations of a royal decree concerning the convoying of Swedish
                    merchant vessels during time of war.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Ira N. Morris</hi>
                        
                    </signed>
                </closer>



                <xi:include href="d881-a1.xml" xpointer="d881-a1"/>
            </div>
