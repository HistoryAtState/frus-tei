    <text>
        <body>
            <div xml:id="d613">

                <pb facs="0676" n="418" sameAs="frus:frus1915Supp/pg418"/>

                <note rend="inline" type="source">File No. 441.11B74/20</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Page</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1915-05-29">
                            <hi rendition="#italic">May 29, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received 12.30 p. m.</hi>]</dateline>
                </opener>
                <p>2189. Your 1512, 6th.<anchor n="1" xml:id="d613-f1"/> In reply to my
                    representations regarding <hi rendition="#italic">Segurança</hi> Foreign Office
                    advises me that instructions have been sent to British Ambassador at Washington
                    to inform British consuls that, to minimize the risks of delay and detention, it
                    would be advisable that shippers should arrange to have their cargoes for
                    Holland consigned to the Netherlands Oversea Trust.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">American Ambassador</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
