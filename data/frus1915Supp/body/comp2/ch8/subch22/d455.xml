    <text>
        <body>
            <div xml:id="d455">

                <pb facs="0566" n="308" sameAs="frus:frus1915Supp/pg308"/>

                <note rend="inline" type="source">File No. 300.115/2101</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Great Britain</hi> (<hi
                            rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-01-15">
                            <hi rendition="#italic">January 15, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>964. Department advised by Swiss Legation Department Foreign Affairs Swiss
                    Government requests good offices of United States with British Government for
                    release of 800 tons copper steamers <hi rendition="#italic">Ascot, Palermo</hi>
                    and <hi rendition="#italic">Regina d’ltalia</hi>, detained at Gibraltar, shipped
                    by American Metal Company, destined for Brown Boveri, Baden, Aargau,
                    Switzerland. Appropriately present matter British Foreign Office, requesting
                    release copper for forwarding to Swiss consignees.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Bryan</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
