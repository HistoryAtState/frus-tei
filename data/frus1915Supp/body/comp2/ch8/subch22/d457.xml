    <text>
        <body>
            <div xml:id="d457">

                <pb facs="0569" n="311" xml:id="pg311"/>

                <note rend="inline" type="source">File No. 763.72112/634</note>
                <head>
                    <hi rendition="#italic">The Minister in Sweden</hi> (<hi rendition="#italic">Morris</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Stockholm</hi></placeName>, <date
                            calendar="gregorian" when="1915-01-19T19:00:00+01:00">
                            <hi rendition="#italic">January 19, 1915, 7 p. m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 11.45 p. m.</hi>]</dateline>
                </opener>
                <p>14. Swedish Government has furnished me with memorandum calling attention to fact
                    that statistics of Swedish imports as set out in British note of January
                        7<anchor n="1" xml:id="d457-f1"/> do not correspond with Swedish statistics
                    of imports.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Morris</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
