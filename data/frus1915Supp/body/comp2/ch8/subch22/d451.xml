                <pb facs="0564" n="306" sameAs="frus:frus1915Supp/pg306"/>

                <note rend="inline" type="source">File No. 763.72/1382</note>
                <head>
                    <hi rendition="#italic">The Minister in Sweden</hi> (<hi rendition="#italic"
                        >Morris</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Stockholm</hi></placeName>, <date
                            calendar="gregorian" when="1915-01-13">
                            <hi rendition="#italic">January 13, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received 8 p. m.</hi>]</dateline>
                </opener>
                <p>12. Decree prohibits transit war material over Sweden.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Morris</hi>
                    </signed>
                </closer>
            </div>
