    <text>
        <body>
            <div xml:id="d439">

                <pb facs="0554" n="296" sameAs="frus:frus1915Supp/pg296"/>

                <note rend="inline" type="source">File No. 763.72112/599</note>
                <head>
                    <hi rendition="#italic">The Danish Minister</hi> (<hi rendition="#italic">Brun</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <p rendition="#center">
                    <hi rendition="#small-caps">Memorandum</hi>
                </p>
                <p>The Danish Government is desirous to learn whether the United States, if England
                    applies Article 2 of the order in council of October 29, 1914,<anchor n="1"
                        xml:id="d439-f1"/> to Denmark, would recognize the right of England to seize
                    American vessels carrying conditional contraband of war to ports of Denmark.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">C. Brun</hi>
                        
                    </signed>
                    <dateline rendition="#float-left">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>,<date calendar="gregorian" when="1914-12-28">
                            <hi rendition="#italic">December 28, 1914</hi>.</date>
                    </dateline>
                </closer>
            </div>
        </body>
    </text>
