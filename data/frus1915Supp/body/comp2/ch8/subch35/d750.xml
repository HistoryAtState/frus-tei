    <text>
        <body>
            <div xml:id="d750">

                <pb facs="0776" n="518" sameAs="frus:frus1915Supp/pg518"/>

                <note rend="inline" type="source">File No. 841.857/18</note>
                <head>
                    <hi rendition="#italic">The Consul General at London</hi> (<hi rendition="#italic"
                        >Skinner</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1915-08-23">
                            <hi rendition="#italic">August 23, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received 8.15 a. m.</hi>]</dateline>
                </opener>
                <p>American Consul, Bristol, reports British ship 
                        <hi rendition="#italic">Baron Erskine</hi>, Avonmouth to New
                    Orleans, destroyed submarine morning August 19. Seventy-seven returning American
                    muleteers on board all saved. Survivors in Bristol.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Skinner</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
