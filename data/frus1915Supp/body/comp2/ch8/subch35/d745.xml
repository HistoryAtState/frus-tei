            <div xml:id="d745">

                <pb facs="0774" n="516" sameAs="frus:frus1915Supp/pg516"/>

                <note rend="inline" type="source">File No. 841.857Ar1</note>
                <head>
                    <hi rendition="#italic">The Vice Consul at Cork</hi> (<hi rendition="#italic"
                        >Thompson</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Queenstown</hi></placeName>, <date
                            ana="#date_undated-inferred-from-document-content" calendar="gregorian"
                            notAfter="1915-08-19T15:00:00-05:00"
                            notBefore="1915-08-19T09:30:00-00:25" when="1915-08-19"><hi
                                rendition="#italic">undated</hi></date>.<lb/>[<hi
                            rendition="#italic">Received August 19, 1915, 3 p. m.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#italic">Arabic</hi> sunk at 9.30 to-day 60 miles from
                    Queenstown. Sunk in eleven minutes. Eleven boats of survivors being brought
                    here.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Thompson</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
