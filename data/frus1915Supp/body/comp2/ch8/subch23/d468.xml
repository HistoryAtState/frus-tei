    <text>
        <body>
            <div xml:id="d468">

                <pb facs="0576" n="318" sameAs="frus:frus1915Supp/pg318"/>

                <note rend="inline" type="source">File No. 763.72112/696</note>
                <head>
                    <hi rendition="#italic">The Assistant Secretary of the Treasury</hi> (<hi rendition="#italic"
                    >Peters</hi>) <hi rendition="#italic">to the Solicitor for the Department of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-02-01">
                            <hi rendition="#italic">February 1, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Johnson</hi>: I
                    enclose herewith a letter from Mr. George E. Warren, of the
                    Morrellville Coal Mining Company, 1 Broadway, New York, to me, which I beg to
                    refer to you for an answer to his inquiry.</p>
                <p>Yours sincerely,</p>
                <closer>
                    <signed>
                        A. J. Peters
                    </signed>
                    <lb/>
                    <hi rendition="#italic">Assistant Secretary</hi>
                </closer>


                <xi:include href="d468-a1.xml" xpointer="d468-a1"/>
            </div>
        </body>
    </text>
