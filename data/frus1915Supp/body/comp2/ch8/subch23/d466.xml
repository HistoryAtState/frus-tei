    <text>
        <body>
            <div xml:id="d466">

                <pb facs="0575" n="317" sameAs="frus:frus1915Supp/pg317"/>

                <note rend="inline" type="source">File No. 300.115/2236</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Page</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi><anchor n="1" xml:id="d466-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1915-01-27">
                            <hi rendition="#italic">January 27, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received 4.30 p. m.</hi>]</dateline>
                </opener>
                <p>1536. Your 1015, January 22.<anchor n="2" xml:id="d466-f2"/> Swiss Minister
                    informs me he has practically secured the result he wishes.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">American Ambassador</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
