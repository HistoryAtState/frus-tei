    <text>
        <body>
            <div xml:id="d898">

                <pb facs="0906" n="648" sameAs="frus:frus1915Supp/pg648"/>

                <note rend="inline" type="source">File No. 763.72/2324</note>
                <head>
                    <hi rendition="#italic">The German Embassy to the
                            Department of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">A 8351]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-12-21">
                            <hi rendition="#italic">December 21, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>The Imperial German Embassy presents its compliments to the United States
                    Department of State and has the honor to enclose here-with a wireless cipher
                    message to the Foreign Office in Berlin for kind transmission to the Tuckerton
                    radio station.</p>
                <p>Duplicate copies of the text of the message are likewise enclosed.</p>



                <xi:include href="d898-a1.xml" xpointer="d898-a1"/>
            </div>
