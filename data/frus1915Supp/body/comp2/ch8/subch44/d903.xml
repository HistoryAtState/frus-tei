    <text>
        <body>
            <div xml:id="d903">

                <pb facs="0908" n="650" sameAs="frus:frus1915Supp/pg650"/>

                <note rend="inline" type="source">File No. 811.0151/119</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Page</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 2675]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1915-12-11">
                            <hi rendition="#italic">December 11, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received December 29</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to the Department’s
                    instruction No. 1864 of November 9, 1915,<anchor n="1" xml:id="d903-f1"/>
                    respecting the reported improper use of the American flag by the British war
                    vessel <hi rendition="#italic">Baralong</hi>, I have the honor to enclose
                    herewith a copy of the note from the Foreign Office upon which my telegram No.
                    3384 of to-day<anchor n="1" xml:id="d903-f2"/> was based.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Walter Hines Page</hi>
                    </signed>
                </closer>


                <xi:include href="d903-a1.xml" xpointer="d903-a1"/>
            </div>
        </body>
    </text>
