    <text>
        <body>
            <div xml:id="d807">

                <pb facs="0810" n="552" sameAs="frus:frus1915Supp/pg552"/>

                <note rend="inline" type="source">File No. 763.72112/1574</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Consul General at London</hi> (<hi
                            rendition="#italic">Skinner</hi>)</head>
                <opener>
                    <seg rendition="#float-left">No. 420]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-09-22">
                            <hi rendition="#italic">September 22, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The Department has received your despatch
                    No. 664 of August 17, 1915,<anchor n="1" xml:id="d807-f1"/> together with its
                    enclosure, relative to the demand upon claimants to refrain from asking for
                    compensation, and approves of the tenor of the communication addressed by you to
                    the procurator general.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        
                            <hi rendition="#small-caps">Wilbur J. Carr</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
