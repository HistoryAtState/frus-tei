        <body>
            <div xml:id="d798">

                <pb facs="0804" n="546" sameAs="frus:frus1915Supp/pg546"/>

                <note rend="inline" type="source">File No. 763.72112/1574</note>
                <head>
                    <hi rendition="#italic">The Consul General at London</hi> (<hi
                        rendition="#italic">Skinner</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 664]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1915-08-17">
                            <hi rendition="#italic">August 17, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received September 14</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith a
                    copy of a letter on the subject—demand upon claimants to refrain from asking for
                    compensation—which I am to-day addressing to the procurator general.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert P. Skinner</hi>
                    </signed>
                </closer>


                <xi:include href="d798-a1.xml" xpointer="d798-a1"/>
            </div>
