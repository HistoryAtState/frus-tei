    <text>
        <body>
            <div xml:id="d499">

                <pb facs="0608" n="350" sameAs="frus:frus1915Supp/pg350"/>

                <note rend="inline" type="source">File No. 300.115/2635</note>
                <head>
                    <hi rendition="#italic">The Consul General at Hamburg</hi> (<hi
                        rendition="#italic">Morgan</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 209]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Hamburg</hi></placeName>, <date
                            calendar="gregorian" when="1915-02-18">
                            <hi rendition="#italic">February 18, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received March 18.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir:</hi> Referring to my despatch No. 204, February
                    17, 1915, I now have the honor to transmit herewith enclosed a copy and
                    translation of the decision of the prize court in Hamburg in the <hi
                        rendition="#italic">Glitra</hi> case together with a copy of a letter from
                    Dres. Schroeder, Stammann and Nolte, commenting upon the decision, which
                    accompanied it.<anchor n="1" xml:id="d499-f1"/>
                </p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Henry H. Morgan</hi>
                    </signed>
                </closer>


                <xi:include href="d499-a1.xml" xpointer="d499-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d499-f1" n="1" xml:id="d499-f1-content">
                <p>Not printed. This decision involved no American interests, but is important as
                    setting a precedent which was followed in the case of the <hi
                        rendition="#italic">Indian Prince</hi>, carrying American-owned cargo; <hi
                        rendition="#italic">post</hi>, <ref target="#pg520">p. 520</ref>. The
                    affirming decision of the supreme prize court is printed <hi rendition="#italic"
                        >post</hi>, <ref target="#pg571">p. 571</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
