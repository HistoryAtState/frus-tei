    <text>
        <body>
            <div xml:id="d530">

                <pb facs="0627" n="369" xml:id="pg369"/>

                <note rend="inline" type="source">File No. 300.115/2902</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Page</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1915-04-13">
                            <hi rendition="#italic">April 13, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received 9 p. m.</hi>]</dateline>
                </opener>
                <p>1920. Foreign Office informs me that American steamship <hi rendition="#italic"
                        >Ogeechee</hi> has arrived at Stornoway with cargo loaded entirely at Bremen
                    which port she left April 3, and that under terms of order in council of March
                    11, vessel has been ordered to proceed to Sharpness to discharge cargo, after
                    which she will be permitted to proceed to her destination.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">American Ambassador</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
