    <text>
        <body>
            <div xml:id="d524">

                <pb facs="0623" n="365" sameAs="frus:frus1915Supp/pg365"/>

                <note rend="inline" type="source">File No. 341.115G82/37</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Great Britain</hi> (<hi
                            rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-04-12">
                            <hi rendition="#italic">April 12, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>1407. Your 1903, 8th. Attorneys for 
                        <hi rendition="#italic">Wilhelmina</hi>
                     inform Department that April 10 they cabled their representative,
                    London, authorizing acceptance in substance British proposal, leaving details to
                    him. They request proceedings be expedited. You are authorized render all
                    possible assistance.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Bryan</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
