    <text>
        <body>
            <div xml:id="d527">

                <pb facs="0624" n="366" sameAs="frus:frus1915Supp/pg366"/>

                <note rend="inline" type="source">File No. 763.72112/999</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Page</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1136]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1915-03-30">
                            <hi rendition="#italic">March 30, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received April 13</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Pursuant to the instructions of the
                    Department relative to the transmission of all published official documents
                    respecting the present state of hostilities, I have the honor to enclose
                    herewith seven copies each of the following:</p>
                <p>...</p>
                <p>Order in Council (prize court rules) of March 23, 1915.</p>
                <p>...</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Walter Hines Page</hi>
                    </signed>
                </closer>


                <xi:include href="d527-a1.xml" xpointer="d527-a1"/>
            </div>
