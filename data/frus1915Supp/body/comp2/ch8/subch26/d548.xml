            <div xml:id="d548">

                <pb facs="0636" n="378" sameAs="frus:frus1915Supp/pg378"/>

                <note rend="inline" type="source">File No. 300.115G95</note>
                <head>
                    <hi rendition="#italic">The Consul at Plymouth</hi> (<hi
                            rendition="#italic">Stephens</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Plymouth</hi></placeName>, <date
                            ana="#date_undated-inferred-from-outside-research" calendar="gregorian"
                            notAfter="1915-05-03T12:55:00-05:00"
                            notBefore="1915-05-02T10:00:00+00:00"><hi rendition="#italic"
                                >undated</hi></date>.<lb/>[<hi rendition="#italic">Received May 3,
                            1915, 12.55 p. m.</hi>]</dateline>
                </opener>
                <p>American tank steamer <hi rendition="#italic">Gulflight</hi> torpedoed of Scilly
                    1st instant. Captain died heart failure, body landed. Two of crew drowned,
                    thirty-four saved. Vessel afloat, patrol boats attempting tow her into
                    Scilly.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Stephens</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
