                <pb facs="0636" n="378" sameAs="frus:frus1915Supp/pg378"/>

                <note rend="inline" type="source">File No. 362.115St21</note>
                <head>
                    <hi rendition="#italic">The Minister in the Netherlands</hi> (<hi rendition="#italic">Van
                        Dyke</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">The Hague</hi></placeName>, <date
                            calendar="gregorian" when="1915-04-30">
                            <hi rendition="#italic">April 30, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received 9.08 p. m.</hi>]</dateline>
                </opener>
                <p>255. American Consul, Rotterdam, reports American steamship <hi
                        rendition="#italic">Cushing</hi>, Captain Herland, with
                    petroleum from New York to Rotterdam, flying American flag, was attacked by
                    German aeroplane near North Hinder Lightship, afternoon April 29. Three bombs
                    dropped, one struck ship causing damage but no life lost.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Van Dyke</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
