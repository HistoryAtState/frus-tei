    <text>
        <body>
            <div xml:id="d549">

                <pb facs="0636" n="378" sameAs="frus:frus1915Supp/pg378"/>

                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Great Britain</hi> (<hi
                            rendition="#italic">Page</hi>)<anchor n="1" xml:id="d549-f1"
                    />
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-05-03">
                            <hi rendition="#italic">May 3, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>1500. Reported American tank steamer <hi rendition="#italic">Gulflight</hi>
                    torpedoed off Scilly May 1. Please obtain detailed report and forward Department
                    immediately. Cabling American Consul Plymouth to-day for detailed report.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Bryan</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d549-f1" n="1" type="source" xml:id="d549-f1-content">
                <p>The same to the Ambassador in Germany, No. 1612, May 3.</p>
            </note>
        </listAnnotation>
    </standOff>
