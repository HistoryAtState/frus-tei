    <text>
        <body>
            <div xml:id="d538">

                <pb facs="0630" n="372" sameAs="frus:frus1915Supp/pg372"/>

                <note rend="inline" type="source">File No. 341.115P51/39</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Page</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1915-04-19">
                            <hi rendition="#italic">April 19, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received 5.55 p. m.</hi>]</dateline>
                </opener>
                <p>1955. Your 1421, 14th. Foreign Office informs me British Government have decided
                    to discharge the cargo on <hi rendition="#italic">Joseph W. Fordney</hi> on
                    ground that it is believed to be intended for Germany.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">American Ambassador</hi>
                    </signed>
                </closer>
            </div>
        </body>
