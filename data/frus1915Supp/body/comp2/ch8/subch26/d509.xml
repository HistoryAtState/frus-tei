    <text>
        <body>
            <div xml:id="d509">

                <pb facs="0616" n="358" sameAs="frus:frus1915Supp/pg358"/>

                <note rend="inline" type="source">File No. 362.112T41/2</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Page</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1915-03-31">
                            <hi rendition="#italic">March 31, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received April 1, 9.30 a. m.</hi>]</dateline>
                </opener>
                <p>1864. For your information. Leon Chester Thrasher, engineer, stated to be
                    American citizen but unknown to Embassy, is reported missing, presumably drowned
                    from British ship <hi rendition="#italic">Falaba</hi> sunk March 28 in Irish Sea
                    by German submarine.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">American Ambassador</hi>
                    </signed>
                </closer>
            </div>
        </body>
