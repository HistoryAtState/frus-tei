    <text>
        <body>
            <div xml:id="d911">

                <pb facs="0916" n="658" sameAs="frus:frus1915Supp/pg658"/>

                <note rend="inline" type="source">File No. 763.72112/2074</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Germany</hi> (<hi rendition="#italic"
                    >Gerard</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 2084]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berlin</hi></placeName>, <date
                            calendar="gregorian" when="1915-12-21">
                            <hi rendition="#italic">December 21, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received January 3, 1916</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to the Department’s cipher
                    telegram No. 2083 of August 17, 1915, 4 p. m.,<anchor n="1" xml:id="d911-f1"/> I
                    have the honor to transmit to the Department herewith the translation of a note
                    received from the Imperial Foreign Office, dated December 18, 1915, explaining
                    the conditions under which American vessels are brought to German ports for
                    examination.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">James W. Gerard</hi>
                        
                    </signed>
                </closer>


                <xi:include href="d911-a1.xml" xpointer="d911-a1"/>
            </div>
        </body>
    </text>
