        <body>
            <div xml:id="d930">

                <pb facs="0929" n="671" sameAs="frus:frus1915Supp/pg671"/>

                <note rend="inline" type="source">File No. 841.801/45</note>
                <head>
                    <hi rendition="#italic">The Consul General at London</hi> (<hi rendition="#italic"
                        >Skinner</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1915-05-19">
                            <hi rendition="#italic">May 19, 1915</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received June 4</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to my telegram of May 17,<anchor
                        n="1" xml:id="d930-f1"/> setting forth briefly the terms of a notice on
                    navigation in the North Sea and English Channel received from the trade division
                    of the Admiralty on that date, I have the honor to enclose herewith, in
                    duplicate, a full copy of the circular, together with the <hi
                        rendition="#italic">Admiralty Notices to Mariners</hi><anchor n="1"
                        xml:id="d930-f2"/> referred to in said circular.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Robert P. Skinner</hi>
                        
                    </signed>
                </closer>


                <xi:include href="d930-a1.xml" xpointer="d930-a1"/>
            </div>
        </body>
    </text>
