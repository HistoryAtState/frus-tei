    <text>
        <body>
            <div xml:id="d1-a1">

                <pb facs="0016" n="6" sameAs="frus:frus1919Parisv07/pg6"/>

                <head>Appendix A to IC–200 [FM–28]</head>
                <opener><seg rendition="#center">[Translation<anchor n="4" xml:id="d1-f1"
                    />]</seg></opener>
                <opener><dateline rendition="#float-right"><hi rendition="#small-caps">German Peace
                            Delegation</hi>,<lb/><placeName><hi rendition="#small-caps"
                                >Versailles</hi></placeName>, <date calendar="gregorian"
                            when="1919-06-30">June 30, 1919</date>.</dateline></opener>
                <p rendition="#center">[<hi rendition="#italic">The Head of the German
                        Delegation</hi> (<hi rendition="#italic">Von Lersner</hi>) <hi
                        rendition="#italic">to the President of the Peace Conference</hi> (<hi
                        rendition="#italic">Clemenceau</hi>)]</p>
                <p><hi rendition="#small-caps">Mr. President</hi>: By order of the German
                    Government, I have the honor to inquire of Your Excellency when and where the
                    discussions relating to the occupied regions will begin.</p>
                <p>Accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Baron von Lersner</hi></signed></closer>
            </div>
        </body>
    </text>
