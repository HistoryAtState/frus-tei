    <text>
        <body>
            <div xml:id="d11-a2">

                <pb facs="0134" n="124" xml:id="pg124"/>

                <opener>
                    <seg rendition="#float-left">No. 385</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1919-06-23">23 June, 1919.</date><lb/>4, rue Boccador.</dateline>
                </opener>
                <p rendition="#flush">From: General Pechitch, Chief of the Serbian, Croatian, and
                    Slovene Military Mission.</p>
                <p rendition="#flush">To: General Alby, Chief of the General Staff, Paris.</p>
                <p>I have the honour to transmit to you a copy of the document referred to in my
                    letter of the 18th June (No. 373).</p>
                <closer><signed><hi rendition="#small-caps">Pechitch</hi></signed><lb/><hi
                        rendition="#italic">Commander-in-chief of the Mission</hi></closer>
            </div>
        </body>
    </text>
