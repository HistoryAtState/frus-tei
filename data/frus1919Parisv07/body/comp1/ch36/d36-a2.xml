    <text>
        <body>
            <div xml:id="d36-a2">

                <pb facs="0698" n="688" sameAs="frus:frus1919Parisv07/pg688"/>

                <head>Appendix B to HD–31</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1919-08-14">August 14, 1919</date>.</dateline></opener>
                <p><hi rendition="#small-caps">rumanian delegation<lb/>to the peace
                    conference</hi></p>
                <p rendition="#flush">Translation</p>
                <p>The Rumanian Delegation has the honour to submit herewith the reply of the
                    Rumanian Government to the communications of the <pb facs="0699" n="689"
                        xml:id="pg689"/> Peace Conference, presented at Bucarest on August 9,
                        1919,<anchor n="5" xml:id="d36-f1"/> concerning the situation in
                    Hungary.</p>
                <p>To His Excellency the President<lb/>of the Peace Conference.</p>
            </div>
        </body>
    </text>
