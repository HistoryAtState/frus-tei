                <pb facs="0286" n="274" sameAs="frus:frus1943v02/pg274"/>

                <note rend="inline" type="source">851D.20/46: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Consul at Cayenne</hi>
                        (<hi rendition="#italic">LaMont</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-04-06T22:00:00-04:00">April 6, 1943—10
                            p.m.</date>
                    </dateline>
                </opener>
                <p>23. Your 42, April 1. Please assure Governor Rapenne that we will be guided by
                    his wishes in the matter.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
