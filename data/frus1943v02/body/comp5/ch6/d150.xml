    <text>
        <body>
            <div xml:id="d150">

                <pb facs="0194" n="182" sameAs="frus:frus1943v02/pg182"/>

                <head>
                    <hi rendition="#italic">President Roosevelt to
                        the British Prime Minister</hi> (<hi rendition="#italic"
                            >Churchill</hi>)<anchor n="10" xml:id="d150-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1943-08-03">August 3, 1943</date>.</dateline>
                </opener>
                <p>343. Referring to your numbers 399<anchor n="11" xml:id="d150-f2"/> and
                        400,<anchor n="12" xml:id="d150-f3"/> I earnestly hope that nothing will be
                    done in the matter of recognition of the Committee of National Liberation until
                    we have an opportunity to talk it over together.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Roosevelt</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d150-f1" n="10" type="source" xml:id="d150-f1-content">
