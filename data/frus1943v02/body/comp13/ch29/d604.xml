                <pb facs="0687" n="675" sameAs="frus:frus1943v02/pg675"/>

                <note rend="inline" type="source">852.6363/775: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Spain</hi> (<hi rendition="#italic"
                            >Hayes</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-04-17T11:00:00-04:00">April 17, 1943—11
                            a.m.</date>
                    </dateline>
                </opener>
                <p>882. Your 897, April 13, midnight. As this matter is still being discussed here
                    the Department feels it would be premature to make any communication to the
                    Spanish Government at present.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
