    <text>
        <body>
            <div xml:id="d334">

                <pb facs="0383" n="371" sameAs="frus:frus1943v02/pg371"/>

                <note rend="inline" type="source">740.00119 European War 1939/9–2143</note>
                <head>
                    <hi rendition="#italic">The British Minister</hi> (<hi
                            rendition="#italic">Campbell</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-09-21">September 21,
                        1943</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Secretary</hi>: I send you herewith copies
                    of two messages which the Prime Minister sent to the President about the
                    Badoglio Government.</p>
                <p>Believe me [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">R. I. Campbell</hi>
                    </signed>
                </closer>



                <xi:include href="d334-a1.xml" xpointer="d334-a1"/>
