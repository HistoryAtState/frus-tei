            <div xml:id="d359">

                <pb facs="0401" n="389" sameAs="frus:frus1943v02/pg389"/>

                <note rend="inline" type="source">740.00119 European War 1939/1906: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in the Soviet Union</hi> (<hi rendition="#italic">Hamilton</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Moscow</hi></placeName>, <date
                            calendar="gregorian" when="1943-10-19T18:00:00+03:00">October 19, 1943—6
                            p.m.</date>
                        <lb/> [Received October 19—10:50 a.m.]</dateline>
                </opener>
                <p>1637. Your 1002, October 16, 8 p.m. The British Ambassador has received similar
                    instructions and each of us is addressing a communication to Molotov in
                    accordance with instructions.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hamilton</hi>
                    </signed>
                </closer>
            </div>
