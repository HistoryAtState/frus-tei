    <text>
        <body>
            <div xml:id="toc">

                <pb facs="0009" n="V" xml:id="pgV"/>

                <head>Contents</head>
                <list type="toc">
                    <item>
                        <ref target="#pgIII">
                            <hi rendition="#small-caps">Preface</hi>
                        </ref>
                    </item>
                    <item>
                        <hi rendition="#small-caps">Albania</hi>: <list>
                            <item>
                                <ref target="#pg1">Question of recognition of an Albanian government
                                    in exile</ref>
                            </item>
                        </list>
                    </item>
                    <item>
                        <hi rendition="#small-caps">Belgium</hi>: <list>
                            <item>
                                <ref target="#pg2">Representation by Belgium regarding bombing in
                                    Belgium by American Air Forces which resulted in heavy
                                    casualties among Belgian population</ref>
                            </item>
                            <item>
                                <ref target="#pg4">Supplementary agreement between the United States
                                    and Belgium regarding principles applying to the provision of
                                    aid to the Armed Forces of the United States</ref>
                            </item>
                            <item>
                                <ref target="#pg5">Agreement between the United States and Belgium
                                    regarding jurisdiction over criminal offenses committed by the
                                    Armed Forces of the United States in the Belgian Congo</ref>
                            </item>
                        </list>
                    </item>
                    <item>
                        <hi rendition="#small-caps">Denmark</hi>: <list>
                            <item>
                                <ref target="#pg6">Continued recognition by the United States of the
                                    Danish Minister as representative of Denmark while that country
                                    was under German occupation</ref>
                            </item>
                        </list>
                    </item>
                    <item>
                        <ref target="#pg22">
                            <hi rendition="#small-caps">Finland</hi>
                        </ref>
                    </item>
                    <item>
                        <hi rendition="#small-caps">France</hi>: <list>
                            <item>
                                <ref target="#pg23">Concern of the United States over the disunity
                                    between Generals Giraud and de Gaulle in French North and West
                                    Africa; recognition of administrative authority of the French
                                    Committee of National Liberation</ref>
                            </item>
                            <item>
                                <ref target="#pg202">Concern of the United States over methods used
                                    by the Free French in recruiting French sailors in American
                                    ports</ref>
                            </item>
                            <item>
                                <ref target="#pg219">Aid of the United States in securing transfer
                                    of control of the French West Indies to Representative of the
                                    French Committee of National Liberation</ref>
                            </item>
                            <item>
                                <ref target="#pg249">Interest of the United States in the adhesion
                                    of French Guiana to the United Nations cause</ref>
                            </item>
                            <item>
                                <ref target="#pg280">Negotiation by the United States with French
                                    authorities to relieve Jewish community in Tunisia of Nazi fines
                                    and levies resulting in forced property transfers</ref>
                            </item>
                            <item>
                                <ref target="#pg301">Agreement between the United States and the
                                    French Committee of National Liberation regarding reciprocal aid
                                    in French North and West Africa</ref>
                            </item>
                        </list>
                    </item>
                    <pb facs="0010" n="VI" xml:id="pgVI"/>
                    <item>
                        <ref target="#pg302">
                            <hi rendition="#small-caps">Greece</hi>
                        </ref>
                    </item>
                    <item>
                        <hi rendition="#small-caps">Iceland</hi>: <list>
                            <item>
                                <ref target="#pg303">Reduction in prices charged by the United
                                    States Navy in Iceland for petroleum products in response to
                                    representations by the Icelandic Government</ref>
                            </item>
                            <item>
                                <ref target="#pg307">Request by Iceland for assurances regarding the
                                    withdrawal of British troops from the Island</ref>
                            </item>
                            <item>
                                <ref target="#pg313">Reciprocal trade agreement between the United
                                    States and Iceland, signed at Reykjavik August 27, 1943</ref>
                            </item>
                        </list>
                    </item>
                    <item>
                        <hi rendition="#small-caps">Italy</hi>: <list>
                            <item>
                                <ref target="#pg314">Overthrow of Fascist regime in Italy; Italian
                                    surrender and recognition as co-belligerent</ref>
                            </item>
                            <item>
                                <ref target="#pg402">Concern of the United States regarding the
                                    maintenance of responsible government in Italy following the
                                    fall of Mussolini</ref>
                            </item>
                        </list>
                    </item>
                    <item>
                        <hi rendition="#small-caps">Netherlands</hi>: <list>
                            <item>
                                <ref target="#pg446">Discussions between the United States and the
                                    Netherlands regarding the financial needs of the Netherlands
                                    Government</ref>
                            </item>
                            <item>
                                <ref target="#pg470">Representations by the Netherlands Government
                                    with respect to the requisition by the United States of the S.S.
                                        <hi rendition="#italic">Wilhelmina</hi>
                                </ref>
                            </item>
                            <item>
                                <ref target="#pg480">Supplementary agreement between the United
                                    States and the Netherlands regarding principles applying to the
                                    provision of aid to the Armed Forces of the United States</ref>
                            </item>
                        </list>
                    </item>
                    <item>
                        <hi rendition="#small-caps">Norway</hi>: <list>
                            <item>
                                <ref target="#pg481">Discussions regarding replacement by the United
                                    States of ships lost by Norway in the United Nations war
                                    efforts</ref>
                            </item>
                            <item>
                                <ref target="#pg489">Representations by the Norwegian Government for
                                    obtaining materials to restore Norsk Hydro chemical plant in
                                    Norway bombed by United States Air Force</ref>
                            </item>
                        </list>
                    </item>
                    <item>
                        <ref target="#pg496">
                            <hi rendition="#small-caps">Poland</hi>
                        </ref>
                    </item>
                    <item>
                        <hi rendition="#small-caps">Portugal</hi>: <list>
                            <item>
                                <ref target="#pg497">Difficulties with Portugal over price raising
                                    on materials bought from and sold to Portugal; renewal of
                                    wolfram agreement of August 24, 1942</ref>
                            </item>
                            <item>
                                <ref target="#pg525">Position of the United States Government that
                                    it would not be advisable to encourage the Portuguese Government
                                    to enter the war against Japan</ref>
                            </item>
                            <item>
                                <ref target="#pg527">Interest of the United States in obtaining
                                    water-port and airport facilities in the Azores</ref>
                            </item>
                            <item>
                                <ref target="#pg581">Portuguese policy regarding American planes
                                    interned in Portugal</ref>
                            </item>
                            <item>
                                <ref target="#pg585">Efforts of the United States to enforce
                                    restrictions on sale of petroleum products to Germans and
                                    Italians in Angola</ref>
                            </item>
                        </list>
                    </item>
                    <item>
                        <hi rendition="#small-caps">Spain</hi>: <list>
                            <item>
                                <ref target="#pg595">Concern of the United States over the
                                    maintenance of neutrality by Spain</ref>
                            </item>
                            <item>
                                <ref target="#pg632">Efforts made toward getting Spain to impose an
                                    embargo on export of wolfram to Germany</ref>
                            </item>
                            <pb facs="0011" n="VII" xml:id="pgVII"/>
                            <item>
                                <ref target="#pg668">Control of imports of petroleum products to
                                    Spain; obtainment of landing rights for American commercial
                                    airplanes in Spain</ref>
                            </item>
                            <item>
                                <ref target="#pg711">Representations against Spanish internment of
                                    Italian warships and merchant vessels</ref>
                            </item>
                            <item>
                                <ref target="#pg722">Concern of the United States over
                                    congratulatory telegram sent by the Spanish Government to José
                                    P. Laurel, head of the Japanese-controlled Philippine
                                    government</ref>
                            </item>
                        </list>
                    </item>
                    <item>
                        <hi rendition="#small-caps">Sweden</hi>: <list>
                            <item>
                                <ref target="#pg739">War trade agreement between the United States,
                                    the United Kingdom, and Sweden</ref>
                            </item>
                            <item>
                                <ref target="#pg815">Efforts of the United States and the United
                                    Kingdom to obtain reduction by Sweden of iron ore exports to
                                    Germany</ref>
                            </item>
                        </list>
                    </item>
                    <item>
                        <hi rendition="#small-caps">Switzerland</hi>: <list>
                            <item>
                                <ref target="#pg824">War trade agreement between the United States,
                                    the United Kingdom, and Switzerland</ref>
                            </item>
                            <item>
                                <ref target="#pg892">Negotiations between the United States and
                                    Switzerland concerning supplying Swiss need for army supplies in
                                    addition to those provided by compensation agreement</ref>
                            </item>
                        </list>
                    </item>
                    <item>
                        <ref target="#pg909">
                            <hi rendition="#small-caps">Union of Soviet Socialist Republics</hi>
                        </ref>
                    </item>
                    <item>
                        <hi rendition="#small-caps">Vatican</hi>: <list>
                            <item>
                                <ref target="#pg910">Appeals of the Vatican to the American and
                                    British Governments that they refrain from bombing Rome</ref>
                            </item>
                            <item>
                                <ref target="#pg953">Extension to North Africa of the Vatican
                                    information service regarding prisoners of war</ref>
                            </item>
                        </list>
                    </item>
                    <item>
                        <hi rendition="#small-caps">Yugoslavia</hi>: <list>
                            <item>
                                <ref target="#pg962">Concern of the United States regarding disunity
                                    among Yugoslav resistance forces</ref>
                            </item>
                            <item>
                                <ref target="#pg1041">Arrangement for service of a group of Yugoslav
                                    aviators as a unit with the United States Army Air Force</ref>
                            </item>
                        </list>
                    </item>
                    <item>
                        <ref target="#pg1051">
                            <hi rendition="#small-caps">Index</hi>
                        </ref>
                    </item>
                </list>
            </div>
        </body>
    </text>
</TEI>
