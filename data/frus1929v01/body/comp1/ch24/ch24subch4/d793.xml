    <text>
        <body>
            <div xml:id="d793">

                <pb facs="1086" n="950" sameAs="frus:frus1929v01/pg950"/>

                <note rend="inline" type="source">714.1515/909</note>
                <head><hi rendition="#italic">The Assistant Secretary of State</hi> (<hi rendition="#italic">White</hi>) <hi
                        rendition="#italic">to the Minister in Honduras</hi> (<hi rendition="#italic">Summerlin</hi>), <hi
                        rendition="#italic">Temporarily in New York</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1929-07-18">July 18, 1929</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Summie</hi>: Here is the statement that the
                    Secretary told you yesterday he would like to have prepared for you to deliver
                    verbally <pb facs="1087" n="951" xml:id="pg951"/> to the Minister for Foreign
                    Affairs. It has been approved by the Secretary.</p>
                <p>With best wishes for a <hi rendition="#italic">bon voyage</hi> and hoping that
                    all will go well,</p>
                <p>Yours very sincerely,</p>
                <closer><signed><hi rendition="#small-caps">Francis White</hi></signed></closer>


                <xi:include href="d793-a1.xml" xpointer="d793-a1"/>
            </div>
        </body>
    </text>
