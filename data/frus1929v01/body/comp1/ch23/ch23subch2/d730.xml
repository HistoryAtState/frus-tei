    <text>
        <body>
            <div xml:id="d730">

                <pb facs="1008" n="872" sameAs="frus:frus1929v01/pg872"/>

                <note rend="inline" type="source">724.3415/667b: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Chargé in
                        Bolivia</hi> (<hi rendition="#italic">Hibbard</hi>)<anchor n="46"
                        xml:id="d730-f1"/></head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1929-08-24T13:00:00-04:00">August 24, 1929—1
                        p.m.</date></dateline></opener>
                <p>44. American Embassy in Brazil reports that the Government of Brazil will be
                    disposed to cooperate in counseling moderation at Asunción and La Paz in the
                    circumstances set forth in the Department’s telegram 43, August 24, 11 a.m.</p>
                <closer><signed><hi rendition="#small-caps">Carr</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d730-f1" n="46" type="source" xml:id="d730-f1-content">
                <p>The same on the same date to the Minister in Paraguay as telegram No. 32,
                    mentioning Department’s telegram No. 31. August 24, 11 a.m.</p>
            </note>
        </listAnnotation>
    </standOff>
