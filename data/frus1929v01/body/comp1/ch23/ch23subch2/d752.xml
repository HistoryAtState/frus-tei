    <text>
        <body>
            <div xml:id="d752">

                <pb facs="1041" n="905" sameAs="frus:frus1929v01/pg905"/>

                <note rend="inline" type="source">724.3415/739f: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Chargé in Bolivia</hi> (<hi rendition="#italic"
                            >Hibbard</hi>)<anchor n="72" xml:id="d752-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1929-09-30T10:00:00-05:00">September 30, 1929—10
                        a.m.</date></dateline></opener>
                <p>57. Department’s circular September 23, 6 p.m. Please transmit communication
                    quoted therein to Bolivian Government on Tuesday morning, October first.</p>
                <closer><signed><hi rendition="#small-caps">Stimson</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d752-f1" n="72" type="source" xml:id="d752-f1-content">
                <p>The same, <hi rendition="#italic">mutatis mutandis</hi>, on the same date to the
                    Minister in Paraguay as telegram No. 51.</p>
            </note>
        </listAnnotation>
    </standOff>
