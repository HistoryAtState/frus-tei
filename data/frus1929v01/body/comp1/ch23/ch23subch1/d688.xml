                <pb facs="0969" n="833" sameAs="frus:frus1929v01/pg833"/>

                <note rend="inline" type="source">724.3415/338: Telegram</note>
                <head><hi rendition="#italic">The Minister in Colombia</hi> (<hi rendition="#italic"
                        >Caffery</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Bogotá</hi></placeName>, <date calendar="gregorian"
                            when="1929-01-04T16:00:00-05:00">January 4, 1929—4
                        p.m.</date><lb/>[Received 5:55 p.m.]</dateline></opener>
                <p>2. My telegram number 1, January 4, noon.<anchor n="15" xml:id="d688-f1"/>
                    Minister for Foreign Affairs telephones me Colombian Government accepts the
                    invitation.</p>
                <closer><signed><hi rendition="#small-caps">Caffery</hi></signed></closer>
            </div>
        </body>
    </text>
