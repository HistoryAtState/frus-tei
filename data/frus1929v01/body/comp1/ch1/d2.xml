    <text>
        <body>
            <div xml:id="d2">

                <pb facs="0139" n="3" sameAs="frus:frus1929v01/pg3"/>

                <note rend="inline" type="source">500.C114/445bbb</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Minister in Switzerland</hi> (<hi
                            rendition="#italic">Wilson</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1929-02-19">February 19, 1929</date>.</dateline>
                    <seg rendition="#float-left">No. 404</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I am enclosing, for transmission in the
                    usual informal manner, a note to the Secretary-General of the League of
                        Nations,<anchor n="9" xml:id="d2-f1"/> setting <pb facs="0140" n="4"
                        xml:id="pg4"/> forth the text of a communication which I have addressed to
                    each of the signatories to the Protocol of Signature of the Statute of the
                    Permanent Court of International Justice.</p>
                <p>I am [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Frank B. Kellogg</hi></signed></closer>
            </div>
        </body>
    </text>
