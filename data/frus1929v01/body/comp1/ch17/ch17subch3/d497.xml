    <text>
        <body>
            <div xml:id="d497">

                <pb facs="0772" n="636" sameAs="frus:frus1929v01/pg636"/>

                <note rend="inline" type="source">814.796 Latin American Airways/2: Telegram</note>
                <head><hi rendition="#italic">The Minister in Guatemala</hi> (<hi rendition="#italic">Geissler</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Guatemala</hi></placeName>, <date calendar="gregorian"
                            when="1929-05-02T16:00:00-06:00">May 2, 1929—4 p.m.</date><lb/>[Received
                        11:20 p.m.]</dateline></opener>
                <p>54. Despatch 2371, April 24.<anchor n="90" xml:id="d497-f1"/> A note has been
                    received from the Foreign Office requesting information regarding the financial
                    backing and capacities of the Latin American Air Transport Company <pb
                        facs="0773" n="637" xml:id="pg637"/> represented by Lee Balch and “all such
                    other data regarding the matter as may be deemed of interest to the Government
                    of Guatemala.” Please answer by telegraph.</p>
                <closer><signed><hi rendition="#small-caps">Geissler</hi></signed></closer>
            </div>
        </body>
    </text>
