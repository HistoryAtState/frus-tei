    <text>
        <body>
            <div xml:id="d327">

                <pb facs="0683" n="547" sameAs="frus:frus1929v01/pg547"/>

                <note rend="inline" type="source">810.79611 Pan American Airways, Inc./227:
                    Telegram</note>
                <head><hi rendition="#italic">The Minister in Costa Rica</hi> (<hi
                        rendition="#italic">Davis</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >San José</hi></placeName>, <date calendar="gregorian"
                            when="1929-01-24T12:00:00-06:00">January 24,
                        1929—noon</date>.<lb/>[Received 1:20 p.m.]</dateline></opener>
                <p>7. The President this morning signed contract with Pan American Airways,
                        Incorporated.<anchor n="5" xml:id="d327-f1"/> This contract will be
                    submitted to Congress when it reconvenes.</p>
                <closer><signed><hi rendition="#small-caps">Davis</hi></signed></closer>
            </div>
        </body>
    </text>
