    <text>
        <body>
            <div xml:id="d406">

                <pb facs="0716" n="580" sameAs="frus:frus1929v01/pg580"/>

                <note rend="inline" type="source">810.79611 Pan American Airways, Inc./654</note>
                <head><hi rendition="#italic">The Vice Consul at Georgetown</hi> (<hi
                        rendition="#italic">Brown</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Georgetown</hi></placeName>, <date calendar="gregorian"
                            when="1929-08-28">August 28, 1929</date>.<lb/>[Received September
                        17.]</dateline>
                    <seg rendition="#float-left">No. 212</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to refer to despatch No.
                    178 of May 27, 1929, file No. 879.6,<anchor n="32" xml:id="d406-f1"/> regarding
                    the prohibition of flights over French Guiana and to enclose herewith a copy of
                    a letter from His Excellency the Governor of French Guiana dated July 30, 1929,
                    and received at this office on August 26, 1929.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Harold R. Brown</hi></signed></closer>



                <xi:include href="d406-a1.xml" xpointer="d406-a1"/>
            </div>
        </body>
    </text>
