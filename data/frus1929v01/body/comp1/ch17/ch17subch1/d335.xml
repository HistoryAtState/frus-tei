    <text>
        <body>
            <div xml:id="d335">

                <pb facs="0685" n="549" sameAs="frus:frus1929v01/pg549"/>

                <note rend="inline" type="source">810.79611 Pan American Airways, Inc./249:
                    Telegram</note>
                <head><hi rendition="#italic">The Minister in Colombia</hi> (<hi rendition="#italic">Caffery</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Bogotá</hi></placeName>, <date calendar="gregorian"
                            when="1929-02-09T19:00:00-05:00">February 9, 1929—7
                        p.m.</date><lb/>[Received 10:15 p.m.]</dateline></opener>
                <p>22. My 21 February 8, 9 p.m.<anchor n="7" xml:id="d335-f1"/> Colombian Government
                    today granted request of Pan American, as set forth in the Department’s 5,
                    January 18, 12 noon, under the following conditions: <list>
                        <label>1.</label>
                        <item>Notification day and approximate hour arrival Colombian
                            territory.</item>
                        <label>2.</label>
                        <item>Type of plane and power of motor.</item>
                        <pb facs="0686" n="550" xml:id="pg550"/>
                        <label>3.</label>
                        <item>Not to be considered inauguration commercial service between United
                            States and Colombia pending termination negotiations between the two
                                countries.<anchor n="8" xml:id="d335-f2"/></item>
                    </list>
                </p>
                <p>Repeated to Panama.</p>
                <closer><signed><hi rendition="#small-caps">Caffery</hi></signed></closer>
            </div>
        </body>
    </text>
