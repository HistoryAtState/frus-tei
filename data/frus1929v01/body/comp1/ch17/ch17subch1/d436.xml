                <pb facs="0738" n="602" xml:id="pg602"/>

                <note rend="inline" type="source">810.79611 Pan American Airways, Inc./690:
                    Telegram</note>
                <head><hi rendition="#italic">The Minister in El Salvador</hi> (<hi rendition="#italic">Robbins</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >San Salvador</hi></placeName>, <date calendar="gregorian"
                            when="1929-10-22T11:00:00-06:00">October 22, 1929—11
                        a.m.</date><lb/>[Received 1:47 p.m.]</dateline></opener>
                <p>74. My telegram 73, October 19, 11 a.m. Provisional operating permit on basis of
                    contract granted yesterday by Minister of War and Aviation.</p>
                <closer><signed><hi rendition="#small-caps">Robbins</hi></signed></closer>
            </div>
        </body>
