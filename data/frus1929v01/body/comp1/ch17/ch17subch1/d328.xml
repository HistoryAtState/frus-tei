    <text>
        <body>
            <div xml:id="d328">

                <pb facs="0683" n="547" sameAs="frus:frus1929v01/pg547"/>

                <note rend="inline" type="source">810.79611 Pan American Airways, Inc./234:
                    Telegram</note>
                <head><hi rendition="#italic">The Minister in Ecuador</hi> (<hi rendition="#italic">Bading</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Quito</hi></placeName>, <date calendar="gregorian"
                            when="1929-02-02T11:00:00-05:14">February 2, 1929—11
                        a.m.</date><lb/>[Received 5:15 p.m.]</dateline></opener>
                <p>8. Department’s 2, January 18, noon.<anchor n="6" xml:id="d328-f1"/> Permission
                    granted, but Government requests that official Ecuadorian pilot be taken on
                    survey flights to be picked up at first Ecuadorian port.</p>
                <closer><signed><hi rendition="#small-caps">Bading</hi></signed></closer>
            </div>
        </body>
    </text>
