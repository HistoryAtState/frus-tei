                <pb facs="0723" n="587" sameAs="frus:frus1929v01/pg587"/>

                <note rend="inline" type="source">810.79611 Pan American Airways, Inc./652:
                    Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Chargé in Peru</hi> (<hi
                        rendition="#italic">Mayer</hi>)</head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1929-09-16T16:00:00-04:00">September 16, 1929—4
                        p.m.</date></dateline></opener>
                <p>91. Your 171, September 14, 5 p.m. In order to consider plans for Colonel
                    Lindbergh to go to Peru, the Department must know how long the conference
                    scheduled for September 25 will last. Please inform the Department as soon as
                    possible as Colonel Lindbergh will stop in Washington for a few minutes early
                    Wednesday morning en route to Paramaribo.</p>
                <closer><signed><hi rendition="#small-caps">Stimson</hi></signed></closer>
            </div>
