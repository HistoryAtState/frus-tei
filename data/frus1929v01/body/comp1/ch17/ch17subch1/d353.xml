                <pb facs="0692" n="556" sameAs="frus:frus1929v01/pg556"/>

                <note rend="inline" type="source">810.79611 Pan American Airways, Inc./361:
                    Telegram</note>
                <head><hi rendition="#italic">The Minister in Honduras</hi> (<hi rendition="#italic">Summerlin</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Tegucigalpa</hi></placeName>, <date calendar="gregorian"
                            when="1929-04-02T11:00:00-06:00">April 2, 1929—11
                        a.m.</date><lb/>[Received 6:45 p.m.]</dateline></opener>
                <p>31. Your 23, March 19, 6 p.m. The local representative of the Pan American
                    Airways now states that he hopes to be able to make some kind of a working
                    arrangement with the Government of Honduras shortly after adjournment of the
                    Congress April 10.</p>
                <closer><signed><hi rendition="#small-caps">Summerlin</hi></signed></closer>
            </div>
        </body>
