    <text>
        <body>
            <div xml:id="d365">

                <pb facs="0697" n="561" xml:id="pg561"/>

                <note rend="inline" type="source">810.79611 Pan American Airways, Inc./456:
                    Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        Brazil</hi> (<hi rendition="#italic">Morgan</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1929-06-01T13:00:00-04:00">June 1, 1929—1
                    p.m.</date></dateline></opener>
                <p>21. Please request free entry contingent upon reexportation for one Fokker super
                    universal monoplane with wasp engine, shipped May 31 on <hi rendition="#italic"
                        >Western World</hi> by Pan American Airways, also permission for air mail
                    survey flights along the coast of Brazil.</p>
                <closer><signed><hi rendition="#small-caps">Clark</hi></signed></closer>
            </div>
        </body>
    </text>
