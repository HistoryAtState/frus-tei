    <text>
        <body>
            <div xml:id="d339">

                <pb facs="0687" n="551" sameAs="frus:frus1929v01/pg551"/>

                <note rend="inline" type="source">810.79611 Pan American Airways, Inc./271:
                    Telegram</note>
                <head><hi rendition="#italic">The Minister in Ecuador</hi> (<hi rendition="#italic"
                        >Bading</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Quito</hi></placeName>, <date calendar="gregorian"
                            when="1929-02-23T10:00:00-05:14">February 23, 1929—10
                        a.m.</date><lb/>[Received 3:15 p.m.]</dateline></opener>
                <p>10. Harris, Vice President of Peruvian Airways, secured personal but transferable
                    contract for Pan American Airway service.<anchor n="13" xml:id="d339-f1"/> Copy
                    of contract by mail.</p>
                <closer><signed><hi rendition="#small-caps">Bading</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d339-f1" n="13" xml:id="d339-f1-content">
                <p>See telegram No. 30, December 8, 1928, 10 a.m., to the Minister of Ecuador. <ref
                        target="frus1928v01#pg_797"><hi rendition="#italic">Foreign Relations</hi>,
                        1928, vol. <hi rendition="#small-caps">i</hi>, p. 797</ref>.</p>
            </note>
