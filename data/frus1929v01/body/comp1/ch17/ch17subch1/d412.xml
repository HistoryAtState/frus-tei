                <pb facs="0720" n="584" sameAs="frus:frus1929v01/pg584"/>

                <note rend="inline" type="source">810.79611 Pan American Airways, Inc./633:
                    Telegram</note>
                <head><hi rendition="#italic">The Chargé in France</hi> (<hi
                            rendition="#italic">Armour</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1929-09-06T16:00:00+01:00">September 6, 1929—4
                        p.m.</date><lb/>[Received September 6—2:32 p.m.]</dateline></opener>
                <p>405. Reference Department’s telegram No. 105, April 9, 5 p.m. Temporary
                    authorization granted for exploratory flight.</p>
                <p>Matter of Department’s telegram No. 258, August 10 [<hi rendition="#italic"
                        >12</hi>], being given further study.</p>
                <closer><signed><hi rendition="#small-caps">Armour</hi></signed></closer>
            </div>
