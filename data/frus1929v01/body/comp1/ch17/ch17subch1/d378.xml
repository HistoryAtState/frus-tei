                <pb facs="0702" n="566" sameAs="frus:frus1929v01/pg566"/>

                <note rend="inline" type="source">810.79611 Pan American Airways, Inc./511:
                    Telegram</note>
                <head><hi rendition="#italic">The Chargé in Uruguay</hi> (<hi rendition="#italic"
                        >Gade</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Montevideo</hi></placeName>, <date calendar="gregorian"
                            when="1929-07-02T12:00:00-03:30">July 2, 1929—noon</date>.<lb/>[Received
                        July 2—11:40 a.m.]</dateline></opener>
                <p>31. Department’s telegram 9, June 1, 1 p.m.<anchor n="20" xml:id="d378-f1"/> Free
                    entry and permission to fly and land granted.</p>
                <closer><signed><hi rendition="#small-caps">Gade</hi></signed></closer>
            </div>
        </body>
    </text>
