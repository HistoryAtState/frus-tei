    <text>
        <body>
            <div xml:id="d364">

                <pb facs="0696" n="560" sameAs="frus:frus1929v01/pg560"/>

                <note rend="inline" type="source">810.79611 Pan American Airways, Inc./455:
                    Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Ambassador in Argentina</hi> (<hi rendition="#italic">Bliss</hi>)<anchor n="17"
                        xml:id="d364-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1929-06-01T13:00:00-04:00">June 1, 1929—1
                    p.m.</date></dateline></opener>
                <p>46. Please request on behalf of Pan American Airways free entry contingent upon
                    reexportation for one Fokker super universal monoplane, also permission to fly
                    over and land in Argentina in making air mail survey flights.</p>
                <closer><signed><hi rendition="#small-caps">Clark</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d364-f1" n="17" type="source" xml:id="d364-f1-content">
                <p>The same, <hi rendition="#italic">mutatis mutandis</hi>, on the same date to the
                    Minister in Uruguay as telegram No. 9.</p>
            </note>
        </listAnnotation>
    </standOff>
