            <div xml:id="d472">

                <pb facs="0756" n="620" sameAs="frus:frus1929v01/pg620"/>

                <note rend="inline" type="source">810.79611 Tri-Motors Safety Airways/36:
                    Telegram</note>
                <head><hi rendition="#italic">The Chargé in Venezuela</hi> (<hi rendition="#italic"
                        >Engert</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Caracas</hi></placeName>, <date calendar="gregorian"
                            when="1929-05-29T20:00:00-04:30">May 29, 1929—8
                        p.m.</date><lb/>[Received May 30—5:10 p.m.]</dateline></opener>
                <p>48. Department’s 13, April 30, 2 p.m.<anchor n="66" xml:id="d472-f1"/> The
                    Venezuelan Government will permit survey flight by one Sikorsky plane between
                    Trinidad and Maracay.</p>
                <closer><signed><hi rendition="#small-caps">Engert</hi></signed></closer>
            </div>
        </body>
    </text>
