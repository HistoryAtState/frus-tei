    <text>
        <body>
            <div xml:id="d481">

                <pb facs="0759" n="623" sameAs="frus:frus1929v01/pg623"/>

                <note rend="inline" type="source">810.79611 Tri-Motors Safety Airways/85:
                    Telegram</note>
                <head><hi rendition="#italic">The Chargé in Venezuela</hi> (<hi rendition="#italic"
                        >Engert</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Caracas</hi></placeName>, <date calendar="gregorian"
                            when="1929-08-03T14:00:00-04:30">August 3, 1929—2
                        p.m.</date><lb/>[Received 6 p.m.]</dateline></opener>
                <p>113. Confidentially informed that the Government of Venezuela has approved the
                    contract with the New York, Rio, and Buenos Aires Line on essentially the same
                    terms as the French contract. See Legation’s despatch No. 1918, July 13.<anchor
                        n="72" xml:id="d481-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Engert</hi></signed></closer>
            </div>
        </body>
    </text>
