    <text>
        <body>
            <div xml:id="d847">

                <pb facs="1141" n="1005" sameAs="frus:frus1929v01/pg1005"/>

                <note rend="inline" type="source">196.6/1093</note>
                <head><hi rendition="#italic">The German Embassy to the
                            Department of State</hi><anchor n="4"
                        xml:id="d847-f1"/></head>
                <dateline>
                    <date ana="#date_undated-inferred-from-document-head" calendar="gregorian"
                        when="1929-05-17">May 17, 1929</date>
                </dateline>
                <p rendition="#center"><hi rendition="#small-caps">Memorandum</hi></p>
                <p rendition="#center">Senate Bill S. 314</p>
                <p rendition="#flush">Relating to the payment of advance wages and allotments in
                    respect of seamen of foreign vessels and making further provisions for carrying
                    out the purposes of the Seamen’s Act, approved March 4, 1915.</p>
                <p>The Bill would in the opinion of the German Government, if enacted, jeopardize
                    the rights and interests of German shipping companies in contracting with their
                    crews, as provided under the German law.</p>
                <p>The passing of the Bill would therefore be regarded with apprehension.</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d847-f1" n="4" type="source" xml:id="d847-f1-content">
                <p>Left at the Department by the Secretary of the German Embassy (Putlitz), May 17,
                    1929.</p>
            </note>
        </listAnnotation>
    </standOff>
