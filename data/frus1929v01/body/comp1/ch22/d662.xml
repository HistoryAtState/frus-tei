    <text>
        <body>
            <div xml:id="d662">

                <pb facs="0946" n="810" sameAs="frus:frus1929v01/pg810"/>

                <note rend="inline" type="source">723.2515/3474</note>
                <head><hi rendition="#italic">The Ambassador in Chile</hi> (<hi rendition="#italic"
                        >Culbertson</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Santiago</hi></placeName>, <date calendar="gregorian"
                            when="1929-07-08">July 8, 1929</date>.<lb/>[Received July
                        31.]</dateline>
                    <seg rendition="#float-left">No. 225</seg></opener>
                <p>Sir: Referring to my despatch No. 218 of July 1, 1929,<anchor n="49"
                        xml:id="d662-f1"/> I have the honor to transmit herewith the Spanish text of
                    the Protocol of the Tacna-Arica Treaty between Chile and Peru. Until released by
                    the Governments this Protocol should be held strictly confidential.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">W. S. Culbertson</hi></signed></closer>



                <xi:include href="d662-a1.xml" xpointer="d662-a1"/>
            </div>
        </body>
    </text>
