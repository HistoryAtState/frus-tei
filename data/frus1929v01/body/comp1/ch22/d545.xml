                <pb facs="0865" n="729" sameAs="frus:frus1929v01/pg729"/>

                <note rend="inline" type="source">723.2515/3270: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Peru</hi> (<hi rendition="#italic"
                        >Moore</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Lima</hi></placeName>, <date calendar="gregorian"
                            when="1929-02-28T13:00:00-05:00">February 28, 1929—1
                        p.m.</date><lb/>[Received 3 p.m.]</dateline></opener>
                <p>23. My 22, February 27, 8 p.m. President Leguia will deliver report to Ambassador
                    Figueroa at the Government Palace at 5 p.m. today.</p>
                <closer><signed><hi rendition="#small-caps">Moore</hi></signed></closer>
            </div>
        </body>
