    <text>
        <body>
            <div xml:id="d591">

                <pb facs="0892" n="756" sameAs="frus:frus1929v01/pg756"/>

                <note rend="inline" type="source">723.2515/3313b: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Ambassador in Chile</hi> (<hi rendition="#italic"
                            >Culbertson</hi>)<anchor n="16" xml:id="d591-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1929-03-25T11:00:00-05:00">March 25, 1929—11
                        a.m.</date></dateline></opener>
                <p>34. I shall remain in office until Friday.<anchor n="17" xml:id="d591-f2"/></p>
                <closer><signed><hi rendition="#small-caps">Kellogg</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d591-f1" n="16" type="source" xml:id="d591-f1-content">
                <p>The same, <hi rendition="#italic">mutatis mutandis</hi>, on the same date to the
                    Ambassador in Peru as telegram No. 32.</p>
            </note>
            <note corresp="#d591-f2" n="17" xml:id="d591-f2-content">
                <p>March 29.</p>
            </note>
        </listAnnotation>
    </standOff>
