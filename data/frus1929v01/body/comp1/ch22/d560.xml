                <pb facs="0872" n="736" sameAs="frus:frus1929v01/pg736"/>

                <note rend="inline" type="source">723.2515/3281: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Ambassador in Peru</hi> (<hi rendition="#italic"
                            >Moore</hi>)</head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1929-03-11T11:00:00-05:00">March 11, 1929—11
                        a.m.</date></dateline></opener>
                <p>21. I have just received from Ambassador Culbertson a copy of a telegram which
                    the President of Chile sent to his Ambassador at Lima, repeated to you. Please
                    telegraph as soon as possible the reaction of President Leguia to this
                    proposition of Chile.</p>
                <closer><signed><hi rendition="#small-caps">Kellogg</hi></signed></closer>
            </div>
        </body>
    </text>
