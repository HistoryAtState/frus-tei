    <text>
        <body>
            <div xml:id="d518">

                <pb facs="0832" n="696" sameAs="frus:frus1929v01/pg696"/>

                <note rend="inline" type="source">574.H1/103</note>
                <head><hi rendition="#italic">The American Minister in Canada</hi> (<hi rendition="#italic">Phillips</hi>) <hi
                        rendition="#italic">to the Canadian Secretary of State for External
                        Affairs</hi> (<hi rendition="#italic">Mackenzie
                            King</hi>)<anchor n="7" xml:id="d518-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Ottawa</hi></placeName>, <date calendar="gregorian"
                            when="1929-02-26">February 26, 1929</date>.</dateline>
                    <seg rendition="#float-left">No. 314</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With regard to the recent short length
                    radio conference at Ottawa, I am instructed by my Government to inform you that
                    it approves the recommendations of the delegates at the conference and will
                    announce the agreement effective March 1, 1929.</p>
                <p>I avail myself [etc.]</p>
                <closer><signed><hi rendition="#small-caps">William Phillips</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d518-f1" n="7" type="source" xml:id="d518-f1-content">
                <p>Copy transmitted to the Department by the Minister in Canada as an enclosure to
                    his despatch No. 1033, June 13; received June 17.</p>
            </note>
        </listAnnotation>
    </standOff>
