                <pb facs="0419" n="283" sameAs="frus:frus1929v01/pg283"/>

                <note rend="inline" type="source">500.A15a3/417a: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Ambassador in Great
                        Britain</hi> (<hi rendition="#italic">Dawes</hi>)</head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1929-11-20T17:00:00-05:00">November 20, 1929—5
                        p.m.</date></dateline></opener>
                <p>305. The President deems it wiser, until after the outcome of the forthcoming
                    discussions with the members of the Japanese delegation on their way to London,
                    for you to refrain from discussing the question of the Japanese ratio with
                    Matsudaira, in order that any possible misunderstanding or confusion on this
                    delicate subject may be avoided.</p>
                <closer><signed><hi rendition="#small-caps">Stimson</hi></signed></closer>
            </div>
        </body>
    </text>
