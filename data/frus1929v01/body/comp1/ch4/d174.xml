    <text>
        <body>
            <div xml:id="d174">

                <pb facs="0404" n="268" xml:id="pg268"/>

                <note rend="inline" type="source">500.A15a3/281</note>
                <head><hi rendition="#italic">The Japanese Ambassador</hi> (<hi rendition="#italic">Debuchi</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1929-10-16">October 16, 1929</date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: With reference to our
                    conversation this morning, I take pleasure in sending you herewith, for your
                    information, a copy of the reply of my Government to the British Note of October
                    7. I may add that the text is to be released to the press at Tokio at 9 o’clock,
                    this Friday evening.</p>
                <p>With best regards [etc.]</p>
                <closer><signed><hi rendition="#small-caps">K. Debuchi</hi></signed></closer>


                <xi:include href="d174-a1.xml" xpointer="d174-a1"/>
