    <text>
        <body>
            <div xml:id="d125">

                <pb facs="0331" n="195" sameAs="frus:frus1929v01/pg195"/>

                <note rend="inline" type="source">500.A15a3/147</note>
                <head><hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Dawes</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><seg rendition="#center">[Extract]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1929-08-23">August 23, 1929</date>.<lb/>[Received August
                        31.]</dateline>
                    <seg rendition="#float-left">No. 179</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to the Embassy’s telegram No. 241
                    of August 21st, 12 noon,<anchor n="38" xml:id="d125-f1"/> I have the honor to
                    transmit herewith the text of the Prime Minister’s statement on Anglo-American
                    naval negotiations, issued at Lossiemouth on August 20th and generally published
                    in the London press on August 21st …</p>
                <p>I have [etc.]</p>
                <closer>For the Ambassador:<lb/><signed><hi rendition="#small-caps">F. L.
                        Belin</hi></signed><lb/><hi rendition="#italic">First Secretary of
                        Embassy</hi></closer>



                <xi:include href="d125-a1.xml" xpointer="d125-a1"/>
            </div>
        </body>
    </text>
