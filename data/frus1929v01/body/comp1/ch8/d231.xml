    <text>
        <body>
            <div xml:id="d231">

                <pb facs="0535" n="399" sameAs="frus:frus1929v01/pg399"/>

                <note rend="inline" type="source">551.58B1/18</note>
                <head><hi rendition="#italic">The Secretary of State to the Minister in
                        Switzerland</hi> (<hi rendition="#italic">Wilson</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1929-03-22">March 22, 1929</date>.</dateline>
                    <seg rendition="#float-left">No. 430</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: There is enclosed, for transmission in the
                    usual informal manner, a note to the Secretary General of the League of Nations,
                    in reply to his note of October 8, 1928,<anchor n="7" xml:id="d231-f1"/>
                    requesting this Government’s observations on the proposals contained in the
                    report of the Mixed Committee for the Suppression of Counterfeiting
                    Currency.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State:<lb/><signed><hi rendition="#small-caps">W. R.
                            Castle, Jr.</hi></signed></closer>


                <xi:include href="d231-a1.xml" xpointer="d231-a1"/>
            </div>
        </body>
    </text>
