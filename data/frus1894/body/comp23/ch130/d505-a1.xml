                <pb facs="0566" n="516" sameAs="frus:frus1894/pg516"/>

                <opener><seg rendition="#center">[Document No. 1.—From the legation of
                        Portugal.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Rio de Janeiro</hi></placeName>, <date calendar="gregorian"
                            when="1894-03-11"><hi rendition="#italic">March 11,
                        1894</hi></date>.</dateline></opener>
                <p>Asylum granted without my authorization. I request orders.</p>
                <closer><signed><hi rendition="#small-caps">Paraty.</hi></signed></closer>
            </div>
        </body>
