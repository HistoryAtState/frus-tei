    <text>
        <body>
            <div xml:id="d505-a32">

                <pb facs="0570" n="520" sameAs="frus:frus1894/pg520"/>

                <opener><seg rendition="#center">[Document No. 32.—To the legation of Portugal in
                        Buenos Ayres.]</seg></opener>
                <opener><dateline rendition="#float-right"><date calendar="gregorian"
                            when="1894-04-08"><hi rendition="#small-caps">April</hi> 8,
                        1894</date>.</dateline></opener>
                <p>Received your telegram to-day. You may sign the contract; to-morrow I will make
                    provision of money.</p>
                <closer><signed><hi rendition="#small-caps">Hintze Ribeiro.</hi></signed></closer>
            </div>
        </body>
    </text>
