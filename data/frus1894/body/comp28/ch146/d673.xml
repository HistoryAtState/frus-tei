    <text>
        <body>
            <div xml:id="d673">

                <pb facs="0701" n="651" sameAs="frus:frus1894/pg651"/>

                <head><hi rendition="#italic">Mr. Cheney to Mr.
                            Foster.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Legation of the United States</hi></placeName>, <date
                            calendar="gregorian" when="1893-01-31"><hi rendition="#italic">January
                                31, 1893</hi></date>. (Received February 14.)</dateline>
                    <seg rendition="#float-left">No. 5.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I find at this legation the inclosed
                    communication from the federal department of foreign affairs, in reply to Mr.
                    Washburn’s letter of August 10.</p>
                <p>I respectfully forward the copy of same and await instructions.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Person C. Cheney.</hi></signed></closer>


                <xi:include href="d673-a1.xml" xpointer="d673-a1"/>
