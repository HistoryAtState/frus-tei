    <text>
        <body>
            <div xml:id="d677">

                <pb facs="0704" n="654" sameAs="frus:frus1894/pg654"/>

                <head><hi rendition="#italic">Mr. Cheney to Mr. Gresham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Legation of the United States</hi></placeName>, <date
                            calendar="gregorian" when="1893-05-23"><hi rendition="#italic">May 23,
                                1893</hi></date>. (Received June 3.)</dateline>
                    <seg rendition="#float-left">No. 27.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith the
                    reply of the chief of the department of foreign affairs in reply to my
                    communication of March 18, the same being in substance the language of the then
                    Acting Secretary, Mr. Wharton, in his letter of instructions to this legation
                    under date of February 17.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Person C. Cheney.</hi></signed></closer>



                <xi:include href="d677-a1.xml" xpointer="d677-a1"/>
