    <text>
        <body>
            <div xml:id="d802">

                <pb facs="0830" n="780" xml:id="pg780"/>

                <head><hi rendition="#italic">Mr. Terrell to Mr. Gresham.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1894-09-08"><hi rendition="#italic">September 8,
                        1894</hi></date>.</dateline></opener>
                <p>Adam Aivazian has been pardoned and discharged. Seferiades<anchor n="1"
                        xml:id="d802-f1"/> is not under arrest, but is absent from Smyrna.</p>
                <closer><signed><hi rendition="#small-caps">Terrell.</hi></signed></closer>
            </div>
        </body>
    </text>
