    <text>
        <body>
            <div xml:id="d715-a1">

                <pb facs="0763" n="713" sameAs="frus:frus1894/pg713"/>

                <opener><seg rendition="#center">[Inclosure 1 in No. 148.]</seg></opener>
                <head><hi rendition="#italic">Mr. Short to Mr.
                            Terrell.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Consulate-General of the United States</hi>,<lb/><hi
                                rendition="#italic">Consulate-General of the United
                            States</hi></placeName>, <date calendar="gregorian" when="1894-01-04"
                                ><hi rendition="#italic">January 4,
                    1894</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your dispatch No. 20, of this date, inclosing a communication in Arabic from
                    Selah Merrill, consul at Jerusalem, and beg leave to return herewith said
                    communication, with its translation in English, as desired.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Luther Short</hi>,</signed></closer>
            </div>
        </body>
