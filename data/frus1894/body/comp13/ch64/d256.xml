    <text>
        <body>
            <div xml:id="d256">

                <pb facs="0312" n="262" sameAs="frus:frus1894/pg262"/>

                <head><hi rendition="#italic">Mr. Uhl to Sir
                            Julian Pauncefote.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1894-06-19"><hi rendition="#italic">June 19,
                        1894</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: Referring to your note of the 14th
                    ultimo, and to my reply of the 25th ultimo, I have the honor to inclose herewith
                    two copies of “An act to adopt regulations for preventing collisions at sea,”
                    approved by the President May 28, 1894.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Edwin F. Uhl.</hi></signed></closer>
            </div>
        </body>
    </text>
