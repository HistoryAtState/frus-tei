                <pb facs="0344" n="294" sameAs="frus:frus1894/pg294"/>

                <head><hi rendition="#italic">Mr. Uhl to Mr. Alexander.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1894-05-26"><hi rendition="#italic">May 26,
                        1894</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 23.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to the Department’s instruction
                    to you, No. 21, of the 16th instant, I transmit to you herewith a full power
                    authorizing you to negotiate, conclude, and sign a convention between the United
                    States and Greece for the reciprocal protection of trade-marks and trade
                    labels.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Edwin F. Uhl</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary</hi></signed></closer>
            </div>
        </body>
    </text>
