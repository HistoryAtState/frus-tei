    <text>
        <body>
            <div xml:id="d181">

                <pb facs="0224" n="174" sameAs="frus:frus1894/pg174"/>

                <head><hi rendition="#italic">Mr. Denby to Mr. Gresham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1894-09-10"><hi rendition="#italic">September 10,
                        1894</hi></date>. (Received October 27.)</dateline>
                    <seg rendition="#float-left">No. 1960.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a copy
                    of a dispatch from the Japanese minister for foreign affairs to Mr. Dun, U. S.
                    minister at Tokyo, explanatory of Japan’s withdrawal from negotiations
                    concerning the exemption of private ships from capture.</p>
                <p>I also inclose herewith a copy of another dispatch from the same to the same, in
                    explanation of the refusal of Japan to grant safe conducts to the vessels of the
                    Chinese foreign customs service employed as light-house tenders.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Chas. Denby, Jr.</hi>,<lb/><hi
                            rendition="#italic">Chargé d’ Affaires ad
                    interim.</hi></signed></closer>



                <xi:include href="d181-a1.xml" xpointer="d181-a1"/>
