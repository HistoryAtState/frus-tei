    <text>
        <body>
            <div xml:id="d172">

                <pb facs="0211" n="161" sameAs="frus:frus1894/pg161"/>

                <head><hi rendition="#italic">Mr. Gresham to Mr.
                            Yang Yü.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1894-03-15"><hi rendition="#italic">March 15,
                        1894</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In reply to your note of the 12th instant,
                    I have the honor to inclose for your information copy of a letter which I
                    addressed to the Secretary of the Treasury on the same date, and a copy of his
                    reply thereto, transmitting copy of a report upon the subject of registration of
                    Chinese laborers by the Commissioner of Internal Revenue.</p>
                <closer><signed><hi rendition="#small-caps">W. Q. Gresham.</hi></signed></closer>





