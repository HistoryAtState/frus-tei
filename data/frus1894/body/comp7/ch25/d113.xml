    <text>
        <body>
            <div xml:id="d113">

                <pb facs="0164" n="114" xml:id="pg114"/>

                <head><hi rendition="#italic">Mr. Jernigan to Mr. Denby.</hi></head>
                <opener><dateline rendition="#float-right"><date calendar="gregorian"
                            when="1894-08-19"><hi rendition="#small-caps">August</hi> 19,
                            1894</date>.</dateline></opener>
                <p>Have written fully relative to alleged Japanese spies. They are secure.</p>
                <closer><signed><hi rendition="#small-caps">Jernigan.</hi></signed></closer>
            </div>
        </body>
