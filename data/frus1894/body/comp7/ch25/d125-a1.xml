            <div xml:id="d125-a1">

                <pb facs="0167" n="117" sameAs="frus:frus1894/pg117"/>

                <opener><seg rendition="#center">[Inclosure.—The Japan Daily Mail.—Yokohama,
                        Thursday, August 9, 1894.]</seg></opener>
                <head><hi rendition="#italic">Imperial ordinance.</hi></head>
                <p>We publish below an authorized translation of the important imperial ordinance of
                    the 4th instant.</p>
                <p>We hereby sanction the present regulations relating to Chinese subjects residing
                    in Japan, and order the same to be promulgated.</p>
                <p>(Privy seal.)</p>
                <closer>(<signed>H. I. M.’s Sign Manual</signed>.) <lb/>
                    <dateline rendition="#float-left"><date calendar="japanese-nengō"
                            when="1894-08-04">The 4th day, the 8th month, the 27th year of <hi
                                rendition="#italic">Meiji</hi></date>.</dateline></closer>
                <postscript>
                    <p>(Countersigned)</p>
                    <signed>Count <hi rendition="#small-caps">Ito Hirobumi</hi>,<lb/><hi
                            rendition="#italic">Minister President of State</hi>.</signed>
                    <lb/>
                    <signed>Count <hi rendition="#small-caps">Inouye Kaoru</hi>,<lb/><hi
                            rendition="#italic">Minister of State for Home Affairs.</hi></signed>
                    <lb/>
                    <signed><hi rendition="#small-caps">Mutsu Munemitsu</hi>,<lb/><hi
                            rendition="#italic">Minister of State for Foreign Affairs.</hi></signed>
                    <lb/>
                    <signed><hi rendition="#small-caps">Yoshikawa Akimasa</hi>,<lb/><hi
                            rendition="#italic">Minister of State for Justice.</hi></signed>
                </postscript>
            </div>
