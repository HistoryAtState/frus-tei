    <text>
        <body>
            <div xml:id="d483">

                <pb facs="0534" n="484" xml:id="pg484"/>

                <head><hi rendition="#italic">Mr. McDonald to Mr.
                            Gresham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Teheran, Persia</hi></placeName>, <date calendar="gregorian"
                            when="1894-01-11"><hi rendition="#italic">January 11, 1894</hi></date>.
                        (Received February 17.)</dateline>
                    <seg rendition="#float-left">No. 57.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith a
                    copy of the translation of the memorandum sent from the foreign office
                    respecting the taxation of foreigners engaged in various trades in Persia, and a
                    copy of the translation of the reply thereto.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alex. McDonald.</hi></signed></closer>



                <xi:include href="d483-a1.xml" xpointer="d483-a1"/>
