    <text>
        <body>
            <div xml:id="d357">

                <pb facs="0409" n="359" sameAs="frus:frus1894/pg359"/>

                <head><hi rendition="#italic">Mr. Willis to Mr. Gresham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Honolulu, Hawaiian Islands</hi></placeName>, <date
                            calendar="gregorian" when="1894-08-27"><hi rendition="#italic">August
                                27, 1894</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 67.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inform you that the
                    autograph letter of President Cleveland, recognizing the Republic of Hawaii, was
                    delivered to President Dole at 11 o’clock this morning at the executive building
                    in the presence of the members of his cabinet and Minister Thurston.</p>
                <p>I inclose copies of the remarks submitted upon the occasion.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Albert S. Willis.</hi></signed></closer>



                <xi:include href="d357-a1.xml" xpointer="d357-a1"/>
