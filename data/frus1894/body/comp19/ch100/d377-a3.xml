    <text>
        <body>
            <div xml:id="d377-a3">

                <pb facs="0432" n="382" sameAs="frus:frus1894/pg382"/>

                <opener><seg rendition="#center">[Subinolosure 1 in No. 48.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Consulate of the United States</hi>,<lb/><hi rendition="#italic"
                                >Nagasaki, Japan</hi></placeName>, <date calendar="gregorian"
                            when="1893-01-14"><hi rendition="#italic">January 14,
                        1893</hi></date>.</dateline></opener>
                <p>Governor <hi rendition="#small-caps">T. Nakano</hi>,<lb/><hi rendition="#italic"
                        >Kencho:</hi></p>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inform you that Mr.
                    George W. Lake, an American citizen, deported from Nagasaki in 1871 at the
                    request of the Japanese Government, has returned to this city.</p>
                <p>Will you do me the honor to advise me, at your earliest convenience, whether or
                    not there is still existing objection to his residence temporarily or
                    permanently in this city?</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. H. Abercrombie</hi>,<lb/><hi
                            rendition="#italic">U. S. Consul.</hi></signed></closer>
            </div>
        </body>
