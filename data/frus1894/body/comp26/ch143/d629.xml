        <body>
            <div xml:id="d629">

                <pb facs="0669" n="619" sameAs="frus:frus1894/pg619"/>

                <head><hi rendition="#italic">Mr. Taylor to Mr.
                            Gresham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1894-08-30"><hi rendition="#italic">August 30, 1894</hi></date>.
                        (Received September 10.)</dateline>
                    <seg rendition="#float-left">No. 228.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herein, with
                    translation, a copy of a note just received from the minister of state,
                    announcing the fact that His Majesty’s Government has decided to annul the
                    decree of June 28, 1891, putting into execution the reciprocity arrangement in
                    the islands of Cuba and Porto Rico.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Hannis Taylor.</hi></signed></closer>


                <xi:include href="d629-a1.xml" xpointer="d629-a1"/>
