                <pb facs="0676" n="626" sameAs="frus:frus1894/pg626"/>

                <head><hi rendition="#italic">Mr. Taylor to Mr. Gresham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States.</hi><lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1894-12-31"><hi rendition="#italic">December 31, 1894</hi></date>.
                        (Received January 15, 1895.)</dateline>
                    <seg rendition="#float-left">No. 278.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to report the receipt
                    yesterday (Sunday) of your telegram of the 29th instant. I inclose you herein a
                    copy of a note which I have to-day addressed to the minister of state.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Hannis Taylor.</hi></signed></closer>



                <xi:include href="d641-a1.xml" xpointer="d641-a1"/>
