    <text>
        <body>
            <div xml:id="d632">

                <pb facs="0672" n="622" sameAs="frus:frus1894/pg622"/>

                <head><hi rendition="#italic">Mr. Uhl to Mr. Muruaga.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1894-05-19"><hi rendition="#italic">May 19,
                        1894</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge receipt of
                    your note of 14th instant, making inquiries touching changes in the duties at
                    present operative under the reciprocity arrangement.</p>
                <p>A copy of your note has been laid before the Secretary of the Treasury for his
                    consideration and an expression of his views upon the subject-matter
                    thereof.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Edwin F. Uhl</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary</hi>,</signed></closer>
            </div>
        </body>
    </text>
