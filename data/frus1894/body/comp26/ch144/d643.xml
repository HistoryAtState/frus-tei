        <body>
            <div xml:id="d643">

                <pb facs="0677" n="627" sameAs="frus:frus1894/pg627"/>

                <head><hi rendition="#italic">Mr. Taylor to Mr.
                            Gresham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1895-01-01"><hi rendition="#italic">January 1, 1895</hi></date>.
                        (Received January 15.)</dateline>
                    <seg rendition="#float-left">No. 279.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have just received from the minister of
                    state an answer to your demand of the 16th ultimo, which I inclose herein with
                    translation. I have just communicated to you the substance of this answer in a
                    telegram.</p>
                <p>I am, etc.</p>
                <closer><signed><hi rendition="#small-caps">Hannis Taylor.</hi></signed></closer>


                <xi:include href="d643-a1.xml" xpointer="d643-a1"/>
