        <body>
            <div xml:id="d595">

                <pb facs="0647" n="597" xml:id="pg597"/>

                <head><hi rendition="#italic">Mr. Taylor to Mr. Gresham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1894-09-01"><hi rendition="#italic">September 1, 1894</hi></date>.
                        (Received September 13.)</dateline>
                    <seg rendition="#float-left">No. 231.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herein, with
                    translation, a copy of a note just received from the minister of state in reply
                    to my note of the 27th ultimo, demanding permission for the missionaries to
                    return to Ponape, a copy of which I mailed to you on that day. * * *</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Hannis Taylor.</hi></signed></closer>


                <xi:include href="d595-a1.xml" xpointer="d595-a1"/>
