    <text>
        <body>
            <div xml:id="d617">

                <pb facs="0660" n="610" sameAs="frus:frus1894/pg610"/>

                <head><hi rendition="#italic">Mr. Taylor to Mr.
                            Gresham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1894-06-22"><hi rendition="#italic">June 22, 1894</hi></date>.
                        (Received July 5.)</dateline>
                    <seg rendition="#float-left">No. 192.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith, with
                    translation, a copy of the official notice just received from the ministry of
                    state as to the promulgation of the definitive repertory.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Hannis Taylor.</hi></signed></closer>



                <xi:include href="d617-a1.xml" xpointer="d617-a1"/>
