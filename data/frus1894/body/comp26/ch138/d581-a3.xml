    <text>
        <body>
            <div xml:id="d581-a3">

                <pb facs="0631" n="581" xml:id="pg581"/>

                <opener><seg rendition="#center">[Inclosure 3 in No. 65.]</seg></opener>
                <head><hi rendition="#italic">Certificate of collector of customs.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Office of the Collector of Customs</hi>,<lb/><hi
                                rendition="#italic">Port of New
                    York</hi></placeName>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#italic">To whom it may concern:</hi></p>
                <p>This is to certify that Spanish vessels, and the vessels of all other nations,
                    are required, under section 2887, United State’s Revised Statutes, to make post
                    entries of cargo unmentioned in manifests by accident or mistake.</p>
                <closer>
                    <dateline rendition="#float-left">Given under my hand and seal of office <date
                            calendar="gregorian" when="1893-11-16">this 16th day of November,
                            1893</date>.</dateline>
                    <lb/> [<hi rendition="#small-caps">seal.</hi>] <signed><hi
                            rendition="#small-caps">James T. Kilbraith</hi>,<lb/><hi
                            rendition="#italic">Collector of Customs.</hi></signed></closer>
            </div>
        </body>
    </text>
