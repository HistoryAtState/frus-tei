                <pb facs="0291" n="241" sameAs="frus:frus1894/pg241"/>

                <head><hi rendition="#italic">Mr. Runyon to Mr.
                            Gresham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >Berlin</hi></placeName>, <date calendar="gregorian"
                            when="1894-11-01"><hi rendition="#italic">November 1,
                        1894</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 153.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to append hereto a
                    memorandum report of certain military cases, more particularly mentioned below,
                    which have not yet been referred to in my correspondence with the State
                    Department, and to be, sir, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Theodore Runyon.</hi></signed></closer>












