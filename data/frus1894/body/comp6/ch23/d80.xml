                <pb facs="0139" n="89" sameAs="frus:frus1894/pg89"/>

                <head><hi rendition="#italic">Mr. McGarr to Mr. Gresham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Santiago</hi></placeName>, <date calendar="gregorian"
                            when="1894-04-21"><hi rendition="#italic">April 21, 1894</hi></date>.
                        (Received May 25.)</dateline>
                    <seg rendition="#float-left">No. 121.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have received from the minister of
                    foreign affairs a note (of which a translation is inclosed) saying that the
                    determination of the question of another commission to dispose of the unsettled
                    claims presented to the late United States and Chilean claim commission will be
                    communicated by his successor in that ministry.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">O. McGarr.</hi></signed></closer>


                <xi:include href="d80-a1.xml" xpointer="d80-a1"/>
