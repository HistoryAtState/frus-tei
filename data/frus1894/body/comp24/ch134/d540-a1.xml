    <text>
        <body>
            <div xml:id="d540-a1">

                <pb facs="0607" n="557" sameAs="frus:frus1894/pg557"/>

                <opener><seg rendition="#center">[Inclosure in No. 264.]</seg></opener>
                <head><hi rendition="#italic">Draft of certificate.</hi></head>
                <p rendition="#flush"><hi rendition="#italic">To all whom it may concern:</hi></p>
                <p>Be it known that whereas William Hess, a citizen of the United States, has
                    declared by letter his intention and desire to relinquish his citizenship and
                    allegiance to the said United States:</p>
                <p>Now, therefore, this is to certify that this legation, representing the
                    Government of the United States, finds no objection to the aforesaid William
                    Hess becoming a subject of his Imperial Majesty the Emperor of Russia.</p>
            </div>
        </body>
