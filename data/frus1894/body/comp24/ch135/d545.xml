    <text>
        <body>
            <div xml:id="d545">

                <pb facs="0608" n="558" sameAs="frus:frus1894/pg558"/>

                <head><hi rendition="#italic">The President to the Emperor of Russia.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1894-11-02"><hi rendition="#italic">November 2,
                        1894</hi></date>.</dateline></opener>
                <p rendition="#flush">His Majesty <hi rendition="#small-caps">Nicolas
                        II,</hi><lb/><hi rendition="#italic">Emperor of Russia, Livadia:</hi></p>
                <p>I hasten to express my heartfelt sympathy and the sympathy of my countrymen with
                    the Imperial family and the Russian people in their affliction by reason of the
                    death of your honored father.</p>
                <closer><signed><hi rendition="#small-caps">Grover Cleveland.</hi></signed></closer>
            </div>
        </body>
    </text>
