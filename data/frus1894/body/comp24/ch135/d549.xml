        <body>
            <div xml:id="d549">

                <pb facs="0609" n="559" sameAs="frus:frus1894/pg559"/>

                <head><hi rendition="#italic">Mr. Breckinridge to Mr. Gresham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic">St.
                                Petersburg</hi></placeName>, <date calendar="gregorian"
                            when="1894-11-06"><hi rendition="#italic">November 6, 1894</hi></date>.
                        (Received November 26.)</dateline>
                    <seg rendition="#float-left">No. 3.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith the
                    translation of the proclamation of His Imperial Majesty Nicolas II.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Clifton R.
                    Breckinridge</hi>,</signed></closer>



                <xi:include href="d549-a1.xml" xpointer="d549-a1"/>
