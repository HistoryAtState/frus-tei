    <text>
        <body>
            <div xml:id="d668">

                <pb facs="0694" n="644" sameAs="frus:frus1894/pg644"/>

                <head><hi rendition="#italic">Mr. Uhl to Mr. Grip.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1894-10-03"><hi rendition="#italic">October 3,
                        1894</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose for your
                    information copy of a letter from the Acting Secretary of the Treasury,
                    transmitting a copy of a circular issued by that Department relative to the
                    admeasurement of Norwegian vessels.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Edwin F. Uhl</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>




                <xi:include href="d668-a1.xml" xpointer="d668-a1"/>
