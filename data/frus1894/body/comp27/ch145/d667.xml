    <text>
        <body>
            <div xml:id="d667">

                <pb facs="0693" n="643" sameAs="frus:frus1894/pg643"/>

                <head><hi rendition="#italic">Mr. Uhl to Mr.
                            Grip.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1894-10-03"><hi rendition="#italic">October 3,
                        1894</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to your note of the 16th of July
                    last, in relation to the reciprocal acceptance of certificates of admeasurement
                    of vessels by the United States and Sweden, I have the honor to inclose herewith
                    copy of a letter of the 29th ultimo from the Acting Secretary of the Treasury
                    upon the subject.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Edwin F. Uhl</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>


                <xi:include href="d667-a1.xml" xpointer="d667-a1"/>
