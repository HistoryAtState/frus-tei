                <pb facs="0106" n="56" xml:id="pg56"/>

                <head><hi rendition="#italic">Mr. Gresham to Mr. Moonlight.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1894-08-27"><hi rendition="#italic">August 27,
                        1894</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 26.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have received your No. 36, of the 19th
                    ultimo, concerning the case of Romulo Fortún, of the Bolivian army, and desire
                    to approve your explanatory note to the minister of foreign affairs touching the
                    same.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. Q. Gresham.</hi></signed></closer>
            </div>
        </body>
    </text>
