                <p><hi rendition="#superscript">1</hi> Add freight, 7 cents per gallon, and duty
                    stands at 71.</p>
                <p><hi rendition="#superscript">2</hi> Add freight, and duty stands at 40.</p>
                <pb facs="0062" n="12" xml:id="pg12"/>
