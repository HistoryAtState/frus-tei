    <text>
        <body>
            <div xml:id="d7-a1">

                <pb facs="0056" n="6" sameAs="frus:frus1894/pg6"/>

                <opener><seg rendition="#center">[Inclosure—Telegram.]</seg></opener>
                <head><hi rendition="#italic">Señor Costa to Señor Zeballos.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Buenos Ayres</hi></placeName>, <date calendar="gregorian"
                            when="1894-06-18"><hi rendition="#italic">June 18,
                        1894</hi></date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Argentine Minister</hi>, <hi
                        rendition="#italic">Washington, D. C.:</hi></p>
                <p>Received telegram with great satisfaction. Government will use efforts in order
                    that Congress shall respond with possible exemptions.</p>
                <closer><signed><hi rendition="#small-caps">Eduardo Costa.</hi></signed></closer>
            </div>
        </body>
    </text>
