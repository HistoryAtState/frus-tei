    <text>
        <body>
            <div xml:id="d807-a3">

                <pb facs="0842" n="792" sameAs="frus:frus1894/pg792"/>

                <opener><seg rendition="#center">[Inclosure 3 in No. 150.—Telegram.]</seg></opener>
                <head><hi rendition="#italic">Mr. Carpenter to Mr. Bartleman.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Ciudad Bolivar</hi></placeName>, <date calendar="gregorian"
                            when="1894-05-12"><hi rendition="#italic">May 12, 1894</hi></date>.
                        (Received May 14.)</dateline></opener>
                <p><hi rendition="#italic">Bolivar</hi> still illegally detained. Full particulars
                    of the case already in possession of State Department, Washington. If you can do
                    nothing, ask for instructions from Washington. Demand immediate release, Please
                    wire answer here to me at this place at once.</p>
                <closer><signed><hi rendition="#small-caps">Geo. F. Carpenter</hi>,<lb/><hi
                            rendition="#italic">Manager.</hi></signed></closer>
            </div>
        </body>
    </text>
