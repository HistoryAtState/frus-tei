    <text>
        <body>
            <div xml:id="d810">

                <pb facs="0844" n="794" sameAs="frus:frus1894/pg794"/>

                <head><hi rendition="#italic">Mr. Bartleman to Mr.
                            Gresham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Caracas</hi></placeName>, <date calendar="gregorian"
                            when="1894-06-08"><hi rendition="#italic">June 8, 1894</hi></date>.
                        (Received June 19.)</dateline>
                    <seg rendition="#float-left">No. 156.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith, in
                    copy and translation, an additional decree (first transmitted with No. 58, of
                    July 10, 1893),<anchor n="1" xml:id="d810-f1"/> with reference to the navigation
                    of the Orinoco River and its channels.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">R. M. Bartleman.</hi></signed></closer>


                <xi:include href="d810-a1.xml" xpointer="d810-a1"/>
            </div>
        </body>
    </text>
