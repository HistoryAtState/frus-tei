    <text>
        <body>
            <div xml:id="d808">

                <pb facs="0842" n="792" sameAs="frus:frus1894/pg792"/>

                <head><hi rendition="#italic">Mr. Bartleman to Mr. Gresham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Caracas</hi></placeName>, <date calendar="gregorian"
                            when="1894-05-30"><hi rendition="#italic">May 30, 1894</hi></date>.
                        (Received June 7.)</dateline>
                    <seg rendition="#float-left">No. 154.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to append on the overleaf
                    a copy of a telegram received on the 24th instant, in which it is stated that
                    the American steamer <hi rendition="#italic">Bolivar</hi> has been cleared by
                    the collector of customs and all authorities.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">R. M. Bartleman.</hi></signed></closer>


                <xi:include href="d808-a1.xml" xpointer="d808-a1"/>
