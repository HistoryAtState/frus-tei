    <text>
        <body>
            <div xml:id="d56-a9">

                <pb facs="0118" n="68" xml:id="pg68"/>

                <head><hi rendition="#small-caps">note of the portuguese legation to the brazilian
                        government.</hi></head>
                <opener><dateline rendition="#float-right"><date calendar="gregorian"
                            when="1894-03-17"><hi rendition="#small-caps">March</hi> 17,
                        1894</date>.</dateline></opener>
                <p>I have the honor to herewith remit you a list of the fugitives in refuge on the
                    Portuguese ships, it being a copy of a list furnished me by Commander
                    Castilho.</p>
                <p>I renew the assurance, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Conde Paraty.</hi></signed></closer>
                <postscript>
                    <p>To Dr. <hi rendition="#small-caps">Cassiano do Nascimento</hi>,<lb/><hi
                            rendition="#italic">Minister for Foreign Affairs.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
