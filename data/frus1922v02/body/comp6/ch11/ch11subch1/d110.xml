                <pb facs="0232" n="118" sameAs="frus:frus1922v02/pg118"/>

                <note rend="inline" type="source">890d.01/79</note>
                <head><hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic"
                        >Herrick</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1922-06-30"><hi rendition="#italic">June 30,
                        1922</hi></date>.<lb/>[Received July 11.]</dateline>
                    <seg rendition="#float-left">No. 2085</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to my telegram No. 269, June
                    30th, 4 P.M.,<anchor n="5" xml:id="d110-f1"/> I have the honor to transmit
                    herewith copy and translation of the proposed texts of the French Mandate for
                    Syria and the Lebanon and the Franco-American Treaty in regard thereto. A copy
                    and translation of the accompanying Foreign Office Note are likewise
                    forwarded.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Myron T. Herrick</hi></signed></closer>




                <xi:include href="d110-a1.xml" xpointer="d110-a1"/>
