    <text>
        <body>
            <div xml:id="d93">

                <pb facs="0216" n="102" sameAs="frus:frus1922v02/pg102"/>

                <note rend="inline" type="source">422.11Am8/39</note>
                <head><hi rendition="#italic">The Consul General at Guayaquil</hi> (<hi rendition="#italic">Goding</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><seg rendition="#center">[Extract]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Guayaquil</hi></placeName>, <date calendar="gregorian"
                            when="1922-04-25"><hi rendition="#italic">April 25,
                        1922</hi></date>.<lb/>[Received May 10, 1922.]</dateline>
                    <seg rendition="#float-left">No. 790</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inform you that the
                    indebtedness of the Municipality of Guayaquil to Amsinck &amp; Company of New
                    York has been settled, and the money therefor is deposited in the bank to the
                    credit of that house.</p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Frederic W.
                    Goding</hi></signed></closer>
            </div>
        </body>
    </text>
