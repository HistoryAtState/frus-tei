                <pb facs="0521" n="407" sameAs="frus:frus1922v02/pg407"/>

                <note rend="inline" type="source">711.419/–</note>
                <head><hi rendition="#italic">The British Ambassador</hi> (<hi
                            rendition="#italic">Geddes</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1922-04-27"><hi rendition="#italic">April 27,
                        1922</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 323</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honour, on instructions from my
                    Government, to give formal notice of the denunciation of the Treaty and
                    Convention <pb facs="0522" n="408" xml:id="pg408"/> between His Majesty’s
                    Government and the United States Government for the abolition of the slave
                    trade. In communicating this notice to you, I am instructed to state that this
                    action is taken in accordance with the general policy of His Majesty’s
                    Government to abolish all obsolete instruments since the circumstances under
                    which these Treaties were negotiated are now happily past.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">A. C. Geddes</hi></signed></closer>
            </div>
        </body>
    </text>
