            <div xml:id="d294">

                <pb facs="0506" n="392" sameAs="frus:frus1922v02/pg392"/>

                <note rend="inline" type="source">123 S1 1/80: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Harvey</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1922-07-26T14:00:00+01:00"><hi rendition="#italic">July 26, 1922—2
                                p.m.</hi></date><lb/>[Received July 26—9:58
                    a.m.]</dateline></opener>
                <p>312. Your 217, July 20, 3 p.m. Investigation now proceeding. Embassy has
                    informally communicated to the Foreign Office its assumption that actual
                    withdrawal of recognition will not be proceeded with until opportunity has been
                    given to develop and confirm pertinent facts.</p>
                <closer><signed><hi rendition="#small-caps">Harvey</hi></signed></closer>
            </div>
        </body>
