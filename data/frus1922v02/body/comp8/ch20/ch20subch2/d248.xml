                <pb facs="0444" n="330" sameAs="frus:frus1922v02/pg330"/>

                <note rend="inline" type="source">800.01 M 31/146</note>
                <head><hi rendition="#italic">The British Ambassador</hi> (<hi
                            rendition="#italic">Geddes</hi>) <hi rendition="#italic">to
                        the Acting Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1922-08-14"><hi rendition="#italic">August 14,
                        1922</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 627</seg></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: With reference to our
                    conversation of this morning on the subject of the use of the words “Concurs”
                    and “Consents” in the Treaty between the United States of America and Great
                    Britain respecting “B” Mandates, I have the honour to inform you that I agree to
                    the use of the word “Consents” on the distinct understanding that its use will
                    not prejudice the legal position of His Majesty’s Government arising under
                    various treaties with Germany.</p>
                <p>Believe me [etc.]</p>
                <closer><signed><hi rendition="#small-caps">A. C. Geddes</hi></signed></closer>
            </div>
        </body>
    </text>
