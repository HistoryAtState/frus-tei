    <text>
        <body>
            <div xml:id="d228">

                <pb facs="0393" n="279" sameAs="frus:frus1922v02/pg279"/>

                <note rend="inline" type="source">867n.01/232</note>
                <head><hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Harvey</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1922-05-17"><hi rendition="#italic">May 17,
                        1922</hi></date>.<lb/>[Received June 1.]</dateline>
                    <seg rendition="#float-left">No. 1314</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to the Department’s
                    telegraphic Instruction No. 134, of May 8, 8 p.m., relative to the mandate for
                    Palestine, I have the honor to enclose herewith, copies of my Note, No. 218,
                    dated May 10, 1922,<anchor n="16" xml:id="d228-f1"/> based on the
                    above-mentioned instruction, and of a Note received to-day from the Foreign
                    Office, dated May 16, 1922, replying thereto.</p>
                <p>I have [etc.]</p>
                <closer>For the Ambassador:<lb/><signed><hi rendition="#small-caps">Post
                            Wheeler</hi></signed><lb/><hi rendition="#italic">Counselor of
                        Embassy</hi></closer>



                <xi:include href="d228-a1.xml" xpointer="d228-a1"/>
            </div>
        </body>
    </text>
