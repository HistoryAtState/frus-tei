            <div xml:id="d240">

                <pb facs="0418" n="304" sameAs="frus:frus1922v02/pg304"/>

                <note rend="inline" type="source">867n.01/318</note>
                <head><hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Harvey</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1922-10-11"><hi rendition="#italic">October 11,
                        1922</hi></date>.<lb/>[Received October 20.]</dateline>
                    <seg rendition="#float-left">No. 1748</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Confirming this Embassy’s telegram No. 442
                    of October 4, 12 noon, 1922,<anchor n="27" xml:id="d240-f1"/> I have the honor
                    to enclose herewith copies of Notes No. W 7965/1110/98, and No. E 9865/78/65,
                    dated September 30, 1922,<anchor n="28" xml:id="d240-f2"/> and October 2, 1922,
                    respectively, relative to the proposed Convention between Great Britain and the
                    United States regarding the Palestine mandate and the African mandates.</p>
                <p>I have [etc.]</p>
                <closer>For the Ambassador:<lb/><signed><hi rendition="#small-caps">Oliver B.
                            Harriman</hi></signed><lb/><hi rendition="#italic">First Secretary of
                        Embassy</hi></closer>



                <xi:include href="d240-a1.xml" xpointer="d240-a1"/>
                <xi:include href="d240-a2.xml" xpointer="d240-a2"/>
            </div>
