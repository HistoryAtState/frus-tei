                <pb facs="0813" n="699" sameAs="frus:frus1922v02/pg699"/>

                <note rend="inline" type="source">812.6363/1228</note>
                <head><hi rendition="#italic">The Chief of the Division of Mexican Affairs,
                        Department of State</hi> (<hi rendition="#italic">Hanna</hi>) <hi
                        rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1922-07-11"><hi rendition="#italic">July 11,
                        1922</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. Secretary</hi>: Mr. Branch appeared to be
                    satisfied with his Conference with you this morning, and intimated that he
                    thought the Committee would give Mr. de la Huerta a negative answer to his
                    request for a loan.</p>
                <closer><signed>M[<hi rendition="#small-caps">atthew</hi>] E. H[<hi
                            rendition="#small-caps">anna</hi>]</signed></closer>
            </div>
        </body>
