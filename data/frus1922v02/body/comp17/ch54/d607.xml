    <text>
        <body>
            <div xml:id="d607">

                <pb facs="0819" n="705" sameAs="frus:frus1922v02/pg705"/>

                <note rend="inline" type="source">812.6363/1290</note>
                <head><hi rendition="#italic">The First Secretary of the Mexican Embassy</hi> (<hi
                        rendition="#italic">Téllez</hi>) <hi rendition="#italic">to the Chief of the
                        Division of Mexican Affairs, Department of State</hi> (<hi
                        rendition="#italic">Hanna</hi>)</head>
                <opener><seg rendition="#center">[Translation<anchor n="54" xml:id="d607-f1"
                        />]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1922-11-22"><hi rendition="#italic">November 22,
                        1922</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Hanna</hi>: In compliance with
                    instructions just sent me by the Foreign Office, I have the pleasure of
                    enclosing herewith to you a copy of the declarations made yesterday by that
                    Office in connection with the statements given to the press by the Department of
                    State Saturday last.</p>
                <p>In this connection, I take [etc]</p>
                <closer><signed><hi rendition="#small-caps">Manuel C. Téllez</hi></signed></closer>



                <xi:include href="d607-a1.xml" xpointer="d607-a1"/>
            </div>
        </body>
    </text>
