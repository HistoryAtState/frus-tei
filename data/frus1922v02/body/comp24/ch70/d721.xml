                <pb facs="0948" n="834" sameAs="frus:frus1922v02/pg834"/>

                <note rend="inline" type="source">861.50 Am 3/17: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        Germany</hi> (<hi rendition="#italic">Houghton</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1922-09-18T17:00:00-04:00"><hi rendition="#italic">September 18,
                                1922—5 p.m.</hi></date></dateline></opener>
                <p>122. Your 187, September 16, 4 p.m. A public announcement is being made that in
                    view of Soviet refusal matter is now considered to be terminated.</p>
                <closer><signed><hi rendition="#small-caps">Phillips</hi></signed></closer>
            </div>
        </body>
