                <pb facs="0949" n="835" xml:id="pg835"/>

                <note rend="inline" type="source">861.50 Am 3/29: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Special Mission at
                        Lausanne</hi></head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1922-12-12T19:00:00-05:00"><hi rendition="#italic">December 12,
                                1922—7 p.m.</hi></date></dateline></opener>
                <p>43. Mission’s 87, December 11, 2 p.m. Belief that you should carefully avoid this
                    question at Lausanne has our approval.</p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
