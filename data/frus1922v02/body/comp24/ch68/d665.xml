    <text>
        <body>
            <div xml:id="d665">

                <pb facs="0886" n="772" xml:id="pg772"/>

                <note rend="inline" type="source">861.6363/52a: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Ambassador in Italy</hi>
                        (<hi rendition="#italic">Child</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1922-05-02T16:00:00-04:00"><hi rendition="#italic">May 2, 1922—4
                                p.m.</hi></date></dateline></opener>
                <p>Your 11, April 24, 2 P.M. <hi rendition="#italic">New York Times</hi> despatch
                    from Genoa dated May 1 states that Royal Dutch Shell has concluded arrangements
                    with Soviet delegation for extensive concessions in Russia. Investigate
                    discreetly and report.</p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
