                <pb facs="0975" n="861" sameAs="frus:frus1922v02/pg861"/>

                <note rend="inline" type="source">861a.01/444</note>
                <head><hi rendition="#italic">The Ambassador in Japan</hi> (<hi rendition="#italic">Warren</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Tokyo</hi></placeName>, <date calendar="gregorian"
                            when="1922-10-04"><hi rendition="#italic">October 4,
                        1922</hi></date>.<lb/>[Received November 1.]</dateline>
                    <seg rendition="#float-left">No. 373</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith a
                    translation of an announcement issued by the War Office on September 29th,
                    relative to the withdrawal of Japanese troops from the Siberian mainland
                    opposite Sakhalin.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Charles B. Warren</hi></signed></closer>


                <xi:include href="d754-a1.xml" xpointer="d754-a1"/>
