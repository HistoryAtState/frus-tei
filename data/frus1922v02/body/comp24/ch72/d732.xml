                <pb facs="0958" n="844" sameAs="frus:frus1922v02/pg844"/>

                <note rend="inline" type="source">861a.01/202</note>
                <head><hi rendition="#italic">The Chairman of the Special Trade Delegation of the
                        Far Eastern Republic to the United States</hi> (<hi
                            rendition="#italic">Yazikoff</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1922-03-01"><hi rendition="#italic">March 1,
                        1922</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I am enclosing herewith a copy of a Note
                    sent by Mr. Janson, the Minister of Foreign Affairs of the Far Eastern Republic
                    to the Minister of Foreign Affairs of the Japanese Imperial Government on
                    February 10th, 1922.</p>
                <p>I beg [etc.]</p>
                <closer><signed><hi rendition="#small-caps">A. Yazikoff</hi></signed></closer>


                <xi:include href="d732-a1.xml" xpointer="d732-a1"/>
            </div>
