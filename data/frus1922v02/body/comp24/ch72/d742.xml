                <pb facs="0966" n="852" sameAs="frus:frus1922v02/pg852"/>

                <note rend="inline" type="source">861a.01/287</note>
                <head><hi rendition="#italic">The Ambassador in Japan</hi> (<hi rendition="#italic"
                        >Warren</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Tokyo</hi></placeName>, <date calendar="gregorian"
                            when="1922-06-07"><hi rendition="#italic">June 7,
                        1922</hi></date>.<lb/>[Received June 27.]</dateline>
                    <seg rendition="#float-left">No. 237</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith a
                    paraphrase of telegram No. 24 from Mr. Thomas dated May 27, 2 p.m., 1922.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Charles B. Warren</hi></signed></closer>



