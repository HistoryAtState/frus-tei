    <text>
        <body>
            <div xml:id="d364">

                <pb facs="0559" n="445" xml:id="pg445"/>

                <note rend="inline" type="source">868.48/291</note>
                <head><hi rendition="#italic">The Acting High Commissioner at Constantinople</hi>
                        (<hi rendition="#italic">Dolbeare</hi>) <hi rendition="#italic">to the
                        Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1922-11-25"><hi rendition="#italic">November 25,
                        1922</hi></date>.<lb/>[Received January 4, 1923.]</dateline>
                    <seg rendition="#float-left">No. 577</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to enclose for the
                    information of the Department copy of a report from the Senior Naval Officer at
                    Smyrna, dated October 20, 1922, giving a summary of the evacuation of refugees
                    from that city, and the agencies by which it was accomplished. Although it is a
                    “supplementary report” this includes all previous reports and is a final
                    statement.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Frederic R.
                    Dolbeare</hi></signed></closer>


                <xi:include href="d364-a1.xml" xpointer="d364-a1"/>
            </div>
