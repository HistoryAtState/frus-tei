    <text>
        <body>
            <div xml:id="d101">

                <pb facs="0220" n="106" sameAs="frus:frus1922v02/pg106"/>

                <note rend="inline" type="source">883.05/242</note>
                <head><hi rendition="#italic">The Agent and Consul General at Cairo</hi> (<hi
                        rendition="#italic">Howell</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener><seg rendition="#center">[Extract]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Cairo</hi></placeName>, <date calendar="gregorian"
                            when="1922-06-16"><hi rendition="#italic">June 16,
                        1922</hi></date>.<lb/>[Received July 7.]</dateline>
                    <seg rendition="#float-left">No. 97</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honour to herewith transmit to
                    the Department copy of a communication just received, dated June 14, 1922, from
                    the Ministry for Foreign Affairs, respecting the interpretation by the
                    Department of the reservation formulated by it, in reference to the acceptance
                    of the prorogation of the powers of the Mixed Jurisdictions for an undetermined
                    period in Egypt.</p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">J. Morton Howell</hi></signed></closer>



                <xi:include href="d101-a1.xml" xpointer="d101-a1"/>
            </div>
        </body>
    </text>
