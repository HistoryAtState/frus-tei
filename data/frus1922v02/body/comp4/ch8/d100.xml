                <pb facs="0220" n="106" sameAs="frus:frus1922v02/pg106"/>

                <note rend="inline" type="source">123 H 836/13a: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Agent and Consul General
                        at Cairo</hi> (<hi rendition="#italic">Howell</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1922-06-23T18:00:00-04:00"><hi rendition="#italic">June 23, 1922—6
                                p.m.</hi></date></dateline></opener>
                <p>20. Your nomination as Envoy Extraordinary and Minister Plenipotentiary to Egypt
                    confirmed. Take oath immediately. Inform Department date executed. Letter of
                    credence follows by mail.</p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
