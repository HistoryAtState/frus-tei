    <text>
        <body>
            <div xml:id="d16">

                <pb facs="0139" n="25" sameAs="frus:frus1922v02/pg25"/>

                <note rend="inline" type="source">839.00/2531: Telegram</note>
                <head><hi rendition="#italic">The Minister in the Dominican Republic</hi> (<hi
                        rendition="#italic">Russell</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Santo Domingo</hi></placeName>, <date calendar="gregorian"
                            when="1922-06-08T17:00:00-04:40"><hi rendition="#italic">June 8, 1922—5
                                p.m.</hi></date><lb/>[Received June 12—2:25
                    p.m.]</dateline></opener>
                <p>23. General Horacio Vasquez<anchor n="22" xml:id="d16-f1"/> and Federico
                    Velasquez left here yesterday for Washington via Porto Rico and will arrive at
                    New York about June 13th. …</p>
                <closer><signed><hi rendition="#small-caps">Russell</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d16-f1" n="22" xml:id="d16-f1-content">
                <p>Horacio Vasquez replaced Jacinto de Castro as representative of the Nacional
                    party.</p>
            </note>
        </listAnnotation>
    </standOff>
