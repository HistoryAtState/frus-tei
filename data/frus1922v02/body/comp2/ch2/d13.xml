                <pb facs="0133" n="19" sameAs="frus:frus1922v02/pg19"/>

                <note rend="inline" type="source">839.00/2525</note>
                <head><hi rendition="#italic">The Assistant Secretary of the Navy</hi> (<hi rendition="#italic">Roosevelt</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1922-05-24"><hi rendition="#italic">May 24,
                        1922</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I am enclosing you a copy
                    of the proposed letter of instruction to the Military Governor of the Dominican
                    Republic. …</p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>Believe me [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Theodore
                    Roosevelt</hi></signed></closer>



