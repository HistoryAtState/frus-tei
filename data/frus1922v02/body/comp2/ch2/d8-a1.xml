                        <cell role="num">500,000</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell/>
                        <cell cols="2">(Due Ayuntamientos)</cell>
                        <cell/>
                        <cell/>
                    </row>
                    <row>
