                        <cell/>
                    </row>
                    <row>
                        <cell rendition="#border-right">1921</cell>
                        <cell rendition="#border-right" role="num">2,500,000</cell>
                        <cell rendition="#border-right #border-bottom" role="num">2,242,000</cell>
                        <cell rendition="#border-right #border-bottom" role="num">814,000</cell>
                        <cell>July 1, 1925</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right #border-bottom"/>
                        <cell rendition="#border-right #border-bottom"/>
                        <cell rendition="#border-right #border-bottom" role="num">$11,403,000</cell>
                        <cell rendition="#border-right #border-bottom" role="num">$2,303,000</cell>
                        <cell rendition="#border-bottom"/>
                    </row>
                </table>
                <table cols="6" rows="5">
                    <row role="label">
                        <cell>6.</cell>
                        <cell cols="5">Other obligations.</cell>
                    </row>
                    <row>
