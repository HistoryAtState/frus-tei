                            <cell role="num">$1,774,000</cell>
                        </row>
                        <row>
                            <cell rendition="#middle" rows="2">1924</cell>
                            <cell role="brace" rows="2">{</cell>
                            <cell cols="3">1908 Loan, Interest and amortization</cell>
                            <cell role="num">1,200,000</cell>
                        </row>
                        <row>
                            <cell cols="3">New Loan, interest</cell>
                            <cell rendition="#border-bottom" role="num">667,750</cell>
                        </row>
                        <row>
