                        <cell rendition="#border-bottom #border-top">Date
                            complete<lb/>Amortization</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">1908</cell>
                        <cell rendition="#border-right" role="num">$20,000,000</cell>
                        <cell rendition="#border-right" role="num">$7,534,000</cell>
                        <cell rendition="#border-right" role="num">$1,200,000</cell>
