                            <cell/>
                            <cell cols="3">Total</cell>
                            <cell role="num">$1,867,750</cell>
                        </row>
                        <row>
                            <cell>1925</cell>
                            <cell role="brace" rows="5">}</cell>
                            <cell rendition="#middle" rows="5">Each</cell>
                            <cell role="brace" rows="5">{</cell>
