    <text>
        <body>
            <div xml:id="d15">

                <pb facs="0136" n="22" xml:id="pg22"/>

                <note rend="inline" type="source">839.00/2533</note>
                <head><hi rendition="#italic">The Minister in the Dominican Republic</hi> (<hi rendition="#italic">Russell</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Santo Domingo</hi></placeName>, <date calendar="gregorian"
                            when="1922-06-07"><hi rendition="#italic">June 7,
                        1922</hi></date>.<lb/>[Received June 22.]</dateline>
                    <seg rendition="#float-left">No. 768</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to refer generally to the
                    subject of political conditions in the Dominican Republic and in particular to
                    my telegrams No. 19 of April 24 [<hi rendition="#italic">25</hi>], 5 p.m., and
                    No. 22 of May 26, 5 p.m., 1922,<anchor n="18" xml:id="d15-f1"/> relative to the
                    contemplated visit of Mr. Federico Velasquez<anchor n="19" xml:id="d15-f2"/> and
                    Mr. Jacinto de Castro<anchor n="20" xml:id="d15-f3"/> to Washington to discuss
                    disoccupation, and in that connection to transmit herewith, for the information
                    of the Department, a copy of notes on a conference held June 3rd between the
                    above named political leaders and the Military Governor and myself.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">William W.
                    Russell</hi></signed></closer>


                <xi:include href="d15-a1.xml" xpointer="d15-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d15-f1" n="18" xml:id="d15-f1-content">
                <p>Neither printed.</p>
            </note>
            <note corresp="#d15-f2" n="19" xml:id="d15-f2-content">
                <p>Leader of the Progresista (or Velasquista) party.</p>
            </note>
            <note corresp="#d15-f3" n="20" xml:id="d15-f3-content">
                <p>A leader of the Nacional (formerly Horacista) party.</p>
            </note>
        </listAnnotation>
    </standOff>
