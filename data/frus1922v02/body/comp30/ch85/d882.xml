    <text>
        <body>
            <div xml:id="d882">

                <pb facs="1107" n="993" sameAs="frus:frus1922v02/pg993"/>

                <note rend="inline" type="source">211.31/9: Telegram</note>
                <head><hi rendition="#italic">The Minister in Venezuela</hi> (<hi
                        rendition="#italic">McGoodwin</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Caracas</hi></placeName>, <date calendar="gregorian"
                            when="1921-09-24T12:00:00-04:30"><hi rendition="#italic">September 24,
                                1921—noon</hi></date>.<lb/>[Received September 28—4:20
                        a.m.]</dateline></opener>
                <p>21. Department’s telegram June 25, 4 p.m.<anchor n="7" xml:id="d882-f1"/></p>
                <p>Draft of treaty with Honduras finally accepted adding to paragraph inserted
                    Department’s instruction number 550 imprisonment [for life<anchor n="8"
                        xml:id="d882-f2"/>], prohibited by constitution. Please answer by
                    telegraph.</p>
                <closer><signed><hi rendition="#small-caps">McGoodwin</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d882-f1" n="7" xml:id="d882-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d882-f2" n="8" xml:id="d882-f2-content">
                <p>The words “for life” supplied from the Minister’s despatch no. 2517 of the same
                    date (file no. 211.31/10).</p>
            </note>
        </listAnnotation>
