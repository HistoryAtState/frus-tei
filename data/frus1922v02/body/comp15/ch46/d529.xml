                <pb facs="0713" n="599" sameAs="frus:frus1922v02/pg599"/>

                <note rend="inline" type="source">862i.01/185</note>
                <head><hi rendition="#italic">The Japanese Ambassador</hi> (<hi rendition="#italic">Shidehara</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1922-02-11"><hi rendition="#italic">February 11,
                        1922</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In proceeding this day to the signature of
                    the Convention between Japan and the United States with respect to the islands,
                    under Japan’s Mandate, situated in the Pacific Ocean and lying north of the
                    Equator, I have the honor to assure you, under authorization of my Government,
                    that the usual comity will be extended to nationals and vessels of the United
                    States in visiting the harbors and waters of those islands.</p>
                <p>Accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps">K. Shidehara.</hi></signed></closer>
            </div>
