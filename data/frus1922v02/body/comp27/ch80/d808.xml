    <text>
        <body>
            <div xml:id="d808">

                <pb facs="1029" n="915" sameAs="frus:frus1922v02/pg915"/>

                <note rend="inline" type="source">703.5200/6</note>
                <head><hi rendition="#italic">The Spanish Ambassador</hi> (<hi
                            rendition="#italic">Riaño</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><seg rendition="#center">[Translation<anchor n="2" xml:id="d808-f1"
                    />]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1922-06-15"><hi rendition="#italic">June 15,
                        1922</hi></date>.</dateline>
                    <seg rendition="#float-left">37–03</seg></opener>
                <p><hi rendition="#small-caps">Mr. Secretary</hi>: I have the honor to forward to
                    Your Excellency, together with the usual office copy and with a request that you
                    kindly cause it to reach its high destination, the letter which His Majesty the
                    King, my August Sovereign, sends to the President of the Republic of the United
                    States in reply to that expressing the gratefulness of the North American people
                    and Government for the mission assumed by Spain during the late war.</p>
                <p>I avail myself [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Juan Riaño</hi></signed></closer>



                <xi:include href="d808-a1.xml" xpointer="d808-a1"/>
            </div>
        </body>
    </text>
