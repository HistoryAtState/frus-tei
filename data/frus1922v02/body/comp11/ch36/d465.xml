            <div xml:id="d465">

                <pb facs="0659" n="545" sameAs="frus:frus1922v02/pg545"/>

                <note rend="inline" type="source">438.00/185</note>
                <head><hi rendition="#italic">The High Commissioner in Haiti</hi> (<hi rendition="#italic">Russell</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Port au Prince</hi></placeName>, <date calendar="gregorian"
                            when="1922-11-09"><hi rendition="#italic">November 9,
                        1922</hi></date>.<lb/>[Received November 25.]</dateline>
                    <seg rendition="#float-left">No. 80</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith a
                    copy of the <hi rendition="#italic">Moniteur</hi> containing the law on the
                    organization of the Claims Commission, and I also attach a translation
                    thereof.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">John H. Russell</hi></signed></closer>


                <xi:include href="d465-a1.xml" xpointer="d465-a1"/>
