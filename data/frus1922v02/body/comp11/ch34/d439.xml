                <pb facs="0630" n="516" sameAs="frus:frus1922v02/pg516"/>

                <note rend="inline" type="source">838.51/1415: Telegram</note>
                <head><hi rendition="#italic">The High Commissioner in Haiti</hi> (<hi rendition="#italic">Russell</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Port au Prince</hi></placeName>, <date calendar="gregorian"
                            when="1922-10-28T09:00:00-05:00"><hi rendition="#italic">October 28,
                                1922—9 a.m.</hi></date><lb/>[Received 8:50 p.m.]</dateline></opener>
                <p>131. Officially informed by the Haitian Government that the Council of State
                    yesterday, October 27th, sanctioned without modification the loan protocol.</p>
                <closer><signed><hi rendition="#small-caps">Russell</hi></signed></closer>
            </div>
        </body>
