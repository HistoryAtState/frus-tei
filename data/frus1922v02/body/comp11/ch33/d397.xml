                <pb facs="0586" n="472" sameAs="frus:frus1922v02/pg472"/>

                <note rend="inline" type="source">838.51/1443</note>
                <head><hi rendition="#italic">The High Commissioner in Haiti</hi> (<hi rendition="#italic">Russell</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Port au Prince</hi></placeName>, <date calendar="gregorian"
                            when="1922-11-09"><hi rendition="#italic">November 9,
                        1922</hi></date>.<lb/>[Received November 25.]</dateline>
                    <seg rendition="#float-left">No. 81</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to report that the
                    Financial Adviser, Mr. John S. Hord, has received his appointment from the
                    Haitian Government and has assumed his duties as Financial Adviser to the
                    Republic of Haiti.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">John H. Russell</hi></signed></closer>
            </div>
        </body>
