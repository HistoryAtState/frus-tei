                <pb facs="1097" n="983" sameAs="frus:frus1922v02/pg983"/>

                <note rend="inline" type="source">867.602 Ot 81/229: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Acting High Commissioner
                        at Constantinople</hi> (<hi rendition="#italic">Dolbeare</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1922-12-09T18:00:00-05:00"><hi rendition="#italic">December 9,
                                1922—6 p.m.</hi></date></dateline></opener>
                <p>285. See Department’s 282, December 7, 7 p.m. Following sent at request of
                    General Goethals: <quote rend="blockquote">
                        <p>“For Kennedy. All interests at this end now working harmoniously. Trust
                            that you and Chester will cooperate closely in all matters. Advise if
                            any assistance can be rendered here. Signed Goethals”</p>
                    </quote></p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
