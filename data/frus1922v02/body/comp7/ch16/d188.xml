    <text>
        <body>
            <div xml:id="d188">

                <pb facs="0343" n="229" sameAs="frus:frus1922v02/pg229"/>

                <note rend="inline" type="source">462.00 R 294/81</note>
                <head><hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic"
                        >Herrick</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1922-05-19"><hi rendition="#italic">May 19,
                        1922</hi></date>.<lb/>[Received May 31.]</dateline>
                    <seg rendition="#float-left">No. 1906</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Reverting to my despatch No. 1652 of March
                    29, 1922,<anchor n="64" xml:id="d188-f1"/> I have the honor to transmit herewith
                    copy and translation of a Note dated May 18th from the Ministry for Foreign
                    Affairs concerning the costs of the American troops of occupation on the
                    Rhine.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Myron T. Herrick</hi></signed></closer>


                <xi:include href="d188-a1.xml" xpointer="d188-a1"/>
            </div>
        </body>
    </text>
