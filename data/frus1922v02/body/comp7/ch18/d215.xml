    <text>
        <body>
            <div xml:id="d215">

                <pb facs="0376" n="262" sameAs="frus:frus1922v02/pg262"/>

                <note rend="inline" type="source">462.11 W 892/55</note>
                <head><hi rendition="#italic">Memorandum by President Harding for the Secretary of
                        State</hi><anchor n="5" xml:id="d215-f1"/></head>
                <dateline>
                    <date ana="#date_undated-inferred-from-document-content" calendar="gregorian"
                        when="1922-08-10">undated</date>
                </dateline>
                <p><hi rendition="#small-caps">Dear Mr. Sec</hi>[<hi rendition="#small-caps"
                        >retar</hi>]<hi rendition="#small-caps">y</hi>: In making the announcement,
                    please <hi rendition="#italic">emphasize</hi> the request to us to name umpire.
                    It is so unusual that its significance is worth bringing well to the fore.</p>
                <closer><signed>W[<hi rendition="#small-caps">arren</hi>] G. H[<hi
                            rendition="#small-caps">arding</hi>]</signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d215-f1" n="5" type="source" xml:id="d215-f1-content">
                <p>This undated memorandum, in longhand, was received by the Secretary on Aug.
                    10.</p>
            </note>
        </listAnnotation>
    </standOff>
