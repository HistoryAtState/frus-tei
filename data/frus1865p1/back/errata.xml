            <div xml:id="errata">

                <pb facs="0712" n="672" sameAs="frus:frus1865p1/pg672"/>

                <head>Errata</head>
                <p>The following change has been made to <ref target="frus:frus1865p1">
                        <hi rendition="#italic">Papers Relating to Foreign Affairs, Accompanying the
                            Annual Message of the President to the First Session Thirty-ninth
                            Congress</hi></ref>. Please be aware that printed volumes have not been
                    revised. <!--Revised information is in italic.-->
                </p>
                <list type="simple">
                    <item>
                        <hi rendition="#bold">1. <ref target="#d373">Mr. Seward to Mr. Adams</ref>,
                                <ref target="#pg656">Page 656</ref> (date of correction: March 14,
                            2019)</hi>
                    </item>
                    <item>The dateline for this document has been corrected from “1855” to
                        “1865.”</item>
                    <item>
                        <hi rendition="#bold">2. <ref target="#d373a">Mr. Seward to Mr. Adams</ref>,
                                <ref target="#pg656">Page 659</ref> (date of correction: March 14,
                            2019)</hi>
                    </item>
                    <item>This document has been reclassified from an attachment to the previous
                        document to a newly inserted document.</item>
                </list>
            </div>
        </body>
    </text>
