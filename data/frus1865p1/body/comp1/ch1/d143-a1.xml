    <text>
        <body>
            <div xml:id="d143-a1">

                <pb facs="0336" n="296" sameAs="frus:frus1865p1/pg296"/>

                <head>Mr. Stanton to Mr.
                        Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">War Department,</hi>
                            <hi rendition="#italic">Washington City,</hi></placeName>
                        <date calendar="gregorian" when="1865-03-27"><hi rendition="#italic"
                                >March</hi> 27, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> The communication of Earl Russell, herewith
                    enclosed, was, at your request, transmitted by this department to Lieutenant
                    General Grant, to be forwarded to General Lee. I have now the honor of returning
                    it to you, with the accompanying letters of Lieutenant General Grant and General
                    Lee, received by this department this morning.</p>
                <p>Your obedient servant,</p>
                <closer>
                    <signed>EDWIN M. STANTON, <hi rendition="#italic">Secretary of
                        War.</hi></signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State.</hi></p>
                </postscript>
            </div>
        </body>
