    <text>
        <body>
            <div xml:id="d319">

                <pb facs="0495" n="455" sameAs="frus:frus1865p1/pg455"/>

                <head>Mr. Seward to Mr.
                        Adams</head>
                <opener>
                    <seg rendition="#float-left">No. 1526.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-08-26"><hi rendition="#italic"
                                >August</hi> 26, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your despatch No. 1025, of the 3d of
                    August, together with a full report of the proceedings in the court of chancery
                    in the case of the cotton claimed by <pb facs="0496" n="456" xml:id="pg456"/>
                    the United States, has been received, and your action in regard to the matter is
                    approved by this department.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
