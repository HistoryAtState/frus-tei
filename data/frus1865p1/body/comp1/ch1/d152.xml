    <text>
        <body>
            <div xml:id="d152">

                <pb facs="0341" n="301" sameAs="frus:frus1865p1/pg301"/>

                <head>Mr. Seward to Mr.
                        Adams</head>
                <opener>
                    <seg rendition="#float-left">No. 1332.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-04-04"><hi rendition="#italic"
                                >April</hi> 4, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your despatch of the 16th ultimo, No. 897,
                    together with its accompanying copies of the correspondence between Earl Russell
                    and yourself upon the <pb facs="0342" n="302" xml:id="pg302"/> subject of the
                    sale of the Alexandra, <hi rendition="#italic">alias</hi> the Mary, at Nassau,
                    has been received, and is approved.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
