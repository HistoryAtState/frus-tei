    <text>
        <body>
            <div xml:id="d32">

                <pb facs="0105" n="65" sameAs="frus:frus1865p1/pg65"/>

                <head>Mr. Seward to Mr. Adams</head>
                <opener>
                    <seg rendition="#float-left">No. 1199.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-12-21"><hi rendition="#italic"
                                >December</hi> 21, 1864</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I enclose for your information a copy of a
                    despatch of the 12th ultimo, No. 208, from Charles A. Leas, esq., the United
                    States commercial agent at Belize, in regard to a recent proclamation of Prince
                    Maximilian affecting the British settlement in the Honduras, and relating also
                    to other features of political affairs in that quarter and the West Indies.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWABD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
                <postscript>
                    <p>(Same, <hi rendition="#italic">mutatis mutandis,</hi> to Mr. Bigelow.)</p>
                </postscript>


                <xi:include href="d32-a1.xml" xpointer="d32-a1"/>
            </div>
