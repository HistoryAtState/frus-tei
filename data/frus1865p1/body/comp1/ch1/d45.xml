    <text>
        <body>
            <div xml:id="d45">

                <pb facs="0114" n="74" sameAs="frus:frus1865p1/pg74"/>

                <head>Mr. Seward to Mr. Adams</head>
                <opener>
                    <seg rendition="#float-left">No. 1221.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-01-01"><hi rendition="#italic"
                                >January</hi> 1, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your despatch of the 16th ultimo, No. 832,
                    informing me that you had transmitted to Lord Russell the information contained
                    in General Dix’s letter, respecting the rebel organization at Marysburgh, Prince
                    Edward’s county, in Canada, has been received and approved.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
