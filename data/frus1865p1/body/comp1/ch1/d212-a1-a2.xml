    <text>
        <body>
            <div xml:id="d212-a1-a2">

                <pb facs="0388" n="348" sameAs="frus:frus1865p1/pg348"/>

                <head>Earl Russell to Mr. Adams</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Foreign Office,</hi></placeName>
                        <date calendar="gregorian" when="1865-04-05"><hi rendition="#italic"
                                >April</hi> 5, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sri</hi>: I have the honor to acknowledge the receipt
                    of your letter of yesterday’s date, respecting certain fuzes found in Fort
                    Fisher, which it is alleged were supplied from Wolwich arsenal, and I have to
                    inform you that I have requested the secretary of state for war to cause an
                    immediate investigation to be made into the circumstances of the case.</p>
                <p>I have the honor to be, with the highest consideration, sir, your most obedient,
                    humble servant,</p>
                <closer>
                    <signed>RUSSELL.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
