    <text>
        <body>
            <div xml:id="d286-a1-a10">

                <pb facs="0463" n="423" sameAs="frus:frus1865p1/pg423"/>

                <opener><seg rendition="#center">[Enclosure No. 10.]</seg></opener>
                <head>Mr. Wilding to Mr.
                        Adams.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">United States Consulate,</hi>
                            <hi rendition="#italic">Liverpool,</hi></placeName>
                        <date calendar="gregorian" when="1865-07-18"><hi rendition="#italic">
                                July</hi> 18, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I annex copy of a letter just received from
                    Messrs. Harvey &amp; Co., relating to the cotton by the Aline.</p>
                <p>In the cases of the Rappahannock and the Tallahassee, I am informed that warrants
                    were issued this morning.</p>
                <p>Very respectfully, I am, sir, your obedient servant,</p>
                <closer>
                    <signed>H. WILDING, <hi rendition="#italic">Vice Consul.</hi></signed></closer>
                <postscript>
                    <p>His Excellency <hi rendition="#small-caps">Charles Francis Adams,</hi>
                        <hi rendition="#italic">&amp;c., &amp;c., &amp;c., London.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
