    <text>
        <body>
            <div xml:id="d278">

                <pb facs="0454" n="414" xml:id="pg414"/>

                <head>Mr. Seward to Mr.
                        Adams</head>
                <opener>
                    <seg rendition="#float-left">No. 1473.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-07-03"><hi rendition="#italic">
                                July</hi> 3, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I enclose for your information a copy of a
                    letter of the 22<hi rendition="#italic">d</hi> ultimo addressed by the Secretary
                    of the Navy to Rear-Admiral Goldsborough upon the subject of the withdrawal from
                    the insurgents of the character of belligerents, and the proceedings of the Navy
                    Department in view thereof.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d278-a1.xml" xpointer="d278-a1"/>
            </div>
