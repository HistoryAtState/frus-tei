    <text>
        <body>
            <div xml:id="d137">

                <pb facs="0301" n="261" sameAs="frus:frus1865p1/pg261"/>

                <head>Mr. Adams to Mr.
                        Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 905.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">London,</hi></placeName>
                        <date calendar="gregorian" when="1865-03-23"><hi rendition="#italic"
                                >March</hi> 23, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to transmit an address to
                    the President from the Union and Emancipation Society of Glasgow, on the passage
                    of the constitutional amendment through both houses of Congress.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>CHARLES FRANCIS ADAMS.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>


                <xi:include href="d137-a1.xml" xpointer="d137-a1"/>
            </div>
