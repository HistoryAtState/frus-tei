    <text>
        <body>
            <div xml:id="d239">

                <pb facs="0424" n="384" sameAs="frus:frus1865p1/pg384"/>

                <head>Mr. Adams to Mr.
                        Hunter</head>
                <opener>
                    <seg rendition="#float-left">No. 966.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">London,</hi></placeName>
                        <date calendar="gregorian" when="1865-05-25"><hi rendition="#italic"
                                >May</hi> 25, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to transmit a copy of a
                    note from Lord Russell to me of the 27th of April, relative to the steamer
                    formerly known as the Tallahassee, in Wilmington, and later as the Chameleon, at
                    Bermuda and at Liverpool.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>CHAULES FRANCIS ADAMS.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">William Hunter,</hi> Esq., <hi
                            rendition="#italic">Acting Secretary of State, Washington, D.
                        C.</hi></p>
                </postscript>


                <xi:include href="d239-a1.xml" xpointer="d239-a1"/>
            </div>
