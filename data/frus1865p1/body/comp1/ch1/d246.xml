    <text>
        <body>
            <div xml:id="d246">

                <pb facs="0427" n="387" sameAs="frus:frus1865p1/pg387"/>

                <head>Mr. Hunter to Mr. Adams</head>
                <opener>
                    <seg rendition="#float-left">No. 1428.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-05-29"><hi rendition="#italic"
                                >May</hi> 29, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your despatch of the 11th instant, No. 950,
                    and its accompanying copies of the correspondence which has taken place between
                    Lord Russell and yourself, relative to the transmission of the late President’s
                    letter to the Queen on the occasion of the recall of Lord Lyons, has been
                    received and is approved.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>W. HUNTER, <hi rendition="#italic">Acting
                    Secretary.</hi></signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
