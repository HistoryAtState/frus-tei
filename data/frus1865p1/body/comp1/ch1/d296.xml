    <text>
        <body>
            <div xml:id="d296">

                <pb facs="0482" n="442" sameAs="frus:frus1865p1/pg442"/>

                <head>Mr. Moran to Mr. Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps"> London,</hi></placeName>
                        <date calendar="gregorian" when="1865-07-28"><hi rendition="#italic"
                                >July</hi> 28, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Sir:</hi> Mr. Adams directs me to forward the
                    enclosed letter and bill in the case of the United States <hi
                        rendition="#italic">vs.</hi> Prioleau, and to say that, as the report of the
                    hearing has not been received by him, he will be obliged to postpone sending it
                    until next week.</p>
                <p>I am, my dear sir, with great respect, your very obedient servant,</p>
                <closer>
                    <signed>BENJAMIN MORAN.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d296-a1.xml" xpointer="d296-a1"/>
            </div>
