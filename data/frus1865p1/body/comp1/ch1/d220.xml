    <text>
        <body>
            <div xml:id="d220">

                <pb facs="0402" n="362" sameAs="frus:frus1865p1/pg362"/>

                <head>Mr. Hunter to Mr.
                        Adams</head>
                <opener>
                    <seg rendition="#float-left">No. 1403.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-05-15"><hi rendition="#italic"
                                >May</hi> 15, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have to acknowledge the receipt of your
                    despatch of the 28th ultimo, No. 938, transmitting a copy of a note from Earl
                    Russell which he addressed to you, giving the result of an investigation made at
                    Bermuda on the character of certain steamers which had arrived there.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>W. HUNTER, <hi rendition="#italic">Acting
                    Secretary.</hi></signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
