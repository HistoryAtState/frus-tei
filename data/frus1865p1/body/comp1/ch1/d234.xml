    <text>
        <body>
            <div xml:id="d234">

                <pb facs="0413" n="373" xml:id="pg373"/>

                <head>Mr. Hunter to Mr.
                        Adams</head>
                <opener>
                    <seg rendition="#float-left">No. 1419.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-05-22"><hi rendition="#italic"
                                >May</hi> 22, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I transmit herewith, for your information,
                    a copy of a note of this date addressed to Mr. Tassara, the Spanish minister,
                    relative to the proceedings of the piratical cruiser Stonewall.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>W. HUNTER, <hi rendition="#italic">Acting
                    Secretary.</hi></signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d234-a1.xml" xpointer="d234-a1"/>
