    <text>
        <body>
            <div xml:id="d143-a3">

                <pb facs="0336" n="296" sameAs="frus:frus1865p1/pg296"/>

                <head>General Grant to Mr. Stanton</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Headquarters Armies of the United
                                States,</hi>
                            <hi rendition="#italic">City Point, Va.,</hi></placeName>
                        <date calendar="gregorian" when="1865-03-25"><hi rendition="#italic"
                                >March</hi> 25, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to forward herewith a
                    communication of General R. E. Lee, “commanding armies Confederate States,” of
                    date 23d instant, with enclosures.</p>
                <p>Very respectfully your obedient servant,</p>
                <closer>
                    <signed>U. S. GRANT, <hi rendition="#italic">Lieutenant
                    General.</hi></signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">E. M. Stanton,</hi>
                        <hi rendition="#italic">Secretary of War, Washington City.</hi></p>
                </postscript>


                <xi:include href="d143-a3-a1.xml" xpointer="d143-a3-a1"/>
            </div>
        </body>
    </text>
