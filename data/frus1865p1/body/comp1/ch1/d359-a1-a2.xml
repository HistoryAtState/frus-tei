    <text>
        <body>
            <div xml:id="d359-a1-a2">

                <pb facs="0667" n="627" sameAs="frus:frus1865p1/pg627"/>

                <head>Earl Russell to Mr. Adams</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Foreign Office,</hi></placeName>
                        <date calendar="gregorian" when="1865-10-25"><hi rendition="#italic"
                                >October</hi> 25, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your letter of the 21st instant, and its enclosures, respecting the
                    Shenandoah; and I have to state to you that your representations shall be duly
                    considered by her Majesty’s government.</p>
                <p>I have the honor to be, with the highest consideration, sir, your most obedient,
                    humble servant,</p>
                <closer>
                    <signed>RUSSELL.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams</hi>, Esq., <hi
                            rendition="#italic">&amp;c.,&amp;c.,&amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
