    <text>
        <body>
            <div xml:id="d335">

                <pb facs="0591" n="551" sameAs="frus:frus1865p1/pg551"/>

                <head>Mr. Adams to Mr. Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 1047.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">London,</hi></placeName>
                        <date calendar="gregorian" when="1865-09-15"><hi rendition="#italic"
                                >September</hi> 15, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith, for
                    the President and Mrs. Lincoln, copies of resolutions on the late deplorable
                    event at Washington, passed by the annual assembly of the United Methodist Free
                    Churches at a meeting held at Nottingham, in that kingdom, in August last.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>CHARLES FRANCIS ADAMS.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>


                <xi:include href="d335-a1.xml" xpointer="d335-a1"/>
            </div>
