    <text>
        <body>
            <div xml:id="d338">

                <pb facs="0593" n="553" sameAs="frus:frus1865p1/pg553"/>

                <head>Mr. Adams to Mr.
                        Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 1051.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">london,</hi></placeName>
                        <date calendar="gregorian" when="1865-09-21"><hi rendition="#italic"
                                >September</hi> 21, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In connexion with my despatch No. 1036, of
                    the 7th of September, I now have the honor to transmit a copy of Lord Russell’s
                    note of the 10th, acknowledging mine of the 5th relative to the slave trade in
                    Cuba. I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>CHARLES FRANCIS ADAMS.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>


                <xi:include href="d338-a1.xml" xpointer="d338-a1"/>
            </div>
