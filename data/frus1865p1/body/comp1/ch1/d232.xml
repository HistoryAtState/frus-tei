    <text>
        <body>
            <div xml:id="d232">

                <pb facs="0412" n="372" sameAs="frus:frus1865p1/pg372"/>

                <head>Mr. Hunter to Mr. Adams</head>
                <opener>
                    <seg rendition="#float-left">No. 1417.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-05-22"><hi rendition="#italic"
                                >May</hi> 22, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your despatch of the 21st ultimo, No. 933,
                    expressive of your sympathy with the Secretary of State upon the occasion of the
                    accident which befel him on the 5th of last month, has been received.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>W. HUNTER, <hi rendition="#italic">Acting
                    Secretary.</hi></signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
