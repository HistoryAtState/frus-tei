    <text>
        <body>
            <div xml:id="d299">

                <pb facs="0486" n="446" xml:id="pg446"/>

                <head>Mr. Hunter to Mr. Adams</head>
                <opener>
                    <seg rendition="#float-left">No. 1498.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-07-31"><hi rendition="#italic"
                                >July</hi> 31, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your despatch of the 13th instant, No.
                    1010, and its accompaniments, containing expressions of sympathy with the
                    government and people of this country, has been received</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>W. HUNTEK, <hi rendition="#italic">Acting
                    Secretary.</hi></signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
