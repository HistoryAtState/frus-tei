    <text>
        <body>
            <div xml:id="d274">

                <pb facs="0452" n="412" sameAs="frus:frus1865p1/pg412"/>

                <head>Mr. Hunter to Mr. Adams</head>
                <opener>
                    <seg rendition="#float-left">No. 1467.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-06-27"><hi rendition="#italic"
                                >June</hi> 27, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I Have to acknowledge the receipt of your
                    despatch of the 8th of June, No. 983, transmitting a copy of the London Gazette
                    of the 6th instant, containing Earl Russell’s note to the lords commissioners of
                    the admiralty, announcing the withdrawal of the recognition by her Majesty’s
                    government of belligerent rights to the rebels.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>W. HUNTER, <hi rendition="#italic">Acting
                    Secretary.</hi></signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
