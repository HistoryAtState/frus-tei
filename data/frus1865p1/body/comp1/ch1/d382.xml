    <text>
        <body>
            <div xml:id="d382">

                <pb facs="0705" n="665" sameAs="frus:frus1865p1/pg665"/>

                <head>Mr. Seward to Mr.
                        Adams</head>
                <opener>
                    <seg rendition="#float-left">No. 1597.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-11-20"><hi rendition="#italic"
                                >November</hi> 20, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit herewith, for the information of
                    her Majesty’s government, a copy of a despatch of the 4th instant from our
                    vice-consul general at Havana, relative to an expedition of African negroes
                    recently landed on the coast of Cuba.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams</hi>, Esq., <hi
                            rendition="#italic">&amp;c.,&amp;c.,&amp;c.</hi></p>
                </postscript>



                <xi:include href="d382-a1.xml" xpointer="d382-a1"/>
            </div>
