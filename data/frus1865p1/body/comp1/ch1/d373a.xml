    <text>
        <body>
            <div xml:id="d373a">

                <pb facs="0699" n="659" sameAs="frus:frus1865p1/pg659"/>

                <head>Mr. Seward to Mr. Adams</head>
                <opener>[Enclosure]</opener>
                <opener>
                    <seg rendition="#float-left">No. 1586.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-11-15"><hi rendition="#italic"
                                >November</hi> 15, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit herewith a copy of a
                    communication, without date, which I have just received from Mr. Hibbard,
                    arbitrator of the mixed court at Sierra Leone, giving his views as to the most
                    effectual and beneficent manner of suppressing the African slave trade. I will
                    thank you to submit a copy thereof to the consideration of her Majesty’s
                    government.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams</hi>, Esq., <hi
                            rendition="#italic">&amp;c.,&amp;c.,&amp;c</hi>.</p>
                </postscript>


                <xi:include href="d373a-a1.xml" xpointer="d373a-a1"/>
            </div>
