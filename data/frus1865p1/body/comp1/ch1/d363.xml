    <text>
        <body>
            <div xml:id="d363">

                <pb facs="0668" n="628" sameAs="frus:frus1865p1/pg628"/>

                <head>Mr. Seward to Mr. Adams</head>
                <opener>
                    <seg rendition="#float-left">No. 1575.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-10-31"><hi rendition="#italic"
                                >October</hi> 31, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your despatch of the 5th instant, No. 1061,
                    accompanied by a copy of the correspondence which passed between yourself and
                    Earl Russell regarding a rumor of certain supposed visits of the United States
                    steamer Niagara to the Irish coast within a short time, has been received, and
                    your action in the premises is approved.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams</hi>, Esq., <hi
                            rendition="#italic">&amp;c.,&amp;c.,&amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
