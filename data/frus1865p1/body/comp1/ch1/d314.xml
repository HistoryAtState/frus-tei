    <text>
        <body>
            <div xml:id="d314">

                <pb facs="0494" n="454" sameAs="frus:frus1865p1/pg454"/>

                <head>Mr. Seward to Mr. Adams</head>
                <opener>
                    <seg rendition="#float-left">No. 1520.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-08-22"><hi rendition="#italic"
                                >August</hi> 22, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I enclose for your information a copy of a
                        correspondence<anchor n="†" xml:id="d314-f1"/> which has taken place between
                    her Majesty’s legation and this department upon the subject of the withdrawal of
                    the notice abrogating the agreement contained in the convention of 1817,
                    limiting the naval armament on the lakes.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d314-f1" n="†" xml:id="d314-f1-content">
                <p>For enclosure see correspondence with British legation, current series.</p>
            </note>
        </listAnnotation>
    </standOff>
