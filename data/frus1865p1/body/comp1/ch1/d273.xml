    <text>
        <body>
            <div xml:id="d273">

                <pb facs="0452" n="412" xml:id="pg412"/>

                <head> Mr. Hunter to Mr. Adams</head>
                <opener>
                    <seg rendition="#float-left">No. 1464.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi></placeName>
                        <date calendar="gregorian" when="1865-06-26"><hi rendition="#italic"
                                >June</hi> 26, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I transmit herewith for your information,
                    and that of the government to which you are accredited, two copies of the
                    President’s proclamation of the 23d instant relative to the blockade.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>W. HUNTER, <hi rendition="#italic">Acting
                    Secretary.</hi></signed></closer>


                <xi:include href="d273-a1.xml" xpointer="d273-a1"/>
            </div>
