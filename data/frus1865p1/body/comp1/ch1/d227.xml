    <text>
        <body>
            <div xml:id="d227">

                <pb facs="0410" n="370" sameAs="frus:frus1865p1/pg370"/>

                <head>Mr. Hunter to Mr.
                        Adams</head>
                <opener>
                    <seg rendition="#float-left">No. 1410.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-05-19"><hi rendition="#italic"
                                >May</hi> 19, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have to acknowledge the receipt of your
                    despatch of the 4th instant, No. 944, transmitting a number of addresses and
                    resolutions from various public meetings of the residents of Great Britain,
                    expressive of their sympathy for Mrs. Lincoln, the widow of the late President,
                    to whom they will be communicated.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>W. HUNTER, <hi rendition="#italic">Acting
                    Secretary.</hi></signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq.,<hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
