    <text>
        <body>
            <div xml:id="d206">

                <pb facs="0385" n="345" xml:id="pg345"/>

                <head>Mr. Hunter to Mr. Adams</head>
                <opener>
                    <seg rendition="#float-left">No. 1392.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-05-05"><hi rendition="#italic"
                                >May</hi> 5, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have to acknowledge the receipt of your
                    despatch of the 20th April, No. 932, transmitting a copy of a letter from the
                    United States consul at Teneriffe, concerning the arrival of the Stonewall at
                    that place on the 31st of March last, and her departure therefrom on the day
                    following.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>W. HUNTER, <hi rendition="#italic">Acting
                    Secretary.</hi></signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
