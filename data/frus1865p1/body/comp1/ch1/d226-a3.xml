                <pb facs="0410" n="370" sameAs="frus:frus1865p1/pg370"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName> “<hi rendition="#small-caps">Custom House,</hi>
                            <hi rendition="#italic">London,</hi></placeName>
                        <date calendar="gregorian" when="1865-05-13"><hi rendition="#italic"
                                >May</hi> 13, 1865</date>.</dateline></opener>
                <p>“The aforegoing copy of a letter from Mr. Hamilton, one of the secretaries to the
                    lords, of the treasury, dated 11th instant, together with copy of the letter
                    from the Foreign Office therein referred to, is transmitted to the collector at
                    for his government.</p>
                <p>“By order of the commissioners,</p>
                <closer>
                    <signed>“J.B. HALE.”</signed></closer>
            </div>
        </body>
