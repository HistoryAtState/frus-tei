    <text>
        <body>
            <div xml:id="d387">

                <pb facs="0708" n="668" xml:id="pg668"/>

                <head>Mr. Seward to Mr. Adams</head>
                <opener>
                    <seg rendition="#float-left">No. 1609.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-11-28"><hi rendition="#italic"
                                >November</hi> 28, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit for your information a copy of a
                    note which I yesterday<anchor n="*" xml:id="d387-f1"/> addressed to Sir
                    Frederick Bruce, concerning vessels owned by rebels.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams</hi>, Esq., <hi
                            rendition="#italic">&amp;c.,&amp;c.,&amp;c. London</hi></p>
                </postscript>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d387-f1" n="*" xml:id="d387-f1-content">
                <p>See correspondence with the British legation, current series.</p>
            </note>
