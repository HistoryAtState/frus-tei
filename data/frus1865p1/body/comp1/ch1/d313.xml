    <text>
        <body>
            <div xml:id="d313">

                <pb facs="0494" n="454" xml:id="pg454"/>

                <head>Mr. Seward to Mr.
                        Adams</head>
                <opener>
                    <seg rendition="#float-left">No. 1518.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-08-19"><hi rendition="#italic">
                                August</hi> 19, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I transmit herewith, for your information,
                    a copy of a note which, on the 15th instant,<anchor n="*" xml:id="d313-f1"/> I
                    addressed to Sir Frederick Bruce, in reply to one from him requesting, on behalf
                    of her Majesty’s government, to be informed of the views entertained by the
                    government of the United States regarding a proposal made by the charge
                    d’affaires of Hayti to the British government for concurrence in guaranteeing
                    the neutrality of the peninsula of Samana.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
