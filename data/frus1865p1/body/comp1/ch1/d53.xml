    <text>
        <body>
            <div xml:id="d53">

                <pb facs="0122" n="82" sameAs="frus:frus1865p1/pg82"/>

                <head>Mr. Seward to Mr. Adams</head>
                <opener>
                    <seg rendition="#float-left">No. 1229.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-01-10"><hi rendition="#italic"
                                >January</hi> 10, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> You will please make due and grateful
                    acknowledgments on the part of the President of the United States to his friends
                    in Merthyr Tydfil, in Wales, for their generous and humane letter of
                    congratulation upon the results of the late national election; and you will at
                    the same time assure them of the best wishes of the President for their
                    individual happiness and the peace and prosperity of the British nation.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>



                <xi:include href="d53-a1.xml" xpointer="d53-a1"/>
            </div>
