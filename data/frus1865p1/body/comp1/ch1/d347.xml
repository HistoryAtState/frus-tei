    <text>
        <body>
            <div xml:id="d347">

                <pb facs="0611" n="571" sameAs="frus:frus1865p1/pg571"/>

                <head>Mr. Seward to Mr.
                        Adams</head>
                <opener>
                    <seg rendition="#float-left">No. 1553.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-10-02"><hi rendition="#italic"
                                >October</hi> 2, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I acknowledge the receipt of your despatch
                    of the 14th ultimo, No. 1046, relative to your proceedings in regard to the
                    correspondence with Earl Russell upon the subject of the Alabama and other
                    similar claims. Those proceedings are approved. An instruction of the 27th
                    ultimo, No. 1551, will more fully explain the views of the department in the
                    premises.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams</hi>, Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
