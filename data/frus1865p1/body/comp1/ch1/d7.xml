    <text>
        <body>
            <div xml:id="d7">

                <pb facs="0051" n="11" sameAs="frus:frus1865p1/pg11"/>

                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <head>Mr. Adams to Mr.
                        Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 825.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">London,</hi></placeName>
                        <date calendar="gregorian" when="1864-12-01"><hi rendition="#italic"
                                >December</hi> 1, 1864</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Lord Russell has sent me still another note
                    in regard to the Deerhound. I forward copies of his note and of my answer.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>CHARLES FRANCIS ADAMS.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>
                        <hi rendition="#italic">Secretary of Slate, Washington, D. C.</hi></p>
                </postscript>


                <xi:include href="d7-a1.xml" xpointer="d7-a1"/>
            </div>
