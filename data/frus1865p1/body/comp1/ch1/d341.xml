    <text>
        <body>
            <div xml:id="d341">

                <pb facs="0603" n="563" sameAs="frus:frus1865p1/pg563"/>

                <head>Mr. Seward to Mr. Adams</head>
                <opener>
                    <seg rendition="#float-left">No. 1543.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-09-23"><hi rendition="#italic"
                                >September</hi> 23, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    despatch of the 7th instant, No. 1039, and the copy of correspondence respecting
                    the schooner St. Mary’s which accompanied it.</p>
                <p>Your note to Earl Russell is approved.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams</hi>, Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c., London.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
