    <text>
        <body>
            <div xml:id="d326-a1-a16">

                <pb facs="0510" n="470" sameAs="frus:frus1865p1/pg470"/>

                <head>[Enclosure No. 16.]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>83 <hi rendition="#small-caps">Collins Street
                            West,</hi></placeName>
                        <date calendar="gregorian" when="1865-02-04"><hi rendition="#italic"
                                >February</hi> 4, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Sir:</hi> The attorney general has written me,
                    stating that he will be happy to see you on Monday next, at 12 o’clock at the
                    Crown law offices</p>
                <p>Yours faithfully</p>
                <closer>
                    <signed>JOSEPH G. DUFFETT</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">William Blanchard</hi> Esq.</p>
                </postscript>
            </div>
        </body>
