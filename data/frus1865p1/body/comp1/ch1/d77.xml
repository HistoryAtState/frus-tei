    <text>
        <body>
            <div xml:id="d77">

                <pb facs="0171" n="131" sameAs="frus:frus1865p1/pg131"/>

                <head>Mr. Seward to Mr.
                        Adams</head>
                <opener>
                    <seg rendition="#float-left">No. 1261.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>. <hi
                                rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-02-07"><hi rendition="#italic"
                                >February</hi> 7, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>. Your despatch of the 19th ultimo, No. 857,
                    has been received. Your proceedings, related therein, are approved. It is left
                    entirely to your discretion to decide upon the course to be pursued in regard to
                    the prosecutions to which you refer.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams</hi>. <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
