    <text>
        <body>
            <div xml:id="d321">

                <pb facs="0496" n="456" sameAs="frus:frus1865p1/pg456"/>

                <head>Mr. Seward to Mr.
                        Adams</head>
                <opener>
                    <seg rendition="#float-left">No. 1530.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-08-28"><hi rendition="#italic"
                                >August</hi> 28, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have to acknowledge the receipt of your
                    very interesting despatch o the 20th of July last, No. 1015, respecting the
                    favorable issue of the recent elections in Great Britain. We shall look with
                    much interest to the proceedings of Parliament, and the tendency towards a
                    policy just, if not friendly, to the United States.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
