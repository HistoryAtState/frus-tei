    <text>
        <body>
            <div xml:id="d282">

                <pb facs="0455" n="415" sameAs="frus:frus1865p1/pg415"/>

                <head>Mr. Adams to Mr. Hunter</head>
                <opener>
                    <seg rendition="#float-left">No. 1010.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">London,</hi></placeName>
                        <date calendar="gregorian" when="1865-07-13"><hi rendition="#italic">
                                July</hi> 13, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit further
                    resolutions of condolence—one from, the Annual Association of Independent
                    Ministers of the counties of Carmarthen, Cardigan, and Pembroke; the other from
                    the representatives of the General Baptist churches of England, and also an
                    address from the Freedmen’s Aid Society of London.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>CHARLES FRANCIS ADAMS.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">William Hunter,</hi> Esq., <hi
                            rendition="#italic">Acting Secretary of State, Washington, D.
                        C.</hi></p>
                    <p>[For enclosures see Appendix, separate volume.]</p>
                </postscript>
            </div>
        </body>
    </text>
