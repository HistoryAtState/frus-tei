    <text>
        <body>
            <div xml:id="d129-a1-a2">

                <pb facs="0293" n="253" sameAs="frus:frus1865p1/pg253"/>

                <head>General Grant to General Lee</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Headquarters Armies of the United
                                States,</hi></placeName>
                        <date calendar="gregorian" when="1865-03-13"><hi rendition="#italic"
                                >March</hi> 13, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">General:</hi> Enclosed with this I send you copy of a
                    communication from Earl Russell, secretary of state for foreign affairs,
                    England, to Messrs. Mason, Slidell, and Mann. The accompanying copy of a note
                    from the Hon. William H. Seward, Secretary of State, to the Secretary of War,
                    explains the reason for sending it to you.</p>
                <p>Very respectfully, your obedient servant,</p>
                <closer>
                    <signed>U. S. GRANT, <hi rendition="#italic">Lieutenant
                    General.</hi></signed></closer>
                <postscript>
                    <p>General <hi rendition="#small-caps">R. E. Lee</hi>, <hi rendition="#italic"
                            >Commanding Confederate States Armies.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
