    <text>
        <body>
            <div xml:id="d349">

                <pb facs="0611" n="571" sameAs="frus:frus1865p1/pg571"/>

                <head>Mr. Hunter to Mr. Adams</head>
                <opener>
                    <seg rendition="#float-left">No. 1559.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-10-03"><hi rendition="#italic"
                                >October</hi> 3, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your despatch of the 21st ultimo, No. 1051,
                    enclosing a copy of Lord Russell’s note, relative to the slave trade in Cuba,
                    has been received.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>W. HUNTER, <hi rendition="#italic">Acting
                    Secretary</hi>.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams</hi>, Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
