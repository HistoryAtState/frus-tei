    <text>
        <body>
            <div xml:id="d46-a1-a4">

                <pb facs="0117" n="77" sameAs="frus:frus1865p1/pg77"/>

                <head>Earl Russell to Mr. Adams</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Foreign Office,</hi></placeName>
                        <date calendar="gregorian" when="1864-11-19"><hi rendition="#italic"
                                >November</hi> 19, 1864</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge the receipt
                    of your letter of the 18th instant, enclosing copies of a letter from the United
                    States consul at Liverpool, and the depositions of two men who lately formed
                    part of the crew of the steamer Sea King.</p>
                <p>I have the honor to be, with the highest consideration, sir, your most obedient,
                    humble servant,</p>
                <closer>
                    <signed>RUSSELL.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi>
                        <hi rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
