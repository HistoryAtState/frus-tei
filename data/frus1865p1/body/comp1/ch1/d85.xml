    <text>
        <body>
            <div xml:id="d85">

                <pb facs="0204" n="164" sameAs="frus:frus1865p1/pg164"/>

                <head>Mr. Seward to Mr. Adams</head>
                <opener>
                    <seg rendition="#float-left">No. 1269.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>. <hi
                                rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-02-13"><hi rendition="#italic"
                                >February</hi> 13, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>. I transmit a copy of the joint resolution
                    of Congress, approved on tlie 9th instant, relative to the notice to terminate
                    the treaty of 1817, regulating the naval force on the lakes. You may make such
                    use of the same as may be necessary or advisable.</p>
                <p>I am, sir. your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams</hi>.<hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c., London.</hi></p>
                </postscript>


                <xi:include href="d85-a1.xml" xpointer="d85-a1"/>
            </div>
