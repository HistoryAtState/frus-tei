    <text>
        <body>
            <div xml:id="d178">

                <pb facs="0362" n="322" sameAs="frus:frus1865p1/pg322"/>

                <head>Mr. Hunter to Mr. Adams</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-04-17"><hi rendition="#italic"
                                >April</hi> 17, 1865</date>.</dateline></opener>
                <p>It is hereby ordered that, in honor to the memory of our late illustrious Chief
                    Magistrate, all officers and others subject to the orders of the Secretary of
                    State wear crape upon the left arm for the period of six months.</p>
                <closer>
                    <signed>W. HUNTER, <hi rendition="#italic">Acting
                    Secretary.</hi></signed></closer>
                <postscript>
                    <p>(Same, <hi rendition="#italic">mutatis mutandis,</hi> to all our ministers
                        and consuls abroad.)</p>
                </postscript>
            </div>
        </body>
    </text>
