    <text>
        <body>
            <div xml:id="d376">

                <pb facs="0701" n="661" sameAs="frus:frus1865p1/pg661"/>

                <head>Mr. Seward to Mr. Adams</head>
                <opener>
                    <seg rendition="#float-left">No. 1591.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-11-15"><hi rendition="#italic"
                                >November</hi> 15, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your despatch of the 2d of June, No. 974,
                    transmitting a number of addresses, resolutions, &amp;c., on the assassination
                    of the late President, has been received.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams</hi>, Esq., <hi
                            rendition="#italic">&amp;c.,&amp;c.,&amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
