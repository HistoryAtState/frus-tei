    <text>
        <body>
            <div xml:id="d303">

                <pb facs="0490" n="450" xml:id="pg450"/>

                <head>Mr. Hunter to Mr.
                        Adams</head>
                <opener>
                    <seg rendition="#float-left">No. 1503.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-08-05"><hi rendition="#italic"
                                >August</hi> 5, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your despatch of the 21st of July, No.
                    1019, enclosing a resolution of condolence on the assassination of the late
                    President, adopted by the Northern Presbytery of Antrim, at a meeting held on
                    the 6th ultimo, has been received.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>W. HUNTER, <hi rendition="#italic">Acting
                    Secretary,</hi></signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq.,<hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
