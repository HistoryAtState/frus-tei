    <text>
        <body>
            <div xml:id="d266">

                <pb facs="0446" n="406" xml:id="pg406"/>

                <head>Mr. Adams to Mr.
                        Hunter</head>
                <opener>
                    <seg rendition="#float-left">No. 991.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">London,</hi></placeName>
                        <date calendar="gregorian" when="1865-06-15"><hi rendition="#italic"
                                >June</hi> 15, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to transmit a very few
                    more addresses and resolutions called forth by the late event in the United
                    States.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>CHARLES FRANCIS ADAMS.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Wm.</hi> HUNTER, Esq., <hi rendition="#italic"
                            >Acting Secretary of State, Washington, D. C.</hi></p>
                </postscript>


                <xi:include href="d266-a1.xml" xpointer="d266-a1"/>
