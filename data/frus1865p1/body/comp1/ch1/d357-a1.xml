    <text>
        <body>
            <div xml:id="d357-a1">

                <pb facs="0663" n="623" sameAs="frus:frus1865p1/pg623"/>

                <head>Earl Russell to Mr
                        Adams</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Foreign Office,</hi></placeName>
                        <date calendar="gregorian" when="1865-10-19"><hi rendition="#italic"
                                >October</hi> 19, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your letter of the 17th instant, requesting to be informed of the precise
                    nature of the claims which her Majesty’s government would be willing to refer to
                    a commission, and I have to state to you, in reply, that the information you
                    request may take some time in preparation; but her Majesty’s government will
                    furnish it as soon as they can consistently with the importance of the
                    question.</p>
                <p>I have the honor to be, with the highest consideration, sir, your most obedient,
                    humble servant,</p>
                <closer>
                    <signed>RUSSELL.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams</hi>, Esq., <hi
                            rendition="#italic">&amp;c.,&amp;c.,&amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
