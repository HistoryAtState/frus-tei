    <text>
        <body>
            <div xml:id="d135-a2">

                <pb facs="0299" n="259" sameAs="frus:frus1865p1/pg259"/>

                <head>Earl Russell to Mr. Adams</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Foreign Office,</hi></placeName>
                        <date calendar="gregorian" when="1865-03-17"><hi rendition="#italic"
                                >March</hi> 17, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge the receipt
                    of your letter of this day, containing a resolution of the Congress of the
                    United States, approved by the President, in regard to the termination of the
                    treaty of 1854, commonly known as the reciprocity treaty.</p>
                <p>Her Majesty will instruct Sir Frederick Bruce, on his proceeding to Washington as
                    her Majesty’s envoy extraordinary, upon the subject.</p>
                <p>I have the honor to be, with the highest consideration, sir, your most obedient,
                    humble servant,</p>
                <closer>
                    <signed>RUSSELL.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
