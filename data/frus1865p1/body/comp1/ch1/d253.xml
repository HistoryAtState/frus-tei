    <text>
        <body>
            <div xml:id="d253">

                <pb facs="0438" n="398" sameAs="frus:frus1865p1/pg398"/>

                <head>Mr. Hunter to Mr.
                        Adams</head>
                <opener>
                    <seg rendition="#float-left">No. 1437.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-06-03"><hi rendition="#italic"
                                >June</hi> 3, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have received your despatch of the 18th
                    ultimo, No. 956, transmitting from various parts of the kingdom of Great Britain
                    a large number of addresses and resolutions which have been called forth by the
                    late deplorable events, together with an appended list of the same.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>W. HUNTER, <hi rendition="#italic">Acting
                    Secretary.</hi></signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
