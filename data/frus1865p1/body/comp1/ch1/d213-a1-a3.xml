    <text>
        <body>
            <div xml:id="d213-a1-a3">

                <pb facs="0391" n="351" xml:id="pg351"/>

                <head>Mr. Adams to Earl
                        Russell</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">London,</hi></placeName>
                        <date calendar="gregorian" when="1865-04-28"><hi rendition="#italic"
                                >April</hi> 28, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Lord:</hi> I have the honor to transmit to your
                    lordship herewith, in compliance with the request contained in your note of this
                    day, the original letter from the President to the Queen, in reply to that from
                    her Majesty, announcing the resignation by Lord Lyons of the post of her
                    Majesty’s representative at Washington.</p>
                <p>I pray your lordship to accept the assurances of the highest consideration with
                    which I have the honor to be, my lord, your lordship’s most obedient
                    servant,</p>
                <closer>
                    <signed>CHARLES FRANCIS ADAMS.</signed></closer>
                <postscript>
                    <p>Right Hon. <hi rendition="#small-caps">Earl Russell,</hi>
                        <hi rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
