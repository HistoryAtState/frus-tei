    <text>
        <body>
            <div xml:id="d428">

                <pb facs="0572" n="560" sameAs="frus:frus1943v03/pg560"/>

                <note rend="inline" type="source">124.61/263: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the Soviet Union</hi> (<hi rendition="#italic">Standley</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Moscow</hi></placeName>, <date
                            calendar="gregorian" when="1943-08-10T15:00:00+03:00">August 10, 1943—3
                            p.m.</date>
                        <lb/> [Received 9:15 p.m.]</dateline>
                </opener>
                <p>1038. My number 1010, August 3, 5 p.m. Kuibyshev advises that office there will
                    be closed August 14.<anchor n="58" xml:id="d428-f1"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Standley</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d428-f1" n="58" xml:id="d428-f1-content">
                <p>All of the staff at Kuibyshev except one person, who was to come later, arrived
                    in Moscow by special diplomatic train on August 16, 1943.</p>
            </note>
        </listAnnotation>
    </standOff>
