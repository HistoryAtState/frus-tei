    <text>
        <body>
            <div xml:id="d449">

                <pb facs="0594" n="582" sameAs="frus:frus1943v03/pg582"/>

                <note rend="inline" type="source">851.01/3038: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in the Soviet Union</hi> (<hi
                        rendition="#italic">Hamilton</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Moscow</hi></placeName>, <date
                            calendar="gregorian" when="1943-10-05">October 5,
                        1943</date>.<lb/>[Received October 6—11:16 a.m.]</dateline>
                </opener>
                <p>1532. Moscow papers for October 5 announced the appointment of Aleksandr
                    Efremovich Bogomolov as Plenipotentiary Representative of the Soviet Government
                    to the French Committee of National Liberation.<anchor n="2" xml:id="d449-f1"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hamilton</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d449-f1" n="2" xml:id="d449-f1-content">
                <p>For correspondence regarding the concern of the United States over the disunity
                    in French North Africa and recognition of the administrative authority of the
                    French Committee of National Liberation, see <ref target="frus1943v02#pg_23"
                        >vol. <hi rendition="#small-caps">ii</hi>, pp. 23</ref> ff.</p>
            </note>
        </listAnnotation>
    </standOff>
