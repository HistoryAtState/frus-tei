    <text>
        <body>
            <div xml:id="d453">

                <pb facs="0597" n="585" xml:id="pg585"/>

                <note rend="inline" type="source">701.6111/1226: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the Soviet Union</hi> (<hi
                        rendition="#italic">Harriman</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Moscow</hi></placeName>, <date
                            calendar="gregorian" when="1943-10-26">October 26,
                        1943</date>.<lb/>[Received October 27—1:08 p.m.]</dateline>
                </opener>
                <p>1734. Personal for Soviet Ambassador. Have just read digest reported here on your
                    radio address October 21st.<anchor n="8" xml:id="d453-f1"/> It is an important
                    contribution toward establishment of mutual understanding and friendship between
                    the people of our two countries. May I send you my congratulations.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Harriman</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d453-f1" n="8" xml:id="d453-f1-content">
                <p>The text of the radio address by Ambassador Gromyko is printed in the <hi
                        rendition="#italic">New York Times</hi>, October 22, 1943, p. 10, col.
                    2.</p>
            </note>
        </listAnnotation>
    </standOff>
