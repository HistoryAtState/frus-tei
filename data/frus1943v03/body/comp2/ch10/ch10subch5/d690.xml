    <text>
        <body>
            <div xml:id="d690">

                <pb facs="0846" n="834" sameAs="frus:frus1943v03/pg834"/>

                <note rend="inline" type="source">800.01B11 Registration/1637</note>
                <head>
                    <hi rendition="#italic">The Ambassador of the Soviet Union</hi> (<hi
                        rendition="#italic">Litvinov</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <p>The Ambassador of the Union of Soviet Socialist Republics presents his
                    compliments to the Secretary of State and has the honor to transmit herewith
                    Form FA–3F–6M filled out by the Amtorg Trading Corporation, 210 Madison Avenue,
                    New York, N.Y.,<anchor n="35" xml:id="d690-f1"/> and would appreciate it if the
                    Secretary would transmit it to the Department of Justice.<anchor n="36"
                        xml:id="d690-f2"/>
                </p>
                <closer>
                    <dateline rendition="#float-left">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1943-04-29">April 29,
                            1943</date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d690-f1" n="35" xml:id="d690-f1-content">
                <p>Official purchasing and sales agency of the Soviet Union in the United
                    States.</p>
            </note>
            <note corresp="#d690-f2" n="36" xml:id="d690-f2-content">
                <p>This registration form was sent to the Department of Justice on May 8.</p>
            </note>
        </listAnnotation>
    </standOff>
