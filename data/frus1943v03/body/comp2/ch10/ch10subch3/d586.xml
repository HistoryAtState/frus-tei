    <text>
        <body>
            <div xml:id="d586">

                <pb facs="0752" n="740" sameAs="frus:frus1943v03/pg740"/>

                <note rend="inline" type="source">Moscow Embassy Files: Lot F–96</note>
                <head>
                    <hi rendition="#italic">The American Ambassador in the Soviet Union</hi> (<hi
                        rendition="#italic">Standley</hi>) <hi rendition="#italic">to the People’s
                        Commissar for Foreign Affairs of the Soviet Union</hi> (<hi
                        rendition="#italic">Molotov</hi>)</head>
                <opener>
                    <seg rendition="#float-left">No. L–28</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Moscow</hi></placeName>, <date
                            calendar="gregorian" when="1943-01-10">January 10,
                        1943</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: I have the honor to inform you that
                    I have been instructed to deliver the following message, dated January 9, 1943,
                    from President Roosevelt to Premier Stalin.<anchor n="42" xml:id="d586-f1"/>
                </p>
                <pb facs="0753" n="741" xml:id="pg741"/>
                <quote rend="blockquote">
                    <p>“I have arranged that two hundred C–47 transport planes be assigned to you in
                        1943 beginning in January.</p>
                    <p>“Your mission here is being advised of the dates of delivery by months.</p>
                    <p>“I am going to do everything I can to give you another one hundred but you
                        can definitely count on the two hundred planes referred to above.”</p>
                </quote>
                <p>Accept [etc.]</p>
                <closer>For the Ambassador: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Llewellyn E. Thompson, Jr</hi>.</signed>
                    <lb/>
                    <hi rendition="#italic">Secretary of Embassy</hi>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d586-f1" n="42" xml:id="d586-f1-content">
                <p>Iosif Vissarionovich Stalin, President (Chairman) of the Council of People’s
                    Commissars since May 6, 1941, and People’s Commissar of Defense since July 19,
                    1941.</p>
            </note>
        </listAnnotation>
    </standOff>
