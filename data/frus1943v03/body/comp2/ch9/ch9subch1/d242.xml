    <text>
        <body>
            <div xml:id="d242">

                <pb facs="0341" n="329" sameAs="frus:frus1943v03/pg329"/>

                <note rend="inline" type="source">760C.61/2–843</note>
                <head>
                    <hi rendition="#italic">The Polish Ambassador</hi> (<hi
                            rendition="#italic">Ciechanowski</hi>) <hi
                        rendition="#italic">to the Under Secretary of State</hi> (<hi rendition="#italic">Welles</hi>)<anchor n="33"
                        xml:id="d242-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-02-08">February 8,
                        1943</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Welles</hi>: Enclosed I am sending you a
                    telegraphic message which I received from General Sikorski this morning in reply
                    to my telegram after our last conversation on February fifth.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>J. <hi rendition="#small-caps">Ciechanowski</hi>
                    </signed>
                </closer>


                <xi:include href="d242-a1.xml" xpointer="d242-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d242-f1" n="33" type="source" xml:id="d242-f1-content">
                <p>A copy of this message was sent promptly by the Under Secretary to President
                    Roosevelt.</p>
            </note>
        </listAnnotation>
    </standOff>
