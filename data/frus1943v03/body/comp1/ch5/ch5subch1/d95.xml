                <pb facs="0169" n="157" sameAs="frus:frus1943v03/pg157"/>

                <note rend="inline" type="source">841D.01/204: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in the United Kingdom</hi> (<hi
                            rendition="#italic">Winant</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-10-05T00:00:00-04:00">October 5,
                            1943—midnight</date>.</dateline>
                </opener>
                <p>6157. Personal for Winant, Department’s 5736, September 18 and your 6266,
                    September 19. Could you make discreet inquiries as to when we may expect to
                    receive the British Government’s views? As you know the President is personally
                    interested in this matter.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
