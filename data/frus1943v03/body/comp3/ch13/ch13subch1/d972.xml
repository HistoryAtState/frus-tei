    <text>
        <body>
            <div xml:id="d972">

                <pb facs="1106" n="1094" sameAs="frus:frus1943v03/pg1094"/>

                <note rend="inline" type="source">895.01/251</note>
                <head>
                    <hi rendition="#italic">Major General Edwin M.
                            Watson, Secretary to President
                        Roosevelt, to the Chairman of the Korean Commission in
                        the United States</hi> (<hi rendition="#italic"
                            >Rhee</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, [<date
                            calendar="gregorian" when="1943-05-26">May 26, 1943</date>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Dr. Rhee</hi>: By direction of the
                    President, I acknowledge the receipt of your letter of May 15, 1943, in which
                    you discuss various matters relating to Korea and with which you enclose a copy
                    of a telegram from Mr. Tjosowang.</p>
                <p>I do not need to assure you that the contents of your letter and its enclosures
                    have received careful attention.</p>
                <p>Very sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Edwin</hi> M. <hi rendition="#small-caps"
                            >Watson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
