            <div xml:id="d873">

                <pb facs="1009" n="997" sameAs="frus:frus1943v03/pg997"/>

                <note rend="inline" type="source">711.94114A/3: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in Switzerland</hi> (<hi
                        rendition="#italic">Harrison</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Bern</hi></placeName>, <date
                            calendar="gregorian" when="1943-07-14">July 14,
                        1943</date>.<lb/>[Received July 14—9:21 p.m.]</dateline>
                </opener>
                <p>4157. American interests Japan. Department’s 1252, May 25. Legation Tokyo
                    telegraphs: <pb facs="1010" n="998" xml:id="pg998"/>
                    <quote rend="blockquote">
                        <p>Japanese Foreign Office states Japanese Government not prepared give such
                            authorization as article 13 Japanese regulations regarding prisoner of
                            war prescribes witness be present all visits to prisoners.</p>
                    </quote>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Harrison</hi>
                    </signed>
                </closer>
            </div>
        </body>
