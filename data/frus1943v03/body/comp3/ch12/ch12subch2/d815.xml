            <div xml:id="d815">

                <pb facs="0968" n="956" sameAs="frus:frus1943v03/pg956"/>

                <note rend="inline" type="source">390.1115/6284: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Minister in Switzerland</hi> (<hi rendition="#italic"
                            >Harrison</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-01-14">January 14,
                        1943</date>.</dateline>
                </opener>
                <p>107. American interests—prisoners of war—China. Your 167 January 9th. Department
                    appreciates Gorgé’s efforts in this matter. It is anxious to obtain as soon as
                    possible information requested in the last paragraph of its 2845 of December
                        17.<anchor n="89" xml:id="d815-f1"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
