    <text>
        <body>
            <div xml:id="d768">

                <pb facs="0930" n="918" sameAs="frus:frus1943v03/pg918"/>

                <note rend="inline" type="source">701.0090/1927: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Minister in Switzerland</hi> (<hi rendition="#italic"
                            >Harrison</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-08-28">August 28,
                        1943</date>.</dateline>
                </opener>
                <p>2105. American interests Far East—exchange. Your 5301, August 27.<anchor n="7"
                        xml:id="d768-f1"/> Please inform Gorgé and Fontanel<anchor n="8"
                        xml:id="d768-f2"/> that each child is counted as a person for purposes of
                    American-Japanese exchange. This is necessary in view of the need of keeping the
                    ship’s company within the limits of the certified lifeboat capacity of the <hi
                        rendition="#italic">Gripsholm</hi>. The proposal that children under 2 years
                    be not counted and those between 2 and 4 years be counted as half persons was
                    made by the British Government in connection with the British-Japanese exchange
                    and is not applicable to the American-Japanese exchange.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d768-f1" n="7" xml:id="d768-f1-content">
