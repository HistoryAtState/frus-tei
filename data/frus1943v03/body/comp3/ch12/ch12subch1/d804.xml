    <text>
        <body>
            <div xml:id="d804">

                <pb facs="0958" n="946" sameAs="frus:frus1943v03/pg946"/>

                <note rend="inline" type="source">701.0090/3362a: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in
                        Switzerland</hi> (<hi rendition="#italic">Harrison</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-12-02">December 2,
                        1943</date>.</dateline>
                </opener>
                <p>2987. American interests—Far East. Inform Japanese Foreign Office that <hi
                        rendition="#italic">Gripsholm</hi> arrived New York, December l.<anchor
                        n="63" xml:id="d804-f1"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d804-f1" n="63" xml:id="d804-f1-content">
                <p>The <hi rendition="#italic">Gripsholm</hi> arrived at Port Elizabeth at 7:30
                    a.m., South African summer time, November 3, and departed the next day at 6:30
                    p.m. The vessel arrived at Rio de Janeiro at 1:05 p.m., November 15, and
                    departed for New York on the 16th. For arrangements made at the New York pier
                    and general observations, see Department of State <hi rendition="#italic"
                        >Bulletin</hi>, November 13, 1943, pp. 320, 321. For the Department’s press
                    release of January 13, 1944, on the exchange, see <hi rendition="#italic"
                        >ibid</hi>., January 15, 1944, p. 77.</p>
            </note>
        </listAnnotation>
    </standOff>
