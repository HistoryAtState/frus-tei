    <text>
        <body>
            <div xml:id="d761">

                <pb facs="0924" n="912" xml:id="pg912"/>

                <note rend="inline" type="source">701.0090/1794: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Minister in
                        Switzerland</hi> (<hi rendition="#italic">Harrison</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-08-24">August 24,
                        1943</date>.</dateline>
                </opener>
                <p>2056. American interests Philippines repatriation. Your 5135, August 21.<anchor
                        n="93" xml:id="d761-f1"/> The Philippine citizens in question are nationals
                    of the United States and accordingly entitled under the exchange agreement to be
                    exchanged. It is requested that the Swiss Legation Tokyo so inform the Japanese
                    Government.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Berle</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d761-f1" n="93" xml:id="d761-f1-content">
                <p>Not printed; it reported Japanese deletion of names of 13 Philippine citizens
                    trom the list of persons to be repatriated from occupied China.</p>
            </note>
        </listAnnotation>
    </standOff>
