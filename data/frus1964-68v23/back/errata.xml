    <text>
        <body>
            <div xml:id="errata">

                <pb facs="0921" n="[888]" xml:id="pg888"/>

                <head>Errata</head>
                <p>The following error has been identified in <hi rendition="#italic">Foreign
                        Relations of the United States, 1964–1968, Volume XXIII, Congo</hi>. Please
                    be aware that printed volumes have not been revised.</p>
                <list type="simple">
                    <item>
                        <hi rendition="#bold">1. <ref target="#d61">Document 61</ref>, <ref
                                target="#pg80">Page 80</ref> (date of errata entry: March 6,
                            2025)</hi>
                    </item>
                    <item>The organization in the document heading of Document 61 has been corrected
                        from “North American Treaty Organization” to “North Atlantic Treaty
                        Organization”.</item>
                </list>
            </div>
        </body>
    </text>
