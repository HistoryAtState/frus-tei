            <div xml:id="d62">

                <pb facs="0159" n="83" sameAs="frus:frus1935v02/pg83"/>

                <note rend="inline" type="source">611.47H31/86: Telegram</note>
                <head><hi rendition="#italic">The Consul General at Wellington</hi> (<hi
                        rendition="#italic">Bucklin</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Wellington</hi></placeName>, <date calendar="gregorian"
                            when="1935-12-15T18:00:00+12:00">December 15, 1935—6
                        p.m.</date><lb/>[Received December 16—3:42 a.m.]</dateline>
                </opener>
                <p>May assurance be given New Zealand Government that it will receive advantages of
                    Canadian-American Trade Agreement regarding butter if most favored nation
                    treatment is hereafter accorded the United States under the New Zealand-Belgian
                    Treaty reported by despatch No. 442, March 14, 1934?<anchor n="18"
                        xml:id="d62-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Bucklin</hi></signed></closer>
            </div>
        </body>
    </text>
