            <div xml:id="d658">

                <pb facs="0874" n="798" sameAs="frus:frus1935v02/pg798"/>

                <note rend="inline" type="source">811.5034/170</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Swiss Minister</hi> (<hi rendition="#italic"
                            >Peter</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1935-01-22">January 22, 1935</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of January 8, 1935, presenting the views of your Government
                    concerning the interpretation of the meaning of the word “citizen” in Article 2
                    of Paragraph 2 of the Convention of Friendship and Commerce between the Swiss
                    Confederation and the United States of America, signed November 25, 1850. The
                    statements contained in your note will receive the Department’s careful
                    consideration.</p>
                <p>Accept [etc.]</p>
                <closer>For the Secretary of State:<lb/><signed>R. <hi rendition="#small-caps"
                            >Walton Moore</hi></signed></closer>
            </div>
        </body>
    </text>
