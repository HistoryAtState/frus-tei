    <text>
        <body>
            <div xml:id="d278">

                <pb facs="0433" n="357" sameAs="frus:frus1935v02/pg357"/>

                <note rend="inline" type="source">862.404/126a: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Ambassador in Germany</hi> (<hi
                            rendition="#italic">Dodd</hi>)<anchor n="11" xml:id="d278-f1"
                    /></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1935-07-22T18:00:00-04:00">July 22, 1935—6 p.m.</date></dateline>
                </opener>
                <p>50. Press for last few days has been reporting new measures by German Government
                    applying to religious groups. Would appreciate telegraphic report with comment
                    on subject.</p>
                <closer><signed><hi rendition="#small-caps">Phillips</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d278-f1" n="11" type="source" xml:id="d278-f1-content">
                <p>This instruction was sent at the request of President Roosevelt and the reply,
                        <hi rendition="#italic">infra</hi>, was transmitted to him.</p>
            </note>
        </listAnnotation>
    </standOff>
