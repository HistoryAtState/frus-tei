    <text>
        <body>
            <div xml:id="d496">

                <pb facs="0691" n="615" sameAs="frus:frus1935v02/pg615"/>

                <note rend="inline" type="source">811.91256D/1: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Chargé in the
                        Netherlands</hi> (<hi rendition="#italic">Wilson</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1935-11-13T17:00:00-05:00">November 13, 1935—5
                        p.m.</date></dateline>
                </opener>
                <p>50. Your despatch 310, October 25. Supplement your <hi rendition="#italic"
                        >aide-mémoire</hi> with a reference to Article 22 of the Telecommunication
                    Convention signed at Madrid December 9, 1932.<anchor n="39" xml:id="d496-f1"/>
                    Your action is approved.</p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
    </text>
