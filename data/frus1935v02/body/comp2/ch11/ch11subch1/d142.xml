    <text>
        <body>
            <div xml:id="d142">

                <pb facs="0249" n="173" xml:id="pg173"/>

                <note rend="inline" type="source">659.116/95: Telegram</note>
                <head><hi rendition="#italic">The Minister in Denmark</hi> (<hi rendition="#italic"
                        >Owen</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Copenhagen</hi></placeName>, <date calendar="gregorian"
                            when="1935-02-13T12:00:00+01:00">February 13,
                        1935—noon</date>.<lb/>[Received February 13—9:50 a.m.]</dateline>
                </opener>
                <p>2. Department’s telegram No. 2 February 11, 7 p.m. In view of the psychology of
                    local situation I respectfully request that I be authorized to present note with
                    last 10 words omitted conveying their content verbally.<anchor n="5"
                        xml:id="d142-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Owen</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d142-f1" n="5" xml:id="d142-f1-content">
                <p>By telegram No. 3, February 13, 1935, 6 p.m., the Minister was informed of the
                    Department’s approval.</p>
            </note>
        </listAnnotation>
    </standOff>
