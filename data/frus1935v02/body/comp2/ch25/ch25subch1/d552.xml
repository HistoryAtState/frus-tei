                <pb facs="0765" n="689" sameAs="frus:frus1935v02/pg689"/>

                <note rend="inline" type="source">611.5231/962</note>
                <head><hi rendition="#italic">The Spanish Embassy to the Department of
                    State</hi></head>
                <p rendition="#center"><hi rendition="#small-caps">Foreign Trade of Spain</hi></p>
                <p rendition="#center">(Base—1933)</p>
