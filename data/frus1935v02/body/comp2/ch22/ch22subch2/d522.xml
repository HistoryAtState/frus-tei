    <text>
        <body>
            <div xml:id="d522">

                <pb facs="0736" n="660" sameAs="frus:frus1935v02/pg660"/>

                <note rend="inline" type="source">124.60C 3/214: Telegram (part air)</note>
                <head><hi rendition="#italic">The Ambassador in Poland</hi> (<hi rendition="#italic">Cudahy</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Warsaw</hi></placeName>, <date calendar="gregorian"
                            when="1934-12-27T00:00:00+01:00">December 27, 1934—12
                        a.m.</date><lb/>[Received December 29—7:56 a.m.]</dateline>
                </opener>
                <p>59. Your instruction No. 138, December 12, page 4 second paragraph.<anchor n="41"
                        xml:id="d522-f1"/> What is the status of American employees of the Embassy
                        <pb facs="0737" n="661" xml:id="pg661"/> other than officers with respect to
                    liability to contribute portion cost of insurance of Polish nationals personally
                    employed by them?</p>
                <closer><signed><hi rendition="#small-caps">Cudahy</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d522-f1" n="41" xml:id="d522-f1-content">
                <p>Paragraph beginning, “In view of the extraterritorial status …”, above.</p>
            </note>
        </listAnnotation>
    </standOff>
