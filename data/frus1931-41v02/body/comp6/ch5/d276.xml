    <text>
        <body>
            <div xml:id="d276">

                <pb facs="0565" n="499" sameAs="frus:frus1931-41v02/pg499"/>

                <note rend="inline" type="source">711.94/2178<hi rendition="#superscript"
                    >2/18</hi></note>
                <head><hi rendition="#italic">The Japanese Ambassador</hi> (<hi rendition="#italic"
                        >Nomura</hi>) <hi rendition="#italic">to the Secretary of State</hi><anchor
                        n="52" xml:id="d276-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1941-07-04">July 4, 1941</date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I am glad to inform you
                    that I am now authorized by the Foreign Minister to assure you that there is no
                    divergence of views in the Government regarding its fundamental policy of
                    adjusting Japanese-American relations on a fair basis.</p>
                <p>Yours very sincerely,</p>
                <closer><signed>K. <hi rendition="#small-caps">Nomura</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d276-f1" n="52" type="source" xml:id="d276-f1-content">
                <p>Notation on original: “This letter was handed to Mr. Ballantine by the Japanese
                    Ambassador on July 4, 1941 with the request that its contents be telephoned to
                    the Secretary as soon as possible. The contents of the letter were telephoned to
                    the Secretary on July 5 by Mr. Renchard.”</p>
            </note>
        </listAnnotation>
    </standOff>
