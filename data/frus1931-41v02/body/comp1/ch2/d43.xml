            </note>
            <note corresp="#d43-f2" n="61a" xml:id="d43-f2-content">
                <p>Bear Admiral Thomas C. Hart, Commander-in-Chief of the U. S. Asiatic Fleet.</p>
            </note>
        </listAnnotation>
    </standOff>
