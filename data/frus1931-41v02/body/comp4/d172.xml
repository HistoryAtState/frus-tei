    <text>
        <body>
            <div xml:id="d172">

                <pb facs="0319" n="253" sameAs="frus:frus1931-41v02/pg253"/>

                <head><hi rendition="#italic">Proclamation No. 2464, Signed by President Roosevelt,
                        March 4, 1941</hi><anchor n="49" xml:id="d172-f1"/></head>
                <p><hi rendition="#small-caps">Whereas</hi> section 6 of the act of Congress
                    entitled “<hi rendition="#small-caps">An Act To</hi> expedite the strengthening
                    of the national defense”, approved July 2, 1940, provides as follows:</p>
                <p>[Here follows the text of the act as quoted in proclamation No. 2413 of July 2,
                    1940, printed on <ref target="#pg211">page 211</ref>.]</p>
                <p><hi rendition="#small-caps">Now, therefore, I, Franklin D. Roosevelt</hi>,
                    President of the United States of America, acting under and by virtue of the
                    authority vested in me by the aforesaid act of Congress, do hereby proclaim that
                    upon the recommendation of the Administrator of Export Control I have determined
                    that it is necessary in the interest of the national defense that on and after
                    March 24, 1941, the following-described articles and materials shall not be
                    exported from the United <pb facs="0320" n="254" xml:id="pg254"/> States except
                    when authorized in each case by a license as provided for in Proclamation No.
                    2413 of July 2, 1940, entitled “Administration of section 6 of the Act entitled
                        ‘<hi rendition="#small-caps">An Act To</hi> expedite the strengthening of
                    the national defense’ approved July 2, 1940”: <list>
                        <label>(1)</label>
                        <item>Jute</item>
                        <label>(2)</label>
                        <item>Lead</item>
                        <label>(3)</label>
                        <item>Borax</item>
                        <label>(4)</label>
                        <item>Phosphates</item>
                    </list></p>
                <p><hi rendition="#small-caps">In witness whereof</hi>, I have hereunto set my hand
                    and caused the seal of the United States of America to be affixed.</p>
                <closer>
                    <dateline rendition="#float-left">
                        <seg type="margin">[<hi rendition="#small-caps">seal</hi>]</seg>
                        <hi rendition="#small-caps">Done</hi> at the city of
                            <placeName>Washington</placeName>
                        <date calendar="gregorian us-republic" when="1941-03-04">this 4th day of
                            March, in the year of our Lord nineteen hundred and forty-one, and of
                            the Independence of the United States of America the one hundred and
                            sixty-fifth</date>.</dateline>
                    <lb/>
                    <signed><hi rendition="#small-caps">Franklin D. Roosevelt</hi></signed></closer>
                <postscript>
                    <p>By the President:<lb/><hi rendition="#small-caps">Cordell Hull</hi><lb/><hi
                            rendition="#italic">Secretary of State</hi></p>
                </postscript>
            </div>
