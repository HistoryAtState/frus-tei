            </note>
            <note corresp="#d106-f2" n="9a" xml:id="d106-f2-content">
                <p>Sec. 13 (<hi rendition="#italic">c</hi>) of act approved May 26, 1924; 43 Stat.
                    153.</p>
            </note>
        </listAnnotation>
