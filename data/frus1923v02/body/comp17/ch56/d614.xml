    <text>
        <body>
            <div xml:id="d614">

                <pb facs="0844" n="720" sameAs="frus:frus1923v02/pg720"/>

                <note rend="inline" type="source">891.6363 Standard Oil/327</note>
                <head><hi rendition="#italic">The Minister in Persia</hi> (<hi rendition="#italic"
                        >Kornfeld</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Teheran</hi></placeName>, <date calendar="gregorian"
                            when="1924-01-05"><hi rendition="#italic">January 5,
                        1924</hi></date>.<lb/>[Received February 16.]</dateline>
                    <seg rendition="#float-left">No. 343</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to the Legation’s despatch No.
                    336 of December 29, 1923,<anchor n="11" xml:id="d614-f1"/> I have the honor to
                    transmit herewith translation of the contract awarding the northern oil
                    concession to the Sinclair Exploration Company.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Joseph S.
                    Kornfeld</hi></signed></closer>



                <xi:include href="d614-a1.xml" xpointer="d614-a1"/>
            </div>
        </body>
    </text>
