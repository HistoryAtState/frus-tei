            <div xml:id="d643">

                <pb facs="0918" n="794" sameAs="frus:frus1923v02/pg794"/>

                <note rend="inline" type="source">361.1153 In 8/24: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Consul at
                        Vladivostok</hi> (<hi rendition="#italic">Tuck</hi>)</head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1923-03-27T18:00:00-05:00"><hi rendition="#italic">March 27,
                                1923—6 p.m.</hi></date></dateline></opener>
                <p>Under circumstances reported in your telegram no. 12, March 26, 1 p.m., you must
                    use greatest care. Do not file further protests without explicit instructions
                    from the Department.</p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
