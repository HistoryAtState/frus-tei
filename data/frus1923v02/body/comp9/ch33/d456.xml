    <text>
        <body>
            <div xml:id="d456">

                <pb facs="0628" n="504" sameAs="frus:frus1923v02/pg504"/>

                <note rend="inline" type="source">894.51 Or 4/23</note>
                <head><hi rendition="#italic">The President of the Riggs National Bank</hi> (<hi
                        rendition="#italic">Milton E. Ailes</hi>) <hi rendition="#italic">to the
                        Economic Adviser of the Department of State</hi> (<hi rendition="#italic"
                        >Young</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1923-02-17"><hi rendition="#italic">February 17,
                        1923</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Dr. Young</hi>: Referring to my conversation
                    with you yesterday, I enclose herewith copy of letter I have just received from
                    Mr. Victor Schoepperle, Assistant Vice President of the National City Company,
                    New York, giving further information touching the question of the use of the
                    proceeds of the proposed loan to the Oriental Development Company.</p>
                <p>Very truly yours,</p>
                <closer><signed><hi rendition="#small-caps">Milton E. Ailes</hi></signed></closer>


                <xi:include href="d456-a1.xml" xpointer="d456-a1"/>
            </div>
