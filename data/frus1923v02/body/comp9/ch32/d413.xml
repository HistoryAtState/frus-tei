                <pb facs="0599" n="475" sameAs="frus:frus1923v02/pg475"/>

                <note rend="inline" type="source">894.48B/67B: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Ambassador in Japan</hi> (<hi rendition="#italic"
                            >Woods</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1923-09-11"><hi rendition="#italic">September 11,
                        1923</hi></date>.</dateline></opener>
                <p>154. Please inform Count Yamamoto that the President is deeply touched by his
                    generous and friendly message which has been received through the Japanese
                    Ambassador and assure him that the American people desire to testify in every
                    practicable way to their warm sympathy for the people of Japan in this hour of
                    terrible affliction.</p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
