    <text>
        <body>
            <div xml:id="d234">

                <pb facs="0459" n="335" sameAs="frus:frus1923v02/pg335"/>

                <note rend="inline" type="source">868.48/439: Telegram</note>
                <head><hi rendition="#italic">The High Commissioner at Constantinople</hi>
                        (<hi rendition="#italic">Bristol</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1923-04-27T11:00:00+02:00"><hi rendition="#italic">April 27,
                                1923—11 a.m.</hi></date><lb/>[Received April 27—9:14
                        a.m.]</dateline></opener>
                <p>125. Department’s 61, April 6, 3 p.m. and my 105, April 12, 4 p.m.<anchor n="17"
                        xml:id="d234-f1"/> Red Crescent, Constantinople, has been authorized by
                    Angora to pass Near East Relief food supplies through customs free of duty.
                    Details being worked out now and satisfactory solution of difficulties most
                    probable.</p>
                <closer><signed><hi rendition="#small-caps">Bristol</hi></signed></closer>
            </div>
        </body>
    </text>
