    <text>
        <body>
            <div xml:id="d233">

                <pb facs="0459" n="335" sameAs="frus:frus1923v02/pg335"/>

                <note rend="inline" type="source">868.51 Refugee Settlement Commission/37</note>
                <head><hi rendition="#italic">The Italian Ambassador</hi> (<hi
                            rendition="#italic">Caetani</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><seg rendition="#center">[Translation<anchor n="15" xml:id="d233-f1"
                        />]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1923-04-26"><hi rendition="#italic">April 26,
                        1923</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Mr. Secretary of State</hi>: By direction of Signor
                    Mussolini, and with reference to the note which Your Excellency sent me under
                    date of March 31st last,<anchor n="16" xml:id="d233-f2"/> I have the honor to
                    assure Your Excellency that the Italian Government is ready to consider with the
                    most benevolent interest the American proposal concerning systematic provision
                    for the refugees from Asia Minor.</p>
                <p>I welcome [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Caetani</hi></signed></closer>
            </div>
        </body>
    </text>
