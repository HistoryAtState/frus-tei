    <text>
        <body>
            <div xml:id="d546">

                <pb facs="0727" n="603" xml:id="pg603"/>

                <note rend="inline" type="source">381.81/135</note>
                <head><hi rendition="#italic">The Diplomatic Agent and Consul General at
                        Tangier</hi> (<hi rendition="#italic"
                        >Denning</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><seg rendition="#center">[Extract]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Tangier</hi></placeName>, <date calendar="gregorian"
                            when="1923-10-26"><hi rendition="#italic">October 26,
                        1923</hi></date>.<lb/>[Received November 26.]</dateline>
                    <seg rendition="#float-left">No. 180</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith
                    (Enclosure No. 1), a copy with its translation of a communication received at
                    this Agency from the French Residency-General in reply to two letters to [<hi
                        rendition="#italic">from</hi>] this Mission dated July 10th, and September
                    14th, concerning the list of American Protégés and their status in the French
                    Zone.</p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">J. M. Denning</hi></signed></closer>


                <xi:include href="d546-a1.xml" xpointer="d546-a1"/>
            </div>
        </body>
    </text>
