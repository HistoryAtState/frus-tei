                <pb facs="0434" n="310" sameAs="frus:frus1923v02/pg310"/>

                <note rend="inline" type="source">25.655/96: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Great Britain</hi> (<hi
                        rendition="#italic">Wheeler</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1923-07-28T13:00:00+01:00"><hi rendition="#italic">July 28, 1923—1
                                p.m.</hi></date><lb/>[Received July 28—9:15
                    a.m.]</dateline></opener>
                <p>324. My 323, July 27, 5 p.m. It is Sperling’s suggestion that the announcement by
                    the American Government take the form of a note from our London Embassy to the
                    British Foreign Office.</p>
                <closer><signed><hi rendition="#small-caps">Wheeler</hi></signed></closer>
            </div>
        </body>
