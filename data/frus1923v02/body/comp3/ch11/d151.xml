    <text>
        <body>
            <div xml:id="d151">

                <pb facs="0349" n="225" xml:id="pg225"/>

                <note rend="inline" type="source">867n.01/371</note>
                <head><hi rendition="#italic">The Chargé in Great Britain</hi> (<hi
                        rendition="#italic">Wheeler</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1923-11-30"><hi rendition="#italic">November 30,
                        1923</hi></date>.<lb/>[Received December 15.]</dateline>
                    <seg rendition="#float-left">No. 3180</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Supplementing my telegram No. 536 of
                    November 30, 5 p.m., 1923,<anchor n="6" xml:id="d151-f1"/> I have the honor to
                    enclose two notes from the Foreign Office, dated November 29, 1923, on the
                    subject of the difficulties which have arisen in Palestine through the issuance
                    of an Order in Council conflicting with the agreement made by the American Vice
                    Consul in Jerusalem with the local authorities, and with regard to the desire of
                    the British Government to conclude an Anglo-American Treaty recognizing the
                    British Mandate in Palestine.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Post Wheeler</hi></signed></closer>



                <xi:include href="d151-a1.xml" xpointer="d151-a1"/>
                <xi:include href="d151-a2.xml" xpointer="d151-a2"/>
            </div>
