    <text>
        <body>
            <div xml:id="d150">

                <pb facs="0348" n="224" sameAs="frus:frus1923v02/pg224"/>

                <note rend="inline" type="source">867n.01/363: Telegram</note>
                <head><hi rendition="#italic">The Vice Consul at Jerusalem</hi> (<hi rendition="#italic">Cobb</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Jerusalem</hi></placeName>, <date calendar="gregorian"
                            when="1923-10-31T10:00:00+02:00"><hi rendition="#italic">October 31,
                                1923—10 a.m.</hi></date><lb/>[Received 7 p.m.]</dateline></opener>
                <p>Officially informed Palestine mandate definitely effective September 29th.
                    Increasing difficulties with civil courts. Protested to local government who
                    have again requested instructions from London.</p>
                <closer><signed><hi rendition="#small-caps">Cobb</hi></signed></closer>
            </div>
        </body>
    </text>
