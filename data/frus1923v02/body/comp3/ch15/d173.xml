    <text>
        <body>
            <div xml:id="d173">

                <pb facs="0407" n="283" sameAs="frus:frus1923v02/pg283"/>

                <note rend="inline" type="source">811.7353b W 52/101</note>
                <head><hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Harvey</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1923-04-20"><hi rendition="#italic">April 20,
                        1923</hi></date>.<lb/>[Received April 30.]</dateline>
                    <seg rendition="#float-left">No. 2273</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to my telegram No. 117, of
                    April 19, 5 p.m., 1923,<anchor n="79" xml:id="d173-f1"/> I have the honor to
                    forward herewith copy, in triplicate, of the Foreign Office Note No. A
                    2051/319/45, of April 18, 1923, relative to the Azores cable situation.</p>
                <p>I have [etc.]</p>
                <closer>For the Ambassador:<lb/><signed><hi rendition="#small-caps">Post
                            Wheeler</hi></signed></closer>


                <xi:include href="d173-a1.xml" xpointer="d173-a1"/>
            </div>
        </body>
    </text>
