                <pb facs="0729" n="605" sameAs="frus:frus1923v02/pg605"/>

                <note rend="inline" type="source">817.00/2932: Telegram</note>
                <head><hi rendition="#italic">The Minister in Nicaragua</hi> (<hi rendition="#italic">Ramer</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Managua</hi></placeName>, <date calendar="gregorian"
                            when="1923-03-17T11:00:00-05:45"><hi rendition="#italic">March 17,
                                1923—11 a.m.</hi></date><lb/>[Received March 18—12:30
                        a.m.]</dateline></opener>
                <p>22. Dodds law passed Congress yesterday with few minor changes of no
                        importance.<anchor n="2" xml:id="d548-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Ramer</hi></signed></closer>
            </div>
        </body>
    </text>
