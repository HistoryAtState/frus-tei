                <pb facs="0192" n="68" sameAs="frus:frus1923v02/pg68"/>

                <note rend="inline" type="source">462.00 R 296/16</note>
                <head><hi rendition="#italic">The British Chargé</hi> (<hi rendition="#italic"
                        >Chilton</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1923-10-13"><hi rendition="#italic">October 13,
                        1923</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I enclose herein an <hi
                        rendition="#italic">Aide-Mémoire</hi> recording the communication which I
                    made to you this morning.</p>
                <p>I am [etc.]</p>
                <closer><signed><hi rendition="#small-caps">H. G. Chilton</hi></signed></closer>


                <xi:include href="d47-a1.xml" xpointer="d47-a1"/>
