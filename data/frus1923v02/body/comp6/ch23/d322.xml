            <div xml:id="d322">

                <pb facs="0538" n="414" sameAs="frus:frus1923v02/pg414"/>

                <note rend="inline" type="source">838.51/1489: Telegram</note>
                <head><hi rendition="#italic">The High Commissioner in Haiti</hi> (<hi
                        rendition="#italic">Russell</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Port au Prince</hi></placeName>, <date calendar="gregorian"
                            when="1923-01-18T14:00:00-05:00"><hi rendition="#italic">January 18,
                                1923—2 p.m.</hi></date><lb/>[Received January 19—11:25
                        a.m.]</dateline></opener>
                <p>8. Department’s 10, January 16, 11 a.m.<anchor n="33" xml:id="d322-f1"/>
                    Instructions have been sent to Haitian Legation, Paris, to publish redemption
                    notice of 1910 bonds at once.</p>
                <closer><signed><hi rendition="#small-caps">Russell</hi></signed></closer>
            </div>
        </body>
    </text>
