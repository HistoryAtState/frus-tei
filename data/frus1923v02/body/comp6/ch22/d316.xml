            <div xml:id="d316">

                <pb facs="0534" n="410" sameAs="frus:frus1923v02/pg410"/>

                <note rend="inline" type="source">438.00/264: Telegram</note>
                <head><hi rendition="#italic">The High Commissioner in Haiti</hi> (<hi rendition="#italic">Russell</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Port au Prince</hi></placeName>, <date calendar="gregorian"
                            when="1923-06-15T16:00:00-05:00"><hi rendition="#italic">June 15, 1923—4
                                p.m.</hi></date><lb/>[Received 7:24 p.m.]</dateline></opener>
                <p>82. Department’s 62, May 28, 5 p.m. Haitian Government agrees to limiting
                    jurisdiction of Claims Commission to claims arising before May 3d, 1916.</p>
                <closer><signed><hi rendition="#small-caps">Russell</hi></signed></closer>
            </div>
        </body>
    </text>
