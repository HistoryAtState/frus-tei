    <text>
        <body>
            <div xml:id="d10">

                <pb facs="0137" n="13" sameAs="frus:frus1923v02/pg13"/>

                <note rend="inline" type="source">711.5112/72a</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the French Ambassador</hi> (<hi rendition="#italic"
                            >Jusserand</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1923-06-25"><hi rendition="#italic">June 25,
                        1923</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Ambassador</hi>: Permit me to enclose in
                    further response to your suggestion of yesterday, a draft of a proposed
                    agreement for the renewal of the Arbitration Treaty with France.<anchor n="20"
                        xml:id="d10-f1"/> This <pb facs="0138" n="14" xml:id="pg14"/> is similar to
                    the agreement which was signed on Saturday with Great Britain when the notes to
                    which I referred in my first letter today were exchanged.</p>
                <p>Very sincerely yours,</p>
                <closer><signed><hi rendition="#small-caps">Charles E. Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d10-f1" n="20" xml:id="d10-f1-content">
                <p>Enclosure not printed.</p>
            </note>
