                <pb facs="0800" n="676" sameAs="frus:frus1923v02/pg676"/>

                <note rend="inline" type="source">711.192/7</note>
                <head><hi rendition="#italic">President Coolidge to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >The White House</hi></placeName>, <date calendar="gregorian"
                            when="1923-10-15"><hi rendition="#italic">October 15,
                        1923</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: Replying to your letter
                    of October 15th, suggesting that notice be given to the Government of Panama of
                    the intention to abrogate the Taft Agreement, I am writing to authorize you to
                    inform the Panaman Government that the Government of the United States will
                    abrogate the so-called Taft Agreement on May 1, 1924.</p>
                <p>Very truly yours,</p>
                <closer><signed><hi rendition="#small-caps">Calvin Coolidge</hi></signed></closer>
            </div>
        </body>
    </text>
