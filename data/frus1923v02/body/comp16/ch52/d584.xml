    <text>
        <body>
            <div xml:id="d584">

                <pb facs="0812" n="688" sameAs="frus:frus1923v02/pg688"/>

                <note rend="inline" type="source">819.51/366: Telegram</note>
                <head><hi rendition="#italic">The Minister in Panama</hi> (<hi
                            rendition="#italic">South</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Panama</hi></placeName>, <date calendar="gregorian"
                            when="1923-02-17T11:00:00-05:00"><hi rendition="#italic">February 17,
                                1923—11 a.m.</hi></date><lb/>[Received 8:33
                    p.m.]</dateline></opener>
                <p>14. My despatch no. 192, January 15th.<anchor n="33" xml:id="d584-f1"/> President
                    yesterday approved bill authorizing loan up to $4,500,000 for road building
                    purposes. Section providing for withdrawal from the United States of
                    six-million-dollar fund eliminated.</p>
                <closer><signed><hi rendition="#small-caps">South</hi></signed></closer>
            </div>
        </body>
    </text>
