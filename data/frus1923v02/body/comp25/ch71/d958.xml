    <text>
        <body>
            <div xml:id="d958">

                <pb facs="1263" n="1139" sameAs="frus:frus1923v02/pg1139"/>

                <note rend="inline" type="source">711.672/170</note>
                <head><hi rendition="#italic">The Turkish Plenipotentiary</hi> (<hi rendition="#italic">Ismet</hi>) <hi
                        rendition="#italic">to the American Plenipotentiary</hi> (<hi rendition="#italic">Grew</hi>)<anchor n="17"
                        xml:id="d958-f1"/></head>
                <opener><seg rendition="#center">[Translation]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Lausanne</hi></placeName>, <date calendar="gregorian"
                            when="1923-08-04"><hi rendition="#italic">August 4,
                        1923</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Mr. Minister</hi>: In response to the desire
                    expressed by Your Excellency, I have the honor to transmit to you herewith, for
                    your information, copies of the two Declarations relative to the judicial
                    administration and to the employment in the service of the Turkish sanitary
                    administration of several European specialists. These declarations have each a
                    duration of five years.</p>
                <p>Accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps">M. Ismet</hi></signed></closer>




                <xi:include href="d958-a1.xml" xpointer="d958-a1"/>
                <xi:include href="d958-a2.xml" xpointer="d958-a2"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d958-f1" n="17" type="source" xml:id="d958-f1-content">
                <p>Transmitted with despatch no. 56–A, Aug. 7, from the Special Mission at
                    Lausanne.</p>
            </note>
        </listAnnotation>
    </standOff>
