    <text>
        <body>
            <div xml:id="d982">

                <pb facs="1312" n="1188" sameAs="frus:frus1923v02/pg1188"/>

                <note rend="inline" type="source">467.11 W 89/42: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the High Commissioner at Constantinople</hi> (<hi
                            rendition="#italic">Bristol</hi>)</head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1923-12-20T18:00:00-05:00"><hi rendition="#italic">December 20,
                                1923—6 p.m.</hi></date></dateline></opener>
                <p>234. You are authorized to sign communication quoted in your telegram 332 of
                    December 19,<anchor n="44" xml:id="d982-f1"/> it being understood that Adnan <pb
                        facs="1313" n="1189" xml:id="pg1189"/> Bey will address a communication to
                    you, <hi rendition="#italic">mutatis mutandis</hi>, like the one you address to
                    him.</p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d982-f1" n="44" xml:id="d982-f1-content">
                <p>Not printed; the text submitted for approval in telegram 332 was substantially
                    the same as the translation of the letter of Dec. 24 from Admiral Bristol to
                    Adnan Bey, printed <ref target="#pg1190">p. 1190</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
