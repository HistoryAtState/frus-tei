    <text>
        <body>
            <div xml:id="d842">

                <pb facs="1118" n="994" sameAs="frus:frus1923v02/pg994"/>

                <note rend="inline" type="source">767.68119 P/22</note>
                <head><hi rendition="#italic">The Special Mission at Lausanne to the Secretary of
                        State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Lausanne</hi></placeName>, <date calendar="gregorian"
                            when="1923-04-30"><hi rendition="#italic">April 30,
                        1923</hi></date>.<lb/>[Received May 10.]</dateline>
                    <seg rendition="#float-left">No. 2–A</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith a
                    copy and translation of the text of the so-called Montagna formula, together
                    with a copy and translation of the new draft declaration which this Mission is
                    informed will be presented by Sir Horace Rumbold at an early meeting of his
                        Committee,<anchor n="7" xml:id="d842-f1"/> when the Judicial Capitulations
                    will be <pb facs="1119" n="995" xml:id="pg995"/> discussed. The Department has
                    already been informed by telegram<anchor n="8" xml:id="d842-f2"/> of the
                    variations between the original draft declaration, presented with the treaty in
                    February last and the Montagna draft.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">F. L. Belin</hi></signed><lb/><hi
                        rendition="#italic">Secretary General</hi></closer>


                <xi:include href="d842-a1.xml" xpointer="d842-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d842-f1" n="7" xml:id="d842-f1-content">
                <p>Rumbold formula not printed.</p>
            </note>
            <note corresp="#d842-f2" n="8" xml:id="d842-f2-content">
                <p>Telegram no. 14, Feb. 8, from the Minister in Switzerland, <ref target="#pg968"
                        >p. 968</ref>.</p>
            </note>
        </listAnnotation>
