                <pb facs="0693" n="569" sameAs="frus:frus1923v02/pg569"/>

                <note rend="inline" type="source">812.24/200: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Minister in
                        Guatemala</hi> (<hi rendition="#italic">Geissler</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1923-12-29T11:00:00-05:00"><hi rendition="#italic">December 29,
                                1923—11 a.m.</hi></date></dateline></opener>
                <p>71. Your 101, December 28, noon.</p>
                <p>In the understanding that the sales are to be made to the recognized Government
                    of Mexico, the Department perceives no objection.</p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
