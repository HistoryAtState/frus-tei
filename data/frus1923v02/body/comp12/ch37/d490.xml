    <text>
        <body>
            <div xml:id="d490">

                <pb facs="0679" n="555" xml:id="pg555"/>

                <note rend="inline" type="source">123 Su 6/113: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Mexico</hi> (<hi
                            rendition="#italic">Summerlin</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico City</hi></placeName>, <date calendar="gregorian"
                            when="1923-09-03T13:00:00-07:00"><hi rendition="#italic">September 3,
                                1923—1 p.m.</hi></date><lb/>[Received 6:50 p.m.]</dateline></opener>
                <p>91. Your telegram no. 129, August 31, noon.<anchor n="28" xml:id="d490-f1"/> Your
                    telegraphic letter of credence was presented to and accepted by Mexican Minister
                    for Foreign Affairs at noon today.</p>
                <closer><signed><hi rendition="#small-caps">Summerlin</hi></signed></closer>
            </div>
        </body>
    </text>
