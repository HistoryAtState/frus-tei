                <pb facs="0659" n="535" sameAs="frus:frus1923v02/pg535"/>

                <note rend="inline" type="source">711.1211/98b</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Chargé in Mexico</hi> (<hi rendition="#italic"
                            >Summerlin</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1923-05-05"><hi rendition="#italic">May 5,
                        1923</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 2431</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I enclose, for your information and
                    guidance, a copy of a letter which I have addressed to the American members of
                    the United States-Mexican Commission, in regard to the Department’s desire <pb
                        facs="0660" n="536" xml:id="pg536"/> that the appropriate representatives in
                    Mexico of Cuba, Belgium, France, Great Britain and Poland be given timely advice
                    of such developments arising out of their conferences with the Mexican
                    Commissioners as may be suitable and will not embarrass their negotiations.</p>
                <p>I am [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Charles E. Hughes</hi></signed></closer>


                <xi:include href="d480-a1.xml" xpointer="d480-a1"/>
            </div>
