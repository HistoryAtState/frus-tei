    <text>
        <body>
            <div xml:id="d472">

                <pb facs="0647" n="523" xml:id="pg523"/>

                <note rend="inline" type="source">711.1211/61</note>
                <head><hi rendition="#italic">The Chargé in Mexico</hi> (<hi rendition="#italic"
                        >Summerlin</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Mexico City</hi></placeName>,] <date calendar="gregorian"
                            when="1923-04-05"><hi rendition="#italic">April 5,
                        1923</hi></date>.<lb/>[Received April 12(?)]</dateline>
                    <seg rendition="#float-left">No. 7270</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In confirmation of my telegram No. 21,
                    April 4, 5 P.M.,<anchor n="3" xml:id="d472-f1"/> and with reference to your
                    informal instruction dated July 28, 1923 [<hi rendition="#italic"
                        >1922</hi>],<anchor n="4" xml:id="d472-f2"/> and to previous correspondence,
                    in regard to the proposed Treaty of Amity and Commerce, I have the honor to
                    enclose herewith a copy and translation of Mr. Pani’s informal note dated March
                    31, 1923, which was delivered to me yesterday by a member of the Protocol
                    Section of the Foreign Office.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">George T.
                    Summerlin</hi></signed></closer>


                <xi:include href="d472-a1.xml" xpointer="d472-a1"/>
            </div>
        </body>
    </text>
