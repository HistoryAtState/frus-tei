        <body>
            <div xml:id="d28-a8">

                <pb facs="0516" n="506" sameAs="frus:frus1919Parisv10/pg506"/>

                <head>Appendix 253</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Rotterdam</hi></placeName>, <date calendar="gregorian"
                            when="1919-07-23">July 23, 1919</date>.</dateline></opener>
                <p rendition="#center">[<hi rendition="#italic">Cablegram From the Rotterdam Food
                        Commission</hi>]</p>
                <p>Rotterdam Food Commission requests definite instructions to continue or cease
                    functioning addressed officially to it as an Inter-Allied Commission, British
                    and American members have been instructed individually, French have no
                    instructions.</p>
                <closer><signed><hi rendition="#small-caps">Hocking</hi></signed><lb/><hi
                        rendition="#italic">Secretary, British Consulate</hi></closer>
            </div>
        </body>
