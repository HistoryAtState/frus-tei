    <text>
        <body>
            <div xml:id="d28-a12">

                <pb facs="0522" n="512" sameAs="frus:frus1919Parisv10/pg512"/>

                <head>Appendix 255</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1919-06-28">June 28, 1919</date>.</dateline></opener>
                <p rendition="#center"><hi rendition="#italic">Memorandum From the Roumanian
                        Delegation Regarding the Administration of the Danube</hi></p>
                <p><hi rendition="#small-caps">M. le Président</hi>: I have the honour to enclose
                    herewith a memorandum on the situation created in Roumania by the measures
                    adopted by the Supreme Council of the Allied Armies regarding the administration
                    of the Danube.</p>
                <closer><signed><hi rendition="#small-caps">Bratiano</hi></signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">To the President of the Inter-Allied<lb/>Supreme
                            Economic Council.</hi></p>
                </postscript>
            </div>
        </body>
