                <pb facs="0718" n="681" xml:id="pg681"/>

                <head>116. Minutes of a National Security Planning Group Meeting<anchor n="1"
                        xml:id="d116-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            from="1987-12-15T14:00:00-05:00" to="1987-12-15T14:45:00-05:00">December
                            15, 1987, 2–2:45 p.m.</date>
                    </dateline>
                </opener>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>Covert Action Update</item>
                </list>
                <list subtype="participants" type="description">
