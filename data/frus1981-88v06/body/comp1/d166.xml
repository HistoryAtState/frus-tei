                <head>166. Minutes of a National Security Planning Group Meeting<anchor n="1"
                        xml:id="d166-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            from="1988-07-11T14:00:00-04:00" to="1988-07-11T15:00:00-04:00">July 11,
                            1988, 2–3 p.m.</date>
                    </dateline>
                </opener>
                <list subtype="subject" type="description">
