                <pb facs="0484" n="394" xml:id="pg394"/>

                <note rend="inline" type="source">763.72119/10074b: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        Belgium</hi> (<hi rendition="#italic">Whitlock</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-06-26T15:00:00-04:00"><hi rendition="#italic">June 26, 1920—3
                                p.m.</hi></date></dateline></opener>
                <p>56. Please cable brief summary of all available information concerning results
                    reached at recent Hythe and Boulogne conferences. Send full report by pouch.</p>
                <closer><signed><hi rendition="#small-caps">Davis</hi></signed></closer>
            </div>
        </body>
    </text>
