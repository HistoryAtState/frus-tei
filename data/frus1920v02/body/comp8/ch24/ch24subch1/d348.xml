            <div xml:id="d348">

                <pb facs="0496" n="406" sameAs="frus:frus1920v02/pg406"/>

                <note rend="inline" type="source">763.72119/10284</note>
                <head><hi rendition="#italic">The Chargé in France</hi> (<hi
                            rendition="#italic">Harrison</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1920-07-30"><hi rendition="#italic">July 30,
                        1920</hi></date>.<lb/>[Received August 10.]</dateline>
                    <seg rendition="#float-left">No. 1457</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith six
                    copies of a document furnished me by Mr. Roland W. Boyden, being an Agreement
                    between the Allies for the Settlement of certain questions as to the Application
                    of the Treaties of Peace and complementary agreements with Germany, Austria,
                    Hungary and Bulgaria.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Leland Harrison</hi></signed></closer>


                <xi:include href="d348-a1.xml" xpointer="d348-a1"/>
            </div>
