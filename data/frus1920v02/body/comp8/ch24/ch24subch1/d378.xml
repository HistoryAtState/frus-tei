                <pb facs="0535" n="445" sameAs="frus:frus1920v02/pg445"/>

                <note rend="inline" type="source">462.00 R 29/412: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        France</hi> (<hi rendition="#italic">Wallace</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-12-15T13:00:00-05:00"><hi rendition="#italic">December 15,
                                1920—1 p.m.</hi></date></dateline></opener>
                <p>1700. Your 2006, December 13, 5 p.m.</p>
                <p>See Department’s 1684, B–168 for Boyden.</p>
                <p>You are requested to inform the French Foreign Office that this Government does
                    not deem it practicable to be represented at the conference at Brussels on
                    December 15.</p>
                <closer><signed><hi rendition="#small-caps">Davis</hi></signed></closer>
            </div>
        </body>
