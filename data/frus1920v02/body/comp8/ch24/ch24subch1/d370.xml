            <div xml:id="d370">

                <pb facs="0527" n="437" sameAs="frus:frus1920v02/pg437"/>

                <note rend="inline" type="source">462.00 R 29/337</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the British Ambassador</hi> (<hi rendition="#italic"
                            >Geddes</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-09-23"><hi rendition="#italic">September 23,
                        1920</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Ambassador</hi>: In reply to your note of
                    September 13, 1920, and the memorandum enclosed therewith, in regard to the
                    Geneva Conference, I hasten to outline the position of this Government on the
                    questions you were good enough to raise.</p>
                <p>Very sincerely yours,</p>
                <closer><signed><hi rendition="#small-caps">Bainbridge Colby</hi></signed></closer>


                <xi:include href="d370-a1.xml" xpointer="d370-a1"/>
