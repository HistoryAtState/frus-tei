            <div xml:id="d369">

                <pb facs="0525" n="435" sameAs="frus:frus1920v02/pg435"/>

                <note rend="inline" type="source">462.00 R 29/337</note>
                <head><hi rendition="#italic">The British Ambassador</hi> (<hi rendition="#italic"
                        >Geddes</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-09-13"><hi rendition="#italic">September 13,
                        1920</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: In accordance with the
                    promise which I gave you yesterday, I send you, herewith, a short memorandum <pb
                        facs="0526" n="436" xml:id="pg436"/> summarizing the position which has
                    arisen with regard to the proposed conference at Geneva on September 24th.</p>
                <p>Believe me [etc.]</p>
                <closer><signed><hi rendition="#small-caps">A. C. Geddes</hi></signed></closer>


                <xi:include href="d369-a1.xml" xpointer="d369-a1"/>
