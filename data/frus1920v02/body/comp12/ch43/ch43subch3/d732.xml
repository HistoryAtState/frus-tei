    <text>
        <body>
            <div xml:id="d732">

                <pb facs="0919" n="829" sameAs="frus:frus1920v02/pg829"/>

                <note rend="inline" type="source">438.00/111</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the French
                        Chargé</hi> (<hi rendition="#italic">Béarn</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-10-29"><hi rendition="#italic">October 29,
                        1920</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith a
                    memorandum replying to your note of August 30, last,<anchor n="74"
                        xml:id="d732-f1"/> which conveyed instructions received <pb facs="0920"
                        n="830" xml:id="pg830"/> from the French Government regarding the
                    appointment of the Claims Commission provided for in the Protocol signed between
                    the American and Haitian Governments on October 3, 1919.</p>
                <p>Accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Norman H. Davis</hi></signed></closer>


                <xi:include href="d732-a1.xml" xpointer="d732-a1"/>
            </div>
        </body>
    </text>
