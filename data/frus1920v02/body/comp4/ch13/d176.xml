    <text>
        <body>
            <div xml:id="d176">

                <pb facs="0303" n="213" sameAs="frus:frus1920v02/pg213"/>

                <note rend="inline" type="source">822.6363/27</note>
                <head><hi rendition="#italic">The Minister in Ecuador</hi> (<hi rendition="#italic"
                        >Hartman</hi>) <hi rendition="#italic">to the Acting Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Quito</hi></placeName>, <date calendar="gregorian"
                            when="1920-12-21"><hi rendition="#italic">December 21,
                        1920</hi></date>.<lb/>[Received January 15, 1921.]</dateline>
                    <seg rendition="#float-left">No. 626</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to confirm my telegram No.
                    82 of December 17, 11 a.m.,<anchor n="40" xml:id="d176-f1"/> wherein I gave
                    present status of Ecuadorean oil legislation and transmitted the body of the
                    decree approved November 25, 1920.</p>
                <p>I now enclose, for the information of the Department, triplicate copies of <hi
                        rendition="#italic">Registro Oficial</hi> containing the said decree of
                    November 25, 1920, together with triplicate copies of the translation of the
                    decree.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Chas. S. Hartman</hi></signed></closer>



                <xi:include href="d176-a1.xml" xpointer="d176-a1"/>
            </div>
        </body>
    </text>
