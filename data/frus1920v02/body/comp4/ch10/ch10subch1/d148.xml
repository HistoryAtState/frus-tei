    <text>
        <body>
            <div xml:id="d148">

                <pb facs="0275" n="185" sameAs="frus:frus1920v02/pg185"/>

                <note rend="inline" type="source">822.51/312</note>
                <head><hi rendition="#italic">Mr. C. H. Hand, Jr.,
                        of Brown Brothers and Company, to the Acting Chief of the Division of Latin
                        American Affairs, Department of State</hi> (<hi
                            rendition="#italic">Welles</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >New York</hi></placeName>, <date calendar="gregorian"
                            when="1920-10-20"><hi rendition="#italic">October 20,
                        1920</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. Welles</hi>: I am enclosing herewith a
                    memorandum showing the plan which we thought might be followed in refunding the
                    Ecuadorian foreign debt,<anchor n="10" xml:id="d148-f1"/> as I promised I would
                    send you upon my last visit to Washington when you were so kind as to say that
                    you would cable the Legation at Quito to the effect that Mr. Lindberg would have
                    this matter in hand for us and notify the Legation to cooperate with him.</p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>Very truly yours,</p>
                <closer><signed><hi rendition="#small-caps">C. H. Hand</hi>, Jr.</signed></closer>


                <xi:include href="d148-a1.xml" xpointer="d148-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d148-f1" n="10" xml:id="d148-f1-content">
                <p>Based on a plan submitted to the Department July 15, 1920 (file no.
                    822.51/302).</p>
            </note>
        </listAnnotation>
    </standOff>
