    <text>
        <body>
            <div xml:id="d207">

                <pb facs="0346" n="256" sameAs="frus:frus1920v02/pg256"/>

                <note rend="inline" type="source">760d.61/31</note>
                <head><hi rendition="#italic">The Finnish Minister</hi> (<hi rendition="#italic"
                        >Saastamoinen</hi>) <hi rendition="#italic">to the Acting Secretary of
                        State</hi></head>
                <opener><seg rendition="#float-left">No. 12</seg></opener>
                <p>The Envoy Extraordinary and Minister Plenipotentiary of Finland presents his
                    compliments to the Acting Secretary of State and respectfully begs to advise
                    that the treaty of peace between Finland and Russia became effective at 6:25
                    p.m. December 31, 1920.</p>
                <closer>
                    <dateline rendition="#float-left">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1921-01-04"><hi
                                rendition="#italic">January 4, 1921</hi></date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
