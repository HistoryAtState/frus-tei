                <pb facs="0103" n="13" sameAs="frus:frus1920v02/pg13"/>

                <note rend="inline" type="source">837.00/1673: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Cuba</hi> (<hi
                            rendition="#italic">White</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Habana</hi></placeName>, <date calendar="gregorian"
                            when="1920-05-27T15:00:00-05:29"><hi rendition="#italic">May 27, 1920—3
                                p.m.</hi></date><lb/>[Received 6:30 p.m.]</dateline></opener>
                <p>119. General Electoral Board yesterday recognized Partido Popular Cubano of
                    Doctor Alfredo Zayas as a national party.</p>
                <closer><signed><hi rendition="#small-caps">White</hi></signed></closer>
            </div>
        </body>
