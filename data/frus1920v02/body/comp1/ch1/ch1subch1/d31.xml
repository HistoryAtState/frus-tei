            <div xml:id="d31">

                <pb facs="0114" n="24" sameAs="frus:frus1920v02/pg24"/>

                <note rend="inline" type="source">837.00/1772: Telegram</note>
                <head><hi rendition="#italic">The Minister in Cuba</hi> (<hi
                            rendition="#italic">Long</hi>) <hi rendition="#italic">to the
                            Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Habana</hi></placeName>, <date calendar="gregorian"
                            when="1920-09-27T17:00:00-05:29"><hi rendition="#italic">September 27,
                                1920—5 p.m.</hi></date><lb/>[Received 11:09
                    p.m.]</dateline></opener>
                <p>228. Supreme Court September 25 upheld Zayas against Montalvo as legal candidate
                    of the Conservative Party for President in the elections. This decision clears
                    the way for the National League. Details by mail.<anchor n="36" xml:id="d31-f1"
                    /></p>
                <closer><signed><hi rendition="#small-caps">Long</hi></signed></closer>
            </div>
        </body>
    </text>
