    <text>
        <body>
            <div xml:id="d11">

                <pb facs="0100" n="10" sameAs="frus:frus1920v02/pg10"/>

                <note rend="inline" type="source">837.00/1650</note>
                <head><hi rendition="#italic">The Minister in Cuba</hi> (<hi rendition="#italic"
                        >Long</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Habana</hi></placeName>, <date calendar="gregorian"
                            when="1920-04-02"><hi rendition="#italic">April 2,
                        1920</hi></date>.<lb/>[Received April 8.]</dateline>
                    <seg rendition="#float-left">No. 64</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith, as
                    stated in my telegram of April 1, 3 p.m.,<anchor n="17" xml:id="d11-f1"/> a copy
                    of supplementary memorandum by Dr. Desvernine expressing his views on the
                    amendments of the electoral law, other than article No. 120 thereof.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Boaz W. Long</hi></signed></closer>


                <xi:include href="d11-a1.xml" xpointer="d11-a1"/>
            </div>
        </body>
    </text>
