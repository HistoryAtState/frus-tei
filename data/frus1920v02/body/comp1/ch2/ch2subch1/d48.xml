            <div xml:id="d48">

                <pb facs="0134" n="44" sameAs="frus:frus1920v02/pg44"/>

                <note rend="inline" type="source">837.51/354</note>
                <head><hi rendition="#italic">The Minister in Cuba</hi> (<hi
                            rendition="#italic">Long</hi>) <hi rendition="#italic">to the
                            Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Habana</hi></placeName>, <date calendar="gregorian"
                            when="1920-10-12"><hi rendition="#italic">October 12,
                        1920</hi></date>.<lb/>[Received October 19.]</dateline>
                    <seg rendition="#float-left">No. 449</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to recent telegrams in regard to
                    the Moratorium Decreed by the President on the 10th Instant, I have the honor to
                    transmit, herewith, copies of the Extraordinary Edition (No. 43) of the <hi
                        rendition="#italic">Official Gazette</hi> of October 10, 1920, in which this
                    decree (No. 1583) is published. A translation of the decree published in the
                    Havana <hi rendition="#italic">Post</hi> today is also enclosed herewith.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Boaz W. Long</hi></signed></closer>


                <xi:include href="d48-a1.xml" xpointer="d48-a1"/>
            </div>
