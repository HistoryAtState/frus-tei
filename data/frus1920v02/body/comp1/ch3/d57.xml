            <div xml:id="d57">

                <pb facs="0149" n="59" xml:id="pg59"/>

                <note rend="inline" type="source">837.73/2a: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Chargé in Cuba</hi> (<hi
                        rendition="#italic">White</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-06-03T13:00:00-04:00"><hi rendition="#italic">June 3, 1920—1
                                p.m.</hi></date></dateline></opener>
                <p>89. Thomas R. Strahan, of Root, Clark, Buckner and Howland, is at Hotel Sevilla
                    to further interests of All America Cables. Please lend him all proper
                    assistance.</p>
                <closer><signed><hi rendition="#small-caps">Colby</hi></signed></closer>
            </div>
        </body>
    </text>
