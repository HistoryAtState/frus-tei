        <body>
            <div xml:id="d800">

                <pb facs="0966" n="876" xml:id="pg876"/>

                <note rend="inline" type="source">815.51/407</note>
                <head><hi rendition="#italic">The Chargé in Honduras</hi> (<hi rendition="#italic"
                        >Spencer</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Tegucigalpa</hi></placeName>, <date calendar="gregorian"
                            when="1920-09-29"><hi rendition="#italic">September 29,
                        1920</hi></date>.<lb/>[Received October 19.]</dateline>
                    <seg rendition="#float-left">No. 19</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith a
                    memorandum given me by Dr. Young, Financial Advisor to the Republic of Honduras,
                    of his conversation had at my suggestion with the President yesterday.</p>
                <p>The memorandum is so exact that I am glad to transmit it in its original
                    form.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Willing Spencer</hi></signed></closer>


                <xi:include href="d800-a1.xml" xpointer="d800-a1"/>
            </div>
