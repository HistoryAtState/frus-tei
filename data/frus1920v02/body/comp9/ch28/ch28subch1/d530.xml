            <div xml:id="d530">

                <pb facs="0725" n="635" xml:id="pg635"/>

                <note rend="inline" type="source">341.115L89/10: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Consul General at
                        London</hi> (<hi rendition="#italic">Skinner</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-02-02T18:00:00-05:00"><hi rendition="#italic">February 2,
                                1920—6 p.m.</hi></date></dateline></opener>
                <p>Your January 17, 1 p.m.</p>
                <p>Telegraph whether Procurator General has obtained instructions from President
                    Prize Court applicable to all similar claims.</p>
                <closer><signed><hi rendition="#small-caps">Lansing</hi></signed></closer>
            </div>
        </body>
    </text>
