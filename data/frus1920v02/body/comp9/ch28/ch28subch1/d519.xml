    <text>
        <body>
            <div xml:id="d519">

                <pb facs="0718" n="628" xml:id="pg628"/>

                <note rend="inline" type="source">300.115/15001: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Consul General at
                        London</hi> (<hi rendition="#italic">Skinner</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1919-03-11T16:00:00-05:00"><hi rendition="#italic">March 11,
                                1919—4 p.m.</hi></date></dateline></opener>
                <p>Your February 27, 3 p.m. Ask Embassy for copy of Department’s 180, July 12
                        last.<anchor n="27" xml:id="d519-f1"/> Embassy has been instructed to give
                    you copy.</p>
                <closer><signed><hi rendition="#small-caps">Polk</hi></signed></closer>
            </div>
        </body>
    </text>
