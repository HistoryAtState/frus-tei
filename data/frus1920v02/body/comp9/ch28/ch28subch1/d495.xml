    <text>
        <body>
            <div xml:id="d495">

                <pb facs="0691" n="[601]" sameAs="frus:frus1920v02/pg601"/>

                <note rend="inline" type="source">763.72112/3729a Suppl.: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Consul General at
                        London</hi> (<hi rendition="#italic">Skinner</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1917-06-14T17:00:00-05:00"><hi rendition="#italic">June 14, 1917—5
                                p.m.</hi></date></dateline></opener>
                <p>Department’s May 29, 5 p.m., Prize Court cases.</p>
                <p>Include in report cases in hands of Procurator-General under Order in Council
                    March 11, 1915 which have not been presented to Prize Court.<anchor n="1"
                        xml:id="d495-f1"/> Hasten reply as much as possible.</p>
                <closer><signed><hi rendition="#small-caps">Lansing</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d495-f1" n="1" xml:id="d495-f1-content">
                <p>For order in council of Mar. 11, 1915, see <ref target="frus1915Supp#pg_144"><hi
                            rendition="#italic">Foreign Relations</hi>, 1915, supp., p.
                    144</ref>.</p>
            </note>
