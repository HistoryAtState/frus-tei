    <text>
        <body>
            <div xml:id="d553">

                <pb facs="0758" n="668" sameAs="frus:frus1920v02/pg668"/>

                <note rend="inline" type="source">800.6363/196 A</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Ambassador in Great Britain</hi> (<hi
                            rendition="#italic">Davis</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-11-23"><hi rendition="#italic">November 23,
                        1920</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1040</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my telegram No. 1169 [<hi
                        rendition="#italic">1168</hi>] of November 20<anchor n="80" xml:id="d553-f1"
                    /> and to your telegraphic reply No. 1639, November 22, 4:35 P.M.,<anchor n="80"
                        xml:id="d553-f2"/> I transmit herewith the signed communication to Lord
                    Curzon <pb facs="0759" n="669" xml:id="pg669"/> on the subject of petroleum
                    resources in the Near East. I request that you will hand this note to His
                    Lordship at your early convenience.</p>
                <p>I am [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Bainbridge Colby</hi></signed></closer>


                <xi:include href="d553-a1.xml" xpointer="d553-a1"/>
            </div>
        </body>
    </text>
