    <text>
        <body>
            <div xml:id="d569">

                <pb facs="0775" n="685" xml:id="pg685"/>

                <note rend="inline" type="source">741.9411/41: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">Crane</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1920-06-28T12:00:00+08:00"><hi rendition="#italic">June 28,
                                1920—noon</hi></date>.<lb/>[Received June 28—8:34
                    a.m.]</dateline></opener>
                <p>150. Department’s telegram June 22, 5 p.m. Chinese Government has protested
                    against mention of China in Anglo–Japanese Alliance Treaty when renewed. I am
                    sending a copy of the Chinese note by mail.<anchor n="92" xml:id="d569-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Crane</hi></signed></closer>
            </div>
        </body>
    </text>
