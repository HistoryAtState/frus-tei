            <div xml:id="d565">

                <pb facs="0772" n="682" xml:id="pg682"/>

                <note rend="inline" type="source">741.9411/33: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Ambassador in Great Britain</hi> (<hi rendition="#italic">Davis</hi>)</head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-05-24T19:00:00-04:00"><hi rendition="#italic">May 24, 1920—7
                                p.m.</hi></date></dateline></opener>
                <p>543. Your 833, May 21, 2 p.m. Use your own discretion in urging unofficially the
                    suggestions made in our 471, May 10, noon, using such channels of communication
                    as seem best to you.</p>
                <closer><signed><hi rendition="#small-caps">Polk</hi></signed></closer>
            </div>
        </body>
