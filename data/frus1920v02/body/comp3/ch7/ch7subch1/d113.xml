    <text>
        <body>
            <div xml:id="d113">

                <pb facs="0245" n="155" xml:id="pg155"/>

                <note rend="inline" type="source">839.00/2355</note>
                <head><hi rendition="#italic">The Secretary of the Navy</hi> (<hi rendition="#italic">Denby</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1921-03-09"><hi rendition="#italic">March 9,
                        1921</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to forward herewith for
                    the information of the Department of State, a copy of the Quarterly Report of
                    the Military Governor of Santo Domingo, for the period October 1 to December 31,
                    1920.</p>
                <p>Sincerely yours,</p>
                <closer><signed><hi rendition="#small-caps">Edwin Denby</hi></signed></closer>


                <xi:include href="d113-a1.xml" xpointer="d113-a1"/>
