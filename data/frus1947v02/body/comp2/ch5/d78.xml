                    <hi rendition="#small-caps">french delegation</hi>
                </p>
                <p rendition="#flush">
                    <hi rendition="#italic">Member</hi>
                </p>
                <p>
                    Georges Bidault, Minister for Foreign
                    Affairs</p>
                <p rendition="#flush">
                    <hi rendition="#italic">Deputy for Germany</hi>
                </p>
