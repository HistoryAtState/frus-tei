                <pb facs="0937" n="929" sameAs="frus:frus1938v02/pg929"/>

                <note rend="inline" type="source">867N.01/1101a: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Consul General at Jerusalem</hi> (<hi
                            rendition="#italic">Wadsworth</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1938-07-08T17:00:00-04:00">July 8, 1938—5 p.m.</date></dateline>
                </opener>
                <p>Please submit brief report regarding present situation, indicate whether any
                    American citizens have been injured and what steps you have taken to obtain
                    protection for American nationals.</p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
    </text>
