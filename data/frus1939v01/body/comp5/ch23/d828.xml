            <div xml:id="d828">

                <pb facs="0780" n="768" sameAs="frus:frus1939v01/pg768"/>

                <note rend="inline" type="source">855.001 Leopold/60</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Belgium</hi> (<hi rendition="#italic"
                            >Davies</hi>)</head>
                <opener>
                    <seg rendition="#float-left">No. 144</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1939-11-07">November 7,
                        1939</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: There is enclosed a letter from the
                    President to His Majesty the King of the Belgians in reply to a letter from King
                    Leopold dated September 26, 1939, which was handed to the President by Monsieur
                    Theunis.</p>
                <p>You are requested to convey this letter to His Majesty the King.</p>
                <p>Very truly yours,</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Sumner Welles</hi>
                    </signed>
                </closer>


                <xi:include href="d828-a1.xml" xpointer="d828-a1"/>
            </div>
        </body>
    </text>
