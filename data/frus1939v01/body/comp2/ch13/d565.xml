    <text>
        <body>
            <div xml:id="d565">

                <pb facs="0554" n="542" sameAs="frus:frus1939v01/pg542"/>

                <note rend="inline" type="source">740.00116 European War 1939/23a: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in the United
                        Kingdom</hi> (<hi rendition="#italic">Kennedy</hi>)<anchor n="16"
                        xml:id="d565-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1939-09-01T06:00:00-04:00">September 1,
                            1939—6 a.m.</date>
                    </dateline>
                </opener>
                <p>745. Department’s 744, September 1, 1939, 5 a.m. It is in the highest degree
                    important that the reply of the British Government be favorable and that it be
                    received at the earliest possible moment by the Department so that it may be
                    made public.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d565-f1" n="16" type="source" xml:id="d565-f1-content">
                <p>Sent, <hi rendition="#italic">mutatis mutandis</hi>, to Paris (No. 701), to Rome
                    (No. 86), and to Warsaw (No. 53).</p>
            </note>
        </listAnnotation>
    </standOff>
