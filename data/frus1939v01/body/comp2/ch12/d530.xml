    <text>
        <body>
            <div xml:id="d530">

                <pb facs="0518" n="506" sameAs="frus:frus1939v01/pg506"/>

                <note rend="inline" type="source">740.00119 European War 1939/44: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic"
                        >Bullitt</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1939-10-07T15:00:00+01:00">October 7, 1939—3
                            p.m.</date>
                        <lb/> [Received October 7—11:02 a.m.]</dateline>
                </opener>
                <p>2377. Leger<anchor n="81" xml:id="d530-f1"/> informed me this morning that the
                    French Government has decided that Hitler’s speech requires no reply and that
                    any observations on it may be made fittingly in the course of routine utterances
                    by members of the French and British Governments.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bullitt</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d530-f1" n="81" xml:id="d530-f1-content">
                <p>Secretary General of the French Foreign Office.</p>
            </note>
        </listAnnotation>
    </standOff>
