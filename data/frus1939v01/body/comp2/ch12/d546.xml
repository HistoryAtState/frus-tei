                <pb facs="0532" n="520" sameAs="frus:frus1939v01/pg520"/>

                <note rend="inline" type="source">740.00119 European War 1939/104: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in France</hi> (<hi rendition="#italic"
                            >Bullitt</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1939-10-25T19:00:00-05:00">October 25, 1939—7
                            p.m.</date>
                    </dateline>
                </opener>
                <p>1308. Your 2457, October 23, 1 p.m. You were quite right in assuming that this
                    Government would not instruct you to urge that the French Government accept
                    Mooney’s proposals. Please inform Kennedy.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
