    <text>
        <body>
            <div xml:id="d601">

                <pb facs="0573" n="561" sameAs="frus:frus1939v01/pg561"/>

                <note rend="inline" type="source">500.A15A5/968: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Italy</hi> (<hi
                            rendition="#italic">Phillips</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Rome</hi></placeName>, <date
                            calendar="gregorian" when="1939-10-14T14:00:00+01:00">October 14, 1939—2
                            p.m.</date>
                        <lb/> [Received October 14—11:05 a.m.]</dateline>
                </opener>
                <p>464. My telegram No. 441, October 5, 11 p.m.<anchor n="30" xml:id="d601-f1"/> By
                    note dated October 10th received today the Minister for Foreign Affairs formally
                    advises that “the Government of His Majesty the King of Italy and of Albania,
                    Emperor of Ethiopia has on its part decided to avail itself of the option
                    contemplated by article 24 paragraph 2 of naval treaty and declares the
                    operation thereof to be suspended insofar as it is concerned.”</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Phillips</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
