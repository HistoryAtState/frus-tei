                <pb facs="0621" n="609" sameAs="frus:frus1939v01/pg609"/>

                <note rend="inline" type="source">340.1115A/34a: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in France</hi>
                        (<hi rendition="#italic">Bullitt</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1939-09-19T19:00:00-04:00">September 19,
                            1939—7 p.m.</date>
                    </dateline>
                </opener>
                <p>993. Your 2048, September 19, noon. United States Lines understands that diverted
                    ships may carry aliens only when refusal might mean separation of American
                    families. This measure does not apply to ordinary runs of United States
                    Lines.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
