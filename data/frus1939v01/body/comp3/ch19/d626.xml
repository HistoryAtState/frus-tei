    <text>
        <body>
            <div xml:id="d626">

                <pb facs="0605" n="593" sameAs="frus:frus1939v01/pg593"/>

                <note rend="inline" type="source">811.111 Quota/2272: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in the United
                        Kingdom</hi> (<hi rendition="#italic">Kennedy</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1939-09-01T10:00:00-04:00">September 1,
                            1939—10 a.m.</date>
                    </dateline>
                </opener>
                <p>746. Your 1331, August 31, 3 p.m.<anchor n="12" xml:id="d626-f1"/> In view of the
                    need for steamship accommodations for American citizens and in order that the
                    Embassy staff may devote its attention to the needs of Americans in England,
                    consuls are authorized to suspend the issuance of quota immigration visas during
                    September so long as emergency continues.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
