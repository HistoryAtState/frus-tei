    <text>
        <body>
            <div xml:id="d647">

                <pb facs="0621" n="609" xml:id="pg609"/>

                <note rend="inline" type="source">340.1115A/24: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Frame</hi> (<hi
                            rendition="#italic">Bullitt</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1939-09-19T12:00:00+01:00">September 19,
                            1939—noon</date>.<lb/>[Received September 19—9 a.m.]</dateline>
                </opener>
                <p>2048.Your 982, September 18, 7 p.m. I take your telegram under reference to mean
                    that you have given appropriate instructions to the United States Lines.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bullitt</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
