            <div xml:id="d734">

                <pb facs="0706" n="694" sameAs="frus:frus1939v01/pg694"/>

                <note rend="inline" type="source">740.00111A Armed Merchantmen/1: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in France</hi> (<hi
                            rendition="#italic">Bullitt</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1939-09-17T15:00:00+01:00">September 17,
                            1939—3 p.m.</date>
                        <lb/> [Received September 17—10:24 a.m.]</dateline>
                </opener>
                <p>2017. Ministry of Navy inquires of our Naval Attaché whether it is permissible
                    for French merchant vessels which are armed for defensive purposes to enter
                    American ports.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bullitt</hi>
                    </signed>
                </closer>
            </div>
        </body>
