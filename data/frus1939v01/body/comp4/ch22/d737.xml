            </note>
            <note corresp="#d737-f2" n="55" xml:id="d737-f2-content">
                <p>H. J. Res. 306, approved November 4, 1939, 54 Stat. 4.</p>
            </note>
            <note corresp="#d737-f3" n="56" xml:id="d737-f3-content">
