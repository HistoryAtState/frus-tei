    <text>
        <body>
            <div xml:id="d761">

                <pb facs="0726" n="714" sameAs="frus:frus1939v01/pg714"/>

                <note rend="inline" type="source">740.00111A Combat Areas/53a: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Chargé in the United
                        Kingdom</hi> (<hi rendition="#italic">Johnson</hi>)<anchor n="75"
                        xml:id="d761-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1939-12-02T17:00:00-05:00">December 2, 1939—5
                            p.m.</date>
                    </dateline>
                </opener>
                <p>1541. Department desires to be advised promptly of any American vessels taken
                    into any belligerent port, especially in the combat area, contrary to the
                    provisions of the American Neutrality Act. You will recall that the Act does not
                    apply to vessels which sailed from an American port prior to the effective date
                    of the Act.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d761-f1" n="75" type="source" xml:id="d761-f1-content">
                <p>The same telegram was sent December 2, 7 p.m. to the Ambassador in France (No.
                    1478).</p>
            </note>
        </listAnnotation>
    </standOff>
