                <pb facs="0728" n="716" sameAs="frus:frus1939v01/pg716"/>

                <note rend="inline" type="source">740.00111A Passenger Travel/63a: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Minister in Switzerland</hi> (<hi rendition="#italic"
                            >Harrison</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1939-12-20T18:00:00-05:00">December 20,
                            1939—6 p.m.</date>
                    </dateline>
                </opener>
                <p>138. Please urgently inform all missions in Europe that in carrying out
                    Department’s telegrams of November 17, 6 p.m. and November 22, 6 p.m. the travel
                    of news correspondents and broadcasters should be expedited and facilitated
                    every possible way.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
