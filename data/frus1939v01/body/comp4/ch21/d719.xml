    <text>
        <body>
            <div xml:id="d719">

                <pb facs="0686" n="674" sameAs="frus:frus1939v01/pg674"/>

                <note rend="inline" type="source">811.04418/554½</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the United Kingdom</hi> (<hi
                        rendition="#italic">Kennedy</hi>) <hi rendition="#italic">to President
                        Roosevelt </hi><anchor n="27" xml:id="d719-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1939-10-06">October 6,
                        1939</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. President</hi>: I enclose a letter
                    addressed to you by the Prime Minister which was handed to me yesterday.<anchor
                        n="28" xml:id="d719-f2"/>
                </p>
                <p>Yours sincerely,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Jos. Kennedy</hi>
                    </signed>
                </closer>


                <xi:include href="d719-a1.xml" xpointer="d719-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d719-f1" n="27" type="source" xml:id="d719-f1-content">
                <p>Photostatic copy obtained from the Franklin D. Roosevelt Library, Hyde Park, N.
                    Y.</p>
            </note>
            <note corresp="#d719-f2" n="28" xml:id="d719-f2-content">
                <p>Referred by the President to the Secretary of State, October 25, 1939, and
                    returned with the marginal notation: “Interesting—C. H.”</p>
            </note>
        </listAnnotation>
