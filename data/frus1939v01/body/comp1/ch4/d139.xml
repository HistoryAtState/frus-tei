    <text>
        <body>
            <div xml:id="d139">

                <pb facs="0159" n="147" sameAs="frus:frus1939v01/pg147"/>

                <note rend="inline" type="source">740.00/963: Telegram</note>
                <head>
                    <hi rendition="#italic">President Roosevelt to
                        the President of the Presidium of the Supreme Council of the Soviet
                        Union</hi> (<hi rendition="#italic"
                        >Kalinin</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1939-04-21">April 21, 1939</date>.</dateline>
                </opener>
                <p>I have received your friendly message and am glad to learn that your views with
                    regard to my efforts on behalf of world peace are similar to those expressed to
                    me by the heads of numerous other states.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Franklin D. Roosevelt</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
