            <div xml:id="d301">

                <pb facs="0322" n="310" sameAs="frus:frus1939v01/pg310"/>

                <note rend="inline" type="source">740.00/2133</note>
                <head>
                    <hi rendition="#italic">The British Ambassador</hi> (<hi rendition="#italic"
                        >Lindsay</hi>) <hi rendition="#italic">to the Chief of the Division of
                        European Affairs</hi> (<hi rendition="#italic">Moffat</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1939-08-26">August 26,
                        1939</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Moffat</hi>: I enclose herein a copy of the
                    latest telegram which we have had from the Foreign Office regarding the
                    international situation.</p>
                <p>Yours sincerely,</p>
                <closer>
                    <signed>R. C. <hi rendition="#small-caps">Lindsay</hi>
                    </signed>
                </closer>


                <xi:include href="d301-a1.xml" xpointer="d301-a1"/>
