    <text>
        <body>
            <div xml:id="d1142">

                <pb facs="1039" n="1027" sameAs="frus:frus1939v01/pg1027"/>

                <note rend="inline" type="source">860d.24/54</note>
                <head>
                    <hi rendition="#italic">The Finnish Minister</hi> (<hi
                            rendition="#italic">Procopé</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi><anchor n="22" xml:id="d1142-f1"/>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 3658</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1939-12-11">December 11,
                        1939</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I herewith have the honour to inform
                    Your Excellency that the Finnish Government is sending a purchasing Committee
                        <pb facs="1040" n="1028" xml:id="pg1028"/> to the United States. The members
                    of this committee are Lieutenant General V. P. Nenonen, former Inspector of the
                    Finnish Artillery, and Mr. W. Wahlf ors, President of the Wärtsilä metal concern
                    in Finland. They are accompanied by one secretary. General Nenonen is not
                    visiting the United States in his capacity of officer, but only as a member of
                    the above mentioned committee. The purchases will mainly consist of implements
                    of war. The committee is expected to arrive in New York about the 20th of
                    December.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hj. J. Procopé</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1142-f1" n="22" type="source" xml:id="d1142-f1-content">
                <p>Acknowledged for the Secretary of State on December 15, 1939, by the Counselor of
                    the Department, R. Walton Moore.</p>
            </note>
        </listAnnotation>
    </standOff>
