    <text>
        <body>
            <div xml:id="d1034">

                <pb facs="0958" n="946" sameAs="frus:frus1939v01/pg946"/>

                <note rend="inline" type="source">800.6354/186: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in the United Kingdom</hi> (<hi rendition="#italic">Johnson</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1939-12-09">December 9,
                        1939</date>.<lb/>[Received December 9—8 a.m.]</dateline>
                </opener>
                <p>2573. Embassy’s 2510, December 1, 5 p.m.<anchor n="94" xml:id="d1034-f1"/> Tin
                    quota for first quarter of 1940 raised to 120 percent of standard tonnages.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Johnson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1034-f1" n="94" xml:id="d1034-f1-content">
                <p>Not printed; it had reported the quota for the first quarter of 1940 as
                    established at 100 percent (800.6354/182).</p>
            </note>
        </listAnnotation>
    </standOff>
