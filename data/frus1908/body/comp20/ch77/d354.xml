                <pb facs="0522" n="420" sameAs="frus:frus1908/pg420"/>

                <note rend="inline" type="source">File No. 6775/575.</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Minister of
                        Foreign Affairs of Guatemala.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1908-09-20"><hi rendition="#italic">September 20,
                        1908</hi></date>.</dateline></opener>
                <p>Accept appreciative acknowledgment of your gratifying telegram reporting the
                    inauguration of the international bureau.</p>
                <closer><signed><hi rendition="#small-caps">Adee.</hi></signed></closer>
            </div>
        </body>
