                <pb facs="0507" n="405" sameAs="frus:frus1908/pg405"/>

                <note rend="inline" type="source">File No. 10793/1.</note>
                <head><hi rendition="#italic">The Secretary of State to the Guatemalan
                        Minister.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1908-01-07"><hi rendition="#italic">January 7,
                        1908</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 14.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inform you that in
                    acceptance of the invitation extended by the Government of Guatemala, the
                    President has commissioned Maj. Gen. George W. Davis, United States Army,
                    retired, to be envoy extraordinary and minister plenipotentiary on special
                    mission as the representative of the United States at the ceremonies attending
                    the formal opening of the Interoceanic Railway of Guatemala on the 15th of this
                    month.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Elihu Root.</hi></signed></closer>
            </div>
        </body>
