                <pb facs="0509" n="407" sameAs="frus:frus1908/pg407"/>

                <note rend="inline" type="source">File No. 10793/18–19.</note>
                <head><hi rendition="#italic">The Secretary of State to
                        Chargé Sands.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1908-03-14"><hi rendition="#italic">March 14,
                        1908</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 91.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith a personal letter, dated
                    the 4th instant, addressed by President Roosevelt to President Estrada, which
                    you will transmit to the latter through the channel most agreeable to him.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">E. Root.</hi></signed></closer>


                <xi:include href="d329-a1.xml" xpointer="d329-a1"/>
