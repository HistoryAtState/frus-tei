                <pb facs="0313" n="211" sameAs="frus:frus1908/pg211"/>

                <note rend="inline" type="source">File No. 15927–2.</note>
                <head><hi rendition="#italic">Minister Dawson to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Bogota</hi></placeName>, <date calendar="gregorian" when="1908-09-04"
                                ><hi rendition="#italic">September 4, 1908</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 156.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a copy
                    and translation of the recently ratified convention between Colombia and Spain
                    in regard to giving effect in each country to the judgments of the courts of the
                    other, and a copy and translation of the law of the National Assembly No. 7 of
                    1908 (August 13) approving the same.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. C. Dawson.</hi></signed></closer>



                <xi:include href="d194-a1.xml" xpointer="d194-a1"/>
