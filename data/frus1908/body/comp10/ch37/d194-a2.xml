                <pb facs="0314" n="212" sameAs="frus:frus1908/pg212"/>

                <opener><seg rendition="#center">[Inclosure 2—Translation.]</seg></opener>
                <head><hi rendition="#small-caps">law no</hi>. 7 <hi rendition="#small-caps">of</hi>
                    1908 (13<hi rendition="#small-caps">th of august</hi>) <hi
                        rendition="#small-caps">by which a convention between colombia and spain is
                        approved.</hi></head>
                <p rendition="#flush"><hi rendition="#italic">The national constituent and
                        legislative assembly decree:</hi></p>
                <p>A convention between Colombia and Spain for the carrying out of civil judgments,
                    signed at Madrid May 30, 1908, by His Excellency Juan Evangelista Manrique,
                    Envoy Extraordinary and Minister Plenipotentiary of the Republic in said Court,
                    and His Excellency Manuel Allendesalazar y Munoz de Salazar, Minister of His
                    Catholic Majesty, is hereby approved.</p>
                <closer>
                    <dateline rendition="#float-left">Done in <placeName>Bogota</placeName>, <date
                            calendar="gregorian" when="1908-08-12">August 12,
                        1908</date>.</dateline>
                    <lb/><signed>
                        <list>
                            <item><hi rendition="#small-caps">Alfredo Vazquez Cobo</hi>,<lb/><hi
                                    rendition="#italic">President</hi>,</item>
                            <item><hi rendition="#small-caps">Gerardo Arrubla</hi>,<lb/><hi
                                    rendition="#italic">Secretary</hi>.</item>
                            <item><hi rendition="#small-caps">Fernando E. Baena</hi>,<lb/><hi
                                    rendition="#italic">Secretary.</hi></item>
                        </list>
                    </signed></closer>
            </div>
