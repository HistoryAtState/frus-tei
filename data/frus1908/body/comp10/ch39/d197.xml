            <div xml:id="d197">

                <pb facs="0315" n="213" sameAs="frus:frus1908/pg213"/>

                <note rend="inline" type="source">File No. 16017.</note>
                <head><hi rendition="#italic">The Colombian Minister to the Secretary of
                    State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of Colombia</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1908-10-07"><hi rendition="#italic">October 7,
                        1908</hi></date>.</dateline></opener>
                <p>Mr. <hi rendition="#small-caps">Secretary of State</hi>: I have the honor to
                    inclose herewith a copy of note No. 972 of the Colombian minister of foreign
                    relations under date of August 25 last, in compliance with instructions received
                    from said minister.</p>
                <p>I avail, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Enrique Cortes.</hi></signed></closer>


                <xi:include href="d197-a1.xml" xpointer="d197-a1"/>
