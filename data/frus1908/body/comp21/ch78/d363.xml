                <pb facs="0527" n="425" xml:id="pg425"/>

                <note rend="inline" type="source">File No. 2126/69–71.</note>
                <head><hi rendition="#italic">Minister Furniss to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">Port au
                                Prince</hi></placeName>, <date calendar="gregorian"
                            when="1908-01-17"><hi rendition="#italic">January 17,
                        1908</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 280.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith copies
                    of the correspondence between this legation and the Haitian Government relative
                    to the blockade decreed at Gonaives and St. Marc.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">H. W. Furniss.</hi></signed></closer>



                <xi:include href="d363-a1.xml" xpointer="d363-a1"/>
