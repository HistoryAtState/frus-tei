    <text>
        <body>
            <div xml:id="d386-a4">

                <pb facs="0539" n="437" sameAs="frus:frus1908/pg437"/>

                <opener><seg rendition="#center">[Inclosure 4.—Translation.]</seg></opener>
                <head><hi rendition="#italic">The Minister for Foreign Affairs to Minister
                        Furniss.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Foreign Office</hi>,<lb/><hi rendition="#italic">Port au
                                Prince</hi></placeName>, <date calendar="gregorian"
                            when="1908-05-02"><hi rendition="#italic">May 2,
                        1908</hi></date>.</dateline></opener>
                <p>Mr. <hi rendition="#small-caps">Minister</hi>: I have the honor to receive your
                    communication, No. 270, of this date, transmitting to me instructions received
                    from your Government.<anchor n="1" xml:id="d386-f1"/></p>
                <p>The department takes note of this information to which it will not fail to give
                    publicity.</p>
                <p>Please accept, Mr. Minister, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Louis Borno.</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d386-f1" n="1" xml:id="d386-f1-content">
                <p>Instruction quoted supra.</p>
            </note>
