            <div xml:id="d394-a5">

                <pb facs="0544" n="442" sameAs="frus:frus1908/pg442"/>

                <opener><seg rendition="#center">[Inclosure 5.]</seg></opener>
                <head><hi rendition="#italic">Minister Furniss to the Minister for Foreign
                        Affairs.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">Port au
                                Prince</hi></placeName>, <date calendar="gregorian"
                            when="1908-11-28"><hi rendition="#italic">November 28,
                        1908</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 332.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In reference to my note No. 331 of this
                    date, in order to avoid any misunderstanding, I desire to state that the remarks
                    made therein refer to American ships and to American merchandise in American
                    bottoms.</p>
                <p>Your excellency will please accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">H. W. Furniss.</hi></signed></closer>
            </div>
        </body>
    </text>
