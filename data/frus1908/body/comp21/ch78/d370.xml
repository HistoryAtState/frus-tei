            <div xml:id="d370">

                <pb facs="0529" n="427" sameAs="frus:frus1908/pg427"/>

                <note rend="inline" type="source">File No. 2126/88–89.</note>
                <head><hi rendition="#italic">Minister Furniss to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">Port au
                                Prince</hi></placeName>, <date calendar="gregorian"
                            when="1908-01-24"><hi rendition="#italic">January 24,
                        1908</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 286.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith the
                    acknowledgment by the Haitian Government of the protest which I sent under date
                    of the 17th instant, against the bombardment of St. Marc, copy of which I
                    inclosed in my No. 278 of the 17th instant.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">H. W. Furniss.</hi></signed></closer>


                <xi:include href="d370-a1.xml" xpointer="d370-a1"/>
            </div>
