                <pb facs="0807" n="705" sameAs="frus:frus1908/pg705"/>

                <note rend="inline" type="source">File No. 13468/–1.</note>
                <head><hi rendition="#italic">Chargé Gregory to the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">San
                                Salvador</hi></placeName>, <date calendar="gregorian"
                            when="1908-04-21"><hi rendition="#italic">April 21,
                        1908</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 77, Salvadorean series.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to forward herewith the
                    original and translation of an executive decree recently issued in Salvador
                    relating to treaties, status of foreigners, etc., for the department’s
                    information.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">J. H. Gregory</hi>,
                    Jr.</signed></closer>



                <xi:include href="d686-a1.xml" xpointer="d686-a1"/>
