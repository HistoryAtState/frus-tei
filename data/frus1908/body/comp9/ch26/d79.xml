    <text>
        <body>
            <div xml:id="d79">

                <pb facs="0196" n="94" xml:id="pg94"/>

                <note rend="inline" type="source">File No. 774/273A.</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to Ambassador O’Brien.</hi><anchor n="1" xml:id="d79-f1"/></head>
                <opener><seg rendition="#center">[Telegram.—Paraphrase.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1908-08-01"><hi rendition="#italic">August 1,
                        1908</hi></date>.</dateline></opener>
                <p>(Mr. Adee directs Mr. O’Brien to inform the minister for foreign affairs that
                    Charles D. Brent replaces Thomas Burke as senior American commissioner on Joint
                    International Opium Commission.)</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d79-f1" n="1" type="source" xml:id="d79-f1-content">
                <p>Repeated to Great Britain, France, Germany, Netherlands, Portugal, China.</p>
            </note>
