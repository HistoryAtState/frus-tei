    <text>
        <body>
            <div xml:id="d102">

                <pb facs="0210" n="108" sameAs="frus:frus1908/pg108"/>

                <note rend="inline" type="source">File No. 774/438–439.</note>
                <head><hi rendition="#italic">Chargé de Billier to the Secretary of
                    State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Teheran</hi></placeName>, <date calendar="gregorian" when="1908-11-11"
                                ><hi rendition="#italic">November 11,
                    1908</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose a copy of the
                    Persian Government’s acceptance of the American Government’s invitation to send
                    delegates to the joint commission on the opium question at Shanghai January 1,
                    1909.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Frederic de
                    Billier.</hi></signed></closer>


                <xi:include href="d102-a1.xml" xpointer="d102-a1"/>
