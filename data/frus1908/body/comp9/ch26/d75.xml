    <text>
        <body>
            <div xml:id="d75">

                <pb facs="0194" n="92" sameAs="frus:frus1908/pg92"/>

                <note rend="inline" type="source">File No. 774/225D.</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to Ambassador O’Brien.</hi><anchor n="1" xml:id="d75-f1"/></head>
                <opener><seg rendition="#center">[Telegram.—Paraphrase.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1908-06-20"><hi rendition="#italic">June 20,
                        1908</hi></date>.</dateline></opener>
                <p>(Mr. Adee directs Mr. O’Brien to inform the minister for foreign affairs that the
                    President has appointed Hon. Thomas Burke, Dr. Hamilton Wright, and Dr. Charles
                    D. Tenney American commissioners, joint international commission, to investigate
                    opium in the Far East.)</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d75-f1" n="1" type="source" xml:id="d75-f1-content">
                <p>Repeated to France, Germany, Great Britain, The Netherlands, Portugal, and
                    China.</p>
            </note>
        </listAnnotation>
    </standOff>
