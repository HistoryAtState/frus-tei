                <pb facs="0209" n="107" sameAs="frus:frus1908/pg107"/>

                <note rend="inline" type="source">File No. 774/379.</note>
                <head><hi rendition="#italic">The Third Assistant Secretary of
                            State to the Counselor of the Japanese
                            Embassy.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1908-11-04"><hi rendition="#italic">November 4,
                        1908</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Matsui</hi>: I have received your letter
                    of October 31 and I thank you for so kindly conveying to the department the
                    interesting information that your Government has officially communicated to the
                    Chinese Government its assent to the prohibition of morphia into China.</p>
                <p>Believe me, etc.,</p>
                <closer><signed><hi rendition="#small-caps">William Phillips.</hi></signed></closer>
            </div>
        </body>
