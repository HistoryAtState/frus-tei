                <pb facs="0214" n="112" sameAs="frus:frus1908/pg112"/>

                <note rend="inline" type="source">File No. 774/415.</note>
                <head><hi rendition="#italic">Ambassador O’Brien to
                        the Secretary of State.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Tokyo</hi></placeName>, <date calendar="gregorian" when="1908-11-27"
                                ><hi rendition="#italic">November 27,
                    1908</hi></date>.</dateline></opener>
                <p>Your telegram of the 20th. There is no objection on the part of the Government of
                    Japan to the proposed postponement.</p>
                <closer><signed><hi rendition="#small-caps">O’Brien.</hi></signed></closer>
            </div>
        </body>
