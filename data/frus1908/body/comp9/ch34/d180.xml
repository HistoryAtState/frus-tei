            <div xml:id="d180">

                <pb facs="0280" n="178" xml:id="pg178"/>

                <note rend="inline" type="source">File No. 1518/113–114.</note>
                <head><hi rendition="#italic">Chargé Fletcher to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Peking</hi></placeName>, <date calendar="gregorian" when="1908-01-10"
                                ><hi rendition="#italic">January 10, 1908</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 810.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose translation of
                    a memorial, which has received the imperial sanction, recommending the
                    establishment of a new judicial system in Peking.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Henry P.
                    Fletcher.</hi></signed></closer>





