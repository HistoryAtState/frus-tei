    <text>
        <body>
            <div xml:id="d133">

                <pb facs="0220" n="118" sameAs="frus:frus1908/pg118"/>

                <note rend="inline" type="source">File No. 14911/11–12.</note>
                <head><hi rendition="#italic">The Chinese Minister to the Secretary of
                    State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Imperial Chinese Legation</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1908-11-17"><hi rendition="#italic">November 17,
                        1908</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 16.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inform you that I have
                    received to-day, through the Wai-wu Pu (Ministry of Foreign Affairs), Peking,
                    the <pb facs="0221" n="119" xml:id="pg119"/> inclosed imperial message,
                    forwarded by cable, from His Majesty the Emperor of China to His Excellency the
                    President of the United States of America, announcing the demise of Her Majesty,
                    the late Grand Empress Dowager. I thank you to transmit the message to its high
                    destination.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Wu Ting Fang.</hi></signed></closer>


                <xi:include href="d133-a1.xml" xpointer="d133-a1"/>
