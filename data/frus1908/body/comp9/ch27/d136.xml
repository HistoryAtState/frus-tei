                <pb facs="0222" n="120" xml:id="pg120"/>

                <note rend="inline" type="source">File No. 14911/21–22.</note>
                <head><hi rendition="#italic">The Chinese Minister to the
                            Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Imperial Chinese Legation</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1908-11-25"><hi rendition="#italic">November 25,
                        1908</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 17.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose a translation
                    of an imperial message, addressed to His Excellency the President, and
                    acknowledging the receipt of a message of condolence transmitted to His Majesty
                    in the name of His Excellency. I thank you to transmit the inclosure to its high
                    destination.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Wu Ting Fang.</hi></signed></closer>


                <xi:include href="d136-a1.xml" xpointer="d136-a1"/>
