                <pb facs="0219" n="117" sameAs="frus:frus1908/pg117"/>

                <note rend="inline" type="source">File No. 14911/7.</note>
                <head><hi rendition="#italic">The Chinese Minister to the Secretary of
                    State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Imperial Chinese Legation</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1908-11-16"><hi rendition="#italic">November 16,
                        1908</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 14.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: It is with very great sorrow that I have
                    further to announce to you the demise of Her Imperial Majesty the Empress
                    Dowager, which occurred in Peking at 2 o’clock yesterday afternoon (November
                    14).</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Wu Ting Fang.</hi></signed></closer>
            </div>
        </body>
