            <div xml:id="d149">

                <pb facs="0231" n="129" sameAs="frus:frus1908/pg129"/>

                <note rend="inline" type="source">File No. 4992/5–7.</note>
                <head><hi rendition="#italic">Minister Rockhill to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Peking</hi></placeName>, <date calendar="gregorian" when="1907-03-20"
                                ><hi rendition="#italic">March 20, 1907</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 563.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In further acknowledgment of your telegram
                    asking whether the Chinese Government would grant the extradition of Horace G.
                    McKinley, I have the honor to inclose herewith copy of the note which I
                    addressed to the Wai-wu Pu on the 12th instant, and of its reply, received
                    yesterday.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. W. Rockhill.</hi></signed></closer>



                <xi:include href="d149-a1.xml" xpointer="d149-a1"/>
