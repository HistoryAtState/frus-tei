                <pb facs="0311" n="209" sameAs="frus:frus1908/pg209"/>

                <note rend="inline" type="source">File No. 1576/12–14.</note>
                <head><hi rendition="#italic">Minister Rockhill to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Peking</hi></placeName>, <date calendar="gregorian" when="1908-11-05"
                                ><hi rendition="#italic">November 5, 1908</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1035.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In continuation of my dispatch No. 969 of
                    July 27 last, in which I inclosed a copy of an imperial edict giving Grand
                    Councilor Chang Chih-tung absolute control of the construction of the
                    Canton-Hankow Railway, I have the honor to transmit herewith another imperial
                    edict of the 28th October on the same subject.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. W. Rockhill.</hi></signed></closer>


                <xi:include href="d191-a1.xml" xpointer="d191-a1"/>
