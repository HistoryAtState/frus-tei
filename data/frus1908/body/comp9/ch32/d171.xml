    <text>
        <body>
            <div xml:id="d171">

                <pb facs="0253" n="151" sameAs="frus:frus1908/pg151"/>

                <note rend="inline" type="source">File No. 10388/25–26.</note>
                <head><hi rendition="#italic">Consul General Denby to the Secretary of
                    State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Consulate General</hi>,<lb/><hi rendition="#italic"
                                >Shanghai</hi></placeName>, <date calendar="gregorian"
                            when="1908-06-19"><hi rendition="#italic">June 19,
                        1908</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 209.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inform you that the
                    Chinese Government has paid to me the amount claimed for damages to American
                    citizens on account of the Shanghai riots of December, 1905, the aggregate of
                    the claims amounting to $889.73, United States currency.</p>
                <p>In pursuance of the department’s telegraphic instructions of June 1, I inclose
                    herewith a draft on the International Banking Corporation of New York for
                    $889.73, the amount above stated.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Chas. Denby.</hi></signed></closer>
            </div>
        </body>
    </text>
