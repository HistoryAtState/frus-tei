                <pb facs="0822" n="720" sameAs="frus:frus1908/pg720"/>

                <note rend="inline" type="source">File No. 11854.</note>
                <head><hi rendition="#italic">Minister Collier to the Secretary of
                    State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Madrid</hi></placeName>, <date calendar="gregorian" when="1908-02-04"
                                ><hi rendition="#italic">February 4, 1908</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 474.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith the
                    text and translation of the royal decree of the 20th ultimo, ratifying the
                    declaration made by Spain at the recent international peace conference, whereby
                    she accepts all the rules, including that for the abolition of privateering,
                    laid down in the declaration of Paris of 1856.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Wm. Miller
                    Collier.</hi></signed></closer>



