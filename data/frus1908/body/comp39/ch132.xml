                <pb facs="0825" n="723" sameAs="frus:frus1908/pg723"/>

                <head>Extradition treaty and protocol between the United States and Spain</head>
                <p rendition="#flush"><hi rendition="#italic">Treaty signed at Madrid, June 15,
                        1904. Protocol signed at San Sebastian, August IS, 1907. Ratification
                        advised by the Senate, January 16, 1908. Ratified by the President, February
                        5, 1908. Ratified by Spain, March 30, 1908. Ratifications exchanged at
                        Madrid, April 6, 1908. Proclaimed, May 21, 1908.</hi></p>

                <xi:include href="ch132/d693.xml" xpointer="d693"/>
