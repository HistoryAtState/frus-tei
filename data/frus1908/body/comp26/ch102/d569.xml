            <div xml:id="d569">

                <pb facs="0700" n="598" sameAs="frus:frus1908/pg598"/>

                <note rend="inline" type="source">File No. 10170/3–4.</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Mexican
                    Chargé.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1908-02-14"><hi rendition="#italic">February 14,
                        1908</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 189.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note, No. 127, of the 28th ultimo, transmitting the record of
                    proceedings in the case of the extradition of George Deering Reed, and
                    requesting that the warrant for the surrender of the fugitive be issued.</p>
                <p>In reply I have the honor to inclose the warrant herewith.</p>
                <p>Accept, etc.</p>
                <closer><signed><hi rendition="#small-caps">Robert Bacon.</hi></signed></closer>
            </div>
        </body>
    </text>
