    <text>
        <body>
            <div xml:id="d45">

                <pb facs="0159" n="57" sameAs="frus:frus1908/pg57"/>

                <note rend="inline" type="source">File No. 5072/19–20.</note>
                <head><hi rendition="#italic">Minister Knowles to the Secretary of
                    State.</hi></head>
                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Bucharest</hi></placeName>, <date calendar="gregorian"
                            when="1908-10-06"><hi rendition="#italic">October 6,
                        1908</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 33—Bulgarian Series.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to confirm my telegram of
                    yesterday announcing that Prince Ferdinand, at Tirnovo, proclaimed the
                    independence of Bulgaria, and to transmit herewith a copy of the official note
                    from the foreign minister.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Horace G.
                    Knowles.</hi></signed></closer>


                <xi:include href="d45-a1.xml" xpointer="d45-a1"/>
            </div>
