            <div xml:id="d42">

                <pb facs="0153" n="51" sameAs="frus:frus1908/pg51"/>

                <note rend="inline" type="source">File No. 16546/4–5.</note>
                <head><hi rendition="#italic">Chargé Janes to the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Petropolis</hi></placeName>, <date calendar="gregorian"
                            when="1908-11-11"><hi rendition="#italic">November 11,
                        1908</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 288.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a
                    clipping from the Diario Official with a translation of the general treaty of
                    arbitration between Argentine and Brazil, the ratifications of which were
                    exchanged on the 9th instant.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Henry L. Janes.</hi></signed></closer>


                <xi:include href="d42-a1.xml" xpointer="d42-a1"/>
            </div>
