                <pb facs="0772" n="670" sameAs="frus:frus1908/pg670"/>

                <note rend="inline" type="source">File No. 847/162–163.</note>
                <head><hi rendition="#italic">President Roosevelt
                        to President Obaldia.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >The White House</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1908-10-31"><hi rendition="#italic">October 31,
                        1908</hi></date>.</dateline></opener>
                <p>Please accept my cordial thanks for good wishes extended by yourself and members
                    of your cabinet in your message of October 28.</p>
                <closer><signed><hi rendition="#small-caps">Theodore
                    Roosevelt.</hi></signed></closer>
            </div>
        </body>
