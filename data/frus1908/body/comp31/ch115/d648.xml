                <pb facs="0774" n="672" sameAs="frus:frus1908/pg672"/>

                <note rend="inline" type="source">File No. 5747/22.</note>
                <head><hi rendition="#italic">The Minister of Panama to the Secretary of
                    State.</hi></head>
                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of Panama</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1908-05-27"><hi rendition="#italic">May 27,
                        1908</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 12.]</seg></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I have the honor to inform your
                    excellency that by a cable I have received to-day from my Government I am
                    instructed to advise your excellency that His Excellency Dr. M. Amador Guerrero,
                    President of Panama, has appointed Señors Gil Ponce Jaen and Santiago de la
                    Guardia to discharge the duties stipulated in Article VI of the convention of
                    November 18, 1903.</p>
                <p>I avail, etc.,</p>
                <closer><signed><hi rendition="#small-caps">J. J. Arosemena.</hi></signed></closer>
            </div>
        </body>
    </text>
