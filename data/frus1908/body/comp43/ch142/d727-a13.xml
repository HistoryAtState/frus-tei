    <text>
        <body>
            <div xml:id="d727-a13">

                <pb facs="0870" n="768" sameAs="frus:frus1908/pg768"/>

                <opener><seg rendition="#center">[Subinclosure 12.]</seg></opener>
                <head><hi rendition="#italic">Minister O’Brien to each member of the Diplomatic
                        Corps.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Asuncion</hi></placeName>, <date calendar="gregorian" when="1908-07-06"
                                ><hi rendition="#italic">July 6,
                    1908</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I deliver into your hands a copy of the
                    following note addressed to me by Mr. Eusebio Ayala, a member of the
                    revolutionary committee, who signs as minister of foreign affairs.</p>
                <p>Saluting you with the highest consideration, I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Edward C.
                    O’Brien.</hi></signed></closer>
            </div>
        </body>
