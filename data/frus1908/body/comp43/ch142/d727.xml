                <pb facs="0863" n="761" xml:id="pg761"/>

                <note rend="inline" type="source">File No. 352/12–13.</note>
                <head><hi rendition="#italic">Minister O’Brien to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Asuncion</hi></placeName>, <date calendar="gregorian" when="1908-07-16"
                                ><hi rendition="#italic">July 16, 1908</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 28, Paraguayan series.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: The inclosed report, drawn up by me as dean
                    of the diplomatic corps, covers fully the proceedings taken by that body in
                    connection with the revolution which broke out in Asuncion on July 2, 1908.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">E. C. O’Brien.</hi></signed></closer>



















