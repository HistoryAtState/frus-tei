    <text>
        <body>
            <div xml:id="d727-a10">

                <pb facs="0869" n="767" sameAs="frus:frus1908/pg767"/>

                <opener><seg rendition="#center">[Subinclosure 9.—Translation.]</seg></opener>
                <head><hi rendition="#italic">President Ferreira to
                        the Paraguayan Congress.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Asuncion</hi></placeName>, <date calendar="gregorian"
                            when="1908-07-04"><hi rendition="#italic">July 4,
                        1908</hi></date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#italic">To the Honorable Congress of the
                        Nation:</hi></p>
                <p>In view of present events I present to the honorable Congress my resignation of
                    the office of President of the Republic.</p>
                <p>Saluting the honorable Congress attentively,</p>
                <closer><signed><hi rendition="#small-caps">B. Ferreira.</hi></signed></closer>
            </div>
        </body>
    </text>
