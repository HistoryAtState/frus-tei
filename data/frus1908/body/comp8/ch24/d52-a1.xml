    <text>
        <body>
            <div xml:id="d52-a1">

                <pb facs="0165" n="63" sameAs="frus:frus1908/pg63"/>

                <opener><seg rendition="#center">[Inclosure.]</seg></opener>
                <head><hi rendition="#italic">Consul General Dietrich to the Secretary of
                        State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Consulate General</hi>,<lb/><hi rendition="#italic"
                                >Guayaquil</hi></placeName>, <date calendar="gregorian"
                            when="1908-11-14"><hi rendition="#italic">November 14,
                        1908</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 235.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor, respectfully referring to
                    copy of the departments instructions No. 61 of August 22, 1908, received from
                    the legation at Quito, regarding the protection of Chinese subjects resident in
                    Ecuador, to inclose herewith form of certificate which has been accepted by the
                    Government of Ecuador as a satisfactory form of certificate to be given to the
                    Chinese subjects, when applied for by them.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Herman R.
                    Dietrich.</hi></signed></closer>
            </div>
        </body>
    </text>
