                <head><hi rendition="#italic">Consul Alger to the Secretary of State.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Consulate</hi>,<lb/><hi rendition="#italic"
                                >Tegucigalpa</hi></placeName>, <date calendar="gregorian"
