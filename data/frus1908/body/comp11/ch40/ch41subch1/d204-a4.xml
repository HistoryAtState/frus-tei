    <text>
        <body>
            <div xml:id="d204-a4">

                <pb facs="0337" n="235" sameAs="frus:frus1908/pg235"/>

                <head><hi rendition="#italic">From the President of Salvador</hi>.</head>
                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >San Salvador</hi></placeName>, <date calendar="gregorian"
                            when="1908-05-28"><hi rendition="#italic">May 28,
                        1908</hi></date>.</dateline></opener>
                <p rendition="#flush">The <hi rendition="#small-caps">President</hi>, <hi
                        rendition="#italic">San Jose, Costa Rica:</hi></p>
                <p>The people and Government of Salvador associate themselves with the people and
                    Government of Costa Rica in recognition to Mr. Carnegie for his gift.</p>
                <p>I reiterate to Your Excellency the assurance of my high esteem and subscribe
                    myself,</p>
                <p>Your friend and servant,</p>
                <closer><signed><hi rendition="#small-caps">F. Figueroa.</hi></signed></closer>
            </div>
        </body>
    </text>
