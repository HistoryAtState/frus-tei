                <pb facs="0745" n="643" sameAs="frus:frus1908/pg643"/>

                <note rend="inline" type="source">File No. 2151/106.</note>
                <head><hi rendition="#italic">The Secretary of State to the Spanish
                    Minister.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi><lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1908-01-20"><hi rendition="#italic">January 20,
                        1908</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Minister</hi>: In accordance with my oral
                    promise, I send you inclosed a memorandum in reply to yours of the 17th instant,
                    concerning measures which your Government may find itself obliged to take in
                    Morocco.</p>
                <p>Faithfully, yours,</p>
                <closer><signed><hi rendition="#small-caps">Elihu Root.</hi></signed></closer>
            </div>
        </body>
    </text>
