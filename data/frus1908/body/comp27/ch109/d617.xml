    <text>
        <body>
            <div xml:id="d617">

                <pb facs="0753" n="651" sameAs="frus:frus1908/pg651"/>

                <note rend="inline" type="source">File No. 2151/238–C.</note>
                <head><hi rendition="#italic">The Secretary of State to
                        Minister Gummeré.</hi><anchor n="1"
                        xml:id="d617-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi><lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1908-10-22"><hi rendition="#italic">October 22,
                        1908</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 162.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I quote a telegram sent to you by the
                    department on the 20th instant.<anchor n="2" xml:id="d617-f2"/></p>
                <p>I inclose for your information a copy of the draft submitted by the French
                    ambassador and Spanish chargé, as well as a copy of this department’s memorandum
                    in response.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Elihu Root.</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d617-f1" n="1" type="source" xml:id="d617-f1-content">
                <p>Mutatis mutandis to Paris, No. 278; London, No. 230; Rome, No. 204; Vienna No
                    259; Brussels, No. 176; The Hague, No. 13: Stockholm, No. 108; Lisbon, No. 170;
                    St. Petersburg, No. 188.</p>
            </note>
            <note corresp="#d617-f2" n="2" xml:id="d617-f2-content">
                <p>Supra.</p>
            </note>
        </listAnnotation>
    </standOff>
