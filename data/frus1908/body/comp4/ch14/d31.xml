    <text>
        <body>
            <div xml:id="d31">

                <pb facs="0141" n="39" sameAs="frus:frus1908/pg39"/>

                <note rend="inline" type="source">File No. 11502/3–4.</note>
                <head><hi rendition="#italic">Minister Wilson to the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Brussels</hi></placeName>, <date calendar="gregorian" when="1908-01-20"
                                ><hi rendition="#italic">January 20, 1908</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 283.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith, for
                    the information of the department, a triplicate copy, in the original
                        texts,<anchor n="1" xml:id="d31-f1"/> of a treaty of commerce between
                    Belgium and Servia.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Henry Lane
                    Wilson.</hi></signed></closer>
                <postscript>
                    <p rendition="#center">[SEE ALSO KONGO, <ref target="#pg537">P. 537</ref>.]</p>
                </postscript>
            </div>
        </body>
    </text>
