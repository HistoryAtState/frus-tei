    <text>
        <body>
            <div xml:id="d540">

                <pb facs="0664" n="562" xml:id="pg562"/>

                <head><hi rendition="#italic">Minister Wilson to the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Brussels</hi></placeName>, <date calendar="gregorian" when="1908-04-08"
                                ><hi rendition="#italic">April 8, 1908</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 323.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith three
                    copies of the proposed Kongo annexation bill<anchor n="1" xml:id="d540-f1"/>
                    which has just been reported to the Belgian Parliament by the committee of
                    seventeen. I also transmit three copies of the proposed bill for the government
                    of the Belgian colonial possessions reported by the same committee.</p>
                <p>I have the honor, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Henry Lane
                    Wilson.</hi></signed></closer>
            </div>
        </body>
    </text>
