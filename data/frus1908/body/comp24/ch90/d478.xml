    <text>
        <body>
            <div xml:id="d478">

                <pb facs="0604" n="502" sameAs="frus:frus1908/pg502"/>

                <note rend="inline" type="source">File No. 9146/14–16.</note>
                <head><hi rendition="#italic">Ambassador O’Brien to the Secretary of
                    State.</hi></head>
                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Tokyo</hi></placeName>, <date calendar="gregorian" when="1908-06-02"
                                ><hi rendition="#italic">June 2, 1908</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 341.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith copy
                    in duplicate of a translation published in the Japan Times of the recent
                    agreement entered into between China and Japan, entitled “Yam Forestry
                    Agreement.” The department will have received full information in regard to the
                    nature and object of this agreement through our vice consul at Antung.</p>
                <p>I have, etc.</p>
                <closer><signed><hi rendition="#small-caps">T. J. O’Brien.</hi></signed></closer>


                <xi:include href="d478-a1.xml" xpointer="d478-a1"/>
            </div>
