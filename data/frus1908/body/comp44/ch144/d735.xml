    <text>
        <body>
            <div xml:id="d735">

                <pb facs="0913" n="811" sameAs="frus:frus1908/pg811"/>

                <head><hi rendition="#italic">The Acting Secretary of
                            State to Minister Russell.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1907-08-06"><hi rendition="#italic">August 6,
                        1907</hi></date>.</dateline></opener>
                <p>Answering yours July 27, you will present formal proposal for arbitration,
                    following instruction No 90.</p>
                <closer><signed><hi rendition="#small-caps">Bacon.</hi></signed></closer>
            </div>
        </body>
    </text>
