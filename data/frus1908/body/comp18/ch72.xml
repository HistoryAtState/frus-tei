    <text>
        <body>
            <div xml:id="ch72">

                <pb facs="0499" n="397" sameAs="frus:frus1908/pg397"/>

                <head>Treaty between the United States and Great Britain providing for reciprocal
                    rights for the United States and Canada in the matters of conveyance of
                    prisoners and wrecking and salvage</head>
                <p><hi rendition="#italic">Signed at Washington, May 18, 1908</hi>.</p>
                <p><hi rendition="#italic">Ratification advised by the Senate, May 20,
                    1908</hi>.</p>
                <p><hi rendition="#italic">Ratified by the President, June 19, 1908</hi>.</p>
                <p><hi rendition="#italic">Ratified by Great Britain, June 3, 1908</hi>.</p>
                <p><hi rendition="#italic">Ratifications exchanged at Washington, June 30,
                    1908</hi>.</p>
                <p><hi rendition="#italic">Proclaimed July 10, 1908.</hi></p>

                <xi:include href="ch72/d315.xml" xpointer="d315"/>
