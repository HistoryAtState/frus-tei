            <div xml:id="ch71">

                <pb facs="0486" n="384" sameAs="frus:frus1908/pg384"/>

                <head>Treaty between the United States and Great Britain relating to the Canadian
                    international boundary</head>
                <p><hi rendition="#italic">Signed at Washington, April 11, 1908</hi>.</p>
                <p><hi rendition="#italic">Ratification advised by the Senate, May 4, 1908</hi>.</p>
                <p><hi rendition="#italic">Ratified by the President, May 11, 1908</hi>.</p>
                <p><hi rendition="#italic">Ratified by Great Britain, May 16, 1908</hi>.</p>
                <p><hi rendition="#italic">Ratifications exchanged at Washington, June 4,
                    1908</hi>.</p>
                <p><hi rendition="#italic">Proclaimed, July 1, 1908.</hi></p>

                <xi:include href="ch71/d314.xml" xpointer="d314"/>
