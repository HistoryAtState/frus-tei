            <div xml:id="d753">

                <pb facs="0838" n="750" sameAs="frus:frus1933v04/pg750"/>

                <note rend="inline" type="source">635.4131/124: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Argentina</hi> (<hi rendition="#italic">White</hi>) <hi rendition="#italic"
                        >to the Acting Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">Buenos
                                Aires</hi></placeName>, <date calendar="gregorian"
                            when="1933-08-01T16:00:00-04:00">August 1, 1933—4
                        p.m.</date><lb/>[Received 5 p.m.]</dateline>
                </opener>
                <p>71. My despatch No. 2052 of May 4.<anchor n="24" xml:id="d753-f1"/> Principal
                    Anglo-Argentine Commercial Convention approved by both Houses Congress, time
                    limit for supplementary agreement (see clause 2, article 3) extended to
                    September 1st.</p>
                <closer><signed><hi rendition="#small-caps">White</hi></signed></closer>
            </div>
        </body>
    </text>
