    <text>
        <body>
            <div xml:id="d639">

                <pb facs="0666" n="578" xml:id="pg578"/>

                <note rend="inline" type="source">721.23/1984</note>
                <head><hi rendition="#italic">The Ambassador in Peru</hi> (<hi
                            rendition="#italic">Dearing</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 3042</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Lima</hi></placeName>, <date calendar="gregorian" when="1933-09-20"
                            >September 20, 1933</date>.<lb/>[Received September 28.]</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to the Leticia Conference at
                    Rio de Janeiro and the unsettled boundary questions with Ecuador, I have the
                    honor to enclose to the Department herewith copy of a memorandum of a
                    conversation I had with the Foreign Minister yesterday afternoon.</p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">Fred Morris
                    Dearing</hi></signed></closer>


                <xi:include href="d639-a1.xml" xpointer="d639-a1"/>
