            <div xml:id="d490">

                <pb facs="0559" n="471" sameAs="frus:frus1933v04/pg471"/>

                <note rend="inline" type="source">721.23/1103: Telegram</note>
                <head><hi rendition="#italic">The Minister in Colombia</hi> (<hi rendition="#italic">Caffery</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Bogotá</hi></placeName>, <date calendar="gregorian"
                            when="1933-02-10T15:00:00-05:00">February 10, 1933—3
                        p.m.</date><lb/>[Received 4:15 p.m.]</dateline>
                </opener>
                <p>33. Third paragraph my 29, February 9, 9 p.m. Vasquez ordered not to reach
                    Tarapacá until Sunday.</p>
                <closer><signed><hi rendition="#small-caps">Caffery</hi></signed></closer>
            </div>
        </body>
