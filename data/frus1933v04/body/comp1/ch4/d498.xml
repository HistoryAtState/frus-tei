    <text>
        <body>
            <div xml:id="d498">

                <pb facs="0562" n="474" sameAs="frus:frus1933v04/pg474"/>

                <note rend="inline" type="source">721.23/1119: Telegram</note>
                <head><hi rendition="#italic">The Minister in Colombia</hi> (<hi rendition="#italic"
                        >Caffery</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Bogotá</hi></placeName>, <date calendar="gregorian"
                            when="1933-02-12T21:00:00-05:00">February 12, 1933—9
                        p.m.</date><lb/>[Received February 13—9:15 a.m.]</dateline>
                </opener>
                <p>35. Department’s 22, February 11, noon.<anchor n="19" xml:id="d498-f1"/>
                    Brazilian Minister here delivered note yesterday afternoon to Colombian Minister
                    for Foreign Affairs explaining what Portuguese phrase “in compensation” means.
                    Colombian Government repeats it cannot accept the wording “in compensation”.</p>
                <closer><signed><hi rendition="#small-caps">Caffery</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d498-f1" n="19" xml:id="d498-f1-content">
                <p>Repeating telegram No. 21, February 11, 11 a.m., from the Ambassador in Brazil,
                        <ref target="#pg473">p. 473</ref>.</p>
            </note>
        </listAnnotation>
