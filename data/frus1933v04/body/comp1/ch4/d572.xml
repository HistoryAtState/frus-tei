    <text>
        <body>
            <div xml:id="d572">

                <pb facs="0620" n="532" sameAs="frus:frus1933v04/pg532"/>

                <note rend="inline" type="source">721.23/1717: Telegram</note>
                <head><hi rendition="#italic">The Minister in Colombia</hi> (<hi rendition="#italic">Caffery</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Bogotá</hi></placeName>, <date calendar="gregorian"
                            when="1933-05-14T18:00:00-05:00">May 14, 1933—6
                        p.m.</date><lb/>[Received May 15—9:10 a.m.]</dateline>
                </opener>
                <p>51. Department’s telegram No. 46, May 13 [<hi rendition="#italic">12</hi>] 10
                    a.m. [<hi rendition="#italic">6 p.m.</hi>].<anchor n="79a" xml:id="d572-f1"/>
                    Lopez is going to Lima in personal not official capacity (reported fully air
                    mail).</p>
                <p>Colombian Government has accepted formula (my telegram No. 49<anchor n="80"
                        xml:id="d572-f2"/>).</p>
                <closer><signed><hi rendition="#small-caps">Caffery</hi></signed></closer>
            </div>
        </body>
    </text>
