    <text>
        <body>
            <div xml:id="d458">

                <pb facs="0544" n="456" sameAs="frus:frus1933v04/pg456"/>

                <note rend="inline" type="source">721.23/1031: Telegram</note>
                <head><hi rendition="#italic">The Minister in Costa Rica</hi> (<hi rendition="#italic">Eberhardt</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">San
                                José</hi></placeName>, <date calendar="gregorian"
                            when="1933-02-06T10:00:00-06:00">February 6, 1933—10
                        a.m.</date><lb/>[Received 3:43 p.m.]</dateline>
                </opener>
                <p>6. Referring to Department’s telegram No. 4, February 4, 2 p.m.,<anchor n="95"
                        xml:id="d458-f1"/> Costa Rican Minister for Foreign Affairs assures me he is
                    cabling note to Peru invoking Kellogg Pact. Text of such note will be
                    transmitted to the Department when available.<anchor n="96" xml:id="d458-f2"
                    /></p>
                <closer><signed><hi rendition="#small-caps">Eberhardt</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d458-f1" n="95" xml:id="d458-f1-content">
