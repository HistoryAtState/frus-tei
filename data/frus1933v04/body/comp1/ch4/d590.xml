    <text>
        <body>
            <div xml:id="d590">

                <pb facs="0631" n="543" sameAs="frus:frus1933v04/pg543"/>

                <note rend="inline" type="source">721.23/1874: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Peru</hi> (<hi
                            rendition="#italic">Dearing</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Lima</hi></placeName>, <date calendar="gregorian"
                            when="1933-06-27T11:00:00-05:00">June 27, 1933—11
                        a.m.</date><lb/>[Received 1:10 p.m.]</dateline>
                </opener>
                <p>168. President yesterday informed me Leticia delivered to League commissioners
                    without adverse incident and that situation satisfactory.<anchor n="91"
                        xml:id="d590-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Dearing</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d590-f1" n="91" xml:id="d590-f1-content">
                <p>See League of Nations, <hi rendition="#italic">Official Journal</hi>, July 1933,
                    pp. 977–979.</p>
            </note>
        </listAnnotation>
    </standOff>
