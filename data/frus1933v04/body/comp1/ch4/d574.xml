    <text>
        <body>
            <div xml:id="d574">

                <pb facs="0621" n="533" xml:id="pg533"/>

                <note rend="inline" type="source">721.23/1730: Telegram</note>
                <head><hi rendition="#italic">The Minister in Colombia</hi> (<hi rendition="#italic"
                        >Caffery</hi>) <hi rendition="#italic">to the Secretary of State</hi><anchor
                        n="81" xml:id="d574-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Bogotá</hi></placeName>, <date calendar="gregorian"
                            when="1933-05-17T12:00:00-05:00">May 17, 1933—noon</date>.<lb/>[Received
                        2 p.m.]</dateline>
                </opener>
                <p>53. Olaya says Lopez Lima negotiations appear to have been unsuccessful; in his
                    opinion May 10th formula “is the only hope”.</p>
                <closer><signed><hi rendition="#small-caps">Caffery</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d574-f1" n="81" type="source" xml:id="d574-f1-content">
                <p>Repeated to the Minister in Switzerland, May 18, 2 p.m., as telegram No. 102.</p>
            </note>
        </listAnnotation>
