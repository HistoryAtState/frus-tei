                <pb facs="0480" n="392" sameAs="frus:frus1933v04/pg392"/>

                <note rend="inline" type="source">721.23/669: Telegram</note>
                <head><hi rendition="#italic">The Minister in Colombia</hi> (<hi rendition="#italic">Caffery</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Bogotá</hi></placeName>, <date calendar="gregorian"
                            when="1933-01-07T17:00:00-05:00">January 7, 1933—5
                        p.m.</date><lb/>[Received 6:07 p.m.]</dateline>
                </opener>
                <p>7. For White. Olaya says he has not agreed to formula reported by Morgan. Details
                    follow.</p>
                <closer><signed><hi rendition="#small-caps">Caffery</hi></signed></closer>
            </div>
        </body>
    </text>
