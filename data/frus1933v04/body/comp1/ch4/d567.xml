            <div xml:id="d567">

                <pb facs="0617" n="529" sameAs="frus:frus1933v04/pg529"/>

                <note rend="inline" type="source">721.23/1711: Telegram</note>
                <head><hi rendition="#italic">The Minister in Colombia</hi> (<hi rendition="#italic">Caffery</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Bogotá</hi></placeName>, <date
                            ana="#date_undated-inferred-from-document-content" calendar="gregorian"
                            notAfter="1933-05-12T12:31:00-04:00"
                            notBefore="1933-05-11T17:00:00-04:00">undated</date>.<lb/>[Received May
                        12, 1933—12:31 p.m.]</dateline>
                </opener>
                <p>49. Department’s 45, May 11, 5 p.m.<anchor n="78" xml:id="d567-f1"/> Note being
                    delivered today. Santos has been instructed to accept formula on behalf of the
                    Colombian Government.</p>
                <closer><signed><hi rendition="#small-caps">Caffery</hi></signed></closer>
            </div>
        </body>
    </text>
