            <div xml:id="d587">

                <pb facs="0629" n="541" xml:id="pg541"/>

                <note rend="inline" type="source">721.23/1794: Telegram</note>
                <head><hi rendition="#italic">The Minister in Switzerland</hi> (<hi rendition="#italic">Wilson</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Geneva</hi></placeName>, <date calendar="gregorian"
                            when="1933-06-01T10:00:00+01:00">June 1, 1933—10
                        a.m.</date><lb/>[Received June 1—4:38 a.m.]</dateline>
                </opener>
                <p>194. My 190, May 26, 6 p.m. League Secretariat would appreciate as early a
                    decision as possible with regard to an American member on the commission.</p>
                <closer><signed><hi rendition="#small-caps">Wilson</hi></signed></closer>
            </div>
        </body>
