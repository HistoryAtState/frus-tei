    <text>
        <body>
            <div xml:id="d256">

                <pb facs="0407" n="319" sameAs="frus:frus1933v04/pg319"/>

                <note rend="inline" type="source">724.3415/3103</note>
                <head><hi rendition="#italic">The Paraguayan Minister</hi> (<hi rendition="#italic"
                        >Bordenave</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi><anchor n="96" xml:id="d256-f1"/></head>
                <opener>
                    <seg rendition="#center">[Translation]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1933-05-10">May 10, 1933</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Mr. Secretary</hi>: I have the honor to address
                    myself to Your Excellency, for the purpose of advising you that, by a Decree
                    signed today, my Government declared the state of war with the Republic of
                    Bolivia.</p>
                <p>I renew [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Enrique Bordenave</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d256-f1" n="96" type="source" xml:id="d256-f1-content">
                <p>Acknowledged May 12.</p>
            </note>
        </listAnnotation>
    </standOff>
