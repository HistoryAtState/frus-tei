    <text>
        <body>
            <div xml:id="d142">

                <pb facs="0329" n="241" sameAs="frus:frus1933v04/pg241"/>

                <note rend="inline" type="source">724.3415/2725a: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Ambassador in Brazil</hi> (<hi rendition="#italic"
                            >Morgan</hi>)<anchor n="2" xml:id="d142-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1933-01-04T11:00:00-05:00">January 4, 1933—11
                        a.m.</date></dateline>
                </opener>
                <p>1. Please report any information you can discreetly obtain regarding position
                    Government is likely to take on request of Neutral Commission of December
                        31<anchor n="3" xml:id="d142-f2"/> for information as to steps Government
                    would be willing to take in order to bring about peace between Bolivia and
                    Paraguay.</p>
                <closer><signed><hi rendition="#small-caps">Stimson</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d142-f1" n="2" type="source" xml:id="d142-f1-content">
                <p>The same, January 4, 11 a.m., to the diplomatic representatives in Argentina (as
                    telegram No. 1), Chile (No. 3), and Peru (No. 2).</p>
            </note>
