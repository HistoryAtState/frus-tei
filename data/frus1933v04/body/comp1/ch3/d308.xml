            <div xml:id="d308">

                <pb facs="0441" n="353" sameAs="frus:frus1933v04/pg353"/>

                <note rend="inline" type="source">724.3415/3306</note>
                <head><hi rendition="#italic">The Ambassador in Brazil</hi> (<hi rendition="#italic"
                        >Gibson</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 15</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">Rio de
                                Janeiro</hi></placeName>, <date calendar="gregorian"
                            when="1933-08-23">August 23, 1933</date>.<lb/>[Received September
                        5.]</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to refer to the Embassy’s
                    despatch No. 4182 of July 29, 1933, on the subject noted above, and to enclose
                    herewith a copy of a memorandum of a conversation I had on August 21 with the
                    Minister for Foreign Affairs with respect to the Chaco negotiations.</p>
                <p>Respectfully yours,</p>
                <closer>For the Ambassador<lb/><signed><hi rendition="#small-caps">Walter C.
                            Thurston</hi></signed></closer>


                <xi:include href="d308-a1.xml" xpointer="d308-a1"/>
            </div>
