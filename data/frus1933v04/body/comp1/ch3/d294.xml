    <text>
        <body>
            <div xml:id="d294">

                <pb facs="0433" n="345" sameAs="frus:frus1933v04/pg345"/>

                <note rend="inline" type="source">724.3415/3219</note>
                <head><hi rendition="#italic">The Chairman of the Commission of Neutrals</hi> (<hi
                        rendition="#italic">White</hi>)<anchor n="20" xml:id="d294-f1"/>
                    <hi rendition="#italic">to the Paraguayan Minister</hi> (<hi rendition="#italic"
                        >Bordenave</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1933-06-29">June 29, 1933</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Dear Mr. Minister</hi>: Thank you very much for your
                    letter of the twenty-eighth instant. I desire to express to you the thanks of
                    the Government of the United States for the expressions you make therein
                    regarding the action of the Neutral Commission. I have sent copies of your
                    letter to the representatives of the other Governments that formed part of the
                    Commission.</p>
                <p>Yours, very sincerely,</p>
                <closer><signed><hi rendition="#small-caps">Francis White</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d294-f1" n="20" type="source" xml:id="d294-f1-content">
                <p>Mr. White resigned as Assistant Secretary of State July 2, 1933.</p>
            </note>
        </listAnnotation>
    </standOff>
