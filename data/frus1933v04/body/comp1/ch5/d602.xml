    <text>
        <body>
            <div xml:id="d602">

                <pb facs="0637" n="549" sameAs="frus:frus1933v04/pg549"/>

                <note rend="inline" type="source">704.2123/2: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Peru</hi> (<hi rendition="#italic"
                        >Dearing</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Lima</hi></placeName>, <date calendar="gregorian"
                            when="1933-02-16T19:00:00-05:00">February 16, 1933—7
                        p.m.</date><lb/>[Received 8:22 p.m.]</dateline>
                </opener>
                <p>87. Referring to Department’s telegram No. 32, February 16, 1 p.m.,
                        Manzanilla<anchor n="2" xml:id="d602-f1"/> cordially acquiesces. I will
                    arrange details with Lozano.<anchor n="3" xml:id="d602-f2"/></p>
                <closer><signed><hi rendition="#small-caps">Dearing</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d602-f1" n="2" xml:id="d602-f1-content">
                <p>José Matías Manzanilla, Peruvian Minister for Foreign Affairs.</p>
            </note>
            <note corresp="#d602-f2" n="3" xml:id="d602-f2-content">
                <p>Fabio Lozano y Lozano, Colombian Minister in Peru.</p>
            </note>
        </listAnnotation>
    </standOff>
