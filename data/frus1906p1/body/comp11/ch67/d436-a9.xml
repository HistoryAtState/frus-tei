    <text>
        <body>
            <div xml:id="d436-a9">

                <pb facs="0600" n="494" sameAs="frus:frus1906p1/pg494"/>

                <head><hi rendition="#small-caps">executive order.</hi></head>
                <p>It is hereby ordered that the temporary administration of the government of the
                    Republic of Cuba in virtue of the requirements of article 3 of the treaty of May
                    22, 1903, shall be conducted in Habana by the provisional governor, subject to
                    the supervision of the Secretary of War; and all business in relation thereto in
                    this country will be transacted in the Bureau of Insular Affairs of the War
                    Department, where it will be made a matter of official record.</p>
                <closer><signed><hi rendition="#small-caps">Theodore Roosevelt.</hi></signed>
                    <lb/>
                    <dateline rendition="#float-left"><placeName><hi rendition="#small-caps">The
                                White House</hi></placeName>,<lb/><date calendar="gregorian"
                            when="1906-10-23"><hi rendition="#italic">October 23,
                        1906</hi></date>.</dateline>
                </closer>
            </div>
        </body>
