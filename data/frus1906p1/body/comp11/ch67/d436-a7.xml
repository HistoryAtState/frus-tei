    <text>
        <body>
            <div xml:id="d436-a7">

                <pb facs="0600" n="494" xml:id="pg494"/>

                <opener><seg rendition="#center">[Inclosure 7.]</seg></opener>
                <head><hi rendition="#small-caps">proclamation.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Habana</hi></placeName>, <date calendar="gregorian"
                            when="1906-10-13"><hi rendition="#italic">October 13,
                        1906</hi></date>.</dateline></opener>
                <p>By the direction and with the authority of the President of the United States, I
                    hereby lay down the office of provisional governor of Cuba, assumed by me
                    September 29, 1906, and turn the same over to Charles E. Magoon as my
                    successor.</p>
                <closer><signed><hi rendition="#small-caps">Wm. H. Taft.</hi></signed></closer>
            </div>
        </body>
