    <text>
        <body>
            <div xml:id="d431">

                <pb facs="0592" n="486" sameAs="frus:frus1906p1/pg486"/>

                <head><hi rendition="#italic">Chargé Sleeper to the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Habana</hi></placeName>, <date calendar="gregorian" when="1906-09-17"
                                ><hi rendition="#italic">September 17, 1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 190.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a
                    translation of presidential decree No. 383, of the 17th instant, directing the
                    government forces to suspend all operations in the field and to remain on the
                    defensive.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Jacob Sleeper</hi>,<lb/><hi
                            rendition="#italic">Chargé d’ Affaires ad
                    interim.</hi></signed></closer>


                <xi:include href="d431-a1.xml" xpointer="d431-a1"/>
