    <text>
        <body>
            <div xml:id="d413">

                <pb facs="0581" n="475" sameAs="frus:frus1906p1/pg475"/>

                <head><hi rendition="#italic">Chargé Sleeper to the
                            Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi></placeName>,<lb/><date calendar="gregorian"
                            when="1906-09-11"><hi rendition="#italic">September 11,
                        1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 184.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a
                    translation of President Palma’s proclamation, dated September 8, 1906, calling
                    for an extra session of Congress, and to be, sir,</p>
                <p>Your obedient servant,</p>
                <closer><signed><hi rendition="#small-caps">Jacob Sleeper.</hi></signed></closer>


                <xi:include href="d413-a1.xml" xpointer="d413-a1"/>
