    <text>
        <body>
            <div xml:id="d136">

                <pb facs="0261" n="155" sameAs="frus:frus1906p1/pg155"/>

                <head><hi rendition="#italic">President Roosevelt to the President of
                    Chile.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <hi rendition="#italic"><date
                                calendar="gregorian" when="1906-08-19">August 19,
                        1906</date></hi>.</dateline></opener>
                <p>In the name of the people of the United States I offer tribute of sorrow and
                    sympathy to their afflicted brethren of Chile by reason of the awful disaster
                    that has befallen Valparaiso.</p>
                <closer><signed><hi rendition="#small-caps">Theodore
                    Roosevelt.</hi></signed></closer>
            </div>
        </body>
    </text>
