    <text>
        <body>
            <div xml:id="d577">

                <pb facs="0810" n="704" xml:id="pg704"/>

                <head><hi rendition="#italic">Consul Cornelius to
                        the Third Assistant Secretary of State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Consulate</hi>,<lb/><hi rendition="#italic">St. Johns,
                                Newfoundland</hi></placeName>, <date calendar="gregorian"
                            when="1906-11-03"><hi rendition="#italic">November 3,
                        1906</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I beg to inclose the first official copy of
                    the sections of the fishbait act, published for general information. I regret
                    that I could not procure a copy sooner.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">George O.
                    Cornelius.</hi></signed></closer>


                <xi:include href="d577-a1.xml" xpointer="d577-a1"/>
