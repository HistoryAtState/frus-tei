                <pb facs="0770" n="664" sameAs="frus:frus1906p1/pg664"/>

                <opener><seg rendition="#center">[Inclosure.]</seg></opener>
                <head><hi rendition="#italic">The Secretary of Commerce and
                            Labor to the Secretary of
                    State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of Commerce and Labor,<lb/>Office of the
                                Secretary</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1905-12-29"><hi rendition="#italic">December 29,
                        1905</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: There is transmitted herewith copy of a
                    letter just received from fisheries agent A. B. Alexander, dated Bay of Islands,
                    Newfoundland, December 21, 1905.</p>
                <closer><signed><hi rendition="#small-caps">V. H. Metcalf.</hi></signed></closer>
            </div>
        </body>
