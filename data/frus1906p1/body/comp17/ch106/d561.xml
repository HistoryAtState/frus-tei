    <text>
        <body>
            <div xml:id="d561">

                <pb facs="0773" n="667" sameAs="frus:frus1906p1/pg667"/>

                <head><hi rendition="#italic">The Secretary of State to
                        the British Ambassador.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1906-01-20"><hi rendition="#italic">January 20,
                        1906</hi></date>.</dateline></opener>
                <p>My <hi rendition="#small-caps">Dear Sir Mortimer</hi>: I send you a copy of a
                    letter which I have just received from Mr. Gardner, the Representative of
                    Gloucester in the House, which indicates the kindly feeling happily existing
                    between our American fishermen and the Newfoundland officials.</p>
                <p>Faithfully, yours,</p>
                <closer><signed><hi rendition="#small-caps">Elihu Root.</hi></signed></closer>


                <xi:include href="d561-a1.xml" xpointer="d561-a1"/>
