    <text>
        <body>
            <div xml:id="d532">

                <pb facs="0745" n="639" sameAs="frus:frus1906p1/pg639"/>

                <head><hi rendition="#italic">President Roosevelt
                        to the President of the French
                    Republic.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1906-03-12"><hi rendition="#italic">March 12,
                        1906</hi></date>.</dateline></opener>
                <p>I have learned with sorrow of the terrible calamity which has befallen France,
                    and tender to its Government and the afflicted families the sincere sympathy of
                    the Government and the people of the United States.</p>
                <closer><signed><hi rendition="#small-caps">Theodore
                    Roosevelt.</hi></signed></closer>
            </div>
        </body>
    </text>
