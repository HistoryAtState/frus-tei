    <text>
        <body>
            <div xml:id="d470">

                <pb facs="0630" n="524" xml:id="pg524"/>

                <head><hi rendition="#italic">The Danish Minister to the
                            Secretary of State.</hi></head>
                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of Denmark</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1906-01-29"><hi rendition="#italic">January 29,
                        1906</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Mr. Secretary of State</hi>: By order of my
                    Government, I have to perform the painful duty of advising your excellency that
                    His Majesty the King, my august sovereign, died suddenly this afternoon at
                    3.20.</p>
                <p>I venture to beg your excellency to be so good as to convey this grievous
                    intelligence to the President of the United States.</p>
                <p>Be pleased to accept, Mr. Secretary of State, etc.,</p>
                <closer><signed><hi rendition="#small-caps">C. Brun.</hi></signed></closer>
            </div>
        </body>
