    <text>
        <body>
            <div xml:id="d499">

                <pb facs="0678" n="572" sameAs="frus:frus1906p1/pg572"/>

                <head><hi rendition="#italic">Minister Dawson to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">Santo
                                Domingo</hi></placeName>, <date calendar="gregorian"
                            when="1906-10-18"><hi rendition="#italic">October 18,
                        1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 309.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a copy
                    of a chronology of political events in Santo Domingo since the independence of
                    the country, prepared by me for the information of whoever may be in charge of
                    this legation.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. C. Dawson.</hi></signed></closer>


                <xi:include href="d499-a1.xml" xpointer="d499-a1"/>
            </div>
