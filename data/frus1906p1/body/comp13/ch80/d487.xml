    <text>
        <body>
            <div xml:id="d487">

                <pb facs="0662" n="556" sameAs="frus:frus1906p1/pg556"/>

                <head><hi rendition="#italic">Minister Dawson to the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">Santo
                                Domingo</hi></placeName>, <date calendar="gregorian"
                            when="1906-02-21"><hi rendition="#italic">February 21,
                        1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 219.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit you herewith a
                    copy and translation of a letter from the government physician in charge of the
                    Red Cross at Sanchez, in which he expresses his gratitude for the assistance
                    given him by United States naval officers in attending the Dominican wounded in
                    the recent civil disorders.</p>
                <p>I also inclose copy of my reply to him.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. C. Dawson.</hi></signed></closer>



                <xi:include href="d487-a1.xml" xpointer="d487-a1"/>
