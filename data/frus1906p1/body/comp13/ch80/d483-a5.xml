                <pb facs="0654" n="548" sameAs="frus:frus1906p1/pg548"/>

                <opener><seg rendition="#center">[Inclosure 5.—Translation.]</seg></opener>
                <head><hi rendition="#italic">Resignation of President Morales before
                    Congress.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Santo Domingo</hi></placeName>, <date calendar="gregorian"
                            when="1906-01-12"><hi rendition="#italic">January 12,
                        1906</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Citizen President</hi>: In virtue of the provisions
                    of the constitution, I bring through you knowledge of the high body over which
                    you preside that I renounce the Presidency of the Republic with which I had been
                    honored by the votes of my fellow-citizens.</p>
                <p>I salute you, attentively,</p>
                <closer><signed><hi rendition="#small-caps">Morales, L.</hi>,<lb/><hi
                            rendition="#italic">Citizen President of the National
                        Congress.</hi></signed></closer>
            </div>
        </body>
    </text>
