    <text>
        <body>
            <div xml:id="d337">

                <pb facs="0468" n="362" sameAs="frus:frus1906p1/pg362"/>

                <head><hi rendition="#italic">The Acting Secretary of
                            State to Ambassador Reid.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1906-10-13"><hi rendition="#italic">October 13,
                        1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 315.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to instruction No. 297, of the
                    27th ultimo, I inclose herewith, for your information, a copy of a letter from
                    Bishop Brent, in further relation to international action looking to the
                    suppression of the opium traffic with China.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alvey A. Adee</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>


                <xi:include href="d337-a1.xml" xpointer="d337-a1"/>
