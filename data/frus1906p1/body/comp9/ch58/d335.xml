        <body>
            <div xml:id="d335">

                <pb facs="0465" n="359" sameAs="frus:frus1906p1/pg359"/>

                <head><hi rendition="#italic">Minister Rockhill to
                        the Secretary of State.</hi></head>
                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">Peking,
                                China</hi></placeName>, <date calendar="gregorian" when="1906-09-21"
                                ><hi rendition="#italic">September 21, 1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 400.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In continuation of my dispatch No. 393 of
                    the 8th instant, I have the honor to transmit herewith a translation of an
                    imperial edict which appeared yesterday, decreeing the abolishment within ten
                    years of opium smoking and ordering the council of state to draw up regulations
                    for carrying the same into effect.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. W. Rockhill.</hi></signed></closer>



                <xi:include href="d335-a1.xml" xpointer="d335-a1"/>
