                <pb facs="0331" n="225" sameAs="frus:frus1906p1/pg225"/>

                <head><hi rendition="#italic">Minister Rockhill to
                        the Secretary of State.</hi></head>
                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Peking</hi></placeName>, <hi rendition="#italic"><date
                                calendar="gregorian" when="1906-10-09">October 9,
                        1906</date></hi>.</dateline>
                    <seg rendition="#float-left">No. 423.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the, honor to transmit herewith copy
                    of a note received to-day from the foreign office, informing me that the
                    Japanese troops having now evacuated Hsin-min Fu (or tun) said locality is
                    opened to international trade.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. W. Rockhill.</hi></signed></closer>


                <xi:include href="d206-a1.xml" xpointer="d206-a1"/>
