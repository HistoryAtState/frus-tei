    <text>
        <body>
            <div xml:id="d210">

                <pb facs="0333" n="227" sameAs="frus:frus1906p1/pg227"/>

                <head><hi rendition="#italic">The Acting Secretary of State to Chargé
                    Coolidge.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <hi rendition="#italic"><date
                                calendar="gregorian" when="1906-11-23">November 23,
                        1906</date></hi>.</dateline>
                    <seg rendition="#float-left">No. 217.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith, for your information, a
                    copy of a dispatch from the American ambassador to Russia, reporting the
                    substance of a conversation which he has had with the Russian minister for
                    foreign affairs respecting the establishment of Chinese customs-houses in
                    Manchuria.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Robert Bacon</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>
                <postscript>
                    <p>(<hi rendition="#small-caps">Note.</hi>—Same to the Embassy at Tokyo, No. 47,
                        November 23, 1906.)</p>
                </postscript>


                <xi:include href="d210-a1.xml" xpointer="d210-a1"/>
