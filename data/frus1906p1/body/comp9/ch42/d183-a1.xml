    <text>
        <body>
            <div xml:id="d183-a1">

                <pb facs="0311" n="205" xml:id="pg205"/>

                <opener><seg rendition="#center">[Inclosure 1.]</seg></opener>
                <head><hi rendition="#italic">Mr. Martin to Mr. Rockhill.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Hankow</hi></placeName>, <hi rendition="#italic"><date
                                calendar="gregorian" when="1906-06-19">June 19,
                        1906</date></hi>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to forward herewith a copy
                    of the regulations for the governing of the proposed new commercial settlement
                    at Chang-teh-fu, Honan.</p>
                <p>This city is situated in the Yuan River not far from the west shore of the
                    Tung-ting Lake, and will be opened to foreign business and residence on July 2,
                    1906.</p>
                <closer>(Signed) <signed><hi rendition="#small-caps">Wm.
                    Martin.</hi></signed></closer>
            </div>
        </body>
    </text>
