    <text>
        <body>
            <div xml:id="d224">

                <pb facs="0346" n="240" sameAs="frus:frus1906p1/pg240"/>

                <head><hi rendition="#italic">The Secretary of State to Minister Conger.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <hi rendition="#italic"><date
                                calendar="gregorian" when="1904-10-12">October 12,
                        1904</date></hi>.</dateline>
                    <seg rendition="#float-left">No. 843.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith, for your information, a
                    copy of a note from the German ambassador at this capital, suggesting that steps
                    be taken to secure the postponement for a few months of the date on which the
                    new Chinese tracle-marks regulations are to go into effect.</p>
                <p>A copy of my note in reply is also inclosed.</p>
                <p>I am, sir, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>




                <xi:include href="d224-a1.xml" xpointer="d224-a1"/>
