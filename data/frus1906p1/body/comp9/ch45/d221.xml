    <text>
        <body>
            <div xml:id="d221">

                <pb facs="0342" n="236" sameAs="frus:frus1906p1/pg236"/>

                <head><hi rendition="#italic">Minister Conger to the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Peking</hi></placeName>, <hi rendition="#italic"><date
                                calendar="gregorian" when="1904-06-24">June 24,
                        1904</date>.</hi></dateline>
                    <seg rendition="#float-left">No. 1643.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Continuing the subject-matter of my No.
                        1626,<anchor n="a" xml:id="d221-f1"/> I have the honor to inclose herewith
                    copy of trade-mark regulations furnished me by the foreign office in a note
                    dated the 9th instant, herewith inclosed. I also inclose a copy of my reply
                    thereto.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">E. H. Conger.</hi></signed></closer>


                <xi:include href="d221-a1.xml" xpointer="d221-a1"/>
            </div>
        </body>
    </text>
