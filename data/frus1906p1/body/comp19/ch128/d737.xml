    <text>
        <body>
            <div xml:id="d737">

                <pb facs="0974" n="868" sameAs="frus:frus1906p1/pg868"/>

                <head><hi rendition="#italic">The Guatemalan Minister of Foreign Affairs to the
                        Secretary of State.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Guatemala</hi></placeName>, <date calendar="gregorian"
                            when="1906-10-23"><hi rendition="#italic">October 23,
                        1906</hi></date>.</dateline></opener>
                <p>The President and Government of Guatemala sincerely thank you for expression of
                    condolence and immediate acceptance Chargé Bengoechea.</p>
                <closer><signed><hi rendition="#small-caps">Juan Barrios</hi>.</signed></closer>
            </div>
        </body>
    </text>
