    <text>
        <body>
            <div xml:id="d738">

                <pb facs="0974" n="868" sameAs="frus:frus1906p1/pg868"/>

                <head><hi rendition="#italic">President Roosevelt to the President of
                        Guatemala.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1906-10-26"><hi rendition="#italic">October 26,
                        1906</hi></date>.</dateline></opener>
                <p>I thank you for your kind message. On behalf of this nation I paid sympathetic
                    respects to the distinguished deceased.</p>
                <closer><signed><hi rendition="#small-caps">Theodore
                    Roosevelt.</hi></signed></closer>
            </div>
        </body>
    </text>
