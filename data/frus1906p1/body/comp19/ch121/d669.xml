    <text>
        <body>
            <div xml:id="d669">

                <pb facs="0930" n="824" sameAs="frus:frus1906p1/pg824"/>

                <head><hi rendition="#italic">Minister Combs to the
                            Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Guatemala</hi></placeName>, <date calendar="gregorian"
                            when="1906-05-09"><hi rendition="#italic">May 9,
                        1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 381.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to forward a copy of a
                    telegram from Kensett Champney &amp; Co., complaining of the unlawful drafting
                    of their colonists for government use.</p>
                <p>I made immediate representations to Mr. Barrios, with a resulting promise that
                    the grounds for complaint should not recur.</p>
                <p>I inclose copy of Mr. Barrios’s note to that effect.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Leslie Combs.</hi></signed></closer>



                <xi:include href="d669-a1.xml" xpointer="d669-a1"/>
