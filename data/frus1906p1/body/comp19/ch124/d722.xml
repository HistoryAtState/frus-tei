    <text>
        <body>
            <div xml:id="d722">

                <pb facs="0959" n="853" sameAs="frus:frus1906p1/pg853"/>

                <head><hi rendition="#italic">Chargé Brown to the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Guatemala</hi></placeName>, <date calendar="gregorian"
                            when="1906-08-07"><hi rendition="#italic">August 7,
                        1906</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to confirm on the overleaf
                    cables exchanged between President Bonilla and Mr. Combs, as representing the
                    diplomatic corps accredited to Honduras on the occasion of the signing of peace
                    between Honduras, Guatemala, and Salvador.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Philip Brown.</hi></signed></closer>




                <xi:include href="d722-a1.xml" xpointer="d722-a1"/>
