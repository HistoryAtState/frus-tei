    <text>
        <body>
            <div xml:id="d102">

                <pb facs="0218" n="112" sameAs="frus:frus1906p1/pg112"/>

                <head><hi rendition="#italic">Chargé Richardson to the Secretary of
                    State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Petropolis</hi></placeName>, <date calendar="gregorian"
                            when="1906-03-03"><hi rendition="#italic">March 3,
                        1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 153.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to report that on March 1
                    Dr. Affonso Penna was elected President and Dr. Nilo Peganha Vice-President of
                    the Republic for the period of four years commencing November 15 next.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charles
                    Richardson</hi>.</signed></closer>
            </div>
        </body>
    </text>
