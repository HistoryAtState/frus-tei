    <text>
        <body>
            <div xml:id="d114">

                <pb facs="0222" n="116" sameAs="frus:frus1906p1/pg116"/>

                <head><hi rendition="#italic">Ambassador Griscom to the Secretary of
                    State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Petropolis</hi></placeName>, <date calendar="gregorian"
                            when="1906-08-27"><hi rendition="#italic">August 27,
                        1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 19.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a copy
                    of a paper on “Brazil, the United States and Monroeism,” rumored to have been
                    written by Baron Rio Branco, Brazilian minister for foreign affairs, under the
                    nom de plume of J. Penn.</p>
                <p>A translation by the secretary of this embassy is also inclosed.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Lloyd Griscom.</hi></signed></closer>


                <xi:include href="d114-a1.xml" xpointer="d114-a1"/>
            </div>
        </body>
