    <text>
        <body>
            <div xml:id="d117">

                <pb facs="0242" n="136" sameAs="frus:frus1906p1/pg136"/>

                <head><hi rendition="#italic">Chargé Richardson to the Secretary of
                    State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Petropolis</hi></placeName>, <hi rendition="#italic"><date
                                calendar="gregorian" when="1906-05-17">May 17,
                        1906</date></hi>.</dateline>
                    <seg rendition="#float-left">No. 166.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my dispatch No. 162, inclosing
                    a copy of the Brazilian President’s message to Congress, I now have the honor to
                    inclose an excellent translation of it from the Brazilian Review of May 15,
                    1906.</p>
                <p>I have the honor to be, etc,</p>
                <closer><signed><hi rendition="#small-caps">Charles Richardson</hi>,<lb/><hi
                            rendition="#italic">Chargé d’ Affaires ad
                    interim.</hi></signed></closer>



                <xi:include href="d117-a1.xml" xpointer="d117-a1"/>
            </div>
