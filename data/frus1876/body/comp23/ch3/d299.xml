                <pb facs="0585" n="529" sameAs="frus:frus1876/pg529"/>

                <head>No. 289.<lb/><hi rendition="#italic">Mr. Cushing to Mr. Fish.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1875-11-16"><hi rendition="#italic">November</hi> 16,
                        1875</date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Fish</hi>, <hi rendition="#italic"
                        >Secretary, Washington:</hi></p>
                <p>Spanish note has come in.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>It repeats assurance of trial of Burriel. * * *</p>
                <p rendition="#center">* * * * * * *</p>
                <closer><signed>CUSHING.</signed></closer>
            </div>
        </body>
