    <text>
        <body>
            <div xml:id="d302">

                <pb facs="0589" n="533" sameAs="frus:frus1876/pg533"/>

                <head>No. 292.<lb/><hi rendition="#italic">Mr. Cushing to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1876-04-21"><hi rendition="#italic">April</hi> 21, 1876</date>.
                        (Received May 8.)</dateline>
                    <seg rendition="#float-left">No. 921.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have just received from the minister of
                    state a note, dated today, copy and translation of which are annexed hereto,
                    informing me that the supreme council of war has declared itself competent to
                    try the case of Burriel, and has formally instituted the corresponding
                    proceedings and appointed a prosecuting officer and secretary.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>C. CUSHING.</signed></closer>


                <xi:include href="d302-a1.xml" xpointer="d302-a1"/>
            </div>
