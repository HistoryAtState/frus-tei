        <body>
            <div xml:id="d277">

                <pb facs="0557" n="501" sameAs="frus:frus1876/pg501"/>

                <head>No. 267.<lb/><hi rendition="#italic">Mr. Cushing to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1874-09-27"><hi rendition="#italic">September</hi> 27,
                        1874</date>. (Received October 23.)</dateline>
                    <seg rendition="#float-left">No. 106.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith copy
                    of a communication addressed by me to the minister of state on the 24th instant,
                    in relation to the affair of Brigadier Burriel.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>C. CUSHING.</signed></closer>



                <xi:include href="d277-a1.xml" xpointer="d277-a1"/>
            </div>
