        <body>
            <div xml:id="d281">

                <pb facs="0565" n="509" sameAs="frus:frus1876/pg509"/>

                <head>No. 271.<lb/><hi rendition="#italic">Mr. Cushing to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1874-12-05"><hi rendition="#italic">December</hi> 5, 1874</date>.
                        (Received December 24.)</dateline>
                    <seg rendition="#float-left">No. 177.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith translation of an
                    official note from the minister of state. * * * * * *</p>
                <p>I am compelled to postpone * * * some observations which have occurred to me on
                    the subject.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>C. CUSHING.</signed></closer>


                <xi:include href="d281-a1.xml" xpointer="d281-a1"/>
            </div>
