    <text>
        <body>
            <div xml:id="d296">

                <pb facs="0577" n="521" xml:id="pg521"/>

                <head>No. 286.<lb/><hi rendition="#italic">Mr. Cushing to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1875-10-06"><hi rendition="#italic">October</hi> 6, 1875</date>.
                        (Received October 29.)</dateline>
                    <seg rendition="#float-left">No. 580.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I annex hereto copy of a note on the matter
                    of Burriel, presented to the minister of state, after seeing him by appointment,
                    as described in my No. 579 of this date.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>C. CUSHING.</signed></closer>


                <xi:include href="d296-a1.xml" xpointer="d296-a1"/>
