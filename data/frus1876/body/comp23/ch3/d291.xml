    <text>
        <body>
            <div xml:id="d291">

                <pb facs="0575" n="519" xml:id="pg519"/>

                <head>No. 281.<lb/><hi rendition="#italic">Mr. Fish
                        to Mr. Cushing.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1875-09-22"><hi rendition="#italic">September</hi> 22,
                        1875</date>.</dateline>
                    <seg rendition="#float-left">No. 238]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>:</p>
                <p rendition="#center">* * * * * * *</p>
                <p>Your proceedings, as set forth in your No. 492, of the 25th ultimo, in regard to
                    the promotion of General Burriel, are approved by this Department.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>HAMILTON FISH.</signed></closer>
            </div>
        </body>
    </text>
