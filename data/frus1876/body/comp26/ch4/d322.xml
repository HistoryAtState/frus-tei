    <text>
        <body>
            <div xml:id="d322">

                <pb facs="0642" n="586" sameAs="frus:frus1876/pg586"/>

                <head>No. 313.<lb/><hi rendition="#italic">Mr. Schuyler to Mr. Campbell.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Consulate-General</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1876-09-28"><hi rendition="#italic">September</hi> 28,
                        1876</date>. (Received October 21.)</dateline>
                    <seg rendition="#float-left">No. 13.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose you an
                    interesting and valuable paper on the productions and trade of the district of
                    Philippopolis, prepared, at my request, by Mr. John E. Gueshoff, of
                    Philippopolis.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>EUGENE SCHUYLER,</signed></closer>


                <xi:include href="d322-a1.xml" xpointer="d322-a1"/>
