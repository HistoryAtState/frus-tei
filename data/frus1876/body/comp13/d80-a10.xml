    <text>
        <body>
            <div xml:id="d80-a10">

                <pb facs="0199" n="143" xml:id="pg143"/>

                <opener><seg rendition="#center">[Inclosure 10 in No. 321.]</seg></opener>
                <head><hi rendition="#italic">Table showing the total number of persons included in
                        passports issued during</hi> 1875.</head>
                <table cols="2" rows="4">
                    <row role="label">
                        <cell>Applicants</cell>
                        <cell role="num">223</cell>
                    </row>
                    <row>
                        <cell>Wives of applicants</cell>
                        <cell role="num">36</cell>
                    </row>
                    <row>
                        <cell rendition="#nowrap">Minors included in passports of their parents or
                            guardians</cell>
                        <cell rendition="#border-bottom" role="num">102</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell role="num">361</cell>
                    </row>
                </table>
            </div>
        </body>
    </text>
