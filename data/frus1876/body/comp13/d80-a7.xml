    <text>
        <body>
            <div xml:id="d80-a7">

                <pb facs="0197" n="141" sameAs="frus:frus1876/pg141"/>

                <opener><seg rendition="#center">[Inclosure 7 in No. 321.]</seg></opener>
                <head><hi rendition="#italic">Table showing the ages of applicants to whom passports
                        were issued</hi>.</head>
                <table cols="3" rows="11">
                    <row role="label">
                        <cell rendition="#border-bottom #border-top #border-right">Ages.</cell>
                        <cell rendition="#border-bottom #border-top #border-right">Native.</cell>
                        <cell rendition="#border-bottom #border-top">Naturalized.</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">Under 18</cell>
                        <cell rendition="#border-right" role="num">19</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell rendition="#border-right">Over 18 and under 21</cell>
                        <cell rendition="#border-right" role="num">28</cell>
                        <cell><anchor n="*" xml:id="d80-f1"/>1</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">Over 21 and under 25</cell>
                        <cell rendition="#border-right" role="num">40</cell>
                        <cell role="num">9</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">Over 25 and under 30</cell>
                        <cell rendition="#border-right" role="num">14</cell>
                        <cell role="num">29</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">Over 30 and under 35</cell>
                        <cell rendition="#border-right" role="num">8</cell>
                        <cell role="num">11</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">Over 35 and under 40</cell>
                        <cell rendition="#border-right" role="num">4</cell>
                        <cell role="num">9</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">Over 40 and under 50</cell>
                        <cell rendition="#border-right" role="num">5</cell>
                        <cell role="num">23</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">Over 50 and under 60</cell>
                        <cell rendition="#border-right" role="num">2</cell>
                        <cell role="num">14</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">Over 60</cell>
                        <cell rendition="#border-right #border-bottom" role="num">4</cell>
                        <cell rendition="#border-bottom" role="num">3</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right #border-bottom">Total</cell>
                        <cell rendition="#border-right #border-bottom" role="num">124</cell>
                        <cell rendition="#border-bottom" role="num">99</cell>
                    </row>
                </table>
            </div>
