    <text>
        <body>
            <div xml:id="d91">

                <pb facs="0228" n="172" sameAs="frus:frus1876/pg172"/>

                <head>No. 90.<lb/><hi rendition="#italic">Mr. Schlözer to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >German Legation</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1876-06-29"><hi rendition="#italic">June</hi> 29, 1876</date>.
                        (Received June 29.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: The Emperor of Germany has directed to His
                    Excellency the President a letter of congratulation for the 4th of July, and I
                    have been requested by His Majesty to transmit this letter personally on the 4th
                    of July.</p>
                <p>I therefore take the liberty to beg you, respectfully, to inform me whether the
                    President will accord me the honor to receive me that day for the purpose which
                    I have indicated.</p>
                <p>Accept, &amp;c.,</p>
                <closer><signed>SCHLÖZER.</signed></closer>



                <xi:include href="d91-a1.xml" xpointer="d91-a1"/>
