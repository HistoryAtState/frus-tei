    <text>
        <body>
            <div xml:id="d79">

                <pb facs="0186" n="130" sameAs="frus:frus1876/pg130"/>

                <head>No. 78.<lb/><hi rendition="#italic">Mr. Davis
                        to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Berlin</hi></placeName>, <date calendar="gregorian"
                            when="1876-02-28"><hi rendition="#italic">February</hi> 28, 1876</date>.
                        (Received March 20.)</dateline>
                    <seg rendition="#float-left">No. 291.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>:</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I inclose a copy of the proposed law relating to the Lutheran Church, together
                    with a translation.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>J. C. BANCROFT DAVIS.</signed></closer>




                <xi:include href="d79-a1.xml" xpointer="d79-a1"/>
