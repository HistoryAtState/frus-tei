    <text>
        <body>
            <div xml:id="d101">

                <pb facs="0246" n="190" sameAs="frus:frus1876/pg190"/>

                <head>(M. 3292.)<lb/><hi rendition="#italic">Mr. Henry A. Gadsden to Board of
                        Trade</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >The South Wales Atlantic Steamship Company</hi>, (<hi
                                rendition="#small-caps">limited</hi>,)<lb/>1 <hi rendition="#italic"
                                >Dock Chambers, Cardiff</hi></placeName>, <date calendar="gregorian"
                            when="1875-02-23"><hi rendition="#italic">February</hi> 23,
                        1875</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In reply to your letter of the 19th
                    instant, I beg to say that I laid your communication before the commanders of
                    our steamers, and their replies to your various questions I have the pleasure to
                    inclose.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>HENRY A. GADSDEN, <hi rendition="#italic"
                    >Manager</hi>.</signed></closer>
                <postscript>
                    <p>The <hi rendition="#small-caps">Assistant Secretary</hi><lb/><hi
                            rendition="#italic">Marine Department, Board of Trade</hi>.</p>
                </postscript>



                <xi:include href="d101-a1.xml" xpointer="d101-a1"/>
            </div>
        </body>
    </text>
