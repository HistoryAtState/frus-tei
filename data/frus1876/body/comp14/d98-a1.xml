    <text>
        <body>
            <div xml:id="d98-a1">

                <pb facs="0238" n="182" xml:id="pg182"/>

                <opener><seg rendition="#center">[Inclosure.]</seg></opener>
                <p><hi rendition="#italic">Copy of the report of the committee appointed by the
                        admiralty, the board of trade, and the Trinity House, to consider the
                        regulations for preventing collisions at sea</hi>, (<hi rendition="#italic"
                        >rule of the road at sea</hi>,) <hi rendition="#italic">and of the
                        amendments proposed by them, together with a copy of the letter addressed by
                        the board of trade to the foreign office upon the subject</hi>, (<hi
                        rendition="#italic">in continuation of parliamentary paper No</hi>. 353, <hi
                        rendition="#italic">of session</hi> 1874.)</p>
                <closer><signed>T. H. FARRER.</signed>
                    <lb/>
                    <dateline rendition="#float-left"><hi rendition="#small-caps">Board of
                            Trade</hi>, <date calendar="gregorian" when="1876-02-22"><hi
                                rendition="#italic">February</hi> 22,
                    1876</date>.</dateline></closer>


                <xi:include href="d98-a1-a1.xml" xpointer="d98-a1-a1"/>
            </div>
