        <body>
            <div xml:id="d135">

                <pb facs="0286" n="230" sameAs="frus:frus1876/pg230"/>

                <head>No. 125.<lb/><hi rendition="#italic">Mr. Hoffman to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1876-05-11"><hi rendition="#italic">May</hi> 11,
                        1876</date>.</dateline>
                    <seg rendition="#float-left">No. 82.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose to you copies
                    of two notes I have received from Lord Derby upon the subject of the extradition
                    of Winslow.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>WICKHAM HOFFMAN.</signed></closer>




                <xi:include href="d135-a1.xml" xpointer="d135-a1"/>
