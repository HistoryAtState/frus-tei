                <pb facs="0287" n="231" sameAs="frus:frus1876/pg231"/>

                <head>No. 126.<lb/><hi rendition="#italic">Mr. Hoffman to Mr. Fish.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1876-05-12"><hi rendition="#italic">May</hi> 12,
                        1876</date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Fish</hi>, <hi rendition="#italic"
                        >Secretary, Washington:</hi></p>
                <p>Am notified government will oppose discharge of Winslow to-morrow on ground you
                    have not received note of 4th May, and with hope that arrangement may yet be
                    come to.</p>
                <closer><signed>HOFFMAN.</signed></closer>
            </div>
        </body>
    </text>
