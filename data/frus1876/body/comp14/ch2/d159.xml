    <text>
        <body>
            <div xml:id="d159">

                <pb facs="0311" n="255" sameAs="frus:frus1876/pg255"/>

                <head>No. 149.<lb/><hi rendition="#italic">Mr. Hoffman to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1876-06-22"><hi rendition="#italic">June</hi> 22, 1876</date>.
                        (Received July 3.)</dateline>
                    <seg rendition="#float-left">No. 112.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to forward to you herewith
                    copies of the only notes of importance received from the foreign office in the
                    Winslow matter during the last week.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>WICKHAM HOFFMAN.</signed></closer>



                <xi:include href="d159-a1.xml" xpointer="d159-a1"/>
