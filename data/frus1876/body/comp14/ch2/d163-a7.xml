    <text>
        <body>
            <div xml:id="d163-a7">

                <pb facs="0320" n="264" sameAs="frus:frus1876/pg264"/>

                <head><hi rendition="#italic">Sir F. Rogers to Mr.
                            Burley</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Colonial Office</hi></placeName>, <date calendar="gregorian"
                            when="1865-09-22"><hi rendition="#italic">September</hi> 22,
                        1865</date>.</dateline>
                    <seg rendition="#float-left">No. 29.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I am directed by Mr. Secretary Cardwell to
                    acknowledge the receipt of your letter of the 8th instant, applying for the
                    assistance of Her Majesty’s government on behalf of your son, Mr. Bennet G.
                    Burley; and I am to inform you that your son’s case is one in which Mr. Cardwell
                    is unable to interfere.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>FREDERICK ROGERS.</signed></closer>
            </div>
        </body>
    </text>
