    <text>
        <body>
            <div xml:id="d163-a8-a1">

                <pb facs="0322" n="266" sameAs="frus:frus1876/pg266"/>

                <p rendition="#flush"><hi rendition="#small-caps">United States of
                        America</hi>,<lb/><hi rendition="#italic">State of New York, City and County
                        of New York, ss:</hi></p>
                <p>Richard Baker Caldwell, of Prescott, in the county of Grenville, in the province
                    of Ontario, in the Dominion of Canada, being duly sworn, doth depose and say
                    that the foregoing petition is in all respects true in substance and matters of
                    fact.</p>
                <closer><signed>RICHARD BAKER CALDWELL.</signed></closer>
                <closer>
                    <dateline rendition="#float-left">Sworn <date calendar="gregorian"
                            when="1871-01-12">this 12th day of January, A. D.
                        1871</date>.</dateline>
                    <lb/>
                    <signed>WM. L. GARDNER,<lb/><hi rendition="#italic">Notary Public, New York
                            City</hi>.</signed></closer>
            </div>
        </body>
    </text>
