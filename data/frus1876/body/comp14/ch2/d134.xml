    <text>
        <body>
            <div xml:id="d134">

                <pb facs="0282" n="226" sameAs="frus:frus1876/pg226"/>

                <head>No. 124.<lb/><hi rendition="#italic">Mr. Hoffman to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1876-05-06"><hi rendition="#italic">May</hi> 6, 1876</date>.
                        (Received May 17.)</dateline>
                    <seg rendition="#float-left">No. 79.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to previous correspondence upon
                    the subject of Winslow, I have the honor to forward to you herewith a copy of a
                    note I received last evening from Lord Derby.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>WICKHAM HOFFMAN.</signed></closer>
                <postscript>
                    <p>[<hi rendition="#small-caps">Note</hi>.—As instruction No. 864, of March 31,
                        had been delivered to Lord Derby and a request made that it be substituted
                        for a note addressed to him by Mr. Hoffman communicating it, this note is
                        taken as a reply to 864.]</p>
                </postscript>



                <xi:include href="d134-a1.xml" xpointer="d134-a1"/>
            </div>
        </body>
    </text>
