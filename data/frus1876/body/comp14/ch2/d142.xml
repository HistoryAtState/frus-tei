    <text>
        <body>
            <div xml:id="d142">

                <pb facs="0301" n="245" sameAs="frus:frus1876/pg245"/>

                <head>No. 132.<lb/><hi rendition="#italic">Mr. Hoffman to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1876-05-25"><hi rendition="#italic">May</hi> 25,
                        1876</date>.</dateline>
                    <seg rendition="#float-left">No. 95.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to forward to you herewith
                    a copy of the only note of importance I have lately received from Lord Derby in
                    the Winslow matter. I add a copy of my reply.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>WICKHAM HOFFMAN.</signed></closer>



                <xi:include href="d142-a1.xml" xpointer="d142-a1"/>
