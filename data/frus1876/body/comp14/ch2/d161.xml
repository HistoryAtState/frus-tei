    <text>
        <body>
            <div xml:id="d161">

                <pb facs="0313" n="257" xml:id="pg257"/>

                <head>No. 151.<lb/><hi rendition="#italic">Mr. Hoffman to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1876-07-03"><hi rendition="#italic">July</hi> 3, 1876</date>.
                        (Received July 17.)</dateline>
                    <seg rendition="#float-left">No. 121.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to forward to you herewith
                    a copy of a note from Lord Derby bearing date June 30th, in continuation of the
                    argument upon the Winslow question.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>WICKHAM HOFFMAN.</signed></closer>


                <xi:include href="d161-a1.xml" xpointer="d161-a1"/>
            </div>
        </body>
