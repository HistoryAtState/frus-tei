                <pb facs="0279" n="223" sameAs="frus:frus1876/pg223"/>

                <head>No. 120.<lb/><hi rendition="#italic">Mr. Fish to Mr. Hoffman.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1876-05-02"><hi rendition="#italic">May</hi> 2,
                        1876</date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Hoffman</hi>, <hi
                        rendition="#italic">Chargé, London:</hi></p>
                <p>You were not instructed or authorized to make the request stated in your telegram
                    of first.</p>
                <closer><signed>FISH, <hi rendition="#italic">Secretary</hi>.</signed></closer>
            </div>
        </body>
