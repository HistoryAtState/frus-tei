        <body>
            <div xml:id="d133">

                <pb facs="0280" n="224" sameAs="frus:frus1876/pg224"/>

                <head>No. 123.<lb/><hi rendition="#italic">Mr. Hoffman to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1876-05-04"><hi rendition="#italic">May</hi> 4, 1876</date>.
                        (Received May 15.)</dateline>
                    <seg rendition="#float-left">No. 76.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose to you copies
                    of all important correspondence which has passed between the British government
                    and this legation on the subject of the extradition of Winslow, since the 20th
                    ultimo.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>WICKHAM HOFFMAN.</signed></closer>










