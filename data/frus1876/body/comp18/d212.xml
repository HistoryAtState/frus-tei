        <body>
            <div xml:id="d212">

                <pb facs="0438" n="382" sameAs="frus:frus1876/pg382"/>

                <head>No. 202.<lb/><hi rendition="#italic">Mr. Bingham to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Legation, Japan</hi>,<lb/><hi rendition="#italic"
                                >Tokei</hi></placeName>, <date calendar="gregorian"
                            when="1876-09-20"><hi rendition="#italic">September</hi> 20,
                        1876</date>. (Received October 26.)</dateline>
                    <seg rendition="#float-left">No. 443.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: The Japanese department of education has
                    furnished me copies of the second annual report of the minister of education,
                    duplicates of which I have the honor to inclose herewith.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>JNO. A. BINGHAM.</signed></closer>


                <xi:include href="d212-a1.xml" xpointer="d212-a1"/>
            </div>
