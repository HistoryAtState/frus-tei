    <text>
        <body>
            <div xml:id="d199-a3">

                <pb facs="0421" n="365" xml:id="pg365"/>

                <opener><seg rendition="#center">[Inclosure 3 in No. 347.]</seg></opener>
                <p rendition="#center">No. 111.</p>
                <p>Notice is hereby given that the press-laws published in proclamation 352, dated
                    the tenth month of the sixth year of Meiji, have been repealed, and the
                    following laws enacted.</p>
                <closer><signed>SANJO SANEYOSKI.</signed>
                    <lb/>
                    <dateline rendition="#float-left">
                        <placeName><hi rendition="#small-caps">Daijo Daijin</hi></placeName>, <date
                            calendar="japanese-nengō" when="1875-06-28">28<hi rendition="#italic">th
                                of the</hi> 6<hi rendition="#italic">th month</hi>, 8<hi
                                rendition="#italic">th of Meiji</hi>. (June 28,
                        1875.)</date></dateline></closer>


                <xi:include href="d199-a3-a1.xml" xpointer="d199-a3-a1"/>
            </div>
