    <text>
        <body>
            <div xml:id="d242-a1">

                <pb facs="0488" n="432" sameAs="frus:frus1876/pg432"/>

                <opener><seg rendition="#center">[Inclosure 1 in No. 53.]</seg></opener>
                <head><hi rendition="#italic">Mr. Moran to Mr. Corvo.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Lisbon</hi></placeName>, <date calendar="gregorian"
                            when="1875-12-27"><hi rendition="#italic">December</hi> 27,
                        1875</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Having received a few pamphlet copies of
                    the President’s recent message to Congress, I beg to inclose one herewith for
                    your acceptance, and am, with great respect, your excellency’s most obedient
                    servant,</p>
                <closer><signed>BENJAMIN MORAN.</signed></closer>
                <postscript>
                    <p>His Excellency <hi rendition="#small-caps">João de Andrade
                        Corvo</hi>,<lb/>&amp;c., &amp;., &amp;c.</p>
                </postscript>
            </div>
        </body>
