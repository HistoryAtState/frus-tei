    <text>
        <body>
            <div xml:id="d39-a1">

                <pb facs="0106" n="50" sameAs="frus:frus1876/pg50"/>

                <opener><seg rendition="#center">[Inclosure 1 in No. 52.]</seg></opener>
                <head><hi rendition="#italic">Mr. Bradford to Mr. Seward</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Consulate-General</hi>,<lb/><hi rendition="#italic"
                                >Shanghai</hi></placeName>, <date calendar="gregorian"
                            when="1876-04-22"><hi rendition="#italic">April</hi> 22,
                        1876</date>.</dateline>
                    <seg rendition="#float-left">No. 470.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Inclosed I have the honor to hand you, in
                    duplicate, a copy of my correspondence with Fëng, Taotai, at this port, on the
                    subject of the railway to Woosung.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>O. B. BRADFORD, <hi rendition="#italic"
                        >Vice-Consul-General.</hi></signed></closer>
            </div>
        </body>
