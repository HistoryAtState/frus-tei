    <text>
        <body>
            <div xml:id="d10">

                <pb facs="0321" n="7" sameAs="frus:frus1914Supp/pg7"/>

                <note rend="inline" type="source">File No. 711.0012/491</note>
                <head>
                    <hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic"
                        >Herrick</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Paris</hi></placeName>, <date calendar="gregorian"
                        when="1914-09-08">
                        <hi rendition="#italic">September 8, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received 10:05 a.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>49. Your 47, September 4. Garrett telegraphs that French
                    Foreign Office is in communication with British Foreign Office regarding date
                    for signing treaty.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Herrick</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
