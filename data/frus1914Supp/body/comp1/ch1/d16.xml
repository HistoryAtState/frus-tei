    <text>
        <body>
            <div xml:id="d16">

                <pb facs="0323" n="9" sameAs="frus:frus1914Supp/pg9"/>

                <note rend="inline" type="source">File No. 711.0012/525</note>
                <head>
                    <hi rendition="#italic">The German Ambassador</hi> (<hi rendition="#italic"
                        >Bernstorff</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <dateline>
                    <placeName>
                        <hi rendition="#italic">New York</hi></placeName>, <date
                        calendar="gregorian" when="1914-10-01">
                        <hi rendition="#italic">October 1, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received 10:35 a.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>Your telegram received with thanks. I am returning to Washington to-morrow and
                    will ask you to be good enough to let me have a copy of the last treaties which
                    I will send home by an opportunity.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bernstorff</hi>
                    </signed>
                </closer>
            </div>
        </body>
