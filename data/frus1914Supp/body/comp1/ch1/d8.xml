                <note rend="inline" type="source">File No. 711.0012/468</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Germany</hi> (<hi rendition="#italic"
                        >Gerard</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Berlin</hi></placeName>, <date calendar="gregorian"
                        when="1914-08-21">
                        <hi rendition="#italic">August 21, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received August 22, 9 a.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>Sorry to report no hope peace treaty.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Gerard</hi>
                    </signed>
                </closer>
            </div>
        </body>
