            <div xml:id="d1151">

                <pb facs="1041" n="727" sameAs="frus:frus1914Supp/pg727"/>

                <note rend="inline" type="source">File No. 840.48/979</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Austria-Hungary</hi> (<hi
                        rendition="#italic">Penfield</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Vienna</hi></placeName>, <date calendar="gregorian"
                        when="1914-11-24">
                        <hi rendition="#italic">November 24, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received November 26, 8 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>305. Can passports issue and financially assist return children of tender years
                    born in United States (1) of parents not naturalized, (2) of declarants?</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Penfield</hi>
                    </signed>
                </closer>



                <xi:include href="d1151-a1.xml" xpointer="d1151-a1"/>
