    <text>
        <body>
            <div xml:id="d1151-a1">

                <pb facs="1042" n="728" xml:id="pg728"/>

                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in
                        Austria-Hungary</hi> (<hi rendition="#italic">Penfield</hi>)</head>

                <opener>
                    <dateline>
                        <hi rendition="#small-caps">Department of State</hi>, <lb/>
                        <placeName>
                            <hi rendition="#italic">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1914-12-03">
                            <hi rendition="#italic">December 3, 1914</hi></date>.</dateline>
                </opener>
                <p>327. Your 305, 24th. Passports and financial assistance may be extended to
                    American-born minor children of parents not naturalized or declarants.</p>
                <p rendition="#right">
                    <hi rendition="#small-caps">Bryan</hi>
                </p>
            </div>
        </body>
