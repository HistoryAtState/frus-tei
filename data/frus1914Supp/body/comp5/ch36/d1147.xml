        <body>
            <div xml:id="d1147">

                <pb facs="1036" n="722" sameAs="frus:frus1914Supp/pg722"/>

                <note rend="inline" type="source">File No. 138.4/22</note>
                <head>
                    <hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic">Herrick</hi>) <hi
                        rendition="#italic">to the Secretary of State</hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Paris</hi></placeName>, <date
                        ana="#date_undated-inferred-from-document-content" calendar="gregorian"
                        notAfter="1914-08-11T19:30:00-05:00" notBefore="1914-08-11T00:00:00+00:00"
                            ><hi rendition="#italic">undated</hi></date>. <lb/> [<hi
                        rendition="#italic">Received August 11, 1914, 7:30 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>Earnestly request immediate instructions concerning granting individuals holding
                    first papers certificate of identity to secure temporary <hi rendition="#italic"
                        >permis de sejour</hi> pending opportunity to return to United States.</p>
                <closer>[File copy not signed]</closer>


                <xi:include href="d1147-a1.xml" xpointer="d1147-a1"/>
            </div>
