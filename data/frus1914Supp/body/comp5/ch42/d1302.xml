    <text>
        <body>
            <div xml:id="d1302">

                <pb facs="1130" n="816" sameAs="frus:frus1914Supp/pg816"/>

                <note rend="inline" type="source">File No. 855.48/35</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Page</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi><anchor n="1" xml:id="d1302-f1"/>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">London</hi></placeName>, <date calendar="gregorian"
                        when="1914-11-09">
                        <hi rendition="#italic">November 9, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received 3 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>1027. The French Minister in Holland caused embarrassing situation regard
                    forwarding of food to Belgium saying he lacked instructions from his Government;
                    more cargoes will arrive forthwith.</p>
                <p>Can French Government not send him instructions soon as possible to consent to
                    transshipment through Holland as all other Governments consent?</p>
                <closer>
                    <hi rendition="#small-caps">American Ambassador</hi>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1302-f1" n="1" type="source" xml:id="d1302-f1-content">
                <p>Forwarded to the Ambassador in France November 10, No. 253.</p>
            </note>
        </listAnnotation>
    </standOff>
