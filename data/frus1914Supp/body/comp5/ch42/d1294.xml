    <text>
        <body>
            <div xml:id="d1294">

                <pb facs="1127" n="813" sameAs="frus:frus1914Supp/pg813"/>

                <head>The Acting Secretary of State to the Minister in Belgium (<hi
                        rendition="#italic">Whitlock</hi>)</head>
                <dateline>
                    <hi rendition="#small-caps">Department of State</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-10-20">
                        <hi rendition="#italic">October 20, 1914</hi>.</date>
                </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>40. Your telegram October 19 [<hi rendition="#italic">16</hi>], 10 a.m.,
                    transmitted via London regarding relief of Belgium. Department approves your
                    action and has given instructions to the Ambassador at London to render you and
                    your Spanish colleague every assistance.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
