    <text>
        <body>
            <div xml:id="d1296">

                <pb facs="1128" n="814" xml:id="pg814"/>

                <note rend="inline" type="source">File No. 855.48/17</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Ambassador in France</hi> (<hi
                            rendition="#italic">Herrick</hi>)</head>
                <dateline>
                    <hi rendition="#small-caps">Department of State</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-10-31">
                        <hi rendition="#italic">October 31, 1914</hi>.</date>
                </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>221. At request of American Minister at The Hague you are instructed to ask
                    whether France will give assurance of recognition of neutrality of goods shipped
                    for American Commission for Relief in Belgium.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
