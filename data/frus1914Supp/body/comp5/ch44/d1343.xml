                <pb facs="1149" n="835" sameAs="frus:frus1914Supp/pg835"/>

                <note rend="inline" type="source">File No. 763.72112/181</note>
                <head>
                    <hi rendition="#italic">The Chargé d’Affaires in Russia</hi> (<hi rendition="#italic"
                    >Wilson</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Petrograd</hi></placeName>, <date
                        ana="#date_undated-inferred-from-document-content" calendar="gregorian"
                        notAfter="1914-10-17T23:40:00-05:00" notBefore="1914-10-17T00:00:00+03:00"
                            ><hi rendition="#italic">undated</hi></date>. <lb/> [<hi
                        rendition="#italic">Received October 17, 1914, 11:40 p.m.]</hi>
                </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>69. Department’s circular telegram, September 24.<anchor n="2" xml:id="d1343-f1"
                    /> Russian Government is happy to render homage to the noble initiatives of King
                    of Spain and President of the United States. In response to their appeal,
                    Russian authorities have been ordered to give the broadest application to
                    Article 29 of the Declaration of London.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Wilson</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
