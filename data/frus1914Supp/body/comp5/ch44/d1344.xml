    <text>
        <body>
            <div xml:id="d1344">

                <pb facs="1149" n="835" sameAs="frus:frus1914Supp/pg835"/>

                <note rend="inline" type="source">File No. 763.72112/187</note>
                <head>
                    <hi rendition="#italic">The Minister in Belgium</hi> (<hi rendition="#italic"
                        >Whitlock</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Legation</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Brussels</hi></placeName>, <date
                        calendar="gregorian" when="1914-10-19">
                        <hi rendition="#italic">October 19, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Repetition received October 20, 8 a.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>Department’s circular September 24<anchor n="2" xml:id="d1344-f1"/> regarding
                    agreement to consider hospital supplies as neither contraband nor conditional
                    contraband of war was duly communicated to Belgian Government. No, reply has as
                    yet been received.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Whitlock</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
