    <text>
        <body>
            <div xml:id="d1196">

                <pb facs="1071" n="757" sameAs="frus:frus1914Supp/pg757"/>

                <note rend="inline" type="source">File No. 367.11/171</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Turkey</hi> (<hi rendition="#italic"
                        >Morgenthau</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Constantinople</hi></placeName>, <date
                        calendar="gregorian" when="1914-08-11T00:00:00+02:00">
                        <hi rendition="#italic">August 11, 1914, 12 midnight</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received August 16, 8:20 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>Consul Jackson telegraphs to-day that owing to critical situation and financial
                    crisis fears exist for public safety and for the preservation of American lives
                    and interests and also as an act of humanity American ships should be sent to
                    Syrian ports.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Morgenthau</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
