                <pb facs="1073" n="759" sameAs="frus:frus1914Supp/pg759"/>

                <note rend="inline" type="source">File No. 367.11/185b</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Turkey</hi>
                        (<hi rendition="#italic">Morgenthau</hi>)</head>
                <dateline>
                    <hi rendition="#small-caps">Department of State</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-08-19T20:00:00-05:00">
                        <hi rendition="#italic">August 19, 1914, 8 p.m.</hi>
                    </date>
                </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>United States Government is considering sending warships to Turkish waters, but
                    before doing so deems it advisable to sound European powers as to such
                    action.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi>
                    </signed>
                </closer>
            </div>
        </body>
