    <text>
        <body>
            <div xml:id="d1207">

                <pb facs="1076" n="762" xml:id="pg762"/>

                <note rend="inline" type="source">File No. 367.116/170a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Turkey</hi> (<hi
                            rendition="#italic">Morgenthau</hi>)</head>
                <dateline>
                    <hi rendition="#small-caps">Department of State</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-08-28">
                        <hi rendition="#italic">August 28, 1914</hi>.</date>
                </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>The <hi rendition="#italic">North Carolina</hi> now at Falmouth has been ordered
                    to start to-morrow for Turkish waters with $150,000 gold relief fund.<anchor
                        n="1" xml:id="d1207-f1"/> Department has notified Straus, Schiff, and other
                    interested parties to this effect who will probably send additional funds.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Bryan</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1207-f1" n="1" xml:id="d1207-f1-content">
                <p>The <hi rendition="#italic">Tennessee</hi> was sent later under similar
                    orders.</p>
            </note>
        </listAnnotation>
    </standOff>
