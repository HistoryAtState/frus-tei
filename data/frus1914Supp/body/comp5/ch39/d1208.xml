        <body>
            <div xml:id="d1208">

                <pb facs="1076" n="762" sameAs="frus:frus1914Supp/pg762"/>

                <note rend="inline" type="source">File No. 867.00/643</note>
                <head>
                    <hi rendition="#italic">The Vice Consul at Smyrna</hi> (<hi rendition="#italic"
                        >Morris</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Consulate General</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Smyrna</hi></placeName>, <date calendar="gregorian"
                        when="1914-08-10">
                        <hi rendition="#italic">August 10, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received September 4</hi>.] </dateline>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith copy
                    of a letter which I have sent to the Embassy at Constantinople, concerning the
                    political situation in Smyrna. I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Leland B. Morris</hi>
                    </signed>
                </closer>


                <xi:include href="d1208-a1.xml" xpointer="d1208-a1"/>
            </div>
