                <pb facs="1088" n="774" sameAs="frus:frus1914Supp/pg774"/>

                <note rend="inline" type="source">File No. 763.72/1239</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        Turkey</hi> (<hi rendition="#italic">Morgenthau</hi>)</head>
                <dateline>
                    <hi rendition="#small-caps">Department of State</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-11-30">
                        <hi rendition="#italic">November 30, 1914</hi>.</date>
                </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>82. Your 47, 17th, 5 p.m. Department considers that the matter is closed, and
                    therefore deems it advisable that no further investigation is [<hi
                        rendition="#italic">be</hi>] made.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
