                <pb facs="1081" n="767" sameAs="frus:frus1914Supp/pg767"/>

                <note rend="inline" type="source">File No. 867.00/662</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Germany</hi> (<hi rendition="#italic"
                        >Gerard</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Berlin</hi></placeName>, <date calendar="gregorian"
                        when="1914-09-14">
                        <hi rendition="#italic">September 14, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received September 15, 4 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>148. German Foreign Office says that German Ambassador Turkey now thinks it would
                    be a good thing if neutral warship should be sent to protect foreigners Turkish
                    coast.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Gerard</hi>
                    </signed>
                </closer>
            </div>
        </body>
