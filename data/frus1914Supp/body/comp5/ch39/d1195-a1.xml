    <text>
        <body>
            <div xml:id="d1195-a1">

                <pb facs="1071" n="757" sameAs="frus:frus1914Supp/pg757"/>

                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Turkey</hi> (<hi
                            rendition="#italic">Morgenthau</hi>)</head>

                <opener>
                    <dateline>
                        <hi rendition="#small-caps">Department of State</hi>, <lb/>
                        <placeName>
                            <hi rendition="#italic">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1914-08-08T17:00:00-05:00">
                            <hi rendition="#italic">August 8, 1914, 5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Cannot send ships to Beirut, Smyrna, and Black Sea. <hi rendition="#italic"
                        >Scorpion</hi> will remain at Constantinople.</p>
                <p rendition="#right">
                    
                        <hi rendition="#small-caps">W.J.Bryan</hi>
                    
                </p>
            </div>
        </body>
