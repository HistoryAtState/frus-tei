    <text>
        <body>
            <div xml:id="d1324">

                <pb facs="1141" n="827" xml:id="pg827"/>

                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in France</hi>
                        (<hi rendition="#italic">Herrick</hi>)</head>
                <dateline>
                    <hi rendition="#small-caps">Department of State</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-09-01">
                        <hi rendition="#italic">September 1, 1914</hi>.</date>
                </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>17. The American Red Cross vessel will stop at Havre. Ascertain whether French
                    authorities at that port will remit port duties.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
