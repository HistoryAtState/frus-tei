            <div xml:id="d1244">

                <pb facs="1099" n="785" sameAs="frus:frus1914Supp/pg785"/>

                <note rend="inline" type="source">File No. 763.72/1298</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Turkey</hi> (<hi rendition="#italic"
                        >Morgenthau</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Constantinople</hi></placeName>, <date
                        calendar="gregorian" when="1914-12-10T00:00:00+02:00">
                        <hi rendition="#italic">December 10, 1914, 12 midnight</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received December 11, 8:15 a.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>143. Your 124, 8th.<anchor n="1" xml:id="d1244-f1"/> Contents communicated to
                    Minister of the Interior who is acting Minister of War. He seems absolutely
                    indifferent to being held personally responsible.</p>
                <closer>
                    <hi rendition="#small-caps">American Ambassador</hi>
                </closer>
            </div>
        </body>
    </text>
