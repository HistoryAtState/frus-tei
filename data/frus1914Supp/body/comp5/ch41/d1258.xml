            <div xml:id="d1258">

                <pb facs="1107" n="793" sameAs="frus:frus1914Supp/pg793"/>

                <note rend="inline" type="source">File No. 763.72116/18</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Consul General at Antwerp</hi> (<hi
                            rendition="#italic">Diederch</hi>)</head>
                <dateline>
                    <hi rendition="#small-caps">Department of State</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-09-04">
                        <hi rendition="#italic">September 4, 1914</hi>.</date>
                </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>Your September 2.<anchor n="1" xml:id="d1258-f1"/> Please confine yourself to
                    statement of facts. Our neutrality does not permit an expression of opinion by
                    our diplomatic or consular officers.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Bryan</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
