        <body>
            <div xml:id="d1264">

                <pb facs="1110" n="796" xml:id="pg796"/>

                <note rend="inline" type="source">File No. 763.72116/40</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Germany</hi> (<hi rendition="#italic"
                    >Gerard</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Berlin</hi></placeName>, <date calendar="gregorian"
                        when="1914-09-14T16:00:00+01:00">
                        <hi rendition="#italic">September 14, 1914, 4 p.m.</hi>
                    </date>
                    <lb/> [<hi rendition="#italic">Received September 16, 8 a.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>141. Have sent by messenger, at the request of Government, specimens of alleged
                    dumdum bullets. On reflection I think we had better keep out of controversy, if
                    possible, as bitter feeling will be aroused in whatever country we decide
                    against.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Gerard</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
