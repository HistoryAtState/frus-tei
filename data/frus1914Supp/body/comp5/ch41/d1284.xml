                <pb facs="1122" n="808" sameAs="frus:frus1914Supp/pg808"/>

                <note rend="inline" type="source">File No. 763.72/1255</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Consul at Roubaix</hi> (<hi
                            rendition="#italic">Watson</hi>)</head>
                <dateline>
                    <hi rendition="#small-caps">Department of State</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-12-24">
                        <hi rendition="#italic">December 24, 1914</hi>.</date>
                </dateline>
                <p rendition="#flush">No. 8.]</p>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to your despatch No. 6 of
                    October 17, 1914, in regard to negotiations to safeguard Roubaix, Tourcoing, and
                    Lille, you are instructed to avoid intervention in these matters in future and
                    observe the President’s proclamation of neutrality.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        
                            <hi rendition="#small-caps">Wilbur J. Carr</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
