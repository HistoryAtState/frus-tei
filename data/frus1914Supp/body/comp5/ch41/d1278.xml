                    <hi rendition="#italic">The Secretary of State to the
                        Minister in Belgium</hi> (<hi
                            rendition="#italic">Whitlock</hi>)</head>
                <dateline>
                    <hi rendition="#small-caps">Department of State</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-10-12">
                        <hi rendition="#italic">October 12, 1914</hi>.</date>
                </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>34. Your 41, 10th. Your action approved by Department.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Bryan</hi>
                        
                    </signed>
                </closer>
