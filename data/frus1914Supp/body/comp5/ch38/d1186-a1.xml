    <text>
        <body>
            <div xml:id="d1186-a1">

                <pb facs="1065" n="751" xml:id="pg751"/>

                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Chargé d’Affaires in Russia</hi> (<hi
                            rendition="#italic">Wilson</hi>)</head>

                <opener>
                    <dateline>
                        <hi rendition="#small-caps">Department of State</hi>, <lb/>
                        <placeName>
                            <hi rendition="#italic">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1914-09-16">
                            <hi rendition="#italic">September 16, 1914</hi></date>.</dateline>
                </opener>
                <p>11. Your August 26, 6 p.m.,<anchor n="1" xml:id="d1186-f1"/> and No. 11,
                    September 10, 5 p.m. As no instructions seem to have been sent to you, please
                    explain as to protests and discontinue same until otherwise instructed.</p>
                <p rendition="#right">
                    
                        <hi rendition="#small-caps">Bryan</hi>
                    
                </p>
            </div>
        </body>
    </text>
