            <div xml:id="d1161">

                <pb facs="1050" n="736" sameAs="frus:frus1914Supp/pg736"/>

                <note rend="inline" type="source">File No. 701.6261/7</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Chargé d’Affaires in Russia</hi> (<hi
                            rendition="#italic">Wilson</hi>)</head>
                <dateline>
                    <hi rendition="#small-caps">Department of State</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-08-07T14:00:00-05:00">
                        <hi rendition="#italic">August 7, 1914, 2 p.m.</hi>
                    </date>
                </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>Your August 5, 10 p.m. Department unable to take up matter with Russian
                    Ambassador.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Bryan</hi>
                        
                    </signed>
                </closer>
            </div>
