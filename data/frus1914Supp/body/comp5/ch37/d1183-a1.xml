    <text>
        <body>
            <div xml:id="d1183-a1">

                <pb facs="1063" n="749" sameAs="frus:frus1914Supp/pg749"/>

                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Turkey</hi>
                        (<hi rendition="#italic">Morgenthau</hi>)</head>

                <opener>
                    <dateline>
                        <hi rendition="#small-caps">Department of State</hi>, <lb/>
                        <placeName>
                            <hi rendition="#italic">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1914-12-16">
                            <hi rendition="#italic">December 16, 1914</hi></date>.</dateline>
                </opener>
                <p>Your 155, 13th, 11 p.m. Department approves your cooperation with Italian
                    Ambassador for release of British Vice Consul Hodeida.</p>
                <p rendition="#right">
                    <hi rendition="#small-caps">Bryan</hi>
                </p>
            </div>
