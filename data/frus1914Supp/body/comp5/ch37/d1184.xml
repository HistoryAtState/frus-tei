    <text>
        <body>
            <div xml:id="d1184">

                <pb facs="1063" n="749" sameAs="frus:frus1914Supp/pg749"/>

                <note rend="inline" type="source">File No. 704.6291/6</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Minister in Persia</hi> (<hi
                            rendition="#italic">Caldwell</hi>)</head>
                <dateline>
                    <hi rendition="#small-caps">Department of State</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-12-19">
                        <hi rendition="#italic">December 19, 1914</hi>.</date>
                </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>Department’s November 5.<anchor n="1" xml:id="d1184-f1"/> German Ambassador here
                    states you have assumed protection Germans in Persia owing to urgency.
                    Department approves action and at request of Ambassador desires you also when
                    necessary take charge German interests in parts of Persia occupied by Russian
                    forces.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Bryan</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
