    <text>
        <body>
            <div xml:id="d1166">

                <pb facs="1052" n="738" sameAs="frus:frus1914Supp/pg738"/>

                <note rend="inline" type="source">File No. 704.6261/4</note>
                <head>
                    <hi rendition="#italic">The Chargé d’Affaires in Russia</hi> (<hi
                        rendition="#italic">Wilson</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">St. Petersburg</hi></placeName>, <date
                        calendar="gregorian" when="1914-08-13">
                        <hi rendition="#italic">August 13, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received August 14, 10:30 a.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>Practically all German and Austrian Consuls in Russia are being arrested and
                    imprisoned. Have protested strongly both verbally and in writing but without
                    slightest effect. Request instructions as to what further steps I shall take in
                    matter.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wilson</hi>
                    </signed>
                </closer>


                <xi:include href="d1166-a1.xml" xpointer="d1166-a1"/>
