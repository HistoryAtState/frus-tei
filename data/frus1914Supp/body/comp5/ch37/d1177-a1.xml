    <text>
        <body>
            <div xml:id="d1177-a1">

                <pb facs="1060" n="746" sameAs="frus:frus1914Supp/pg746"/>

                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Germany</hi>
                        (<hi rendition="#italic">Gerard</hi>)</head>

                <opener>
                    <dateline>
                        <hi rendition="#small-caps">Department of State</hi>, <lb/>
                        <placeName>
                            <hi rendition="#italic">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1914-11-12">
                            <hi rendition="#italic">November 12, 1914</hi>.</date>
                    </dateline>
                </opener>
                <p>624. Your 785. Department desires you to continue to act under circular
                    instructions October 5.</p>
                <p rendition="#right">
                    <hi rendition="#small-caps">Bryan</hi>
                </p>
            </div>
        </body>
