            <div xml:id="d584">

                <pb facs="0705" n="391" xml:id="pg391"/>

                <note rend="inline" type="source">File. No 165.009/278</note>
                <head>
                    <hi rendition="#italic">The Minister in Norway</hi> (<hi rendition="#italic"
                        >Schmedeman</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Legation</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Christiania</hi></placeName>, <date
                        calendar="gregorian" when="1914-10-20">
                        <hi rendition="#italic">October 20, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received 2:30 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>Referring to the Department’s telegram of October 16th. Instructions forwarded to
                    Copenhagen and Stockholm. Foreign Minister-informed me Norwegian authorities do
                    not object to cotton shippers sending cotton to Norway destined for Germany.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Schmedeman</hi>
                    </signed>
                </closer>
            </div>
