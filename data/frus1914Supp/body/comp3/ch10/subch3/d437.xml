        <body>
            <div xml:id="d437">

                <pb facs="0601" n="287" sameAs="frus:frus1914Supp/pg287"/>

                <note rend="inline" type="source">File No. 763.72/218</note>
                <head>
                    <hi rendition="#italic">Senator</hi>
                    <hi rendition="#italic">Gore</hi>
                    <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <dateline>
                    <placeName>
                        <hi rendition="#italic">Washington</hi>
                    </placeName>
                    <date calendar="gregorian" when="1914-10-24">
                        <hi rendition="#italic">October 24, 1914</hi>.</date>
                </dateline>
                <p>
                    <hi rendition="#small-caps">My dear Mr. Secretary</hi>:</p>
                <p>I beg to hand you herewith a telegram which I have received from the Harris Irby
                    Cotton Company of Oklahoma City, Oklahoma, which will explain itself.</p>
                <p>Most respectfully,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">T. P. Gore</hi>
                    </signed>
                </closer>



                <xi:include href="d437-a1.xml" xpointer="d437-a1"/>
