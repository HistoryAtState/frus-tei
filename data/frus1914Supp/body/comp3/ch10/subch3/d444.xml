            <div xml:id="d444">

                <pb facs="0605" n="291" sameAs="frus:frus1914Supp/pg291"/>

                <note rend="inline" type="source">File No. 763.72112/380</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Germany</hi> (<hi rendition="#italic"
                        >Gerard</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Berlin</hi></placeName>, <date calendar="gregorian"
                        when="1914-11-11">
                        <hi rendition="#italic">November 11, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received November 16, 8 a.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>821. Your 514, October 28. Foreign Office informs me that under No. 27 of the
                    German prize ordinance [of September 30, 1909], cotton and cotton yarn shall not
                    be declared contraband. These goods cannot, therefore [as a matter of course],
                    be taken from neutral vessels. The German Government will abide by this attitude
                    as long as the enemy powers do not treat cotton and cotton yarn differently and
                    the neutral powers do not acquiesce in such treatment.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Gerard</hi>
                    </signed>
                </closer>
            </div>
        </body>
