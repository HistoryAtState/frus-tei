        <body>
            <div xml:id="d434">

                <pb facs="0599" n="285" sameAs="frus:frus1914Supp/pg285"/>

                <note rend="inline" type="source">File No. 763.72112/197</note>
                <head>
                    <hi rendition="#italic">The Consul General at London</hi> (<hi rendition="#italic"
                        >Skinner</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Consulate General</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">London</hi></placeName>, <date calendar="gregorian"
                        when="1914-10-19">
                        <hi rendition="#italic">October 19, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received 3:45 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>Holland-America Line hears that British Government intends to declare cotton
                    conditional contraband.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Skinner</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
