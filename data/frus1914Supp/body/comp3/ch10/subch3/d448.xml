    <text>
        <body>
            <div xml:id="d448">

                <pb facs="0607" n="293" sameAs="frus:frus1914Supp/pg293"/>

                <note rend="inline" type="source">File No. 763.72112/568</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Austria-Hungary</hi> (<hi rendition="#italic"
                        >Penfield</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Vienna</hi></placeName>, <date calendar="gregorian"
                        when="1914-12-16">
                        <hi rendition="#italic">December 16, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received December 17, 10 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>351. Your 258, November 8,<anchor n="1" xml:id="d448-f1"/> Austro-Hungarian
                    Government state that in navy regulations published May 2, 1913, raw cotton and
                    cotton yarn are specified as non-contraband and therefore free from seizure.
                    Austro-Hungarian Government will adhere to this rule conditional on reciprocity
                    enemy states.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Penfield</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
