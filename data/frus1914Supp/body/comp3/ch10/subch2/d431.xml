    <text>
        <body>
            <div xml:id="d431">

                <pb facs="0598" n="284" sameAs="frus:frus1914Supp/pg284"/>

                <note rend="inline" type="source">File No. 763.72112/576</note>
                <head>
                    <hi rendition="#italic">The British Ambassador</hi> (<hi rendition="#italic">Spring
                        Rice</hi>) <hi rendition="#italic">to the Counselor for the Department of State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">British Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-12-19">
                        <hi rendition="#italic">December 19, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received December 21</hi>.] </dateline>
                <p>
                    <hi rendition="#small-caps">My dear Mr. Counsellor</hi>: With regard to the
                    definition of the expression “copper unwrought” I have been informed by
                        Sir E. Grey that the subject is being
                    carefully studied and a decision will be made shortly which will be at once
                    communicated.</p>
                <p>Yours truly,</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Cecil Spring Rice</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
