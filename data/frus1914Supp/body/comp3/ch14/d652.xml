                <pb facs="0735" n="421" sameAs="frus:frus1914Supp/pg421"/>

                <note rend="inline" type="source">File No. 611.479/27</note>
                <head>
                    <hi rendition="#italic">The Consul General at Sydney, Australia</hi> (<hi rendition="#italic">Bray</hi>), <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Consulate General</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Sydney</hi></placeName>, <date
                        ana="#date_undated-inferred-from-document-content" calendar="gregorian"
                        notAfter="1914-11-02T09:00:00-05:00" notBefore="1914-11-01T00:00:00+10:00"
                            ><hi rendition="#italic">undated</hi></date>. <lb/> [<hi
                        rendition="#italic">Received November 2, 1914, 9 a.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>Except with consent Minister Customs prohibited wool, hides, woolly sheepskins,
                    meat, coal, flour, wheat, sugar. Official guarantees against reexport facilitate
                    permits. Minister being urged modify restrictions on exports to United
                    States.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Bray</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
