    <text>
        <body>
            <div xml:id="d647">

                <pb facs="0733" n="419" sameAs="frus:frus1914Supp/pg419"/>

                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Ambassador in Great Britain</hi> (<hi rendition="#italic">Page</hi>)</head>
                <dateline>
                    <hi rendition="#small-caps">Department of State</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-10-27">
                        <hi rendition="#italic">October 27, 1914</hi>.</date>
                </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>407. Your October 23, 887. You may use your good offices in behalf of the company
                    with a view to bringing about compliance with its request.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
