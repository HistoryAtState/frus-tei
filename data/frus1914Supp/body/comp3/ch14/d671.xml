    <text>
        <body>
            <div xml:id="d671">

                <pb facs="0742" n="428" sameAs="frus:frus1914Supp/pg428"/>

                <note rend="inline" type="source">File No. 611.46c 9/11</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Page</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">London</hi></placeName>, <date
                        ana="#date_undated-inferred-from-document-content" calendar="gregorian"
                        notAfter="1914-12-07T08:30:00-05:00" notBefore="1914-12-07T00:00:00+00:00"
                            ><hi rendition="#italic">undated</hi></date>. <lb/> [<hi
                        rendition="#italic">Received December 7, 1914, 8:30 a.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>1201. Your 640, November 28, 660, December 2, 665, December 2,<anchor n="1"
                        xml:id="d671-f1"/> and 681, December 4, presented and are covered by my
                    1199, December 6.<anchor n="2" xml:id="d671-f2"/>
                </p>
                <closer>
                    <hi rendition="#small-caps">American Ambassador</hi>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d671-f1" n="1" xml:id="d671-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d671-f2" n="2" xml:id="d671-f2-content">
                <p>
                    <hi rendition="#italic">Ante</hi>, <ref target="#pg356">p. 356</ref>. This is
                    the Ambassador’s telegram conveying the proposed “working arrangement” with
                    regard both to embargoes and to interference with ships and cargoes.</p>
            </note>
        </listAnnotation>
    </standOff>
