            <div xml:id="d679">

                <pb facs="0745" n="431" sameAs="frus:frus1914Supp/pg431"/>

                <note rend="inline" type="source">File No. 611.51L9/15</note>
                <head>
                    <hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic">Sharp</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Paris</hi></placeName>, <date calendar="gregorian"
                        when="1914-12-24">
                        <hi rendition="#italic">December 24, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received 11 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>403. Department’s 257, November 11.<anchor n="2" xml:id="d679-f1"/> French
                    Government authorizes export chrome ore New Caledonia provided seller gives bond
                    at customhouse, port of departure, to be released by French consul at New York
                    upon arrival shipment.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Sharp</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
