    <text>
        <body>
            <div xml:id="d730">

                <pb facs="0781" n="467" sameAs="frus:frus1914Supp/pg467"/>

                <note rend="inline" type="source">File No. 763.72/1268</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Germany</hi> (<hi rendition="#italic"
                    >Gerard</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi><anchor n="1" xml:id="d730-f1"/>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Berlin</hi></placeName>, <date calendar="gregorian"
                        when="1914-11-13">
                        <hi rendition="#italic">November 13, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received November 30</hi>.] </dateline>
                <p rendition="#flush">No. 261]</p>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to my cipher telegram No.
                    823, dated November 12, 1914,<anchor n="2" xml:id="d730-f2"/> I have the honor
                    to transmit to you herewith a copy in translation of the reply of the German
                    Government to the protest of the British Government against the laying of German
                        mines.<anchor n="3" xml:id="d730-f3"/>
                </p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">James W. Gerard</hi>
                        
                    </signed>
                </closer>


                <xi:include href="d730-a1.xml" xpointer="d730-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d730-f1" n="1" type="source" xml:id="d730-f1-content">
                <p>Forwarded, December 8, to the Ambassador in Great Britain for transmission
                    without comment to the Foreign Office.</p>
            </note>
            <note corresp="#d730-f2" n="2" xml:id="d730-f2-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d730-f3" n="3" xml:id="d730-f3-content">
