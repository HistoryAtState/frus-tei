    <text>
        <body>
            <div xml:id="d701">

                <pb facs="0767" n="453" sameAs="frus:frus1914Supp/pg453"/>

                <note rend="inline" type="source">File No. 763.72/134</note>
                <head>
                    <hi rendition="#italic">The Netherlands Chargé d’Affaires</hi> (<hi
                        rendition="#italic">De Beaufort</hi>) <hi rendition="#italic">to the
                        Secretary of State </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">Legation of the Netherlands</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-08-01">
                        <hi rendition="#italic">August 1, 1914</hi>.</date>
                </dateline>
                <p rendition="#center">[Translation]</p>
                <p>
                    <hi rendition="#small-caps">Mr. Secretary of State</hi>: By order of my
                    Government I have the honor to apprise your excellency, as required by Article 4
                    of the convention of 1907 concerning submarine mines, that the North Sea and
                    Goeree passes have been obstructed with submarine mines and that preparations
                    are being made to obstruct the other passes.</p>
                <p>Be pleased [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. de Beaufort</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
