    <text>
        <body>
            <div xml:id="d734">

                <pb facs="0784" n="470" sameAs="frus:frus1914Supp/pg470"/>

                <head>
                    <hi rendition="#italic">The Consul General at London</hi> (<hi
                        rendition="#italic">Skinner</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Consulate General</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">London</hi></placeName>, <date calendar="gregorian"
                        when="1914-12-11">
                        <hi rendition="#italic">December 11, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received December 21</hi>.] </dateline>
                <p rendition="#center">[Extract]</p>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith a
                    full copy of a circular which I have received from the Admiralty in regard to
                    the navigation of the North Sea and English Channel. . . .</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert P. Skinner</hi>
                    </signed>
                </closer>


                <xi:include href="d734-a1.xml" xpointer="d734-a1"/>
            </div>
