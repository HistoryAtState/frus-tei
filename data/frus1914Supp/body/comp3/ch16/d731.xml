    <text>
        <body>
            <div xml:id="d731">

                <pb facs="0783" n="469" sameAs="frus:frus1914Supp/pg469"/>

                <note rend="inline" type="source">File No. 763.72/1276a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Great
                        Britain</hi> (<hi rendition="#italic">Page</hi>)</head>
                <dateline>
                    <hi rendition="#small-caps">Department of State</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-12-02T22:00:00-05:00">
                        <hi rendition="#italic">December 2, 1914, 10 p.m.</hi>
                    </date>
                </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>667. Department’s 628, 27th. War Risk Bureau of Treasury Department very anxious
                    for reply as sailing of number of steamers being delayed awaiting
                    information.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi>
                    </signed>
                </closer>
            </div>
        </body>
