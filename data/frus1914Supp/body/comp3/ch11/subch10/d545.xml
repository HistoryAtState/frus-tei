        <body>
            <div xml:id="d545">

                <pb facs="0674" n="360" xml:id="pg360"/>

                <note rend="inline" type="source">File No. 763.72112/458</note>
                <head>
                    <hi rendition="#italic">The Minister in Sweden</hi> (<hi rendition="#italic"
                        >Morris</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Legation</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Stockholm</hi>
                    </placeName>
                    <date calendar="gregorian" when="1914-11-17">
                        <hi rendition="#italic">November 17, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received December 7</hi>.] </dateline>
                <p rendition="#flush">No. 37]</p>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith
                    copies and translation of a note with enclosures from the director general of
                    the Foreign Office.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Ira N. Morris</hi>
                    </signed>
                </closer>



                <xi:include href="d545-a1.xml" xpointer="d545-a1"/>
