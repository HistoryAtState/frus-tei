    <text>
        <body>
            <div xml:id="d545-a1">

                <pb facs="0674" n="360" sameAs="frus:frus1914Supp/pg360"/>


                <head>
                    <hi rendition="#italic">The Director General of the Swedish Foreign Office to
                        the American Minister</hi> (<hi rendition="#italic">Morris</hi>)</head>
                <opener>
                    <dateline>
                        <hi rendition="#small-caps">Ministry of Foreign Affairs</hi>, <lb/>
                        <placeName>
                            <hi rendition="#italic">Stockholm</hi>
                        </placeName>, <date calendar="gregorian" when="1914-11-14">
                            <hi rendition="#italic">November 14, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Morris</hi>: Hereby I beg to transmit to
                    you a copy of the note, which the Swedish Government have addressed to the
                    Governments of France, Germany, Great Britain, and Russia, thinking that the
                    same may be of interest to you.</p>
                <p>Identical notes have been sent by the Danish and Norwegian Governments.<anchor
                        n="1" xml:id="d545-f1"/>
                </p>
                <p>I remain [etc.]</p>
                <p rendition="#right">[File copy not signed]</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d545-f1" n="1" xml:id="d545-f1-content">
                <p>Copies of the note were also transmitted to the Department by the Danish Minister
                    on December 15, and by the Swedish Minister on December 18.</p>
            </note>
        </listAnnotation>
    </standOff>
