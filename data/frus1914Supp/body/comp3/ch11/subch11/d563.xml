    <text>
        <body>
            <div xml:id="d563">

                <pb facs="0691" n="377" sameAs="frus:frus1914Supp/pg377"/>

                <note rend="inline" type="source">File No. 768.72112/546</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Page</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">London</hi></placeName>, <date calendar="gregorian"
                        when="1914-12-28">
                        <hi rendition="#italic">December 28, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received 6 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>1342. Your 836, December 26,<anchor n="2" xml:id="d563-f1"/> received 27th, was
                    presented to Foreign Office to-day. Sir Edward
                        Grey will not return to London until 30th when I shall have a
                    conversation with him on the subject.</p>
                <closer>
                    <hi rendition="#small-caps">American Ambassador</hi>
                </closer>
            </div>
        </body>
    </text>
