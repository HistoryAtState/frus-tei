    <text>
        <body>
            <div xml:id="d525">

                <pb facs="0657" n="343" sameAs="frus:frus1914Supp/pg343"/>

                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Germany</hi> (<hi
                            rendition="#italic">Gerard</hi>)</head>
                <dateline>
                    <hi rendition="#small-caps">Department of State</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-11-09T20:00:00-05:00">
                        <hi rendition="#italic">November 9, 1914, 8 p.m.</hi>
                    </date>
                </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>608. Your 724, November 4.<anchor n="1" xml:id="d525-f1"/> Endeavor obtain
                    information regarding procedure which should be followed by persons desiring to
                    present claims for cargoes that have been destroyed.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Bryan</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
