    <text>
        <body>
            <div xml:id="d801">

                <pb facs="0822" n="508" xml:id="pg508"/>

                <note rend="inline" type="source">File No. 841.731/6</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Page</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">London</hi></placeName>, <date calendar="gregorian"
                        when="1914-08-24">
                        <hi rendition="#italic">August 24, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received September 4</hi>.] </dateline>
                <p rendition="#flush">No. 419]</p>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to your telegram of August
                    15, 5 p.m., I have the honor to transmit herewith a copy of a note I have just
                    received from the Foreign Office touching the censorship of telegraphic messages
                    passing over the Atlantic cables.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Walter Hines Page</hi>
                    </signed>
                </closer>


                <xi:include href="d801-a1.xml" xpointer="d801-a1"/>
            </div>
