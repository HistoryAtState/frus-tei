    <text>
        <body>
            <div xml:id="d814">

                <pb facs="0827" n="513" sameAs="frus:frus1914Supp/pg513"/>

                <note rend="inline" type="source">File No. 841.731/55</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Page</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">London</hi></placeName>, <date calendar="gregorian"
                        when="1914-10-30">
                        <hi rendition="#italic">October 30, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received 8 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>945. Your telegram 405, 27th. Foreign Office informs me that private individuals
                    telegraphing to this country are allowed to use registered cable addresses and
                    that signatures may be abbreviated but must indicate the source
                        unmistakably.<anchor n="1" xml:id="d814-f1"/>
                </p>
                <closer>
                    <hi rendition="#small-caps">American Ambassador</hi>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d814-f1" n="1" xml:id="d814-f1-content">
                <p>Following the receipt of this telegram, the Department resumed the use of its own
                    abbreviated forms of addresses and signatures.</p>
            </note>
        </listAnnotation>
    </standOff>
