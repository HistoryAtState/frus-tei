                <pb facs="0817" n="503" sameAs="frus:frus1914Supp/pg503"/>

                <note rend="inline" type="source">File No. 763.72/143</note>
                <head>
                    <hi rendition="#italic">The Consul at St. Pierre</hi> (<hi rendition="#italic">Kemp</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">St. Pierre</hi></placeName>, <date
                        calendar="gregorian" when="1914-08-05T14:00:00-04:00">
                        <hi rendition="#italic">August 5, 1914, 2 p.m.</hi>
                    </date>
                    <lb/> [<hi rendition="#italic">Received 1:40 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>Will you authorize protection as neutral property telegraph cables leased by the
                    Western Union at this place?</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Kemp</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
