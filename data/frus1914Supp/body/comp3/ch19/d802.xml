    <text>
        <body>
            <div xml:id="d802">

                <pb facs="0822" n="508" sameAs="frus:frus1914Supp/pg508"/>

                <note rend="inline" type="source">File No. 841.731/33C</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Great
                        Britain</hi> (<hi rendition="#italic">Page</hi>)</head>
                <dateline>
                    <hi rendition="#small-caps">Department of State</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-09-05">
                        <hi rendition="#italic">September 5, 1914</hi>.</date>
                </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>66. Represent to British Government the great hardship placed upon American
                    importers by refusal of British Government to pass their cipher messages, and
                    ascertain whether the restrictions would be removed provided copy of the code is
                    deposited with British censor.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
