    <text>
        <body>
            <div xml:id="d798">

                <pb facs="0820" n="506" sameAs="frus:frus1914Supp/pg506"/>

                <note rend="inline" type="source">File No. 841.731</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Page</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi><anchor n="1" xml:id="d798-f1"/>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">London</hi></placeName>, <date calendar="gregorian"
                        when="1914-08-27">
                        <hi rendition="#italic">August 27, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received 3:30 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>493. Please inform all foreign missions concerned that British censorship
                    regulations provide that only messages passing between diplomatic missions and
                    the Government at Washington may go in cipher. All others must be open.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Page</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d798-f1" n="1" type="source" xml:id="d798-f1-content">
                <p>Communicated to the American embassies and legations concerned, August 28 (File
                    No. 841.731/33a).</p>
            </note>
        </listAnnotation>
    </standOff>
