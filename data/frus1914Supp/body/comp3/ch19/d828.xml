                <pb facs="0833" n="519" xml:id="pg519"/>

                <note rend="inline" type="source">File No. 841.731/155</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Italy</hi> (<hi rendition="#italic">Page</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Rome</hi></placeName>, <date calendar="gregorian"
                        when="1914-11-27">
                        <hi rendition="#italic">November 27, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received 10:20 p.m.</hi>] </dateline>
                <p>My telegram November 9.<anchor n="1" xml:id="d828-f1"/> Your telegram No. 81,
                    November 10,<anchor n="1" xml:id="d828-f2"/> Continued complaints commercial
                    telegrams to American companies undelivered, including important messages
                    Curtiss Aeroplane Company. Interference apparently outside of Italy. Business
                    much disturbed.</p>
                <closer>
                    <hi rendition="#small-caps">American Ambassador</hi>
                </closer>
            </div>
        </body>
    </text>
