    <text>
        <body>
            <div xml:id="d830">

                <pb facs="0833" n="519" sameAs="frus:frus1914Supp/pg519"/>

                <note rend="inline" type="source">File No. 841.731/83</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Great Britain</hi> (<hi
                            rendition="#italic">Page</hi>)</head>
                <dateline>
                    <hi rendition="#small-caps">Department of State</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-12-02T17:00:00-05:00">
                        <hi rendition="#italic">December 2, 1914, 5 p.m.</hi>
                    </date>
                    <lb/> [<hi rendition="#italic">Received 11 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>664. From Madrid Embassy, November 27:</p>
                <p>Consul General Barcelona informs me importation of cotton to Spain from the
                    United States seriously interfered with owing to British censorship of cable
                    messages intelligibly worded and in clear English referring to transaction in
                    purchase of cotton. He requests relief on behalf of Spanish importers from
                    censorship interference with such messages.</p>
                <p>You may inform Foreign Office.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Bryan</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
