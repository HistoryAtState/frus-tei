            <div xml:id="d821">

                <pb facs="0829" n="515" sameAs="frus:frus1914Supp/pg515"/>

                <note rend="inline" type="source">File No. 841.731/63</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Great Britain</hi> (<hi rendition="#italic">Page</hi>)</head>
                <dateline>
                    <hi rendition="#small-caps">Department of State</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-11-12">
                        <hi rendition="#italic">November 12, 1914</hi>.</date>
                </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>523. From Copenhagen, 11th. Danish firms conducting business with American houses
                    protest against English censorship of open commercial cables, which is ruining
                    business between America and Denmark. Please present this matter to Foreign
                    Office with a view to ameliorating the hardships described.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Bryan</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
