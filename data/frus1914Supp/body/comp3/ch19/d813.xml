            <div xml:id="d813">

                <pb facs="0827" n="513" xml:id="pg513"/>

                <note rend="inline" type="source">File No. 841.731/54a</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in Great
                        Britain</hi> (<hi rendition="#italic">Page</hi>)</head>
                <dateline>
                    <hi rendition="#small-caps">Department of State</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-10-27">
                        <hi rendition="#italic">October 27, 1914</hi>.</date>
                </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>405. Please confirm advices cable companies that cable addresses and short
                    signatures may now be used.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
