            <div xml:id="d839">

                <pb facs="0837" n="523" sameAs="frus:frus1914Supp/pg523"/>

                <note rend="inline" type="source">File No. 841.731/116</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in France</hi> (<hi
                            rendition="#italic">Herrick</hi>)</head>
                <dateline>
                    <hi rendition="#small-caps">Department of State</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-12-10">
                        <hi rendition="#italic">December 10, 1914</hi>.</date>
                </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>361. Please bring attention Foreign Office that telegrams addressed Milan and
                    other points in Italy, via French cable, have been censored and not delivered.
                    Department has received numerous protests from cotton merchants and feels
                    something should be done by French Government immediately to relieve
                    situation.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Bryan</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
