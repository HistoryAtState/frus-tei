                <pb facs="0824" n="510" sameAs="frus:frus1914Supp/pg510"/>

                <note rend="inline" type="source">File No. 841.731/32</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Page</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">London</hi></placeName>, <date calendar="gregorian"
                        when="1914-10-02">
                        <hi rendition="#italic">October 2, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received 11:30 a.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>Your 229 first. No change in censorship regulations.</p>
                <closer>
                    <hi rendition="#small-caps">American Ambassador</hi>
                </closer>
            </div>
