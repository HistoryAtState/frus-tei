    <text>
        <body>
            <div xml:id="d360">

                <pb facs="0531" n="217" sameAs="frus:frus1914Supp/pg217"/>

                <note rend="inline" type="source">File No. 763.72112/100</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Page</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi><anchor n="1" xml:id="d360-f1"/>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">London</hi></placeName>, <date calendar="gregorian"
                        when="1914-08-19">
                        <hi rendition="#italic">August 19, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received August 20, 6:40 a.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>413. Your August 6, 1 p.m. Sir Edward Grey
                    asks you to inquire of the Austro-Hungarian and German Governments what attitude
                    they intend to adopt towards the Declaration of London during the present war
                    period.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">American Ambassador</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d360-f1" n="1" type="source" xml:id="d360-f1-content">
                <p>Transmitted to the Ambassadors in Germany and Austria-Hungary, August 20.</p>
            </note>
        </listAnnotation>
    </standOff>
