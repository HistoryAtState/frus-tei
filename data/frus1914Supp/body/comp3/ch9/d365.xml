    <text>
        <body>
            <div xml:id="d365">

                <pb facs="0534" n="220" sameAs="frus:frus1914Supp/pg220"/>

                <note rend="inline" type="source">File No. 763.72112/112</note>
                <head>
                    <hi rendition="#italic">The Chargé d’Affaires in Russia</hi> (<hi
                        rendition="#italic">Wilson</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">St. Petersburg</hi></placeName>, <date
                        ana="#date_undated-inferred-from-document-content" calendar="gregorian"
                        notAfter="1914-08-27T22:02:00-05:00" notBefore="1914-08-27T00:00:00+02:30"
                            ><hi rendition="#italic">undated</hi></date>. <lb/> [<hi
                        rendition="#italic">Received August 27, 1914, 10:02 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>Russian Government accepts Declaration of London with exact modifications adopted
                    by England and France.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wilson</hi>
                    </signed>
                </closer>
            </div>
