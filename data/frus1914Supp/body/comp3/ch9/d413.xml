            <div xml:id="d413">

                <pb facs="0582" n="268" xml:id="pg268"/>

                <note rend="inline" type="source">File No. 763.72112/483</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Germany</hi> (<hi rendition="#italic"
                    >Gerard</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Berlin</hi></placeName>, <date calendar="gregorian"
                        when="1914-12-15">
                        <hi rendition="#italic">December 15, 1914</hi>
                    </date>
                    <lb/> [<hi rendition="#italic">Received December 16, 5:05 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>1099. By proclamation dated 14th instant German Government has added aluminum and
                    nickel to list of conditional contraband as numbers 19 and 20, respectively.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Gerard</hi>
                        
                    </signed>
                </closer>
            </div>
