    <text>
        <body>
            <div xml:id="d417">

                <pb facs="0584" n="270" sameAs="frus:frus1914Supp/pg270"/>

                <note rend="inline" type="source">File No. 763.72112/579</note>
                <head>
                    <hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic">Sharp</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Paris</hi></placeName>, <date calendar="gregorian"
                        when="1915-01-05">
                        <hi rendition="#italic">January 5, 1915</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received 9:50 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>428. Your 13th [30th].<anchor n="1" xml:id="d417-f1"/> British Embassy informs me
                    that British and French lists of contraband now correspond absolutely.<anchor
                        n="2" xml:id="d417-f2"/>
                </p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Sharp</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d417-f1" n="1" xml:id="d417-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d417-f2" n="2" xml:id="d417-f2-content">
                <p>The French list published January 3, corresponding to the British list of
                    December 23, was forwarded by the consul General in Paris, January 4 (File No.
                    763.72112/570)</p>
            </note>
        </listAnnotation>
    </standOff>
