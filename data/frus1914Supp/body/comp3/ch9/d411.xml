    <text>
        <body>
            <div xml:id="d411">

                <pb facs="0580" n="266" xml:id="pg266"/>

                <note rend="inline" type="source">File No. 763.72112/475</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Germany</hi> (<hi rendition="#italic"
                        >Gerard</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Berlin</hi></placeName>, <date calendar="gregorian"
                        when="1914-11-23">
                        <hi rendition="#italic">November 23, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received December 14</hi>.] </dateline>
                <p rendition="#flush">No. 280]</p>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit to you
                    herewith translations of two notes received from the Imperial Foreign Office
                    conveying notification of additions to the original lists of articles regarded
                    as contraband by the German Government, which, as reported in my telegram of
                    August 10, 1 p.m., [<hi rendition="#italic">a.m.</hi>]<anchor n="1"
                        xml:id="d411-f1"/> corresponded in all respects with Articles 22 and 24 of
                    the Declaration of London.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">James W. Gerard</hi>
                    </signed>
                </closer>



                <xi:include href="d411-a1.xml" xpointer="d411-a1"/>
                <xi:include href="d411-a2.xml" xpointer="d411-a2"/>
