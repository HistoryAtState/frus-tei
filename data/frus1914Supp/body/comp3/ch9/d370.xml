    <text>
        <body>
            <div xml:id="d370">

                <pb facs="0536" n="222" sameAs="frus:frus1914Supp/pg222"/>

                <note rend="inline" type="source">File No. 763.72112/124</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Austria-Hungary</hi> (<hi
                        rendition="#italic">Penfield</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi><anchor n="1" xml:id="d370-f1"/>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Vienna</hi></placeName>, <date calendar="gregorian"
                        when="1914-09-07">
                        <hi rendition="#italic">September 7, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received September 8, 10 a.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>17. Your 21, September 2.<anchor n="2" xml:id="d370-f2"/> Austro-Hungarian
                    Government desires British Government be notified that they will treat as
                    absolute <pb facs="0537" n="223" xml:id="pg223"/> or conditional contraband
                    those objects and material which are enumerated in Articles 22 and 24 of
                    Declaration of London.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Penfield</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d370-f1" n="1" type="source" xml:id="d370-f1-content">
                <p>Repeated to the Ambassador in Great Britain, September 10. The reply to the
                    British inquiry received from the Ambassador in Germany, dated September 4 (File
                    No. 763.72112/121), was a repetition of his telegram of August 10, <hi
                        rendition="#italic">ante</hi>, <ref target="#pg216">p. 216</ref>.</p>
            </note>
            <note corresp="#d370-f2" n="2" xml:id="d370-f2-content">
                <p>Not printed.</p>
            </note>
        </listAnnotation>
    </standOff>
