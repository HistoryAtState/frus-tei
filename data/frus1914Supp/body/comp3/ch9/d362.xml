        <body>
            <div xml:id="d362">

                <pb facs="0532" n="218" xml:id="pg218"/>

                <note rend="inline" type="source">File No. 763.72112/107</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Austria-Hungary</hi> (<hi
                        rendition="#italic">Penfield</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Vienna</hi></placeName>, <date calendar="gregorian"
                        when="1914-08-23">
                        <hi rendition="#italic">August 23, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received 5 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>Your August 21 [20] via Berlin. In all declarations of war Austro-Hungarian
                    Government has announced adherence to provisions Declaration of London on
                    condition reciprocity.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Penfield</hi>
                    </signed>
                </closer>
            </div>
        </body>
