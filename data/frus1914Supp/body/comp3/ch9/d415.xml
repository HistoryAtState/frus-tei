    <text>
        <body>
            <div xml:id="d415">

                <pb facs="0582" n="268" sameAs="frus:frus1914Supp/pg268"/>

                <note rend="inline" type="source">File No. 763.72112/522</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Turkey</hi> (<hi rendition="#italic"
                        >Morgenthau</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Constantinople</hi></placeName>, <date
                        calendar="gregorian" when="1914-12-24">
                        <hi rendition="#italic">December 24, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received December 26, 8 a.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>206. My 166, sixteenth.<anchor n="1" xml:id="d415-f1"/> Ottoman Government
                    communicates following additional list of conditional contraband articles:</p>
                <p>Crude copper; lead, pig, plates and pipes; glycerine; ferrochrome; hematite;
                    magnetic iron ore; rubber; leather; and raw or partially tanned skins, not
                    including dressed skins.</p>
                <closer>
                    <hi rendition="#small-caps">American Ambassador</hi>
                </closer>
            </div>
        </body>
    </text>
