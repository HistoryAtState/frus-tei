    <text>
        <body>
            <div xml:id="d373">

                <pb facs="0537" n="223" sameAs="frus:frus1914Supp/pg223"/>

                <note rend="inline" type="source">File No. 763.72112/128</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Page</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">London</hi></placeName>, <date calendar="gregorian"
                        when="1914-09-02">
                        <hi rendition="#italic">September 2, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received September 15</hi>.] </dateline>
                <p rendition="#flush">No. 428]</p>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: In confirmation of my telegram of the 1st
                    instant, No. 547, I have the honor to transmit herewith enclosed a copy of the
                    Foreign Office note, dated the 31st ultimo, upon which the same was based,
                    together with the order in council referred to therein.<anchor n="2"
                        xml:id="d373-f1"/>
                </p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Walter Hines Page</hi>
                        
                    </signed>
                </closer>



                <xi:include href="d373-a1.xml" xpointer="d373-a1"/>
            </div>
        </body>
    </text>
