                <pb facs="0808" n="494" sameAs="frus:frus1914Supp/pg494"/>

                <note rend="inline" type="source">File No. 195.1/68</note>
                <head>
                    <hi rendition="#italic">The Consul General at Rio de Janeiro</hi> (<hi
                        rendition="#italic">Burnell</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Consulate General</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Rio De Janeiro</hi></placeName>, <date
                        calendar="gregorian" when="1914-09-23">
                        <hi rendition="#italic">September 23, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received 4 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>Provisional register issued and delivered to steamer <hi rendition="#italic"
                        >Robert Dollar</hi> September 22, although vessel sailed to-day by order of
                    owners under British register.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Burnell</hi>
                    </signed>
                </closer>
            </div>
        </body>
