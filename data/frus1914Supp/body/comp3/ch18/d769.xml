    <text>
        <body>
            <div xml:id="d769">

                <pb facs="0803" n="489" sameAs="frus:frus1914Supp/pg489"/>

                <note rend="inline" type="source">File No. 195.1/13</note>
                <head>
                    <hi rendition="#italic">The French Chargé d’Affaires</hi> (<hi rendition="#italic"
                        >Clausse</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">French Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Manchester, Massachusetts</hi></placeName>, <date
                        calendar="gregorian" when="1914-08-20">
                        <hi rendition="#italic">August 20, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received August 22</hi>.] </dateline>
                <p rendition="#center">[Translation]</p>
                <p>
                    <hi rendition="#small-caps">Mr. Secretary of State</hi>: My Government has heard
                    that Austro-Hungarian shipowners intend to try and get from American consuls
                    abroad certificates of Federal nationality for vessels sold to American citizens
                    and desires me to inform the Federal Government that such flag transfers, if
                    made, could not be recognized by the Government of the Republic.</p>
                <p>Be pleased [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Clausse</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
