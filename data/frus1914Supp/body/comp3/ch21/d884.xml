        <body>
            <div xml:id="d884">

                <pb facs="0857" n="543" sameAs="frus:frus1914Supp/pg543"/>

                <note rend="inline" type="source">File No. 124.0665/9</note>
                <head>
                    <hi rendition="#italic">The Minister in Servia</hi> (<hi rendition="#italic"
                        >Vopicka</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Legation</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Nish</hi></placeName>, <date calendar="gregorian"
                        when="1914-12-24">
                        <hi rendition="#italic">December 24, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received 8:50 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>Servian Government just notified me that it agrees to the proposed postal
                    regulations respecting seals submitted by American government.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Vopicka</hi>
                    </signed>
                </closer>
            </div>
        </body>
