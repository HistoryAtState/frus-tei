        <body>
            <div xml:id="d871">

                <pb facs="0853" n="539" sameAs="frus:frus1914Supp/pg539"/>

                <note rend="inline" type="source">File No. 841.711/6</note>
                <head>
                    <hi rendition="#italic">The Consul General at Rotterdam</hi> (<hi rendition="#italic">Listoe</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Rotterdam</hi></placeName>, <date
                        ana="#date_undated-inferred-from-document-content" calendar="gregorian"
                        notAfter="1914-10-24T23:59:59-05:00" notBefore="1914-10-24T00:00:00+00:19"
                            ><hi rendition="#italic">undated</hi></date>. <lb/> [<hi
                        rendition="#italic">Received October 24, 1914</hi>.] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>Have not knowingly transmitted commercial correspondence between belligerent
                    countries. Positive instructions on subject much desired.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Listoe</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
