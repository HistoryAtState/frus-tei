    <text>
        <body>
            <div xml:id="d866">

                <pb facs="0849" n="535" sameAs="frus:frus1914Supp/pg535"/>

                <note rend="inline" type="source">File No. 841.711/1</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Page</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">London</hi></placeName>, <date calendar="gregorian"
                        when="1914-09-19">
                        <hi rendition="#italic">September 19, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received October 5</hi>.] </dateline>
                <p rendition="#flush">No. 467]</p>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith an
                    inquiry, with accompanying enclosures, received from the American Legation at
                    The Hague, with reference to the regulations and authorization under which the
                    British censor is opening mail of the American Consular Service.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Walter Hines Page</hi>
                        
                    </signed>
                </closer>


                <xi:include href="d866-a1.xml" xpointer="d866-a1"/>
            </div>
        </body>
    </text>
