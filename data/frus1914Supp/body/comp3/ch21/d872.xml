    <text>
        <body>
            <div xml:id="d872">

                <pb facs="0853" n="539" sameAs="frus:frus1914Supp/pg539"/>

                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Consul General at Rotterdam</hi> (<hi rendition="#italic">Listoe</hi>)</head>
                <dateline>
                    <hi rendition="#small-caps">Department of State</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-10-29">
                        <hi rendition="#italic">October 29, 1914</hi>.</date>
                </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>Your October 24. You should not permit consulate be used as medium for
                    transmission private commercial telegrams or correspondence destined for
                    belligerent countries.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
