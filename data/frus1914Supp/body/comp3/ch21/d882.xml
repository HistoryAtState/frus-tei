            <div xml:id="d882">

                <pb facs="0857" n="543" sameAs="frus:frus1914Supp/pg543"/>

                <note rend="inline" type="source">File No. 124.0665/1</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Austria-Hungary</hi> (<hi rendition="#italic"
                        >Penfield</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Vienna</hi></placeName>, <date calendar="gregorian"
                        when="1914-12-08">
                        <hi rendition="#italic">December 8, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received December 9, 7:30 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>334. Your 305, 25th. Austro-Hungarian Government agrees to proposal for
                    inviolability of all diplomatic and consular correspondence on conditions
                    specified. Have instructed consuls.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Penfield</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
