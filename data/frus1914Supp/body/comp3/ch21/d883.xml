            <div xml:id="d883">

                <pb facs="0857" n="543" sameAs="frus:frus1914Supp/pg543"/>

                <note rend="inline" type="source">File No. 124.0665/2</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Russia</hi> (<hi rendition="#italic"
                        >Marye</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Petrograd</hi></placeName>, <date
                        calendar="gregorian" when="1914-12-11">
                        <hi rendition="#italic">December 11, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received 7:30 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>146. Department’s 91, 4th.<anchor n="1" xml:id="d883-f1"/> Foreign Office states
                    exemption from censure or correspondence of diplomatic and consular officers
                    guaranteed by decree of August 2 concerning temporary military censorship,
                    according to which censorship does not apply to letters, telegrams, and
                    despatches of diplomatic and consular officials but [all] such must be presented
                    to postal and telegraph officials clearly marked as belonging to such diplomatic
                    or consular officials.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Marye</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
