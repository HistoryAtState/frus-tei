        <body>
            <div xml:id="d749">

                <pb facs="0792" n="478" sameAs="frus:frus1914Supp/pg478"/>

                <note rend="inline" type="source">File No. 840.48/232</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Germany</hi> (<hi rendition="#italic"
                    >Gerard</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Berlin</hi></placeName>, <date
                        ana="#date_undated-inferred-from-document-content" calendar="gregorian"
                        notAfter="1914-08-13T17:40:00-05:00" notBefore="1914-08-13T00:00:00+01:00"
                            ><hi rendition="#italic">undated</hi></date>. <lb/> [<hi
                        rendition="#italic">Received August 13, 1914, 9:40 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>German Government agrees to refrain from interference with American transports on
                    condition that all other nations at war assure the United States of their
                    respective willingness to agree. Also German Government will issue passes to
                    these ships on hearing from you to this effect.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Gerard</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
