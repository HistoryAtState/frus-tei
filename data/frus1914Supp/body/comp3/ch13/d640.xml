            <div xml:id="d640">

                <pb facs="0730" n="416" sameAs="frus:frus1914Supp/pg416"/>

                <note rend="inline" type="source">File No. 165.102/226</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Germany</hi> (<hi rendition="#italic"
                    >Gerard</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName><hi rendition="#italic">Berlin</hi></placeName>, <date
                        calendar="gregorian" when="1914-10-31T18:00:00+01:00">
                        <hi rendition="#italic">October 31, 1914, 6 p.m.</hi>
                    </date>
                    <lb/> [<hi rendition="#italic">Received November 1, 7:30 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>683. Department’s 516, 29th.<anchor n="1" xml:id="d640-f1"/> Your 448, 19th,
                    seems satisfactory to German Government as they allow the export of dyestuffs,
                    cyanide, and chemicals.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Gerard</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
