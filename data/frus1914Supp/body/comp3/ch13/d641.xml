    <text>
        <body>
            <div xml:id="d641">

                <pb facs="0731" n="417" xml:id="pg417"/>

                <note rend="inline" type="source">File No. 165.102/274</note>
                <head>
                    <hi rendition="#italic">The Ambassador Germany</hi> (<hi rendition="#italic">Gerard</hi>) <hi
                        rendition="#italic">to the Secretary of state
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Berlin</hi></placeName>, <date calendar="gregorian"
                        when="1914-11-29T13:00:00+01:00">
                        <hi rendition="#italic">November 29, 1914, 1 p.m.</hi>
                    </date>
                    <lb/> [<hi rendition="#italic">Received November 30, 10:30 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>950. Hear rumors that the German Government, displeased by the sale of American
                    war materials to England and France, may place difficulties in the. way of
                    exportation of dyestuffs, etc. Under the circumstances information for
                    communication to the German Government concerning shipments of cotton in
                    addition to those mentioned in Department’s 650, November 1.6, 8 p.m.,<anchor
                        n="1" xml:id="d641-f1"/> would doubtless prove useful in helping to insure
                    permission for comtinued exportation dyestuffs, etc.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Gerard</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
