    <text>
        <body>
            <div xml:id="d690">

                <pb facs="0755" n="441" sameAs="frus:frus1914Supp/pg441"/>

                <note rend="inline" type="source">File No. 763.72112/433</note>
                <head>
                    <hi rendition="#italic">The Minister in Peru</hi> (<hi rendition="#italic"
                        >McMillin</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Legation</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Lima</hi></placeName>, <date calendar="gregorian"
                        when="1914-11-10">
                        <hi rendition="#italic">November 10, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received November 28</hi>.] </dateline>
                <p rendition="#flush">No. 100]</p>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Following my cable of November 10, 12
                        noon,<anchor n="1" xml:id="d690-f1"/> I have the honor to forward herewith
                    translations of a note and a memorandum received from Minister for Foreign
                    Affairs Gazzani with the request that the latter be transmitted to the
                    Department for consideration by our Government. As it is lengthy I sent only a
                    brief notice of its contents by cable, reserving the full text for transmission
                    by the pouch.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Benton McMillin</hi>
                    </signed>
                </closer>



                <xi:include href="d690-a1.xml" xpointer="d690-a1"/>
                <xi:include href="d690-a2.xml" xpointer="d690-a2"/>
            </div>
