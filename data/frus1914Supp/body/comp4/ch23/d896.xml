        <body>
            <div xml:id="d896">

                <pb facs="0877" n="563" sameAs="frus:frus1914Supp/pg563"/>

                <note rend="inline" type="source">File No. 763.72/1047</note>
                <head>
                    <hi rendition="#italic">The Vice Consul at Kingston</hi>, <hi
                        rendition="#italic">Jamaica</hi> (<hi rendition="#italic">Bundy</hi>), <hi
                        rendition="#italic">to the Secretary of State </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Kingston, Jamaica</hi></placeName>, <date
                        ana="#date_undated-inferred-from-document-content" calendar="gregorian"
                        notAfter="1914-10-05T13:00:00-05:00" notBefore="1914-10-05T00:00:00-05:00"
                            ><hi rendition="#italic">undated</hi></date>. <lb/> [<hi
                        rendition="#italic">Received October 5, 1914, 1 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>British authorities Jamaica ask boats under American flag carry no Germans or
                    Austrians, either crew or passengers, liable military duty avoiding requirement
                    search.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bundy</hi>
                    </signed>
                </closer>
            </div>
        </body>
