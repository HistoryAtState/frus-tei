    <text>
        <body>
            <div xml:id="d892">

                <pb facs="0874" n="560" sameAs="frus:frus1914Supp/pg560"/>

                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        Japan</hi> (<hi rendition="#italic">Guthrie</hi>)</head>
                <dateline>
                    <hi rendition="#small-caps">Department of State</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-09-24">
                        <hi rendition="#italic">September 24, 1914</hi>.</date>
                </dateline>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Receipt is acknowledged of your despatch
                    of August 27, 1914, enclosing copies of correspondence passing between the
                    Embassy and the Great Northern and Pacific Mail Steamship Companies, with
                    reference to the transportation on ships of those companies of Austrian and
                    German reservists from Japan to the United States. The Department approves your
                    course in this matter.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
