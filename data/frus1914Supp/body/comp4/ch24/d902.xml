    <text>
        <body>
            <div xml:id="d902">

                <pb facs="0879" n="565" sameAs="frus:frus1914Supp/pg565"/>

                <note rend="inline" type="source">File No. 150.07/21</note>
                <head>
                    <hi rendition="#italic">The Russian Ambassador</hi> (<hi rendition="#italic">Bakhméteff</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">Russian Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Newport, Rhode Island</hi></placeName>, <date
                        calendar="gregorian" when="1914-08-27">
                        <hi rendition="#italic">August 27, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received 3:30 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>I would be much obliged to you if you would give immediate instructions to
                    immigration authorities on Canadian border to allow admission of Russians to New
                    York in transit to Archangel by steamer sailing Saturday.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Bakhméteff</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
