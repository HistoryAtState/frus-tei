    <text>
        <body>
            <div xml:id="d913">

                <pb facs="0884" n="570" sameAs="frus:frus1914Supp/pg570"/>

                <note rend="inline" type="source">File No. 150.07/57</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        British Ambassador</hi> (<hi
                            rendition="#italic">Spring Rice</hi>)</head>
                <dateline>
                    <hi rendition="#small-caps">Department of State</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-12-04">
                        <hi rendition="#italic">December 4, 1914</hi>.</date>
                </dateline>
                <p>
                    <hi rendition="#small-caps">My dear Mr. Ambassador</hi>: Referring to your note
                    of October 27 last, relative to the issuance of general instructions to the
                    immigration officials at Montreal to allow the reservists of Great Britain to
                    pass through the United States <hi rendition="#italic">en route</hi> to the
                    United Kingdom, I beg to advise you of the receipt of a letter from the Acting
                    Secretary of labor, stating that such instructions have been sent to the
                    Commissioner of Immigration at Montreal.<anchor n="1" xml:id="d913-f1"/>
                </p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">W. J. Bryan</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d913-f1" n="1" xml:id="d913-f1-content">
                <p>They were sent November 19 in response to a request of November 17 from the
                    Department of State, without regard to the further question raised in the note
                    printed, <hi rendition="#italic">ante</hi>, <ref target="#pg568">p.
                    568</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
