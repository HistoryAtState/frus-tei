    <text>
        <body>
            <div xml:id="d903">

                <pb facs="0880" n="566" xml:id="pg566"/>

                <head>
                    <hi rendition="#italic">The Secretary of State to the Russian Ambassador</hi>
                        (<hi rendition="#italic">Bakhméteff</hi>)</head>
                <dateline>
                    <hi rendition="#small-caps">Department of State</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-08-28">
                        <hi rendition="#italic">August 28, 1914</hi>.</date>
                </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>Your telegram of yesterday was not received until after the office was closed
                    last evening. The Department of Labor has to-day sent the necessary instructions
                    to the immigration authorities on the Canadian border in accordance with your
                    request.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. J. Bryan</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
