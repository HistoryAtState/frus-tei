            <div xml:id="d927">

                <pb facs="0892" n="578" xml:id="pg578"/>

                <note rend="inline" type="source">File No. 763.72111Em1</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Germany</hi> (<hi rendition="#italic"
                    >Gerard</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Berlin</hi></placeName>, <date calendar="gregorian"
                        when="1914-12-04T23:00:00+01:00">
                        <hi rendition="#italic">December, 4 1914, 11 p.m.</hi>
                    </date>
                    <lb/> [<hi rendition="#italic">Received December 5, 5 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>1005. Universal, very bitter, and increasing feeling in Germany because of
                    reported sale by. Americans of munitions of war, etc., to Allies. Boycotting of
                    American goods already beginning.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Gerard</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
