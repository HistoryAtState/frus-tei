    <text>
        <body>
            <div xml:id="d917">

                <pb facs="0886" n="572" sameAs="frus:frus1914Supp/pg572"/>

                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Secretary of the Treasury</hi> (<hi
                            rendition="#italic">McAdoo</hi>)</head>
                <dateline>
                    <hi rendition="#small-caps">Department of State</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-09-05">
                        <hi rendition="#italic">September 5, 1914</hi>.</date>
                </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>Referring to telephone communication from your department regarding shipment of
                    war munitions and equipment through Alaska and your letter of the third instant
                    giving further information in this case, Department advises that transit of
                    these materials through the Territory of Alaska be refused.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">W. J. Bryan</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
