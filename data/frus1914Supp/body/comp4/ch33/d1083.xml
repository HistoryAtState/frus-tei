        <body>
            <div xml:id="d1083">

                <pb facs="0989" n="675" sameAs="frus:frus1914Supp/pg675"/>

                <note rend="inline" type="source">File No. 763.72111/73</note>
                <head>
                    <hi rendition="#italic">The Secretary of the Navy</hi> (<hi rendition="#italic"
                    >Daniels</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">Navy Department</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-08-22">
                        <hi rendition="#italic">August 22, 1914</hi>.</date>
                </dateline>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to forward herewith, for
                    your information, copies of telegrams received and sent by this Department
                    relative to the enforcement of the President’s neutrality proclamation during
                    the existing wars among certain European countries.</p>
                <p rendition="#flush">Sincerely yours,</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Josephus Daniels</hi>
                        
                    </signed>
                </closer>






