            <div xml:id="d971">

                <pb facs="0920" n="606" sameAs="frus:frus1914Supp/pg606"/>

                <note rend="inline" type="source">File No. 763.72111/113</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        German Ambassador</hi> (<hi
                            rendition="#italic">Bernstorff</hi>)</head>
                <dateline>
                    <hi rendition="#small-caps">Department of State</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-09-04">
                        <hi rendition="#italic">September 4, 1914</hi>.</date>
                </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>Your telegram September 1. This Department being satisfied that <hi
                        rendition="#italic">Merion</hi> is merchant vessel has advised her
                    clearance. Department is assured that all ammunition will be taken off and guns
                    dismounted and placed in her hold.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">W. J. Bryan</hi>
                        
                    </signed>
                </closer>
            </div>
