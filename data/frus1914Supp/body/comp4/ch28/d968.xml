            <div xml:id="d968">

                <pb facs="0919" n="605" sameAs="frus:frus1914Supp/pg605"/>

                <note rend="inline" type="source">File No. 763.72111/113</note>
                <head>
                    <hi rendition="#italic">The German Ambassador</hi> (<hi rendition="#italic"
                        >Bernstorff</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <dateline>
                    <placeName>New York</placeName>, <date calendar="gregorian" when="1914-09-01">
                        <hi rendition="#italic">September 1, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received 8:10 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>British steamer <hi rendition="#italic">Merion</hi>, American Line, 13,000 tons
                    burden, arrived last night at Philadelphia armed with six cannons. Intends
                    staying several days. Takes freight for Liverpool.</p>
                <p>I beg to draw your attention to the above.</p>
                <closer>
                    <signed> J. Bernstorff </signed>
                </closer>
            </div>
        </body>
