                <pb facs="1026" n="712" sameAs="frus:frus1914Supp/pg712"/>

                <note rend="inline" type="source">File No. 763.72111W74/2</note>
                <head>
                    <hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic"
                        >Herrick</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <dateline>
                    <placeName>
                        <hi rendition="#italic">Paris</hi></placeName>, <date
                        ana="#date_undated-inferred-from-document-content" calendar="gregorian"
                        notAfter="1914-08-11T16:00:00-05:00" notBefore="1914-08-11T00:00:00+00:00"
                            ><hi rendition="#italic">undated</hi></date>. <lb/> [<hi
                        rendition="#italic">Received August 11, 1914, 4 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>French Government agrees respect neutrality Liberia.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Herrick</hi>
                    </signed>
                </closer>
            </div>
