    <text>
        <body>
            <div xml:id="d1022">

                <pb facs="0953" n="639" sameAs="frus:frus1914Supp/pg639"/>

                <note rend="inline" type="source">File No. 763.72111/824a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to all Seaport Consuls </hi>
                </head>
                <dateline>
                    <placeName>Department of State</placeName>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-11-25">
                        <hi rendition="#italic">November 25, 1914</hi>.</date>
                </dateline>
                <p rendition="#center">[Circular telegram]</p>
                <p>Department’s circular telegram November 22.<anchor n="2" xml:id="d1022-f1"/> When
                    there are several consignors or Consignees you need not report the names unless
                        <pb facs="0954" n="640" xml:id="pg640"/> there is a principal consignment
                    composing the main part of the cargo. This includes regular line steamers as
                    well as tramp steamers.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
