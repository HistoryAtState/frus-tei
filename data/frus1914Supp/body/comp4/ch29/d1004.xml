    <text>
        <body>
            <div xml:id="d1004">

                <pb facs="0941" n="627" xml:id="pg627"/>

                <note rend="inline" type="source">File No. 195.1/142</note>
                <head>
                    <hi rendition="#italic">The British Ambassador</hi> (<hi rendition="#italic"
                            >Spring Rice</hi>)
                        <hi rendition="#italic">to the Acting Secretary of
                            State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">British Embassy</hi>
                    <lb/> ,<placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-10-20">
                        <hi rendition="#italic">October 20, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received October 22</hi>.] </dateline>
                <p>
                    <hi rendition="#small-caps">Dear Mr</hi>. 
                        <hi rendition="#small-caps">Lansing</hi>: With reference to
                    previous communications on the subject I beg to transmit herewith for your
                    further information copy of a memorandum which I have received from His
                    Majesty’s Consul General at San Francisco, respecting the S. S. <hi
                            rendition="#italic">Alexandria</hi>
                     transferred to United States registry on October 8 under the name of
                        <hi rendition="#italic">Sacramento</hi>.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Cecil Spring Rice</hi>
                        
                    </signed>
                </closer>


                <xi:include href="d1004-a1.xml" xpointer="d1004-a1"/>
            </div>
        </body>
    </text>
