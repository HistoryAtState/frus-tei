        <body>
            <div xml:id="d1013">

                <pb facs="0948" n="634" xml:id="pg634"/>

                <note rend="inline" type="source">File No. 763.72111Sa1/1</note>
                <head>
                    <hi rendition="#italic">The Vice Consul at Valparaiso</hi> (<hi
                        rendition="#italic">Easterling</hi>) <hi rendition="#italic">to the
                        Secretary of State </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                    <placeName><hi rendition="#italic">Valparaiso</hi></placeName>, <date
                        calendar="gregorian" when="1914-11-21T11:00:00-05:00">
                        <hi rendition="#italic">November 21, 1914, 11 a.m.</hi>
                    </date>
                    <lb/> [<hi rendition="#italic">Received 3 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>
                    <hi rendition="#italic">Sacramento</hi> reports cargo taken by German war
                    vessels [and prisoners put aboard?] from French sailing vessel <hi
                        rendition="#italic">Valentine</hi> which was sunk by Germans.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Easterling</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
