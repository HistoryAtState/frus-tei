    <text>
        <body>
            <div xml:id="d945">

                <pb facs="0902" n="588" xml:id="pg588"/>

                <note rend="inline" type="source">File No. 763.72111G27/19</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the German, British, and
                        Japanese Ambassadors </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">Department of State</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-11-12">
                        <hi rendition="#italic">November 12, 1914</hi>.</date>
                </dateline>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: I have the honor to advise you of
                    the receipt of a letter from the Secretary of the Treasury, stating that a
                    telegram has been received from the collector of customs at Honolulu, reporting
                    that, on November 8, 1914, the German naval vessels <hi rendition="#italic"
                        >Geier</hi> and <hi rendition="#italic">Locksun</hi> were interned
                    there.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. J. Bryan</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
