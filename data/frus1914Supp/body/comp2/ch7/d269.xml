            <div xml:id="d269">

                <pb facs="0464" n="150" sameAs="frus:frus1914Supp/pg150"/>

                <note rend="inline" type="source">File No. 883.00/49</note>
                <head>
                    <hi rendition="#italic">The Consul General at Cairo</hi> (<hi rendition="#italic">Arnold</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Consulate General</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Cairo</hi></placeName>, <date calendar="gregorian"
                        when="1914-12-11T22:00:00+02:00">
                        <hi rendition="#italic">December 11, 1914, 10 p.m.</hi>
                    </date>
                    <lb/> [<hi rendition="#italic">Received December 12, 10 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>
                    Prince Hussein, uncle of Khedive,
                    rumored about to be proclaimed by British as Sultan of Egypt. If occurrence
                    transpires and if diplomatic agents invited to be present at the ceremony,
                    telegraph instructions in view of attitude of Turkey toward Egypt.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Arnold</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
