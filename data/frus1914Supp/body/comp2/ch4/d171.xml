        <body>
            <div xml:id="d171">

                <pb facs="0397" n="83" sameAs="frus:frus1914Supp/pg83"/>

                <note rend="inline" type="source">File No. 124.511/24</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in France</hi>
                        (<hi rendition="#italic">Herrick</hi>)</head>
                <dateline>
                    <hi rendition="#small-caps">Department of State</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-08-29T11:00:00-05:00">
                        <hi rendition="#italic">August 29, 1914, 11 a.m.</hi>
                    </date>
                </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>Your August 27, 12 midnight. In the event of the seat of government being moved,
                    the Department will be guided by your judgment as to whether the Embassy should
                    remain in Paris or follow the Government.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi>
                    </signed>
                </closer>
            </div>
        </body>
