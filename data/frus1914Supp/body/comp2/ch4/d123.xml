            <div xml:id="d123">

                <pb facs="0367" n="53" sameAs="frus:frus1914Supp/pg53"/>

                <note rend="inline" type="source">File No. 763.72/334</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Austria-Hungary</hi> (<hi rendition="#italic"
                        >Penfield</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Vienna</hi></placeName>, <date
                        ana="#date_undated-inferred-from-document-content" calendar="gregorian"
                        notAfter="1914-08-11T19:00:00-05:00" notBefore="1914-08-11T00:00:00+01:00"
                            ><hi rendition="#italic">undated</hi></date>. <lb/> [<hi
                        rendition="#italic">Received August 11, 1914, 7 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>Austro-Hungarian Government to-day gave French Ambassador passports.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Penfield</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
