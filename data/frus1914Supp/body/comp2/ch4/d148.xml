                <note rend="inline" type="source">File No. 124.551/10</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in Belgium</hi>
                        (<hi rendition="#italic">Whitlock</hi>)</head>
                <dateline>
                    <hi rendition="#small-caps">Department of State</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-08-19">
                        <hi rendition="#italic">August 19, 1914</hi>.</date>
                </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>Your August 17, 5 p.m. Department approves your course of action.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi>
                    </signed>
                </closer>
            </div>
