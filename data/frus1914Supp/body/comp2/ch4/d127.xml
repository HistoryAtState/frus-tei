    <text>
        <body>
            <div xml:id="d127">

                <pb facs="0370" n="56" xml:id="pg56"/>

                <note rend="inline" type="source">File No. 763.72/369</note>
                <head>
                    <hi rendition="#italic">The Chargé d’Affaires in Russia</hi> (<hi rendition="#italic"
                    >Wilson</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">St. Petersburg</hi></placeName>, <date
                        calendar="gregorian" when="1914-08-12T11:00:00+02:30">
                        <hi rendition="#italic">August 12, 1914, 11 a.m.</hi>
                    </date>
                    <lb/> [<hi rendition="#italic">Received August 13, 8:30 a.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>Department’s August 4, 7 p.m.<anchor n="1" xml:id="d127-f1"/> Emperor leaving for
                    Moscow requests President’s communication be presented in writing through
                    Minister for Foreign Affairs. Shall I comply?<anchor n="2" xml:id="d127-f2"/>
                </p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Wilson</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d127-f1" n="1" xml:id="d127-f1-content">
                <p>See footnote, <hi rendition="#italic">ante</hi>, <ref target="#pg42">p.
                    42</ref>.</p>
            </note>
            <note corresp="#d127-f2" n="2" xml:id="d127-f2-content">
                <p>Answer, “Yes,” telegraphed August 13, 8 p.m.</p>
            </note>
        </listAnnotation>
    </standOff>
