                <pb facs="0359" n="45" sameAs="frus:frus1914Supp/pg45"/>

                <note rend="inline" type="source">File No. 763.72111N39/9</note>
                <head>
                    <hi rendition="#italic">The Chargé d’Affaires in Denmark</hi> (<hi
                        rendition="#italic">Magruder</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Legation</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Copenhagen</hi></placeName>, <date
                        calendar="gregorian" when="1914-08-05T19:00:00+01:00">
                        <hi rendition="#italic">August 5, 1914, 7 p.m.</hi>
                    </date>
                    <lb/> [<hi rendition="#italic">Received 10 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>The neutrality of Denmark proclaimed August 4.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Magruder</hi>
                    </signed>
                </closer>
            </div>
