    <text>
        <body>
            <div xml:id="d96">

                <pb facs="0358" n="44" xml:id="pg44"/>

                <note rend="inline" type="source">File No. 768.72/114</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Page</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">London</hi></placeName>, <date calendar="gregorian"
                        when="1914-08-05">
                        <hi rendition="#italic">August 5, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received 12:40 a.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>271. I have received at this moment, 1:40 a.m., August 5, a note from the Foreign
                    Office dated August 4 informing me that a state of war exists between Great
                    Britain and Germany.</p>
                <closer>
                    <hi rendition="#small-caps">American Ambassador</hi>
                </closer>
            </div>
