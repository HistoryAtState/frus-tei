    <text>
        <body>
            <div xml:id="d107">

                <pb facs="0361" n="47" sameAs="frus:frus1914Supp/pg47"/>

                <note rend="inline" type="source">File No. 763.72/192</note>
                <head>
                    <hi rendition="#italic">The Russian Ambassador</hi> (<hi rendition="#italic">Bakhméteff</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">Russian Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Newport, Rhode Island</hi></placeName>, <date
                        ana="#date_undated-inferred-from-document-content" calendar="gregorian"
                        notAfter="1914-08-06T23:40:00-05:00" notBefore="1914-08-06T00:00:00-05:00"
                            ><hi rendition="#italic">undated</hi></date>. <lb/> [<hi
                        rendition="#italic">Received August 6, 1914, 11:40 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>I have the honor to inform your excellency that Austria-Hungary has declared war
                    on Russia.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Bakhméteff</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
