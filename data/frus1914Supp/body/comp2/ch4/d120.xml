                <pb facs="0366" n="52" sameAs="frus:frus1914Supp/pg52"/>

                <note rend="inline" type="source">File No. 763.72/310</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Austria-Hungary</hi> (<hi rendition="#italic"
                        >Penfield</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Vienna</hi></placeName>, <date calendar="gregorian"
                        when="1914-08-10T10:00:00+01:00">
                        <hi rendition="#italic">August 10, 1914, 10 a.m.</hi>
                    </date>
                    <lb/> [<hi rendition="#italic">Received 2:30 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>Austria-Hungary declared war against Montenegro 9th instant.</p>
                <closer>[File copy not signed].</closer>
            </div>
        </body>
