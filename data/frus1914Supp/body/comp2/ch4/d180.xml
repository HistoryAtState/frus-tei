    <text>
        <body>
            <div xml:id="d180">

                <pb facs="0402" n="88" sameAs="frus:frus1914Supp/pg88"/>

                <note rend="inline" type="source">File No. 763.72111/357</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Belgian Minister</hi> (<hi
                        rendition="#italic">Havenith</hi>)</head>
                <dateline>
                    <hi rendition="#small-caps">Department of State</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-09-04">
                        <hi rendition="#italic">September 4, 1914</hi>.</date>
                </dateline>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the
                    receipt of your note of August 20, 1914, in which by direction of your
                    Government you protest against the violation of Belgian neutrality by the German
                        Army.<anchor n="1" xml:id="d180-f1"/>
                </p>
                <p>Accept [etc.]</p>
                <p>For the Secretary of State:</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
