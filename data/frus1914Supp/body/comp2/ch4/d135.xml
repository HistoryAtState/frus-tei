            <div xml:id="d135">

                <pb facs="0375" n="61" sameAs="frus:frus1914Supp/pg61"/>

                <note rend="inline" type="source">File No. 763.72/442</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Turkey</hi> (<hi rendition="#italic"
                        >Morgenthau</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Constantinople</hi></placeName>, <date
                        calendar="gregorian" when="1914-08-13T15:00:00+02:00">
                        <hi rendition="#italic">August 13, 1914, 3 p.m.</hi>
                    </date>
                    <lb/> [<hi rendition="#italic">Received August 16, 3:35 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>General mobilization has been ordered. Moratorium established. Notwithstanding
                    this all banks continue making cash payments in amounts. Parliament adjourned
                    till November. French and Austrian guardships have departed.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Morgenthau</hi>
                    </signed>
                </closer>
            </div>
        </body>
