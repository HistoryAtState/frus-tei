    <text>
        <body>
            <div xml:id="d179">

                <pb facs="0401" n="87" sameAs="frus:frus1914Supp/pg87"/>

                <note rend="inline" type="source">File No. 763.72/788</note>
                <head>
                    <hi rendition="#italic">The German Ambassador</hi> (<hi rendition="#italic"
                        >Bernstorff</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">German Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-09-03">
                        <hi rendition="#italic">September 3, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received September 4</hi>.] </dateline>
                <p rendition="#flush">No. A 1108/14]</p>
                <p>
                    <hi rendition="#small-caps">Mr. Secretary of State</hi>: I have the honor to
                    inform your excellency that I am instructed by my Government to deny most
                    categorically the rumors circulated by English agencies to the effect that <pb
                        facs="0402" n="88" xml:id="pg88"/> Germany, in case she emerges victorious
                    from the present war, intends to seek expansion in South America.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">J. Bernstorff</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
