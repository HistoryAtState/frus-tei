    <text>
        <body>
            <div xml:id="d129">

                <pb facs="0370" n="56" sameAs="frus:frus1914Supp/pg56"/>

                <note rend="inline" type="source">File No. 763.72/380</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Page</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">London</hi></placeName>, <date calendar="gregorian"
                        when="1914-08-13">
                        <hi rendition="#italic">August 13, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received 5:10 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>350. The Foreign Office has just notified me formally that a state of war exists
                    between Great Britain and Austria.</p>
                <closer>
                    <hi rendition="#small-caps">American Ambassador</hi>
                </closer>
            </div>
        </body>
