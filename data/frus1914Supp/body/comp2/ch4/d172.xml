    <text>
        <body>
            <div xml:id="d172">

                <pb facs="0397" n="83" sameAs="frus:frus1914Supp/pg83"/>

                <note rend="inline" type="source">File No. 763.72/709</note>
                <head>
                    <hi rendition="#italic">The Belgian Minister</hi> (<hi rendition="#italic"
                        >Havenith</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">Belgian Legation</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-08-28">
                        <hi rendition="#italic">August 28, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received August 29</hi>.]</dateline>
                <p rendition="#center">[Translation]</p>
                <p>Mr. Secretary of State: I have the honor to inform your excellency that I have
                    just received a cablegram from my Government advising me that Austria-Hungary
                    had declared war on Belgium.</p>
                <p>Be pleased [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">E. Havenith</hi>
                    </signed>
                </closer>
            </div>
        </body>
