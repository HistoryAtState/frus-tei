    <text>
        <body>
            <div xml:id="d316">

                <pb facs="0490" n="176" xml:id="pg176"/>

                <note rend="inline" type="source">File No. 768.72/574</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Germany</hi> (<hi rendition="#italic"
                    >Gerard</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Berlin</hi></placeName>, <date calendar="gregorian"
                        when="1914-08-22T00:00:00+01:00">
                        <hi rendition="#italic">August 22, 1914, 12 midnight</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received August 23, 5:26 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>Austrian Embassy requests that following message be telegraphec:</p>
                <p>Berlin, August 22, 1914. To the Austro-Hungarian Ambassador in Tokyo. H. M. S.
                    Empress Elizabeth, harboring at Tsingtao, should disarm, crew to proceed to
                    Tientsin.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Berchtold</hi>
                        
                        <lb/>
                        
                            <hi rendition="#small-caps">Gerard</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
