    <text>
        <body>
            <div xml:id="d302">

                <pb facs="0482" n="168" sameAs="frus:frus1914Supp/pg168"/>

                <note rend="inline" type="source">File No. 763.72/363</note>
                <head>
                    <hi rendition="#italic">The Secretary of the Navy</hi> (<hi rendition="#italic"
                        >Daniels</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">Navy Department</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-08-12">
                        <hi rendition="#italic">August 12, 1914</hi>.</date>
                </dateline>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to forward herewith, for
                    the information of the Department of State, a copy of a cablegram received from
                    the naval attaché at the Embassy in Tokyo relative to mobilization of the
                    Japanese Fleet.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Josephus Daniels</hi>
                    </signed>
                </closer>
                <postscript>
                    <p rendition="#center">[Enclosure—Telegram]</p>
                    <p rendition="#center">
                        <hi rendition="#italic">The Naval Attaché in Japan</hi> (<hi
                            rendition="#italic">Cotten</hi>) <hi rendition="#italic">to the Navy
                            Department </hi>
                    </p>
                    <p rendition="#right">
                        <hi rendition="#small-caps">Tokyo</hi>, <hi rendition="#italic"
                        >undated</hi>. <lb/> [<hi rendition="#italic">Received August 12, 1914, 7:14
                            a.m.</hi>]</p>
                    <p>The Japanese Fleet mobilizing. There is a strong feeling against Germany. War
                        may be declared.</p>
                    <p rendition="#right">
                        <hi rendition="#small-caps">Cotten</hi>
                    </p>
                </postscript>
            </div>
        </body>
