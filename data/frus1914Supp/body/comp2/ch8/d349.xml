    <text>
        <body>
            <div xml:id="d349">

                <pb facs="0518" n="204" sameAs="frus:frus1914Supp/pg204"/>

                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Minister in China</hi> (<hi
                            rendition="#italic">Reinsch</hi>)</head>
                <dateline>
                    <hi rendition="#small-caps">Department of State</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-12-30T18:00:00-05:00">
                        <hi rendition="#italic">December 30, 1914, 6 p.m.</hi>
                    </date>
                </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>Your telegram of December 23, 2 p.m.</p>
                <p>Has China informed British Government of the demand?</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Bryan</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
