                <pb facs="0519" n="205" sameAs="frus:frus1914Supp/pg205"/>

                <note rend="inline" type="source">File No. 763.72/1363</note>
                <head>
                    <hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >Reinsch</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Legation</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Peking</hi></placeName>, <date calendar="gregorian"
                        when="1915-01-02T18:00:00+08:00">
                        <hi rendition="#italic">January 2, 1915, 6 p.m.</hi>
                    </date>
                    <lb/> [<hi rendition="#italic">Received 9 a.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>Your December 30, 6 p.m., British Legation was informed only unofficially and, I
                    understand, made informal representations to Japanese.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Reinsch</hi>
                    </signed>
                </closer>
            </div>
