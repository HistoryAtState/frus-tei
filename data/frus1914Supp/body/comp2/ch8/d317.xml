    <text>
        <body>
            <div xml:id="d317">

                <pb facs="0490" n="176" sameAs="frus:frus1914Supp/pg176"/>

                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Germany</hi> (<hi
                            rendition="#italic">Gerard</hi>)</head>
                <dateline>
                    <hi rendition="#small-caps">Department of State</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-08-24">
                        <hi rendition="#italic">August 24, 1914</hi>.</date>
                </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>Your August 22. Department prefers not to transmit message in regard to
                    disarmament of H. M. S. <hi rendition="#italic">Empress Elizabeth</hi>,
                    harboring at Tsingtao.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Bryan</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
