            <div xml:id="d340">

                <pb facs="0504" n="190" sameAs="frus:frus1914Supp/pg190"/>

                <note rend="inline" type="source">File No. 763.72/1176</note>
                <head>
                    <hi rendition="#italic">The Consul at Nagasaki</hi> (<hi rendition="#italic"
                        >Deichman</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Nagasaki</hi></placeName>, <date
                        calendar="gregorian" when="1914-11-07T15:00:00+09:00">
                        <hi rendition="#italic">November 7, 1914, 3 p.m.</hi>
                    </date>
                    <lb/> [<hi rendition="#italic">Received 8 a.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>Tsingtao fallen.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Deichman</hi>
                    </signed>
                </closer>
            </div>
        </body>
