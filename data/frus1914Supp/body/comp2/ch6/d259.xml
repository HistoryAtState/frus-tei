    <text>
        <body>
            <div xml:id="d259">

                <pb facs="0455" n="141" sameAs="frus:frus1914Supp/pg141"/>

                <note rend="inline" type="source">File No. 763.72/1277</note>
                <head>
                    <hi rendition="#italic">The Minister in Roumania, Servia, and Bulgaria</hi>
                        (<hi rendition="#italic"
                            >Vopicka</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi><anchor n="2" xml:id="d259-f1"/>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Legation</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Bucharest</hi></placeName>, <date
                        calendar="gregorian" when="1914-12-02T15:00:00+01:44">
                        <hi rendition="#italic">December 2, 1914, 3 p.m.</hi>
                    </date>
                    <lb/> [<hi rendition="#italic">Received December 3, 7:15 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>Servian Minister for Foreign Affairs telegraphs that he has been notified by the
                    Italian Minister in Servia that the Turkish Government <pb facs="0456" n="142"
                        xml:id="pg142"/> proclaimed holy war against Servia and her Allies. The
                    Royal Servian Government considers that all the treaties and conventions between
                    Servian Kingdom and the Turkish Government have ceased to exist.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Vopicka</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d259-f1" n="2" type="source" xml:id="d259-f1-content">
                <p>Repeated to the Ambassador in Turkey, December 4.</p>
            </note>
        </listAnnotation>
    </standOff>
