            <div xml:id="d27">

                <pb facs="0330" n="16" sameAs="frus:frus1914Supp/pg16"/>

                <note rend="inline" type="source">File No. 763.72/5</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Germany</hi> (<hi rendition="#italic"
                    >Gerard</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Berlin</hi></placeName>, <date calendar="gregorian"
                        when="1914-07-27T16:00:00+01:00">
                        <hi rendition="#italic">July 27, 1914, 4 p.m.</hi>
                    </date>
                    <lb/> [<hi rendition="#italic">Received 1:30 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>I have reason to believe matters will be arranged without general European
                    war.</p>
                <p>I have postponed my [departure?] until August 12.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Gerard</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
