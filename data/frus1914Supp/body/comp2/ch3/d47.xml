            <div xml:id="d47">

                <pb facs="0338" n="24" sameAs="frus:frus1914Supp/pg24"/>

                <note rend="inline" type="source">File No. 763.72/36</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Austria-Hungary</hi> (<hi rendition="#italic"
                        >Penfield</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Vienna</hi></placeName>, <date calendar="gregorian"
                        when="1914-07-31T18:00:00+01:00">
                        <hi rendition="#italic">July 31, 1914, 6 p.m.</hi>
                    </date>
                    <lb/> [<hi rendition="#italic">Received 5:17 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>Emperor this afternoon orders general mobilization all armed forces
                    Austria-Hungary including Landsturm. This is extremest military muster of realm.
                    Situation growing in seriousness.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Penfield</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
