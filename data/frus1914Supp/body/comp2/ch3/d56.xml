    <text>
        <body>
            <div xml:id="d56">

                <pb facs="0342" n="28" xml:id="pg28"/>

                <note rend="inline" type="source">File No. 763.72/51</note>
                <head>
                    <hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic"
                        >Herrick</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Paris</hi></placeName>, <date calendar="gregorian"
                        when="1914-08-01T17:00:00+00:00">
                        <hi rendition="#italic">August 1, 1914, 5 p.m.</hi>
                    </date>
                    <lb/> [<hi rendition="#italic">Received 6:45 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>General mobilization called this afternoon. Some changes effected in Cabinet.
                    Will send details later. Now see no hope of avoiding hostilities.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Herrick</hi>
                    </signed>
                </closer>
            </div>
        </body>
