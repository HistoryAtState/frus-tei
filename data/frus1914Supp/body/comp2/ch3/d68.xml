    <text>
        <body>
            <div xml:id="d68">

                <pb facs="0346" n="32" sameAs="frus:frus1914Supp/pg32"/>

                <note rend="inline" type="source">File No. 763.72/56</note>
                <head>
                    <hi rendition="#italic">The Russian Ambassador</hi> (<hi rendition="#italic"
                        >Bakhméteff</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">Russian Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Newport, Rhode Island</hi></placeName>, <date
                        calendar="gregorian" when="1914-08-02">
                        <hi rendition="#italic">August 2, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received 3 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>I have just been informed by my Government that Germany has declared war on
                    us.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bakhméteff</hi>
                    </signed>
                </closer>
            </div>
        </body>
