                <pb facs="0338" n="24" sameAs="frus:frus1914Supp/pg24"/>

                <note rend="inline" type="source">File No. 763.72/42a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassadors, Ministers, and Principal Consular
                            Officers in European Countries</hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">Department of State</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-07-31T17:00:00-05:00">
                        <hi rendition="#italic">July 31, 1914, 5 p.m.</hi>
                    </date>
                </dateline>
                <p rendition="#center">[Circular telegram]</p>
                <p>Telegraph Department daily as to military, political and financial situation
                    without waiting for official confirmation of reports. State basis of information
                    and opinion as to credibility.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Bryan</hi>
                        
                    </signed>
                </closer>
            </div>
