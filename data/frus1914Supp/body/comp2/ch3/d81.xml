                <pb facs="0351" n="37" sameAs="frus:frus1914Supp/pg37"/>

                <note rend="inline" type="source">File No. 763.72119/5</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Page</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">London</hi></placeName>, <date calendar="gregorian"
                        when="1914-08-03T18:00:00+00:00">
                        <hi rendition="#italic">August 3, 1914, 6 p.m.</hi>
                    </date>
                    <lb/> [<hi rendition="#italic">Received 8 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>258. Your August 1, 10 p.m.<anchor n="1" xml:id="d81-f1"/> My very definite
                    opinion is that there is not the slightest chance of any result if our good
                    offices be offered at any continental capital. This is confirmed by the judgment
                    of the British Foreign Office. We may have a chance after the war has reached a
                    breathing space.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Page</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
