            <div xml:id="d39">

                <pb facs="0334" n="20" sameAs="frus:frus1914Supp/pg20"/>

                <note rend="inline" type="source">File No. 763.72/24</note>
                <head>
                    <hi rendition="#italic">The Consul at Gibraltar</hi> (<hi rendition="#italic"
                        >Sprague</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Gibraltar</hi></placeName>, <date
                        ana="#date_undated-inferred-from-document-content" calendar="gregorian"
                        notAfter="1914-07-30T16:15:00-05:00" notBefore="1914-07-30T00:00:00+01:00"
                            ><hi rendition="#italic">undated</hi></date>. <lb/> [<hi
                        rendition="#italic">Received July 30, 1914, 4:15 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p> Garrison mobilized.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Sprague</hi>
                    </signed>
                </closer>
            </div>
        </body>
