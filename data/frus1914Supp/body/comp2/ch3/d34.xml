    <text>
        <body>
            <div xml:id="d34">

                <pb facs="0333" n="19" sameAs="frus:frus1914Supp/pg19"/>

                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Great
                        Britain</hi> (<hi rendition="#italic">Page</hi>)</head>
                <dateline>
                    <hi rendition="#small-caps">Department of State</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1914-07-28T23:44:00-05:00">
                        <hi rendition="#italic">July 28, 1914, 11:44 p.m.</hi>
                    </date>
                </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>Is there in your opinion any likelihood that the good offices of the United
                    States if offered under Article 3 of the Hague convention would be acceptable or
                    serve any high purpose in the present crisis?</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
