                <pb facs="0337" n="23" sameAs="frus:frus1914Supp/pg23"/>

                <note rend="inline" type="source">File No. 763.72/29</note>
                <head>
                    <hi rendition="#italic">The Consul General at Hamburg</hi> (<hi rendition="#italic"
                    >Morgan</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Consulate General</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Hamburg</hi></placeName>, <date calendar="gregorian"
                        when="1914-07-30">
                        <hi rendition="#italic">July 30, 1914</hi>.</date>
                    <lb/> [<hi rendition="#italic">Received July 31, 9:10 a.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>
                    <hi rendition="#italic">Imperator</hi> will not sail.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Morgan</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
