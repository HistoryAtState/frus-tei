            <div xml:id="d67">

                <pb facs="0346" n="32" xml:id="pg32"/>

                <note rend="inline" type="source">File No. 763.72/57</note>
                <head>
                    <hi rendition="#italic">The Minister in the Netherlands</hi> (<hi rendition="#italic">Van
                        Dyke</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Legation</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">The Hague</hi></placeName>, <date
                        calendar="gregorian" when="1914-08-02T16:00:00+00:19">
                        <hi rendition="#italic">August 2, 1914, 4 p.m.</hi>
                    </date>
                    <lb/> [<hi rendition="#italic">Received 2:49 p.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>Telegraphic reports that German army advanced through Grand Duchy of Luxemburg,
                    occupied government buildings on the way into France via Metz.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Van Dyke</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
