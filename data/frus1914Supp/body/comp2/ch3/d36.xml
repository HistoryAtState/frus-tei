    <text>
        <body>
            <div xml:id="d36">

                <pb facs="0333" n="19" sameAs="frus:frus1914Supp/pg19"/>

                <note rend="inline" type="source">File No. 763.72/13</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Page</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <dateline>
                    <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">London</hi></placeName>, <date calendar="gregorian"
                        when="1914-07-29T13:00:00+00:00">
                        <hi rendition="#italic">July 29, 1914, 1 p.m.</hi>
                    </date>
                    <lb/> [<hi rendition="#italic">Received 11:10 a.m.</hi>] </dateline>
                <p rendition="#center">[Telegram]</p>
                <p>250. Your undated telegram received this morning. I informally requested
                        Sir Edward Grey yesterday that if the
                    good offices of the <pb facs="0334" n="20" xml:id="pg20"/> United States could
                    at any time or in any possible way be used, please to inform me. He expressed
                    his thanks and said he would do so. I am renewing the same suggestion
                        to-day.<anchor n="1" xml:id="d36-f1"/>
                </p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Page</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d36-f1" n="1" xml:id="d36-f1-content">
                <p>See the Ambassador’s telegram of July 31, 5 p.m., <hi rendition="#italic"
                        >post</hi>, <ref target="#pg24">p. 24</ref>.</p>
            </note>
