                            </item>
                            <item>
                                <ref target="#pg406">Embargoes by Germany</ref>
                            </item>
                            <item>
                                <ref target="#pg418">Embargoes by the Allied states</ref>
                            </item>
                            <pb facs="0020" n="XVI" xml:id="pgXVI"/>
                            <item>
                                <ref target="#pg432">Projects of cooperation with other American
