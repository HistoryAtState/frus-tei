    <text>
        <body>
            <div xml:id="d790">

                <pb facs="0973" n="849" sameAs="frus:frus1921v01/pg849"/>

                <note rend="inline" type="source">839.00/2450</note>
                <head><hi rendition="#italic">The Minister in the Dominican Republic</hi> (<hi
                        rendition="#italic">Russell</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Santo Domingo</hi></placeName>, <date calendar="gregorian"
                            when="1921-11-05"><hi rendition="#italic">November 5,
                        1921</hi></date>.<lb/>[Received November 20.]</dateline>
                    <seg rendition="#float-left">No. 722</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to forward herewith for
                    the information of the Department a copy of the Quarterly Report of the Military
                    Governor of Santo Domingo for the period July 1, 1921 to September 30, 1921.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">William W.
                    Russell</hi></signed></closer>


                <xi:include href="d790-a1.xml" xpointer="d790-a1"/>
