                <pb facs="0967" n="843" sameAs="frus:frus1921v01/pg843"/>

                <note rend="inline" type="source">839.00/2459</note>
                <head><hi rendition="#italic">The Secretary of the Navy</hi> (<hi rendition="#italic">Denby</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1921-08-25"><hi rendition="#italic">August 25,
                        1921</hi></date>.</dateline>
                    <seg rendition="#float-left">P.D. 159–7</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: There is forwarded herewith for the
                    information of the Department of State a confidential report from the Military
                    Governor of Santo Domingo dated 3 August, 1921, on conditions in Santo
                    Domingo.</p>
                <p>Respectfully,</p>
                <closer><signed><hi rendition="#small-caps">Edwin Denby</hi></signed></closer>



                <xi:include href="d789-a1.xml" xpointer="d789-a1"/>
