    <text>
        <body>
            <div xml:id="d388">

                <pb facs="0544" n="420" sameAs="frus:frus1921v01/pg420"/>

                <note rend="inline" type="source">893.74/102: Telegram</note>
                <head><hi rendition="#italic">Messrs. J. P. Morgan &amp; Company to the Secretary of
                        State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >New York</hi></placeName>, <date calendar="gregorian"
                            when="1921-03-28"><hi rendition="#italic">March 28,
                        1921</hi></date>.<lb/>[Received March 28—2:41 p.m.]</dateline></opener>
                <p>Attention of Mr. MacMurray.<anchor n="28" xml:id="d388-f1"/> We can now confirm
                    that British, French and Japanese, as well as American, groups of Chinese
                    consortium are not interested in financing Federal Telegraph Company
                    contract.</p>
                <closer><hi rendition="#small-caps">J. P. Morgan &amp; Company</hi></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d388-f1" n="28" xml:id="d388-f1-content">
                <p>John Van A. MacMurray, Chief, Division of Far Eastern Affairs, Department of
                    State.</p>
            </note>
        </listAnnotation>
    </standOff>
