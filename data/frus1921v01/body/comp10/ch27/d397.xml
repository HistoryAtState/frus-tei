                <pb facs="0562" n="438" sameAs="frus:frus1921v01/pg438"/>

                <note rend="inline" type="source">893.74/128: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Japan</hi> (<hi
                            rendition="#italic">Bell</hi>) <hi rendition="#italic">to the
                            Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Tokyo</hi></placeName>, <date calendar="gregorian"
                            when="1921-05-09T16:00:00+09:00"><hi rendition="#italic">May 9, 1921—4
                                p.m.</hi></date><lb/>[Received May 9—12:49 p.m.]</dateline></opener>
                <p>161. Following from Peking received today: “184, May 6, 7 p.m. Japanese Legation
                    has made public substance of exchange of notes between Japanese and American
                    Governments regarding Federal wireless.”</p>
                <closer><signed><hi rendition="#small-caps">Bell</hi></signed></closer>
            </div>
        </body>
