    <text>
        <body>
            <div xml:id="d518-a1">

                <pb facs="0694" n="570" xml:id="pg570"/>

                <opener><seg rendition="#center">[Enclosure]</seg></opener>
                <head><hi rendition="#italic">Statement of Amounts Due the Chinese Eastern Railway
                        for the Transportation of the Troops of Various Nations and Amounts Already
                        Paid by the United States Government</hi></head>
                <opener><dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1921-02-18"><hi rendition="#italic">February 18,
                        1921</hi></date>.</dateline></opener>
                <p>1. Amounts owed now for transportation of troops of the following nations over
                    the Chinese Eastern Railway. <table cols="2" rend="width: 80%:"
                        rendition="#center" rows="8">
                        <row role="label">
                            <cell>Japan</cell>
                            <cell>Yen 1,600,000.  </cell>
                        </row>
                        <row>
                            <cell>France</cell>
                            <cell role="num">$425,546.99</cell>
                        </row>
                        <row>
                            <cell>Czecho-Slovakia</cell>
                            <cell role="num">3,416,011.53</cell>
                        </row>
                        <row>
                            <cell>Poland</cell>
                            <cell role="num">87,717.19</cell>
                        </row>
                        <row>
                            <cell>Serbia</cell>
                            <cell role="num">20,117.29</cell>
                        </row>
                        <row>
                            <cell>Roumania</cell>
                            <cell role="num">86,537.90</cell>
                        </row>
                        <row>
                            <cell>Latvia</cell>
                            <cell role="num">13,492.47</cell>
                        </row>
                        <row>
                            <cell>United States</cell>
                            <cell role="num">66,176.50</cell>
                        </row>
                    </table></p>
                <p><table cols="3" rows="5">
                        <row role="label">
                            <cell rendition="#top">2.</cell>
                            <cell>Total Amount Already Paid by the United States for transportation
                                of its troops over the Chinese Eastern Railway</cell>
                            <cell role="num">$567,858.68</cell>
                        </row>
                        <row>
                            <cell/>
                            <cell>Amount Still Owed</cell>
                            <cell rendition="#border-bottom" role="num">66,176.50</cell>
                        </row>
                        <row>
                            <cell/>
                            <cell>U.S Total Transportation bill</cell>
                            <cell role="num">$634,035.18</cell>
                        </row>
                        <row>
                            <cell rendition="#top">3.</cell>
                            <cell>Amount allotted by the United States to the Chinese Eastern and
                                Siberian Railways</cell>
                            <cell role="num">$5,000,000.00</cell>
                        </row>
                        <row>
                            <cell rendition="#top">4.</cell>
                            <cell>Amount Contributed to the Committee</cell>
                            <cell role="num">$4,124,056.93</cell>
                        </row>
                    </table></p>
            </div>
        </body>
