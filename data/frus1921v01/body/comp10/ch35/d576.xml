    <text>
        <body>
            <div xml:id="d576">

                <pb facs="0727" n="603" sameAs="frus:frus1921v01/pg603"/>

                <note rend="inline" type="source">861.77/2233</note>
                <head><hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Harvey</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1921-08-24"><hi rendition="#italic">August 24,
                        1921</hi></date>.<lb/>[Received September 11.]</dateline>
                    <seg rendition="#float-left">No. 400</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to the Department’s
                    telegraphic instruction No. 405, of July 15, 5 [<hi rendition="#italic">6</hi>]
                        p.m.,<anchor n="38" xml:id="d576-f1"/> on the subject of the reorganization
                    of the supervision of the Chinese Eastern Railway, I have the honor to transmit
                    herewith enclosed a copy of a Note, No. F. 2970/45/10, received from the Foreign
                    Office in answer to my representations of August 8th.<anchor n="39"
                        xml:id="d576-f2"/></p>
                <p>I have [etc.]</p>
                <closer>For the Ambassador:<lb/><signed><hi rendition="#small-caps">Post
                            Wheeler</hi></signed><lb/><hi rendition="#italic">Counselor of
                        Embassy</hi></closer>


                <xi:include href="d576-a1.xml" xpointer="d576-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d576-f1" n="38" xml:id="d576-f1-content">
                <p><hi rendition="#italic">Ante</hi>, <ref target="#pg594">p. 594</ref>.</p>
            </note>
            <note corresp="#d576-f2" n="39" xml:id="d576-f2-content">
                <p>Not found in Department files; see telegram no. 438, Aug. 2, to the Ambassador in
                    Great Britain, <ref target="#pg596">p. 596</ref>.</p>
            </note>
        </listAnnotation>
