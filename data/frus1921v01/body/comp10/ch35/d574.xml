    <text>
        <body>
            <div xml:id="d574">

                <pb facs="0726" n="602" xml:id="pg602"/>

                <note rend="inline" type="source">861.77/2206: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Consul at Harbin</hi> (<hi rendition="#italic"
                            >Jenkins</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1921-08-17T16:00:00-04:00"><hi rendition="#italic">August 17,
                                1921—4 p.m.</hi></date></dateline></opener>
                <p>For Stevens.</p>
                <p>Your August 6th [<hi rendition="#italic">16th</hi>] noon. Department approves
                    your attitude. Report immediately by telegraph any further attempts to bring
                    about change of gauge.</p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
