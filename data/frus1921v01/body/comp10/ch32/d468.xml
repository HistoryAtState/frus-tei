    <text>
        <body>
            <div xml:id="d468">

                <pb facs="0640" n="516" sameAs="frus:frus1921v01/pg516"/>

                <note rend="inline" type="source">893.102 Ic/22: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Chargé in China</hi> (<hi rendition="#italic"
                            >Ruddock</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1921-08-26T11:00:00-04:00"><hi rendition="#italic">August 26,
                                1921—11 a.m.</hi></date></dateline></opener>
                <p>238. Your 295 August 23, 10 p.m.</p>
                <p>Department approves arrangement with attached proviso but reserves right to
                    refuse to support any claim which it believes to be unjust. Mail instruction
                    follows relating specially to compensatory claim.<anchor n="6" xml:id="d468-f1"
                    /></p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d468-f1" n="6" xml:id="d468-f1-content">
                <p>No record in Department that mail instruction was sent.</p>
            </note>
        </listAnnotation>
    </standOff>
