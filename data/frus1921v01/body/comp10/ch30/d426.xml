            <div xml:id="d426">

                <pb facs="0616" n="492" sameAs="frus:frus1921v01/pg492"/>

                <note rend="inline" type="source">893.51/3234</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >Crane</hi>) <hi rendition="#italic">to the Acting Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1920-12-07"><hi rendition="#italic">December 7,
                        1920</hi></date>.<lb/>[Received February 3, 1921.]</dateline>
                    <seg rendition="#float-left">No. 594</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith, as
                    of interest to the Department, copies of Circular No. 239 of the Dean of the
                    Diplomatic Corps, regarding translation of a note, which the Dean has received
                    from the Wai Chiao Pu, proposing that the usual deduction of 13.7% from surplus
                    Customs Revenue for the eventual use of the South-Western Provinces should no
                    longer be made.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Charles R. Crane</hi></signed></closer>



                <xi:include href="d426-a1.xml" xpointer="d426-a1"/>
