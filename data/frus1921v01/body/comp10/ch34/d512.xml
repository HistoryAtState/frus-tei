                <pb facs="0687" n="563" sameAs="frus:frus1921v01/pg563"/>

                <note rend="inline" type="source">893.113/207: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Italy</hi> (<hi rendition="#italic"
                        >Child</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Rome</hi></placeName>, <date calendar="gregorian"
                            when="1921-12-17T14:00:00+01:00"><hi rendition="#italic">December 17,
                                1921—2 p.m.</hi></date><lb/>[Received December 17—1:35
                        p.m.]</dateline></opener>
                <p>261. British and French colleagues have been instructed to join in action
                    suggested my cable no. 258, December 13, 1 p.m. They and Japanese Chargé
                    d’Affaires await your instructions to me.</p>
                <closer><signed><hi rendition="#small-caps">Child</hi></signed></closer>
            </div>
        </body>
