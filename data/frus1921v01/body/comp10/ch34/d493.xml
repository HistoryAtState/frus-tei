    <text>
        <body>
            <div xml:id="d493">

                <pb facs="0665" n="541" sameAs="frus:frus1921v01/pg541"/>

                <note rend="inline" type="source">893.113/105</note>
                <head><hi rendition="#italic">The Ambassador in Italy</hi> (<hi rendition="#italic"
                        >Johnson</hi>) <hi rendition="#italic">to the Acting Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Rome</hi></placeName>, <date calendar="gregorian" when="1921-01-25"
                                ><hi rendition="#italic">January 25, 1921</hi></date>.<lb/>[Received
                        February 17.]</dateline>
                    <seg rendition="#float-left">No. 279</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In connection with my despatches Nos.
                        247<anchor n="41" xml:id="d493-f1"/> and 262<anchor n="42" xml:id="d493-f2"
                    /> of December 20, 1920, and January 5, 1921, respectively, I have the honor to
                    enclose herewith copy and translation of a <hi rendition="#italic">Note
                        Verbale</hi> (No. 4211/13) dated January 22, 1921, just received from the
                    Italian Foreign Office, relative to the sale in China of arms and munitions from
                    Italian sources.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Robert Underwood
                    Johnson</hi></signed></closer>



                <xi:include href="d493-a1.xml" xpointer="d493-a1"/>
            </div>
        </body>
    </text>
