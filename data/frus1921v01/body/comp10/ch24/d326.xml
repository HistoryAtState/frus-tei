    <text>
        <body>
            <div xml:id="d326">

                <pb facs="0494" n="370" xml:id="pg370"/>

                <note rend="inline" type="source">893.51/3550</note>
                <head><hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Harvey</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1921-10-19"><hi rendition="#italic">October 19,
                        1921</hi></date>.<lb/>[Received November 4.]</dateline>
                    <seg rendition="#float-left">No. 560</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith, for
                    the information of the Department and such action as may be deemed proper,
                    copies of a document received from the Foreign Office, under date of October 18,
                    1921, entitled “Project for an Extra-Consortium Loan to the Chinese
                    Government”.</p>
                <p>I have [etc.]</p>
                <closer>(For the Ambassador:)<lb/><signed><hi rendition="#small-caps">Post
                            Wheeler</hi></signed><lb/><hi rendition="#italic">Counselor of
                        Embassy</hi></closer>


                <xi:include href="d326-a1.xml" xpointer="d326-a1"/>
            </div>
