                <pb facs="0464" n="340" sameAs="frus:frus1921v01/pg340"/>

                <note rend="inline" type="source">893.00/3926: Telegram</note>
                <head><hi rendition="#italic">The Chargé in China</hi> (<hi
                            rendition="#italic">Ruddock</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1921-06-29T10:00:00+08:00"><hi rendition="#italic">June 29,
                                1921—10 a.m.</hi></date><lb/>[Received June 29—6:49
                    a.m.]</dateline></opener>
                <p>235. Following from Canton: <quote rend="blockquote">
                        <p>“June 27, noon. The Government reports capture of Wuchow, details are not
                            available. Kwangtung troops steadily gaining ground in the west,
                            elsewhere doubtful, Americans at Wuchow brought to Hongkong by the
                            British gunboat <hi rendition="#italic">Tarantula</hi>.”</p></quote></p>
                <closer><signed><hi rendition="#small-caps">Ruddock</hi></signed></closer>
            </div>
        </body>
