                <pb facs="0461" n="337" sameAs="frus:frus1921v01/pg337"/>

                <note rend="inline" type="source">893.00/3913</note>
                <head><hi rendition="#italic">The Personal Representative of Dr. Sun
                            Yat-sen</hi> (<hi rendition="#italic"
                            >Ma Soo</hi>) <hi rendition="#italic">to President Harding</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1921-06-16"><hi rendition="#italic">June 16,
                        1921</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Your Excellency</hi>: I have the honor to transmit to
                    Your Excellency the enclosed letter from Dr. Sun Yat-sen, which I received from
                    Canton this morning.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Ma Soo</hi></signed></closer>



                <xi:include href="d286-a1.xml" xpointer="d286-a1"/>
