            <div xml:id="d285">

                <pb facs="0459" n="335" sameAs="frus:frus1921v01/pg335"/>

                <note rend="inline" type="source">893.00/3866</note>
                <head><hi rendition="#italic">The Personal Representative of Dr. Sun Yat-sen</hi>
                        (<hi rendition="#italic">Ma Soo</hi>) <hi rendition="#italic">to the
                        Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1921-05-14"><hi rendition="#italic">May 14,
                        1921</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit to you the
                    accompanying cablegram in pursuance of instructions received by me from Dr. Wu
                    Ting-fang in Canton, reading: <quote rend="blockquote">
                        <p>“Ma Soo, Washington: Please communicate to the State Department the
                            following manifesto to the Foreign Powers issued by President Sun
                            Yat-sen on his assumption of office.—Wu Ting-fang.”</p></quote></p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Ma Soo</hi></signed></closer>



                <xi:include href="d285-a1.xml" xpointer="d285-a1"/>
            </div>
        </body>
    </text>
