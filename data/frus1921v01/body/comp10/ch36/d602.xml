    <text>
        <body>
            <div xml:id="d602">

                <pb facs="0748" n="624" sameAs="frus:frus1921v01/pg624"/>

                <note rend="inline" type="source">793.94/1207</note>
                <head><hi rendition="#italic">The Japanese Ambassador</hi> (<hi rendition="#italic">Shidehara</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1921-10-22"><hi rendition="#italic">October 22,
                        1921</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. Secretary</hi>: The Japanese Government have
                    just telegraphed to me the text of their communication, under date of October 19
                        [<hi rendition="#italic">15?</hi>], in reply to the Memorandum of the
                    Foreign Office at Peking of October 5,<anchor n="57" xml:id="d602-f1"/> on the
                    Shantung question. Knowing the friendly interest which you have taken in the
                    matter, I now beg to enclose herewith a copy of the new Japanese
                    communication.</p>
                <p>Believe me [etc.]</p>
                <closer><signed><hi rendition="#small-caps">K. Shidehara</hi></signed></closer>



                <xi:include href="d602-a1.xml" xpointer="d602-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d602-f1" n="57" xml:id="d602-f1-content">
                <p>See note from Chinese Minister, <hi rendition="#italic">supra.</hi></p>
            </note>
        </listAnnotation>
    </standOff>
