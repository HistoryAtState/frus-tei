                <pb facs="0648" n="524" sameAs="frus:frus1921v01/pg524"/>

                <note rend="inline" type="source">195.2/2701: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Vice Consul in Chargé at Canton</hi> (<hi
                            rendition="#italic">Price</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1921-05-31T17:00:00-04:00"><hi rendition="#italic">May 31, 1921—5
                                p.m.</hi></date></dateline></opener>
                <p>Your May 26, 3 p.m.</p>
                <p>Department perceives no objection to Chinese vessels chartered to American
                    Companies flying American flag at mast head. This procedure will not impose
                    additional duties upon American Government beyond protection interests American
                    charterers.</p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
