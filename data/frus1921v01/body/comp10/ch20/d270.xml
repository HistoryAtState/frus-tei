    <text>
        <body>
            <div xml:id="d270">

                <pb facs="0437" n="313" sameAs="frus:frus1921v01/pg313"/>

                <note rend="inline" type="source">893.00/3800: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">Crane</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1921-03-25T10:00:00+08:00"><hi rendition="#italic">March 25,
                                1921—10 a.m.</hi></date><lb/>[Received March 25—2:09
                        a.m.]</dateline></opener>
                <p>129. Monarchial agitation increasing daily, meeting being held Mukden of
                    adherents friends Chang Tso-lin<anchor n="1" xml:id="d270-f1"/> to discuss
                    matter.</p>
                <closer><signed><hi rendition="#small-caps">Crane</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d270-f1" n="1" xml:id="d270-f1-content">
