                <pb facs="0409" n="285" sameAs="frus:frus1921v01/pg285"/>

                <note rend="inline" type="source">824.00/120 supp.: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Ambassador in Brazil</hi> (<hi rendition="#italic"
                            >Morgan</hi>)</head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1921-02-04T13:00:00-05:00"><hi rendition="#italic">February 4,
                                1921—1 p.m.</hi></date></dateline></opener>
                <p>18. Department’s telegram dated January 31, 5 p.m.<anchor n="5" xml:id="d244-f1"
                    /> You are instructed to advise the Minister of Foreign Affairs that recognition
                    of the Government of Bolivia will be extended by this Government through the
                    American Minister at La Paz February 9. Please express the Department’s earnest
                    hope that the Government of Brazil will be disposed to recognize the Government
                    of Bolivia on the same day.</p>
                <closer><signed><hi rendition="#small-caps">Colby</hi></signed></closer>
            </div>
        </body>
    </text>
