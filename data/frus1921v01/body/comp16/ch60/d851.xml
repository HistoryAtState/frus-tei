    <text>
        <body>
            <div xml:id="d851">

                <pb facs="1040" n="916" sameAs="frus:frus1921v01/pg916"/>

                <note rend="inline" type="source">883.05/229: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Agent and Consul General at Cairo</hi> (<hi
                            rendition="#italic">Sprigg</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1921-10-18T20:00:00-05:00"><hi rendition="#italic">October 18,
                                1921—8 p.m.</hi></date></dateline></opener>
                <p>20. Your 31, October 12, 6 P.M.</p>
                <p>Position of this Government regarding extension of Mixed Court arrangement
                    contingent upon action of appropriate authorities on our nominations for
                    Appellate Court. British Embassy here so informed September 20.<anchor n="21"
                        xml:id="d851-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d851-f1" n="21" xml:id="d851-f1-content">
                <p>See note of Sept 20 to the British Ambassador, <ref target="#pg915">p.
                    915</ref>.</p>
            </note>
        </listAnnotation>
