                <pb facs="1022" n="898" sameAs="frus:frus1921v01/pg898"/>

                <note rend="inline" type="source">822.61334/47: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Minister in Ecuador</hi>
                        (<hi rendition="#italic">Hartman</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1921-10-07T19:00:00-05:00"><hi rendition="#italic">October 7,
                                1921—7 p.m.</hi></date></dateline></opener>
                <p>14. Mercantile Bank advises Department that it has cabled Lindberg new proposal
                    to be made to Ecuadorean Government relative to solution Cacao Growers’
                    Association difficulties. You will give all proper assistance for purpose of
                    arriving at a solution equitable to all concerned.</p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
