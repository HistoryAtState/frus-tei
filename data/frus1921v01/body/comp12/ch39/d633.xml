            <div xml:id="d633">

                <pb facs="0791" n="667" sameAs="frus:frus1921v01/pg667"/>

                <note rend="inline" type="source">818.51/190: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Costa Rica</hi> (<hi rendition="#italic"
                        >Thurston</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >San José</hi></placeName>, <date calendar="gregorian"
                            when="1921-11-26T10:00:00-06:00"><hi rendition="#italic">November 26,
                                1921—10 a.m.</hi></date><lb/>[Received 11:55
                    p.m.]</dateline></opener>
                <p>136. My 134 November 22, 10 a.m.<anchor n="23" xml:id="d633-f1"/> Congress last
                    evening by 25 to 13 votes approved committee report unfavorable to Royal Bank
                    loan.</p>
                <closer><signed><hi rendition="#small-caps">Thurston</hi></signed></closer>
            </div>
        </body>
    </text>
