                <pb facs="0791" n="667" sameAs="frus:frus1921v01/pg667"/>

                <note rend="inline" type="source">818.6363 Am 6/112: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Costa Rica</hi> (<hi rendition="#italic">Thurston</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >San José</hi></placeName>, <date calendar="gregorian"
                            when="1921-12-14T10:00:00-06:00"><hi rendition="#italic">December 14,
                                1921—10 a.m.</hi></date><lb/>[Received December 15—9:30
                        a.m.]</dateline></opener>
                <p>139. My 135.<anchor n="23" xml:id="d634-f1"/> Congress yesterday approved report
                    of Committee on Foreign Affairs permitting arbitration of Amory petroleum and
                    Royal Bank claims. Details by mail.<anchor n="23" xml:id="d634-f2"/></p>
                <closer><signed><hi rendition="#small-caps">Thurston</hi></signed></closer>
            </div>
        </body>
    </text>
