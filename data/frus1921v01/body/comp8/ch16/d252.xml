    <text>
        <body>
            <div xml:id="d252">

                <pb facs="0413" n="289" sameAs="frus:frus1921v01/pg289"/>

                <note rend="inline" type="source">711.428/644</note>
                <head><hi rendition="#italic">The Secretary of Commerce</hi> (<hi rendition="#italic">Hoover</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1921-07-11"><hi rendition="#italic">July 11,
                        1921</hi></date>.</dateline>
                    <seg rendition="#float-left">99082–N</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Replying to your letter of the 9th
                        instant,<anchor n="2" xml:id="d252-f1"/> enclosing copy of a note from the
                    British Embassy dated July 2d,<anchor n="2" xml:id="d252-f2"/> I have the honor
                    to enclose several copies of the Department’s instructions of July 6 <pb
                        facs="0414" n="290" xml:id="pg290"/> issued to Collectors of Customs
                    terminating on July 15 certain privileges in ports of the United States allowed
                    to fishing vessels of nations associated with the United States.</p>
                <p>Respectfully,</p>
                <closer>For the Secretary:<lb/><signed><hi rendition="#small-caps">C. H.
                        Huston</hi></signed><lb/><hi rendition="#italic">Assistant
                    Secretary</hi></closer>


                <xi:include href="d252-a1.xml" xpointer="d252-a1"/>
            </div>
        </body>
    </text>
