    <text>
        <body>
            <div xml:id="d228">

                <pb facs="0396" n="272" sameAs="frus:frus1921v01/pg272"/>

                <note rend="inline" type="source">711.63119/15</note>
                <head><hi rendition="#italic">The Commissioner at Vienna</hi> (<hi
                        rendition="#italic">Frazier</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Vienna</hi></placeName>, <date calendar="gregorian"
                            when="1921-09-06"><hi rendition="#italic">September 6,
                        1921</hi></date>.<lb/>[Received September 20.]</dateline>
                    <seg rendition="#float-left">No. 309</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to my despatch No. 306 of
                    to-day’s date, I have the honor to transmit herewith enclosed a corrected copy
                    of the treaty of peace between the United States and Austria dated August 24,
                    1921, signed by the Austrian Federal Chancellor and myself.<anchor n="8"
                        xml:id="d228-f1"/></p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Arthur Hugh
                    Frazier</hi></signed></closer>
            </div>
        </body>
    </text>
