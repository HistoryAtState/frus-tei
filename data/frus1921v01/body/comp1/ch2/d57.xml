                <pb facs="0164" n="40" sameAs="frus:frus1921v01/pg40"/>

                <note rend="inline" type="source">500.A4/144</note>
                <head><hi rendition="#italic">The Chargé in Sweden</hi> (<hi rendition="#italic"
                        >Crosby</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Stockholm</hi></placeName>, <date calendar="gregorian"
                            when="1921-07-22"><hi rendition="#italic">July 22,
                        1921</hi></date>.<lb/>[Received August 18.]</dateline>
                    <seg rendition="#float-left">No. 2145</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to advert to my telegram
                    No. 57. of July 21, 1921, 6 P.M.<anchor n="44" xml:id="d57-f1"/> relative to a
                    communication which was received by me from Mr. Kergentzeff, Representative in
                    Sweden of the Russian Soviet Republic; and to transmit herewith the note on
                    which my above mentioned telegram was based together with a copy of the letter
                    which accompanied it.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Sheldon Leavitt
                    Crosby</hi></signed></closer>




                <xi:include href="d57-a1.xml" xpointer="d57-a1"/>
                <xi:include href="d57-a2.xml" xpointer="d57-a2"/>
            </div>
