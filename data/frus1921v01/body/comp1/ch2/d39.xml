    <text>
        <body>
            <div xml:id="d39">

                <pb facs="0151" n="27" sameAs="frus:frus1921v01/pg27"/>

                <note rend="inline" type="source">500.A4/11: Telegram</note>
                <head><hi rendition="#italic">The Chargé in France</hi> (<hi rendition="#italic"
                        >Whitehouse</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1921-07-12T11:00:00+01:00"><hi rendition="#italic">July 12,
                                1921—11 a.m.</hi></date><lb/>[Received 12: 02
                    p.m.]</dateline></opener>
                <p>439a. My 438 [<hi rendition="#italic">439</hi>], July 11, noon.<anchor n="33"
                        xml:id="d39-f1"/> French Government will be very happy to receive an
                    invitation to proposed conference.</p>
                <closer><signed><hi rendition="#small-caps">Whitehouse</hi></signed></closer>
            </div>
        </body>
    </text>
