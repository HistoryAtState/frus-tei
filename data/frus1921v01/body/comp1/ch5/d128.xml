    <text>
        <body>
            <div xml:id="d128">

                <pb facs="0281" n="157" sameAs="frus:frus1921v01/pg157"/>

                <note rend="inline" type="source">813.00/1108: Telegram</note>
                <head><hi rendition="#italic">The Honduran Acting Minister of Foreign Affairs</hi>
                        (<hi rendition="#italic">Reina</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><seg rendition="#center">[Translation<anchor n="36" xml:id="d128-f1"
                        />]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Tegucigalpa</hi></placeName>, <date calendar="gregorian"
                            when="1921-09-12"><hi rendition="#italic">September 12,
                        1921</hi></date>.<lb/>[Received 10:40 a.m.]</dateline></opener>
                <p>The Ministry of Foreign Affairs of Honduras, by direction of the Provisional
                    Federal Council of the Republic of Central America, has the honor to inform Your
                    Excellency that the National Constituent Assembly signed the Political
                    Constitution of the new republic yesterday<anchor n="37" xml:id="d128-f2"/> in
                    accordance with the stipulations of the covenant of San José, Costa Rica.</p>
                <p>Very respectfully,</p>
                <closer><signed><hi rendition="#small-caps">A.R. Reina</hi>, Jr.</signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d128-f1" n="36" xml:id="d128-f1-content">
                <p>File translation revised.</p>
            </note>
            <note corresp="#d128-f2" n="37" xml:id="d128-f2-content">
                <p>The Constitution was signed Sept. 9.</p>
            </note>
        </listAnnotation>
