            <div xml:id="d184">

                <pb facs="0355" n="231" sameAs="frus:frus1921v01/pg231"/>

                <note rend="inline" type="source">714.1515/353</note>
                <head><hi rendition="#italic">The Chief of the Guatemalan Special Mission</hi> (<hi
                        rendition="#italic">Toledo Herrarte</hi>) <hi rendition="#italic">to the
                        Acting Secretary of State</hi></head>
                <opener><seg rendition="#center">[Translation]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1921-01-03"><hi rendition="#italic">January 3,
                        1921</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Mr. Secretary</hi>: I have the honor to inform your
                    Excellency that the Government of Guatemala has been pleased to bring to an end
                    the Special Mission with which I have been entrusted, for a settlement of the
                    boundary dispute with the Republic of Honduras.</p>
                <p>In expressing to your Excellency my profound gratitude for the kind and untiring
                    attentions that your Honorable Government has deigned to extend to me during my
                    Mission, I take [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Luis Toledo
                    Herrarte</hi></signed></closer>
            </div>
        </body>
    </text>
