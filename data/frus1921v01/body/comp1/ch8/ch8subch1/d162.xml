                <pb facs="0312" n="188" sameAs="frus:frus1921v01/pg188"/>

                <note rend="inline" type="source">718.1915/378</note>
                <head><hi rendition="#italic">The Secretary to President Harding</hi> (<hi
                        rendition="#italic">Christian</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1921-03-19"><hi rendition="#italic">March 19,
                        1921</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: By the direction of the
                    President, I am sending you the enclosed copy of a cablegram from President
                    Porras, of Panama, together with a copy of the President’s reply.</p>
                <p>Sincerely yours,</p>
                <closer><signed><hi rendition="#small-caps">Geo. B. Christian</hi>,
                    Jr.</signed></closer>




