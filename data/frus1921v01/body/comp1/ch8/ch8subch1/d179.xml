    <text>
        <body>
            <div xml:id="d179">

                <pb facs="0351" n="227" sameAs="frus:frus1921v01/pg227"/>

                <note rend="inline" type="source">718.1915/622</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Costa Rican Minister</hi> (<hi rendition="#italic"
                            >Beeche</hi>)<anchor n="23" xml:id="d179-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1921-11-18"><hi rendition="#italic">November 18,
                        1921</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Minister</hi>: I desire to inform you
                    that Professor O. M. Leland, Dean of the College of Engineering and Architecture
                    of <pb facs="0352" n="228" xml:id="pg228"/> the University of Minnesota, and
                    Professor John F. Hayford, Director of the College of Engineering of
                    Northwestern University, have been appointed by the Chief Justice of the United
                    States as Commissioners to delimit the boundary between Costa Rica and Panama,
                    in accordance with Article 7 of the Porras–Anderson Treaty of 1910.</p>
                <p>I am [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Charles E. Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d179-f1" n="23" type="source" xml:id="d179-f1-content">
                <p>The same, <hi rendition="#italic">mutatis mutandis</hi>, to the Panaman
                    Chargé.</p>
            </note>
        </listAnnotation>
    </standOff>
