    <text>
        <body>
            <div xml:id="d2">

                <pb facs="0125" n="1" sameAs="frus:frus1921v01/pg1"/>

                <note rend="inline" type="source">462.00 R 29/419a: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Ambassador in France</hi> (<hi
                            rendition="#italic">Wallace</hi>)</head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-12-15T18:00:00-05:00"><hi rendition="#italic">December 15,
                                1920—6 p.m.</hi></date></dateline></opener>
                <p>1704. B–170. For Boyden’s<anchor n="1" xml:id="d2-f1"/> personal information.
                    Department has practically decided upon full withdrawal of participation by
                    United States on Reparation Commission as well as on other commissions in
                    Europe. If you have opinions and suggestions for best carrying out such
                    decision, Department invites you to send them.</p>
                <closer><signed><hi rendition="#small-caps">Davis</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d2-f1" n="1" xml:id="d2-f1-content">
                <p>Roland W. Boyden, American unofficial representative on the Reparation
                    Commission.</p>
            </note>
        </listAnnotation>
    </standOff>
