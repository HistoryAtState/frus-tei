            <div xml:id="d1">

                <pb facs="0125" n="1" sameAs="frus:frus1921v01/pg1"/>

                <note rend="inline" type="source">763.72119/10799a: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        France</hi> (<hi rendition="#italic">Wallace</hi>)</head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-12-15T17:00:00-05:00"><hi rendition="#italic">December 15,
                                1920—5 p.m.</hi></date></dateline></opener>
                <p>1703. Discontinuance of participation in meetings of the Council of Ambassadors
                    has practically been decided upon. I should like to have your views as to the
                    best procedure if and when the decision is made effective.</p>
                <closer><signed><hi rendition="#small-caps">Davis</hi></signed></closer>
            </div>
        </body>
    </text>
