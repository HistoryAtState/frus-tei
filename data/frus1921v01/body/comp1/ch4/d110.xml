            <div xml:id="d110">

                <pb facs="0228" n="104" sameAs="frus:frus1921v01/pg104"/>

                <note rend="inline" type="source">890g.01/3</note>
                <head><hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic">Wallace</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1921-01-14"><hi rendition="#italic">January 14</hi>, [<hi
                                rendition="#italic">1921</hi>]</date>.<lb/>[Received January
                        26.]</dateline>
                    <seg rendition="#float-left">No. 2040</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to the penultimate paragraph of
                    my confidential despatch No. 2017 of January 7, 1921, I have the honor to
                    enclose herewith copies in English and French of the letter dated December 6,
                    1920, from Mr. Arthur J. Balfour to Sir Eric Drummond and of <pb facs="0229"
                        n="105" xml:id="pg105"/> the enclosures thereto, being the draft mandates
                    for Mesopotamia and Palestine as drawn up by the British Government for
                    consideration by the Council of the League of Nations.</p>
                <p>Copies of the aforementioned documents will be forwarded to the American Embassy
                    in London and the American Commission in Berlin.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Hugh C. Wallace</hi></signed></closer>




