            <div xml:id="d113">

                <pb facs="0261" n="137" sameAs="frus:frus1921v01/pg137"/>

                <note rend="inline" type="source">800.01 M 31/35</note>
                <head><hi rendition="#italic">The Chargé in Great Britain</hi> (<hi
                        rendition="#italic">Wright</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1921-04-01"><hi rendition="#italic">April 1,
                        1921</hi></date>.<lb/>[Received April 11.]</dateline>
                    <seg rendition="#float-left">No. 4426</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith, for
                    the information of the Department, copies, in triplicate, of an official White
                    Paper (Cmd. 1195) embodying the Franco-British Convention of December 23, 1920,
                    on Certain Points Connected with the Mandates for Syria and the Lebanon,
                    Palestine and Mesopotamia.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">J. Butler Wright</hi></signed></closer>


                <xi:include href="d113-a1.xml" xpointer="d113-a1"/>
            </div>
        </body>
    </text>
