            <div xml:id="d112">

                <pb facs="0245" n="121" xml:id="pg121"/>

                <note rend="inline" type="source">800.01 M 31/13</note>
                <head><hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic">Wallace</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1921-03-04"><hi rendition="#italic">March 4,
                        1921</hi></date>.<lb/>[Received March 16.]</dateline>
                    <seg rendition="#float-left">No. 2211</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith for
                    your confidential information copy of the League of Nations document No. 135
                    regarding “B” Mandates, …</p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Hugh C. Wallace</hi></signed></closer>


                <xi:include href="d112-a1.xml" xpointer="d112-a1"/>
            </div>
