    <text>
        <body>
            <div xml:id="d761">

                <pb facs="0939" n="815" sameAs="frus:frus1921v01/pg815"/>

                <note rend="inline" type="source">837.73/27: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Minister in
                        Cuba</hi> (<hi rendition="#italic">Long</hi>)</head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1921-01-07T15:00:00-05:00"><hi rendition="#italic">January 7,
                                1921—3 p.m.</hi></date></dateline></opener>
                <p>7. Your 360, December 24, 8 p.m.<anchor n="18" xml:id="d761-f1"/> Send by mail a
                    copy of the decree suspending the cable permit of the Western Union Telegraph
                    Company.</p>
                <closer><signed><hi rendition="#small-caps">Davis</hi></signed></closer>
            </div>
        </body>
    </text>
