    <text>
        <body>
            <div xml:id="d704-a1">

                <pb facs="0857" n="733" sameAs="frus:frus1921v01/pg733"/>

                <opener><seg rendition="#center">[Enclosure]</seg></opener>
                <head><hi rendition="#italic">Monthly Revenues of the Cuban, Treasury, May 1 to
                        September 22, 1921</hi></head>
                <table cols="4" rows="6">
                    <row>
                        <cell rendition="#border-bottom #border-top #border-right"/>
                        <cell rendition="#border-bottom #border-top #border-right">Custom
                            House</cell>
                        <cell rendition="#border-bottom #border-top #border-right">Internal</cell>
                        <cell rendition="#border-bottom #border-top">Total</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">May</cell>
                        <cell rendition="#border-right" role="num">$3,913,642.30</cell>
                        <cell rendition="#border-right" role="num">$2,506,434.92</cell>
                        <cell role="num">$6,420,077.22</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">June</cell>
                        <cell rendition="#border-right" role="num">3,312,536.52</cell>
                        <cell rendition="#border-right" role="num">1,977,169.32</cell>
                        <cell role="num">5,289,705.84</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">July</cell>
                        <cell rendition="#border-right" role="num">3,083,944.74</cell>
                        <cell rendition="#border-right" role="num">2,389,692.37</cell>
                        <cell role="num">5,473,637.11</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">August</cell>
                        <cell rendition="#border-right" role="num">2,881,661.59</cell>
                        <cell rendition="#border-right" role="num">2,833,481.55</cell>
                        <cell role="num">5,715,143.14</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right #border-bottom">September 1 to 22nd,
                            inclusive.</cell>
                        <cell rendition="#border-right #border-bottom #top" role="num"
                            >1,913,345.26</cell>
                        <cell rendition="#border-right #border-bottom #top" role="num"
                            >1,338,119.98</cell>
                        <cell rendition="#border-bottom #top" role="num">3,251,465.24</cell>
                    </row>
                </table>
                <p>Taken from official data at the Cuban Treasury Department.</p>
                <closer>
                    <dateline rendition="#float-left"><date calendar="gregorian" when="1921-09-24"
                            >September 24, 1921</date>.</dateline>
                    <lb/>
                    <signed><hi rendition="#small-caps">D. Castillo</hi>, Jr.</signed></closer>
            </div>
