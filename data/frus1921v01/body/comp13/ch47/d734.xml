    <text>
        <body>
            <div xml:id="d734">

                <pb facs="0913" n="789" sameAs="frus:frus1921v01/pg789"/>

                <note rend="inline" type="source">611.3731/91</note>
                <head><hi rendition="#italic">The Chargé in Cuba</hi> (<hi
                            rendition="#italic">Cable</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Habana</hi></placeName>, <date calendar="gregorian"
                            when="1921-06-27"><hi rendition="#italic">June</hi> [<hi
                                rendition="#italic">July ?</hi>] <hi rendition="#italic">27,
                                1921</hi></date>.<lb/>[Received August 5.]</dateline>
                    <seg rendition="#float-left">No. 1007</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith for
                    the information of the Department clippings from the Havana <hi
                        rendition="#italic">Post</hi> of July 25, 1921, giving the English version
                    of President Zayas’ message to the Extraordinary <pb facs="0914" n="790"
                        xml:id="pg790"/> Session of Congress relative to Reciprocity Treaty of
                    December 1902, and its application in view of the Fordney Tariff Bill.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Philander L.
                    Cable</hi></signed></closer>


                <xi:include href="d734-a1.xml" xpointer="d734-a1"/>
            </div>
        </body>
    </text>
