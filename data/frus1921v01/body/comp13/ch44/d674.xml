    <text>
        <body>
            <div xml:id="d674">

                <pb facs="0820" n="696" sameAs="frus:frus1921v01/pg696"/>

                <note rend="inline" type="source">837.00/2137</note>
                <head><hi rendition="#italic">The Representative on Special Mission in Cuba</hi>
                        (<hi rendition="#italic">Crowder</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Habana</hi></placeName>, <date calendar="gregorian"
                            when="1921-06-20"><hi rendition="#italic">June 20,
                        1921</hi></date>.<lb/>[Received June 29.]</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. Secretary</hi>: I have the honor to transmit
                    herewith copy of the paraphrase of your No. 121 in the form in which I submitted
                    it to President Zayas.<anchor n="28" xml:id="d674-f1"/></p>
                <p>There are to be noted only such verbal changes as would protect the cipher in
                    which the telegram was translated [<hi rendition="#italic"
                    >transmitted?</hi>]</p>
                <p>Very respectfully,</p>
                <closer><signed><hi rendition="#small-caps">E. H. Crowder</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d674-f1" n="28" xml:id="d674-f1-content">
                <p>No. 121, <hi rendition="#italic">supra</hi>; paraphrase not printed.</p>
