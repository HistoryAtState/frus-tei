    <text>
        <body>
            <div xml:id="d755">

                <pb facs="0932" n="808" sameAs="frus:frus1921v01/pg808"/>

                <note rend="inline" type="source">637.61351/311</note>
                <head><hi rendition="#italic">The Secretary of State to the Cuban Minister</hi> (<hi
                        rendition="#italic">Céspedes</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1922-02-06"><hi rendition="#italic">February 6,
                        1922</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to refer to my note of
                    November 30, 1921, and previous correspondence relative to the possible sale to
                    Germany of Cuban raw sugar to be refined in Germany and delivered to France on
                    reparation account, and to transmit herewith for your information a copy of the
                    translation of a note addressed to the American Ambassador at Paris by the
                    French Ministry of Foreign Affairs, in this connection.<anchor n="3"
                        xml:id="d755-f1"/></p>
                <p>Accept [etc.]</p>
                <closer>For the Secretary of State:<lb/><signed><hi rendition="#small-caps">Henry P.
                            Fletcher</hi></signed></closer>
            </div>
        </body>
    </text>
