    <text>
        <body>
            <div xml:id="d194">

                <pb facs="0426" n="416" sameAs="frus:frus1864p1/pg416"/>

                <opener><seg rendition="#center">[In replying, quote the following initial letter
                        M.]</seg></opener>
                <head>The Admiralty to Laird Brothers.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Admiralty,</hi></placeName>
                        <date calendar="gregorian" when="1863-12-12"><hi rendition="#italic"
                                >December</hi> 12, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Gentlemen:</hi> I have received and laid before my
                    lords commissioners of the admiralty your letter of the 7th instant, calling
                    attention to the present condition of the two steam vessels, El Tousson and El
                    Monnassir, and as to the preservation of the property on board from injury,
                    &amp;c.</p>
                <p>I am, gentlemen, your most obedient servant,</p>
                <closer>
                    <signed>C. PAGET.</signed></closer>
                <postscript>
                    <p>Messrs. <hi rendition="#small-caps">Laird</hi> &amp; Co., <hi
                            rendition="#italic">Birkenhead.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
