    <text>
        <body>
            <div xml:id="d220">

                <pb facs="0436" n="426" sameAs="frus:frus1864p1/pg426"/>

                <head>Laird Brothers to Captain
                        Inglefield, H. M. S. Majestic.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Birkenhead Iron Works,</hi>
                            <hi rendition="#italic">Birkenhead,</hi></placeName>
                        <date calendar="gregorian" when="1863-10-24"><hi rendition="#italic"
                                >October</hi> 24, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Owing to the dense fog, we were unable to
                    open our dock this morning, but intend to do so on Monday morning.</p>
                <p>Be so good as to acknowledge receipt of this intimation.</p>
                <p>We are, sir, your obedient servants,</p>
                <closer>
                    <signed>LAIRD BROTHERS.</signed></closer>
                <postscript>
                    <p>Captain <hi rendition="#small-caps">Inglefield,</hi> R. N., <hi
                            rendition="#italic">H. M. S. Majestic.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
