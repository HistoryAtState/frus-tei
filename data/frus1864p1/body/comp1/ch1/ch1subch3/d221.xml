    <text>
        <body>
            <div xml:id="d221">

                <pb facs="0436" n="426" sameAs="frus:frus1864p1/pg426"/>

                <head>Captain Inglefield, H. M. S. Majestic, to
                        Laird Brothers.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Her Majesty’s Steamer Majestic,</hi>
                            <hi rendition="#italic">Rock Ferry,</hi></placeName>
                        <date calendar="gregorian" when="1863-10-26"><hi rendition="#italic"
                                >October,</hi> 26, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Gentlemen:</hi> I have to acknowledge your letter of
                    the 24th instant, acquainting me that you propose to open your graving dock
                    to-morrow morning.</p>
                <p>I am, gentlemen, your obedient servant,</p>
                <closer>
                    <signed>E. A. INGLEFIELD, <hi rendition="#italic"
                    >Captain.</hi></signed></closer>
            </div>
        </body>
    </text>
