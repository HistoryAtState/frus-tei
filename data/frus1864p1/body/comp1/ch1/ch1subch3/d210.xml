    <text>
        <body>
            <div xml:id="d210">

                <pb facs="0432" n="422" sameAs="frus:frus1864p1/pg422"/>

                <head>Assistant collector of her Majesty’s customs,
                        Liverpool, to Laird
                    Brothers.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Custom-House,
                            Liverpool,</hi></placeName>
                        <date calendar="gregorian" when="1863-10-08"><hi rendition="#italic"
                                >October</hi> 8, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Gentlemen:</hi> I beg to acknowledge the receipt of
                    your letter of this day’s date, stating that you had given to Mr. Morgan,
                    surveyor, an order of admission to the iron-clad El Tousson, and beg to thank
                    you for the facility afforded by you to the officers of customs at all
                    times.</p>
                <p>I am, gentlemen, your obedient servant,</p>
                <closer>
                    <signed>W. G. STEWART, <hi rendition="#italic">Assistant
                        Collector.</hi></signed></closer>
                <postscript>
                    <p>Messrs. <hi rendition="#small-caps">Laird Brothers.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
