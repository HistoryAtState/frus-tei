    <text>
        <body>
            <div xml:id="d196">

                <pb facs="0427" n="417" xml:id="pg417"/>

                <head>Laird Brothers to her
                        Majesty’s Treasury.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Birkenhead Iron Works,</hi>
                            <hi rendition="#italic">Birkenhead,</hi></placeName>
                        <date calendar="gregorian" when="1863-12-21"><hi rendition="#italic"
                                >December</hi> 21, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> We beg to acknowlege the receipt of your
                    letter of the 18th instant, and hope to send a reply to-morrow.</p>
                <p>We are, sir, your obedient servants,</p>
                <closer>
                    <signed>LAIRD BROTHERS.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">G. A. Hamilton,</hi> Esq.</p>
                </postscript>
            </div>
        </body>
    </text>
