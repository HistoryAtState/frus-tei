    <text>
        <body>
            <div xml:id="d179">

                <pb facs="0420" n="410" sameAs="frus:frus1864p1/pg410"/>

                <head>S. Price Edwards, esq., collector of customs,
                        Liverpool, to Laird
                    Brothers.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Custom-House,
                            Liverpool,</hi></placeName>
                        <date calendar="gregorian" when="1864-10-27"><hi rendition="#italic"
                                >October</hi> 27, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Gentlemen:</hi> I hereby beg to inform you that your
                    two cupola vessels are now detained, under the 223d section of “the customs
                    consolidated act,” the ground of detention being a violation of “the foreign
                    enlistment act.” And I take leave further to state that the officers in charge
                    have received directions to remove your workman at once from on board the
                    ships.</p>
                <p>I am, gentlemen, your obedient servant,</p>
                <closer>
                    <signed>S. PRICE EDWARDS, <hi rendition="#italic"
                    >Collector.</hi></signed></closer>
                <postscript>
                    <p>Messrs. <hi rendition="#small-caps">Laird Brothers,</hi>
                        <hi rendition="#italic">Birkenhead.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
