    <text>
        <body>
            <div xml:id="d188">

                <pb facs="0424" n="414" xml:id="pg414"/>

                <head>Her Majesty’s Foreign Office to Laird Brothers.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Foreign Office,</hi></placeName>
                        <date calendar="gregorian" when="1863-11-02"><hi rendition="#italic"
                                >November</hi> 2, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Gentlemen:</hi> I am directed by Earl Russell to
                    acknowledge the receipt of your telegraphic message of the 31st ultimo, renewing
                    your protest against the removal from the docks of the two iron-clad vessels now
                    under seizure by the crown; and I am to state to you that the matter has been
                    referred to the lords commissioners of her Majesty’s treasury.</p>
                <p>I am, gentlemen, your obedient servant,</p>
                <closer>
                    <signed>E. HAMMOND.</signed></closer>
                <postscript>
                    <p>Messrs. <hi rendition="#small-caps">Laird,</hi>
                        <hi rendition="#italic">Birkenhead.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
