    <text>
        <body>
            <div xml:id="d212">

                <pb facs="0433" n="423" xml:id="pg423"/>

                <head>E. Morgan, surveyor, her Majesty’s customs, Liverpool, to Laird
                    Brothers.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Customs, Liverpool,</hi></placeName>
                        <date calendar="gregorian" when="1863-10-09"><hi rendition="#italic"
                                >October</hi> 9, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Gentlemen:</hi> I hereby beg to give you notice that
                    I have this day seized the iron-plated cupola vessel now lying in the dock
                    attached to your premises, by order of the commissioners of customs.</p>
                <p>Respectfully,</p>
                <closer>
                    <signed>E. MORGAN, <hi rendition="#italic">Surveyor.</hi></signed></closer>
                <postscript>
                    <p>Messrs. <hi rendition="#small-caps">Laird.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
