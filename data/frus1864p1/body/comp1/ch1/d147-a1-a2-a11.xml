    <text>
        <body>
            <div xml:id="d147-a1-a2-a11">

                <pb facs="0369" n="359" sameAs="frus:frus1864p1/pg359"/>

                <opener><seg rendition="#center">[Enclosure 11 in No. 2.]</seg></opener>
                <head>Mr. Rawson to Mr. Graham.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Colonial Office,</hi></placeName>
                        <date calendar="gregorian" when="1863-08-06"><hi rendition="#italic"
                                >August</hi> 6, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I am directed by the governor to
                    acknowledge the receipt of your letter of yesterday’s date respecting the
                    capture of the Sea Bride by the Alabama, and to acquaint you that he will lose
                    no time in obtaining accurate information as to the circumstances of the
                    capture.</p>
                <p>I have &amp;c.,</p>
                <closer>
                    <signed>RAWSON W. RAWSON, <hi rendition="#italic">Colonial
                        Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
