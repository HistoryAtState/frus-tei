    <text>
        <body>
            <div xml:id="d279-a7">

                <pb facs="0518" n="508" sameAs="frus:frus1864p1/pg508"/>

                <opener><seg rendition="#center">[Enclosure 7 in No. 16.]</seg></opener>
                <head>Lord Lyons to Viscount
                        Monck.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-01-13"><hi rendition="#italic"
                                >January</hi> 13, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Lord:</hi> I have the honor to transmit to your
                    excellency a copy of a note which I have just received from the Secretary of
                    State of the United States, demanding the extradition, under the treaty, of
                    certain persons therein named. I have, &amp;c.,</p>
                <closer>
                    <signed>LYONS.</signed></closer>
            </div>
        </body>
    </text>
