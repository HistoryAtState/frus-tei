    <text>
        <body>
            <div xml:id="d276">

                <pb facs="0513" n="503" sameAs="frus:frus1864p1/pg503"/>

                <opener><seg rendition="#center">No. 13.</seg></opener>
                <head>Major General Doyle to the Duke of Newcastle.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Government House, Halifax,</hi>
                            <hi rendition="#italic">Nova Scotia,</hi></placeName>
                        <date calendar="gregorian" when="1864-01-06"><hi rendition="#italic"
                                >January</hi> 6, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Lord Duke:</hi> With a view to keep your grace
                    thoroughly acquainted with all the particulars concerning the affair of the
                    Chesapeake, and in connexion with my despatch dated this day, I have the honor
                    to transmit, for your information, the copy of a despatch which I have this day
                    addressed to Lord Lyons on the subjects treated upon in the despatch to your
                    grace which I have referred to above.</p>
                <p>I have, &amp;c.,</p>
                <closer>
                    <signed>HASTINGS DOYLE.</signed></closer>



                <xi:include href="d276-a1.xml" xpointer="d276-a1"/>
            </div>
        </body>
    </text>
