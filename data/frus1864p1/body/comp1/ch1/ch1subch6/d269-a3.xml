    <text>
        <body>
            <div xml:id="d269-a3">

                <pb facs="0498" n="488" xml:id="pg488"/>

                <opener><seg rendition="#center">[Enclosure 3 in No. 6.]</seg></opener>
                <head>Mr. Tupper to Mr. Gunnison.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Provincial Secretary’s Office,</hi>
                            <hi rendition="#italic">Halifax,</hi></placeName>
                        <date calendar="gregorian" when="1863-12-24"><hi rendition="#italic"
                                >December</hi> 24, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have it in command from his honor the
                    administrator of the government to say, in reply to your communication of
                    yesterday, that proper precautions have been taken to insure the safety of the
                    Chesapeake.</p>
                <p>I have, &amp;c.,</p>
                <closer>
                    <signed>CHARLES TUPPER, <hi rendition="#italic">Provincial
                        Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
