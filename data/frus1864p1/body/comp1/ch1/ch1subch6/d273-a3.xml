    <text>
        <body>
            <div xml:id="d273-a3">

                <pb facs="0504" n="494" sameAs="frus:frus1864p1/pg494"/>

                <opener><seg rendition="#center">[Enclosure 3 in No. 10.]</seg></opener>
                <head>Lord Lyons to Lieutenant Governor Gordon.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-01-04"><hi rendition="#italic"
                                >January</hi> 4, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge the receipt
                    of your excellency’s despatch of the 28th ultimo, and to transmit to you a copy
                    of a note in which I have informed the Secretary of State of the United States
                    that you have issued a warrant for the arrest of the persons implicated in the
                    affair of the Chesapeake, whose extradition has been demanded by this
                    government.</p>
                <p>I have, &amp;c.,</p>
                <closer>
                    <signed>LYONS.</signed></closer>
            </div>
        </body>
    </text>
