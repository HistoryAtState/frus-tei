                <pb facs="0480" n="470" sameAs="frus:frus1864p1/pg470"/>

                <head>Mr. Seward to Mr Gunnison.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1863-12-09"><hi rendition="#italic"
                                >December</hi> 9, 1863—1.30 <hi rendition="#italic"
                        >p.m.</hi></date></dateline></opener>
                <p>Is the steamer Chesapeake, or has she been, in your port? Please answer.</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
            </div>
        </body>
