    <text>
        <body>
            <div xml:id="d268-a27">

                <pb facs="0494" n="484" sameAs="frus:frus1864p1/pg484"/>

                <opener><seg rendition="#center">[Enclosure 30 in No. 5.]</seg></opener>
                <head>The Mayor of Halifax to Mr. Hickman.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Mayor’s Office,
                            Halifax,</hi></placeName>
                        <date calendar="gregorian" when="1863-12-21"><hi rendition="#italic"
                                >December</hi> 21, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to enclose herewith a copy
                    of the city marshal’s report, to which I referred in my last letter of
                    yesterday’s date, for the information of his honor the administrator of the
                    government.</p>
                <p>I have, &amp;c.,</p>
                <closer>
                    <signed>P. CARTERET HILL.</signed></closer>
            </div>
        </body>
    </text>
