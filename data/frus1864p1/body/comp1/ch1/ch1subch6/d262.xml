    <text>
        <body>
            <div xml:id="d262">

                <pb facs="0481" n="471" sameAs="frus:frus1864p1/pg471"/>

                <head>A. L. to Mr. Chun.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Yarmouth,</hi></placeName>
                        <date calendar="gregorian" when="1863-12-10"><hi rendition="#italic"
                                >December</hi> 10, 1863.</date></dateline></opener>
                <p>A steamer said to be of similar appearance to Chesapeake passed this harbor about
                    noon yesterday, steering down the bay.</p>
                <closer>
                    <signed>A. L.</signed></closer>
            </div>
