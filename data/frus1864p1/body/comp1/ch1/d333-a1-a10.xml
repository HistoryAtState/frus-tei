    <text>
        <body>
            <div xml:id="d333-a1-a10">

                <pb facs="0660" n="650" xml:id="pg650"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Confederate States Steamer
                                Rappahannock</hi>, <hi rendition="#italic">Calais</hi>,</placeName>
                        <date calendar="gregorian" when="1864-02-07"><hi rendition="#italic"
                                >February</hi> 7, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> You are hereby appointed 3d assistant
                    engineer in the Confederate States navy, from the 7th day of February, 1864.</p>
                <p>Respectfully,</p>
                <closer>
                    <signed>WILLIAM V. A. CAMPBELL, <hi rendition="#italic">Lieutenant Commanding,
                            Confederate States Navy.</hi></signed></closer>
                <postscript>
                    <p>Mr. <hi rendition="#small-caps">Joseph Buchanan.</hi></p>
                </postscript>
            </div>
        </body>
