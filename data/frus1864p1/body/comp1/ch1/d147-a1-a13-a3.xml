    <text>
        <body>
            <div xml:id="d147-a1-a13-a3">

                <pb facs="0399" n="389" xml:id="pg389"/>

                <opener><seg rendition="#center">[Enclosure 3 in No. 11.]</seg></opener>
                <head>Sir P. Wodehouse to Rear-Admiral Sir B. Walker.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Government House,</hi></placeName>
                        <date calendar="gregorian" when="1864-01-09"><hi rendition="#italic"
                                >January</hi> 9, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> With reference to your excellency’s letter
                    of the 6th instant, I have the honor to enclose the copy of a letter from the
                    consul of the United States relative to an inspection of the Tuscaloosa.</p>
                <p>I have, &amp;c.,</p>
                <closer>
                    <signed>P. E. WODEHOUSE.</signed></closer>
            </div>
        </body>
    </text>
