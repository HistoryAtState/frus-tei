    <text>
        <body>
            <div xml:id="d51">

                <pb facs="0124" n="114" sameAs="frus:frus1864p1/pg114"/>

                <head>Mr. Adams to Mr. Seward.</head>
                <opener>
                    <seg rendition="#float-left">No. 581.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United
                                States,</hi><hi rendition="#italic"> London,</hi></placeName>
                        <date calendar="gregorian" when="1864-01-22"><hi rendition="#italic"
                                >January</hi> 22, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to transmit a copy of my
                    note to Lord Russell, of the 20th instant based upon your despatch, No. 792, of
                    the 28th December last, and claiming indemnity for the capture of the bark Sea
                    Bride and her cargo.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>CHARLES FRANCIS ADAMS.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>
                        <hi rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>


                <xi:include href="d51-a1.xml" xpointer="d51-a1"/>
            </div>
