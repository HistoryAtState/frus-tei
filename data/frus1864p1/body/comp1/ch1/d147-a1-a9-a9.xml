    <text>
        <body>
            <div xml:id="d147-a1-a9-a9">

                <pb facs="0391" n="381" sameAs="frus:frus1864p1/pg381"/>

                <opener><seg rendition="#center">[Enclosure 9 in No. 9.]</seg></opener>
                <head>Sir P. Wodehouse to Rear-Admiral Sir B. Walker.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Government House,</hi></placeName>
                        <date calendar="gregorian" when="1863-12-30"><hi rendition="#italic"
                                >December</hi> 30, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge the receipt
                    of your excellency’s letter of yesterday’s date and its enclosures, and beg to
                    forward a copy of the reply given to the protest of the commander of the
                    Tuscaloosa.</p>
                <p>I have, &amp;c.,</p>
                <closer>
                    <signed>P. E. WODEHOUSE.</signed></closer>
            </div>
        </body>
    </text>
