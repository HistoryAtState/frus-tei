    <text>
        <body>
            <div xml:id="d351">

                <pb facs="0745" n="735" sameAs="frus:frus1864p1/pg735"/>

                <head>Mr. Adams to Mr. Seward.</head>
                <opener>
                    <seg rendition="#float-left">No. 688.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">London,</hi></placeName>
                        <date calendar="gregorian" when="1864-05-13"><hi rendition="#italic"
                                >May</hi> 13, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to transmit copies of four
                    sets of parliamentary papers recently published in connexion with the affairs of
                    the United States, (Nos. 11, 12, 13, and 14.)</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>CHARLES FRANCES ADAMS.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>





                <xi:include href="d351-a1.xml" xpointer="d351-a1"/>
