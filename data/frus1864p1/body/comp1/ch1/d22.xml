    <text>
        <body>
            <div xml:id="d22">

                <pb facs="0070" n="60" sameAs="frus:frus1864p1/pg60"/>

                <head>Mr. Adams to Mr. Seward.</head>
                <opener>
                    <seg rendition="#float-left">No. 565.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United
                                States,</hi><hi rendition="#italic"> London,</hi></placeName>
                        <date calendar="gregorian" when="1864-01-01"><hi rendition="#italic"
                                >January</hi> 1, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to transmit copies of a
                    note addressed by me to Lord Russell, on the 28th of December, in relation to
                    certain movements contemplated by the rebels in this country, and of his
                    reply.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>CHARLES FRANCIS ADAMS.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>
                        <hi rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>



                <xi:include href="d22-a1.xml" xpointer="d22-a1"/>
