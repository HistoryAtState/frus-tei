    <text>
        <body>
            <div xml:id="d64">

                <pb facs="0135" n="125" xml:id="pg125"/>

                <head>Mr. Seward to Mr.
                        Adams.</head>
                <opener>
                    <seg rendition="#float-left">No. 830.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-02-05"><hi rendition="#italic"
                                >February</hi> 5, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I transmit the copy of a despatch of the
                    21st ultimo from the consul of the United States, at Halifax, Nova Scotia, and
                    of the address of the workingmen and other inhabitants of that place, to the
                    President of the United States, which accompanied it, together with a copy of
                    the reply which the President proposes to make to it, should such reply meet
                    with the approbation of Earl Russell, to whom you will informally submit these
                    papers, Lord Lyons having declined to entertain the matter, preferring the
                    reference now made.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles F. Adams</hi>, Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d64-a1.xml" xpointer="d64-a1"/>
            </div>
