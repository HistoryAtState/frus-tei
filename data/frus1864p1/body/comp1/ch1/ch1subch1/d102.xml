    <text>
        <body>
            <div xml:id="d102">

                <pb facs="0274" n="264" sameAs="frus:frus1864p1/pg264"/>

                <opener><seg rendition="#center">No. 5.</seg></opener>
                <head>Consul Archibald to Earl Russell.—(Received January
                        9.).</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">New York,</hi></placeName>
                        <date calendar="gregorian" when="1863-12-23"><hi rendition="#italic"
                                >December</hi> 23, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Lord:</hi> I have the honor to transmit, herewith
                    enclosed, for your lordship’s information, a copy of my despatch of this date to
                    Lord Lyons, reporting the arrival at this port of the bark Saxon, in charge of a
                    prize crew.</p>
                <p>I have, &amp;c.,</p>
                <closer>
                    <signed>E. M. ARCHIBALD.</signed></closer>



                <xi:include href="d102-a1.xml" xpointer="d102-a1"/>
