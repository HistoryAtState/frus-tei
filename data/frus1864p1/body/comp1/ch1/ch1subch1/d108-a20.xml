    <text>
        <body>
            <div xml:id="d108-a20">

                <pb facs="0296" n="286" sameAs="frus:frus1864p1/pg286"/>

                <p rendition="#center">[Enclosure 11 in No. 11.]</p>
                <p rendition="#center"><hi rendition="#italic">Articles of agreement.</hi></p>
                <p>I certify that the terms of the articles of agreement, signed by the crew of the
                    British bark Saxon, of Cape Town, 215 tons, commanded by Stephen Shephard, run
                    thus: from Table bay to Ascension, from thence to Rio, and for any port or ports
                    in the south Atlantic as employment offers, for a term not exceeding six months,
                    final port of discharge to be Table bay.</p>
                <closer>
                    <signed>THOMAS TINLEY, <hi rendition="#italic">Shipping
                        Master.</hi></signed><lb/><dateline rendition="#float-left"><date
                            calendar="gregorian" when="1863-12-05"><hi rendition="#small-caps"
                                >December</hi> 5, 1863</date>.</dateline></closer>
            </div>
        </body>
    </text>
