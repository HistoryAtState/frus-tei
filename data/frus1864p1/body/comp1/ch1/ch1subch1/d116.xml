    <text>
        <body>
            <div xml:id="d116">

                <pb facs="0307" n="297" sameAs="frus:frus1864p1/pg297"/>

                <opener><seg rendition="#center">No. 19.</seg></opener>
                <head>Earl Russell to Lord Lyons.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Foreign Office,</hi></placeName>
                        <date calendar="gregorian" when="1864-02-11"><hi rendition="#italic"
                                >February</hi> 11, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Lord:</hi> I have to state to you that I approve
                    the note which you addressed to Mr. Seward on the 19th of January, a copy of
                    which is enclosed in <pb facs="0308" n="298" xml:id="pg298"/> your lordship s
                    despatch, No. 51, of the 26th ultimo, calling upon the government of the United
                    States to investigate the circumstances under which Mr. James Gray, mate of the
                    British bark Saxon, was killed by Lieutenant Donohoe, of the United States ship
                    Vanderbilt.</p>
                <p>I am, &amp;c.</p>
                <closer>
                    <signed>RUSSELL,</signed></closer>
            </div>
        </body>
    </text>
