    <text>
        <body>
            <div xml:id="d101">

                <pb facs="0273" n="263" sameAs="frus:frus1864p1/pg263"/>

                <opener><seg rendition="#center">No. 4.</seg></opener>
                <head>Mr. Hammond to Messrs.
                        Sinclair &amp; Co.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Foreign Office,</hi></placeName>
                        <date calendar="gregorian" when="1864-01-06"><hi rendition="#italic"
                                >January</hi> 6, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Gentlemen:</hi> I am directed by Earl Russell to
                    acknowledge the receipt of <pb facs="0274" n="264" xml:id="pg264"/> your letter
                    of the 4th instant, respecting the seizure of the bark Saxon by the United
                    States steamer Vanderbilt; and I am to inform you that this case is under the
                    consideration of her Majesty’s government.</p>
                <p>I am, &amp;c.,</p>
                <closer>
                    <signed>E.HAMMOND.</signed></closer>
            </div>
        </body>
    </text>
