    <text>
        <body>
            <div xml:id="d108-a28-a2">

                <pb facs="0303" n="293" sameAs="frus:frus1864p1/pg293"/>

                <head>No. 2.</head>
                <p>This is to certify that James Gray has been in command of my schooner Wanderer
                    for eighteen months past, and has shown himself to be a fit and proper person to
                    take charge of a vessel.</p>
                <closer>
                    <signed>JAMES MURISON.</signed><lb/><dateline rendition="#float-left"
                                ><placeName><hi rendition="#small-caps">Cape Town,</hi></placeName>
                        <date calendar="gregorian" when="1856-08-01"><hi rendition="#italic"
                                >August</hi> 1, 1856</date>.</dateline></closer>
            </div>
        </body>
    </text>
