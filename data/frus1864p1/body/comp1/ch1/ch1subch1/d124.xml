    <text>
        <body>
            <div xml:id="d124">

                <pb facs="0314" n="304" sameAs="frus:frus1864p1/pg304"/>

                <opener><seg rendition="#center">No. 27.</seg></opener>
                <head>Earl Russell to Lord
                        Lyons.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Foreign Office,</hi></placeName>
                        <date calendar="gregorian" when="1864-02-20"><hi rendition="#italic"
                                >February</hi> 20, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Lord:</hi> With reference to my previous despatch
                    of this day’s date, I enclose for your information copies of farther
                        papers,<anchor n="†" xml:id="d124-f1"/> as marked in the margin, relative to
                    the case of the Saxon.</p>
                <p>I am, &amp;c.,</p>
                <closer>
                    <signed>RUSSELL.</signed></closer>
            </div>
        </body>
    </text>
