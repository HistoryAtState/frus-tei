                <pb facs="0304" n="294" sameAs="frus:frus1864p1/pg294"/>


                <head>Particulars of claim of Messrs. Anderson, Saxon &amp;
                        Co.</head>
                <p rendition="#center">The United States government to William Anderson, Saxon &amp;
                    Co.</p>
                <table>
                    <row>
                        <cell>1863.</cell>
                        <cell/>
                        <cell>Dr.</cell>
                    </row>
                    <row>
                        <cell rendition="#top">Nov. 23.—</cell>
                        <cell>To 250 tons coal taken from Penguin island by the boats and crew of
                            the United States steamer Vanderbilt, by order of Captain Baldwin, on
                            the 31st October last, at <hi rendition="#italic">£</hi>6 per ton</cell>
                        <cell rendition="#bottom" role="num"><hi rendition="#italic"
                            >£</hi>1,500</cell>
                    </row>
                </table>
                <p><hi rendition="#small-caps">Cape Town.</hi></p>
            </div>
        </body>
