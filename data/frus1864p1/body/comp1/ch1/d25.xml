    <text>
        <body>
            <div xml:id="d25">

                <pb facs="0073" n="63" sameAs="frus:frus1864p1/pg63"/>

                <head>Mr. Seward to Mr.
                        Adams.</head>
                <opener>
                    <seg rendition="#float-left">No. 797.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-01-04"><hi rendition="#italic"
                                >January</hi> 4, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your despatch of the 17th of December (No.
                    559) has been received.</p>
                <p>I have laid before the President the proceedings of the citizens of West
                    Hartlepool, on the subject of the civil war in the United States, and am
                    authorized to express to you his great satisfaction with the just sentiments and
                    cordial sympathies therein manifested.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
