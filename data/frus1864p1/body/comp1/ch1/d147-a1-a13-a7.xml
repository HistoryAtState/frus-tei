    <text>
        <body>
            <div xml:id="d147-a1-a13-a7">

                <pb facs="0400" n="390" sameAs="frus:frus1864p1/pg390"/>

                <head>[Enclosure 7 in No. 11.]</head>
                <p rendition="#center"><hi rendition="#italic">List of sails belonging to the bark
                        Conrad, late Tuscaloosa, unbent and stowed in after-hole.</hi></p>
                <table>
                    <row role="label">
                        <cell>Foresail.</cell>
                        <cell>Mizen topmast staysail.</cell>
                    </row>
                    <row>
                        <cell>Fore topsail.</cell>
                        <cell>Main trysail.</cell>
                    </row>
                    <row>
                        <cell>Fore top-gallant sail.</cell>
                        <cell>Spanker.</cell>
                    </row>
                    <row>
                        <cell>Fore royal.</cell>
                        <cell>Gaff topsail.</cell>
                    </row>
                    <row>
                        <cell>Mainsail.</cell>
                        <cell>2 lower studding-sails.</cell>
                    </row>
                    <row>
                        <cell>Main topsail.</cell>
                        <cell>1 topmast studding-sail.</cell>
                    </row>
                    <row>
                        <cell>Main top-gallant sail.</cell>
                        <cell>2 fore top-gallant studding-sails.</cell>
                    </row>
                    <row>
                        <cell>Main royal.</cell>
                        <cell rows="5">
                            <table>
                                <row role="label">
                                    <cell rows="3">Spare</cell>
                                    <cell role="brace" rows="3">{</cell>
                                    <cell>3 topsails, fore or main, quite worn out.</cell>
                                </row>
                                <row>
                                    <cell>3 top-gallant studding-sails, fore or main, quite worn
                                        out.</cell>
                                </row>
                                <row>
                                    <cell>Main trysail.</cell>
                                </row>
                            </table></cell>
                    </row>
                    <row>
                        <cell>Flying jib.</cell>
                    </row>
                    <row>
                        <cell>Jib.</cell>
                    </row>
                    <row>
                        <cell rendition="#nowrap">Fore topmast staysail.</cell>
                    </row>
                    <row>
                        <cell>Main topmast staysail.</cell>
                    </row>
                    <row>
                        <cell>Main top-gallant staysail.</cell>
                        <cell/>
                    </row>
                </table>
            </div>
        </body>
    </text>
