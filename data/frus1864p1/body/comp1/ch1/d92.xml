    <text>
        <body>
            <div xml:id="d92">

                <pb facs="0255" n="245" sameAs="frus:frus1864p1/pg245"/>

                <head>Mr. Seward to Mr. Adams.</head>
                <opener>
                    <seg rendition="#float-left">No. 857.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-02-29"><hi rendition="#italic"
                                >February</hi> 29, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I transmit herewith, for your information,
                    a copy of an instruction to Mr. Dayton, of the 25th instant, No. 487, in regard
                    to the newspaper report of S. R<hi rendition="#italic">.</hi> Mallory, the
                    pretended secretary of the navy of the insurgents, recently sent to you.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">C. F. Adams,</hi> Esq., <hi rendition="#italic"
                            >&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d92-a1.xml" xpointer="d92-a1"/>
            </div>
