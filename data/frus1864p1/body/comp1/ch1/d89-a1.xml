    <text>
        <body>
            <div xml:id="d89-a1">

                <pb facs="0253" n="243" xml:id="pg243"/>

                <head>Mr. Hamilton to Mr. Adams.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>5 <hi rendition="#small-caps">Cannon Street, London,</hi> E.
                            E.</placeName>, <date calendar="gregorian" when="1864-02-22"><hi
                                rendition="#italic">February</hi> 22,
                    1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to inform you that I have
                    received a box of parliamentary papers from the colony of New South Wales for
                    presentation to the Congress of the United States, and I am instructed to
                    deliver them to your order. The papers are safely packed for sea voyage.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>EDW’D HAMILTON, <hi rendition="#italic">Rep. Agent of New South
                            Wales.</hi></signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">C. Francis Adams,</hi>
                        <hi rendition="#italic">&amp;c., &amp;c., &amp;c., Minister of the United
                            States.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
