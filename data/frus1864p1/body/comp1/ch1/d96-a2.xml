    <text>
        <body>
            <div xml:id="d96-a2">

                <pb facs="0265" n="255" sameAs="frus:frus1864p1/pg255"/>

                <head>Earl Russell to Mr.
                        Adams.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Foreign Office,</hi></placeName>
                        <date calendar="gregorian" when="1864-02-25"><hi rendition="#italic"
                                >February</hi> 25, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge the receipt
                    of your letter of the 22d instant, and to state to you, in reply, that I have
                    requested his grace the Duke of Newcastle to call the attention of the colonial
                    authorities at Halifax and Bermuda to the movements of the steamer
                    Will-o’-the-Wisp.</p>
                <p>I have the honor to be, with the highest consideration, sir, your most obedient,
                    humble servant,</p>
                <closer>
                    <signed>RUSSELL.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
