    <text>
        <body>
            <div xml:id="d349-a2">

                <pb facs="0743" n="733" sameAs="frus:frus1864p1/pg733"/>

                <head>Earl Russell to Mr.
                        Adams.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Foreign Office</hi></placeName>
                        <date calendar="gregorian" when="1864-05-09"><hi rendition="#italic"
                                >May</hi> 9, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge the receipt
                    of your note of the 2d instant, enclosing a copy of the report of the American
                    commissioners of the mixed commission court at Sierra Leone upon the slave trade
                    on the west coast of Africa, and I have to request that you will convey to the
                    government of the United States the thanks of her Majesty’s government for this
                    communication.</p>
                <pb facs="0744" n="734" xml:id="pg734"/>
                <p>I have the honor to be, with the highest consideration, sir, your most obedient,
                    humble servant,</p>
                <closer>
                    <signed>RUSSELL.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
