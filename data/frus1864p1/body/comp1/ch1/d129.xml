    <text>
        <body>
            <div xml:id="d129">

                <pb facs="0320" n="310" sameAs="frus:frus1864p1/pg310"/>

                <head>Mr. Adams to Mr.
                        Seward.</head>
                <opener>
                    <seg rendition="#float-left">No. 611.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United
                                States,</hi><hi rendition="#italic"> London,</hi></placeName>
                        <date calendar="gregorian" when="1864-03-10"><hi rendition="#italic"
                                >March</hi> 10, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: * * * * * * * *</p>
                <p>I have the honor to transmit a copy of the Times of the 8th of March, containing
                    a report of some remarks in Parliament the evening before, on certain topics
                    connected with rebel operations on the ocean. * * * *</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>CHARLES FRANCIS ADAMS.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>


                <xi:include href="d129-a1.xml" xpointer="d129-a1"/>
            </div>
