        <body>
            <div xml:id="d45-a7-a3-a5">

                <pb facs="0107" n="97" sameAs="frus:frus1864p1/pg97"/>

                <head><hi rendition="#small-caps">Exhibit</hi> E.</head>
                <p><hi rendition="#small-caps">Madam</hi>: We have this day received advices, per
                    West India mail, from St. Domingo, stating that John Latham, with three other
                    men, deserted the Alabama, on the 25th January, at Kingston, Jamaica, and of
                    course their allotment notes must be stopped.</p>
                <p>We are &amp;c.</p>
                <closer>
                    <signed>Per M. G. KLINGENDER,</signed></closer>
                <closer>
                    <signed>C. F. VAN MELLE.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Martha Latham,</hi> 19 <hi rendition="#italic"
                            >Wellington street, Swansea, South Wales.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
