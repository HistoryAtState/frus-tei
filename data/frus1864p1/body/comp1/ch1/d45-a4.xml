    <text>
        <body>
            <div xml:id="d45-a4">

                <pb facs="0097" n="87" sameAs="frus:frus1864p1/pg87"/>

                <head>Mr. Adams to Earl Russell.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United
                                States,</hi><hi rendition="#italic"> London,</hi></placeName>
                        <date calendar="gregorian" when="1864-01-11"><hi rendition="#italic"
                                >January</hi> 11, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Lord:</hi> I have the honor to submit to your
                    consideration the copies of a letter from Mr. Dudley, consul of the United
                    States at Liverpool, and of the deposition of Thomas Matthews, going most
                    clearly to establish the proof of the agency of Messrs. Jones &amp; Co. in
                    enlisting and paying British subjects in this kingdom to carry on war against
                    the United States.</p>
                <p>I pray your lordship, &amp;c., &amp;c.</p>
                <closer>
                    <signed>CHARLES FRANCIS ADAMS.</signed></closer>
                <postscript>
                    <p>Right Hon. <hi rendition="#small-caps">Earl Russell,</hi>
                        <hi rendition="#italic">&amp;c., &amp;c</hi>.</p>
                </postscript>



                <xi:include href="d45-a4-a1.xml" xpointer="d45-a4-a1"/>
