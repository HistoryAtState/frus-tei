    <text>
        <body>
            <div xml:id="d253">

                <pb facs="0466" n="456" sameAs="frus:frus1864p1/pg456"/>

                <opener><seg rendition="#center">No. 10.</seg></opener>
                <head>Mr. Waddington to Mr. Hammond.—(Received
                    March 1.)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Whitehall,</hi></placeName>
                        <date calendar="gregorian" when="1864-02-29"><hi rendition="#italic"
                                >February</hi> 29, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> With reference to the previous
                    correspondence on the same subject, I am directed by Secretary Sir George Grey
                    to transmit to you, for the information of Earl Russell, a copy of a report
                    which has been received by the Irish government from the Dublin police
                    respecting the embarkation of fifty-five young men by the agency of P. J.
                    Finney.</p>
                <p>I am, &amp;c.,</p>
                <closer>
                    <signed>H. WADDINGTON.</signed></closer>


                <postscript>
                    <p>The <hi rendition="#small-caps">Commissioners of Police</hi>, Submitted. J.
                        L. <hi rendition="#small-caps">O’Ferrall.</hi></p>
                    <p><hi rendition="#small-caps">February</hi> 21, 1864.</p>
                </postscript>

                <xi:include href="d253-a1.xml" xpointer="d253-a1"/>
            </div>
