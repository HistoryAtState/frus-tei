    <text>
        <body>
            <div xml:id="d147-a1-a2">

                <pb facs="0363" n="353" sameAs="frus:frus1864p1/pg353"/>

                <opener><seg rendition="#center">No. 2.</seg></opener>
                <head>Sir F. Rogers to Mr. Hammond.—(Received September 30.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Downing Street,</hi></placeName>
                        <date calendar="gregorian" when="1863-09-29"><hi rendition="#italic"
                                >September</hi> 29, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I am directed by the Duke of Newcastle to
                    transmit to you, for the consideration of Earl Russell, the enclosed copy of a
                    despatch from the governor of the Cape of Good Hope, reporting the arrival at
                    the Cape of the confederate steamer Alabama, and requesting instructions on many
                    questions that have arisen from the state of affairs consequent on the presence
                    of this vessel in the colony.</p>
                <p>I am, &amp;c.,</p>
                <closer>
                    <signed>F. ROGERS.</signed></closer>










































