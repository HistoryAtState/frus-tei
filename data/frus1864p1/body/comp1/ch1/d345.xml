    <text>
        <body>
            <div xml:id="d345">

                <pb facs="0741" n="731" sameAs="frus:frus1864p1/pg731"/>

                <head>Mr. Seward to Mr. Adams.</head>
                <opener>
                    <seg rendition="#float-left">No. 943]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-05-09"><hi rendition="#italic"
                                >May</hi> 9, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge the receipt
                    of your despatches of the 21st ultimo, Nos. 662 to 665 inclusive; also those of
                    the 22d, Nos. 666 to 669; and they are approved.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">C. F. Adams,</hi> Esq., <hi rendition="#italic"
                            >&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
