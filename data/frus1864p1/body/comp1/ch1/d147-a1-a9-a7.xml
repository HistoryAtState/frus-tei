    <text>
        <body>
            <div xml:id="d147-a1-a9-a7">

                <pb facs="0390" n="380" sameAs="frus:frus1864p1/pg380"/>

                <opener><seg rendition="#center">[Enclosure 7 in No. 9]</seg></opener>
                <head>Lieutenant Low, C. S. N., to Rear-Admiral Sir B. Walker.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">“Tuscaloosa,” Simon’s Bay,</hi>
                            <hi rendition="#italic">Cape of Good Hope,</hi></placeName>
                        <date calendar="gregorian" when="1863-12-28"><hi rendition="#italic"
                                >December</hi> 28, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to enclose for your
                    information copy of a letter which I have forwarded this day to his excellency
                    the governor of the colony on the subject of the seizure in this port of the
                    confederate ship Tuscaloosa.</p>
                <p>I am, &amp;c.,</p>
                <closer>
                    <signed>JOHN LOW.</signed></closer>
            </div>
        </body>
    </text>
