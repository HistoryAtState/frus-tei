    <text>
        <body>
            <div xml:id="d147-a1-a4">

                <pb facs="0381" n="371" sameAs="frus:frus1864p1/pg371"/>

                <opener><seg rendition="#center">No. 4.</seg></opener>
                <head>The Secretary to the Admiralty to Mr. Hammond —(Received October 21.).</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Admiralty,</hi></placeName>
                        <date calendar="gregorian" when="1863-10-21"><hi rendition="#italic"
                                >October</hi> 21, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I am commanded by my lords commissioners of
                    the admiralty to send <pb facs="0382" n="372" xml:id="pg372"/> you herewith, for
                    the information of Earl Russell, a copy of a letter dated the 17th September,
                    from Rear-Admiral Sir Baldwin Walker, with copy of its enclosure, relative to
                    the movements of the so-styled Confederate States ship Alabama and her
                    prizes.</p>
                <p>I am, &amp;c.,</p>
                <closer>
                    <signed>C. PAGET.</signed></closer>



                <xi:include href="d147-a1-a4-a1.xml" xpointer="d147-a1-a4-a1"/>
