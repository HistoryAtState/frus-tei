    <text>
        <body>
            <div xml:id="d308-a3">

                <pb facs="0591" n="581" sameAs="frus:frus1864p1/pg581"/>

                <head>Earl Russell to Mr.
                        Adams.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Foreign Office</hi>,</placeName>
                        <date calendar="gregorian" when="1864-04-06"><hi rendition="#italic"
                                >April</hi> 6, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge the receipt
                    of your note of yesterday’s date, enclosing copies of a letter from the United
                    States consul at Liverpool and two affidavits relative to the part taken by
                    Messrs. Jones &amp; Co., of Liver pool, in enlisting men for the service of the
                    so-styled Confederate States.</p>
                <p>I have the honor to be, with the highest consideration, sir, your most obedient,
                    humble servant,</p>
                <closer>
                    <signed>RUSSELL.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams</hi>, Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
