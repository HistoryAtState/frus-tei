    <text>
        <body>
            <div xml:id="d147-a1-a2-a36">

                <pb facs="0380" n="370" sameAs="frus:frus1864p1/pg370"/>

                <opener><seg rendition="#center">[Enclosure 40 in No. 2.]</seg></opener>
                <head>Mr. Rawson to Mr.
                        Holmes.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Colonial Office,</hi></placeName>
                        <date calendar="gregorian" when="1863-08-07"><hi rendition="#italic"
                                >August</hi> 7, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I am directed by the governor to
                    acknowledge the receipt of your letter of yesterday’s date relative to the
                    capture of the Sea Bride, and to acquaint you that an inquiry is in progress as
                    to the circumstances under which it took place.</p>
                <p>I have, &amp;c.,</p>
                <closer>
                    <signed>RAWSON W. RAWSON, <hi rendition="#italic">Colonial
                        Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
