    <text>
        <body>
            <div xml:id="d87-a2">

                <pb facs="0213" n="203" sameAs="frus:frus1864p1/pg203"/>

                <head>Earl Russell to Mr. Adams.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Foreign Office,</hi></placeName>
                        <date calendar="gregorian" when="1864-02-24"><hi rendition="#italic"
                                >February</hi> 24, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge the receipt
                    of your note of the 22d instant, enclosing a copy of the Index newspaper,
                    containing an article relative to the late attempts to release the confederate
                    prisoners of war, confined at Johnson’s island; and I have the honor to inform
                    you that I have forwarded a copy of your note to the colonial office.</p>
                <p>I have the honor to be, with the highest consideration, sir, your most obedient,
                    humble servant,</p>
                <closer>
                    <signed>RUSSELL.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
