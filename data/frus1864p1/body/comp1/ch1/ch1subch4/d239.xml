                <pb facs="0446" n="436" sameAs="frus:frus1864p1/pg436"/>

                <opener><seg rendition="#center">No. 7.</seg></opener>
                <head>The Secretary to the Admiralty to Mr. Hammond.—(Received December 10.)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Admiralty,</hi></placeName>
                        <date calendar="gregorian" when="1863-12-10"><hi rendition="#italic"
                                >December</hi> 10, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> With reference to my letter of the 9th
                    instant, I am commanded by my lords commissioners of the admiralty to send you
                    herewith, for the information of Earl Russell, a copy of a further letter from
                    Rear-Admiral Sir Lewis Jones, dated the 8th instant, with copies of its
                    enclosures, relating to the men relanded at Queenstown from the United States
                    shin-of-war Kearsarge.</p>
                <p>I am, &amp;c.,</p>
                <closer>
                    <signed>W. G. ROMAINE.</signed></closer>



                <xi:include href="d239-a1.xml" xpointer="d239-a1"/>
