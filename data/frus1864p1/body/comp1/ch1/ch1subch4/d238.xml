                <pb facs="0445" n="435" sameAs="frus:frus1864p1/pg435"/>

                <opener><seg rendition="#center">No. 6.</seg></opener>
                <head>The Secretary to the Admiralty to Mr.
                    Hammond.—(Received December 9.)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Admiralty,</hi></placeName>
                        <date calendar="gregorian" when="1863-12-09"><hi rendition="#italic"
                                >December</hi> 9, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I am commanded by my lords commissioners of
                    the admiralty to send you herewith, for the information of Earl Russell, a copy
                    of a letter from Rear-Admiral Sir Lewis Jones, dated the 7th instant, relative
                    to fifteen seamen having been landed at Queenstown from the United States
                    sloop-of-war Kearsarge, who stated that they had been shipped at that port.</p>
                <p>I am, &amp;c.,</p>
                <closer>
                    <signed>W. G. ROMAINE.</signed></closer>



                <xi:include href="d238-a1.xml" xpointer="d238-a1"/>
            </div>
        </body>
    </text>
