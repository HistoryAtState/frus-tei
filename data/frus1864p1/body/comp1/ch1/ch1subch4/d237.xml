                <pb facs="0443" n="433" sameAs="frus:frus1864p1/pg433"/>

                <opener><seg rendition="#center">No. 2.</seg></opener>
                <head>The Earl of Donoughmore to Earl Russell.—(Received November 26.)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>52 <hi rendition="#small-caps">South Audley Street,
                            London,</hi></placeName>
                        <date calendar="gregorian" when="1863-11-25"><hi rendition="#italic"
                                >November</hi> 25, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Lord:</hi> I think it right to forward to your
                    lordship the enclosed copy of a letter received this day from the Hon. J. M.
                    Mason, together with copies of the declarations to which it refers. Believe,
                    &amp;c.,</p>
                <closer>
                    <signed>DONOUGHMORE.</signed></closer>





