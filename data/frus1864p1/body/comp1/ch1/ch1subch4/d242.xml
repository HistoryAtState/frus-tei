    <text>
        <body>
            <div xml:id="d242">

                <pb facs="0448" n="438" sameAs="frus:frus1864p1/pg438"/>

                <opener><seg rendition="#center">No. 12.</seg></opener>
                <head>Earl Russell to Mr. Adams.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Foreign Office,</hi></placeName>
                        <date calendar="gregorian" when="1863-12-17"><hi rendition="#italic"
                                >December</hi> 17, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge the receipt
                    of your note of the 14th instant, respecting the seamen embarked on board the
                    United States steamer Kearsarge at Queenstown.</p>
                <p>I am, &amp;c.,</p>
                <closer>
                    <signed>RUSSELL.</signed></closer>
            </div>
        </body>
    </text>
