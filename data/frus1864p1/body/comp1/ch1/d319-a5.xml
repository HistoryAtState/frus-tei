    <text>
        <body>
            <div xml:id="d319-a5">

                <pb facs="0625" n="615" sameAs="frus:frus1864p1/pg615"/>

                <head>Earl Russell to Mr. Adams.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Foreign Office</hi>,</placeName>
                        <date calendar="gregorian" when="1864-04-13"><hi rendition="#italic"
                                >April</hi> 13, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of the 11th instant, relative to the proceedings of the officers of
                    the United States steamer <pb facs="0626" n="616" xml:id="pg616"/> Kearsarge in
                    regard to the enlistment of British subjects for service on board that
                    vessel.</p>
                <p>I have the honor to be, with the highest consideration, sir, your most obedient,
                    humble servant,</p>
                <closer>
                    <signed>RUSSELL.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams</hi>, Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
