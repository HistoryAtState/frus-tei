    <text>
        <body>
            <div xml:id="d308-a2">

                <pb facs="0590" n="580" xml:id="pg580"/>

                <head>Mr. Adams to Earl
                        Russell.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">London</hi>,</placeName>
                        <date calendar="gregorian" when="1864-04-05"><hi rendition="#italic"
                                >April</hi> 5, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Lord:</hi> I have the honor to submit to your
                    consideration copies of a letter from Mr. Dudley, consul of the United States at
                    Liverpool, and of two depositions, showing the continued agency of the house of
                    Jones &amp; Co., British subjects, in enlistments and payment of British
                    subjects in the service of the insurgents in the United States.</p>
                <p>I pray your lordship to accept the assurances, &amp;c., &amp;c.,</p>
                <closer>
                    <signed>CHARLES FRANCIS ADAMS.</signed></closer>
                <postscript>
                    <p>Right Hon. <hi rendition="#small-caps">Earl Russell</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d308-a2-a1.xml" xpointer="d308-a2-a1"/>
            </div>
        </body>
    </text>
