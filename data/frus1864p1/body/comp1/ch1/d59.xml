    <text>
        <body>
            <div xml:id="d59">

                <pb facs="0131" n="121" sameAs="frus:frus1864p1/pg121"/>

                <head>Mr. Seward to Mr.
                        Adams.</head>
                <opener>
                    <seg rendition="#float-left">No. 828.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-02-02"><hi rendition="#italic"
                                >February</hi> 2, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I transmit herewith, for your further
                    information on the subject, a copy of a memorandum of this date, and of the
                    paper therein referred to, relative to the examination of Drs. Almon and Smith
                    and Mr. A. Keith, jr., charged with having obstructed the execution of a warrant
                    for the arrest of Wade and others, of the pirates engaged in the Chesapeake
                    affair.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles F. Adams</hi>, Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                    <p>[The enclosures referred to will be found among correspondence with the
                        British legation, in this volume.]</p>
                </postscript>
            </div>
        </body>
    </text>
