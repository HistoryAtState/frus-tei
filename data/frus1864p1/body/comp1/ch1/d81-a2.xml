    <text>
        <body>
            <div xml:id="d81-a2">

                <pb facs="0204" n="194" sameAs="frus:frus1864p1/pg194"/>

                <head>Earl Russell to Mr. Adams.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Foreign Office,</hi></placeName>
                        <date calendar="gregorian" when="1864-02-13"><hi rendition="#italic"
                                >February</hi> 13, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge the receipt
                    of your note of yesterday’s date respecting certain alleged abuses of neutrality
                    committed within her Majesty’s North American possessions; and I have the honor
                    to inform you that I have transmitted a copy of the same to the secretary of
                    state for the colonial department.</p>
                <p>I have the honor to be, with the highest consideration, sir, your most obedient,
                    humble servant,</p>
                <closer>
                    <signed>RUSSELL.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
