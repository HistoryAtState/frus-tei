    <text>
        <body>
            <div xml:id="d45-a7-a3-a3">

                <pb facs="0107" n="97" xml:id="pg97"/>

                <head><hi rendition="#small-caps">Exhibit</hi> D.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Liverpool,</hi></placeName>
                        <date calendar="gregorian" when="1862-10-31"><hi rendition="#italic"
                                >October</hi> 31, 1862.</date></dateline></opener>
                <p><hi rendition="#small-caps">Madam:</hi> We enclose you a money order for <hi
                        rendition="#italic">£3</hi> 9<hi rendition="#italic">s.</hi> 6<hi
                        rendition="#italic">d.,</hi> payable at the post office of your town.</p>
                <p>Returning you the note, we are yours, &amp;c.,</p>
                <p rendition="#right">Per M. G. KLINGENDER &amp; CO., C. F. VAN MELLE.</p>
                <table cols="4" rend="width: 75%;" rendition="#center">
                    <row>
                        <cell/>
                        <cell><hi rendition="#italic">£</hi>3</cell>
                        <cell>9<hi rendition="#italic">s.</hi></cell>
                        <cell>6<hi rendition="#italic">d.</hi></cell>
                    </row>
                    <row>
                        <cell>Cost of order,</cell>
                        <cell/>
                        <cell/>
                        <cell rendition="#border-bottom">6<hi rendition="#italic">d.</hi></cell>
                    </row>
                    <row>
                        <cell/>
                        <cell rendition="#border-bottom">3</cell>
                        <cell rendition="#border-bottom">10<hi rendition="#italic">s.</hi></cell>
                        <cell rendition="#border-bottom">0<hi rendition="#italic">d.</hi></cell>
                    </row>
                </table>
                <postscript>
                    <p>Mrs. <hi rendition="#small-caps">Martha Latham,</hi> 19 <hi
                            rendition="#italic">Wellington street, Swansea, South Wales.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
