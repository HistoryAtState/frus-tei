    <text>
        <body>
            <div xml:id="d19-a11">

                <pb facs="0068" n="58" sameAs="frus:frus1864p1/pg58"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Foreign Office,</hi></placeName>
                        <date calendar="gregorian" when="1863-12-17"><hi rendition="#italic"
                                >December</hi> 17, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge the receipt
                    of your letter of the 16th instant, enclosing further papers respecting the case
                    of the Rappahannock, and I have to inform you that the same shall receive the
                    consideration of her Majesty’s government.</p>
                <pb facs="0069" n="59" xml:id="pg59"/>
                <p>I have the honor to be, with the highest consideration, sir, your most obe dient,
                    humble servant,</p>
                <closer>
                    <signed>RUSSELL.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
