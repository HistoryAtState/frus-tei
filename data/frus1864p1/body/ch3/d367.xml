    <text>
        <body>
            <div xml:id="d367">

                <pb facs="0810" n="800" sameAs="frus:frus1864p1/pg800"/>

                <opener><seg rendition="#center">No. 9.</seg></opener>
                <head>Earl Russell to Mr.
                        Mason.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Foreign Office,</hi></placeName>
                        <date calendar="gregorian" when="1863-07-18"><hi rendition="#italic"
                                >July</hi> 18, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge the receipt
                    of your letter of the 16th instant, enclosing a list of vessels which had
                    arrived at Nassau from American blockaded ports from the 18th of July, 1862, to
                    the 2d of June, 1863.</p>
                <p>I am, &amp;c.,</p>
                <closer>
                    <signed>RUSSELL.</signed></closer>
            </div>
        </body>
    </text>
