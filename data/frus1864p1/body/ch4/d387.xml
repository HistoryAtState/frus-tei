    <text>
        <body>
            <div xml:id="d387">

                <pb facs="0846" n="836" sameAs="frus:frus1864p1/pg836"/>

                <opener><seg rendition="#center">No. 7.</seg></opener>
                <head>Lord Lyons to Earl Russell.—(Received
                    November 6.)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1863-10-23"><hi rendition="#italic"
                                >October</hi> 23, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Lord:</hi> With reference to my despatch of the
                    16th instant, I have the honor to transmit to your lordship an extract from the
                    National Intelligencer newspaper of the day before yesterday, containing a part
                    of a correspondence which has been published in the southern newspapers, and
                    from which it appears that the so-called confederate government has expelled the
                    British consular officers from the territory subject to it.</p>
                <p>I have no other information on the subject.</p>
                <p>I have, &amp;c.,</p>
                <closer>
                    <signed>LYONS.</signed></closer>


                <xi:include href="d387-a1.xml" xpointer="d387-a1"/>
            </div>
        </body>
    </text>
