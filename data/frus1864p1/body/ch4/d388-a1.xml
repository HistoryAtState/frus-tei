    <text>
        <body>
            <div xml:id="d388-a1">

                <pb facs="0849" n="839" sameAs="frus:frus1864p1/pg839"/>

                <opener><seg rendition="#center">[Enclosure 1 in No. 8.]</seg></opener>
                <head>Mr. Benjamin to Acting Consul Walker.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Richmond,</hi></placeName>
                        <date calendar="gregorian" when="1863-10-08"><hi rendition="#italic"
                                >October</hi> 8, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> For the reasons expressed in the enclosed
                    copy of a letter from this department to the acting British consul at Savannah,
                    I have to convey to you the orders of the president that you promptly withdraw
                    from the confederacy, and that in the mean time you cease to exereise any
                    consular functions within its limits.</p>
                <p>I am, &amp;c.,</p>
                <closer>
                    <signed>J. P. BENJAMIN, <hi rendition="#italic">Secretary of
                        State.</hi></signed></closer>
            </div>
        </body>
