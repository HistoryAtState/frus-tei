    <text>
        <body>
            <div xml:id="d357">

                <pb facs="0782" n="772" sameAs="frus:frus1864p1/pg772"/>

                <opener><seg rendition="#center">No. 6.</seg></opener>
                <head>Earl Russell to Mr.
                        Adams.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Foreign Office,</hi></placeName>
                        <date calendar="gregorian" when="1864-04-13"><hi rendition="#italic"
                                >April</hi> 13, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge the receipt
                    of your note of the 11th instant, relative to the proceedings of the officers of
                    the United States steamer Kearsarge, in regard to the enlistment of British
                    subjects for service on board that vessel.</p>
                <p>I am, &amp;c.,</p>
                <closer>
                    <signed>RUSSELL.</signed></closer>
            </div>
        </body>
    </text>
