    <text>
        <body>
            <div xml:id="d352">

                <pb facs="0774" n="764" sameAs="frus:frus1864p1/pg764"/>

                <opener><seg rendition="#center">No. 1.</seg></opener>
                <head>Earl Russell to Mr.
                        Adams.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Foreign Office,</hi></placeName>
                        <date calendar="gregorian" when="1864-03-31"><hi rendition="#italic"
                                >March</hi> 31, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to bring to your notice an
                    account taken from a newspaper of what passed at a trial before Mr. Justice
                    Keogh of the British subjects indicted for having taken service in the United
                    States ship Kearsarge, at Queenstown, in violation of the provisions of the
                    foreign enlistment act, and with reference to the correspondence which has
                    passed between us. I have the honor to request that you will inform me whether
                    you have any explanations to offer on the subject.</p>
                <p>I am, &amp;c.,</p>
                <closer>
                    <signed>RUSSELL.</signed></closer>


                <xi:include href="d352-a1.xml" xpointer="d352-a1"/>
            </div>
