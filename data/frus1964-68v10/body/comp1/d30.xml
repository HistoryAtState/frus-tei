    <text>
        <body>
            <div xml:id="d30">

                <pb facs="0109" n="83" xml:id="pg83"/>

                <head>30. National Security Action Memorandum No. 299<anchor n="1" xml:id="d30-f1"/>
                </head>
                <opener><dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            when="1964-05-12">May 12, 1964</date>.</dateline></opener>
                <list type="to">
                    <head>TO</head>
                    <item>The Secretary of State</item>
                    <item>The Secretary of Defense</item>
                    <item>The Chairman, Joint Chiefs of Staff</item>
                    <item>The Director of Central Intelligence</item>
                </list>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>Evacuation and Protection of U.S. Citizens in Danger Areas Abroad</item>
                </list>
                <p>The President has rescinded NSC 6019/1
                    (Evacuation and Protection of U.S. Citizens in Danger Areas Abroad) dated
                    January 2, 1961<anchor n="2" xml:id="d30-f2"/> and has directed that the
                    Secretaries of State and Defense be responsible for carrying out this
                    program.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#bold">McGeorge Bundy</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
