                <pb facs="0726" n="700" xml:id="pg700"/>

                <head>Appendix B</head>
                <p rendition="#center">Authorized Ceilings on Nuclear Weapon Deployments by Category
                    of Weapon—FY 1969</p>
                <table cols="4" rows="7">
                    <row>
                        <cell/>
                        <cell>Western Europe</cell>
                        <cell>Atlantic</cell>
                        <cell>Pacific</cell>
                    </row>
                    <row>
                        <cell>Strategic Offensive<note n="1" target="d207fn1">Includes Strategic
                                Offensive Surface-to-Surface Missiles, Bombs, and Air-to-Surface
                                Missiles</note>
                        </cell>
                        <cell>[*]</cell>
                        <cell>[*]</cell>
                        <cell>[*]</cell>
                    </row>
                    <row>
                        <cell>Strategic Defensive<note n="2" target="d207fn2">Includes Strategic
                                Defensive Air-to-Air Missiles and Surface-to-Air Missiles</note>
                        </cell>
                        <cell>[*]</cell>
                        <cell>[*]</cell>
                        <cell>[*]</cell>
                    </row>
                    <row>
                        <cell>Tactical Offensive<note n="3" target="d207fn3">Includes Tactical
                                Bombs, Surface-to-Surface Missiles, and Artillery</note>
                        </cell>
                        <cell>[*]</cell>
                        <cell>[*]</cell>
                        <cell>[*]</cell>
                    </row>
                    <row>
                        <cell>Tactical Defensive<note n="4" target="d207fn4">Includes Atomic
                                Demolition Munitions, Tactical Air-to-Air Missiles, and
                                Surface-to-Air Missiles</note>
                        </cell>
                        <cell>[*]</cell>
                        <cell>[*]</cell>
                        <cell>[*]</cell>
                    </row>
                    <row>
                        <cell>Fleet ASW and AAW</cell>
                        <cell>[*]</cell>
                        <cell>[*]</cell>
                        <cell>[*]</cell>
                    </row>
                    <row>
                        <cell>TOTAL</cell>
                        <cell>[*]</cell>
                        <cell>[*]</cell>
                        <cell>[*]</cell>
                    </row>
                </table>
                <p>[* <hi rendition="#italic">entry in table not declassified</hi>]</p>
            </div>
