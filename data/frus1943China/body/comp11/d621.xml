    <text>
        <body>
            <div xml:id="d621">

                <pb facs="0697" n="687" sameAs="frus:frus1943China/pg687"/>

                <note rend="inline" type="source">693.002/1169: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in China</hi> (<hi rendition="#italic"
                        >Atcheson</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Chungking</hi></placeName>, <date
                            calendar="gregorian" when="1943-06-04T10:00:00+07:00">June 4, 1943—10
                            a.m.</date>
                        <lb/> [Received 11:02 a.m.]</dateline>
                </opener>
                <p>845. The Minister of Finance<anchor n="2" xml:id="d621-f1"/> announced June 2
                    that Sir Frederick Maze, Inspector General of Customs, is retiring “on grounds
                    of his age and health” and that Mr. L. K. Little<anchor n="3" xml:id="d621-f2"/>
                    has been appointed Acting Inspector General. The Chief Secretary of the
                    Inspectorate General, Mr. K. D. Ting, is to officiate following Maze’s
                    retirement and until Little’s arrival.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Atcheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d621-f1" n="2" xml:id="d621-f1-content">
                <p>H. H. Kung.</p>
            </note>
            <note corresp="#d621-f2" n="3" xml:id="d621-f2-content">
                <p>American Commissioner of Customs at Canton, on leave.</p>
            </note>
