    <text>
        <body>
            <div xml:id="d80">

                <pb facs="0103" n="93" sameAs="frus:frus1943China/pg93"/>

                <note rend="inline" type="source">740.0011 Pacific War/3428</note>
                <head>
                    <hi rendition="#italic">The Chinese Minister for Foreign Affairs</hi> (<hi rendition="#italic">Soong</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-08-18">August 18,
                        1943</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Secretary</hi>: I enclose herewith a
                    memorandum on the question of China’s representation on various inter-allied
                    committees, which we discussed when I saw you this morning.</p>
                <p>I also enclose for your information a memorandum on our assignments of Canadian
                    munitions. While it may not be as detailed as my verbal discussion with you, it
                    is an outline which includes the essential points.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Tse Vun Soong</hi>
                    </signed>
                </closer>




                <xi:include href="d80-a1.xml" xpointer="d80-a1"/>
