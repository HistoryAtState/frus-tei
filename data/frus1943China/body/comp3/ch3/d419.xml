    <text>
        <body>
            <div xml:id="d419">

                <pb facs="0489" n="479" sameAs="frus:frus1943China/pg479"/>

                <note rend="inline" type="source">893.51/7666½</note>
                <head>
                    <hi rendition="#italic">The Secretary of the Treasury</hi> (<hi rendition="#italic">Morgenthau</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-12-20">December 20,
                        1943</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Cordell</hi>: I am sending you herewith copy
                    of a confidential memorandum on the Chinese situation, which I gave to the
                    President yesterday afternoon. In drafting this letter for the President,
                    unfortunately I did not have the benefit of the information contained in
                    Ambassador Gauss’ cable of December 9th.<anchor n="4" xml:id="d419-f1"/>
                </p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Henry</hi>
                    </signed>
                </closer>



                <xi:include href="d419-a1.xml" xpointer="d419-a1"/>
            </div>
        </body>
    </text>
