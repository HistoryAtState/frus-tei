    <text>
        <body>
            <div xml:id="d422">

                <pb facs="0499" n="489" sameAs="frus:frus1943China/pg489"/>

                <note rend="inline" type="source">893.51/7725</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Secretary of the Treasury</hi> (<hi rendition="#italic"
                            >Morgenthau</hi>)<anchor n="11" xml:id="d422-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-12-29">December 29,
                        1943</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: There is enclosed for
                    your confidential information and consideration a paraphrase of a secret
                    telegram of December 23, 1943 from the American Embassy at Chungking<anchor
                        n="12" xml:id="d422-f2"/> in regard to a conversation which Ambassador Gauss
                    had with President Chiang Kai-shek on December 22 on the subject of China’s
                    critical economic position.</p>
                <p>I shall be glad to receive any comments that you may care to make concerning the
                    contents of the enclosed telegram.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Cordell Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d422-f1" n="11" type="source" xml:id="d422-f1-content">
                <p>Copy transmitted on the same date to the Secretary of War (Stimson).</p>
            </note>
            <note corresp="#d422-f2" n="12" xml:id="d422-f2-content">
