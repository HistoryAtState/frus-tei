                    <hi rendition="#italic">Supra.</hi>
                </p>
            </note>
            <note corresp="#d389-f2" n="82" xml:id="d389-f2-content">
                <p>Chiang Kai-shek, President of the Chinese Executive Yuan (Premier).</p>
            </note>
        </listAnnotation>
