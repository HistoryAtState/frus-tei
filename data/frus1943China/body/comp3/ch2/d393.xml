            <div xml:id="d393">

                <pb facs="0471" n="461" sameAs="frus:frus1943China/pg461"/>

                <note rend="inline" type="source">893.5151/936: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in China</hi> (<hi rendition="#italic"
                        >Atcheson</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Chungking</hi></placeName>, <date
                            calendar="gregorian" when="1943-06-26T18:00:00+07:00">June 26, 1943—6
                            p.m.</date>
                        <lb/> [Received June 27—3:21 p.m.]</dateline>
                </opener>
                <p>1031. For Secretary [of] Treasury only from Adler: TF–135. Re your 797, June 23.
                    Informally communicated your views to Dr. Kung yesterday. He indicated that he
                    would ask for revision of 1941 Agreement. [Adler.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Atcheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
