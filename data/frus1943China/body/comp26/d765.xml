    <text>
        <body>
            <div xml:id="d765">

                <pb facs="0853" n="843" sameAs="frus:frus1943China/pg843"/>

                <note rend="inline" type="source">893.9111/47</note>
                <head>
                    <hi rendition="#italic">Memorandum by Mr. Lauchlin Currie, Administrative
                        Assistant to President Roosevelt, to the Chief of the Division of Far
                        Eastern Affairs</hi> (<hi rendition="#italic">Hamilton</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-01-13">January 13,
                        1943</date>.</dateline>
                </opener>
                <p>You will be interested in the attached excerpt from a letter from John
                        Fairbank,<anchor n="5" xml:id="d765-f1"/> dated December 30. The <hi
                        rendition="#italic">Ta Kung Pao</hi> editorial did not come out until the
                    fifth.</p>



                <xi:include href="d765-a1.xml" xpointer="d765-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d765-f1" n="5" xml:id="d765-f1-content">
                <p>Representative in China of the Interdepartmental Committee for the Acquisition of
                    Foreign Publications (IDC), of the Library of Congress, and of the Office of
                    Strategic Services (OSS).</p>
            </note>
        </listAnnotation>
    </standOff>
