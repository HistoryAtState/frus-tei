                <pb facs="0842" n="832" sameAs="frus:frus1943China/pg832"/>

                <note rend="inline" type="source">740.00119 MPC/59: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in China</hi> (<hi rendition="#italic"
                        >Gauss</hi>) <hi rendition="#italic">to the Acting Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Chungking</hi></placeName>, <date
                            calendar="gregorian" when="1943-10-27T22:00:00+07:00">October 27,
                            1943—10 p.m.</date>
                        <lb/> [Received October 27—5:45 p.m.]</dateline>
                </opener>
                <p>2032. Foreign Office requests me to inform Secretary Hull that full powers are
                    being telegraphed to Chinese Ambassador to sign Four Power Declaration and to
                    express thanks of Chinese Government to Mr. Hull for what he has done for China
                    in this connection.</p>
                <p>Please inform Moscow.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Gauss</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
