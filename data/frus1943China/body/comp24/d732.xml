    <text>
        <body>
            <div xml:id="d732">

                <pb facs="0831" n="821" sameAs="frus:frus1943China/pg821"/>

                <note rend="inline" type="source">740.0011 Moscow/17a: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in China</hi>
                        (<hi rendition="#italic">Gauss</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-10-07T00:00:00-04:00">October 7,
                            1943—midnight</date>.</dateline>
                </opener>
                <p>1442. With reference to your conversation with Chiang<anchor n="5"
                        xml:id="d732-f1"/> (Embassy’s 1871)<anchor n="6" xml:id="d732-f2"/> the
                    Department would appreciate receiving by radio a detailed account of his
                    questions and comments in regard to Russia.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d732-f1" n="5" xml:id="d732-f1-content">
                <p>Generalissimo Chiang Kai-shek, President of the Chinese Executive Yuan (Premier);
                    he was inaugurated as President of the Chinese National Government on October
                    10, 1943.</p>
            </note>
            <note corresp="#d732-f2" n="6" xml:id="d732-f2-content">
                <p>Telegram No. 1871, October 6, 11 a.m., <ref target="#pg872">p. 872</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
