    <text>
        <body>
            <div xml:id="d751">

                <pb facs="0845" n="835" sameAs="frus:frus1943China/pg835"/>

                <note rend="inline" type="source">893.001 Chiang Kai-shek/12</note>
                <head>
                    <hi rendition="#italic">Memorandum of Conversation, by the Secretary of
                        State</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1943-11-22">November 22, 1943</date>.</dateline>
                </opener>
                <p>The Chinese Ambassador called under instructions of General Chiang Kai-shek to
                    extend to me the most hearty and sincere congratulations of the Generalissimo
                    for my aid to China at Moscow.</p>
                <closer>
                    <signed>C[<hi rendition="#small-caps">ordell</hi>] H[<hi rendition="#small-caps"
                            >ull</hi>]</signed>
                </closer>
            </div>
        </body>
