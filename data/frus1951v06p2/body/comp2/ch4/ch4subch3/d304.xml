                        target="frus1950v05#pg_1457">
                        <hi rendition="#italic">Foreign Relations</hi>, 1950, vol. <hi
                            rendition="#small-caps">v</hi>, p. 1457</ref>.</p>
            </note>
        </listAnnotation>
