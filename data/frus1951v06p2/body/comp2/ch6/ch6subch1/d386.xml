            </note>
            <note corresp="#d386-f2" n="2" xml:id="d386-f2-content">
                <p>G. S. Peiris.</p>
            </note>
            <note corresp="#d386-f3" n="3" xml:id="d386-f3-content">
                <p>A memorandum of this conversation of July. 25, not printed, is in file
                    846E.2395/7–2651.</p>
            </note>
        </listAnnotation>
    </standOff>
