    <text>
        <body>
            <div xml:id="d829">

                <pb facs="0835" n="717" sameAs="frus:frus1929v03/pg717"/>

                <note rend="inline" type="source">857.014/60</note>
                <head><hi rendition="#italic">The Acting Secretary of War to the Secretary of
                        State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1929-02-05">February 5, 1929</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. Secretary</hi>: With reference to your
                    letter of January 28, 1929, in which you state that the Island of Bouvet in the
                    South Atlantic was placed under the sovereignty of Norway by the Royal Decree of
                    January 23, 1928, I am pleased to advise you that the War Department knows of no
                    American interest that would be jeopardized by a recognition of Norway’s action
                    in this case.<anchor n="11a" xml:id="d829-f1"/></p>
                <p>Sincerely yours,</p>
                <closer><signed>C. B. <hi rendition="#small-caps">Robbins</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d829-f1" n="11a" xml:id="d829-f1-content">
                <p>A reply to the same effect was received from the Navy Department on February
                    1.</p>
            </note>
        </listAnnotation>
    </standOff>
