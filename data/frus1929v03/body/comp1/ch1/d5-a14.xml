    <text>
        <body>
            <div xml:id="d5-a14">

                <pb facs="0147" n="29" sameAs="frus:frus1929v03/pg29"/>

                <opener><seg rendition="#center">[Annex VII<anchor n="22" xml:id="d5-f1"
                    />]</seg></opener>
                <head><hi rendition="#italic">The Secretary to the President</hi> (<hi
                        rendition="#italic">Richey</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >The White House</hi></placeName>, <date calendar="gregorian"
                            when="1929-10-01">October 1, 1929</date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: The President has asked
                    me to transmit to you the enclosed notes which he drafted today in connection
                    with naval parity.</p>
                <p>Yours sincerely,</p>
                <closer><signed><hi rendition="#small-caps">Lawrence Richey</hi></signed></closer>
            </div>
        </body>
    </text>
