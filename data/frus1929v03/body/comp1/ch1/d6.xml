    <text>
        <body>
            <div xml:id="d6">

                <pb facs="0149" n="31" sameAs="frus:frus1929v03/pg31"/>

                <note rend="inline" type="source">033.4111MacDonald, Ramsay/105½</note>
                <head><hi rendition="#italic">President Hoover to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >The White House</hi></placeName>, <date calendar="gregorian"
                            when="1929-10-10">October 10, 1929</date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: Please find enclosed
                    herewith copy of the prohibition comment sent to the Prime Minister.</p>
                <p>Yours faithfully,</p>
                <closer><signed><hi rendition="#small-caps">Herbert Hoover</hi></signed></closer>



