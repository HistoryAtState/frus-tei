        <body>
            <div xml:id="d18">

                <pb facs="0165" n="47" xml:id="pg47"/>

                <note rend="inline" type="source">867n.404Wailing Wall/24: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Consul General at Jerusalem</hi> (<hi rendition="#italic">Knabenshue</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1929-08-24T13:00:00-04:00">August 24, 1929—1
                        p.m.</date></dateline></opener>
                <p>Your August 23, 6 p.m. Keep Department informed by telegraph. Department presumes
                    that no injury has been done to American citizens or their property.</p>
                <closer><signed><hi rendition="#small-caps">Carr</hi></signed></closer>
            </div>
        </body>
