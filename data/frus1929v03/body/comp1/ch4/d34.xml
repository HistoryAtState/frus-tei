    <text>
        <body>
            <div xml:id="d34">

                <pb facs="0172" n="54" sameAs="frus:frus1929v03/pg54"/>

                <note rend="inline" type="source">867n.404Wailing Wall/130: Telegram</note>
                <head><hi rendition="#italic">The Consul General at Jerusalem</hi> (<hi rendition="#italic">Knabenshue</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Jerusalem</hi></placeName>, <date calendar="gregorian"
                            when="1929-08-30T22:00:00+02:00">August 30, 1929—10
                        p.m.</date><lb/>[Received August 31—1:22 a.m.]</dateline></opener>
                <p>Department’s August 28, 8 p.m.<anchor n="43" xml:id="d34-f1"/> Four British
                    troops stationed today at the consulate general for its protection.</p>
                <closer><signed><hi rendition="#small-caps">Knabenshue</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d34-f1" n="43" xml:id="d34-f1-content">
                <p>Not printed; it transmitted text of telegram No. 230 of August 28, midnight, to
                    the Ambassador in Great Britain, <ref target="#pg53">p. 53</ref>.</p>
            </note>
        </listAnnotation>
