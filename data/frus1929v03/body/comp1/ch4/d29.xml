            <div xml:id="d29">

                <pb facs="0170" n="52" sameAs="frus:frus1929v03/pg52"/>

                <note rend="inline" type="source">867n.404Wailing Wall/47: Telegram</note>
                <head><hi rendition="#italic">The Consul General at Jerusalem</hi> (<hi
                        rendition="#italic">Knabenshue</hi>) <hi rendition="#italic">to the
                        Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Jerusalem</hi></placeName>, <date calendar="gregorian"
                            when="1929-08-27T21:00:00+02:00">August 27, 1929—9
                        p.m.</date><lb/>[Received 9:57 p.m.]</dateline></opener>
                <p>All American citizens at Hebron as listed in my August 26, 10 p.m., now safe in
                    Jerusalem. Please notify relatives.</p>
                <closer><signed><hi rendition="#small-caps">Knabenshue</hi></signed></closer>
            </div>
        </body>
    </text>
