                <pb facs="0706" n="588" sameAs="frus:frus1929v03/pg588"/>

                <note rend="inline" type="source">817.00/6492a: Telegram</note>
                <head><hi rendition="#italic">The Vice Consul at Progreso</hi> (<hi
                        rendition="#italic">Lane</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Progreso</hi></placeName>, <date calendar="gregorian"
                            when="1929-07-11T10:00:00-06:00">July 11, 1929—10
                        a.m.</date><lb/>[Received 7 p.m.]</dateline></opener>
                <p>Sandino arrived at Progreso this morning; proceeded to Merida.</p>
                <closer><signed><hi rendition="#small-caps">Lane</hi></signed></closer>
            </div>
        </body>
