            </note>
            <note corresp="#d640-f3" n="14" xml:id="d640-f3-content">
                <p>Brigadier General Dion Williams, U. S. M. C, Commander of the Second Brigade in
                    Nicaragua.</p>
            </note>
        </listAnnotation>
