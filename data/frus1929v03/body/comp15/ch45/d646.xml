            <div xml:id="d646">

                <pb facs="0682" n="564" sameAs="frus:frus1929v03/pg564"/>

                <note rend="inline" type="source">817.00/6320</note>
                <head><hi rendition="#italic">The Chargé in Nicaragua</hi> (<hi rendition="#italic">Hanna</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Managua</hi></placeName>, <date calendar="gregorian"
                            when="1929-05-10">May 10, 1929</date>.<lb/>[Received May 24.]</dateline>
                    <seg rendition="#float-left">No. 983</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith a
                    copy of a memorandum, dated May 6, 1929, from the Commander of the Second
                    Brigade, U. S. M. C., regarding the military situation in Nicaragua on that
                    date.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Matthew E. Hanna</hi></signed></closer>


                <xi:include href="d646-a1.xml" xpointer="d646-a1"/>
