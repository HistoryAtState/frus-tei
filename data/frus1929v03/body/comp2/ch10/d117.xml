            <div xml:id="d117">

                <pb facs="0237" n="119" xml:id="pg119"/>

                <note rend="inline" type="source">868.76/37: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Chargé in Greece</hi> (<hi rendition="#italic"
                            >Aldridge</hi>)</head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1929-06-24T13:00:00-04:00">June 24, 1929—1
                    p.m.</date></dateline></opener>
                <p>34. Your 58, June 22, 5 p.m. You may in your discretion express in appropriate
                    form to the Greek Prime Minister the earnest hope of your Government that the
                    Chamber will have all the facts placed before it in order that a decision may be
                    taken on the merits of the case.</p>
                <closer><signed><hi rendition="#small-caps">Stimson</hi></signed></closer>
            </div>
        </body>
    </text>
