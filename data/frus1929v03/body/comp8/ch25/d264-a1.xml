    <text>
        <body>
            <div xml:id="d264-a1">

                <pb facs="0373" n="255" sameAs="frus:frus1929v03/pg255"/>

                <opener><seg rendition="#center">[Enclosure]</seg></opener>
                <head><hi rendition="#italic">The Japanese Embassy to the
                            Department of State</hi></head>
                <p rendition="#center"><hi rendition="#small-caps">Declaration</hi></p>
                <p>The Imperial Government declare that the phraseology “in the names of their
                    respective peoples”, appearing in Article I of the Treaty for the Renunciation
                    of War, signed at Paris on August 27, 1928, viewed in the light of the
                    provisions of the Imperial Constitution, is understood to be inapplicable in so
                    far as Japan is concerned.</p>
                <closer><dateline rendition="#float-left"><date calendar="japanese-nengō"
                            when="1929-06-27"><hi rendition="#small-caps">June</hi> 27, 4 <hi
                                rendition="#small-caps">Showa</hi>
                    (1929)</date>.</dateline></closer>
            </div>
        </body>
    </text>
