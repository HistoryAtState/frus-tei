                <pb facs="0375" n="257" sameAs="frus:frus1929v03/pg257"/>

                <note rend="inline" type="source">811.3394/88: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Chargé in Japan</hi> (<hi rendition="#italic"
                            >Neville</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1929-04-26T15:00:00-05:00">April 26, 1929—3
                    p.m.</date></dateline></opener>
                <p>36. Your 43, April 24.<anchor n="37" xml:id="d268-f1"/> Advise Foreign Office
                    informally and orally that <hi rendition="#italic">Asheville</hi> will not visit
                    any Japanese mandated islands on her return to the United States from
                    Manila.</p>
                <closer><signed><hi rendition="#small-caps">Stimson</hi></signed></closer>
            </div>
        </body>
    </text>
