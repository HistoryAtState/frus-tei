                <pb facs="0972" n="854" sameAs="frus:frus1929v03/pg854"/>

                <note rend="inline" type="source">811.7331A15/19: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Chargé in Venezuela</hi> (<hi rendition="#italic"
                            >Engert</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1929-05-17T17:00:00-04:00">May 17, 1929—5
                    p.m.</date></dateline></opener>
                <p>16. If you believe such action necessary you may informally remind the Venezuelan
                    Government as suggested in confidential paragraph your telegram No. 36 of May
                    13, 10 a.m.</p>
                <closer><signed><hi rendition="#small-caps">Stimson</hi></signed></closer>
            </div>
        </body>
    </text>
