    <text>
        <body>
            <div xml:id="d563">

                <pb facs="0597" n="479" sameAs="frus:frus1929v03/pg479"/>

                <note rend="inline" type="source">711.12155/358</note>
                <head><hi rendition="#italic">The Secretary of State to the Mexican Ambassador</hi>
                        (<hi rendition="#italic">Téllez</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1930-01-07">January 7, 1930</date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Ambassador</hi>: Referring to a telephone
                    conversation on the fourth instant between a member of your staff and an officer
                    of this Department, with reference to your note of May 31, 1929, I desire to
                    inform you that this Government has determined to hold the matter of selecting a
                    site for a federal building in El Paso in abeyance for the time being.</p>
                <p>I am [etc.]</p>
                <closer><signed>J. P. <hi rendition="#small-caps">Cotton</hi></signed></closer>
            </div>
        </body>
    </text>
