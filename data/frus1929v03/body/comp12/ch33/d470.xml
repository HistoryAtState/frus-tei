                <pb facs="0514" n="396" sameAs="frus:frus1929v03/pg396"/>

                <note rend="inline" type="source">812.00Sonora/700: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Mexico</hi> (<hi rendition="#italic"
                        >Morrow</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1929-04-16T17:00:00-06:00">April 16, 1929—5
                        p.m.</date><lb/>[Received 6:34 p.m.]</dateline></opener>
                <p>210. Your 288, April 15, 7 p.m.<anchor n="50" xml:id="d470-f1"/> I have addressed
                    a formal note to the Minister for Foreign Affairs in accordance with your
                    instructions and will also speak to the President on the subject this
                    afternoon.</p>
                <closer><signed><hi rendition="#small-caps">Morrow</hi></signed></closer>
            </div>
        </body>
    </text>
