    <text>
        <body>
            <div xml:id="d376">

                <pb facs="0459" n="341" xml:id="pg341"/>

                <note rend="inline" type="source">612.0023/91</note>
                <head><hi rendition="#italic">The Mexican Ambassador</hi> (<hi rendition="#italic"
                        >Téllez</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><seg rendition="#center">[Translation]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1929-03-04">March 4, 1929</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Mr. Secretary</hi>: With reference to my note of this
                    date I have the honor to inform Your Excellency in compliance with special
                    instructions which I have received from my Government that the closing of all
                    frontier ports of the State of Sonora has been decreed.</p>
                <p>I avail myself [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Manuel C. Téllez</hi></signed></closer>
            </div>
        </body>
    </text>
