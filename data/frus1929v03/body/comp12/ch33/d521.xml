            <div xml:id="d521">

                <pb facs="0549" n="431" sameAs="frus:frus1929v03/pg431"/>

                <note rend="inline" type="source">812.113/10580a</note>
                <head><hi rendition="#italic">The Acting Secretary of State to Consular Officers in
                        Mexico</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1929-08-08">August 8, 1929</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sirs</hi>: There is enclosed herewith, for your
                    information, a copy of the Proclamation issued by the President on July 18,
                    1929, lifting the embargo which had been in force since January 7, 1924, on the
                    exportation of arms and munitions of war to Mexico. Accordingly, Department of
                    State licenses to export such material to Mexico are no longer required.</p>
                <p>I am [etc.]</p>
                <closer><signed>J. P. <hi rendition="#small-caps">Cotton</hi></signed></closer>



                <xi:include href="d521-a1.xml" xpointer="d521-a1"/>
            </div>
