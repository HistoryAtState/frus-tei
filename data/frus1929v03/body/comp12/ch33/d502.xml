            <div xml:id="d502">

                <pb facs="0532" n="414" sameAs="frus:frus1929v03/pg414"/>

                <note rend="inline" type="source">812.512/3496: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Mexico</hi> (<hi rendition="#italic">Morrow</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1929-05-04T12:00:00-06:00">May 4, 1929—noon</date>.<lb/>[Received
                        4:56 p.m.]</dateline></opener>
                <p>237. Department’s 356, May 3, 6 [<hi rendition="#italic">5</hi>] p.m. Embassy
                    again discussed question of taxation with Foreign Office immediately upon the
                    receipt of Consul Damm’s telegram of May second<anchor n="73" xml:id="d502-f1"/>
                    and is today complying with your instructions under reference.</p>
                <closer><signed><hi rendition="#small-caps">Morrow</hi></signed></closer>
            </div>
        </body>
    </text>
