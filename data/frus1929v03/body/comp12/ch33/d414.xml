    <text>
        <body>
            <div xml:id="d414">

                <pb facs="0484" n="366" sameAs="frus:frus1929v03/pg366"/>

                <note rend="inline" type="source">812.113/10465: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Consul at Nogales</hi> (<hi
                            rendition="#italic">Damm</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1929-03-16T13:00:00-05:00">March 16, 1929—1
                    p.m.</date></dateline></opener>
                <p>For American Consul at Guaymas.</p>
                <p>Your March 13, 5 p.m.<anchor n="20" xml:id="d414-f1"/> Department has no
                    objection to exportation of fuel oil to Mexico in accordance with plan outlined
                    by you.</p>
                <closer><signed><hi rendition="#small-caps">Clark</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d414-f1" n="20" xml:id="d414-f1-content">
                <p>See telegram of March 14, noon, from the Consul at Nogales, <ref target="#pg363"
                        >p. 363</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
