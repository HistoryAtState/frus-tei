    <text>
        <body>
            <div xml:id="d519">

                <pb facs="0548" n="430" sameAs="frus:frus1929v03/pg430"/>

                <note rend="inline" type="source">812.113/10572: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Mexico</hi> (<hi rendition="#italic">Morrow</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1929-07-16T12:00:00-06:00">July 16,
                        1929—noon</date>.<lb/>[Received 3:22 p.m.]</dateline></opener>
                <p>287. Your 409, July 2, 1 p.m. and my 283, July 3, noon.<anchor n="90"
                        xml:id="d519-f1"/> Yesterday the Acting Minister for Foreign Affairs
                    requested orally on <pb facs="0549" n="431" xml:id="pg431"/> behalf of the
                    Government of Mexico that the American embargo on the shipment of arms to Mexico
                    be lifted.</p>
                <closer><signed><hi rendition="#small-caps">Morrow</hi></signed></closer>
            </div>
        </body>
    </text>
