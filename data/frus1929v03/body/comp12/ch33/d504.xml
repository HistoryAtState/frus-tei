            <div xml:id="d504">

                <pb facs="0533" n="415" sameAs="frus:frus1929v03/pg415"/>

                <note rend="inline" type="source">612.0023/90</note>
                <head><hi rendition="#italic">The Mexican Ambassador</hi> (<hi
                            rendition="#italic">Téllez</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><seg rendition="#center">[Translation]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1929-05-07">May 7, 1929</date>.</dateline>
                    <seg rendition="#float-left">No. 2822</seg></opener>
                <p><hi rendition="#small-caps">Mr. Secretary</hi>: I have the honor to inform Your
                    Excellency that according to instructions received from my Government the
                    Customhouses at Nogales, Agua Prieta, and Guaymas, have been newly reopened to
                    international traffic.</p>
                <p>Accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Manuel C. Téllez</hi></signed></closer>
            </div>
        </body>
    </text>
