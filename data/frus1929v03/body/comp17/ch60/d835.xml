    <text>
        <body>
            <div xml:id="d835">

                <pb facs="0839" n="721" sameAs="frus:frus1929v03/pg721"/>

                <note rend="inline" type="source">811f.244/107</note>
                <head><hi rendition="#italic">The Chargé in Panama</hi> (<hi
                            rendition="#italic">Muse</hi>) <hi rendition="#italic">to the
                            Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Panama</hi></placeName>, <date calendar="gregorian"
                            when="1929-05-20">May 20, 1929</date>.<lb/>[Received May 27.]</dateline>
                    <seg rendition="#float-left">No. 2027</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to my telegram No. 55 of May
                    19, 6 P.M.,<anchor n="8" xml:id="d835-f1"/> and previous correspondence
                    concerning the Panaman protest against certain sales made by the Canal
                    Commissaries, I have the honor to transmit herewith copies of the Legation’s
                    correspondence with the Panaman Secretary of Foreign Relations on the
                        subject<anchor n="9" xml:id="d835-f2"/> since Despatch <pb facs="0840"
                        n="722" xml:id="pg722"/> No. 1998 of April 22, 1929, to the Department,
                    together with an English translation of Señor Arosemena’s note.</p>
                <p rendition="#center">. . . . . . .</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Benjamin Muse</hi></signed></closer>


                <xi:include href="d835-a1.xml" xpointer="d835-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d835-f1" n="8" xml:id="d835-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d835-f2" n="9" xml:id="d835-f2-content">
                <p>Only the note of May 16 from the Panaman Minister for Foreign Affairs is
                    printed.</p>
            </note>
        </listAnnotation>
