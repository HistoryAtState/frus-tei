    <text>
        <body>
            <div xml:id="d338">

                <pb facs="0433" n="315" xml:id="pg315"/>

                <note rend="inline" type="source">882.5048/123: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Liberia</hi> (<hi
                            rendition="#italic">Wharton</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Monrovia</hi></placeName>, <date calendar="gregorian"
                            when="1929-11-17T09:00:00-00:44">November 17, 1929—9
                        a.m.</date><lb/>[Received 3:20 p.m.]</dateline></opener>
                <p>64. Senator Tubman<anchor n="33" xml:id="d338-f1"/> informs me slavery convention
                    ratified by Senate last Wednesday.<anchor n="34" xml:id="d338-f2"/></p>
                <closer><signed><hi rendition="#small-caps">Wharton</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d338-f1" n="33" xml:id="d338-f1-content">
                <p>Senator William V. S. Tubman, Maryland County, Liberia.</p>
            </note>
            <note corresp="#d338-f2" n="34" xml:id="d338-f2-content">
                <p>November 13, 1929.</p>
            </note>
