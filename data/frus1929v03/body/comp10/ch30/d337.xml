    <text>
        <body>
            <div xml:id="d337">

                <pb facs="0431" n="313" xml:id="pg313"/>

                <note rend="inline" type="source">882.5048/217</note>
                <head><hi rendition="#italic">Mr. N. E. Nelson of
                        the Firestone Tire &amp; Rubber Company to Mr. Henry
                            Carter of the Division of Western European
                    Affairs</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Akron</hi></placeName>, <date calendar="gregorian"
                            when="1929-11-15">15 November, 1929</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. Carter</hi>: Mr. Firestone, Jr.,<anchor
                        n="30" xml:id="d337-f1"/> before sailing for Europe, instructed me to send
                    the enclosed to you, which outlines the position of the Firestone Company with
                    reference to the proposed inquiry on forced labor conditions in Liberia.</p>
                <p>Very truly yours,</p>
                <closer><signed>N. E. <hi rendition="#small-caps">Nelson</hi></signed></closer>


                <xi:include href="d337-a1.xml" xpointer="d337-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d337-f1" n="30" xml:id="d337-f1-content">
                <p>Harvey S. Firestone, Jr., vice president of the Firestone Plantations Company in
                    Liberia and of the Firestone Tire &amp; Rubber Company, Akron, Ohio.</p>
            </note>
        </listAnnotation>
    </standOff>
