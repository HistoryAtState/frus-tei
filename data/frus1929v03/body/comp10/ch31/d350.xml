                <pb facs="0440" n="322" sameAs="frus:frus1929v03/pg322"/>

                <note rend="inline" type="source">882.124A/43: Telegram</note>
                <head><hi rendition="#italic">The Chargé in France</hi> (<hi
                            rendition="#italic">Armour</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1929-07-19T16:00:00+01:00">July 19, 1929—4
                        p.m.</date><lb/>[Received July 19—2:08 p.m.]</dateline></opener>
                <p>342. Department’s 228, July 11, 2 p.m. Foreign Office states French Consulate at
                    Monrovia has been requested to support representations made by our
                    representative there.</p>
                <closer><signed><hi rendition="#small-caps">Armour</hi></signed></closer>
            </div>
        </body>
