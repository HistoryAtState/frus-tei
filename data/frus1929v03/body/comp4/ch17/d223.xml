                <pb facs="0329" n="211" sameAs="frus:frus1929v03/pg211"/>

                <note rend="inline" type="source">123R914/125: Telegram</note>
                <head><hi rendition="#italic">The High Commissioner in Haiti</hi> (<hi rendition="#italic">Russell</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Port-au-Prince</hi></placeName>, <date calendar="gregorian"
                            when="1929-03-25T13:00:00-05:00">March 25, 1929—1
                        p.m.</date><lb/>[Received 8:33 p.m.]</dateline></opener>
                <p>24. Unless otherwise instructed I propose to withhold action on the Department’s
                    instruction number 406, March 14, 1929, sending a request for reconsideration of
                    certain features therein contained. My despatch discussing these features will
                    be forwarded by next pouch.</p>
                <closer><signed><hi rendition="#small-caps">Russell</hi></signed></closer>
            </div>
        </body>
    </text>
