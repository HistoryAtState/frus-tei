    <text>
        <body>
            <div xml:id="d9">

                <pb facs="0046" n="36" sameAs="frus:frus1902app1/pg36"/>

                <head>No. 5527.—<hi rendition="#small-caps">United States of America.</hi></head>
                <p rendition="#center"><hi rendition="#small-caps">department of state.</hi></p>
                <p rendition="#flush"><hi rendition="#italic">To all to whom these presents shall
                        come, greeting:</hi></p>
                <p>I certify that the documents hereto annexed are true copies from the files of
                    this Department. In testimony whereof I, John Hay, Secretary of State for the
                    United States, have hereunto subscribed my name and caused the seal of the
                    Department of State to be affixed.</p>
                <closer>
                    <dateline rendition="#float-left">Done at the city of
                            <placeName>Washington</placeName>, <date
                            calendar="gregorian us-republic" when="1900-09-01">this 1st day of
                            September, A. D. 1900, and of the Independence of the United States of
                            America the one hundred and twenty-fifth</date>.</dateline>
                    <lb/>
                    <signed><hi rendition="#small-caps">John Hay.</hi></signed>
                    <lb/>
                    <seg rendition="#float-left">[Seal of the Department of State of the United
                        States of America.]</seg>
                </closer>
                <postscript>
                    <p>(For certification of Exhibits F and G.)</p>
                </postscript>
            </div>
        </body>
    </text>
