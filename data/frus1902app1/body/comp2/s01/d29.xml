    <text>
        <body>
            <div xml:id="d29">

                <pb facs="0063" n="53" sameAs="frus:frus1902app1/pg53"/>

                <head>EXHIBIT V.</head>
                <opener>
                    <dateline rendition="#float-right">[<date
                            ana="#date_undated-inferred-from-document-content" calendar="gregorian"
                            type="content-date" when="1892-09-10">September 10,
                        1892</date>]</dateline>
                </opener>
                <p rendition="#flush">In the matter of the claim of the United States of America
                    against the Empire of Russia on account of the claim of J. and W. R. Wing,
                    agents and managing owners of the bark <hi rendition="#italic">Cape Horn
                        Pigeon</hi>, for damages arising out of the seizure of said bark in the
                    Okhotsk Sea by an officer of the Russian navy on the 10th day of September,
                    1892.</p>



