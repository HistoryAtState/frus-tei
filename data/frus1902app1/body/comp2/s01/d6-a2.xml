    <text>
        <body>
            <div xml:id="d6-a2">

                <pb facs="0042" n="32" sameAs="frus:frus1902app1/pg32"/>

                <p>I, Thomas Scullan, master of the said bark <hi rendition="#italic">Cape Horn
                        Pigeon</hi>, do solemnly, sincerely, and truly swear that the within list
                    contains the names of all the crew of the said bark, together with the places of
                    their birth and residence, as far as I can ascertain the same.</p>
                <closer><signed><hi rendition="#small-caps">Thomas Scullun</hi>, <hi
                            rendition="#italic">Master.</hi></signed><lb/><hi
                        rendition="#small-caps">Port of San Francisco</hi>.</closer>
                <closer>
                    <dateline rendition="#float-left">Sworn to and subscribed <date
                            calendar="gregorian" when="1891-12-07">this 7th day of December,
                            1891</date>, before me.</dateline>
                    <lb/>
                    <signed><hi rendition="#small-caps">M. Webber</hi>, <lb/>
                        <hi rendition="#italic">Deputy Collector.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
