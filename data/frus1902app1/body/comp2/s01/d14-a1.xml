    <text>
        <body>
            <div xml:id="d14-a1">

                <pb facs="0049" n="39" sameAs="frus:frus1902app1/pg39"/>

                <opener>
                    <dateline rendition="#float-right"><hi rendition="#small-caps">Embassy of the
                            United States of America</hi>, <lb/>
                        <placeName><hi rendition="#italic">St. Petersburg,
                        Russia</hi></placeName>.</dateline>
                </opener>
                <p>I, Herbert J. Hagerman, second secretary of the embassy of the United States of
                    America, do hereby certify that I have compared the foregoing copy of a telegram
                    with the original now on file in this embassy, and that the same is a correct
                    trancript therefrom and of the whole of said original.</p>
                <closer>
                    <dateline rendition="#float-left">In testimony whereof I have hereunto set my
                        hand and affixed the seal of the embassy of the United States <date
                            calendar="gregorian" when="1900-02-17">this 17th day of February, in the
                            year 1900</date>.</dateline>
                    <lb/> [<hi rendition="#small-caps">seal.</hi>] <signed><hi
                            rendition="#small-caps">Herbert J. Hagerman</hi>,<lb/><hi
                            rendition="#italic">Second Secretary, United States
                        Embassy.</hi></signed></closer>
            </div>
        </body>
