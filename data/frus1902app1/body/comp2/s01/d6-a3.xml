        <body>
            <div xml:id="d6-a3">

                <pb facs="0042" n="32" sameAs="frus:frus1902app1/pg32"/>

                <head>[General customs regulations of 1884, art. 192.]</head>
                <p>I do certify that the within is a true copy of the list of the crew of the bark
                        <hi rendition="#italic">Cape Horn Pigeon</hi>, New Bedford, whereof Thomas
                    Scullan is master, taken from the original on file in this office.</p>
                <closer>
                    <dateline rendition="#float-left">Given under my hand and seal of office, at the
                        custom-house, <date calendar="gregorian" when="1891-12-07">this 7th day of
                            December, in the year of our Lord 1891</date>.</dateline>
                    <lb/>
                    <seg rendition="#float-left">[<hi rendition="#small-caps">seal.</hi>]</seg>
                    <signed rendition="#float-right"><hi rendition="#small-caps">M.
                            Webber</hi>,<lb/><hi rendition="#italic">Deputy
                    Collector.</hi></signed></closer>
            </div>
        </body>
    </text>
