    <text>
        <body>
            <div xml:id="d25-a1">

                <pb facs="0060" n="50" sameAs="frus:frus1902app1/pg50"/>

                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States of America,<lb/>St. Petersburg,
                                Russia</hi>.</placeName></dateline></opener>
                <p>I, Herbert J. Hagerman, second secretary of the embassy of the United States of
                    America, do hereby certify that I have compared the foregoing copy of a note
                    addressed to the Imperial Russian Ministry of Foreign Affairs by the Legation of
                    the United States at St. Petersburg, Russia, with the original as entered in the
                    archives of this Embassy and now on file, and that the same is a correct
                    transcription of the original as so entered, and of the whole thereof.</p>
                <closer>
                    <dateline rendition="#float-left">In testimony whereof I have hereunto set my
                        hand and affixed the seal of this embassy <date calendar="gregorian"
                            when="1900-02-17">this 17th day of February, 1900</date>.</dateline>
                    <lb/> [<hi rendition="#small-caps">seal.</hi>] <signed><hi
                            rendition="#small-caps">Herbert J. Hagerman</hi>,<lb/><hi
                            rendition="#italic">Second Secretary United States
                        Embassy.</hi></signed></closer>
            </div>
        </body>
