    <text>
        <body>
            <div xml:id="d5-a1">

                <pb facs="0041" n="31" sameAs="frus:frus1902app1/pg31"/>

                <opener>
                    <seg rendition="#float-left">[Seal of the United States Treasury.]</seg>
                    <dateline rendition="#float-right"><hi rendition="#small-caps">District of
                                <placeName>San Francisco</placeName>, Port of San Francisco,
                            Collector’s Office</hi>[, <date
                            ana="#date_undated-inferred-from-document-content" calendar="gregorian"
                            when="1893-02-28">February 28, 1893</date>].</dateline>
                </opener>
                <p>I hereby certify the within to be a true copy of the original on record in this
                    office. Given under my hand and seal this 28th day of February, 1893.</p>
                <closer>
                    <seg rendition="#float-left">(Signed)</seg>
                    <signed rendition="#float-right"><hi rendition="#small-caps">M. Webber</hi>, <hi
                            rendition="#italic">Collector</hi>. <seg rendition="#float-right">[<hi
                                rendition="#small-caps">seal.</hi>]</seg></signed>
                </closer>
                <postscript>
                    <p>(Cat. No. 335.)—Registry of <hi rendition="#italic">Cape Horn
                        Pigeon</hi>.</p>
                    <p>Copy of certificate of registry:</p>
                    <p>No . . . . . . . . . . . . Memorial of J. and W. R. Wing, <lb/> of the . . .
                        . . . . . . . . . . . . . . . . . Agents <hi rendition="#italic">Cape Horn
                            Pigeon</hi>, <lb/> called the . . . . . . . . . . . . . . . . </p>
                </postscript>
            </div>
