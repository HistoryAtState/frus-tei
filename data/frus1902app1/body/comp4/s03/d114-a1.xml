    <text>
        <body>
            <div xml:id="d114-a1">

                <pb facs="0273" n="251" sameAs="frus:frus1902app1/pg251"/>

                <p rendition="#flush"><hi rendition="#small-caps">Office of the Clerk of the
                        Superior Court</hi>,<lb/><hi rendition="#italic">City and County of San
                        Francisco, State of California, ss:</hi></p>
                <p>I, Wm. J. Ruddick, county clerk and ex officio clerk of the superior court, in
                    and for the city and county of San Francisco, State of California, said court
                    being a court of record, having common law jurisdiction, and a clerk and seal,
                    do certify that the above is a true copy of the act of naturalization of Andrew
                    Olson, as the same appears upon the records of said court now in my office.</p>
                <closer>
                    <dateline rendition="#float-left">In testimony whereof I have hereunto set my
                        hand and affixed the seal of said court <date calendar="gregorian"
                            when="1888-03-05">this 5th day of March, in the year of our Lord one
                            thousand eight hundred and eighty-eight and in the year of our
                            Independence the one hundred and twelfth</date>.</dateline>
                    <lb/> (Stamped) <signed><hi rendition="#small-caps">Wm. J. Ruddick</hi>, <hi
                            rendition="#italic">Clerk.</hi></signed><lb/><seg
                        rendition="#float-left">[<hi rendition="#small-caps">seal.</hi>]</seg> By
                            <signed><hi rendition="#small-caps">Bert M. Nulty</hi>, <hi
                            rendition="#italic">Deputy Clerk.</hi></signed></closer>
            </div>
        </body>
