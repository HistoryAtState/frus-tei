    <text>
        <body>
            <div xml:id="d86-a1">

                <pb facs="0246" n="226" sameAs="frus:frus1902app1/pg226"/>

                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >State of California, Department of
                        State.</hi></placeName></dateline></opener>
                <p>I, C. F. Curry, secretary of state of the State of California, do hereby certify
                    that I have carefully compared the annexed copy of certificate of incorporation
                    of Eagle Fishing Company with the original now in my office, and that the same
                    is a correct transcript therefrom, and of the whole thereof. Also, that this
                    authentication is in due form and by the proper officer.</p>
                <closer>
                    <dateline rendition="#float-left">Witness my hand and the great seal of state,
                        at office in <placeName>Sacramento, Cal.</placeName>, <date
                            calendar="gregorian" when="1900-09-08">the 8th day of September, A. D.
                            1900</date>.</dateline>
                    <lb/>
                    <signed><hi rendition="#small-caps">C. F. Curry</hi>, <hi rendition="#italic"
                            >Secretary of State.</hi></signed>
                    <lb/>
                    <seg rendition="#float-left">[The great seal of the State of California.]</seg>
                </closer>
                <lb/>
                <postscript>
                    <p>10 cent stamp.</p>
                    <p>9/8/1900.</p>
                    <p>C. F. C.</p>
                </postscript>
            </div>
        </body>
