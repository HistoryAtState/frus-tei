    <text>
        <body>
            <div xml:id="d91-a1">

                <pb facs="0249" n="229" sameAs="frus:frus1902app1/pg229"/>

                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Office of the Clerk of the Superior
                        Court</hi></placeName>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">City and County of San
                        Francisco</hi>, <hi rendition="#italic">State of California, ss:</hi></p>
                <p>I, William J. Blattner, county clerk and ex officio clerk of the superior court
                    in and for the city and county of San Francisco, State of California, said court
                    being a court of record, having common-law jurisdiction and a clerk and seal, do
                    certify that the above is a true copy of the act of naturalization of Niels
                    Wolfgang as the same appears upon the records of said court now in my
                    office.</p>
                <closer>
                    <dateline rendition="#float-left">In testimony whereof I have hereunto set my
                        hand and affixed the seal of said court <date calendar="gregorian"
                            when="1892-04-26">this 26th day of April, in the year of our Lord one
                            thousand eight hundred and ninety-two, and in the year of our
                            Independence the one hundred and sixteenth</date>.</dateline>
                    <lb/> [<hi rendition="#small-caps">seal.</hi>] <signed><hi
                            rendition="#small-caps">Wm. J. Blattner</hi>, <hi rendition="#italic"
                            >Clerk</hi></signed>,<lb/>By <signed><hi rendition="#small-caps">Geo. S.
                            McComb</hi>. <hi rendition="#italic">Deputy
                    Clerk.</hi></signed></closer>
            </div>
        </body>
