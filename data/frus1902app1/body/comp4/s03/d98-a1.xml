                <pb facs="0264" n="244" sameAs="frus:frus1902app1/pg244"/>

                <p rendition="#flush"><hi rendition="#small-caps">State of Washington</hi>,<lb/><hi
                        rendition="#italic">County of Jefferson, City of Port Townsend, ss:</hi></p>
                <p>I hereby certify the above and foregoing to be a true copy of protest against the
                    capture of schooner <hi rendition="#italic">C. H. White</hi>, of San Francisco,
                    now on file in my office.</p>
                <closer>
                    <seg rendition="#float-left">[<hi rendition="#small-caps">seal.</hi>]</seg>
                    <signed rendition="#float-right"><hi rendition="#small-caps">James G. Swan</hi>, <lb/>
                        <hi rendition="#italic">Notary Public, Washington, residing in Port
                            Townsend.</hi></signed></closer>
            </div>
        </body>
