                        <cell>Do.</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right #middle">Triumph</cell>
                        <cell rendition="#border-right #nowrap">July 11, 1889</cell>
                        <cell rendition="#border-right">
                            <table>
                                <row>
                                    <cell role="brace" rows="2">{</cell>
