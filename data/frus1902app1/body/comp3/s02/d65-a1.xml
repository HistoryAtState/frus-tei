    <text>
        <body>
            <div xml:id="d65-a1">

                <pb facs="0217" n="197" sameAs="frus:frus1902app1/pg197"/>

                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States of America,<lb/>St. Petersburg,
                                Russia</hi>.</placeName></dateline></opener>
                <p>I, Herbert H. D. Peirce, first secretary of the embassy of the United States of
                    America at St. Petersburg, Russia, do hereby certify that I have compared the
                    foregoing copy of a memorandum of the embassy of the United States at St.
                    Petersburg with the copy of the said memorandum now on record in the archives of
                    this embassy, and that the same is a correct transcription therefrom and of the
                    whole of said memorandum, and of a memorandum which the ambassador of the United
                    States handed to the officials of the Imperial Russian ministry of foreign
                    affairs in my presence, and left with said official.</p>
                <closer>
                    <dateline rendition="#float-left">In testimony whereof I have hereunto set my
                        hand and affixed the seal of the embassy of the United States <date
                            calendar="gregorian" when="1900-03-08">this 8th day of March in the year
                            1900</date>.</dateline>
                    <lb/> [<hi rendition="#small-caps">seal.</hi>] <signed><hi
                            rendition="#small-caps">Herbert H. D. Peirce</hi>,<lb/><hi
                            rendition="#italic">Secretary of United States
                    Embassy.</hi></signed></closer>
            </div>
        </body>
