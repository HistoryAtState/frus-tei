    <text>
        <body>
            <div xml:id="d74">

                <pb facs="0224" n="204" xml:id="pg204"/>

                <head>EXHIBIT T.</head>
                <p rendition="#flush"><hi rendition="#small-caps">State of California</hi>, <hi
                        rendition="#italic">City and County of San Francisco:</hi></p>
                <p>Max Waizman, being first duly sworn, deposes and says: That he is a resident of
                    the city and county of San Francisco, State of California, and was, on the 2d
                    day of August, 1891, the sole owner of the American schooner <hi
                        rendition="#italic">James Hamilton Lewis</hi>, and was on the 2d day of
                    August, 1891, the date of the seizure of said schooner, a citizen of the United
                    States of America.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Max Waizman.</hi></signed>
                </closer>
                <closer>
                    <dateline rendition="#float-left">Subscribed and sworn to before me this <date
                            calendar="gregorian" when="1893-12-29">29th day of December, A. D.
                            1893</date>.</dateline>
                    <lb/>
                    <seg rendition="#float-left">[<hi rendition="#small-caps">seal.</hi>]</seg>
                    <signed rendition="#float-right"><hi rendition="#small-caps">J. S.
                            Manley</hi>,<lb/><hi rendition="#italic">Commissioner U. S. Circuit
                            Court, Northern District of California.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
