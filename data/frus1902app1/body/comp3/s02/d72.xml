    <text>
        <body>
            <div xml:id="d72">

                <pb facs="0222" n="202" xml:id="pg202"/>

                <head>EXHIBIT R.</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Treasury Department</hi></placeName>, <date calendar="gregorian"
                            when="1900-04-05"><hi rendition="#italic">April 5,
                        1900</hi></date>.</dateline>
                </opener>
                <p rendition="#center"><hi rendition="#small-caps">United States of
                    America.</hi></p>
                <p>Pursuant to section 882 of the Revised Statutes, I hereby certify that the
                    annexed are true and correct copies of the records in this Department.</p>
                <p>In witness whereof I have hereunto set my hand and caused the seal of the
                    Treasury Department to be affixed on the day and year first above written.</p>
                <closer>
                    <seg rendition="#float-left">[<hi rendition="#small-caps">seal.</hi>]</seg>
                    <signed rendition="#float-left"> __________ <lb/>
                        <hi rendition="#italic">Secretary of the Treasury.</hi>
                        <lb/>
                        <list>
                            <item>S. J.</item>
                            <item>S. M. G.</item>
                        </list>
                    </signed>
                </closer>



