    <text>
        <body>
            <div xml:id="d72-a1">

                <pb facs="0222" n="202" sameAs="frus:frus1902app1/pg202"/>

                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Treasury Department, Bureau of Navigation</hi>,<lb/><hi
                                rendition="#italic">Washington, D. C.</hi></placeName>, <date
                            calendar="gregorian" when="1900-04-05"><hi rendition="#italic">April 5,
                                1900</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to your letter dated the 4th
                    instant, I transmit herewith a certified copy of a record in this Department
                    relating to the time of certain yacht races in the United States.</p>
                <p>Respectfully,</p>
                <closer><signed><hi rendition="#small-caps">T. R. Sanders</hi>,<lb/><hi
                            rendition="#italic">Acting Commissioner.</hi></signed></closer>
                <postscript>
                    <p>Mr. <hi rendition="#small-caps">Geo. R. Tingle</hi>,<lb/><hi
                            rendition="#italic">Room 3, 1008 F Street NW., Washington, D.
                        C.</hi></p>
                </postscript>
            </div>
        </body>
