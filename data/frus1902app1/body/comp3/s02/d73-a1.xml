                <pb facs="0223" n="203" sameAs="frus:frus1902app1/pg203"/>

                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >District of San Francisco, Port of San Francisco,<lb/>Collector’s
                                Office</hi></placeName> [<date
                            ana="#date_undated-inferred-from-document-content" calendar="gregorian"
                            when="1900-03-23">March 23, 1900</date>].</dateline></opener>
                <p>I hereby certify the within to be a true copy of the original on record in this
                    office. Given under my hand and seal this 23d day of March, 1900.</p>
                <closer><signed><hi rendition="#small-caps">N. S. Farley</hi>,<lb/><hi
                            rendition="#italic">Deputy Collector.</hi></signed></closer>
                <postscript>
                    <p>[Stamp.]</p>
                    <p>Fee, 20 cents, paid.</p>
                </postscript>
            </div>
