    <text>
        <body>
            <div xml:id="d49">

                <pb facs="0136" n="120" sameAs="frus:frus1902app1/pg120"/>

                <head>EXHIBIT B.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Office of the Collector of Customs.<lb/>Port of San Francisco,
                                Cal.</hi></placeName>,<lb/><date calendar="gregorian"
                            when="1900-03-29"><hi rendition="#italic">March 29,
                        1900</hi></date>.</dateline></opener>
                <p>I hereby certify that the records of this office show that the American schooner
                        <hi rendition="#italic">J. H. Lewis</hi>, A. McLean, master, of 78 tons,
                    cleared at this port for a hunting and fishing voyage on the 7th day of March,
                    1891.</p>
                <closer><signed><hi rendition="#small-caps">N. S. Farley</hi>,<lb/><hi
                            rendition="#italic">Deputy Collector of Customs.</hi></signed></closer>
                <postscript>
                    <p>[<hi rendition="#small-caps">stamp.</hi>]</p>
                    <p>Fee, 20 cents, paid.</p>
                    <closer><dateline rendition="#float-left"><hi rendition="#small-caps">Cashier’s
                                Office, Custom-House</hi>,<lb/><placeName><hi
                                    rendition="#small-caps">San Francisco</hi></placeName>, <date
                                calendar="gregorian" when="1900-03-29"><hi rendition="#italic">March
                                    29, 1900</hi></date>.</dateline></closer>
                </postscript>
            </div>
        </body>
    </text>
