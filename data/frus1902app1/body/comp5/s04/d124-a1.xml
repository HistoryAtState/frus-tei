    <text>
        <body>
            <div xml:id="d124-a1">

                <pb facs="0290" n="268" xml:id="pg268"/>

                <head><hi rendition="#italic">Harry, cabin boy, account current, February 27,
                        1891.</hi></head>
                <table cols="4" rows="9">
                    <row>
                        <cell>Dr.</cell>
                        <cell/>
                        <cell/>
                        <cell>Cr.</cell>
                    </row>
                    <row>
                        <cell>Feb. 27, to advance</cell>
                        <cell rendition="#border-right" role="num">$25.00</cell>
                        <cell>Wages, 7 months at 20 dollars</cell>
                        <cell role="num">$140.00.</cell>
                    </row>
                    <row>
                        <cell>Apr. 30 cash at Yamada</cell>
                        <cell rendition="#border-right" role="num">1.00</cell>
                        <cell>Less 5 days</cell>
                        <cell rendition="#border-bottom" role="num">3.66</cell>
                    </row>
                    <row>
                        <cell>July 5, “ Hakodadi</cell>
                        <cell rendition="#border-right" role="num">31.50</cell>
                        <cell/>
                        <cell role="num">136.34</cell>
                    </row>
                    <row>
                        <cell>” 28, to one cap</cell>
                        <cell rendition="#border-right" role="num">.25</cell>
                        <cell/>
                        <cell rendition="#border-bottom" role="num">3.50</cell>
                    </row>
                    <row>
                        <cell>Aug. 23, allow to cash</cell>
                        <cell rendition="#border-bottom #border-right" role="num">6.00</cell>
                        <cell/>
                        <cell role="num">139.84</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell rendition="#border-right" role="num">63.75</cell>
                        <cell/>
                        <cell rendition="#border-bottom" role="num">73.75</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell rendition="#border-bottom #border-right" role="num">10.00</cell>
                        <cell/>
                        <cell role="num">66.09</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell rendition="#border-right" role="num">73.75</cell>
                        <cell/>
                        <cell/>
                    </row>
                </table>
                <p>Received full payment for sealing voyage of schooner <hi rendition="#italic">Kate
                        and Anna</hi> in 1892.</p>
                <closer><signed><hi rendition="#small-caps">Harry K. Handa.</hi></signed></closer>
            </div>
        </body>
    </text>
