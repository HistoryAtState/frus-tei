    <text>
        <body>
            <div xml:id="d147">

                <pb facs="0329" n="305" sameAs="frus:frus1902app1/pg305"/>

                <head>EXHIBIT VII.</head>
                <opener>
                    <dateline rendition="#float-right">[<date
                            ana="#date_undated-inferred-from-document-content-and-sibling-dates"
                            calendar="gregorian" when="1891-10-20">October 20,
                        1891</date>]</dateline>
                </opener>
                <p rendition="#center"><hi rendition="#small-caps">Annex to the Report No</hi>.
                    489.</p>
                <list>
                    <label>A.</label>
                    <item>Point from which was sighted the schooner <hi rendition="#italic">James
                            Hamilton Lewis.</hi></item>
                    <label>B.</label>
                    <item>Point at which the schooner <hi rendition="#italic">James Hamilton
                            Lewis</hi> lay to and was overhauled by the <hi rendition="#italic"
                            >Aleout.</hi></item>
                    <label>C.</label>
                    <item>Supposed situation of the James <hi rendition="#italic">Hamilton
                            Lewis</hi> when it was sighted by the schooner <hi rendition="#italic"
                            >Aleout.</hi></item>
                </list>
                <closer>(Signed) <signed>Captain of Frigate <hi rendition="#small-caps"
                        >Brandt.</hi></signed></closer>
                <postscript>
                    <p>Certified conformedly.</p>
                    <p><hi rendition="#small-caps">J. Stebline-Kamensky</hi>,<lb/><hi
                            rendition="#italic">Deputy of Jurisconsulate of Minister of
                        Marine.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
