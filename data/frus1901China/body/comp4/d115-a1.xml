    <text>
        <body>
            <div xml:id="d115-a1">

                <pb facs="0176" n="170" sameAs="frus:frus1901China/pg170"/>

                <opener><seg rendition="#center">[Inclosure.—Telegram.]</seg></opener>
                <opener>
                    <seg rendition="#float-left">No. 90.]</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Hankow</hi></placeName>, <date calendar="gregorian"
                            when="1901-05-11"><hi rendition="#italic">May 11,
                        1901</hi></date>.</dateline>
                </opener>
                <p rendition="#flush"><hi rendition="#small-caps">Rockhill</hi>, <hi
                        rendition="#italic">Peking:</hi></p>
                <p>Viceroy requests you suggest policy; also send list of reforms and commercial
                    privileges that powers would accept.</p>
                <closer><signed><hi rendition="#small-caps">Wilcox.</hi></signed></closer>
            </div>
        </body>
    </text>
