    <text>
        <body>
            <div xml:id="d131-a6">

                <pb facs="0223" n="217" sameAs="frus:frus1901China/pg217"/>

                <opener><seg rendition="#center">[Inclosure 4, with instruction 20.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Asiatic Association</hi>,<lb/><hi rendition="#italic">New
                                York</hi></placeName>, <date calendar="gregorian" when="1901-01-25"
                                ><hi rendition="#italic">January 25,
                    1901</hi></date>.</dateline></opener>
                <p rendition="#flush">The <hi rendition="#small-caps">President of the United
                        States.</hi></p>
                <p><hi rendition="#small-caps">Sir</hi>: In compliance with the request made by you
                    to a delegation of this association which had the honor of waiting on you on the
                    3d instant, the executive committee desires me to transmit to you the inclosed
                    memorandum in regard to the revision of the commercial clauses of the treaties
                    with China.</p>
                <p>I have the honor to be, yours, respectfully,</p>
                <closer><signed><hi rendition="#small-caps">John Foord</hi>,<lb/><hi
                            rendition="#italic">Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
