    <text>
        <body>
            <div xml:id="d41">

                <pb facs="0041" n="35" sameAs="frus:frus1901China/pg35"/>

                <head><hi rendition="#italic">Mr. Conger to Mr. Hay.</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 416.]</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking, China</hi></placeName>, <date calendar="gregorian"
                            when="1900-09-20"><hi rendition="#italic">September 20,
                        1900</hi></date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith
                    translation of Prince Ching’s reply to my informal note of the 16th instant
                    regarding the return of the Emperor to Peking, copy of which I transmitted in my
                    No. 413 of the 16th instant.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">E. H. Conger.</hi></signed></closer>


                <xi:include href="d41-a1.xml" xpointer="d41-a1"/>
