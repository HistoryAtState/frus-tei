    <text>
        <body>
            <div xml:id="d166">

                <pb facs="0297" n="291" sameAs="frus:frus1901China/pg291"/>

                <head><hi rendition="#italic">Mr. Rockhill to Mr.
                            Hay.</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 146.]</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Commissioner of the United States to China</hi>,<lb/><hi
                                rendition="#italic">Peking, China</hi></placeName>, <date
                            calendar="gregorian" when="1901-07-31"><hi rendition="#italic">July 31,
                                1901</hi></date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith copy
                    of a note to the dean of the diplomatic corps from the Chinese
                    plenipotentiaries, acknowledging the receipt of the former’s note of the 19th
                    instant (copy sent you in my No. 140) and expressing gratification at the
                    satisfactory settlement of the audience question.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. W. Rockhill</hi>.</signed></closer>


                <xi:include href="d166-a1.xml" xpointer="d166-a1"/>
