            <div xml:id="d179-a12">

                <pb facs="0331" n="325" sameAs="frus:frus1901China/pg325"/>

                <head><hi rendition="#small-caps">Annex No</hi>. 10.</head>
                <p rendition="#center"><hi rendition="#italic">List of cemeteries situated in the
                        neighborhood of Peking and which have been desecrated.</hi></p>
                <table cols="2" rows="4">
                    <row role="label">
                        <cell>British cemetery</cell>
                        <cell>One</cell>
                    </row>
                    <row>
                        <cell>French cemeteries</cell>
                        <cell>Five</cell>
                    </row>
                    <row>
                        <cell>Russian cemetery</cell>
                        <cell rendition="#underline">One</cell>
                    </row>
                    <row>
                        <cell rend="padding-left: 3em;">Total</cell>
                        <cell>Seven</cell>
                    </row>
                </table>
                <closer><hi rendition="#italic">Correct copy</hi>. <lb/><signed><list>
                            <item><hi rendition="#small-caps">A. d’Anthouard.</hi></item>
                            <item><hi rendition="#small-caps">B. Kroupensky</hi>.</item>
                            <item><hi rendition="#small-caps">Reginald Tower</hi>.</item>
                            <item><hi rendition="#small-caps">G. Bohlen-Halbach</hi>.</item>
                        </list></signed></closer>
            </div>
