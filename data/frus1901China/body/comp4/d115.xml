    <text>
        <body>
            <div xml:id="d115">

                <pb facs="0176" n="170" sameAs="frus:frus1901China/pg170"/>

                <head><hi rendition="#italic">Mr. Rockhill to Mr. Hay.</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 90.]</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Commissioner of the United States to China</hi>,<lb/><hi
                                rendition="#italic">Peking, China</hi></placeName>, <date
                            calendar="gregorian" when="1901-05-20"><hi rendition="#italic">May 20,
                                1901</hi></date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith for
                    your information copy of telegraphic correspondence had with the Yangtze
                    Viceroys on the subject of suggested reforms and commercial privileges.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. W. Rockhill.</hi></signed></closer>



                <xi:include href="d115-a1.xml" xpointer="d115-a1"/>
