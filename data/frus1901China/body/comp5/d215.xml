                <pb facs="0361" n="355" sameAs="frus:frus1901China/pg355"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Conger.</hi></head>
                <opener><seg rendition="#center">[Telegram.—Paraphrase.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1900-12-21"><hi rendition="#italic">December
                        21</hi></date>.</dateline></opener>
                <p>(As Mr. Conger has felt obliged to acquiesce in the note retaining the word
                    “irrevocable,” and considering his statement that if he does not sign it will
                    probably result in failure of negotiations, Mr. Hay authorizes him to sign after
                    again stating the views of this Government.)</p>
            </div>
        </body>
    </text>
