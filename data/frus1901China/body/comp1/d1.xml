            <div xml:id="d1">

                <pb facs="0009" n="3" sameAs="frus:frus1901China/pg3"/>

                <head>[Untitled]</head>
                <p rendition="#flush"><hi rendition="#italic">To the Senate and House of
                        Representatives:</hi></p>
                <p>I transmit a report from the Hon. William W. Rockhill, late commissioner to
                    China, of the results of his mission to that country, with accompanying
                    documents.</p>
                <closer><signed><hi rendition="#small-caps">Theodore Roosevelt.</hi></signed>
                    <lb/>
                    <dateline rendition="#float-left"><hi rendition="#small-caps">White
                                House</hi>,<lb/><placeName><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1901-12-11"><hi rendition="#italic">December 11,
                        1901</hi></date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
