    <text>
        <body>
            <div xml:id="d2">

                <pb facs="0009" n="3" sameAs="frus:frus1901China/pg3"/>

                <head>[Untitled]</head>
                <p rendition="#flush">The <hi rendition="#small-caps">President</hi>:</p>
                <p>I have the honor to submit to you, with a view of transmittal to the Congress, if
                    it meet your approval, a report from the Hon. William W. Rockhill, late
                    commissioner to China, of the results of his mission to that country, with
                    accompanying documents.</p>
                <p>Respectfully submitted.</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed>
                    <lb/>
                    <dateline rendition="#float-left"><hi rendition="#small-caps">Department of
                            State</hi>,<lb/><placeName><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1901-12-05"><hi rendition="#italic">December 5,
                        1901</hi></date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
