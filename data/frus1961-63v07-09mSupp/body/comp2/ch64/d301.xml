    <text>
        <body>
            <div xml:id="d301">

                <pb facs="1436" n="1285" xml:id="pg1285"/>

                <head>301. National Intelligence Estimate, NIE 11–8–63, October 18<anchor n="1"
                        xml:id="d301-f1"/>
                </head>
                <opener>
                    <dateline>
                        <date ana="#date_undated-inferred-from-document-head" calendar="gregorian"
                            when="1963-10-18">October 18, 1963</date>
                    </dateline>
                </opener>
                <pb facs="d301-01" n="1" type="facsimile" xml:id="d301-01"/>
                <pb facs="d301-02" n="2" type="facsimile" xml:id="d301-02"/>
                <pb facs="d301-03" n="3" type="facsimile" xml:id="d301-03"/>
                <pb facs="d301-04" n="4" type="facsimile" xml:id="d301-04"/>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>Extreme Sensitivity of NIE 11–8–63, “Soviet Capabilities for Strategic
                        Attack”</item>
                </list>
                <p>1. In accordance with the wishes of the President, dissemination of NIE 11–8–63
                    has been carefully limited because of the extreme sensitivity of the information
                    therein.</p>
                <p>2. In this connection, I wish to stress that there be absolutely no reproduction
                    of this Estimate, and that no revelation of its existence be made to
                    unauthorized persons.</p>
                <closer><signed>John A. McCone</signed>
                    <affiliation>Director</affiliation></closer>
                <pb facs="d301-05" n="5" type="facsimile" xml:id="d301-05"/>
                <pb facs="d301-06" n="6" type="facsimile" xml:id="d301-06"/>



                <xi:include href="d301-a1.xml" xpointer="d301-a1"/>
            </div>
        </body>
    </text>
    <standOff>
