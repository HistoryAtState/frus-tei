    <text>
        <body>
            <div xml:id="d252">

                <pb facs="1067" n="916" xml:id="pg916"/>

                <head>252. Memorandum from McCone to
                    President Kennedy, January 8<anchor
                        n="1" xml:id="d252-f1"/></head>
                <opener>
                    <dateline><date ana="#date_undated-inferred-from-document-head"
                            calendar="gregorian" when="1962-01-08">January 8, 1962</date></dateline>
                    <pb facs="d252-1" n="1" type="facsimile" xml:id="d252-1"/>
                    <salute>Dear Mr. President:</salute>
                </opener>
                <p>The attached memorandum is in response to your request for further information
                    about the Soviet missile program.</p>
                <p>Respectfully,</p>
                <closer>
                    <signed corresp="#p_MJA_1">John A.
                            McCone
                    </signed><affiliation>Director</affiliation>
                </closer>



                <xi:include href="d252-a1.xml" xpointer="d252-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d252-f1" n="1" type="source" xml:id="d252-f1-content">
                <p>Transmits requested information on Soviet missile program. Top Secret. 4 pp.
                        CIA Files, DCI (McCone) Files, Job
                    80B01285A, Mtgs w/Pres, 12/1/61–6/30/62.</p>
            </note>
        </listAnnotation>
    </standOff>
