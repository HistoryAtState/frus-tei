            <div xml:id="d265">

                <pb facs="1096" n="945" sameAs="frus:frus1961-63v07-09mSupp/pg945"/>

                <head>265. Memorandum from the Secretaries to the Joint Chiefs of Staff, April
                        24<anchor n="1" xml:id="d265-f1"/></head>
                <opener>
                    <dateline><date ana="#date_undated-inferred-from-document-head"
                            calendar="gregorian" when="1962-04-24">April 24, 1962</date></dateline>
                </opener>
                <pb facs="d265-01" n="1" type="facsimile" xml:id="d265-01"/>
                <p rendition="#center"><hi rendition="#italic">NUCLEAR SUPERIORITY OF US VIS-À-VIS
                        THE SOVIET UNION</hi></p>
                <p rendition="#center">Reference: JCS 1924/127</p>
                <p>The attached memorandum by the Chairman, Joint Chiefs of Staff, CM–592–62, dated
                    18 April 1962, subject as above, together with its Attachments (Tabs A and B),
                    is circulated for information.</p>
                <closer>
                    <signed>F.J. Blouin</signed>
                    <signed>M.J. Ingelido</signed>
                    <affiliation><hi rendition="#italic">Joint
                    Secretariat</hi></affiliation></closer>


                <pb facs="d265-09" n="9" type="facsimile" xml:id="d265-09"/>


                <pb facs="d265-10" n="10" type="facsimile" xml:id="d265-10"/>



