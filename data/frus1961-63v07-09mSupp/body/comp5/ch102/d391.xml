    <text>
        <body>
            <div xml:id="d391">

                <pb facs="1775" n="1624" sameAs="frus:frus1961-63v07-09mSupp/pg1624"/>

                <head>391. Note from Rusk to Bowles, September 1961<anchor n="1" xml:id="d391-f1"
                    /></head>
                <opener>
                    <dateline>
                        <date ana="#date_undated-inferred-from-document-head" calendar="gregorian"
                            notAfter="1961-09-30T23:59:59-04:00"
                            notBefore="1961-09-01T00:00:00-04:00" when="1961-09">September
                            1961</date>
                    </dateline>
                </opener>
                <pb facs="d391-1" n="1" type="facsimile" xml:id="d391-1"/>
                <p>Thanks. Go ahead — taking into account my comments this AM as a “regional”
                    possibility</p>
                <closer>
                    <signed>DR</signed>
                </closer>

                <pb facs="d391-2" n="2" type="facsimile" xml:id="d391-2"/>



                <xi:include href="d391-a1.xml" xpointer="d391-a1"/>
                <xi:include href="d391-a2.xml" xpointer="d391-a2"/>
