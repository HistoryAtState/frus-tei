    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d391-f1" n="1" type="source" xml:id="d391-f1-content">
                <p>“Go ahead” guidance on coordinated approach to rural development. No
                    classification marking. 7 pp. Two attachments provide background material. Yale
                    University Library, Bowles Papers, Box 300, Folder 536.</p>
            </note>
        </listAnnotation>
    </standOff>
