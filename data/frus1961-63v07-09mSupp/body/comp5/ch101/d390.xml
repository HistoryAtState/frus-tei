    <text>
        <body>
            <div xml:id="d390">

                <pb facs="1774" n="1623" xml:id="pg1623"/>

                <head>390. Note from Pezzullo to May, August 21<anchor n="1" xml:id="d390-f1"
                    /></head>
                <opener>
                    <dateline>
                        <date ana="#date_undated-inferred-from-document-head" calendar="gregorian"
                            when="1961-08-21">August 21, 1961</date>
                    </dateline>
                </opener>
                <pb facs="d390-1" n="1" type="facsimile" xml:id="d390-1"/>
                <p rendition="#section-heading #italic">Draft Reply by Under Secretary to Letter
                    from Sec. Freeman</p>
                <p>U has gone over the history of this correspondence, and does not believe any
                    further reply to Freeman is required at
                    this time. Mr. Bowles and Mr. Freeman have seen each other several times
                    since the letter was written, and the reply as drafted is overtaken by
                    events.</p>
                <closer>
                    <signed>Lawrence Pezzullo</signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d390-f1" n="1" type="source" xml:id="d390-f1-content">
                <p>No reply necessary to correspondence from Secretary Freeman to Mr. Bowles.
                    No subject mentioned. No classification marking. 1 p. Washington National
                    Records Center, RG 286, AID Administrator Files: FRC 65 A
                    481, Agriculture, FY 1962.</p>
            </note>
        </listAnnotation>
    </standOff>
