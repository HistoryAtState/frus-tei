                <pb facs="d360-6" n="6" sameAs="frus:frus1961-63v07-09mSupp/d360-6"/>


                <opener>
                    <dateline><date calendar="gregorian" when="1963-09-03">September 3,
                        1963</date></dateline>
                </opener>
                <pb facs="d360-7" n="7" type="facsimile" xml:id="d360-7"/>
                <p>Attached is a copy of the record of the Under Secretary’s meeting with the
                    Ambassador in Paris on May 31, 1963. Please note that this record has not yet
                    been cleared by the Under Secretary. It is not being distributed outside the
                    Department with the exception of copies sent to the Chiefs of Mission or senior
                    participants represented at the meeting. Accordingly special handling is
                    required.</p>
                <closer>
                    <signed>Benjamin H. Read </signed><affiliation>Executive Secretary</affiliation>
                </closer>
            </div>
        </body>
