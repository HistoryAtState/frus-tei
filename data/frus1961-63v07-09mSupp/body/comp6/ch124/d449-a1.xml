    <text>
        <body>
            <div xml:id="d449-a1">

                <pb facs="d449-4" n="4" xml:id="d449-4"/>


                <dateline><date calendar="gregorian" when="1961-10-07">October 7,
                    1961</date></dateline>
                <p>Dear Howard:</p>
                <p>I attach a comment on your memorandum of October 4. I would be glad to discuss
                    them with you at your convenience.</p>
                <p>Since I will be leaving Wednesday afternoon for ten days or so, it perhaps would
                    be better to try to set it up before then.</p>
                <closer>
                    <signed corresp="#p_KC_1">Carl Kaysen</signed>
                </closer>
            </div>
        </body>
    </text>
