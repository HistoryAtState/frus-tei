    <text>
        <body>
            <div xml:id="d459">

                <pb facs="1980" n="1829" xml:id="pg1829"/>

                <head>459. Letter from Hodges to Ball, September 14<anchor n="1"
                        xml:id="d459-f1"/></head>
                <opener>
                    <dateline>
                        <date ana="#date_undated-inferred-from-document-head" calendar="gregorian"
                            when="1962-09-14">September 14, 1962</date>
                    </dateline>
                    <pb facs="d459-1" n="1" type="facsimile" xml:id="d459-1"/>
                    <salute>Dear George:</salute>
                </opener>
                <p>Attached herewith are the minutes of the President’s Cabinet Textile Advisory
                    Committee held Monday, August 27, 1962, at the White House.</p>
                <p>The delay in getting these to you is regretted.</p>
                <p>Sincerely yours,</p>
                <closer><signed>Luther H.
                        Hodges</signed><affiliation>Secretary of
                    Commerce</affiliation></closer>


                <xi:include href="d459-a1.xml" xpointer="d459-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
