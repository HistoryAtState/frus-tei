    <text>
        <body>
            <div xml:id="d24">

                <pb facs="0254" n="103" sameAs="frus:frus1961-63v07-09mSupp/pg103"/>

                <head>24. Memorandum from Dean to Bundy, August 4<anchor n="1" xml:id="d24-f1"
                    /></head>
                <opener>
                    <dateline>
                        <date ana="#date_undated-inferred-from-document-head" calendar="gregorian"
                            when="1961-08-04">August 4, 1961</date>
                    </dateline>
                </opener>
                <pb facs="d24-1" n="1" type="facsimile" xml:id="d24-1"/>
                <p rendition="#center">MEMORANDUM FOR THE WHITE HOUSE</p>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>Possible public announcement by United States that we would be willing to
                        forego any tests in the atmosphere without the right of inspection or
                        control if the Soviets would do likewise</item>
                </list>
                <p>I attach a memorandum for the President about which you and I spoke on the
                    telephone.</p>
                <closer><signed>Arthur H.
                        Dean</signed><affiliation>Chairman, U.S. Delegation <lb/> Nuclear
                        Test Ban Talks</affiliation></closer>



                <xi:include href="d24-a1.xml" xpointer="d24-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d24-f1" n="1" type="source" xml:id="d24-f1-content">
                <p>Transmits memorandum on disadvantages of a public announcement regarding
                    atmospheric tests. Confidential. 5 pp. Kennedy Library, National Security Files,
                    Departments and Agencies Series, ACDA,
                    Disarmament, Test Ban General, 4/61–8/61.</p>
            </note>
        </listAnnotation>
    </standOff>
