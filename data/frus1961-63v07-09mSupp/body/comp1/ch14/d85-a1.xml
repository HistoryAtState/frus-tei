    <text>
        <body>
            <div xml:id="d85-a1">

                <pb facs="d85-2" n="2" xml:id="d85-2"/>


                <dateline rendition="#float-right">
                    <date ana="#date_undated-inferred-from-document-head" calendar="gregorian"
                        when="1962-02-28">February 28, 1962</date>
                </dateline>
                <p>Dear Mr. President,</p>
                <p>I have been asked to pass to you the enclosed text of the Prime Minister’s reply
                    to your letter of February 27 about Nuclear Tests.</p>
                <p>Yours sincerely,</p>
                <closer><signed>David Ormsby
                    Gore</signed></closer>


