    <text>
        <body>
            <div xml:id="d334-a2">

                <pb facs="1622" n="1471" sameAs="frus:frus1961-63v07-09mSupp/pg1471"/>


                <list type="to">
                    <head>TO</head>
                    <item>U–Mr. Springsteen</item>
                </list>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item><hi rendition="#italic">DOD Balance of Payments Proposals</hi></item>
                </list>
                <p>The attached Memorandum of Conversation with Secretary McNamara was prepared with
                    G/PM. The Under Secretary’s remarks have been sidelined in red. May we have your
                    approval prior to distribution.</p>
                <p>Approve</p>
                <p>Disapprove</p>
                <p>The distribution pattern follows:</p>
                <list subtype="participants" type="description">
                    <label>PARTICIPANTS</label>
                    <item>FE—Mr. Rice</item>
                    <item>EUR—Mr. Davis</item>
                    <item>White House—Mr. Klein</item>
                    <item>Defense—General Vogt</item>
                    <item>Mr. Rowen</item>
                    <item>Treasury—Mr. Dillon</item>
                </list>
            </div>
        </body>
