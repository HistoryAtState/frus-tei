    <text>
        <body>
            <div xml:id="d53">

                <pb facs="0196" n="78" sameAs="frus:frus1889/pg78"/>

                <head><hi rendition="#italic">Mr. Denby to Mr.
                            Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1888-10-20"><hi rendition="#italic">October</hi> 20, 1888</date>.
                        (Received November 30.)</dateline>
                    <seg rendition="#float-left">No. 738.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith an estimate of the
                    population of China, prepared by the imperial maritime customs. It is based on
                    the census of 1879 and 1882.</p>
                <p>Official censuses in China are not entirely accurate.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charles Denby.</hi></signed></closer>



                <xi:include href="d53-a1.xml" xpointer="d53-a1"/>
            </div>
