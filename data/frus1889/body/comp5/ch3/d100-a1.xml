    <text>
        <body>
            <div xml:id="d100-a1">

                <pb facs="0258" n="140" sameAs="frus:frus1889/pg140"/>

                <opener><seg rendition="#center">[Inclosure]</seg></opener>
                <head><hi rendition="#italic">Form of certificate.</hi></head>
                <p>This is to certify that,—— ——, whose description list is given below, has been
                    granted permission by the Government of China to go to the United States; that
                    his occupation is that of a merchant, in which he has been engaged for —— years
                    at —— and that his present place of residence is ——; that his special business
                    as a merchant has been —— and its estimated annual value amounts to —— dollars
                    or taels.</p>
                <p>Signed and sealed this</p>
                <p>[Here follows date and place of certificate.]</p>
                <p rendition="#center"><hi rendition="#italic">Descriptive list.</hi></p>
                <p>Name. (Give individual and tribal family) ——.</p>
                <p>Age ——.</p>
                <p>Height —— feet —— inches.</p>
                <p>Color of eyes ——.</p>
                <p>Physical marks ————.</p>
                <p>Signature ——.</p>
            </div>
        </body>
