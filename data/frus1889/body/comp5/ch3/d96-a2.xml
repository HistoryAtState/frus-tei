            <div xml:id="d96-a2">

                <pb facs="0249" n="131" sameAs="frus:frus1889/pg131"/>

                <opener><seg rendition="#center">[Inclosure 2.—Telegram.]</seg></opener>
                <head><hi rendition="#italic">Mr. Magone to Mr.
                            Fairchild.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >New York</hi></placeName>, <date calendar="gregorian"
                            when="1889-02-28"><hi rendition="#italic">February</hi> 28.
                        1889</date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Secretary of the Treasury</hi>,
                        <hi rendition="#italic">Washington:</hi></p>
                <p>Telegram received, Have not Issued any such order.</p>
                <closer><signed><hi rendition="#small-caps">D. Magone</hi>,<lb/><hi
                            rendition="#italic">Collector</hi>.</signed></closer>
            </div>
        </body>
