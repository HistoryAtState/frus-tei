    <text>
        <body>
            <div xml:id="d96-a3">

                <pb facs="0250" n="132" xml:id="pg132"/>

                <opener><seg rendition="#center">[Inclosure 3.—Telegram.]</seg></opener>
                <head><hi rendition="#italic">Mr. Jonas to Mr. Fairchild.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >New Orleans, La.</hi></placeName>, <date calendar="gregorian"
                            when="1889-03-01"><hi rendition="#italic">March</hi> 1,
                        1889</date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Secretary Treasury</hi>, <hi
                        rendition="#italic">Washington, D. C.:</hi></p>
                <p>No orders issued regarding transit Chinese through the United States.</p>
                <closer><signed><hi rendition="#small-caps">B. F. Jonas</hi>,<lb/><hi
                            rendition="#italic">Collector.</hi></signed></closer>
            </div>
        </body>
    </text>
