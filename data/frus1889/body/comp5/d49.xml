    <text>
        <body>
            <div xml:id="d49">

                <pb facs="0190" n="72" sameAs="frus:frus1889/pg72"/>

                <head><hi rendition="#italic">Mr. Denby to Mr.
                            Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1888-10-01"><hi rendition="#italic">October</hi> 1, 1888</date>.
                        (Received November 16.)</dateline>
                    <seg rendition="#float-left">No. 713.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith a
                    copy of a communication which I addressed to the Tsung-li Yamên on the 27th
                    ultimo, having relation to the Chi-nan-fu case, which has formed the subject of
                    previous dispatches from the legation to the Department.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charles Denby.</hi></signed></closer>


                <xi:include href="d49-a1.xml" xpointer="d49-a1"/>
            </div>
