    <text>
        <body>
            <div xml:id="d72">

                <pb facs="0223" n="105" sameAs="frus:frus1889/pg105"/>

                <head><hi rendition="#italic">Mr. Denby to Mr. Blaine.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1889-03-08"><hi rendition="#italic">March</hi> 8, 1889</date>.
                        (Received, April 23.)</dateline>
                    <seg rendition="#float-left">No 842.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a
                    translation of the reply of the prince and ministers of the foreign office to my
                    communication conveying the felicitations of the President to His Majesty the
                    Emperor, on the occasion of his marriage.</p>
                <p>I have, etc.</p>
                <closer><signed><hi rendition="#small-caps">Charles Denby.</hi></signed></closer>


                <xi:include href="d72-a1.xml" xpointer="d72-a1"/>
            </div>
