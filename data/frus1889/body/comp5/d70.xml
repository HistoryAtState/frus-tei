                <pb facs="0219" n="101" sameAs="frus:frus1889/pg101"/>

                <head><hi rendition="#italic">Mr. Denby to Mr. Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1889-03-05"><hi rendition="#italic">March</hi> 5, 1889</date>.
                        (Received April 23.)</dateline>
                    <seg rendition="#float-left">No. 837.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith the translation of a
                    decree wherein the Empress declines to entertain the proposal that certain
                    memorials should be addressed to her, and severely reprimands and punishes the
                    censor who made the proposal.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charles Denby.</hi></signed></closer>



                <xi:include href="d70-a1.xml" xpointer="d70-a1"/>
            </div>
        </body>
    </text>
