    <text>
        <body>
            <div xml:id="d245">

                <pb facs="0681" n="559" sameAs="frus:frus1889/pg559"/>

                <head><hi rendition="#italic">Mr. Bragg to Mr. Blaine.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1889-03-23"><hi rendition="#italic">March</hi> 23, 1889</date>.
                        (Received April 1.)</dateline>
                    <seg rendition="#float-left">No. 280.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose a synopsis of
                    what would appear to be a very valuable work on Mexico and Mexican affairs.</p>
                <p>As soon as the publication is complete a copy will be forwarded to the
                    Department.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Edw. S. Bragg.</hi></signed></closer>



                <xi:include href="d245-a1.xml" xpointer="d245-a1"/>
            </div>
        </body>
