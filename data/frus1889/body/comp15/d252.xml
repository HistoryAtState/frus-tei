    <text>
        <body>
            <div xml:id="d252">

                <pb facs="0722" n="600" sameAs="frus:frus1889/pg600"/>

                <head><hi rendition="#italic">Mr. Wharton to Mr.
                            Ryan.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1889-07-12"><hi rendition="#italic">July</hi> 12,
                        1889</date>.</dateline>
                    <seg rendition="#float-left">No. 30.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to instruction No. 244 of 19th
                    January, 1888, I transmit a copy of a further statement in the matter of the
                    Howard 0. Walker claim against Mexico, as there set forth.</p>
                <p>If no reply has yet been returned to the presentation of the claim then made, you
                    will again call the attention of the Mexican Government to the facts in the
                    case, and ask for a statement of its conclusions in the matter.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Wm. F. Wharton.</hi></signed></closer>


                <xi:include href="d252-a1.xml" xpointer="d252-a1"/>
