    <text>
        <body>
            <div xml:id="d246">

                <pb facs="0683" n="561" sameAs="frus:frus1889/pg561"/>

                <head><hi rendition="#italic">Mr. Blaine to Mr. Bragg.</hi></head>
                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1889-05-16"><hi rendition="#italic">May</hi> 16,
                        1889</date>.</dateline>
                    <seg rendition="#float-left">No. 268.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I herewith inclose for your information and
                    files a copy of a note<anchor n="*" xml:id="d246-f1"/> lately addressed by me to
                    the Mexican minister here, urging upon him the great necessity of his Government
                    adopting a thorough system of sanitary inspection for native and imported
                    cattle.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">James G. Blaine.</hi></signed></closer>
            </div>
        </body>
    </text>
