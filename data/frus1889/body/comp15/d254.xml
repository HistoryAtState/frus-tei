                <pb facs="0723" n="601" sameAs="frus:frus1889/pg601"/>

                <head><hi rendition="#italic">Mr. Ryan to Mr. Blaine.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1889-07-20"><hi rendition="#italic">July</hi> 20, 1889</date>.
                        (Received July 29.)</dateline>
                    <seg rendition="#float-left">No. 47.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In connection with my No. 30, of the 30th
                    ultimo, relative to the case of R. C. Work, Tamaulipas, I have the honor to
                    inclose copy of a letter from Mrs. Work, which explains itself.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Thos. Ryan.</hi></signed></closer>


                <xi:include href="d254-a1.xml" xpointer="d254-a1"/>
