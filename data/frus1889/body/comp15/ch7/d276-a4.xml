    <text>
        <body>
            <div xml:id="d276-a4">

                <pb facs="0755" n="633" sameAs="frus:frus1889/pg633"/>

                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Consulate of the United States</hi>,<lb/><hi rendition="#italic"
                                >Paso del Norte, Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1888-12-04"><hi rendition="#italic">December</hi> 4,
                        1888</date>.</dateline></opener>
                <p>I hereby certify that the accompanying translation was made by me, and after
                    being submitted to Mr. Ygnacio Garfias declared by him to be true and
                    correct.</p>
                <p>Given under my hand and seal of office the day and year above written.</p>
                <closer>[<hi rendition="#small-caps">seal.</hi>] <signed><hi rendition="#small-caps"
                            >Beckford Mackey</hi>,<lb/><hi rendition="#italic">United Stales
                            Consul.</hi></signed></closer>
            </div>
        </body>
