    <text>
        <body>
            <div xml:id="d30">

                <pb facs="0168" n="50" sameAs="frus:frus1889/pg50"/>

                <head><hi rendition="#italic">Mr. Tree to Mr.
                            Bayard.</hi></head>
                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Brussels</hi></placeName>, <date calendar="gregorian"
                            when="1888-11-23"><hi rendition="#italic">November</hi> 23, 1888</date>.
                        (Received December 3.)</dateline>
                    <seg rendition="#float-left">No. 417.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a copy
                    of a letter addressed to me by the minister of foreign affairs, giving me formal
                    notice of the surrender of the man Sambolino into the hands of Mr. Heidelberg on
                    board the steamer <hi rendition="#italic">Westernland</hi> on the 10th
                    instant.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Lambert Tree.</hi></signed></closer>


                <xi:include href="d30-a1.xml" xpointer="d30-a1"/>
            </div>
        </body>
    </text>
