    <text>
        <body>
            <div xml:id="d32">

                <pb facs="0174" n="56" sameAs="frus:frus1889/pg56"/>

                <head><hi rendition="#italic">Mr. Bayard to Mr.
                            Parkhurst.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1889-02-12"><hi rendition="#italic">February</hi> 12,
                        1889</date>.</dateline>
                    <seg rendition="#float-left">No. 22.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to previous correspondence
                    concerning the Sambolino extradition case, I inclose herewith for your
                    information a copy of a letter from the district attorney at New York reporting
                    that Sambolino has been convicted of the crime of forgery and sentenced to
                    imprisonment at hard labor for ten years.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. F. Bayard.</hi></signed></closer>


                <xi:include href="d32-a1.xml" xpointer="d32-a1"/>
