    <text>
        <body>
            <div xml:id="d26">

                <pb facs="0164" n="46" sameAs="frus:frus1889/pg46"/>

                <head><hi rendition="#italic">Mr. Rives to Mr. Tree.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1888-10-20"><hi rendition="#italic">October</hi> 20,
                        1888</date>.</dateline></opener>
                <p>Upon application authorities State of New York, you are instructed to request
                    detention Adolph Sambolino, now under arrest at Antwerp, pending arrival
                    extradition papers charging forgery.</p>
                <closer><signed><hi rendition="#small-caps">Rives</hi>.</signed></closer>
            </div>
        </body>
    </text>
