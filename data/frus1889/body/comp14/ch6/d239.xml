    <text>
        <body>
            <div xml:id="d239">

                <pb facs="0670" n="548" sameAs="frus:frus1889/pg548"/>

                <head><hi rendition="#italic">Mr. Mutsu to Mr. Blaine.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of Japan</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1889-03-27"><hi rendition="#italic">March</hi> 27, 1889</date>.
                        (Received March 29).</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I beg to acknowledge the receipt of your
                    note of this date, in which you inform me that to-morrow you will be prepared to
                    deliver to me a check for $15,000, being the amount appropriated by Congress to
                    be paid to the Japanese Government on account of injuries caused to Japanese
                    subjects by explosion of shells from the United States steamer <hi
                        rendition="#italic">Omaha</hi>, and to say that I shall be gratified to
                    receive the same, and to transmit to my Government.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">M. Mutsu.</hi></signed></closer>


                <xi:include href="d239-a1.xml" xpointer="d239-a1"/>
