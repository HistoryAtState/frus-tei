    <text>
        <body>
            <div xml:id="d193">

                <pb facs="0616" n="494" sameAs="frus:frus1889/pg494"/>

                <head><hi rendition="#italic">Mr. Thompson to Mr. Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Port au Prince, Hayti</hi></placeName>, <date calendar="gregorian"
                            when="1889-01-16"><hi rendition="#italic">January</hi> 16, 1889</date>.
                        (Received January 30.)</dateline>
                    <seg rendition="#float-left">No. 249.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: The U. S. S. <hi rendition="#italic"
                        >Ossipee</hi> left this harbor 5.50 p.m., yesterday en route for Kingston,
                    Jamaica, taking in tow the steamer <hi rendition="#italic">Haytien
                    Republic</hi>. The U. S. S. <hi rendition="#italic">Galena</hi> steamed from
                    here at 9 o’clock this evening, bound for Key West, Florida.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John E. W.
                    Thompson.</hi></signed></closer>
            </div>
        </body>
