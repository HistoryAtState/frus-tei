                <pb facs="0634" n="512" xml:id="pg512"/>

                <head><hi rendition="#italic">Mr. Preston to Mr.
                            Bayard.</hi></head>
                <opener><seg rendition="#center">[Inclosure.—Translation.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of Hayti</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1889-01-02"><hi rendition="#italic">January</hi> 2, 1889</date>.
                        (Received January 3.)</dateline></opener>
                <p>Mr. <hi rendition="#small-caps">Secretary of State</hi>: I have the honor, in
                    pursuance of instructions from my Government, herewith to transmit to you the
                    decree of the National Constituent Assembly, bearing date of the 10th ultimo,
                    closing, provisionally, to foreign commerce the ports of St. Marc, Les Gonaïves,
                    Port de Paix, and Cape Haytien, and abolishing the right hitherto granted of
                    putting into the ports of La Grande Salin, Môle St. Nicolas, and Fort
                    Liberty.</p>
                <p>Be pleased to accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Stephen Preston.</hi></signed></closer>


                <xi:include href="d207-a1.xml" xpointer="d207-a1"/>
