                <pb facs="0633" n="511" sameAs="frus:frus1889/pg511"/>

                <head><hi rendition="#italic">Mr. Preston to Mr.
                            Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of Hayti</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1889-01-02"><hi rendition="#italic">January</hi> 2, 1889</date>.
                        (Received January 3.)</dateline></opener>
                <p>Mr. <hi rendition="#small-caps">Secretary of State</hi>: In pursuance of
                    instructions received from my Government I have the honor herewith to transmit
                    to you a copy of the decree of the National Constituent Assembly, bearing date
                    of December 16, 1888, whereby General Francois Denys Légitime was elected
                    President of the Republic of Hayti for seven years.</p>
                <p>Be pleased to accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Stephen Preston.</hi></signed></closer>


                <xi:include href="d206-a1.xml" xpointer="d206-a1"/>
