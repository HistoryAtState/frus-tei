    <text>
        <body>
            <div xml:id="d219">

                <pb facs="0649" n="527" sameAs="frus:frus1889/pg527"/>

                <head><hi rendition="#italic">Mr. Preston to Mr. Bayard.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >New York</hi></placeName>, <date calendar="gregorian"
                            when="1889-02-18"><hi rendition="#italic">February</hi> 18,
                        1889</date>.</dateline></opener>
                <p>The <hi rendition="#italic">Madrid</hi>, now the <hi rendition="#italic"
                        >Conserva</hi>, is still in Gravesend Bay harbor of New York. Request you to
                    order immediately her detention.</p>
                <closer><signed><hi rendition="#small-caps">Stephen Preston.</hi></signed></closer>
            </div>
        </body>
    </text>
