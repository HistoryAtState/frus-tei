    <text>
        <body>
            <div xml:id="d196-a4">

                <pb facs="0622" n="500" sameAs="frus:frus1889/pg500"/>

                <opener><seg rendition="#center">[Inclosure 4, in No.
                    307.—Translation.]</seg></opener>
                <head><hi rendition="#italic">Mr. Firman to Messrs. Thompson and
                    Garrido</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >St. Marc</hi></placeName>, <date calendar="gregorian"
                            when="1889-08-21"><hi rendition="#italic">August</hi> 21, 1889</date>
                        (Eighty-sixth year of the Independence).</dateline></opener>
                <table cols="3" rows="1">
                    <row>
                        <cell>Liberty.</cell>
                        <cell>Equality.</cell>
                        <cell>Fraternity.</cell>
                    </row>
                </table>
                <p rendition="#center"><hi rendition="#small-caps">republic of hayti.</hi></p>
                <p><hi rendition="#small-caps">Gentlemen</hi>: The Provisional Government has
                    authorized me to answer your dispatch of this day, which has been duly
                    received.</p>
                <p>Please find herewith a note signed and containing the details of the manner of
                    execution of the note that I have had the honor to remit on the 7th instant to
                    the Messrs. Zohrab and Garrido.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">A. Firman.</hi></signed></closer>
            </div>
        </body>
    </text>
