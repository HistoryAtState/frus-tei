    <text>
        <body>
            <div xml:id="d190-a2">

                <pb facs="0615" n="493" sameAs="frus:frus1889/pg493"/>

                <opener><seg rendition="#center">[Inclosure 2 in No. 239.]</seg></opener>
                <head><hi rendition="#italic">Admiral Luce to Mr. Morse.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps">U.
                                S. S. Galena</hi>,<lb/><hi rendition="#italic">Port au Prince,
                                Hayti</hi></placeName>, <date calendar="gregorian" when="1888-12-23"
                                ><hi rendition="#italic">December</hi> 23,
                    1888</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: It gives me great pleasure to turn over to
                    your keeping this day, in as good order as it was practicable to make her, the
                    steamer <hi rendition="#italic">Haytien Republic</hi>.</p>
                <p>Respectfully,</p>
                <closer><signed><hi rendition="#small-caps">S. B. Luce</hi>,<lb/><hi
                            rendition="#italic">Rear-Admiral, U. S. Navy, Commanding North Atlantic
                            Squadron</hi>.</signed></closer>
            </div>
        </body>
