    <text>
        <body>
            <div xml:id="d329">

                <pb facs="0831" n="709" sameAs="frus:frus1889/pg709"/>

                <head><hi rendition="#italic">Mr. Straus to Mr.
                            Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1889-01-21"><hi rendition="#italic">January</hi> 21, 1889</date>.
                        (Received February 6.)</dateline>
                    <seg rendition="#float-left">No. 161.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my No. 151, of December 22,
                    1888, respecting the printing of the Bible in Turkish, I inclose a copy of a
                    note from the Porte, giving the desired permission. I have furnished a copy
                    thereof to the Bible house in Stamboul.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">O. S. Straus.</hi></signed></closer>



                <xi:include href="d329-a1.xml" xpointer="d329-a1"/>
