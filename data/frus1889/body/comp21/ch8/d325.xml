    <text>
        <body>
            <div xml:id="d325">

                <pb facs="0826" n="704" sameAs="frus:frus1889/pg704"/>

                <head><hi rendition="#italic">Mr. Wharton to Mr. Kloss.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1889-08-19"><hi rendition="#italic">August</hi> 19,
                        1889</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of the 13th instant, referring to the letter of the Treasury
                    Department concerning certain Swiss immigrants who were not allowed to land at
                    New York, and expressing your thanks to the Secretary of the Treasury for his
                    courteous action in the premises, and to inform you that the Department has
                    communicated the contents of your note to the Secretary of the Treasury.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">William F.
                    Wharton.</hi></signed></closer>
            </div>
        </body>
    </text>
