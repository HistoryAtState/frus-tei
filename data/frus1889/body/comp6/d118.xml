    <text>
        <body>
            <div xml:id="d118">

                <pb facs="0276" n="158" sameAs="frus:frus1889/pg158"/>

                <head><hi rendition="#italic">Sir Edmund Monson to Mr. Blaine.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Athens</hi></placeName>, <date calendar="gregorian"
                            when="1890-01-22"><hi rendition="#italic">January</hi> 22, 1890</date>.
                        (Received February 10.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit to you
                    herewith my award as arbitrator under the convention signed at Copenhagen by the
                    representatives of the United States and of Denmark on the 6th of December,
                    1888, for the settlement of the claim of Carlo’s Butterfield &amp; Co.</p>
                <p>A duplicate of this award will be forwarded to the Danish Government.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Edmund Monson.</hi></signed></closer>


                <xi:include href="d118-a1.xml" xpointer="d118-a1"/>
            </div>
