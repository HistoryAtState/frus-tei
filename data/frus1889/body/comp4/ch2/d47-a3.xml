    <text>
        <body>
            <div xml:id="d47-a3">

                <pb facs="0189" n="71" xml:id="pg71"/>

                <opener><seg rendition="#center">[Inclosure No.
                    3—Telegram—Translation.]</seg></opener>
                <head><hi rendition="#italic">Mr. Bocayuva to Mr.
                            Valente.</hi></head>
                <opener><dateline rendition="#float-right"><date calendar="gregorian"
                            when="1889-11-21"><hi rendition="#small-caps">November</hi>
                        21</date>.</dateline></opener>
                <p>Provisional Government confirms powers given to you and Messrs. Lafayette and
                    Mendonça.</p>
                <closer><signed><hi rendition="#small-caps">Bocayuva.</hi></signed></closer>
            </div>
        </body>
    </text>
