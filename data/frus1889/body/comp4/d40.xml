                <pb facs="0181" n="63" xml:id="pg63"/>

                <head><hi rendition="#italic">Mr. Blaine to Mr. Adams.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1889-11-19"><hi rendition="#italic">November</hi> 19,
                        1889</date>.</dateline></opener>
                <p>You will maintain diplomatic relations with the provisional government of
                    Brazil.</p>
                <closer><signed><hi rendition="#small-caps">Blaine.</hi></signed></closer>
            </div>
