    <text>
        <body>
            <div xml:id="d35">

                <pb facs="0177" n="59" sameAs="frus:frus1889/pg59"/>

                <head><hi rendition="#italic">Mr. Adams to Mr.
                            Blaine.</hi></head>
                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic">Rio
                                de Janeiro</hi></placeName>, <date calendar="gregorian"
                            when="1889-08-08"><hi rendition="#italic">August</hi> 8, 1889</date>.
                        (Received August 31.)</dateline>
                    <seg rendition="#float-left">No. 4.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I here with inclose a copy—translation—of
                    the reply to my letter of July 22 to the minister and secretary of foreign
                    affairs, conveying the congratulations of the President to His Majesty Dom Pedro
                    II on his escape from assassination.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Robert Adams, Jr.</hi></signed></closer>


                <xi:include href="d35-a1.xml" xpointer="d35-a1"/>
