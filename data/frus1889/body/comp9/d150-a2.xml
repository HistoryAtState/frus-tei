    <text>
        <body>
            <div xml:id="d150-a2">

                <pb facs="0544" n="422" sameAs="frus:frus1889/pg422"/>

                <head>B.</head>
                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName>
                            <placeName type="venue"><hi rendition="#small-caps">Palace of the
                                    King</hi></placeName>, <lb/>
                            <placeName type="city"><hi rendition="#italic"
                            >Matautu</hi></placeName></placeName>, <date calendar="gregorian"
                            when="1889-12-04"><hi rendition="#italic">December</hi> 4,
                        1889</date>.</dateline></opener>
                <p rendition="#flush">Your highness <hi rendition="#small-caps">W.
                        Blacklock</hi>,<lb/><hi rendition="#italic">U. S. Vice-Consul:</hi></p>
                <p><hi rendition="#small-caps">Your Highness</hi>: I have the honour to inform you
                    that to-morrow morning at eight o’clock the flag of my government will be
                    hoisted in Apia.</p>
                <p>Sir, I am,</p>
                <closer><signed><hi rendition="#small-caps">Malietoa</hi>,<lb/><hi
                            rendition="#italic">King of Samoa.</hi></signed></closer>
            </div>
        </body>
