    <text>
        <body>
            <div xml:id="d152-a25">

                <pb facs="0566" n="444" xml:id="pg444"/>

                <opener><seg rendition="#center">[Inclosure 25 in No. 1049.]</seg></opener>
                <head><hi rendition="#italic">Mr. Allen to Mr.
                            Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1889-01-19"><hi rendition="#italic">January</hi> 19,
                        1889</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: The paper herewith I beg to attach to my
                    letter of even date, to be filed with the State Department.</p>
                <p>Respectfully, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John H. Allen.</hi></signed></closer>
            </div>
        </body>
