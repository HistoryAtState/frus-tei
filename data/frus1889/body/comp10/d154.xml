    <text>
        <body>
            <div xml:id="d154">

                <pb facs="0568" n="446" sameAs="frus:frus1889/pg446"/>

                <head><hi rendition="#italic">Mr. White to Mr. Bayard.</hi></head>
                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States.</hi><lb/><hi rendition="#italic"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1889-02-23"><hi rendition="#italic">February</hi> 23, 1889</date>.
                        (Received March 5.)</dateline>
                    <seg rendition="#float-left">No. 928.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to your instruction No. 1049 of
                    the 23d ultimo, I have the honor to inclose herewith the copy of a note which I
                    addressed to the Secretary of State for Foreign Affairs on the 20th instant,
                    relative to the case of the American ship <hi rendition="#italic"
                        >Bridgewater</hi>.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Henry White.</hi></signed></closer>


                <xi:include href="d154-a1.xml" xpointer="d154-a1"/>
            </div>
