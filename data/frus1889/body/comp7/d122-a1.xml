    <text>
        <body>
            <div xml:id="d122-a1">

                <pb facs="0283" n="165" sameAs="frus:frus1889/pg165"/>

                <opener><seg rendition="#center">[Inclosure in No. 16.]</seg></opener>
                <head><hi rendition="#italic">Mr. Stone to Mr. Blaine.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Board of Trade of the City of Chicago,<lb/>Secretary’s
                                Office</hi>,<lb/><hi rendition="#italic">Chicago</hi></placeName>,
                            <date calendar="gregorian" when="1889-06-04"><hi rendition="#italic"
                                >June</hi> 4, 1889</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a copy
                    of preamble and resolutions adopted by the board of directors of this beard,
                    with reference to the prohibition, by Germany and France, of the importation of
                    American hog meats.</p>
                <p>Very respectfully, yours,</p>
                <closer><signed><hi rendition="#small-caps">Geo. F. Stone.</hi></signed></closer>
            </div>
        </body>
