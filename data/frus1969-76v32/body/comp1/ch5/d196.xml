                <pb facs="0640" n="605" sameAs="frus:frus1969-76v32/pg605"/>

                <head>196. Minutes of a Verification Panel Meeting<anchor n="1" xml:id="d196-f1"/>
                </head>
                <opener><dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            from="1971-09-15T15:20:00-04:00" to="1971-09-15T16:33:00-04:00"
                            >September 15, 1971, 3:20–4:33 p.m.</date>
                    </dateline></opener>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>
                        SALT
                    </item>
                </list>
                <list subtype="participants" type="description">
