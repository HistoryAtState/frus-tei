                <pb facs="0549" n="514" xml:id="pg514"/>

                <head>166. Minutes of a Verification Panel Meeting<anchor n="1" xml:id="d166-f1"/>
                </head>
                <opener><dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            from="1971-06-18T03:00:00-04:00" to="1971-06-18T16:40:00-04:00">June 18,
                            1971, 3:00 a.m.–4:40 p.m.</date>
                    </dateline></opener>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>
                        SALT
                    </item>
                </list>
                <list subtype="participants" type="description">
                    <label>PARTICIPATION</label>
                    <item>Chairman—Henry A. Kissinger
                    </item>
                    <item>State <list>
                            <item>
                                John N. Irwin, II
                            </item>
                            <item>
                                Ronald Spiers
                            </item>
                            <item>Seymour Weiss</item>
                            <item>
                                Raymond Garthoff
                            </item>
                            <item>Amb. Graham Parsons</item>
                        </list>
                    </item>
                    <item>Defense <list>
                            <item>
                                David Packard
                            </item>
                            <item>
                                Paul Nitze
                            </item>
                            <item>Archie L. Wood</item>
                        </list>
                    </item>
                    <item>
                        JCS
                        <list>
                            <item>LTG Royal B. Allison
                            </item>
                            <item>Justice</item>
