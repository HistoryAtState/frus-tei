                            </item>
                        </list>
                    </item>
                    <item>
                        ACDA
                        <list>
                            <item>Amb. Gerard Smith
                            </item>
                            <item>
                                Harold Brown
                            </item>
                            <item>
                                Philip J. Farley
                            </item>
                            <item>
