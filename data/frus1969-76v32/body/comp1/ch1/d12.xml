                <pb facs="0057" n="22" xml:id="pg22"/>

                <head>12. Minutes of a Review Group Meeting<anchor n="1" xml:id="d12-f1"/>
                </head>
                <opener><dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            from="1969-05-29T14:05:00-04:00" to="1969-05-29T17:40:00-04:00">May 29,
                            1969, 2:05–5:40 p.m.</date>
                    </dateline></opener>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>Review of U.S. Strategic Posture</item>
                </list>
                <list subtype="participants" type="description">
                    <label>PARTICIPATION</label>
                    <item>Chairman—Henry A. Kissinger
                    </item>
                    <item>State <list>
                            <item>
                                Arthur Hartman
                            </item>
