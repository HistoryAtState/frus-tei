            <div xml:id="d108">

                <pb facs="0290" n="251" xml:id="pg251"/>

                <head>108. Memorandum<anchor n="1" xml:id="d108-f1"/>
                </head>
                <opener><dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            when="1975-06-11">June 11, 1975</date>.</dateline></opener>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>Angola</item>
                </list>
                <list>
                    <label>1.</label>
                    <item>Attached is a paper discussing in a preliminary way what could be done
                        covertly to support a major effort to prevent a Neto takeover in Angola.</item>
                    <label>2.</label>
                    <item>[<hi rendition="#italic">3½ lines not declassified</hi>]</item>
                    <label>3.</label>
                    <item>Please do not reproduce these papers and return them when no longer
                        needed.</item>
                </list>


                <xi:include href="d108-a1.xml" xpointer="d108-a1"/>
            </div>
        </body>
    </text>
