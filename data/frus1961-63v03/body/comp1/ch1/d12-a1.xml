        <body>
            <div xml:id="d12-a1">

                <pb facs="0051" n="25" sameAs="frus:frus1961-63v03/pg25"/>


                <head>THIRD COUNTRY AID—(FY 63)</head>
                <list>
                    <item><hi rendition="#italic">Australia</hi>
                        <list>
                            <item>(Estimated $1,000,000 for FY
                                63)</item>
                            <item>—RR cars, Radio Station, jeeps, barbed wire, mills,</item>
                            <item>—corrugated iron, participants, etc.</item>
                        </list></item>
                    <item><hi rendition="#italic">Belgium</hi>
                        <list>
                            <item>—Five Year export credits</item>
                            <item>—Six scholarships</item>
                        </list></item>
                    <item><hi rendition="#italic">China, Republic of</hi>
                        <list>
                            <item>—Two geological engineers</item>
                            <item>—Technical advisers</item>
                        </list></item>
                    <item><hi rendition="#italic">Germany</hi>
                        <list>
                            <item>—Five additional Medical Professors for Hue</item>
                            <item>—Architectural Engineer</item>
                        </list></item>
                    <item><hi rendition="#italic">Japan</hi>
                        <list>
                            <item>—Steel Rolling Mill (under war reparations)</item>
                            <item>—Continuing work on Da Nhim Cam</item>
                        </list></item>
                    <item><hi rendition="#italic">New Zealand</hi>
                        <list>
                            <item>—Surgical team for Provincial Hospital</item>
                            <item>—Equipment for Hue Medical Faculty</item>
                            <item>—Participants</item>
                        </list></item>
                    <item><hi rendition="#italic">Canada</hi>
                        <list>
                            <item>—$300.000 worth of wheat flour</item>
                        </list></item>
                    <pb facs="0052" n="26" xml:id="pg26"/>
                    <item><hi rendition="#italic">France</hi>
                        <list>
                            <item>(FY 63 effort about 4.8
                                million)</item>
                            <item>—Teachers</item>
                            <item>—Technicians</item>
                            <item>—Participants</item>
                            <item>—Commercial Credits</item>
                        </list></item>
                </list>
            </div>
