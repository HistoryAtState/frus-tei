    <text>
        <body>
            <div xml:id="d584">

                <pb facs="0751" n="677" sameAs="frus:frus1917Supp02v01/pg677"/>

                <note rend="inline" type="source">File No. 825.6374/61</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Consul General at London</hi> (<hi
                            rendition="#italic">Skinner</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-12-06T18:00:00-05:00">
                            <hi rendition="#italic">December 6, 1917, 6 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Supplementing Department’s December 4th regarding nitrates. In case acceptance of
                    proposal in paragraph 3 is made conditional upon including Gibbs among purchasers for American market on
                    basis of their fair proportion of past business, you are authorized to assent to
                    that arrangement.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
