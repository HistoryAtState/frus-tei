    <text>
        <body>
            <div xml:id="d602">

                <pb facs="0768" n="694" sameAs="frus:frus1917Supp02v01/pg694"/>

                <note rend="inline" type="source">File No. 862.85/195a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in Siam</hi> (<hi
                        rendition="#italic">Ingersoll</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-10-20">
                            <hi rendition="#italic">October 20, 1917</hi></date>.</dateline>
                </opener>
                <p>Your September 17, 11 a.m.<anchor n="2" xml:id="d602-f1"/> This Government has
                    agreed to following apportionment of steamers taken over by Siamese Government:
                        <pb facs="0769" n="695" xml:id="pg695"/> 25 per cent each to Great Britain,
                    France, Japan, and the United States. Embassy at Tokyo has been instructed
                    accordingly.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
