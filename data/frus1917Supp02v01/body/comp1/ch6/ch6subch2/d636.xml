    <text>
        <body>
            <div xml:id="d636">

                <pb facs="0795" n="721" sameAs="frus:frus1917Supp02v01/pg721"/>

                <note rend="inline" type="source">File No. 763.72115/3239</note>
                <head>
                    <hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic">Reinsch</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Peking</hi></placeName>, <date
                            calendar="gregorian" when="1917-12-31T18:00:00+08:00">
                            <hi rendition="#italic">December 31, 1917, 6 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received December 31, 4.15
                        p.m.</hi>]</dateline>
                </opener>
                <p>Your December 29, 3 p.m. Inquiry was intended to inform you that the action of
                    the Allied representatives contemplated deportation to Australia of all enemy
                    subjects to the exclusion of the alternative of deporting only suspected
                    persons.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Reinsch</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
