    <text>
        <body>
            <div xml:id="d637">

                <pb facs="0795" n="721" sameAs="frus:frus1917Supp02v01/pg721"/>

                <note rend="inline" type="source">File No. 763.72115/3237</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in China</hi>
                        (<hi rendition="#italic">Reinsch</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-01-03T14:00:00-05:00">
                            <hi rendition="#italic">January 3, 1918, 2 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your December 27, 11 p.m.<anchor n="1" xml:id="d637-f1"/> You may support Allied
                    representatives on the ground that this measure alone will adequately safeguard
                    interests of China and her allies.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
