    <text>
        <body>
            <div xml:id="d630">

                <pb facs="0787" n="713" xml:id="pg713"/>

                <note rend="inline" type="source">File No. 862.85/254</note>
                <head>
                    <hi rendition="#italic">The Minister in Siam</hi> (<hi rendition="#italic"
                        >Ingersoll</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Bangkok</hi></placeName>, <date
                            calendar="gregorian" when="1917-12-27T07:00:00+06:42">
                            <hi rendition="#italic">December 27, 1917, 7 a.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 3.21 p.m.</hi>]</dateline>
                </opener>
                <p>Referring to the Department’s telegram of December 21, 7 p.m.<anchor n="1"
                        xml:id="d630-f1"/> Charter contracts for our allotted vessels<anchor n="2"
                        xml:id="d630-f2"/> signed yesterday. Rates of charter hire payable in New
                    York.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Ingersoll</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d630-f1" n="1" xml:id="d630-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d630-f2" n="2" xml:id="d630-f2-content">
                <p>As named in the British Embassy’s memorandum of Nov. 7, <hi rendition="#italic"
                        >ante</hi>, <ref target="#pg698">p. 698</ref>.</p>
            </note>
