            <div xml:id="d496">

                <pb facs="0662" n="588" sameAs="frus:frus1917Supp02v01/pg588"/>

                <note rend="inline" type="source">File No. 102.1/447a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Great
                        Britain</hi> (<hi rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-12-08T18:00:00-05:00">
                            <hi rendition="#italic">December 8, 1917, 6 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>5994. For Crosby from Leffingwell:</p>
                <p>Treasury 22. Plan for two councils outlined your Nos. 11 and 13 approved.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
