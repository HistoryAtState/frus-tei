    <text>
        <body>
            <div xml:id="d472">

                <pb facs="0645" n="571" sameAs="frus:frus1917Supp02v01/pg571"/>

                <note rend="inline" type="source">File No. 763.72/6939</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Page</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1917-09-21T15:00:00+00:00">
                            <hi rendition="#italic">September 21, 1917, 3 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 3.30 p.m.</hi>]</dateline>
                </opener>
                <p>7218. Your 5396, September 8, 2 p.m. British Government are proceeding with all
                    speed nomination of their delegates to Inter-Ally Council and hope very shortly
                    to announce their names.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Page</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
