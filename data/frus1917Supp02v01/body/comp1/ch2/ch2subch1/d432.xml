    <text>
        <body>
            <div xml:id="d432">

                <pb facs="0599" n="525" xml:id="pg525"/>

                <note rend="inline" type="source">File No. 851.51/49</note>
                <head>
                    <hi rendition="#italic">The French Ambassador</hi> (<hi rendition="#italic">Jusserand</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Translation]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-05-02">
                            <hi rendition="#italic">May 2, 1917</hi></date>. <lb/> [<hi
                            rendition="#italic">Received May 3.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Secretary of State</hi>: The Government of the
                    French Republic wishes to enter upon a loan contract with the Federal Government
                    at the earliest possible date.</p>
                <p>Under the circumstances, I should be very grateful to Your Excellency if you will
                    kindly put either me or the representatives whose names I shall furnish in
                    contact with the Secretary of the Treasury of the United States in order to
                    begin the negotiations for the said loan.</p>
                <p>I have received the requisite power to sign all instruments connected with the
                    transaction that would come out of the said negotiations.</p>
                <p>Be pleased to accept [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Jusserand</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
