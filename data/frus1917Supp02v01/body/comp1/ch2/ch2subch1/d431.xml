    <text>
        <body>
            <div xml:id="d431">

                <pb facs="0598" n="524" sameAs="frus:frus1917Supp02v01/pg524"/>

                <note rend="inline" type="source">File No. 841.51/46</note>
                <head>
                    <hi rendition="#italic">The British Ambassador</hi> (<hi rendition="#italic"
                        >Spring Rice</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 113</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-04-23">
                            <hi rendition="#italic">April 23, 1917</hi></date>. <lb/> [<hi
                            rendition="#italic">Received April 24.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: It is the desire of my Government to
                    borrow at the earliest practicable date, the sum of $200,000,000 from your
                    Government. I will appreciate very much if you could place me, or those whom I
                    may indicate, in communication with the Secretary of the Treasury of your
                    Government, so that negotiations may be taken up for the loan mentioned.<anchor
                        n="2" xml:id="d431-f1"/> The authority to sign the necessary documents
                    covering such transaction as may result from my negotiations with the Secretary
                    of the Treasury, is in my hands.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Cecil Spring Rice</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d431-f1" n="2" xml:id="d431-f1-content">
                <p>The contents of this note were communicated to the Secretary of the Treasury Apr.
                    24.</p>
            </note>
        </listAnnotation>
