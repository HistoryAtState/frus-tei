    <text>
        <body>
            <div xml:id="d455">

                <pb facs="0622" n="548" sameAs="frus:frus1917Supp02v01/pg548"/>

                <note rend="inline" type="source">File No. 841.51/70</note>
                <head>
                    <hi rendition="#italic">The Assistant Secretary of the Treasury</hi> (<hi
                        rendition="#italic">Crosby</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-07-20">
                            <hi rendition="#italic">July 20, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: On behalf of the Secretary of the
                    Treasury, I beg to advise you that an advance of $85,000,000 has to-day been
                    made to the British Government. This brings the total loaned to that Government
                    to date to $770,000,000.</p>
                <p>Very sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Oscar T. Crosby</hi>
                    </signed>
                </closer>
            </div>
        </body>
