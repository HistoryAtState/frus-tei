    <text>
        <body>
            <div xml:id="d539">

                <pb facs="0713" n="639" sameAs="frus:frus1917Supp02v01/pg639"/>

                <note rend="inline" type="source">File No. 411.57N83/106</note>
                <head>
                    <hi rendition="#italic">The Commercial Adviser of the British Embassy</hi>
                        (<hi rendition="#italic"
                            >Crawford</hi>) <hi rendition="#italic">to the Counselor for
                        the Department of State</hi> (<hi
                            rendition="#italic">Polk</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-11-24">
                            <hi rendition="#italic">November 24, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Polk</hi>: Here is the draft of the telegram I propose to send.
                    Let me know whether you agree.</p>
                <p>Yours very sincerely,</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Richard Crawford</hi>
                        
                    </signed>
                </closer>


                <xi:include href="d539-a1.xml" xpointer="d539-a1"/>
