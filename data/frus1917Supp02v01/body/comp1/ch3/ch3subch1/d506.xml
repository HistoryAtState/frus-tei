    <text>
        <body>
            <div xml:id="d506">

                <pb facs="0671" n="597" sameAs="frus:frus1917Supp02v01/pg597"/>

                <note rend="inline" type="source">File No. 195/87</note>
                <head>
                    <hi rendition="#italic">The Chief of the British Special Mission</hi> (<hi
                        rendition="#italic">Balfour</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-05-23">
                            <hi rendition="#italic">May 23, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Secretary</hi>: I send you a copy of a
                    letter which I have addressed to Mr. Denman to-day.</p>
                <p>Yours very sincerely,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Arthur James Balfour</hi>
                    </signed>
                </closer>



