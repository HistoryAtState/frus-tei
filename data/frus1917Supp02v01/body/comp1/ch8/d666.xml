    <text>
        <body>
            <div xml:id="d666">

                <pb facs="0816" n="742" sameAs="frus:frus1917Supp02v01/pg742"/>

                <note rend="inline" type="source">File No. 763.72119/646</note>
                <head>
                    <hi rendition="#italic">The Editor of the Chicago “Tribune”</hi> (<hi
                        rendition="#italic">McCormick</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Chicago</hi></placeName>, <date
                            calendar="gregorian" when="1917-06-12">
                            <hi rendition="#italic">June 12, 1917</hi></date>. <lb/> [<hi
                            rendition="#italic">Received June 14</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Lansing</hi>: I enclose a cablegram from
                    our correspondent in Stockholm which I thought best not to print. I feel,
                    however, that the subject matter should come to your attention.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert R. McCormick</hi>
                    </signed>
                </closer>


                <xi:include href="d666-a1.xml" xpointer="d666-a1"/>
            </div>
