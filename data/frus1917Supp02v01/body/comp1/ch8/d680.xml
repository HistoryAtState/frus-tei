    <text>
        <body>
            <div xml:id="d680">

                <pb facs="0825" n="751" sameAs="frus:frus1917Supp02v01/pg751"/>

                <note rend="inline" type="source">File No. 763.72119/703a</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in Great
                        Britain</hi> (<hi rendition="#italic">Page</hi>)<anchor n="1"
                        xml:id="d680-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-08-03T17:00:00-05:00">
                            <hi rendition="#italic">August 3, 1917, 5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>5251. Please advise Department immediately of the policy of the British
                    Government in permitting Socialists to attend Stockholm conference.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Polk</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d680-f1" n="1" type="source" xml:id="d680-f1-content">
                <p>The same, <hi rendition="#italic">mutatis mutandis</hi>, on the same date, to the
                    Ambassador in France (No. 2514).</p>
            </note>
        </listAnnotation>
    </standOff>
