    <text>
        <body>
            <div xml:id="d683">

                <pb facs="0826" n="752" sameAs="frus:frus1917Supp02v01/pg752"/>

                <note rend="inline" type="source">File No. 763.72119/709a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Great
                        Britain</hi> (<hi rendition="#italic">Page</hi>)<anchor n="1"
                        xml:id="d683-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-08-07T17:00:00-05:00">
                            <hi rendition="#italic">August 7, 1917, 5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>5267. Department notified Morris Hillquit, Socialist delegate to Copenhagen [<hi
                        rendition="#italic">Stockholm</hi>] conference, would not be given
                    passport.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d683-f1" n="1" type="source" xml:id="d683-f1-content">
                <p>The same, on the same date, to the Ambassador in France (No. 2523).</p>
            </note>
        </listAnnotation>
    </standOff>
