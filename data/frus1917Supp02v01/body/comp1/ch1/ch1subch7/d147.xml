    <text>
        <body>
            <div xml:id="d147">

                <pb facs="0181" n="107" sameAs="frus:frus1917Supp02v01/pg107"/>

                <note rend="inline" type="source">File No. 763.72112/3830</note>
                <head>
                    <hi rendition="#italic">The Minister in Greece</hi> (<hi rendition="#italic">Droppers</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Athens</hi></placeName>, <date
                            calendar="gregorian" when="1917-06-20">
                            <hi rendition="#italic">June 20, 1917</hi></date>. <lb/> [<hi
                            rendition="#italic">Received June 21, 1 a.m.</hi>]</dateline>
                </opener>
                <p>302. French Admiral notifies me blockade referred to my telegram 196, December
                        8,<anchor n="1" xml:id="d147-f1"/> raised. Ships leaving Greece require
                    authorization Allied authorities.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Droppers</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
