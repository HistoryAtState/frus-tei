    <text>
        <body>
            <div xml:id="d174">

                <pb facs="0197" n="123" sameAs="frus:frus1917Supp02v01/pg123"/>

                <note rend="inline" type="source">File No. 763.72/5646</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in Great
                        Britain</hi> (<hi rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-07-11T17:00:00-05:00">
                            <hi rendition="#italic">July 11, 1917, 5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>5129. Your 6599<anchor n="2" xml:id="d174-f1"/> has been referred to the
                    President and the decision reached that, while Mr. Balfour’s cordial invitation
                    is <pb facs="0198" n="124" xml:id="pg124"/> greatly appreciated, this Government
                    is not ready at the present time to take part in the inter-Allied war
                    conferences.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Polk</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
