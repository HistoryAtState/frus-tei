    <text>
        <body>
            <div xml:id="d165">

                <pb facs="0191" n="117" sameAs="frus:frus1917Supp02v01/pg117"/>

                <note rend="inline" type="source">File No. 763.72/5670</note>
                <head>
                    <hi rendition="#italic">The Minister in Greece</hi> (<hi rendition="#italic"
                        >Droppers</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Athens</hi></placeName>, <date
                            calendar="gregorian" when="1917-07-02">
                            <hi rendition="#italic">July 2, 1917</hi></date>. <lb/> [<hi
                            rendition="#italic">Received July 3, 1.30 a.m.</hi>]</dateline>
                </opener>
                <p>372. Minister of Foreign Affairs informs me Greece at war Germany, Bulgaria.
                    Relations broken off other Central powers.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Droppers</hi>
                    </signed>
                </closer>
            </div>
        </body>
