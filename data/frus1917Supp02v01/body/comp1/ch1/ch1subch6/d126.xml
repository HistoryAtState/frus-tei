    <text>
        <body>
            <div xml:id="d126">

                <pb facs="0164" n="90" xml:id="pg90"/>

                <note rend="inline" type="source">File No. 763.72/5194</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in Greece</hi>
                        (<hi rendition="#italic">Droppers</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-06-09T17:00:00-05:00">
                            <hi rendition="#italic">June 9, 1917, 5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>294. Your 347, June 7, 2 p.m. Please notify Department details agreement between
                    England, France, Russia, relative Greek affairs. Inform Department more
                    frequently and more fully concerning conditions in Greece.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
