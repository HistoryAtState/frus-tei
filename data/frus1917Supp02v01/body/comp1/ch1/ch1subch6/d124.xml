            <div xml:id="d124">

                <pb facs="0163" n="89" sameAs="frus:frus1917Supp02v01/pg89"/>

                <note rend="inline" type="source">File No. 763.72/5214</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Page</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1917-06-08T19:00:00+01:00">
                            <hi rendition="#italic">June 8, 1917, 7 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 12 p.m.</hi>]</dateline>
                </opener>
                <p>6410. General Pershing and staff arrived
                    in London this afternoon and were met at train by myself and by Secretary of
                    State for War and other officials.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Page</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
