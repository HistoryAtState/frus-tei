    <text>
        <body>
            <div xml:id="d107">

                <pb facs="0154" n="80" sameAs="frus:frus1917Supp02v01/pg80"/>

                <note rend="inline" type="source">File No. 763.72/4978</note>
                <head>
                    <hi rendition="#italic">The Minister in Belgium</hi> (<hi rendition="#italic">Whitlock</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Havre</hi></placeName>, <date
                            calendar="gregorian" when="1917-05-29T18:00:00+01:00">
                            <hi rendition="#italic">May 29, 1917, 6 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received May 29, 5.50 p.m.</hi>]</dateline>
                </opener>
                <p>69. Belgian mission, composed of Baron Moncheur, General
                        Leclercq, Hector Carrier, Major
                        Osterrieth, and Lieutenant Count Louis
                        d’Ursel, sails for America June 3 from Cadiz.<anchor n="2"
                        xml:id="d107-f1"/>
                </p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Whitlock</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d107-f1" n="2" xml:id="d107-f1-content">
                <p>This mission arrived June 16. See footnote 1, <hi rendition="#italic">ante</hi>,
                        <ref target="#pg20">p. 20</ref>.</p>
            </note>
        </listAnnotation>
