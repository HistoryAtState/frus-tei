    <text>
        <body>
            <div xml:id="d122">

                <pb facs="0161" n="87" sameAs="frus:frus1917Supp02v01/pg87"/>

                <note rend="inline" type="source">File No. 763.72/5194</note>
                <head>
                    <hi rendition="#italic">The Minister in Greece</hi> (<hi rendition="#italic">Droppers</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Athens</hi></placeName>, <date
                            calendar="gregorian" when="1917-06-07T14:00:00+02:00">
                            <hi rendition="#italic">June 7, 1917, 2 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received June 8, 7 a.m.</hi>]</dateline>
                </opener>
                <p>347. England, France, Russia having reached an agreement in regard to Greek
                    affairs French Senator Jonnart proceeding
                    Salonica then Athens as special emissary and exponent of joint policy of three
                    powers.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Droppers</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
