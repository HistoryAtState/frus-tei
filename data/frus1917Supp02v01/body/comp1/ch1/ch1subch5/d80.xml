    <text>
        <body>
            <div xml:id="d80">

                <pb facs="0133" n="59" sameAs="frus:frus1917Supp02v01/pg59"/>

                <note rend="inline" type="source">File No. 763.72/4127</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Italy</hi>
                        (<hi rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-05-07T19:00:00-05:00">
                            <hi rendition="#italic">May 7, 1917, 7 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>799. Your 937, April 28, 2 p.m.<anchor n="1" xml:id="d80-f1"/> Inform Italian
                    Government of this Government’s pleasure in receiving distinguished members of
                    Italian commission.<anchor n="2" xml:id="d80-f2"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d80-f1" n="1" xml:id="d80-f1-content">
                <p>
                    <hi rendition="#italic">Ante</hi>, <ref target="#pg47">p. 47</ref>.</p>
            </note>
            <note corresp="#d80-f2" n="2" xml:id="d80-f2-content">
                <p>This mission arrived in New York May 10. See footnote 1, <hi rendition="#italic"
                        >ante</hi>, <ref target="#pg20">p. 20</ref>.</p>
            </note>
        </listAnnotation>
