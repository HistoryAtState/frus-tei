    <text>
        <body>
            <div xml:id="d76">

                <pb facs="0129" n="55" sameAs="frus:frus1917Supp02v01/pg55"/>

                <note rend="inline" type="source">File No. 868.00/107</note>
                <head>
                    <hi rendition="#italic">The Minister in Greece</hi> (<hi rendition="#italic"
                        >Droppers</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Athens</hi></placeName>, <date
                            calendar="gregorian" when="1917-05-04T13:00:00+02:00">
                            <hi rendition="#italic">May 4, 1917, 1 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 12 p.m.</hi>]</dateline>
                </opener>
                <p>322. Zaimis has consented to form a new ministry. It is hoped that he will
                    improve Greco-Entente relations.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Droppers</hi>
                    </signed>
                </closer>
            </div>
        </body>
