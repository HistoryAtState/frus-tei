    <text>
        <body>
            <div xml:id="d91">

                <pb facs="0139" n="65" sameAs="frus:frus1917Supp02v01/pg65"/>

                <note rend="inline" type="source">File No. 763.72/4781c</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Minister in Denmark</hi> (<hi
                            rendition="#italic">Egan</hi>)<anchor n="2" xml:id="d91-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-05-17T16:00:00-05:00">
                            <hi rendition="#italic">May 17, 1917, 4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>354. In scanning German press, please watch for comment indicating German
                    jubilation or satisfaction over what they may take to be America’s dilatory
                    start in the war.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d91-f1" n="2" type="source" xml:id="d91-f1-content">
                <p>The same telegram was sent May 17 to the Minister in Switzerland (No. 582) and
                    the Chargé in the Netherlands (No. 521).</p>
            </note>
        </listAnnotation>
    </standOff>
