    <text>
        <body>
            <div xml:id="d202">

                <pb facs="0225" n="151" sameAs="frus:frus1917Supp02v01/pg151"/>

                <note rend="inline" type="source">File No. 763.72119/685</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        France</hi> (<hi rendition="#italic">Sharp</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-07-31T16:00:00-05:00">
                            <hi rendition="#italic">July 31, 1917, 4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>2501. Your 2321.<anchor n="1" xml:id="d202-f1"/> Question No. 3 refers to
                    agreements between Allies concerning Asia Minor. Department has no information
                    regarding these agreements and would be glad to be informed of their nature in
                    order that it may be in a position to answer the inquiry.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Polk</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
