    <text>
        <body>
            <div xml:id="d395">

                <pb facs="0547" n="473" xml:id="pg473"/>

                <note rend="inline" type="source">File No. 763.72/8202b</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Spain</hi>
                        (<hi rendition="#italic">Willard</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-12-15">
                            <hi rendition="#italic">December 15, 1917</hi></date>.</dateline>
                </opener>
                <p>783. Inform Foreign Office and request it officially to notify Austro-Hungarian
                    Government that in pursuance of resolution mentioned in Department’s 779,
                    December 11, to you, President on December 11 proclaimed that a state of war
                    exists between the United States and the Imperial and Royal Austro-Hungarian
                    Government. Advise consular officers of proclamation.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
