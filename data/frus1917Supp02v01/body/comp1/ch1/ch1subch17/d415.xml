                <pb facs="0566" n="492" sameAs="frus:frus1917Supp02v01/pg492"/>

                <note rend="inline" type="source">File No. 763.72119/1031</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Chargé in Switzerland</hi> (<hi
                            rendition="#italic">Wilson</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-12-26T17:00:00-05:00">
                            <hi rendition="#italic">December 26, 1917, 5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>1273. Referring to third paragraph Department’s 1208, December 10, 3 p.m.,<anchor
                        n="2" xml:id="d415-f1"/> you may furnish your British and French colleagues
                    with information contained in your 2261, Anderson’s cable No. 9.<anchor n="3" xml:id="d415-f2"/>
                    Paraphrases thereof have been furnished British and French Ambassadors here
                    to-day.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
