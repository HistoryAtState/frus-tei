    <text>
        <body>
            <div xml:id="d381">

                <pb facs="0533" n="459" sameAs="frus:frus1917Supp02v01/pg459"/>

                <note rend="inline" type="source">File No. 763.72/8023a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                            All Diplomatic Officers
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Circular telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-12-07">
                            <hi rendition="#italic">December 7, 1917</hi></date>.</dateline>
                </opener>
                <p>Congress to-day passed and President signed joint resolution declaring war on
                    Austria-Hungary. Inform Consuls.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
