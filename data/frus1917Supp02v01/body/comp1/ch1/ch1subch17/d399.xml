    <text>
        <body>
            <div xml:id="d399">

                <pb facs="0548" n="474" sameAs="frus:frus1917Supp02v01/pg474"/>

                <note rend="inline" type="source">File No. 763.72119/8265</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Minister in the Netherlands</hi> (<hi
                            rendition="#italic">Garrett</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-12-16T21:00:00-05:00">
                            <hi rendition="#italic">December 16, 1917, 9 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>848. You may receive communication mentioned in your 1767 making it clear that
                    you are acting entirely unofficially and as an individual and that you will deny
                    receipt in case it becomes public.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
