    <text>
        <body>
            <div xml:id="d390">

                <pb facs="0544" n="470" sameAs="frus:frus1917Supp02v01/pg470"/>

                <note rend="inline" type="source">File No. 763.72/8101a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            Diplomatic Officers in All Countries except
                            Spain
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Circular telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-12-11">
                            <hi rendition="#italic">December 11, 1917</hi></date>.</dateline>
                </opener>
                <p>Supplementing Department’s circular 7th.<anchor n="2" xml:id="d390-f1"/> Inform
                    Foreign Office that, “The United States Congress has passed a resolution,
                    approved by the President December 7, declaring that a state of war exists
                    between the Austro-Hungarian Government and the people of the United
                    States.”</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
