    <text>
        <body>
            <div xml:id="d396">

                <pb facs="0547" n="473" sameAs="frus:frus1917Supp02v01/pg473"/>

                <note rend="inline" type="source">File No. 867n.01/2a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Great Britain</hi> (<hi
                            rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-12-15T15:00:00-05:00">
                            <hi rendition="#italic">December 15, 1917, 3 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>6041. Investigate discreetly and report fully and promptly to Department reasons
                    for Balfour’s recent statement relative
                    Jewish state in Palestine.<anchor n="1" xml:id="d396-f1"/>
                </p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
