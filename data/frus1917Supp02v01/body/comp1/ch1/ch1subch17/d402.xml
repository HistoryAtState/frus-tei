    <text>
        <body>
            <div xml:id="d402">

                <pb facs="0549" n="475" sameAs="frus:frus1917Supp02v01/pg475"/>

                <note rend="inline" type="source">File No. 763.72/13413a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the French Ambassador</hi>
                        (<hi rendition="#italic">Jursserand</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-12-19">
                            <hi rendition="#italic">December 19, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Ambassador</hi>: I enclose for your
                    information and for transmittal to your Government if you so desire, a
                    paraphrase of a telegram which was sent yesterday by the Secretary of War to
                    General Pershing.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>



                <xi:include href="d402-a1.xml" xpointer="d402-a1"/>
