    <text>
        <body>
            <div xml:id="d373">

                <pb facs="0522" n="448" xml:id="pg448"/>

                <note rend="inline" type="source">File No. 763.72/8475b</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Chairman of the Committee on Foreign Relations of the Senate</hi> (<hi rendition="#italic">Stone</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-12-06">
                            <hi rendition="#italic">December 6, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Senator Stone</hi>: In
                    accordance with your request it gives me pleasure to send you enclosed a
                    confidential memorandum regarding the inadvisability of a declaration of war by
                    the United States against Turkey and Bulgaria at the present time.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Robert Lansing</hi>
                        
                    </signed>
                </closer>



                <xi:include href="d373-a1.xml" xpointer="d373-a1"/>
