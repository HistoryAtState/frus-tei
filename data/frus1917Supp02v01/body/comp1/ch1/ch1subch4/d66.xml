    <text>
        <body>
            <div xml:id="d66">

                <pb facs="0122" n="48" xml:id="pg48"/>

                <note rend="inline" type="source">File No. 868.00/102</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Minister in Greece</hi> (<hi
                            rendition="#italic">Droppers</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-04-28T16:00:00-05:00">
                            <hi rendition="#italic">April 28, 1917, 4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>270. Your 300, April 17,<anchor n="1" xml:id="d66-f1"/> does not answer questions
                    Department’s 247,<anchor n="2" xml:id="d66-f2"/> April 4, relative to
                    parliamentary elections and dissolution Parliament.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
