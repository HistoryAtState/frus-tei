    <text>
        <body>
            <div xml:id="d65">

                <pb facs="0121" n="47" sameAs="frus:frus1917Supp02v01/pg47"/>

                <note rend="inline" type="source">File No. 763.72/4127</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Italy</hi> (<hi rendition="#italic">Page</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Rome</hi></placeName>, <date
                            calendar="gregorian" when="1917-04-28T14:00:00+02:00">
                            <hi rendition="#italic">April 28, 1917, 2 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 3.10 p.m.</hi>]</dateline>
                </opener>
                <p>937. Informed by Prime Minister that Prince of Udine heads mission to United
                    States. Other members probably Marquis Bor-sarelli, Undersecretary of State;
                    Senator Marconi; Arlotta, Minister of Transportation; Nitti, former Minister of
                    Agriculture; and two others.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Nelson Page</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
