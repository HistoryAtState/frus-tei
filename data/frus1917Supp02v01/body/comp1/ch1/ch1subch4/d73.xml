    <text>
        <body>
            <div xml:id="d73">

                <pb facs="0126" n="52" sameAs="frus:frus1917Supp02v01/pg52"/>

                <note rend="inline" type="source">File No. 763.72/4196</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in Greece</hi>
                        (<hi rendition="#italic">Droppers</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-05-03T16:00:00-05:00">
                            <hi rendition="#italic">May 3, 1917, 4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>271. Your 317, April 30, 10 p.m. Proposed action by Venizelist commissioners in
                    United States impossible at present. Question of attitude United States towards
                    Provisional Government still under consideration.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
