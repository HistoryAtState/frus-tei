    <text>
        <body>
            <div xml:id="d231">

                <pb facs="0246" n="172" sameAs="frus:frus1917Supp02v01/pg172"/>

                <note rend="inline" type="source">File No. 763.72/6592</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Page</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1917-08-24T15:00:00+01:00">
                            <hi rendition="#italic">August 24, 1917, 3 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 5.15 p.m.</hi>]</dateline>
                </opener>
                <p>7021. Your 5307, August 15.<anchor n="1" xml:id="d231-f1"/> Foreign Office
                    informs me the date on which it is suggested that the conference should meet is
                    September 4.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Page</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
