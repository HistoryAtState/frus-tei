    <text>
        <body>
            <div xml:id="d345">

                <pb facs="0382" n="308" sameAs="frus:frus1917Supp02v01/pg308"/>

                <note rend="inline" type="source">File No. 763.72/7761</note>
                <head>
                    <hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic">Sharp</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1917-11-16T22:00:00+00:00">
                            <hi rendition="#italic">November 16, 1917, 10 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received November 17, 3.15
                        p.m.</hi>]</dateline>
                </opener>
                <p>2754. Your 2798, 12th [<hi rendition="#italic">10th</hi>].<anchor n="2"
                        xml:id="d345-f1"/> Foreign Office replies that the smaller powers have been
                    invited to assist at the military session of the Inter-Allied Conference of
                    Paris and that they have reserved for decision at that time what will be the
                    working procedure to be followed subsequently.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Sharp</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
