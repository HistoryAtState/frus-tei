    <text>
        <body>
            <div xml:id="d362">

                <pb facs="0401" n="327" xml:id="pg327"/>

                <note rend="inline" type="source">File No. 761.00/11a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Minister in Sweden</hi> (<hi
                            rendition="#italic">Morris</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-11-30T16:00:00-05:00">
                            <hi rendition="#italic">November 30, 1917, 4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>427. Department informed secret treaties are being published by Bolsheviki
                    government in Petrograd but their publication here held up by Allies’ censor.
                    Please telegraph substance of all treaties so far published.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
