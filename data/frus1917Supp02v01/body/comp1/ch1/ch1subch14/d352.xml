                <pb facs="0392" n="318" sameAs="frus:frus1917Supp02v01/pg318"/>

                <note rend="inline" type="source">File No. 763.72119/956</note>
                <head>
                    <hi rendition="#italic">The Chargé in Switzerland</hi> (<hi rendition="#italic"
                    >Wilson</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berne</hi></placeName>, <date
                            calendar="gregorian" when="1917-11-24T13:00:00+01:00">
                            <hi rendition="#italic">November 24, 1917, 1 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received November 26, 3.10
                        a.m.</hi>]</dateline>
                </opener>
                <p>3009. Following telegram from McNally,
                    Zürich:</p>
                <p>November 23. Should the German Government express a willingness to make known
                    their peace terms to a duly authorized American representative, would our
                    Government consider the appointment of such a person to receive them and to
                    confer and exchange ideas tending towards a basis for the discussion of peace
                    without any reference to a separate peace? Am informed that the German
                    Government would gladly enter into such an arrangement.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Wilson</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
