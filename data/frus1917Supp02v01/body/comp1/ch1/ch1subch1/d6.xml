    <text>
        <body>
            <div xml:id="d6">

                <pb facs="0080" n="6" sameAs="frus:frus1917Supp02v01/pg6"/>

                <note rend="inline" type="source">File No. 763.72112/4103a</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Ambassador in Great Britain</hi> (<hi rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-03-24T18:00:00-05:00">
                            <hi rendition="#italic">March 24, 1917</hi> [<hi rendition="#italic">6
                                p.m.</hi>]</date>
                    </dateline>
                </opener>
                <p>4586. It has been suggested that it would be desirable for you to get in touch
                    informally with Foreign Trade Bureau, British Government, with the idea of
                    getting their views as to possibility cooperation. If in your judgment it can be
                    properly done at this time suggest you have interview with proper officials
                    apparently on your own initiative and cable result.<anchor n="1" xml:id="d6-f1"
                    />
                </p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Polk</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d6-f1" n="1" xml:id="d6-f1-content">
                <p>Telegraphic replies not printed; for British suggestions see <ref
                        target="frus1917Supp02v02#pg_808">Vol. II, p. 808</ref>.</p>
            </note>
