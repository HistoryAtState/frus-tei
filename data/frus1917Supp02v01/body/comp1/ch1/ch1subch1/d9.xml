    <text>
        <body>
            <div xml:id="d9">

                <pb facs="0082" n="8" xml:id="pg8"/>

                <note rend="inline" type="source">File No. 763.72/3579</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Great Britain</hi> (<hi
                            rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-03-27T18:00:00-05:00">
                            <hi rendition="#italic">March 27, 1917, 6 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>4599. Your 5880, March 23, 7 p.m. Admiral will be sent as soon as
                        possible.<anchor n="1" xml:id="d9-f1"/>
                </p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d9-f1" n="1" xml:id="d9-f1-content">
                <p>
                    Admiral W. S. Sims sailed Mar. 31.</p>
            </note>
        </listAnnotation>
