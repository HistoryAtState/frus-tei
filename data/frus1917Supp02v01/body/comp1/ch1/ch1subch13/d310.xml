    <text>
        <body>
            <div xml:id="d310">

                <pb facs="0356" n="282" sameAs="frus:frus1917Supp02v01/pg282"/>

                <note rend="inline" type="source">File No. 763.72/7605</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        French Ambassador</hi> (<hi
                            rendition="#italic">Jusserand</hi>)</head>
                <opener>
                    <seg rendition="#float-left">No. 1983</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-10-30">
                            <hi rendition="#italic">October 30, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: I have the honor to enclose
                    herewith, for transmission to Your Excellency’s Government, a copy of a note
                    dated October 26, 1917,<anchor n="1" xml:id="d310-f1"/> from the Minister of
                    Serbia at this Capital, relative to the conference of the Allied powers to be
                    held at Paris next month.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Robert Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
