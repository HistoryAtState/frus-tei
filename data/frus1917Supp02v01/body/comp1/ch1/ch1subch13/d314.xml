    <text>
        <body>
            <div xml:id="d314">

                <pb facs="0358" n="284" sameAs="frus:frus1917Supp02v01/pg284"/>

                <note rend="inline" type="source">File No. 763.72/7501</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        French Ambassador</hi> (<hi
                            rendition="#italic">Jusserand</hi>)</head>
                <opener>
                    <seg rendition="#float-left">No. 1984</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-11-01">
                            <hi rendition="#italic">November 1, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: Referring to my recent note on the
                    subject of the participation by the Serbian Government in the conference of the
                    Allies at Paris, I have the honor to inform you that the American Minister at
                    Jassy has advised this Department that the Government of Roumania likewise
                    claims that it should participate in the same conference.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Robert Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
