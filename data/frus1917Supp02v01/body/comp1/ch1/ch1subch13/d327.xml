    <text>
        <body>
            <div xml:id="d327">

                <pb facs="0368" n="294" sameAs="frus:frus1917Supp02v01/pg294"/>

                <note rend="inline" type="source">File No. 862.20261/28</note>
                <head>
                    <hi rendition="#italic">The Consul at Tiflis</hi> (<hi
                            rendition="#italic">Smith</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 66</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Tiflis</hi></placeName>, <date
                            calendar="gregorian" when="1917-10-04">
                            <hi rendition="#italic">October 4, 1917</hi></date>. <lb/> [<hi
                            rendition="#italic">Received November 7.</hi>]</dateline>
                </opener>
                <p rendition="#center">Subject:—Propaganda among the Kurdish Tribes</p>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith for
                    the Department’s information a copy of my despatch to the Ambassador on the
                    above subject.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">F. Willoughby Smith</hi>
                        
                    </signed>
                </closer>



                <xi:include href="d327-a1.xml" xpointer="d327-a1"/>
            </div>
