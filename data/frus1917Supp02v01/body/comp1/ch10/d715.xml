    <text>
        <body>
            <div xml:id="d715">

                <pb facs="0852" n="778" sameAs="frus:frus1917Supp02v01/pg778"/>

                <note rend="inline" type="source">File No. 860c.01/61</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in France</hi> (<hi
                            rendition="#italic">Sharp</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-11-10T16:00:00-05:00">
                            <hi rendition="#italic">November 10, 1917, 4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>2799. Your 2622, October 19.<anchor n="1" xml:id="d715-f1"/> Please inform Mr.
                        Dmowski, President of the Polish
                    National Committee in Paris, that the Department has received his request that
                    the Government of the United States extend recognition to the Polish National
                    Committee at Paris as an official Polish organization.</p>
                <p>In reply the Department authorizes you hereby to extend such formal
                    recognition.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
