    <text>
        <body>
            <div xml:id="d245">

                <pb facs="0218" n="144" sameAs="frus:frus1865p2/pg144"/>

                <head>Sir F. Bruce to Mr. Hunter</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-05-16"><hi rendition="#italic"
                                >May</hi> 16, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor, at the request of the
                    governor of the Bahamas, to forward to you, for the information of the United
                    States government, copies of the report and evidence in the case of the wreck of
                    the United States schooner J. L. Gerrity, which was run ashore by her master on
                    one of the Bahamas on the 5th of April, and to beg that you will have the
                    goodness to communicate <pb facs="0219" n="145" xml:id="pg145"/> the same to the
                    owners of the schooner, and to such other persons as it may concern.</p>
                <p>I have the honor to be, with the highest consideration, sir, your most obedient,
                    humble servant,</p>
                <closer>
                    <signed>FREDERICK W. A. BRUCE.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">W. Hunter,</hi>
                        <hi rendition="#italic">&amp;c., &amp;c., &amp;c</hi>.</p>
                </postscript>


                <xi:include href="d245-a1.xml" xpointer="d245-a1"/>
            </div>
