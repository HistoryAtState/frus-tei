    <text>
        <body>
            <div xml:id="d271">

                <pb facs="0240" n="166" sameAs="frus:frus1865p2/pg166"/>

                <head>Sir F. Bruce to Mr.
                        Hunter</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-06-01"><hi rendition="#italic"
                                >June</hi> 1, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: At the request of the mayor of South port,
                    Lancashire, England, I have the honor to forward to you, for the United States
                    government and for Mrs. Lincoln, copies of resolutions<anchor n="*"
                        xml:id="d271-f1"/> passed at a public meeting of the inhabitants of that
                    town, expressive of the deep regret and indignation which the recent lamentable
                    events in the United States have occasioned.</p>
                <p>I have the honor to be, with the highest consideration, sir, your most obedient,
                    humble servant,</p>
                <closer>
                    <signed>FREDERICK W. A. BRUCE.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">W. Hunter,</hi>
                        <hi rendition="#italic">&amp;c., &amp;c., &amp;c</hi>.</p>
                </postscript>
            </div>
        </body>
    </text>
