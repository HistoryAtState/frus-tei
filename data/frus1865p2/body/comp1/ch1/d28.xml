    <text>
        <body>
            <div xml:id="d28">

                <pb facs="0091" n="17" sameAs="frus:frus1865p2/pg17"/>

                <head>Mr. Burnley to Mr.
                        Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-12-17"><hi rendition="#italic"
                                >December</hi> 17, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to communicate to you,
                    under the instructions which I have received from her Majesty’s principal
                    secretary of state for foreign affairs, the enclosed copy of a despatch
                    addressed to Lord Lyons relative to the intention of the United States
                    government, in conformity with the treaty reservation right, to increase their
                    naval armament upon the North American lakes.</p>
                <p>I have the honor to be, with the highest consideration, sir, your most obedient,
                    humble servant,</p>
                <closer>
                    <signed>J. HUME BURNLEY.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c</hi>.</p>
                </postscript>



                <xi:include href="d28-a1.xml" xpointer="d28-a1"/>
            </div>
