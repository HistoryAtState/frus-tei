    <text>
        <body>
            <div xml:id="d21-a1-a1">

                <pb facs="0086" n="12" sameAs="frus:frus1865p2/pg12"/>

                <head>General Dix to General
                        Halleck</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Headquarters Department of the
                                East</hi>, <hi rendition="#italic">New York</hi>,</placeName>
                        <date calendar="gregorian" when="1864-12-04"><hi rendition="#italic"
                                >December</hi> 4, 1864.</date></dateline></opener>
                <p>Respectfully forwarded, with enclosed papers, to Major General Halleck, chief of
                    staff, in response to the reference in this case of the 17th November, 1864.</p>
                <closer>
                    <signed>JOHN A. DIX, <hi rendition="#italic">Major General
                        Commanding.</hi></signed></closer>
            </div>
        </body>
    </text>
