    <text>
        <body>
            <div xml:id="d223">

                <pb facs="0210" n="136" sameAs="frus:frus1865p2/pg136"/>

                <head>Mr. Hunter to Sir F.
                        Bruce</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-04-25"><hi rendition="#italic"
                                >April</hi> 25, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Dear Sir:</hi> I have the pleasure of
                    acknowledging the receipt of your letter of the 3d instant, informing the
                    Secretary of State, at the instance of Lord Monck, of the decision of the
                    Canadian courts in regard to the St. Albans raiders and their subsequent
                    re-arrest on a charge of violating the Queen’s neutrality.</p>
                <p>I am, my dear sir, very faithfully yours,</p>
                <closer>
                    <signed>W. HUNTER, <hi rendition="#italic">Acting
                    Secretary.</hi></signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">Sir Frederick W. A. Bruce,</hi>
                        <hi rendition="#italic">&amp;c., &amp;c., &amp;c</hi>.</p>
                </postscript>
            </div>
        </body>
    </text>
