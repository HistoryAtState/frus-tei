    <text>
        <body>
            <div xml:id="d80">

                <pb facs="0121" n="47" sameAs="frus:frus1865p2/pg47"/>

                <head>Mr. Burnley to Mr. Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-01-17"><hi rendition="#italic"
                                >January</hi> 17, 1865,</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge the receipt
                    of your letter of the 14th instant, and to inform you, in reply, that copies of
                    it shall be forwarded to her Majesty’s government and to the lieutenant governor
                    of Bermuda.</p>
                <p>I have the honor to be, with the highest respect, sir, your most obedient, humble
                    servant,</p>
                <closer>
                    <signed>J, HUME BURNLEY.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">&amp;c., &amp;c., &amp;c</hi>.</p>
                </postscript>
            </div>
        </body>
    </text>
