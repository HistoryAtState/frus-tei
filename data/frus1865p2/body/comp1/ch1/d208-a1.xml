        <body>
            <div xml:id="d208-a1">

                <pb facs="0197" n="123" xml:id="pg123"/>

                <head>Order of the procession.</head>
                <p rendition="#center">Funeral escort in column of march.</p>
                <p rendition="#center">One regiment of cavalry.</p>
                <p rendition="#center">Two batteries of artillery.</p>
                <p rendition="#center">Battalion of marines.</p>
                <p rendition="#center">Two regiments of infantry.</p>
                <p rendition="#center">Commander of escort and staff.</p>
                <p rendition="#center">Dismounted officers of marine corps.</p>
                <p rendition="#center">Navy and army in the order named.</p>
                <p rendition="#center">Mounted officers of marine corps.</p>
                <p rendition="#center">Navy and army in the order named.</p>
                <p rendition="#center">All military officers to be in uniform, with side-arms.</p>
            </div>
        </body>
