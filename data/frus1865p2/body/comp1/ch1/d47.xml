    <text>
        <body>
            <div xml:id="d47">

                <pb facs="0105" n="31" sameAs="frus:frus1865p2/pg31"/>

                <head>Mr. Seward to Mr. Burnley</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1864-12-28"><hi rendition="#italic"
                                >December</hi> 28, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of the 13th instant, submitting for consideration a proposition to
                    bring the vessel James Douglas to New York, in order that a settlement may be
                    effected with the owners, and, in reply, to inform you that I have invited the
                    attention of the Secretary of the Navy to the matter.</p>
                <p>Accept the assurances of my high consideration.</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p>J. <hi rendition="#small-caps">Hume Burnley,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c</hi>.</p>
                </postscript>
            </div>
        </body>
    </text>
