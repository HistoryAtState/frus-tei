    <text>
        <body>
            <div xml:id="d256-a4">

                <pb facs="0234" n="160" sameAs="frus:frus1865p2/pg160"/>

                <opener><seg rendition="#center">[Enclosure.]</seg></opener>
                <opener><dateline rendition="#center">[From Brooklyn Daily Union, <date
                            calendar="gregorian" when="1865-05-08">May 8,
                    1865</date>.]</dateline></opener>
                <p rendition="#center">“<hi rendition="#italic">Annexation of Mexico and British
                        America to the United States.</hi></p>
                <p>“All in favor of this project, and those wishing to interest themselves in this
                    matter, will please address Geo. W. Gibbons, box 44, Brooklyn post office.”</p>
            </div>
