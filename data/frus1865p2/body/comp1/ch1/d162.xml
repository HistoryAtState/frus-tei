    <text>
        <body>
            <div xml:id="d162">

                <pb facs="0168" n="94" xml:id="pg94"/>

                <head>Mr. Burnley to Mr.
                        Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-03-11"><hi rendition="#italic"
                                >March</hi> 11, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I communicated to the governor general of
                    Canada a copy of your note of the 23d of February, relative to alleged plans of
                    persons residing in Canada for making hostile incursions into the United States,
                    and I have now the honor to transmit a copy of his excellency’s reply.</p>
                <p>I have the honor to be, with the highest consideration, sir, your most obedient,
                    humble servant,</p>
                <closer>
                    <signed>J. HUME BURNLEY.</signed></closer>
                <postscript>
                    <p>Hon. WILLIAM<hi rendition="#small-caps"> H. Seward,</hi>
                        <hi rendition="#italic">&amp;c., &amp;c., &amp;c</hi>.</p>
                </postscript>


                <xi:include href="d162-a1.xml" xpointer="d162-a1"/>
