    <text>
        <body>
            <div xml:id="d212">

                <pb facs="0200" n="126" sameAs="frus:frus1865p2/pg126"/>

                <head>Mr. Burnley to Mr. Hunter</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-04-08"><hi rendition="#italic"
                                >April</hi> 18, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I communicated to Governor Rawson a copy of
                    Mr. Seward’s note of the 8th ultimo, relative to five vessels supposed to have
                    been fitted out at the Bahamas for purposes hostile to the United States, and I
                    have now the honor to transmit a copy of his excellency’s answer.</p>
                <p>I have the honor to be, with high consideration, sir, your most obedient, humble
                    servant,</p>
                <closer>
                    <signed>J. HUME BURNLEY.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">W. Hunter,</hi>
                        <hi rendition="#italic">&amp;c., &amp;c., &amp;c</hi>.</p>
                </postscript>



                <xi:include href="d212-a1.xml" xpointer="d212-a1"/>
