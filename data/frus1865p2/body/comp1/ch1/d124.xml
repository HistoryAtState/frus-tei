    <text>
        <body>
            <div xml:id="d124">

                <pb facs="0147" n="73" sameAs="frus:frus1865p2/pg73"/>

                <head>Mr. Seward to Mr.
                        Burnley</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-02-14"><hi rendition="#italic"
                                >February</hi> 14, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of the 31st ultimo, and of the accompanying papers, from the
                    governor general of Canada, in relation to the two vessels building at Montreal
                    for the service of the insurgents, and I beg you will convey to him my thanks
                    for his prompt attention to the matter.</p>
                <p>I have the honor to be, with the highest consideration, sir, your obedient
                    servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p>J. <hi rendition="#small-caps">Hume Burnley,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c</hi>.</p>
                </postscript>
            </div>
        </body>
    </text>
