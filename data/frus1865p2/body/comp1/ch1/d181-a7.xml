    <text>
        <body>
            <div xml:id="d181-a7">

                <pb facs="0182" n="108" sameAs="frus:frus1865p2/pg108"/>

                <head>Depositions of George Dowie and Wm.
                    McComb.</head>
                <p>
                    <placeName><hi rendition="#small-caps">British Consulate</hi>, <hi
                            rendition="#italic">Port of Charleston</hi>:</placeName></p>
                <p>George Dowie, of Bee street, druggist, and William McComb, of No. 33 Vanderhorst
                    street, dealer in dry goods, severally make oath and say that they were present
                    this morning at the interviews had by W. F. Paddon with Lieutenant Haviland and
                    Colonel Woodford, and that his statement of what transpired, detailed in the
                    foregoing affidavit, is correct.</p>
                <p rendition="#right">GEO. DOWIE.</p>
                <p rendition="#right">W. McCOMB.</p>
                <closer><dateline rendition="#float-left">Sworn before me, <date
                            calendar="gregorian" when="1865-03-06">this 6th March,
                        1865</date>.</dateline>
                    <lb/>
                    <signed>H. P. WALKER, <hi rendition="#italic">Her Majesty’s Acting
                        Consul,</hi></signed></closer>
            </div>
        </body>
    </text>
