    <text>
        <body>
            <div xml:id="d137-a1">

                <pb facs="0155" n="81" sameAs="frus:frus1865p2/pg81"/>

                <head>Viscount Monck to Mr. Burnley</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Quebec,</hi></placeName>
                        <date calendar="gregorian" when="1865-02-18"><hi rendition="#italic"
                                >February</hi> 18, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your despatch of February 9, with copy of a note from the Secretary of State
                    of the United States respecting a reported organization, at Cape Vincent, with a
                    view to a marauding expedition upon Canadian territory.</p>
                <p>I shall feel much obliged if you will convey to Mr. Seward my thanks for the
                    information and for the steps taken by the authorities of the United States to
                    frustrate the design.</p>
                <p>I have, &amp;c.,</p>
                <closer>
                    <signed>MONCK</signed></closer>
                <postscript>
                    <p>J. <hi rendition="#small-caps">Hume Burnley,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c</hi>.</p>
                </postscript>
            </div>
        </body>
    </text>
