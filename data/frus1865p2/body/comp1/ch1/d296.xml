    <text>
        <body>
            <div xml:id="d296">

                <pb facs="0255" n="181" sameAs="frus:frus1865p2/pg181"/>

                <head>Mr. Tindall to Mr. Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Aylmer, Canada West,</hi></placeName>
                        <date calendar="gregorian" when="1865-06-20"><hi rendition="#italic"
                                >June</hi> 20, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I am directed to transmit to you the
                    enclosed resolution,<anchor n="*" xml:id="d296-f1"/> which was unanimously
                    passed at the late session of the conference of the Methodist New Connexion
                    church of Canada;</p>
                <p>And remain, yours, with respect,</p>
                <closer>
                    <signed>WILLIAM TINDALL,<hi rendition="#italic">Secretary of
                        Conference.</hi></signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, U. S.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
