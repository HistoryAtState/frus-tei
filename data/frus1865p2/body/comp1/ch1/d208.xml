    <text>
        <body>
            <div xml:id="d208">

                <pb facs="0196" n="122" sameAs="frus:frus1865p2/pg122"/>

                <head>Mr. Hunter to Mr.
                        Burnley</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-04-18"><hi rendition="#italic"
                                >April</hi> 18, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to enclose a programme of
                    arrangements for the obsequies of the late President. The religious services
                    will take place at the Executive Mansion at twelve o’clock m. to-morrow. Your
                    attendance at about half-past eleven is invited.</p>
                <p>I have the honor to be, with the highest consideration, your obedient
                    servant,</p>
                <closer>
                    <signed>W. HUNTER, <hi rendition="#italic">Acting
                    Secretary.</hi></signed></closer>
                <postscript>
                    <p>J. <hi rendition="#small-caps">Hume Burnley,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c</hi>.</p>
                    <p>[Same, <hi rendition="#italic">mutatis mutandis,</hi> to all foreign
                        ministers in the United States.]</p>
                </postscript>




                <xi:include href="d208-a1.xml" xpointer="d208-a1"/>
