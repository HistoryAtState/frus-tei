    <text>
        <body>
            <div xml:id="d252-a3">

                <pb facs="0231" n="157" sameAs="frus:frus1865p2/pg157"/>

                <head>Mr. Lousada to Mr.
                        Goodrich</head>
                <opener>
                    <seg rendition="#float-left">Private.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Her Britannic Majesty’s
                                Consulate,</hi>
                            <hi rendition="#italic">Boston,</hi></placeName>
                        <date calendar="gregorian" when="1865-05-04"><hi rendition="#italic"
                                >May</hi> 4, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Dear Sir:</hi> May I shortly expect an answer to my
                    despatch to you of the 22d ultimo, relative to the measurement of British
                    vessels?</p>
                <p>I am, &amp;c.,</p>
                <closer>
                    <signed>F. LOUSADA, <hi rendition="#italic">Her Britannic Majesty’s
                        Consul.</hi></signed></closer>
                <postscript>
                    <p>Hon. J. Z. <hi rendition="#small-caps">Goodrich.</hi></p>
                </postscript>
            </div>
        </body>
