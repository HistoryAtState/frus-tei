    <text>
        <body>
            <div xml:id="d256-a5">

                <pb facs="0234" n="160" sameAs="frus:frus1865p2/pg160"/>

                <opener><seg rendition="#center">[Enclosure.]</seg></opener>
                <head>Mr. Gibbons to X.
                        Y.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>“<hi rendition="#small-caps">New York,</hi></placeName>
                        <date calendar="gregorian" when="1865-05-16"><hi rendition="#italic"
                                >May</hi> 16, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">“Dear Sir:</hi> Yours of the 13th received, and, in
                    answer, would say that it is the intention of the party to which I am the leader
                        <hi rendition="#italic">pro tem.</hi> to declare war against Great Britain
                    by invading the Canadas. I have 3,000 men now enlisted.</p>
                <p>“Respectfully,</p>
                <closer>
                    <signed>GEO. W. GIBBONS, “<hi rendition="#italic">Box</hi> 44, <hi
                            rendition="#italic">Brooklyn Post Office.”</hi></signed></closer>
            </div>
        </body>
    </text>
