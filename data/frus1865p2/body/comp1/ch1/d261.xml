    <text>
        <body>
            <div xml:id="d261">

                <pb facs="0236" n="162" sameAs="frus:frus1865p2/pg162"/>

                <head>Mr. Hunter to Sir F. Bruce</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-05-26"><hi rendition="#italic"
                                >May</hi> 26, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I will be very much obliged by your having
                    the genuineness of my signature on the certificate appended to the enclosed
                    papers relating to the Chesapeake case duly authenticated under the seal of your
                    legation, and the papers returned to this department at your earliest
                    convenience.</p>
                <p>I have the honor to be, with the highest consideration, sir, your obedient
                    servant,</p>
                <closer>
                    <signed>W. HUNTER, <hi rendition="#italic">Acting
                    Secretary.</hi></signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">Sir Frederick W. A. Bruce,</hi>
                        <hi rendition="#italic">&amp;c., &amp;c., &amp;c</hi>.</p>
                </postscript>
            </div>
        </body>
    </text>
