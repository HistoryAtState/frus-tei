    <text>
        <body>
            <div xml:id="d94">

                <pb facs="0128" n="54" sameAs="frus:frus1865p2/pg54"/>

                <head>Mr. Burnley to Mr.
                        Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-01-25"><hi rendition="#italic"
                                >January</hi> 25, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge receipt of
                    your note of the 23d instant, and inform you that a copy of it shall be
                    communicated to the proper authorities.</p>
                <p>I have the honor to be, with the highest consideration, sir, your most obedient,
                    humble servant,</p>
                <closer>
                    <signed>J. HUME BURNLEY.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">&amp;c., &amp;c., &amp;c</hi>.</p>
                </postscript>
            </div>
        </body>
    </text>
