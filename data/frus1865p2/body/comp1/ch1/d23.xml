    <text>
        <body>
            <div xml:id="d23">

                <pb facs="0089" n="15" sameAs="frus:frus1865p2/pg15"/>

                <head>Mr. Seward to Mr.
                        Burnley</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-12-15"><hi rendition="#italic"
                                >December</hi> 15, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge the receipt
                    of your note of the 9th instant, relative to the case of the Labuan, and, in
                    reply, to inform you that it will receive attention.</p>
                <p>Accept, sir, a renewed assurance of my high consideration.</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p>J. <hi rendition="#small-caps">Hume Burnley,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c</hi>.</p>
                </postscript>
            </div>
        </body>
    </text>
