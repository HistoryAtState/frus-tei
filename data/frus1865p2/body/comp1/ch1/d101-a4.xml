    <text>
        <body>
            <div xml:id="d101-a4">

                <pb facs="0135" n="61" sameAs="frus:frus1865p2/pg61"/>

                <head>Mr. Futvoye to Mr.
                        O’Meara</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Crown Law Department,</hi>
                            <hi rendition="#italic">Quebec,</hi></placeName>
                        <date calendar="gregorian" when="1865-01-17"><hi rendition="#italic"
                                >January</hi> 17, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I am directed by the honorable the attorney
                    general for Lower Canada to transmit to you the enclosed letter of the collector
                    of customs at Montreal, and to request you to return it, at your early
                    convenience, with such further information as you may be able to furnish on the
                    subject-matter thereof.</p>
                <p>I have, &amp;c.,</p>
                <closer>
                    <signed>GEOEGE FUTVOYE, <hi rendition="#italic">Clerk of Crown Law
                            Department.</hi></signed></closer>
                <postscript>
                    <p>J. P. <hi rendition="#small-caps">O’Meara,</hi> Esq., <hi rendition="#italic"
                            >Measuring Surveyor, her Majesty’s Customs, Quebec.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
