    <text>
        <body>
            <div xml:id="d12">

                <pb facs="0082" n="8" xml:id="pg8"/>

                <head>Mr. Burnley to Mr. Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-12-12"><hi rendition="#italic"
                                >December</hi> 12, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I forwarded, on the 30th ultimo, to his
                    excellency the governor general of Canada, copies of your note of the 29th
                    ultimo, and of its enclosures, relative to the alleged existence of a military
                    organization in Canada of fugitives from the United States.</p>
                <p>I have now the honor to transmit to you a copy of his excellency’s reply.</p>
                <p>I have the honor to be, with the highest consideration, sir, your most obedient,
                    humble servant,</p>
                <closer>
                    <signed>J. HUME BURNLEY.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">&amp;c., &amp;c., &amp;c</hi>.</p>
                </postscript>


                <xi:include href="d12-a1.xml" xpointer="d12-a1"/>
