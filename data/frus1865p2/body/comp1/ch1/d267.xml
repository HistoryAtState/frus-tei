    <text>
        <body>
            <div xml:id="d267">

                <pb facs="0238" n="164" sameAs="frus:frus1865p2/pg164"/>

                <head>Sir F. Bruce to Mr. Hunter</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-05-29"><hi rendition="#italic"
                                >May</hi> 29, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to transmit to you a copy
                    of a despatch which I have received from the governor of Newfoundland, enclosing
                    a resolution of the executive council of that colony with reference to the
                    assassination of President Lincoln.</p>
                <p>I have the honor to be, with the highest consideration sir, your most obedient,
                    humble servant,</p>
                <closer>
                    <signed>FREDEKICK W. A. BRUCE.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">W. Hunter,</hi>
                        <hi rendition="#italic">&amp;c., &amp;c., &amp;c</hi>.</p>
                </postscript>


                <xi:include href="d267-a1.xml" xpointer="d267-a1"/>
