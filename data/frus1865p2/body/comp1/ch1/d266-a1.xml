    <text>
        <body>
            <div xml:id="d266-a1">

                <pb facs="0238" n="164" xml:id="pg164"/>

                <head>Mr. Ashton to Mr. Hunter</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Attorney General’s Office</hi>, <hi
                                rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-05-29"><hi rendition="#italic"
                                >May</hi> 29, 1865</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to enclose you herewith a
                    copy of a letter addressed under the in struction of the attorney general to the
                    United States attorney for the eastern district of New York, relative to the
                    subject-matter of the communication of Sir Frederick Bruce to your department,
                    dated the 19th instant.</p>
                <p>Very respectfully, your obedient servant,</p>
                <closer>
                    <signed>J. HUBLEY ASHTON, <hi rendition="#italic">Assistant Attorney
                            General.</hi></signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">W. Hunter</hi>, <hi rendition="#italic"
                            >Acting Secretary of State.</hi></p>
                </postscript>


                <xi:include href="d266-a1-a1.xml" xpointer="d266-a1-a1"/>
