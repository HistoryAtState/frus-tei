    <text>
        <body>
            <div xml:id="d154-a1-a3">

                <pb facs="0165" n="91" xml:id="pg91"/>

                <head>Mr. Bunch to the Registrar</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Havana,</hi></placeName>
                        <date calendar="gregorian" when="1865-02-08"><hi rendition="#italic"
                                >February</hi> 8, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor of transmitting to you
                    herewith the British certificate of registry of steamer AImandares, official
                    number 46,257, of your port, sold this day to Spanish subjects for $81,340,
                    currency of Canada.</p>
                <p>I remain, &amp;c.,</p>
                <closer>
                    <signed>JOHN BUNCH, <hi rendition="#italic">Consul
                    General.</hi></signed></closer>
                <postscript>
                    <p>The REGISTRAR, <hi rendition="#italic">Montreal, Canada.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
