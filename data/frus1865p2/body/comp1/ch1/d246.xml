    <text>
        <body>
            <div xml:id="d246">

                <pb facs="0228" n="154" sameAs="frus:frus1865p2/pg154"/>

                <head>Sir F. Bruce to Mr. Hunter</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-05-16"><hi rendition="#italic"
                                >May</hi> 16, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I am instructed to forward the enclosed
                        letter,<anchor n="*" xml:id="d246-f1"/> addressed by her Majesty the Queen
                    to the honorable Mrs. Lincoln, and I shall feel obliged if you will cause it to
                    be delivered to that lady without delay.</p>
                <p>I have the honor to be, with the highest consideration, sir, your most obedient,
                    humble servant,</p>
                <closer>
                    <signed>FREDERICK W. A. BRUCE.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William Hunter,</hi>
                        <hi rendition="#italic">&amp;c., &amp;c., &amp;c</hi>.</p>
                </postscript>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d246-f1" n="*" xml:id="d246-f1-content">
                <p>Transmitted to Mrs. Lincoln.</p>
            </note>
        </listAnnotation>
    </standOff>
