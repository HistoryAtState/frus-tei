    <text>
        <body>
            <div xml:id="d128">

                <pb facs="0151" n="77" xml:id="pg77"/>

                <head>Mr. Burnley to Mr.
                        Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">British Legation,</hi></placeName>
                        <date calendar="gregorian" when="1865-02-17"><hi rendition="#italic"
                                >February</hi> 17, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Dear Sir</hi>: The lieutenant governor of New
                    Brunswick telegraphs this morning that “Linus Seely, one of the Chesapeake
                    captors, has been arrested at St. John.”</p>
                <p>Very faithfully yours,</p>
                <closer>
                    <signed>J. HUME BURNLEY.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">&amp;c., &amp;c., &amp;c</hi>.</p>
                </postscript>
            </div>
        </body>
    </text>
