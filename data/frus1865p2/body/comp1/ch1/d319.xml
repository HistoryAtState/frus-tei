    <text>
        <body>
            <div xml:id="d319">

                <pb facs="0267" n="193" sameAs="frus:frus1865p2/pg193"/>

                <head>Sir F. Bruce to Mr. Hunter</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-10-23"><hi rendition="#italic"
                                >October</hi> 23, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> In accordance with instructions which I
                    have received from her Majesty’s principal secretary of state for foreign
                    affairs, I have the honor to transmit to you herewith, for the information of
                    the government of the United States, two addresses from the legislative council
                    and assembly of Victoria, Australia, to her Majesty the Queen, on receipt of the
                    intelligence of the assassination of the late President Lincoln.</p>
                <p>I have the honor to be, with the highest consideration, sir, your most obedient,
                    humble servant,</p>
                <closer>
                    <signed>FREDERICK W. A. BRUCE.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William HUNter,</hi>
                        <hi rendition="#italic">&amp;c., &amp;c., &amp;c</hi>.</p>
                </postscript>
            </div>
        </body>
    </text>
