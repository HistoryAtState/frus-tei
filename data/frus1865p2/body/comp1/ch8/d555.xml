    <text>
        <body>
            <div xml:id="d555">

                <pb facs="0509" n="435" sameAs="frus:frus1865p2/pg435"/>

                <head>Mr. Burlingame to Mr. Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 102]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">Peking,</hi></placeName>
                        <date calendar="gregorian" when="1865-03-11"><hi rendition="#italic"
                                >March</hi> 11, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to send herewith
                    correspondence in relation to the prohibitions that exist in China against
                    entering forbidden places.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>ANSON BURLINGAME.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State, Washington,</hi></p>
                </postscript>



                <xi:include href="d555-a1.xml" xpointer="d555-a1"/>
