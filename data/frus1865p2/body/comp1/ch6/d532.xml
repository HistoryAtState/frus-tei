    <text>
        <body>
            <div xml:id="d532">

                <pb facs="0472" n="398" sameAs="frus:frus1865p2/pg398"/>

                <head>Mr. Seward to Mr. Pike</head>
                <opener>
                    <seg rendition="#float-left">No. 258]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-11-06"><hi rendition="#italic"
                                >November</hi> 6, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have received your despatch of the 18th
                    ultimo, No. 178, and shall cause that part of it which relates to cholera to be
                    published. The despatch, as a whole, is approved.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">James</hi> S. <hi rendition="#small-caps"
                            >Pike,</hi> Esq., <hi rendition="#italic"
                        >&amp;c.,&amp;c.,&amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
