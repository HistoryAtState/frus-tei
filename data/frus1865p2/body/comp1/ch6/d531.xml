    <text>
        <body>
            <div xml:id="d531">

                <pb facs="0472" n="398" sameAs="frus:frus1865p2/pg398"/>

                <head>Mr. Seward to Mr.
                        Pike</head>
                <opener>
                    <seg rendition="#float-left">No. 257.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-11-06"><hi rendition="#italic"
                                >November</hi> 6, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir: You</hi> will excuse my delay in acknowledging
                    your despatch of May 31, No. 168. Your proceedings therein referred to are
                    approved, and your obser vations upon the European sentiment towards the United
                    States are appreciated.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">James</hi> S. <hi rendition="#small-caps"
                            >Pike,</hi> Esq., <hi rendition="#italic"
                        >&amp;c.,&amp;c.,&amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
