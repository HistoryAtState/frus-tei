    <text>
        <body>
            <div xml:id="d336">

                <pb facs="0277" n="203" sameAs="frus:frus1865p2/pg203"/>

                <head>Mr. Seward to Mr. Pennington</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State;</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-12-23"><hi rendition="#italic"
                                >December</hi> 23, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have received your despatch of the 2d
                    instant, No. 1, announcing to this department the sudden death of the Hon.
                    William L. Dayton, minister resident of the United States at Paris.</p>
                <p>You are instructed to commit the archives of the legation to J. Bigelow, esq.,
                    late the United States consul at Paris, who has been appointed charge d’affaires
                        <hi rendition="#italic">ad interim.</hi></p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p>W. S. <hi rendition="#small-caps">Pennington,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c</hi>.</p>
                </postscript>
            </div>
        </body>
    </text>
