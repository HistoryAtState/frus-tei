    <text>
        <body>
            <div xml:id="d373">

                <pb facs="0314" n="240" sameAs="frus:frus1865p2/pg240"/>

                <head>Mr. Seward to Mr.
                        Bigelow</head>
                <opener>
                    <seg rendition="#float-left">No. 60.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-03-07"><hi rendition="#italic"
                                >March</hi> 7, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have to acknowledge the receipt of your
                    very interesting despatch of the 9th ultimo, No. 24, informing me of the opinion
                    entertained by Prince Murat of the sudden departure of the King of Italy from
                    Turin for Florence.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">John Bigelow,</hi> Esq., <hi rendition="#italic"
                            >&amp;c., &amp;c., &amp;c</hi>.</p>
                </postscript>
            </div>
        </body>
    </text>
