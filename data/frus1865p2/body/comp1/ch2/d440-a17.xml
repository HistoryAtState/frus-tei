    <text>
        <body>
            <div xml:id="d440-a17">

                <pb facs="0414" n="340" sameAs="frus:frus1865p2/pg340"/>


                <head>Mr. Bigelow to Mr. Pelatte</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Paris,</hi></placeName>
                        <date calendar="gregorian" when="1865-05-13"><hi rendition="#italic"
                                >May</hi> 13, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I am in receipt of your favor of the 10th
                    instant, covering an address from the Americans resident at Nice to the
                    President of the United States.</p>
                <p>I shall lose no time in transmitting it, agreeably to their request and
                    yours.</p>
                <p>I am, sir, with great respect, your obedient servant,</p>
                <closer>
                    <signed>JOHN BIGELOW.</signed></closer>
                <postscript>
                    <p>Mr. <hi rendition="#small-caps">Leon Pelatte.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
