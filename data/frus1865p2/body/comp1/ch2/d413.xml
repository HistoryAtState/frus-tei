    <text>
        <body>
            <div xml:id="d413">

                <pb facs="0370" n="296" sameAs="frus:frus1865p2/pg296"/>

                <head>Mr. Bigelow to Mr.
                        Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 97.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">Paris,</hi></placeName>
                        <date calendar="gregorian" when="1865-05-23"><hi rendition="#italic"
                                >May</hi> 23, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have this day addressed to Mr. Cochin a
                    letter, of which the enclosure No. 1 is a copy and No. 2 a translation, in reply
                    to his note of the 17th instant, eommunicating to me an address from the French
                    Committee of Emancipation to the President of the United States.</p>
                <p>I am, sir, with great respect, your obedient servant,</p>
                <closer>
                    <signed>JOHN BIGELOW.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington.</hi></p>
                </postscript>


                <xi:include href="d413-a1.xml" xpointer="d413-a1"/>
            </div>
        </body>
    </text>
