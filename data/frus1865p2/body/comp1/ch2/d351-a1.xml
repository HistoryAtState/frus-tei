    <text>
        <body>
            <div xml:id="d351-a1">

                <pb facs="0290" n="216" sameAs="frus:frus1865p2/pg216"/>

                <head>[Enclosure No. 1.—&amp;c.,Telegraphic despatch.]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Madrid,</hi></placeName>
                        <date calendar="gregorian" when="1865-02-05"><hi rendition="#italic"
                                >February</hi> 5, 1865—7 1/2 o’clock.</date></dateline></opener>
                <p>It is the iron-clad steamer Stonewall, Captain V. G. Page; 3 cannon; 300
                    horse-power; 79 crew; from Copenhagen for America; at dock-yard of Ferrol; asks
                    repairs.</p>
                <closer>
                    <signed>HORATIO PERRY.</signed></closer>
                <postscript>
                    <p>Mr. ———— ————, <hi rendition="#italic">Chargé d’Affaires of the United States
                            at Paris.</hi></p>
                </postscript>
            </div>
        </body>
