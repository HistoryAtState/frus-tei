    <text>
        <body>
            <div xml:id="d370">

                <pb facs="0313" n="239" sameAs="frus:frus1865p2/pg239"/>

                <head>Mr. Bigelow to Mr. Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 43.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">Paris,</hi></placeName>
                        <date calendar="gregorian" when="1865-03-06"><hi rendition="#italic"
                                >March</hi> 6, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> In consequence of information received from
                    Mr. Dudley, our consul at Liverpool, this morning, I addressed a note, of which
                    I enclose a copy, to his excellency the minister of foreign affairs.</p>
                <p>I am, sir, with great respect, your very obedient servant,</p>
                <closer>
                    <signed>JOHN BIGELOW.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State,</hi> &amp;<hi
                            rendition="#italic">c</hi>.,</p>
                </postscript>


                <xi:include href="d370-a1.xml" xpointer="d370-a1"/>
            </div>
