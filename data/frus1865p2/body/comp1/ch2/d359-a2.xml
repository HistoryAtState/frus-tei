    <text>
        <body>
            <div xml:id="d359-a2">

                <pb facs="0301" n="227" sameAs="frus:frus1865p2/pg227"/>

                <head>[Enclosure No. 3.—Translation of No. 2.]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Port of La Paz</hi>, <hi
                                rendition="#italic">Mexico,</hi></placeName>
                        <date calendar="gregorian" when="1864-10-30"><hi rendition="#italic"
                                >October</hi> 30, 1864.</date></dateline></opener>
                <p>I declare having seized on board the schooner W. Richardson, Captain George
                    Goodrum, one hundred barrels of powder, against protest of the said captain.</p>
                <p rendition="#right">A. DE LA COUVE, <hi rendition="#italic">The officer on
                        service.</hi></p>
                <p rendition="#right"><hi rendition="#small-caps">United States Consulate,</hi>
                    <hi rendition="#italic">La Paz, November</hi> 22, 1864.</p>
                <p>I, the undersigned, consul of the United States of America for La Paz, &amp;c, do
                    hereby cer tify that the above declaration is a true and faithful copy of the
                    original filed in this office, the same having been compared by me and found to
                    agree therewith, word for word and figure for figure.</p>
                <p><hi rendition="#small-caps">[seal.]</hi></p>
                <closer>
                    <signed>F. B. ELMER, <hi rendition="#italic">U. S.
                    Consul.</hi></signed></closer>
            </div>
        </body>
