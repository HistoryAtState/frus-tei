    <text>
        <body>
            <div xml:id="d440-a4">

                <pb facs="0411" n="337" xml:id="pg337"/>

                <opener><seg rendition="#center">[Translation.]</seg></opener>

                <head>Mr. Bigelow to Mr.
                        Isoard</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Paris,</hi></placeName>
                        <date calendar="gregorian" when="1865-05-04"><hi rendition="#italic"
                                >May</hi> 4, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I thank you heartily for the sympathy you
                    have pleased to show towards my country and its government on the occasion of
                    the calamity which has just stricken them so cruelly.</p>
                <p>Accept, I pray you, sir, the assurance of my distinguished respects.</p>
                <closer>
                    <signed>JOHN BIGELOW.</signed></closer>
                <postscript>
                    <p>Mr. E. <hi rendition="#small-caps">Isoard.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
