            <div xml:id="d350-a2">

                <pb facs="0289" n="215" sameAs="frus:frus1865p2/pg215"/>

                <p>[Enclosure No. 2]</p>
                <p><hi rendition="#small-caps">United States Consul, Paris:</hi></p>
                <p>Stoerkodder on outward clearance; thirty tons coal exported; previous stock on
                    board un-known; went into Christians and, also to the Texel, January 19; left
                    21st for Bordeaux.</p>
                <closer>
                    <signed>HANSEN.</signed></closer>
            </div>
        </body>
