    <text>
        <body>
            <div xml:id="d437">

                <pb facs="0407" n="333" sameAs="frus:frus1865p2/pg333"/>

                <head>Mr. Hunter to Mr. Bigelow</head>
                <opener>
                    <seg rendition="#float-left">No. 217.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-07-31"><hi rendition="#italic"
                                >July</hi> 31, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your despatch of the 14th instant, No. 144,
                    relative to the movement alleged to have been on foot for the purpose of
                    convening a European congress, has been received and read with interest.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>W. HUNTER, <hi rendition="#italic">Acting
                    Secretary.</hi></signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">John Bigelow,</hi> Esq.,<hi rendition="#italic"
                            >&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
