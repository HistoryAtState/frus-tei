    <text>
        <body>
            <div xml:id="d430">

                <pb facs="0404" n="330" sameAs="frus:frus1865p2/pg330"/>

                <head>Mr. Hunter to Mr. Bigelow</head>
                <opener>
                    <seg rendition="#float-left">No. 189.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-07-03"><hi rendition="#italic"
                                >July</hi> 3, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I enclose for your information a copy of a
                    letter of the 22d ultimo,<anchor n="*" xml:id="d430-f1"/> addressed by the
                    Secretary of the Navy to Rear-Admiral Groldsborough, upon the subject of the
                    withdrawal from the insurgents of the character of belligerents, and the
                    proceedings of the Navy Department in view thereof.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>W. HUNTER, <hi rendition="#italic">Acting
                    Secretary.</hi></signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">John Bigelow,</hi> Esq., <hi rendition="#italic"
                            >&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d430-f1" n="*" xml:id="d430-f1-content">
                <p>See enclosure to instructions No. 1473 to Mr. Adams.</p>
            </note>
        </listAnnotation>
