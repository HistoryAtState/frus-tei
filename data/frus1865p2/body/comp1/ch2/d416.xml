    <text>
        <body>
            <div xml:id="d416">

                <pb facs="0373" n="299" sameAs="frus:frus1865p2/pg299"/>

                <head>Mr. Hunter to Mr.
                        Bigelow</head>
                <opener>
                    <seg rendition="#float-left">No. 156.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-05-29"><hi rendition="#italic"
                                >May</hi> 29, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your despatch of the 12th instant, No. 92,
                    and its accompanying copy of a note which you addressed to Mr. Drouyn de Lhuys
                    upon the subject of the President’s proclamations, which were transmitted to you
                    with my instruction, No. 112, has been received and is approved.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>W. HUNTER, <hi rendition="#italic">Acting
                    Secretary.</hi></signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">John Bigelow,</hi> Esq., <hi rendition="#italic"
                            >&amp;</hi>c., <hi rendition="#italic">&amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
