    <text>
        <body>
            <div xml:id="d428">

                <pb facs="0402" n="328" sameAs="frus:frus1865p2/pg328"/>

                <head>Mr. Bigelow to Mr.
                        Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 127.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">Paris,</hi></placeName>
                        <date calendar="gregorian" when="1865-06-26"><hi rendition="#italic"
                                >June</hi> 26, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to enclose a copy of my
                    letter to M. Cochin, secretary of the French emancipation society, written in
                    compliance with the instructions contained in Mr. Hunter’s despatch No. 161.</p>
                <p>I am, sir, with great respect, your very obedient servant,</p>
                <closer>
                    <signed>JOHN BIGELOW.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, &amp;c., &amp;c.,
                        &amp;c.</hi></p>
                </postscript>



                <xi:include href="d428-a1.xml" xpointer="d428-a1"/>
            </div>
