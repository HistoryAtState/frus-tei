    <text>
        <body>
            <div xml:id="d440-a28">

                <pb facs="0417" n="343" sameAs="frus:frus1865p2/pg343"/>


                <head>Mr. Bigelow to Mr. Lesley</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Paris,</hi></placeName>
                        <date calendar="gregorian" when="1865-06-06"><hi rendition="#italic"
                                >June</hi> 6, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Dear Sir:</hi> I have received the address from the
                    democrats of Lyons which you sent me, and will lose no time in transmitting it
                    to the President.</p>
                <p>I am, dear sir, with great respect, your obedient servant,</p>
                <closer>
                    <signed>JOHN BIGELOW.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">James Lesley,</hi> Esq., <hi rendition="#italic"
                            >Consul of the United States.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
