    <text>
        <body>
            <div xml:id="d366">

                <pb facs="0306" n="232" sameAs="frus:frus1865p2/pg232"/>

                <head>Mr. Bigelow to Mr. Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 39.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">Paris,</hi></placeName>
                        <date calendar="gregorian" when="1865-02-28"><hi rendition="#italic"
                                >February</hi>28, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Enclosed you will find a rejoinder from his
                    excellency the minister of foreign affairs to my communication of the 31st of
                    January last, in reference to the <hi rendition="#italic">repatriation</hi> of
                    William Horace Castaned, of Mobile, an inmate of a workhouse at
                    Grafienstaden.</p>
                <p>I am, sir, with great respect, your obedient servant,</p>
                <closer>
                    <signed>JOHN BIGELOW.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State,</hi>
                        <hi rendition="#italic">&amp;c., &amp;c., &amp;c</hi>.</p>
                </postscript>


                <xi:include href="d366-a1.xml" xpointer="d366-a1"/>
            </div>
