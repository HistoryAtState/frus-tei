    <text>
        <body>
            <div xml:id="d449">

                <pb facs="0424" n="350" sameAs="frus:frus1865p2/pg350"/>

                <head>Mr. Seward to Mr. Bigelow</head>
                <opener>
                    <seg rendition="#float-left">No. 294.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-10-30"><hi rendition="#italic"
                                >October</hi> 30, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your despatch of the 13th of October, No.
                    184, has been received. I thank you for the information you have given me of the
                    manner in which my No. 264 was received by Mr. Drouyn de Lhuys, and I shall wait
                    with interest for an account of the imperial purposes in regard to the matter
                    therein presented.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">John Bigelow,</hi> Esq., <hi rendition="#italic"
                            >&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
