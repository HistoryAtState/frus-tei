    <text>
        <body>
            <div xml:id="d427">

                <pb facs="0402" n="328" sameAs="frus:frus1865p2/pg328"/>

                <head>Mr. Hunter to Mr. Bigelow</head>
                <opener>
                    <seg rendition="#float-left">No. 185.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-06-26"><hi rendition="#italic"
                                >June</hi> 26, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have to acknowledge the receipt of your
                    despatch of the 9th instant, No. 116, with five accompaniments, in regard to the
                    withdrawal of the concession of belligerent rights to the insurgents by
                    France.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>W. HUNTER, <hi rendition="#italic">Acting
                    Secretary.</hi></signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">John Bigelow,</hi> Esq., <hi rendition="#italic"
                            >&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
