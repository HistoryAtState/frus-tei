    <text>
        <body>
            <div xml:id="d398">

                <pb facs="0357" n="283" sameAs="frus:frus1865p2/pg283"/>

                <head>Mr. Hunter to Mr. Bigelow</head>
                <opener>
                    <seg rendition="#float-left">No. 115.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-04-20"><hi rendition="#italic"
                                >April</hi> 20, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have to acknowledge the receipt of your
                    despatch of the 4th instant, No. 67, including copies of certain documents which
                    you have received from Mr. Wood, our minister at Copenhagen, relative to the
                    delivery of the steamer Stonewall, alias Olinde, to officers of the insurgent
                    navy.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>W. HUNTER, <hi rendition="#italic">Acting
                    Secretary.</hi></signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">John Bigelow,</hi> Esq., <hi rendition="#italic"
                            >&amp;c.,&amp;c.,&amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
