    <text>
        <body>
            <div xml:id="d377">

                <pb facs="0316" n="242" sameAs="frus:frus1865p2/pg242"/>

                <head>Mr. Bigelow to Mr. Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 56.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">Paris,</hi></placeName>
                        <date calendar="gregorian" when="1865-03-15"><hi rendition="#italic"
                                >March</hi> 15, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to enclose a copy and a
                    translation of a communication this day received from his excellency the
                    minister of foreign affairs, announcing the appointment of the Marquis de
                    Montholon to represent the Emperor of France in the quality of envoy
                    extraordinary and minister plenipotentiary at Washington.</p>
                <p>I am, sir, with great respect, your very obedient servant,</p>
                <closer>
                    <signed>JOHN BIGELOW.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State.</hi></p>
                </postscript>


                <xi:include href="d377-a1.xml" xpointer="d377-a1"/>
            </div>
