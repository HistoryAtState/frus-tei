    <text>
        <body>
            <div xml:id="d440-a19">

                <pb facs="0415" n="341" sameAs="frus:frus1865p2/pg341"/>

                <opener><seg rendition="#center">[Translation.]</seg></opener>

                <head>Mr. Bigelow to Mr. Lesperut</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Paris,</hi></placeName>
                        <date calendar="gregorian" when="1865-05-17"><hi rendition="#italic"
                                >May</hi> 17, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge the receipt
                    of your letter of the 12th, and of the bi ographical notice of the life of Mr.
                    Abraham Lincoln which accompanied it. I pray you to receive all my thanks, and
                    to believe in my most distinguished and most earnest regard.</p>
                <closer>
                    <signed>JOHN BIGELOW.</signed></closer>
                <postscript>
                    <p>Mr. <hi rendition="#small-caps">Lesperut.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
