    <text>
        <body>
            <div xml:id="d537">

                <pb facs="0475" n="401" sameAs="frus:frus1865p2/pg401"/>

                <head>Mr. Seward to Mr. van Limburg</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-02-09"><hi rendition="#italic"
                                >February</hi> 9, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge the receipt
                    of your note of the 20th ultimo, relative to the capture of the Netherlands ship
                    Geziena Hildegonda, and to inform you that I have submitted a translation
                    thereof for consideration to the Secretary of the Navy.</p>
                <p>Accept, sir, a renewed assurance of my high consideration.</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p>Mr. <hi rendition="#small-caps">Roest van Limburg</hi>, <hi
                            rendition="#italic">&amp;c.,&amp;c.,&amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
