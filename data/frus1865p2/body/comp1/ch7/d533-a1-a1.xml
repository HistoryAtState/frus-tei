    <text>
        <body>
            <div xml:id="d533-a1-a1">

                <pb facs="0473" n="399" sameAs="frus:frus1865p2/pg399"/>

                <opener><dateline rendition="#center">[From Southwest Pass, dated <date
                            calendar="gregorian" when="1864-12-15">December 15,
                        1864</date>.]</dateline></opener>
                <p><hi rendition="#small-caps">Netherlands Consul:</hi> The Dutch brig Geziena
                    Hildegonda has crossed the bar as a prize to the United States steam gunboat
                    Pembina. I am from Liverpool, bound to Matamoras. Please advise the British
                    consul of the above.</p>
                <closer>
                    <signed>B. P. JANSON, </signed>
                    <affiliation><hi rendition="#italic">Master.</hi>
                        <hi rendition="#small-caps">Am. Conturie,</hi>
                        <hi rendition="#italic">Consul des Pays Bas.</hi></affiliation></closer>
            </div>
        </body>
    </text>
