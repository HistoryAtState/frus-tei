    <text>
        <body>
            <div xml:id="d462">

                <pb facs="0433" n="359" xml:id="pg359"/>

                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <head>Mr. de Geofroy to Mr.
                        Hunter</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of France to the United
                                States,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-04-26"><hi rendition="#italic"
                                >April</hi> 26, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to send to you, requesting
                    you will please to cause them to reach their destination, two letters of
                    condolence addressed by the French community in Philadelphia to Mrs. Lincoln and
                    to Mr. William H. Seward.</p>
                <p>Accept, sir, the assurances of my high consideration.</p>
                <closer>
                    <signed>L. DE GEOFROY.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William Hunter</hi>, <hi rendition="#italic"
                            >&amp;c., &amp;c., &amp;c.</hi></p>
                    <p>[For enclosures see Appendix, separate volume.]</p>
                </postscript>
            </div>
        </body>
    </text>
