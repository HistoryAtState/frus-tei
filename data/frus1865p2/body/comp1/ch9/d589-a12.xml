                <pb facs="0554" n="480" sameAs="frus:frus1865p2/pg480"/>

                <head>No. 12.</head>
                <opener><dateline rendition="#center">[Telegram.—<date calendar="gregorian"
                            when="1865-02-05">February 5, 1865</date>—5 a. m.]</dateline></opener>
                <p><hi rendition="#italic">To his Excellency the Minister of the United States at
                        London:</hi></p>
                <p>The iron-clad confederate steamer Stonewall, Commander V. G. Page, 3 guns, 300
                    horsepower, crew 79 men, from Copenhagen for America, is stopped at Ferrol to
                    repair damages.</p>
                <closer>
                    <signed>HORATIO J. PERRY.</signed></closer>
            </div>
        </body>
