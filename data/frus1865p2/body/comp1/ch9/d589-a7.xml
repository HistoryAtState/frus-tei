    <text>
        <body>
            <div xml:id="d589-a7">

                <pb facs="0553" n="479" sameAs="frus:frus1865p2/pg479"/>

                <head>No. 7.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>FERROL</placeName>, <date calendar="gregorian" when="1865-02-07"
                                ><hi rendition="#italic">February</hi> 7,
                    1865.</date></dateline></opener>
                <p>The royal order is complied with. Not possible for Stonewall to go to sea in the
                    condition in which she is, according to advices.</p>
                <closer>
                    <signed>CONSUL FERNANDEZ.</signed></closer>
            </div>
