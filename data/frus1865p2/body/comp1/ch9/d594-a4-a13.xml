    <text>
        <body>
            <div xml:id="d594-a4-a13">

                <pb facs="0579" n="505" xml:id="pg505"/>

                <head>No. 9.</head>
                <opener><dateline rendition="#center">[Telegram.—<date calendar="gregorian"
                            when="1865-02">February, 1865</date>.]</dateline></opener>
                <p><hi rendition="#italic">To the Chargé d’ Affaires of the United States:</hi></p>
                <p>Stonewall repairs finished. Niagara getting ready. I am ignorant of the day of
                    departure of the first.</p>
                <closer>
                    <signed>FERNANDEZ.</signed></closer>
            </div>
        </body>
