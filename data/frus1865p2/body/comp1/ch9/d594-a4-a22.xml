    <text>
        <body>
            <div xml:id="d594-a4-a22">

                <pb facs="0581" n="507" sameAs="frus:frus1865p2/pg507"/>

                <opener>[Enclosure G, with No. 168.]</opener>
                <head>Mr. Banuelos to Mr. Perry.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Ministerio de
                            Estado,</hi></placeName>
                        <date calendar="gregorian" when="1865-02-16"><hi rendition="#italic"
                                >February</hi> 16, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Dear Sir:</hi> I have been waiting for you two hours.
                    I wish to see you a moment, and will be en ministère this evening, not being
                    able to go to Rue d’Alcala to present mes homages a Mme. Perry.</p>
                <p>No transshipment allowed à ce soir.</p>
                <p>Yours, sincerely,</p>
                <closer>
                    <signed>M. BANUELOS.</signed></closer>
            </div>
        </body>
    </text>
