                <pb facs="0585" n="511" sameAs="frus:frus1865p2/pg511"/>

                <head>B No. 2.</head>
                <opener><dateline rendition="#center">[Telegram.— <placeName>Corunna</placeName>,
                            <date calendar="gregorian" when="1865-03-04">March 4</date>.—6h. 28m.
                        p.m.]</dateline></opener>
                <p><hi rendition="#italic">Hon. H. J. Perry, American Chargé d’Affaires:</hi></p>
                <p>Thanks for your glorious news. Hurrah! Shall salute on Monday.</p>
                <closer>
                    <signed>CRAVEN.</signed></closer>
            </div>
        </body>
