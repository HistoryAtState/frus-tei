        <body>
            <div xml:id="d594-a1-a16">

                <pb facs="0574" n="500" sameAs="frus:frus1865p2/pg500"/>

                <head>No. 17.</head>
                <opener><dateline rendition="#center">[Telegram.–<date calendar="gregorian"
                            when="1865-02-14">February 14</date>, at night.]</dateline></opener>
                <p><hi rendition="#italic">Capitan Craven, abordo del Niagara, Corunna:</hi></p>
                <p>Peremptory orders have been sent to prevent the Stonewall from taking any men,
                    ammunition, or supplies from the Louisa Ann Fanny, or from any other quarter,
                    while in Spanish jurisdiction.</p>
                <closer>
                    <signed>PERRY.</signed></closer>
            </div>
        </body>
