        <body>
            <div xml:id="d594-a1-a6">

                <pb facs="0573" n="499" xml:id="pg499"/>

                <head>No. 7.</head>
                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <opener><dateline rendition="#center">[Telegram at 4 p. m., <date
                            calendar="gregorian" when="1865-02-11">February 11,
                        1865</date>.]</dateline></opener>
                <p><hi rendition="#italic">Sr. Fernandez, Consular Agent of the United States at
                        Ferrol:</hi></p>
                <p>Send a reliable person aboard the frigate to inform him immediately.</p>
                <closer>
                    <signed>PERRY, <hi rendition="#italic">Chargé d’Affaires.</hi></signed></closer>
            </div>
        </body>
    </text>
