        <body>
            <div xml:id="d592-a7">

                <pb facs="0567" n="493" sameAs="frus:frus1865p2/pg493"/>

                <head>No. 7.</head>
                <opener><dateline rendition="#center">[Telegram.—<placeName>Madrid</placeName>,
                            <date calendar="gregorian" when="1865-02-14">February
                        14</date>—night.]</dateline></opener>
                <p><hi rendition="#italic">Captain Craven, on board Niagara, Corunna:</hi></p>
                <p>Peremptory orders have been sent to prevent the Stonewall from taking any men,
                    ammunition, or supplies from the Louisa Anna Fanny, or from any other quarter,
                    while in Spanish jurisdiction.</p>
                <closer>
                    <signed>PERRY.</signed></closer>
            </div>
        </body>
