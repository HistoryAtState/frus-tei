                <pb facs="0566" n="492" sameAs="frus:frus1865p2/pg492"/>

                <opener><seg rendition="#center">No. 1.</seg></opener>
                <opener><dateline rendition="#center">[Enclosure A, despatch No. 167, <date
                            calendar="gregorian" when="1865-02-18">February
                    18</date>.]</dateline></opener>
                <head>[Telegram.—Translation.]</head>
                <p>Ferrol, 14th February, 11h. 35m. a. m.—Received Madrid, 14th February, 12b. 34m.
                    p. m.</p>
                <p><hi rendition="#italic">To the Chargé d’Affaires of the United States:</hi></p>
                <p>Stonewall will be ready to-day. English steamer came in called Louisa Anna Fanny.
                    Very suspicious; we watch her.</p>
                <closer>
                    <signed>FERNANDEZ.</signed></closer>
                <postscript>
                    <p>Sent out at 12h. 40m. p. m., of February 14,</p>
                </postscript>
            </div>
        </body>
