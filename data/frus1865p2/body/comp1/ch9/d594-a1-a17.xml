                <pb facs="0574" n="500" sameAs="frus:frus1865p2/pg500"/>

                <head>[No. 18.]</head>
                <opener><dateline rendition="#center">[Telegram.–<date calendar="gregorian"
                            when="1865-02-16">February 16, 1865</date>.]</dateline></opener>
                <p><hi rendition="#italic">Captain Craven abordo la fragata Niagara,
                    Ferrol:</hi></p>
                <p>I have been notified that the 24-hours rule will be enforced in the sailing of
                    Niagara and Stonewall. The Louisa Ann Fanny has gone to Bermuda, by official
                    accounts.</p>
                <closer>
                    <signed>PERRY.</signed></closer>
            </div>
        </body>
