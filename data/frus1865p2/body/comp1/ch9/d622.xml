    <text>
        <body>
            <div xml:id="d622">

                <pb facs="0612" n="538" sameAs="frus:frus1865p2/pg538"/>

                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <head>Mr. Hunter to Mr. Perry</head>
                <opener><seg rendition="#float-left">No. 98.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1865-05-16"><hi rendition="#italic"
                                >May</hi> 16, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your several despatches, from No 188, the
                    21st ultimo, to No. 191, of the 24th ultimo, together with your private note,
                    dated April 8, have been received. The thrilling account given in your No. 190
                    of the effect produced in the Spanish capital by the news of the fall of
                    Richmond is highly interesting.</p>
                <p rendition="#center">* * * * * * * * *</p>
                <p>I am, sir, your obedient servant, </p>
                <closer>
                    <signed>W. HUNTER, <hi rendition="#italic">Acting
                    Secretary.</hi></signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Horatio</hi> J. <hi rendition="#small-caps"
                            >Perry,</hi> Esq., <hi rendition="#italic">&amp;c., &amp;c.,
                            Madrid.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
