            <div xml:id="d587-a4">

                <pb facs="0548" n="474" sameAs="frus:frus1865p2/pg474"/>

                <head>[Telegram.]</head>
                <p><hi rendition="#italic">His Excellency the Minister of the United States at
                        London:</hi></p>
                <p>A confederate pirate, supposed the Shenandoah, has entered Corunna and asks for
                    repairs. Advice to whom it may concern.</p>
                <closer>
                    <signed>PERRY, <hi rendition="#italic">American Legation.</hi></signed></closer>
            </div>
        </body>
    </text>
