                <pb facs="0592" n="518" sameAs="frus:frus1865p2/pg518"/>

                <head>Commodore Craven to Mr. Perry</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Corunna,</hi></placeName>
                        <date calendar="gregorian" when="1865-03-11"><hi rendition="#italic"
                                >March</hi> 11, 1865.</date></dateline></opener>
                <p>Hon. H. J. <hi rendition="#small-caps">Perry</hi>, <hi rendition="#italic"
                        >American Chargé d’Affaires:</hi> Thanks for your despatch received
                    yesterday.</p>
                <closer>
                    <signed>CRAVEN.</signed></closer>
            </div>
        </body>
