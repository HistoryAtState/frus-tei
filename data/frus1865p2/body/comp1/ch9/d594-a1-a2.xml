            <div xml:id="d594-a1-a2">

                <pb facs="0572" n="498" sameAs="frus:frus1865p2/pg498"/>

                <head>No. 2.</head>
                <opener><dateline rendition="#center">[Telegram at 9 1/2 a. m., <date
                            calendar="gregorian" when="1865-02-10">February 10,
                        1865</date>.]</dateline></opener>
                <p>M. <hi rendition="#italic">le Chargé d’Affaires des Etats Unis à Paris:</hi></p>
                <p>Le corsaire Stonewall s’en ira probablement demain,</p>
                <closer>
                    <signed>PERRY.</signed></closer>
            </div>
        </body>
