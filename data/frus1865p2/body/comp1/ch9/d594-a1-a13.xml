    <text>
        <body>
            <div xml:id="d594-a1-a13">

                <pb facs="0574" n="500" xml:id="pg500"/>

                <head>No. 14.</head>
                <opener><dateline rendition="#center">[Telegram.–<date calendar="gregorian"
                            when="1865-02-14">February 14, 1865</date>.]</dateline></opener>
                <p><hi rendition="#italic">Mr. Harvey, American minister, Lisbon:</hi></p>
                <p>The new-comer is a blockade-runner with men, ammunition, and supplies for the
                    Stonewall.</p>
                <closer>
                    <signed>PERRY.</signed></closer>
            </div>
        </body>
