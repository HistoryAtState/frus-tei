        <body>
            <div xml:id="d589-a9">

                <pb facs="0554" n="480" xml:id="pg480"/>

                <head>No. 9.</head>
                <opener><dateline rendition="#center">[Telegram.—<placeName>Lisbon</placeName>,
                            <date calendar="gregorian" when="1865-02-09">February 9,
                        1865</date>.]</dateline></opener>
                <p><hi rendition="#italic">Horatio Perry, American Legation, Madrid:</hi></p>
                <p>Please keep me fully informed about movements of corsair at Ferrol.</p>
                <closer>
                    <signed>JAMES E. HARVEY.</signed></closer>
            </div>
