    <text>
        <body>
            <div xml:id="d500">

                <pb facs="0458" n="384" sameAs="frus:frus1865p2/pg384"/>

                <opener><seg rendition="#center">[Extracts.]</seg></opener>
                <head>Mr. Seward to Mr. Clay</head>
                <opener><seg rendition="#float-left">No. 172.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-10-02"><hi rendition="#italic"
                                >October</hi> 2, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have received your despatch of the 5th
                    ultimo, No. 86, relative to the misunderstanding existing between the Russian
                    government and the agent of the American Union Telegraph Company, in regard to
                    the construction to be placed upon the charter obtained from the Russian
                    authorities. * * * * The details of the matter are left to your discretion, but
                    it is expected that you will give it your careful attention.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Cassius M. Clay,</hi> Esq., <hi
                            rendition="#italic">&amp;c.,&amp;c.,&amp;c.,</hi></p>
                </postscript>
            </div>
        </body>
    </text>
