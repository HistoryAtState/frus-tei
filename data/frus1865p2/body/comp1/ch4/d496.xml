    <text>
        <body>
            <div xml:id="d496">

                <pb facs="0457" n="383" xml:id="pg383"/>

                <head>Mr. Seward to Mr.
                        Clay</head>
                <opener>
                    <seg rendition="#float-left">No. 164.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-07-14"><hi rendition="#italic"
                                >July</hi> 14, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I transmit to you a letter of condolence
                    from the President of the United States to the Emperor of Russia, in answer to
                    one just received from his Majesty, announcing to the President the melancholy
                    intelligence of the death of his Majesty’s son—his Imperial Highness the
                    Cesarowitch—at Nice. An office copy of the President’s letter is also enclosed.
                    You will communicate these to the minister for foreign affairs, requesting him
                    to place the original in the hands of the Emperor,</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Cassius M. Clay,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c., Russia.</hi></p>
                </postscript>


                <xi:include href="d496-a1.xml" xpointer="d496-a1"/>
            </div>
