    <text>
        <body>
            <div xml:id="d494">

                <pb facs="0456" n="382" sameAs="frus:frus1865p2/pg382"/>

                <head>Mr. Hunter to Mr. Clay</head>
                <opener>
                    <seg rendition="#float-left">No. 159.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of
                            State,Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-06-05"><hi rendition="#italic"
                                >June</hi> 5, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have received your despatch of the 12th
                    ultimo, No. 80, relative to the death of Abraham Lincoln, and the circumstances
                    under which President Johnson occupies the presidential chair.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>W. HUNTER, <hi rendition="#italic">Acting
                    Secretary.</hi></signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Cassius M. Clay,</hi> Esq., <hi
                            rendition="#italic">&amp;c.,&amp;c.,&amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
