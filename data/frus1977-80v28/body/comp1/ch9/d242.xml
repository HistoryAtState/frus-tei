    <text>
        <body>
            <div xml:id="d242">

                <pb facs="0989" n="960" sameAs="frus:frus1977-80v28/pg960"/>

                <head>242. Letter From the Under Secretary of State for Management (Read) to the Director of the Office of
                    Government Employment, Equal Employment Opportunity Commission (Mathew)<anchor
                        n="1" xml:id="d242-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            when="1980-03-22">March 22, 1980</date>
                    </dateline>
                </opener>
                <opener>
                    <salute>Dear Mr. Mathew:</salute>
                </opener>
                <p>Enclosed is the Department of State’s Supplemental Affirmative Action Plan for
                    the hiring, placement and advancement of handicapped individuals and disabled
                    veterans for Fiscal Year 1980.</p>
                <p>As requested, the Department of State will put special emphasis on the
                    recruitment and placement of persons with specified severe disabilities under
                    this Plan.</p>
                <p>Sincerely,</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Ben H.
                            Read</hi><anchor n="2" xml:id="d242-f2"/>
                    </signed>
                </closer>



                <xi:include href="d242-a1.xml" xpointer="d242-a1"/>
            </div>
        </body>
    </text>
    <standOff>
