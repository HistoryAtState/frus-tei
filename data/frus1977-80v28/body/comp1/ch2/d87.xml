                <pb facs="0424" n="395" xml:id="pg395"/>

                <head>87. Summary of Conclusions of a Special Coordination Committee Meeting<anchor
                        n="1" xml:id="d87-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            from="1978-06-27T16:00:00-04:00" to="1978-06-27T18:30:00-04:00">June 27,
                            1978, 4:00–6:30 p.m.</date>
                    </dateline>
                </opener>
                <list subtype="subject" type="description">
