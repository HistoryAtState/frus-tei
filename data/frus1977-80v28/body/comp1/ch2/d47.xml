                <pb facs="0302" n="273" xml:id="pg273"/>

                <head>47. Summary of Conclusions of a Special Coordination Committee Meeting<anchor
                        n="1" xml:id="d47-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            from="1977-06-15T16:30:00-04:00" to="1977-06-15T18:30:00-04:00">June 15,
                            1977, 4:30–6:30 p.m.</date>
                    </dateline>
                </opener>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>PRM/NSC–11—Intelligence Structure and Mission</item>
                </list>
