    <text>
        <body>
            <div xml:id="d14">

                <pb facs="0071" n="31" sameAs="frus:frus1961-63v25/pg31"/>

                <head>14. Memorandum From Charles E. Johnson of the
                    National Security Council Staff to the Professional Staff of
                        the National Security Council<anchor n="1" xml:id="d14-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1961-06-19">June 19,
                    1961</date>.</dateline></opener>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>Operations Center of the Department of State</item>
                </list>
                <p>Attached is a description of the Operations Center recently established in the
                    State Department under the direction of Mr. Achilles and
                    Mr. Stutesman, his deputy. This is distributed as a matter
                    of general information to the Staff, in view of the close working relationship
                    that will be maintained between the National Security Council Staff and that of
                    the Operations Center.</p>
                <closer><signed><hi rendition="#bold">Charles E.
                            Johnson</hi><anchor n="2" xml:id="d14-f2"/></signed></closer>



                <xi:include href="d14-a1.xml" xpointer="d14-a1"/>
            </div>
        </body>
    </text>
