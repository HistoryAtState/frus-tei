    <text>
        <body>
            <div xml:id="Volumes">

                <pb facs="0009" n="IX" xml:id="pgIX"/>

                <head>Kennedy Administration Volumes</head>
                <p>Following is a list of the volumes in the <hi rendition="#italic">Foreign
                        Relations</hi> series for the administration of President John F. Kennedy.
                    The year of publication is in parentheses after the title.</p>
                <p rendition="#flush"><hi rendition="#italic">Print Volumes</hi></p>
                <list>
                    <item><ref target="#pgI">Vietnam, 1961 (1988)</ref></item>
                    <item><ref target="#pgII">Vietnam, 1962 (1990)</ref></item>
                    <item><ref target="#pgIII">Vietnam, January-August 1963 (1991)</ref></item>
                    <item><ref target="#pgIV">Vietnam, August-December 1963 (1991)</ref></item>
                    <item><ref target="#pgV">Soviet Union (1998)</ref></item>
                    <item><ref target="#pgVI">Kennedy-Khrushchev Exchanges (1996)</ref></item>
                    <item><ref target="#pgVII">Arms Control and Disarmament (1995)</ref></item>
                    <item><ref target="#pgVIII">National Security Policy (1996)</ref></item>
                    <item><ref target="#pgIX">Foreign Economic Policy (1995)</ref></item>
                    <item><ref target="#pgX">Cuba, January 1961–September 1962 (1997)</ref></item>
                    <item><ref target="#pgXI">Cuba, October 1962–December 1963 (1997)</ref></item>
                    <item><ref target="#pgXII">American Republics (1996)</ref></item>
                    <item><ref target="#pgXIII">Western Europe and Canada (1994)</ref></item>
                    <item><ref target="#pgXIV">Berlin Crisis, 1961–1962 (1994)</ref></item>
                    <item><ref target="#pgXV">Berlin Crisis, 1962–1963 (1994)</ref></item>
                    <item><ref target="#pgXVI">Eastern Europe; Cyprus; Greece; Turkey
                        (1994)</ref></item>
                    <item><ref target="#pgXVII">Near East, 1961–1962 (1995)</ref></item>
                    <item><ref target="#pgXVIII">Near East, 1962–1963 (1995)</ref></item>
                    <item><ref target="#pgXIX">South Asia (1996)</ref></item>
                    <item><ref target="#pgXX">Congo Crisis (1995)</ref></item>
                    <item><ref target="#pgXXI">Africa (1996)</ref></item>
                    <item><ref target="#pgXXII">Northeast Asia (1996)</ref></item>
                    <item><ref target="#pgXXIII">Southeast Asia (1995)</ref></item>
                    <item><ref target="#pgXXIV">Laos Crisis (1994)</ref></item>
                    <item><ref target="#pgXXV">Organization of Foreign Policy; Information Policy;
                            United Nations; Scientific Matters (2001)</ref></item>
                </list>
                <p rendition="#flush"><hi rendition="#italic">Microfiche Supplements</hi></p>
                <list>
                    <item>Arms Control; National Security; Foreign Economic Policy (Volumes VII,
                        VIII, IX) (1997)</item>
                    <item>Cuba; American Republics (Volumes X, XI, XII) (1998)</item>
                    <item>Western Europe; Berlin ( Volumes XIII, XIV, XV) (1995)</item>
                    <item>Near East; Congo; Africa (Volumes XVII, XVIII, XX, XXI) (1997)</item>
                    <item>Northeast Asia; Laos (XXII, XXIV) (1996)</item>
                </list>
