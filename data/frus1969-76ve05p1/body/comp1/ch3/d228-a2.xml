                <pb facs="d228-04" n="4" xml:id="d228-04"/>


                <head>Memorandum From the Executive Secretary of the Department of State (Eliot) to
                    the Presidentʼs Assistant for National Security Affairs (Kissinger)</head>
                <dateline><placeName>Washington</placeName>, <date when="1972-10-07">October 7,
                        1972</date></dateline>
                <list subtype="subject" type="description">
                    <label>Subject:</label>
                    <item>Burundi</item>
                </list>
                <p>The attached memorandum to Assistant Secretary Newsom reflects the current views of Ambassador Robert Yost on our policy toward Burundi.
                    Ambassador Yost is currently in Washington on consultation.</p>
                <p>The memorandum is forwarded to supplement the Departmentʼs memorandum of
                    September 24 and to assist further in the Presidentʼs consideration of our
                    future posture toward this country.</p>
                <closer>
                    <signed>Theodore L. Eliot,
                    Jr.</signed>Executive Secretary</closer>



                <xi:include href="d228-a2-a1.xml" xpointer="d228-a2-a1"/>
