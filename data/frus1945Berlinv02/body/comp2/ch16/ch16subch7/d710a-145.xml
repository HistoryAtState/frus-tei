    <text>
        <body>
            <div xml:id="d710a-145">

                <pb facs="0702" n="508" sameAs="frus:frus1945Berlinv02/pg508"/>

                <note rend="inline" type="source">740.00119 Control (Germany)/7–2945</note>
                <head><hi rendition="#italic">Memorandum by the Political Adviser to the
                        Representative on the European Advisory Commission</hi> (<hi
                        rendition="#italic">Mosely</hi>)<anchor n="2" xml:id="d710a-145-f1"/></head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Babelsberg</hi></placeName>, <date calendar="gregorian"
                            when="1945-07-30">July 30, 1945</date>.]</dateline>
                </opener>
                <p>Informed J. G. Ward (UK) and Gousev (U. S. S. R.) July 30, of U. S.
                        approval<anchor n="3" xml:id="d710a-145-f2"/> and timing arrangement.
                    Telegram to Mr. Winant, July 30.<anchor n="4" xml:id="d710a-145-f3"/></p>
                <closer><signed>P[<hi rendition="#small-caps">hilip</hi>] E. M[<hi
                            rendition="#small-caps">osely</hi>]</signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d710a-145-f1" n="2" type="source" xml:id="d710a-145-f1-content">
                <p>This memorandum is in the form of a manuscript endorsement to <ref target="#d788"
                        >document No. 788</ref>, <hi rendition="#italic">post</hi>.</p>
            </note>
            <note corresp="#d710a-145-f2" n="3" xml:id="d710a-145-f2-content">
                <p>Of three quadripartite statements relating to Austria. See <ref target="#d788"
                        >document No. 788</ref>, <hi rendition="#italic">post</hi>.</p>
            </note>
            <note corresp="#d710a-145-f3" n="4" xml:id="d710a-145-f3-content">
                <p><ref target="#d789">Document No. 789</ref>, <hi rendition="#italic"
                    >post</hi>.</p>
            </note>
        </listAnnotation>
    </standOff>
