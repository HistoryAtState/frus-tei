                                <del rendition="#strikethrough">of</del>
                                <del rendition="#strikethrough">the</del>
                                <del rendition="#strikethrough">enemy;</del></item>
                            <item><del rendition="#strikethrough">(ii)</del> (<hi
                                    rendition="#italic">1</hi>) <del rendition="#strikethrough"
                                    >persons,</del>
                                <del rendition="#strikethrough">whether</del>
                                <del rendition="#strikethrough">prisoners</del>
                                <del rendition="#strikethrough">of</del>
                                <del rendition="#strikethrough">war</del>
                                <del rendition="#strikethrough">or</del>
                                <del rendition="#strikethrough">not,</del>
                                <del rendition="#strikethrough">who,</del>
                                <del rendition="#strikethrough">during</del>
                                <del rendition="#strikethrough">the</del>
                                <del rendition="#strikethrough">war,</del>
                                <del rendition="#strikethrough">have</del> voluntarily engaged in
                                activities calculated to assist the <del rendition="#strikethrough"
                                    >enemy’s</del>
                                <del rendition="#strikethrough">operations;</del>
                                <hi rendition="#italic">enemy in any way whatsoever; or</hi></item>
                            <item><del rendition="#strikethrough">(iii)</del> (<hi
                                    rendition="#italic">2</hi>) <del rendition="#strikethrough"
                                    >persons</del>
                                <del rendition="#strikethrough">who</del>
                                <del rendition="#strikethrough">have</del>
                                <del rendition="#strikethrough">applied</del>
                                <del rendition="#strikethrough">for</del>
                                <del rendition="#strikethrough">and</del>
                                <hi rendition="#italic">assumed or</hi> obtained, enemy nationality
                                    <del rendition="#strikethrough">during</del>
                                <del rendition="#strikethrough">the</del>
                                <del rendition="#strikethrough">other</del>
                                <del rendition="#strikethrough">than</del>
                                <hi rendition="#italic">and are not</hi> members of communities <del
                                    rendition="#strikethrough">who</del>
                                <del rendition="#strikethrough">have</del>
                                <del rendition="#strikethrough">been</del> obliged to accept German
                                nationality.</item>
                        </list></item>
                    <item>5. <del rendition="#strikethrough">Those</del>
                        <del rendition="#strikethrough">whom</del>
                        <del rendition="#strikethrough">you</del>
                        <del rendition="#strikethrough">do</del>
                        <del rendition="#strikethrough">not</del>
