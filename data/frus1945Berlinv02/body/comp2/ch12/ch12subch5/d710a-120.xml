    <text>
        <body>
            <div xml:id="d710a-120">

                <pb facs="0615" n="421" sameAs="frus:frus1945Berlinv02/pg421"/>

                <note rend="inline" type="source">740.00116 EW/7–2745</note>
                <head><hi rendition="#italic">The Assistant Secretary of War</hi> (<hi
                            rendition="#italic">McCloy</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">confidential</hi></seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi> [<hi rendition="#italic"
                            >Babelsberg</hi>]</placeName>, <date calendar="gregorian"
                            when="1945-07-27">27 July 1945</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Dear Mr. Secretary</hi>[:] I send you herewith a copy
                    of our minutes of the conference held in your office yesterday evening on war crimes.</p>
                <p>Sincerely yours,</p>
                <closer><signed><hi rendition="#small-caps">John</hi> J
                                <hi rendition="#small-caps">McCloy</hi></signed></closer>


                <xi:include href="d710a-120-a1.xml" xpointer="d710a-120-a1"/>
