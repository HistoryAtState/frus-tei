            </note>
            <note corresp="#d710a-39-f3" n="4" xml:id="d710a-39-f3-content">
                <p>Admiral Lord Louis Mountbatten.</p>
            </note>
            <note corresp="#d710a-39-f4" n="5" xml:id="d710a-39-f4-content">
