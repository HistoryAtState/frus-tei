    <text>
        <body>
            <div xml:id="d710a-46">

                <pb facs="0363" n="183" xml:id="pg183"/>

                <note rend="inline" type="source">Truman Papers</note>
                <head><hi rendition="#italic">Memorandum by the President</hi><anchor n="2"
                        xml:id="d710a-46-f1"/></head>
                <opener>
                    <dateline rendition="#float-right">[<date
                            ana="#date_undated-inferred-from-document-content-and-sibling-dates"
                            calendar="gregorian" when="1945-07-20">Undated</date>.]</dateline>
                </opener>
                <p>Question<anchor n="3" xml:id="d710a-46-f2"/> asked of Stalin after meeting on
                    20th. Had already asked him when he called.<anchor n="4" xml:id="d710a-46-f3"/>
                    Agreed to it in a few days.</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d710a-46-f1" n="2" type="source" xml:id="d710a-46-f1-content">
                <p>This brief memorandum is a manuscript notation by Truman on the Leahy memorandum
                    quoted in footnote 1 to <ref target="#d1275">document No. 1275</ref>, <hi
                        rendition="#italic">post</hi>.</p>
            </note>
            <note corresp="#d710a-46-f2" n="3" xml:id="d710a-46-f2-content">
                <p>i. e., when the Soviet Chiefs of Staff would meet with the United States Chiefs
                    of Staff.</p>
            </note>
            <note corresp="#d710a-46-f3" n="4" xml:id="d710a-46-f3-content">
                <p>See <hi rendition="#italic">ante</hi>, <ref target="#pg44">p. 44</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
