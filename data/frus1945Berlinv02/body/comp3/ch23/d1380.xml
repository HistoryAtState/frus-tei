    <text>
        <body>
            <div xml:id="d1380">

                <pb facs="1640" n="1442" sameAs="frus:frus1945Berlinv02/pg1442"/>

                <note rend="inline" type="source">740.00119 Potsdam/8–145</note>
                <head>No. 1380<lb/><hi rendition="#italic">The Special Assistant to the Secretary of
                        State</hi> (<hi rendition="#italic"
                            >Brown</hi>) <hi rendition="#italic">to the President and the Secretary of State</hi></head>
                <dateline>
                    <date ana="#date_undated-inferred-from-document-content" calendar="gregorian"
                        when="1945-08-02">undated</date>
                </dateline>
                <p>[<hi rendition="#small-caps">Editor’s Note</hi>.—Stapled on top of <ref
                        target="#d1380">document No. 1380</ref> is a sheet of paper bearing the
                    signatures of the three Heads of Government, as follows:</p>
                <p rendition="#center"><hi rendition="#small-caps">Communique</hi><anchor n="1"
                        xml:id="d1380-f1"/></p>
                <table cols="2" rows="3">
                    <row role="label">
                        <cell>Approved:</cell>
                        <cell>И. <hi rendition="#small-caps">Ctajiиh</hi><anchor n="2"
                                xml:id="d1380-f2"/></cell>
                    </row>
                    <row>
                        <cell/>
                        <cell><hi rendition="#small-caps"
                                >Harry</hi> S <hi
                                    rendition="#small-caps">Truman</hi></cell>
                    </row>
                    <row>
                        <cell/>
                        <cell>C. R. <hi rendition="#small-caps"
                                    >Attlee</hi></cell>
                    </row>
                </table>
                <p rendition="#flush">This cover sheet was signed early on August 2, following
                    discussion of the Communiqué at the Thirteenth Plenary Meeting. See <hi
                        rendition="#italic">ante</hi>, <ref target="#pg596">page 596</ref>. For the
                    text of the Communiqué as actually released at the conclusion of the Conference
                    by the Secretary to the President, see <ref target="#d1384">document No.
                        1384</ref>.]</p>




                <xi:include href="d1380-a1.xml" xpointer="d1380-a1"/>
                <xi:include href="d1380-a2.xml" xpointer="d1380-a2"/>
            </div>
        </body>
    </text>
