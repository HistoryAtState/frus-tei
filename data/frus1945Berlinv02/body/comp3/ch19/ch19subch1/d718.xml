    <text>
        <body>
            <div xml:id="d718">

                <pb facs="0811" n="617" sameAs="frus:frus1945Berlinv02/pg617"/>

                <note rend="inline" type="source">Department of the Army Files: Telegram</note>
                <head>No. 718<lb/><hi rendition="#italic">The Ambassador in China</hi> (<hi rendition="#italic"
                        >Hurley</hi>) <hi rendition="#italic">to the Secretary of State</hi><anchor n="1" xml:id="d718-f1"/></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">top secret</hi>
                        <lb/>
                        <hi rendition="#small-caps">urgent</hi></seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Chungking</hi></placeName>, <date calendar="gregorian"
                            when="1945-07-31">31 July 1945</date>.</dateline>
                </opener>
                <p>TopSec and Urgent Personal for Byrnes, Secretary of State, Potsdam, Germany
                        <hi rendition="#small-caps">Cfb</hi> 2223
                    from Hurley signed ComGenChina.</p>
                <p>Received your unnumbered message July 30,<anchor n="2" xml:id="d718-f2"/> 1040
                        hours,<anchor n="3" xml:id="d718-f3"/> Chungking time, July 31.</p>
                <p>Proceeding immediately on instructions contained in your <hi rendition="#small-caps">Victory</hi> number
                        375.<anchor n="4" xml:id="d718-f4"/></p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d718-f1" n="1" type="source" xml:id="d718-f1-content">
                <p>Sent by the Commanding General, United States Forces, China, via Army
                    channels.</p>
            </note>
            <note corresp="#d718-f2" n="2" xml:id="d718-f2-content">
