    <text>
        <body>
            <div xml:id="d716">

                <pb facs="0811" n="617" xml:id="pg617"/>

                <note rend="inline" type="source">Department of the Army Files: Telegram</note>
                <head>No. 716<lb/><hi rendition="#italic">The Ambassador in China</hi> (<hi rendition="#italic"
                        >Hurley</hi>) <hi rendition="#italic">to the Secretary of State</hi><anchor n="1" xml:id="d716-f1"/></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">top secret</hi>
                        <lb/>
                        <hi rendition="#small-caps">urgent</hi></seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Chungking</hi></placeName>, <date calendar="gregorian"
                            when="1945-07-28">28 July 1945</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Cfb</hi> 2015. For
                    the Eyes alone of Byrnes, Secretary of
                    State, Potsdam, Germany from Hurley,
                    signed ComGenChina.</p>
                <p>Received your <hi rendition="#small-caps"
                            >Victory</hi> 375, July 27.<anchor n="2" xml:id="d716-f2"/> Will
                    be prepared to obtain acceptance by Chiang
                        Kai-Shek quickly and in the method suggested on receipt of
                    authorization.</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d716-f1" n="1" type="source" xml:id="d716-f1-content">
                <p>Sent by the Commanding General, United States Forces, China, via Army
                    channels.</p>
            </note>
            <note corresp="#d716-f2" n="2" xml:id="d716-f2-content">
