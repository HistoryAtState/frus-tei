    <text>
        <body>
            <div xml:id="d717">

                <pb facs="0811" n="617" sameAs="frus:frus1945Berlinv02/pg617"/>

                <note rend="inline" type="source">Department of the Army Files: Telegram</note>
                <head>No. 717<lb/><hi rendition="#italic">The Secretary of State to the Ambassador
                        in China</hi> (<hi rendition="#italic">Hurley</hi>)</head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">secret</hi>
                        <lb/>
                        <hi rendition="#small-caps">urgent</hi></seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Babelsberg</hi></placeName>,] <date calendar="gregorian"
                            when="1945-07-30">July 30, 1945</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Victory</hi> 439. Please proceed at once in
                    accordance with the instruction in our telegram Number 375 of July 27<anchor
                        n="1" xml:id="d717-f1"/> inasmuch as we wish to have President Chiang’s
                    reply within the next 48 hours.</p>
                <closer><signed><hi rendition="#small-caps">Byrnes</hi></signed></closer>
            </div>
        </body>
    </text>
