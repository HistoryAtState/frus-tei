    <text>
        <body>
            <div xml:id="d726">

                <pb facs="0819" n="625" sameAs="frus:frus1945Berlinv02/pg625"/>

                <note rend="inline" type="source">740.00119 Potsdam/7–2045</note>
                <head>No. 726<lb/><hi rendition="#italic">Memorandum by the First Secretary of
                        Embassy in Portugal</hi> (<hi
                            rendition="#italic">Cannon</hi>)<anchor n="1"
                        xml:id="d726-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Potsdam</hi></placeName>, <date calendar="gregorian"
                            when="1945-07-20">July 20, 1945</date>.</dateline>
                </opener>
                <p rendition="#center"><hi rendition="#small-caps">Memorandum</hi></p>
                <p>In presenting this paper<anchor n="2" xml:id="d726-f2"/> the Secretary may wish
                    orally to restate the interest of the United States Government in the early
                    admission of Italy to the United Nations Organization, and to observe that this
                    matter is being handled separately by a Sub-Committee.</p>
                <closer><signed><hi rendition="#small-caps">Cavendish W.
                                Cannon</hi></signed></closer>
            </div>
        </body>
    </text>
