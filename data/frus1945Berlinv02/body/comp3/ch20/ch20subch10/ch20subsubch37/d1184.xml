    <text>
        <body>
            <div xml:id="d1184">

                <pb facs="1381" n="1183" sameAs="frus:frus1945Berlinv02/pg1183"/>

                <note rend="inline" type="source">740.00119 PW/7–2545</note>
                <head>No. 1184<lb/><hi rendition="#italic">Prime Minister Churchill to President
                            Truman</hi></head>
                <opener>
                    <seg rendition="#center">[Extract<anchor n="1" xml:id="d1184-f1"/>]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">most secret</hi></seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Whitehall</hi> [<hi rendition="#italic"
                            >Babelsberg</hi>]</placeName>, <date calendar="gregorian"
                            when="1945-07-25">July 25, 1945</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">My Dear Mr. President</hi>, I thank you for your
                    letter of July 25,<anchor n="2" xml:id="d1184-f2"/> and I await the Memorandum
                    on Lend-Lease which you are kindly having prepared.</p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>Yours very sincerely,</p>
                <closer><signed><hi rendition="#small-caps">Winston</hi>
                            S. <hi rendition="#small-caps"
                    >Churchill</hi></signed></closer>
            </div>
        </body>
    </text>
