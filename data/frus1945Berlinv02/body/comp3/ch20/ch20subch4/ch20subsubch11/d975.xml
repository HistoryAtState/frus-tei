    <text>
        <body>
            <div xml:id="d975">

                <pb facs="1131" n="935" sameAs="frus:frus1945Berlinv02/pg935"/>

                <note rend="inline" type="source">740.00119 EW/9–2045</note>
                <head>No. 975<lb/><hi rendition="#italic">The Representative on the Allied
                        Commission on Reparations</hi> (<hi rendition="#italic">Pauley</hi>) <hi
                        rendition="#italic">and the Assistant Secretary of State</hi> (<hi
                        rendition="#italic">Clayton</hi>) <hi rendition="#italic">to the Deputy
                        Military Governor, United States Zone in Germany</hi> (<hi
                        rendition="#italic">Clay</hi>)<anchor n="1" xml:id="d975-f1"/></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">secret</hi></seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Babelsberg</hi></placeName>, <date calendar="gregorian"
                            when="1945-08-01">August 1, 1945</date>.</dateline>
                </opener>
                <p rendition="#center"><hi rendition="#small-caps">Memorandum for General
                    Clay</hi></p>
                <p>We request that you urge the Control Council to adopt the attached proposed
                    principle on Allied and neutral property in Germany to supplement the economic
                    principles and the reparation agreement approved by the heads of Government.</p>
                <closer><signed>
                        <hi rendition="#small-caps">Edwin</hi> W. <hi rendition="#small-caps"
                            >Pauley</hi>
                        <lb/> W. L. <hi rendition="#small-caps">Clayton</hi>
                    </signed></closer>


                <xi:include href="d975-a1.xml" xpointer="d975-a1"/>
            </div>
        </body>
    </text>
