    <text>
        <body>
            <div xml:id="d895">

                <pb facs="1029" n="835" sameAs="frus:frus1945Berlinv02/pg835"/>

                <note rend="inline" type="source">J. C. S.
                    Files</note>
                <head>No. 895<lb/><hi rendition="#italic">Memorandum by the United States Chiefs of
                        Staff</hi><anchor n="1" xml:id="d895-f1"/></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">secret</hi>
                        <lb/>
                        C. C. S. 706/14 (<hi rendition="#small-caps"
                        >Terminal</hi>)</seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Babelsberg</hi></placeName>,] <date calendar="gregorian"
                            when="1945-07-17">17 July 1945</date>.</dateline>
                </opener>
                <p rendition="#flush"><hi rendition="#small-caps">Disposal of Enemy War Materiel in Germany and Austria</hi></p>
                <p rendition="#flush">Reference:</p>
                <p>CCS 706/11<anchor n="2" xml:id="d895-f2"/></p>
                <p>The United States Chiefs of Staff recommend that the Combined Chiefs of Staff
                    approve Appendices “A” and “B” to C. C. S.
                    706/11 as amended herein.</p>




                <xi:include href="d895-a1.xml" xpointer="d895-a1"/>
                <xi:include href="d895-a2.xml" xpointer="d895-a2"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d895-f1" n="1" type="source" xml:id="d895-f1-content">
                <p>Considered by the Combined Chiefs of Staff at their 197th Meeting, July 20. See
                        <hi rendition="#italic">ante</hi>, <ref target="#pg162">p. 162</ref>.</p>
