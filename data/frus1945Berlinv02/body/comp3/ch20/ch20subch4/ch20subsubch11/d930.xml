    <text>
        <body>
            <div xml:id="d930">

                <pb facs="1071" n="877" xml:id="pg877"/>

                <note rend="inline" type="source">740.00119 E. W./7–2545</note>
                <head>No. 930<lb/><hi rendition="#italic">The Representative on the Allied
                        Commission on Reparations</hi> (<hi rendition="#italic">Pauley</hi>) <hi
                        rendition="#italic">to the Assistant Secretary of State</hi> (<hi
                        rendition="#italic">Clayton</hi>)<anchor n="1" xml:id="d930-f1"/></head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Babelsberg</hi></placeName>,] <date calendar="gregorian"
                            when="1945-07-25">July 25, 1945</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Dear Mr. Clayton</hi>: Attached are estimates of both
                    ourselves and the Soviet Union on the comparative percentage of wealth in the
                    Soviet occupied zone. In view of our present discussions I am sure they will be
                    of interest to you.</p>
                <p>Very truly yours,</p>
                <closer><signed><hi rendition="#small-caps">Edwin W. Pauley</hi></signed></closer>




                <xi:include href="d930-a1.xml" xpointer="d930-a1"/>
                <xi:include href="d930-a2.xml" xpointer="d930-a2"/>
