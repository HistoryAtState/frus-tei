    <text>
        <body>
            <div xml:id="d1058">

                <pb facs="1234" n="1038" sameAs="frus:frus1945Berlinv02/pg1038"/>

                <note rend="inline" type="source">740.00119 Control (Germany)/7–3145</note>
                <head>No. 1058<lb/><hi rendition="#italic">The British Foreign Secretary</hi>
                        (<hi rendition="#italic"
                        >Bevin</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Berlin</hi></placeName>, <date calendar="gregorian"
                            when="1945-07-31">31st July, 1945</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">My Dear Secretary of State</hi>[:] With reference to
                    discussion at the Foreign Secretaries’ meeting yesterday afternoon,<anchor n="1"
                        xml:id="d1058-f1"/> I send you herewith copy of a letter which I have
                    written to Monsieur Molotov, together
                    with a copy of the Soviet <hi rendition="#italic">aide-mémoire</hi><anchor n="2"
                        xml:id="d1058-f2"/> to which reference is made in it, on the subject of the
                    disarming of the German troops in Norway.</p>
                <p>Yours very sincerely</p>
                <closer><signed><hi rendition="#small-caps">Ernest
                                Bevin</hi></signed></closer>


                <xi:include href="d1058-a1.xml" xpointer="d1058-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1058-f1" n="1" xml:id="d1058-f1-content">
                <p>See <hi rendition="#italic">ante</hi>, <ref target="#pg496">p. 496</ref>.</p>
            </note>
            <note corresp="#d1058-f2" n="2" xml:id="d1058-f2-content">
                <p>This enclosure is not printed. It is a variant translation of the <hi
                        rendition="#italic">aide-mémoire</hi> presented to the United States
                    Delegation (enclosure to <ref target="#d1056">document No. 1056</ref>).</p>
            </note>
        </listAnnotation>
    </standOff>
