    <text>
        <body>
            <div xml:id="d1056">

                <pb facs="1233" n="1037" sameAs="frus:frus1945Berlinv02/pg1037"/>

                <note rend="inline" type="source">740.00119 EW/7–2545</note>
                <head>No. 1056<lb/><hi rendition="#italic">The Secretary of the Soviet
                        Delegation</hi> (<hi rendition="#italic">Novikov</hi>) <hi
                        rendition="#italic">to the Assistant Secretary of State</hi> (<hi
                        rendition="#italic">Dunn</hi>)</head>
                <opener>
                    <seg rendition="#center">[Translation]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Berlin</hi></placeName>, <date calendar="gregorian"
                            when="1945-07-25">July 25, 1945</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Dear Mr. Dunn</hi>: Under instructions of Peoples’
                    Commissar of Foreign Affairs, V. M. Molotov, I enclose herewith an <hi
                        rendition="#italic">aide-mémoire</hi> on the question of the non-application
                    of the unconditional surrender regime toward German troops in Norway.</p>
                <p>I would appreciate it if you would acknowledge receipt of this letter.</p>
                <p>Sincerely yours,</p>
                <closer><signed>K <hi rendition="#small-caps">Novikov</hi></signed></closer>


                <xi:include href="d1056-a1.xml" xpointer="d1056-a1"/>
            </div>
        </body>
