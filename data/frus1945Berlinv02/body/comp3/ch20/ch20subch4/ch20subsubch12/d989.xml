    <text>
        <body>
            <div xml:id="d989">

                <pb facs="1151" n="955" sameAs="frus:frus1945Berlinv02/pg955"/>

                <note rend="inline" type="source">740.00119 Potsdam/7–1845: Telegram</note>
                <head>No. 989<lb/><hi rendition="#italic">The Acting Secretary of State to the
                        Assistant Secretary of State</hi> (<hi rendition="#italic"
                        >Clayton</hi>)<anchor n="1" xml:id="d989-f1"/></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">secret</hi></seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1945-07-24">July 24, 1945</date>.</dateline>
                </opener>
                <p>115. (For Clayton.)</p>
                <p>For your information and with reference Department’s 56 of July 18,<anchor n="2"
                        xml:id="d989-f2"/> Bucharest reports Soviets now demand German bank stocks
                    in Rumania.</p>
                <closer><signed>[<hi rendition="#small-caps">Grew</hi>]</signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d989-f1" n="1" type="source" xml:id="d989-f1-content">
                <p>Sent to the Secretary of State at Babelsberg.</p>
            </note>
