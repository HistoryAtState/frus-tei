    <text>
        <body>
            <div xml:id="d1039">

                <pb facs="1219" n="1023" sameAs="frus:frus1945Berlinv02/pg1023"/>

                <note rend="inline" type="source">740.00119 (Potsdam)/7–1845: Telegram</note>
                <head>No. 1039<lb/><hi rendition="#italic">The Assistant Secretary of State</hi>
                        (<hi rendition="#italic"
                            >Clayton</hi>) <hi rendition="#italic">and the Adviser on
                        German Economic Affairs</hi> (<hi
                            rendition="#italic">Despres</hi>) <hi rendition="#italic">to
                        the Deputy to the Assistant Secretary of State for Economic Affairs</hi>
                        (<hi rendition="#italic"
                        >Thorp</hi>)<anchor n="1" xml:id="d1039-f1"/></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">secret</hi></seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Babelsberg</hi></placeName>, <date calendar="gregorian"
                            when="1945-07-18">July 18, 1945</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Victory</hi> 56.
                    For Thorp from Clayton and Despres.</p>
                <p>Please advise us whether Soviet [Union] has been informed of U. S. proposal for
                    directive on German coal production and exports.<anchor n="2" xml:id="d1039-f2"
                    /></p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1039-f1" n="1" type="source" xml:id="d1039-f1-content">
                <p>Sent to the Acting Secretary of State over the signature of Byrnes.</p>
            </note>
            <note corresp="#d1039-f2" n="2" xml:id="d1039-f2-content">
                <p>See <ref target="frus1945Berlinv01#d420">vol. <hi rendition="#small-caps">i</hi>,
