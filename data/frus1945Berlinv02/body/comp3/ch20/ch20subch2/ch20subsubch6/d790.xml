    <text>
        <body>
            <div xml:id="d790">

                <pb facs="0877" n="683" sameAs="frus:frus1945Berlinv02/pg683"/>

                <note rend="inline" type="source">740.00119 Control (Germany)/7–2545</note>
                <head>No. 790<lb/><hi rendition="#italic">The Secretary of the Soviet
                        Delegation</hi> (<hi
                            rendition="#italic">Novikov</hi>) <hi rendition="#italic">to
                        the Assistant Secretary of State</hi> (<hi rendition="#italic">Dunn</hi>)</head>
                <opener>
                    <seg rendition="#center">[Translation]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Berlin</hi></placeName>, <date calendar="gregorian"
                            when="1945-07-25">July 25, 1945</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Dear Mr. Dunn</hi>: Under instructions of Peoples’ Commissar of Foreign
                    Affairs, V. M. Molotov, I enclose
                    herewith an <hi rendition="#italic">Aide-Mémoire</hi> concerning the activities,
                    which is unfriendly to the Soviet Union, in British, American and French Zones
                    of occupation in Austria and Germany on the part of white-immigrants and other
                    persons and organizations hostile to the U. S. S. R.</p>
                <p>I would appreciate it, Mr. Dunn, if you
                    would confirm the receipt of this letter.</p>
                <p>Sincerely yours,</p>
                <closer><signed>K <hi rendition="#small-caps"
                                >Novikov</hi></signed></closer>



                <xi:include href="d790-a1.xml" xpointer="d790-a1"/>
            </div>
