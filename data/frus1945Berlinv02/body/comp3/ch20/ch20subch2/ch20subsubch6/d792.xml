    <text>
        <body>
            <div xml:id="d792">

                <pb facs="0879" n="685" xml:id="pg685"/>

                <note rend="inline" type="source">740.00119 Control (Germany)/7–2545</note>
                <head>No. 792<lb/><hi rendition="#italic">The Assistant Secretary of State</hi> (<hi
                        rendition="#italic">Dunn</hi>) <hi rendition="#italic">to the Secretary of
                        the Soviet Delegation</hi> (<hi rendition="#italic">Novikov</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Berlin</hi></placeName>, <date calendar="gregorian"
                            when="1945-07-27">July 27, 1945</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Dear Mr. Novikov</hi>: I refer to your note of July
                    25, 1945<anchor n="1" xml:id="d792-f1"/> with which you enclosed an <hi
                        rendition="#italic">aide-mémoire</hi> concerning activities in the British,
                    American and French zones of occupation in Germany and Austria considered by you
                    to be unfriendly to the Soviet Union.</p>
                <p>I have referred this matter to the appropriate military authorities of the
                    American Government in order that information may be obtained upon which an
                    answer, so far as the American zone is concerned, may be prepared.<anchor n="2"
                        xml:id="d792-f2"/></p>
                <p>Sincerely yours,</p>
                <closer><signed><hi rendition="#small-caps">James Clement
                    Dunn</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d792-f1" n="1" xml:id="d792-f1-content">
                <p><ref target="#d790">Document No. 790</ref>.</p>
            </note>
            <note corresp="#d792-f2" n="2" xml:id="d792-f2-content">
                <p>No further reply was made to the Soviet Delegation during the course of the
                    Berlin Conference.</p>
            </note>
        </listAnnotation>
    </standOff>
