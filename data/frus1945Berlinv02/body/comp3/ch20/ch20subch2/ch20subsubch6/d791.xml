    <text>
        <body>
            <div xml:id="d791">

                <pb facs="0878" n="684" sameAs="frus:frus1945Berlinv02/pg684"/>

                <note rend="inline" type="source">740.00119 Control (Germany)/7–2545</note>
                <head>No. 791<lb/><hi rendition="#italic">The Information Officer in the Office of
                        the Secretary of State</hi> (<hi rendition="#italic">Reams</hi>) <hi
                        rendition="#italic">to the Assistant Secretary of State</hi> (<hi
                        rendition="#italic">Dunn</hi>)<anchor n="1" xml:id="d791-f1"/></head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Babelsberg</hi></placeName>,] <date calendar="gregorian"
                            when="1945-07-27">July 27, 1945</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Mr. Dunn</hi>: General Hull prefers that this matter
                    be presented to the War Department in Washington. However, if you feel that
                    there is some special need for haste, he is prepared to take it up with General
                    Eisenhower and the War Department from Potsdam.</p>
                <closer><signed>R. <hi rendition="#small-caps">Borden Reams</hi></signed></closer>
            </div>
        </body>
    </text>
