            <div xml:id="d808">

                <pb facs="0897" n="703" xml:id="pg703"/>

                <note rend="inline" type="source">SWNCC
                    Files</note>
                <head>No. 808<lb/><hi rendition="#italic">The Joint Chiefs of
                            Staff to the State–War–Navy Coordinating Committee</hi></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">secret</hi>
                        <lb/>
                        SM–2621</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi> [<hi rendition="#italic"
                            >Babelsberg</hi>]</placeName>, <date calendar="gregorian"
                            when="1945-07-23">23 July 1945</date>.</dateline>
                </opener>
                <p rendition="#center"><hi rendition="#small-caps">Memorandum for the State–War–Navy Coordinating Committee</hi></p>
                <p rendition="#flush">Subject: Proposed Statutes for Allied Control Commission for
                    Hungary.</p>
                <p>The Joint Chiefs of Staff have considered the report by the State–War–Navy Coordinating Subcommittee for Europe on
                    “Proposed Statutes for Allied Control Commission for Hungary” and perceive no
                    objection from the military point of view.</p>
                <closer>For the Joint Chiefs of Staff:<lb/><signed>A.
                            J. <hi rendition="#small-caps"
                        >McFarland</hi></signed>,<lb/><hi rendition="#italic">Brigadier
                        General, U. S. A. Secretary.</hi></closer>



                <xi:include href="d808-a1.xml" xpointer="d808-a1"/>
