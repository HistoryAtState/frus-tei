    <text>
        <body>
            <div xml:id="d1155">

                <pb facs="1351" n="1153" sameAs="frus:frus1945Berlinv02/pg1153"/>

                <note rend="inline" type="source">860c.24/7–2645: Telegram</note>
                <head>No. 1155<lb/><hi rendition="#italic">The Assistant Secretary of State</hi>
                        (<hi rendition="#italic">Clayton</hi>) <hi rendition="#italic">to the
                        Army–Navy Liquidation Commissioner</hi> (<hi rendition="#italic"
                        >McCabe</hi>)<anchor n="1" xml:id="d1155-f1"/></head>
                <opener>
                    <seg rendition="#center">[Extract]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">secret</hi></seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Babelsberg</hi></placeName>, <date calendar="gregorian"
                            when="1945-07-26">July 26, 1945</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Victory</hi> 349. To [Acting] Secretary of State
                    Washington for McCabe from Clayton[;] for Fetter from Collado.</p>
                <p>Please inform us urgently of status of 1,000 trucks for Poland. …<anchor n="2"
                        xml:id="d1155-f2"/></p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1155-f1" n="1" type="source" xml:id="d1155-f1-content">
                <p>Sent to the Acting Secretary of State over the signature of Byrnes.</p>
            </note>
            <note corresp="#d1155-f2" n="2" xml:id="d1155-f2-content">
                <p>Cf. <hi rendition="#italic">ante</hi>, <ref target="#pg403">p. 403</ref>.</p>
