            </note>
            <note corresp="#d1066-f2" n="2" xml:id="d1066-f2-content">
                <p><ref target="#d1064">Document No. 1064</ref>.</p>
            </note>
            <note corresp="#d1066-f3" n="*" xml:id="d1066-f3-content">
                <p>Annex <hi rendition="#small-caps">i</hi>. [Footnote in the original. For the text
                    of annex <hi rendition="#small-caps">i</hi>, see annex <hi
                        rendition="#small-caps">i</hi> to <ref target="#d1076">document No.
                        1076</ref>.]</p>
            </note>
            <note corresp="#d1066-f4" n="†" xml:id="d1066-f4-content">
                <p>Annex <hi rendition="#small-caps">ii</hi>. [Footnote in the original. This annex
                    is not reproduced here. For its text, see <hi rendition="#italic">What We Saw in
                        Greece: Report of the T. U. C. Delegation</hi> (London, Trades Union
                    Congress, 1945).]</p>
            </note>
        </listAnnotation>
