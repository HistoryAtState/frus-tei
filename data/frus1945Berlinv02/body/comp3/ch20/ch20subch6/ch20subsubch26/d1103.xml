    <text>
        <body>
            <div xml:id="d1103">

                <pb facs="1291" n="1095" xml:id="pg1095"/>

                <note rend="inline" type="source">Pauley Files</note>
                <head>No. 1103<lb/><hi rendition="#italic">United States Delegation Working
                        Paper</hi><anchor n="1" xml:id="d1103-f1"/></head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Babelsberg</hi></placeName>,] <date calendar="gregorian"
                            when="1945-07-25">July 25 [1945.]</date></dateline>
                </opener>
                <p rendition="#center"><hi rendition="#small-caps">Reparations From Italy</hi></p>
                <list>
                    <label>1.</label>
                    <item>Greece, Yugoslavia, Ethiopia and any other United Nation which claims to
                        be entitled to reparations from Italy shall file a statement of the nature
                        and amount of such claim with the Allied Commission for Italy prior to
                        November 1, 1945.</item>
                    <label>2.</label>
                    <item>The Governments of the Soviet Union, the United Kingdom and the United
                        States will consider such claims, in consultation with the other governments
                        concerned, for the purpose of determining the extent to which and the manner
                        in which Italy shall be required to make compensation for the losses
                        suffered by other countries as a result of Italy’s participation with
                        Germany in the war.</item>
                </list>
            </div>
        </body>
    </text>
