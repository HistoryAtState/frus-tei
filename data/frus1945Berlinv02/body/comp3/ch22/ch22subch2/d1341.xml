    <text>
        <body>
            <div xml:id="d1341">

                <pb facs="1597" n="1399" sameAs="frus:frus1945Berlinv02/pg1399"/>

                <note rend="inline" type="source">Truman Papers</note>
                <head>No. 1341<lb/><hi rendition="#italic">Proposal by the Soviet
                        Delegation</hi><anchor n="1" xml:id="d1341-f1"/></head>
                <opener>
                    <seg rendition="#center">[Translation]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Berlin</hi></placeName>, <date calendar="gregorian"
                            when="1945-07-23">July 23, 1945</date>.</dateline>
                </opener>
                <p rendition="#center"><hi rendition="#small-caps">Syria and Lebanon</hi></p>
                <p>Owing to the international importance of the question of the situation in Syria
                    and Lebanon the Conference expresses itself in <pb facs="1598" n="1400"
                        xml:id="pg1400"/> favour of this question being considered by
                    representatives of the United States of America, Great Britain, the USSR and
                    France and deems necessary that consent of the Government of France should be
                    first obtained to this proposal.</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1341-f1" n="1" type="source" xml:id="d1341-f1-content">
                <p>An agency in Syria concerned with the collection and distribution of wheat.</p>
            </note>
