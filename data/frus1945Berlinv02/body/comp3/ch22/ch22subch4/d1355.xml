    <text>
        <body>
            <div xml:id="d1355">

                <pb facs="1611" n="1413" xml:id="pg1413"/>

                <note rend="inline" type="source">881.00/7–2145</note>
                <head>No. 1355<lb/><hi rendition="#italic">The Ambassador in France</hi> (<hi
                        rendition="#italic">Caffery</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">secret</hi>
                        <lb/> No. 2536</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1945-07-21">July 21, 1945</date>.</dateline>
                </opener>
                <p rendition="#flush">Subject: Transmitting Comments on Spanish Threat to Withdraw
                    from the Tangier Statute in the Event of Soviet Participation</p>
                <p>The American Ambassador refers to telegram no. 1548, July 18, 1945 addressed by
                    the American Ambassador in Madrid to the Department<anchor n="1"
                        xml:id="d1355-f1"/> referring to a Spanish threat to withdraw from the
                    Tangier Administration in the event of Soviet participation, and has the honor
                    to transmit, as of possible interest to the Department, a memorandum prepared by
                    Mr. Ernest J. Dempster in consultation with Mr. J. Rives Childs commenting on
                    the disabilities of Spain to carry out its threatened intentions.</p>
                <closer><signed>J R[<hi rendition="#small-caps">ives</hi>] C[<hi
                            rendition="#small-caps">hilds</hi>]</signed></closer>


                <xi:include href="d1355-a1.xml" xpointer="d1355-a1"/>
