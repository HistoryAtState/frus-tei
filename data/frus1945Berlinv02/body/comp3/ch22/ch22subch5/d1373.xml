    <text>
        <body>
            <div xml:id="d1373">

                <pb facs="1633" n="1435" xml:id="pg1435"/>

                <note rend="inline" type="source">840.811/7–2545</note>
                <head>No. 1373<lb/><hi rendition="#italic">Proposal by the United States
                        Delegation</hi><anchor n="1" xml:id="d1373-f1"/></head>
                <opener>
                    <seg rendition="#center">[Extract<anchor n="2" xml:id="d1373-f2"/>]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">Berlin
                                Conference</hi></placeName>, <date calendar="gregorian"
                            when="1945-07-25">July 25, 1945</date>.</dateline>
                </opener>
                <p rendition="#center"><hi rendition="#small-caps">Draft Proposal by American
                        Delegation</hi></p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>The three states will support the policy of free and unrestricted navigation in
                    any revision of the Montreux Convention of 1936.</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1373-f1" n="1" type="source" xml:id="d1373-f1-content">
                <p>Submitted at a meeting of the Subcommittee on Inland Waterways, July 27. See <hi
                        rendition="#italic">ante</hi>, <ref target="#pg453">p. 453</ref>.</p>
            </note>
            <note corresp="#d1373-f2" n="2" xml:id="d1373-f2-content">
                <p>For the other paragraphs of this proposal, see <ref target="#d758">document No.
                        758</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
