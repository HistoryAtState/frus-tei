    <text>
        <body>
            <div xml:id="d1365-a1">

                <pb facs="1622" n="1424" sameAs="frus:frus1945Berlinv02/pg1424"/>

                <opener>
                    <seg rendition="#center">[Attachment]</seg>
                </opener>
                <head><hi rendition="#italic">The Chairman of the State–War–Navy Coordinating
                        Committee</hi> (<hi
                            rendition="#italic">Dunn</hi>) <hi rendition="#italic">to the
                            Secretary of State</hi></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">top secret</hi></seg>
                    <dateline rendition="#float-right">[<date
                            ana="#date_undated-inferred-from-document-content" calendar="gregorian"
                            when="1945-07-30">Undated</date>.<anchor n="4" xml:id="d1365-f1"
                        />]</dateline>
                </opener>
                <p rendition="#center"><hi rendition="#small-caps">Memorandum for the Secretary of
                        State</hi></p>
                <p rendition="#flush">Subject: United States Policy Concerning Dardanelles and Kiel
                    Canal</p>
                <p>The following views of the Joint Chiefs of Staff on the above subject have been
                    approved by the State–War–Navy Coordinating Committee (Berlin) and are forwarded
                    herewith, in compliance with the request of the State Department:</p>
                <p>[Here follows verbatim the body of memorandum No. SM–2610 of July 17 by the Joint Chiefs of Staff. See <ref
                        target="#d751">documents Nos. 751</ref> and <ref target="#d1363"
                    >1363</ref>.]</p>
                <closer><signed><hi rendition="#small-caps">James
                                Clement Dunn</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1365-f1" n="4" xml:id="d1365-f1-content">
                <p>Circulated by the Secretariat of the Committee as SWNCC 169 on July 30.</p>
            </note>
        </listAnnotation>
