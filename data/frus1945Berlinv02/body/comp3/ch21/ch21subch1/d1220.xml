    <text>
        <body>
            <div xml:id="d1220">

                <pb facs="1443" n="1245" sameAs="frus:frus1945Berlinv02/pg1245"/>

                <note rend="inline" type="source">761.93/7–2945: Telegram</note>
                <head>No. 1220<lb/><hi rendition="#italic">The Ambassador in China</hi> (<hi
                        rendition="#italic">Hurley</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">top secret</hi></seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Chungking</hi></placeName>, <date calendar="gregorian"
                            when="1945-07-29">29 July 1945</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Cfb</hi> 2087. Reference to your message of 28 July
                    for Doctor T. V. Soong<anchor n="1" xml:id="d1220-f1"/> the following is Soong’s
                    reply to you: <quote rend="blockquote">
                        <p>“When I left Moscow I had distinct understanding with M. Molotov that he
                            will keep me informed of Marshal Stalin’s movements so that I could
                            reach Moscow soon after he returns.”</p>
                    </quote></p>
                <closer><signed><hi rendition="#small-caps">Hurley</hi></signed></closer>
            </div>
        </body>
    </text>
