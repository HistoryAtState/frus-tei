    <text>
        <body>
            <div xml:id="d1285">

                <pb facs="1536" n="1338" xml:id="pg1338"/>

                <note rend="inline" type="source">J. C. S.
                    Files</note>
                <head>No. 1285<lb/><hi rendition="#italic">Memorandum by the British Chiefs of
                        Staff</hi><anchor n="1" xml:id="d1285-f1"/></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">top secret</hi>
                        <lb/>
                        C. C. S. 892/1 (<hi rendition="#small-caps">Terminal</hi>)</seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Babelsberg</hi></placeName>,] <date calendar="gregorian"
                            when="1945-07-20">20 July 1945</date>.</dateline>
                </opener>
                <p rendition="#center"><hi rendition="#small-caps">Directive to the Supreme Allied
                        Commander Southeast Asia</hi></p>
                <p>We submit for the approval of the Combined Chiefs of Staff the attached draft
                    directive to the Supreme Allied Commander Southeast Asia.<anchor n="2"
                        xml:id="d1285-f2"/></p>


                <xi:include href="d1285-a1.xml" xpointer="d1285-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1285-f1" n="1" type="source" xml:id="d1285-f1-content">
                <p>Considered by the Combined Chiefs of Staff at their 197th Meeting, July 20. See
                        <hi rendition="#italic">ante</hi>, <ref target="#pg162">p. 162</ref>.</p>
            </note>
            <note corresp="#d1285-f2" n="2" xml:id="d1285-f2-content">
                <p>Admiral Lord Louis Mountbatten.</p>
            </note>
        </listAnnotation>
    </standOff>
