    <text>
        <body>
            <div xml:id="d1321-a1">

                <pb facs="1582" n="1384" sameAs="frus:frus1945Berlinv02/pg1384"/>

                <opener>
                    <seg rendition="#center">[Annex I]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">top secret</hi></seg>
                </opener>
                <p rendition="#flush">(<hi rendition="#italic">a</hi>) Approximate Producing
                    Capacity, Rumania, Austria, Hungary</p>
                <table cols="5" rows="3">
                    <row>
                        <cell/>
                        <cell><hi rendition="#italic"
                                >Rumania</hi></cell>
                        <cell><hi rendition="#italic">Austria</hi></cell>
                        <cell><hi rendition="#italic">Hungary</hi></cell>
                        <cell><hi rendition="#italic">Total</hi></cell>
                    </row>
                    <row>
                        <cell>Production Capacity Barrels per day</cell>
                        <cell role="num">87,000</cell>
                        <cell role="num">21,000</cell>
                        <cell role="num">20,000</cell>
                        <cell role="num">128,000</cell>
                    </row>
                    <row>
                        <cell>Refining Capacity Barrels per day</cell>
                        <cell role="num">195,000<anchor n="*" xml:id="d1321-f1"/></cell>
                        <cell role="num">10,000</cell>
                        <cell role="num">16,000</cell>
                        <cell role="num">221,000</cell>
                    </row>
                </table>
                <p rendition="#flush">(<hi rendition="#italic">b</hi>) <hi rendition="#italic"
                        >Tentative Request for Oil Supplies from U. S. to Russia Last Six Months,
                        1945</hi>.</p>
                <table cols="2" rows="6">
                    <row role="label">
                        <cell>Alkylate</cell>
                        <cell role="num">7,900 B/D</cell>
                    </row>
                    <row>
                        <cell>100 Octane Av. Gas.</cell>
                        <cell role="num">3,500 “</cell>
                    </row>
                    <row>
                        <cell>Motor Gasoline</cell>
                        <cell role="num">1,300 “</cell>
                    </row>
                    <row>
                        <cell>Navy Special Fuel Oil</cell>
                        <cell role="num">3,300 “</cell>
                    </row>
                    <row>
                        <cell>Lube Oils</cell>
                        <cell role="num">700 “</cell>
                    </row>
                    <row>
                        <cell>Total</cell>
                        <cell role="num">16,700 B/D</cell>
                    </row>
                </table>
                <closer><dateline rendition="#float-left">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>?], <date calendar="gregorian"
                            when="1945-07-13">July 13, 1945</date>.</dateline></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1321-f1" n="*" xml:id="d1321-f1-content">
                <p>Prewar Capacity: Now operable capacity estimated well above 100,000 barrels per
                    day. [Footnote in the original.]</p>
            </note>
        </listAnnotation>
    </standOff>
