    <text>
        <body>
            <div xml:id="d1291">

                <pb facs="1543" n="1345" sameAs="frus:frus1945Berlinv02/pg1345"/>

                <note rend="inline" type="source">J. C. S. Files</note>
                <head>No. 1291<lb/><hi rendition="#italic">Memorandum by the United States Chiefs of
                        Staff</hi><anchor n="1" xml:id="d1291-f1"/></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">top secret</hi>
                        <lb/> C. C. S. 895/2</seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Babelsberg</hi></placeName>,] <date calendar="gregorian"
                            when="1945-07-19">19 July 1945</date>.</dateline>
                </opener>
                <p rendition="#center"><hi rendition="#small-caps">Participation of Two French
                        Colonial Infantry Divisions in Far Eastern Operations</hi></p>
                <p>The United States Chiefs of Staff have considered the comments of the British
                    Chiefs of Staff in C. C. S. 895/1<anchor n="2" xml:id="d1291-f2"/> as to the
                    employment of the two French divisions and recommend that the enclosed
                    memorandum be forwarded by the Combined Chiefs of Staff to the Chief of the
                    French Military Mission to the United States in lieu of Enclosure “B” to C. C.
                    S. 895.<anchor n="3" xml:id="d1291-f3"/></p>



                <xi:include href="d1291-a1.xml" xpointer="d1291-a1"/>
            </div>
        </body>
    </text>
