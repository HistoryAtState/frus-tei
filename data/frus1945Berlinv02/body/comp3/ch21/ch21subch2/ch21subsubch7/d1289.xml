    <text>
        <body>
            <div xml:id="d1289">

                <pb facs="1542" n="1344" sameAs="frus:frus1945Berlinv02/pg1344"/>

                <note rend="inline" type="source">J. C. S. Files</note>
                <head>No. 1289<lb/><hi rendition="#italic">Memorandum by the United States Chiefs of
                        Staff</hi><anchor n="1" xml:id="d1289-f1"/></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">top secret</hi>
                        <lb/> C. C. S. 842/2</seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Babelsberg</hi></placeName>,] <date calendar="gregorian"
                            when="1945-07-18">18 July 1945</date>.</dateline>
                </opener>
                <p rendition="#center"><hi rendition="#small-caps">French and Dutch Participation in
                        the War Against Japan</hi></p>
                <p>The United States Chiefs of Staff recommend that the Combined Chiefs of Staff
                    forward the enclosed memorandum to the French and Netherlands Representatives to
                    the Combined Chiefs of Staff in lieu of the memorandum in the Enclosure to C. C.
                    S. 842/1.<anchor n="2" xml:id="d1289-f2"/></p>


                <xi:include href="d1289-a1.xml" xpointer="d1289-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1289-f1" n="1" type="source" xml:id="d1289-f1-content">
                <p>Considered by the Combined Chiefs of Staff at their 195th Meeting, July 18. See
                        <hi rendition="#italic">ante</hi>, <ref target="#pg83">p. 83</ref>.</p>
            </note>
