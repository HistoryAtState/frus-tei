    <text>
        <body>
            <div xml:id="d1311">

                <pb facs="1572" n="1374" xml:id="pg1374"/>

                <note rend="inline" type="source">Department of the Army Files: Telegram</note>
                <head>No. 1311<lb/><hi rendition="#italic">The Acting Chairman of the Interim
                        Committee</hi> (<hi rendition="#italic">Harrison</hi>) <hi
                        rendition="#italic">to the Secretary of War</hi> (<hi rendition="#italic"
                        >Stimson</hi>)</head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">top secret</hi>
                        <lb/>
                        <hi rendition="#small-caps">urgent</hi></seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1945-07-23">23 July 1945</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">War</hi> 36791. Top secret Secretary of War <hi
                        rendition="#small-caps">Eyes Only</hi> from Harrison.</p>
                <p>Reference my <hi rendition="#small-caps">War</hi> 35987<anchor n="1"
                        xml:id="d1311-f1"/> and your <hi rendition="#small-caps">Victory</hi>
                        218<anchor n="2" xml:id="d1311-f2"/> Hiroshima, Kokura, Niigata in [<hi
                        rendition="#italic">is?</hi>] order of choice here.</p>
            </div>
        </body>
    </text>
