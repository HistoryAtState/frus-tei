    <text>
        <body>
            <div xml:id="d1269">

                <pb facs="1515" n="1317" xml:id="pg1317"/>

                <note rend="inline" type="source">J. C. S. Files</note>
                <head>No. 1269<lb/><hi rendition="#italic">Memorandum by the British Chiefs of
                        Staff</hi><anchor n="1" xml:id="d1269-f1"/></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">top secret</hi>
                        <lb/> C. C. S. 892/1 (<hi rendition="#small-caps">Terminal</hi>)</seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Babelsberg</hi></placeName>,] <date calendar="gregorian"
                            when="1945-07-20">20 July 1945</date>.</dateline>
                </opener>
                <p rendition="#center"><hi rendition="#small-caps">Directive to the Supreme Allied
                        Commander Southeast Asia</hi></p>
                <p>We submit for the approval of the Combined Chiefs of Staff the attached draft
                    directive to the Supreme Allied Commander Southeast Asia.</p>




                <xi:include href="d1269-a1.xml" xpointer="d1269-a1"/>
                <xi:include href="d1269-a2.xml" xpointer="d1269-a2"/>
            </div>
