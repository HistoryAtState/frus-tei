    <text>
        <body>
            <div xml:id="d1395">

                <pb facs="1743" n="1543" sameAs="frus:frus1945Berlinv02/pg1543"/>

                <note rend="inline" type="source">740.00119 (Potsdam)/7–3145</note>
                <head>No. 1395<lb/><hi rendition="#italic">The Ambassador in France</hi> (<hi
                        rendition="#italic">Caffery</hi>) <hi rendition="#italic">to the French
                        Minister of Foreign Affairs</hi> (<hi rendition="#italic"
                    >Bidault</hi>)</head>
                <opener>
                    <seg rendition="#float-left">No. 533</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1945-07-31">July 31, 1945</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Excellency</hi>: Acting under instructions from my
                    Government, I have the honor to transmit an invitation on behalf of my
                    Government to the Government of France to participate in the Council of Foreign
                    Ministers of the Five Great Powers.</p>
                <p>Your Excellency will note that my Government attaches much importance to the
                    participation of the French Government in the proposed arrangements and hopes to
                    receive an early and favorable reply to this invitation.</p>
                <p>I avail myself [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Jefferson Caffery</hi></signed></closer>


                <xi:include href="d1395-a1.xml" xpointer="d1395-a1"/>
            </div>
        </body>
