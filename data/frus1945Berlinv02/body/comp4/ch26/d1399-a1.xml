    <text>
        <body>
            <div xml:id="d1399-a1">

                <pb facs="1747" n="1547" xml:id="pg1547"/>

                <opener>
                    <seg rendition="#center">[Enclosure]</seg>
                </opener>
                <p>The Governments of the United Kingdom, the United States of America and the U. S.
                    S. R. have pleasure in inviting the Provisional French Government to take part
                    in the work of the Allied Commission on Reparations. They trust that the
                    Provisional French Government will be willing to accept this invitation and
                    appoint a representative as soon as possible.</p>
                <closer><dateline rendition="#float-left">
                        <placeName><hi rendition="#small-caps">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1945-08-01">August 1,
                    1945</date>.</dateline></closer>
            </div>
        </body>
    </text>
