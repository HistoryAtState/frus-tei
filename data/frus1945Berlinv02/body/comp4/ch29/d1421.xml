    <text>
        <body>
            <div xml:id="d1421">

                <pb facs="1790" n="1590" sameAs="frus:frus1945Berlinv02/pg1590"/>

                <note rend="inline" type="source">740.00119 Potsdam/7–2045</note>
                <head>No. 1421<lb/><hi rendition="#italic">Proposal by the Soviet
                        Delegation</hi><anchor n="1" xml:id="d1421-f1"/></head>
                <opener>
                    <seg rendition="#center">[Translation<anchor n="2" xml:id="d1421-f2"/>]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">[<date
                            ana="#date_undated-inferred-from-document-content-and-sibling-dates"
                            calendar="gregorian" notAfter="1945-07-24T23:59:59+03:00"
                            notBefore="1945-07-15T00:00:00+03:00">Undated</date>.]</dateline>
                </opener>
                <p rendition="#center"><hi rendition="#small-caps">Amendments of the Soviet
                        Delegation to the British Draft Declaration on the Polish
                        Question</hi><anchor n="3" xml:id="d1421-f3"/></p>
                <p><hi rendition="#small-caps">It Is Suggested</hi>: <list>
                        <label>1.</label>
                        <item>that the text of paragraph 2 of the above-mentioned document be
                            replaced by a new text (see enclosure 1).</item>
                        <label>2.</label>
                        <item>that the text of the last sentence of paragraph 3 be replaced by a new
                            text (see enclosure 2).</item>
                        <label>3.</label>
                        <item>that the last two sentences of paragraph 4 be omitted.</item>
                    </list></p>



                <xi:include href="d1421-a1.xml" xpointer="d1421-a1"/>
                <xi:include href="d1421-a2.xml" xpointer="d1421-a2"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1421-f1" n="1" type="source" xml:id="d1421-f1-content">
                <p>Submitted to the Subcommittee on Poland.</p>
            </note>
            <note corresp="#d1421-f2" n="2" xml:id="d1421-f2-content">
                <p>The translations of this proposal and of its two enclosures were prepared for
                    this volume by the Division of Language Services, Department of State.</p>
            </note>
            <note corresp="#d1421-f3" n="3" xml:id="d1421-f3-content">
                <p>For the text of the British proposal referred to, see <ref target="#d1121"
                        >document No. 1121</ref>. For the text reported by the Subcommittee, after
                    consideration of the British and Soviet drafts on this subject, see <ref
                        target="#d1129">document No. 1129</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
