    <text>
        <body>
            <div xml:id="list-of-illustrations">

                <pb facs="0015" n="XI" xml:id="pgXI"/>

                <head>List of Illustrations and Maps</head>
                <p rendition="#center">PHOTOGRAPHS</p>
                <p rendition="#center">(Eight United States Army photographs taken at the Berlin
                    Conference will be found in a group following <ref target="#pg400">page
                        400</ref>.)</p>
                <list>
                    <item><ref target="#pg1">Cecilienhof Palace</ref></item>
                    <item><ref target="#pg2">The three Heads of Government, July 17,
                        1945</ref></item>
                    <item><ref target="#pg3">First plenary meeting, July 17, 1945</ref></item>
                    <item><ref target="#pg4">Third plenary meeting, July 19, 1945</ref></item>
                    <item><ref target="#pg5">Meeting of the Combined Chiefs of Staff, July 21,
                            1945</ref></item>
                    <item><ref target="#pg6">Meeting of the United States and Soviet Chiefs of
                            Staff, July 26, 1945</ref></item>
                    <item><ref target="#pg7">Tenth meeting of the Foreign Ministers, July 30,
                            1945</ref></item>
                    <item><ref target="#pg8">The three Heads of Government and their principal
                            advisers, August 1, 1945</ref></item>
                </list>
                <p rendition="#center">FACSIMILES OF DOCUMENTS</p>
                <list>
                    <item><ref target="#pg1478">Signed “top document” attached to the Protocol of
                            Proceedings of the Berlin Conference <hi rendition="#italic"
                            >facing</hi></ref></item>
                    <item><ref target="#pg1479">A page from the United States original of the
                            Protocol of Proceedings of the Berlin Conference <hi rendition="#italic"
                                >facing</hi></ref></item>
                </list>
                <p rendition="#center">MAPS</p>
                <list>
                    <item><ref target="#pg346">The Japanese Armed Forces: Ground, 18 June 1945
                                (C. C. S. 643/3, annex to appendix
                            B) (<hi rendition="#italic">in color</hi>) <hi rendition="#italic"
                                >facing</hi></ref></item>
                    <item><ref target="#pg346">Ground Situation in China, 6 June 1945: Major U. S.
                            Airfields Held by Japanese and Chinese (C. C.
                                S. 893/1, appendix D) (<hi rendition="#italic">in
                            color</hi>) <hi rendition="#italic">facing</hi></ref></item>
                    <item><ref target="#pg350">Pacific Situation, 1 July 1945 (C. C. S. 893, appendix A) (<hi
                                rendition="#italic">in color</hi>) . <hi rendition="#italic"
                                >facing</hi></ref></item>
                    <item><ref target="#pg926">The Ruhr: Traffic Districts and Administrative
                            Divisions <hi rendition="#italic">facing</hi></ref></item>
                    <item><ref target="#pg1152">Consideration of the Western Frontier of Poland at
                            the Berlin Conference <hi rendition="#italic">facing</hi></ref></item>
                </list>
            </div>
