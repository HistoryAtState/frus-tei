            </note>
            <note corresp="#d273-f2" n="23" xml:id="d273-f2-content">
                <p>Semen Konstantinovich Tsarapkin.</p>
            </note>
            <note corresp="#d273-f3" n="24" xml:id="d273-f3-content">
                <p>George F. Kennan, Counselor of American Embassy.</p>
            </note>
            <note corresp="#d273-f4" n="25" xml:id="d273-f4-content">
                <p>Pavel Nikolayevich Kumykin.</p>
            </note>
        </listAnnotation>
