    <text>
        <body>
            <div xml:id="d279">

                <pb facs="0852" n="840" xml:id="pg840"/>

                <note rend="inline" type="source">740.00112A EW/5–2645: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Ambassador in the United Kingdom</hi> (<hi
                            rendition="#italic">Winant</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-05-26T18:00:00-04:00">May 26, 1945—6
                            p.m.</date>
                    </dateline>
                </opener>
                <p>4203. Please inform Missions in London Coordination Area<anchor n="36"
                        xml:id="d279-f1"/> that Confidential List will be abolished on May 26 and
                    suggest, where appropriate, that review of list be made for names which should
                    be promoted to Proclaimed List.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Grew</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d279-f1" n="36" xml:id="d279-f1-content">
                <p>The London Coordination Area was composed of Ireland, Sweden, Switzerland,
                    Portugal and Spain with their possessions, Tangier, Turkey, Iran, and Iraq.</p>
            </note>
        </listAnnotation>
    </standOff>
