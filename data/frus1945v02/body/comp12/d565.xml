            <div xml:id="d565">

                <pb facs="1221" n="1209" sameAs="frus:frus1945v02/pg1209"/>

                <note rend="inline" type="source">800.4016 D.P./11–1745: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the United States Political
                        Adviser for Germany</hi> (<hi rendition="#italic">Murphy</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-12-01T13:00:00-05:00">December 1, 1945—1
                            p.m.</date>
                    </dateline>
                </opener>
                <p>987. Suggestion re segregation Jewish displaced persons contained urtel 1041 Nov
                    17 viewed favorably by Dept. Please inform Dept re ultimate action taken.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Byrnes</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
