            </note>
            <note corresp="#d121-f3" n="62" xml:id="d121-f3-content">
                <p>September 22, “Provisional Navigation Regime for European Inland Waterways”, <ref
                        target="#pg324">p. 324</ref>.</p>
            </note>
        </listAnnotation>
