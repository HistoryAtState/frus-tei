                <pb facs="0347" n="335" xml:id="pg335"/>

                <note rend="inline" type="source">Council of Foreign Ministers Files: Lot M–88: CFM
                    London Decisions</note>
                <head>
                    <hi rendition="#italic">Record of Decisions of the Eighteenth Meeting of the
                        Council of Foreign Ministers, Lancaster House, London, September 24, 1945,
                        11 a.m.</hi>
                </head>
                <dateline>
                    <placeName>London</placeName>, <date
                        ana="#date_undated-inferred-from-document-head" calendar="gregorian"
                        when="1945-09-24T11:00:00+00:00">September 24, 1945, 11 a.m.</date>
                </dateline>
                <opener>
                    <seg rendition="#float-left">C.F.M.(P) (45) 18th Meeting</seg>
                </opener>
                <p rendition="#center">
                    <hi rendition="#small-caps">Present</hi>
                </p>
                <table rend="width: 98%" rendition="#center">
                    <row role="label">
                        <cell rend="padding-left: 4em">U.K.</cell>
                        <cell rend="padding-left: 4em">U.S.A</cell>
                        <cell rend="padding-left: 4em">U.S.S.R</cell>
                    </row>
                    <row>
                        <cell>Mr. Bevin</cell>
                        <cell>Mr. Byrnes</cell>
                        <cell>M. Molotov</cell>
                    </row>
                    <row>
                        <cell>Sir R. I. Campbell</cell>
                        <cell>Mr. J. Dunn</cell>
                        <cell>M. F. T. Gousev</cell>
                    </row>
                    <row>
