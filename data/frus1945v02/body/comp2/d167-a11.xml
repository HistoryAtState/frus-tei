                    <seg rendition="#center">[Annex 11]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">Record of Decisions of the Eleventh Meeting of the
                        Council of Foreign Ministers, London, September 19, 1945</hi><anchor n="7"
                        xml:id="d167-f1"/>
                </head>
                <p rendition="#flush">
                    <hi rendition="#small-caps">Italian Peace Treaty: Yugoslav–Italian Frontier and
                        Trieste</hi>
                </p>
                <p>An exchange of views took place.</p>
            </div>
