                        </cell>
                        <cell rend="padding-left: 4em">
                            <hi rendition="#small-caps">China</hi>
                        </cell>
                    </row>
                    <row>
                        <cell>M. Bidault (Chairman)</cell>
                        <cell>Dr. Wang Shih Chieh</cell>
                    </row>
                    <row>
                        <cell>M. Couve de Murville</cell>
                        <cell>Dr. Wellington Koo</cell>
                    </row>
                    <row>
