                <pb facs="0299" n="287" sameAs="frus:frus1945v02/pg287"/>

                <note rend="inline" type="source">Council of Foreign Ministers Files: Lot M–88: CFM
                    London Decisions</note>
                <head>
                    <hi rendition="#italic">Record of Decisions of the Fifteenth Meeting of the
                        Council of Foreign Ministers, Lancaster House, London, September 21, 1945,
                        11 a.m.</hi><anchor n="16" xml:id="d115-f1"/>
                </head>
                <dateline>
                    <placeName>London</placeName>, <date
                        ana="#date_undated-inferred-from-document-head" calendar="gregorian"
                        when="1945-09-21T11:00:00+00:00">September 21, 1945, 11 a.m.</date>
                </dateline>
                <opener>
                    <seg rendition="#float-left">C.F.M.(P) (45) 15th Meeting</seg>
                </opener>
                <p rendition="#center">
                    <hi rendition="#small-caps">Present</hi>
                </p>
