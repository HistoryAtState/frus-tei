    <text>
        <body>
            <div xml:id="d746">

                <pb facs="1461" n="1449" sameAs="frus:frus1945v02/pg1449"/>

                <note rend="inline" type="source">840.50/5–1645: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the United Kingdom</hi> (<hi
                        rendition="#italic">Winant</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1945-05-16T17:00:00+02:00">May 16, 1945—5
                            p.m.</date>
                        <lb/> [Received May 16—3:59 p.m.]</dateline>
                </opener>
                <p>4875. ReDepts 3723, May 12, 1 p.m. Your suggestion regarding formal invitation to
                    Danish Govt to attend meetings of ECO and EECE is agreed to by the Foreign
                    Office which is issuing the invitation immediately.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Winant</hi>
                    </signed>
                </closer>
            </div>
        </body>
