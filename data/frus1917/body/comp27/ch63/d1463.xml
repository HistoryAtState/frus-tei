    <text>
        <body>
            <div xml:id="d1463">

                <pb facs="1381" n="1215" sameAs="frus:frus1917/pg1215"/>

                <note rend="inline" type="source">File No. 816.48/10</note>
                <head>
                    <hi rendition="#italic">President Melendez to President Wilson </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Translation]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">San Salvador</hi></placeName>, <date
                            calendar="gregorian" when="1917-06-10">
                            <hi rendition="#italic">June 10, 1917</hi></date>.</dateline>
                </opener>
                <p>In the name of the people of Salvador, and in my own, I acknowledge with
                    heartfelt thanks the sentiments of sympathy from Your Excellency and the
                    American people arid also the generous wishes you are pleased to express to me
                    for the sufferers of the disaster that has taken place.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">President Melendez</hi>
                    </signed>
                </closer>
            </div>
        </body>
