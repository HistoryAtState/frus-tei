                <pb facs="1003" n="837" sameAs="frus:frus1917/pg837"/>

                <note rend="inline" type="source">File No. 365.117/497</note>
                <head>
                    <hi rendition="#italic">Minister Stovall to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Berne</hi></placeName>, <date
                            calendar="gregorian" when="1917-02-16">
                            <hi rendition="#italic">February 16, 1917</hi></date>.</dateline>
                </opener>
                <p>Frank J. Ghiloni left Berne, January 31, for Bordeaux to embark United States. I
                    have requested Consul Bordeaux to report by telegraph.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stovall</hi>
                    </signed>
                </closer>
            </div>
        </body>
