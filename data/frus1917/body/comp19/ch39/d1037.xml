    <text>
        <body>
            <div xml:id="d1037">

                <pb facs="1008" n="842" sameAs="frus:frus1917/pg842"/>

                <note rend="inline" type="source">File No. 365.117/583</note>
                <head>
                    <hi rendition="#italic">Ambassador Page to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Extract]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 772</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Rome</hi></placeName>, <date
                            calendar="gregorian" when="1917-10-13">
                            <hi rendition="#italic">October 13, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith
                    translation of a note received to-day from the R. Ministry for Foreign Affairs
                    from which it will be seen that Guglielmo Andreaccio has been released from
                    military service.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Thos. Nelson Page</hi>
                    </signed>
                </closer>


                <xi:include href="d1037-a1.xml" xpointer="d1037-a1"/>
            </div>
        </body>
    </text>
