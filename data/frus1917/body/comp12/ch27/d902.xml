    <text>
        <body>
            <div xml:id="d902">

                <pb facs="0895" n="729" sameAs="frus:frus1917/pg729"/>

                <note rend="inline" type="source">File No. 439.00/22</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Minister Russell
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-12-29">
                            <hi rendition="#italic">December 29, 1917</hi></date>.</dateline>
                </opener>
                <p>Your dispatch No. 275, December 15, 1917. In accordance with General Rule No. 1,
                    Dominican Claims Commission of 1917, enter appearance for American claimants
                    listed with Johnston Commission who have not filed claims with present
                    Commission as you purpose doing for other American claimants who have not
                    appeared.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
