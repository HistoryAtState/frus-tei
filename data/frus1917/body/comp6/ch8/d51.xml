            <div xml:id="d51">

                <pb facs="0210" n="44" sameAs="frus:frus1917/pg44"/>

                <note rend="inline" type="source">File No. 813.00/866</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            Salvadorean Minister
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 23</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-09-08">
                            <hi rendition="#italic">September 8, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the
                    receipt of your note of August 31, 1917, in further relation to the desire of
                    your Government that this Government may be represented in the Central American
                    Conference concerning the continuance of the Central American Court of
                    Justice.</p>
                <p>In reply I have the honor to refer you to the Department’s note of the 5th
                    instant, in reply to your note of August 23.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
