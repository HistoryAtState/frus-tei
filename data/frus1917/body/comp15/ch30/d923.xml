    <text>
        <body>
            <div xml:id="d923">

                <pb facs="0916" n="750" sameAs="frus:frus1917/pg750"/>

                <note rend="inline" type="source">File No. 868.001A12/18</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Minister Droppers </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 155</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-10-06">
                            <hi rendition="#italic">October 6, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I enclose herewith, with office copy, a
                    letter addressed by the President to the new Greek King, acknowledging the
                    receipt of his letter of July 6 last announcing his accession to the throne.</p>
                <p>You will forward the copy to the Foreign Office and deliver the original in the
                    manner most agreeable to His Majesty.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">William Phillips</hi>
                    </signed>
                </closer>


                <xi:include href="d923-a1.xml" xpointer="d923-a1"/>
            </div>
        </body>
    </text>
