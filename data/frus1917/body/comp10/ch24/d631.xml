                <note rend="inline" type="source">File No. 837.156/223a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Minister Gonzales
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-02-29T17:00:00-05:00">
                            <hi rendition="#italic">February 29, 1916, 5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Report by cable latest developments Cuban Ports Company matter.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
