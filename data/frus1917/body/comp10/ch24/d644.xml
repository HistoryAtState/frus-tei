        <body>
            <div xml:id="d644">

                <pb facs="0612" n="446" sameAs="frus:frus1917/pg446"/>

                <note rend="inline" type="source">File No. 837.156/240</note>
                <head>
                    <hi rendition="#italic">Minister Gonzales to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 368</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Habana</hi></placeName>, <date
                            calendar="gregorian" when="1916-08-25">
                            <hi rendition="#italic">August 25, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith a
                    translation of a note, dated August 22, from the Cuban Secretary of State,
                    replying to my note of August 7, relative to the matter of the Cuban Ports
                    Company, addressed to him in pursuance of the Department’s instruction No. 235
                    of July 31, 1916.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">William E. Gonzales</hi>
                    </signed>
                </closer>


                <xi:include href="d644-a1.xml" xpointer="d644-a1"/>
            </div>
        </body>
    </text>
