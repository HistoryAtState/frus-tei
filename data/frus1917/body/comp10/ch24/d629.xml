                <pb facs="0601" n="435" xml:id="pg435"/>

                <note rend="inline" type="source">File No. 837.156/209</note>
                <head>
                    <hi rendition="#italic">Minister Gonzales to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Habana</hi></placeName>, <date
                            calendar="gregorian" when="1915-11-22T14:00:00-05:29">
                            <hi rendition="#italic">November 22, 1915, 2 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Court renders decision against Cuban Ports Company leaving company without
                    standing. Five days before copy decision obtainable.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Gonzales</hi>
                    </signed>
                </closer>
            </div>
        </body>
