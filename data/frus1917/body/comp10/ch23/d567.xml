            <div xml:id="d567">

                <pb facs="0580" n="414" sameAs="frus:frus1917/pg414"/>

                <note rend="inline" type="source">File No. 337.11/170</note>
                <head>
                    <hi rendition="#italic">Minister Gonzales to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegrams]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Habana</hi></placeName>, <date
                            calendar="gregorian" when="1917-02-20T22:00:00-05:29">
                            <hi rendition="#italic">February 20, 1917, 10 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your February 19, 6 p.m. Had already reported, matter to Government. Conditions
                    changed for better as reported to-day by representative of company.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Gonzales</hi>
                    </signed>
                </closer>
            </div>
        </body>
