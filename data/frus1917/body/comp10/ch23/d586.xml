            <div xml:id="d586">

                <pb facs="0586" n="420" sameAs="frus:frus1917/pg420"/>

                <note rend="inline" type="source">File No. 337.11/282</note>
                <head>
                    <hi rendition="#italic">Minister Gonzales to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegrams]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Habana</hi></placeName>, <date
                            calendar="gregorian" when="1917-03-14T11:00:00-05:29">
                            <hi rendition="#italic">March 14, 1917, 11 a.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>My telegram of March 12, 7 p.m. Van Patton, American Administrator Punta Alegre,
                    has been released.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Gonzales</hi>
                    </signed>
                </closer>
            </div>
