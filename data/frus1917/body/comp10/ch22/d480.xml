    <text>
        <body>
            <div xml:id="d480">

                <pb facs="0537" n="371" sameAs="frus:frus1917/pg371"/>

                <note rend="inline" type="source">File No. 837.00/1121</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Minister Gonzales
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Extract]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-03-01">
                            <hi rendition="#italic">March 1, 1917</hi></date>.</dateline>
                </opener>
                <p>For your information. The following was sent to the American Consul at Santiago
                    on February 23, in response to a statement forwarded by him from the Chamber of
                    Commerce of Santiago, addressed to President Wilson. [Here follows Department’s
                    telegram of February 23, 1917, to the American Consul at Santiago.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
