    <text>
        <body>
            <div xml:id="d563">

                <pb facs="0579" n="413" sameAs="frus:frus1917/pg413"/>

                <note rend="inline" type="source">File No. 837.001M52/29</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Cuban Minister </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 167</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-08-15">
                            <hi rendition="#italic">August 15, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the
                    receipt of your note of the 10th instant in which you enclose a letter, with
                    office copy, addressed to the President by His Excellency the President of Cuba,
                    announcing his election to the Presidency of that Republic and his assumption of
                    his high office.</p>
                <p>I have the honor to say in reply that I have laid President Menocal’s letter
                    before the President and that the latter’s reply will shortly be transmitted
                    through the American Minister at Habana.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
