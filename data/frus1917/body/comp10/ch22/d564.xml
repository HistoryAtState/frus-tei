    <text>
        <body>
            <div xml:id="d564">

                <pb facs="0579" n="413" sameAs="frus:frus1917/pg413"/>

                <note rend="inline" type="source">File No. 837.001M52/29</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Minister Gonzales </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 394</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-09-06">
                            <hi rendition="#italic">September 6, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I enclose herewith, with office copy, a
                    letter addressed by the President to His Excellency Mario G. Menocal,
                    acknowledging the receipt of his letter of May 20 last in which he announced his
                    assumption of the Presidency of the Republic of Cuba.</p>
                <p>You will forward the copy to the Foreign Office and deliver the original in the
                    manner most agreeable to His Excellency.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">William Phillips</hi>
                    </signed>
                </closer>



                <xi:include href="d564-a1.xml" xpointer="d564-a1"/>
            </div>
        </body>
    </text>
