    <text>
        <body>
            <div xml:id="d562">

                <pb facs="0578" n="412" sameAs="frus:frus1917/pg412"/>

                <note rend="inline" type="source">File No. 837.001M52/29</note>
                <head>
                    <hi rendition="#italic">The Cuban Minister to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Translation]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 90</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Legation of Cuba</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-08-10">
                            <hi rendition="#italic">August 10, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Secretary</hi>: I have the high honor to place
                    in your excellency’s hands, together with this note, the autograph letter
                    written to His Excellency, Mr. Woodrow Wilson, President of the United States of
                    America, by the President of Cuba, with the request that you kindly forward it
                    to its high destination.</p>
                <p>I also have the honor to enclose the usual office copy of the said autograph
                    letter.</p>
                <p>I renew [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Carlos Manuel de Céspedes</hi>
                    </signed>
                </closer>



                <xi:include href="d562-a1.xml" xpointer="d562-a1"/>
            </div>
        </body>
    </text>
