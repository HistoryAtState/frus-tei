    <text>
        <body>
            <div xml:id="d542">

                <pb facs="0569" n="403" sameAs="frus:frus1917/pg403"/>

                <note rend="inline" type="source">File No. 837.00/1336</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Minister Gonzales </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-05-10">
                            <hi rendition="#italic">May 10, 1917</hi></date>.</dateline>
                </opener>
                <p>Your May 7. Convey to Cuban Government congratulations of this Government in view
                    of proclamation by Cuban Congress of the election of President Menocal and Vice
                    President Nuñez.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
