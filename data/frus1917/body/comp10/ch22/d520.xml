        <body>
            <div xml:id="d520">

                <pb facs="0557" n="391" xml:id="pg391"/>

                <note rend="inline" type="source">File No. 837.00/1283</note>
                <head>
                    <hi rendition="#italic">Minister Gonzales to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 433</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Habana</hi></placeName>, <date
                            calendar="gregorian" when="1917-03-29">
                            <hi rendition="#italic">March 29, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith in
                    translation a copy of President Menocal’s manifesto to the people of Cuba, dated
                    March 26, 1917.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">William E. Gonzales</hi>
                    </signed>
                </closer>


                <xi:include href="d520-a1.xml" xpointer="d520-a1"/>
