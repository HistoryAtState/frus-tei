    <text>
        <body>
            <div xml:id="d555">

                <pb facs="0576" n="410" sameAs="frus:frus1917/pg410"/>

                <note rend="inline" type="source">File No. 837.001M52/28</note>
                <head>
                    <hi rendition="#italic">The Cuban Minister to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Translation]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 60</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Cuban Legation</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-05-21">
                            <hi rendition="#italic">May 21, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Secretary</hi>: I have the honor to inform your
                    excellency that on yesterday the 20th of May 1917, Messrs. Mario G. Menocal and
                    Emilio Nuñez assumed the offices of President and Vice President of the Republic
                    of Cuba to which they were respectively proclaimed by the National Congress to
                    have been elected for the term of four years which will end on May 21, 1921.</p>
                <p>I avail [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Carlos Manuel de Céspedes</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
