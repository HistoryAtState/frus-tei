    <text>
        <body>
            <div xml:id="d491">

                <pb facs="0543" n="377" sameAs="frus:frus1917/pg377"/>

                <note rend="inline" type="source">File No. 837.00/1206</note>
                <head>
                    <hi rendition="#italic">Minister Gonzales to Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 423</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Habana</hi></placeName>, <date
                            calendar="gregorian" when="1917-03-05">
                            <hi rendition="#italic">March 5, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose in translation
                    copy of a communication from the Mayor of Cienfuegos to our Consul in that city,
                    conveying by resolution of the city council a message of commendation to our
                    Government for its attitude towards the insurrection, and referred to me by Mr.
                    Bartleman.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">William E. Gonzales</hi>
                    </signed>
                </closer>



                <xi:include href="d491-a1.xml" xpointer="d491-a1"/>
            </div>
        </body>
    </text>
