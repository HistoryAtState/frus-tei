            <div xml:id="d472">

                <pb facs="0533" n="367" sameAs="frus:frus1917/pg367"/>

                <note rend="inline" type="source">File No. 837.00/1141</note>
                <head>
                    <hi rendition="#italic">Consul Griffith to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">Santiago</hi>
                        </placeName> [<date
                            ana="#date_undated-inferred-from-document-content-and-sibling-dates"
                            calendar="gregorian" notAfter="1917-02-26T23:59:59-05:00"
                            notBefore="1917-02-25T19:00:00-05:29"><hi rendition="#italic"
                                >undated</hi></date><hi rendition="#italic">; received February 26,
                            1917</hi>].</dateline>
                </opener>
                <p>Cuban gunboat <hi rendition="#italic">Cuba</hi> now outside blockading harbor
                    entrance.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Griffith</hi>
                    </signed>
                </closer>
            </div>
