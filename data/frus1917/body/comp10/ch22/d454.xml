    <text>
        <body>
            <div xml:id="d454">

                <pb facs="0527" n="361" xml:id="pg361"/>

                <note rend="inline" type="source">File No. 837.00/1087</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Minister Gonzales </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-02-16T15:00:00-05:00">
                            <hi rendition="#italic">February 16, 1917—3 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Navy Department informs Department that U. S. S. <hi rendition="#italic"
                        >Machias</hi> will replace U. S. S. <hi rendition="#italic">Petrel</hi> at
                    Santiago arid that U. S. S. <hi rendition="#italic">Dixie</hi> will sail for
                    Habana some time today. These vessels will report upon conditions and be present
                    in case of emergency.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
