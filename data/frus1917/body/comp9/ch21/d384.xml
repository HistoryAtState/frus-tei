    <text>
        <body>
            <div xml:id="d384">

                <pb facs="0474" n="308" sameAs="frus:frus1917/pg308"/>

                <note rend="inline" type="source">File No. 818.00/90a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Minister Leavell
                    </hi><anchor n="4" xml:id="d384-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-02-23T19:00:00-05:00">
                            <hi rendition="#italic">February 23, 1917, 7 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>The following statement has been made to General Tinoco at San José and he has
                    been informed that it has been made public in the United States and in Central
                    America: [Here follows second paragraph of above telegram.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d384-f1" n="4" type="source" xml:id="d384-f1-content">
                <p>Same to the American Legations at Managua, Tegucigalpa and San Salvador.</p>
            </note>
        </listAnnotation>
    </standOff>
