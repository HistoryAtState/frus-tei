                <note rend="inline" type="source">File No. 818.00/55</note>
                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Limon</hi></placeName>, <date
                            calendar="gregorian" when="1917-01-27T00:00:00-05:36">
                            <hi rendition="#italic">January 27, 1917,
                        midnight</hi></date>.</dateline>
                </opener>
                <p>The President and the Cabinet and Maximo Fernandez, the President of Congress,
                    request the protection of the Government of the United States to sustain legal
                    Government.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hale</hi>
                    </signed>
                </closer>
            </div>
