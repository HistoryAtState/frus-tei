        <body>
            <div xml:id="d380">

                <pb facs="0473" n="307" sameAs="frus:frus1917/pg307"/>

                <note rend="inline" type="source">File No. 818.00/74</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Consul Chase </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 19</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-02-12">
                            <hi rendition="#italic">February 12, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The Department has received, and read with
                    interest, your despatch No. 24 of January 27, 1917, reporting that on that date
                    a revolution was started in San José, Costa Rica, by the Minister of War,
                    Federico Tinoco.</p>
                <p>Your action in not giving information regarding the attitude of the Government of
                    the United States is approved by the Department.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Wilbur J. Carr</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
