    <text>
        <body>
            <div xml:id="d121">

                <pb facs="0253" n="87" sameAs="frus:frus1917/pg87"/>

                <note rend="inline" type="source">File No. 893.001F35/1</note>
                <head>
                    <hi rendition="#italic">Minister Reinsch to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegrams]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Peking</hi></placeName>, <date
                            calendar="gregorian" when="1917-07-17T18:00:00+08:00">
                            <hi rendition="#italic">July 17, 1917, 6 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Minister for Foreign Affairs communicates notification from Vice President Feng
                    that in accordance with law he is performing in an acting capacity the duties of
                    the President, having assumed office on the 6th instant.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Reinsch</hi>
                    </signed>
                </closer>
            </div>
        </body>
