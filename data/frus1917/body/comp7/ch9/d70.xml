    <text>
        <body>
            <div xml:id="d70">

                <pb facs="0222" n="56" xml:id="pg56"/>

                <note rend="inline" type="source">File No. 893.00/2650</note>
                <head>
                    <hi rendition="#italic">Consul General Heintzleman to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 64</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate General</hi>, <lb/>
                            <hi rendition="#italic">Canton</hi></placeName>, <date
                            calendar="gregorian" when="1917-06-06">
                            <hi rendition="#italic">June 6, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith, for
                    the information of the Department, copy of my despatch No. 23, of today’s date,
                    to the Legation.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">P. S. Heintzleman</hi>
                    </signed>
                </closer>


                <xi:include href="d70-a1.xml" xpointer="d70-a1"/>
