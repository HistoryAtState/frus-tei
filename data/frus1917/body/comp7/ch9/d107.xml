    <text>
        <body>
            <div xml:id="d107">

                <pb facs="0246" n="80" sameAs="frus:frus1917/pg80"/>

                <note rend="inline" type="source">File No. 893.00/2644</note>
                <head>
                    <hi rendition="#italic">Consul General Sammons to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate General</hi>, <lb/>
                            <hi rendition="#italic">Shanghai</hi></placeName>, <date
                            calendar="gregorian" when="1917-07-03T12:00:00+08:00">
                            <hi rendition="#italic">July 3, 1917, noon</hi></date>.</dateline>
                </opener>
                <p>Chinese Commissioner of Foreign Affairs states confidently Vice President Feng
                    and all local military and naval forces agree oppose monarchy.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Sammons</hi>
                    </signed>
                </closer>
            </div>
        </body>
