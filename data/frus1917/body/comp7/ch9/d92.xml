                <note rend="inline" type="source">File No. 893.00/2620</note>
                <head>
                    <hi rendition="#italic">Ambassador Sharp to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Extract]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1917-06-17">
                            <hi rendition="#italic">June 17, 1917</hi></date>.</dateline>
                </opener>
                <p>2190. Your 2313, June 4, and 2338, June 9. The following is a translation of a
                    note from the Ministry for Foreign Affairs in reply thereto, just
                        received.<anchor n="7" xml:id="d92-f1"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Sharp</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d92-f1" n="7" xml:id="d92-f1-content">
                <p>Printed as inclosure to despatch No. 5456, June 20, 1917, from the American
                    Embassy at Paris.</p>
            </note>
