    <text>
        <body>
            <div xml:id="d294">

                <pb facs="0390" n="224" sameAs="frus:frus1917/pg224"/>

                <note rend="inline" type="source">File No. 893.811/276</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Minister Reinsch </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-11-02T17:00:00-05:00">
                            <hi rendition="#italic">November 2, 1917, 5 p.m</hi></date>.</dateline>
                </opener>
                <p>For your and Carey’s information: <quote rend="blockquote">
                        <p>Canal having Corporation’s most serious consideration. Decisions will be
                            communicated soon as possible. Have called in conservancy engineers
                            familiar with situation who are now studying matter. <hi
                                rendition="#small-caps">Stone</hi>
                        </p>
                    </quote>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
