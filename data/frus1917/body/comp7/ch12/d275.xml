                <note rend="inline" type="source">File No. 893.811/246</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Minister Reinsch
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-02-09T17:00:00-05:00">
                            <hi rendition="#italic">February 9, 1917, 5 p.m</hi></date>.</dateline>
                </opener>
                <p>Your February 2, 5 p.m. See International Corporation’s telegram of February 5 to
                    their Peking representative.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
