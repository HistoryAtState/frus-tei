    <text>
        <body>
            <div xml:id="d282">

                <pb facs="0384" n="218" sameAs="frus:frus1917/pg218"/>

                <note rend="inline" type="source">File No. 893.811/260</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Minister Reinsch
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 633</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-06-12">
                            <hi rendition="#italic">June 12, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The Department acknowledges the receipt of
                    your despatch No. 1458 of April 19, 1917, relative to the proposed cooperation
                    between the American International Corporation and Japanese capitalists in the
                    improvement of the Grand Canal in Shantung.</p>
                <p>Your action in regard to this matter, as reported in the despatch under
                    acknowledgment, is approved.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Frank L. Polk</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
