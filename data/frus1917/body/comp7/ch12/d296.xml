    <text>
        <body>
            <div xml:id="d296">

                <pb facs="0391" n="225" sameAs="frus:frus1917/pg225"/>

                <note rend="inline" type="source">File No. 893.811/279</note>
                <head>
                    <hi rendition="#italic">Minister Reinsch to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Extract]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Peking</hi></placeName>, <date
                            calendar="gregorian" when="1917-11-21T18:00:00+08:00">
                            <hi rendition="#italic">November 21, 1917, 6 p.m</hi></date>.</dateline>
                </opener>
                <p>Grand Canal contract signed yesterday subject to consent of Parliament.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Reinsch</hi>
                    </signed>
                </closer>
            </div>
