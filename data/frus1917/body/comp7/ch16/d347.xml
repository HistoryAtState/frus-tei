    <text>
        <body>
            <div xml:id="d347">

                <pb facs="0450" n="284" sameAs="frus:frus1917/pg284"/>

                <note rend="inline" type="source">File No. 611.9331/45</note>
                <head>
                    <hi rendition="#italic">Minister Reinsch to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1442</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Peking</hi></placeName>, <date
                            calendar="gregorian" when="1917-04-06">
                            <hi rendition="#italic">April 6, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to report that the
                    Chinese Government, through the Revenue Board, has decided to permit the free
                    export by Chinese or foreign merchants of Shanghai milled flour. There is <pb
                        facs="0451" n="285" xml:id="pg285"/> enclosed herewith a copy of a letter
                    from the Inspector General of Customs to the Chinese Secretary of this Legation
                    setting forth the terms on which such export may be made.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Paul S. Reinch</hi>
                    </signed>
                </closer>


                <xi:include href="d347-a1.xml" xpointer="d347-a1"/>
            </div>
        </body>
    </text>
