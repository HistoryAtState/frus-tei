    <text>
        <body>
            <div xml:id="d346">

                <pb facs="0450" n="284" sameAs="frus:frus1917/pg284"/>

                <note rend="inline" type="source">File No. 611.9331/43</note>
                <head>
                    <hi rendition="#italic">Minister Reinsch to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/> [<hi
                                rendition="#italic">Peking</hi>
                        </placeName>
                        <date ana="#date_undated-inferred-from-document-content"
                            calendar="gregorian" notAfter="1917-04-05T09:30:00-05:00"
                            notBefore="1917-04-01T00:00:00+08:00"><hi rendition="#italic"
                                >undated</hi></date><hi rendition="#italic">; received April 5,
                            1917, 9.30 a.m.</hi>]</dateline>
                </opener>
                <p>Revenue Council has issued instructions permitting foreign and Chinese merchants
                    to export flour on payment of forty cents Mexican per bag.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Reinsch</hi>
                    </signed>
                </closer>
            </div>
