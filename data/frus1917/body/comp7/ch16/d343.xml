    <text>
        <body>
            <div xml:id="d343">

                <pb facs="0449" n="283" sameAs="frus:frus1917/pg283"/>

                <note rend="inline" type="source">File No. 611.9331/38</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Minister Reinsch </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-01-19T16:00:00-05:00">
                            <hi rendition="#italic">January 19, 1917, 4 p.m</hi></date>.</dateline>
                </opener>
                <p>Based upon stand Chinese Government, that exportation grain products forbidden by
                    treaty, you may take position outlined last paragraph your January 16, 6
                    p.m.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
