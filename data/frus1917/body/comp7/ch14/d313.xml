            <div xml:id="d313">

                <pb facs="0420" n="254" sameAs="frus:frus1917/pg254"/>

                <note rend="inline" type="source">File No. 793.94/564</note>
                <head>
                    <hi rendition="#italic">Chargé Wheeler to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Tokyo</hi></placeName>, <date
                            calendar="gregorian" when="1917-04-04">
                            <hi rendition="#italic">April 4, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith a
                    translation made by this Embassy of the notes exchanged between Japan arid China
                    with regard to the Chengchiatun affair. This translation was made from the
                    Japanese text as given by the Foreign Office to the press.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Post Wheeler</hi>
                    </signed>
                </closer>


                <xi:include href="d313-a1.xml" xpointer="d313-a1"/>
            </div>
