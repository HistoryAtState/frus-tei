            <div xml:id="d241">

                <pb facs="0350" n="184" sameAs="frus:frus1917/pg184"/>

                <note rend="inline" type="source">File No. 893.77/1594</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Minister Reinsch </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-04-07T17:00:00-05:00">
                            <hi rendition="#italic">April 7, 1917, 5 p.m</hi></date>.</dateline>
                </opener>
                <p>Your telegram of April 3, 6 p.m. You are authorized as you request to take the
                    position stated by you.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
