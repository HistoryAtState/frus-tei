            <div xml:id="d192">

                <pb facs="0306" n="140" sameAs="frus:frus1917/pg140"/>

                <note rend="inline" type="source">File No. 893.51/1806</note>
                <head>
                    <hi rendition="#italic">Minister Reinsch to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Peking</hi></placeName>, <date
                            calendar="gregorian" when="1917-09-15T00:00:00+08:00">
                            <hi rendition="#italic">September 15, 1917,
                        midnight</hi></date>.</dateline>
                </opener>
                <p>Your telegram of September 13, 3 p.m. I earnestly request no commitment be given
                    in regard to proposed advance until you shall have considered telegraphic report
                    that I am now preparing.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Reinsch</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
