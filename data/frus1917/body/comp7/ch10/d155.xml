                <pb facs="0282" n="116" sameAs="frus:frus1917/pg116"/>

                <note rend="inline" type="source">File No. 893.51/1726</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Ambassador Guthrie
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Extract]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-01-23T17:00:00-05:00">
                            <hi rendition="#italic">January 23, 1917, 5 p.m</hi></date>.</dateline>
                </opener>
                <p>The following strictly confidential telegram received from Peking January 15 is
                    sent you for your strictly confidential information. [Quotes telegram of January
                    15, 6 p.m., from Minister Reinsch.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
