    <text>
        <body>
            <div xml:id="d207">

                <pb facs="0316" n="150" sameAs="frus:frus1917/pg150"/>

                <note rend="inline" type="source">File No. 893.51/18</note>
                <head>
                    <hi rendition="#italic">Minister Reinsch to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1684</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Peking</hi></placeName>, <date
                            calendar="gregorian" when="1917-10-26">
                            <hi rendition="#italic">October 26, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit for your
                    information copies of an agreement for a loan of 20,000,000 yen made between the
                    Bank of Communications and three Japanese banks, on September 28, 1917.
                    Incidental correspondence concerning this loan has not been communicated to
                    me.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Paul S. Reinsch</hi>
                    </signed>
                </closer>


                <xi:include href="d207-a1.xml" xpointer="d207-a1"/>
            </div>
