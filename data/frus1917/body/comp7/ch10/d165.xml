    <text>
        <body>
            <div xml:id="d165">

                <pb facs="0288" n="122" sameAs="frus:frus1917/pg122"/>

                <note rend="inline" type="source">File No. 893.51/1757</note>
                <head>
                    <hi rendition="#italic">Minister Reinsch to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1383</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Peking</hi></placeName>, <date
                            calendar="gregorian" when="1917-02-13">
                            <hi rendition="#italic">February 13, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit for your
                    information copies of a report submitted to the Cabinet by the managing director
                    of the Bank of Communications, advising the former of the conclusion of the
                    Japanese loan, as published in the <hi rendition="#italic">Peking Gazette</hi>
                    of February 6, 1917. A translation of the loan agreement itself (as corrected
                    herewith by the Chinese Secretariat of the Legation) is included in the
                    report.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Paul S. Reinsch</hi>
                    </signed>
                </closer>



                <xi:include href="d165-a1.xml" xpointer="d165-a1"/>
            </div>
        </body>
    </text>
