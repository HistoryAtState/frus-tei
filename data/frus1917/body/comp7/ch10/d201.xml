    <text>
        <body>
            <div xml:id="d201">

                <pb facs="0312" n="146" sameAs="frus:frus1917/pg146"/>

                <note rend="inline" type="source">File No. 893.51/1830</note>
                <head>
                    <hi rendition="#italic">Minister Reinsch to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1661</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Pelting</hi></placeName>, <date
                            calendar="gregorian" when="1917-10-09">
                            <hi rendition="#italic">October 9, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit for your
                    information copies of the agreement signed August 28, 1917, for an advance of
                    Yen 10,000,000 made by the Yokohama Specie Bank to the Chinese Government.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Paul S. Reinsch</hi>
                    </signed>
                </closer>


                <xi:include href="d201-a1.xml" xpointer="d201-a1"/>
            </div>
