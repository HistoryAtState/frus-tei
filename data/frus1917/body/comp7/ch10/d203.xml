                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Peking</hi></placeName>, <date
                            calendar="gregorian" when="1917-10-12T21:00:00+08:00">
                            <hi rendition="#italic">October 12, 1917, 9 p.m</hi></date>.</dateline>
                </opener>
                <p>My October 11, 1 a.m. Currency loan option has been extended six months.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Reinsch</hi>
                    </signed>
                </closer>
