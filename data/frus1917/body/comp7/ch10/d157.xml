    <text>
        <body>
            <div xml:id="d157">

                <pb facs="0284" n="118" sameAs="frus:frus1917/pg118"/>

                <note rend="inline" type="source">File No. 893.51/1737</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Minister Reinsch
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Extract]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-01-25T16:00:00-05:00">
                            <hi rendition="#italic">January 25, 1917, 4 p.m</hi></date>.</dateline>
                </opener>
                <p>Your telegram of January 23, 1 p.m. Chicago contract grants option on additional
                    loan up to twenty-five millions but option limited to sixty days from date of
                    application for such additional loan.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
