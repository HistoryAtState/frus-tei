    <text>
        <body>
            <div xml:id="d334">

                <pb facs="0436" n="270" sameAs="frus:frus1917/pg270"/>

                <note rend="inline" type="source">File No. 793.94/603</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Japanese Ambassador
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 49</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi>
                        </placeName>
                        <date calendar="gregorian" when="1917-11-16">
                            <hi rendition="#italic">November 16, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: In accordance with your oral
                    request I have the honor to enclose herewith copy of a declaration made by the
                    Chinese <pb facs="0437" n="271" xml:id="pg271"/> Government on November 12,
                    1917, in connection with the recent exchange of notes between the Government of
                    the United States and the Government of Japan.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Frank L. Polk</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
