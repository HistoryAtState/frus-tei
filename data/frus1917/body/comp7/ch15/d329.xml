    <text>
        <body>
            <div xml:id="d329">

                <pb facs="0434" n="268" sameAs="frus:frus1917/pg268"/>

                <note rend="inline" type="source">File No. 793.84/589e</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the British Ambassador
                        </hi><anchor n="65" xml:id="d329-f1"/>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1875</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-11-05">
                            <hi rendition="#italic">November 5, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: I have the honor to enclose
                    herewith for your information copies of notes exchanged on November 2, 1917,
                    between the Governments of the United States and Japan, declaring the policy of
                    the two Governments as regards China.</p>
                <p>By agreement with Viscount Ishii the notes will be made public here on the
                    afternoon of November 6 and in Japan on November 7.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d329-f1" n="65" type="source" xml:id="d329-f1-content">
                <p>
                    <hi rendition="#italic">Mutatis mutandis</hi> to the French, Italian and Russian
                    Ambassadors and the Belgian Minister at Washington.</p>
            </note>
        </listAnnotation>
    </standOff>
