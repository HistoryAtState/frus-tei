    <text>
        <body>
            <div xml:id="d1081">

                <pb facs="1054" n="888" sameAs="frus:frus1917/pg888"/>

                <note rend="inline" type="source">File No. 882.51/742</note>
                <head>
                    <hi rendition="#italic">Minister Curtis to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 89</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Monrovia</hi></placeName>, <date
                            calendar="gregorian" when="1917-03-23">
                            <hi rendition="#italic">March 23, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith a
                    copy of the loan and depositary agreement between the Government of Liberia and
                    the <pb facs="1055" n="889" xml:id="pg889"/> Bank of British West Africa Ltd.,
                    signed February 21, 1917, as a substitute for the agreement heretofore brought
                    to the Department’s attention.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">James L. Curtis</hi>
                    </signed>
                </closer>


                <xi:include href="d1081-a1.xml" xpointer="d1081-a1"/>
            </div>
        </body>
    </text>
