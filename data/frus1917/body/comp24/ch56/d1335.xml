    <text>
        <body>
            <div xml:id="d1335">

                <pb facs="1265" n="1099" sameAs="frus:frus1917/pg1099"/>

                <note rend="inline" type="source">File No. 817.032/24</note>
                <head>
                    <hi rendition="#italic">Minister Jefferson to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 461</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Managua</hi></placeName>, <date
                            calendar="gregorian" when="1917-12-22">
                            <hi rendition="#italic">December 22, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: For the information of the Departments
                    have the honor to enclose herewith copy and translation of President Chamorro’s
                    message to the National Congress, which he read at the convening of the ordinary
                    session on December 15, 1917.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Benjamin L. Jefferson</hi>
                    </signed>
                </closer>


                <xi:include href="d1335-a1.xml" xpointer="d1335-a1"/>
            </div>
        </body>
    </text>
