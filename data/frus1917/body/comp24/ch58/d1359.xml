    <text>
        <body>
            <div xml:id="d1359">

                <pb facs="1287" n="1121" sameAs="frus:frus1917/pg1121"/>

                <note rend="inline" type="source">File No. 817.51/931</note>
                <head>
                    <hi rendition="#italic">Minister Jefferson to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 357</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Managua</hi></placeName>, <date
                            calendar="gregorian" when="1917-03-28">
                            <hi rendition="#italic">March 28, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith for
                    the information of the Department copy and translation of the data requested by
                    the Commission of Public Credit of the holders of claims against the Government
                    of Nicaragua.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Benjamin L. Jefferson</hi>
                    </signed>
                </closer>


                <xi:include href="d1359-a1.xml" xpointer="d1359-a1"/>
            </div>
        </body>
    </text>
