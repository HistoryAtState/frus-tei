    <text>
        <body>
            <div xml:id="d1406">

                <pb facs="1319" n="1153" sameAs="frus:frus1917/pg1153"/>

                <note rend="inline" type="source">File No. 817.51/1065</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            Chargé d’Affaires of Nicaragua
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 56</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-12-18">
                            <hi rendition="#italic">December 18, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the
                    receipt of your note of December 5, stating that, in accordance with Article 1
                    of the contract signed October 1, 1917, you sent on November 30, through the
                    National City Bank of New York, a telegraphic order for one hundred and
                    sixty-eight thousand and eight pounds, four shillings, and seven pence, to be
                    paid to the Corporation of Foreign Bondholders of London, and that the bank has
                    notified you that payment was effected on December 3.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
