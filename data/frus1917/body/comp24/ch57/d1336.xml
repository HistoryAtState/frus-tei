    <text>
        <body>
            <div xml:id="d1336">

                <pb facs="1266" n="1100" sameAs="frus:frus1917/pg1100"/>

                <note rend="inline" type="source">File No. 817.812/307</note>
                <head>
                    <hi rendition="#italic">Minister Jefferson to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 355</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Managua</hi></placeName>, <date
                            calendar="gregorian" when="1917-03-19">
                            <hi rendition="#italic">March 19, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith for
                    the information of the Department copy and translation of the decision of the
                    Central American Court of Justice in the case of the Government of El Salvador
                    against the Government of Nicaragua relative to the concession <pb facs="1267"
                        n="1101" xml:id="pg1101"/> of a naval base in the Gulf of Fonseca by the
                    Nicaraguan Government in the Bryan-Chamorro Treaty.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Benjamin L. Jefferson</hi>
                    </signed>
                </closer>


                <xi:include href="d1336-a1.xml" xpointer="d1336-a1"/>
            </div>
        </body>
    </text>
