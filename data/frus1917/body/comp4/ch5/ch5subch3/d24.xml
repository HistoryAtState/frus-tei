    <text>
        <body>
            <div xml:id="d24">

                <pb facs="0183" n="17" sameAs="frus:frus1917/pg17"/>

                <note rend="inline" type="source">File No. 711.7121/2</note>
                <head>
                    <hi rendition="#italic">Minister Vopicka to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Bucharest</hi></placeName>, <date
                            calendar="gregorian" when="1916-07-25">
                            <hi rendition="#italic">July 25, 1916</hi></date>.</dateline>
                </opener>
                <p>281. Department’s circular April 1. Was assured verbally yesterday at Foreign
                    Office that Seamen’s Act approved and written acceptance would follow
                        shortly.<anchor n="4" xml:id="d24-f1"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Vopicka</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d24-f1" n="4" xml:id="d24-f1-content">
                <p>No further reply seems to have been received from the Roumanian Government.</p>
            </note>
        </listAnnotation>
    </standOff>
