            <div xml:id="d17">

                <pb facs="0176" n="10" sameAs="frus:frus1917/pg10"/>

                <note rend="inline" type="source">File No. 711.6321/86</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to Ambassador Penfield
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-07-24T16:00:00-05:00">
                            <hi rendition="#italic">July 24, 1916, 4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>1305. Your 1339, July 17, 11 a.m. Department not entirely clear respecting
                    meaning Foreign Office note. Mail copy as soon as possible.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Polk</hi>
                    </signed>
                </closer>
            </div>
        </body>
