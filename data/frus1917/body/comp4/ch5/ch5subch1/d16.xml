    <text>
        <body>
            <div xml:id="d16">

                <pb facs="0175" n="9" sameAs="frus:frus1917/pg9"/>

                <note rend="inline" type="source">File No. 711.6321/87</note>
                <head>
                    <hi rendition="#italic">Ambassador Penfield to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1781</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Vienna</hi></placeName>, <date
                            calendar="gregorian" when="1916-07-19">
                            <hi rendition="#italic">July 19, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to the Department’s unnumbered
                    instruction of May 29, 1915, relative to the intention of the United States to
                    abrogate certain sections of the Treaties of May 8, 1848, and July 11, 1870,
                    between the United States and Austria-Hungary, and enclosing copy of the Act of
                    Congress of March 4, 1915 “An Act to Promote the Welfare of American Seamen,”
                    and to my telegram No. 1218 of April 4th last,<anchor n="2" xml:id="d16-f1"/> I
                    have the honor now to transmit herewith a copy and translation of a Note from
                    the Austro-Hungarian Minister for Foreign Affairs on this subject.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Frederic C. Penfield</hi>
                    </signed>
                </closer>



                <xi:include href="d16-a1.xml" xpointer="d16-a1"/>
            </div>
        </body>
    </text>
