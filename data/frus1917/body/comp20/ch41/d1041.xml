    <text>
        <body>
            <div xml:id="d1041">

                <pb facs="1010" n="844" sameAs="frus:frus1917/pg844"/>

                <note rend="inline" type="source">File No. 123G98/32</note>
                <head>
                    <hi rendition="#italic">The Japanese Ambassador to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Imperial Japanese Embassy</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-03-10">
                            <hi rendition="#italic">March 10, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: In pursuance of telegraphic instructions
                    from the Imperial Government I have the honor to express on their behalf the
                    most sincere condolence and sympathy to the United States Government for the
                    lamentable death of his excellency Ambassador George W. Guthrie at Tokyo.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Atmaro Sato</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
