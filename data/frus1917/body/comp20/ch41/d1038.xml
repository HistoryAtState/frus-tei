    <text>
        <body>
            <div xml:id="d1038">

                <pb facs="1009" n="843" sameAs="frus:frus1917/pg843"/>

                <note rend="inline" type="source">File No. 123G98/28</note>
                <head>
                    <hi rendition="#italic">Chargé Wheeler to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegrams]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Tokyo</hi></placeName>, <date
                            calendar="gregorian" when="1917-03-08T21:00:00+09:00">
                            <hi rendition="#italic">March 8, 1917, 9 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>It is my painful duty to inform you that the Ambassador died suddenly at 8
                    tonight of apoplexy. In accordance with instructions to diplomatic officers, I
                    have assumed charge as Chargé d’Affaires <hi rendition="#italic">ad
                        interim.</hi>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wheeler</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
