    <text>
        <body>
            <div xml:id="d688">

                <pb facs="0667" n="501" sameAs="frus:frus1917/pg501"/>

                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Minister Swenson
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1901-12-17">
                            <hi rendition="#italic">December 17, 1901</hi></date>.</dateline>
                </opener>
                <p>Please remind Minister of Foreign Affairs that the Senate adjourns for the
                    holidays on Thursday and that it would be quite desirable to have the treaty
                    signed before that day if possible.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hay</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
