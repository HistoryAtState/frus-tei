    <text>
        <body>
            <div xml:id="d728">

                <pb facs="0705" n="539" xml:id="pg539"/>

                <head>
                    <hi rendition="#italic">The Secretary of State to the Danish Minister </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1902-06-03">
                            <hi rendition="#italic">June 3, 1902</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Brun</hi>: I enclose a memorandum as to the
                    matter we conversed about some days ago.</p>
                <p>Yours faithfully,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">John Hay</hi>
                    </signed>
                </closer>


                <xi:include href="d728-a1.xml" xpointer="d728-a1"/>
