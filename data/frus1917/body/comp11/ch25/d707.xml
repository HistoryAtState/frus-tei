    <text>
        <body>
            <div xml:id="d707">

                <pb facs="0683" n="517" sameAs="frus:frus1917/pg517"/>

                <head>
                    <hi rendition="#italic">Minister Swenson to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 243</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Copenhagen</hi></placeName>, <date
                            calendar="gregorian" when="1902-01-31">
                            <hi rendition="#italic">January 31, 1902</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith a
                    copy, together with a translation, of a note from the Minister for Foreign
                    Affairs, dated <pb facs="0684" n="518" xml:id="pg518"/> the 24th instant, in
                    reply to one which I addressed to his excellency, under date of December 16th
                    last, relative to the termination of the negotiations and the signature of the
                    treaty for the cession of the Danish West Indies to the United States.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Laurits S. Swenson</hi>
                    </signed>
                </closer>


                <xi:include href="d707-a1.xml" xpointer="d707-a1"/>
            </div>
        </body>
    </text>
