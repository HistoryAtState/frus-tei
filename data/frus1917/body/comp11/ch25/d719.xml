    <text>
        <body>
            <div xml:id="d719">

                <pb facs="0694" n="528" sameAs="frus:frus1917/pg528"/>

                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Minister Swenson
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1902-05-03">
                            <hi rendition="#italic">May 3, 1902</hi></date>.</dateline>
                </opener>
                <p>Have informed Danish Minister here that this Government agrees with the Danish
                    Government in its interpretation of the treaty as set forth in Mr. Brun’s note
                    of April 18th.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hay</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
