    <text>
        <body>
            <div xml:id="d695">

                <pb facs="0672" n="506" sameAs="frus:frus1917/pg506"/>

                <head>
                    <hi rendition="#italic">Minister Swenson to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Copenhagen</hi></placeName>, <date
                            calendar="gregorian" when="1902-01-02">
                            <hi rendition="#italic">January 2, 1902</hi></date>.</dateline>
                </opener>
                <p>Hold Minister for Foreign Affairs agreement sign the treaty with this
                    understanding: that no plebiscite will be ordered for any purpose.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Swenson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
