                <note rend="inline" type="source">File No. 711.5914/54</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Minister Egan
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-04-24T14:00:00-05:00">
                            <hi rendition="#italic">April 24, 1916, 2 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>99. Your 238, April 23, 11 a.m. Please cable complete Danish <hi
                        rendition="#italic">contre</hi> proposition.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
