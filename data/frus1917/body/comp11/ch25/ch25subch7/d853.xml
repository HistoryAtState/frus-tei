    <text>
        <body>
            <div xml:id="d853">

                <pb facs="0844" n="678" sameAs="frus:frus1917/pg678"/>

                <note rend="inline" type="source">File No. 711. 5914/162</note>
                <head>
                    <hi rendition="#italic">Minister Egan to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 959</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Copenhagen</hi></placeName>, <date
                            calendar="gregorian" when="1916-09-27">
                            <hi rendition="#italic">September 27, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to the Legation’s telegram
                    No. 352 of September 26, 1916, I have the honor to transmit a memorandum,
                    carefully made by the Minister of Finance, concerning the privileges of the West
                    India Company at St. Thomas. Attached to this I likewise enclose copies of the
                    pamphlets containing passages mentioned in the memorandum. The memorandum,
                    translated by us, was sent to the Department yesterday by cable.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Maurice Francis Egan</hi>
                    </signed>
                </closer>




                <xi:include href="d853-a1.xml" xpointer="d853-a1"/>
