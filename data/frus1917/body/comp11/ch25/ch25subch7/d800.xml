    <text>
        <body>
            <div xml:id="d800">

                <pb facs="0793" n="627" sameAs="frus:frus1917/pg627"/>

                <note rend="inline" type="source">File No. 711.5914/70</note>
                <head>
                    <hi rendition="#italic">Minister Egan to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 937</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Copenhagen</hi></placeName>, <date
                            calendar="gregorian" when="1916-07-04">
                            <hi rendition="#italic">July 4, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to the request made in the
                    Department’s telegraphic instruction No. 110 of June 9, 12 noon, for copies of
                    the concessions granted in the Danish West Indies, I have the honor to state
                    that the enclosed copies were forwarded to me by the Foreign Office at the same
                    time as the written result of the conversation, which I cabled to you in two
                    sections on June 29, 1916, as telegram No. 267.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Maurice Francis Egan</hi>
                    </signed>
                </closer>







