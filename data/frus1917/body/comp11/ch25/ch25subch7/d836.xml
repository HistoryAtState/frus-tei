        <body>
            <div xml:id="d836">

                <pb facs="0833" n="667" sameAs="frus:frus1917/pg667"/>

                <note rend="inline" type="source">File No. 711.5914/122</note>
                <head>
                    <hi rendition="#italic">Consul Payne to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">St. Thomas</hi></placeName>, <date
                            calendar="gregorian" when="1916-08-25">
                            <hi rendition="#italic">August 25, 1916</hi></date>.</dateline>
                </opener>
                <p>By unanimous order local Colonial Council Governor today cabling Copenhagen
                    petitioning immediate sale islands.</p>
                <closer>
                    <hi rendition="#small-caps">American Consul</hi>
                </closer>
            </div>
        </body>
