    <text>
        <body>
            <div xml:id="d845">

                <pb facs="0840" n="674" sameAs="frus:frus1917/pg674"/>

                <note rend="inline" type="source">File No. 711.5914/140</note>
                <head>
                    <hi rendition="#italic">The Danish Minister to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Danish Legation</hi>, <lb/>
                            <hi rendition="#italic">Bar Harbor</hi></placeName>, <date
                            calendar="gregorian" when="1916-09-08">
                            <hi rendition="#italic">September 8, 1916</hi></date>.</dateline>
                </opener>
                <p>Your telegram to-day. Accept my warmest congratulations upon the successful
                    passage of our West India Treaty by the Senate of the United States.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Brun</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
