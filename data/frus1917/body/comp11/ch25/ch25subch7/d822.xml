    <text>
        <body>
            <div xml:id="d822">

                <pb facs="0822" n="656" xml:id="pg656"/>

                <note rend="inline" type="source">File No. 711.5914/137</note>
                <head>
                    <hi rendition="#italic">Minister Egan to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 946</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Copenhagen</hi></placeName>, <date
                            calendar="gregorian" when="1916-08-17">
                            <hi rendition="#italic">August 17, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to the Legation’s despatch No.
                    943 of August 9, 1916, I have the honor to enclose a copy and translation of the
                    ordinance of April 1, 1913, the substance of which was telegraphed the
                    Department in my despatch No. 306 of August 16, 1 p.m.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Maurice Francis Egan</hi>
                    </signed>
                </closer>


                <xi:include href="d822-a1.xml" xpointer="d822-a1"/>
            </div>
