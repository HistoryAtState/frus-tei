                <pb facs="0783" n="617" xml:id="pg617"/>

                <note rend="inline" type="source">File No. 711.5914/54</note>
                <head>
                    <hi rendition="#italic">Minister Egan to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Copenhagen</hi></placeName>, <date
                            calendar="gregorian" when="1916-04-23T11:00:00+01:00">
                            <hi rendition="#italic">April 23, 1916, 11 a.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>238. Danish <hi rendition="#italic">contre projet</hi> on subject of islands
                    received. Shall I cable synopsis?</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Egan</hi>
                    </signed>
                </closer>
            </div>
        </body>
