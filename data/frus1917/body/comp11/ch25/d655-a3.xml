                <pb facs="0628" n="462" sameAs="frus:frus1917/pg462"/>

                <opener>
                    <seg rendition="#center">[Inclosure 3]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">Captain von Christmas to Secretary of Embassy White
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Translation]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <date calendar="gregorian" when="1899-12-14">
                            <hi rendition="#italic">December 14, 1899</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Henry White</hi>, Esq. Prime Minister delighted to
                    receive you. When do you arrive?</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Christmas</hi>
                    </signed>
                </closer>
            </div>
        </body>
