    <text>
        <body>
            <div xml:id="d660">

                <pb facs="0635" n="469" sameAs="frus:frus1917/pg469"/>

                <head>
                    <hi rendition="#italic">Minister Swenson to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 151</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Copenhagen</hi></placeName>, <date
                            calendar="gregorian" when="1900-02-28">
                            <hi rendition="#italic">February 28, 1900</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith for
                    your information a copy, together with a translation, of a note from the
                    Minister of Foreign Affairs in reply to my communication of the 20th instant, a
                    copy of which I forwarded to you in my No. 150, of the 22d instant.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Laurits S. Swenson</hi>
                    </signed>
                </closer>


                <xi:include href="d660-a1.xml" xpointer="d660-a1"/>
            </div>
        </body>
    </text>
