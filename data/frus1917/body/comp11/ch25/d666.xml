    <text>
        <body>
            <div xml:id="d666">

                <pb facs="0644" n="478" sameAs="frus:frus1917/pg478"/>

                <head>
                    <hi rendition="#italic">Minister Swenson to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Copenhagen</hi></placeName>, <date
                            calendar="gregorian" when="1900-11-27">
                            <hi rendition="#italic">November 27, 1900</hi></date>.</dateline>
                </opener>
                <p>Article III, amended convention, is worded identically as heretofore. Your
                    despatch names three millions, the convention three millions and a quarter.
                    Cable corrections.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Swenson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
