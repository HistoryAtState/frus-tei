            <div xml:id="d761">

                <pb facs="0731" n="565" sameAs="frus:frus1917/pg565"/>

                <note rend="inline" type="source">File No. 711.5914/11</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Minister Egan
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 111</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1911-01-25">
                            <hi rendition="#italic">January 25, 1911</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The Department has received your No. 367
                    of the 6th ultimo in which you report that the tendency towards the sale of the
                    Danish West Indies is growing in Copenhagen.</p>
                <p>The Department desires that you keep it fully informed with regard to this
                    matter.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">P. C. Knox</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
