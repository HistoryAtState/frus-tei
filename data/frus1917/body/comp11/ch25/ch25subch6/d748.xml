    <text>
        <body>
            <div xml:id="d748">

                <pb facs="0716" n="550" sameAs="frus:frus1917/pg550"/>

                <head>
                    <hi rendition="#italic">Minister O’Brien to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 34</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Copenhagen</hi></placeName>, <date
                            calendar="gregorian" when="1905-10-23">
                            <hi rendition="#italic">October 23, 1905</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I beg to inclose herewith a translation of
                    an article appearing in the <hi rendition="#italic">Hamburger Nachrichten</hi>
                    of the 18th instant. I understand it to be a letter from New York.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">S. J. O’Brien</hi>
                    </signed>
                </closer>


                <xi:include href="d748-a1.xml" xpointer="d748-a1"/>
            </div>
        </body>
    </text>
