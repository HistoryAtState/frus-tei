    <text>
        <body>
            <div xml:id="d767">

                <pb facs="0746" n="580" sameAs="frus:frus1917/pg580"/>

                <note rend="inline" type="source">File No. 711.5914/23</note>
                <head>
                    <hi rendition="#italic">Minister Egan to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 694</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Copenhagen</hi></placeName>, <date
                            calendar="gregorian" when="1913-05-27">
                            <hi rendition="#italic">May 27, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: By way of supplement to the report made on
                    the Danish West Indies, I beg leave to enclose a copy of a translation of an
                    article written by a former Governor of the Danish Antilles, Mr. F. P.
                    Hiort-Lorenzen.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Maurice Francis Egan</hi>
                    </signed>
                </closer>



                <xi:include href="d767-a1.xml" xpointer="d767-a1"/>
            </div>
        </body>
    </text>
