    <text>
        <body>
            <div xml:id="d677">

                <pb facs="0659" n="493" sameAs="frus:frus1917/pg493"/>

                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to Minister Swenson
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 128</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1901-09-10">
                            <hi rendition="#italic">September 10, 1901</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to your despatch No. 212, dated
                    Norseland, Minnesota, August 8, 1901, communicating copy of the note of the
                    Danish Minister for Foreign Affairs of the 29th of June, relative to the
                    proposed cession of the Danish West Indies, I have to enclose herewith copy of a
                    new draft of the treaty with Denmark embodying all the accepted suggestions of
                    the Danish Government.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Alvey A. Adee</hi>
                    </signed>
                </closer>


                <xi:include href="d677-a1.xml" xpointer="d677-a1"/>
            </div>
        </body>
    </text>
