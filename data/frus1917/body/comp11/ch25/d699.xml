    <text>
        <body>
            <div xml:id="d699">

                <pb facs="0676" n="510" sameAs="frus:frus1917/pg510"/>

                <head>
                    <hi rendition="#italic">Minister Swenson to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Copenhagen</hi></placeName>, <date
                            calendar="gregorian" when="1902-01-15">
                            <hi rendition="#italic">January 15, 1902</hi></date>.</dateline>
                </opener>
                <p>Brun advises Minister for Foreign Affairs by cable order plebiscite before
                    signing the treaty. Press for immediate signature protesting against such delay
                    and plebiscite as contrary to agreement.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Swenson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
