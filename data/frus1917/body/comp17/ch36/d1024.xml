    <text>
        <body>
            <div xml:id="d1024">

                <pb facs="0999" n="833" sameAs="frus:frus1917/pg833"/>

                <note rend="inline" type="source">File No. 838.77/176</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Minister Blanchard </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-12-04T16:00:00-05:00">
                            <hi rendition="#italic">December 4, 1917, 4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your November 20, noon. Your despatch April 30, No. 136, enclosure 1. Again
                    present matter of signature and delivery of bonds, to the end that this be
                    accomplished without further delay.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
