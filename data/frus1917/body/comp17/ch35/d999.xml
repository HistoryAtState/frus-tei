    <text>
        <body>
            <div xml:id="d999">

                <pb facs="0974" n="808" sameAs="frus:frus1917/pg808"/>

                <note rend="inline" type="source">File No. 711.38/120</note>
                <head>
                    <hi rendition="#italic">Minister Blanchard to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 135</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Port au Prince</hi></placeName>, <date
                            calendar="gregorian" when="1917-03-29">
                            <hi rendition="#italic">March 29, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to my March 28, 6 p.m., I have
                    the honor to forward herewith the original and copy of the Protocol, signed
                        yesterday,<anchor n="3" xml:id="d999-f1"/> calling into being full force
                    Article XVI of the Convention of September 16, 1915.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">A. Bailly-Blanchard</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
