                <note rend="inline" type="source">File No. 838.51/603</note>
                <head>
                    <hi rendition="#italic">Minister Blanchard to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Port au Prince</hi></placeName>, <date
                            calendar="gregorian" when="1917-03-28T18:00:00-05:00">
                            <hi rendition="#italic">March 28, 1917, 6 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your March 22, 5 p.m. Protocol as amended just signed.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Blanchard</hi>
                    </signed>
                </closer>
