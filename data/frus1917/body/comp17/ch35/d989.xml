    <text>
        <body>
            <div xml:id="d989">

                <pb facs="0968" n="802" sameAs="frus:frus1917/pg802"/>

                <note rend="inline" type="source">File No. 838.51/580</note>
                <head>
                    <hi rendition="#italic">The Haitian Minister to the Division of Latin American
                        Affairs </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Translation]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Haitian Legation</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-01-11">
                            <hi rendition="#italic">January 11, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Stabler</hi>: I take great pleasure in
                    handing you herewith a memorandum about an order issued as far back as February
                    1916 by Admiral Caper ton on the subject of attachments affecting officials of
                    the Republic of Haiti.</p>
                <pb facs="0969" n="803" xml:id="pg803"/>
                <p>I should be thankful if you would as far as possible expedite the settlement of
                    this question.</p>
                <p>Be pleased to accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Solon Ménos</hi>
                    </signed>
                </closer>


                <xi:include href="d989-a1.xml" xpointer="d989-a1"/>
            </div>
        </body>
    </text>
