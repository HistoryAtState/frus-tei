    <text>
        <body>
            <div xml:id="d969">

                <pb facs="0951" n="785" sameAs="frus:frus1917/pg785"/>

                <note rend="inline" type="source">File No. 714.1515/54</note>
                <head>
                    <hi rendition="#italic">Minister Ewing to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Extract]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 364</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Tegucigalpa</hi></placeName>, <date
                            calendar="gregorian" when="1917-12-10">
                            <hi rendition="#italic">December 10, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to comply with the
                    Department’s cabled instruction of December 8, 5 p.m.,<anchor n="1"
                        xml:id="d969-f1"/> to forward by pouch a copy, with translation, of the
                    boundary convention between Guatemala and Honduras signed August 1, 1914, by
                    both countries. * * *</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Jno. Ewing</hi>
                    </signed>
                </closer>



                <xi:include href="d969-a1.xml" xpointer="d969-a1"/>
            </div>
        </body>
    </text>
    <standOff>
