    <text>
        <body>
            <div xml:id="d951">

                <pb facs="0931" n="765" sameAs="frus:frus1917/pg765"/>

                <note rend="inline" type="source">File No. 714.1515/11</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister of Guatemala
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 65</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-03-06">
                            <hi rendition="#italic">March 6, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the
                    receipt of your notes dated February 21, and 24, 1917, in which you state that
                    you have received information from the Government of Guatemala to the effect
                    that Guatemalan territory has been invaded by an armed force from Honduras.</p>
                <p>In reply I desire to inform you that this matter has been called to the attention
                    of the diplomatic representative of the United States in Honduras, with the
                    request that he report in full in regard to the situation.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
