    <text>
        <body>
            <div xml:id="d965">

                <pb facs="0948" n="782" xml:id="pg782"/>

                <note rend="inline" type="source">File No. 714.1515/40</note>
                <head>
                    <hi rendition="#italic">Minister Ewing to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Extract]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 549</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Tegucigalpa</hi></placeName>, <date
                            calendar="gregorian" when="1917-11-16">
                            <hi rendition="#italic">November 16, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I submit herewith for the Department’s
                    consideration copies and translations of the recent correspondence with the
                    Honduran Foreign Office.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Jno. Ewing</hi>
                    </signed>
                </closer>




