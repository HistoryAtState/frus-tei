    <text>
        <body>
            <div xml:id="d929">

                <pb facs="0920" n="754" sameAs="frus:frus1917/pg754"/>

                <note rend="inline" type="source">File No. 814.48/7</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Chargé Thurston
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-12-27T18:00:00-05:00">
                            <hi rendition="#italic">December 27, 1917, 6 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your December 26, 6 a.m. and December 26, 1 p.m. Present condolences of the
                    Government of the United States, informing <pb facs="0921" n="755"
                        xml:id="pg755"/> President Cabrera that this Government desires to be of any
                    possible assistance to her sister Republic of Guatemala.</p>
                <p>Report to Department what supplies are needed from American Red Cross.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
