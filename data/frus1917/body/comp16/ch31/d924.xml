    <text>
        <body>
            <div xml:id="d924">

                <pb facs="0917" n="751" sameAs="frus:frus1917/pg751"/>

                <note rend="inline" type="source">File No. 814.032/7</note>
                <head>
                    <hi rendition="#italic">Minister Leavell to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 364</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Guatemala</hi></placeName>, <date
                            calendar="gregorian" when="1917-03-06">
                            <hi rendition="#italic">March 6, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith two
                    copies of the Annual Message presented by His Excellency President Manuel
                    Estrada Cabrera to the Congress of Guatemala at its opening session on the first
                    day of March. I also beg leave to transmit translations of such portions of the
                    message as relate to the United States.</p>
                <p>I have [etc]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wm. Hayne Leavell</hi>
                    </signed>
                </closer>


                <xi:include href="d924-a1.xml" xpointer="d924-a1"/>
            </div>
        </body>
    </text>
