    <text>
        <body>
            <div xml:id="d1446">

                <pb facs="1369" n="1203" sameAs="frus:frus1917/pg1203"/>

                <note rend="inline" type="source">File No. 819.154/26</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Minister of Panama
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 33</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-08-03">
                            <hi rendition="#italic">August 3, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the
                    receipt of your note of the 27th ultimo<anchor n="2" xml:id="d1446-f1"/> in
                    which, under the instruction of your Government, you ask when the work on the
                    road system of Panama is to be commenced.</p>
                <p>In reply I have the honor to say that the subject of your note is receiving
                    consideration.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Frank L. Polk</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
