    <text>
        <body>
            <div xml:id="d1322-a1">

                <pb facs="1257" n="1091" xml:id="pg1091"/>

                <opener>
                    <seg rendition="#center">[Inclosure 1 – Telegram]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">The Adjutant General to
                        General Pershing
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-04-26">
                            <hi rendition="#italic">April 26, 1917</hi></date>.</dateline>
                </opener>
                <p>6586. Reference telegram from this office No. 6449 dated April 14 relative
                    Chinese refugees Columbus no answer received as yet. Wire reply.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">McCain</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
