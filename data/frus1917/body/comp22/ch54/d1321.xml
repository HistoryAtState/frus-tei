    <text>
        <body>
            <div xml:id="d1321">

                <pb facs="1256" n="1090" sameAs="frus:frus1917/pg1090"/>

                <note rend="inline" type="source">File No. 704.9312/13</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Consul Silliman </hi><anchor
                        n="23" xml:id="d1321-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-03-23">
                            <hi rendition="#italic">March 23, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: In response to a request from the Chinese
                    Minister at Washington, you are instructed, when it may seem necessary to do so,
                    to render such informal good offices as may be possible and as you are permitted
                    to exercise by the local authorities to Chinese citizens resident in Mexico.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Wilbur J. Carr</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1321-f1" n="23" type="source" xml:id="d1321-f1-content">
                <p>The same to other Consular Officers in Mexico.</p>
            </note>
        </listAnnotation>
    </standOff>
