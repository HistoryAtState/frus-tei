    <text>
        <body>
            <div xml:id="d1151">

                <pb facs="1169" n="1003" xml:id="pg1003"/>

                <note rend="inline" type="source">File No. 812.51/262</note>
                <head>
                    <hi rendition="#italic">Mr. Parker,
                        representing American interests, to the Secretary of
                            State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Mexico City</hi></placeName>, <date
                            calendar="gregorian" when="1916-10-11T18:00:00-06:36">
                            <hi rendition="#italic">October 11, 1916—6 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>475. Reliable information indicates that another decree is in preparation to
                    supplant the Law of Payments decreed by Carranza on September 15.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Parker</hi>
                    </signed>
                </closer>
            </div>
        </body>
