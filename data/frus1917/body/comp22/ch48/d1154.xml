    <text>
        <body>
            <div xml:id="d1154">

                <pb facs="1170" n="1004" sameAs="frus:frus1917/pg1004"/>

                <note rend="inline" type="source">File No. 812.51/271</note>
                <head>
                    <hi rendition="#italic">Mr. Thurston, in charge
                        of American interests, to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 627</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Mexico City</hi></placeName>, <date
                            calendar="gregorian" when="1916-12-18">
                            <hi rendition="#italic">December 18, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit, herewith, a
                    translation of the decree mentioned in my telegram of December 16, 4
                        p.m.,<anchor n="2" xml:id="d1154-f1"/> relative to the Law of Payments and
                    subsequent amendments thereto.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Walter C. Thurston</hi>
                    </signed>
                </closer>



                <xi:include href="d1154-a1.xml" xpointer="d1154-a1"/>
                <xi:include href="d1154-a2.xml" xpointer="d1154-a2"/>
            </div>
        </body>
    </text>
