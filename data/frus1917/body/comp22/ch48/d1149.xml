    <text>
        <body>
            <div xml:id="d1149">

                <pb facs="1164" n="998" sameAs="frus:frus1917/pg998"/>

                <note rend="inline" type="source">File No. 812.51/258</note>
                <head>
                    <hi rendition="#italic">Mr. Parker,
                        representing American interests, to the Secretary of
                            State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 522</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Mexico City</hi></placeName>, <date
                            calendar="gregorian" when="1916-09-20">
                            <hi rendition="#italic">September 20, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: For the information of the Department I
                    have the honor to enclose herewith, in triplicate, a copy of the Decree of
                    General Carranza, dated September 15, 1916, relative to the “Law of Payments”,
                    together with a translation of same.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Charles B. Parker</hi>
                    </signed>
                </closer>


                <xi:include href="d1149-a1.xml" xpointer="d1149-a1"/>
            </div>
        </body>
    </text>
