    <text>
        <body>
            <div xml:id="d1126">

                <pb facs="1109" n="943" xml:id="pg943"/>

                <note rend="inline" type="source">File No. 812.001C23/l</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Ambassador Fletcher
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No 285</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-08-31">
                            <hi rendition="#italic">August 31, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I transmit enclosed, with office copy, the
                    President’s acknowledgment of the letter whereby President Carranza announced
                    his assumption of the office of President of the United Mexican States.</p>
                <p>You will forward the office copy to the Minister for Foreign Affairs, and deliver
                    the original letter in the manner most agreeable to President Carranza.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>


                <xi:include href="d1126-a1.xml" xpointer="d1126-a1"/>
            </div>
        </body>
    </text>
