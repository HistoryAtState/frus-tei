                <note rend="inline" type="source">File No. 812.00/20846</note>
                <head>
                    <hi rendition="#italic">Ambassador Fletcher to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Mexico City</hi></placeName>, <date
                            calendar="gregorian" when="1917-04-27T11:00:00-06:36">
                            <hi rendition="#italic">April 27, 1917, 11 a.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Election of Carranza declared official yesterday.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Fletcher</hi>
                    </signed>
                </closer>
            </div>
