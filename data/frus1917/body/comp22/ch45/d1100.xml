    <text>
        <body>
            <div xml:id="d1100">

                <pb facs="1073" n="907" sameAs="frus:frus1917/pg907"/>

                <note rend="inline" type="source">File No. 812.00/20461</note>
                <head>
                    <hi rendition="#italic">The Secretary of War to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">War Department</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-01-30">
                            <hi rendition="#italic">January 30, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I have the honor to
                    enclose herewith copy of telegram No. 4420, from General Funston, reporting the
                    movement of General Pershing’s command to the border.</p>
                <p>Very sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Newton D. Baker</hi>
                    </signed>
                </closer>


                <xi:include href="d1100-a1.xml" xpointer="d1100-a1"/>
