    <text>
        <body>
            <div xml:id="d1096">

                <pb facs="1071" n="905" sameAs="frus:frus1917/pg905"/>

                <note rend="inline" type="source">File No. 812.00/20236</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Mr. De Negri </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-01-09">
                            <hi rendition="#italic">January 9, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. De Negri</hi>: I am in receipt of your
                    communication of January 8, stating that the forces of the Pershing expedition
                    have occupied certain offices at Palomas, State of Chihuahua.</p>
                <p>In reply I have to inform you that I have sent a copy of your communication to
                    the Secretary of War for such action as he may direct. Upon receipt of a reply
                    from the Secretary of War you will be advised.</p>
                <p>Very sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
