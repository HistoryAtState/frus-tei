    <text>
        <body>
            <div xml:id="d1102">

                <pb facs="1074" n="908" sameAs="frus:frus1917/pg908"/>

                <note rend="inline" type="source">File No. 812.00/20473</note>
                <head>
                    <hi rendition="#italic">The Secretary of War to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">War Department</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-02-02">
                            <hi rendition="#italic">February 2, 1917</hi></date>.</dateline>
                </opener>
                <p>The Secretary of War presents his compliments to the Honorable the Secretary of
                    State and has the honor to inclose herewith, for his information, copy of
                    telegram received from the commanding general, Southern Department, Fort Sam
                    Houston, Texas, dated February 2, 1917, quoting a telegram from General Pershing
                    with reference to the movement out of Mexico.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Newton D. Baker</hi>
                    </signed>
                </closer>


                <xi:include href="d1102-a1.xml" xpointer="d1102-a1"/>
