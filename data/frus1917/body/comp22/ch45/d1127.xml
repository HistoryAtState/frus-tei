    <text>
        <body>
            <div xml:id="d1127">

                <pb facs="1109" n="943" sameAs="frus:frus1917/pg943"/>

                <note rend="inline" type="source">File No. 812.001 C23/7</note>
                <head>
                    <hi rendition="#italic">Ambassador Fletcher to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 510</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1917-09-26">
                            <hi rendition="#italic">September 26, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to report that, in
                    compliance with the Department’s instruction number 285 of August 31, 1917, I
                    have to-day placed in the hands of President Carranza, President Wilson’s
                    acknowledgment of the letter whereby President Carranza announced his assumption
                    of the office of President of the United Mexican States.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Henry P. Fletcher</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
