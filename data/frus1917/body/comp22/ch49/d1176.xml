    <text>
        <body>
            <div xml:id="d1176">

                <pb facs="1185" n="1019" xml:id="pg1019"/>

                <note rend="inline" type="source">File No. 312.11/8327</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Consul Dickinson </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-01-02T17:00:00-05:00">
                            <hi rendition="#italic">January 2, 1917, 5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Advise Americans in Durango district to withdraw from Mexico, Department does not
                    feel at liberty to extend this advice to foreigners mentioned in your December
                    29, 11 p.m.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
