    <text>
        <body>
            <div xml:id="d1173">

                <pb facs="1183" n="1017" sameAs="frus:frus1917/pg1017"/>

                <note rend="inline" type="source">File No. 312.11/8343</note>
                <head>
                    <hi rendition="#italic">Mr. Parker,
                        representing American interests, to the Secretary of
                            State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 642</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Mexico City</hi></placeName>, <date
                            calendar="gregorian" when="1916-12-27">
                            <hi rendition="#italic">December 27, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to refer to the
                    Department’s telegraphic instruction 550, of November 14, 1916,<anchor n="6"
                        xml:id="d1173-f1"/> relative to the protection of American property in the
                    Yaqui Valley of the State of Sonora, and to enclose herewith a copy of my note
                    to the Foreign Office, dated November 15 [10], and translations of the two notes
                    which I have received from the Foreign Office in the matter, dated respectively
                    December 8 and 13.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Charles B. Parker</hi>
                    </signed>
                </closer>





                <xi:include href="d1173-a1.xml" xpointer="d1173-a1"/>
                <xi:include href="d1173-a2.xml" xpointer="d1173-a2"/>
