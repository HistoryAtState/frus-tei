        <body>
            <div xml:id="d1197">

                <pb facs="1195" n="1029" sameAs="frus:frus1917/pg1029"/>

                <note rend="inline" type="source">File No. 812.504/133</note>
                <head>
                    <hi rendition="#italic">Ambassador Fletcher to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 402</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Mexico City</hi></placeName>, <date
                            calendar="gregorian" when="1917-08-15">
                            <hi rendition="#italic">August 15, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to the labor situation at
                    Tampico, and the general strike which was declared on July 23, 1917, I have the
                    honor to enclose herewith a copy and translation of note No. 353 dated August 6,
                    1917 from the Foreign Office regarding the strike.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Henry P. Fletcher</hi>
                    </signed>
                </closer>


                <xi:include href="d1197-a1.xml" xpointer="d1197-a1"/>
            </div>
        </body>
    </text>
