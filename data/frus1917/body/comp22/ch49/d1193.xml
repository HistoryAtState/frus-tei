        <body>
            <div xml:id="d1193">

                <pb facs="1194" n="1028" sameAs="frus:frus1917/pg1028"/>

                <note rend="inline" type="source">File No. 312.11/8471</note>
                <head>
                    <hi rendition="#italic">Chargé Summerlin to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 313</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Mexico City</hi></placeName>, <date
                            calendar="gregorian" when="1917-07-09">
                            <hi rendition="#italic">July 9, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring further to the Department’s
                    telegram No. 217, May 31, 7 p.m., and to the Embassy’s despatch No. 221, June
                    11, 1917, regarding the reported raiding of American property in the Yaqui
                    Valley, I have the honor to attach a translation of a note from the Foreign
                    Office, dated June 27, relative to the matter.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">George T. Summerlin</hi>
                    </signed>
                </closer>


                <xi:include href="d1193-a1.xml" xpointer="d1193-a1"/>
            </div>
