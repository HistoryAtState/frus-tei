                <note rend="inline" type="source">File No. 312.11/8327</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Consul Dickinson
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-12-29T15:00:00-05:00">
                            <hi rendition="#italic">December 29, 1916, 3 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Telegraph whereabouts Vice Consul O’Hea, and party of foreigners.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
