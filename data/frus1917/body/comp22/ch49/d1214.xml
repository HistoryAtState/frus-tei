            <div xml:id="d1214">

                <pb facs="1203" n="1037" sameAs="frus:frus1917/pg1037"/>

                <note rend="inline" type="source">File No. 312.11/8514</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Consul Simpich
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-12-19T16:00:00-05:00">
                            <hi rendition="#italic">December 19, 1917, 4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your December 14, 8 p.m. Department telegraphing Embassy urgently to renew
                    request for prompt and adequate protection of American settlers.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
