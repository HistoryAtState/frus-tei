                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Consul Simpich
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegrams]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-12-08T16:00:00-05:00">
                            <hi rendition="#italic">December 8, 1917, 4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Send detailed report on Yaqui situation Sonora.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
