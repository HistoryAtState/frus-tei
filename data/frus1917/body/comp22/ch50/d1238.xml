    <text>
        <body>
            <div xml:id="d1238">

                <pb facs="1212" n="1046" sameAs="frus:frus1917/pg1046"/>

                <note rend="inline" type="source">File No. 812.63/380</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Ambassador Fletcher
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-02-28T16:00:00-05:00">
                            <hi rendition="#italic">February 28, 1917, 4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>16. Department views with satisfaction assurances given by Minister for Foreign
                    Affairs that it is not the intention to confiscate American properties under
                    decrees requiring resumption of work in mines.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
