    <text>
        <body>
            <div xml:id="d1227">

                <pb facs="1207" n="1041" sameAs="frus:frus1917/pg1041"/>

                <note rend="inline" type="source">File No. 812.63/360</note>
                <head>
                    <hi rendition="#italic">Mr. Parker,
                        representing American interests, to the Secretary of
                            State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Mexico City</hi></placeName>, <date
                            calendar="gregorian" when="1917-02-10T12:00:00-06:36">
                            <hi rendition="#italic">February 10, 1917, 12
                        noon</hi></date>.</dateline>
                </opener>
                <p>674. Department’s 657, February 8, four p.m. Am working on matter but see no
                    prospect of withdrawal or extension.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Parker</hi>
                    </signed>
                </closer>
            </div>
        </body>
