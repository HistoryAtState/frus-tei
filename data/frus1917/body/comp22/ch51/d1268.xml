    <text>
        <body>
            <div xml:id="d1268">

                <pb facs="1231" n="1065" sameAs="frus:frus1917/pg1065"/>

                <note rend="inline" type="source">File No. 812.6363/275</note>
                <head>
                    <hi rendition="#italic">Ambassador Fletcher to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 81</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Mexico City</hi></placeName>, <date
                            calendar="gregorian" when="1917-04-19">
                            <hi rendition="#italic">April 19, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Supplementing my telegram No. 106 of April
                    17, 6 p.m.,<anchor n="2" xml:id="d1268-f1"/> I have the honor to enclose the
                    text and translation of the decree establishing the rates of taxation for
                    petroleum and its products, issued April 13, 1917, by First Chief Carranza of
                    the Constitutionalist Army, to go into effect May 1, 1917.</p>
                <p>This decree has not yet been published in the <hi rendition="#italic">Diario
                        Oficial</hi> and this text has been copied from a local paper.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Henry P. Fletcher</hi>
                    </signed>
                </closer>


                <xi:include href="d1268-a1.xml" xpointer="d1268-a1"/>
            </div>
        </body>
    </text>
