        <body>
            <div xml:id="d1275">

                <pb facs="1236" n="1070" sameAs="frus:frus1917/pg1070"/>

                <note rend="inline" type="source">File No. 812.6363/292</note>
                <head>
                    <hi rendition="#italic">Chargé Summerlin to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 311</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Mexico City</hi></placeName>, <date
                            calendar="gregorian" when="1917-07-09">
                            <hi rendition="#italic">July 9, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to the Department’s
                    telegram No. 267, June 16, 3 p.m., relative to the refusal on the part of
                    officials of the Mexican Government to grant permits to oil companies to drill
                    wells acquired under leases of dates subsequent to February 5, 1917, I have the
                    honor to enclose herewith, copies and translations of my <hi rendition="#italic"
                        >note verbale</hi> of June 22 to the Minister of Industry and Commerce on
                    the subject, and of his reply of June 28.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">George T. Summerlin</hi>
                    </signed>
                </closer>




                <xi:include href="d1275-a1.xml" xpointer="d1275-a1"/>
                <xi:include href="d1275-a2.xml" xpointer="d1275-a2"/>
