    <text>
        <body>
            <div xml:id="d1262">

                <pb facs="1226" n="1060" sameAs="frus:frus1917/pg1060"/>

                <note rend="inline" type="source">File No. 812.5034/40</note>
                <head>
                    <hi rendition="#italic">Ambassador Fletcher to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 99</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1917-05-01">
                            <hi rendition="#italic">May 1, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>. I have the honor to enclose a copy and a
                    translation of a decree issued April 24, 1917 by the Secretary of Fomento,
                    outlining the procedure to be followed by foreigners who are endeavoring to
                    secure property in Mexico and who have not renounced certain of their rights as
                    foreigners in so far as such property is concerned, as prescribed in the decrees
                    of August 15, 1916 and December 15, 1916.</p>
                <p>This decree has not yet appeared in the <hi rendition="#italic">Diario
                        Oficial</hi> and the copy submitted has been taken from a local
                    newspaper.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Henry P. Fletcher</hi>
                    </signed>
                </closer>


                <xi:include href="d1262-a1.xml" xpointer="d1262-a1"/>
            </div>
        </body>
    </text>
