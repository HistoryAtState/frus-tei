    <text>
        <body>
            <div xml:id="d1144">

                <pb facs="1116" n="950" sameAs="frus:frus1917/pg950"/>

                <note rend="inline" type="source">File No. 812.011/31</note>
                <head>
                    <hi rendition="#italic">Mr. Parker,
                        representing American interests, to the Secretary of
                            State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 681</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1917-02-07">
                            <hi rendition="#italic">February 7, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith, in
                    compliance with the Department’s telegram No. 651 of February 5, 5 p.m., two
                    copies of the <hi rendition="#italic">Diario Oficial</hi> containing the entire
                    text of the reformed Mexican Constitution.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Charles B. Parker</hi>
                    </signed>
                </closer>


                <xi:include href="d1144-a1.xml" xpointer="d1144-a1"/>
            </div>
        </body>
    </text>
