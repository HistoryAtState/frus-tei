    <text>
        <body>
            <div xml:id="d1302">

                <pb facs="1245" n="1079" sameAs="frus:frus1917/pg1079"/>

                <note rend="inline" type="source">File No. 812.113/5770</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Mr.
                            De Negri
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-02-10">
                            <hi rendition="#italic">February 10, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I am in receipt of your letter of February
                    5, 1917, requesting that permission be given for the exportation, from the
                    United States to Mexico, of two million rounds of ammunition, for the use of
                    General Murguia, Commander of the forces of the <hi rendition="#italic">de
                        facto</hi> Government of Mexico in the State of Chihuahua.</p>
                <p>It is regretted that I do not see my way clear to recommend that permission be
                    given for the shipment of this ammunition, at this time.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
