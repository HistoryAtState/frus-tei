            <div xml:id="d1289">

                <pb facs="1241" n="1075" sameAs="frus:frus1917/pg1075"/>

                <note rend="inline" type="source">File No. 312.115/314</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Collector Cobb
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-06-30T13:00:00-05:00">
                            <hi rendition="#italic">June 30, 1917, 1 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Ascertain, if possible, truth of reported incidents your June 28, 11 a.m., and
                    keep Department advised of any new developments.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
