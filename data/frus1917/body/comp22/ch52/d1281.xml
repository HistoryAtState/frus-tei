    <text>
        <body>
            <div xml:id="d1281">

                <pb facs="1239" n="1073" sameAs="frus:frus1917/pg1073"/>

                <note rend="inline" type="source">File No. 312.115R39/20</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Ambassador Fletcher
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegrams]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-04-17T17:00:00-05:00">
                            <hi rendition="#italic">April 17, 1917, 5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>117. Your April 12, 3 p.m. Richardson Company reports embargo reimposed April
                    13.</p>
                <p>Urgently request sufficient suspension to allow thorough investigation.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
