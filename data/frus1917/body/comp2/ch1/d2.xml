                <pb facs="0170" n="4" xml:id="pg4"/>

                <note rend="inline" type="source">File No. 561.14A12/3</note>
                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-06-23">
                            <hi rendition="#italic">June 23, 1917</hi></date>.</dateline>
                </opener>
                <p rendition="#flush">
                    <hi rendition="#italic">To the Diplomatic Officers of the United States</hi>
                </p>
                <p>
                    <hi rendition="#small-caps">Gentlemen</hi>: Referring to the Department’s
                    circular of April 7, 1917, instructing the Diplomatic Officers of the United
                    States to extend to the Governments to which they are respectively accredited,
                    in pursuance of a provision contained in the Agricultural Appropriation Act
                    approved March 4, 1917, an invitation to appoint delegates or representatives to
                    the International Farm Congress to be held at Peoria, Illinois, during the
                    fiscal year, 1918, and to participate in the International Soil Products
                    Exposition to be held in connection therewith, you are now instructed to advise
                    those Governments that the Congress and Exposition will take place at Peoria,
                    Illinois, September 18–29, 1917.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Frank L. Polk</hi>
                    </signed>
                </closer>
            </div>
