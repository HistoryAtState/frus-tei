    <text>
        <body>
            <div xml:id="d767">

                <pb facs="1491" n="1469" sameAs="frus:frus1946v01/pg1469"/>

                <note rend="inline" type="source">841.796/2–546: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the United Kingdom</hi> (<hi rendition="#italic">Winant</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                        <lb/>
                        <hi rendition="#small-caps">us urgent</hi>
                        <lb/>
                        
                            <hi rendition="#small-caps">niact</hi>
                        
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1946-02-05T20:00:00+00:00">February 5, 1946—8
                            p.m.</date><lb/>[Received February 5—5:29 p.m.]</dateline>
                </opener>
                <p>1417. Re my 1392, Feb. 5.<anchor n="40" xml:id="d767-f1"/> The differences
                    between compromise arrived at in Bermuda and the position taken by the British
                    Cabinet have been cabled to the British Embassy in Washington for transmission
                    to Under Secretary Acheson and Assistant Secretary Clayton.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Winant</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
