                            <cell role="num">100,000,000</cell>
                        </row>
                        <row>
                            <cell>Philippine Islands</cell>
                            <cell role="num">50,000,000</cell>
                        </row>
                        <row>
                            <cell>Latin America</cell>
                            <cell/>
                        </row>
                        <row>
                            <cell>Other</cell>
                            <cell role="num">200,000,000</cell>
                        </row>
                        <row>
                            <cell/>
                            <cell rendition="#border-bottom" role="num">500,000,000</cell>
                        </row>
                        <row>
                            <cell rendition="#float-right">
                                <hi rendition="#italic">Total</hi>
                            </cell>
                            <cell role="num">$3,960,000,000</cell>
                        </row>
                    </table>
                </p>
