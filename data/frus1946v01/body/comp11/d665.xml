    <text>
        <body>
            <div xml:id="d665">

                <pb facs="1331" n="1309" sameAs="frus:frus1946v01/pg1309"/>

                <note rend="inline" type="source">560.AL/4–146: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in the United Kingdom</hi> (<hi
                            rendition="#italic">Winant</hi>)</head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                        <lb/>
                        
                            <hi rendition="#small-caps">niact</hi>
                        
                        <lb/>
                        <hi rendition="#small-caps">us urgent</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1946-04-09T18:00:00-05:00">April 9, 1946—6
                            p.m.</date>
                    </dateline>
                </opener>
                <p>3060. For Hawkins. Urtel 3635, Apr l.<anchor
                        n="59" xml:id="d665-f1"/> Please inform Brit that they can make no statement
                    on our authority at this time regarding approx date preliminary trade meeting,
                    that we will give them a definite answer by Apr 16 or 17 and that decision will
                    probably be to postpone negotiating meeting until early 1947.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Byrnes</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
