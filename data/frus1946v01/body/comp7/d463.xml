    <text>
        <body>
            <div xml:id="d463">

                <pb facs="0895" n="877" xml:id="pg877"/>

                <note rend="inline" type="source">Department of State Atomic Energy Files</note>
                <head>
                    <hi rendition="#italic">The Commanding General, Manhattan Engineer District</hi>
                        (<hi rendition="#italic">Groves</hi>), <hi
                        rendition="#italic">to Mr. John M. Hancock of
                        the United States Delegation to the Atomic Energy Commission</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1946-08-16">August 16,
                        1946</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Hancock</hi>: I am inclosing two copies of
                    the memorandum on stages which we have been working on and discussing over the
                    past several weeks.</p>
                <p>These are for your files.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>L. R. <hi rendition="#small-caps">Groves</hi>
                    </signed>
                    <lb/>
                    <hi rendition="#italic">Major General, USA
                    </hi>
                </closer>


                <xi:include href="d463-a1.xml" xpointer="d463-a1"/>
            </div>
        </body>
    </text>
