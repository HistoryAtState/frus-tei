                <note rend="inline" type="source">Department of State Disarmament Files</note>
                <head>
                    <hi rendition="#italic">Record of a Special Meeting of the Policy Committee on
                        Arms and Armaments, Department of State, November 4, 1946, 11 a.m.</hi>
                </head>
                <dateline>
                    <date ana="#date_undated-inferred-from-document-head" calendar="gregorian"
                        when="1946-11-04T11:00:00-05:00">November 4, 1946, 11 a.m.</date>
                </dateline>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                    </seg>
                    <lb/><seg rendition="#float-left"> PCA M–23 (Supplement)</seg>
                </opener>
                <table rend="width: 80%" rendition="#center">
                    <row role="label">
                        <cell>Present:</cell>
                        <cell>General Crain,<anchor n="53" xml:id="d513-f1"/> A–H, Deputy
