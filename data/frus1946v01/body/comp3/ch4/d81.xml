    <text>
        <body>
            <div xml:id="d81">

                <pb facs="0174" n="156" sameAs="frus:frus1946v01/pg156"/>

                <note rend="inline" type="source">
                    IO Files: USGA/Ia/12/Add.1</note>
                <head>
                    <hi rendition="#italic">Memorandum by the Principal Adviser to the United States
                        Delegation</hi> (<hi rendition="#italic"
                        >Hiss</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >London</hi></placeName>,] <date calendar="gregorian"
                            when="1946-01-12">January 12, 1946</date>.</dateline>
                </opener>
                <p>The attached slates have been circulated this morning<anchor n="50"
                        xml:id="d81-f1"/> by our political officers as our slates for the Security
                    Council and the Economic and Social Council.</p>



                <xi:include href="d81-a1.xml" xpointer="d81-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d81-f1" n="50" xml:id="d81-f1-content">
                <p>Typed notation at bottom of this memorandum reads: “Covering Memo to slates sent
                    Byrnes Jan. 12, 9 a.m.”</p>
            </note>
        </listAnnotation>
