    <text>
        <body>
            <div xml:id="d73-a3">

                <pb facs="0155" n="137" sameAs="frus:frus1946v01/pg137"/>

                <opener>
                    <seg rendition="#center">[Annex III]</seg>
                </opener>
                <head>
                    <hi rendition="#small-caps">Table</hi> III</head>
                <p rendition="#center">(Australia as President)</p>
                <p rendition="#flush">President: Australia</p>
                <p rendition="#flush">Vice-Presidents: China, France, UK, USA, USSR <list>
                        <item>Poland</item>
                        <item>Uruguay</item>
                    </list>
                </p>
                <table cols="3" rows="7">
                    <row role="label">
                        <cell>
                            <hi rendition="#italic">Committee</hi>
                        </cell>
                        <cell>
                            <hi rendition="#italic">Chairman</hi>
                        </cell>
                        <cell>
                            <hi rendition="#italic">Vice-Chairman</hi>
                        </cell>
                    </row>
                    <row>
                        <cell>Political and Security</cell>
                        <cell>New Zealand</cell>
                        <cell>Yugoslavia</cell>
                    </row>
                    <row>
                        <cell>Economic</cell>
                        <cell>Norway (or Belgium)<anchor n="**" xml:id="d73-f1"/>
                        </cell>
                        <cell>Egypt (or Iran)</cell>
                    </row>
                    <row>
                        <cell>Social</cell>
                        <cell>Ukraine</cell>
                        <cell>Belgium (or Norway)</cell>
                    </row>
                    <row>
                        <cell>Trusteeship</cell>
                        <cell>Colombia (or Venezuela)</cell>
                        <cell>Canada</cell>
                    </row>
                    <row>
                        <cell>Administrative &amp; Budgetary</cell>
                        <cell>Iran (or Egypt)</cell>
                        <cell>Venezuela (or Colombia)</cell>
                    </row>
                    <row>
                        <cell>Legal</cell>
                        <cell>Mexico</cell>
                        <cell>South Africa</cell>
                    </row>
                </table>
                <p>See other footnotes on Table I. [Footnote in the original.]</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d73-f1" n="**" xml:id="d73-f1-content">
                <p>As a consolation for not being elected President.</p>
            </note>
        </listAnnotation>
    </standOff>
