    <text>
        <body>
            <div xml:id="d222">

                <pb facs="0422" n="318" sameAs="frus:frus1890/pg318"/>

                <head><hi rendition="#italic">Mr. Blaine to Count
                            von Arco-Valley.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1890-03-07"><hi rendition="#italic">March</hi> 7,
                        1890</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Acknowledging the receipt of your note of
                    the 2d instant, inclosing a copy of a memorandum submitted by your Government
                    relative to the execution of the Samoan treaty, I have the honor to transmit to
                    you herewith a copy of a telegram which I sent to the American vice-consul at
                    Samoa on the subject.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">James G. Blaine.</hi></signed></closer>


                <xi:include href="d222-a1.xml" xpointer="d222-a1"/>
