    <text>
        <body>
            <div xml:id="d221">

                <pb facs="0421" n="317" sameAs="frus:frus1890/pg317"/>

                <head><hi rendition="#italic">Count von Arco-Valley
                        to Mr. Blaine.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Imperial German Legation</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1890-03-02"><hi rendition="#italic">March</hi> 2, 1890</date>.
                        (Received March 3.)</dateline></opener>
                <p>Mr. <hi rendition="#small-caps">Secretary of State</hi>: I have the honor, in
                    obedience to instructions received, most respectfully herewith to transmit to
                    you a copy of a memorandum relative to the execution of the Samoan general
                    act.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Arco.</hi></signed></closer>


                <xi:include href="d221-a1.xml" xpointer="d221-a1"/>
