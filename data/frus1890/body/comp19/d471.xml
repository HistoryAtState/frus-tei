    <text>
        <body>
            <div xml:id="d471">

                <pb facs="0873" n="763" sameAs="frus:frus1890/pg763"/>

                <head><hi rendition="#italic">Mr. Blaine to Mr. Hirsch.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1890-05-06"><hi rendition="#italic">May</hi> 6,
                        1890</date>.</dateline>
                    <seg rendition="#float-left">No. 82.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit, for your information, a copy of
                    a letter from the Rev. Judson Smith, of the American Board of Commissioners for
                    Foreign Missions, in further relation to the local interference in Turkish
                    territory with the legitimate book trade of our citizens there; also a copy of
                    the answer made by the Department.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">James G. Blaine.</hi></signed></closer>



                <xi:include href="d471-a1.xml" xpointer="d471-a1"/>
