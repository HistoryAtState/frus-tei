    <text>
        <body>
            <div xml:id="d477-a1">

                <pb facs="0878" n="768" sameAs="frus:frus1890/pg768"/>

                <opener><seg rendition="#center">[Inclosure in No. 141.].</seg></opener>
                <head><hi rendition="#italic">Mr. Sweeney to Mr.
                            Hirsch</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Consulate-General of the United States</hi>,<lb/><hi
                                rendition="#italic">Constantinople</hi></placeName>, <date
                            calendar="gregorian" when="1890-06-11"><hi rendition="#italic">June</hi>
                            11, 1890</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose a copy of a
                    dispatch from the consul at Jerusalem, concerning the riot in which the
                    Christians were attacked by a Moslem mob at Jaffa on the 23d May, 1890.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Z. T. Sweeney.</hi></signed></closer>
            </div>
        </body>
