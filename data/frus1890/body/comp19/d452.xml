    <text>
        <body>
            <div xml:id="d452">

                <pb facs="0831" n="721" sameAs="frus:frus1890/pg721"/>

                <head><hi rendition="#italic">Mr. Blaine to Mr. Hirsch.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1889-12-07"><hi rendition="#italic">December</hi> 7,
                        1889</date>.</dateline>
                    <seg rendition="#float-left">No. 39.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit, in further relation to the
                    subject of instruction No. 27 of the 8th of November last, a copy of a letter
                    from Mr. Judson Smith, of the American Board of Commissioners for Foreign
                    Missions, and of the inclosure thereof, expressing apprehensions that Moussa
                    Bey, the alleged assailant of the American missionaries Rev. Mr. Knapp and Dr.
                    Raynolds, in 1882, may escape the legal punishment for his wrongdoing, which it
                    was hoped might be the possible result of his present trial at
                    Constantinople.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">James G. Blaine.</hi></signed></closer>




                <xi:include href="d452-a1.xml" xpointer="d452-a1"/>
