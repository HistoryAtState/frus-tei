    <text>
        <body>
            <div xml:id="d495">

                <pb facs="0891" n="781" sameAs="frus:frus1890/pg781"/>

                <head><hi rendition="#italic">Mr. Blaine to Mr.
                            Scruggs.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1890-06-21"><hi rendition="#italic">June</hi> 21,
                        1890</date>.</dateline>
                    <seg rendition="#float-left">No. 97.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    No. 106 of the 7th instant, in relation to the Guiana boundary dispute, and to
                    state that a copy of your dispatch has been forwarded to your colleague at
                    London, for his information.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">James G. Blaine.</hi></signed></closer>
            </div>
        </body>
    </text>
