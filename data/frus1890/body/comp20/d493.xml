    <text>
        <body>
            <div xml:id="d493">

                <pb facs="0890" n="780" sameAs="frus:frus1890/pg780"/>

                <head><hi rendition="#italic">Mr. Blaine to Mr. Scruggs.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1890-05-21"><hi rendition="#italic">May</hi> 21,
                        1890</date>.</dateline>
                    <seg rendition="#float-left">No. 88.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have received your No. 100 of the 3d
                    instant, inclosing a map showing the British claims to the territory in dispute
                    between the Governments of Great Britain and Venezuela. Copies of your dispatch
                    and of its inclosure have been transmitted to our minister at London.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">James G. Blaine.</hi></signed></closer>
            </div>
        </body>
    </text>
