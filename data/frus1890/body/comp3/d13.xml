    <text>
        <body>
            <div xml:id="d13">

                <pb facs="0124" n="20" sameAs="frus:frus1890/pg20"/>

                <head><hi rendition="#italic">Mr. Adams to Mr.
                            Blaine</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Petropolis</hi></placeName>, <date calendar="gregorian"
                            when="1890-01-10"><hi rendition="#italic">January</hi> 10, 1890</date>.
                        (Received February 10.)</dateline>
                    <seg rendition="#float-left">No. 36.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to forward herewith
                    translations of the decrees of December 31, 1889, and January 7, 1890, both of
                    importance, of the Provisional Government.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Robert Adams, Jr.</hi></signed></closer>



