    <text>
        <body>
            <div xml:id="d239">

                <pb facs="0439" n="335" sameAs="frus:frus1890/pg335"/>

                <head><hi rendition="#italic">Mr. Blaine to Mr.
                            Lincoln.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1890-04-18"><hi rendition="#italic">April</hi> 18,
                        1890</date>.</dateline>
                    <seg rendition="#float-left">No. 242.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to your dispatch No. 203 of the
                    28th ultimo, concerning the paper in the nature of a passport issued by the
                    governor of Minnesota to Mr. Louis Wagner, I transmit to you herewith, for your
                    information, a copy of a letter from the executive of Minnesota on the
                    subject.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">James G. Blaine.</hi></signed></closer>


                <xi:include href="d239-a1.xml" xpointer="d239-a1"/>
