    <text>
        <body>
            <div xml:id="d110-a3">

                <pb facs="0224" n="120" xml:id="pg120"/>

                <head><hi rendition="#italic">Mr. Mizner to Mr. Bernhard</hi>.</head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Guatemala</hi></placeName>, <date calendar="gregorian"
                            when="1890-09-19"><hi rendition="#italic">September</hi> 19,
                        1890</date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">George Bernhard</hi>, <hi
                        rendition="#italic">United States Vice-Consul, Tegucigalpa:</hi></p>
                <p>The cable line via La Libertad, Salvador, will be open for telegrams to the
                    United States on Monday.</p>
                <closer><signed><hi rendition="#small-caps">Mizner</hi>,<lb/><hi rendition="#italic"
                            >United States Minister.</hi></signed></closer>
            </div>
        </body>
    </text>
