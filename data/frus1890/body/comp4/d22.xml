                <pb facs="0136" n="32" sameAs="frus:frus1890/pg32"/>

                <head><hi rendition="#italic">Mr. Adee to Mr. Mizner</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1890-07-14"><hi rendition="#italic">July</hi> 14,
                        1890</date>.</dateline>
                    <seg rendition="#float-left">No. 128.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to your recent telegram relative
                    to a possible early conflict between the troops of Salvador and Guatemala, I
                    have to state that the Secretary of the Navy has ordered two ships of war to
                    proceed to that quarter.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alvey A. Adee.</hi></signed></closer>
            </div>
        </body>
    </text>
