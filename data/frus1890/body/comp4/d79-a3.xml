    <text>
        <body>
            <div xml:id="d79-a3">

                <pb facs="0189" n="85" sameAs="frus:frus1890/pg85"/>

                <opener><seg rendition="#center">[Inclosure 3 in No. 150.—Telegram.]</seg></opener>
                <head><hi rendition="#italic">Captain Pitts to Minister Mizner.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >San José de Guatemala</hi></placeName>, <date calendar="gregorian"
                            when="1890-08-27"><hi rendition="#italic">August</hi> 27,
                        1890</date>.</dateline></opener>
                <p rendition="#center">[Received at telegraph office in Guatemala at 9:46 p.m.;
                    received at this legation at 10 p.m., August 27.]</p>
                <p rendition="#flush">Mr. <hi rendition="#small-caps">Mizner</hi>,<lb/><hi
                        rendition="#italic">United States Minister:</hi></p>
                <p>Shall I deliver General Barrundia to the authorities here? If so, please send me
                    a letter with your signature to that effect.</p>
                <closer><signed><hi rendition="#small-caps">W. G. Pitts</hi>,<lb/><hi
                            rendition="#italic">Commander.</hi></signed></closer>
            </div>
        </body>
    </text>
