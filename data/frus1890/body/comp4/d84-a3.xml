    <text>
        <body>
            <div xml:id="d84-a3">

                <pb facs="0198" n="94" xml:id="pg94"/>

                <opener><seg rendition="#center">[Inclosure 3 in No.
                    151.—Translation.]</seg></opener>
                <p>In view of the bases of peace to which the preceding declaration refers, and in
                    the interests of the same, I hereby ratify them, in conformity with, and in
                    relation to, the answer given this day by the foreign diplomatic corps
                    accredited to Central America.</p>
                <closer><signed><hi rendition="#small-caps">Carlos Ezeta.</hi></signed>
                    <lb/>
                    <dateline rendition="#float-left"><placeName><hi rendition="#small-caps"
                                >Acajutla, Salvador</hi></placeName>, <date calendar="gregorian"
                            when="1890-08-25"><hi rendition="#italic">August</hi> 25,
                        1890</date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
