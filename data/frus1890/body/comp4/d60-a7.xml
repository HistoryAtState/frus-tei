    <text>
        <body>
            <div xml:id="d60-a7">

                <pb facs="0171" n="67" sameAs="frus:frus1890/pg67"/>

                <opener><seg rendition="#center">[Inclosure 6.]</seg></opener>
                <head><hi rendition="#italic">Mr. Jones to Captain Long.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >San José, Guatemala</hi></placeName>, <date calendar="gregorian"
                            when="1890-07-18"><hi rendition="#italic">July</hi> 18,
                        1890</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Sir</hi>: The commandant has given official
                    order to permit the transshipment of the 20 cases rifles and 25 cases cartridges
                    to the <hi rendition="#italic">City of Sidney.</hi></p>
                <p>I therefore beg you to order the transshipment as soon as possible, so that the
                        <hi rendition="#italic">City of Sydney</hi> may reach Champerico this
                    evening.</p>
                <p>Yours, truly,</p>
                <closer><signed><hi rendition="#small-caps">R. L. Jones.</hi></signed></closer>
            </div>
        </body>
    </text>
