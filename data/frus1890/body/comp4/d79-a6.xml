    <text>
        <body>
            <div xml:id="d79-a6">

                <pb facs="0190" n="86" xml:id="pg86"/>

                <opener><seg rendition="#center">[Inclosure 6 in No. 150.—Telegram.]</seg></opener>
                <head><hi rendition="#italic">Commander Reiter to Mr. Mizner.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >San José de Guatemala</hi></placeName>, <date calendar="gregorian"
                            when="1890-08-28"><hi rendition="#italic">August</hi> 28,
                        1890</date>.</dateline></opener>
                <p rendition="#flush">Minister <hi rendition="#small-caps">Mizner</hi>:</p>
                <p>Barrundia resisted arrest and was killed. No passengers or others injured. Letter
                    with particulars to-morrow.</p>
                <closer><signed><hi rendition="#small-caps">Reiter.</hi></signed></closer>
            </div>
        </body>
    </text>
