    <text>
        <body>
            <div xml:id="d60-a5">

                <pb facs="0171" n="67" sameAs="frus:frus1890/pg67"/>

                <opener><seg rendition="#center">[Inclosure
                    4.—Telegram.—Translation.]</seg></opener>
                <head><hi rendition="#italic">Mr. Leverich to Captain Long.</hi></head>
                <opener><dateline rendition="#center">[From <placeName>Adunna</placeName>, <date
                            calendar="gregorian" when="1890-07-17">July 17, 1890</date>. Received at
                        San José at 2:57 p.m.]</dateline></opener>
                <p rendition="#flush">To Capt. <hi rendition="#small-caps">J. S. Long</hi>:</p>
                <p>Minister Mizner has telegraphed Washington for instructions, and I also to the
                    Pacific Mail, New York.</p>
                <closer><signed><hi rendition="#small-caps">J. H. Leverich.</hi></signed></closer>
            </div>
        </body>
