    <text>
        <body>
            <div xml:id="d51-a14">

                <pb facs="0165" n="61" sameAs="frus:frus1890/pg61"/>

                <head><hi rendition="#italic">Mr. Leverich to
                            Pacific Mail Steamship Company.</hi></head>
                <opener><seg rendition="#center">[Telegram.—Translation.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Guatemala</hi></placeName>, <date calendar="gregorian"
                            when="1890-07-17"><hi rendition="#italic">July</hi> 17,
                        1890</date>.</dateline>
                    <seg rendition="#float-left">No. 3.]</seg></opener>
                <p>I have ordered arms to be transferred to steamship <hi rendition="#italic">City
                        of Sydney</hi> for storage on hulk <hi rendition="#italic">Alaska.</hi></p>
                <closer><signed><hi rendition="#small-caps">J. H. Leverich</hi>,<lb/><hi
                            rendition="#italic">Special Agent.</hi></signed></closer>
            </div>
        </body>
    </text>
