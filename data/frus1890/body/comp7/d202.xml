                <pb facs="0392" n="288" sameAs="frus:frus1890/pg288"/>

                <head><hi rendition="#italic">Mr. Reid to Mr. Blaine.</hi></head>
                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1890-07-28"><hi rendition="#italic">July</hi> 28, 1890</date>.
                        (Received August 9.)</dateline>
                    <seg rendition="#float-left">No. 210.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith copies
                    of a letter from Mr. Ribot, minister of foreign affairs, on the pork question
                    and of my reply.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Whitelaw Reid.</hi></signed></closer>



                <xi:include href="d202-a1.xml" xpointer="d202-a1"/>
