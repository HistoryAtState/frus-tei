    <text>
        <body>
            <div xml:id="d450">

                <pb facs="0830" n="720" xml:id="pg720"/>

                <head><hi rendition="#italic">Mr. Wharton to Mr.
                            Grip.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1890-08-21"><hi rendition="#italic">August</hi> 21,
                        1890</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose for your
                    information copy of the order<anchor n="*" xml:id="d450-f1"/> issued by the
                    Acting Secretary of the Navy on the 18th instant, in reference to the salute to
                    the flag of Sweden to be fired on the occasion of the embarkation of the remains
                    of Captain Ericsson.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">William F. Wharton</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d450-f1" n="*" xml:id="d450-f1-content">
                <p>For inclosure see inclosure to instructions No. 50, dated August 26, 1890, to
                    United States minister to Sweden and Norway.</p>
            </note>
        </listAnnotation>
    </standOff>
