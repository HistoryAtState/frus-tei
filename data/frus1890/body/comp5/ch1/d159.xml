    <text>
        <body>
            <div xml:id="d159">

                <pb facs="0315" n="211" sameAs="frus:frus1890/pg211"/>

                <head><hi rendition="#italic">Mr. Blaine to Mr. Tsui</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1890-03-13"><hi rendition="#italic">March</hi> 13,
                        1890</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your esteemed note of the 27th ultimo, in further relation to the transit of
                    Chinese subjects through the United States.</p>
                <p>I have made known its contents to the Secretary of the Treasury, and am now
                    awaiting whatever further statement he may have to communicate on the
                    subject.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">James G. Blaine.</hi></signed></closer>
            </div>
        </body>
    </text>
