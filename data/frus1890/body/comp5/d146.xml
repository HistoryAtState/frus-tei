    <text>
        <body>
            <div xml:id="d146">

                <pb facs="0300" n="196" sameAs="frus:frus1890/pg196"/>

                <head><hi rendition="#italic">Mr. Wharton to Mr. Denby</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1890-09-25"><hi rendition="#italic">September</hi> 25,
                        1890</date>.</dateline>
                    <seg rendition="#float-left">No. 556.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have read your No. 1140 of the 4th
                    ultimo, and approve the terms of your note of that date to the foreign office,
                    in which you express a hope that the Chinese Government will see its way clear
                    to permit foreign scientific officers to continue and complete the hydrography
                    of the ports of China.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">William F. Wharton</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
