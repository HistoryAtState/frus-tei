    <text>
        <body>
            <div xml:id="d184">

                <pb facs="0362" n="258" sameAs="frus:frus1890/pg258"/>

                <head><hi rendition="#italic">Mr. Abbott to Mr. Blaine.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Bogota</hi></placeName>, <date calendar="gregorian"
                            when="1890-08-14"><hi rendition="#italic">August</hi> 14, 1890</date>.
                        (Received September 13.)</dateline>
                    <seg rendition="#float-left">No. 113.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I herewith transmit a copy and translation
                    of so much of the report of the minister of foreign affairs as relates to the
                    claim of the Boston Ice Company against this Government.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John T. Abbott.</hi></signed></closer>


                <xi:include href="d184-a1.xml" xpointer="d184-a1"/>
