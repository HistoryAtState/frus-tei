    <text>
        <body>
            <div xml:id="d185">

                <pb facs="0364" n="260" sameAs="frus:frus1890/pg260"/>

                <head><hi rendition="#italic">Mr. Abbott to Mr. Blaine.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Bogota</hi></placeName>, <date calendar="gregorian"
                            when="1890-08-18"><hi rendition="#italic">August</hi> 18, 1890</date>.
                        (Received September 13.)</dateline>
                    <seg rendition="#float-left">No. 117.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith a copy and translation
                    of so much of the report of the minister of foreign affairs as relates to the
                    claim of the Panama Star and Herald against this Government.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John T. Abbott.</hi></signed></closer>


                <xi:include href="d185-a1.xml" xpointer="d185-a1"/>
