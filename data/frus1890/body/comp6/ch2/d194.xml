    <text>
        <body>
            <div xml:id="d194">

                <pb facs="0377" n="273" sameAs="frus:frus1890/pg273"/>

                <head><hi rendition="#italic">Mr. Blaine to Mr. Hurtado.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1890-05-07"><hi rendition="#italic">May</hi> 7,
                        1890</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to recall to your
                    attention my note of January 31 last, relating to the claim of the Panama Star
                    and Herald against the Government of Colombia.</p>
                <p>This Government earnestly desires to reach a settlement of the case, and hopes it
                    may soon receive a proposition which will lead to its adjustment.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">James G. Blaine.</hi></signed></closer>
            </div>
        </body>
    </text>
