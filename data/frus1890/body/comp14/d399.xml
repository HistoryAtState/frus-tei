                <pb facs="0762" n="652" sameAs="frus:frus1890/pg652"/>

                <head><hi rendition="#italic">Mr. Ryan to Mr. Blaine.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1890-08-19"><hi rendition="#italic">August</hi> 19, 1890</date>.
                        (Received November 4.)</dateline>
                    <seg rendition="#float-left">No. 387.</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to submit herewith, for
                    the information of the Department, copies of correspondence relative to action
                    by the United States and Mexican Governments for the peaceful solution of
                    Central American affairs.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Thos. Ryan.</hi></signed></closer>



                <xi:include href="d399-a1.xml" xpointer="d399-a1"/>
