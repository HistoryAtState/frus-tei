                <pb facs="0764" n="654" sameAs="frus:frus1890/pg654"/>

                <head><hi rendition="#italic">Mr. Ryan to Mr. Blaine.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1890-08-30"><hi rendition="#italic">August</hi> 30, 1890</date>.
                        (Received September 10.)</dateline>
                    <seg rendition="#float-left">No. 398.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Herewith I beg to forward letter of Mr.
                    Azpiroz relative to Central American affairs.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Thos. Ryan.</hi></signed></closer>


                <xi:include href="d404-a1.xml" xpointer="d404-a1"/>
