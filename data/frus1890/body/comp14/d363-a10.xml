    <text>
        <body>
            <div xml:id="d363-a10">

                <pb facs="0736" n="626" sameAs="frus:frus1890/pg626"/>

                <opener><seg rendition="#center">[Inclosure 7 in No. 211.]</seg></opener>
                <head><hi rendition="#italic">Mr. Ryan to Mr.
                            King.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1890-01-04"><hi rendition="#italic">January</hi> 4,
                        1890</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I am just in receipt of yours No. 18 of
                    27th ultimo, reporting that the magistrate may soon be expected to sentence R.
                    C. Work.</p>
                <p>Please aid Work in securing the testimony of Sisto and Patricio Vega, if not
                    already given in the trial proceedings.</p>
                <p>Yours, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Thos. Ryan.</hi></signed></closer>
            </div>
        </body>
    </text>
