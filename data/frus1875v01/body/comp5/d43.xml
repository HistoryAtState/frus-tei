            <div xml:id="d43">

                <pb facs="0161" n="71" sameAs="frus:frus1875v01/pg71"/>

                <head>No. 39.<lb/><hi rendition="#italic">Mr. Jones to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Brussels</hi></placeName>, <date calendar="gregorian"
                            when="1871-12-17"><hi rendition="#italic">December</hi> 17, 1871</date>.
                        (Received January 4, 1875.)</dateline>
                    <seg rendition="#float-left">No. 329.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: The inclosed letter from the King to the
                    minister of the interior, a translation of which I also inclose, is from the
                    “Moniteur” of the 15th instant.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>J. R. JONES.</signed></closer>


                <xi:include href="d43-a1.xml" xpointer="d43-a1"/>
