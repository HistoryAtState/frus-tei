        <body>
            <div xml:id="d189">

                <pb facs="0502" n="412" sameAs="frus:frus1875v01/pg412"/>

                <head>No. 185.<lb/><hi rendition="#italic">Mr. Seward to Mr. Cadwalader.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Consulate General</hi>,<lb/><hi rendition="#italic"
                                >At Shanghai</hi></placeName>, <date calendar="gregorian"
                            when="1875-06-14"><hi rendition="#italic">June</hi> 14, 1875</date>.
                        (Received July 24.)</dateline>
                    <seg rendition="#float-left">No. 940.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to hand to you herewith a
                    copy of a dispatch which I have received from the consul at Foo-chow, together
                    with a copy of an answer which I have addressed to him.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>GEORGE F. SEWARD.</signed></closer>




                <xi:include href="d189-a1.xml" xpointer="d189-a1"/>
