            <div xml:id="d248">

                <pb facs="0633" n="543" sameAs="frus:frus1875v01/pg543"/>

                <head>No. 244.<lb/><hi rendition="#italic">Mr. Davis to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Berlin</hi></placeName>, <date calendar="gregorian"
                            when="1875-04-26"><hi rendition="#italic">April</hi> 26, 1875</date>.
                        (Received May 14.)</dateline>
                    <seg rendition="#float-left">No. 106.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose a translation
                    of the proposed law for the management of the property in Catholic church
                    communities, as reported in an amended form by the committee of the Prussian
                    Diet, and to be, &amp;c.</p>
                <closer><signed>J. C. BANCROFT DAVIS.</signed></closer>


                <xi:include href="d248-a1.xml" xpointer="d248-a1"/>
            </div>
