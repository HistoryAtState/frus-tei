                <head><hi rendition="#italic">Mr. Ingalls to Mr.
                            Thayer.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Whitehall</hi></placeName>, <date calendar="gregorian"
                            when="1874-11-30"><hi rendition="#italic">November</hi> 30, 1874</date>.
