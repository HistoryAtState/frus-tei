                <p>No, sir.</p>
                <closer><signed><list>
                            <item>J. W. INGALLS,<lb/><hi rendition="#italic">First Clerk</hi>.
                                (Collector absent.)</item>
                            <item><hi rendition="#small-caps">Francis S. Thayer</hi>, <hi
                                    rendition="#italic">Auditor.</hi></item>
                        </list></signed></closer>
