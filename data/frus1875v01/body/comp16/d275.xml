    <text>
        <body>
            <div xml:id="d275">

                <pb facs="0730" n="640" sameAs="frus:frus1875v01/pg640"/>

                <head>No. 271.<lb/><hi rendition="#italic">Mr. Hoffman to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1875-08-28"><hi rendition="#italic">August</hi> 28, 1875</date>.
                        (Received September 9.)</dateline>
                    <seg rendition="#float-left">No. 25.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to your dispatch No. 766, in
                    reference to the assistance and courtesies extended to the American
                    transit-of-Yen us party in New Zealand, I have the honor to inclose to you
                    herewith copies of the correspondence which has passed between Lord Derby and
                    myself upon this subject.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>WICKHAM HOFFMAN.</signed></closer>




                <xi:include href="d275-a1.xml" xpointer="d275-a1"/>
