    <text>
        <body>
            <div xml:id="d289">

                <pb facs="0744" n="654" sameAs="frus:frus1875v01/pg654"/>

                <head>No. 285.<lb/><hi rendition="#italic">Sir Edward Thornton to Mr.
                    Fish</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1875-03-05"><hi rendition="#italic">March</hi> 5, 1875</date>.
                        (Received March 6.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In obedience to instructions from the Earl
                    of Derby, I have the honor to inclose to you a copy of a list of Her Majesty’s
                    ships which are provided with warrants for the suppression of the slave-trade,
                    together with the number of their guns, the names of their commanders, and the
                    stations on which they are severally employed.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>EDW’D THORNTON.</signed></closer>



                <xi:include href="d289-a1.xml" xpointer="d289-a1"/>
            </div>
        </body>
