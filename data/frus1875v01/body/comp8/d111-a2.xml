    <text>
        <body>
            <div xml:id="d111-a2">

                <pb facs="0245" n="155" xml:id="pg155"/>

                <opener><seg rendition="#center">[Inclosure 1 in No.
                    306.—Translation.]</seg></opener>
                <head><hi rendition="#small-caps">decree of the president of nicaragua.</hi></head>
                <p rendition="#flush"><hi rendition="#italic">The President of the Republic of
                        Nicaragua to its inhabitants:</hi></p>
                <p>Know that the sovereign Congress has declared the following:</p>
                <p>The Congress of the Republic of Nicaragua declares—</p>
                <p>Article 1st. “the citizen, Mr. Pedro Joaquin Chamorro, is popularly and
                    constitutionally elected President of the republic .by the free and spontaneous
                    vote of the Nicaraguans for the term that commences the 1st of March of the
                    present year.</p>
                <p>To the executive power.</p>
                <closer><dateline rendition="#float-left">Given in the hall of the sessions of
                        Congress, <placeName>Managua</placeName>, <date calendar="gregorian"
                            when="1875-01-19">January 19, 1875</date>.</dateline>
                    <lb/>
                    <signed>JOSÉ ARQUELLO ARCE, <hi rendition="#italic">Pte</hi>.</signed>
                    <lb/>
                    <signed>PEDRO CHAMORRO, <hi rendition="#italic">D. S.</hi></signed>
                    <lb/>
                    <signed>FRANCISCO DEL CASTILLO, <hi rendition="#italic">D.
                    S.</hi></signed></closer>


                <xi:include href="d111-a2-a1.xml" xpointer="d111-a2-a1"/>
