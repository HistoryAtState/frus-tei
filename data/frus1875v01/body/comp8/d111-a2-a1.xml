            <div xml:id="d111-a2-a1">

                <pb facs="0245" n="155" xml:id="pg155"/>

                <p>Therefore let it be executed.</p>
                <closer>
                    <dateline rendition="#float-left"><placeName>Managua</placeName>, <date
                            calendar="gregorian" when="1875-01-19">January 19,
                        1875</date>.</dateline>
                    <lb/><signed><list>
                            <item>VICENTE QUADRA.</item>
                            <item>FRANCISCO BARBERENA,<lb/><hi rendition="#italic">Minister of the
                                    government.</hi></item>
                            <item>RIVAS.</item>
                        </list></signed></closer>
            </div>
        </body>
