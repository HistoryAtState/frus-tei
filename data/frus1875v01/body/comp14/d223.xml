        <body>
            <div xml:id="d223">

                <pb facs="0553" n="463" sameAs="frus:frus1875v01/pg463"/>

                <head>No. 219.<lb/><hi rendition="#italic">Mr. Washburne to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1875-03-01"><hi rendition="#italic">March</hi> 1, 1875</date>.
                        (Received March 25.)</dateline>
                    <seg rendition="#float-left">No. 1109.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose you herewith
                    the full text of the constitutional laws and the law of the senate recently
                    enacted by the National Assembly.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>E. B. WASHBURNE.</signed></closer>


                <xi:include href="d223-a1.xml" xpointer="d223-a1"/>
            </div>
