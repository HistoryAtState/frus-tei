    <text>
        <body>
            <div xml:id="d2">

                <pb facs="0053" n="XXXI" xml:id="pgXXXI"/>

                <head>[Untitled]</head>
                <p rendition="#flush">To <hi rendition="#small-caps">the President</hi>:</p>
                <p>The Secretary of State has the honor to transmit herewith a report concerning the
                    business of the Court of Commissioners of Alabama Claims, made through its
                    clerk.</p>
                <p>In this connection he has the honor to call your attention to the statement
                    contained therein that, in the opinion of the court, it will be impossible to
                    complete the work before it within the time allowed by existing provisions of
                    law therefor.</p>
                <closer><signed>HAMILTON FISH.</signed>
                    <lb/>
                    <dateline rendition="#float-left"><hi rendition="#small-caps">Department of
                            State</hi>,<lb/><placeName><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1875-11-15"><hi rendition="#italic">November</hi> 15,
                        1875</date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
