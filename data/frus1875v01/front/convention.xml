                <pb facs="0049" n="XXVII" sameAs="frus:frus1875v01/pgXXVII"/>

                <head>Convention between the United States of American and His Majesty the King of
                    the Hawaiian Islands.</head>
                <p rendition="#center"><hi rendition="#small-caps">commercial reciprocity.</hi></p>
                <p rendition="#flush"><hi rendition="#italic">Concluded January</hi> 30, 1875; <hi
                        rendition="#italic">ratification advised by Senate March</hi> 18, 1875; <hi
                        rendition="#italic">ratified by President May</hi> 31, 1875; <hi
                        rendition="#italic">ratified by King April</hi> 17, 1875; <hi
                        rendition="#italic">ratifications exchanged at Washington, June</hi> 3,
                    1875; <hi rendition="#italic">proclaimed June</hi> 3, 1875.</p>






                <xi:include href="convention/d1.xml" xpointer="d1"/>
