                <pb facs="0109" n="37" sameAs="frus:frus1909/pg37"/>

                <note rend="inline" type="source">File No. 3382/25A.</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Belgian
                        Minister.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1909-12-22"><hi rendition="#italic">December 22,
                        1909</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Minister</hi>: The President desires me
                    to say that he will attend the services to be held at St. Matthew’s Church
                    tomorrow morning, at half past 10 o’clock, in memory of His late Majesty King
                    Leopold.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Huntington
                    Wilson.</hi></signed></closer>
            </div>
        </body>
