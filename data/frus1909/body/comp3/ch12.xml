            <div xml:id="ch12">

                <pb facs="0105" n="33" xml:id="pg33"/>

                <head>Arbitration Convention between the United States and Austria-Hungary</head>
                <p><hi rendition="#italic">Signed at Washington, January 15, 1909.</hi></p>
                <p><hi rendition="#italic">Ratification advised by the Senate, January 20,
                        1909.</hi></p>
                <p><hi rendition="#italic">Ratified by the President, March 1, 1909.</hi></p>
                <p><hi rendition="#italic">Ratified by Austria-Hungary, April 17, 1909.</hi></p>
                <p><hi rendition="#italic">Ratifications exchanged at Washington, May 18,
                    1909.</hi></p>
                <p><hi rendition="#italic">Proclaimed May 18, 1909.</hi></p>

                <xi:include href="ch12/d38.xml" xpointer="d38"/>
