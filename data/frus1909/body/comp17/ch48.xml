    <text>
        <body>
            <div xml:id="ch48">

                <pb facs="0336" n="264" sameAs="frus:frus1909/pg264"/>

                <head>Patents convention between the United States and Germany</head>
                <p><hi rendition="#italic">Signed at Washington, February 23, 1909.</hi></p>
                <p><hi rendition="#italic">Ratification advised by the Senate, April 15,
                    1909.</hi></p>
                <p><hi rendition="#italic">Ratified by the President, April 20, 1909.</hi></p>
                <p><hi rendition="#italic">Ratified by Germany, June 15, 1909.</hi></p>
                <p><hi rendition="#italic">Ratifications exchanged at Washington July 14,
                    1909.</hi></p>
                <p><hi rendition="#italic">Proclaimed, August 1, 1909.</hi></p>

                <xi:include href="ch48/d252.xml" xpointer="d252"/>
