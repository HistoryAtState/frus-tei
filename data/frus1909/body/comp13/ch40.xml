    <text>
        <body>
            <div xml:id="ch40">

                <pb facs="0311" n="239" sameAs="frus:frus1909/pg239"/>

                <head>Arbitration convention between the United States and Denmark</head>
                <p><hi rendition="#italic">Signed at Washington, May 18, 1908.</hi></p>
                <p><hi rendition="#italic">Ratification advised by the Senate, May 20,
                    1908.</hi></p>
                <p><hi rendition="#italic">Ratified by the President, January 8, 1909.</hi></p>
                <p><hi rendition="#italic">Ratified by Denmark, February 15, 1909.</hi></p>
                <p><hi rendition="#italic">Ratifications exchanged at Washington, March 29,
                        1909.</hi></p>
                <p><hi rendition="#italic">Proclaimed, March 29, 1909.</hi></p>

                <xi:include href="ch40/d230.xml" xpointer="d230"/>
