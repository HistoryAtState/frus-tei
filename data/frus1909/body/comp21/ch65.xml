    <text>
        <body>
            <div xml:id="ch65">

                <pb facs="0431" n="359" sameAs="frus:frus1909/pg359"/>

                <head>Arbitration convention between the United States and Haiti</head>
                <p><hi rendition="#italic">Signed at Washington, January 7, 1909.</hi></p>
                <p><hi rendition="#italic">Ratification advised by the Senate, February 13,
                        1909.</hi></p>
                <p><hi rendition="#italic">Ratified by the President, March 1, 1909.</hi></p>
                <p><hi rendition="#italic">Ratified by Haiti, March 22, 1909.</hi></p>
                <p><hi rendition="#italic">Ratifications exchanged at Washington, November 15,
                        1909.</hi></p>
                <p><hi rendition="#italic">Proclaimed, November 16, 1909.</hi></p>

                <xi:include href="ch65/d322.xml" xpointer="d322"/>
