    <text>
        <body>
            <div xml:id="ch67">

                <pb facs="0436" n="364" sameAs="frus:frus1909/pg364"/>

                <head>Naturalization convention between the United States and Honduras</head>
                <p><hi rendition="#italic">Signed at Tegucigalpa, June 23, 1908.</hi></p>
                <p><hi rendition="#italic">Ratification advised by the Senate, December 10,
                        1908.</hi></p>
                <p><hi rendition="#italic">Ratified by the President, December 26, 1908.</hi></p>
                <p><hi rendition="#italic">Ratified by Honduras, April 7, 1909.</hi></p>
                <p><hi rendition="#italic">Ratifications exchanged at Tegucigalpa, April 16,
                        1909.</hi></p>
                <p><hi rendition="#italic">Proclaimed, June 8, 1909.</hi></p>

                <xi:include href="ch67/d325.xml" xpointer="d325"/>
