    <text>
        <body>
            <div xml:id="d328">

                <pb facs="0441" n="369" sameAs="frus:frus1909/pg369"/>

                <note rend="inline" type="source">File No. 21274/19–24.</note>
                <head><hi rendition="#italic">Minister Brown to the Secretary of State.</hi></head>
                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                                >Tegucigalpa</hi></placeName>, <date calendar="gregorian"
                            when="1909-10-06"><hi rendition="#italic">October 6,
                        1909</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 144.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to previous correspondence on the
                    subject, I have the honor to submit herewith copies of further correspondence
                    concerning the apparent intention of the Honduranean Government to enfarce to
                    the letter its laws of navigation in the case of the schooner <hi
                        rendition="#italic">George A. Lawry</hi>, of New York, owned by Consular
                    Agent Glynn at Trujillo.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Philip Brown.</hi></signed></closer>




                <xi:include href="d328-a1.xml" xpointer="d328-a1"/>
                <xi:include href="d328-a2.xml" xpointer="d328-a2"/>
