                <pb facs="0548" n="476" xml:id="pg476"/>

                <note rend="inline" type="source">File No. 15778/25–27.</note>
                <head><hi rendition="#italic">Chargé Weitzel to the
                            Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Panama</hi></placeName>, <date calendar="gregorian" when="1908-11-17"
                                ><hi rendition="#italic">November 17, 1908</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 386.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge receipt of
                    your No. 125, dated October 23, 1908, relative to the assault made by natives of
                    Panama on sailors of the U. S. S. <hi rendition="#italic">Buffalo</hi> on
                    September 28, last.</p>
                <p>In pursuance thereto I sent a copy of the instruction with a note, under date of
                    the 12th instant, to the secretary for foreign affairs, making formal demand for
                    the punishment of the assailants, including the police, for indemnity to the
                    injured, and for an apology to the Government of the United States.</p>
                <p>My note has not as yet been acknowledged, but for the purpose of completing the
                    record of my action in the matter before turning same over to Mr. Squiers, who
                    is expected to arrive tomorrow, I am transmitting herewith inclosure 1, copy of
                    said note.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">George T.
                    Weitzel.</hi></signed></closer>


                <xi:include href="d440-a1.xml" xpointer="d440-a1"/>
