    <text>
        <body>
            <div xml:id="d57">

                <pb facs="0115" n="43" sameAs="frus:frus1909/pg43"/>

                <note rend="inline" type="source">File No. 2372/30.</note>
                <head><hi rendition="#italic">The President of the United
                            States to the Vice President of
                        Brazil.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >The White House</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1909-06-15"><hi rendition="#italic">June 15,
                        1909</hi></date>.</dateline></opener>
                <p>In the name of my countrymen, and my own, I offer heartfelt condolence to the
                    stricken family and to the Brazilian people in their great personal and national
                    bereavement.</p>
                <closer><signed><hi rendition="#small-caps">Wm. H. Taft.</hi></signed></closer>
            </div>
        </body>
