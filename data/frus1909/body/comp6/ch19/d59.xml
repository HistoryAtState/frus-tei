    <text>
        <body>
            <div xml:id="d59">

                <pb facs="0115" n="43" sameAs="frus:frus1909/pg43"/>

                <note rend="inline" type="source">File No. 2372/39–40.</note>
                <head><hi rendition="#italic">Ambassador Dudley to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Petropolis</hi></placeName>, <date calendar="gregorian"
                            when="1909-06-21"><hi rendition="#italic">June 21,
                        1909</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith a copy
                    and translation of a telegram from the Brazilian Foreign Minister, received
                    after my dispatch of the 17th instant reporting President Penna’s death had <pb
                        facs="0116" n="44" xml:id="pg44"/> gone forward, acknowledging the receipt
                    of the condolences extended by this embassy and expressing grateful appreciation
                    of the action of the United States in the premises.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Irving B. Dudley.</hi></signed></closer>


                <xi:include href="d59-a1.xml" xpointer="d59-a1"/>
            </div>
        </body>
