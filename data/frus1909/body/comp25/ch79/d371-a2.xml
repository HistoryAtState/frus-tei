    <text>
        <body>
            <div xml:id="d371-a2">

                <pb facs="0479" n="407" sameAs="frus:frus1909/pg407"/>

                <opener><seg rendition="#center">[Inclosure 2.]</seg></opener>
                <head><hi rendition="#italic">Sir Edward Grey to
                            Count de Lalaing.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Foreign Office</hi></placeName>, <date calendar="gregorian"
                            when="1909-06-11"><hi rendition="#italic">June 11,
                        1909</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit to you
                    herewith the reply of His Majesty’s Government to the memorandum regarding the
                    Kongo question which you were good enough to leave with me on the 15th
                    March.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">E. Grey.</hi></signed></closer>
            </div>
        </body>
    </text>
