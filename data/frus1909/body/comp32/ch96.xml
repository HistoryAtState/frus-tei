            <div xml:id="ch96">

                <pb facs="0570" n="498" sameAs="frus:frus1909/pg498"/>

                <head>Arbitration convention between the United States and Peru</head>
                <p>Signed at Washington, December 5, 1908.</p>
                <p>Ratification advised by the Senate, December 10, 1908.</p>
                <p>Ratified by the President, March 1, 1909.</p>
                <p>Ratified by Peru, May 3, 1909.</p>
                <p>Ratifications exchanged at Washington, June 29, 1909.</p>
                <p>Proclaimed, June 30, 1909.</p>

                <xi:include href="ch96/d466.xml" xpointer="d466"/>
