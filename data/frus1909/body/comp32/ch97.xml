    <text>
        <body>
            <div xml:id="ch97">

                <pb facs="0572" n="500" xml:id="pg500"/>

                <head>Naturalization convention between the United States and Peru</head>
                <p><hi rendition="#italic">Signed at Lima, October 15, 1907.</hi></p>
                <p><hi rendition="#italic">Ratification advised by the Senate, February 19,
                        1908.</hi></p>
                <p><hi rendition="#italic">Ratified by the President, March 9, 1908.</hi></p>
                <p><hi rendition="#italic">Ratified by Peru, July 23, 1909.</hi></p>
                <p><hi rendition="#italic">Ratifications exchanged at Lima, July 23, 1909.</hi></p>
                <p><hi rendition="#italic">Proclaimed, September 2, 1909.</hi></p>

                <xi:include href="ch97/d467.xml" xpointer="d467"/>
