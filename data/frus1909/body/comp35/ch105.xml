    <text>
        <body>
            <div xml:id="ch105">

                <pb facs="0601" n="529" sameAs="frus:frus1909/pg529"/>

                <head>Arbitration convention between the United States and Salvador</head>
                <p><hi rendition="#italic">Signed at Washington, December 21, 1908.</hi></p>
                <p><hi rendition="#italic">Ratification advised by the Senate, January 6,
                    1909.</hi></p>
                <p><hi rendition="#italic">Ratified by the President, March 1, 1909.</hi></p>
                <p><hi rendition="#italic">Ratified by Salvador, June 14, 1909.</hi></p>
                <p><hi rendition="#italic">Ratifications exchanged at Washington, July 3,
                    1909.</hi></p>
                <p><hi rendition="#italic">Proclaimed, July 7, 1909.</hi></p>

                <xi:include href="ch105/d495.xml" xpointer="d495"/>
