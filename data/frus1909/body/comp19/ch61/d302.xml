            <div xml:id="d302">

                <pb facs="0411" n="339" sameAs="frus:frus1909/pg339"/>

                <note rend="inline" type="source">File No. 871/28–29.</note>
                <head><hi rendition="#italic">Chargé Einstein to the Secretary of State.</hi></head>
                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1909-07-26"><hi rendition="#italic">July 26,
                        1909</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1059.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose copy, with
                    translation, the note of the Ottoman Government to the four powers concerning
                    Crete, dated July 22, 1909.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Lewis Einstein.</hi></signed></closer>


                <xi:include href="d302-a1.xml" xpointer="d302-a1"/>
