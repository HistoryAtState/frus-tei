                <pb facs="0626" n="554" sameAs="frus:frus1909/pg554"/>

                <note rend="inline" type="source">File No. 8344A.</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to Minister Clay.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1909-04-30"><hi rendition="#italic">April 30,
                        1909</hi></date>.</dateline></opener>
                <p>For your information and for immediate communication to the Swiss Government I
                    quote the following letter of notification addressed to-day to the Swiss
                    minister here.<anchor n="1" xml:id="d517-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Wilson.</hi></signed></closer>
            </div>
        </body>
    </text>
