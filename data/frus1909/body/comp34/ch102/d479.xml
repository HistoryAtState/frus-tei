                <pb facs="0586" n="514" sameAs="frus:frus1909/pg514"/>

                <note rend="inline" type="source">File No. 10901/1.</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Russian Ambassador.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1908-01-07"><hi rendition="#italic">January 7,
                        1908</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 59.]</seg></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: In compliance with the request
                    contained in your note of the 7th instant, and in pursuance of existing treaty
                    stipulations between the United States and Russia, I have the honor to transmit
                    this department’s certificate, stating that the Government of Russia has
                    requested the extradition of Jan Janov Pouren, alias W. Kohks, alias Martin
                    Martinson, charged with murder, robbery and attempt at murder in Russia, and a
                    fugitive from its justice in the United States. Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Elihu Root.</hi></signed></closer>
            </div>
        </body>
    </text>
