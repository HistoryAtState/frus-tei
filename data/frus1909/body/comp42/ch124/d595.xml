    <text>
        <body>
            <div xml:id="d595">

                <pb facs="0688" n="616" xml:id="pg616"/>

                <note rend="inline" type="source">File No. 4832/89–91.</note>
                <head><hi rendition="#italic">Special Commissioner Buchanan to the Secretary of
                        State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1909-02-26"><hi rendition="#italic">February 26,
                        1909</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In connection with my mission to Venezuela,
                    I received instructions from the department authorizing me to communicate to the
                    Venezuelan Government the conditions under which the United States would return
                    its minister to Caracas.</p>
                <p>With regard to the above instruction, I beg to inclose herewith a copy of my note
                    of January 18 addressed to the minister for foreign affairs of Venezuela,
                    together with his original note replying thereto and a translation.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Wm. I. Buchanan.</hi></signed></closer>
            </div>
        </body>
    </text>
