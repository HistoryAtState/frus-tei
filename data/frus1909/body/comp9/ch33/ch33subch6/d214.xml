    <text>
        <body>
            <div xml:id="d214">

                <pb facs="0287" n="215" sameAs="frus:frus1909/pg215"/>

                <note rend="inline" type="source">File No. 14911/93–94.</note>
                <head><hi rendition="#italic">Minister Rockhill to
                        the Secretary of State.</hi></head>
                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Lelgation</hi>,<lb/><hi rendition="#italic"
                            >Peking</hi></placeName>, <date calendar="gregorian" when="1909-02-09"
                                ><hi rendition="#italic">February 9, 1909</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1101.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith copy
                    of a circular of the dean of the diplomatic body, which I received yesterday,
                    informing <pb facs="0288" n="216" xml:id="pg216"/> me that the Chinese
                    Government would invite the diplomatic body to be present at the funeral
                    ceremonies of His Majesty the late Emperor on May 1 next, and that it would see
                    with pleasure the sending by the various powers of special embassies for the
                    occasion.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. W. Rockhill.</hi></signed></closer>


                <xi:include href="d214-a1.xml" xpointer="d214-a1"/>
            </div>
