                <pb facs="0288" n="216" sameAs="frus:frus1909/pg216"/>

                <note rend="inline" type="source">File No. 14911/97–98.</note>
                <head><hi rendition="#italic">The Chinese Minister to the
                            Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Imperial Chinese Legation</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1909-05-03"><hi rendition="#italic">May 3,
                        1909</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 30.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose a translation
                    of an imperial message from His Majesty the Emperor of China to His Excellency
                    the President of the United States of America. I thank you to forward it to its
                    high destination.</p>
                <p>Accept, sir, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Wu Ting Fang.</hi></signed></closer>



                <xi:include href="d216-a1.xml" xpointer="d216-a1"/>
