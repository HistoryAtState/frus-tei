            <div xml:id="d84">

                <pb facs="0139" n="67" sameAs="frus:frus1909/pg67"/>

                <note rend="inline" type="source">File No. 20866/3.</note>
                <head><hi rendition="#italic">The Acting Secretary of State to Chargé
                    Fletcher.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1909-10-12"><hi rendition="#italic">October 12,
                        1909</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 640.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    No. 1182, of June 23, 1909, with which you transmit a copy of Mr. Bergholz’s No.
                    266, of May 26, 1909, and the original inclosures thereto, relative to the
                    recognition of the American Presbyterian Missionary Society.</p>
                <p>The department has replied on the subject directly to Mr. Bergholz and incloses
                    herewith a copy of its instruction.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alvey A. Adee.</hi></signed></closer>


                <xi:include href="d84-a1.xml" xpointer="d84-a1"/>
