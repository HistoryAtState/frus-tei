    <text>
        <body>
            <div xml:id="d105">

                <pb facs="0167" n="95" sameAs="frus:frus1909/pg95"/>

                <note rend="inline" type="source">File No. 774/574–575.</note>
                <head><hi rendition="#italic">Minister King to the
                            Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Bankok</hi></placeName>, <date calendar="gregorian" when="1909-01-02"
                                ><hi rendition="#italic">January 2, 1909</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 447.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose the copy of a
                    dispatch this day received from the foreign office in reply to your dispatch
                    from the State Department bearing the date of October 22,<anchor n="1"
                        xml:id="d105-f1"/> which was transmitted to the foreign office by me on
                    December 2, 1908.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Hamilton King.</hi></signed></closer>


                <xi:include href="d105-a1.xml" xpointer="d105-a1"/>
            </div>
        </body>
    </text>
