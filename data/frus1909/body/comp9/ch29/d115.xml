    <text>
        <body>
            <div xml:id="d115">

                <pb facs="0172" n="100" xml:id="pg100"/>

                <note rend="inline" type="source">File No. 774/572.</note>
                <head><hi rendition="#italic">Minister Beaupré to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">The
                            Hague</hi></placeName>, <date calendar="gregorian" when="1909-02-02"><hi
                                rendition="#italic">February 2, 1909</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 103.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to state that on receipt
                    of the department’s cablegram of the 27th ultimo,<anchor n="1" xml:id="d115-f1"
                    /> I immediately advised the minister for foreign affairs that the Governments
                    of Italy and Austria-Hungary had been invited to participate in the
                    deliberations of the Internationl Opium Conference at Shanghai and that his
                    excellency has this day acknowledged the receipt of said advice.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">A. M. Beaupré.</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d115-f1" n="1" xml:id="d115-f1-content">
