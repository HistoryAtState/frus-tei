    <text>
        <body>
            <div xml:id="d106">

                <pb facs="0167" n="95" sameAs="frus:frus1909/pg95"/>

                <note rend="inline" type="source">File No. 774/587–588.</note>
                <head><hi rendition="#italic">Minister Rockhill to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Peking</hi></placeName>, <date calendar="gregorian" when="1909-01-05"
                                ><hi rendition="#italic">January 5, 1909</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1078.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my dispatch No. 1027, of
                    October 15, 1908,<anchor n="2" xml:id="d106-f1"/> I have the honor to inclose
                    herewith copy of the regulations issued <pb facs="0168" n="96" xml:id="pg96"/>
                    by the imperial maritime customs, effective from January 1 of this year,
                    governing the importation of morphia and instruments for its injection.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. W. Rockhill.</hi></signed></closer>


                <xi:include href="d106-a1.xml" xpointer="d106-a1"/>
            </div>
        </body>
    </text>
