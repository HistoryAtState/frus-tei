                <pb facs="0172" n="100" sameAs="frus:frus1909/pg100"/>

                <note rend="inline" type="source">File No. 774/552–557.</note>
                <head><hi rendition="#italic">The Secretary of State to
                        Minister Rockhill.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1909-02-20"><hi rendition="#italic">February 20,
                        1909</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 550.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: There is inclosed herewith, for the
                    information of the legation, a copy of the bill prohibiting the importation of
                    opium into the United States which was recently passed by the Congress and
                    approved by the President.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Robert Bacon.</hi></signed></closer>


                <xi:include href="d116-a1.xml" xpointer="d116-a1"/>
