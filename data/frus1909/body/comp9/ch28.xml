    <text>
        <body>
            <div xml:id="ch28">

                <pb facs="0165" n="93" xml:id="pg93"/>

                <head>Arbitration convention between the United States and China</head>
                <p><hi rendition="#italic">Signed at Washington, October 8, 1908.</hi></p>
                <p><hi rendition="#italic">Ratification advised by the Senate, December 10,
                        1908.</hi></p>
                <p><hi rendition="#italic">Ratified by the President, March 1, 1909.</hi></p>
                <p><hi rendition="#italic">Ratified by China, February 12, 1909.</hi></p>
                <p><hi rendition="#italic">Ratifications exchanged at Washington, April 6,
                        1909.</hi></p>
                <p><hi rendition="#italic">Proclaimed, April 6, 1909.</hi></p>

                <xi:include href="ch28/d104.xml" xpointer="d104"/>
