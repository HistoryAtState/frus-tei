            <div xml:id="ch123">

                <pb facs="0678" n="606" xml:id="pg606"/>

                <head>Naturalization convention between the United States and Uruguay</head>
                <p><hi rendition="#italic">Signed at Montevideo, August 10, 1908.</hi></p>
                <p><hi rendition="#italic">Ratification advised by the Senate, December 10,
                        1908.</hi></p>
                <p><hi rendition="#italic">Ratified by the President, December 26, 1908.</hi></p>
                <p><hi rendition="#italic">Ratified by Uruguay, May 14, 1909.</hi></p>
                <p><hi rendition="#italic">Ratifications exchanged at Montevideo, May 14,
                    1909.</hi></p>
                <p><hi rendition="#italic">Proclaimed, June 19, 1909.</hi></p>

                <xi:include href="ch123/d581.xml" xpointer="d581"/>
