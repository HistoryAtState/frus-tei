            <div xml:id="ch122">

                <pb facs="0676" n="604" sameAs="frus:frus1909/pg604"/>

                <head>Arbitration convention between the United States and Paraguay</head>
                <p>Signed at Asuncion March 13, 1909.</p>
                <p>Ratification advised by the Senate July 30, 1909.</p>
                <p>Ratified by the President August 10, 1909.</p>
                <p>Ratified by Paraguay September 28, 1909.</p>
                <p>Ratifications exchanged at Asuncion October 2, 1909.</p>
                <p>Proclaimed November 11, 1909.</p>

                <xi:include href="ch122/d580.xml" xpointer="d580"/>
