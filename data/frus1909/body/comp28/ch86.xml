    <text>
        <body>
            <div xml:id="ch86">

                <pb facs="0514" n="442" sameAs="frus:frus1909/pg442"/>

                <head>Arbitration convention between the United States and the Netherlands</head>
                <p><hi rendition="#italic">Signed at Washington, May 2, 1908.</hi></p>
                <p><hi rendition="#italic">Ratification advised by the Senate, May 6, 1908.</hi></p>
                <p><hi rendition="#italic">Ratified by the President, January 8, 1909.</hi></p>
                <p><hi rendition="#italic">Ratified by the Netherlands, March 5, 1909.</hi></p>
                <p><hi rendition="#italic">Ratifications exchanged at Washington, March 25,
                        1909.</hi></p>
                <p><hi rendition="#italic">Proclaimed, March 25, 1909.</hi></p>

                <xi:include href="ch86/d401.xml" xpointer="d401"/>
