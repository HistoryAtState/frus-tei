                <pb facs="0418" n="346" sameAs="frus:frus1909/pg346"/>

                <note rend="inline" type="source">File No. 21267/4.</note>
                <head><hi rendition="#italic">Minister Sands to the
                            Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Guatemala</hi></placeName>, <date calendar="gregorian"
                            when="1909-11-24"><hi rendition="#italic">November 24,
                        1909</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 17.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose copy and
                    translation of the acknowledgment of the foreign office of my note of November
                    1, communicating the department’s view of decree 699, on the presumption of
                    guilt in case of the burning of insured premises.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. F. Sands.</hi></signed></closer>


                <xi:include href="d308-a1.xml" xpointer="d308-a1"/>
