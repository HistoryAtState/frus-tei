                <pb facs="0417" n="345" sameAs="frus:frus1909/pg345"/>

                <note rend="inline" type="source">File No. 21267/2–3.</note>
                <head><hi rendition="#italic">Minister Sands to the
                            Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Guatemala</hi></placeName>, <date calendar="gregorian"
                            when="1909-11-01"><hi rendition="#italic">November 1,
                        1909</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge receipt of
                    the department’s No. 5, dated October 7 last.</p>
                <p>I have communicated the department’s view of the Guatemalan executive decree 699,
                    on the presumption of guilt in case of the burning of insured premises, in a
                    note to the foreign office.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. F. Sands.</hi></signed></closer>



                <xi:include href="d307-a1.xml" xpointer="d307-a1"/>
