                <pb facs="0465" n="393" sameAs="frus:frus1909/pg393"/>

                <note rend="inline" type="source">File No. 697/48.</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to Chargé Garrett.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1909-08-18"><hi rendition="#italic">August 18,
                        1909</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 10.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose a copy of a dispatch from the
                    American consul at Catania, reporting the use of the flag of the United States
                    as a sign for saloons and bars in Messina, Catania, and other Italian
                    cities.</p>
                <p>You will inquire whether the Italian law controls the display of foreign flags,
                    or whether there are any other means which could be employed to prevent this
                    abuse of our national emblem.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alvey A. Adee.</hi></signed></closer>



                <xi:include href="d362-a1.xml" xpointer="d362-a1"/>
            </div>
