    <text>
        <body>
            <div xml:id="ch72">

                <pb facs="0457" n="385" xml:id="pg385"/>

                <head>Arbitration convention between the United States and Italy</head>
                <p><hi rendition="#italic">Signed at Washington, March 28, 1908.</hi></p>
                <p><hi rendition="#italic">Ratification advised by the Senate, April 2,
                    1908.</hi></p>
                <p><hi rendition="#italic">Ratified by the President, June 19, 1908.</hi></p>
                <p><hi rendition="#italic">Ratified by Italy, June 19, 1908.</hi></p>
                <p><hi rendition="#italic">Ratifications exchanged at Washington, January 22,
                        1909.</hi></p>
                <p><hi rendition="#italic">Proclaimed, January 25, 1909.</hi></p>

                <xi:include href="ch72/d353.xml" xpointer="d353"/>
