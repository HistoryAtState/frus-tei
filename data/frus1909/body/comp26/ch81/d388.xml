                <pb facs="0500" n="428" sameAs="frus:frus1909/pg428"/>

                <note rend="inline" type="source">File No. 20292/44.</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to Ambassador Thompson.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1909-10-02"><hi rendition="#italic">October 2,
                        1909</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 787.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to the department’s telegram of
                    the 30th ultimo I inclose herewith, for your information, a revised copy of the
                    toast which President Taft will offer to the health of the President of Mexico
                    at the banquet in Juarez.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alvey A. Adee.</hi></signed></closer>


                <xi:include href="d388-a1.xml" xpointer="d388-a1"/>
