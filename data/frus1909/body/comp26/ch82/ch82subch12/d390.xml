    <text>
        <body>
            <div xml:id="d390">

                <pb facs="0503" n="431" sameAs="frus:frus1909/pg431"/>

                <note rend="inline" type="source">File No. 15660/3–5.</note>
                <head><hi rendition="#italic">Ambassador Thompson
                        to the Secretary of State.</hi></head>
                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Mexico</hi></placeName>, <date calendar="gregorian" when="1909-03-16"
                                ><hi rendition="#italic">March 16, 1909</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1596.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose copy and translation of a note
                    from the foreign office under date of the 11th instant, in which is transmitted
                    the Presidential decision granting the extradition of the Mexican Teo-dosio
                    Jiminez.</p>
                <p>The foreign office requests that this decision be communicated to my Government,
                    as a precedent for the rendition by a country of its own citizens, in accordance
                    with Article IV of the extradition treaty between Mexico and the United
                    States.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">D. E. Thompson.</hi></signed></closer>



                <xi:include href="d390-a1.xml" xpointer="d390-a1"/>
