                <pb facs="0657" n="585" sameAs="frus:frus1909/pg585"/>

                <note rend="inline" type="source">File No. 10044/376.</note>
                <head><hi rendition="#italic">Ambassador Straus to the Secretary of
                    State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1909-11-19"><hi rendition="#italic">November 19,
                        1909</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 41]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith for
                    the files of the department the copy, in duplicate, of the Ottoman Constitution,
                    together with unofficial French and English translations of the same as such
                    copies do not appear to have been previously transmitted by the embassy.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Oscar S. Straus.</hi></signed></closer>


                <xi:include href="d565-a1.xml" xpointer="d565-a1"/>
