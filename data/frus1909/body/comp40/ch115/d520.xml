    <text>
        <body>
            <div xml:id="d520">

                <pb facs="0629" n="557" sameAs="frus:frus1909/pg557"/>

                <note rend="inline" type="source">File No. 19274/22–23.</note>
                <head><hi rendition="#italic">The Acting Secretary of State to Chargé
                    Einstein.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1909-07-07"><hi rendition="#italic">July 7,
                        1909</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 529.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose for the embassy’s files a copy of
                    a letter<anchor n="2" xml:id="d520-f1"/> from the Hon. William S. Bennett, M.
                    C., transmitting a petition<anchor n="2" xml:id="d520-f2"/> relating to the
                    recent massacres in Asia Minor, which the Armenian Evangelical Alliance of
                    America has addressed to the President. I also inclose a copy of the
                    department’s reply to Mr. Bennett.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alvey A. Adee.</hi></signed></closer>


                <xi:include href="d520-a1.xml" xpointer="d520-a1"/>
            </div>
        </body>
    </text>
