                <pb facs="0607" n="535" sameAs="frus:frus1909/pg535"/>

                <note rend="inline" type="source">File No. 10883/32–38.</note>
                <head><hi rendition="#italic">Minister King to the
                            Secretary of State.</hi></head>
                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Bangkok</hi></placeName>, <date calendar="gregorian" when="1909-05-13"
                                ><hi rendition="#italic">May 13, 1909</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 484.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit a copy of the
                    Anglo-Siamese treaty with associated papers.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Hamilton King.</hi></signed></closer>









