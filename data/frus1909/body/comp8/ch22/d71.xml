            <div xml:id="d71">

                <pb facs="0121" n="49" sameAs="frus:frus1909/pg49"/>

                <note rend="inline" type="source">File No. 15077/58.</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to Minister Hicks.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1909-02-13"><hi rendition="#italic">February 13,
                        1909</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 152.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: There is inclosed herewith a copy of a
                        note<anchor n="1" xml:id="d71-f1"/> received by the department from the
                    Chinese minister, expressing the appreciation of his Government of the
                    arrangements made in Chile and other countries for the protection of Chinese
                    subjects by American diplomatic and consular officers.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Robert Bacon.</hi></signed></closer>
            </div>
        </body>
    </text>
