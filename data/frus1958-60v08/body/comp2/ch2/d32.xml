    <text>
        <body>
            <div xml:id="d32">

                <pb facs="0085" n="60" sameAs="frus:frus1958-60v08/pg60"/>

                <head>32. Memorandum From Acting Secretary of State Herter to President Eisenhower<anchor n="0" xml:id="d32-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1958-11-13">November 13,
                        1958</date>.</dateline></opener>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>Status Report on Berlin in the Light of the Khrushchev Statement of November 10</item>
                </list>
                <p>In response to your request for information regarding the present Berlin
                    situation resulting from the Khrushchev
                    speech of November 10, I enclose a status report on this subject.</p>
                <closer><signed><hi rendition="#bold">Christian A.
                                Herter</hi></signed></closer>



                <xi:include href="d32-a1.xml" xpointer="d32-a1"/>
            </div>
        </body>
