    <text>
        <body>
            <div xml:id="d432-a2">

                <pb facs="0479" n="413" xml:id="pg413"/>

                <opener>
                    <seg rendition="#center">[Enclosure 2—Translation]</seg>
                </opener>
                <head><hi rendition="#italic">The Mexican Ministry for Foreign
                            Affairs to the American
                    Embassy</hi></head>
                <opener>
                    <dateline rendition="#float-right"><date calendar="gregorian" when="1934-02-09"
                                ><hi rendition="#small-caps">February</hi> 9,
                        1934</date>.</dateline>
                </opener>
                <p rendition="#center"><hi rendition="#small-caps">Memorandum</hi> B</p>
                <p rendition="#flush">Subject: Bases for an En Bloc Settlement of Claims Covered by
                    the Special Convention of 1923.</p>
                <p>To be deducted from the amount recorded: <list>
                        <label>1.</label>
                        <item>— <list>
                                <label><hi rendition="#italic">a</hi>)</label>
                                <item>Claims duplicated in the same Commission.</item>
                                <label><hi rendition="#italic">b</hi>)</label>
                                <item>Claims withdrawn and claims decided.</item>
                                <label><hi rendition="#italic">c</hi>)</label>
                                <item>50% of the claims filed with (<hi rendition="#italic"
                                        >duplicados en</hi>) both Commissions.</item>
                            </list></item>
                        <label>2.</label>
                        <item>— <list>
                                <item>Calculate 2.60% of the net result.</item>
                            </list></item>
                    </list></p>
                <p>The term of payment to be fifteen years, without interest.</p>
            </div>
        </body>
    </text>
