            <div xml:id="d103">

                <pb facs="0173" n="107" sameAs="frus:frus1934v05/pg107"/>

                <note rend="inline" type="source">837.01/70: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Personal Representative
                        of the President</hi> (<hi rendition="#italic">Caffery</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1934-01-23">January 23, 1934</date>.</dateline>
                </opener>
                <p>15. Under authorization of the President you will please extend immediately to
                    the Government of Cuba on behalf of the United States a formal and cordial
                    recognition.</p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
    </text>
