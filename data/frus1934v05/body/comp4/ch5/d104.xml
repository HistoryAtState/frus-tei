    <text>
        <body>
            <div xml:id="d104">

                <pb facs="0173" n="107" sameAs="frus:frus1934v05/pg107"/>

                <note rend="inline" type="source">837.01/71: Telegram</note>
                <head><hi rendition="#italic">The Personal Representative of the President</hi> (<hi
                        rendition="#italic">Caffery</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Habana</hi></placeName>, <date calendar="gregorian"
                            when="1934-01-23T16:00:00-05:00">January 23, 1934—4
                        p.m.</date><lb/>[Received 5:02 p.m.]</dateline>
                </opener>
                <p>68. Department’s telegram No. 15, January 23rd. Formal recognition extended at 4
                    p.m. today.<anchor n="17" xml:id="d104-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Caffery</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d104-f1" n="17" xml:id="d104-f1-content">
                <p>Mr. Jefferson Caffery presented his credentials as American Ambassador to Cuba on
                    February 28, 1934. Dr. Márquez Sterling presented his credentials as Cuban
                    Ambassador to the United States on January 31, 1934. (123 C11/400; Department of
                    State, <hi rendition="#italic">Press Releases</hi>, February 3, 1934, pp.
                    69–70.)</p>
            </note>
        </listAnnotation>
    </standOff>
