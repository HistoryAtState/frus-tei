    <text>
        <body>
            <div xml:id="d169">

                <pb facs="0248" n="182" sameAs="frus:frus1934v05/pg182"/>

                <note rend="inline" type="source">811.6135/108</note>
                <head><hi rendition="#italic">The Cuban Ambassador</hi> (<hi
                            rendition="#italic">Márquez Sterling</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1934-02-12">February 12, 1934</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I have the honor to inform Your
                    Excellency that my Government has instructed me to transmit its expression of
                    gratitude <pb facs="0249" n="183" xml:id="pg183"/> for the part of the message
                    of President Roosevelt to the United States Congress regarding sugar,<anchor
                        n="76" xml:id="d169-f1"/> with relation to Cuba. This message has conveyed
                    to the distressed people of Cuba the hopes of a prosperous future.</p>
                <p>I avail myself [etc.]</p>
                <closer><signed>M. <hi rendition="#small-caps">Márquez
                    Sterling</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d169-f1" n="76" xml:id="d169-f1-content">
