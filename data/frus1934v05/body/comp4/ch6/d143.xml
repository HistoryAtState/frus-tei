                <pb facs="0230" n="164" xml:id="pg164"/>

                <note rend="inline" type="source">611.3731/906: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Cuba</hi> (<hi
                            rendition="#italic">Caffery</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Habana</hi></placeName>, <date calendar="gregorian"
                            when="1934-08-15T09:00:00-05:00">August 15, 1934—9
                        a.m.</date><lb/>[Received 10:30 a.m.]</dateline>
                </opener>
                <p>393. Desire Department’s views on immediate reduction consular invoice fee set
                    forth in my telegram No. 380, August 10, noon.</p>
                <closer><signed><hi rendition="#small-caps">Caffery</hi></signed></closer>
            </div>
        </body>
