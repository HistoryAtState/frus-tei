    <text>
        <body>
            <div xml:id="d295">

                <pb facs="0353" n="287" sameAs="frus:frus1934v05/pg287"/>

                <note rend="inline" type="source">611.1431/70a: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Minister in
                        Guatemala</hi> (<hi rendition="#italic">Hanna</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1934-09-10T20:00:00-04:00">September 10, 1934—8
                        p.m.</date></dateline>
                </opener>
                <p>30. Public notice of intention to negotiate a foreign trade agreement with
                    Guatemala was given September 7.<anchor n="6" xml:id="d295-f1"/> Please inform
                    Minister for Foreign Affairs.</p>
                <closer><signed><hi rendition="#small-caps">Phillips</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d295-f1" n="6" xml:id="d295-f1-content">
                <p>For text of public notice and statistics on trade between the United States and
                    Guatemala, issued by the Department of State on September 7, 1934, see
                    Department of State, <hi rendition="#italic">Press Releases</hi>, September 8,
                    1934, pp. 170–173.</p>
            </note>
        </listAnnotation>
    </standOff>
