    <text>
        <body>
            <div xml:id="d565">

                <pb facs="0636" n="570" sameAs="frus:frus1934v05/pg570"/>

                <note rend="inline" type="source">417.00/493: Telegram</note>
                <head><hi rendition="#italic">The Minister in Nicaragua</hi> (<hi
                        rendition="#italic">Lane</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Managua</hi></placeName>, <date calendar="gregorian"
                            when="1934-03-10T10:00:00-05:45">March 10, 1934—10
                        a.m.</date><lb/>[Received 12:34 p.m.]</dateline>
                </opener>
                <p>96. New law has gone into effect extending time limit for presenting claims to
                    Nicaraguan Claims Commission until April 30, 1934. Full text follows by air
                        mail.<anchor n="89" xml:id="d565-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Lane</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d565-f1" n="89" xml:id="d565-f1-content">
                <p>For text of the law, signed by the President February 20, 1934, see <hi
                        rendition="#italic">La Gaceta-Diario Oficial</hi>, March 8, 1934, p.
                    457.</p>
            </note>
        </listAnnotation>
    </standOff>
