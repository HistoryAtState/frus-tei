            <div xml:id="d228">

                <pb facs="0306" n="240" sameAs="frus:frus1934v05/pg240"/>

                <note rend="inline" type="source">816.01/378: Telegram</note>
                <head><hi rendition="#italic">The Minister in Nicaragua</hi> (<hi rendition="#italic">Lane</hi>) <hi rendition="#italic"
                        >to the Acting Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Managua</hi></placeName>, <date calendar="gregorian"
                            when="1934-01-18T19:00:00-05:45">January 18, 1934—7
                        p.m.</date><lb/>[Received 9 p.m.]</dateline>
                </opener>
                <p>17. I have not communicated to Niearaguan Government information contained in
                    Lawton’s January 18, noon.<anchor n="20" xml:id="d228-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Lane</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d228-f1" n="20" xml:id="d228-f1-content">
                <p>See last sentence of telegram No. 3, <ref target="#pg237">p. 237</ref>.</p>
            </note>
