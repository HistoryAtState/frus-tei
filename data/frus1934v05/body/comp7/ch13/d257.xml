    <text>
        <body>
            <div xml:id="d257">

                <pb facs="0322" n="256" sameAs="frus:frus1934v05/pg256"/>

                <note rend="inline" type="source">816.01/412: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Chargé in El Salvador</hi> (<hi rendition="#italic"
                            >McCafferty</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1934-01-26T13:00:00-05:00">January 26, 1934—1
                        p.m.</date></dateline>
                </opener>
                <p>4. Under authorization of the President please extend on behalf of the United
                    States a formal and cordial recognition to the Government of El Salvador.<anchor
                        n="35" xml:id="d257-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d257-f1" n="35" xml:id="d257-f1-content">
                <p>The Chargé extended recognition late in the afternoon of January 26, in a note
                    which he delivered personally to the Minister of Foreign Affairs
                    (816.01/425).</p>
            </note>
        </listAnnotation>
    </standOff>
