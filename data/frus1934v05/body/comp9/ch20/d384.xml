            <div xml:id="d384">

                <pb facs="0432" n="366" xml:id="pg366"/>

                <note rend="inline" type="source">838.516/291: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Minister in Haiti</hi>
                        (<hi rendition="#italic">Armour</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1934-05-26T13:00:00-04:00">May 26, 1934—1 p.m.</date></dateline>
                </opener>
                <p>37. Your 55, May 25, 2 p.m. We agree to insertion in article I of the treaty of
                    the phrase requested by the Haitian Government.</p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
    </text>
