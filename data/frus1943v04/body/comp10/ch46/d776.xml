    <text>
        <body>
            <div xml:id="d776">

                <pb facs="0739" n="727" sameAs="frus:frus1943v04/pg727"/>

                <note rend="inline" type="source">121.67/3686</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Spain</hi> (<hi rendition="#italic"
                        >Hayes</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1026</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Madrid</hi></placeName>, <date
                            calendar="gregorian" when="1943-06-24">June 24,
                        1943</date>.<lb/>[Received July 5.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to refer to my telegram
                    No. 1495 of 2 p.m., June 5, 1943,<anchor n="12" xml:id="d776-f1"/> in response
                    to the Department’s telegram No. 1251, 10 a.m., June 2, regarding the detention
                    on May 20 by Spanish customs officers at Arbaoua of two American couriers en
                    route from Tangier to Rabat.</p>
                <p>A copy of my Note of protest, No. 1014 dated June 4, to the Foreign Minister and
                    a copy and translation of his reply dated June 16 are enclosed.</p>
                <p>Respectfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Carlton</hi> J. H. <hi rendition="#small-caps"
                            >Hayes</hi>
                    </signed>
                </closer>




                <xi:include href="d776-a1.xml" xpointer="d776-a1"/>
                <xi:include href="d776-a2.xml" xpointer="d776-a2"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d776-f1" n="12" xml:id="d776-f1-content">
                <p>Not printed (121.67/3611); it reported that representations had been made in
                    accordance with the Department’s telegram No. 1251, June 2, <hi
                        rendition="#italic">supra</hi>.</p>
            </note>
        </listAnnotation>
    </standOff>
