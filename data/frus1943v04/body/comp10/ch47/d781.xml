    <text>
        <body>
            <div xml:id="d781">

                <pb facs="0744" n="732" sameAs="frus:frus1943v04/pg732"/>

                <note rend="inline" type="source">740.00114A European War 1939/242: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Spain</hi> (<hi
                            rendition="#italic">Hayes</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Madrid</hi></placeName>, <date
                            calendar="gregorian" when="1943-02-04T00:00:00+01:00">February 4,
                            1943—midnight</date>.<lb/>[Received February 5—9:54 p.m.]</dateline>
                </opener>
                <p>291. My 124, January 18, 6 p.m.<anchor n="23" xml:id="d781-f1"/> Air Ministry has
                    agreed to release all remaining American aviation personnel in Spain and Spanish
                    Morocco, latter to be released to Gibraltar without necessity of coming to
                    Madrid.</p>
                <p>Repeated to Tangier.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hayes</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
