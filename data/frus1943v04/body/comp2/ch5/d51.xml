    <text>
        <body>
            <div xml:id="d51">

                <pb facs="0064" n="52" xml:id="pg52"/>

                <note rend="inline" type="source">894.20290H/14: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in Afghanistan</hi> (<hi rendition="#italic">Engert</hi>) <hi rendition="#italic"
                        >to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Kabul</hi></placeName>, <date
                            calendar="gregorian" when="1943-10-13T20:00:00+04:00">October 13, 1943—8
                            p.m.</date>
                        <lb/> [Received October 15—10:23 a.m.]</dateline>
                </opener>
                <p>179. Four Japanese engineers mentioned in my despatch 228, July 10,<anchor n="65"
                        xml:id="d51-f1"/> left Kabul for Japan via Russia September 24 and crossed
                    Russian frontier at Termez September 29. Please inform Moscow.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Engert</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
