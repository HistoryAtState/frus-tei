    <text>
        <body>
            <div xml:id="d260">

                <pb facs="0243" n="231" sameAs="frus:frus1943v04/pg231"/>

                <note rend="inline" type="source">845.001/85: Telegram</note>
                <head>
                    <hi rendition="#italic">The Officer in Charge at New Delhi</hi> (<hi rendition="#italic">Merrell</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">New Delhi</hi></placeName>, <date
                            calendar="gregorian" when="1943-10-19T18:00:00+06:30">October 19, 1943—6
                            p.m.</date>
                        <lb/> [Received 8:03 p.m.]</dateline>
                </opener>
                <p>765. Linlithgow departed by air this morning and Wavell takes oath as Viceroy
                    tomorrow morning.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Merrell</hi>
                    </signed>
                </closer>
            </div>
        </body>
