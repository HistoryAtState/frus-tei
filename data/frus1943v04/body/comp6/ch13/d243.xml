    <text>
        <body>
            <div xml:id="d243">

                <pb facs="0232" n="220" sameAs="frus:frus1943v04/pg220"/>

                <note rend="inline" type="source">123 P 54/597: Telegram</note>
                <head>
                    <hi rendition="#italic">The Officer in Charge at New Delhi</hi> (<hi rendition="#italic">Merrell</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">New Delhi</hi></placeName>, <date
                            calendar="gregorian" when="1943-04-29T12:00:00+06:30">April 29,
                            1943—noon</date>.<lb/>[Received 8 p.m.]</dateline>
                </opener>
                <p>318. Mr. Phillips accompanied by Major Heppner<anchor n="45" xml:id="d243-f1"/>
                    and Berry<anchor n="46" xml:id="d243-f2"/> departed by air this morning for
                    Karachi en route to the United States. I have assumed Charge.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Merrell</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d243-f1" n="45" xml:id="d243-f1-content">
                <p>Maj. Richard Heppner, personal assistant to Ambassador Phillips.</p>
            </note>
            <note corresp="#d243-f2" n="46" xml:id="d243-f2-content">
                <p>James Lampton Berry, Secretary in the American Mission at New Delhi.</p>
            </note>
        </listAnnotation>
    </standOff>
