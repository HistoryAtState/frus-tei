                <pb facs="0192" n="180" sameAs="frus:frus1943v04/pg180"/>

                <note rend="inline" type="source">123 P 54/569: Telegram</note>
                <head>
                    <hi rendition="#italic">Mr. William Phillips, Personal Representative of
                        President Roosevelt in India, to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">New Delhi</hi></placeName>, <date
                            calendar="gregorian" when="1943-01-08">January 8,
                        1943</date>.<lb/>[Received January 8—3:59 p.m.]</dateline>
                </opener>
                <p>12. Arrived today, assumed charge.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Phillips</hi>
                    </signed>
                </closer>
            </div>
        </body>
