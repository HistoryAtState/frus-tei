    <text>
        <body>
            <div xml:id="d225">

                <pb facs="0220" n="208" xml:id="pg208"/>

                <note rend="inline" type="source">123 P 54/585: Telegram</note>
                <head>
                    <hi rendition="#italic">Mr. William Phillips, Personal Representative of
                        President Roosevelt in India, to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">New Delhi</hi></placeName>, <date
                            calendar="gregorian" when="1943-03-05T12:00:00+06:30">March 5,
                            1943—noon</date>.<lb/>[Received March 5—9:23 a.m.]</dateline>
                </opener>
                <p>207. I am leaving today for Bombay and the south and shall return to Delhi about
                    April 1.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Phillips</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
