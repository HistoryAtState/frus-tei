            <div xml:id="d330">

                <pb facs="0303" n="291" sameAs="frus:frus1943v04/pg291"/>

                <note rend="inline" type="source">811.71245/22: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in the United Kingdom</hi> (<hi
                            rendition="#italic">Winant</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-06-10T22:00:00-04:00">June 10, 1943—10
                            p.m.</date>
                    </dateline>
                </opener>
                <p>3621. Contents of your 3874, June 8, have been duly noted and communicated to
                    United Press.</p>
                <p>Please continue to impress upon British authorities importance which this
                    Government attaches to United Press obtaining adequate teletype service in
                    India.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
