            <div xml:id="d268">

                <pb facs="0248" n="236" xml:id="pg236"/>

                <note rend="inline" type="source">740.00118 European War (1939)/1885:
                    Telegram</note>
                <head>
                    <hi rendition="#italic">Mr. William Phillips, Personal Representative of
                        President Roosevelt in India, to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">New Delhi</hi></placeName>, <date
                            calendar="gregorian" when="1943-03-26">March 26,
                        1943</date>.<lb/>[Received March 26—10:08 a.m.]</dateline>
                </opener>
                <p>240. Department’s 161, 18th. Government of India has now informed Mission that
                    assignments will be agreeable.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Phillips</hi>
                    </signed>
                </closer>
            </div>
        </body>
