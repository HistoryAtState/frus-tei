    <text>
        <body>
            <div xml:id="d273">

                <pb facs="0250" n="238" xml:id="pg238"/>

                <note rend="inline" type="source">121.5445/17: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the United Kingdom</hi> (<hi rendition="#italic">Winant</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1943-05-18">May 18,
                        1943</date>.<lb/>[Received May 18—12:15 p.m.]</dateline>
                </opener>
                <p>3422. Department’s 2877, 6th.<anchor n="76" xml:id="d273-f1"/> Foreign Office has
                    today advised that the title “Military Observers with personal status of
                    Military Attaché and Assistant Military Attachés has been approved by the
                    Government of India and the interested authorities here.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Winant</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
