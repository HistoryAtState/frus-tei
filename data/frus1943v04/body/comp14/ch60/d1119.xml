    <text>
        <body>
            <div xml:id="d1119">

                <pb facs="1074" n="1062" sameAs="frus:frus1943v04/pg1062"/>

                <note rend="inline" type="source">740.0011 European War 1939/27976</note>
                <head>
                    <hi rendition="#italic">The President of Turkey</hi> (<hi rendition="#italic"
                        >Inönü</hi>) <hi rendition="#italic">to President Roosevelt </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Translation]<anchor n="9" xml:id="d1119-f1"/>
                    </seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Ankara</hi></placeName>, <date
                            calendar="gregorian" when="1943-02-02">February 2,
                        1943</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">The President</hi>: Mr. Winston Churchill has been
                    good enough to transmit to me, Mr. President, the friendly personal message you
                    so thoughtfully extended to me. My great pleasure in talking with the British
                    Prime Minister was heightened by the evidence of your moral support.</p>
                <p>Please accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Ismet Inönü</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
