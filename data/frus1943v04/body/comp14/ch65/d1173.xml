            <div xml:id="d1173">

                <pb facs="1117" n="1105" sameAs="frus:frus1943v04/pg1105"/>

                <note rend="inline" type="source">867.24/663: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Turkey</hi> (<hi rendition="#italic"
                            >Steinhardt</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-07-12T20:00:00-04:00">July 12, 1943—8
                            p.m.</date>
                    </dateline>
                </opener>
                <p>600. Your telegram no. 646, April 5, 3 p.m. Please report any further reaction to
                    our proposal you may have received from the Turks.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
