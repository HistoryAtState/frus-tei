    <text>
        <body>
            <div xml:id="d100">

                <pb facs="0096" n="84" sameAs="frus:frus1943v04/pg84"/>

                <note rend="inline" type="source">884.24/95½: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Consul at Asmara</hi> (<hi rendition="#italic"
                            >Smith</hi>)</head>
                <opener>
                    <seg rendition="#center">[Extract]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-02-06T22:00:00-04:00">February 6,
                            1943—10 p.m.</date>
                    </dateline>
                </opener>
                <p>24. Your no. 13, February 1, 10 a.m. You are authorized to accompany General
                    Maxwell and Colonel Clark to Addis Ababa.</p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
