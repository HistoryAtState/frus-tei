    <text>
        <body>
            <div xml:id="d113-a1">

                <pb facs="0115" n="103" sameAs="frus:frus1943v04/pg103"/>

                <opener>
                    <seg rendition="#center">[Enclosure]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">Statement on Amount of Loan and Credit Requested by the
                        Ethiopian Government</hi><anchor n="29" xml:id="d113-f1"/>
                </head>
                <table cols="2" rows="3">
                    <row role="label">
                        <cell rendition="#hanging-indent">Credit to be made available in the United
                            States in cash balance and to purchase consumers goods</cell>
                        <cell role="num">$40,000,000</cell>
                    </row>
                    <row>
                        <cell rendition="#hanging-indent">Silver Loan under Lend Lease</cell>
                        <cell rendition="#underline" role="num">$10,000,000</cell>
                    </row>
                    <row>
                        <cell rendition="#float-right">Total</cell>
                        <cell role="num">$50,000,000</cell>
                    </row>
                </table>
                <p>The credit may be supplied over a period, the terms and conditions of which to be
                    specified.</p>
            </div>
        </body>
    </text>
