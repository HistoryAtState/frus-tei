    <text>
        <body>
            <div xml:id="d123">

                <pb facs="0127" n="115" sameAs="frus:frus1943v04/pg115"/>

                <note rend="inline" type="source">884.24/147b: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Minister in Ethiopia</hi> (<hi
                            rendition="#italic">Caldwell</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-10-22T23:00:00-04:00">October 22,
                            1943—11 p.m.</date>
                    </dateline>
                </opener>
                <p>12. Military equipment for 5,000 men has been approved. Plans for shipment now
                    being worked out. Military radio equipment critical <pb facs="0128" n="116"
                        xml:id="pg116"/> and cannot be supplied at present. Finger<anchor n="45"
                        xml:id="d123-f1"/> and Anis are consulting with appropriate agencies in
                    regard to transport planes.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stettinius</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d123-f1" n="45" xml:id="d123-f1-content">
                <p>John W. Finger, who had been engaged by the Ethiopian Government to assist on
                    lend-lease aid, etc.</p>
            </note>
        </listAnnotation>
    </standOff>
