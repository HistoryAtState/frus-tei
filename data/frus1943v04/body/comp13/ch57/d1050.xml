                <pb facs="1007" n="995" sameAs="frus:frus1943v04/pg995"/>

                <note rend="inline" type="source">890D.01/707: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Diplomatic Agent and
                        Consul General at Beirut</hi> (<hi rendition="#italic"
                    >Wadsworth</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-10-05T20:00:00-04:00">October 5, 1943—8
                            p.m.</date>
                    </dateline>
                </opener>
                <p>254. Your 285, October 2, 2 p.m. Your remarks to Syrian President and Foreign
                    Minister and suggestion contained in antepenultimate paragraph are approved.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
