    <text>
        <body>
            <div xml:id="d1107">

                <pb facs="1063" n="1051" sameAs="frus:frus1943v04/pg1051"/>

                <note rend="inline" type="source">890E.00/322</note>
                <head>
                    <hi rendition="#italic">Memorandum of Conversation, by the Under Secretary of
                        State</hi> (<hi rendition="#italic">Stettinius</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1943-12-13">December 13, 1943</date>.</dateline>
                </opener>
                <p>Lord Halifax<anchor n="58" xml:id="d1107-f1"/> called to see me today. He said he
                    had just had word that his Foreign Office felt our statement on the
                        Lebanon<anchor n="59" xml:id="d1107-f2"/> was excellent and that it pleased
                    the British immensely.</p>
                <closer>
                    <signed>E[<hi rendition="#small-caps">dward</hi>] S[<hi rendition="#small-caps"
                            >tettinius</hi>]</signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1107-f1" n="58" xml:id="d1107-f1-content">
                <p>British Ambassador.</p>
            </note>
            <note corresp="#d1107-f2" n="59" xml:id="d1107-f2-content">
                <p>Statement issued to the press by the Department of State, November 26, <ref
                        target="#pg1049">p. 1049</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
