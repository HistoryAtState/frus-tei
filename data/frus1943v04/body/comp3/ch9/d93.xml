            <div xml:id="d93">

                <pb facs="0093" n="81" sameAs="frus:frus1943v04/pg81"/>

                <note rend="inline" type="source">811.203/242: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in Egypt</hi> (<hi rendition="#italic"
                        >Kirk</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Cairo</hi></placeName>, <date
                            calendar="gregorian" when="1943-02-23T10:00:00+02:00">February 23,
                            1943—10 a.m.</date>
                        <lb/> [Received 11:37 a.m.]</dateline>
                </opener>
                <p>404. Department’s 286, February 19, 5 p.m. Signing of notes regarding military
                    jurisdiction is being delayed on account of illness of Prime Minister and
                    resulting impossibility of convening Council of Ministers to approve
                    arrangement.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Kirk</hi>
                    </signed>
                </closer>
            </div>
        </body>
