                <pb facs="0137" n="125" sameAs="frus:frus1943v04/pg125"/>

                <note rend="inline" type="source">868.01/328: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in Egypt</hi> (<hi rendition="#italic"
                        >Kirk</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Cairo</hi></placeName>, <date
                            calendar="gregorian" when="1943-03-15T11:00:00+02:00">March 15, 1943—11
                            a.m.</date>
                        <lb/> [Received March 15—9:04 a.m.]</dateline>
                </opener>
                <p>508. My 505, March 13, 6 p.m. The King of Greece arrived this morning.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Kirk</hi>
                    </signed>
                </closer>
            </div>
        </body>
