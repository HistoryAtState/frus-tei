            <div xml:id="d841">

                <pb facs="0816" n="804" sameAs="frus:frus1943v04/pg804"/>

                <note rend="inline" type="source">887N.01/1936a: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Consul at Basra</hi> (<hi rendition="#italic"
                            >Fletcher</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-08-16T23:00:00-04:00">August 16, 1943—11
                            p.m.</date>
                    </dateline>
                </opener>
                <p>109. From Alling for Colonel Hoskins who is expected to arrive in Basra about
                    August 27th: In the interests of secrecy please do not telegraph your report.
                    Instead please send your full report by air pouch from the Legation at Cairo.
                    [Alling.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
