    <text>
        <body>
            <div xml:id="d801">

                <pb facs="0763" n="751" sameAs="frus:frus1943v04/pg751"/>

                <note rend="inline" type="source">867N.00/618</note>
                <head>
                    <hi rendition="#italic">The Egyptian Minister</hi> (<hi rendition="#italic"
                        >Hassan</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-02-02">February 2,
                        1943</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: At the direction of my Government, I have
                    the honour to hand over to your Excellency the enclosed <hi rendition="#italic"
                        >aide-mémoire</hi> in connection with the question of Palestine.</p>
                <p>Please accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hassan</hi>
                    </signed>
                </closer>


                <xi:include href="d801-a1.xml" xpointer="d801-a1"/>
            </div>
