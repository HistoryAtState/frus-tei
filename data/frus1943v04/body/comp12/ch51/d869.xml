                <pb facs="0844" n="832" sameAs="frus:frus1943v04/pg832"/>

                <note rend="inline" type="source">123 Moose, James S./431: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in Saudi Arabia</hi> (<hi rendition="#italic"
                        >Moose</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Jidda</hi></placeName>, <date
                            calendar="gregorian" when="1943-05-19T12:00:00+03:06">May 19,
                            1943—noon</date>.<lb/>[Received 4:46 p.m.]</dateline>
                </opener>
                <p>42. Arrived and assumed charge today. Please advise Mrs. Moose.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Moose</hi>
                    </signed>
                </closer>
            </div>
        </body>
