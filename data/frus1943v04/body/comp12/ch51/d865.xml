    <text>
        <body>
            <div xml:id="d865">

                <pb facs="0843" n="831" sameAs="frus:frus1943v04/pg831"/>

                <note rend="inline" type="source">123 Moose, James S./417: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Chargé in Saudi Arabia</hi> (<hi rendition="#italic"
                            >Shullaw</hi>
                    <anchor n="5" xml:id="d865-f1"/>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-04-14T17:00:00-04:00">April 14, 1943—5
                            p.m.</date>
                    </dateline>
                </opener>
                <p>13. The President desires to appoint Mr. James S. Moose, Jr. to act as Minister
                    Resident to Saudi Arabia.</p>
                <p>Please ascertain whether Mr. Moose’s appointment would be agreeable to the
                    Government of Saudi Arabia and telegraph reply.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d865-f1" n="5" type="source" xml:id="d865-f1-content">
                <p>Mr. Moose was at this time in the United States on consultation and leave.</p>
            </note>
        </listAnnotation>
    </standOff>
