                <pb facs="0871" n="859" sameAs="frus:frus1943v04/pg859"/>

                <note rend="inline" type="source">890F.24/32</note>
                <head>
                    <hi rendition="#italic">President Roosevelt to the Lend-Lease Administrator</hi>
                        (<hi rendition="#italic">Stettinius</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-02-18">February 18,
                        1943</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Stettinius</hi>: For purposes of
                    implementing the authority conferred upon you as Lend-Lease Administrator by
                    Executive Order No. 8926, dated October 28, 1941, and in order to enable you to
                    arrange for Lend-Lease aid to the Government of Saudi Arabia, I hereby find that
                    the defense of Saudi Arabia is vital to the defense of the United States.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Franklin</hi> D. <hi rendition="#small-caps"
                            >Roosevelt</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
