                <pb facs="0921" n="909" sameAs="frus:frus1943v04/pg909"/>

                <note rend="inline" type="source">890F.515/50: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Minister Resident in Saudi Arabia</hi> (<hi
                            rendition="#italic">Moose</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-10-29T18:00:00-04:00">October 29, 1943—6
                            p.m.</date>
                    </dateline>
                </opener>
                <p>95. Procedure mentioned in your 164, October 25, 5 p.m. is considered
                    satisfactory by the Department.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stettinius</hi>
                    </signed>
                </closer>
            </div>
        </body>
