    <text>
        <body>
            <div xml:id="d876">

                <pb facs="0852" n="840" sameAs="frus:frus1943v04/pg840"/>

                <note rend="inline" type="source">125.0090F/8: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister Resident in Saudi
                        Arabia</hi> (<hi rendition="#italic">Moose</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-11-30T22:00:00-04:00">November 30,
                            1943—10 p.m.</date>
                    </dateline>
                </opener>
                <p>110. Please endeavor to obtain the consent of the Saudi Arabian Government to the
                    sending of an officer from the Legation to Dhahran to perform consular functions
                    there in accordance with the suggestions contained in your 169, October 30, 11
                        a.m.<anchor n="19" xml:id="d876-f1"/> and despatch 53, October 25, 1943. If
                    this permission is obtained, the Department will assign an additional officer to
                    Jidda.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
