                <pb facs="0949" n="937" sameAs="frus:frus1943v04/pg937"/>

                <note rend="inline" type="source">890F.6363/58: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in Egypt</hi>
                        (<hi rendition="#italic">Kirk</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-08-05T22:00:00-04:00">August 5, 1943—10
                            p.m.</date>
                    </dateline>
                </opener>
                <p>1101. In view of the extreme delicacy of the questions involved and the necessity
                    of absolute secrecy in regard thereto, please request Colonel Hoskins to refrain
                    entirely from any further discussion of the matter referred to in your 1327,
                    July 27, 9 a.m.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
