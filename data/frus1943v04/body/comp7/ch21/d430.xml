                <pb facs="0425" n="413" sameAs="frus:frus1943v04/pg413"/>

                <note rend="inline" type="source">123 Hurley, Patrick J./125: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Minister in Iran</hi> (<hi rendition="#italic"
                            >Dreyfus</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-11-26T00:00:00-04:00">November 26,
                            1943—midnight</date>.</dateline>
                </opener>
                <p>598. For General Hurley. Please give Dreyfus the substance of the Department’s
                    telegram no. 1777 of November 19 sent to Cairo for you.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
