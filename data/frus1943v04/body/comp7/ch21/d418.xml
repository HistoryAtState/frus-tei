    <text>
        <body>
            <div xml:id="d418">

                <pb facs="0412" n="400" xml:id="pg400"/>

                <note rend="inline" type="source">123 D 82/566: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in Iran</hi> (<hi rendition="#italic"
                        >Dreyfus</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Tehran</hi></placeName>, <date
                            calendar="gregorian" when="1943-11-04T09:00:00+03:25">November 4, 1943—9
                            a.m.</date>
                        <lb/> [Received 11:32 a.m.]</dateline>
                </opener>
                <p>1045. Relinquished charge and departed today for the United States with
                    Secretary’s party.<anchor n="41" xml:id="d418-f1"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Dreyfus</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d418-f1" n="41" xml:id="d418-f1-content">
                <p>Secretary of State Cordell Hull was returning from the Tripartite Conference of
                    Foreign Ministers held at Moscow. Richard Ford was left as Chargé in Iran.</p>
            </note>
        </listAnnotation>
    </standOff>
