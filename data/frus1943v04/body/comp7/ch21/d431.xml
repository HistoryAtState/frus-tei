    <text>
        <body>
            <div xml:id="d431">

                <pb facs="0425" n="413" sameAs="frus:frus1943v04/pg413"/>

                <note rend="inline" type="source">123 Hurley, Patrick J./126: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in Iran</hi> (<hi rendition="#italic"
                        >Dreyfus</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Tehran</hi></placeName>, <date
                            calendar="gregorian" when="1943-11-29T10:00:00+03:25">November 29,
                            1943—10 a.m.</date>
                        <lb/> [Received 10:07 a.m.]</dateline>
                </opener>
                <p>1075. Department’s 598, November 26. Following from Hurley: <quote
                        rend="blockquote">
                        <p>“We understand orders perfectly and getting along splendidly.”</p>
                    </quote>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Dreyfus</hi>
                    </signed>
                </closer>
            </div>
        </body>
