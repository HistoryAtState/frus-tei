            <div xml:id="d411">

                <pb facs="0405" n="393" sameAs="frus:frus1943v04/pg393"/>

                <note rend="inline" type="source">740.0011 Moscow/5: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in the United Kingdom</hi> (<hi
                            rendition="#italic">Winant</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-10-08T00:00:00-04:00">October 8,
                            1943—midnight</date>.</dateline>
                </opener>
                <p>6264. Please inform the Foreign Office that the Department wholly concurs in the
                    communication quoted in your telegram no. 6739, October 6,3 [<hi
                        rendition="#italic">5</hi>] p.m. concerning Allied policy in Iran.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
