    <text>
        <body>
            <div xml:id="d453">

                <pb facs="0445" n="433" sameAs="frus:frus1943v04/pg433"/>

                <note rend="inline" type="source">740.0011 European War 1939/30759: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the United Kingdom</hi> (<hi rendition="#italic">Winant</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1943-08-20">August 20,
                        1943</date>.<lb/>[Received August 20—6:15 a.m.]</dateline>
                </opener>
                <p>Department’s 4939, August 14, 7 p.m. Foreign Office states British Government
                    agrees to terms of proposed communication to Government <pb facs="0446" n="434"
                        xml:id="pg434"/> of Iran and that British Minister at Tehran is being
                    instructed to inform American Minister of this and to draft his reply to the
                    Iranian Government in the same sense.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Winant</hi>
                    </signed>
                </closer>
            </div>
        </body>
