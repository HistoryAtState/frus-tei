    <text>
        <body>
            <div xml:id="d194">

                <pb facs="0480" n="444" sameAs="frus:frus1949v03/pg444"/>

                <note rend="inline" type="source">862.014/4–349</note>
                <head>
                    <hi rendition="#italic">The Soviet Ambassador</hi> (<hi rendition="#italic"
                        >Panyushkin</hi>) <hi rendition="#italic">to the Secretary of State
                        </hi><anchor n="1" xml:id="d194-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Translation]</seg>
                </opener>
                <dateline>
                    <placeName>
                        <hi rendition="#small-caps">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1949-04-03">April 3, 1949</date>.</dateline>
                <p rendition="#flush">No. 36</p>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to submit herewith a note
                    of the Soviet Government on the question of the illegal change of the boundaries
                    of Germany.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed> A. <hi rendition="#small-caps">Panyushkin</hi>
                    </signed>
                </closer>


                <xi:include href="d194-a1.xml" xpointer="d194-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d194-f1" n="1" type="source" xml:id="d194-f1-content">
                <p>For the text of the original Russian note, see <hi rendition="#italic">Vneshníaia
                        politika Sovetskogo Soiuza, dokumenty i materialy, 1949 god</hi>, Moscow,
                    1953, pp. 94–95.</p>
            </note>
