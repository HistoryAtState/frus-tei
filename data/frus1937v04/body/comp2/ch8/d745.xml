    <text>
        <body>
            <div xml:id="d745">

                <pb facs="0594" n="586" sameAs="frus:frus1937v04/pg586"/>

                <note rend="inline" type="source">893.51/6369: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Consul General at Shanghai</hi> (<hi
                            rendition="#italic">Gauss</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1937-05-04T12:00:00-04:00">May 4, 1937—noon</date>.</dateline>
                </opener>
                <p>107. Following from Eximbank<anchor n="64" xml:id="d745-f1"/> for Warren Pierson:
                        <quote rend="blockquote">
                        <p>Executive Committee approved China credit on basis your recommendations
                            subject to your obtaining clearance with Ambassador Johnson. Resolution
                            will not be released pending receipt from you of Ambassador’s views.</p>
                    </quote></p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d745-f1" n="64" xml:id="d745-f1-content">
                <p>Export-Import Bank of Washington.</p>
            </note>
