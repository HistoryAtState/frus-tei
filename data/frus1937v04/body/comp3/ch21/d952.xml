            </note>
            <note corresp="#d952-f2" n="17" xml:id="d952-f2-content">
                <p>Seijiro Yoshizawa, Director of the American Affairs Bureau, Japanese Foreign
                    Office.</p>
            </note>
        </listAnnotation>
    </standOff>
