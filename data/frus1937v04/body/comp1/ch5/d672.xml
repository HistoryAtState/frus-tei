    <text>
        <body>
            <div xml:id="d672">

                <pb facs="0527" n="519" xml:id="pg519"/>

                <note rend="inline" type="source">394.115 Panay/197: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Japan</hi> (<hi rendition="#italic">Grew</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Tokyo</hi></placeName>, <date calendar="gregorian"
                            when="1937-12-25T12:00:00+09:00">December 25,
                        1937—noon</date>.<lb/>[Received December 25—6:30 a.m.]</dateline>
                </opener>
                <p>680. My 677, December 24, 6 p.m.<anchor n="1" xml:id="d672-f1"/></p>
                <p>1. <hi rendition="#italic">Panay</hi>. Complete report of findings of Naval Court
                    of Inquiry received and communicated to the Minister for Foreign Affairs
                    today.</p>
                <p>Repeated to Shanghai and Commander in Chief.</p>
                <closer><signed><hi rendition="#small-caps">Grew</hi></signed></closer>
            </div>
        </body>
    </text>
