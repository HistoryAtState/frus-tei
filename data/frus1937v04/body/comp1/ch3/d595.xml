    <text>
        <body>
            <div xml:id="d595">

                <pb facs="0479" n="471" sameAs="frus:frus1937v04/pg471"/>

                <note rend="inline" type="source">793.94/11701: Telegram</note>
                <head><hi rendition="#italic">The Commander in Chief of the United States Asiatic
                        Fleet</hi> (<hi rendition="#italic"
                        >Yarnell</hi>) <hi rendition="#italic">to the Chief of Named
                        Operations</hi> (<hi rendition="#italic"
                        >Leahy</hi>)<anchor n="25" xml:id="d595-f1"/></head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Shanghai</hi></placeName>,] <date calendar="gregorian"
                            when="1937-12-19T16:00:00+08:00">December 19, 1937—4
                        p.m.</date><lb/>[Received December 19—8:20 a.m.]</dateline>
                </opener>
                <p>0119. An officer Japanese Navy informed Admiral Holt<anchor n="26"
                        xml:id="d595-f2"/> at Nanking that the channels through Mudfort and Kiangyin
                    barriers have been made solely for use of the Japanese forces and not for the
                    use of neutral shipping and that passage of H. M. S. <hi rendition="#italic"
                        >Ladybird</hi>, U. S. S. <hi rendition="#italic">Oahu</hi> and others of
                    that convoy cannot be taken as a precedent.</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d595-f1" n="25" type="source" xml:id="d595-f1-content">
                <p>Copy transmitted to the Department by the Navy Department.</p>
            </note>
            <note corresp="#d595-f2" n="26" xml:id="d595-f2-content">
                <p>Commanding British naval forces in the Yangtze.</p>
            </note>
        </listAnnotation>
    </standOff>
