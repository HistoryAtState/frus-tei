    <text>
        <body>
            <div xml:id="d384">

                <pb facs="0348" n="340" sameAs="frus:frus1937v04/pg340"/>

                <note rend="inline" type="source">793.94/10141: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Ambassador in China</hi>
                        (<hi rendition="#italic">Johnson</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1937-09-19T14:00:00-04:00">September 19, 1937—2
                        p.m.</date></dateline>
                </opener>
                <p>250. Department has repeated Shanghai’s 728, September 19, 1 p.m.<anchor n="42"
                        xml:id="d384-f1"/> to Tokyo with request that Ambassador make immediate
                    representations in regard to the safety of the American Embassy and American
                    nationals at Nanking.<anchor n="43" xml:id="d384-f2"/></p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d384-f1" n="42" xml:id="d384-f1-content">
                <p><ref target="frus1931-41v01#pg_499"><hi rendition="#italic">Foreign
                            Relations</hi>, Japan, 1931–1941, vol. <hi rendition="#small-caps"
                            >i</hi>, p. 499</ref>.</p>
            </note>
            <note corresp="#d384-f2" n="43" xml:id="d384-f2-content">
                <p>For report of representations, see memorandum by the Ambassador in Japan,
                    September 20, <ref target="frus1931-41v01#pg_500"><hi rendition="#italic"
                            >ibid.</hi>, p. 500</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
