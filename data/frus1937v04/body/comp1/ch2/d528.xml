    <text>
        <body>
            <div xml:id="d528">

                <pb facs="0433" n="425" xml:id="pg425"/>

                <note rend="inline" type="source">393.1115/2345: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Japan</hi> (<hi rendition="#italic">Grew</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Tokyo</hi></placeName>, <date calendar="gregorian"
                            when="1937-12-29T12:00:00+09:00">December 29,
                        1937—noon</date>.<lb/>[Received December 29—2:35 a.m.]</dateline>
                </opener>
                <p>696. Following has been sent to Shanghai: <quote rend="blockquote">
                        <p>“December 29, noon. Hankow’s 102, December 23, 1 p.m.<anchor n="66"
                                xml:id="d528-f1"/> The Foreign Office states that the Navy
                            Department has issued to forces in China instructions with regard to the
                            second special train leaving Hankow December 30, 9 a.m. for
                                Canton.<anchor n="67" xml:id="d528-f2"/> Please rush relay to
                            Hankow.</p>
                        <p>Repeated to the Department.”</p>
                    </quote></p>
                <closer><signed><hi rendition="#small-caps">Grew</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d528-f1" n="66" xml:id="d528-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d528-f2" n="67" xml:id="d528-f2-content">
                <p>This train left as scheduled carrying 300 foreigners including 167 Americans.</p>
            </note>
        </listAnnotation>
    </standOff>
