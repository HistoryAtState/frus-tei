    <text>
        <body>
            <div xml:id="d397">

                <pb facs="0354" n="346" xml:id="pg346"/>

                <note rend="inline" type="source">393.1115/1019: Telegram</note>
                <head><hi rendition="#italic">The Commander in Chief of the United States Asiatic
                        Fleet</hi> (<hi rendition="#italic">Yarnell</hi>) <hi rendition="#italic">to
                        the Chief of Naval Operations</hi> (<hi rendition="#italic"
                        >Leahy</hi>)<anchor n="54" xml:id="d397-f1"/></head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Shanghai</hi></placeName>,] <date calendar="gregorian"
                            when="1937-09-21T08:50:00+08:00">September 21, 1937—8:50
                        a.m.</date><lb/>[Received September 21—7 a.m.]</dateline>
                </opener>
                <p>0021. Orders have been given Comyangpat<anchor n="55" xml:id="d397-f2"/> to keep
                    a gunboat at Nanking as long as there are any United States nationals there who
                    may require assistance or protection.</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d397-f1" n="54" type="source" xml:id="d397-f1-content">
