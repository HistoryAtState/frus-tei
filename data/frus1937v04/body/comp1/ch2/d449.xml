    <text>
        <body>
            <div xml:id="d449">

                <pb facs="0384" n="376" sameAs="frus:frus1937v04/pg376"/>

                <note rend="inline" type="source">393.1115/1872: Telegram</note>
                <head><hi rendition="#italic">The Consul General at Tientsin</hi> (<hi rendition="#italic">Caldwell</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Tientsin</hi></placeName>, <date calendar="gregorian"
                            when="1937-11-11T15:00:00+08:00">November 11, 1937—3
                        p.m.</date><lb/>[Received November 11—11:50 a.m.]</dateline>
                </opener>
                <p>71. Department’s 90, November 9, noon.<anchor n="2" xml:id="d449-f1"/> List of
                    Americans in Honan Province, as given in Hankow’s November 6, 1 p.m.,<anchor
                        n="2" xml:id="d449-f2"/> has been communicated to Japanese authorities with
                    request that they take appropriate steps to avoid injury to lives and property
                    of Americans.</p>
                <closer><signed><hi rendition="#small-caps">Caldwell</hi></signed></closer>
            </div>
        </body>
    </text>
