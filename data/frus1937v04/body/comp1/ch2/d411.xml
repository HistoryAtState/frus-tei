    <text>
        <body>
            <div xml:id="d411">

                <pb facs="0363" n="355" xml:id="pg355"/>

                <note rend="inline" type="source">393.1163 Am 3/225: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Ambassador in China</hi>
                        (<hi rendition="#italic">Johnson</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1937-09-24T19:00:00-04:00">September 24, 1937—7
                        p.m.</date></dateline>
                </opener>
                <p>263. Your 707, September 23, 2 p.m.<anchor n="65" xml:id="d411-f1"/> On September
                    23 the Department instructed Tokyo to make appropriate representations in regard
                    to the endangering of the American personnel of the mission<anchor n="66"
                        xml:id="d411-f2"/> and on the same day authorized Tientsin to confirm in
                    writing its oral protest to the Japanese Consul General.</p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d411-f1" n="65" xml:id="d411-f1-content">
