    <text>
        <body>
            <div xml:id="d367">

                <pb facs="0338" n="330" sameAs="frus:frus1937v04/pg330"/>

                <note rend="inline" type="source">393.1115/838: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in China</hi> (<hi rendition="#italic"
                        >Johnson</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Nanking</hi></placeName>, <date calendar="gregorian"
                            when="1937-09-15T17:00:00+08:00">September 15, 1937—5
                        p.m.</date><lb/>[Received September 15—10:55 a.m.]</dateline>
                </opener>
                <p>662. Your [<hi rendition="#italic">Shanghai’s</hi>] 793 [<hi rendition="#italic"
                        >693</hi>], September 13, noon. Please inform Japanese Consul when giving
                    him information contained in Hankow’s September 14, 4 p.m.,<anchor n="33"
                        xml:id="d367-f1"/> that Hankow will continue to send American citizens on
                    down trains of Canton–Hankow line and that it is our hope that Japanese will do
                    nothing to make this impossible.</p>
                <p>Sent to Shanghai, Hankow.</p>
                <closer><signed><hi rendition="#small-caps">Johnson</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
