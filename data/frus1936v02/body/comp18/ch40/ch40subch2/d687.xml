            <div xml:id="d687">

                <pb facs="0789" n="690" sameAs="frus:frus1936v02/pg690"/>

                <note rend="inline" type="source">352.1815/3: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Consul at Barcelona</hi>
                        (<hi rendition="#italic">Franklin</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1936-09-01T12:00:00-04:00">September 1,
                        1936—noon</date>.</dateline>
                </opener>
                <p>Department’s August 29, 2 p.m., your August 30, noon.<anchor n="9"
                        xml:id="d687-f1"/> The Department desires you to maintain cordial contact
                    with the Costa Rican Consul and requests you to extend all proper and consistent
                    assistance to him or his successor in the protection or evacuation of Costa
                    Rican nationals should the need arise.</p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
    </text>
