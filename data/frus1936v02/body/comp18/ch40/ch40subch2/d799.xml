                <pb facs="0858" n="759" sameAs="frus:frus1936v02/pg759"/>

                <note rend="inline" type="source">852.00/3763: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Third Secretary
                        of Embassy in Spain</hi> (<hi rendition="#italic">Wendelin</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1936-11-14T13:00:00-05:00">November 14, 1936—1
                        p.m.</date></dateline>
                </opener>
                <p>191. Your X–311, November 13, 10 p.m. Please keep us informed as to action
                    British may take in order that we may be in a position to act promptly in the
                    event that similar action on our part seems advisable.</p>
                <closer><signed><hi rendition="#small-caps">Moore</hi></signed></closer>
            </div>
        </body>
