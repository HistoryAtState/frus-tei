                <pb facs="0742" n="643" sameAs="frus:frus1936v02/pg643"/>

                <note rend="inline" type="source">852.00/2272: Telegram</note>
                <head><hi rendition="#italic">The Consul at Barcelona</hi> (<hi rendition="#italic"
                        >Franklin</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Barcelona</hi></placeName>, <date calendar="gregorian"
                            when="1936-07-25T19:00:00+00:00">July 25, 1936—7
                        p.m.</date><lb/>[Received July 26—3:25 a.m.]</dateline>
                </opener>
                <p>Please send USS <hi rendition="#italic">Quincy</hi> which I understand is at
                    Gibraltar to Barcelona as all communication threatened.</p>
                <closer><signed><hi rendition="#small-caps">Franklin</hi></signed></closer>
            </div>
        </body>
    </text>
