                <pb facs="0539" n="440" xml:id="pg440"/>

                <note rend="inline" type="source">852.00/2174: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Spain</hi> (<hi rendition="#italic">Bowers</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">San
                                Sebastián</hi></placeName>, <date calendar="gregorian"
                            when="1936-07-18T12:00:00+00:00">July 18,
                        1936—noon</date>.<lb/>[Received July 18—9:35 a.m.]</dateline>
                </opener>
                <p>45. Wendelin in Madrid telephones by special permission <hi rendition="#italic"
                        >coup d’état</hi> planned for noon today. Telegraphic and telephone
                    communications closed. Will wire when information more definite.</p>
                <closer><signed><hi rendition="#small-caps">Bowers</hi></signed></closer>
            </div>
        </body>
    </text>
