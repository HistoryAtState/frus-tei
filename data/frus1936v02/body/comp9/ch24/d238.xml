            <div xml:id="d238">

                <pb facs="0406" n="307" sameAs="frus:frus1936v02/pg307"/>

                <note rend="inline" type="source">711.689 Entry, Residence and Establishment/2:
                    Telegram</note>
                <head><hi rendition="#italic">The Minister in Greece</hi> (<hi rendition="#italic"
                        >MacVeagh</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Athens</hi></placeName>, <date calendar="gregorian"
                            when="1936-01-23T12:00:00+02:00">January 23,
                        1936—noon</date>.<lb/>[Received January 23—10:30 a.m.]</dateline>
                </opener>
                <p>13. Department’s instruction No. 240 of November 15, 1935. The Greek Government
                    agrees in principle to the proposed treaty negotiations and I have submitted the
                    draft forwarded with the Department’s instruction under reference.</p>
                <closer><signed><hi rendition="#small-caps">MacVeagh</hi></signed></closer>
            </div>
        </body>
