            <div xml:id="d858">

                <pb facs="0896" n="797" sameAs="frus:frus1936v02/pg797"/>

                <note rend="inline" type="source">611.5431/300</note>
                <head><hi rendition="#italic">The Swiss Minister</hi> (<hi
                            rendition="#italic">Peter</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1936-01-09">January 9, 1936</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of January 9, 1936, relating to the laws to which the last sentence
                    of Article II of the Trade Agreement signed to-day is referring, and to inform
                    you that its contents have been duly noted.</p>
                <p>Accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Marc Peter</hi></signed></closer>
            </div>
        </body>
    </text>
