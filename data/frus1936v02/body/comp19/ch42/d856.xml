    <text>
        <body>
            <div xml:id="d856">

                <pb facs="0896" n="797" xml:id="pg797"/>

                <note rend="inline" type="source">611.5431/288</note>
                <head><hi rendition="#italic">The Secretary of State to the Swiss Minister</hi> (<hi
                        rendition="#italic">Peter</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1936-01-09">January 9, 1936</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of January 9, 1936, and to inform you that the declarations of the
                    Swiss Government pertaining to the importation into Switzerland of lard as well
                    as of trucks and their chassis from the United States have been duly noted.</p>
                <p>Accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Cordell Hull</hi></signed></closer>
            </div>
        </body>
    </text>
