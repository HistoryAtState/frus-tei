            <div xml:id="d326">

                <pb facs="0597" n="481" sameAs="frus:frus1923v01/pg481"/>

                <note rend="inline" type="source">711.428/778</note>
                <head><hi rendition="#italic">The Consul General at Ottawa</hi> (<hi
                        rendition="#italic">Foster</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Ottawa</hi></placeName> [<date
                            ana="#date_undated-inferred-from-document-content-and-sibling-dates"
                            calendar="gregorian" notAfter="1923-12-31T23:59:59-05:00"
                            notBefore="1923-12-17T13:00:00-05:00"><hi rendition="#italic"
                                >undated</hi></date>].<lb/>[Received December 31, 1923.]</dateline>
                    <seg rendition="#float-left">No. 4215</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In response to instruction of December
                    17th, I now have the honor to forward herewith, copy of a letter I have received
                    from Mr. A. Johnston, Deputy Minister of Marine and Fisheries, in reply to the
                    personal message conveyed to him by me, on behalf of the Honorable William
                    Phillips, Under Secretary of State.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">John G. Foster</hi></signed></closer>


                <xi:include href="d326-a1.xml" xpointer="d326-a1"/>
            </div>
        </body>
    </text>
