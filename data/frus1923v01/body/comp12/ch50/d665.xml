                <pb facs="0952" n="836" xml:id="pg836"/>

                <note rend="inline" type="source">711.1828/10: Telegram</note>
                <head><hi rendition="#italic">The Minister in Costa Rica</hi> (<hi rendition="#italic">Davis</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >San José</hi></placeName>, <date calendar="gregorian"
                            when="1923-04-14T18:00:00-06:00"><hi rendition="#italic">April 14,
                                1923—6 p.m.</hi></date><lb/>[Received April 16—3
                    p.m.]</dateline></opener>
                <p>23. My number 22, April 10, 4 p.m.<anchor n="4" xml:id="d665-f1"/> President
                    Acosta yesterday withdrew canal protocol from Congress.</p>
                <closer><signed><hi rendition="#small-caps">Davis</hi></signed></closer>
            </div>
        </body>
    </text>
