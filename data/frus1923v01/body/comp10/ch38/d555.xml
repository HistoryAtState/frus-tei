    <text>
        <body>
            <div xml:id="d555">

                <pb facs="0811" n="695" sameAs="frus:frus1923v01/pg695"/>

                <note rend="inline" type="source">393.1123 Lincheng/257</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">Schurman</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1923-09-29"><hi rendition="#italic">September 29,
                        1923</hi></date>.<lb/>[Received October 26.]</dateline>
                    <seg rendition="#float-left">No. 1852</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to my telegram No. 323 of
                    September 25, 1923, 10 a.m.,<anchor n="15" xml:id="d555-f1"/> regarding the
                    receipt of the reply to the note addressed to the Ministry of Foreign Affairs by
                    the Diplomatic Body regarding the Lincheng incident, I have the honor to
                    transmit herewith a translation of the note in question from the Ministry of
                    Foreign Affairs.<anchor n="16" xml:id="d555-f2"/></p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Jacob Gould
                    Schurman</hi></signed></closer>



                <xi:include href="d555-a1.xml" xpointer="d555-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d555-f1" n="15" xml:id="d555-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d555-f2" n="16" xml:id="d555-f2-content">
                <p>The Department received a summary of this note from the Associated Press on Sept.
                    26 and a copy of the text from the Chinese Legation on Sept. 28.</p>
            </note>
        </listAnnotation>
    </standOff>
