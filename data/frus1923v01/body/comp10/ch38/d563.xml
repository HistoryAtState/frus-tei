                <pb facs="0824" n="708" sameAs="frus:frus1923v01/pg708"/>

                <note rend="inline" type="source">893.105/37: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Minister in China</hi>
                        (<hi rendition="#italic">Schurman</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1923-10-18T16:00:00-05:00"><hi rendition="#italic">October 18,
                                1923—4 p.m.</hi></date></dateline></opener>
                <p>224. Your No. 346 October 14, 2 p.m.<anchor n="24" xml:id="d563-f1"/></p>
                <p>Please report by telegraph concerning the oral understanding between the Dean and
                    the Ministry of Foreign Affairs relating to the railway police scheme.</p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
