    <text>
        <body>
            <div xml:id="d499">

                <pb facs="0751" n="635" sameAs="frus:frus1923v01/pg635"/>

                <note rend="inline" type="source">393.1123 Lincheng/28: Telegram</note>
                <head><hi rendition="#italic">The Counselor of Legation at Peking</hi> (<hi
                        rendition="#italic">Bell</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1923-05-10T15:00:00+08:00"><hi rendition="#italic">May 10, 1923—3
                                p.m.</hi></date><lb/>[Received May 10—8:30 a.m.]</dateline></opener>
                <p>148. My 139, May 8, 11 a.m.<anchor n="76" xml:id="d499-f1"/> Following from
                    Consul Davis, Lincheng: <quote rend="blockquote">
                        <p>“Robert Allen, Rowland Pinger released. Their fathers in good condition.
                            Hope others will be released soon. Situation hopeful. Davis.”</p>
                    </quote></p>
                <closer><signed><hi rendition="#small-caps">Schurman</hi> [<hi rendition="#italic"
                            >Bell</hi>]</signed></closer>
            </div>
        </body>
    </text>
