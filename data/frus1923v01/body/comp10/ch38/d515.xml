    <text>
        <body>
            <div xml:id="d515">

                <pb facs="0766" n="650" xml:id="pg650"/>

                <note rend="inline" type="source">393.1123 Lincheng/117: Telegram</note>
                <head><hi rendition="#italic">The Consul General at Shanghai</hi> (<hi rendition="#italic">Cunningham</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Shanghai</hi></placeName>, <date calendar="gregorian"
                            when="1923-05-31T16:00:00+08:00"><hi rendition="#italic">May 31, 1923—4
                                p.m.</hi></date><lb/>[Received May 31—4:36 a.m.]</dateline></opener>
                <p>Davis reports Allen<anchor n="89" xml:id="d515-f1"/> and Smith<anchor n="90"
                        xml:id="d515-f2"/> released unconditionally. Proceeding Tientsin.
                    Negotiations continuing favorably.</p>
                <closer><signed><hi rendition="#small-caps">Cunningham</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d515-f1" n="89" xml:id="d515-f1-content">
                <p>Maj. Robert A. Allen, United States Army.</p>
            </note>
            <note corresp="#d515-f2" n="90" xml:id="d515-f2-content">
                <p>William Smith, British citizen.</p>
            </note>
        </listAnnotation>
    </standOff>
