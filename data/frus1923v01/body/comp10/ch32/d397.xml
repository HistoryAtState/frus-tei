                <pb facs="0667" n="551" sameAs="frus:frus1923v01/pg551"/>

                <note rend="inline" type="source">893.00/4824: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">Schurman</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1923-01-19T11:00:00+08:00"><hi rendition="#italic">January 19,
                                1923—11 a.m.</hi></date><lb/>[Received January 19—6:54
                        a.m.]</dateline></opener>
                <p>24. Following from Canton: <quote rend="blockquote">
                        <p>“January 18, 7 p.m. Referring to my telegram of January 16th, 11 a.m.
                            Chen went to Waichow not to Hong Kong. Situation at Canton confused as
                            there is no leader here recognized by all military forces in the
                            city.”</p>
                    </quote></p>
                <closer><signed><hi rendition="#small-caps">Schurman</hi></signed></closer>
            </div>
        </body>
    </text>
