                <pb facs="0668" n="552" sameAs="frus:frus1923v01/pg552"/>

                <note rend="inline" type="source">893.00/4876: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">Schurman</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1923-02-22T10:00:00+08:00"><hi rendition="#italic">February 22,
                                1923—10 a.m.</hi></date><lb/>[Received February 22—3:43
                        a.m.]</dateline></opener>
                <p>64. Following from Canton: <quote rend="blockquote">
                        <p>“February 21, 4 p.m. Sun Yat-sen arrived at Canton today.”</p>
                    </quote></p>
                <closer><signed><hi rendition="#small-caps">Schurman</hi></signed></closer>
            </div>
        </body>
