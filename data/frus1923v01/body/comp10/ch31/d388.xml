    <text>
        <body>
            <div xml:id="d388">

                <pb facs="0659" n="543" sameAs="frus:frus1923v01/pg543"/>

                <note rend="inline" type="source">893.51/4339</note>
                <head><hi rendition="#italic">The American Group to the
                            Secretary of State</hi></head>
                <opener><seg rendition="#center">[Extract]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >New York</hi></placeName>, <date calendar="gregorian"
                            when="1923-06-20"><hi rendition="#italic">June 20,
                        1923</hi></date>.<lb/>[Received June 21.]</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to our letter of June
                        15th,<anchor n="62" xml:id="d388-f1"/> we now enclose … four copies of the
                    Consortium Council Report …</p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>Respectfully,</p>
                <closer><hi rendition="#small-caps">J. P. Morgan</hi> &amp; Co.<lb/><hi
                        rendition="#italic">For the American Group</hi></closer>


                <xi:include href="d388-a1.xml" xpointer="d388-a1"/>
            </div>
        </body>
    </text>
