                <pb facs="0665" n="549" sameAs="frus:frus1923v01/pg549"/>

                <note rend="inline" type="source">893.51/4411: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Minister in China</hi>
                        (<hi rendition="#italic">Schurman</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1923-10-08T18:00:00-05:00"><hi rendition="#italic">October 8,
                                1923—6 p.m.</hi></date></dateline></opener>
                <p>214. Your 326, September 29, 4 p.m.</p>
                <p>Department perceives no objection to acceptance by American Group representative
                    of advisership to Financial Readjustment Commission, and Group has been so
                    advised.</p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
