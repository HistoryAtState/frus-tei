                <pb facs="0840" n="724" sameAs="frus:frus1923v01/pg724"/>

                <note rend="inline" type="source">393.1123 Coltman, Charles/38: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Minister in China</hi> (<hi
                            rendition="#italic">Schurman</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1923-02-13T13:00:00-05:00"><hi rendition="#italic">February 13,
                                1923—1 p.m.</hi></date></dateline></opener>
                <p>30. Your No. 48 February 11, 8 p.m.</p>
                <p>The Department fully concurs in your opinion that the reply of the Foreign Office
                    is wholly unsatisfactory. Please give me your views on Department’s telegram No.
                    21, January 31, 6 p.m.</p>
                <closer><signed><hi rendition="#small-caps">Phillips</hi></signed></closer>
            </div>
        </body>
