    <text>
        <body>
            <div xml:id="d592">

                <pb facs="0853" n="737" sameAs="frus:frus1923v01/pg737"/>

                <note rend="inline" type="source">393.1123 Coltman, Charles/87: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">Schurman</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1923-05-26T15:00:00+08:00"><hi rendition="#italic">May 26, 1923—3
                                p.m.</hi></date><lb/>[Received May 26—7:02 a.m.]</dateline></opener>
                <p>184. My 171, May 19, 11 a.m.<anchor n="54" xml:id="d592-f1"/> Note from Foreign
                    Office dated yesterday states chief of staff on petition Ministry War and
                    General <pb facs="0854" n="738" xml:id="pg738"/> Staff was dismissed by
                    Presidential mandate, and chief adjutant and Adjutant Wang dismissed by Ministry
                    of War; and Chinese Government accepts our demand for $25,000
                        compensation.<anchor n="55" xml:id="d592-f2"/></p>
                <closer><signed><hi rendition="#small-caps">Schurman</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d592-f1" n="54" xml:id="d592-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d592-f2" n="55" xml:id="d592-f2-content">
                <p>On Sept. 20, the Chinese Acting Minister for Foreign Affairs transmitted a draft
                    for $25,000 to the Minister in China in payment of this claim.</p>
            </note>
        </listAnnotation>
    </standOff>
