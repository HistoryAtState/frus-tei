    <text>
        <body>
            <div xml:id="d476">

                <pb facs="0733" n="617" sameAs="frus:frus1923v01/pg617"/>

                <note rend="inline" type="source">893.113/539</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">Schurman</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1923-07-25"><hi rendition="#italic">July 25,
                        1923</hi></date>.<lb/>[Received August 21.]</dateline>
                    <seg rendition="#float-left">No. 1689</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to the last paragraph of my
                    telegram No. 46 of February 9, 6 p.m.,<anchor n="54" xml:id="d476-f1"/>
                    regarding the arms embargo and the proposal to withhold naval assistance to
                    China, I have the honor to transmit herewith for the Department’s information a
                    copy of Dean Circular No. 187 of July 13th regarding the agreement of the
                    Netherlands <pb facs="0734" n="618" xml:id="pg618"/> and Japanese Ministers to
                    the formula proposed by the American Government regarding the question of
                    withholding naval assistance to China.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Jacob Gould
                    Schurman</hi></signed></closer>



                <xi:include href="d476-a1.xml" xpointer="d476-a1"/>
                <xi:include href="d476-a2.xml" xpointer="d476-a2"/>
