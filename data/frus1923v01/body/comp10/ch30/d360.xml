    <text>
        <body>
            <div xml:id="d360">

                <pb facs="0631" n="515" sameAs="frus:frus1923v01/pg515"/>

                <note rend="inline" type="source">893.00/5186</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">Schurman</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1923-08-17"><hi rendition="#italic">August 17,
                        1923</hi></date>.<lb/>[Received September 21.]</dateline>
                    <seg rendition="#float-left">No. 1738</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to my telegram No. 283, of
                    August 12, 11 a.m.,<anchor n="19" xml:id="d360-f1"/> regarding the probability
                    of an outbreak of hostilities between the Military Governors of Kiangsu and
                    Chekiang Provinces, I have the honor to transmit herewith a copy of the joint
                    note on <pb facs="0632" n="516" xml:id="pg516"/> the matter which my French,
                    British and Japanese Colleagues and I addressed to the Ministry of Foreign
                    Affairs on August 11th.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Jacob Gould
                    Schurman</hi></signed></closer>


                <xi:include href="d360-a1.xml" xpointer="d360-a1"/>
            </div>
        </body>
    </text>
