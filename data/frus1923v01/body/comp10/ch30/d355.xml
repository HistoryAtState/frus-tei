                <pb facs="0626" n="510" sameAs="frus:frus1923v01/pg510"/>

                <note rend="inline" type="source">893.00/5044: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">Schurman</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1923-06-13T14:00:00+08:00"><hi rendition="#italic">June 13, 1923—2
                                p.m.</hi></date><lb/>[Received June 13—7:28
                    a.m.]</dateline></opener>
                <p>220. My 215, June 12, noon.<anchor n="14" xml:id="d355-f1"/> President left for
                    Tientsin at 1:25 p.m. today accompanied by Vice Minister of War.</p>
                <p>No excitement.</p>
                <closer><signed><hi rendition="#small-caps">Schurman</hi></signed></closer>
            </div>
        </body>
    </text>
