            <div xml:id="d346">

                <pb facs="0621" n="505" sameAs="frus:frus1923v01/pg505"/>

                <note rend="inline" type="source">893.002/121: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">Schurman</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1923-04-09T10:00:00+08:00"><hi rendition="#italic">April 9,
                                1923—10 a.m.</hi></date><lb/>[Received April 9—4: 37
                        a.m.]</dateline></opener>
                <p>98. My 93, March 29, 5 p.m.<anchor n="11" xml:id="d346-f1"/> By Presidential
                    mandate yesterday resignation of Huang Fu is accepted and Wellington Koo
                    appointed Acting Minister of Foreign Affairs.</p>
                <closer><signed><hi rendition="#small-caps">Schurman</hi></signed></closer>
            </div>
        </body>
    </text>
