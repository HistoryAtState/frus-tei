    <text>
        <body>
            <div xml:id="d621">

                <pb facs="0902" n="786" xml:id="pg786"/>

                <note rend="inline" type="source">893.74/282</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">Schurman</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><seg rendition="#center">[Extract]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1923-03-01"><hi rendition="#italic">March 1,
                        1923</hi></date>.<lb/>[Received April 3.]</dateline>
                    <seg rendition="#float-left">No. 1387</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my despatch No. 1188, of
                    November 29, 1922,<anchor n="95" xml:id="d621-f1"/> and subsequent telegraphic
                    correspondence regarding the Federal wireless contract, I have the honor to
                    transmit herewith records of conversations and copies of other documents
                    connected with this matter.<anchor n="96" xml:id="d621-f2"/></p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Jacob Gould
                    Schurman</hi></signed></closer>


                <xi:include href="d621-a1.xml" xpointer="d621-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d621-f1" n="95" xml:id="d621-f1-content">
