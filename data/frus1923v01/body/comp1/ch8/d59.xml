    <text>
        <body>
            <div xml:id="d59">

                <pb facs="0242" n="126" sameAs="frus:frus1923v01/pg126"/>

                <note rend="inline" type="source">611.0031/163</note>
                <head><hi rendition="#italic">Senator Henry Cabot
                            Lodge</hi><anchor n="86" xml:id="d59-f1"/>
                    <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1923-01-08"><hi rendition="#italic">January 8,
                        1923</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I have read the enclosed
                        statement<anchor n="87" xml:id="d59-f2"/> which you kindly lent me with
                    great interest. It seems very convincing <pb facs="0243" n="127" xml:id="pg127"
                    /> and very well put and I think that Mr. Culbertson makes a very strong case. I
                    shall be glad to talk with you further in regard to it.</p>
                <p>With kind regards [etc.]</p>
                <closer><signed><hi rendition="#small-caps">H. C. Lodge</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d59-f1" n="86" type="source" xml:id="d59-f1-content">
                <p>Chairman of the Senate Committee on Foreign Relations.</p>
            </note>
            <note corresp="#d59-f2" n="87" xml:id="d59-f2-content">
                <p>Apparently refers to letter of Dec. 14, 1922, from the Acting Chairman of the
                    Tariff Commission to the Secretary of State, <hi rendition="#italic"
                    >supra.</hi></p>
            </note>
        </listAnnotation>
    </standOff>
