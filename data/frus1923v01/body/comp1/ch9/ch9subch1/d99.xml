    <text>
        <body>
            <div xml:id="d99">

                <pb facs="0286" n="170" sameAs="frus:frus1923v01/pg170"/>

                <note rend="inline" type="source">811.114/1752</note>
                <head><hi rendition="#italic">The Portuguese Minister</hi> (<hi rendition="#italic"
                        >Alte</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Bar Harbor, Maine</hi></placeName>, <date calendar="gregorian"
                            when="1923-07-25"><hi rendition="#italic">July 25,
                        1923</hi></date>.<lb/>[Received July 28.]</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honour to enclose a Memorandum
                    stating the position of the Portuguese Government in respect to the principle
                    involved in the question of the transportation of alcoholic beverages in
                    American waters referred in the Department of State’s Memorandum of June 9,
                        1923.<anchor n="25" xml:id="d99-f1"/></p>
                <p>Accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Alte</hi></signed></closer>


                <xi:include href="d99-a1.xml" xpointer="d99-a1"/>
            </div>
        </body>
    </text>
