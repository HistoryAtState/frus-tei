                <pb facs="0482" n="366" sameAs="frus:frus1923v01/pg366"/>

                <note rend="inline" type="source">723.2515/1129</note>
                <head><hi rendition="#italic">The Chilean Ambassador</hi> (<hi rendition="#italic"
                        >Mathieu</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><seg rendition="#center">[Translation]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1923-03-01"><hi rendition="#italic">March 1,
                        1923</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 52</seg></opener>
                <p><hi rendition="#small-caps">Mr. Secretary of State</hi>: I have the honor to
                    inform Your Excellency that my Government has appointed the former Minister of
                    Foreign Relations, Señor Ernesto Barros Jarpa, to take charge of Chile’s
                    interests in the arbitration agreed with Peru in the Protocol of July 20,
                    1922.</p>
                <p>Señor Barros Jarpa is already in Washington and will have his office at the
                    Embassy.</p>
                <p>In bringing this appointment to Your Excellency’s knowledge for all pertinent
                    purposes, I take [etc.]</p>
                <closer><signed><hi rendition="#small-caps">B. Mathieu</hi></signed></closer>
            </div>
        </body>
    </text>
