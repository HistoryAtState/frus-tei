    <text>
        <body>
            <div xml:id="d4">

                <pb facs="0121" n="5" sameAs="frus:frus1923v01/pg5"/>

                <note rend="inline" type="source">500.C114/240</note>
                <head><hi rendition="#italic">The Chief Justice of the Supreme Court</hi> (<hi rendition="#italic">Taft</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1922-11-16"><hi rendition="#italic">November 16,
                        1922</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I send you herewith a
                    copy of a letter I have from Lord Robert Cecil, for your perusal, and to
                    complete your files in respect to this general subject matter.</p>
                <p>With best wishes [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Wm. H. Taft</hi></signed></closer>


                <xi:include href="d4-a1.xml" xpointer="d4-a1"/>
            </div>
