    <text>
        <body>
            <div xml:id="d3">

                <pb facs="0119" n="3" sameAs="frus:frus1923v01/pg3"/>

                <note rend="inline" type="source">500.C114/236½</note>
                <head><hi rendition="#italic">The Chief Justice of the Supreme Court</hi> (<hi
                        rendition="#italic">Taft</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1922-09-27"><hi rendition="#italic">September 27,
                        1922</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I enclose herewith copies
                    of the two letters which I wrote—one to Lord Robert Cecil,<anchor n="1a"
                        xml:id="d3-f1"/> and the other to Earl Balfour—in respect to the matter
                    which we discussed to-day.</p>
                <p>Sincerely yours,</p>
                <closer><signed><hi rendition="#small-caps">Wm. H. Taft</hi></signed></closer>


                <xi:include href="d3-a1.xml" xpointer="d3-a1"/>
            </div>
        </body>
    </text>
