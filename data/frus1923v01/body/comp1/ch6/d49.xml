    <text>
        <body>
            <div xml:id="d49">

                <pb facs="0230" n="114" sameAs="frus:frus1923v01/pg114"/>

                <note rend="inline" type="source">512.4 A 1a/229½</note>
                <head><hi rendition="#italic">President Coolidge to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1923-08-21"><hi rendition="#italic">August 21,
                        1923</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I have noted your letter
                    of August 21st in regard to the International Office of Public Health and will
                    be <pb facs="0231" n="115" xml:id="pg115"/> glad to have you act favorably in
                    the matter you present if your judgment approves.</p>
                <p>Very truly yours,</p>
                <closer><signed><hi rendition="#small-caps">Calvin Coolidge</hi></signed></closer>
            </div>
        </body>
    </text>
