                <pb facs="0164" n="48" sameAs="frus:frus1923v01/pg48"/>

                <note rend="inline" type="source">700.00116/51</note>
                <head><hi rendition="#italic">The Secretary of the Navy</hi> (<hi rendition="#italic">Denby</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1922-11-01"><hi rendition="#italic">November 1,
                        1922</hi></date>.</dateline>
                    <seg rendition="#float-left">3809–959:190–1</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In connection with the coming conference at
                    the Hague on the Laws of War, there is transmitted herewith a paper by the
                    General Board regarding the use of radio in war, which paper has been approved
                    by me.</p>
                <p>Sincerely yours,</p>
                <closer><signed><hi rendition="#small-caps">Edwin Denby</hi></signed></closer>


                <xi:include href="d23-a1.xml" xpointer="d23-a1"/>
