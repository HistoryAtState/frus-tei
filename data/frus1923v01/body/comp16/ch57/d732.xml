    <text>
        <body>
            <div xml:id="d732">

                <pb facs="1013" n="897" xml:id="pg897"/>

                <note rend="inline" type="source">839.00/2709</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Commissioner in the Dominican Republic</hi> (<hi
                            rendition="#italic">Welles</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1923-05-24"><hi rendition="#italic">May 24,
                        1923</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: The Department has received your despatch
                    No. 52 of April 30, last, and views with satisfaction your endeavor to make
                    clear in the Dominican Republic the neutral position of the American Government
                    and of yourself in the presidential contest.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State:<lb/><signed><hi rendition="#small-caps">William
                            Phillips</hi></signed></closer>
            </div>
        </body>
    </text>
