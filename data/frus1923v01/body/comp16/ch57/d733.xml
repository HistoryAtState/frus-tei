    <text>
        <body>
            <div xml:id="d733">

                <pb facs="1013" n="897" sameAs="frus:frus1923v01/pg897"/>

                <note rend="inline" type="source">830.00/2723: Telegram</note>
                <head><hi rendition="#italic">The Minister in the Dominican Republic</hi> (<hi
                        rendition="#italic">Russell</hi>)<anchor n="5" xml:id="d733-f1"/>
                    <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Santo Domingo</hi></placeName>, <date calendar="gregorian"
                            when="1923-06-23T09:00:00-04:40"><hi rendition="#italic">June 23, 1923—9
                                a.m.</hi></date><lb/>[Received June 25—3:40
                    p.m.]</dateline></opener>
                <p>27. Registration commenced 20th and is continuing daily. Reports from interior
                    indicate progress. Registration in the capital first two days 600.</p>
                <closer><signed><hi rendition="#small-caps">Russell</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d733-f1" n="5" type="source" xml:id="d733-f1-content">
                <p>Commissioner Welles returned to the United States in May and remained until late
                    in October.</p>
            </note>
        </listAnnotation>
    </standOff>
