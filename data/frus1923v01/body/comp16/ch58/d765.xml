    <text>
        <body>
            <div xml:id="d765">

                <pb facs="1037" n="921" sameAs="frus:frus1923v01/pg921"/>

                <note rend="inline" type="source">839.6463/114: Telegram</note>
                <head><hi rendition="#italic">The Minister in the Dominican Republic</hi> (<hi
                        rendition="#italic">Russell</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Santo Domingo</hi></placeName>, <date calendar="gregorian"
                            when="1923-06-23T10:00:00-04:40"><hi rendition="#italic">June 23,
                                1923—10 a.m.</hi></date><lb/>[Received June 25—3:40
                    p.m.]</dateline></opener>
                <p>28. Contract for settlement of the case of the Santo Domingo Water, Light and
                    Power Company has been approved by both municipalities. <pb facs="1038" n="922"
                        xml:id="pg922"/> Please notify company. Contract will be forwarded by next
                        mail.<anchor n="14" xml:id="d765-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Russell</hi></signed></closer>
            </div>
        </body>
    </text>
