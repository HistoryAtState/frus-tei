            <div xml:id="d799">

                <pb facs="1055" n="939" xml:id="pg939"/>

                <note rend="inline" type="source">822.51 Et 3/26</note>
                <head><hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Kellogg</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1924-01-24"><hi rendition="#italic">January 24,
                        1924</hi></date>.<lb/>[Received February 5.]</dateline>
                    <seg rendition="#float-left">No. 35</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In reply to your telegram No. 383 of
                    December 17, 5 p.m., 1923, concerning the attitude of the Guayaquil &amp; Quito
                    Railway Co. toward the proposed loan from the Ethelburga Syndicate to the
                    Government of Ecuador, I have the honor to forward herewith copies of Foreign
                    Office Note No. A 355/3/54, dated January 22, 1924.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Frank B. Kellogg</hi></signed></closer>


                <xi:include href="d799-a1.xml" xpointer="d799-a1"/>
            </div>
