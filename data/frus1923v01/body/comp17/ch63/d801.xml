                <pb facs="1056" n="940" sameAs="frus:frus1923v01/pg940"/>

                <note rend="inline" type="source">822.61334/95a</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Minister in Ecuador</hi> (<hi rendition="#italic"
                            >Bading</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1923-07-30"><hi rendition="#italic">July 30,
                        1923</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Mr. Jordan Herbert Stabler is proceeding to
                    Ecuador in the interest of the Mercantile Bank of the Americas in connection
                    with the matter pending between the bank and the Asociación de Agriculture [<hi
                        rendition="#italic">Agricultores</hi>] del Ecuador. You are requested to
                    render Mr. Stabler all appropriate assistance in the transaction of his
                    business.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State:<lb/><signed><hi rendition="#small-caps">Leland
                            Harrison</hi></signed></closer>
            </div>
        </body>
    </text>
