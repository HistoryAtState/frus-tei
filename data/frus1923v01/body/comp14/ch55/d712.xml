    <text>
        <body>
            <div xml:id="d712">

                <pb facs="0994" n="878" sameAs="frus:frus1923v01/pg878"/>

                <note rend="inline" type="source">800.51 W 89 Czechoslovakia/43: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Czechoslovakia</hi> (<hi
                        rendition="#italic">Pearson</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Prague</hi></placeName>, <date calendar="gregorian"
                            when="1923-04-30T16:00:00+01:00"><hi rendition="#italic">April 30,
                                1923—4 p.m.</hi></date><lb/>[Received 8:15 p.m.]</dateline></opener>
                <p>23. Legation’s number 21, April 13, 3 p.m.<anchor n="14" xml:id="d712-f1"/> Debt
                    Commission sailing May 5 on <hi rendition="#italic">Berengaria</hi> from
                        Cherbourg.<anchor n="15" xml:id="d712-f2"/> Minister for Foreign <pb
                        facs="0995" n="879" xml:id="pg879"/> Affairs informed me this morning
                    Commission is authorized to conduct negotiations for repayment but must refer
                    any agreement reached back to Czech Government for final approval.</p>
                <closer><signed><hi rendition="#small-caps">Pearson</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d712-f1" n="14" xml:id="d712-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d712-f2" n="15" xml:id="d712-f2-content">
                <p>The Commission was composed of Dr. Chvalkovsky, appointed Czechoslovak Minister
                    to the United States; Dr. Lipansky, Counselor of the Ministry of Finance;
                    Captain Křenek, of the Ministry of National Defense; and Francis Pisecky,
                    Director of the Corn Office.</p>
            </note>
        </listAnnotation>
    </standOff>
