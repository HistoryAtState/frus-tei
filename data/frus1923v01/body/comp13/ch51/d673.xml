    <text>
        <body>
            <div xml:id="d673">

                <pb facs="0962" n="846" sameAs="frus:frus1923v01/pg846"/>

                <note rend="inline" type="source">123C8812/15a: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Ambassador in Cuba</hi>
                        (<hi rendition="#italic">Crowder</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1923-07-28T14:00:00-04:00"><hi rendition="#italic">July 28, 1923—2
                                p.m.</hi></date></dateline></opener>
                <p>63. Your No. 58 of July 26, 1 p.m.,<anchor n="14" xml:id="d673-f1"/> and your
                    telephone conversation with Captain Rock. Also your despatch No. 218, of July
                        24.<anchor n="14" xml:id="d673-f2"/></p>
                <p>The Department desires that you should come to Washington for a conference as
                    soon as you deem it advisable.<anchor n="15" xml:id="d673-f3"/></p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d673-f1" n="14" xml:id="d673-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d673-f2" n="14" xml:id="d673-f2-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d673-f3" n="15" xml:id="d673-f3-content">
                <p>The Ambassador left Habana Aug. 2 and remained in the United States until Dec.
                    14.</p>
            </note>
        </listAnnotation>
    </standOff>
