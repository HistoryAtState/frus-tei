    <text>
        <body>
            <div xml:id="d134">

                <pb facs="0351" n="325" sameAs="frus:frus1961-63v07/pg325"/>

                <head>134. Letter From the British Ambassador (Ormsby Gore) to Secretary of State
                        Rusk<anchor n="0" xml:id="d134-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1962-02-26">February 26,
                        1962</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Dean</hi>: I think it may be useful to you if I
                    send you the exact wording of the telegram I sent to the Foreign Secretary on
                    February 21, recording my telephone conversation with the President on the
                    previous day.</p>
                <p>Yours ever</p>
                <closer><signed><hi rendition="#bold">David</hi></signed></closer>



                <xi:include href="d134-a1.xml" xpointer="d134-a1"/>
            </div>
        </body>
    </text>
