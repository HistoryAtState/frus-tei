        <body>
            <div xml:id="d221">

                <pb facs="0270" n="258" xml:id="pg258"/>

                <note rend="inline" type="source">740.0011 European War 1939/3848: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in Germany</hi> (<hi
                            rendition="#italic">Heath</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berlin</hi></placeName>, <date
                            calendar="gregorian" when="1940-06-15">June 15,
                        1940</date>.<lb/>[Received June 17—1 a.m.]</dateline>
                </opener>
                <p>1889. Following message from American Embassy in Paris has just been orally
                    communicated by German military authorities: “The occupation of Paris took place
                    entirely without disorder or loss of life. All members of this mission are in
                    excellent health. Bullitt.”</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Heath</hi>
                    </signed>
                </closer>
            </div>
        </body>
