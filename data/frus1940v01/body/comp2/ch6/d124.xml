            <div xml:id="d124">

                <pb facs="0197" n="185" sameAs="frus:frus1940v01/pg185"/>

                <note rend="inline" type="source">740.0011 European War 1939/2248: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in the Netherlands</hi> (<hi rendition="#italic">Gordon</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">The Hague</hi></placeName>, <date
                            calendar="gregorian" when="1940-04-16T11:00:00+00:20">April 16, 1940—11
                            a.m.</date>
                        <lb/> [Received April 16—8:40 a.m.]</dateline>
                </opener>
                <p>119. On Sunday Dutch anti-aircraft batteries and pursuit planes were in action
                    against British, French and German planes over Netherlands territory.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Gordon</hi>
                    </signed>
                </closer>
            </div>
