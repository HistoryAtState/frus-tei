    <text>
        <body>
            <div xml:id="d126">

                <pb facs="0198" n="186" xml:id="pg186"/>

                <note rend="inline" type="source">740.0011 European War 1939/2343: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in the Netherlands</hi> (<hi
                        rendition="#italic">Gordon</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">The Hague</hi></placeName>, <date
                            calendar="gregorian" when="1940-04-19T17:00:00+00:20">April 19, 1940—5
                            p.m.</date>
                        <lb/> [Received April 19—4:12 p.m.]</dateline>
                </opener>
                <p>129. My 117, April 15, 3 p.m.<anchor n="49" xml:id="d126-f1"/> In radio address
                    this afternoon Prime Minister<anchor n="49a" xml:id="d126-f2"/> announced that
                    the entire country has now been placed under martial law.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Gordon</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
