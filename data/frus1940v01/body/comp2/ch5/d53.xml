    <text>
        <body>
            <div xml:id="d53">

                <pb facs="0152" n="140" sameAs="frus:frus1940v01/pg140"/>

                <note rend="inline" type="source">740.00112 European War 1939/1303</note>
                <head>
                    <hi rendition="#italic">The British Ambassador</hi> (<hi rendition="#italic"
                        >Lothian</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1940-04-06">April 6, 1940</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Secretary</hi>: I received instructions
                    last night from Lord Halifax<anchor n="8" xml:id="d53-f1"/> to communicate the
                    enclosed message to you for your personal information.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lothian</hi>
                    </signed>
                </closer>


                <xi:include href="d53-a1.xml" xpointer="d53-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d53-f1" n="8" xml:id="d53-f1-content">
                <p>British Secretary of State for Foreign Affairs.</p>
