                <pb facs="0173" n="161" sameAs="frus:frus1940v01/pg161"/>

                <note rend="inline" type="source">740.0011 European War 1939/2375: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Chargé in Germany</hi> (<hi rendition="#italic"
                            >Kirk</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1940-04-22T18:00:00-05:00">April 22, 1940—6
                            p.m.</date>
                    </dateline>
                </opener>
                <p>1022. Your 1071, April 20, 6 p.m. The Department fully understands the situation
                    indicated in your telegram under acknowledgment and will continue to give every
                    consideration to the suggestions you have made. As you will understand, there
                    are many important aspects of the problem to be determined.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
