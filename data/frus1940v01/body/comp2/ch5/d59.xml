            <div xml:id="d59">

                <pb facs="0156" n="144" sameAs="frus:frus1940v01/pg144"/>

                <note rend="inline" type="source">740.0011 European War 1939/1994: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in Denmark</hi> (<hi rendition="#italic"
                        >Atherton</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Copenhagen</hi></placeName>, <date
                            calendar="gregorian" when="1940-04-09">April 9,
                        1940</date>.<lb/>[Received April 9—7 a.m.]</dateline>
                </opener>
                <p>59. German leaflets distributed Denmark state occupation protecting Denmark’s
                    neutrality. Negotiations proceeding between Danish and German Government for
                    preservation of Kingdom, civil and military authority.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Atherton</hi>
                    </signed>
                </closer>
            </div>
        </body>
