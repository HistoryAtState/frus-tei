    <text>
        <body>
            <div xml:id="d94">

                <pb facs="0180" n="168" xml:id="pg168"/>

                <note rend="inline" type="source">740.0011 European War 1939/3627: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in Sweden</hi> (<hi rendition="#italic"
                        >Sterling</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Stockholm</hi></placeName>, <date
                            calendar="gregorian" when="1940-06-09T23:00:00+01:00">June 9, 1940—11
                            p.m.</date>
                        <lb/> [Received June 9—8:15 p.m.]</dateline>
                </opener>
                <p>607. From Harriman. Swedish Foreign Minister just informs me as Allies have
                    withdrawn their help Norwegian Army has ceased to fight. King and Government are
                    en route to England. Please treat as confidential until carried in newspapers.
                    [Harriman.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Sterling</hi>
                    </signed>
                </closer>
            </div>
        </body>
