            <div xml:id="d115">

                <pb facs="0193" n="181" xml:id="pg181"/>

                <note rend="inline" type="source">124.57/56: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the United Kingdom</hi> (<hi
                        rendition="#italic">Kennedy</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1940-07-26T16:00:00+01:00">July 26, 1940—4
                            p.m.</date>
                        <lb/> [Received July 26—11:30 a.m.]</dateline>
                </opener>
                <p>2410. Your 1909, July 19, 5 p.m. British Government has no objection and
                    Government of Norway is agreeable to Schoenfeld’s designation as Chargé a. i.
                    near the Government of Norway.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Kennedy</hi>
                    </signed>
                </closer>
            </div>
        </body>
