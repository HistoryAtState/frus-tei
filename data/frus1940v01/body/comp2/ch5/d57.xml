    <text>
        <body>
            <div xml:id="d57">

                <pb facs="0155" n="143" sameAs="frus:frus1940v01/pg143"/>

                <note rend="inline" type="source">740.00112 European War 1939/1305</note>
                <head>
                    <hi rendition="#italic">The British Ambassador</hi> (<hi
                            rendition="#italic">Lothian</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1940-04-08">April 8, 1940</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Under instructions from His Majesty’s
                    Principal Secretary of State for Foreign Affairs I have the honour to
                    communicate to you the enclosed text of a joint public declaration which has
                    been made by His Majesty’s Government in the United Kingdom and the French
                    Government, regarding the territorial waters of Norway.<anchor n="11"
                        xml:id="d57-f1"/>
                </p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lothian</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d57-f1" n="11" xml:id="d57-f1-content">
                <p>For text of declaration, see <hi rendition="#italic">ibid.</hi>, p. 7.</p>
            </note>
        </listAnnotation>
