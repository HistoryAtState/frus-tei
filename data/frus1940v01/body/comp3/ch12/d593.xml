    <text>
        <body>
            <div xml:id="d593">

                <pb facs="0567" n="555" sameAs="frus:frus1940v01/pg555"/>

                <note rend="inline" type="source">761.6215/18: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in the Soviet Union</hi> (<hi
                        rendition="#italic">Thurston</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Moscow</hi></placeName>, <date
                            calendar="gregorian" when="1940-06-12T10:00:00+03:00">June 12, 1940—10
                            a.m.</date>
                        <lb/> [Received June 12—7:55 a.m.]</dateline>
                </opener>
                <p>663. Embassy’s telegram No. 466, April 27, 5 p.m.<anchor n="11" xml:id="d593-f1"
                    /> The Embassy has been informed by a Secretary of the German Embassy that the
                    Soviet and German Governments have concluded a treaty for the regulation of
                    border disputes.<anchor n="12" xml:id="d593-f2"/> The informant indicated that
                    the treaty was of purely technical nature and of no political significance. He
                    added that it contained provision for the settlement of border disputes by the
                    local frontier authorities.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Thurston</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
