            </note>
            <note corresp="#d356-f2" n="8" xml:id="d356-f2-content">
                <p>Friedrich Werner, Count von der Schulenburg.</p>
            </note>
            <note corresp="#d356-f3" n="9" xml:id="d356-f3-content">
