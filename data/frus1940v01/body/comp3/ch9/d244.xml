    <text>
        <body>
            <div xml:id="d244">

                <pb facs="0288" n="276" xml:id="pg276"/>

                <note rend="inline" type="source">860D.24/82: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in Finland</hi> (<hi
                            rendition="#italic">Schoenfeld</hi>) <hi rendition="#italic"
                        >to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Grankulla</hi> (<hi rendition="#small-caps"
                                >Helsinki</hi>)</placeName>, <date calendar="gregorian"
                            when="1940-01-12T18:00:00+02:00">January 12, 1940—6 p.m.</date>
                        <lb/> [Received January 12—5:20 p.m.]</dateline>
                </opener>
                <p>24. Private and unofficial for General George Marshall<anchor n="23"
                        xml:id="d244-f1"/> from Military Attaché.<anchor n="24" xml:id="d244-f2"/>
                </p>
                <quote rend="blockquote">
                    <p>“Lieutenant General Nenonen, Chief of Finnish Military Commission, will call
                        on you with regard to immediate Finnish needs. Recommend action be taken at
                        once as delay will seriously handicap our assistance. Cannot overemphasize
                        necessity for speed. Haynes.”</p>
                </quote>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Schoenfeld</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d244-f1" n="23" xml:id="d244-f1-content">
                <p>Chief of Staff, United States Army.</p>
            </note>
            <note corresp="#d244-f2" n="24" xml:id="d244-f2-content">
                <p>Maj. Frank B. Haynes.</p>
            </note>
        </listAnnotation>
