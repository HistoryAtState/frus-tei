    <text>
        <body>
            <div xml:id="d813">

                <pb facs="0754" n="742" xml:id="pg742"/>

                <note rend="inline" type="source">740.00111 A.R./1095: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Panama</hi> (<hi rendition="#italic"
                        >Dawson</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Panama</hi></placeName>, <date
                            calendar="gregorian" when="1940-05-18T14:00:00-05:00">May 18, 1940—2
                            p.m.</date>
                        <lb/> [Received 2:55 p.m.]</dateline>
                </opener>
                <p>69. My telegram number 67.<anchor n="75" xml:id="d813-f1"/> Doctor Garay is
                    releasing joint declaration for publication this afternoon in papers appearing
                    not before 5 o’clock.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Dawson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
