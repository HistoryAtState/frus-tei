    <text>
        <body>
            <div xml:id="d738">

                <pb facs="0707" n="695" sameAs="frus:frus1940v01/pg695"/>

                <note rend="inline" type="source">862.857/55</note>
                <head>
                    <hi rendition="#italic">The Panamanian Ambassador</hi> (<hi rendition="#italic"
                        >Boyd</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Translation]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. D–66</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1940-02-16">February 16,
                        1940</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Secretary of State</hi>: I have the honor to
                    transmit to Your Excellency, herewith, the communication which the Secretary of
                    Foreign Affairs and Communications of the Republic of Panama addresses to Your
                    Excellency, in connection with a new violation of the Security Zone established
                    by the Declaration of Panama and which is self-explanatory.</p>
                <p>I avail myself [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Jorge E. Boyd</hi>
                    </signed>
                </closer>


                <xi:include href="d738-a1.xml" xpointer="d738-a1"/>
            </div>
        </body>
    </text>
