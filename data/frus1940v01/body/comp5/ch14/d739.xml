    <text>
        <body>
            <div xml:id="d739">

                <pb facs="0708" n="696" sameAs="frus:frus1940v01/pg696"/>

                <note rend="inline" type="source">740.0011 European War 1939/1686</note>
                <head>
                    <hi rendition="#italic">The Panamanian Ambassador</hi> (<hi rendition="#italic"
                        >Boyd</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Translation]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. D–65</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1940-02-16">February 16,
                        1940</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Secretary</hi>: I have the honor to transmit to
                    Your Excellency herewith a copy of the note, with a translation thereof into
                    Spanish, addressed to the Panamanian Chancellery by the Chargé d’Affaires of
                    Germany in Panama, by means of which he replies in the name of his Government to
                    the protest which the American Republics, through His Excellency the President
                    of the Republic of Panama, addressed on December 23, 1939, to the countries
                    which violated the Security Zone established in the Declaration of Panama, of
                    October 3, 1939.</p>
                <p>I avail myself [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Jorge E. Boyd</hi>
                    </signed>
                </closer>


                <xi:include href="d739-a1.xml" xpointer="d739-a1"/>
            </div>
        </body>
    </text>
