    <text>
        <body>
            <div xml:id="d863">

                <pb facs="0796" n="784" xml:id="pg784"/>

                <note rend="inline" type="source">740.00111 A.R.–Subs/16: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in El Salvador</hi> (<hi
                        rendition="#italic">Frazer</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">San Salvador</hi></placeName>, <date
                            calendar="gregorian" when="1940-06-28T16:00:00-06:00">June 28, 1940—4
                            p.m.</date>
                        <lb/> [Received 7 p.m.]</dateline>
                </opener>
                <p>30. Salvadoran decree excluding belligerent submarines and other naval vessels
                    from ports and territories promulgated June 26th.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Frazer</hi>
                    </signed>
                </closer>
            </div>
        </body>
