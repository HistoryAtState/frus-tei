    <text>
        <body>
            <div xml:id="d862">

                <pb facs="0795" n="783" sameAs="frus:frus1940v01/pg783"/>

                <note rend="inline" type="source">740.00111 A.R.–Subs/12: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in Uruguay</hi> (<hi rendition="#italic"
                        >Wilson</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Montevideo</hi></placeName>, <date
                            calendar="gregorian" when="1940-06-26T17:00:00-03:30">June 26, 1940—5
                            p.m.</date>
                        <lb/> [Received 8:40 p.m.]</dateline>
                </opener>
                <p>131. My 111, June 14th.<anchor n="28" xml:id="d862-f1"/> The decree excluding
                    belligerent submarines was issued last night.<anchor n="29" xml:id="d862-f2"/>
                </p>
                <p>Repeated to Rio de Janeiro.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wilson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
