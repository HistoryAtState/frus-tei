    <text>
        <body>
            <div xml:id="d874">

                <pb facs="0803" n="791" xml:id="pg791"/>

                <note rend="inline" type="source">740.00111 A.R./1137: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in El Salvador</hi> (<hi rendition="#italic">Frazer</hi>) <hi rendition="#italic"
                        >to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">San Salvador</hi></placeName>, <date
                            calendar="gregorian" when="1940-05-23T15:00:00-06:00">May 23, 1940—3
                            p.m.</date>
                        <lb/> [Received 10:18 p.m.]</dateline>
                </opener>
                <p>21. Following is translated text of note from German Minister at Guatemala to the
                    Government of El Salvador referred to in Department’s telegram No. 16 [<hi
                        rendition="#italic">15?</hi>]<anchor n="41" xml:id="d874-f1"/>
                </p>
                <p>[Here follows text of memorandum similar to the one presented to the Guatemalan
                    Minister for Foreign Affairs dated May 18, printed <hi rendition="#italic"
                        >supra.</hi>]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Frazer</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
