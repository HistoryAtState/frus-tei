    <text>
        <body>
            <div xml:id="d31">

                <pb facs="0131" n="119" sameAs="frus:frus1940v01/pg119"/>

                <note rend="inline" type="source">500.A21/1a: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                            American Diplomatic Missions in All Neutral
                            Countries
                    </hi><anchor n="83" xml:id="d31-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1940-02-10T16:00:00-05:00">February 10,
                            1940—4 p.m.</date>
                    </dateline>
                </opener>
                <p>[Here follows, <hi rendition="#italic">mutatis mutandis</hi>, the text of
                    telegram No. 26, February 8, 11 a.m., to the Ambassador in Brazil, printed on
                        <ref target="#pg117">page 117</ref>.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d31-f1" n="83" type="source" xml:id="d31-f1-content">
                <p>This telegram was sent to the following countries: Belgium, with instructions
                    also to convey to Luxemburg Government; Bolivia; Bulgaria; Chile; Colombia;
                    Costa Rica; Cuba; Denmark; Dominican Republic; Ecuador; Egypt, with instructions
                    also to convey to Saudi Arabian Government; El Salvador; Estonia; Greece;
                    Guatemala; Haiti; Honduras; Hungary; Iran, with instructions also to convey to
                    Afghan Government; Iraq; Ireland; Italy; Latvia; Liberia; Lithuania; Mexico;
                    Netherlands; Nicaragua; Norway; Panama; Paraguay; Peru; Portugal; Rumania;
                    Spain; Sweden; Switzerland; Thailand; Turkey; Uruguay; Venezuela; and
                    Yugoslavia.</p>
            </note>
        </listAnnotation>
    </standOff>
