    <text>
        <body>
            <div xml:id="d356">

                <pb facs="0915" n="897" xml:id="pg897"/>

                <note rend="inline" type="source">396.1 MA/9–754: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in France (Dillon) to the Department of
                        State</hi><anchor n="1" xml:id="d356-f1"/></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">confidential</hi></seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1954-09-07T20:00:00+01:00">September 7, 1954—8
                        p.m.</date></dateline>
                </opener>
                <p>1005. Margerie<anchor n="2" xml:id="d356-f2"/> states Mendes has instructed La
                    Chambre that French delegation, except for suggesting verbal changes in draft,
                    should go down line with US on all major points.</p>
                <closer><signed><hi rendition="#small-caps">Dillon</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d356-f1" n="1" type="source" xml:id="d356-f1-content">
                <p>Repeated for information to Manila.</p>
            </note>
            <note corresp="#d356-f2" n="2" xml:id="d356-f2-content">
                <p>Roland Jacquin de Margerie, Deputy Director General for Political and Economic
                    Affairs at the Foreign Ministry.</p>
            </note>
        </listAnnotation>
    </standOff>
