    <text>
        <body>
            <div xml:id="d415">

                <pb facs="1053" n="1035" sameAs="frus:frus1952-54v12p1/pg1035"/>

                <note rend="inline" type="source">S/S–NSC files, lot 63 D 351, NSC 5429/4</note>
                <head><hi rendition="#italic">Note to the National Security Council by the Acting
                        Executive Secretary (Gleason)</hi></head>
                <note rend="inline" type="source">[Extracts]</note>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">top secret</hi><lb/>NSC
                        5429/4</seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1954-12-10">December 10, 1954</date>.</dateline>
                </opener>
                <pb facs="1054" n="1036" xml:id="pg1036"/>
                <p rendition="#center"><hi rendition="#small-caps">Current U.S. Policy Toward the
                        Far East</hi></p>
                <gap/>
                <p>The NSC Planning Board has prepared, pursuant to NSC Action No.
                        1275–b-(12),<anchor n="1" xml:id="d415-f1"/> the proposed statement of
                    policy in the enclosed paragraphs marked by a double asterisk, for consideration
                    by the Council at its meeting on December 21.</p>
                <gap/>
                <closer><signed><hi rendition="#small-caps">S. Everett
                    Gleason</hi></signed></closer>


                <xi:include href="d415-a1.xml" xpointer="d415-a1"/>
