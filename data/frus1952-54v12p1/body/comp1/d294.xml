    <text>
        <body>
            <div xml:id="d294">

                <pb facs="0735" n="717" sameAs="frus:frus1952-54v12p1/pg717"/>

                <note rend="inline" type="source">Conference files, lot 60 D 627, CF 348</note>
                <head><hi rendition="#italic">Memorandum by Walter Trulock of the Reports and
                        Operations Staff</hi></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">secret</hi><lb/>SEAP D–2/2</seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1954-08-11">August 11, 1954</date>.</dateline>
                </opener>
                <p rendition="#center">UK
                    <hi rendition="#small-caps">Comments on the Revised Treaty Text</hi><anchor
                        n="1" xml:id="d294-f1"/></p>
                <p>Attached is a paper outlining the substance of the comments made by the British
                    Embassy yesterday with respect to the draft Southeast Asia Collective Security
                    Treaty (SEAP D–2/1).</p>
                <closer><signed><hi rendition="#small-caps">Walter Trulock</hi></signed></closer>



                <xi:include href="d294-a1.xml" xpointer="d294-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d294-f1" n="1" xml:id="d294-f1-content">
                <p>Apparently a reference to the draft dated Aug. 5, <ref target="#pg708">p.
                        708</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
