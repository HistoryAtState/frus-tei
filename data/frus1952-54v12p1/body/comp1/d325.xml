    <text>
        <body>
            <div xml:id="d325">

                <pb facs="0812" n="794" sameAs="frus:frus1952-54v12p1/pg794"/>

                <note rend="inline" type="source">Conference files, lot 60 D 627, CF 348</note>
                <head><hi rendition="#italic">Memorandum by Walter Trulock of the Reports and
                        Operations Staff</hi></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">secret</hi><lb/>SEAP
                        D–12</seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1954-08-26">August 26, 1954</date>.</dateline>
                </opener>
                <p rendition="#center"><hi rendition="#small-caps">Meeting of Southeast Asia
                        Pact</hi> (SEAP)</p>
                <p rendition="#center"><hi rendition="#small-caps">United Kingdom Proposed
                        Amendments to Articles ii and iii</hi><anchor n="1" xml:id="d325-f1"/></p>
                <p rendition="#center">Attached are the UK amendments to Article II and III.</p>


                <xi:include href="d325-a1.xml" xpointer="d325-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d325-f1" n="1" xml:id="d325-f1-content">
                <p>The amendments are to the articles as they appear in the U.S. draft dated Aug.
                    24, <ref target="#pg784">p. 784</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
