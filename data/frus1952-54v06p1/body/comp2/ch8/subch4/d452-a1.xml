                    </row>
                    <row>
                        <cell/>
                        <cell><hi rendition="#italic">Non-Soviet World</hi> 2,183,000 tons</cell>
                    </row>
                    <row>
                        <cell>Copper (Blister)—</cell>
                        <cell><hi rendition="#italic">China</hi> 7,000 tons</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell><hi rendition="#italic">Non-Soviet World</hi> 2,552,000 tons</cell>
                    </row>
