                    </row>
                    <row>
                        <cell/>
                        <cell><hi rendition="#italic">Non-Soviet World</hi> 5,772,000 tons</cell>
                    </row>
                    <row>
                        <cell>Chrome Ore—</cell>
                        <cell><hi rendition="#italic">China</hi> Nil</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell><hi rendition="#italic">Non-Soviet World</hi> 3,036,000 tons</cell>
                    </row>
                    <row>
                        <cell>Tungsten Concentrates—</cell>
                        <cell><hi rendition="#italic">China</hi> 21,000 tons</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell><hi rendition="#italic">Non-Soviet World</hi> 48,393 tons (this seems
                            to be their only strong point)</cell>
                    </row>
                    <row>
                        <cell>Nickel—</cell>
                        <cell><hi rendition="#italic">China</hi> Nil</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell><hi rendition="#italic">Non-Soviet World</hi> 160,697 tons</cell>
