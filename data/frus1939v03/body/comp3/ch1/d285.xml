    <text>
        <body>
            <div xml:id="d285">

                <pb facs="0323" n="319" sameAs="frus:frus1939v03/pg319"/>

                <note rend="inline" type="source">893.0146/742a: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Second Secretary of
                        Embassy in China</hi> (<hi rendition="#italic">Smyth</hi>), <hi
                        rendition="#italic">at Peiping</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1939-11-18T14:00:00-05:00">November 18,
                            1939—2 p.m.</date>
                    </dateline>
                </opener>
                <p>259. In connection with the recent announcements of the British and French
                    Governments that they intend to reduce their military forces stationed in north
                    China, the Department requests that Peiping, Shanghai and Tientsin keep it
                    currently informed of pertinent developments in this connection, especially in
                    regard to numerical or other important changes affecting British and French
                    forces in north China and at Shanghai.<anchor n="13" xml:id="d285-f1"/>
                </p>
                <p>Sent to Peiping. Repeated to Chungking, Shanghai and Tientsin.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Welles</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d285-f1" n="13" xml:id="d285-f1-content">
                <p>Such information was promptly reported by telegram.</p>
            </note>
        </listAnnotation>
    </standOff>
