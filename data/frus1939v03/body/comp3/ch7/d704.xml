            <div xml:id="d704">

                <pb facs="0740" n="736" sameAs="frus:frus1939v03/pg736"/>

                <note rend="inline" type="source">893.51/7017: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Chargé in the United Kingdom</hi> (<hi
                            rendition="#italic">Johnson</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1939-12-29T17:00:00-05:00">December 29,
                            1939—5 p.m.</date>
                    </dateline>
                </opener>
                <p>1692. Your 2680, December 20. American group informs Hornbeck news received of
                    satisfactory settlement. Hornbeck proposes congratulations to Butterworth.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
