    <text>
        <body>
            <div xml:id="d670">

                <pb facs="0708" n="704" xml:id="pg704"/>

                <note rend="inline" type="source">893.24/594a: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Ambassador in France</hi> (<hi
                            rendition="#italic">Bullitt</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1939-08-05T14:00:00-04:00">August 5, 1939—2
                            p.m.</date>
                    </dateline>
                </opener>
                <p>591. Your 1414, July 31, 4 p.m. The British Government has informally informed me
                    through the British Embassy here that the British Government has no intention to
                    close the Burma Road to shipments for China.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Welles</hi>
                    </signed>
                </closer>
            </div>
        </body>
