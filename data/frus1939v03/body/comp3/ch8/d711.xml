    <text>
        <body>
            <div xml:id="d711">

                <pb facs="0745" n="741" sameAs="frus:frus1939v03/pg741"/>

                <note rend="inline" type="source">893.24/539: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic"
                        >Bullitt</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1939-02-22T00:00:00+00:00">February 22,
                            1939—midnight</date>.<lb/>[Received February 23—8:45 a.m.]</dateline>
                </opener>
                <p>341. Mandel, Minister of Colonies, stated to me last night that at the present
                    time there were no restrictions whatsoever on shipments of any sort over the
                    railroad through Indo-China.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bullitt</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
