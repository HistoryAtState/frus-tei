    <text>
        <body>
            <div xml:id="d846">

                <pb facs="0850" n="846" sameAs="frus:frus1939v03/pg846"/>

                <note rend="inline" type="source">893.51/6913: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Counselor of Embassy in China</hi> (<hi
                            rendition="#italic">Peck</hi>), <hi rendition="#italic">at
                        Chungking</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1939-06-14T17:00:00-04:00">June 14, 1939—5
                            p.m.</date>
                    </dateline>
                </opener>
                <p>102. Your 371, June 10, 9 a.m., and 372, June 10, 10 a.m.,<anchor n="87"
                        xml:id="d846-f1"/> in regard to cotton and wheat credits to China. When you
                    next see Arthur Young please ask him to inform the Chinese Minister of Finance
                    that the inquiry made by the Chinese Government is receiving consideration by
                    this Government.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
