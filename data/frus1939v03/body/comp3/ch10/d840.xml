    <text>
        <body>
            <div xml:id="d840">

                <pb facs="0843" n="839" sameAs="frus:frus1939v03/pg839"/>

                <note rend="inline" type="source">893.51/6910</note>
                <head>
                    <hi rendition="#italic">The Chinese Ambassador</hi> (<hi
                            rendition="#italic">Hu Shih</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1939-06-08">June 8, 1939</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: Referring to my note of
                    April 26, 1939, enclosing two telegraphic messages from His Excellency Dr. H. H.
                    Kung, Minister of Finance, I beg to enclose herewith a copy of another
                    telegraphic message from Dr. Kung, dated Chungking, June 7, 1939, concerning the
                    service of the loans secured by the customs and salt revenues and the deferment
                    of payment of the Indemnity of 1901, for your consideration.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hu Shih</hi>
                    </signed>
                </closer>


                <xi:include href="d840-a1.xml" xpointer="d840-a1"/>
            </div>
        </body>
    </text>
