    <text>
        <body>
            <div xml:id="d400">

                <pb facs="0422" n="418" sameAs="frus:frus1939v03/pg418"/>

                <note rend="inline" type="source">693.001/553: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in Japan</hi> (<hi
                            rendition="#italic">Dooman</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Tokyo</hi></placeName>, <date
                            calendar="gregorian" when="1939-06-12T12:00:00+09:00">June 12,
                            1939—noon</date>.<lb/>[Received June 12—6:40 a.m.]</dateline>
                </opener>
                <p>268. Department’s 137, May 20, 3 p.m., via Shanghai, North China trade
                    restrictions.</p>
                <p>The British Embassy presented a note to the Foreign Office on June 9. We
                    presented a note along the lines indicated today.<anchor n="72" xml:id="d400-f1"
                    />
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Dooman</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
