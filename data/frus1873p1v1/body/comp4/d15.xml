    <text>
        <body>
            <div xml:id="d15">

                <pb facs="0134" n="50" sameAs="frus:frus1873p1v1/pg50"/>

                <head>No. 13.<lb/><hi rendition="#italic">Mr. <persName corresp="#p_JJ1" type="from"
                            >Jay</persName> to Mr. <persName corresp="#p_HF1" type="to"
                            >Fish</persName></hi>.</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Vienna</hi></placeName>, <date calendar="gregorian" when="1872-09-03"
                                ><hi rendition="#italic">September</hi> 3, 1872</date>. (Received
                        September 18.)</dateline>
                    <seg rendition="#float-left">No. 464.]</seg>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I herewith inclose the Official Gazette of
                    this morning, containing, in an English and German version, the new treaty of
                    friendship, commerce, and navigation between the Austro-Hungarian Empire and
                    Japan, and the accompanying regulations under which the trade of the
                    Austro-Hungarian monarchy is to be conducted in Japan.</p>
                <p>I have, &amp;c.,</p>
                <closer>
                    <signed><persName corresp="#p_JJ1">JOHN JAY</persName>.</signed>
                </closer>





                <xi:include href="d15-a1.xml" xpointer="d15-a1"/>
