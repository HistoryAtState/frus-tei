    <text>
        <body>
            <div xml:id="d264-a4">

                <pb facs="0693" n="607" sameAs="frus:frus1873p1v1/pg607"/>

                <head>
                    <hi rendition="#italic">Mr. De
                            Long to Mr. Sheppard.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">United
                                States Legation</hi>,<lb/><hi rendition="#italic">Yokohama,
                                Japan</hi></placeName>, <date calendar="gregorian" when="1873-06-16"
                                ><hi rendition="#italic">June</hi> 16, 1873</date>.</dateline>
                    <seg rendition="#float-left">No. 141.]</seg>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: At the request of his excellency Aurelio
                    Garcia y Garcia, envoy extraordinary and minister plenipotentiary of Peru in
                    this empire, I inclose a letter to your care for safe delivery as addressed.</p>
                <p>I will thank you to reply, advising me of your having delivered the same.</p>
                <p>I am, &amp;c.,</p>
                <closer>
                    <signed>C. E. DE LONG.</signed>
                </closer>
            </div>
        </body>
    </text>
