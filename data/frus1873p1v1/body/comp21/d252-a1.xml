    <text>
        <body>
            <div xml:id="d252-a1">

                <pb facs="0652" n="566" sameAs="frus:frus1873p1v1/pg566"/>

                <opener>
                    <seg rendition="#center">[Inclosure 1.]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">Notification.</hi>
                </head>
                <p>American citizens resident in Japan are hereby advised that the Japanese
                    government has issued the following notification to its people, and requested
                    the undersigned to make the same known to his countrymen.</p>
                <closer>
                    <signed>C. E. DE LONG,<lb/><hi
                            rendition="#italic">United States Minister.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
