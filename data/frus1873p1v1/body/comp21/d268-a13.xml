    <text>
        <body>
            <div xml:id="d268-a13">

                <pb facs="0713" n="627" sameAs="frus:frus1873p1v1/pg627"/>

                <opener>
                    <seg rendition="#center">[Inclosure 13, or 1 in 16.]</seg>
                </opener>
                <p>C. E. De Long, Dr., to the
                    undersigned:</p>
                <table cols="2" rows="5">
                    <row role="label">
                        <cell>For 100 inventories</cell>
                        <cell rendition="#nowrap" role="num">$10 00</cell>
                    </row>
                    <row>
                        <cell>Cooly hire, discharging provisions</cell>
                        <cell rendition="#nowrap" role="num">4 10</cell>
                    </row>
                    <row>
                        <cell>Advertising in Japan Herald, Gazette, Nishin Shingrshi, 2 weeks</cell>
                        <cell rendition="#nowrap" role="num">60 00</cell>
                    </row>
                    <row>
                        <cell>Commission on $4,250 at 5%</cell>
                        <cell rendition="#nowrap #border-bottom" role="num">217 50</cell>
                    </row>
                    <row>
                        <cell>Total</cell>
                        <cell rendition="#nowrap" role="num">291 50</cell>
                    </row>
                </table>
                <p>E. &amp; O. E.<lb/>Rec’d payment,</p>
                <closer>C. A. FLETCHER &amp; Co.,<lb/><hi rendition="#italic"
                        >Auctioneers.</hi><lb/><dateline rendition="#float-left"><placeName><hi
                                rendition="#small-caps">Yokohama</hi></placeName>, <date
                            calendar="gregorian" when="1873-08-11"><hi rendition="#italic"
                                >August</hi> 11, 1873</date>.</dateline></closer>
            </div>
        </body>
    </text>
