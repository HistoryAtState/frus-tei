                <pb facs="0713" n="627" sameAs="frus:frus1873p1v1/pg627"/>

                <opener>
                    <seg rendition="#center">[Inclosure 14, or 2 in 16.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Yokohama</hi></placeName>, <date calendar="gregorian"
                            when="1873-08-11"><hi rendition="#italic">August</hi> 11,
                        1873</date>.</dateline>
                </opener>
                <p rendition="#flush">$2,245 22/100.</p>
                <p>Received from C. E. De Long, United
                    States minister, the sum of twenty-two hundred forty-five dollars twenty-two
                    cents Mexican, being disbursements of Peruvian bark Maria Luz.</p>
                <closer>WALSH, HALL &amp; CO.</closer>
            </div>
