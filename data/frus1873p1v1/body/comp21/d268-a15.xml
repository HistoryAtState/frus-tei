    <text>
        <body>
            <div xml:id="d268-a15">

                <pb facs="0714" n="628" xml:id="pg628"/>

                <opener>
                    <seg rendition="#center">[Inclosure 15, or 3 in 16.]</seg>
                </opener>
                <p rendition="#center">[From the Hong-Kong and Shanghai Banking Corporation.]</p>
                <p><hi rendition="#small-caps">Dear Sir</hi>: I am in receipt of Messrs. Walsh, Hall
                    &amp; Co.’s check for $4,713.28, which I have placed in current deposit account
                    in trust for the creditors of the Maria Luz.</p>
                <p>Yours, faithfully,</p>
                <closer>
                    <signed><persName>J. G. HODGSON</persName>,<lb/><hi rendition="#italic">Account
                            Manager.</hi></signed>
                </closer>
                <postscript>
                    <p><persName corresp="#p_CEDL1"><hi rendition="#small-caps">C. E. De
                            Long</hi></persName>,<lb/><hi rendition="#italic">United States
                            Minister.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
