    <text>
        <body>
            <div xml:id="d269">

                <pb facs="0715" n="629" sameAs="frus:frus1873p1v1/pg629"/>

                <head>No. 266.<lb/><hi rendition="#italic">Mr. De Long to Mr. Fish</hi>.</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">United
                                States Legation, Japan</hi></placeName>,<lb/><date
                            calendar="gregorian" when="1873-09-02"><hi rendition="#italic"
                                >September</hi> 2, 1873</date>. (Received October 8.)</dateline>
                    <seg rendition="#float-left">No. 470.]</seg>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to forward to you herewith
                    a printed copy of the treaty concluded between Japan and Peru, which was handed
                    to me unofficially by the Peruvian envoy, (inclosure No. 1.)</p>
                <p>I remain, &amp;c.,</p>
                <closer>
                    <signed>
                        C. E. <hi rendition="#small-caps">De</hi>
                            Long.
                    </signed>
                </closer>


                <xi:include href="d269-a1.xml" xpointer="d269-a1"/>
