    <text>
        <body>
            <div xml:id="d298-a3-a2">

                <pb facs="0765" n="679" sameAs="frus:frus1873p1v1/pg679"/>

                <p rendition="#flush">To the citizen <hi rendition="#small-caps">Blas
                        Balcarcel</hi>,<lb/><hi rendition="#italic">Minister of Public Works,
                        Colonization, Industry, and Commerce.</hi></p>
                <p>And I communicate the same to you for the consequent ends.</p>
                <p>Independence and liberty.</p>
                <closer>
                    <signed>BALCARCEL.</signed>
                    <lb/>
                    <dateline rendition="#float-left"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1872-12-10"><hi rendition="#italic">December</hi> 10,
                        1872</date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
