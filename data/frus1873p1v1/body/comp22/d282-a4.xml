    <text>
        <body>
            <div xml:id="d282-a4">

                <pb facs="0732" n="646" sameAs="frus:frus1873p1v1/pg646"/>

                <opener>
                    <seg rendition="#center">[Indorsements.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Headquarters Department of Texas</hi>,<lb/><hi rendition="#italic"
                                >San Antonio</hi></placeName>, <date calendar="gregorian"
                            when="1872-12-24"><hi rendition="#italic">December</hi> 24,
                        1872</date>.</dateline>
                </opener>
                <p>Respectfully forwarded to the headquarters Military Division of the Missouri, for
                    the information of the Lieutenant-General commanding.</p>
                <closer>
                    <signed>C. C. AUGUR,<lb/><hi rendition="#italic">Brigadier-General, U. S.
                            Army.</hi></signed>
                </closer>
            </div>
