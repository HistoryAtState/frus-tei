    <text>
        <body>
            <div xml:id="d297">

                <pb facs="0756" n="670" sameAs="frus:frus1873p1v1/pg670"/>

                <head>No. 294<lb/><hi rendition="#italic">Mr. <persName type="from"
                            >Nelson</persName> to Mr. <persName corresp="#p_HF1" type="to"
                            >Fish</persName>.</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1873-06-07"><hi rendition="#italic">June</hi> 7, 1873</date>.
                        (Received June 25.)</dateline>
                    <seg rendition="#float-left">No. 743.]</seg>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I herewith inclose a translation of the
                    addresses delivered at the closing of the last session of the sixth
                    Constitutional Congress, on the 31st ultimo, by President Lerdo and the
                    President of Congress.</p>
                <p>I have, &amp;c.,</p>
                <closer>
                    <signed><persName>THOMAS H. NELSON</persName>.</signed>
                </closer>



