    <text>
        <body>
            <div xml:id="d298-a3-a1">

                <pb facs="0765" n="679" sameAs="frus:frus1873p1v1/pg679"/>

                <p>Wherefore I order that this decree be printed, published, circulated, and that
                    due compliance be given to it.</p>
                <closer>
                    <dateline rendition="#float-left">Dated in the palace of the national government
                        of <placeName>Mexico</placeName>, <date calendar="gregorian"
                            when="1872-12-10">December 10, 1872</date>.</dateline>
                    <lb/>
                    <signed>SEBASTIAN LERDO DE TEJADA.</signed>
                </closer>
            </div>
        </body>
