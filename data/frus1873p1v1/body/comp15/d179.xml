    <text>
        <body>
            <div xml:id="d179">

                <pb facs="0488" n="402" sameAs="frus:frus1873p1v1/pg402"/>

                <head>No. 177.<lb/><hi rendition="#italic"><persName corresp="#p_SET1" type="from"
                            >Sir Edward Thornton</persName> to Mr. <persName corresp="#p_HF1"
                            type="to">Fish</persName>.</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1872-12-04"><hi rendition="#italic">December</hi> 4, 1872</date>.
                        (Received December 5.)</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose for your
                    information a certified copy of the act of the legislature of Canada relating to
                    the Treaty of Washington of May 8, 1871.</p>
                <p>I have, &amp;c.,</p>
                <closer>
                    <signed><persName corresp="#p_SET1">EDW’D THORNTON</persName>.</signed>
                </closer>



                <xi:include href="d179-a1.xml" xpointer="d179-a1"/>
