    <text>
        <body>
            <div xml:id="d169-a6">

                <pb facs="0467" n="381" sameAs="frus:frus1873p1v1/pg381"/>

                <head><hi rendition="#small-caps">Schedule A</hi>.</head>
                <table cols="3" rows="5">
                    <row>
                        <cell>On wines, ale, porter, or liquors, per old wine-gallon</cell>
                        <cell/>
                        <cell>6<hi rendition="#italic">d</hi>.</cell>
                    </row>
                    <row>
                        <cell>On spirits, per old wine-gallon</cell>
                        <cell>2<hi rendition="#italic">s</hi>.</cell>
                        <cell>6<hi rendition="#italic">d</hi>.</cell>
                    </row>
                    <row>
                        <cell>On cigars, snuff, or tobacco in any shape, per pound</cell>
                        <cell/>
                        <cell>6<hi rendition="#italic">d</hi>.</cell>
                    </row>
                    <row>
                        <cell>On gun powder, per pound</cell>
                        <cell/>
                        <cell>6<hi rendition="#italic">d</hi>.</cell>
                    </row>
                    <row>
                        <cell>On guns, each</cell>
                        <cell/>
                        <cell>2<hi rendition="#italic">s</hi>.</cell>
                    </row>
                </table>
                <p>On all other goods of every kind an <hi rendition="#italic">ad-valorem</hi> duty
                    of ten per cent. on the invoice-price.</p>
                <p rendition="#center"><hi rendition="#small-caps">Schedule B</hi>.</p>
                <p>Corn, rice, and grain; meal and flour of every kind; biscuits; fresh, salted, and
                    preserved meats, and fish, live stock.</p>
                <p>Books and newspapers.</p>
                <p>British coins, and other coins in the settlement.</p>
                <p>Passengers’ luggage.</p>
                <p>Puncheon-shooks.</p>
                <p>Packages in which goods are usually imported.</p>
            </div>
        </body>
