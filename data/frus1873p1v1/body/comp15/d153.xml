        <body>
            <div xml:id="d153">

                <pb facs="0388" n="302" sameAs="frus:frus1873p1v1/pg302"/>

                <head>No. 151.<lb/><hi rendition="#italic">Mr. <persName type="from"
                            >Moran</persName> to Mr. <persName corresp="#p_HF1" type="to"
                            >Fish</persName></hi>.</head>
                <opener>
                    <seg rendition="#center">[Extract.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1872-11-21"><hi rendition="#italic">November</hi> 21, 1872</date>.
                        (Received December 7.)</dateline>
                    <seg rendition="#float-left">No. 419.]</seg>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: * * * * * * *</p>
                <p>I forward herewith * * for your information * * a copy of the * * [extradition]
                    act of 1870. * * * *</p>
                <p>I have, &amp;c.,</p>
                <closer>
                    <signed><persName>BENJAMIN MORAN</persName>.</signed>
                </closer>


                <xi:include href="d153-a1.xml" xpointer="d153-a1"/>
