    <text>
        <body>
            <div xml:id="d196">

                <pb facs="0516" n="430" sameAs="frus:frus1873p1v1/pg430"/>

                <head>No. 194.<lb/><hi rendition="#italic"><persName corresp="#p_SET1" type="from"
                            >Sir Edward Thornton</persName> to Mr. <persName type="to"
                            >Davis</persName>.</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Catskill Station</hi></placeName>, <date calendar="gregorian"
                            when="1873-07-18"><hi rendition="#italic">July</hi> 18, 1873</date>.
                        (Received July 19.)</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: In compliance with an instruction which I
                    have received from Lord Granville, I have the honor to transmit herewith, for
                    the information of the Government of the United States, a copy of the treaty
                    which has been concluded with the Sultan of Zanzibar for the suppression of the
                    slave-trade.</p>
                <p>I have, &amp;c.,</p>
                <closer>
                    <signed><persName corresp="#p_SET1">EDW’D THORNTON</persName>.</signed>
                </closer>



                <xi:include href="d196-a1.xml" xpointer="d196-a1"/>
