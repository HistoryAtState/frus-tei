    <text>
        <body>
            <div xml:id="d169-a3">

                <pb facs="0465" n="379" sameAs="frus:frus1873p1v1/pg379"/>

                <opener>
                    <seg rendition="#center">[Inclosure No. 2, with dispatch June 7.]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">Collector Russell to Mr. Butler.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Custom-House, Boston, Mass</hi>.,<lb/><hi rendition="#italic"
                                >Collector’s Office</hi></placeName>, <date calendar="gregorian"
                            when="1873-06-05"><hi rendition="#italic">June</hi> 5,
                        1873</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Dear General</hi>: The exporters of rum, having been
                    saved once by your efforts, call on you again, as you will see by the inclosed.
                    Mr. Bartlett is a most worthy man, and an intimate friend of Secretary
                    Richardson.</p>
                <p>Yours, very truly,</p>
                <closer>
                    <signed>THOMAS RUSSELL.</signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">B. F. Butler</hi></p>
                </postscript>
            </div>
        </body>
    </text>
