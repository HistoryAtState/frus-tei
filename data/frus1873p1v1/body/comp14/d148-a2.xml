    <text>
        <body>
            <div xml:id="d148-a2">

                <pb facs="0384" n="298" sameAs="frus:frus1873p1v1/pg298"/>

                <head>II.<lb/><hi rendition="#italic">Mr. Adams to
                        Mr. Bancroft</hi>.</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >British Embassy</hi>, <hi rendition="#italic"
                            >Berlin</hi></placeName>, <date calendar="gregorian" when="1873-08-30"
                                ><hi rendition="#italic">August</hi> 30, 1873</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">My Dear Mr. Bancroft</hi>: I beg to inclose to you herewith a copy of a
                    letter which has been forwarded to me by Mr. Hammond in the absence of Lord
                    Tenderden, respecting the matter about which I inquired according to your
                    wish.</p>
                <p>Believe me, &amp;c.,</p>
                <closer>
                    <signed>F. O. ADAMS.</signed>
                </closer>
            </div>
        </body>
    </text>
