    <standOff>
        <listAnnotation>
            <note corresp="#d607-f1" n="1" type="source" xml:id="d607-f1-content">
                <p>One of a series of papers prepared for the briefing book for the Secretary’s trip
                    to the Middle East and South Asia; see <ref target="#d604-f1">footnote 1,
                        Document 604</ref>.</p>
            </note>
            <note corresp="#d607-f2" n="2" xml:id="d607-f2-content">
                <p>Annexed to this summary paper as tabs were position papers on each of the
                    problems summarized.</p>
            </note>
