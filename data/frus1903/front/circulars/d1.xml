    <text>
        <body>
            <div xml:id="d1">

                <pb facs="0083" n="LXXXIII" sameAs="frus:frus1903/pgLXXXIII"/>

                <head><hi rendition="#italic">Mr. Hay to Mr. Ames.</hi><anchor n="a" xml:id="d1-f1"
                    /></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1903-11-14"><hi rendition="#italic">November 14,
                        1903</hi></date>.</dateline></opener>
                <p>The President yesterday fully recognized the Republic of Panama and formally
                    received its minister plenipotentiary. You will promptly communicate this to the
                    Government to which you are accredited.</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1-f1" n="a" type="source" xml:id="d1-f1-content">
                <p>Same instruction, mutatis mutandis, to all United States diplomatic
                    representatives.</p>
            </note>
        </listAnnotation>
    </standOff>
