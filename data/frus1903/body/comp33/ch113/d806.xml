                <pb facs="0881" n="795" sameAs="frus:frus1903/pg795"/>

                <head><hi rendition="#italic">Mr. Bowen to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Caracas</hi></placeName>, <date calendar="gregorian"
                            when="1902-12-13"><hi rendition="#italic">December 13,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 141.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith copies
                    of the letters I received and sent in regard to the matter of taking charge of
                    the British and German legations.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Herbert W. Bowen.</hi></signed></closer>







