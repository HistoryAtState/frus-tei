    <text>
        <body>
            <div xml:id="d830">

                <pb facs="0888" n="802" sameAs="frus:frus1903/pg802"/>

                <head><hi rendition="#italic">Mr. Bowen to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Caracas</hi></placeName>, <date calendar="gregorian"
                            when="1902-12-27"><hi rendition="#italic">December 27,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 145.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose a translation
                    of a petition to President Castro from the leading men of Caracas asking that I
                    be authorized to arrange the pending difficulty between Venezuela and Great
                    Britain, Germany, and Italy.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Herbert W. Bowen.</hi></signed></closer>


                <xi:include href="d830-a1.xml" xpointer="d830-a1"/>
