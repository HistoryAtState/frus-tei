                <pb facs="0884" n="798" sameAs="frus:frus1903/pg798"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Bowen.</hi></head>
                <opener><seg rendition="#center">[Telegram.—Paraphrase.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-12-16"><hi rendition="#italic">December 16,
                        1902</hi></date>.</dateline></opener>
                <p>(Mr. Hay states that no reply to the proposition to arbitrate has yet been made
                    known by Great Britain and Germany; that he has repeated the proposition with
                    strong commendation, and that Mr. Bowen will be promptly advised of the receipt
                    of replies.)</p>
            </div>
        </body>
