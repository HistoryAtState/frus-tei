    <text>
        <body>
            <div xml:id="d92-a1">

                <pb facs="0169" n="85" sameAs="frus:frus1903/pg85"/>

                <opener><seg rendition="#center">[Inclosure 1.]</seg></opener>
                <head><hi rendition="#italic">The Acting Secretary of the
                            Navy to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Navy Department</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1903-10-02"><hi rendition="#italic">October 2,
                        1903</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose for your
                    information copies of correspondence recently received from the commander in
                    chief United States Asiatic fleet, with reference to visits by small gunboats in
                    certain parts of the upper Yangtse, China, and to request such comment as the
                    State Department may desire to make.</p>
                <p>Very respectfully,</p>
                <closer><signed><hi rendition="#small-caps">Chas. H. Darling</hi>, <hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>
            </div>
        </body>
