    <text>
        <body>
            <div xml:id="d37">

                <pb facs="0133" n="49" sameAs="frus:frus1903/pg49"/>

                <head><hi rendition="#italic">Mr. Conger to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1903-03-10"><hi rendition="#italic">March 10,
                        1903</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1233.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit herewith copies of a dispatch
                    from Consul Miller, of Niuchwang, concerning Russian operations in
                    Manchuria.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">E. H. Conger.</hi></signed></closer>


                <xi:include href="d37-a1.xml" xpointer="d37-a1"/>
