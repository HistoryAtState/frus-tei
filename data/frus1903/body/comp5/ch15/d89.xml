    <text>
        <body>
            <div xml:id="d89">

                <pb facs="0166" n="82" sameAs="frus:frus1903/pg82"/>

                <head><hi rendition="#italic">Mr. Conger to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1903-02-21"><hi rendition="#italic">February 21,
                        1903</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1219.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose copies of
                    correspondence with Consul Fowler, of Chefoo, concerning the right of certain
                    consular officers (being resident merchants or professional men) to take part in
                    the deliberations of those who are in the regular consular service. Respectfully
                    requesting your opinion upon the question,</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">E. H. Conger.</hi></signed></closer>



                <xi:include href="d89-a1.xml" xpointer="d89-a1"/>
