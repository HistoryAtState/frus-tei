    <text>
        <body>
            <div xml:id="d11">

                <pb facs="0101" n="17" sameAs="frus:frus1903/pg17"/>

                <head><hi rendition="#italic">Mr. Hay to Mr. Storer.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1903-11-23"><hi rendition="#italic">November 23,
                        1903</hi>.</date></dateline>
                    <seg rendition="#float-left">No. 56.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my instruction of the 14th
                    instant, I inclose a copy of a further letter from Charles Strauss, relating to
                    the certificate stated to be required from this Department that Austro-Hungarian
                    subjects are free to engage in commerce in this country.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>



                <xi:include href="d11-a1.xml" xpointer="d11-a1"/>
            </div>
