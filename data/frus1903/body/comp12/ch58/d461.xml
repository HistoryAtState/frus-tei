    <text>
        <body>
            <div xml:id="d461">

                <pb facs="0552" n="468" sameAs="frus:frus1903/pg468"/>

                <head><hi rendition="#italic">Mr. White to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >London</hi></placeName>, <date calendar="gregorian" when="1903-01-09"
                                ><hi rendition="#italic">January 9, 1903</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1024.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith copies
                    of a telegram<anchor n="a" xml:id="d461-f1"/> which I received from you
                    yesterday, of a note which I thereupon addressed to the Marquis of Lansdowne,
                    and of a telegram<anchor n="a" xml:id="d461-f2"/> in which I informed you that
                    your instructions had been carried out; also of his lordship’s reply to my
                    note.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Henry White.</hi></signed></closer>



                <xi:include href="d461-a1.xml" xpointer="d461-a1"/>
                <xi:include href="d461-a2.xml" xpointer="d461-a2"/>
            </div>
        </body>
    </text>
