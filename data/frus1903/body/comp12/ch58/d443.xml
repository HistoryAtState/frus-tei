                <pb facs="0543" n="459" sameAs="frus:frus1903/pg459"/>

                <head><hi rendition="#italic">Mr. White to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >London</hi></placeName>, <date calendar="gregorian" when="1902-12-20"
                                ><hi rendition="#italic">December 20, 1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1008.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my dispatch, No. 1005, of
                    yesterday’s date, I have the honor to inclose herewith the copy of a note which
                    I received yesterday from His Majesty’s secretary of state for foreign affairs,
                    in reply to mine of the 13th instant, of which a copy has already been forwarded
                    to you.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Henry White.</hi></signed></closer>


                <xi:include href="d443-a1.xml" xpointer="d443-a1"/>
