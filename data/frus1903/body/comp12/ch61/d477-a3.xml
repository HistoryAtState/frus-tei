    <text>
        <body>
            <div xml:id="d477-a3">

                <pb facs="0569" n="485" sameAs="frus:frus1903/pg485"/>

                <opener><seg rendition="#center">[Subinclosure 2.]</seg></opener>
                <head><hi rendition="#italic">Mr. Evans to Messrs. Gray, Dawes &amp; Co.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Consulate-General</hi>,<lb/><hi rendition="#italic"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1902-10-14"><hi rendition="#italic">October 14,
                        1902</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Sirs</hi>: I. am in receipt of your letter of
                    the 13th instant regarding the effects of the late Capt. Charles E. Schonberg,
                    who died on board the steamship <hi rendition="#italic">Manora</hi>. If you will
                    have the effects in question delivered to me I will take charge of them for
                    delivery to the person or persons entitled thereto.</p>
                <p>Yours, faithfully,</p>
                <closer><signed><hi rendition="#small-caps">H. Clay Evans</hi>,<lb/><hi
                            rendition="#italic">Consul-General.</hi></signed></closer>
            </div>
        </body>
    </text>
