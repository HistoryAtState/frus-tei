    <text>
        <body>
            <div xml:id="d522">

                <pb facs="0618" n="534" sameAs="frus:frus1903/pg534"/>

                <head><hi rendition="#italic">Mr. Raikes to Mr.
                            Loomis.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >British Embassy</hi>,<lb/><hi rendition="#italic">Newport R.
                                I,</hi></placeName>, <date calendar="gregorian" when="1903-07-03"
                                ><hi rendition="#italic">July 3,
                    1903</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge receipt of
                    your note of the 1st instant, transmitting the United States counter case in the
                    Alaskan <pb facs="0619" n="535" xml:id="pg535"/> boundary dispute, together with
                    a communication from the agent of the United States to the agent of Great
                    Britain.</p>
                <p>I have the honor to be, with the highest consideration, sir, your most obedient,
                    humble servant,</p>
                <closer><signed><hi rendition="#small-caps">Arthur S. Raikes.</hi></signed></closer>
                <postscript>
                    <p>The Hon. <hi rendition="#small-caps">F. B. Loomis</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary of State, etc.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
