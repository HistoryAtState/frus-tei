    <text>
        <body>
            <div xml:id="d515">

                <pb facs="0613" n="529" sameAs="frus:frus1903/pg529"/>

                <head><hi rendition="#italic">Mr. Raikes to Mr.
                            Hay.</hi></head>
                <opener><seg rendition="#center">[Personal.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >British Embassy</hi>,<lb/><hi rendition="#italic">Newport, R.
                                I.</hi></placeName>, <date calendar="gregorian" when="1903-06-28"
                                ><hi rendition="#italic">June 28,
                    1903</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. Secretary</hi>: I beg to acknowledge the
                    receipt of your note of the 26th instant inclosing a memorandum relative to the
                    application of His Majesty’s Government for an extension of time for the
                    presentation of the British counter case before the Alaskan Boundary
                    Tribunal.</p>
                <p>I am, dear Mr. Secretary, yours, very truly,</p>
                <closer><signed><hi rendition="#small-caps">Arthur S. Raikes.</hi></signed></closer>
            </div>
        </body>
    </text>
