    <text>
        <body>
            <div xml:id="d514">

                <pb facs="0610" n="526" sameAs="frus:frus1903/pg526"/>

                <head><hi rendition="#italic">Mr. Hay to Mr. Raikes.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1903-06-26"><hi rendition="#italic">June 26,
                        1903</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. Raikes</hi>: I inclose a memorandum in reply
                    to the argument of the British Government of the 23d of June, for an extension
                    of time for the presentation of evidence in the British counter case.</p>
                <p>I am, my dear Mr. Raikes, sincerely yours,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>



                <xi:include href="d514-a1.xml" xpointer="d514-a1"/>
