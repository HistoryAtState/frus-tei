    <text>
        <body>
            <div xml:id="d503">

                <pb facs="0589" n="505" xml:id="pg505"/>

                <head><hi rendition="#italic">Sir M. H. Herbert to
                        Mr. Foster.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >British Embassy</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1903-06-08"><hi rendition="#italic">June 8,
                        1903</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. Foster</hi>: With reference to my note to
                    Mr. Hay of the 29th May, I received to-day from the British agent the inclosed
                    detailed list of the documents the production of which he has already asked
                    for.</p>
                <p>Yours, very truly,</p>
                <closer><signed><hi rendition="#small-caps">Michael H.
                    Herbert.</hi></signed></closer>


                <xi:include href="d503-a1.xml" xpointer="d503-a1"/>
