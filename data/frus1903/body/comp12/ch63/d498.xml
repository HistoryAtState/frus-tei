    <text>
        <body>
            <div xml:id="d498">

                <pb facs="0585" n="501" xml:id="pg501"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Choate.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1903-05-25"><hi rendition="#italic">May 25,
                        1903</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1203.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith a letter from John W.
                    Foster, esq., agent of the United States before the Alaskan Boundary Tribunal,
                    addressed to the Hon. Clifford Sifton, agent of Great Britain, making demand, in
                    pursuance of paragraph 4 of Article II of the treaty of January 24, 1903, for
                    copies of certain documents therein particularly described which are specified
                    or referred to in the British case without annexing copies thereto.</p>
                <p>You will communicate this demand, through the foreign office, to the British
                    agent.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>


                <xi:include href="d498-a1.xml" xpointer="d498-a1"/>
