    <text>
        <body>
            <div xml:id="d533">

                <pb facs="0625" n="541" sameAs="frus:frus1903/pg541"/>

                <head><hi rendition="#italic">Mr. Choate to Mr.
                            Hay.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1903-08-07"><hi rendition="#italic">August 7,
                        1903</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 53.]</seg></opener>
                <p>Referring to your telegram of the 5th [4th] August, it is agreed that tribunal
                    shall meet on September 3.</p>
                <closer><signed><hi rendition="#small-caps">Choate.</hi></signed></closer>
            </div>
        </body>
    </text>
