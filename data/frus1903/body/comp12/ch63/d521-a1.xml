    <text>
        <body>
            <div xml:id="d521-a1">

                <pb facs="0618" n="534" sameAs="frus:frus1903/pg534"/>

                <opener><seg rendition="#center">[Inclosure.]</seg></opener>
                <head><hi rendition="#italic">Mr. Lansing to Mr. Sifton.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1903-06-30"><hi rendition="#italic">June 30,
                        1903</hi>.</date></dateline></opener>
                <p rendition="#flush">The Hon. <hi rendition="#small-caps">Clifford
                        Sifton</hi>,<lb/><hi rendition="#italic">Agent for Great Britain before the
                        Alaskan Boundary tribunal</hi>.</p>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor, in accordance with the
                    understanding reached between the Governments of the United States and Great
                    Britain, to herewith deliver to you certified copies of documents in the Russian
                    and French languages, of which translations were appended to the case of the
                    United States, together with certified copies of certain diplomatic
                    correspondence in the English language, also appended, all of which documents
                    are in the files and records of the Department of State.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer><signed><hi rendition="#small-caps">Robert Lansing</hi>,<lb/><hi
                            rendition="#italic">Acting Agent of the United States before the Alaskan
                            Boundary Tribunal.</hi></signed></closer>
            </div>
        </body>
    </text>
