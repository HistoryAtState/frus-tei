    <text>
        <body>
            <div xml:id="d3">

                <pb facs="0089" n="5" sameAs="frus:frus1903/pg5"/>

                <head><hi rendition="#italic">Mr. Hay to Señor Garcia Mérou.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1903-02-17"><hi rendition="#italic">February 17,
                        1903</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Minister</hi>: I inclose a memorandum in
                    regard to Mr. Drago’s instruction of December 29, 1902, a copy of which you left
                    with me.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>


                <xi:include href="d3-a1.xml" xpointer="d3-a1"/>
