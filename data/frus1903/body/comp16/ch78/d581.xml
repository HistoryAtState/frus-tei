    <text>
        <body>
            <div xml:id="d581">

                <pb facs="0690" n="604" sameAs="frus:frus1903/pg604"/>

                <head><hi rendition="#italic">Mr. Meyer to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Rome</hi></placeName>, <date calendar="gregorian" when="1902-12-25"><hi
                                rendition="#italic">December 25, 1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 218.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to confirm the telegram
                    sent to you on December 24 instant.</p>
                <p>A copy of the official note upon which this telegram was based is inclosed
                    herewith with a translation.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">G. V. L. Meyer.</hi></signed></closer>


                <xi:include href="d581-a1.xml" xpointer="d581-a1"/>
            </div>
