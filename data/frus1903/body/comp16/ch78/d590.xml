    <text>
        <body>
            <div xml:id="d590">

                <pb facs="0695" n="609" sameAs="frus:frus1903/pg609"/>

                <head><hi rendition="#italic">Mr. Meyer to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Rome</hi></placeName>, <date calendar="gregorian" when="1903-01-14"><hi
                                rendition="#italic">January 14, 1903</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 225.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the
                    receipt, on January 11, of your cable dispatch dated January 10.</p>
                <p>I immediately communicated the contents of this cablegram to the minister for
                    foreign affairs and on the same day was informed by him that he was consulting
                    the Governments of Germany and Great Britain before replying. A copy of the
                    minister’s note with translation is inclosed herein.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">G. V. L. Meyer.</hi></signed></closer>


                <xi:include href="d590-a1.xml" xpointer="d590-a1"/>
