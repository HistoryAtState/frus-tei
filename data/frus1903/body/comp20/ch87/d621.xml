    <text>
        <body>
            <div xml:id="d621">

                <pb facs="0731" n="645" sameAs="frus:frus1903/pg645"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Clayton.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1903-02-09"><hi rendition="#italic">February 9,
                        1903</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 839.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to your No. 998<anchor n="a"
                        xml:id="d621-f1"/> of June 27, 1901, reporting on the arrest and
                    imprisonment in Mexico of American citizens employed as train hands on railways
                    in that country, I have now to ask you to report any additional cases that may
                    have arisen since the date of that report, and the present status of those
                    heretofore reported.</p>
                <p>I inclose herewith for your information copies of a letter and its inclosure from
                    the governor of Michigan, which have occasioned this instruction.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>



                <xi:include href="d621-a1.xml" xpointer="d621-a1"/>
                <xi:include href="d621-a2.xml" xpointer="d621-a2"/>
            </div>
        </body>
    </text>
