    <text>
        <body>
            <div xml:id="d621-a1">

                <pb facs="0731" n="645" sameAs="frus:frus1903/pg645"/>

                <opener><seg rendition="#center">[Inclosure.]</seg></opener>
                <head><hi rendition="#italic">Mr. Bliss to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >State of Michigan, Executive Office</hi>,<lb/><hi
                                rendition="#italic">Lansing</hi></placeName>, <date
                            calendar="gregorian" when="1903-01-30"><hi rendition="#italic">January
                                30, 1903</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I am in receipt of the inclosed
                    communication from the manager and secretary of the Brotherhood Relief
                    Committee, Kansas City, Mo. Will you kindly inform me what is your understanding
                    of the condition recited therein?</p>
                <p>Yours, respectfully,</p>
                <closer><signed><hi rendition="#small-caps">A. T. Bliss</hi>, <hi
                            rendition="#italic">Governor.</hi></signed></closer>
            </div>
        </body>
