    <text>
        <body>
            <div xml:id="d626-a2">

                <pb facs="0747" n="661" sameAs="frus:frus1903/pg661"/>

                <opener><seg rendition="#center">[Inclosure 2.]</seg></opener>
                <head><hi rendition="#italic">Mexican Central Railway Company, Limited.</hi></head>
                <opener><dateline rendition="#float-right"><date calendar="gregorian"
                            when="1903-07-24"><hi rendition="#small-caps">July</hi> 24,
                        1903</date>.</dateline></opener>
                <p>Received of Mr. J. Shinabu $4.75 Mexican currency, for 1 person, as alien tax
                    imposed by the United States Government. Ticket, For Mexico, number——;
                    destination, El Paso.</p>
                <closer><signed><hi rendition="#small-caps">D. A. Skell</hi>, <hi
                            rendition="#italic">Conductor or Agent</hi>.</signed></closer>
                <postscript>
                    <p>This tax must be paid each time on entering the U. S.</p>
                </postscript>
            </div>
