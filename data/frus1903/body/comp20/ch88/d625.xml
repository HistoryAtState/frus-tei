    <text>
        <body>
            <div xml:id="d625">

                <pb facs="0743" n="657" sameAs="frus:frus1903/pg657"/>

                <head><hi rendition="#italic">Mr. Clayton to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1903-09-21"><hi rendition="#italic">September 21,
                        1903</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1955.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith
                    extracts from the message delivered by President Diaz on the opening of the
                    Mexican Congress in this city, on the 16th instant.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Powell Clayton.</hi></signed></closer>


                <xi:include href="d625-a1.xml" xpointer="d625-a1"/>
            </div>
