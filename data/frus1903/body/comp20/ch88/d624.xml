    <text>
        <body>
            <div xml:id="d624">

                <pb facs="0738" n="652" sameAs="frus:frus1903/pg652"/>

                <head><hi rendition="#italic">Mr. Clayton to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1903-04-06"><hi rendition="#italic">April 6,
                        1903</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1763.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose translation of
                    extracts from the message of President Diaz delivered at the opening of the
                    Mexican Congress on the 1st instant, and to call the Department’s attention to
                    that part of the message referring to the Pious Fund award.</p>
                <p>I have the honor, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Powell Clayton.</hi></signed></closer>



                <xi:include href="d624-a1.xml" xpointer="d624-a1"/>
