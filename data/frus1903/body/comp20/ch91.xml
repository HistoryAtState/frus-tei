                <pb facs="0758" n="672" sameAs="frus:frus1903/pg672"/>

                <head>Supplementary convention between the United States and Mexico for the mutual
                    extradition of fugitives from justice</head>
                <p><hi rendition="#italic">Signed at the City of Mexico June 25,
                        1902.<lb/>Ratification advised by the Senate March 11, 1903.<lb/>Ratified by
                        the President March 18, 1903.<lb/>Ratified by Mexico March 28,
                        1903.<lb/>Ratifications exchanged at the City of Mexico March 28,
                        1903.<lb/>Proclaimed April 3, 1903.</hi></p>

                <xi:include href="ch91/d634.xml" xpointer="d634"/>
