    <text>
        <body>
            <div xml:id="d552">

                <pb facs="0663" n="577" sameAs="frus:frus1903/pg577"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Combs.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1903-07-14"><hi rendition="#italic">July 14,
                        1903</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 57.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith copy of a note from the
                    Chinese minister at this capital, expressing his sincere appreciation of the
                    good offices <pb facs="0664" n="578" xml:id="pg578"/> exerted by you on behalf
                    of certain Chinese subjects in Guatemala, and expressing also the hope that the
                    continuance of those good offices will prevent further imposition upon Chinese
                    subjects.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>


                <xi:include href="d552-a1.xml" xpointer="d552-a1"/>
            </div>
