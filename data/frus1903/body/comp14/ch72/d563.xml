    <text>
        <body>
            <div xml:id="d563">

                <pb facs="0673" n="587" sameAs="frus:frus1903/pg587"/>

                <head><hi rendition="#italic">Mr. Loomis to Mr.
                            Combs.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1903-07-01"><hi rendition="#italic">July 1,
                        1903</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 52.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith for your information a
                    copy of a letter from Mr. J. Zenón Posadas, of San Francisco, Cal., expressing
                    his gratitude for your prompt and efficient services rendered to his son, in
                    securing his release from arrest by the officers of the Guatemalan
                    Government.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Francis B. Loomis</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>


                <xi:include href="d563-a1.xml" xpointer="d563-a1"/>
            </div>
        </body>
    </text>
