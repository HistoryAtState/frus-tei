    <text>
        <body>
            <div xml:id="d658-a2">

                <pb facs="0781" n="695" sameAs="frus:frus1903/pg695"/>

                <p rendition="#flush">To His <hi rendition="#small-caps">Excellency the President of
                        the Republic</hi>:</p>
                <p>Whereas the above law has not been opportunely promulgated by the Executive, in
                    virtue of article 71 of the constitution, I order it to be printed, circulated,
                    and communicated to the bureau of justice, worship, and instruction for the
                    necessary steps to be taken for its observance.</p>
                <closer>
                    <dateline rendition="#float-left"><placeName><placeName type="venue">Hall of
                                Congress</placeName>, in <placeName type="city"
                            >Lima</placeName></placeName>, on <date calendar="gregorian"
                            when="1903-11-23">the 23d of November, 1903</date>.</dateline>
                    <lb/>
                    <signed>
                        <list>
                            <item><hi rendition="#small-caps">Nicañor Alvarez Calderón</hi>,<lb/><hi
                                    rendition="#italic">President of Congress</hi>.</item>
                            <item><hi rendition="#small-caps">Victor Castro Iglesias</hi>,<lb/><hi
                                    rendition="#italic">Secretary of Congress</hi>.</item>
                            <item><hi rendition="#small-caps">Emesto L. Raez</hi>,<lb/><hi
                                    rendition="#italic">Secretary of Congress.</hi></item>
                        </list>
                    </signed></closer>
            </div>
        </body>
    </text>
