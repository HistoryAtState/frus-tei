    <text>
        <body>
            <div xml:id="d342">

                <pb facs="0467" n="383" sameAs="frus:frus1903/pg383"/>

                <head><hi rendition="#italic">Mr. Swenson to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Copenhagen</hi></placeName>, <date calendar="gregorian"
                            when="1903-03-13"><hi rendition="#italic">March 13,
                        1903</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 295.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith clippings from
                    Berlingske Tidende and the London Times, commenting on the German Emperor’s
                    approaching visit to the Danish court.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Laurits S.
                    Swenson.</hi></signed></closer>




