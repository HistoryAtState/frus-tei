    <text>
        <body>
            <div xml:id="d350">

                <pb facs="0477" n="393" sameAs="frus:frus1903/pg393"/>

                <head><hi rendition="#italic">Mr. Powell to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Port au Prince</hi></placeName>, <date calendar="gregorian"
                            when="1903-06-09"><hi rendition="#italic">June 9,
                        1903</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 552, Santo Domingo series.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose to the
                    Department the correspondence that has passed between this legation and the
                    Dominican foreign office on the subject of recognition.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. F. Powell.</hi></signed></closer>



