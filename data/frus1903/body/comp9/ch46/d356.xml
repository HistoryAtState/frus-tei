    <text>
        <body>
            <div xml:id="d356">

                <pb facs="0487" n="403" sameAs="frus:frus1903/pg403"/>

                <head><hi rendition="#italic">Mr. Hay to Mr. Powell.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1903-11-05"><hi rendition="#italic">November 5,
                        1903</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 197.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose for your information copy of a
                    correspondence had with the Dominican consul-general in regard to the treatment
                    of American vessels and their cargoes under the decree of blockade issued
                    against the ports of Monte Cristi and Puerto Plata.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>



                <xi:include href="d356-a1.xml" xpointer="d356-a1"/>
