    <text>
        <body>
            <div xml:id="d17">

                <pb facs="0105" n="21" sameAs="frus:frus1903/pg21"/>

                <head><hi rendition="#italic">President Roosevelt
                        to Prince Ferdinand.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >White House</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1903-09-21"><hi rendition="#italic">September 21,
                        1903</hi></date>.</dateline></opener>
                <p>I cordially appreciate the friendly message of Your Royal Highness and share your
                    good wishes.</p>
                <closer><signed><hi rendition="#small-caps">Theodore
                    Roosevelt.</hi></signed></closer>
            </div>
        </body>
