    <text>
        <body>
            <div xml:id="d678">

                <pb facs="0798" n="712" sameAs="frus:frus1903/pg712"/>

                <head><hi rendition="#italic">Mr. McCormick to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic">St.
                                Petersburg</hi></placeName>, <date calendar="gregorian"
                            when="1903-05-13"><hi rendition="#italic">May 13,
                        1903</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to your cablegraphic instruction
                    in the matter of alleged famine conditions among the Jews in Kishenev, I have
                    the honor to inclose herewith a cutting from the London Standard of May 1 * * *
                    which will throw some light on the subject of that instruction.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Robert S.
                    McCormick.</hi></signed></closer>


                <xi:include href="d678-a1.xml" xpointer="d678-a1"/>
