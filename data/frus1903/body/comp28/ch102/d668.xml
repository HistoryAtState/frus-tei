    <text>
        <body>
            <div xml:id="d668">

                <pb facs="0794" n="708" sameAs="frus:frus1903/pg708"/>

                <head><hi rendition="#italic">Mr. McCormick to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic">St.
                                Petersburg</hi></placeName>, <date calendar="gregorian"
                            when="1903-02-04"><hi rendition="#italic">February 4,
                        1903</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 6.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith a
                    copy and a translation of a note received from the minister for foreign affairs
                    relative to the establishment of foreign consuls at Dalny.</p>
                <p>I have the honor, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Robert S.
                    McCormick.</hi></signed></closer>


                <xi:include href="d668-a1.xml" xpointer="d668-a1"/>
