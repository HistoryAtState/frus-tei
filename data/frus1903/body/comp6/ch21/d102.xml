    <text>
        <body>
            <div xml:id="d102">

                <pb facs="0213" n="129" sameAs="frus:frus1903/pg129"/>

                <head><hi rendition="#italic">Mr. Beauapré to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Bogotá</hi></placeName>, <date calendar="gregorian"
                            when="1903-09-17"><hi rendition="#italic">September 17,
                        1903</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 137.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my No. 131, of September 8,
                    1903, concerning the hostility shown towards the Syrians in this country, I have
                    the honor to inclose herewith a copy and translation of a note from the minister
                    for foreign affairs in answer to mine of the 8th instant.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">A. M. Beaupré.</hi></signed></closer>


                <xi:include href="d102-a1.xml" xpointer="d102-a1"/>
