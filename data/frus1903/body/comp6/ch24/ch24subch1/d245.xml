                <pb facs="0319" n="235" sameAs="frus:frus1903/pg235"/>

                <head><hi rendition="#italic">Mr. Loomis to Mr.
                            Ehrman.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1903-11-10"><hi rendition="#italic">November 10, 1903</hi></date>.
                        (Sent 3.42 p.m.)</dateline></opener>
                <p>Keep in touch with commander of United States naval forces at Panama, advising
                    him concerning news bearing on military situation.</p>
                <closer><signed><hi rendition="#small-caps">Loomis.</hi></signed></closer>
            </div>
        </body>
