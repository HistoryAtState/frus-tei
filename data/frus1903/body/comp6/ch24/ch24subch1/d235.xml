                <pb facs="0316" n="232" sameAs="frus:frus1903/pg232"/>

                <head><hi rendition="#italic">Mr. Loomis to Mr.
                            Ehrman.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1903-11-05"><hi rendition="#italic">November 5, 1903</hi></date>.
                        (Sent 3.15 p.m.)</dateline></opener>
                <p>Acknowledge the receipt of circular letter and await instructions before taking
                    any further action in this line.</p>
                <closer><signed><hi rendition="#small-caps">Loomis.</hi></signed></closer>
            </div>
        </body>
