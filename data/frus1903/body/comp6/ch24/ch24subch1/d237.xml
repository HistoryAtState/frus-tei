                <pb facs="0317" n="233" sameAs="frus:frus1903/pg233"/>

                <head><hi rendition="#italic">Mr. Ehrman to Mr. Hay.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Panama</hi></placeName>, <date calendar="gregorian"
                            when="1903-11-05"><hi rendition="#italic">November 5,
                        1903</hi>.</date><lb/>(Received 9.42 p.m.)</dateline></opener>
                <p>Colombian troops reembarked per Royal Mail for Carthagena. <hi
                        rendition="#italic">Bogotá</hi> supposed at Buenaventura. Quiet
                    prevails.</p>
                <closer><signed><hi rendition="#small-caps">Ehrman.</hi></signed></closer>
            </div>
        </body>
    </text>
