    <text>
        <body>
            <div xml:id="d241">

                <pb facs="0318" n="234" sameAs="frus:frus1903/pg234"/>

                <head><hi rendition="#italic">Mr. Ehrman to Mr. Hay.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Panama</hi></placeName>, <date calendar="gregorian"
                            when="1903-11-06"><hi rendition="#italic">November 6,
                        1903</hi>.</date><lb/>(Received 7.23 p.m.)</dateline></opener>
                <p>Felipe Bunau-Varilla has been appointed envoy extraordinary and minister
                    plenipotentiary to the United States of America. Perfect quiet.</p>
                <closer><signed><hi rendition="#small-caps">Ehrman</hi>.</signed></closer>
            </div>
        </body>
