    <text>
        <body>
            <div xml:id="d274">

                <pb facs="0328" n="244" sameAs="frus:frus1903/pg244"/>

                <head><hi rendition="#italic">Mr. Hay to Dr.
                            Herran.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1903-11-11"><hi rendition="#italic">November 11,
                        1903</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 22.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of the 7th instant, in which, acknowledging my communication of the
                    6th instant, you are pleased, of your own motion and in the absence of
                    instructions from your Government, to lodge a protest against the attitude
                    assumed by the Government of the United States in respect to the situation on
                    the Isthmus of Panama.</p>
                <p>Accept, sir, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
    </text>
