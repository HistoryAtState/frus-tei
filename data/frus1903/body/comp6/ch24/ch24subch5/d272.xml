    <text>
        <body>
            <div xml:id="d272">

                <pb facs="0327" n="243" sameAs="frus:frus1903/pg243"/>

                <head><hi rendition="#italic">Mr. Hay to Doctor Herran.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1903-11-06"><hi rendition="#italic">November 6,
                        1903</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Doctor Herran</hi>: I inclose copy of a dispatch
                    which has today been sent to our minister at Bogotá.</p>
                <p>Very sincerely, yours,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>


                <xi:include href="d272-a1.xml" xpointer="d272-a1"/>
