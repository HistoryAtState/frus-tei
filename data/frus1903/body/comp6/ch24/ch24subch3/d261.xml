    <text>
        <body>
            <div xml:id="d261">

                <pb facs="0323" n="239" sameAs="frus:frus1903/pg239"/>

                <head>[Telegram.—Translation.]</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Panama</hi></placeName>, <date calendar="gregorian"
                            when="1903-11-05"><hi rendition="#italic">November 5,
                        1903</hi>.</date><lb/>(Received 8.48 p.m.)</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Secretary of State</hi>, <hi
                        rendition="#italic">Washington:</hi></p>
                <p>We notify you that we have appointed Señor Philippe Bunau-Varilla confidential
                    agent of the Republic of Panama near your Government and Dr. Francisco V. de la
                    Espriella minister of foreign affairs.</p>
                <closer><signed>
                        <list>
                            <item><hi rendition="#small-caps">Arango.</hi></item>
                            <item><hi rendition="#small-caps">Boyd.</hi></item>
                            <item><hi rendition="#small-caps">Arias.</hi></item>
                        </list>
                    </signed></closer>
            </div>
        </body>
    </text>
