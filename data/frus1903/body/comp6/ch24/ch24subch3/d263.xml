    <text>
        <body>
            <div xml:id="d263">

                <pb facs="0323" n="239" sameAs="frus:frus1903/pg239"/>

                <head>[Telegram.—Translation.]</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Panama</hi></placeName>, <date calendar="gregorian"
                            when="1903-11-06"><hi rendition="#italic">November 6,
                        1903</hi></date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Secretary of State</hi>, <hi
                        rendition="#italic">Washington:</hi></p>
                <p>The board of provisional government of the Republic of Panama has appointed Señor
                    Philippe Bunau Varilla envoy extraordinary and minister plenipotentiary near
                    your Government with full powers to conduct diplomatic and financial
                    negotiations. Deign to receive and heed him.</p>
                <closer><signed>
                        <list>
                            <item><hi rendition="#small-caps">J. M. Arango</hi>,</item>
                            <item><hi rendition="#small-caps">Tomas Arias</hi>,</item>
                            <item><hi rendition="#small-caps">Federico Boyd</hi>,<lb/><hi
                                    rendition="#italic">Foreign Relations.</hi></item>
                        </list>
                    </signed></closer>
            </div>
        </body>
    </text>
