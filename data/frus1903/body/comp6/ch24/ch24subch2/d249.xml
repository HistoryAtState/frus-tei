                <pb facs="0320" n="236" sameAs="frus:frus1903/pg236"/>

                <head><hi rendition="#italic">Mr. Loomis to Mr. Malmros.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1903-11-03"><hi rendition="#italic">November 3, 1903</hi></date>.
                        (Sent 4.28 p.m.)</dateline></opener>
                <p>Did you receive and deliver to <hi rendition="#italic">Nashville</hi> last night
                    or early this morning a message?</p>
                <closer><signed><hi rendition="#small-caps">Loomis.</hi></signed></closer>
            </div>
        </body>
