    <text>
        <body>
            <div xml:id="d308-a2">

                <pb facs="0337" n="253" sameAs="frus:frus1903/pg253"/>

                <head>B.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Panama</hi></placeName>, <date calendar="gregorian"
                            when="1903-11-05"><hi rendition="#italic">November 5,
                        1903</hi>.</date></dateline></opener>
                <p rendition="#flush">Messrs. <hi rendition="#small-caps">J. A. Arango, Tomas
                        Arias</hi>, and <hi rendition="#small-caps">Federico Boyd</hi>,<lb/><hi
                        rendition="#italic">Committee of the Provisional Government,
                    Panama</hi>.</p>
                <p><hi rendition="#small-caps">Sirs</hi>: I have the honor to acknowledge receipt of
                    your circular letter No. 1, dated November 4, 1903.</p>
                <p>I am, sirs, very respectfully, yours,</p>
                <closer><signed><hi rendition="#small-caps">Felix Ehrman</hi>,<lb/><hi
                            rendition="#italic">United States
                    Vice-Consul-General.</hi></signed></closer>
            </div>
        </body>
