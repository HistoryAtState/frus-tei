            <div xml:id="d318-a1">

                <pb facs="0367" n="283" sameAs="frus:frus1903/pg283"/>

                <p rendition="#flush">The <hi rendition="#small-caps">President</hi>:</p>
                <p>In continuation of the papers previously submitted, the undersigned Secretary of
                    State has the honor to lay before the President additional correspondence
                    touching the relations of the United States with Colombia and Panama.</p>
                <p>Respectfully submitted.</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed>
                    <lb/>
                    <dateline rendition="#float-left"><hi rendition="#small-caps">Department of
                            State</hi>,<lb/><placeName><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1904-01-16"><hi rendition="#italic">January 16,
                        1904</hi></date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
