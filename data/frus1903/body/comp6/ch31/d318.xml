                <pb facs="0367" n="283" sameAs="frus:frus1903/pg283"/>

                <head>MESSAGE FROM THE PRESIDENT OF THE UNITED STATES, TRANSMITTING A REPORT FROM
                    THE SECRETARY OF STATE COVERING COPIES OF ADDITIONAL PAPERS BEARING UPON THE
                    RELATIONS OF THE UNITED STATES WITH COLOMBIA AND THE REPUBLIC OF PANAMA.</head>
                <p rendition="#flush"><hi rendition="#italic">To the Senate and House of
                        Representatives:</hi></p>
                <p>I transmit herewith for the information of the Congress a report from the
                    Secretary of State covering copies of additional papers bearing upon the
                    relations of the United States with Colombia and the Republic of Panama.</p>
                <closer><signed><hi rendition="#small-caps">Theodore Roosevelt.</hi></signed>
                    <lb/>
                    <dateline rendition="#float-left"><placeName><hi rendition="#small-caps">White
                                House</hi></placeName>, <date calendar="gregorian" when="1904-01-18"
                                ><hi rendition="#italic">January 18, 1904</hi></date>.</dateline>
                </closer>


                <xi:include href="d318-a1.xml" xpointer="d318-a1"/>
