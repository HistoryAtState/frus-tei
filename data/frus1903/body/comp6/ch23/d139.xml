    <text>
        <body>
            <div xml:id="d139">

                <pb facs="0242" n="158" sameAs="frus:frus1903/pg158"/>

                <head><hi rendition="#italic">Mr. Beaupré to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Bogotá</hi></placeName>, <date calendar="gregorian"
                            when="1903-07-06"><hi rendition="#italic">July 6,
                        1903</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 72.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my No. 60 of June 24, 1903,
                    with which I transmitted a copy of the President’s message to Congress, I now
                    have the honor to inclose herewith a translation of said message.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer><signed><hi rendition="#small-caps">A. M. Beaupré</hi>.</signed></closer>



                <xi:include href="d139-a1.xml" xpointer="d139-a1"/>
