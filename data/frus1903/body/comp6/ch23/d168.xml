    <text>
        <body>
            <div xml:id="d168">

                <pb facs="0271" n="187" sameAs="frus:frus1903/pg187"/>

                <head><hi rendition="#italic">Mr. Beaupré to Mr. Hay.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Legation</hi>,<lb/><hi rendition="#italic"
                                >Bogotá</hi></placeName>, <date calendar="gregorian"
                            when="1903-08-17"><hi rendition="#italic">August 17, 1903</hi></date>.
                        (Received August 25.)</dateline></opener>
                <p>The President informs me that Congress will pass law authorizing him to continue
                    and finish negotiations for canal; but what conditions will be specified he can
                    not state at the present moment.</p>
                <closer><signed><hi rendition="#small-caps">Beaupré.</hi></signed></closer>
            </div>
        </body>
    </text>
