    <text>
        <body>
            <div xml:id="d199">

                <pb facs="0294" n="210" sameAs="frus:frus1903/pg210"/>

                <head><hi rendition="#italic">Mr. Beaupré to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Bogotá</hi></placeName>, <date calendar="gregorian"
                            when="1903-10-16"><hi rendition="#italic">October 16,
                        1903</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 181.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a copy
                    and translation of the report of the committee to whom was referred the project
                    of law authorizing the Executive of the Republic to negotiate for the
                    construction of a Panama canal. This report was read in the Senate on the 14th
                    instant.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer><signed><hi rendition="#small-caps">A. M. Beaupré.</hi></signed></closer>


                <xi:include href="d199-a1.xml" xpointer="d199-a1"/>
