    <text>
        <body>
            <div xml:id="d205">

                <pb facs="0300" n="216" sameAs="frus:frus1903/pg216"/>

                <head><hi rendition="#italic">Mr. Beaupré to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Bogotá</hi></placeName>, <date calendar="gregorian"
                            when="1903-10-23"><hi rendition="#italic">October 23,
                        1903</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 188.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my No. 160<anchor n="a"
                        xml:id="d205-f1"/> of September 29, 1903, concerning the taxes and charges
                    on shipping at Panama, I have the honor to inclose herewith a copy and
                    translation of a note from the minister for foreign affairs on the subject.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer><signed><hi rendition="#small-caps">A. M. Beaupré.</hi></signed></closer>


                <xi:include href="d205-a1.xml" xpointer="d205-a1"/>
            </div>
        </body>
    </text>
