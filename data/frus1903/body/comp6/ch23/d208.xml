                <pb facs="0302" n="218" sameAs="frus:frus1903/pg218"/>

                <head><hi rendition="#italic">Mr. Beaupré to Mr. Hay.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Legation</hi>,<lb/><hi rendition="#italic"
                                >Bogotá</hi></placeName>, <date calendar="gregorian"
                            when="1903-10-29"><hi rendition="#italic">October 29,
                        1903</hi></date>.<lb/>(Received 6.55 p.m., November 6.)</dateline></opener>
                <p>October 29, 1 p.m. Please give instructions to consul-general at Panama keep me
                    advised by cable matters of consequence.</p>
                <p>Canal situation unchanged.</p>
                <closer><signed><hi rendition="#small-caps">Beaupré.</hi></signed></closer>
            </div>
        </body>
