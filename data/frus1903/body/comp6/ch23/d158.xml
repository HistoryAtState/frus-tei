    <text>
        <body>
            <div xml:id="d158">

                <pb facs="0261" n="177" sameAs="frus:frus1903/pg177"/>

                <head><hi rendition="#italic">Mr. Beaupré to the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Bogotá</hi></placeName>, <date calendar="gregorian"
                            when="1903-08-10"><hi rendition="#italic">August 10,
                        1903</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 101.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my No. 98 of the 7th instant,
                    I have the honor to inclose herewith a copy and translation of a note from the
                    minister for foreign affairs, together with a copy of my reply thereto.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer><signed><hi rendition="#small-caps">A. M. Beaupré.</hi></signed></closer>



                <xi:include href="d158-a1.xml" xpointer="d158-a1"/>
