    <text>
        <body>
            <div xml:id="d167">

                <pb facs="0269" n="185" sameAs="frus:frus1903/pg185"/>

                <head><hi rendition="#italic">Mr. Beaupré to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Bogotá</hi></placeName>, <date calendar="gregorian"
                            when="1903-08-17"><hi rendition="#italic">August 17,
                        1903</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 107.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to send you inclosed
                    copies and translations of two notes from the minister for foreign affairs in
                    regard to the Panama Canal treaty.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer><signed><hi rendition="#small-caps">A. M. Beaupré.</hi></signed></closer>




