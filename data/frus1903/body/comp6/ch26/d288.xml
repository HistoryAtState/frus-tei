                <pb facs="0333" n="249" xml:id="pg249"/>

                <head>[Translation.]</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington, D. C.,</hi></placeName>
                        <date calendar="gregorian" when="1903-11-06"><hi rendition="#italic"
                                >November 6, 1903</hi>.</date></dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Maine</hi>, <hi
                        rendition="#italic">Woods Hole, Mass.:</hi></p>
                <p>Proceed at once to Colon, coaling wherever necessary to expedite your arrival.
                    Acknowledge.</p>
                <closer><signed><hi rendition="#small-caps">Moody.</hi></signed></closer>
            </div>
        </body>
