                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Navy Department</hi>,<lb/><hi rendition="#italic">Washington, D.
                                C.</hi></placeName>, <date calendar="gregorian" when="1903-11-05"
