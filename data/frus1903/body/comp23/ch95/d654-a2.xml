    <text>
        <body>
            <div xml:id="d654-a2">

                <pb facs="0777" n="691" sameAs="frus:frus1903/pg691"/>

                <opener><seg rendition="#center">[Inclosure 2.]</seg></opener>
                <head><hi rendition="#italic">Mr. Buchanan to the minister for foreign
                    affairs.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Panama</hi></placeName>,<lb/><date calendar="gregorian"
                            when="1903-12-23"><hi rendition="#italic">December 23,
                        1903</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I beg to inclose for your excellency’s
                    information a copy of the remarks I shall have the honor to make to their
                    excellencies the members of the junta of the provisional government upon the
                    occasion of my presenting to their excellencies my letter of credence from the
                    President of the United States.</p>
                <p>I have, etc</p>
                <closer><signed><hi rendition="#small-caps">Wm. I. Buchanan.</hi></signed></closer>
            </div>
        </body>
    </text>
