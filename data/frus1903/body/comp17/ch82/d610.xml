    <text>
        <body>
            <div xml:id="d610">

                <pb facs="0708" n="622" sameAs="frus:frus1903/pg622"/>

                <head><hi rendition="#italic">Mr. Hay to Mr. Griscom.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1903-09-02"><hi rendition="#italic">September 2,
                        1903</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 14.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit copies of a letter from the G.
                    &amp; J. Tire Company, and its inclosure, addressed to the Imperial consulate of
                    Japan at Chicago, protesting against the copyrighting of their trade-mark in
                    Japan by Rikicki Sumi, a bicycle dealer of Osaka.</p>
                <pb facs="0709" n="623" xml:id="pg623"/>
                <p>The company expresses the hope that the Department will take some steps to
                    protect its interests in Japan.</p>
                <p>You are instructed to investigate the matter and to furnish the Department with a
                    report thereon.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>



                <xi:include href="d610-a1.xml" xpointer="d610-a1"/>
                <xi:include href="d610-a2.xml" xpointer="d610-a2"/>
