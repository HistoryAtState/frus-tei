                <pb facs="0459" n="375" sameAs="frus:frus1903/pg375"/>

                <head>Commercial convention between the United States and Cuba</head>
                <p><hi rendition="#italic">Signed at Havana, December 11, 1902.<lb/>Ratification
                        with amendments advised by the Senate March 19, 1903.<lb/>Ratified by the
                        President, March 30, 1903.<lb/>Ratified by Cuba, March 30,
                        1903.<lb/>Ratifications exchanged at Washington, March 31,
                        1903.<lb/>Proclaimed, December 17, 1903.</hi></p>

