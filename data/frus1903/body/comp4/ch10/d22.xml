    <text>
        <body>
            <div xml:id="d22">

                <pb facs="0120" n="36" sameAs="frus:frus1903/pg36"/>

                <head><hi rendition="#italic">Mr. Bryan to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Petropolis</hi></placeName>, <date calendar="gregorian"
                            when="1902-08-14"><hi rendition="#italic">August 14,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 441.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a copy
                    and translation of an official order of the minister of finance, recently
                    promulgated, by which he closes or attempts to close the free navigation of the
                    Amazon, subjecting all goods in transit to Brazilian export and import
                    duties.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charles Page
                    Bryan.</hi></signed></closer>


                <xi:include href="d22-a1.xml" xpointer="d22-a1"/>
