            <div xml:id="ch8">

                <pb facs="0111" n="27" sameAs="frus:frus1903/pg27"/>

                <head>Treaty and protocol between the United States and Brazil for the extradition
                    of criminals</head>
                <p><hi rendition="#italic">Signed respectively at Rio de Janeiro, May 14, 1897, and
                        May 28, 1898.<lb/>Ratification with amendments advised by the Senate,
                        February 28, 1899.<lb/>Ratified by the President, February 13,
                        1903.<lb/>Ratified by Brazil, April 14, 1903.<lb/>Ratifications exchanged at
                        Rio de Janeiro, April 18, 1903.<lb/>Proclaimed, April 30, 1903.</hi></p>

                <xi:include href="ch8/d20.xml" xpointer="d20"/>
