    <text>
        <body>
            <div xml:id="d366-a2">

                <pb facs="0496" n="412" sameAs="frus:frus1903/pg412"/>

                <opener><seg rendition="#center">[Subinclosure.]</seg></opener>
                <p rendition="#center"><hi rendition="#italic">Ship “Robert Rickmers”—Expenses in
                        Portland, August, 1900, incurred through the desertion of crews.</hi></p>
                <table cols="2" rows="9">
                    <row role="label">
                        <cell>Shipping masters’ fees</cell>
                        <cell role="num">$75.00</cell>
                    </row>
                    <row>
                        <cell>“Blood money” for ten men</cell>
                        <cell role="num">700.00</cell>
                    </row>
                    <row>
                        <cell>B. H. Sullivan’s so-called compensation</cell>
                        <cell role="num">675.00</cell>
                    </row>
                    <row>
                        <cell>Watchman</cell>
                        <cell rendition="#border-bottom" role="num">24.10</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell role="num">1,474.10</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell>Marks.</cell>
                    </row>
                    <row>
                        <cell rend="padding-left: 3em;">At 4.20 marks</cell>
                        <cell role="num">6,191.22</cell>
                    </row>
                    <row>
                        <cell>Ten men for about five months, at 600 marks per month higher
                            wages</cell>
                        <cell rendition="#border-bottom" role="num">3,000.00</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell role="num">9,191.22</cell>
                    </row>
                </table>
                <p>Average per man, 919.12 marks.</p>
                <p rendition="#center"><hi rendition="#italic">Ship “Mabel Rickmers”—Expenses in
                        Portland, September, 1901, incurred through the desertion of crews.</hi></p>
                <table cols="2" rows="9">
                    <row role="label">
                        <cell>Shipping masters’ fees</cell>
                        <cell role="num">$130.00</cell>
                    </row>
                    <row>
                        <cell>“Blood money” for thirteen men</cell>
                        <cell role="num">425.00</cell>
                    </row>
                    <row>
                        <cell>Extras for fares, etc</cell>
                        <cell role="num">48.00</cell>
                    </row>
                    <row>
                        <cell>Watchmen</cell>
                        <cell rendition="#border-bottom" role="num">75.00</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell role="num">678.00</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell>Marks.</cell>
                    </row>
                    <row>
                        <cell rend="padding-left: 3em;">At 4.20 marks</cell>
                        <cell role="num">2,847.60</cell>
                    </row>
                    <row>
                        <cell>Thirteen men for five months, at 400 marks per month higher
                            wages</cell>
                        <cell rendition="#border-bottom" role="num">2,000.00</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell role="num">4,847.60</cell>
                    </row>
                </table>
                <p>Average per man, 372.90 marks.</p>
            </div>
        </body>
