    <text>
        <body>
            <div xml:id="d409">

                <pb facs="0521" n="437" sameAs="frus:frus1903/pg437"/>

                <head><hi rendition="#italic">Mr. Tower to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >Berlin</hi></placeName>, <date calendar="gregorian"
                            when="1903-02-21"><hi rendition="#italic">February 21,
                        1903</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 50.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose to you herewith
                    a copy and a translation into English of a note which I have received from the
                    Imperial secretary of state for foreign affairs, announcing that the blockade of
                    the Venezuelan ports of Maracaibo and Puerto Cabello has been raised.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charlemagne
                    Tower.</hi></signed></closer>




