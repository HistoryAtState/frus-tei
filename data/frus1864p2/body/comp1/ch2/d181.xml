    <text>
        <body>
            <div xml:id="d181">

                <pb facs="0391" n="371" sameAs="frus:frus1864p2/pg371"/>

                <head>Mr. F. W. Seward to Mr. Adams.</head>
                <opener>
                    <seg rendition="#float-left">No. 794.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1863-12-27"><hi rendition="#italic"
                                >December</hi> 27, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Referring to instruction No. 791, of the
                    26th instant, I enclose a copy of a despatch of the 12th instant, No. 70, from
                    the consul at Cork, in regard to the alleged violation of the foreign enlistment
                    act of Great Britain in the case of the Kearsarge, and which was received
                    subsequent to the writing of No. 791.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>F.W.SEWARD, <hi rendition="#italic">Acting
                    Secretary.</hi></signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq.</p>
                </postscript>



                <xi:include href="d181-a1.xml" xpointer="d181-a1"/>
