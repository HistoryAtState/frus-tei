    <text>
        <body>
            <div xml:id="d143">

                <pb facs="0343" n="323" sameAs="frus:frus1864p2/pg323"/>

                <head>Mr. Seward to Mr. Adams.
                    .</head>
                <opener>
                    <seg rendition="#float-left">No. 1116.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-10-07"><hi rendition="#italic"
                                >October</hi> 7, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I herewith communicate, for the information
                    of her Britannic Majesty’s government, a copy of a despatch of the 22d of
                    September from Mr. Savage, vice-consul general of the United States at Havana,
                    relating to recent operations of slave traders in Cuba.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d143-a1.xml" xpointer="d143-a1"/>
            </div>
