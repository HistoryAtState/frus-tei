    <text>
        <body>
            <div xml:id="d15">

                <pb facs="0080" n="60" sameAs="frus:frus1864p2/pg60"/>

                <head>Mr. Seward to Mr. Adams.</head>
                <opener>
                    <seg rendition="#float-left">No. 969.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1864-05-30"><hi rendition="#italic">May</hi>
                            30, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have to acknowledge the receipt of your
                    despatch of the 12th instant, No. 686, and its accompaniments relative to the
                    suppression of the African slave trade. I cordially assent to the proposition of
                    Earl Russell therein mentioned.</p>
                <p>I give you, herewith, a copy of the papers respecting the Arguelles case.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>



























