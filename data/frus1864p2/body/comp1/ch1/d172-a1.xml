    <text>
        <body>
            <div xml:id="d172-a1">

                <pb facs="0380" n="360" sameAs="frus:frus1864p2/pg360"/>

                <head>Mr. Dana to Mr.
                        Seward.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">War Department,</hi>
                            <hi rendition="#italic">Washington City</hi></placeName>, <date
                            calendar="gregorian" when="1864-11-25"><hi rendition="#italic"
                                >November</hi> 25, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> The Secretary of War directs me to transmit
                    for your information the enclosed copy of a letter from Major General Dix
                    relative to the disturbed condition of the northern frontiers.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>C. A. DANA, <hi rendition="#italic">Assistant Secretary of
                        War.</hi></signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, &amp;c., &amp;c.,
                        &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
