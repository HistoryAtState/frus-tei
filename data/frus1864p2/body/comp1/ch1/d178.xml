    <text>
        <body>
            <div xml:id="d178">

                <pb facs="0389" n="369" sameAs="frus:frus1864p2/pg369"/>

                <head>Mr. Seward to Mr. Adams.</head>
                <opener>
                    <seg rendition="#float-left">No. 1178.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1864-12-05"><hi rendition="#italic"
                                >December</hi> 5, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have to acknowledge the receipt of your
                    despatch of the 18th ultimo, No. 815, in relation to the fitting out of the Sea
                    King, and transmitting a copy of your note of the 18th of that month to Earl
                    Russell upon the subject, and its bearing upon the intervention of the
                    Deerhound.</p>
                <p>I am happy to observe that you have well anticipated and executed my instructions
                    on the subject.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
