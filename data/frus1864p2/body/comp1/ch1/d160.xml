    <text>
        <body>
            <div xml:id="d160">

                <pb facs="0368" n="348" sameAs="frus:frus1864p2/pg348"/>

                <head>Mr. Adams to Mr.
                        Seward.</head>
                <opener>
                    <seg rendition="#float-left">No. 806.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">London</hi></placeName>, <date
                            calendar="gregorian" when="1864-11-03"><hi rendition="#italic"
                                >November</hi> 3, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> In connexion with your despatch No. 1116,
                    of the 7th of last month, I have the honor to transmit copies of notes which
                    have passed between Lord Russell and myself on the subject therein referred
                    to.</p>
                <p>I have honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>CHARLES FRANCIS ADAMS.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>


                <xi:include href="d160-a1.xml" xpointer="d160-a1"/>
            </div>
