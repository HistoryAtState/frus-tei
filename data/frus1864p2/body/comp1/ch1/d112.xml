    <text>
        <body>
            <div xml:id="d112">

                <pb facs="0311" n="291" sameAs="frus:frus1864p2/pg291"/>

                <head>Mr. Adams to Mr.
                        Seward.</head>
                <opener>
                    <seg rendition="#float-left">No. 772.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">London,</hi></placeName>
                        <date calendar="gregorian" when="1864-09-02"><hi rendition="#italic"
                                >September</hi> 2, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> In connexion with my despatch No. 760, of
                    the 18th of August, I transmit herewith a copy of a note of Lord Russell to me
                    of the 24th of that month relative to the landing of a cargo of negroes in
                    Cuba.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>CHARLES FRANCIS ADAMS</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d112-a1.xml" xpointer="d112-a1"/>
            </div>
