    <text>
        <body>
            <div xml:id="d148-a1-a2">

                <pb facs="0351" n="331" sameAs="frus:frus1864p2/pg331"/>

                <head>Mr. Moran to Mr.
                        Seward.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">London</hi></placeName>, <date
                            calendar="gregorian" when="1864-10-14"><hi rendition="#italic"
                                >October</hi> 14, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I beg to enclose herewith a copy of an
                    address to the people of the United States, on the approaching presidential
                    election, just issued by the Union and Emancipation Society of Glasgow, and
                    received at this legation this morning from the secretary.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>BENJAMIN MORAN, <hi rendition="#italic">Secretary of
                        Legation.</hi></signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>


                <xi:include href="d148-a1-a2-a1.xml" xpointer="d148-a1-a2-a1"/>
