    <text>
        <body>
            <div xml:id="d150">

                <pb facs="0353" n="333" sameAs="frus:frus1864p2/pg333"/>

                <head>Mr. Seward to Mr. Adams.</head>
                <opener>
                    <seg rendition="#float-left">No. 1127.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1864-10-17"><hi rendition="#italic"
                                >October</hi> 17, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Referring to your despatch of the 16th
                    ultimo, No. 785, relative to the escape of three deserters from the United
                    States steamer Iroquois while anchored near Dover, England, I transmit in reply
                    a copy of a letter from the Secretary of the Navy in reference to this
                    subject.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>



                <xi:include href="d150-a1.xml" xpointer="d150-a1"/>
            </div>
