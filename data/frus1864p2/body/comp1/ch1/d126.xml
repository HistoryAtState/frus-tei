    <text>
        <body>
            <div xml:id="d126">

                <pb facs="0326" n="306" xml:id="pg306"/>

                <head>Mr. Seward to Mr. Adams.</head>
                <opener>
                    <seg rendition="#float-left">No. 1094.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-09-19"><hi rendition="#italic"
                                >September</hi> 19, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have received your despatch of the 1st of
                    September, No. 769, relating to the action of Mr. Lancaster in the engagement
                    between the Kearsarge and the Alabama. The course you propose to adopt in regard
                    to this case is approved.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
