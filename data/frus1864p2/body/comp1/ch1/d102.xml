    <text>
        <body>
            <div xml:id="d102">

                <pb facs="0299" n="279" xml:id="pg279"/>

                <head>Mr. Adams to Mr. Seward.</head>
                <opener>
                    <seg rendition="#float-left">No. 762.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United. States,</hi>
                            <hi rendition="#italic">London,</hi></placeName>
                        <date calendar="gregorian" when="1864-08-18"><hi rendition="#italic"
                                >August</hi> 18, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to transmit a copy of a
                    note addressed by me to Lord Russell on the 2d instant, under the instructions
                    contained in your despatch, No. 1042, of the 18th of July. I have not as yet
                    received any reply thereto.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>CHARLES FRANCIS ADAMS.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d102-a1.xml" xpointer="d102-a1"/>
