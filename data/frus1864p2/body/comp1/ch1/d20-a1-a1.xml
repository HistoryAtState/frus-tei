    <text>
        <body>
            <div xml:id="d20-a1-a1">

                <pb facs="0098" n="78" sameAs="frus:frus1864p2/pg78"/>

                <head>Mr. Adams to Earl Russell.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation op the United States,</hi>
                            <hi rendition="#italic">London</hi></placeName>, <date
                            calendar="gregorian" when="1864-05-23"><hi rendition="#italic">May</hi>
                            23, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Lord:</hi> I have the honor to submit to your
                    consideration a number of additional depositions, all going to show the
                    continuance of the practice of enlistments of British subjects by the insurgents
                    of the United States and their agents within this kingdom.</p>
                <p>I pray your lordship to accept, &amp;c, &amp;c.</p>
                <closer>
                    <signed>CHARLES FRANCIS ADAMS.</signed></closer>
                <postscript>
                    <p>Right Hon. <hi rendition="#small-caps">Earl Russell</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
