    <text>
        <body>
            <div xml:id="d153-a1">

                <pb facs="0356" n="336" sameAs="frus:frus1864p2/pg336"/>

                <head>Earl Russell to Mr.
                        Adams.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Foreign Office,</hi></placeName>
                        <date calendar="gregorian" when="1864-09-21"><hi rendition="#italic"
                                >September</hi> 21, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge the receipt
                    of your note of the 16th instant, relative to the desertion, at Dover, of three
                    seamen from the United States ship Iroquois, and to inform you that your
                    communication shall be considered by her Majesty’s government.</p>
                <p>I have the honor to be, with the highest consideration, sir, your most obedient,
                    humble servant,</p>
                <closer>
                    <signed>RUSSELL.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
