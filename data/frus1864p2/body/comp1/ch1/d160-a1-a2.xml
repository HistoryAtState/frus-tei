    <text>
        <body>
            <div xml:id="d160-a1-a2">

                <pb facs="0368" n="348" sameAs="frus:frus1864p2/pg348"/>

                <head>Earl Russell to Mr.
                        Adams.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Foreign Office,</hi></placeName>
                        <date calendar="gregorian" when="1864-11-02"><hi rendition="#italic"
                                >November</hi> 2, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge with thanks
                    the receipt of your letter of the 27th ultimo, enclosing a copy of a report from
                    the United States vice-consul at the Havana, containing information respecting
                    the slave trade.</p>
                <p>I have the honor to be, with the highest consideration, sir, your most obedient,
                    humble servant,</p>
                <closer>
                    <signed>RUSSELL.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">C. F. Adams,</hi> Esq., <hi rendition="#italic"
                            >&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
