    <text>
        <body>
            <div xml:id="d45-a1-a3">

                <pb facs="0207" n="187" sameAs="frus:frus1864p2/pg187"/>

                <head>Earl Russell to Mr. Adams.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Foreign Office,</hi></placeName>
                        <date calendar="gregorian" when="1864-06-20"><hi rendition="#italic"
                                >June</hi> 20, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge the receipt
                    of your letter of the 18th instant, and its enclosure respecting the Hawk, and I
                    have the honor to state to you that her Majesty’s government will cause further
                    inquiries to be made with respect to that vessel.</p>
                <p>I have the honor to be, with the highest consideration, sir, your most obedient,
                    humble servant,</p>
                <closer>
                    <signed>RUSSELL.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
