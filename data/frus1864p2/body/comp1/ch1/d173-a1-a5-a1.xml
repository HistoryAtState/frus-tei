    <text>
        <body>
            <div xml:id="d173-a1-a5-a1">

                <pb facs="0385" n="365" sameAs="frus:frus1864p2/pg365"/>

                <opener><seg rendition="#center">[Enclosure with No. 4.]</seg></opener>
                <head>Affidavit of Mr. Allen..</head>
                <p>I, Charles M. Allen, consul to the United States of America for Bermuda, do
                    solemnly and truly swear that I have good reason to believe, and do believe,
                    that an act or acts of piracy and murder has or have been committed on board the
                    United States steam vessel Roanoke, at sea, on or about the 29th day of
                    September last, by one —— Braine, <hi rendition="#italic">alias</hi> Johnson,
                    assisted by one Dr. Parr, <hi rendition="#italic">alias</hi> Anderson, and
                    several other persons to this deponent unknown, and that the said persons have
                    sought an asylum in the town of St. George, in Bermuda, aforesaid.</p>
                <closer>
                    <signed>C.M. ALLEN.</signed></closer>
                <closer>
                    <dateline rendition="#float-left">Sworn to before me <date calendar="gregorian"
                            when="1864-10-10">this 10th day of October, 1864</date>.</dateline>
                    <lb/>
                    <signed>JAMES H. THIES, <hi rendition="#italic">Mayor.</hi></signed></closer>
            </div>
        </body>
