    <text>
        <body>
            <div xml:id="d217-a1-a7">

                <pb facs="0479" n="459" sameAs="frus:frus1864p2/pg459"/>

                <head>The Mayor of Halifax to Mr. Tupper.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Mayor’s Office,</hi>
                            <hi rendition="#italic">Halifax,</hi></placeName>
                        <date calendar="gregorian" when="1863-12-22"><hi rendition="#italic"
                                >December</hi> 22, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to enclose you copies of
                    report from the city marshal and policeman Hutt, on the subject of the attempted
                    arrest of George Wade, the prisoner from the steamer Chesapeake. I have,
                    &amp;c.,</p>
                <closer>
                    <signed>P. CARTERET HILL, <hi rendition="#italic">Mayor.</hi></signed></closer>
                <postscript>
                    <p>The honorable <hi rendition="#small-caps">Provincial Secretary.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
