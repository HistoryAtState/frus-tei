    <text>
        <body>
            <div xml:id="d358">

                <pb facs="0621" n="601" sameAs="frus:frus1864p2/pg601"/>

                <head>Mr. Seward to Lord
                        Lyons.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1864-05-02"><hi rendition="#italic"
                                >May</hi> 2, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Lord</hi>: Recurring to your note.of the 18th
                    ultimo, relative to persons, twenty-eight in number, captured on British vessels
                    violating the blockade, I have the honor to enclose, in reply, a copy of a
                    letter of the 23d ultimo, from the Secretary of the Navy.</p>
                <p>I have the honor to be, with high consideration, my lord, your obedient
                    servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p>Right Hon. <hi rendition="#small-caps">Lord Lyons</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d358-a1.xml" xpointer="d358-a1"/>
            </div>
