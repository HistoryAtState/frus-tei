    <text>
        <body>
            <div xml:id="d465-a1">

                <pb facs="0706" n="686" sameAs="frus:frus1864p2/pg686"/>

                <head><hi rendition="#italic">Certificate of baptism.</hi></head>
                <p>John Arthur Cole, son of John and Charlotte Sherwood Verner, born June 30, 1848,
                    baptized January 2, 1849, by me.</p>
                <closer><signed>EDWARD DENRICHE.</signed></closer>
                <closer>
                    <dateline rendition="#float-left">The above certificate of the baptism of John
                        Verner, son of John Willoughby Verner, nephew of Sir William Verner, Bart.,
                        was copied from the register of baptism of St. Peter’s church,
                            <placeName>Breckville</placeName>, <date calendar="gregorian"
                            when="1864-05-31">this 31st of May, 1864</date>, by me.</dateline>
                    <lb/>
                    <signed>F. R. TANE, <hi rendition="#italic">Pastor of Breckville, Canada
                            West.</hi></signed></closer>
            </div>
        </body>
    </text>
