    <text>
        <body>
            <div xml:id="d543">

                <pb facs="0771" n="751" sameAs="frus:frus1864p2/pg751"/>

                <head>Mr. Burnley to Mr.
                        Seward.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <date calendar="gregorian" when="1864-10-23"><hi rendition="#small-caps"
                                >Sunday,</hi>
                            <hi rendition="#italic">October</hi> 23,
                    1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Dear Sir:</hi> I send you, on the other side, the
                    answer received this morning from the governor general of Canada.</p>
                <p>Believe me, very truly yours,</p>
                <closer>
                    <signed>J. HUME BURNLEY.</signed></closer>


                <xi:include href="d543-a1.xml" xpointer="d543-a1"/>
            </div>
