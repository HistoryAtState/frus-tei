    <text>
        <body>
            <div xml:id="d589">

                <pb facs="0832" n="812" xml:id="pg812"/>

                <head>Mr. Seward to Lord Lyons.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-11-26"><hi rendition="#italic"
                                >November</hi> 26, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Lord:</hi> I have the honor to acknowledge the
                    receipt of your communica-tion of the 19th instant, relative to an order alleged
                    to have been issued by General Dix in regard to the recent outrages at St.
                    Albans Vermont; and in reply, to inform your lordship that the matter will
                    receive due consideration.</p>
                <p>I have the honor to be, with the highest consideration, my lord, your obedient
                    servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p>Right Hon. <hi rendition="#small-caps">Lord Lyons</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
