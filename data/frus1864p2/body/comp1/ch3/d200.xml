    <text>
        <body>
            <div xml:id="d200">

                <pb facs="0422" n="402" sameAs="frus:frus1864p2/pg402"/>

                <head>Lord Lyons to Mr.
                        Seward.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1863-12-16"><hi rendition="#italic"
                                >December</hi> 16, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">My dear Sir:</hi> I send you a copy of the telegram
                    which I have despatched to the administrator of the government of Nova Scotia,
                    in consequence of the note which I received from you this morning respecting the
                    affair of the Chesapeake, and the conversation which I had with you on the
                    subject afterwards.</p>
                <p>I have despatched an identic telegram to the lieutenant governor of New
                    Brunswick.</p>
                <p>Yours, faithfully,</p>
                <closer>
                    <signed>LYONS.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward.</hi></p>
                </postscript>


                <xi:include href="d200-a1.xml" xpointer="d200-a1"/>
            </div>
