    <text>
        <body>
            <div xml:id="d514-a5">

                <pb facs="0742" n="722" sameAs="frus:frus1864p2/pg722"/>

                <head>Mr. Hendricks to Captain
                        Russell.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Custom-House, Beaufort, North
                                Carolina,</hi></placeName>
                        <date calendar="gregorian" when="1864-09-01"><hi rendition="#italic"
                                >September</hi> 1, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I transmit herein the paper seized on board
                    the sloop Racer on the 2d ultimo, off Bull’s bay, South Carolina, and do hereby
                    release said sloop, her master and crew, from further custody.</p>
                <p>I am, very respectfully, your obedient servant,</p>
                <closer>
                    <signed>JOHN A. HENDRICKS, <hi rendition="#italic"
                    >Collector.</hi></signed></closer>
                <postscript>
                    <p>Captain <hi rendition="#small-caps">C. A. Russell,</hi>
                        <hi rendition="#italic">Master of the Sloop Racer, Beaufort, North
                            Carolina.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
