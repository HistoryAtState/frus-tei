    <text>
        <body>
            <div xml:id="d350">

                <pb facs="0615" n="595" sameAs="frus:frus1864p2/pg595"/>

                <head>Lord Lyons to Mr.
                        Seward.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1864-04-22"><hi rendition="#italic"
                                >April</hi> 22, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Dear Sir</hi>: In compliance with the wish you
                    expressed in our conversation of yesterday, I send you a copy of an article in
                    the Buffalo Morning Courier of the 15th instant, respecting a vessel stated to
                    be building at that port for the United States government.</p>
                <p>Yours, faithfully,</p>
                <closer>
                    <signed>LYONS</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d350-a1.xml" xpointer="d350-a1"/>
            </div>
