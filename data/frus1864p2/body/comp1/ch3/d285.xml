    <text>
        <body>
            <div xml:id="d285">

                <pb facs="0551" n="531" sameAs="frus:frus1864p2/pg531"/>

                <head>Mr. Seward to Lord Lyons.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1864-02-22"><hi rendition="#italic"
                                >February</hi> 22, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Lord</hi>: I have the honor to acknowledge the
                    receipt of your communication of the 19th instant, relative to the restrictions
                    imposed upon shipments from New York to several of her Majesty’s possessions,
                    and to inform you that it will receive attention.</p>
                <p>I have the honor to be, with high consideration, your lordship’s obedient
                    servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p>Right Hon. <hi rendition="#small-caps">Lord Lyons</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
