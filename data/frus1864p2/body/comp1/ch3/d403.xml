    <text>
        <body>
            <div xml:id="d403">

                <pb facs="0657" n="637" sameAs="frus:frus1864p2/pg637"/>

                <head>Mr. Seward to Lord Lyons.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1864-06-16"><hi rendition="#italic"
                                >June</hi> 16, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Lord</hi>: I have the honor to acknowledge the
                    receipt of your note of the 13th instant relative to the case of the Blanche,
                    and, in reply, to assure your lordship that it will receive a careful
                    consideration.</p>
                <p>I have the honor to be, with high consideration, my lord, your obedient
                    servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p>Right Hon. Lord Lyons, <hi rendition="#italic">&amp;c., &amp;c.,
                        &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
