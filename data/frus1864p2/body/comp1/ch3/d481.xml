    <text>
        <body>
            <div xml:id="d481">

                <pb facs="0721" n="701" sameAs="frus:frus1864p2/pg701"/>

                <head>Mr. F. W. Seward to Mr. Burnley.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-09-03"><hi rendition="#italic"
                                >September</hi> 3, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge the receipt
                    of your note of the 31st ultimo, relative to the capture of the British sloop
                    Racer, of Nassau, and, in reply, to inform you that I have transmitted a copy
                    thereof to the Secretary of the Navy, who has been requested to investigate the
                    case, with a view to the adoption of such proceedings as the result may call
                    for.</p>
                <p>Accept, sir, a renewed assurance of my high consideration.</p>
                <closer>
                    <signed>F.W.SEWARD, <hi rendition="#italic">Acting
                    Secretary.</hi></signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">J. Hume Burnley,</hi> Esq., <hi
                            rendition="#italic">&amp;c, &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
