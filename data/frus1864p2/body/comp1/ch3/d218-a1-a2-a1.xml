    <text>
        <body>
            <div xml:id="d218-a1-a2-a1">

                <pb facs="0484" n="464" sameAs="frus:frus1864p2/pg464"/>

                <head><hi rendition="#italic">Certificate of Commodore Clitz.</hi></head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">United States Steamer Juniata,</hi>
                            <hi rendition="#italic">Cape Haytien,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1863-07-08"><hi rendition="#italic"
                                >July</hi> 8, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>; This is to certify that Francisco Abril
                    Ledro Antonio Lopez, Antonio Rerba, Esteban Elebul, Jose Gabacho, Miguel
                    Andreosebi, and Juan Mas were taken from the schooner Don Jose, on the 2d of
                    July, 1863.</p>
                <closer>
                    <signed>J. M. B. CLITZ, <hi rendition="#italic"
                    >Commander.</hi></signed></closer>
            </div>
        </body>
    </text>
