    <text>
        <body>
            <div xml:id="d243">

                <pb facs="0513" n="493" sameAs="frus:frus1864p2/pg493"/>

                <head>Lord Lyons to Mr. Seward.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1864-01-18"><hi rendition="#italic"
                                >January</hi> 18, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge the receipt
                    of your note of the day before yesterday’s date, relative to the United States
                    schooner J. L. Gerrity, which was seized by passengers on board and carried to
                    Belize. I have lost no time in forwarding a copy of it to her Majesty’s
                    government.</p>
                <p>I have the honor to be, with the highest consideration, sir, your most obedient,
                    humble servant,</p>
                <closer>
                    <signed>LYONS.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
