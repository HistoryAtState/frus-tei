    <text>
        <body>
            <div xml:id="d542">

                <pb facs="0771" n="751" sameAs="frus:frus1864p2/pg751"/>

                <head>Mr. Burnley to Mr.
                        Seward.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-10-23"><hi rendition="#italic"
                                >October</hi> 23, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge receipt of
                    your note of the 21st instant, relative to the affair at St. Albans, and beg to
                    state that I have caused a copy of this note to be sent to his excellency the
                    governor general of Canada.</p>
                <p>I have the honor to be, with the highest consideration, sir, your most obedient,
                    humble servant,</p>
                <closer>
                    <signed>J. HUME BURNLEY.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">&amp;c, &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
