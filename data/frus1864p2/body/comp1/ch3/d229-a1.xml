            <div xml:id="d229-a1">

                <pb facs="0502" n="482" sameAs="frus:frus1864p2/pg482"/>

                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <head>Mr. Giddings to Mr. Seward.</head>
                <opener>
                    <placeName><hi rendition="#small-caps">United States Military Telegraph</hi>,
                            <hi rendition="#italic">War Department.</hi></placeName></opener>
                <p>[Received in cipher, January 12.]</p>
                <p rendition="#right">
                    <placeName><hi rendition="#italic">Montreal, January 12, via New
                        York</hi>,</placeName><hi rendition="#italic">January</hi> 12, 1864.</p>
                <p>Lieutenant Braine, Colonel Talbot, and other confederates are here on their way
                    to Windsor. There seems to be a concentration there for some purpose,</p>
                <closer>
                    <signed>J. R. GIDDINGS, <hi rendition="#italic">United States Consul.</hi>
                    </signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
