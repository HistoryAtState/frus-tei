            <div xml:id="d582-a1-a1">

                <pb facs="0807" n="787" sameAs="frus:frus1864p2/pg787"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <p><hi rendition="#small-caps">State of Vermont,</hi>
                    <hi rendition="#italic">Franklin County, ss:</hi></p>
                <p><hi rendition="#italic">To any sheriff or constable in the State,
                    greeting:</hi></p>
                <p>By the authority of the State of Vermont, you are hereby commanded to apprehend
                    the bodies of the said Samuel Eugene Lackey, Thomas Bransdon Collins, <pb
                        facs="0808" n="788" xml:id="pg788"/> Squier Turner Teavis, Alexander Pope
                    Bruce, Marcus Spurr, Charles Moore Swager, Bennett H. Young, George Scott, Caleb
                    McDowall Wallace, James Alexander Doty, Joseph M. Grorty, Samuel Sipson Gregg,
                    William H. Hutchinson, and Dudley Moore, and them have forthwith before the
                    subscribing authority at the sheriffs office in St. Albans, in said Franklin
                    county, that they may answer to the foregoing complaint, and be further dealt
                    with according to law.</p>
                <closer><dateline rendition="#float-left">Given under my hand, at <placeName>St.
                            Albans</placeName> aforesaid, <date calendar="gregorian"
                            when="1864-10-21">this 21st day of October, in the year of our Lord
                            1864</date>.</dateline>
                    <lb/>
                    <signed>LEONARD GILMAN, <hi rendition="#italic">Justice of the
                        Peace.</hi></signed></closer>
            </div>
        </body>
    </text>
