    <text>
        <body>
            <div xml:id="d257">

                <pb facs="0528" n="508" xml:id="pg508"/>

                <head>Mr. Seward to Lord Lyons.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1864-01-26"><hi rendition="#italic"
                                >January</hi> 26, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Lord</hi>: Recurring to your note of the 13th
                    instant, inquiring, under the instruction of her Majesty’s government,
                    concerning the capture of the British brigs Volante, of Jersey, and Dashing
                    Wave, of Liverpool, I have now the honor to enclose a copy of a letter of the
                    19th instant, from the Secretary of the Navy, which contains the desired
                    information.</p>
                <p>I have the honor to be, with high consideration, my lord, your obedient
                    servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD. </signed></closer>
                <postscript>
                    <p>Right Hon. <hi rendition="#small-caps">Lord Lyons</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c.,&amp;c.</hi></p>
                </postscript>


                <xi:include href="d257-a1.xml" xpointer="d257-a1"/>
