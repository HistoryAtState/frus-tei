    <text>
        <body>
            <div xml:id="d408-a1-a1">

                <pb facs="0661" n="641" xml:id="pg641"/>

                <p>I, Walter Graham, consul for the United States at Cape Town, do hereby certify
                    that the signature above written is genuine, and that the power of attorney
                    referred to has been shown to me, and that it is a genuine document in all
                    respects.</p>
                <closer>
                    <dateline rendition="#float-left">In witness whereof, I have hereunto affixed my
                        signature and the seal of this consulate, <date calendar="gregorian"
                            when="1863-12-03">this third day of December, 1863</date>.</dateline>
                    <signed>WALTER GRAHAM, <hi rendition="#italic">United States Consult Cape
                            Town.</hi></signed></closer>
            </div>
        </body>
    </text>
