    <text>
        <body>
            <div xml:id="d455-a1">

                <pb facs="0695" n="675" xml:id="pg675"/>

                <head>Gen. Townsend to Mr.
                        Seward.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">War Department, Adjutant General’s
                                Office,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-08-08"><hi rendition="#italic"
                                >August</hi> 8, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I am instructed by the Secretary of War to
                    transmit to you the enclosed copies of two letters from Lieutenant Colonel B. H.
                    Hill, United States army, in relation to certain rumors of rebel plots against
                    the United States said to be on foot in Canada.</p>
                <p>I have the honor to be, sir, with great respect, your most obedient servant,</p>
                <closer>
                    <signed>E. D. TOWNSEND, <hi rendition="#italic">Assistant Adjutant
                        General.</hi></signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
