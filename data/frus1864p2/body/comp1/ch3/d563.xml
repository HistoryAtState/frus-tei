    <text>
        <body>
            <div xml:id="d563">

                <pb facs="0793" n="773" sameAs="frus:frus1864p2/pg773"/>

                <head>Mr. Seward to Lord Lyons.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-11-12"><hi rendition="#italic">
                                November</hi> 12, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Lord</hi>: I have the honor to acknowledge the
                    receipt of your communication of the 2d instant, transmitting further evidence
                    of the nationality of the prisoners in the case of the Night Hawk; and in reply,
                    to inform your lordship that I have transmitted a copy thereof to the Secretary
                    of the Navy recalling his attention to the case with a view to the adoption of
                    such proceedings as the result may warrant, returning the original
                    affidavit.</p>
                <p>I have the honor to be, with the highest consideration, my lord, your
                    obedient</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p>Right Hon. <hi rendition="#small-caps">Lord Lyons</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
