    <text>
        <body>
            <div xml:id="d296">

                <pb facs="0559" n="539" sameAs="frus:frus1864p2/pg539"/>

                <head>Mr. Seward to Lord Lyons.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State.</hi>
                            <hi rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1864-03-03"><hi rendition="#italic"
                                >March</hi> 3, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Lord</hi>: I have the honor to acknowledge the
                    receipt of your note relative to the question of damages in the case of the
                    steamer Labuan, and to inform your lordship that the subject shall receive
                    attention.</p>
                <p>I have the honor to be, with high consideration, my lord, your obedient
                    servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p>Right Hon. <hi rendition="#small-caps">Lord Lyons</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
