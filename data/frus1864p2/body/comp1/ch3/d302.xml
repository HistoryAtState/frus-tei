    <text>
        <body>
            <div xml:id="d302">

                <pb facs="0567" n="547" sameAs="frus:frus1864p2/pg547"/>

                <head>Mr. Seward to Lord Lyons.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1864-03-09"><hi rendition="#italic">
                                March</hi> 9, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Lord</hi>: I have the honor to recur to your note
                    of the 1st instant, so far <pb facs="0568" n="548" xml:id="pg548"/> as it
                    relates to the rights of the United States in regard to maritime captures and
                    jurisdiction, and in reply to enclose a copy of a letter of the 5th instant from
                    the Secretary of the Navy, to whom a copy of your note was submitted, which, it
                    is hoped, will prove satisfactory to your lordship.</p>
                <p>I have the honor to be, with high consideration, my lord, your obedient
                    servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p>Right Hon. <hi rendition="#small-caps">Lord Lyons</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d302-a1.xml" xpointer="d302-a1"/>
            </div>
