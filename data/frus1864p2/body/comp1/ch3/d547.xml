    <text>
        <body>
            <div xml:id="d547">

                <pb facs="0773" n="753" sameAs="frus:frus1864p2/pg753"/>

                <head>Mr. Seward to Mr.
                        Burnley.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-10-26"><hi rendition="#italic"
                                >October</hi> 26, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Referring to your note of the 17th ultimo,
                    relative to the claim of Miss Murray to certain cotton alleged to have been
                    seized by the United States government in Mississippi, I have the honor, in
                    reply, to enclose, a copy of a letter of the 19th instant, from the War
                    Department, regarding this case.</p>
                <p>I have the honor to be, with high consideration, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">J. Hume Burnley,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d547-a1.xml" xpointer="d547-a1"/>
            </div>
