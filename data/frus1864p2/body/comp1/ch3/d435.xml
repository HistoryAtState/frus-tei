    <text>
        <body>
            <div xml:id="d435">

                <pb facs="0680" n="660" sameAs="frus:frus1864p2/pg660"/>

                <head>Mr. Seward to Lord Lyons.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-07-21"><hi rendition="#italic">July
                                21,</hi> 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Lord</hi>: With reference to the subject of the
                    detention of persons captured on vessels engaged in violating the blockade, I
                    have the honor to invite your lordship’s attention to the accompanying extract
                    from a despatch of the 1st instant, addressed to me by the consul general of the
                    United States at Havana.</p>
                <p>I have the honor to be, with high consideration, my lord, your obedient
                    servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p>Right Hon. <hi rendition="#small-caps">Lord Lyons,</hi>
                        <hi rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d435-a1.xml" xpointer="d435-a1"/>
            </div>
