            <div xml:id="d209-a33">

                <pb facs="0464" n="444" sameAs="frus:frus1864p2/pg444"/>

                <head>No. 5—B.</head>
                <p>Statement of loss sustained on cargo of steamship Margaret and Jessie, by damage
                    caused by the sinking and stranding of said steamship :</p>
                <table cols="2">
                    <row role="label">
                        <cell>Value of said cargo in Nassau, if landed in good order, as shown by
                            the declaration of Hon. George D. Harris</cell>
                        <cell rendition="#bottom" role="num">£32,162</cell>
                        <cell rendition="#bottom" role="num">10</cell>
                        <cell rendition="#bottom" role="num">0</cell>
                    </row>
                    <row>
                        <cell>Less net proceeds of sales at auction, as per accompanying account
                            sales</cell>
                        <cell rendition="#bottom" role="num">14,630</cell>
                        <cell rendition="#bottom" role="num">5</cell>
                        <cell rendition="#bottom" role="num">0</cell>
                    </row>
                    <row>
                        <cell>Actual loss</cell>
                        <cell rendition="#bottom" role="num">17,532</cell>
                        <cell rendition="#bottom" role="num">5</cell>
                        <cell rendition="#bottom" role="num">0</cell>
                    </row>
                </table>
                <closer>
                    <signed>GEORGE A. TRENHOLM, By his agent, J. B. LAFITTE.</signed>
                    <lb/>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Nassau,</hi> N. P.</placeName>, <date
                            calendar="gregorian" when="1863-07-03"><hi rendition="#italic">July</hi>
                            3, 1863.</date></dateline></closer>
            </div>
        </body>
