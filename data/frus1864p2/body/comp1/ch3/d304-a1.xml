    <text>
        <body>
            <div xml:id="d304-a1">

                <pb facs="0569" n="549" sameAs="frus:frus1864p2/pg549"/>

                <head>Mr. Stanton to Mr.
                        Seward.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">War Department</hi>, <hi
                                rendition="#italic">Washington City</hi>,</placeName>
                        <date calendar="gregorian" when="1864-03-08"><hi rendition="#italic"
                                >March</hi> 8, 1864</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor of enclosing to you a copy
                    of a report made to this department by Provost Marshal Baker, for your
                    information and such action as you may deem proper.</p>
                <p>Your obedient servant,</p>
                <closer>
                    <signed>EDWIN M. STANTON, <hi rendition="#italic">Secretary of
                        War.</hi></signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State.</hi></p>
                </postscript>


                <xi:include href="d304-a1-a1.xml" xpointer="d304-a1-a1"/>
