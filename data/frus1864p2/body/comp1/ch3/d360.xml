    <text>
        <body>
            <div xml:id="d360">

                <pb facs="0622" n="602" sameAs="frus:frus1864p2/pg602"/>

                <head>Mr. Seward to Lord Lyons.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1864-05-05"><hi rendition="#italic"
                                >May</hi> 5, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Lord</hi>: I have the honor to acknowledge with
                    much satisfaction the receipt of your communication of the 22d ultimo, relative
                    to the case of the schooner J. L. Gerety, or Eureka.</p>
                <p>Thanking your lordship for the information it contains, I have the honor to be,
                    with high consideration, my lord, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p>Right Hon. <hi rendition="#small-caps">Lord Lyons</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
