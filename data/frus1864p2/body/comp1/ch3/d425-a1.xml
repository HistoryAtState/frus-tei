    <text>
        <body>
            <div xml:id="d425-a1">

                <pb facs="0671" n="651" xml:id="pg651"/>

                <head>Mr. Stanton to Mr. Seward.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">War Department,
                            Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-07-08"><hi rendition="#italic"
                                >July</hi> 8,1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to transmit, herewith, a
                    copy of the opinion of Judge Advocate General Holt to whom agreeably to the
                    request made in your letter of the 16th ultimo, the copy of the note of Lord
                    Lyons which accompanied it, relative to the death of James Hardcastle, from the
                    effect of a shot fired by a sentinel at the Old Capitol prison, where he was
                    confined, was referred for a review of the whole case.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>EDWIN M. STANTON, <hi rendition="#italic">Secretary of
                        War</hi>.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State.</hi></p>
                </postscript>


                <xi:include href="d425-a1-a1.xml" xpointer="d425-a1-a1"/>
