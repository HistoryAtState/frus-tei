    <text>
        <body>
            <div xml:id="d582-a1-a29">

                <pb facs="0820" n="800" sameAs="frus:frus1864p2/pg800"/>

                <p rendition="#center">UNITED STATES OF AMERICA.</p>
                <p><hi rendition="#small-caps">State of Vermont,</hi>
                    <hi rendition="#italic">Executive Department:</hi></p>
                <p>I, John Gregory Smith, governor of the said State of Vermont, do hereby certify
                    that the foregoing document is authenticated according to the laws-of said State
                    of Vermont and of the United States; that the signature of the respective <pb
                        facs="0821" n="801" xml:id="pg801"/> officers attached to said certificates
                    of authentication are genuine, and that said officers respectively hold and
                    exercise the offices which they in and by said certificates purport to hold and
                    exercise; and that the seal of the county court of the aforesaid county of
                    Franklin thereon is genuine, and that full faith ought to be given to said
                    document and certificates.</p>
                <closer><dateline rendition="#float-left">In witness whereof I have caused the seal
                        of the said State to be hereto at tached, and affixed my signature hereto,
                        at <placeName>Montpelier</placeName>, <date calendar="gregorian"
                            when="1864-10-31">this thirty-first day of October, in the year of our
                            Lord one thousand eight hundred and sixty-four</date>.<seg type="margin"
                                ><hi rendition="#small-caps">[l. s.]</hi></seg></dateline>
                    <lb/>
                    <signed>J. GREGORY SMITH.</signed></closer>
                <postscript>
                    <p>By his excellency the governor.</p>
                    <p>Attest:</p>
                    <p rendition="#right">G. W. BAILEY, <hi rendition="#italic">Secretary of
                            State.</hi></p>
                </postscript>
            </div>
