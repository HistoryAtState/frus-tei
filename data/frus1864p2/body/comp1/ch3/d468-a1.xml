    <text>
        <body>
            <div xml:id="d468-a1">

                <pb facs="0708" n="688" xml:id="pg688"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Treasury Department,</hi></placeName>
                        <date calendar="gregorian" when="1864-08-17"><hi rendition="#italic"
                                >August</hi> 17, 1864.</date></dateline></opener>
                <p>This department having been officially notified that the conditions named in the
                    Executive order of the 30th July, 1864, have been complied with by the
                    government of Canada, to wit, that the exportation of anthracite coal from the
                    province of Canada should be prohibited, the instructions of this department,
                    heretofore issued, prohibiting the exportation of anthracite coal from the
                    United States are hereby so far modified that such coal may be exported except
                    by sea into Canada, without restriction.</p>
                <closer>
                    <signed>GEORGE HARRINGTON, <hi rendition="#italic">Acting Secretary of the
                            Treasury.</hi></signed></closer>
            </div>
        </body>
    </text>
