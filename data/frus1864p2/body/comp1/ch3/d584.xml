    <text>
        <body>
            <div xml:id="d584">

                <pb facs="0824" n="804" sameAs="frus:frus1864p2/pg804"/>

                <head>Mr. Burnley to Mr.
                        Seward.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-11-22"><hi rendition="#italic"
                                >November</hi> 22, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I had the honor this morning to receive
                    your note of yesterday’s date enclosing to me copies of fresh warrants and other
                    papers in the matter of the extradition of Samuel Eugene Lackey and others.</p>
                <p>I have this day forwarded these documents to his excellency the governor general
                    of Canada.</p>
                <p>I have the honor to be, with the highest consideration, sir, your most obe dient,
                    humble servant,</p>
                <closer>
                    <signed>For LORD LYONS,</signed>
                    <lb/>
                    <signed>J. HUME BURNLEY.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">&amp;c, &amp;c, &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
