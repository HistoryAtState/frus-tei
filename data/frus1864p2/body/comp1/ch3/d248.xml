    <text>
        <body>
            <div xml:id="d248">

                <pb facs="0517" n="497" sameAs="frus:frus1864p2/pg497"/>

                <head>Mr. Seward to Lord Lyons.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1864-01-21"><hi rendition="#italic"
                                >January</hi> 21, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Lord</hi>: Your note of the 30th ultimo, relative
                    to the case of the “Victor” was duly received, and has been taken into
                    consideration. This department expects to have occasion soon to address you
                    again on that subject. I have the honor to be, my lord, your very obedient
                    servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD. </signed></closer>
                <postscript>
                    <p>Right Hon. <hi rendition="#small-caps">Lord Lyons</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
