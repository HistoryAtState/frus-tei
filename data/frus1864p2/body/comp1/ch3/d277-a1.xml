    <text>
        <body>
            <div xml:id="d277-a1">

                <pb facs="0542" n="522" sameAs="frus:frus1864p2/pg522"/>

                <head>Mr. Chase to Mr.
                        Seward.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Treasury Department</hi>,</placeName>
                        <date calendar="gregorian" when="1864-02-12"><hi rendition="#italic"
                                >February</hi> 12, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to transmit herewith a
                    copy of a letter from the assistant collector of New York, received in response
                    to your letter of inquiry of the 30th ultimo, concerning the seizure of the
                    British schooner Etta, alleged to have been made at New York in the autumn of
                    last year.</p>
                <p>I am, respectfully,</p>
                <closer>
                    <signed>S. P. CHASE, <hi rendition="#italic">Secretary of the
                        Treasury</hi>,</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, &amp;c., &amp;c.,
                        &amp;c.</hi></p>
                </postscript>


                <xi:include href="d277-a1-a1.xml" xpointer="d277-a1-a1"/>
            </div>
