                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <p rendition="#center"><hi rendition="#italic">Expenses incurred by Captain
                        McPherson owing to the detention of his two apprentices on board the St.
                        Mary’s,</hi></p>
                <table cols="4">
                    <row>
                        <cell>For labor discharging at Tortorabello</cell>
                        <cell/>
                        <cell role="num">$9</cell>
                        <cell role="num">00</cell>
                    </row>
                    <row>
                        <cell>For labor loading at Chaneral</cell>
                        <cell rendition="#border-bottom"/>
                        <cell rendition="#border-bottom" role="num">42</cell>
                        <cell rendition="#border-bottom" role="num">52</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell rendition="#border-bottom"/>
                        <cell rendition="#border-bottom" role="num">51</cell>
                        <cell rendition="#border-bottom" role="num">52</cell>
                    </row>
                    <row>
                        <cell>Together $51 52 at 4s. <hi rendition="#italic">5d.</hi> per
                            dollar</cell>
                        <cell role="num"><hi rendition="#italic">£</hi>9</cell>
                        <cell role="num">13</cell>
                        <cell role="num">2</cell>
                    </row>
                    <row>
                        <cell>For wages of two substitutes for the homeward voyage to
                            Swansea.</cell>
                        <cell role="num">29</cell>
                        <cell role="num">13</cell>
                        <cell role="num">0</cell>
                    </row>
                </table>
