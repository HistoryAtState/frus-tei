            <div xml:id="toc">

                <pb facs="0015" n="XI" xml:id="pgXI"/>

                <head>Contents</head>
                <list type="toc">
                    <item><ref target="#pgIII"><hi rendition="#bold">Preface</hi></ref></item>
                    <item><ref target="#pgXIII"><hi rendition="#bold">List of
                        Sources</hi></ref></item>
                    <item><ref target="#pgXIX"><hi rendition="#bold">List of
                            Abbreviations</hi></ref></item>
                    <item><ref target="#pgXXV"><hi rendition="#bold">List of
                        Persons</hi></ref></item>
                    <item><hi rendition="#bold">Eastern Europe</hi>
                        <list>
                            <item><ref target="#pg1">U.S. policy toward the Soviet-dominated nations
                                    in Eastern Europe; U.S. response to the Rapacki plan for
                                    creation of a nuclear-free zone in Central Europe; President
                                    Eisenhower’s proclamation of Captive Nations Week</ref></item>
                        </list></item>
                    <item><hi rendition="#bold">Soviet Union</hi>
                        <list>
                            <item><ref target="#pg146">January–February 1958: Soviet announcement of
                                    a reduction in its armed forces; Ambassador Mikhail A.
                                    Menshikov’s presentation of credentials</ref></item>
                            <item><ref target="#pg155">March–June 1958: Soviet charges of U.S.
                                    violations of its air space; changes in the Soviet
                                    leadership</ref></item>
                            <item><ref target="#pg170">June–December 1958: C–118 and C–130 airplane
                                    incidents; U.S. balloon reconnaissance program; visits to the
                                    Soviet Union of Adlai E. Stevenson, Eric Johnston, and Hubert
                                    Humphrey</ref></item>
                            <item><ref target="#pg207">January–February 1959: Visit to the United
                                    States of Anastas I. Mikoyan; the 21st Congress of the Communist
                                    Party of the Soviet Union</ref></item>
                            <item><ref target="#pg268">May–June 1959: Visit to the Soviet Union of
                                    W. Averell Harriman</ref></item>
                            <item><ref target="#pg287">June–July 1959: Visit to the United States of
                                    Frol R. Kozlov</ref></item>
                            <item><ref target="#pg326">July–August 1959: Visit to the Soviet Union
                                    of Richard M. Nixon</ref></item>
                            <item><ref target="#pg388">September–December 1959: Visit to the United
                                    States of Nikita S. Khrushchev</ref></item>
                            <item><ref target="#pg498">January–February 1960: Resumption and
                                    suspension of lend-lease negotiations; visit to the Soviet Union
                                    of Henry Cabot Lodge</ref></item>
                            <item><ref target="#pg510">May–July 1960: The U–2 airplane
                                    incident</ref></item>
                            <item><ref target="#pg556">July–September 1960: The RB–47 airplane
                                    incident. 540 September–October 1960: Visit to the United
                                    Nations of Nikita S. Khrushchev</ref></item>
                        </list></item>
                    <pb facs="0016" n="XII" xml:id="pgXII"/>
                    <item><hi rendition="#bold">Cyprus</hi>
                        <list>
                            <item><ref target="#pg564">January–April 1958: U.S. support for the Foot
                                    proposals</ref></item>
                            <item><ref target="#pg605">May–June 1958: The Macmillan
                                proposals</ref></item>
                            <item><ref target="#pg676">July–October 1958: Revision and
                                    implementation of the Macmillan proposals; efforts to convene a
                                    NATO conference on Cyprus</ref></item>
                            <item><ref target="#pg735">November–December 1958: Discussions at the
                                    United Nations</ref></item>
                            <item><ref target="#pg753">December 1958–February 1959: The final
                                    settlement on Cyprus</ref></item>
                            <item><ref target="#pg772">February 1959–July 1960: Constitution of the
                                    Republic of Cyprus; efforts by the United States to secure its
                                    interests</ref></item>
                            <item><ref target="#pg835">August–December 1960: Initial U.S. relations
                                    with the Republic of Cyprus….</ref></item>
                        </list></item>
                    <item><ref target="#pg845"><hi rendition="#bold">Index</hi></ref></item>
                </list>
