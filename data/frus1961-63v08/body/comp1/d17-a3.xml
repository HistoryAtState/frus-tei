                        <cell role="num">15</cell>
                        <cell role="num">0</cell>
                    </row>
                </table>
                <pb facs="0080" n="48" xml:id="pg48"/>
                <p><hi rendition="#italic">Note</hi>: The difference in the approach to missile
                    development in the two countries may explain, in part, the difference in test
                    firings.</p>
