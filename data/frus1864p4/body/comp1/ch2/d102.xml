    <text>
        <body>
            <div xml:id="d102">

                <pb facs="0143" n="119" sameAs="frus:frus1864p4/pg119"/>

                <head>Mr. Motley to Mr.
                        Seward.</head>
                <opener>
                    <seg rendition="#float-left">No. 37.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the U. S. of America at
                                Vienna</hi></placeName>, <date calendar="gregorian"
                            when="1863-10-26"><hi rendition="#italic">October</hi>26,
                        1863</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge the receipt
                    of your despatches Nos. 42, 43, and 44.</p>
                <pb facs="0144" n="120" xml:id="pg120"/>
                <p>I beg herewith to enclose to you the translation of a communication just received
                    from the imperial royal department of foreign affairs.</p>
                <p>I have the honor to remain, sir, your obedient servant,</p>
                <closer>
                    <signed>J. LOTHROP MOTLEY.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington.</hi></p>
                </postscript>


                <xi:include href="d102-a1.xml" xpointer="d102-a1"/>
            </div>
        </body>
    </text>
