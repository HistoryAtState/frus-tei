    <text>
        <body>
            <div xml:id="d452">

                <pb facs="0438" n="414" xml:id="pg414"/>

                <head>Mr. Seward to Mr. McMath.</head>
                <opener>
                    <seg rendition="#float-left">No. 13.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1864-08-25"><hi rendition="#italic"
                                >August</hi> 25, 1864</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your despatch of the 1st ultimo, No. 22,
                    announcing the removal of certain restrictions on trade in the interior markets
                    of Morocco, has been received, and has been read with satisfaction. Due
                    publicity will be given to the information you have communicated.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Jesse H. McMath</hi>, Esq., &amp;<hi
                            rendition="#italic">c</hi>., &amp;<hi rendition="#italic">c</hi>.,
                            &amp;<hi rendition="#italic">c</hi>.<hi rendition="#italic">,
                            Tangier.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
