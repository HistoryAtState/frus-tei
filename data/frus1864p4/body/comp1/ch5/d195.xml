    <text>
        <body>
            <div xml:id="d195">

                <pb facs="0253" n="229" sameAs="frus:frus1864p4/pg229"/>

                <head>Mr. Seward to Mr.
                        Sanford.</head>
                <opener>
                    <seg rendition="#float-left">No. 142.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1864-08-25"><hi rendition="#italic"
                                >August</hi> 25, 1864</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi>Your despatches from No. 204, of the 21st
                    ultimo, to No. 208, of the 29th ultimo, inclusive, have been received. I thank
                    you for the interesting information communicated in your No. 205, relative to
                    the movements of his Belgian Majesty. Your No. 206 was, on its receipt,
                    submitted to the perusal of the Secretary of the Navy.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Henry S. Sanford</hi>, Esq., &amp;<hi
                            rendition="#italic">c</hi>., &amp;<hi rendition="#italic">c</hi>.,
                            &amp;<hi rendition="#italic">c</hi>., <hi rendition="#italic"
                            >Brussels.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
