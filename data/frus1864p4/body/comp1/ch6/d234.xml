    <text>
        <body>
            <div xml:id="d234">

                <pb facs="0291" n="267" sameAs="frus:frus1864p4/pg267"/>

                <head>Mr. Seward to Mr.
                        Harvey.</head>
                <opener>
                    <seg rendition="#float-left">No. 123.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1863-11-30"><hi rendition="#italic"
                                >November</hi> 30, 1863</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi>Your despatch, No. 238, of the 4th instant
                    has been received and will be submitted for perusal to the Secretary of the
                    Navy.</p>
                <p>Your vigilance in watching the movements of rebel cruisers, and your exertions to
                    prevent their depredations upon our commerce, are cordially commended.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">James E. Harvey</hi>, Esq., &amp;<hi
                            rendition="#italic">c</hi>., &amp;<hi rendition="#italic">c</hi>.,
                            &amp;<hi rendition="#italic">c</hi>.<hi rendition="#italic">,
                            Lisbon.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
