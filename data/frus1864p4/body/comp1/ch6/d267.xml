    <text>
        <body>
            <div xml:id="d267">

                <pb facs="0307" n="283" sameAs="frus:frus1864p4/pg283"/>

                <head>Mr. Harvey to Mr.
                        Seward.</head>
                <opener>
                    <seg rendition="#float-left">No. 246.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">Lisbon</hi></placeName>, <date
                            calendar="gregorian" when="1863-12-27"><hi rendition="#italic"
                                >December</hi> 27, 1863</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I transmit with this despatch the copy of a
                    letter from the United States consul at Funchal, giving information concerning
                    various suspected vessels, which will doubtless be communicated to the Navy
                    Department.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>JAMES E. HARVEY.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State,</hi> &amp;<hi
                            rendition="#italic">c</hi>., &amp;<hi rendition="#italic">c</hi>.,
                            &amp;<hi rendition="#italic">c</hi>.</p>
                </postscript>
            </div>
        </body>
    </text>
