    <text>
        <body>
            <div xml:id="d327-a1">

                <pb facs="0344" n="320" sameAs="frus:frus1864p4/pg320"/>

                <head>[Telegram.]</head>
                <p>Inform Craven or some other commander that a rebel armed steamer was seen off
                    Sicily a few days ago.</p>
                <closer>
                    <signed>JAMES E. HARVEY.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">H. S. Sanford</hi>, <hi rendition="#italic"
                            >United States Minister, Brussels.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
