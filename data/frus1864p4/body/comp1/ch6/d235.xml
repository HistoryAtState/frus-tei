    <text>
        <body>
            <div xml:id="d235">

                <pb facs="0292" n="268" xml:id="pg268"/>

                <head>Mr. Seward to Mr. Harvey.</head>
                <opener>
                    <seg rendition="#float-left">No. 124.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1863-12-19"><hi rendition="#italic"
                                >December</hi> 19, 1863</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your despatch, No. 239, bearing date of
                    November 11, and relating to Captain Winslow, of the United States steamer
                    Kearsarge, has been received and a copy sent to the Secretary of the Navy.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">James E. Harvey</hi>, Esq., &amp;<hi
                            rendition="#italic">c</hi>., &amp;<hi rendition="#italic">c</hi>.,
                            &amp;<hi rendition="#italic">c</hi>.<hi rendition="#italic">,
                            Lisbon.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
