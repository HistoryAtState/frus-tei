    <text>
        <body>
            <div xml:id="d233">

                <pb facs="0291" n="267" sameAs="frus:frus1864p4/pg267"/>

                <head>Mr. Seward to Mr.
                        Harvey.</head>
                <opener>
                    <seg rendition="#float-left">No. 121.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1863-11-23"><hi rendition="#italic"
                                >November</hi> 23, 1863</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi>Tour despatch of the 29th ultimo, No. 237,
                    has been received and has been submitted for perusal to the Secretary of the
                    Navy.</p>
                <p>Your proceedings in relation to the movements of the rebel cruiser Georgia are
                    approved.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">James E. Harvey</hi>, Esq., &amp;<hi
                            rendition="#italic">c</hi>., &amp;<hi rendition="#italic">c</hi>.,
                            &amp;<hi rendition="#italic">c</hi>.<hi rendition="#italic">,
                            Lisbon</hi>.</p>
                </postscript>
            </div>
        </body>
    </text>
