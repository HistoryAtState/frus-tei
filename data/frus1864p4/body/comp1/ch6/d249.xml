    <text>
        <body>
            <div xml:id="d249">

                <pb facs="0296" n="272" sameAs="frus:frus1864p4/pg272"/>

                <head>Mr. Seward to Mr.
                        Harvey.</head>
                <opener>
                    <seg rendition="#float-left">No. 154.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1864-11-29"><hi rendition="#italic"
                                >November</hi> 29, 1864</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi>Your despatch, No. 296, of the 14th ultimo
                    has been received, and I have commended to the Secretary of the Navy your
                    suggestion as to the importance <pb facs="0297" n="273" xml:id="pg273"/> of
                    ready communication between our ministers abroad and naval officers of the
                    United States on foreign stations.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">James E. Harvey</hi>, Esq., &amp;<hi
                            rendition="#italic">c</hi>., &amp;<hi rendition="#italic">c</hi>.,
                            &amp;<hi rendition="#italic">c</hi>.<hi rendition="#italic">,
                            Lisbon.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
