    <text>
        <body>
            <div xml:id="d282">

                <pb facs="0316" n="292" sameAs="frus:frus1864p4/pg292"/>

                <head>Mr. Harvey to Mr.
                        Seward.</head>
                <opener>
                    <seg rendition="#float-left">No. 257.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">Lisbon</hi></placeName>, <date
                            calendar="gregorian" when="1864-02-01"><hi rendition="#italic"
                                >February</hi> 1, 1864</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to submit a copy of
                    instructions, which it seemed to me proper to issue to the United States consuls
                    at the Azores, Madeira, and Cape Verde islands, in view of the recent
                    correspondence with this government, and in order also that every means might be
                    exerted to guard, as far as may be practicable, against the threatened dangers
                    to our commerce.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>JAMES E. HARVEY.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
