    <text>
        <body>
            <div xml:id="d438">

                <pb facs="0427" n="[403]" sameAs="frus:frus1864p4/pg403"/>

                <head>Mr. Seward to Mr.
                        Thayer.</head>
                <opener>
                    <seg rendition="#float-left">No. 26.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1863-10-23"><hi rendition="#italic"
                                >October</hi> 23, 1863</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your despatch of September 5, No. 37, has
                    been received. The information it communicates relative to the cotton crop in
                    Egypt, and the favorable progress of the Suez canal enterprise, is very
                    interesting and instructive.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">William S. Thayer</hi>, Esq., &amp;<hi
                            rendition="#italic">c</hi>., &amp;<hi rendition="#italic">c</hi>.,
                            &amp;<hi rendition="#italic">c</hi>.<hi rendition="#italic">,
                            Alexandria.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
