    <text>
        <body>
            <div xml:id="d154">

                <pb facs="0218" n="194" sameAs="frus:frus1864p4/pg194"/>

                <head>Mr. Seward to Mr.
                        Kreismann.</head>
                <opener>
                    <seg rendition="#float-left">No. 18.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-09-20"><hi rendition="#italic"
                                >September</hi> 20, 1864</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I think it important that you ascertain, as
                    well as you can, what vessels built in France or elsewhere for the rebels of the
                    United States are purchased by the government of Prussia, and keep Mr. Dayton
                    and Mr. Adams well advised on the subject.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Hermann Kreismann</hi>, Esq., &amp;<hi
                            rendition="#italic">c</hi>., &amp;<hi rendition="#italic">c</hi>.,
                            &amp;<hi rendition="#italic">c</hi>.<hi rendition="#italic">,
                            Berlin.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
