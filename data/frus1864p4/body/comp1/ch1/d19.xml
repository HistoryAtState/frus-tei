    <text>
        <body>
            <div xml:id="d19">

                <pb facs="0038" n="14" sameAs="frus:frus1864p4/pg14"/>

                <head>Mr. Seward to Mr.
                        Koerner.</head>
                <opener>
                    <seg rendition="#float-left">No. 74.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1864-03-22"><hi rendition="#italic"
                                >March</hi> 22, 1864</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi>For your information I enclose herewith a
                    copy of a despatch of the 12th instant from the consulate general at Havana, on
                    the subject of an apprehended revolt of the negroes on the island, through the
                    agency of Dominican and Haytian emissaries.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Gustavus Koerner</hi>, Esq., &amp;<hi
                            rendition="#italic">c</hi>., &amp;<hi rendition="#italic">c</hi>.,
                            &amp;<hi rendition="#italic">c</hi>.<hi rendition="#italic">,
                            Madrid.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
