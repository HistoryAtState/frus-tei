    <text>
        <body>
            <div xml:id="d50">

                <pb facs="0059" n="35" sameAs="frus:frus1864p4/pg35"/>

                <head>Mr. Seward to Mr. Koerner.</head>
                <opener>
                    <seg rendition="#float-left">No. 108½.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1864-06-24"><hi rendition="#italic">June</hi>
                            24, 1864</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I enclose for your information a transcript
                    of a communication which I have this day addressed to the honorable Jas. F.
                    Wilson, chairman of the Committee on the Judiciary of the House of
                    Representatives, on the subject of the extradition of Colonel Arguelles.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Gustavus Koerner</hi>, Esq., &amp;<hi
                            rendition="#italic">c</hi>.<hi rendition="#italic">,</hi> &amp;<hi
                            rendition="#italic">c</hi>. <hi rendition="#italic">Madrid.</hi></p>
                </postscript>


                <xi:include href="d50-a1.xml" xpointer="d50-a1"/>
            </div>
        </body>
    </text>
