    <text>
        <body>
            <div xml:id="d50-a1-a2">

                <pb facs="0080" n="56" sameAs="frus:frus1864p4/pg56"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1855-09-19"><hi rendition="#italic"
                                >September</hi> 19, 1855</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi>Your despatch, No. 19, has been received,
                    and an extract therefrom relating to the deportation of certain criminals to New
                    York by the authorities of Güstrow has been sent to the mayor of the former
                    place.</p>
                <p>I am, sir, &amp;c.,</p>
                <closer>
                    <signed>WILLIAM HUNTER, <hi rendition="#italic">Assistant
                        Secretary.</hi></signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Samuel Bromberg</hi>, Esq., <hi
                            rendition="#italic">United States Vice-Consul, Hamburg.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
