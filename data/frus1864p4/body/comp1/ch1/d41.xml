    <text>
        <body>
            <div xml:id="d41">

                <pb facs="0052" n="28" sameAs="frus:frus1864p4/pg28"/>

                <head>Mr. Seward to Mr. Koerner.</head>
                <opener>
                    <seg rendition="#float-left">No. 99.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1864-05-30"><hi rendition="#italic">May</hi>
                            30, 1864</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have received your despatch of May 7, No.
                    94, and I appreciate very highly the account you have given me of domestic
                    affairs in Spain.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Gustavus Koerner</hi>, Esq., &amp;<hi
                            rendition="#italic">c</hi>., &amp;<hi rendition="#italic">c</hi>.,
                            &amp;<hi rendition="#italic">c</hi>.<hi rendition="#italic">,
                            Madrid.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
