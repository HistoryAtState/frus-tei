    <text>
        <body>
            <div xml:id="d417">

                <pb facs="0412" n="388" sameAs="frus:frus1864p4/pg388"/>

                <head>Mr. F. W. Seward to Mr. Fogg.</head>
                <opener>
                    <seg rendition="#float-left">No. 59.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1864-09-24"><hi rendition="#italic"
                                >September</hi> 24, 1864</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi>Your despatch No. 67, under date of August
                    26, has been received, and your proceedings in the case of Jean Zweifel are
                    approved.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>F. W. SEWARD, <hi rendition="#italic">Acting
                    Secretary.</hi></signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">George G. Fogg</hi>, Esq., &amp;<hi
                            rendition="#italic">c</hi>., &amp;<hi rendition="#italic">c</hi>.,
                            &amp;<hi rendition="#italic">c</hi>., <hi rendition="#italic"
                        >Berne</hi>.</p>
                </postscript>
            </div>
        </body>
    </text>
