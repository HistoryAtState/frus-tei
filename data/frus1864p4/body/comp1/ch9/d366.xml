    <text>
        <body>
            <div xml:id="d366">

                <pb facs="0370" n="[346]" sameAs="frus:frus1864p4/pg346"/>

                <head>Mr. Seward to Mr.
                        Haldeman.</head>
                <opener>
                    <seg rendition="#float-left">No. 32.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1863-10-05"><hi rendition="#italic"
                                >October</hi> 5, 1863</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have received your despatch of the 12th
                    of last month, No. 34, and have carefully read the very interesting information
                    which it communicates relative to the action of the German Bund concerning the
                    Danish question and its probable results.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Jacob S. Haldeman</hi>, Esq., &amp;<hi
                            rendition="#italic">c</hi>., &amp;<hi rendition="#italic">c</hi>.,
                            &amp;<hi rendition="#italic">c</hi>.<hi rendition="#italic">,
                            Stockholm.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
