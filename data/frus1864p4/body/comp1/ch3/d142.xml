    <text>
        <body>
            <div xml:id="d142">

                <pb facs="0214" n="190" sameAs="frus:frus1864p4/pg190"/>

                <head>Mr. Seward to Mr. Nelson.</head>
                <opener>
                    <seg rendition="#float-left">No. 82.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1864-11-22"><hi rendition="#italic"
                                >November</hi> 22, 1864</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have to acknowledge the receipt of your
                    despatches Nos. 152, 153, and 154, all under date of the 16th of October
                    last.</p>
                <p>Your correspondence with Mr. Covarrubias, transmitted with your No. 152,
                    returning thanks for the courtesies extended to you on the 4th of July last, is
                    deemed satisfactory and is approved.</p>
                <p rendition="#center">* * * * * *</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Thomas H. Nelson</hi>, Esq., &amp;<hi
                            rendition="#italic">c</hi>., &amp;<hi rendition="#italic">c</hi>.,
                            &amp;<hi rendition="#italic">c</hi>.<hi rendition="#italic">,
                            Chili.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
