    <text>
        <body>
            <div xml:id="d266-a1">

                <pb facs="0461" n="389" sameAs="frus:frus1882/pg389"/>

                <opener><seg rendition="#center">[Inclosure 1 in No. 423.]</seg></opener>
                <head><hi rendition="#italic">Mr. Morgan to Señor Mariscal.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1882-05-03"><hi rendition="#italic">May</hi> 3,
                        1882</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have been instructed by my government to
                    request permission for United States troops to cross into Mexico in the pursuit
                    of hostile Indians, whose capture they are seeking to accomplish, until said
                    pursuit can be taken up by a competent force of Mexican troops.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>P. H. MORGAN.</signed></closer>
            </div>
        </body>
