    <text>
        <body>
            <div xml:id="d275">

                <pb facs="0476" n="404" sameAs="frus:frus1882/pg404"/>

                <head>No. 220.<lb/><hi rendition="#italic">Mr. Frelinghuysen to Mr. Morgan</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1882-12-15"><hi rendition="#italic">December</hi> 15,
                        1882</date>.</dateline>
                    <seg rendition="#float-left">No. 349.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit herewith copies of a protocol of
                    an agreement, signed and exchanged September 21, 1882, between Mr. Romero and
                    myself, <pb facs="0477" n="405" xml:id="pg405"/> modifying Article VIII of the
                    agreement between the United States and Mexico of July 29, 1882, providing for
                    the reciprocal right to pursue savage Indians across the boundary line.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>FRED’K T. FRELINGHUYSEN.</signed></closer>


                <xi:include href="d275-a1.xml" xpointer="d275-a1"/>
            </div>
        </body>
    </text>
