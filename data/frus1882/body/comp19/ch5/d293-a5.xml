                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Headquarters Department of the Missouri</hi>,<lb/><hi
                                rendition="#italic">Fort Leavenworth, Kans.</hi></placeName>, <date
                            calendar="gregorian" when="1882-04-04"><hi rendition="#italic"
