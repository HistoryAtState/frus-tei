    <text>
        <body>
            <div xml:id="d310-a4">

                <pb facs="0500" n="428" sameAs="frus:frus1882/pg428"/>

                <opener><seg rendition="#center">[Inclosure 3.—Exhibit A.]</seg></opener>
                <p>Know all men by these presents that I, the undersigned, sheriff of Pima County,
                    Arizona Territory, do hereby appoint W. J. Ross a deputy sheriff in and for said
                    county.</p>
                <closer>
                    <dateline rendition="#float-left">Witness my hand <date calendar="gregorian"
                            when="1882-04-29">this 29th day of April, A. D. 1882</date>.</dateline>
                    <lb/>
                    <signed>R. H. PAUL,<lb/><hi rendition="#italic">Sheriff.</hi></signed></closer>
            </div>
        </body>
    </text>
