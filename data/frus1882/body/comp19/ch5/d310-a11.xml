    <text>
        <body>
            <div xml:id="d310-a11">

                <pb facs="0501" n="429" sameAs="frus:frus1882/pg429"/>

                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Tucson, Arizona Territory</hi></placeName>, <date
                            calendar="gregorian" when="1882-06-22"><hi rendition="#italic">June</hi>
                            22, 1882</date>.</dateline></opener>
                <p>I hereby certify that the above and foregoing is a full, true, and correct copy
                    of the minutes of the board of supervisors of Pima County, Arizona Territory, of
                    May 1, A. D. 1882, and of May 3, A. D. 1882, in as far as action of said board
                    has reference to the certificate of R. H. Paul, sheriff of said county, touching
                    the execution of a warrant of arrest against certain Apache Indians.</p>
                <closer>[<hi rendition="#small-caps">seal.</hi>] <signed>H. WARD,<lb/><hi
                            rendition="#italic">Deputy Clerk, Board of Supervisors, Pima County,
                            Arizona Territory.</hi></signed></closer>
            </div>
        </body>
