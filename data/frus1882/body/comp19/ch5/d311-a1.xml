    <text>
        <body>
            <div xml:id="d311-a1">

                <pb facs="0505" n="433" sameAs="frus:frus1882/pg433"/>

                <opener><seg rendition="#center">[Inclosure.—Telegram.—Translation.]</seg></opener>
                <head><hi rendition="#italic">Mr. Mariscal to Mr.
                            Romero</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1882-07-10"><hi rendition="#italic">July</hi> 10,
                        1882</date>.</dateline></opener>
                <p>Your telegram received to-day. Minister of war has no official knowledge of the
                    disarming, but he orders, if such disarming took place, the arms shall be
                    returned to the nearest United States force.</p>
                <closer><signed>MARISCAL.</signed></closer>
            </div>
        </body>
