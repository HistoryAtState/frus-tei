    <text>
        <body>
            <div xml:id="d298">

                <pb facs="0492" n="420" sameAs="frus:frus1882/pg420"/>

                <head>No. 236.<lb/><hi rendition="#italic">Mr. Frelinghuysen to Señor
                    Romero.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1882-05-12"><hi rendition="#italic">May</hi> 12,
                        1882</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the pleasure to inclose for your
                    information a copy of a letter from the Secretary of War of the 8th instant, in
                    relation to the recent successful operations against the hostile Apaches on the
                    border.</p>
                <p>Accept, &amp;c.,</p>
                <closer><signed>FRED’K T. FRELINGHUYSEN.</signed></closer>
            </div>
        </body>
    </text>
