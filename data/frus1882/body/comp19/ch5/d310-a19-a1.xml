    <text>
        <body>
            <div xml:id="d310-a19-a1">

                <pb facs="0504" n="432" xml:id="pg432"/>

                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Tucson, Arizona</hi></placeName>, <date calendar="gregorian"
                            when="1882-05-09"><hi rendition="#italic">May</hi> 9,
                        1882</date>.</dateline></opener>
                <p rendition="#flush">Capt. <hi rendition="#small-caps">William J. Ross</hi>:</p>
                <p>You will proceed with your company of the Arizona Militia, known as the Pima
                    County Rangers, to the southeastern border of Arizona, to prevent the incursions
                    and encroachments of hostile Apache Indians upon the citizens of the
                    Territory.</p>
                <p>Yours, &amp;c.,</p>
                <closer><signed>F. A. TRITLE,<lb/><hi rendition="#italic">Governor and
                            Commander-in-Chief of the Militia.</hi></signed></closer>
            </div>
        </body>
    </text>
