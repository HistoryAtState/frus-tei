    <text>
        <body>
            <div xml:id="d293-a4">

                <pb facs="0487" n="415" sameAs="frus:frus1882/pg415"/>

                <opener><seg rendition="#center">[Indorsements.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Headquarters District of New Mexico</hi>,<lb/><hi
                                rendition="#italic">Santa Fé, N. Mex.</hi></placeName>, <date
                            calendar="gregorian" when="1882-03-30"><hi rendition="#italic"
                                >March</hi> 30, 1882</date>.</dateline></opener>
                <p>Respectfully forwarded to the assistant adjutant-general, Department of the
                    Missouri, for the information of the department commander.</p>
                <closer><signed>R. S. MACKENZIE,<lb/><hi rendition="#italic">Colonel Fourth Cavalry,
                            Commanding.</hi></signed></closer>
            </div>
