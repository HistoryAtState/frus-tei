    <text>
        <body>
            <div xml:id="d310-a18">

                <pb facs="0503" n="431" sameAs="frus:frus1882/pg431"/>

                <p>I hereby certify that W. J. Ross acted in the capacity of deputy sheriff of Pima
                    County, Arizona, as well as captain of Arizona militia, in the late campaign
                    against the hostile Apaches—then on the war-path.</p>
                <closer><signed>JNO. S. CARR,<lb/><hi rendition="#italic">Chairman Citizens’
                            Executive Committee.</hi></signed></closer>
                <closer>
                    <dateline rendition="#float-left">Subscribed and sworn to before me <date
                            calendar="gregorian" when="1882-06-23">this 23d day of June,
                        1882</date>.</dateline>
                    <lb/> [<hi rendition="#small-caps">seal.</hi>] <signed>GEO. A. CLUM,<lb/><hi
                            rendition="#italic">Clerk District Court, First District, Arizona
                            Territory</hi>.</signed><lb/>By <signed>C. W. CLUM,<lb/><hi
                            rendition="#italic">Deputy.</hi></signed></closer>
            </div>
        </body>
    </text>
