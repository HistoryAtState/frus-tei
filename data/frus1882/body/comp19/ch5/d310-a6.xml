    <text>
        <body>
            <div xml:id="d310-a6">

                <pb facs="0500" n="428" sameAs="frus:frus1882/pg428"/>

                <p rendition="#flush"><hi rendition="#small-caps">Territory of Arizona</hi>,<lb/><hi
                        rendition="#italic">County of Pima, ss:</hi></p>
                <p>I, Charles R. Drake, county recorder in and for the county of Pima, do hereby
                    certify that the above and foregoing is a full, true, and correct copy of the
                    appointment of W. J. Ross as deputy sheriff for the county of Pima, as appears
                    on file now in my office.</p>
                <closer>
                    <dateline rendition="#float-left">In witness whereof I have hereunto set my hand
                        and affixed my official seal, at my office in <placeName>Tucson</placeName>,
                            <date calendar="gregorian" when="1882-06-22">this 22d day of June, A. D.
                            1882</date>.</dateline>
                    <lb/> [<hi rendition="#small-caps">seal.</hi>] <signed>CHAS. R. DRAKE,<lb/><hi
                            rendition="#italic">County Recorder.</hi></signed></closer>
            </div>
        </body>
    </text>
