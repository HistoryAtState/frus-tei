    <text>
        <body>
            <div xml:id="d295">

                <pb facs="0491" n="419" sameAs="frus:frus1882/pg419"/>

                <head>No. 234.<lb/><hi rendition="#italic">Mr. Frelinghuysen to Señor Romero.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1882-05-03"><hi rendition="#italic">May</hi> 3,
                        1882</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note, of the 17th ultimo, relative to the measures adopted by the War
                    Department for the prevention of future raids into Mexico by the Chiricahua
                    Indians. Accordingly I have referred your request to the Secretary of War, and
                    upon the receipt of his reply will gladly communicate its purport for the
                    information of your government.</p>
                <p>Accept, sir, &amp;c.,</p>
                <closer><signed>FRED’K T. FRELINGHUYSEN.</signed></closer>
            </div>
        </body>
    </text>
