        <body>
            <div xml:id="d310-a8">

                <pb facs="0500" n="428" sameAs="frus:frus1882/pg428"/>

                <p rendition="#flush"><hi rendition="#small-caps">Territory of Arizona</hi>,<lb/><hi
                        rendition="#italic">County of Pima, ss:</hi></p>
                <p>I, William J. Osborn, a justice of the peace in and for the county of Pima,
                    Territory of Arizona, do hereby certify the foregoing to be a full, true, and
                    correct copy of the original warrant issued by me upon a complaint as provided
                    by law, and that I delivered said warrant to R. H. Paul, sheriff of the county
                    of Pima, for service and execution, on the 27th day of April, A. D. 1882.</p>
                <closer><signed>WILLIAM J. OSBORN,<lb/><hi rendition="#italic">Justice of the Peace,
                            Pima County, Arizona.</hi></signed></closer>
            </div>
        </body>
    </text>
