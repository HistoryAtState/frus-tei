    <text>
        <body>
            <div xml:id="d310-a3">

                <pb facs="0500" n="428" xml:id="pg428"/>

                <opener><seg rendition="#center">[Inclosure 2.—Copy of telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Tucson</hi></placeName>, <date calendar="gregorian"
                            when="1882-06-23"><hi rendition="#italic">June</hi> 23,
                        1882</date>.</dateline></opener>
                <p rendition="#flush">Gov. <hi rendition="#small-caps">F. A. Tritle</hi>, <hi
                        rendition="#italic">Governor of Arizona, Washington, D. C.:</hi></p>
                <p>Documents asked for in your dispatch of 21st to Colonel Toole, go to your address
                    by to-night’s mail.</p>
                <p>Please await their arrival.</p>
                <closer><signed>JNO. S. CARR,<lb/><hi rendition="#italic">Chairman Executive
                            Committee.</hi></signed></closer>
            </div>
        </body>
    </text>
