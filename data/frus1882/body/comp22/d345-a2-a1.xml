    <text>
        <body>
            <div xml:id="d345-a2-a1">

                <pb facs="0538" n="466" sameAs="frus:frus1882/pg466"/>

                <head><hi rendition="#italic">American schooner Belief to Manuel Suarez,
                    Dr.</hi></head>
                <table cols="2" rows="8">
                    <row role="label">
                        <cell>Tonnage dues</cell>
                        <cell rendition="#nowrap" role="num">$42 15</cell>
                    </row>
                    <row>
                        <cell>Dispatching from customhouse</cell>
                        <cell rendition="#nowrap" role="num">16 00</cell>
                    </row>
                    <row>
                        <cell>Pilotage</cell>
                        <cell rendition="#nowrap" role="num">9 34</cell>
                    </row>
                    <row>
                        <cell>Interpreter.</cell>
                        <cell rendition="#nowrap" role="num">4 00</cell>
                    </row>
                    <row>
                        <cell>Consul’s fee</cell>
                        <cell rendition="#nowrap" role="num">2 20</cell>
                    </row>
                    <row>
                        <cell>Copying manifest in Spanish</cell>
                        <cell rendition="#nowrap" role="num">3 00</cell>
                    </row>
                    <row>
                        <cell>Commission</cell>
                        <cell rendition="#nowrap #border-bottom" role="num">7 00</cell>
                    </row>
                    <row>
                        <cell>In gold</cell>
                        <cell rendition="#nowrap" role="num">$83 69</cell>
                    </row>
                </table>
                <closer><dateline rendition="#float-left"><placeName><hi rendition="#small-caps"
                                >Havana</hi></placeName>, <date calendar="gregorian"
                            when="1881-11-19"><hi rendition="#italic">November</hi> 19,
                        1881</date>.</dateline>
                    <lb/>
                    <signed>MANUEL SUAREZ</signed>,<lb/><hi rendition="#italic"
                    >Consignee.</hi></closer>
                <postscript>
                    <p>The above-named vessel is only 32.43 American tons, pays the above amount
                        every trip to any port in Cuba, and makes about twelve trips per annum.</p>
                    <closer><signed>FOGARTY &amp; JOHNSON</signed>,<lb/><hi rendition="#italic"
                            >Owners</hi>
                        <lb/>
                        <dateline rendition="#float-left"><placeName><hi rendition="#small-caps">Key
                                    West, Fla.</hi></placeName>, <date calendar="gregorian"
                                when="1882-02-21"><hi rendition="#italic">February</hi> 21,
                                1882</date>.</dateline></closer>
                </postscript>
            </div>
        </body>
