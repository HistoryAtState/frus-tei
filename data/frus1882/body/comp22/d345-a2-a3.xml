    <text>
        <body>
            <div xml:id="d345-a2-a3">

                <pb facs="0538" n="466" sameAs="frus:frus1882/pg466"/>

                <head><hi rendition="#italic">American schooner Riverside to Manuel Suarez,
                    Dr</hi>.</head>
                <table cols="2" rows="8">
                    <row role="label">
                        <cell>Tonnage dues</cell>
                        <cell rendition="#nowrap" role="num">$60 25</cell>
                    </row>
                    <row>
                        <cell>Dispatching from custom-house</cell>
                        <cell rendition="#nowrap" role="num">16 00</cell>
                    </row>
                    <row>
                        <cell>Pilotage</cell>
                        <cell rendition="#nowrap" role="num">9 34</cell>
                    </row>
                    <row>
                        <cell>Interpreter</cell>
                        <cell rendition="#nowrap" role="num">4 00</cell>
                    </row>
                    <row>
                        <cell>Consul’s fee</cell>
                        <cell rendition="#nowrap" role="num">7 10</cell>
                    </row>
                    <row>
                        <cell>Making manifest in Spanish</cell>
                        <cell rendition="#nowrap" role="num">2 50</cell>
                    </row>
                    <row>
                        <cell>Commission</cell>
                        <cell rendition="#nowrap #border-bottom" role="num">7 00</cell>
                    </row>
                    <row>
                        <cell>In gold</cell>
                        <cell rendition="#nowrap" role="num">$106 19</cell>
                    </row>
                </table>
                <closer>
                    <dateline rendition="#float-left">
                        <placeName><hi rendition="#small-caps">Havana</hi></placeName>, <date
                            calendar="gregorian" when="1881-07-23"><hi rendition="#italic">July</hi>
                            23, 1881</date>.</dateline>
                    <lb/>
                    <signed>MANUEL SUAREZ</signed>,<lb/><hi rendition="#italic"
                    >Consignee.</hi></closer>
                <pb facs="0539" n="467" xml:id="pg467"/>
                <postscript>
                    <p>The above-named vessel is 46.26 American tons, and pays the above amount of
                        expense every trip to Havana, and makes about twelve trips a year.</p>
                    <closer><signed>FOGARTY &amp; JOHNSON</signed>,<lb/><hi rendition="#italic"
                            >Agents.</hi>
                        <lb/>
                        <dateline rendition="#float-left"><placeName><hi rendition="#small-caps">Key
                                    West, Fla.</hi></placeName>, <date calendar="gregorian"
                                when="1882-02-21"><hi rendition="#italic">February 21</hi>,
                                1882</date>.</dateline></closer>
                </postscript>
                <postscript>
                    <p>Fogarty and Johnson, owners of schooners Relief and Cuba, and agents for
                        schooner Riverside, Samuel Filer, schooner Ellen E. Filer, and one hundred
                        and twelve other merchants.</p>
                </postscript>
            </div>
        </body>
