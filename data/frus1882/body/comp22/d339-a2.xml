    <text>
        <body>
            <div xml:id="d339-a2">

                <pb facs="0530" n="458" sameAs="frus:frus1882/pg458"/>

                <opener><seg rendition="#center">[Inclosure 2 in No. 24.]</seg></opener>
                <head><hi rendition="#small-caps">protest of the captain of the barkentine john
                        baizley.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Boston</hi></placeName>, <date calendar="gregorian"
                            when="1882-01-02"><hi rendition="#italic">January</hi> 2,
                        1882</date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#italic">Consul of Spain, Boston:</hi></p>
                <p><hi rendition="#small-caps">Dear Sir</hi>: Please take notice that the payment of
                    consular fees on the cargo of the John Baizley are paid under protest.</p>
                <p>Yours, truly,</p>
                <closer><signed>F. P. SHEPHERD,<lb/><hi rendition="#italic"
                    >Master.</hi></signed></closer>
            </div>
        </body>
    </text>
