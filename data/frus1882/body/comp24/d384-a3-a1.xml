    <text>
        <body>
            <div xml:id="d384-a3-a1">

                <pb facs="0594" n="522" sameAs="frus:frus1882/pg522"/>

                <p><hi rendition="#italic">Article</hi> 3 <hi rendition="#italic">of the regulation
                        of</hi> 13<hi rendition="#italic">th</hi> (25<hi rendition="#italic"
                    >th</hi>) <hi rendition="#italic">October</hi>, 1873, <hi rendition="#italic"
                        >published in L’Impartial of</hi> 27<hi rendition="#italic">th October</hi>,
                    1873.</p>
                <p><hi rendition="#small-caps">Art</hi>. 3. All the petroleum contained in the
                    vessel shall be discharged in a special warehouse, at the choice of the
                    importer, provided that this warehouse be removed at least 2 kilometers from the
                    city and at least 1 kilometer from the villages.</p>
            </div>
