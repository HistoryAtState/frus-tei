    <text>
        <body>
            <div xml:id="d367">

                <pb facs="0569" n="497" sameAs="frus:frus1882/pg497"/>

                <head>No. 303.<lb/><hi rendition="#italic">Mr. Bancroft
                            Davis to Mr. Wallace</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1881-12-23"><hi rendition="#italic">December</hi> 23,
                        1881</date>.</dateline>
                    <seg rendition="#float-left">No. 27.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your dispatch No. 30, of the 22d ultimo,
                    touching the increased duty levied on alcohol by the Turkish customs authorities
                    at Smyrna, <pb facs="0570" n="498" xml:id="pg498"/> has been received, and your
                    action in consequence thereof meets with the Department’s approval.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>J. C. BANCROFT DAVIS,<lb/><hi rendition="#italic">Acting
                            Secretary</hi>.</signed></closer>
            </div>
        </body>
    </text>
