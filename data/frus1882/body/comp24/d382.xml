    <text>
        <body>
            <div xml:id="d382">

                <pb facs="0588" n="516" sameAs="frus:frus1882/pg516"/>

                <head>No. 318.<lb/><hi rendition="#italic">Mr. Frelinghuysen to Mr.
                    Wallace</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1882-06-29"><hi rendition="#italic">June</hi> 29,
                        1882</date>.</dateline>
                    <seg rendition="#float-left">No. 68.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your dispatch No. 96, of the 6th instant,
                    inclosing copy of your protest in reply to the note verbal of the Ottoman
                    Government, prohibiting the importation therein of American salt meats, has been
                    received, and your timely action is approved.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>FRED’K T. FRELINGHUYSEN.</signed></closer>
            </div>
        </body>
    </text>
