    <text>
        <body>
            <div xml:id="d373">

                <pb facs="0575" n="503" sameAs="frus:frus1882/pg503"/>

                <head>No. 309.<lb/><hi rendition="#italic">Mr. Wallace to Mr. Frelinghuysen</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1882-03-20"><hi rendition="#italic">March</hi> 20, 1882</date>.
                        (Received April 10.)</dateline>
                    <seg rendition="#float-left">No. 72.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In compliance with the directions in your
                    dispatch No. 40, relative to the action of the British authorities in the matter
                    of protecting American citizens in places in the Ottoman Empire where there are
                    no United States consuls, I addressed a note to Earl Dufferin, British
                    ambassador, a copy of which is inclosed.</p>
                <p>Lord Dufferin acknowledges the note in such pleasant terms that I make haste to
                    forward a copy of his reply.</p>
                <p>I have the honor, &amp;c.,</p>
                <closer><signed>LEW. WALLACE.</signed></closer>



                <xi:include href="d373-a1.xml" xpointer="d373-a1"/>
