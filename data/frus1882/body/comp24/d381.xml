    <text>
        <body>
            <div xml:id="d381">

                <pb facs="0587" n="515" sameAs="frus:frus1882/pg515"/>

                <head>No. 317.<lb/><hi rendition="#italic">Mr. Frelinghuysen to Mr.
                    Wallace</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1882-06-14"><hi rendition="#italic">June</hi> 14,
                        1882</date>.</dateline>
                    <seg rendition="#float-left">No. 63.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Adverting to previous correspondence upon
                    the subject. I have now the pleasure to inclose, for your information, a copy of
                    a note<anchor n="*" xml:id="d381-f1"/> recently received from the British
                    minister at this capital, covering a copy <pb facs="0588" n="516" xml:id="pg516"
                    /> of a circular note addressed by Her Britannic Majesty’s ambassador at
                    Constantinople to Her Majesty’s consular officers in the Ottoman Empire,
                    defining the grounds upon which they shall extend protection to our citizens in
                    Turkey in quarters where we maintain no consular representatives.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>FRED’K. T. FBELINGHUYSEN.</signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d381-f1" n="*" xml:id="d381-f1-content">
                <p>For this inclosure see Document No. 151, <hi rendition="#italic">ante</hi>, <ref
                        target="#pg314">page 314</ref>.</p>
            </note>
