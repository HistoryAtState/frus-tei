                <pb facs="0610" n="538" sameAs="frus:frus1882/pg538"/>

                <head>No. 336.<lb/><hi rendition="#italic">Mr. Davis to Mr. Baker</hi>.</head>
                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1882-08-18"><hi rendition="#italic">August</hi> 18,
                        1882</date>.</dateline>
                    <seg rendition="#float-left">No. 179.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    dispatch No. 522, of the 31st ultimo, and to approve your representations to the
                    Venezuelan Government in the matter of the additional duty, which the Department
                    would be gratified to learn had been satisfactorily adjusted.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>JOHN DAVIS,<lb/><hi rendition="#italic">Acting
                        Secretary</hi></signed></closer>
            </div>
        </body>
    </text>
