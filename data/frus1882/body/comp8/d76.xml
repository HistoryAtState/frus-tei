    <text>
        <body>
            <div xml:id="d76">

                <pb facs="0205" n="133" sameAs="frus:frus1882/pg133"/>

                <head>No. 76.<lb/><hi rendition="#italic">Mr. Frelinghuysen to Mr.
                    Holcombe</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1882-04-21"><hi rendition="#italic">April</hi> 21,
                        1882</date>.</dateline>
                    <seg rendition="#float-left">No. 160.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit herewith for your information
                    copies of a recent circular of the Treasury Department, enjoining the customs
                    officers to enforce the provisions of Article II of the treaty of November 17,
                    1880, with China, relative to importations of opium by Chinese subjects.</p>
                <p>You will communicate two copies of this circular to the foreign minister.</p>
                <p>Acknowledging, in this relation, the receipt of your interesting dispatch, No.
                    57,</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>FRED’K T. FRELINGHUYSEN.</signed></closer>


                <xi:include href="d76-a1.xml" xpointer="d76-a1"/>
            </div>
        </body>
    </text>
