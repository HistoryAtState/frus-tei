    <text>
        <body>
            <div xml:id="d79">

                <pb facs="0213" n="141" sameAs="frus:frus1882/pg141"/>

                <head>No. 79.<lb/><hi rendition="#italic">Mr. Holcombe to Mr. Frelinghuysen</hi>.</head>
                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Pekin</hi></placeName>, <date calendar="gregorian"
                            when="1882-05-09"><hi rendition="#italic">May</hi> 9, 1882</date>.
                        (Received June 29.)</dateline>
                    <seg rendition="#float-left">No. 101.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith for
                    the information of the Department a newspaper extract relating to a military
                    force recently dispatched by the French Government to Tonquin.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>CHESTER HOLCOMBE.</signed></closer>


                <xi:include href="d79-a1.xml" xpointer="d79-a1"/>
            </div>
