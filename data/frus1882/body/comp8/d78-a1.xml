    <text>
        <body>
            <div xml:id="d78-a1">

                <pb facs="0210" n="138" sameAs="frus:frus1882/pg138"/>

                <opener><seg rendition="#center">[Inclosure 1 in No. 99.]</seg></opener>
                <head><hi rendition="#italic">Mr. Carrow to Mr.
                            Holcombe</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Canton</hi></placeName>, <date calendar="gregorian"
                            when="1882-04-06"><hi rendition="#italic">April</hi> 6,
                        1882</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose you herein No.
                    1 from the United States consula<hi rendition="#superscript">r</hi> agency at
                    Swatow, and to ask that you will oblige me with an answer at your
                    convenience.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>F. CARROW.</signed></closer>
            </div>
        </body>
    </text>
