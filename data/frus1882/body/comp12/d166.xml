    <text>
        <body>
            <div xml:id="d166">

                <pb facs="0330" n="258" sameAs="frus:frus1882/pg258"/>

                <head>No. 41.<lb/><hi rendition="#italic">Earl Granville to Mr. West.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Foreign Office</hi></placeName>, <date calendar="gregorian"
                            when="1882-04-05"><hi rendition="#italic">April</hi> 5,
                        1882</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit herewith, for your information,
                    a copy of a letter which I have received from the United States minister in
                    London, pressing for the early trial of Mr. Patrick Slattery, a naturalized
                    citizen of the United States, who is imprisoned in Limerick County jail, under
                    the protection of person and property (Ireland) act, 1881.<anchor n="*"
                        xml:id="d166-f1"/></p>
                <p>I am, &amp;c.,</p>
                <closer><signed>GRANVILLE.</signed></closer>
            </div>
        </body>
    </text>
