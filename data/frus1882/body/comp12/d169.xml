    <text>
        <body>
            <div xml:id="d169">

                <pb facs="0330" n="258" sameAs="frus:frus1882/pg258"/>

                <head>No. 44.<lb/><hi rendition="#italic">Mr. West to Earl Granville.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1882-03-28"><hi rendition="#italic">March</hi> 28, 1882</date>.
                        (Received April 10.)</dateline></opener>
                <p><hi rendition="#small-caps">My Lord</hi>: I have the honor to inclose herewith to
                    your lordship printed copies of the message of the President to the Senate,
                    transmitting papers relating to the imprisonment of Daniel McSweeney in
                    Ireland.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>L. S. SACKVILLE WEST.</signed></closer>



                <xi:include href="d169-a1.xml" xpointer="d169-a1"/>
