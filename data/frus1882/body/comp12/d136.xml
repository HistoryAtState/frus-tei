    <text>
        <body>
            <div xml:id="d136">

                <pb facs="0318" n="246" sameAs="frus:frus1882/pg246"/>

                <head>No. 11.<lb/><hi rendition="#italic">Earl Granville to Mr.
                    Drummond.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Foreign Office</hi></placeName>, <date calendar="gregorian"
                            when="1881-07-09"><hi rendition="#italic">July</hi> 9,
                        1881</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to my dispatch to Sir E.
                    Thornton of the 1st instant, I transmit, for your information, copies of a
                    further correspondence which has passed between Mr. Lowell and this department
                    relative to the arrest of Mr. Joseph B. Walsh.<anchor n="*" xml:id="d136-f1"
                    /></p>
                <p>I am, &amp;c.,</p>
                <closer><signed>GRANVILLE.</signed></closer>
            </div>
        </body>
    </text>
