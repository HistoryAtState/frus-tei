    <text>
        <body>
            <div xml:id="d123-a1">

                <pb facs="0307" n="235" sameAs="frus:frus1882/pg235"/>

                <opener><seg rendition="#center">[Inclosure 1 in No. 349.]</seg></opener>
                <head><hi rendition="#italic">Mr. Lowell to Mr. Barrows</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the. United States</hi>,<lb/><hi rendition="#italic"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1882-04-21"><hi rendition="#italic">April</hi> 21,
                        1882</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: You will please see without delay William
                    Brophy, a suspect claiming to be art American citizen, confined in Naas jail,
                    and say to him that “in case he should be liberated you have authority to pay
                    him forty pounds sterling for his passage to the United States” for which sum
                    you may draw upon me at sight.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>J. R. LOWELL.</signed></closer>
            </div>
        </body>
