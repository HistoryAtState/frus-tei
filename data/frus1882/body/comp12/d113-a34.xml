    <text>
        <body>
            <div xml:id="d113-a34">

                <pb facs="0292" n="220" sameAs="frus:frus1882/pg220"/>

                <opener><seg rendition="#center">[Inclosure 33 in No. 831.]</seg></opener>
                <head><hi rendition="#italic">Mr. Barrows to Mr.
                            Lowell</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Consulate of the United States</hi>,<lb/><hi rendition="#italic"
                                >Dublin</hi></placeName>, <date calendar="gregorian"
                            when="1882-01-31"><hi rendition="#italic">January</hi> 31,
                        1882</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to forward a letter from
                    Mr. Philip O’Sullivan, dated Naas prison, 30th January, 1882, with certificate
                    of naturalization referred to therein, claiming protection from the United
                    States Government, and respectfully request I may be favored with instructions
                    in the matter.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>B. H. BARROWS,<lb/><hi rendition="#italic"
                    >Consul</hi></signed></closer>
            </div>
        </body>
