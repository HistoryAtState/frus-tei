            <div xml:id="d63">

                <pb facs="0177" n="105" sameAs="frus:frus1882/pg105"/>

                <head>No. 63.<lb/><hi rendition="#italic">Mr. Trescot to Mr. Frelinghuysen</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Special Mission of the United States in South America</hi>,<lb/><hi
                                rendition="#italic">Washington, D. C.</hi></placeName>, <date
                            calendar="gregorian" when="1882-06-10"><hi rendition="#italic">June</hi>
                            10, 1882</date>.</dateline>
                    <seg rendition="#float-left">No. 27.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I herewith inclose a copy of a
                    communication just received from Señor Alvarez, secretary for foreign affairs of
                    the Provisional Government of Peru, and have the honor to be your obedient
                    servant,</p>
                <closer><signed>WM. HENRY TRESCOT.</signed></closer>





                <xi:include href="d63-a1.xml" xpointer="d63-a1"/>
