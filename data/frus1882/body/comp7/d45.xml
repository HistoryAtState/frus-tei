                <pb facs="0143" n="71" sameAs="frus:frus1882/pg71"/>

                <head>No. 45.<lb/><hi rendition="#italic">Mr. Trescot to Mr. Frelinghuysen</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Special Mission of the United States in South America</hi>,<lb/><hi
                                rendition="#italic">Viña del Mar, Chili</hi></placeName>, <date
                            calendar="gregorian" when="1882-02-03"><hi rendition="#italic"
                                >February</hi> 3, 1882</date>. (Received March 7.)</dateline>
                    <seg rendition="#float-left">No. 10.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my dispatch No. 6, January 24,
                    I have the honor to inclose copies of the confidential letter of Mr. Balmaceda,
                    the secretary for foreign affairs, and my reply thereto.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>WM. HENRY TRESCOT.</signed></closer>



                <xi:include href="d45-a1.xml" xpointer="d45-a1"/>
