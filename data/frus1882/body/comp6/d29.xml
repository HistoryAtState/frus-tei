    <text>
        <body>
            <div xml:id="d29">

                <pb facs="0118" n="46" sameAs="frus:frus1882/pg46"/>

                <head>No. 29.<lb/><hi rendition="#italic">Mr. Hall to Mr. Frelinghuysen</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States,<lb/>Central America</hi>,<lb/><hi
                                rendition="#italic">Guatemala</hi></placeName>, <date
                            calendar="gregorian" when="1882-08-29"><hi rendition="#italic"
                                >August</hi> 29, 1882</date>. (Received September 16.)</dateline>
                    <seg rendition="#float-left">No. 9.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have just received a communication from
                    the minister of foreign relations in which, on the part of the Government of
                    Guatemala, he requests me to express its gratitude to the Government of the
                    United States for the marked attentions and deferent consideration shown to
                    President Barrios during his recent sojourn in that country. I have time only by
                    this mail to transmit a copy and translation of this communication, and a copy
                    of my reply.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>HENRY C. HALL.</signed></closer>




                <xi:include href="d29-a1.xml" xpointer="d29-a1"/>
                <xi:include href="d29-a2.xml" xpointer="d29-a2"/>
