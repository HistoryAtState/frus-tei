    <text>
        <body>
            <div xml:id="d23">

                <pb facs="0104" n="32" sameAs="frus:frus1882/pg32"/>

                <head>No. 23.<lb/><hi rendition="#italic">Mr. Logan
                        to Mr. Frelinghuysen</hi>.</head>
                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Guatemala City</hi></placeName>, <date calendar="gregorian"
                            when="1882-03-03"><hi rendition="#italic">March</hi> 3, 1882</date>.
                        (Received April 17.)</dateline>
                    <seg rendition="#float-left">No. 273.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Under cover of this dispatch I inclose the
                    translation of an editorial article from El Guatemalteco, the official organ of
                    the Guatemala Government, relating to the proposed American Peace Congress. Its
                    utterances are important. * * *</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>C. A. LOGAN.</signed></closer>



                <xi:include href="d23-a1.xml" xpointer="d23-a1"/>
            </div>
