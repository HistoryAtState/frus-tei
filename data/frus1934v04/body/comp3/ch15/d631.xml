    <text>
        <body>
            <div xml:id="d631">

                <pb facs="0617" n="547" sameAs="frus:frus1934v04/pg547"/>

                <note rend="inline" type="source">611.3231/625a: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        Brazil</hi> (<hi rendition="#italic">Gibson</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1934-08-29T19:00:00-04:00">August 29, 1934—7
                        p.m.</date></dateline>
                </opener>
                <p>115. Please inform Brazilian Government that the Department intends to give
                    public notice shortly of this Government’s intention to negotiate a Reciprocal
                    Foreign Trade Agreement with the Government of Brazil.<anchor n="13"
                        xml:id="d631-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Phillips</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d631-f1" n="13" xml:id="d631-f1-content">
                <p>For text of public notice and statistics concerning trade between the United
                    States and Brazil, issued by the Department of State on August 31, 1934, see
                    Department of State, <hi rendition="#italic">Press Releases</hi>, September 1,
                    1934, pp. 144–149, <hi rendition="#italic">passim.</hi></p>
            </note>
        </listAnnotation>
    </standOff>
