                <pb facs="0513" n="443" sameAs="frus:frus1934v04/pg443"/>

                <note rend="inline" type="source">713.1311/267: Telegram</note>
                <head><hi rendition="#italic">The Minister in Costa Rica</hi> (<hi
                        rendition="#italic">Sack</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">San
                                José</hi></placeName>, <date calendar="gregorian"
                            when="1934-03-05T12:00:00-06:00">March 5,
                        1934—noon</date>.<lb/>[Received 3:05 p.m.]</dateline>
                </opener>
                <p>12. Honduran Minister to Costa Rica, Medál, flying tomorrow to Tegucigalpa for
                    conferences before appointment as delegate to Guatemala Conference.</p>
                <closer><signed><hi rendition="#small-caps">Sack</hi></signed></closer>
            </div>
        </body>
