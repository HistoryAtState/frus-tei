    <text>
        <body>
            <div xml:id="d575">

                <pb facs="0541" n="471" sameAs="frus:frus1934v04/pg471"/>

                <note rend="inline" type="source">810.154/565</note>
                <head><hi rendition="#italic">The Secretary of State to the Secretary of
                        Agriculture</hi> (<hi rendition="#italic">Wallace</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1934-05-18">May 18, 1934</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Dear Mr. Secretary</hi>: Please find attached copy of
                    a letter of May 16th,<anchor n="5" xml:id="d575-f1"/> from Mr. Thomas H.
                    MacDonald, Chief of the Bureau of Public Roads, to Assistant Secretary of State
                    Moore, along with a copy of the suggested legislative provision accompanying the
                    letter.</p>
                <p>Whatever you may determine should be done in respect to the matter will meet with
                    my approval.</p>
                <p>Yours very truly,</p>
                <closer><signed><hi rendition="#small-caps">Cordell Hull</hi></signed></closer>
            </div>
        </body>
    </text>
