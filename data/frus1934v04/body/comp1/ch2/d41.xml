            <div xml:id="d41">

                <pb facs="0091" n="21" sameAs="frus:frus1934v04/pg21"/>

                <note rend="inline" type="source">710.G Commercial Agreement/54: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Chile</hi> (<hi rendition="#italic"
                        >Sevier</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Santiago</hi></placeName>, <date calendar="gregorian"
                            when="1934-09-26T15:00:00-04:00">September 26, 1934—3
                        p.m.</date><lb/>[Received 3:45 p.m.]</dateline>
                </opener>
                <p>93. Department’s circular telegram September 23, 2 p.m. The Foreign Office
                    informs instructions have been sent to the Chilean delegation at Geneva to
                    support the proposition of the Belgian delegation regarding Resolution 81.</p>
                <closer><signed><hi rendition="#small-caps">Sevier</hi></signed></closer>
            </div>
        </body>
