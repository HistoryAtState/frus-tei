            <div xml:id="d386">

                <pb facs="0381" n="311" xml:id="pg311"/>

                <note rend="inline" type="source">725.34/30: Telegram</note>
                <head><hi rendition="#italic">The Minister in Paraguay</hi> (<hi rendition="#italic">Nicholson</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Asunción</hi></placeName>, <date calendar="gregorian"
                            when="1934-08-12T10:00:00-04:00">August 12, 1934—10
                        a.m.</date><lb/>[Received 1:55 p.m.]</dateline>
                </opener>
                <p>36. Department’s telegram No. 31, August 11, 2 p.m. The departure of the Chilean
                    Minister from Asunción has been postponed.</p>
                <closer><signed><hi rendition="#small-caps">Nicholson</hi></signed></closer>
            </div>
        </body>
