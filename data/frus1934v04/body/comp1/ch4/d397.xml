            <div xml:id="d397">

                <pb facs="0389" n="319" xml:id="pg319"/>

                <note rend="inline" type="source">725.34/62: Telegram</note>
                <head><hi rendition="#italic">The Ambassador m Chile</hi> (<hi
                            rendition="#italic">Sevier</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Santiago</hi></placeName>, <date calendar="gregorian"
                            when="1934-09-19T11:00:00-04:00">September 19, 1934—11
                        a.m.</date><lb/>[Received 11:20 a.m.]</dateline>
                </opener>
                <p>91. Chilean-Paraguayan incident has been satisfactorily adjusted along the lines
                    of my telegram 90, September 17, 2 p.m.</p>
                <closer><signed><hi rendition="#small-caps">Sevier</hi></signed></closer>
            </div>
        </body>
