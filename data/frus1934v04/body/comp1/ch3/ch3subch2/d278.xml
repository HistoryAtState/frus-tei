            <div xml:id="d278">

                <pb facs="0297" n="227" xml:id="pg227"/>

                <note rend="inline" type="source">724.3415/4267: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        Brazil</hi> (<hi rendition="#italic">Gibson</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1934-10-18T17:00:00-05:00">October 18, 1934—5
                        p.m.</date></dateline>
                </opener>
                <p>156. Your 288, October 17, 6 p.m. The Department views the proposal most
                    favorably. Please keep the Department fully informed by cable of all
                    developments.</p>
                <closer><signed><hi rendition="#small-caps">Phillips</hi></signed></closer>
            </div>
        </body>
    </text>
