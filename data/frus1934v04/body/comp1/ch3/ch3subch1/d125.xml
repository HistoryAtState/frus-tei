            <div xml:id="d125">

                <pb facs="0157" n="87" sameAs="frus:frus1934v04/pg87"/>

                <note rend="inline" type="source">724.3415/4191: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Brazil</hi> (<hi rendition="#italic">Gibson</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">Rio de
                                Janeiro</hi></placeName>, <date calendar="gregorian"
                            when="1934-09-27T14:00:00-03:00">September 27, 1934—2
                        p.m.</date><lb/>[Received September 27—1:35 p.m.]</dateline>
                </opener>
                <p>244. Foreign Office has received informal invitation from Avenol to join League
                    Commission. Anxious receive earliest possible moment indication as to line taken
                    in your reply in order to follow same course.</p>
                <closer><signed><hi rendition="#small-caps">Gibson</hi></signed></closer>
            </div>
        </body>
