        <body>
            <div xml:id="d86">

                <pb facs="0128" n="58" xml:id="pg58"/>

                <note rend="inline" type="source">724.3415/3567: Telegram</note>
                <head><hi rendition="#italic">The Minister in Bolivia</hi> (<hi rendition="#italic">Des Portes</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">La
                                Paz</hi></placeName>, <date calendar="gregorian"
                            when="1934-02-27T11:00:00-04:00">February 27, 1934—11
                        a.m.</date><lb/>[Received 11:50 a.m.]</dateline>
                </opener>
                <p>14. Attitude toward peace proposal generally favorable. Extension of time for
                    reply may be requested. Repeated to Buenos Aires, Asunción.</p>
                <closer><signed><hi rendition="#small-caps">Des Portes</hi></signed></closer>
            </div>
        </body>
