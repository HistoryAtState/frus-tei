    <text>
        <body>
            <div xml:id="d9-a2">

                <pb facs="0761" n="27" sameAs="frus:frus1877app/pg27"/>

                <head><hi rendition="#small-caps">Table</hi> 2.—<hi rendition="#italic">Importations
                        into Guatemala during the year</hi> 1876, <hi rendition="#italic">by
                        principal countries</hi>.</head>
                <table cols="2" rows="7">
                    <row role="label">
                        <cell>England</cell>
                        <cell role="num">$1,125,150 31</cell>
                    </row>
                    <row>
                        <cell>France</cell>
                        <cell role="num">449,537 38</cell>
                    </row>
                    <row>
                        <cell>Germany</cell>
                        <cell role="num">264,288 25</cell>
                    </row>
                    <row>
                        <cell>United States</cell>
                        <cell role="num">245,867 54</cell>
                    </row>
                    <row>
                        <cell>Spain</cell>
                        <cell role="num">83,893 40</cell>
                    </row>
                    <row>
                        <cell>All other countries</cell>
                        <cell rendition="#border-bottom" role="num">96,095 02</cell>
                    </row>
                    <row>
                        <cell>Total</cell>
                        <cell rendition="#nowrap" role="num"><anchor n="*" xml:id="d9-f1"/>2,264,831
                            90</cell>
                    </row>
                </table>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d9-f1" n="*" xml:id="d9-f1-content">
                <p>In the official report of the Government of Guatemala there is added to the above
                    total $451,952.74 as cost of packing, commissions, insurance, freight; but as
                    that addition is not considered reliable, and the sum is not distributed among
                    the different countries, I have thought it advisable not to take it into
                    account.</p>
            </note>
        </listAnnotation>
    </standOff>
