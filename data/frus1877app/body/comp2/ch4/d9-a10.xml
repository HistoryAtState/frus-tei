                <table cols="2" rows="7">
                    <row role="label">
                        <cell>Coffee</cell>
                        <cell rendition="#nowrap" role="num">$4,859,154 40</cell>
                    </row>
                    <row>
                        <cell>Rubber</cell>
                        <cell rendition="#nowrap" role="num">36,230 40</cell>
                    </row>
                    <row>
                        <cell>Hides</cell>
                        <cell rendition="#nowrap" role="num">54,433 80</cell>
                    </row>
                    <row>
