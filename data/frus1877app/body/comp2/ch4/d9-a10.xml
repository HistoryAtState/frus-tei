                        <cell rendition="#nowrap" role="num">57,587 14</cell>
                    </row>
                    <row>
                        <cell>Exportations from Atlantic ports of hides, rubber, woods, vanilla,
                            sarsaparilla, &amp;c</cell>
                        <cell rendition="#nowrap #border-bottom" role="num">300,000 00</cell>
                    </row>
                    <row>
