    <text>
        <body>
            <div xml:id="d22-a2">

                <pb facs="0103" n="78" xml:id="pg78"/>


                <head>Paper Prepared in the National Security Council<anchor n="5" xml:id="d22-f1"
                    /></head>
                <opener><dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian">undated</date></dateline></opener>
                <p rendition="#center"><hi rendition="#italic">STRATEGIC BOMBER INVESTMENT
                        OPTIONS</hi>
                    <lb/> ($ BILLIONS)</p>
                <table cols="7" xml:id="table008">
                    <row>
                        <cell/>
                        <cell/>
                        <cell>1979</cell>
                        <cell>1981</cell>
                        <cell>5 Years 1978–82</cell>
                        <cell>10 Years 1978–87 (Current $)</cell>
                        <cell>10 Years 1978–87 (Constant $)</cell>
                    </row>
                    <row>
                        <cell rows="2">1. Continue Current B–1 Plan; maximum rate 4/month.</cell>
                        <cell>TOA</cell>
                        <cell>3.2</cell>
                        <cell>4.2</cell>
                        <cell>17.2</cell>
                        <cell>25.3</cell>
                        <cell>21.0</cell>
                    </row>
                    <row>
                        <cell>Outlays</cell>
                        <cell>2.0</cell>
                        <cell>3.5</cell>
                        <cell/>
                        <cell/>
                        <cell/>
                    </row>
                    <row>
                        <cell rows="2">2. Slow B–1 Production Buildup; maximum rate 2/month.</cell>
                        <cell>TOA</cell>
                        <cell>2.2</cell>
                        <cell>3.7</cell>
                        <cell>13.1</cell>
                        <cell>25.3</cell>
                        <cell>18.9</cell>
                    </row>
                    <row>
                        <cell>Outlays</cell>
                        <cell>1.8</cell>
                        <cell>2.4</cell>
                        <cell/>
                        <cell/>
                        <cell/>
                    </row>
                    <pb facs="0104" n="79" xml:id="pg79"/>
                    <row>
                        <cell rows="2">3A. Two-year delay on further B–1 production; initiate
                            R&amp;D on cruise missile carrier (CMC). Assumes B–1 terminates in 1980
                            and production commences on CMC.</cell>
                        <cell>TOA</cell>
                        <cell>1.6</cell>
                        <cell>2.0</cell>
                        <cell>7.8</cell>
                        <cell>16.6</cell>
                        <cell>13.2</cell>
                    </row>
                    <row>
                        <cell>Outlays</cell>
                        <cell>1.5</cell>
                        <cell>1.1</cell>
                        <cell/>
                        <cell/>
                        <cell/>
                    </row>
                    <row>
                        <cell rows="2">3B. Two-year delay on further B–1 production; initiate
                            R&amp;D on CMC. Assumes B–1 production resumes in 1980 at maximum rate,
                            and no CMC production.</cell>
                        <cell>TOA</cell>
                        <cell>1.6</cell>
                        <cell>2.6</cell>
                        <cell>12.7</cell>
                        <cell>28.8</cell>
                        <cell>21.5</cell>
                    </row>
                    <row>
                        <cell>Outlays</cell>
                        <cell>1.5</cell>
                        <cell>1.8</cell>
                        <cell/>
                        <cell/>
                        <cell/>
                    </row>
                    <row>
                        <cell rows="2">4. Terminate B–1 production; plan no new aircraft.</cell>
                        <cell>TOA</cell>
                        <cell>.7</cell>
                        <cell>.9</cell>
                        <cell>4.1</cell>
                        <cell>6.0</cell>
                        <cell>4.6</cell>
                    </row>
                    <row>
                        <cell>Outlays</cell>
                        <cell>.6</cell>
                        <cell>.6</cell>
                        <cell/>
                        <cell/>
                        <cell/>
                    </row>
                </table>
