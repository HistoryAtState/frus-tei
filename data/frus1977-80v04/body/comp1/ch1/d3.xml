    <text>
        <body>
            <div xml:id="d3">

                <pb facs="0041" n="16" xml:id="pg16"/>

                <head>3. Memorandum From Secretary of Defense Brown to President Carter<anchor n="1"
                        xml:id="d3-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1977-02-18">February 18,
                        1977</date></dateline></opener>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>FY 1978 Budget Revisions</item>
                </list>
                <p>Attached for your approval are my recommended adjustments to the FY 1978
                    Department of Defense budget request. I believe they accurately reflect the
                    conversations we have had, but they should be formalized for the record.<anchor
                        n="2" xml:id="d3-f2"/></p>
                <closer><signed><hi rendition="#bold">Harold Brown</hi></signed></closer>


                <xi:include href="d3-a1.xml" xpointer="d3-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d3-f1" n="1" type="source" xml:id="d3-f1-content">
                <p>Source: Carter Library, National Security Affairs, Brzezinski Material, Subject
                    File, Box 9, Budget: FY 1978 Defense Budget Revisions: 2/77. For Official Use
                    Only.</p>
            </note>
            <note corresp="#d3-f2" n="2" xml:id="d3-f2-content">
                <p>Carter signed his approval at the bottom of the memorandum.</p>
            </note>
        </listAnnotation>
    </standOff>
