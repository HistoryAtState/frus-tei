    <text>
        <body>
            <div xml:id="d671">

                <pb facs="0729" n="717" sameAs="frus:frus1943v05/pg717"/>

                <note rend="inline" type="source">811.20 Defense (M) Brazil/5302: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Brazil</hi> (<hi rendition="#italic">Caffery</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">Rio de
                                Janeiro</hi></placeName>, <date calendar="gregorian"
                            when="1943-10-08T23:00:00-03:00">October 8, 1943—11
                        p.m.</date><lb/>[Received October 8—10:55 p.m.]</dateline>
                </opener>
                <p>4779. Department’s 3780, October 6, midnight.<anchor n="23" xml:id="d671-f1"/> In
                    view of paramount British interest and experience in Brazilian rice, Embassy,
                    Winans, and Bland recommend that rice agreement be negotiated and signed by
                    United Kingdom with our concurrence and support. Please telegraph reply
                    urgently.</p>
                <closer><signed><hi rendition="#small-caps">Caffery</hi></signed></closer>
            </div>
        </body>
    </text>
