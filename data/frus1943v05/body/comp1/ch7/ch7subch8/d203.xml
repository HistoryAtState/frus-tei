    <text>
        <body>
            <div xml:id="d203">

                <pb facs="0215" n="203" sameAs="frus:frus1943v05/pg203"/>

                <note rend="inline" type="source">103.917/5085: Airgram</note>
                <head><hi rendition="#italic">The Ambassador in the Dominican Republic</hi> (<hi
                        rendition="#italic">Warren</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">Ciudad
                                Trujillo</hi></placeName>, <date calendar="gregorian"
                            when="1943-11-25T08:00:00-05:00">November 25, 1943—8
                        a.m.</date><lb/>[Received November 26—5 p.m.]</dateline>
                </opener>
                <p>A–611. For Foreign Economic Administration.<anchor n="83" xml:id="d203-f1"/> As
                    requested by Department’s circular airgram of November 13, 1943<anchor n="84"
                        xml:id="d203-f2"/> the Embassy <pb facs="0216" n="204" xml:id="pg204"/>
                    reports that the additional simplifications of export controls referred to in
                    the above airgram have been communicated to the Dominican Import-Export Control
                    Committee and that the Committee has expressed its acceptance of and complete
                    agreement with such proposals.</p>
                <p>In accordance with the Department’s instructions, the revised procedure will
                    become effective in the Dominican Republic on January 1, 1944.</p>
                <closer><signed><hi rendition="#small-caps">Warren</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d203-f1" n="83" xml:id="d203-f1-content">
                <p>The Office of Economic Warfare, formerly the Board of Economic Warfare, was
                    consolidated into the Foreign Economic Administration, September 25, 1943.</p>
            </note>
            <note corresp="#d203-f2" n="84" xml:id="d203-f2-content">
                <p><hi rendition="#italic">Ante</hi>, <ref target="#pg131">p. 131</ref>.</p>
            </note>
