                <pb facs="0304" n="292" sameAs="frus:frus1943v05/pg292"/>

                <note rend="inline" type="source">831.24/604: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Venezuela</hi> (<hi
                        rendition="#italic">Corrigan</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Caracas</hi></placeName>, <date calendar="gregorian"
                            when="1943-03-13T10:00:00-04:30">March 13, 1943—10
                        a.m.</date><lb/>[Received March 13—1:48 a.m.]</dateline>
                </opener>
                <p>273. Embassy’s 263, March 11, 11 a.m.<anchor n="10" xml:id="d284-f1"/> Cabinet
                    yesterday confirmed April 1, for application Decentralization Plan.</p>
                <closer><signed><hi rendition="#small-caps">Corrigan</hi></signed></closer>
            </div>
        </body>
    </text>
