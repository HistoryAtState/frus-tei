                <pb facs="0077" n="65" sameAs="frus:frus1943v05/pg65"/>

                <note rend="inline" type="source">033.1110 Wallace, Henry A./186b: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Ambassador in Chile</hi>
                        (<hi rendition="#italic">Bowers</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1943-04-01T20:00:00-04:00">April 1, 1943—8 p.m.</date></dateline>
                </opener>
                <p>380. Following for Vice President Wallace. “Many thanks for your wires. We are
                    all happy in the great success of your trip. I wish I were with you. F.D.R.”</p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
