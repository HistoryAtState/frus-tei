                <pb facs="0822" n="810" sameAs="frus:frus1943v05/pg810"/>

                <note rend="inline" type="source">740.0011 European War 1939/29434: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Chile</hi> (<hi rendition="#italic"
                        >Bowers</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Santiago</hi></placeName>, <date calendar="gregorian"
                            when="1943-05-18T22:00:00-04:00">May 18, 1943—10
                        p.m.</date><lb/>[Received 11 p.m.]</dateline>
                </opener>
                <p>916. The Foreign Minister has just informed me that the Chilean Government is
                    immediately issuing a decree severing diplomatic relations with Bulgaria,
                    Rumania, Hungary and Vichy France.</p>
                <closer><signed><hi rendition="#small-caps">Bowers</hi></signed></closer>
            </div>
        </body>
