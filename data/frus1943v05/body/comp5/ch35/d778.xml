    <text>
        <body>
            <div xml:id="d778">

                <pb facs="0829" n="817" sameAs="frus:frus1943v05/pg817"/>

                <note rend="inline" type="source">825.796/141</note>
                <head><hi rendition="#italic">Memorandum by the Chief of the Division of the
                        American Republics</hi> (<hi rendition="#italic"
                            >Bonsal</hi>) <hi rendition="#italic">to the Acting Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1943-03-04">March 4, 1943</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Mr. Berle</hi>: No further action on the four
                    Lockheed Lodestars for the Chilean Air Line<anchor n="50" xml:id="d778-f1"/> is
                    indicated at this time, since the Munitions Assignments Board on March 3, 1943
                    approved schedule of delivery for April, May, October, and November, 1943.</p>
                <closer><signed><hi rendition="#small-caps">Philip W. Bonsal</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d778-f1" n="50" xml:id="d778-f1-content">
                <p>See airgram No. A–42, January 9, from the Ambassador in Chile, <ref
                        target="#pg811">p. 811</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
