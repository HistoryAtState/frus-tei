    <text>
        <body>
            <div xml:id="d1076">

                <pb facs="1123" n="1113" sameAs="frus:frus1949v09/pg1113"/>

                <note rend="inline" type="source">893.801/6–2849: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister-Counselor of Embassy in China</hi>
                        (<hi rendition="#italic">Clark</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Canton</hi></placeName>, <date
                            calendar="gregorian" when="1949-06-28T17:00:00+08:00">June 28, 1949—5 p.
                            m.</date>
                        <lb/> [Received June 29—8:15 a. m.]</dateline>
                </opener>
                <p>Cantel 661. Note regarding blockade (telCan 384, June 24, repeated Nanking 746,
                    Shanghai 1291, Taipei 152) delivered Foreign Office at 5 o’clock today June 28,
                    altered to show correct number of Chinese note as 5138.</p>
                <p>Repeated Nanking 441, Shanghai 377, Taipei 50.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Clark</hi>
                    </signed>
                </closer>
            </div>
        </body>
