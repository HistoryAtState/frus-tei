    <text>
        <body>
            <div xml:id="d1126">

                <pb facs="1154" n="1144" sameAs="frus:frus1949v09/pg1144"/>

                <note rend="inline" type="source">393.115/10–749: Telegram</note>
                <head>
                    <hi rendition="#italic">The Consul General at Shanghai</hi> (<hi rendition="#italic">McConaughy</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Shanghai</hi></placeName>, <date
                            calendar="gregorian" when="1949-10-07">October 7,
                        1949</date>.<lb/>[Received October 7—4:11 a. m.]</dateline>
                </opener>
                <p>4211. Message from <hi rendition="#italic">Flying Independent</hi> dated October
                    7 at 1115 hours local time stated vessel proceeding Fusan<anchor n="79"
                        xml:id="d1126-f1"/> with official permission. Departure was cordial. ETA
                    Fusan October 9 at 0500 hours. No advice from <hi rendition="#italic">Flying
                        Clipper</hi>.</p>
                <p>Sent Department 4211, repeated OffEmb Canton 1149, Hong Kong 299, Taipei 342.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">McConaughy</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1126-f1" n="79" xml:id="d1126-f1-content">
                <p>Pusan, Korea.</p>
            </note>
        </listAnnotation>
    </standOff>
