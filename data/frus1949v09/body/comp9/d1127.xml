    <text>
        <body>
            <div xml:id="d1127">

                <pb facs="1154" n="1144" sameAs="frus:frus1949v09/pg1144"/>

                <note rend="inline" type="source">393.115/10–749: Telegram</note>
                <head>
                    <hi rendition="#italic">The Consul General at Shanghai</hi> (<hi
                        rendition="#italic">McConaughy</hi>) <hi rendition="#italic">to the
                        Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Shanghai</hi></placeName>, <date
                            calendar="gregorian" when="1949-10-07">October 7,
                        1949</date>.<lb/>[Received October 7—4:41 a. m.]</dateline>
                </opener>
                <p>4217. Message from SS <hi rendition="#italic">Flying Clipper</hi> to Pattison,
                    Shanghai agents Isbrandtsen Company, stated ship released October 7 at 1200
                    hours local time and was bound for Hong Kong.</p>
                <p>Sent Department 4217, repeated Canton 1150, Hong Kong 302, Taipei 343, CNO.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">McConaughy</hi>
                    </signed>
                </closer>
            </div>
        </body>
