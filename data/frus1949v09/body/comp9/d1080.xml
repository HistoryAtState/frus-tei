    <text>
        <body>
            <div xml:id="d1080">

                <pb facs="1125" n="1115" sameAs="frus:frus1949v09/pg1115"/>

                <note rend="inline" type="source">893.801/6–3049: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic"
                        >Bruce</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1949-06-30T15:00:00+01:00">June 30, 1949—3 p.
                            m.</date>
                        <lb/> [Received June 30—12:35 p. m.]</dateline>
                </opener>
                <p>2720. Foreign Office informs us that reply is being sent to Chinese Government’s
                    note re closing certain Chinese ports and is similar US note in rejection
                    legality closure.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bruce</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
