    <text>
        <body>
            <div xml:id="d1136">

                <pb facs="1159" n="1149" sameAs="frus:frus1949v09/pg1149"/>

                <note rend="inline" type="source">393.115/10–1549: Telegram</note>
                <head>
                    <hi rendition="#italic">The Consul General at Shanghai</hi> (<hi rendition="#italic">McConaughy</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Shanghai</hi></placeName>, <date
                            ana="#date_apparent-typo-based-on-sibling-dates" calendar="gregorian"
                            when="1949-10-15">October 15, 1949</date>. <lb/> [Received October
                        15—6:51 p. m.]</dateline>
                </opener>
                <p>Unnumbered. Following message received from master SS <hi rendition="#italic"
                        >Flying Trader</hi> 2220 hours October 15 local time to A. P. Pattison and
                    Company, Shanghai agents, Isbrandtsen:</p>
                <quote rend="blockquote">
                    <p>“Fired at and stopped by Chinese warship on Kiutoan Spit buoy. Now anchored
                        awaiting further orders.”</p>
                </quote>
                <p>Sent Department; repeated Chungking, Hong Kong, Taipei.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">McConaughy</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
