            </note>
            <note corresp="#d1079-f2" n="33" xml:id="d1079-f2-content">
                <p>Peter W. S. Y. Scarlett, Head of the Far Eastern Department of the British
                    Foreign Office.</p>
            </note>
        </listAnnotation>
    </standOff>
