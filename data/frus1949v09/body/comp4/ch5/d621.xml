    <text>
        <body>
            <div xml:id="d621">

                <pb facs="0645" n="635" xml:id="pg635"/>

                <note rend="inline" type="source">893.50 Recovery/3–3149: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister-Counselor of Embassy in China</hi>
                        (<hi rendition="#italic">Clark</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Canton</hi></placeName>, <date
                            calendar="gregorian" when="1949-03-31T17:00:00+08:00">March 31, 1949—5
                            p. m.</date>
                        <lb/> [Received March 31—8:05 a. m.]</dateline>
                </opener>
                <p>Cantel 180. Notes on unencumbered balance special account exchanged.<anchor
                        n="96" xml:id="d621-f1"/> Documents being pouched.<anchor n="97"
                        xml:id="d621-f2"/> [Re] Department’s telCan 71, March 29.</p>
                <p>Sent Department Cantel 180, repeated Nanking 166, Shanghai 121 for ECA
                    Griffin.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Clark</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d621-f1" n="96" xml:id="d621-f1-content">
