    <text>
        <body>
            <div xml:id="d620">

                <pb facs="0644" n="634" sameAs="frus:frus1949v09/pg634"/>

                <note rend="inline" type="source">893.50 Recovery/3–2249: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister-Counselor of
                        Embassy in China</hi> (<hi rendition="#italic">Clark</hi>), <hi
                        rendition="#italic">at Canton</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1949-03-29T19:00:00-05:00">March 29, 1949—7
                            p. m.</date>
                    </dateline>
                </opener>
                <p>TelCan 71. Language proposed note satisfactory Cantel 160 Mar 22. Essential this
                    be exchanged FonOff prior April 3.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
