            <div xml:id="d682">

                <pb facs="0737" n="727" sameAs="frus:frus1949v09/pg727"/>

                <note rend="inline" type="source">893.24/10–1349</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Dr.
                            Kan Chieh-hou, Personal Representative of
                        the Acting President of China</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1949-11-02">November 2,
                        1949</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Dr. Kan</hi>: I am grateful for the frank
                    expression of your views respecting the present situation in China contained in
                    your letters of October 13 and October 23, 1949. I assure you again that your
                    views and those of your Government are most welcome and that they will be given
                    the most careful consideration.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Dean Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
