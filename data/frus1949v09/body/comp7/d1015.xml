    <text>
        <body>
            <div xml:id="d1015">

                <pb facs="1067" n="1057" sameAs="frus:frus1949v09/pg1057"/>

                <note rend="inline" type="source">661.9331/6–2249: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister-Counselor of Embassy in China</hi>
                        (<hi rendition="#italic">Clark</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Canton</hi></placeName>, <date
                            calendar="gregorian" when="1949-06-22T11:00:00+08:00">June 22, 1949—11
                            a. m.</date>
                        <lb/> [Received June 22—6:21 a. m.]</dateline>
                </opener>
                <p>Cantel 630. Inquiry FonOff reveals Sino-Soviet trade discussions remain
                    standstill, Cantel 219, April 15; repeated Nanking 193, Shanghai 141.</p>
                <p>Sent Department, repeated Nanking 421, Shanghai 361.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Clark</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
