    <text>
        <body>
            <div xml:id="d990">

                <pb facs="1049" n="1039" xml:id="pg1039"/>

                <note rend="inline" type="source">761.932/2–849: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in China</hi> (<hi
                            rendition="#italic">Stuart</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Nanking</hi></placeName>, <date
                            calendar="gregorian" when="1949-02-08T10:00:00+08:00">February 8,
                            1949—10 a. m.</date>
                        <lb/> [Received February 9—12:29 a. m.]</dateline>
                </opener>
                <p>338. [To Consul at Tihwa:<anchor n="8" xml:id="d990-f1"/>] Please keep Embassy
                    and Department promptly informed visit of Chang Chih-chung your area, including
                    anticipated “exploratory talks” or actual negotiations with Soviet
                    representatives on commercial treaty between Sinkiang and USSR. (ReEmbtel 283 to
                    Department February 1, repeated Consulate General Canton 16 and Tihwa 11.)</p>
                <p>Sent Tihwa 12; repeated Chungking 7, Department 338, Office Embassy Canton
                    24.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stuart</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d990-f1" n="8" xml:id="d990-f1-content">
                <p>J. Hall Paxton.</p>
            </note>
