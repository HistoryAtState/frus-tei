    <text>
        <body>
            <div xml:id="d970">

                <pb facs="1031" n="1021" sameAs="frus:frus1949v09/pg1021"/>

                <note rend="inline" type="source">893.6363/8–249: Telegram</note>
                <head>
                    <hi rendition="#italic">The Consul at Tsingtao</hi> (<hi
                            rendition="#italic">Hawthorne</hi>) <hi rendition="#italic"
                        >to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Tsingtao</hi></placeName>, <date
                            calendar="gregorian" when="1949-08-02T10:00:00+08:00">August 2, 1949—10
                            a. m.</date>
                        <lb/> [Received August 5–12:49 p. m.]</dateline>
                </opener>
                <p>399. Caltex Tsingtao shipping 200,000 gallons avigas Peiping account Communists.
                    Unknown whether for commercial or military use. Department pass Nanking at its
                    discretion.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hawthorne</hi>
                    </signed>
                </closer>
            </div>
        </body>
