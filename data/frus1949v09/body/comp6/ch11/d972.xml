                <pb facs="1031" n="1021" sameAs="frus:frus1949v09/pg1021"/>

                <note rend="inline" type="source">893.6363/8–249: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Consul at Tsingtao</hi>
                        (<hi rendition="#italic">Hawthorne</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1949-08-17T18:00:00-04:00">August 17, 1949—6
                            p. m.</date>
                    </dateline>
                </opener>
                <p>241. Request info source Avigas shipped Peiping account Communist urtel 399
                    August 2. Caltex office here reports company’s Tsingtao Avigas stocks under 100
                    bbls.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
