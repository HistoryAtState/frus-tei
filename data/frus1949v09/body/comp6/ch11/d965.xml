    <text>
        <body>
            <div xml:id="d965">

                <pb facs="1028" n="1018" sameAs="frus:frus1949v09/pg1018"/>

                <note rend="inline" type="source">893.248/6–2849: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Consul General at
                        Taipei</hi> (<hi rendition="#italic">Krentz</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1949-06-28T17:00:00-04:00">June 28, 1949—5 p.
                            m.</date>
                    </dateline>
                </opener>
                <p>155. Nat Govt querying market substantial quantities avgas for delivery Taiwan.
                    Dept desires your best estimate mil stocks avgas on island and current rate
                        CAF<anchor n="43" xml:id="d965-f1"/> consumption.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d965-f1" n="43" xml:id="d965-f1-content">
                <p>Chinese Air Force.</p>
            </note>
        </listAnnotation>
    </standOff>
