                    </row>
                    <row>
                        <cell rend="padding-left: 3em">Glycerine</cell>
                        <cell rendition="#hanging-indent">unknown</cell>
                        <cell role="num">45,707</cell>
                    </row>
                    <row>
                        <cell rend="padding-left: 3em">Lubricating oils</cell>
                        <cell rendition="#hanging-indent">335,900 Am. galls.</cell>
                        <cell role="num">537,538</cell>
                    </row>
                    <row>
                        <cell/>
