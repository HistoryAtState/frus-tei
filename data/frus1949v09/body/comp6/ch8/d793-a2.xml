                        <cell role="num">219,000</cell>
                    </row>
                    <row>
                        <cell rend="padding-left: 3em">Auto parts</cell>
                        <cell rendition="#hanging-indent">26 cases</cell>
                        <cell rendition="#border-bottom" role="num">50,000</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell/>
