            <div xml:id="d791">

                <pb facs="0844" n="834" sameAs="frus:frus1949v09/pg834"/>

                <note rend="inline" type="source">611.9331/3–349</note>
                <head>
                    <hi rendition="#italic">Memorandum by the Executive Secretary of the National
                        Security Council</hi> (<hi rendition="#italic">Souers</hi>) <hi
                        rendition="#italic">to the Council </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1949-03-03">March 3, 1949</date>.</dateline>
                </opener>
                <p rendition="#flush">Subject: United States Policy Regarding Trade With China</p>
                <p rendition="#flush">Reference: NSC 41</p>
                <p>The President has this date approved the Conclusions contained in the reference
                    report, and directs that they be implemented by all appropriate Executive
                    Departments and Agencies of the United States Government under the coordination
                    of the Secretary of State.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Sidney</hi> W. <hi rendition="#small-caps"
                            >Souers</hi>
                    </signed>
                </closer>
            </div>
        </body>
