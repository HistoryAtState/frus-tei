            <div xml:id="d874">

                <pb facs="0944" n="934" sameAs="frus:frus1949v09/pg934"/>

                <note rend="inline" type="source">611.9331/4–549: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Consul General at
                        Shanghai</hi> (<hi rendition="#italic">Cabot</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1949-04-28T10:00:00-04:00">April 28, 1949—10
                            a. m.</date>
                    </dateline>
                </opener>
                <p>779. Request ConGen’s views re feasibility action suggested Con-Gentel 1084,
                    April 5, in light Tientsin’s 231, Apr 11 rptd Shanghai 152.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
