            </note>
            <note corresp="#d228-f2" n="59" xml:id="d228-f2-content">
                <p>Augustin G. Gabriel, Head of the Philippine National Investigation and
                    Coordinating Agency (NICA).</p>
            </note>
        </listAnnotation>
