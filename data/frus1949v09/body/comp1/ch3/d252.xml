                <pb facs="0237" n="227" sameAs="frus:frus1949v09/pg227"/>

                <note rend="inline" type="source">893.01/12–1749: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in Burma</hi> (<hi rendition="#italic"
                        >Day</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Rangoon</hi></placeName>, <date
                            calendar="gregorian" when="1949-12-17T19:00:00+06:30">December 17,
                            1949—7 p. m.</date>
                        <lb/> [Received December 17—10:49 a. m.]</dateline>
                </opener>
                <p>550. Deputy Secretary Foreign Office has confirmed the Burma Government has
                    extended recognition Communist China as reportedly revealed by Foreign Minister
                    to press in Calcutta.</p>
                <p>Sent Department 550, repeated New Delhi 62.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Day</hi>
                    </signed>
                </closer>
            </div>
