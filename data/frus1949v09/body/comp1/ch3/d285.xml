            <div xml:id="d285">

                <pb facs="0265" n="255" sameAs="frus:frus1949v09/pg255"/>

                <note rend="inline" type="source">893.01/12–2949: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Ceylon</hi> (<hi
                            rendition="#italic">Satterthwaite</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Colombo</hi></placeName>, <date
                            calendar="gregorian" when="1949-12-29T16:00:00+05:30">December 29,
                            1949—4 p. m.</date>
                        <lb/> [Received December 29—9:32 a. m.]</dateline>
                </opener>
                <p>288. Permanent Secretary External Affairs informs me Ceylon expects follow UK
                    lead in recognizing Communist regime in China. He expects his action be
                    completed before Commonwealth Foreign Ministers convene on January 9.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Satterthwaite</hi>
                    </signed>
                </closer>
            </div>
