    <text>
        <body>
            <div xml:id="d244">

                <pb facs="0232" n="222" sameAs="frus:frus1949v09/pg222"/>

                <note rend="inline" type="source">893.01/12–1249: Telegram</note>
                <opener>
                    <seg rendition="#center">[Extract]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">The Ambassador in Italy</hi> (<hi rendition="#italic"
                        >Dunn</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Rome</hi></placeName>, <date
                            calendar="gregorian" when="1949-12-12T18:00:00+01:00">December 12,
                            1949—6 p. m.</date>
                        <lb/> [Received December 12—2:39 p. m.]</dateline>
                </opener>
                <p>4056. ReEmbtel 4041, December 10. Italian Government reply December 7 to British
                        <hi rendition="#italic">pro memoria</hi> agrees with British evaluation of
                    present political and military situation in China …</p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Dunn</hi>
                    </signed>
                </closer>
            </div>
        </body>
