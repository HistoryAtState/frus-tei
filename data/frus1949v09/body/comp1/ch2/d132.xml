                <p>October 10, anniversary of the Chinese revolution of 1911.</p>
            </note>
            <note corresp="#d132-f3" n="12" xml:id="d132-f3-content">
                <p>Felino Neri, Philippine Under Secretary for Foreign Affairs.</p>
            </note>
        </listAnnotation>
