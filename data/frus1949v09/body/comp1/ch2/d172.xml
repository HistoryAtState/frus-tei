    <text>
        <body>
            <div xml:id="d172">

                <pb facs="0159" n="149" sameAs="frus:frus1949v09/pg149"/>

                <note rend="inline" type="source">865.00B/10–2949: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Italy</hi> (<hi rendition="#italic"
                        >Dunn</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Rome</hi></placeName>, <date
                            calendar="gregorian" when="1949-10-29T18:00:00+01:00">October 29, 1949—6
                            p. m.</date>
                        <lb/> [Received 9:16 p. m.]</dateline>
                </opener>
                <p>3460. Information contained Deptel 2617, October 22,<anchor n="55"
                        xml:id="d172-f1"/> transmitted Director General, Political Affairs, Foreign
                    Office, who states Italian position similar to ours and that US would be
                    consulted by Italy prior to any decision on part of Italian Government re
                    recognition Communist regime.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Dunn</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d172-f1" n="55" xml:id="d172-f1-content">
                <p>Not printed; it reported in regard to the Chinese Communist bid for recognition
                    and the Department’s position (893.01/10–1949).</p>
            </note>
        </listAnnotation>
    </standOff>
