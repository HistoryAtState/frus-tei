    <text>
        <body>
            <div xml:id="d115">

                <pb facs="0114" n="104" sameAs="frus:frus1949v09/pg104"/>

                <note rend="inline" type="source">893.01/10–649: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Yugoslavia</hi> (<hi
                        rendition="#italic">Cannon</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>Belgrade</placeName>, <date calendar="gregorian"
                            when="1949-10-06">October 6, 1949</date>.<lb/>[Received October 7—12:36
                        a. m.]</dateline>
                </opener>
                <p>1036. Today’s <hi rendition="#italic">Borba</hi><anchor n="88" xml:id="d115-f1"/>
                    announces FPRY<anchor n="89" xml:id="d115-f2"/> recognition yesterday of Central
                    Government of the People’s Republic of China.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Cannon</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d115-f1" n="88" xml:id="d115-f1-content">
                <p>Yugoslav Communist newspaper.</p>
            </note>
            <note corresp="#d115-f2" n="89" xml:id="d115-f2-content">
                <p>Federated People’s Republic of Yugoslavia.</p>
            </note>
        </listAnnotation>
