    <text>
        <body>
            <div xml:id="d15">

                <pb facs="0028" n="18" xml:id="pg18"/>

                <note rend="inline" type="source">893.01/5–949: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the Netherlands</hi> (<hi
                        rendition="#italic">Baruch</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">The Hague</hi></placeName>, <date
                            calendar="gregorian" when="1949-05-09T15:00:00+01:00">May 9, 1949—3 p.
                            m.</date>
                        <lb/> [Received May 9—2:55 p. m.]</dateline>
                </opener>
                <p>390. Discussed Foreign Minister Depcirtel May 8 [<hi rendition="#italic">6</hi>],
                    5 p. m. anent China and on both points 1 and 2, he expressed entire cooperation
                    and agreement.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Baruch</hi>
                    </signed>
                </closer>
            </div>
        </body>
