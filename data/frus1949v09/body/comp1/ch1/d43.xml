            <div xml:id="d43">

                <pb facs="0045" n="35" sameAs="frus:frus1949v09/pg35"/>

                <note rend="inline" type="source">893.01/6–849: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in Australia</hi> (<hi
                            rendition="#italic">Foster</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Canberra</hi></placeName>, <date
                            calendar="gregorian" when="1949-06-08T15:00:00+10:00">June 8, 1949—3 p.
                            m.</date>
                        <lb/> [Received June 8—6:06 a. m.]</dateline>
                </opener>
                <p>114. Would appreciate reply Embtel 111, June 1, especially since External Affairs
                    might interpret my silence as indication US reconsidering policy nonrecognition
                    Communist regime China.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Foster</hi>
                    </signed>
                </closer>
            </div>
        </body>
