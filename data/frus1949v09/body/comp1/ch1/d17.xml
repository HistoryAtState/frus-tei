    <text>
        <body>
            <div xml:id="d17">

                <pb facs="0029" n="19" xml:id="pg19"/>

                <note rend="inline" type="source">893.01/5–1049: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in France</hi> (<hi
                            rendition="#italic">Caffery</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1949-05-10T13:00:00+01:00">May 10, 1949—1 p.
                            m.</date>
                        <lb/> [Received 5:07 p. m.]</dateline>
                </opener>
                <p>1887. Schuman<anchor n="36" xml:id="d17-f1"/> told me last night that he agrees
                    with Department’s position with regard to recognizing Chinese Communist
                    Government as set forth in Deptcirtel May 6, 3 a. m. [<hi rendition="#italic">5
                        p. m</hi>.].</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Caffery</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d17-f1" n="36" xml:id="d17-f1-content">
                <p>Robert Schuman, French Minister for Foreign Affairs.</p>
            </note>
        </listAnnotation>
    </standOff>
