    <text>
        <body>
            <div xml:id="d56">

                <pb facs="0056" n="46" sameAs="frus:frus1949v09/pg46"/>

                <note rend="inline" type="source">893.01/6–2649: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in China</hi> (<hi
                            rendition="#italic">Stuart</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Nanking</hi></placeName>, <date
                            calendar="gregorian" when="1949-06-26T21:00:00+08:00">June 26, 1949—9 p.
                            m.</date>
                        <lb/> [Received June 26—2 p. m.]</dateline>
                </opener>
                <p>1379. Substance Deptel 711, June 17,<anchor n="93" xml:id="d56-f1"/> communicated
                    to Burmese Ambassador here. Confidential message from him to Foreign Minister,
                    Rangoon, despatched directly American Embassy there.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stuart</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d56-f1" n="93" xml:id="d56-f1-content">
                <p>Not printed; it requested inclusion of the Burmese Ambassador in consultations on
                    common-front policy (893.01/6–1749).</p>
            </note>
        </listAnnotation>
    </standOff>
