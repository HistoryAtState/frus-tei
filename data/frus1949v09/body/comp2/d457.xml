    <text>
        <body>
            <div xml:id="d457">

                <pb facs="0436" n="426" sameAs="frus:frus1949v09/pg426"/>

                <note rend="inline" type="source">102.21/11–1349: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Consul General at Taipei</hi> (<hi
                            rendition="#italic">Macdonald</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1949-11-14T20:00:00-05:00">November 14,
                            1949—8 p. m.</date>
                    </dateline>
                </opener>
                <p>457. Re Army tel cite C 53512, Nov 13,<anchor n="48" xml:id="d457-f1"/> passed to
                    Taipei by Dept. Understand Dept Army sending interim message to SCAP advising
                    that trip be postponed pending further consideration Washington. Will keep you
                    advised.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Webb</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d457-f1" n="48" xml:id="d457-f1-content">
                <p>Not printed; it requested diplomatic clearance for a staff team from Far East Air
                    Force to visit Taipei (811.2394A/11–1349).</p>
            </note>
        </listAnnotation>
    </standOff>
