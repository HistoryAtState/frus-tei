    <text>
        <body>
            <div xml:id="d323">

                <pb facs="0306" n="296" sameAs="frus:frus1949v09/pg296"/>

                <note rend="inline" type="source">Executive Secretariat Files</note>
                <head>
                    <hi rendition="#italic">Memorandum by the Executive Secretary of the National
                        Security Council</hi> (<hi rendition="#italic">Souers</hi>) <hi
                        rendition="#italic">to the Council </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1949-03-03">March 3, 1949</date>.</dateline>
                </opener>
                <p rendition="#flush">Subject: Supplementary Measures With Respect to Formosa</p>
                <p rendition="#flush">Reference: NSC 37/5<anchor n="94" xml:id="d323-f1"/>
                </p>
                <p>The President has this date approved the Conclusions contained in the reference
                    report, and directs that they be implemented by all appropriate <pb facs="0307"
                        n="297" xml:id="pg297"/> Executive Departments and Agencies of the United
                    States Government under the coordination of the Secretary of State.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Sidney</hi> W. <hi rendition="#small-caps"
                            >Souers</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
