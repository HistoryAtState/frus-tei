            <div xml:id="d416">

                <pb facs="0389" n="379" sameAs="frus:frus1949v09/pg379"/>

                <note rend="inline" type="source">893.50 Recovery/8–2949: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Consul General at
                        Taipei</hi> (<hi rendition="#italic">Taipei</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1949-08-29T19:00:00-04:00">August 29, 1949—7
                            p. m.</date>
                    </dateline>
                </opener>
                <p>269. Dept unno instr Aug 9.<anchor n="4" xml:id="d416-f1"/> For your info, JCS
                    views previously expressed in memo Feb 10 to NSC have been reaffirmed and
                    clarified in JCS memo to NSC contained in NSC 37/7 Aug 22. Copy this document
                    being forwarded soonest.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
