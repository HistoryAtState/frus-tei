    <text>
        <body>
            <div xml:id="d299">

                <pb facs="0285" n="275" sameAs="frus:frus1949v09/pg275"/>

                <note rend="inline" type="source">893.00/1–2149: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in China</hi>
                        (<hi rendition="#italic">Stuart</hi>)<anchor n="33" xml:id="d299-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1949-01-22T15:00:00-05:00">January 22, 1949—3
                            p. m.</date>
                    </dateline>
                </opener>
                <p>84. Dept would appreciate your obtaining from JUSMAG<anchor n="34"
                        xml:id="d299-f2"/> (your 183 Jan 21<anchor n="35" xml:id="d299-f3"/>) more
                    detailed info, re disposition US milit equipment landed Formosa.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d299-f1" n="33" type="source" xml:id="d299-f1-content">
                <p>Repeated to the Consul General at Taipei as No. 5.</p>
            </note>
            <note corresp="#d299-f2" n="34" xml:id="d299-f2-content">
                <p>Joint U.S. Military Advisory Group.</p>
            </note>
            <note corresp="#d299-f3" n="35" xml:id="d299-f3-content">
                <p>
                    <ref target="frus1949v08#ch1">Vol. <hi rendition="#small-caps">viii</hi>,
                        “Political and military situation in China”, chapter I</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
