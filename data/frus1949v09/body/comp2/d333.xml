    <text>
        <body>
            <div xml:id="d333">

                <pb facs="0311" n="301" sameAs="frus:frus1949v09/pg301"/>

                <note rend="inline" type="source">894A.01/3–2349: Telegram</note>
                <head>
                    <hi rendition="#italic">The Consul General at Shanghai</hi> (<hi
                        rendition="#italic">Cabot</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Shanghai</hi></placeName>, <date
                            calendar="gregorian" when="1949-03-23T17:00:00+08:00">March 23, 1949—5
                            p. m.</date>
                        <lb/> [Received March 23—5:43 a. m.]</dateline>
                </opener>
                <p>981. Mayor Wu<anchor n="3" xml:id="d333-f1"/> has again urged on me in long
                    conversation American aid to bolster up last ditch Nationalist stand on
                    Taiwan.</p>
                <p>Sent Department, repeated Nanking 577.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Cabot</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d333-f1" n="3" xml:id="d333-f1-content">
                <p>K. C. Wu, Mayor of Shanghai.</p>
            </note>
        </listAnnotation>
    </standOff>
