    <text>
        <body>
            <div xml:id="d300">

                <pb facs="0285" n="275" sameAs="frus:frus1949v09/pg275"/>

                <note rend="inline" type="source">893.00/1–2549: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in China</hi> (<hi rendition="#italic"
                        >Stuart</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Nanking</hi></placeName>, <date
                            calendar="gregorian" when="1949-01-25T12:00:00+08:00">January 25,
                            1949—noon</date>.<lb/>[Received January 25—9:51 a. m.]</dateline>
                </opener>
                <p>204. Chief<anchor n="36" xml:id="d300-f1"/> JUSMAG informs us, your 84, January
                    22, that JUSMAG loses control equipment when Chinese take physical delivery and
                    has no knowledge its subsequent disposal.</p>
                <p>Sent Department 204, repeated Taipei 13.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stuart</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d300-f1" n="36" xml:id="d300-f1-content">
                <p>Maj. Gen. David G. Barr.</p>
            </note>
        </listAnnotation>
    </standOff>
