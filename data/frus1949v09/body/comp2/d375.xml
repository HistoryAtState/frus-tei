            <div xml:id="d375">

                <pb facs="0341" n="331" sameAs="frus:frus1949v09/pg331"/>

                <note rend="inline" type="source">893.01/5–1149: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister-Counselor of Embassy in China</hi> (<hi
                        rendition="#italic">Clark</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Canton</hi></placeName>, <date
                            calendar="gregorian" when="1949-05-11T18:00:00+08:00">May 11, 1949—6 p.
                            m.</date>
                        <lb/> [Received May 12—6:19 p. m.]</dateline>
                </opener>
                <p>Cantel 358. From Merchant. Do not concur in recommendation contained Taipei’s
                    150, May 6, to Department, repeated Off Emb Canton 26.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Clark</hi>
                    </signed>
                </closer>
            </div>
        </body>
