            <div xml:id="d399">

                <pb facs="0364" n="354" sameAs="frus:frus1949v09/pg354"/>

                <note rend="inline" type="source">894A.00/6–2549: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Consul General at Shanghai</hi> (<hi rendition="#italic"
                            >Cabot</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1949-06-28T20:00:00-04:00">June 28, 1949—8 p.
                            m.</date>
                    </dateline>
                </opener>
                <p>1303. Dept appreciative suggestion urtel 2490 June 25, rptd Canton as 802, but
                    believes no useful action feasible these lines at this time.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
