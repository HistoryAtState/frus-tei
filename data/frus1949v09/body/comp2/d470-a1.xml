                                engineering spares)</cell>
                            <cell/>
                            <cell role="num">265,000</cell>
                        </row>
                        <row>
                            <cell rendition="#hanging-indent">Aircraft snare parts</cell>
                            <cell/>
                            <cell role="num">305,000</cell>
