    <text>
        <body>
            <div xml:id="d1432">

                <pb facs="1387" n="1377" sameAs="frus:frus1949v09/pg1377"/>

                <note rend="inline" type="source">026 China/7–2149</note>
                <head>
                    <hi rendition="#italic">The Secretary of Defense</hi> (<hi rendition="#italic"
                        >Johnson</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1949-07-21">21 July 1949</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I am leaving with you a
                    copy of the views of the Joint Chiefs of Staff concerning the China White Paper.
                    They were handed to me as I was leaving the office and I am giving them to you
                    in advance of a letter explaining my position. This letter will reach you later
                    in the day.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Louis Johnson</hi>
                    </signed>
                </closer>


                <xi:include href="d1432-a1.xml" xpointer="d1432-a1"/>
            </div>
        </body>
