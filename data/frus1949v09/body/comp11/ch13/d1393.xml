    <text>
        <body>
            <div xml:id="d1393">

                <pb facs="1359" n="1349" xml:id="pg1349"/>

                <note rend="inline" type="source">393.1115/9–2949: Telegram</note>
                <head>
                    <hi rendition="#italic">The Second Secretary of Embassy in China</hi> (<hi
                        rendition="#italic">Bacon</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Nanking</hi></placeName>, <date
                            calendar="gregorian" when="1949-09-29T15:00:00+08:00">September 29,
                            1949—3 p. m.</date>
                        <lb/> [Received September 29—6:23 a. m.]</dateline>
                </opener>
                <p>2192. ReDeptel 1131, September 26.<anchor n="73" xml:id="d1393-f1"/> No official
                    or nonofficial Americans Nanking district refused exit permits or deprived
                    opportunity leave on <hi rendition="#italic">Gordon</hi>.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bacon</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
