    <text>
        <body>
            <div xml:id="d1308">

                <pb facs="1281" n="1271" sameAs="frus:frus1949v09/pg1271"/>

                <note rend="inline" type="source">393.1115/7–2249: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister-Counselor of Embassy in China</hi>
                        (<hi rendition="#italic">Clark</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Canton</hi></placeName>, <date
                            calendar="gregorian" when="1949-07-22">July 22,
                        1949</date>.<lb/>[Received July 22—4:11 a. m.]</dateline>
                </opener>
                <p>Cantel 799. Foreign Office volunteers it has no objection should Americans desire
                    depart Shanghai on <hi rendition="#italic">Anchises</hi>, safe conduct for which
                    has been given.</p>
                <p>Sent Shanghai 449; repeated Department Cantel 799, Nanking 531.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Clark</hi>
                    </signed>
                </closer>
            </div>
        </body>
