    <text>
        <body>
            <div xml:id="d1397">

                <pb facs="1363" n="1353" sameAs="frus:frus1949v09/pg1353"/>

                <note rend="inline" type="source">893.00/10–2149: Telegram</note>
                <head>
                    <hi rendition="#italic">The Consul General at Hong Kong</hi> (<hi rendition="#italic">Rankin</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Hong Kong</hi></placeName>, <date
                            calendar="gregorian" when="1949-10-21">October 21,
                        1949</date>.<lb/>[Received October 21—8:17 a. m.]</dateline>
                </opener>
                <p>911. First message from British Consulate General Canton indicates all quiet and
                    no reports of American citizens in difficulties.<anchor n="75" xml:id="d1397-f1"
                    />
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Rankin</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1397-f1" n="75" xml:id="d1397-f1-content">
                <p>Chinese Government troops evacuated Canton on October 14.</p>
            </note>
        </listAnnotation>
    </standOff>
