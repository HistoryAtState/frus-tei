    <text>
        <body>
            <div xml:id="d1401">

                <pb facs="1365" n="1355" sameAs="frus:frus1949v09/pg1355"/>

                <note rend="inline" type="source">893.1115/11–149: Telegram</note>
                <head>
                    <hi rendition="#italic">The Consul General at Taipei</hi> (<hi
                        rendition="#italic">Macdonald</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Taipei</hi></placeName>, <date
                            calendar="gregorian" when="1949-11-01T11:00:00+08:00">November 1,
                            1949—11 a. m.</date>
                        <lb/> [Received November 2—12:48 a. m.]</dateline>
                </opener>
                <p>648. ReDeptel 411, October 28, 7 p. m. Recommend with Terry’s<anchor n="83"
                        xml:id="d1401-f1"/> approval that warning as worded in reference telegram be
                    issued now <pb facs="1366" n="1356" xml:id="pg1356"/> with addition of data on
                    next 60 days’ steamship sailings. Consulate General desires take no other action
                    this time.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Macdonald</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1401-f1" n="83" xml:id="d1401-f1-content">
                <p>Carroll M. Terry, First Secretary of the Embassy in the Philippines.</p>
            </note>
        </listAnnotation>
    </standOff>
