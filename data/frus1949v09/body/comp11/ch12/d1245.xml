                <pb facs="1238" n="1228" sameAs="frus:frus1949v09/pg1228"/>

                <note rend="inline" type="source">811.3393/1–2749: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Consul General at
                        Shanghai</hi> (<hi rendition="#italic">Cabot</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1949-02-07T19:00:00-05:00">February 7, 1949—7
                            p. m.</date>
                    </dateline>
                </opener>
                <p>208. Reurtel 277, Jan 27, rptd Nanking 214. Question disposition <hi
                        rendition="#italic">Bayfield</hi> foil Comm occupation Shanghai under
                    consideration by Dept which discussing matter with Navy. You will be informed
                    when final decision reached.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
