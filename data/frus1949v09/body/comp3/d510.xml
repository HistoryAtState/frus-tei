    <text>
        <body>
            <div xml:id="d510">

                <pb facs="0494" n="484" sameAs="frus:frus1949v09/pg484"/>

                <note rend="inline" type="source">Executive Secretariat Files</note>
                <head>
                    <hi rendition="#italic">Memorandum by the Executive Secretary of the National
                        Security Council</hi> (<hi rendition="#italic">Souers</hi>) <hi
                        rendition="#italic">to the Council </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1949-02-04">February 4,
                        1949</date>.</dateline>
                </opener>
                <p rendition="#flush">Subject: United States Policy Toward China</p>
                <p rendition="#flush">Reference: NSC 34/1<anchor n="36" xml:id="d510-f1"/>
                </p>
                <p>The President has this date approved the reference report and directs that it be
                    implemented by all appropriate Executive Departments <pb facs="0495" n="485"
                        xml:id="pg485"/> and Agencies of the United States Government under the
                    coordination of the Secretary of State.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Sidney</hi> W. <hi rendition="#small-caps"
                            >Souers</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
