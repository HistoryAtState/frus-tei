    <text>
        <body>
            <div xml:id="d526">

                <pb facs="0509" n="499" sameAs="frus:frus1949v09/pg499"/>

                <note rend="inline" type="source">Executive Secretariat Files</note>
                <head>
                    <hi rendition="#italic">Memorandum by the Acting Executive Secretary of the
                        National Security Council</hi> (<hi
                            rendition="#italic">Lay</hi>) <hi rendition="#italic">to the
                            Council
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1949-03-03">March 3, 1949</date>.</dateline>
                </opener>
                <p rendition="#flush">Subject: United States Policy Toward China</p>
                <p rendition="#flush">Reference: NSC 34/2<anchor n="51" xml:id="d526-f1"/>
                </p>
                <p>The President has this date approved the Recommendations contained in the
                    reference report, and directs that they be implemented by all appropriate
                    Executive Departments and Agencies of the United States Government under the
                    coordination of the Secretary of State.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">James</hi> S. <hi rendition="#small-caps">Lay,
                            Jr.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
