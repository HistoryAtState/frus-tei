    <text>
        <body>
            <div xml:id="d750">

                <pb facs="0798" n="788" sameAs="frus:frus1949v09/pg788"/>

                <note rend="inline" type="source">893.515/6–1549: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister-Counselor of Embassy in China</hi>
                        (<hi rendition="#italic">Clark</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Canton</hi></placeName>, <date
                            calendar="gregorian" when="1949-06-15T17:00:00+08:00">June 15, 1949—5 p.
                            m.</date>
                        <lb/> [Received June 15—5:51 a. m.]</dateline>
                </opener>
                <p>Cantel 593. Manager banking department Central Bank confirmed in conversation
                    today Amoy, Taiwan gold not yet obtained and Finance Minister<anchor n="4"
                        xml:id="d750-f1"/> presently in Taiwan conferring with Generalissimo for
                    release.</p>
                <p>Sent Department, repeated Nanking 396, Shanghai 338.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Clark</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d750-f1" n="4" xml:id="d750-f1-content">
                <p>Hsu Kan (since June 11).</p>
            </note>
        </listAnnotation>
    </standOff>
