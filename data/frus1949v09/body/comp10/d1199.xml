                <pb facs="1206" n="1196" sameAs="frus:frus1949v09/pg1196"/>

                <note rend="inline" type="source">811.3393/1–2549: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Consul at Tsingtao</hi> (<hi rendition="#italic"
                            >Strong</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1949-01-26T21:00:00-05:00">January 26, 1949—9
                            p. m.</date>
                    </dateline>
                </opener>
                <p>42. Dept understands (Contel 44 Jan 24[<hi rendition="#italic">25</hi>]) Navy has
                    forwarded Adm Badger material for use in connection any publicity re
                    withdrawal.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
