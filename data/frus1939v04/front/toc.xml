    <text>
        <body>
            <div xml:id="toc">

                <pb facs="0003" n="III" xml:id="pgIII"/>

                <head>Contents</head>
                <p rendition="#flush">(<hi rendition="#small-caps">Note</hi>: For previously
                    published correspondence on relations between the United States and Japan in
                    1939, see <ref target="frus:frus1931-41v01"><hi rendition="#italic">Foreign
                            Relations</hi>, Japan, 1931–1941, Volumes I</ref> and <ref
                        target="frus:frus1931-41v02">II</ref>. Documents printed in those volumes
                    have not been reprinted in the 1939 annual volumes.)</p>
                <list type="toc">
                    <item><hi rendition="#small-caps">The Far East</hi>: <list>
                            <item><hi rendition="#small-caps">Undeclared War Between Japan and
                                    China</hi> (continued from <ref target="frus:frus1939v03">Volume
                                    III</ref>): <list>
                                    <item><ref target="#pg1">American interest in Japanese demands
                                            affecting the integrity of the International Settlement
                                            at Shanghai</ref></item>
                                    <item><ref target="#pg108">American interest in Japanese demands
                                            affecting the integrity of the International Settlement
                                            of Kulangsu at Amoy</ref></item>
                                    <item><ref target="#pg163">American interest in situation
                                            created by Japanese demands on the British Concession at
                                            Tientsin</ref></item>
                                    <item><ref target="#pg262">Measures taken by the United States
                                            for the protection of American lives and property in
                                            China resulting from hostilities between Japan and
                                            China</ref></item>
                                    <item><ref target="#pg426">Problem of controlling the traffic in
                                            opium and other narcotic drugs in parts of China under
                                            Japanese military occupation</ref></item>
                                    <item><ref target="#pg438">Attitude of the United States with
                                            respect to registration of American citizens under
                                            “Manchoukuo” law</ref></item>
                                </list></item>
                            <item><ref target="#pg442"><hi rendition="#small-caps"
                                >China</hi></ref></item>
                            <item><hi rendition="#small-caps">Japan</hi>: <list>
                                    <item><ref target="#pg443">Political developments in
                                        Japan</ref></item>
                                    <item><ref target="#pg455">Transportation to Japan of the ashes
                                            of the late Japanese Ambassador Hirosi Saito on the
                                            United States cruiser <hi rendition="#italic"
                                                >Astoria</hi></ref></item>
                                    <item><ref target="#pg462">Representations by Japan regarding
                                            Philippine legislation affecting Japanese trade with the
                                            Philippines</ref></item>
                                    <item><ref target="#pg470">Representations to the Japanese
                                            Government against blocking transfer by the American
                                            President Lines of its property accruing in
                                        Japan</ref></item>
                                </list></item>
                        </list></item>
                    <item><hi rendition="#small-caps">The Near East and Africa</hi>: <list>
                            <item><hi rendition="#small-caps">Egypt</hi>: <list>
                                    <item><ref target="#pg477">Proposed consular convention between
                                            the United States and Egypt</ref></item>
                                    <item><ref target="#pg486">Preliminary discussions respecting a
                                            trade agreement between the United States and
                                            Egypt</ref></item>
                                </list></item>
                            <item><hi rendition="#small-caps">Ethiopia</hi>: <list>
                                    <item><ref target="#pg507">Repressive measures by the Italian
                                            authorities against foreign missionary activities in
                                            Ethiopia</ref></item>
                                </list></item>
                            <item><hi rendition="#small-caps">Iran</hi>: <list>
                                    <item><ref target="#pg525">Representations by the United States
                                            regarding the expropriation of American schools in
                                            Iran</ref></item>
                                    <item><ref target="#pg538">Efforts of the Iranian Government to
                                            secure a loan in the United States</ref></item>
                                    <pb facs="0004" n="IV" xml:id="pgIV"/>
                                    <item><ref target="#pg543">Assurance by Iran that foreign
                                            exchange would be provided for the payment of American
                                            creditors</ref></item>
                                </list></item>
                            <item><hi rendition="#small-caps">Iraq</hi>: <list>
                                    <item><ref target="#pg545">Representations by the United States
                                            against proposed Iraqi legislation affecting foreign
                                            schools in Iraq</ref></item>
                                </list></item>
                            <item><ref target="#pg555"><hi rendition="#small-caps">Kenya and
                                        Tanganyika</hi></ref></item>
                            <item><hi rendition="#small-caps">Liberia</hi>: <list>
                                    <item><ref target="#pg556">Interest of the United States in the
                                            defense and security of Liberia; assurances by France
                                            and the United Kingdom of aid to Liberia in case of
                                            attack</ref></item>
                                    <item><ref target="#pg614">Air navigation agreement between the
                                            United States and Liberia, signed at Monrovia, June 14,
                                            1939</ref></item>
                                    <item><ref target="#pg620">Treaty of conciliation between the
                                            United States and Liberia, signed at Monrovia, August
                                            21, 1939</ref></item>
                                    <item><ref target="#pg623">Withdrawal by the United States Steel
                                            Corporation from further investigation of mineral
                                            deposits in Liberia</ref></item>
                                </list></item>
                            <item><hi rendition="#small-caps">Morocco</hi>: <list>
                                    <item><ref target="#pg631">Proposed abolition of capitulatory
                                            rights of the United States in the French Zone of
                                            Morocco</ref></item>
                                    <item><ref target="#pg670">Negotiations regarding the settlement
                                            of American claims in the French Zone of
                                        Morocco</ref></item>
                                    <item><ref target="#pg684">Reservation of American treaty rights
                                            as affected by emergency war measures in the French Zone
                                            of Morocco</ref></item>
                                </list></item>
                            <item><hi rendition="#small-caps">Palestine</hi>: <list>
                                    <item><ref target="#pg694">Interest of the United States in
                                            British policy regarding Palestine: British discussions
                                            with Arab and Jewish representatives; British White
                                            Paper; suspension of Jewish immigration</ref></item>
                                    <item><ref target="#pg811">Representations regarding restrictive
                                            trade measures adopted by British authorities in
                                            Palestine in violation of American treaty
                                        rights</ref></item>
                                    <item><ref target="#pg816">Assurances by the Government of
                                            Palestine regarding exemption of American citizens
                                            resident in Palestine from the provisions of the Defence
                                            (Finance) Regulations requiring declaration of
                                            securities</ref></item>
                                </list></item>
                            <item><hi rendition="#small-caps">Saudi Arabia</hi>: <list>
                                    <item><ref target="#pg824">Establishment by the United States of
                                            diplomatic representation in Saudi Arabia</ref></item>
                                </list></item>
                            <item><hi rendition="#small-caps">Syria and Lebanon</hi>: <list>
                                    <item><ref target="#pg832">Cession of the Hatay (the Sanjak of
                                            Alexandretta) by France to Turkey; protection of
                                            American rights and interests</ref></item>
                                    <item><ref target="#pg847">Representations by the United States
                                            against expulsion of American nationals from Syria and
                                            Lebanon without furnishing evidence to justify
                                            action</ref></item>
                                </list></item>
                            <pb facs="0005" n="V" xml:id="pgV"/>
                            <item><hi rendition="#small-caps">Turkey</hi>: <list>
                                    <item><ref target="#pg849">Proposed agreement between the United
                                            States and Turkey regarding the status of certain
                                            naturalized American citizens natives of territory
                                            detached from Turkey by the Treaty of
                                        Lausanne</ref></item>
                                    <item><ref target="#pg861">Reciprocal trade agreement between
                                            the United States and Turkey, signed April 1,
                                        1939</ref></item>
                                    <item><ref target="#pg866">Informal representations by the
                                            United States respecting Turkish exchange regulations
                                            affecting American-Turkish trade</ref></item>
                                </list></item>
                        </list></item>
                    <item><ref target="#pg895"><hi rendition="#small-caps">Index</hi></ref></item>
                </list>
            </div>
        </body>
    </text>
