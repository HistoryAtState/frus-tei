    <text>
        <body>
            <div xml:id="d41">

                <pb facs="0051" n="45" sameAs="frus:frus1939v04/pg45"/>

                <note rend="inline" type="source">893.102S/1797: Telegram</note>
                <head><hi rendition="#italic">The Consul General at Shanghai</hi> (<hi rendition="#italic">Gauss</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Shanghai</hi></placeName>, <date calendar="gregorian"
                            when="1939-05-12T14:00:00+08:00">May 12, 1939—2
                        p.m.</date><lb/>[Received May 12—8:30 a.m.]</dateline>
                </opener>
                <p>375. For Hornbeck.<anchor n="47" xml:id="d41-f1"/> Stirling Fessenden, Secretary
                    General of the Municipal Council, has asked me to send you the following
                    message.</p>
                <quote rend="blockquote">
                    <p>“Possibility violent Japanese action against International Settlement.
                        Strongly urge if possible public statement by State Department that any such
                        act would be regarded as unfriendly to American Government.”</p>
                </quote>
                <closer><signed><hi rendition="#small-caps">Gauss</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d41-f1" n="47" xml:id="d41-f1-content">
                <p>Stanley K. Hornbeck, Adviser on Political Relations.</p>
            </note>
        </listAnnotation>
    </standOff>
