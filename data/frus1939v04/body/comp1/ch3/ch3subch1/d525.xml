                <pb facs="0449" n="443" sameAs="frus:frus1939v04/pg443"/>

                <note rend="inline" type="source">894.00/828: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Japan</hi> (<hi rendition="#italic">Grew</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Tokyo</hi></placeName>, <date calendar="gregorian"
                            when="1939-01-04T12:00:00+09:00">January 4,
                        1939—noon</date>.<lb/>[Received January 4—5:10 a.m.]</dateline>
                </opener>
                <p>4. Embassy’s 813, December 29, 7 p.m.<anchor n="2" xml:id="d525-f1"/> The entire
                    Cabinet resigned this morning.</p>
                <closer><signed><hi rendition="#small-caps">Grew</hi></signed></closer>
            </div>
        </body>
    </text>
