    <text>
        <body>
            <div xml:id="d901">

                <pb facs="0852" n="846" sameAs="frus:frus1939v04/pg846"/>

                <note rend="inline" type="source">751.67/281</note>
                <head><hi rendition="#italic">The Italian Ambassador</hi> (<hi
                            rendition="#italic">Colonna</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <p>The Italian Ambassador presents his compliments to the Honorable Secretary of
                    State and, under instructions of his Government, has the honor to bring to the
                    knowledge of the State Department that the Italian Ambassador in Paris has
                    addressed to the French Foreign Minister a note of which copy will be found
                    herewith.</p>
                <closer>
                    <dateline rendition="#float-left">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1939-07-11">July 11,
                            1939—XVII</date>.</dateline>
                </closer>
                <postscript>
                    <p>No. 6252</p>
                </postscript>


                <xi:include href="d901-a1.xml" xpointer="d901-a1"/>
