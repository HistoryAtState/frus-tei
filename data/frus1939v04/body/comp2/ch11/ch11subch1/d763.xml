            </note>
            <note corresp="#d763-f2" n="23" xml:id="d763-f2-content">
                <p>Nuri Pasha as-Said.</p>
            </note>
            <note corresp="#d763-f3" n="24" xml:id="d763-f3-content">
                <p>Fuad Bey Hamza.</p>
            </note>
            <note corresp="#d763-f4" n="25" xml:id="d763-f4-content">
                <p>Cousin of the Mufti.</p>
            </note>
            <note corresp="#d763-f5" n="25a" xml:id="d763-f5-content">
                <p>Chief of the Royal Cabinet.</p>
            </note>
            <note corresp="#d763-f6" n="26" xml:id="d763-f6-content">
                <p>Hassan Nashat Pasha.</p>
            </note>
        </listAnnotation>
