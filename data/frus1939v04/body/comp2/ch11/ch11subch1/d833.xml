                <pb facs="0783" n="777" sameAs="frus:frus1939v04/pg777"/>

                <note rend="inline" type="source">867N.01/1613a: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Consul at Geneva</hi> (<hi rendition="#italic"
                            >Everett</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1939-06-20T11:00:00-04:00">June 20, 1939—11 a.m.</date></dateline>
                </opener>
                <p>77. Please telegraph any information which you can discreetly obtain in regard to
                    the reactions of the Permanent Mandates Commission to proposed British policy in
                    Palestine.</p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
    </text>
