                <pb facs="0756" n="750" sameAs="frus:frus1939v04/pg750"/>

                <note rend="inline" type="source">867N.01/1544: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in the United Kingdom</hi> (<hi
                        rendition="#italic">Kennedy</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1939-05-11T17:00:00+01:00">May 11, 1939—5
                        p.m.</date><lb/>[Received May 11—11:45 a.m.]</dateline>
                </opener>
                <p>663. Talked to MacDonald this morning. For parliamentary purposes it would be
                    advisable to postpone Palestine statement until Wednesday instead of Monday.
                    They are sending to Lindsay the complete text of the White Paper and not just
                    the outline, with instructions to show you the whole thing.</p>
                <closer><signed><hi rendition="#small-caps">Kennedy</hi></signed></closer>
            </div>
        </body>
