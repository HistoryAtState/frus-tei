        <body>
            <div xml:id="d807-a1">

                <pb facs="0755" n="749" xml:id="pg749"/>

                <opener>
                    <seg rendition="#center">[Enclosure]</seg>
                </opener>
                <head><hi rendition="#italic">Mr. Louis D. Brandeis to President
                    Roosevelt</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1939-05-09">May 9, 1939</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Dear Mr. President</hi>: Herewith I enclose Dr.
                    Weizmann’s cable to you of the 8th.</p>
                <p>Cordially,</p>
                <closer><signed><hi rendition="#small-caps">Louis Brandeis</hi></signed></closer>
            </div>
        </body>
