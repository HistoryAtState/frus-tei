    <text>
        <body>
            <div xml:id="d592">

                <pb facs="0534" n="528" sameAs="frus:frus1939v04/pg528"/>

                <note rend="inline" type="source">391.1164/90a: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Chargé in Iran</hi> (<hi
                            rendition="#italic">Engert</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1939-08-19T14:00:00-04:00">August 19, 1939—2
                        p.m.</date></dateline>
                </opener>
                <p>37. Following from Presbyterian Board for Muller:<anchor n="2" xml:id="d592-f1"/>
                    <quote rend="blockquote">
                        <p>“We have consulted State Department and for the time being formal
                            representations on behalf of mission will be handled by Legation at
                            Tehran. Please keep in close touch with Engert and communicate with us
                            through the Legation as circumstances may require.”</p>
                    </quote></p>
                <closer><signed><hi rendition="#small-caps">Moore</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d592-f1" n="2" xml:id="d592-f1-content">
                <p>Rev. Hugo A. Muller, member of the Presbyterian Mission at Tehran.</p>
            </note>
        </listAnnotation>
    </standOff>
