                <pb facs="0682" n="676" sameAs="frus:frus1939v04/pg676"/>

                <note rend="inline" type="source">481.11/137: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Chargé in France</hi>
                        (<hi rendition="#italic">Wilson</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1939-06-15T17:00:00-04:00">June 15, 1939—5 p.m.</date></dateline>
                </opener>
                <p>433. Your 1117, June 13, 3 p.m. The Department fully approves the action proposed
                    by you.</p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
