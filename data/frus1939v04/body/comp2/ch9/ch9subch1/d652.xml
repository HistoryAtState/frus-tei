    <text>
        <body>
            <div xml:id="d652">

                <pb facs="0592" n="586" xml:id="pg586"/>

                <note rend="inline" type="source">882.20/463</note>
                <head><hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic"
                        >Bullitt</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 4429</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1939-05-30">May 30, 1939</date>.<lb/>[Received June 9.]</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to refer to my telegram
                    No. 988 of May 23, 2 p.m.,<anchor n="26" xml:id="d652-f1"/> reporting a
                    conversation I had with the Liberian Minister, and to enclose herewith a copy of
                    a despatch which the Liberian Minister in Paris addressed to the Liberian
                    Foreign Office in Monrovia under date of May 26, 1939.</p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">William C.
                    Bullitt</hi></signed></closer>


                <xi:include href="d652-a1.xml" xpointer="d652-a1"/>
            </div>
        </body>
    </text>
