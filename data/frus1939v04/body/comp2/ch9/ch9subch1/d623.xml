    <text>
        <body>
            <div xml:id="d623">

                <pb facs="0565" n="559" xml:id="pg559"/>

                <note rend="inline" type="source">882.20/432: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Minister in Liberia</hi> (<hi
                            rendition="#italic">Walton</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1939-03-16T20:00:00-05:00">March 16, 1939—8 p.m.</date></dateline>
                </opener>
                <p>6. Your 14, March 15, 3 p.m. Please forward via commercial cable in same code as
                    this message full text of the <hi rendition="#italic">aide-mémoire</hi> handed
                    you by the Secretary of State. After it has been received and studied,
                    appropriate instructions will be sent to you.</p>
                <closer><signed><hi rendition="#small-caps">Welles</hi></signed></closer>
            </div>
        </body>
    </text>
