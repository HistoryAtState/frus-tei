                <pb facs="0621" n="615" xml:id="pg615"/>

                <note rend="inline" type="source">711.8227/2: Telegram</note>
                <head><hi rendition="#italic">The Minister in Liberia</hi> (<hi rendition="#italic"
                        >Walton</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Monrovia</hi></placeName>, <date calendar="gregorian"
                            when="1939-03-31T12:00:00-00:44">March 31,
                        1939—noon</date>.<lb/>[Received March 31—11:18 a.m.]</dateline>
                </opener>
                <p>18. Department’s No. 9, March 25, 2 p.m. The Liberian Government would welcome
                    the initiation of negotiations with the United States Government for the
                    conclusion of a civil aviation agreement.</p>
                <closer><signed><hi rendition="#small-caps">Walton</hi></signed></closer>
            </div>
        </body>
