            </note>
            <note corresp="#d905-f2" n="3" xml:id="d905-f2-content">
                <p>Numan Menemencioglu, Secretary General of the Turkish Ministry for Foreign
                    Affairs.</p>
            </note>
        </listAnnotation>
    </standOff>
