    <text>
        <body>
            <div xml:id="d16">

                <pb facs="0044" n="22" xml:id="pg22"/>

                <head>16. Letter From President Kennedy to Chairman Khrushchev<anchor n="0"
                        xml:id="d16-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1961-06-10">June 10,
                    1961</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. Chairman</hi>: Many thanks for your kindness
                    in presenting me with a case of beverages during our recent meeting in
                        Vienna.<anchor n="1" xml:id="d16-f2"/> I would also like to express my
                    appreciation to the Soviet Government for the gold cigar chest, caviar and
                    records. For these courtesies I am very grateful.</p>
                <p>Sincerely,</p>
                <closer><signed><hi rendition="#bold">John F. Kennedy</hi></signed><anchor n="2"
                        xml:id="d16-f3"/></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d16-f1" n="0" type="source" xml:id="d16-f1-content">
                <p>Source: Department of State, Presidential Correspondence: Lot 66 D 204. No
                    classification marking. Another copy of this message is in the Kennedy Library,
                    National Security Files, Countries Series, USSR, Khrushchev Correspondence.</p>
            </note>
            <note corresp="#d16-f2" n="1" xml:id="d16-f2-content">
                <p>Regarding these meetings June 3-4, see <ref target="frus1961-63v05">volume
                        V</ref>.</p>
            </note>
            <note corresp="#d16-f3" n="2" xml:id="d16-f3-content">
                <p>Printed from a copy that indicates the original was signed by President
                    Kennedy.</p>
            </note>
        </listAnnotation>
