    <text>
        <body>
            <div xml:id="d13">

                <pb facs="0068" n="40" xml:id="pg40"/>

                <head>13. Memorandum From the Joint Chiefs of Staff to
                    Secretary of War Stimson and
                    Secretary of the Navy Forrestal<anchor
                        n="0" xml:id="d13-f1"/></head>
                <dateline><placeName>Washington</placeName>, <date calendar="gregorian"
                        when="1945-09-19">September 19, 1945</date>.</dateline>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>Establishment of a central intelligence service upon liquidation of OSS</item>
                </list>
                <p>The Joint Chiefs of Staff request that the Secretary of War and the Secretary of
                    the Navy forward the attached memorandum to the President.</p>
                <closer>For the Joint Chiefs of Staff:<lb/><signed><hi
                                rendition="#bold">William D. Leahy</hi></signed><lb/><hi
                        rendition="#italic">Fleet Admiral, U.S. Navy Chief of Staff to the Commander
                        in Chief of the Army and Navy</hi></closer>



                <xi:include href="d13-a1.xml" xpointer="d13-a1"/>
                <xi:include href="d13-a2.xml" xpointer="d13-a2"/>
            </div>
        </body>
    </text>
