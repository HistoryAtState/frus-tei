    <text>
        <body>
            <div xml:id="d212">

                <pb facs="0596" n="568" sameAs="frus:frus1945-50Intel/pg568"/>

                <head>212. Letter From Secretary of State Marshall to Senator Chan Gurney<anchor
                        n="0" xml:id="d212-f1"/></head>
                <dateline><placeName>Washington</placeName>, <date calendar="gregorian"
                        when="1947-05-05">May 5, 1947</date>.</dateline>
                <p><hi rendition="#small-caps">Dear Senator</hi>: This is to confirm the message I
                    asked General Carter<anchor n="1" xml:id="d212-f2"/> to pass on to you Friday
                        afternoon.<anchor n="2" xml:id="d212-f3"/></p>
                <p>The legislation regarding the CIG reflects the unchanged status of the agreement
                    reached in February by the Secretaries of War and Navy and myself.<anchor n="3"
                        xml:id="d212-f4"/></p>
                <p>Faithfully yours,<anchor n="4" xml:id="d212-f5"/></p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d212-f1" n="0" type="source" xml:id="d212-f1-content">
                <p>Source: National Archives and Records Administration, RG 59, Records of the
                    Department of State, Decimal File 1945–49, 101.5/5–547. No classification
                    marking. Drafted by Marshall. A note on the source text reads: “Delivered by
                    hand 5/6/47.”</p>
            </note>
            <note corresp="#d212-f2" n="1" xml:id="d212-f2-content">
                <p>Brigadier General Marshall Carter, Secretary Marshall’s Special Assistant.</p>
            </note>
            <note corresp="#d212-f3" n="2" xml:id="d212-f3-content">
                <p>Presumably Friday, May 2.</p>
            </note>
            <note corresp="#d212-f4" n="3" xml:id="d212-f4-content">
                <p>No documents concerning this agreement, and no other references to it, have been
                    found.</p>
            </note>
            <note corresp="#d212-f5" n="4" xml:id="d212-f5-content">
                <p>Printed from an unsigned copy.</p>
            </note>
        </listAnnotation>
    </standOff>
