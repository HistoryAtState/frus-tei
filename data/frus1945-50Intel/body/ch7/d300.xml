    <text>
        <body>
            <div xml:id="d300">

                <pb facs="0752" n="724" xml:id="pg724"/>

                <head>300. Central Intelligence Agency General Order No. 10<anchor n="0"
                        xml:id="d300-f1"/></head>
                <dateline><placeName>Washington</placeName>, <date calendar="gregorian"
                        when="1948-08-27">August 27, 1948</date>.</dateline>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>Organization</item>
                </list>
                <list>
                    <label>1.</label>
                    <item>The activation of the Office of Policy Coordination, effective 1 September
                        1948, is hereby announced.</item>
                    <label>2.</label>
                    <item>Mr. Frank G. Wisner is announced as Assistant Director for Policy
                        Coordination.</item>
                    <label>3.</label>
                    <item>Detailed directives reference the functions of the Office of Policy
                        Coordination will be the subject of separate orders.</item>
                </list>
                <closer>For the Director of Central Intelligence:<lb/><signed><hi rendition="#bold"
                            >E. K. Wright</hi></signed><lb/><hi rendition="#italic">Brigadier
                        General, USA <lb/> Deputy Director</hi></closer>
            </div>
        </body>
    </text>
