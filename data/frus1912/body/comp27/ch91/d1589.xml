    <text>
        <body>
            <div xml:id="d1589">

                <pb facs="1282" n="1166" sameAs="frus:frus1912/pg1166"/>

                <note rend="inline" type="source">File No. 819.001 P 82/4.</note>
                <head>
                    <hi rendition="#italic">The Secretary for Foreign Affairs to the Secretary of
                        State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Translation.]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 3210.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Foreign Office</hi>, <lb/>
                            <hi rendition="#italic">Panama</hi></placeName>, <date
                            calendar="gregorian" when="1912-10-14">
                            <hi rendition="#italic">October 14, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Secretary</hi>: Accompanied by the customary
                    copy, I have the honor to transmit to your excellency the autograph letter which
                    His Excellency Dr. Belisario Porras addresses to His Excellency W. H. Taft,
                    President of the United States, announcing to him that he has assumed the
                    presidency of the Republic of Panama.</p>
                <p>I beg your excellency to be kind enough to have the mentioned sealed envelope
                    reach its high destination and to accept for it my most cordial thanks.</p>
                <p>I avail [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">E. T. Lefevre.</hi>
                    </signed>
                </closer>


                <xi:include href="d1589-a1.xml" xpointer="d1589-a1"/>
            </div>
