    <text>
        <body>
            <div xml:id="d1648">

                <pb facs="1351" n="1235" sameAs="frus:frus1912/pg1235"/>

                <note rend="inline" type="source">File No. 819.74/15.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Secretary of the
                        Navy</hi>.</head>
                <opener>
                    <seg rendition="#center">[Extract]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-05-11">
                            <hi rendition="#italic">May 11, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the
                    receipt of your letter of the 22d ultimo regarding the construction of wireless
                    telegraph stations in Panama and to transmit herewith for your information copy
                    of an instruction<anchor n="1" xml:id="d1648-f1"/> to the American Minister at
                    Panama.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Huntington Wilson.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1648-f1" n="1" xml:id="d1648-f1-content">
                <p>This is the instruction of May 13 (see infra).</p>
            </note>
        </listAnnotation>
    </standOff>
