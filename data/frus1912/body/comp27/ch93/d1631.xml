            <div xml:id="d1631">

                <pb facs="1325" n="1209" sameAs="frus:frus1912/pg1209"/>

                <note rend="inline" type="source">File No. 819.74/4.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Secretary of the
                        Navy</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1911-12-26">
                            <hi rendition="#italic">December 26, 1911</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: [After referring to the Navy Department’s
                    letters of December 11 and 13, and quoting the Minister’s telegram of December
                    21, the letter continues:]</p>
                <p>The Department would be glad to have you give it some expression as to an
                    arrangement that might be made by the Navy Department to handle all wireless
                    messages to and from the Republic of Panama.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Huntington Wilson.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
