    <text>
        <body>
            <div xml:id="d1643">

                <pb facs="1337" n="1221" xml:id="pg1221"/>

                <note rend="inline" type="source">File No. 819.74/13.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the American Minister</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 43.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-04-15">
                            <hi rendition="#italic">April 15, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to past correspondence relative
                    to the establishment of wireless telegraph stations in Panama, there is enclosed
                    herewith for your information a copy of the Solicitor’s memorandum dated April
                    4, 1912, considering the subject from the point of view of the rights given to
                    the United States by treaty to erect and maintain wireless stations not only in
                    the Canal Zone, but in parts of the Isthmus itself.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Huntington Wilson.</hi>
                    </signed>
                </closer>


                <xi:include href="d1643-a1.xml" xpointer="d1643-a1"/>
            </div>
        </body>
    </text>
