            <div xml:id="d1629">

                <pb facs="1324" n="1208" sameAs="frus:frus1912/pg1208"/>

                <note rend="inline" type="source">File No. 819.74/3.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Secretary of the
                    Navy</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1911-12-20">
                            <hi rendition="#italic">December 20, 1911</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to the letter dated December 13,
                    1911, from the Acting Secretary of the Navy in which is quoted a recommendation
                    of the joint board, dated November 27, 1911, relative to the installation of
                    private and commercial wireless stations in the Republic of Panama, I have the
                    honor to inform you that a copy of the letter from your Department has been
                    referred to the American Minister at Panama, for his information and for
                    appropriate action.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">P. C. Knox.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
