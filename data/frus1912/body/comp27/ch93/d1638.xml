    <text>
        <body>
            <div xml:id="d1638">

                <pb facs="1332" n="1216" sameAs="frus:frus1912/pg1216"/>

                <note rend="inline" type="source">File No. 819.74/8.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Secretary of the
                    Navy</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-01-17">
                            <hi rendition="#italic">January 17, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to previous correspondence, I
                    have the honor to inclose herewith for your information a copy of a dispatch of
                    the 3d instant from the American Minister at Panama, reporting on the wireless
                    telegraphic systems proposed or already established on the Isthmus of
                    Panama.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">P. C. Knox.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
