    <text>
        <body>
            <div xml:id="d1640">

                <pb facs="1334" n="1218" sameAs="frus:frus1912/pg1218"/>

                <note rend="inline" type="source">File No. 819.74/10.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            American Minister</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 29.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-01-31">
                            <hi rendition="#italic">January 31, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to past correspondence on the
                    subject of wireless telegraph stations in Panama, a copy of a letter dated
                    January 23, 1912, from the Secretary of the Navy, setting forth the desires of
                    that Department with regard thereto is enclosed for your preliminary
                    information.</p>
                <p>The Department is studying carefully the proposals of the Navy Department in
                    order to determine the form which negotiations looking to the realization of the
                    Navy Department’s desires should take.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">P. C. Knox.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
