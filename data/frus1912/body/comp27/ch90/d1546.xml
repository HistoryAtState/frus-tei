    <text>
        <body>
            <div xml:id="d1546">

                <pb facs="1250" n="1134" sameAs="frus:frus1912/pg1134"/>

                <note rend="inline" type="source">File No. 819.00/357.</note>
                <head>
                    <hi rendition="#italic">The Secretary to the President to the Secretary of
                        State</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">The White House</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-01-23">
                            <hi rendition="#italic">January 23, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Secretary</hi>: For your information I send
                    you a copy of the dispatch which the President this afternoon sent to Colonel
                    Goethals.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Charles D. Hilles.</hi>
                    </signed>
                </closer>


                <xi:include href="d1546-a1.xml" xpointer="d1546-a1"/>
