    <text>
        <body>
            <div xml:id="d806-a1">

                <pb facs="0764" n="648" xml:id="pg648"/>

                <opener>
                    <seg rendition="#center">[Inclosure.—Translation.]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">The Minister for Foreign
                            Affairs to the American
                    Ambassador</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 20.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of Foreign Affairs</hi>, <lb/>
                            <hi rendition="#italic">Tokyo</hi></placeName>, <date
                            calendar="gregorian" when="1912-02-29">
                            <hi rendition="#italic">February 29, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Ambassador</hi>: Referring to our former
                    communication in regard to the Grand Exhibition of Japan which was to be held in
                    Tokyo in 1917, I beg leave to inform you that the Imperial Government have to
                    their deep regret been compelled by unavoidable circumstances to abandon that
                    project.</p>
                <p>I avail [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Viscount Y. Uchida.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
