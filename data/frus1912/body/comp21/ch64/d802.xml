        <body>
            <div xml:id="d802">

                <pb facs="0760" n="644" sameAs="frus:frus1912/pg644"/>

                <note rend="inline" type="source">File No. 895.52/12.</note>
                <head>
                    <hi rendition="#italic">The American Ambassador to
                        the Secretary of State</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Tokyo</hi></placeName>, <date
                            calendar="gregorian" when="1912-08-02">
                            <hi rendition="#italic">August 2, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to my despatch No. 86 of June
                    14, 1912, in regard to the rights of American citizens claiming title to land in
                    Chosen (Korea), I have the honor to enclose herewith a copy of a note (No. 1)
                    received this day from the Japanese Foreign Office in reply to my note No. 54 of
                    June 14.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Charles Page Bryan.</hi>
                    </signed>
                </closer>



                <xi:include href="d802-a1.xml" xpointer="d802-a1"/>
            </div>
