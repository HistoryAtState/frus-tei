    <text>
        <body>
            <div xml:id="d788">

                <pb facs="0750" n="634" sameAs="frus:frus1912/pg634"/>

                <note rend="inline" type="source">File No. 894.001 M98/9.</note>
                <head>
                    <hi rendition="#italic">The Ambassador of Japan to
                        the Secretary of State</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Imperial Japanese Embassy</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-07-29">
                            <hi rendition="#italic">July 29, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I am profoundly grieved to inform you that
                    I have received a cable message from Viscount Uchida, His Majesty’s Minister for
                    Foreign Affairs, announcing the demise of His Majesty the Emperor at the
                    Imperial Palace at Tokio at 12:43 Tuesday morning, July 30th.</p>
                <p>It is my melancholy duty to request that you will bring this sad intelligence to
                    the knowledge of the President and his Cabinet.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">J. Chinda.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
