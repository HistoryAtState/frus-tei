    <text>
        <body>
            <div xml:id="d792">

                <pb facs="0751" n="635" sameAs="frus:frus1912/pg635"/>

                <note rend="inline" type="source">File No. 894.001 M98/9.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            Japanese Minister for Foreign
                    Affairs</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-07-29">
                            <hi rendition="#italic">July 29, 1912</hi></date>.</dateline>
                </opener>
                <p>I offer to your excellency the expression of my personal sympathy and sorrow in
                    the great loss which has been sustained by the Japanese nation in the death of
                    His Majesty the Emperor Mutsuhito.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">P. C. Knox.</hi>
                    </signed>
                </closer>
            </div>
        </body>
