    <text>
        <body>
            <div xml:id="d798">

                <pb facs="0754" n="638" sameAs="frus:frus1912/pg638"/>

                <note rend="inline" type="source">File No. 894.001 Y8.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Ambassador of Japan</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-10-16">
                            <hi rendition="#italic">October 16, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: I have the honor to acknowledge the
                    receipt of your note of the 11th instant, enclosing under separate sealed cover,
                    for presentation to the President of the United States, an autograph letter
                    addressed to him by His Majesty the Emperor of Japan, announcing the lamented
                    demise of His Majesty the late Emperor, and the consequent accession to the
                    Throne of His Majesty the present Emperor.</p>
                <p>In reply I have the honor to inform you that the Imperial communication has been
                    laid before the President, whose reply will be delivered through the American
                    Ambassador at Tokyo.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Alvey A. Adee.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
