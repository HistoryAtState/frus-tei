    <text>
        <body>
            <div xml:id="d1765">

                <pb facs="1437" n="1321" sameAs="frus:frus1912/pg1321"/>

                <note rend="inline" type="source">File No. 816.00/147.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the American Minister to
                        Guatemala</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-01-12T16:00:00-05:00">
                            <hi rendition="#italic">January 12, 1912—4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>The Minister of Salvador informs the Department that Lino A. Barahona and
                    Prudencio Alfaro are fomenting a revolution on Guatemalan soil against Salvador,
                    and that Alfaro is at Jalpatagua. You will immediately convey this information
                    to the President of Guatemala.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Knox.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
