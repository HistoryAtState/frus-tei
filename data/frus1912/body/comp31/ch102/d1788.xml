    <text>
        <body>
            <div xml:id="d1788">

                <pb facs="1454" n="1338" xml:id="pg1338"/>

                <note rend="inline" type="source">File No. 033.1611/1.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the American
                    Minister</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 106.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washing ton</hi></placeName>, <date
                            calendar="gregorian" when="1912-06-28">
                            <hi rendition="#italic">June 28, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>:I enclose, with office copy, a letter by
                    which the President acknowledges the letter, dated March 18 last, from the
                    Constitutional President of Salvador expressing his appreciation of the recent
                    visit of the Secretary of State to Salvador.</p>
                <p>You will forward the copy to the Foreign Office and deliver the original in the
                    manner most agreeable to His Excellency.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">P. C. Knox.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
