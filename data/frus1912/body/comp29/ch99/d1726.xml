            <div xml:id="d1726">

                <pb facs="1398" n="1282" sameAs="frus:frus1912/pg1282"/>

                <note rend="inline" type="source">File No. 823.124/10.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            American Minister</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-05-21">
                            <hi rendition="#italic">May 21, 1912</hi></date>.</dateline>
                </opener>
                <p>[Summary of the foregoing letter from the Acting Secretary of the Treasury.]</p>
                <p>Three civilians have been recommended also, but have not yet been consulted as to
                    their willingness to undertake the work.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Knox.</hi>
                    </signed>
                </closer>
            </div>
