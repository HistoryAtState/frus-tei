                <note rend="inline" type="source">File No. 823.124/17.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the American
                        Minister</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-08-19">
                            <hi rendition="#italic">August 19, 1912</hi></date>.</dateline>
                </opener>
                <p>Department is consulting War Department and American Society of Civil
                    Engineers.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Adee.</hi>
                    </signed>
                </closer>
