                <pb facs="0296" n="180" sameAs="frus:frus1912/pg180"/>

                <opener>
                    <seg rendition="#center">[Inclosure 2.]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">The American Vice and Deputy Consul in Chargé at Foochow
                        to the American Minister</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">Foochow</hi></placeName>, <date
                            calendar="gregorian" when="1912-01-02">
                            <hi rendition="#italic">January 2, 1912</hi></date>.</dateline>
                </opener>
                <p>Shall I furnish Provisional Government complete list American property signed by
                    consular officer, giving area and full value including improvements, as has been
                    requested?</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Thompson.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
