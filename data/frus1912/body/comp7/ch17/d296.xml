            <div xml:id="d296">

                <pb facs="0291" n="175" sameAs="frus:frus1912/pg175"/>

                <note rend="inline" type="source">File No. 893.00/747.</note>
                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Shanghai</hi></placeName>, <date
                            calendar="gregorian" when="1911-12-04">
                            <hi rendition="#italic">December 4, 1911</hi></date>.</dateline>
                </opener>
                <p rendition="#center">[Telegram transmitted to the Secretary of State Dec. 4,
                    1911.]</p>
                <p>The <hi rendition="#italic">Nanshan</hi> fired at from Kiukiang forts; the error
                    has been admitted. I have directed the <hi rendition="#italic">Albany’s</hi>
                    commanding officer to investigate and if necessary obtain an apology.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Murdock.</hi>
                    </signed>
                </closer>
            </div>
        </body>
