            <div xml:id="d297">

                <pb facs="0291" n="175" sameAs="frus:frus1912/pg175"/>

                <note rend="inline" type="source">File No. 893.00/772.</note>
                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <date calendar="gregorian" when="1911-12-12">
                            <hi rendition="#small-caps">December</hi>
                            <hi rendition="#italic">12, 1911</hi></date>.</dateline>
                </opener>
                <p rendition="#center">[Telegram.—Extract. Transmitted to the Secretary of State
                    December 12, 1911.]</p>
                <p>Wu Ting Fang, recognized by all factions as in charge of foreign affairs, has
                    submitted apology for firing upon <hi rendition="#italic">Nanshan</hi> and has
                    given assurance of no repetition.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Murdock.</hi>
                    </signed>
                </closer>
            </div>
        </body>
