    <text>
        <body>
            <div xml:id="d271">

                <pb facs="0282" n="166" sameAs="frus:frus1912/pg166"/>

                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            American Chargé d’Affaires</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1911-11-10">
                            <hi rendition="#italic">November 10, 1911</hi></date>.</dateline>
                </opener>
                <p>Provided such action becomes necessary, this Government will participate in
                    protection of the railway to the sea, under the protocol of 1901.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Knox.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
