    <text>
        <body>
            <div xml:id="d275">

                <pb facs="0284" n="168" xml:id="pg168"/>

                <note rend="inline" type="source">File No. 893.00/701.</note>
                <head>
                    <hi rendition="#italic">The American Minister to the
                            Secretary of State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Peking</hi></placeName>, <date
                            calendar="gregorian" when="1911-11-28T10:00:00+08:00">
                            <hi rendition="#italic">November 28, 1911—10 a.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>I am requesting the Admiral to send 70 more marines for east side of quarter.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Calhoun.</hi>
                    </signed>
                </closer>
            </div>
        </body>
