    <text>
        <body>
            <div xml:id="d70">

                <pb facs="0182" n="66" sameAs="frus:frus1912/pg66"/>

                <note rend="inline" type="source">File No. 893.00/1072.</note>
                <head>
                    <hi rendition="#italic">The American Minister to the
                            Secretary of State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.—Extract.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Peking</hi></placeName>, <date
                            calendar="gregorian" when="1912-02-15">
                            <hi rendition="#italic">February 15, 1912</hi></date>.</dateline>
                </opener>
                <p>Resignation of Sun and Cabinet has been accepted by the Nanking Assembly.
                    Election of a new president set for to-day.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Calhoun.</hi>
                    </signed>
                </closer>
            </div>
        </body>
