                <pb facs="0191" n="75" xml:id="pg75"/>

                <note rend="inline" type="source">File No. 893.00/1170.</note>
                <head>
                    <hi rendition="#italic">The American Minister to the
                            Secretary of State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram—Extract.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Peking</hi></placeName>, <date
                            calendar="gregorian" when="1912-03-09">
                            <hi rendition="#italic">March 9, 1912</hi></date>.</dateline>
                </opener>
                <p>Yuan authorized by Nanking Assembly to be inaugurated at Peking on March 10.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Calhoun</hi>.</signed>
                </closer>
            </div>
        </body>
