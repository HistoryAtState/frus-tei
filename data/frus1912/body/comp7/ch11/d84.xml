    <text>
        <body>
            <div xml:id="d84">

                <pb facs="0190" n="74" sameAs="frus:frus1912/pg74"/>

                <note rend="inline" type="source">File No. 893.001Y/9.</note>
                <head>
                    <hi rendition="#italic">The Chinese Minister to the Acting Secretary of
                        State</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 34.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Chinese Legation</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-03-09">
                            <hi rendition="#italic">March 9, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I am instructed by my Government to inform
                    you that His Excellency Yuan Shih-Kai will take the oath of office and enter
                    upon the duties as Provisional President of the Republic of China, at Peking, on
                    the 10th instant.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Chang Yin Tang</hi>.</signed>
                </closer>
            </div>
        </body>
