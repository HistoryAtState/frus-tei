    <text>
        <body>
            <div xml:id="d65-a1">

                <pb facs="0179" n="63" sameAs="frus:frus1912/pg63"/>

                <opener>
                    <seg rendition="#center">[Inclosure 1.]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">The German Ambassador to the
                            Secretary of State</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Imperial German Embassy</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-01-31">
                            <hi rendition="#italic">January 31, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Secretary of State</hi>: I have the honor
                    respectfully to inform your excellency that in view of the development of
                    affairs in the Far East the Imperial Government would desire to obtain
                    confidential information as to the attitude of the Government of the United
                    States toward the said development.</p>
                <p>I avail [etc.].</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">J. Bernstorff.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
