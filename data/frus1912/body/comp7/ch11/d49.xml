            <div xml:id="d49">

                <pb facs="0171" n="55" sameAs="frus:frus1912/pg55"/>

                <note rend="inline" type="source">File No. 893.00/766.</note>
                <head>
                    <hi rendition="#italic">The Naval Attaché at Tokyo to the Secretary of the
                        Navy</hi>.</head>
                <dateline>
                    <placeName>Tokyo</placeName>, <date
                        ana="#date_undated-inferred-from-document-content-and-sibling-dates"
                        calendar="gregorian" notAfter="1911-12-11T23:59:59-05:00"
                        notBefore="1911-12-07T00:00:00+09:00">undated</date>
                </dateline>
                <p rendition="#center">[Telegram transmitted to the Secretary of State Dec. 11,
                    1911.]</p>
                <p>Agreement has been reached between the British and Japanese commanding officers
                    to intervene in China, using Japanese soldiers. Three Japanese divisions ready
                    to move on 24 hours notice. The Austrian Military Attaché is authority for the
                    above.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Shipley.</hi>
                    </signed>
                </closer>
            </div>
