    <text>
        <body>
            <div xml:id="d293">

                <pb facs="0290" n="174" sameAs="frus:frus1912/pg174"/>

                <head>
                    <hi rendition="#italic">The Secretary of State to the American Chargé
                        d’Affaires</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1911-11-10">
                            <hi rendition="#italic">November 10, 1911</hi></date>.</dateline>
                </opener>
                <p>In accordance with the uniform policy of this Government you may at your
                    discretion afford temporary refuge where such is necessary to preserve innocent
                    human life, first ascertaining that your colleagues believe safety of the
                    legation quarter not thereby endangered.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Knox.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
