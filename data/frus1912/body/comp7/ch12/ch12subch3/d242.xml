    <text>
        <body>
            <div xml:id="d242">

                <pb facs="0268" n="152" xml:id="pg152"/>

                <note rend="inline" type="source">File No. 893.51/1059.</note>
                <head>
                    <hi rendition="#italic">The American Ambassador to Great Britain to the
                        Secretary of State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.—Extract.—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">London</hi></placeName>, <date
                            calendar="gregorian" when="1912-09-19">
                            <hi rendition="#italic">September 19, 1912</hi></date>.</dateline>
                </opener>
                <p>Foreign office remains firm in its intention to discourage as far as possible the
                    new £10,000,000 loan and does not intend to acknowledge the note from the
                    Chinese Legation announcing signature to this loan.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Reid.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
