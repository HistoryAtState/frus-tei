            <div xml:id="d208">

                <pb facs="0254" n="138" sameAs="frus:frus1912/pg138"/>

                <note rend="inline" type="source">File No. 893.51/945.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the American Ambassador to
                        France</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-06-15T21:00:00-05:00">
                            <hi rendition="#italic">June 15, 1912—9 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your June 13—12 a.m. If the other Governments concerned accept the proposed
                    agreement this Government also approves.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Knox.</hi>
                    </signed>
                </closer>
            </div>
