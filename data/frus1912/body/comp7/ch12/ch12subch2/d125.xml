        <body>
            <div xml:id="d125">

                <pb facs="0211" n="95" sameAs="frus:frus1912/pg95"/>

                <note rend="inline" type="source">File 893.51/470.]</note>
                <head>
                    <hi rendition="#italic">The American Minister to the Secretary of
                    State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Extract.]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 230.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Peking</hi></placeName>, <date
                            calendar="gregorian" when="1911-04-27">
                            <hi rendition="#italic">April 27, 1911</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a
                    copy in duplicate of the loan agreement for national currency reform and,
                    industrial development in Manchuria, which was signed on the 15th instant by the
                    local representatives of the quadruple banks, on the one part, and Duke
                    Tsai-tse, President of the Board of Finance, on the other. * * *</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. J. Calhoun</hi>.</signed>
                </closer>


                <xi:include href="d125-a1.xml" xpointer="d125-a1"/>
            </div>
        </body>
    </text>
