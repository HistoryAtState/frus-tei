    <text>
        <body>
            <div xml:id="d463">

                <pb facs="0442" n="326" sameAs="frus:frus1912/pg326"/>

                <note rend="inline" type="source">File No. 811.5124/10.]</note>
                <head>
                    <hi rendition="#italic">The Assistant Attorney General to the Secretary of
                        State</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of Justice</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-04-30">
                            <hi rendition="#italic">April 30, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring again to your letter of the 26th
                    of February,<anchor n="1" xml:id="d463-f1"/> in connection with the settlement
                    and distribution of the estate of Ane <pb facs="0443" n="327" xml:id="pg327"/>
                    Margrethe Anderson, I beg to enclose for your information copy of a letter dated
                    the 22nd instant from the United States Attorney for the Northern District of
                    Iowa, reporting the status of the intervening petition filed by him.</p>
                <p>Respectfully,</p>
                <closer>(For the Attorney General) <lb/>
                    <signed>
                        <hi rendition="#small-caps">Winfred T. Denison</hi>, <lb/>
                        <hi rendition="#italic">Assistant, Attorney General</hi>.</signed>
                </closer>


                <xi:include href="d463-a1.xml" xpointer="d463-a1"/>
            </div>
        </body>
    </text>
