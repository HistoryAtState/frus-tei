    <text>
        <body>
            <div xml:id="d476">

                <pb facs="0450" n="334" sameAs="frus:frus1912/pg334"/>

                <note rend="inline" type="source">File No. 859.001F87/10.]</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            Minister of Denmark</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 173.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Legation of Denmark</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-07-17">
                            <hi rendition="#italic">July 17, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the
                    receipt of your note of the 9th instant, with which you transmit a letter, with
                    office copy, <pb facs="0451" n="335" xml:id="pg335"/> addressed to the President
                    by His Majesty King Christian X., announcing his accession to the throne of
                    Denmark.</p>
                <p>In reply I have the honor to say that His Majesty’s letter has been laid before
                    the President’s [sic] whose reply will, in due course, be forwarded through the
                    American Legation at Copenhagen.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">P. C. Knox</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
