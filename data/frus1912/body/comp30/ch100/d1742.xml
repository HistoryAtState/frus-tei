    <text>
        <body>
            <div xml:id="d1742">

                <pb facs="1416" n="1300" xml:id="pg1300"/>

                <note rend="inline" type="source">File No. 861.0145/5.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the American Ambassador</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 148.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1911-03-11">
                            <hi rendition="#italic">March 11, 1911</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The Department has received your No. 466
                    of the 13th ultimo reporting further concerning the Russian law extending to
                    twelve miles from low-water mark the area of supervision by the Russian customs
                    authorities.</p>
                <p>The Department awaits the reply promised to you by the Russian Minister for
                    Foreign Affairs and your comments thereon.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Alvey A. Adee.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
