            <div xml:id="ch25">

                <pb facs="0343" n="227" sameAs="frus:frus1912/pg227"/>

                <head>Naturalization convention between the United States and Costa Rica</head>
                <p rendition="#flush">
                    <hi rendition="#italic">Signed at San José, June 10, 1911; ratification advised
                        by the Senate, February 14, 1912; ratified by the President, March 29, 1912;
                        ratified by Costa Rica, August 5, 1911; ratifications exchanged at San José,
                        May 9, 1912; proclaimed, June 6, 1912</hi>.</p>

                <xi:include href="ch25/d313.xml" xpointer="d313"/>
