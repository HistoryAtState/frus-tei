    <text>
        <body>
            <div xml:id="ch6">

                <pb facs="0123" n="7" sameAs="frus:frus1912/pg7"/>

                <head>Copyright convention between the United States and Hungary</head>
                <p>
                    <hi rendition="#italic">Signed at Budapest, January 30, 1912.</hi>
                </p>
                <p>
                    <hi rendition="#italic">Ratification advised by the Senate, July 23, 1912.</hi>
                </p>
                <p>
                    <hi rendition="#italic">Ratified by the President, July 31, 1912.</hi>
                </p>
                <p>
                    <hi rendition="#italic">Ratified by Hungary, August 12, 1912.</hi>
                </p>
                <p>
                    <hi rendition="#italic">Ratifications exchanged at Washington, September 16,
                        1912.</hi>
                </p>
                <p>
                    <hi rendition="#italic">Proclaimed, October 15, 1912.</hi>
                </p>

                <xi:include href="ch6/d6.xml" xpointer="d6"/>
