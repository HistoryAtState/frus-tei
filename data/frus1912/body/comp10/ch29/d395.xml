        <body>
            <div xml:id="d395">

                <pb facs="0389" n="273" sameAs="frus:frus1912/pg273"/>

                <note rend="inline" type="source">File No. 123.G35/50.</note>
                <head>
                    <hi rendition="#italic">The Minister of Cuba to the Secretary of
                    State</hi>.</head>
                <p>The Minister of Cuba, under instructions from his Government, has the honor to
                    transmit herewith a copy of a cablegram dated <pb facs="0390" n="274"
                        xml:id="pg274"/> the first instant, from the President of the Republic of
                    Cuba to the President of the United States.</p>
                <p>The Minister of Cuba takes this occasion [etc]</p>
                <closer>
                    <dateline rendition="#float-left">
                        <hi rendition="#small-caps">Legation of Cuba</hi>, <lb/>
                        <placeName><hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-09-02"><hi rendition="#italic">September
                                2, 1912</hi></date>.</dateline>
                </closer>


                <xi:include href="d395-a1.xml" xpointer="d395-a1"/>
