    <text>
        <body>
            <div xml:id="d457">

                <pb facs="0438" n="322" sameAs="frus:frus1912/pg322"/>

                <note rend="inline" type="source">File No. 837.6112/26.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Mr.
                            Champion</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-12-30">
                            <hi rendition="#italic">December 30, 1912</hi></date>.</dateline>
                </opener>
                <p>Your telegram to Assistant Solicitor Hart received. Department expects to have in
                    about a week a conference with Mr. Rodgers, now in this country, and hopes to
                    make its decision shortly thereafter.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Knox</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
