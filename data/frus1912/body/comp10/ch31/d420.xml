    <text>
        <body>
            <div xml:id="d420">

                <pb facs="0411" n="295" sameAs="frus:frus1912/pg295"/>

                <note rend="inline" type="source">File No. 811.34537/108a.</note>
                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <opener>
                    <seg rendition="#float-left">No. 170.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-11-21">
                            <hi rendition="#italic">November 21, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to previous correspondence on
                    the subject, I enclose a full power<anchor n="1" xml:id="d420-f1"/> authorizing
                    you to sign with the Government of Cuba an agreement amending the agreements
                    between the United States and Cuba concluded February 16/23, 1903, and July 2,
                    1903, by which certain described areas of land and water in Guantánamo and Bahía
                    Honda were leased to the United States for the purpose of coaling and naval
                    stations.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">P. C. Knox</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
