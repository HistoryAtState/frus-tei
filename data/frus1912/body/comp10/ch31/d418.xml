    <text>
        <body>
            <div xml:id="d418">

                <pb facs="0410" n="294" sameAs="frus:frus1912/pg294"/>

                <note rend="inline" type="source">File No. 811.34537/107.</note>
                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <opener>
                    <seg rendition="#float-left">No. 477.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Habana</hi></placeName>, <date
                            calendar="gregorian" when="1912-10-23">
                            <hi rendition="#italic">October 23, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith the
                    final texts<anchor n="2" xml:id="d418-f1"/> in English and Spanish of the
                    proposed convention for the enlargement of the Guantánamo naval station.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">A. M. Beaupré</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
