                <pb facs="0423" n="307" sameAs="frus:frus1912/pg307"/>

                <note rend="inline" type="source">File No. 811.304M28/64.</note>
                <head>
                    <hi rendition="#italic">The American Minister to the Secretary of
                    State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Habana</hi></placeName>, <date
                            calendar="gregorian" when="1912-03-11">
                            <hi rendition="#italic">March 11, 1912</hi></date>.</dateline>
                </opener>
                <p>The rearrangements for the reception of the remains will be modified as
                    desired.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Beaupré</hi>.</signed>
                </closer>
            </div>
        </body>
