    <text>
        <body>
            <div xml:id="d414">

                <pb facs="0407" n="291" xml:id="pg291"/>

                <note rend="inline" type="source">File No. 437.00/43.</note>
                <head>
                    <hi rendition="#italic">The Ambassador of Great
                            Britain to the Secretary of
                        State</hi>.<anchor n="1" xml:id="d414-f1"/>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 260.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">British Embassy</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-12-20">
                            <hi rendition="#italic">December 20, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honour, under instructions from
                    His Majesty’s Principal Secretary of State for Foreign Affairs, to communicate
                    to you herewith a copy of a joint note and agreement which the representatives
                    of His Majesty’s Government and the French and German Government at Havana have
                    addressed to the Cuban Government in regard to the arbitration of the British,
                    French and German outstanding claims against Cuba.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">James Bryce</hi>.</signed>
                </closer>


                <xi:include href="d414-a1.xml" xpointer="d414-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d414-f1" n="1" type="source" xml:id="d414-f1-content">
                <p>A similar note was sent on the same date with the same inclosure by the French
                    and the German Ambassadors, file nos. 437.00/44 and 437.00/45 respectively.</p>
            </note>
        </listAnnotation>
    </standOff>
