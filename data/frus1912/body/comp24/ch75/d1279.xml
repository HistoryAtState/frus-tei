    <text>
        <body>
            <div xml:id="d1279">

                <pb facs="1019" n="903" sameAs="frus:frus1912/pg903"/>

                <note rend="inline" type="source">File No. 612.1123/10.</note>
                <head>
                    <hi rendition="#italic">The American Chargé d’Affaires to the Secretary of
                        State</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 1772.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1912-11-08">
                            <hi rendition="#italic">November 8, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to the Department’s
                    telegraphic instruction of October 23, 1 p.m., relative to the closure of ports
                    of Mexico by executive or legislative order, I have the honor to report that I
                    have received a note from the Mexican Foreign Office which states to the effect
                    that in view of the fact that the conditions at the port of Vera Cruz are now
                    changed, the Foreign Office believes that the matter may be considered as
                    terminated.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Montgomery Schuyler.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
