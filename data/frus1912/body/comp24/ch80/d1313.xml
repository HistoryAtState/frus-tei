    <text>
        <body>
            <div xml:id="d1313">

                <pb facs="1040" n="924" sameAs="frus:frus1912/pg924"/>

                <head>
                    <hi rendition="#italic">The American Consul at Vera Cruz to the Secretary of
                        State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">Vera Cruz</hi></placeName>, <date
                            calendar="gregorian" when="1912-10-24T17:00:00-06:36">
                            <hi rendition="#italic">October 24, 1912—5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>No foreigners hurt or property destroyed. City in the possession of Federals.
                    Díaz is a prisoner; if asylum is asked for will be refused.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Canada.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
