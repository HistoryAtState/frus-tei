    <text>
        <body>
            <div xml:id="d1263">

                <pb facs="1012" n="896" sameAs="frus:frus1912/pg896"/>

                <note rend="inline" type="source">File No. 812.2311/55.</note>
                <head>
                    <hi rendition="#italic">The Governor of New Mexico to the Secretary of
                        State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Santa Fé, N. Mex.</hi></placeName>, <date
                            calendar="gregorian" when="1912-09-09">
                            <hi rendition="#italic">September 9, 1912</hi></date>.</dateline>
                </opener>
                <p>Replying to your telegram. It will be entirely agreeable to the State of New
                    Mexico to have Mexican troops pass through our State under such regulations as
                    may be imposed by the United States Government.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">William C. McDonald.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
