    <text>
        <body>
            <div xml:id="d1261">

                <pb facs="1011" n="895" sameAs="frus:frus1912/pg895"/>

                <note rend="inline" type="source">File No. 812.2311/52.</note>
                <head>
                    <hi rendition="#italic">The Governor of Arizona to
                        the Secretary of State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.—Extract.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Phoenix, Ariz.</hi></placeName>, <date
                            calendar="gregorian" when="1912-09-07">
                            <hi rendition="#italic">September 7, 1912</hi></date>.</dateline>
                </opener>
                <p>In compliance with the request conveyed to me through your telegram of to-day I
                    have the honor to assure you that the State of Arizona readily assents to the
                    transporting of Mexican Federal troops from Ciudad Juárez through United States
                    territory to points in the State of Sonora where American lives and property,
                    are being endangered by the operation of Mexican revolutionary bands.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Geo. W. P. Hunt.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
