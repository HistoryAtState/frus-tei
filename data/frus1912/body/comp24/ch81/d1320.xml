    <text>
        <body>
            <div xml:id="d1320">

                <pb facs="1043" n="927" sameAs="frus:frus1912/pg927"/>

                <note rend="inline" type="source">File No. 312.93/19.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the American Consul at Mazatlan</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 68.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-04-01">
                            <hi rendition="#italic">April 1, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The Department has received your dispatch
                    No. 149 of the 17th ultimo reporting your action in connection with a meeting
                    which it was proposed to hold Saturday evening the 16th of March for the purpose
                    of arousing an anti-Chinese demonstration.</p>
                <p>Your action in requesting that the meeting be prohibited has the approval of the
                    Department.</p>
                <p>I am [etc.]</p>
                <closer>For <signed>Mr. Huntington Wilson</signed>: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Wilbur J. Carr.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
