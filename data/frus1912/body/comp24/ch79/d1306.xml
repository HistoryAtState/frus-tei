    <text>
        <body>
            <div xml:id="d1306">

                <pb facs="1037" n="921" sameAs="frus:frus1912/pg921"/>

                <note rend="inline" type="source">File No. 812.77/127.</note>
                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <opener>
                    <seg rendition="#float-left">No. 1369.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1912-04-19">
                            <hi rendition="#italic">April 19, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith
                    without comment and for the information of the Department or such other
                    Departments as may be interested therein a copy of a letter from Mr. T. K.
                    Eccles and <pb facs="1038" n="922" xml:id="pg922"/> Mr. J. F. Ealy,
                    representatives respectively of the Order of Railway Conductors and of the
                    Brotherhood of Locomotive Engineers.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Henry Lane Wilson.</hi>
                    </signed>
                </closer>


                <xi:include href="d1306-a1.xml" xpointer="d1306-a1"/>
            </div>
        </body>
    </text>
