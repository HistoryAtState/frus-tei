    <text>
        <body>
            <div xml:id="d997">

                <pb facs="0873" n="757" sameAs="frus:frus1912/pg757"/>

                <note rend="inline" type="source">File No. 812.113/242.</note>
                <head>
                    <hi rendition="#italic">The American Ambassador to
                        the Secretary of State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegrams.—Paraphrases.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1912-03-22T18:00:00-06:36">
                            <hi rendition="#italic">March 22, 1912—6 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Department’s March 21, 11 a.m., and my March 22, 11 a.m.<anchor n="1"
                        xml:id="d997-f1"/> The committee of the American colony desire me to add to
                    the order 1,000 field-service belts and to increase the number of rifle
                    cartridges from 250,000 to 1,000,000.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wilson.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d997-f1" n="1" xml:id="d997-f1-content">
                <p>See Mar. 22, 12 noon.</p>
            </note>
        </listAnnotation>
    </standOff>
