    <text>
        <body>
            <div xml:id="d1200-a4">

                <pb facs="0980" n="864" sameAs="frus:frus1912/pg864"/>

                <opener>
                    <seg rendition="#center">[Inclosure 4.]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">Commander Hughes to the
                            German Consul</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">United States Cruiser “Des Moines,”</hi>
                            <lb/>
                            <hi rendition="#italic">Vera Cruz</hi></placeName>, <date
                            calendar="gregorian" when="1912-10-21">
                            <hi rendition="#italic">October 21, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I beg to acknowledge receipt of your
                    letter of the 21st instant requesting that I furnish protection to the German
                    steamer <hi rendition="#italic">Steigerwald.</hi>
                </p>
                <p>I beg to inform you that I will afford all the protection within my power to the
                    above vessel, the same as if she flew the flag of the United States, and I <pb
                        facs="0981" n="865" xml:id="pg865"/> have so informed the senior Mexican
                    naval officer and the master of the <hi rendition="#italic">Steigerwald.</hi>
                </p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">C. F. Hughes.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
