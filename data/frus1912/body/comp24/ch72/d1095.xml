            <div xml:id="d1095">

                <pb facs="0922" n="806" xml:id="pg806"/>

                <note rend="inline" type="source">File No. 312.11/310a.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the American Consul at Los Mochis</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-04-29T18:00:00-05:00">
                            <hi rendition="#italic">April 29, 1912—6 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p rendition="#center">[Telegram in care of Collector of Customs at San
                    Diego.—Paraphrase.]</p>
                <p>Communication with the American Consul at Mazatlan is cut off and the Department
                    therefore desires you or commanding officer <hi rendition="#italic">Buford</hi>
                    to deliver to him the following telegram from the Department dated April 27,
                    1912: <quote rend="blockquote">
                        <p>The Department has informed the British Ambassador, in compliance with
                            request of British Government, that if there is room the <hi
                                rendition="#italic">Buford</hi> will be glad to extend assistance to
                            any British subjects who seek it after all Americans have been cared
                            for.</p>
                    </quote>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Huntington Wilson.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
