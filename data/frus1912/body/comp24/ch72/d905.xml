    <text>
        <body>
            <div xml:id="d905">

                <pb facs="0826" n="710" xml:id="pg710"/>

                <note rend="inline" type="source">File No. 812.00/2692.</note>
                <head>
                    <hi rendition="#italic">The American Ambassador to
                        the Secretary of State</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 1203.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1912-01-06">
                            <hi rendition="#italic">January 6, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith for
                    such action as the Department deems necessary to take, a copy of an informal
                    note, with its inclosures, from the Mexican Minister for Foreign Affairs,
                    relative to certain seditious propaganda being carried on by Dr. Emilio Vázquez
                    Gómez from his present home in San Antonio, Texas.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Henry Lane Wilson.</hi>
                    </signed>
                </closer>




