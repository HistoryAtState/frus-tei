            <div xml:id="d1200">

                <pb facs="0980" n="864" xml:id="pg864"/>

                <note rend="inline" type="source">File No. 812.00/5480.</note>
                <head>
                    <hi rendition="#italic">The American Consul at Vera Cruz to the Secretary of
                        State</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 770.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">Vera Cruz</hi></placeName>, <date
                            calendar="gregorian" when="1912-10-25">
                            <hi rendition="#italic">October 25, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to inclose a series of
                    reports and documents referring to the taking of Vera Cruz by the rebel general
                    Felix Diaz and the retaking from Diaz by the Federal general Joaquin
                    Beltrán.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wm. W. Canada.</hi>
                    </signed>
                </closer>










