    <text>
        <body>
            <div xml:id="d952">

                <pb facs="0849" n="733" sameAs="frus:frus1912/pg733"/>

                <note rend="inline" type="source">File No. 812.00/3053a.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Mexican Ambassador</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-03-02">
                            <hi rendition="#italic">March 2, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Ambassador</hi>: I inclose for your
                    excellency’s information a copy of a proclamation by the President of the United
                    States which is being promulgated to-day, which will make evident <pb
                        facs="0850" n="734" xml:id="pg734"/> to your excellency the great desire of
                    the President to prevent any improper use of American territory as a basis for
                    participation in anyway whatsoever in the present Mexican disturbances.</p>
                <p>I beg leave to inclose also, for your excellency’s information, copy of what I
                    shall give to the press to-day, not as a statement but for their guidance.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Huntington Wilson.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
