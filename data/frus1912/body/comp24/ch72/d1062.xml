    <text>
        <body>
            <div xml:id="d1062">

                <pb facs="0906" n="790" sameAs="frus:frus1912/pg790"/>

                <note rend="inline" type="source">File No. 312.112F821.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the American Consul at
                        Chihuahua</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-04-15">
                            <hi rendition="#italic">April 15, 1912</hi></date>.</dateline>
                </opener>
                <p>Thoroughly investigate circumstances killing of Fountain and matter of his
                    presumed American citizenship.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Huntington Wilson.</hi>
                    </signed>
                </closer>
            </div>
        </body>
