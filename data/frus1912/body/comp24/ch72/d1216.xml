    <text>
        <body>
            <div xml:id="d1216">

                <pb facs="0987" n="871" sameAs="frus:frus1912/pg871"/>

                <note rend="inline" type="source">File No.312.11/1001.</note>
                <head>
                    <hi rendition="#italic">The American Chargé d’Affaires to the Secretary of
                        State</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 1792.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1912-11-27">
                            <hi rendition="#italic">November 27, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to my telegram of November
                    24, 12 noon,<anchor n="1" xml:id="d1216-f1"/> I have the honor to transmit
                    herewith a translation of the note which I have received in reply to the
                    Embassy’s strong note of September 15 last.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Montgomery Schuyler.</hi>
                    </signed>
                </closer>


                <xi:include href="d1216-a1.xml" xpointer="d1216-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1216-f1" n="1" xml:id="d1216-f1-content">
                <p>Should be November 27, 12 noon.</p>
            </note>
        </listAnnotation>
    </standOff>
