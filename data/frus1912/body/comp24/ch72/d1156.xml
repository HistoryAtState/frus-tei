            <div xml:id="d1156">

                <pb facs="0954" n="838" sameAs="frus:frus1912/pg838"/>

                <note rend="inline" type="source">File No. 812.113/926a.</note>
                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-09-07T12:00:00-05:00">
                            <hi rendition="#italic">September 7, 1912—12
                        noon</hi></date>.</dateline>
                </opener>
                <p>Department has requested the War Department to place at Naco, as a reserve
                    supply, 1,000 rifles and 200,000 rounds of ammunition.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Adee.</hi>
                    </signed>
                </closer>
                <postscript>
                    <p>[Same to Dye at Douglas.]</p>
                </postscript>
            </div>
