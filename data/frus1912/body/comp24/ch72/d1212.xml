    <text>
        <body>
            <div xml:id="d1212">

                <pb facs="0985" n="869" sameAs="frus:frus1912/pg869"/>

                <note rend="inline" type="source">File No. 812.00/5513.</note>
                <head>
                    <hi rendition="#italic">The American Consul at San Luis
                            Potosí to the Secretary of
                    State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">San Luis Potosí</hi></placeName>, <date
                            calendar="gregorian" when="1912-11-17T20:00:00-06:36">
                            <hi rendition="#italic">November 17, 1912—8 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Cuidad Maiz, town 4,000 inhabitants, 90 miles east, taken by rebels.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bonney.</hi>
                    </signed>
                </closer>
            </div>
        </body>
