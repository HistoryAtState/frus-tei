    <text>
        <body>
            <div xml:id="d1103">

                <pb facs="0925" n="809" sameAs="frus:frus1912/pg809"/>

                <note rend="inline" type="source">File No. 812.00/3801.</note>
                <head>
                    <hi rendition="#italic">The American Consul at Juárez to the Secretary of
                        State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">Ciudad Juárez</hi></placeName>, <date
                            calendar="gregorian" when="1912-05-04">
                            <hi rendition="#italic">May 4, 1912</hi></date>.</dateline>
                </opener>
                <p>Special envoy of Pascual Orozco to-day formally appointed Vásquez Gómez
                    Provisional President of Mexico at Ciudad Juárez, where the seat of government
                    will for the present remain.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Edwards.</hi>
                    </signed>
                </closer>
            </div>
        </body>
