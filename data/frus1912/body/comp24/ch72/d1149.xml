    <text>
        <body>
            <div xml:id="d1149">

                <pb facs="0949" n="833" sameAs="frus:frus1912/pg833"/>

                <note rend="inline" type="source">File No. 312.11/1354b.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the American
                        Ambassador</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 965.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-09-04">
                            <hi rendition="#italic">September 4, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I transmit herewith a brief account of the
                    gist of the President’s interview this afternoon with Mr. Calero, the Ambassador
                    of Mexico, who leaves this evening to return to the City of Mexico.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Huntington Wilson</hi>.</signed>
                </closer>



                <xi:include href="d1149-a1.xml" xpointer="d1149-a1"/>
            </div>
