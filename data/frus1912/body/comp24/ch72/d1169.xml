                <pb facs="0962" n="846" sameAs="frus:frus1912/pg846"/>

                <note rend="inline" type="source">File No. 312.11/877.</note>
                <head>
                    <hi rendition="#italic">The American Ambassador to the Secretary of
                    State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegrams.—Paraphrases.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1912-09-17T10:00:00-06:36">
                            <hi rendition="#italic">September 17, 1912—10 a.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Note delivered this morning. Impossible last night.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wilson.</hi>
                    </signed>
                </closer>
            </div>
