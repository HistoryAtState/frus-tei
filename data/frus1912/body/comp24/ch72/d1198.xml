    <text>
        <body>
            <div xml:id="d1198">

                <pb facs="0977" n="861" sameAs="frus:frus1912/pg861"/>

                <note rend="inline" type="source">File No. 812.00/5424.</note>
                <head>
                    <hi rendition="#italic">The American Consul at Vera Cruz to the Secretary of
                        State</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 768.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">Vera Cruz</hi></placeName>, <date
                            calendar="gregorian" when="1912-10-23">
                            <hi rendition="#italic">October 23, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a
                    series of documents and reports referring to the taking of the city of Vera Cruz
                    and the subsequent happenings.</p>
                <p>I have [etc.],</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wm. W. Canada.</hi>
                    </signed>
                </closer>







