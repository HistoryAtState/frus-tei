    <text>
        <body>
            <div xml:id="d1022">

                <pb facs="0886" n="770" sameAs="frus:frus1912/pg770"/>

                <note rend="inline" type="source">File No. 812.113/284.</note>
                <head>
                    <hi rendition="#italic">The President to the Acting Secretary of
                    State</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">The White House</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-04-01">
                            <hi rendition="#italic">April 1, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Wilson</hi>: By direction of the President
                    I send you the inclosed copy of a letter from the Attorney General which
                    explains itself. The President concurs in the conclusions of the Attorney
                    General and directs that the aeroplane referred to be not permitted exportation
                    into Mexico.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Charles D. Hilles</hi>, <lb/>
                        <hi rendition="#italic">Secretary to the President.</hi>
                    </signed>
                </closer>


                <xi:include href="d1022-a1.xml" xpointer="d1022-a1"/>
            </div>
