            <div xml:id="d1195">

                <pb facs="0976" n="860" sameAs="frus:frus1912/pg860"/>

                <note rend="inline" type="source">File No. 812.00/5319.</note>
                <head>
                    <hi rendition="#italic">The American Consul at Vera
                            Cruz to the Secretary of
                    State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">Vera Cruz</hi></placeName>, <date
                            calendar="gregorian" when="1912-10-23T07:00:00-06:36">
                            <hi rendition="#italic">October 23, 1912—7 a.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>The battle has already commenced all around city.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Canada.</hi>
                    </signed>
                </closer>
            </div>
        </body>
