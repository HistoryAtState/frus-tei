            <div xml:id="d1045">

                <pb facs="0897" n="781" xml:id="pg781"/>

                <note rend="inline" type="source">File No. 812.018/25.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the American Ambassador</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-04-11T15:00:00-05:00">
                            <hi rendition="#italic">April 11, 1912—3 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>No formal representations desired in matter presented in your April 10, 11
                    a.m.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Huntington Wilson.</hi>
                    </signed>
                </closer>
            </div>
