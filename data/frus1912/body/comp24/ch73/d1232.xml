    <text>
        <body>
            <div xml:id="d1232">

                <pb facs="0998" n="882" sameAs="frus:frus1912/pg882"/>

                <note rend="inline" type="source">File No. 812.00/3040.</note>
                <head>
                    <hi rendition="#italic">The American Ambassador to
                        the Secretary of State</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 1285.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1912-02-28">
                            <hi rendition="#italic">February 28, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to the Department’s
                    telegraphic instructions of February 25 and 26, relative to the situation at
                    Ciudad Juárez, I have the honor to transmit herewith, for the information of the
                    Department, copies of my correspondence with His Excellency the President of
                    Mexico and with the Minister for Foreign Affairs on the subject.</p>
                <p>I have [etc.],</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Henry Lane Wilson.</hi>
                    </signed>
                </closer>




