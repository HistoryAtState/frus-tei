            <div xml:id="d1230">

                <pb facs="0997" n="881" sameAs="frus:frus1912/pg881"/>

                <note rend="inline" type="source">File No. 812.00/2942.</note>
                <head>
                    <hi rendition="#italic">The American Ambassador to
                        the Secretary of State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.—Extract.—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1912-02-27T17:00:00-06:36">
                            <hi rendition="#italic">February 27, 1912—5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>I sent notes this morning in the sense of the Department’s February 26, 11 p.m.,
                    to the President and the Minister for Foreign Affairs.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wilson.</hi>
                    </signed>
                </closer>
            </div>
