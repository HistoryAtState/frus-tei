    <text>
        <body>
            <div xml:id="d1223">

                <pb facs="0995" n="879" sameAs="frus:frus1912/pg879"/>

                <note rend="inline" type="source">File No. 812.00/2888.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the American Ambassador</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-02-26T15:00:00-05:00">
                            <hi rendition="#italic">February 26, 1912—3 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Last sentence of your February 24, 9 p.m.<anchor n="1" xml:id="d1223-f1"/>
                    Officially renew emphatic warning to the Mexican Government that there must
                    positively be no firing into American territory.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Huntington Wilson.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
