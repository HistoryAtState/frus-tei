    <text>
        <body>
            <div xml:id="d1354">

                <pb facs="1065" n="949" sameAs="frus:frus1912/pg949"/>

                <note rend="inline" type="source">File No. 412.11/41.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            American Ambassador</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1911-11-27">
                            <hi rendition="#italic">November 27, 1911</hi></date>.</dateline>
                </opener>
                <p>Convey to the Foreign Office the expression of this Government’s appreciation of
                    the courtesy of the Mexican Government in extending the time for the
                    presentation of claims.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Knox.</hi>
                    </signed>
                </closer>
            </div>
        </body>
