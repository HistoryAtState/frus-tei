            <div xml:id="d1388">

                <pb facs="1083" n="967" sameAs="frus:frus1912/pg967"/>

                <note rend="inline" type="source">File No. 412.11/133.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Secretary of War</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-09-18">
                            <hi rendition="#italic">September 18, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the
                    receipt of your letter of the 3d instant referring to the Joint Resolution of
                    Congress approved August 9, 1912, authorizing the War Department to investigate
                    [etc.].</p>
                <p>In reply I have the honor to enclose a list of claims of the character referred
                    to in your letter, which have been filed in the Department. This list shows the
                    names and addresses of the claimants.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Alvey A. Adee.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
