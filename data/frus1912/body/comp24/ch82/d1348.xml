                <pb facs="1062" n="946" sameAs="frus:frus1912/pg946"/>

                <note rend="inline" type="source">File No. 412.11/36.</note>
                <head>
                    <hi rendition="#italic">The American Ambassador to
                        the Secretary of State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1911-10-28">
                            <hi rendition="#italic">October 28, 1911</hi></date>.</dateline>
                </opener>
                <p>The President refuses to grant a further extension of time for filing claims
                    before the Claims Commission.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wilson.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
