    <text>
        <body>
            <div xml:id="d1375">

                <pb facs="1076" n="960" sameAs="frus:frus1912/pg960"/>

                <note rend="inline" type="source">File No. 312.11/147.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the American Ambassador</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-03-30">
                            <hi rendition="#italic">March 30, 1912</hi></date>.</dateline>
                </opener>
                <p>Department deems it inadvisable at present further to elaborate the subject of
                    your telegram of March 23, 11 a.m.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Huntington Wilson.</hi>
                    </signed>
                </closer>
            </div>
        </body>
