            <div xml:id="d1391">

                <pb facs="1084" n="968" sameAs="frus:frus1912/pg968"/>

                <note rend="inline" type="source">File No. 412.11/136.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Secretary of War</hi>.</head>
                <opener>
                    <seg rendition="#center">[Extract.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-10-08">
                            <hi rendition="#italic">October 8, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the
                    receipt of your letter of the 25th ultimo in which [etc.]</p>
                <p>I have the honor to transmit the requested memorials for your information and to
                    ask that when they have served their purpose they may be returned for the files
                    of this Department.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Huntington Wilson.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
