    <text>
        <body>
            <div xml:id="d1376">

                <pb facs="1076" n="960" sameAs="frus:frus1912/pg960"/>

                <note rend="inline" type="source">File No. 412.11/75.</note>
                <head>
                    <hi rendition="#italic">The Mexican Ambassador to the Secretary of
                    State</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 1235.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Mexican Embassy</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-04-01">
                            <hi rendition="#italic">April 1, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: In compliance with the instructions
                    received from my Government I have the honor to inform you that Mexico has <pb
                        facs="1077" n="961" xml:id="pg961"/> named commissioners at El Paso, Texas,
                    and Douglas, Arizona, to attend to the claims for damages caused during the
                    combats that occurred at Ciudad Juárez and Agua Prieta.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Gilberto Crespo y Martinez</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
