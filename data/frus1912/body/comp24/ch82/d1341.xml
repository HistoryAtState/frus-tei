    <text>
        <body>
            <div xml:id="d1341">

                <pb facs="1057" n="941" sameAs="frus:frus1912/pg941"/>

                <note rend="inline" type="source">File No. 812.032/4.</note>
                <head>
                    <hi rendition="#italic">The American Ambassador to the Secretary of
                    State</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 948.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1911-09-19">
                            <hi rendition="#italic">September 19, 1911</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit to the
                    Department clippings from the Mexican Herald and El Diario Oficial, of this city
                    containing the text in English and Spanish of the message read by President de
                    la Barra on the occasion of the opening of the first period of the Mexican
                    Congress, on the 16th instant, for the fiscal year 1911–1912.<anchor n="1"
                        xml:id="d1341-f1"/> The attention of the Department is especially called to
                    that portion of the message which relates to the attitude of the Mexican
                    Government concerning the payment of claims growing out of the recent
                    Revolution.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Henry Lane Wilson.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
