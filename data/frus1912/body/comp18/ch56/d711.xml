    <text>
        <body>
            <div xml:id="d711">

                <pb facs="0651" n="535" sameAs="frus:frus1912/pg535"/>

                <note rend="inline" type="source">File No. 838.111/63.]</note>
                <head>
                    <hi rendition="#italic">The American Ambassador to
                            Turkey to the Secretary of
                    State</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 138.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Constantinople</hi></placeName>, <date
                            calendar="gregorian" when="1912-02-16">
                            <hi rendition="#italic">February 16, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith copy
                    and translation of a note verbale received yesterday from the Sublime Porte,
                    asking the assistance of the United States Government in securing from the
                    Government of Haiti licenses to vendors of Ottoman nationality residing in the
                    Island of Haiti.</p>
                <p>I have [etc.],</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">William W. Rockhill.</hi>
                    </signed>
                </closer>


                <xi:include href="d711-a1.xml" xpointer="d711-a1"/>
            </div>
        </body>
    </text>
