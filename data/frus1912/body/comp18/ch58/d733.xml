    <text>
        <body>
            <div xml:id="d733">

                <pb facs="0663" n="547" sameAs="frus:frus1912/pg547"/>

                <note rend="inline" type="source">File No. 838.001 Au 4/2.]</note>
                <head>
                    <hi rendition="#italic">The Minister of Haiti to the
                            Secretary of State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Translation]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Legation of Haiti</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-10-03">
                            <hi rendition="#italic">October 3, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Secretary of State</hi>: I have the honor of
                    transmitting to you accompanied by the customary copy, the autograph letter, by
                    which Mr. Tancrède Auguste informs the President of the United States of America
                    of his election to the Presidency of the Republic of Haiti.</p>
                <p>In begging you to kindly let this letter reach its high destination, I renew
                    [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Solón Menos.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
