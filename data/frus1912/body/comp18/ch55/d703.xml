    <text>
        <body>
            <div xml:id="d703">

                <pb facs="0637" n="521" sameAs="frus:frus1912/pg521"/>

                <note rend="inline" type="source">File No. 838.032/8.</note>
                <head>
                    <hi rendition="#italic">The American Minister to the Secretary of
                    State</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 1093.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Port au Prince</hi></placeName>, <date
                            calendar="gregorian" when="1912-07-05">
                            <hi rendition="#italic">July 5, 1912</hi></date>.</dateline>
                </opener>
                <p>I have the honor to enclose herewith copy of the reports of the different
                    departments of the Haitian Government submitted to Congress upon the opening of
                    that body of April last.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">H. W. Furniss</hi>.</signed>
                </closer>



                <xi:include href="d703-a1.xml" xpointer="d703-a1"/>
