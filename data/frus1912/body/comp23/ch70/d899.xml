    <text>
        <body>
            <div xml:id="d899">

                <pb facs="0820" n="704" sameAs="frus:frus1912/pg704"/>

                <note rend="inline" type="source">File No. 850a.001M33.</note>
                <head>
                    <hi rendition="#italic">The American Minister to the Secretary of
                    State</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">The Hague</hi></placeName>, <date
                            calendar="gregorian" when="1912-08-07">
                            <hi rendition="#italic">August 7, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith
                    inclosed, at the request of the Minister for Foreign Affairs of Luxemburg, a
                        letter<hi rendition="#superscript">1</hi> with office copy and translation
                    thereof, by which Her Royal Highness, the Grand Duchess of the Grand Duchy of
                    Luxemburg, notifies the President of the United States of her accession to the
                    throne.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lloyd Bryce.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
