    <text>
        <body>
            <div xml:id="d1843">

                <pb facs="1472" n="1356" sameAs="frus:frus1912/pg1356"/>

                <head>
                    <hi rendition="#italic">Remarks of Mr. Knox upon placing a wreath at the foot of
                        the statue of Bolívar in Caracas, Venezuela, March 23, 1912</hi>.</head>
                <dateline>
                    <placeName>Caracas</placeName>, <date
                        ana="#date_undated-inferred-from-document-head" calendar="gregorian"
                        when="1912-03-23">March 23, 1912</date>
                </dateline>
                <p>
                    <hi rendition="#small-caps">Mr. Minister</hi>: In the name of the people and of
                    the President of the United States I beg to lay this token of appreciation,
                    respect, and veneration at the foot of the statue of the great Venezuelan
                    Liberator.</p>
                <postscript>
                    <p>[Remarks of Mr. Matos, Minister for Foreign Affairs, were extempore and not
                        taken.]</p>
                </postscript>
            </div>
