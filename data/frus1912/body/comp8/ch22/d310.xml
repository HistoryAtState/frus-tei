            <div xml:id="d310">

                <pb facs="0341" n="225" sameAs="frus:frus1912/pg225"/>

                <note rend="inline" type="source">File No. 821.032.</note>
                <head>
                    <hi rendition="#italic">The American Chargé
                            d’Affaires to the Secretary of
                        State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Extract]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 81.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Bogotá</hi></placeName>, <date
                            calendar="gregorian" when="1912-07-31">
                            <hi rendition="#italic">July 31, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith in
                    duplicate copies of the Presidential Message to the Congress of 1912, together
                    with translations of that part of the message pertaining to foreign affairs. * *
                    *</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Leland Harrison</hi>.</signed>
                </closer>


                <xi:include href="d310-a1.xml" xpointer="d310-a1"/>
            </div>
