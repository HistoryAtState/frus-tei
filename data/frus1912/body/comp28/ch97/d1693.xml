        <body>
            <div xml:id="d1693">

                <pb facs="1383" n="1267" sameAs="frus:frus1912/pg1267"/>

                <note rend="inline" type="source">File No. 834.00/105.</note>
                <head>
                    <hi rendition="#italic">The American Minister to the Secretary of
                    State</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 40, Paraguay.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Montevideo</hi></placeName>, <date
                            calendar="gregorian" when="1911-07-06">
                            <hi rendition="#italic">July 6, 1911</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor of transmitting copy of a
                    letter received today from Consul Ferris at Asuncion, giving the latest
                    political events in Paraguay.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Edwin V. Morgan.</hi>
                    </signed>
                </closer>


                <xi:include href="d1693-a1.xml" xpointer="d1693-a1"/>
            </div>
