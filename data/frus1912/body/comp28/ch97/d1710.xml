    <text>
        <body>
            <div xml:id="d1710">

                <pb facs="1390" n="1274" sameAs="frus:frus1912/pg1274"/>

                <note rend="inline" type="source">File No. 834.00/132.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the American Minister</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-05-08">
                            <hi rendition="#italic">May 8, 1912</hi></date>.</dateline>
                </opener>
                <p>The Department is withholding judgment in view of renewed political
                    disturbances.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wilson.</hi>
                    </signed>
                </closer>
            </div>
        </body>
