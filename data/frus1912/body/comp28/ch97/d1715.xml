    <text>
        <body>
            <div xml:id="d1715">

                <pb facs="1393" n="1277" sameAs="frus:frus1912/pg1277"/>

                <note rend="inline" type="source">File No. 834.001 Sch 1/1.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            Minister for Foreign Affairs</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-11-29">
                            <hi rendition="#italic">November 29, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: I have the honor to acknowledge the
                    receipt of your note of the 17th of August last, enclosing a letter, with office
                    copy, addressed to the President of the United States by His Excellency Señor
                    Don Eduardo Schaerer, announcing his elevation to the Chief Magistracy of
                    Paraguay.</p>
                <p>His Excellency’s letter has been laid before the President, whose reply will be
                    delivered to its high destination through the American Legation at
                    Montevideo.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">P. C. Knox.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
