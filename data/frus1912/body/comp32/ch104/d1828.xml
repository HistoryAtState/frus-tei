    <text>
        <body>
            <div xml:id="d1828">

                <pb facs="1467" n="1351" sameAs="frus:frus1912/pg1351"/>

                <note rend="inline" type="source">File No. 367.11/55.</note>
                <head>
                    <hi rendition="#italic">The Secretary of the Navy to
                        the Secretary of State</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Navy Department</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-11-16">
                            <hi rendition="#italic">November 16, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to inform the Department
                    of State that the U. S. S. <hi rendition="#italic">Brutus</hi>, a naval
                    auxiliary, will leave Norfolk, Va., about November 20th, or shortly thereafter,
                    for Smyrna, Turkey, with coal and supplies for naval vessels in the vicinity.
                    The <hi rendition="#italic">Brutus</hi> will call at Gibralter en route.</p>
                <p>Respectfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Geo. von L. Meyer.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
