    <text>
        <body>
            <div xml:id="d1819">

                <pb facs="1465" n="1349" sameAs="frus:frus1912/pg1349"/>

                <note rend="inline" type="source">File No. 367.11/16.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the American Ambassador to
                        Great Britain.</hi><anchor n="1" xml:id="d1819-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-11-11">
                            <hi rendition="#italic">November 11, 1912</hi></date>.</dateline>
                </opener>
                <p>Convey to Minister for Foreign Affairs the gratification of this Government upon
                    learning that its desires had been anticipated by the British Government in
                    relation to protection of Americans at Constantinople.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Knox.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1819-f1" n="1" type="source" xml:id="d1819-f1-content">
                <p>The same to the American Ambassador to Russia. (File No. 367.11/18.)</p>
            </note>
        </listAnnotation>
    </standOff>
