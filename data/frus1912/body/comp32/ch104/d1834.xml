    <text>
        <body>
            <div xml:id="d1834">

                <pb facs="1469" n="1353" sameAs="frus:frus1912/pg1353"/>

                <note rend="inline" type="source">File No. 767.70/190.</note>
                <head>
                    <hi rendition="#italic">The Secretary of the Navy to
                        the Secretary of State</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Navy Department</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-12-04">
                            <hi rendition="#italic">December 4, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to quote for the
                    information of the Department of State the following extract from a cablegram
                    dated December 4, 1912, received from the Commanding Officer of the U. S. S. <hi
                        rendition="#italic">Scorpion</hi> at Constantinople, Turkey:</p>
                <p>“Yesterday men reembarked.”</p>
                <p>Respectfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">G. von L. Meyer.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
