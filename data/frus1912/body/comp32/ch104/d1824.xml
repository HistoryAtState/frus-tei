    <text>
        <body>
            <div xml:id="d1824">

                <pb facs="1466" n="1350" sameAs="frus:frus1912/pg1350"/>

                <note rend="inline" type="source">File No. 367.11/27.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            American Ambassador to France</hi>.<anchor
                        n="1" xml:id="d1824-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-11-12">
                            <hi rendition="#italic">November 12, 1912</hi></date>.</dateline>
                </opener>
                <p>Make appropriate expression to the Minister for Foreign Affairs of this
                    Government’s appreciation of his assurances concerning protection in case of
                    need to be extended to Americans in Turkey.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Knox.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1824-f1" n="1" type="source" xml:id="d1824-f1-content">
                <p>Repeated from Paris to Vienna, Berlin, and Rome.</p>
            </note>
        </listAnnotation>
    </standOff>
