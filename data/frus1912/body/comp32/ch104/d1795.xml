    <text>
        <body>
            <div xml:id="d1795">

                <pb facs="1458" n="1342" xml:id="pg1342"/>

                <note rend="inline" type="source">File No. 767.70/33.</note>
                <head>
                    <hi rendition="#italic">The American Minister to
                            Roumania to the Secretary of
                    State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegrams.—Paraphrases.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Bucharest</hi></placeName>, <date
                            calendar="gregorian" when="1912-10-18">
                            <hi rendition="#italic">October 18, 1912</hi></date>.</dateline>
                </opener>
                <p>To-day Servia declared war with Turkey.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Jackson</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
