    <text>
        <body>
            <div xml:id="d1825">

                <pb facs="1467" n="1351" xml:id="pg1351"/>

                <note rend="inline" type="source">File No. 367.11/40.</note>
                <head>
                    <hi rendition="#italic">The American Ambassador to the Secretary of
                    State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Constantinople</hi></placeName>, <date
                            calendar="gregorian" when="1912-11-12">
                            <hi rendition="#italic">November 12, 1912</hi></date>.</dateline>
                </opener>
                <p>I have informed <hi rendition="#italic">Unalga’s</hi> commander that his services
                    will not be required in Turkish waters.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Rockhill.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
