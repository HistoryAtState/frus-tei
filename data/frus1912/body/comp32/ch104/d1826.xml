            <div xml:id="d1826">

                <pb facs="1467" n="1351" sameAs="frus:frus1912/pg1351"/>

                <note rend="inline" type="source">File No. 367.11/40.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            American Ambassador</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegrams.—Paraphrases.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-11-13">
                            <hi rendition="#italic">November 13, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#italic">Unalga</hi> will remain available at Port Said at least
                    until arrival of a cruiser at Beirut.</p>
                <closer>For the Secretary: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Adee.</hi>
                    </signed>
                </closer>
            </div>
