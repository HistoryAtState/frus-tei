            <div xml:id="d601">

                <pb facs="0528" n="412" sameAs="frus:frus1912/pg412"/>

                <note rend="inline" type="source">File No. 422.11 G93/430.]</note>
                <head>
                    <hi rendition="#italic">The American Chargé
                            d’Affaires to the Secretary of
                        State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Guayaquil</hi></placeName>, <date
                            calendar="gregorian" when="1912-02-21">
                            <hi rendition="#italic">February 21, 1912</hi></date>.</dateline>
                </opener>
                <p>The Ecuadorian Government has made no effort to fulfill its obligations to the
                    American railway company since the revolution.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bingham.</hi>
                    </signed>
                </closer>
            </div>
        </body>
