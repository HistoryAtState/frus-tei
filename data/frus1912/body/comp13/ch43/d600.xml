    <text>
        <body>
            <div xml:id="d600">

                <pb facs="0528" n="412" sameAs="frus:frus1912/pg412"/>

                <note rend="inline" type="source">File No. 422.11 G93/428.]</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the American Legation</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-02-19">
                            <hi rendition="#italic">February 19, 1912</hi></date>.</dateline>
                </opener>
                <p>Report what steps Ecuadorian Government has taken to fulfill its obligations
                    toward the Guayaquil &amp; Quito Railway Company.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wilson.</hi>
                    </signed>
                </closer>
            </div>
        </body>
