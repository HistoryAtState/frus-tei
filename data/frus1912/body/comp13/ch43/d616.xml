            <div xml:id="d616">

                <pb facs="0535" n="419" sameAs="frus:frus1912/pg419"/>

                <note rend="inline" type="source">File No. 422.11 G93/477.]</note>
                <head>
                    <hi rendition="#italic">The American Chargé d’Affaires to the Secretary of
                        State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Quito</hi></placeName>, <date
                            calendar="gregorian" when="1912-05-24">
                            <hi rendition="#italic">May 24, 1912</hi></date>.</dateline>
                </opener>
                <p>The Government of Ecuador has made a formal request for the appointment by the
                    United States of an arbitrator.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bingham.</hi>
                    </signed>
                </closer>
            </div>
        </body>
