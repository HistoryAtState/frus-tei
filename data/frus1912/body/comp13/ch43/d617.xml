    <text>
        <body>
            <div xml:id="d617">

                <pb facs="0536" n="420" xml:id="pg420"/>

                <note rend="inline" type="source">File No. 422.11 G93/477.]</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the American Chargé
                        d’Affaires</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-05-27">
                            <hi rendition="#italic">May 27, 1912</hi></date>.</dateline>
                </opener>
                <p>Has payment of the 100,000 sucres been made to the railway company?</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wilson.</hi>
                    </signed>
                </closer>
            </div>
        </body>
