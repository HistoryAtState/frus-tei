    <text>
        <body>
            <div xml:id="d598">

                <pb facs="0527" n="411" xml:id="pg411"/>

                <note rend="inline" type="source">File No. 822.001 P69/3.]</note>
                <head>
                    <hi rendition="#italic">The Chargé d’Affaires of
                            Ecuador to the Secretary of
                    State</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 197.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Legation of Ecuador</hi>, <lb/>
                            <hi rendition="#italic">New York</hi></placeName>, <date
                            calendar="gregorian" when="1912-12-04">
                            <hi rendition="#italic">December 4, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor of handing to you the
                    “Letras Autógrafas” of Gen. Leonidas Plaza G., President of Ecuador, addressed
                    to His Excellency William H. Taft, President of the United States of America,
                    informing him upon his inauguration as Constitutional President of Ecuador, on
                    the 30th of August of the present year.</p>
                <p>I avail [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">S. S. Wither y S.</hi>
                    </signed>
                </closer>


                <xi:include href="d598-a1.xml" xpointer="d598-a1"/>
            </div>
        </body>
    </text>
