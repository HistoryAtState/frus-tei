                <pb facs="0522" n="406" sameAs="frus:frus1912/pg406"/>

                <note rend="inline" type="source">File No. 822.00/280.]</note>
                <head>
                    <hi rendition="#italic">The American Minister to the
                            Secretary of State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Extract.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#small-caps">Quito</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-03-22">
                            <hi rendition="#italic">March 22, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith a
                    report, with enclosures, from Captain Constant Cordier, U. S. A., Military
                    Attaché of this Legation. * * *</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Evan E. Young.</hi>
                    </signed>
                </closer>




