    <text>
        <body>
            <div xml:id="d575">

                <pb facs="0510" n="394" sameAs="frus:frus1912/pg394"/>

                <note rend="inline" type="source">File No. 822.00/202.]</note>
                <head>
                    <hi rendition="#italic">General Montero to the
                            Secretary of State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Guayaquil</hi></placeName>, (<date
                            ana="#date_undated-inferred-from-document-content-and-sibling-dates"
                            calendar="gregorian" when="1912-01-17">undated</date>) <hi
                            rendition="#italic">received January 17, 1912</hi>.</dateline>
                </opener>
                <p>My Government will fulfill every obligation contracted by Ecuador, and fully
                    respect foreign and especially American interests.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Pedro J. Montero</hi>, <lb/>
                        <hi rendition="#italic">Jefe Supremo.</hi>
                    </signed>
                </closer>
            </div>
        </body>
