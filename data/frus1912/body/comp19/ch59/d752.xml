    <text>
        <body>
            <div xml:id="d752">

                <pb facs="0693" n="577" xml:id="pg577"/>

                <note rend="inline" type="source">File No. 815.51/241.</note>
                <head>
                    <hi rendition="#italic">The American Minister to the
                            Secretary of State</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 161.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Tegucigalpa</hi></placeName>, <date
                            calendar="gregorian" when="1911-03-25">
                            <hi rendition="#italic">March 25, 1911</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to my No. 126, of the 2nd
                        ultimo,<anchor n="1" xml:id="d752-f1"/> I have the honor to enclose copy and
                    translation of a “Manifesto of the National Congress to the Honduran People”
                    signed by most of the deputies, dated February 14, 1911, containing the reasons
                    for the action of the Congress on January 31 last in disapproving the United
                    States-Honduras Convention signed in Washington on January 10, 1911.</p>
                <p>This manifesto has not yet been published.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Fenton R. McCreery.</hi>
                    </signed>
                </closer>


                <xi:include href="d752-a1.xml" xpointer="d752-a1"/>
            </div>
        </body>
    </text>
