    <text>
        <body>
            <div xml:id="d755">

                <pb facs="0699" n="583" sameAs="frus:frus1912/pg583"/>

                <note rend="inline" type="source">File No. 815.51/260.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Chairman of the Senate
                        Committee on Foreign Relations</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1911-05-18">
                            <hi rendition="#italic">May 18, 1911</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Senator</hi>: I beg to acknowledge the
                    receipt of your letter<anchor n="1" xml:id="d755-f1"/> of the 17th instant,
                    notifying me of a meeting of the Committee on Foreign Relations to be held on
                    Wednesday next the 24th instant, at which time the treaty with Honduras will be
                    taken up for consideration, and requesting me to be present.</p>
                <p>In reply I have the honor to state that I shall be very glad to be present at the
                    meeting of the Committee.</p>
                <p>Very sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">P. C. Knox.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
