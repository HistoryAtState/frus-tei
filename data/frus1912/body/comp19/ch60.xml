                <pb facs="0735" n="619" sameAs="frus:frus1912/pg619"/>

                <head>Extradition convention between the United States and Honduras</head>
                <p>
                    <hi rendition="#italic">Treaty signed at Washington, January 15, 1909;
                        ratification advised by the Senate, January 20, 1909; ratified by the
                        President, March 1, 1909; ratified by Honduras, May 20, 1912; ratifications
                        exchanged at Washington, July 10, 1912; proclaimed, July 10, 1912.</hi>
                </p>

