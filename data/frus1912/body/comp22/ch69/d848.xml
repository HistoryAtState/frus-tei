    <text>
        <body>
            <div xml:id="d848">

                <pb facs="0787" n="671" sameAs="frus:frus1912/pg671"/>

                <note rend="inline" type="source">File No. 882.51/308C.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador of the
                        French Republic.</hi><anchor n="1" xml:id="d848-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-03-13">
                            <hi rendition="#italic">March 13, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: I have the honor to enclose
                    herewith for your information a copy of the loan agreement<anchor n="2"
                        xml:id="d848-f2"/> between the Republic of Liberia and the bankers, for the
                    refunding of the Republic’s bonded debt, which was signed on the 7th instant. A
                    duplicate original of this loan agreement will be transmitted to the French
                    Government through the diplomatic representative of Liberia to the Republic of
                    France.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Huntington Wilson.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d848-f1" n="1" type="source" xml:id="d848-f1-content">
                <p>Mutatis mutandis to the Ambassador of Great Britain and the German
                    Ambassador.</p>
            </note>
            <note corresp="#d848-f2" n="2" xml:id="d848-f2-content">
                <p>Not printed.</p>
            </note>
        </listAnnotation>
    </standOff>
