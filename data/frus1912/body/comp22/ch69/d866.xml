    <text>
        <body>
            <div xml:id="d866">

                <pb facs="0796" n="680" sameAs="frus:frus1912/pg680"/>

                <note rend="inline" type="source">File No. 882.51/400.</note>
                <head>
                    <hi rendition="#italic">The American Minister to the Secretary of
                    State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Monrovia</hi></placeName>, <date
                            calendar="gregorian" when="1912-06-25">
                            <hi rendition="#italic">June 25, 1912</hi></date>.</dateline>
                </opener>
                <p>Clark, General Receiver, awaits official notification that loan is effected by
                    July 1 before taking steps to assume control of revenues.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Crum.</hi>
                    </signed>
                </closer>
            </div>
        </body>
