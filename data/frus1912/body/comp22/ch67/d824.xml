    <text>
        <body>
            <div xml:id="d824">

                <pb facs="0776" n="660" sameAs="frus:frus1912/pg660"/>

                <note rend="inline" type="source">File No. 741.8215/58.</note>
                <head>
                    <hi rendition="#italic">The American Minister to the Secretary of
                    State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <hi
                                rendition="#italic">Monrovia</hi></placeName>, <date
                            calendar="gregorian" when="1912-06-26">
                            <hi rendition="#italic">June 26, 1912</hi></date>.</dateline>
                </opener>
                <p>My May 23. Cooper and Lomax brought to Monrovia to-day.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Crum.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
