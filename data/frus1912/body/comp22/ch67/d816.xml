    <text>
        <body>
            <div xml:id="d816">

                <pb facs="0774" n="658" xml:id="pg658"/>

                <note rend="inline" type="source">File No. 741.8215/44.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the American Ambassador to Great
                    Britain</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi>
                        </placeName>
                        <date calendar="gregorian" when="1912-04-15">
                            <hi rendition="#italic">April 15, 1912</hi></date>.</dateline>
                </opener>
                <p>Your April twelve. Express to Foreign Office high appreciation of this Government
                    regarding forbearance British Government in Liberian boundary troubles.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wilson.</hi>
                    </signed>
                </closer>
            </div>
        </body>
