    <text>
        <body>
            <div xml:id="d828">

                <pb facs="0778" n="662" sameAs="frus:frus1912/pg662"/>

                <note rend="inline" type="source">File No. 882.20.</note>
                <head>
                    <hi rendition="#italic">The American Minister to the Secretary of
                    State</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 10.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Monrovia</hi></placeName>, <date
                            calendar="gregorian" when="1911-04-17">
                            <hi rendition="#italic">April 17, 1911</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to herewith transmit a
                    copy of a dispatch received from the Liberian Government, concerning the
                    assistance which the President of the United States has intimated to the
                    Liberian Government it was his intention to lend it,<anchor n="1"
                        xml:id="d828-f1"/> in its military department.</p>
                <p>I most respectfully request that this matter receive from the Department whatever
                    action seems appropriate to it in the premises.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wm. D. Crum.</hi>
                    </signed>
                </closer>


                <xi:include href="d828-a1.xml" xpointer="d828-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d828-f1" n="1" xml:id="d828-f1-content">
                <p>See the President’s message, <ref target="#pgXXIII">p. xxiii</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
