            <div xml:id="d1538">

                <pb facs="1245" n="1129" sameAs="frus:frus1912/pg1129"/>

                <note rend="inline" type="source">File No. 817.48/6.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Secretary of the
                        American Red Cross</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-08-26">
                            <hi rendition="#italic">August 26, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to previous correspondence
                    relative to the present situation in Nicaragua, I beg to inform you that, the
                    Department is in receipt of a telegram from the American Minister at Managua,
                    Nicaragua, dated August 23rd in which he states [summary of telegram referred
                    to].</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Huntington Wilson</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
