    <text>
        <body>
            <div xml:id="d1540">

                <pb facs="1246" n="1130" sameAs="frus:frus1912/pg1130"/>

                <note rend="inline" type="source">File No. 817.48/11b.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the American Minister</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-09-05">
                            <hi rendition="#italic">September 5, 1912</hi></date>.</dateline>
                </opener>
                <p>American Red Cross authorizes further expenditure of $1,000. Food supplies will
                    be obtained as previously and shipped to Corinto on first available steamer.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Adee.</hi>
                    </signed>
                </closer>
            </div>
        </body>
