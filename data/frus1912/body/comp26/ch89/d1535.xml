    <text>
        <body>
            <div xml:id="d1535">

                <pb facs="1244" n="1128" sameAs="frus:frus1912/pg1128"/>

                <note rend="inline" type="source">File No. 817.48.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            American Minister</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-08-07">
                            <hi rendition="#italic">August 7, 1912</hi></date>.</dateline>
                </opener>
                <p>Expenditure of $1,000 for food supplies authorized by American Reel Cross, in
                    pursuance of your August 5. Supplies will be furnished for delivery to <hi
                        rendition="#italic">Justin</hi> to be held at Corinto subject to your
                    instructions. These supplies will be furnished by commissary department of Canal
                    Commission under the direction of the American Minister at Panama.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Knox</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
