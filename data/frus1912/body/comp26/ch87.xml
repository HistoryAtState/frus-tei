        <body>
            <div xml:id="ch87">

                <pb facs="1221" n="1105" sameAs="frus:frus1912/pg1105"/>

                <head>Naturalization convention between the United States and Nicaragua</head>
                <p rendition="#flush">
                    <hi rendition="#italic">Signed at Managua, December 7, 1908; ratification
                        advised by the Senate January 21, 1909; ratified by the President March 1,
                        1909; ratified by Nicaragua March 28, 1912; ratifications exchanged at
                        Managua March 28, 1912; proclaimed May 10, 1912.</hi>
                </p>

                <xi:include href="ch87/d1518.xml" xpointer="d1518"/>
