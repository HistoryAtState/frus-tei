    <text>
        <body>
            <div xml:id="d1488">

                <pb facs="1197" n="1081" sameAs="frus:frus1912/pg1081"/>

                <note rend="inline" type="source">File No. 817.51/280.</note>
                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <opener>
                    <seg rendition="#center">[Telegram.—Extract.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Managua</hi></placeName>, <date
                            calendar="gregorian" when="1911-12-26">
                            <hi rendition="#italic">December 26, 1911</hi></date>.</dateline>
                </opener>
                <p>The good offices of the United States are requested by the President of Nicaragua
                    for securing the services of an excise expert to advise as to a thorough excise
                    reform.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Gunther.</hi>
                    </signed>
                </closer>
            </div>
        </body>
