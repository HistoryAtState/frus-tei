    <text>
        <body>
            <div xml:id="d1503">

                <pb facs="1215" n="1099" sameAs="frus:frus1912/pg1099"/>

                <note rend="inline" type="source">File No. 817.51/395.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the American
                        Minister</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-03-22">
                            <hi rendition="#italic">March 22, 1912</hi></date>.</dateline>
                </opener>
                <p>Bankers have definitely instructed their representatives to drop canal
                    feature.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wilson</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
