                <pb facs="1198" n="1082" sameAs="frus:frus1912/pg1082"/>

                <note rend="inline" type="source">File No. 817.51/280.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            American Chargé d’Affaires</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.—Extract.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-01-12">
                            <hi rendition="#italic">January 12, 1912</hi></date>.</dateline>
                </opener>
                <p>Edwin A. Thayer highly recommended for excise expert by the Insular Bureau. He is
                    Chief of the Bureau of Accounts, Treasury Department, Porto Rico.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Knox.</hi>
                    </signed>
                </closer>
            </div>
