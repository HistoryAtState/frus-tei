    <text>
        <body>
            <div xml:id="d1516">

                <pb facs="1221" n="1105" xml:id="pg1105"/>

                <note rend="inline" type="source">File No. 817.51/505.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the American Minister</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-09-26">
                            <hi rendition="#italic">September 26, 1912</hi></date>.</dateline>
                </opener>
                <p>The following just received from the bankers: <quote rend="blockquote">
                        <p>The plan we submitted, and accepted by Nicaragua, involved no delay and
                            will, we trust, be promptly adopted.</p>
                    </quote>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wilson.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
