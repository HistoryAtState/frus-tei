    <text>
        <body>
            <div xml:id="d1458">

                <pb facs="1177" n="1061" sameAs="frus:frus1912/pg1061"/>

                <note rend="inline" type="source">File No. 817.00/2134.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of the
                            Navy to the Secretary of
                    State</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Navy Department</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-10-30">
                            <hi rendition="#italic">October 30, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith, for
                    the information of the Department of State, a copy of a report, dated October
                    18th, 1912, received from the Commander-in-Chief, Pacific Fleet, at Corinto,
                    concerning operations in Nicaragua.</p>
                <p>Respectfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Philip Andrews.</hi>
                    </signed>
                </closer>



                <xi:include href="d1458-a1.xml" xpointer="d1458-a1"/>
