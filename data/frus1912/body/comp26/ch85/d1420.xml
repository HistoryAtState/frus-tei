    <text>
        <body>
            <div xml:id="d1420">

                <pb facs="1133" n="1017" sameAs="frus:frus1912/pg1017"/>

                <note rend="inline" type="source">File No. 817.00/1753.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the American
                    Minister</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 4.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-01-25">
                            <hi rendition="#italic">January 25, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I enclose herewith for your information a
                    copy of a letter in regard to political conditions in Nicaragua, which General
                    Emilia no Chamorro has addressed to the Department.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">P. C. Knox.</hi>
                    </signed>
                </closer>



                <xi:include href="d1420-a1.xml" xpointer="d1420-a1"/>
