    <text>
        <body>
            <div xml:id="d1461">

                <pb facs="1181" n="1065" xml:id="pg1065"/>

                <note rend="inline" type="source">File No. 817.00/2138.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the American
                    Minister</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 64.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-11-13">
                            <hi rendition="#italic">November 13, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I enclose herewith for your information
                    copies of two letters from the Acting Secretary of War and a copy of the
                    Department’s letter in reply thereto, regarding the detention of General Mena in
                    the Canal Zone and his application for a writ of habeas corpus.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">P. C. Knox.</hi>
                    </signed>
                </closer>




                <xi:include href="d1461-a1.xml" xpointer="d1461-a1"/>
