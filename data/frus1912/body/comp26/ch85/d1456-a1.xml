    <text>
        <body>
            <div xml:id="d1456-a1">

                <pb facs="1174" n="1058" sameAs="frus:frus1912/pg1058"/>

                <opener>
                    <seg rendition="#center">[Inclosure.]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">The Commander-in-Chief, Pacific Fleet, to the Secretary
                        of the Navy</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>U. S. S. <hi rendition="#italic">Annapolis</hi>, <lb/>
                            <hi rendition="#italic">Corinto</hi></placeName>, <date
                            calendar="gregorian" when="1912-10-20">
                            <hi rendition="#italic">October 20, 1912</hi></date>.</dateline>
                </opener>
                <p>Except the landing force of <hi rendition="#italic">Cleveland</hi> [and] <hi
                        rendition="#italic">Denver</hi>, will retain force on shore until election
                    of November 3, 1912; I do not anticipate any trouble, but consider it wise to be
                    prepared.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Southerland.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
