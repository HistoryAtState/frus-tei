    <text>
        <body>
            <div xml:id="d1464">

                <pb facs="1182" n="1066" sameAs="frus:frus1912/pg1066"/>

                <note rend="inline" type="source">File No. 817.00/2145.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister for Foreign
                        Affairs of Nicaragua</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-11-16">
                            <hi rendition="#italic">November 16, 1912</hi></date>.</dateline>
                </opener>
                <p>Your cordial salutation received with thanks. Accept my sincere good wishes for
                    the continued prosperity of Nicaragua.</p>
                <closer>(For the Secretary of State.) <lb/>
                    <signed>
                        <hi rendition="#small-caps">A. A. Adee.</hi>
                    </signed>
                </closer>
            </div>
        </body>
