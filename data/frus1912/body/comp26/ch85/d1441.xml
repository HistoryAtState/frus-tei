    <text>
        <body>
            <div xml:id="d1441">

                <pb facs="1164" n="1048" sameAs="frus:frus1912/pg1048"/>

                <note rend="inline" type="source">File No. 817.00/2003a.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the American Minister</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-09-24">
                            <hi rendition="#italic">September 24, 1912</hi></date>.</dateline>
                </opener>
                <p>Repeat to the other Legations in Central America for their information and
                    guidance Department’s declaration of policy, contained in the telegram of
                    September 4, 7 p.m.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wilson.</hi>
                    </signed>
                </closer>
            </div>
        </body>
