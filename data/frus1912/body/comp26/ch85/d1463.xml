    <text>
        <body>
            <div xml:id="d1463">

                <pb facs="1182" n="1066" sameAs="frus:frus1912/pg1066"/>

                <note rend="inline" type="source">File No. 817.00/2146.</note>
                <head>
                    <hi rendition="#italic">The President of Nicaragua to
                        the President</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.—Translation.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Corinto</hi></placeName>, <date
                            calendar="gregorian" when="1912-11-14">
                            <hi rendition="#italic">November 14, 1912</hi></date>.</dateline>
                </opener>
                <p>Having been honored by the courteous hospitality of Admiral Southerland on board
                    the <hi rendition="#italic">California</hi>, I take pleasure in sending you my
                    most cordial greeting together with the expression of my high esteem for you and
                    for your country.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">President Díaz.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
