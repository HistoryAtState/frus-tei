    <text>
        <body>
            <div xml:id="d1456">

                <pb facs="1174" n="1058" sameAs="frus:frus1912/pg1058"/>

                <note rend="inline" type="source">File No. 817.00/2116.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of the
                            Navy to the Secretary of
                    State</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Navy Department</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-10-22">
                            <hi rendition="#italic">October 22, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith, for
                    the information of the Department of State, a copy of a cablegram, dated October
                    20th, 1912, received from the Commander-in-Chief, Pacific Fleet, at Corinto,
                    stating that, except the landing forces of <hi rendition="#italic"
                        >Cleveland</hi> and <hi rendition="#italic">Denver</hi>, the force now in
                    Nicaragua will be retained on shore until the election of November 3rd,
                    1912.</p>
                <p>Respectfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Beekman Winthrop.</hi>
                    </signed>
                </closer>


                <xi:include href="d1456-a1.xml" xpointer="d1456-a1"/>
            </div>
