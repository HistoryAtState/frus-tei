    <text>
        <body>
            <div xml:id="d1437">

                <pb facs="1161" n="1045" sameAs="frus:frus1912/pg1045"/>

                <note rend="inline" type="source">File No. 817.00/1959.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of the
                            Navy to the Secretary of
                    State</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Navy Department</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-09-10">
                            <hi rendition="#italic">September 10, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith, for
                    the information of the Department of State, copies of two cablegrams, dated
                    September 8th and 9th, received from the Commander-in-Chief, Pacific Fleet, U.
                    S. S. <hi rendition="#italic">Annapolis</hi>, regarding the Nicaraguan
                    revolution.</p>
                <p>Respectfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Philip Andrews.</hi>
                    </signed>
                </closer>




                <xi:include href="d1437-a1.xml" xpointer="d1437-a1"/>
