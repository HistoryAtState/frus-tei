    <text>
        <body>
            <div xml:id="d1475">

                <pb facs="1187" n="1071" sameAs="frus:frus1912/pg1071"/>

                <note rend="inline" type="source">File No. 817.00/2203.</note>
                <head>
                    <hi rendition="#italic">The American Minister to the Secretary of
                    State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Extract.]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 93.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Managua</hi></placeName>, <date
                            calendar="gregorian" when="1912-12-26">
                            <hi rendition="#italic">December 26, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to inform the Department
                    that the National Assembly in its session of December 18 canvassed the vote cast
                    at the polls on November 2, 1912, and thereupon officially declared Don Adolfo
                    Díaz and Don Fernando Solórzano elected President and Vice President,
                    respectively, for the four years beginning January 1, 1913.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">George T. Weitzel.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
