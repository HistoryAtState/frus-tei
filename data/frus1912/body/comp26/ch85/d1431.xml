    <text>
        <body>
            <div xml:id="d1431">

                <pb facs="1153" n="1037" sameAs="frus:frus1912/pg1037"/>

                <note rend="inline" type="source">File No. 817.00/1851.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the American
                        Minister</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 46.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-08-17">
                            <hi rendition="#italic">August 17, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I enclose herewith for your information a
                    copy of a despatch from the Legation at San José, in regard to the rumor that
                    the Nicaraguan Liberals threatened to invade Nicaragua from Costa Rican
                    territory.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Alvey A. Adee.</hi>
                    </signed>
                </closer>


                <xi:include href="d1431-a1.xml" xpointer="d1431-a1"/>
            </div>
