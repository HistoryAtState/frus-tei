    <text>
        <body>
            <div xml:id="d549">

                <pb facs="0496" n="380" sameAs="frus:frus1912/pg380"/>

                <note rend="inline" type="source">File No. 839.00/481.]</note>
                <head>
                    <hi rendition="#italic">The American Minister to the Dominican Republic to the
                        Secretary of State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.—Extract.—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Santo Domingo</hi></placeName>, <date
                            calendar="gregorian" when="1912-01-19">
                            <hi rendition="#italic">January 19, 1912</hi></date>.</dateline>
                </opener>
                <p>The Minister for Foreign Affairs requests me to inform you that Peynado<anchor
                        n="5" xml:id="d549-f1"/> will leave for Washington in a few days with full
                    general powers to sign a boundary protocol that will be submitted to
                    plebiscite.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Russell.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d549-f1" n="5" xml:id="d549-f1-content">
                <p>Dominican Minister to the United States.</p>
            </note>
        </listAnnotation>
