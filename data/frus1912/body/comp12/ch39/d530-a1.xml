    <text>
        <body>
            <div xml:id="d530-a1">

                <pb facs="0486" n="370" sameAs="frus:frus1912/pg370"/>

                <opener>
                    <seg rendition="#center">[Inclosure 1.]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">The American Minister to the Haitian Minister for
                        Foreign Affairs</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 658.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Port au Prince</hi></placeName>, <date
                            calendar="gregorian" when="1912-09-25">
                            <hi rendition="#italic">September 25, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I am instructed by cablegram received from
                    my Government to-day, to hand to your excellency the following: [quoting the
                    instruction of the 24th September]</p>
                <p>Copies of the maps above referred to have been transmitted by the Department of
                    State to this Legation by mail, and as soon as received will be forwarded to
                    your excellency.</p>
                <p>In the meanwhile accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">H. W. Furniss.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
