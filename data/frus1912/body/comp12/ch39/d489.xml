        <body>
            <div xml:id="d489">

                <pb facs="0458" n="342" sameAs="frus:frus1912/pg342"/>

                <note rend="inline" type="source">File No. 839.00/488.]</note>
                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <date calendar="gregorian" when="1912-01-26">
                            <hi rendition="#italic">January 26, 1912</hi></date>.</dateline>
                </opener>
                <p>Furniss telegraphs: <quote rend="blockquote">
                        <p>I am convinced that the Haitian Government earnestly desires to maintain
                            neutrality. Reports false as to shipment of arms and ammunition.</p>
                    </quote>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Knox.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
