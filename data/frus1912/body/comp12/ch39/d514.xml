    <text>
        <body>
            <div xml:id="d514">

                <pb facs="0475" n="359" xml:id="pg359"/>

                <note rend="inline" type="source">File No. 738.3915/131.]</note>
                <head>
                    <hi rendition="#italic">The American Minister to the
                            Dominican Republic to the Secretary of
                            State</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 168.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Santo Domingo</hi></placeName>, <date
                            calendar="gregorian" when="1912-07-01">
                            <hi rendition="#italic">July 1, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith
                    translations of the memoranda furnished me by the Minister for Foreign Affairs
                    containing the proposition from the Haitian Government concerning the
                    maintenance of neutrality on the frontier, and the counter-proposition from the
                    Dominican Government.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">William W. Russell.</hi>
                    </signed>
                </closer>



                <xi:include href="d514-a1.xml" xpointer="d514-a1"/>
                <xi:include href="d514-a2.xml" xpointer="d514-a2"/>
            </div>
