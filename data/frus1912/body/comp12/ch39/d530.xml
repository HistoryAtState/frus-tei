    <text>
        <body>
            <div xml:id="d530">

                <pb facs="0486" n="370" sameAs="frus:frus1912/pg370"/>

                <note rend="inline" type="source">File No. 738.3915/179.]</note>
                <head>
                    <hi rendition="#italic">The American Minister to
                            Haiti to the Secretary of
                    State</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 1138.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Port au Prince</hi></placeName>, <date
                            calendar="gregorian" when="1912-10-10">
                            <hi rendition="#italic">October 10, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to the Department’s telegram of
                    September 24th, I have the honor to enclose herewith copies of the
                    correspondence passed between this Legation and the Haitian Government regarding
                    the temporary frontier line between the Haitian and Dominican Republics.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">H. W. Furniss</hi>.</signed>
                </closer>




                <xi:include href="d530-a1.xml" xpointer="d530-a1"/>
