                <pb facs="0492" n="376" sameAs="frus:frus1912/pg376"/>

                <note rend="inline" type="source">File No. 839.00/723.]</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the American
                    Minister</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.—Extract.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-11-29">
                            <hi rendition="#italic">November 29, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#italic">Petrel</hi> will reach Santo Domingo about December
                    12.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Knox.</hi>
                    </signed>
                </closer>
            </div>
        </body>
