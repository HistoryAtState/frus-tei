        <body>
            <div xml:id="toc">

                <pb facs="0003" n="III" xml:id="pgIII"/>

                <head>Contents</head>
                <p rendition="#center">[For alphabetical index, see end of volume.]</p>
                <list type="toc">
                    <item>
                        <ref target="#pgVII">Message of the President, annual</ref>
                    </item>
                    <item>
                        <ref target="#pgXXIX">List of papers, in chronological order, with subjects
                            of correspondence</ref>
                    </item>
                    <item>Circulars: <list>
                            <item>
                                <ref target="#pg1">Territorial integrity of American States</ref>
                            </item>
                            <item>
                                <ref target="#pg2">Interchange of professors and students among the
                                    universities of the American States</ref>
                            </item>
                            <item>
                                <ref target="#pg4">Invitation to the Panama-Pacific International
                                    Exposition to be held in San Francisco in 1915</ref>
                            </item>
                            <item>
                                <ref target="#pg5">Death of the Vice President, James S.
                                    Sherman</ref>
                            </item>
                        </list>
                    </item>
                    <item>Argentina: <list>
                            <item>
                                <ref target="#pg6">Apprehension of fugitives from justice of foreign
                                    countries</ref>
                            </item>
                        </list>
                    </item>
                    <item>Austria-Hungary: <list>
                            <item>
                                <ref target="#pg7">Copyright convention between the United States
                                    and Hungary</ref>
                            </item>
                        </list>
                    </item>
                    <item>Belgium: <list>
                            <item>
                                <ref target="#pg9">Removal of discrimination against American
                                    lubricating oils</ref>
                            </item>
                        </list>
                    </item>
                    <item>Brazil: <list>
                            <item>
                                <ref target="#pg18">Message of the President, Marshal Hermes R. da
                                    Fonseca, to the Congress</ref>
                            </item>
                            <item>
                                <ref target="#pg18">American international law; report of the United
                                    States delegates to the International Commission of Jurists at
                                    Rio de Janeiro</ref>
                            </item>
                        </list>
                    </item>
                    <item>Bulgaria: <list>
                            <item>War with Turkey. (<hi rendition="#italic">See</hi> Turkey.)</item>
                        </list>
                    </item>
                    <item>Chile: <list>
                            <item>
                                <ref target="#pg44">Permission of Congress to a United States Army
                                    officer to accept service under a foreign government</ref>
                            </item>
                        </list>
                    </item>
                    <item>China: <list>
                            <item>
                                <ref target="#pg46">Revolution; abdication of the Manchu rulers;
                                    establishment of a provisional republican government; concerted
                                    action of the Powers; correspondence concerning recognition of
                                    the Republic of China</ref>
                            </item>
                            <item>
                                <ref target="#pg87">Chinese loan negotiations; conclusion of the
                                    Hukuang Railway loan; correspondence concerning proposed
                                    currency-reform, industrial-development, and reorganization
                                    loans; current-expense advances</ref>
                            </item>
                            <item>
                                <ref target="#pg159">Indemnity payments</ref>
                            </item>
                            <item>
                                <ref target="#pg161">International plan for defense of foreign
                                    settlements</ref>
                            </item>
                            <item>
                                <ref target="#pg171">Claims of American citizens against China;
                                    joint procedure of the Powers for presentation of claims</ref>
                            </item>
                            <item>
                                <ref target="#pg173">Asylum requested at the American Legation;
                                    temporary refuge offered</ref>
                            </item>
                            <item>
                                <ref target="#pg174">Search of foreign merchant vessels by rebel
                                    forces for contraband of war</ref>
                            </item>
                            <item>
                                <ref target="#pg175">Arrangement between the United States and
                                    France for reciprocal protection in China of literary and
                                    artistic property</ref>
                            </item>
                            <item>
                                <ref target="#pg178">Registration of the property of foreigners in
                                    China</ref>
                            </item>
                            <item>
                                <ref target="#pg181">Adoption of a national flag</ref>
                            </item>
                            <item>
                                <ref target="#pg182">First International Opium Conference</ref>
                            </item>
                        </list>
                    </item>
                    <item>Colombia: <list>
                            <item>
                                <ref target="#pg225">Message of the President, Don Carlos E.
                                    Restrepo, to the Congress</ref>
                            </item>
                            <item>
                                <ref target="#pg225">Claim of Gonzalo Ramos Ruiz <hi
                                        rendition="#italic">v</hi>. the United States</ref>
                            </item>
                        </list>
                    </item>
                    <item>Costa Rica: <list>
                            <item>
                                <ref target="#pg227">Message of the President, Don Ricardo Jiménez,
                                    to the Congress</ref>
                            </item>
                            <item>
                                <ref target="#pg227">Naturalization convention between the United
                                    States and Costa Rica</ref>
                            </item>
                            <item>
                                <ref target="#pg229">Visit of the Secretary of State to Costa
                                    Rica</ref>
                            </item>
                        </list>
                    </item>
                    <item>Cuba: <list>
                            <item>
                                <ref target="#pg236">Veteranista agitation; attitude of the United
                                    States</ref>
                            </item>
                            <item>
                                <ref target="#pg242">Negro uprising; attitude of the United States;
                                    protection of foreign colonies</ref>
                            </item>
                            <pb facs="0004" n="IV" xml:id="pgIV"/>
                            <item>
                                <ref target="#pg268">Assault upon the American Chargé
                                    d’Affaires</ref>
                            </item>
                            <item>
                                <ref target="#pg276">Proposal of France, Germany, and Great Britain
                                    to arbitrate with Cuba certain insurrectionary claims of their
                                    nationals arising prior to 1898</ref>
                            </item>
                            <item>
                                <ref target="#pg293">Naval station at Guantánamo</ref>
                            </item>
                            <item>
                                <ref target="#pg297">Visit of the Secretary of State to Cuba</ref>
                            </item>
                            <item>
                                <ref target="#pg304">Raising of the wreck of the U. S. S. <hi
                                        rendition="#italic">Maine</hi>
                                </ref>
                            </item>
                            <item>
                                <ref target="#pg309">Zapata swamp concession</ref>
                            </item>
                        </list>
                    </item>
                    <item>Denmark: <list>
                            <item>
                                <ref target="#pg323">Imposition in the United States of an
                                    inheritance tax on nonresident Danish heirs; application of
                                    article 7 of the treaty of 1826 between Denmark and the United
                                    States</ref>
                            </item>
                            <item>
                                <ref target="#pg333">Death of King Frederik VIII and accession of
                                    King Christian X</ref>
                            </item>
                            <item>
                                <ref target="#pg335">Presentation of a park to the Danish Government
                                    by American citizens of Danish descent</ref>
                            </item>
                        </list>
                    </item>
                    <item>Dominican Republic: <list>
                            <item>
                                <ref target="#pg339">Message of the President, Don Eladio Victoria,
                                    to the Congress</ref>
                            </item>
                            <item>
                                <ref target="#pg340">Political affairs: border warfare with Haiti;
                                    maintenance of the status quo; insurrection; resignation of
                                    President Victoria; election of President Adolfo Nouel; good
                                    offices of the United States</ref>
                            </item>
                            <item>
                                <ref target="#pg380">Arbitration of boundary dispute between the
                                    Dominican Republic and Haiti; good offices of the United
                                    States</ref>
                            </item>
                            <item>
                                <ref target="#pg387">Visit of the Secretary of State to the
                                    Dominican Republic</ref>
                            </item>
                        </list>
                    </item>
                    <item>Ecuador: <list>
                            <item>
                                <ref target="#pg391">Political affairs: insurrection; closure of
                                    ports; measures to protect American interests; request for
                                    asylum at American Legation and Consulate; attitude of the
                                    United States; succession of Provisional Presidents Freile
                                    Zaldumbide and Baquerizo Moreno; election and inauguration of
                                    President Plaza</ref>
                            </item>
                            <item>
                                <ref target="#pg412">Claims of the Guayaquil &amp; Quito Railway Co.
                                    against Ecuador; attitude of the United States; proposal of
                                    Ecuador to arbitrate</ref>
                            </item>
                            <item>
                                <ref target="#pg422">Sanitation of Guayaquil; proposal by Ecuador of
                                    a convention with the United States; visit to Guayaquil of a
                                    United States inspection commission</ref>
                            </item>
                            <item>
                                <ref target="#pg434">Attacks on Chinese citizens; good offices of
                                    the United States</ref>
                            </item>
                        </list>
                    </item>
                    <item>France: <list>
                            <item>
                                <ref target="#pg439">Presentation by France to the United States of
                                    a bust of “La France” at the Champlain celebration</ref>
                            </item>
                            <item>
                                <ref target="#pg175">Arrangement between the United States and
                                    France for reciprocal protection in China of literary and
                                    artistic property (see China)</ref>
                            </item>
                        </list>
                    </item>
                    <item>Germany: <list>
                            <item>
                                <ref target="#pg444">Wireless telegraph convention between the
                                    United States and other Powers</ref>
                            </item>
                        </list>
                    </item>
                    <item>Great Britain: <list>
                            <item>
                                <ref target="#pg467">Panama Canal tolls; exemption of vessels in the
                                    coastwise trade of the United States from payment of tolls, and
                                    other features of the Panama Canal act of August 24, 1912;
                                    objections thereto of the British Government</ref>
                            </item>
                            <item>
                                <ref target="#pg489">North Atlantic coast fisheries arbitration;
                                    agreement between the United States and Great Britain adopting,
                                    with certain modifications, the rules and method of procedure
                                    recommended in the award of 1910</ref>
                            </item>
                            <item>
                                <ref target="#pg494">Arbitration of pecuniary claims</ref>
                            </item>
                            <item>
                                <ref target="#pg494">Wreck of the British vessel <hi
                                        rendition="#italic">Titanic;</hi> consular disposition of
                                    effects of the deceased; recognition of the services of Captain
                                    Rostron</ref>
                            </item>
                            <item>
                                <ref target="#pg497">Death of Mr. Whitelaw Reid, American Ambassador
                                    to Great Britain</ref>
                            </item>
                        </list>
                    </item>
                    <item>Greece: <list>
                            <item>War with Turkey. (<hi rendition="#italic">See</hi> Turkey.)</item>
                        </list>
                    </item>
                    <item>Guatemala: <list>
                            <item>
                                <ref target="#pg500">Financial affairs; demand of Great Britain for
                                    restitution of the coffee revenues; proposal of a new bond
                                    issue; good offices of the United States</ref>
                            </item>
                            <item>
                                <ref target="#pg511">Visit of the Secretary of State to
                                    Guatemala</ref>
                            </item>
                        </list>
                    </item>
                    <item>Haiti: <list>
                            <item>
                                <ref target="#pg521">Message of President Jean Jacques Leconte to
                                    the Congress; report of the Minister for Foreign Affairs</ref>
                            </item>
                            <pb facs="0005" n="V" xml:id="pgV"/>
                            <item>
                                <ref target="#pg523">Abrogation of the right of Syrians to trade in
                                    Haiti; rights of American citizens of Syrian birth</ref>
                            </item>
                            <item>
                                <ref target="#pg541">Visit of the Secretary of State to Haiti</ref>
                            </item>
                            <item>
                                <ref target="#pg547">Death of President Leconte and recognition by
                                    the United States of President Auguste</ref>
                            </item>
                        </list>
                    </item>
                    <item>Honduras: <list>
                            <item>
                                <ref target="#pg549">Financial affairs; proposed loan convention
                                    between Honduras and the United States; proposed loan contracts;
                                    good offices of the United States; arbitration proposal</ref>
                            </item>
                            <item>
                                <ref target="#pg619">Extradition convention between the United
                                    States and Honduras</ref>
                            </item>
                            <item>
                                <ref target="#pg624">Visit of the Secretary of State to
                                    Honduras</ref>
                            </item>
                        </list>
                    </item>
                    <item>Italy: <list>
                            <item>
                                <ref target="#pg632">Termination of the war between Italy and
                                    Turkey; sovereignty of Italy over Libya; extraterritorial rights
                                    of the United States</ref>
                            </item>
                        </list>
                    </item>
                    <item>Japan: <list>
                            <item>
                                <ref target="#pg634">Death of Emperor Mutsuhito; accession to the
                                    throne of Emperor Yoshihito</ref>
                            </item>
                            <item>
                                <ref target="#pg642">Land laws of Chosen; validity of consular
                                    registration of title</ref>
                            </item>
                            <item>
                                <ref target="#pg647">Abandonment of the proposed international
                                    exposition at Tokyo</ref>
                            </item>
                        </list>
                    </item>
                    <item>Liberia: <list>
                            <item>
                                <ref target="#pg649">Message of the President to the
                                    Legislature</ref>
                            </item>
                            <item>
                                <ref target="#pg652">Disturbances on the Anglo-Liberian
                                    frontier</ref>
                            </item>
                            <item>
                                <ref target="#pg662">Reorganization of the Liberian Frontier Force
                                    under American officers</ref>
                            </item>
                            <item>
                                <ref target="#pg667">Financial affairs; conclusion of the refunding
                                    loan of 1912; constitution of the customs receivership</ref>
                            </item>
                        </list>
                    </item>
                    <item>Luxemburg: <list>
                            <item>
                                <ref target="#pg702">Death of Grand Duke William Alexander and
                                    accession to the throne of Grand Duchess Marie Adelaide</ref>
                            </item>
                        </list>
                    </item>
                    <item>Mexico: <list>
                            <item>
                                <ref target="#pg706">Messages of the President, Francisco I. Madero,
                                    to the Congress</ref>
                            </item>
                            <item>
                                <ref target="#pg708">Political affairs.—Revolution: Measures taken
                                    by the United States to prevent breach of neutrality laws and to
                                    protect American life and property in Mexico</ref>
                            </item>
                            <item>
                                <ref target="#pg878">Measures to prevent firing across the boundary
                                    line by Mexican troops</ref>
                            </item>
                            <item>
                                <ref target="#pg888">Permission for Mexican troops to pass over
                                    American soil</ref>
                            </item>
                            <item>
                                <ref target="#pg900">Closure of the port of Vera Cruz</ref>
                            </item>
                            <item>
                                <ref target="#pg903">Display of the American flag by American
                                    consular officers in Mexico</ref>
                            </item>
                            <item>
                                <ref target="#pg905">Presentation of a statue of George Washington
                                    to Mexico by American citizens residing in Mexico</ref>
                            </item>
                            <item>
                                <ref target="#pg907">Taxation of foreigners by insurrectionary
                                    forces exercising de facto authority</ref>
                            </item>
                            <item>
                                <ref target="#pg910">Discrimination against American citizens
                                    employed on Mexican railroads</ref>
                            </item>
                            <item>
                                <ref target="#pg924">The rights of asylum and of temporary
                                    refuge</ref>
                            </item>
                            <item>
                                <ref target="#pg926">Protection of Chinese subjects in Mexico by
                                    American diplomatic and consular officers; temporary refuge
                                    granted; waiver of Exclusion Act</ref>
                            </item>
                            <item>
                                <ref target="#pg929">Claims of American citizens against Mexico for
                                    damages arising from revolutionary disturbances</ref>
                            </item>
                        </list>
                    </item>
                    <item>Montenegro: <list>
                            <item>
                                <ref target="#pg1341">War with Turkey (see Turkey)</ref>
                            </item>
                        </list>
                    </item>
                    <item>Morocco: <list>
                            <item>
                                <ref target="#pg987">Relation of American protégés to the French
                                    authorities at Fez; good offices of the British Consul in the
                                    case of Mohammed ben Lehsen el Filaly</ref>
                            </item>
                        </list>
                    </item>
                    <item>Nicaragua: <list>
                            <item>
                                <ref target="#pg993">Constitution of Nicaragua, promulgated January
                                    12, 1912</ref>
                            </item>
                            <item>
                                <ref target="#pg1012">Political affairs; revolutionary plots; the
                                    Mena insurrection; breach of the Dawson Agreements and of the
                                    Washington Conventions; measures taken by the United States for
                                    protecting life and property of foreigners; arrest and detention
                                    of Mena; election by direct popular vote of Adolfo Diaz as
                                    Constitutional President from January 1, 1913</ref>
                            </item>
                            <item>
                                <ref target="#pg1071">Financial affairs; loan convention between
                                    Nicaragua and the United States submitted to the Senate,
                                    ratified by Nicaragua; loans to Nicaragua by American bankers;
                                    good offices of the United States</ref>
                            </item>
                            <pb facs="0006" n="VI" xml:id="pgVI"/>
                            <item>
                                <ref target="#pg1105">Naturalization convention between the United
                                    States and Nicaragua</ref>
                            </item>
                            <item>
                                <ref target="#pg1109">Visit of the Secretary of State to
                                    Nicaragua</ref>
                            </item>
                            <item>
                                <ref target="#pg1127">Relief of famine in Nicaragua</ref>
                            </item>
                        </list>
                    </item>
                    <item>Panama: <list>
                            <item>Panama Canal tolls; objections of Great Britain to exemption of
                                vessels in the U. S. coastwise trade. (<hi rendition="#italic"
                                    >See</hi> Great Britain.)</item>
                            <item>
                                <ref target="#pg1133">Supervision of elections by the United
                                    States</ref>
                            </item>
                            <item>
                                <ref target="#pg1165">Inauguration of President Porras</ref>
                            </item>
                            <item>
                                <ref target="#pg1167">Railway concessions to foreigners and their
                                    relation to the Canal; attitude of the United States</ref>
                            </item>
                            <item>
                                <ref target="#pg1206">Wireless telegraph installation in Panama;
                                    treaty rights of the United States</ref>
                            </item>
                            <item>
                                <ref target="#pg1240">Visit of the Secretary of State to the
                                    Republics of Central America and the Caribbean Sea</ref>
                            </item>
                            <item>
                                <ref target="#pg1250">Assault on American citizens in Panama</ref>
                            </item>
                            <item>
                                <ref target="#pg1261">Reinstatement of police officers dismissed at
                                    request of the United States</ref>
                            </item>
                        </list>
                    </item>
                    <item>Paraguay: <list>
                            <item>
                                <ref target="#pg1265">Political affairs: insurrection of
                                    February–March, 1911; coup d’état of July, 1911; various
                                    insurrections November 1911 to May 1912; presidential
                                    successions of Gondra, Jara, Rojas, Peña, Navero, and Schaerer;
                                    recognition of President Schaerer by the United States</ref>
                            </item>
                        </list>
                    </item>
                    <item>Peru: <list>
                            <item>
                                <ref target="#pg1279">Settlement of boundary dispute between Bolivia
                                    and Peru</ref>
                            </item>
                            <item>
                                <ref target="#pg1280">Sanitation of Iquitos; employment of American
                                    engineers; good offices of the United States</ref>
                            </item>
                        </list>
                    </item>
                    <item>Russia: <list>
                            <item>
                                <ref target="#pg1287">Extension by Russia of the three-mile limit of
                                    territorial waters to twelve miles for customs purposes and
                                    control of fisheries</ref>
                            </item>
                        </list>
                    </item>
                    <item>Salvador: <list>
                            <item>
                                <ref target="#pg1310">Political disturbances; attitude of the United
                                    States</ref>
                            </item>
                            <item>
                                <ref target="#pg1328">Visit of the Secretary of State to
                                    Salvador</ref>
                            </item>
                            <item>
                                <ref target="#pg1339">The coat of arms and the flag of
                                    Salvador</ref>
                            </item>
                        </list>
                    </item>
                    <item>Servia: <list>
                            <item>
                                <ref target="#pg1341">War with Turkey (see Turkey)</ref>
                            </item>
                        </list>
                    </item>
                    <item>Turkey: <list>
                            <item>
                                <ref target="#pg1341">War between Turkey and Montenegro, Servia,
                                    Bulgaria, and Greece; protection of American interests; good
                                    offices of neutral powers</ref>
                            </item>
                        </list>
                    </item>
                    <item>Venezuela: <list>
                            <item>
                                <ref target="#pg1355">Visit of the Secretary of State to
                                    Venezuela</ref>
                            </item>
                        </list>
                    </item>
                    <item>International conferences and congresses held in the United States: <list>
                            <item>
                                <ref target="#pg1365">Ninth International Red Cross Conference</ref>
                            </item>
                            <item>
                                <ref target="#pg1365">Twelfth International Congress of
                                    Navigation</ref>
                            </item>
                            <item>
                                <ref target="#pg1365">Eighth International Congress of Applied
                                    Chemistry</ref>
                            </item>
                            <item>
                                <ref target="#pg1365">International Conference on Mine
                                    Explosions</ref>
                            </item>
                            <item>
                                <ref target="#pg1365">Ninth International Congress of Hygiene and
                                    Demography</ref>
                            </item>
                        </list>
                    </item>
                </list>
            </div>
        </body>
    </text>
