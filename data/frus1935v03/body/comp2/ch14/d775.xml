            <div xml:id="d775">

                <pb facs="0880" n="768" sameAs="frus:frus1935v03/pg768"/>

                <note rend="inline" type="source">893.6359 Antimony/11: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Minister in China</hi> (<hi rendition="#italic"
                            >Johnson</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1935-01-21T14:00:00-05:00">January 21, 1935—2
                        p.m.</date></dateline>
                </opener>
                <p>14. Your despatch 3195, December 17.<anchor n="53" xml:id="d775-f1"/></p>
                <list>
                    <label>1.</label>
                    <item>Please report existing situation in regard to Hunan antimony
                        monopoly.</item>
                    <label>2.</label>
                    <item>If Foreign Office has failed to reply adequately to Legation’s note of
                        December 12, Department suggests that matter again be pressed.</item>
                </list>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
    </text>
