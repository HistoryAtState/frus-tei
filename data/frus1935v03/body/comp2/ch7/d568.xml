                <pb facs="0702" n="590" sameAs="frus:frus1935v03/pg590"/>

                <note rend="inline" type="source">893.515/586: Telegram</note>
                <head><hi rendition="#italic">The Consul General at Shanghai</hi> (<hi
                        rendition="#italic">Cunningham</hi>) <hi rendition="#italic">to the
                        Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Shanghai</hi></placeName>, <date calendar="gregorian"
                            when="1935-05-31T20:00:00+08:00">May 31, 1935—8
                        p.m.</date><lb/>[Received May 31—1:10 p.m.]</dateline>
                </opener>
                <p>273. Have seen Kung this afternoon at the Minister’s instruction. Kung informed
                    me that he desired to accept American Government’s proposal regarding payment
                    silver, writing to that effect tomorrow morning.</p>
                <p>Repeated to the Legation at Nanking.</p>
                <closer><signed><hi rendition="#small-caps">Cunningham</hi></signed></closer>
            </div>
        </body>
