    <text>
        <body>
            <div xml:id="d678">

                <pb facs="0797" n="685" xml:id="pg685"/>

                <note rend="inline" type="source">893.00/13100: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >Johnson</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peiping</hi></placeName>, <date calendar="gregorian"
                            when="1935-05-28T13:00:00+08:00">May 28, 1935—1
                        p.m.</date><lb/>[Received May 28—9 a.m.]</dateline>
                </opener>
                <p>222. Department’s 137, May 23, 2 p.m.<anchor n="4" xml:id="d678-f1"/> Ringwalt
                    reports May 27, 11 a.m., that all American citizens had returned to Yunnanfu by
                    May 12th.</p>
                <closer>For the Minister:<lb/><signed><hi rendition="#small-caps"
                        >Lockhart</hi></signed></closer>
            </div>
        </body>
    </text>
