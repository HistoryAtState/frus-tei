    <text>
        <body>
            <div xml:id="d683">

                <pb facs="0799" n="687" sameAs="frus:frus1935v03/pg687"/>

                <note rend="inline" type="source">393.1111 Bush, Henry J./30: Telegram</note>
                <head><hi rendition="#italic">The Consul at Swatow</hi> (<hi rendition="#italic"
                        >Hinke</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Swatow</hi></placeName>, <date calendar="gregorian"
                            when="1935-06-16T12:00:00+08:00">June 16,
                        1935—noon</date>.<lb/>[Received June 16—5:45 a.m.]</dateline>
                </opener>
                <p>The following telegram has been received from Drumright<anchor n="8"
                        xml:id="d683-f1"/> at Kaying: <quote rend="blockquote">
                        <p>“June 16, 10 a.m. Father Bush rescued near Huangpi by military forces
                            last night and is being escorted to Shihcheng today.”</p>
                    </quote></p>
                <p>Legation informed.</p>
                <closer><signed><hi rendition="#small-caps">Hinke</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d683-f1" n="8" xml:id="d683-f1-content">
                <p>Everett F. Drumright, Vice Consul at Shanghai, temporarily detailed to
                    Swatow.</p>
            </note>
        </listAnnotation>
    </standOff>
