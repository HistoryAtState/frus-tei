    <text>
        <body>
            <div xml:id="d221">

                <pb facs="0377" n="265" sameAs="frus:frus1935v03/pg265"/>

                <note rend="inline" type="source">793.9414/5: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Minister in China</hi>
                        (<hi rendition="#italic">Johnson</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1935-06-18T20:00:00-04:00">June 18, 1935—8 p.m.</date></dateline>
                </opener>
                <p>171. A report has been obtained from an usually reliable source<anchor n="94"
                        xml:id="d221-f1"/> that the Japanese Government is now negotiating at
                    Nanking with the Chinese Government for the purchase of Pratas Reef, situated
                    between Hong Kong and Northern Luzon. Please investigate discreetly and report
                    by telegraph.</p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d221-f1" n="94" xml:id="d221-f1-content">
                <p>Report from the Naval Attaché in Japan, quoted in letter from the Secretary of
                    the Navy to the Secretary of State, June 14, not printed.</p>
            </note>
        </listAnnotation>
    </standOff>
