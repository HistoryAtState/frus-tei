            </note>
            <note corresp="#d1065-f2" n="13" xml:id="d1065-f2-content">
                <p>Yakichiro Suma, First Secretary of the Japanese Embassy in China at Nanking.</p>
            </note>
        </listAnnotation>
    </standOff>
