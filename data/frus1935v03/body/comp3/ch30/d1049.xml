                <pb facs="1204" n="1092" sameAs="frus:frus1935v03/pg1092"/>

                <note rend="inline" type="source">393.1123 Winterle/7: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Ambassador in China</hi> (<hi rendition="#italic"
                            >Johnson</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1935-09-27T14:00:00-04:00">September 27, 1935—2
                        p.m.</date></dateline>
                </opener>
                <p>7. Your 17, September 26, 3 p.m. Department suggests for consideration that you
                    repeat to Chefoo the last paragraph of your telegram under reference.</p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
