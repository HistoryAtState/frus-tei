    <text>
        <body>
            <div xml:id="d883">

                <pb facs="1012" n="900" sameAs="frus:frus1935v03/pg900"/>

                <note rend="inline" type="source">893.6363 Manchuria/172</note>
                <head><hi rendition="#italic">The Chief of the Division of Far Eastern Affairs</hi>
                        (<hi rendition="#italic">Hornbeck</hi>) <hi rendition="#italic">to the
                        British Ambassador</hi> (<hi rendition="#italic">Lindsay</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1935-04-16">April 16, 1935</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">My Dear Mr. Ambassador</hi>: I send you herewith the
                    memorandum of oral statement in record of what was said to you this morning.</p>
                <p>The reference is, of course, to the second of the two memoranda which you handed
                    to me on April 10.<anchor n="95" xml:id="d883-f1"/></p>
                <p>I am [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Stanley K.
                    Hornbeck</hi></signed></closer>


                <xi:include href="d883-a1.xml" xpointer="d883-a1"/>
            </div>
        </body>
    </text>
    <standOff>
