                <pb facs="0994" n="882" sameAs="frus:frus1935v03/pg882"/>

                <note rend="inline" type="source">893.6363 Manchuria/139: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Ambassador in Japan</hi> (<hi
                            rendition="#italic">Grew</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1935-02-23T13:00:00-05:00">February 23, 1935—1
                        p.m.</date></dateline>
                </opener>
                <p>23. Your 36, February 21, 7 p.m. Following message (paraphrased by the
                    Department) for special representative of American oil company.</p>
                <quote rend="blockquote">
                    <p>“Your views have the support of all parties concerned. Dundas.”</p>
                </quote>
                <closer><signed><hi rendition="#small-caps">Phillips</hi></signed></closer>
            </div>
        </body>
