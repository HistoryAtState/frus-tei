    <text>
        <body>
            <div xml:id="d71">

                <pb facs="0143" n="51" xml:id="pg51"/>

                <note rend="inline" type="source">Roosevelt Papers: Telegram</note>
                <head><hi rendition="#italic">President Roosevelt to Prime Minister
                        Churchill</hi><anchor n="1" xml:id="d71-f1"/></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">secret</hi>
                        <lb/>
                        <hi rendition="#small-caps">priority</hi></seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1943-10-29">29 October 1943</date>.</dateline>
                </opener>
                <p>To the Former Naval Person from the President, Number 401. Secret and
                    personal.</p>
                <p>My immediately preceding message. Code word <hi rendition="#small-caps"
                        >Sextant</hi> is accepted.</p>
                <closer><signed><hi rendition="#small-caps">Roosevelt</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d71-f1" n="1" type="source" xml:id="d71-f1-content">
                <p>Sent to the United States Naval Attaché, London, via Navy channels.</p>
            </note>
        </listAnnotation>
