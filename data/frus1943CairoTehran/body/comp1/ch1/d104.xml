    <text>
        <body>
            <div xml:id="d104">

                <pb facs="0165" n="73" xml:id="pg73"/>

                <note rend="inline" type="source">Roosevelt
                    Papers: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in the United Kingdom</hi> (<hi rendition="#italic"
                    >Winant</hi>) <hi rendition="#italic">to the President</hi><anchor n="1" xml:id="d104-f1"/></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">secret</hi></seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1943-11-08">8 November 1943</date>.</dateline>
                </opener>
                <p>To the President from Winant.</p>
                <p>Would you object if I traveled out with our friend? He would like me to go with
                    him.</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d104-f1" n="1" type="source" xml:id="d104-f1-content">
                <p>Apparently sent via military channels.</p>
            </note>
        </listAnnotation>
