    <text>
        <body>
            <div xml:id="d32">

                <pb facs="0117" n="25" xml:id="pg25"/>

                <note rend="inline" type="source">740.0011 EW
                    1939/31080: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Egypt</hi> (<hi rendition="#italic">Kirk</hi>)
                        <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Cairo</hi></placeName>, <date calendar="gregorian"
                            when="1943-09-10">September 10, 1943</date>.</dateline>
                </opener>
                <p>1638. Today’s <hi rendition="#italic">Egyptian Mail</hi> carries a summary of
                    interview of Nahas Pasha with London <hi
                        rendition="#italic">News Chronicle</hi> reporting <hi rendition="#italic"
                        >inter alia</hi> he would welcome holding conference between Great Britain,
                    United States and Russia in Cairo and would be pleased to provide
                    facilities.</p>
                <closer><signed><hi rendition="#small-caps"
                            >Kirk</hi></signed></closer>
            </div>
        </body>
    </text>
