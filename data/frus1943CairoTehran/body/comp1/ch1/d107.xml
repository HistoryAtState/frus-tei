    <text>
        <body>
            <div xml:id="d107">

                <pb facs="0165" n="73" sameAs="frus:frus1943CairoTehran/pg73"/>

                <note rend="inline" type="source">Roosevelt Papers: Telegram</note>
                <head><hi rendition="#italic">Prime Minister Churchill to President
                        Roosevelt</hi><anchor n="1" xml:id="d107-f1"/></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">secret</hi></seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1943-11-09">9 November 1943</date>.</dateline>
                </opener>
                <p>Prime Minister to President Roosevelt. Personal and most secret. No. 496.</p>
                <pb facs="0166" n="74" xml:id="pg74"/>
                <p>Your No. 411.<anchor n="2" xml:id="d107-f2"/> You may be sure that everything is
                    being arranged. Will telegraph more fully.</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d107-f1" n="1" type="source" xml:id="d107-f1-content">
                <p>Apparently sent via military channels.</p>
            </note>
            <note corresp="#d107-f2" n="2" xml:id="d107-f2-content">
