    <text>
        <body>
            <div xml:id="d197">

                <pb facs="0253" n="161" sameAs="frus:frus1943CairoTehran/pg161"/>

                <note rend="inline" type="source">Roosevelt Papers: Telegram</note>
                <head><hi rendition="#italic">President Roosevelt to Prime Minister
                        Churchill</hi><anchor n="1" xml:id="d197-f1"/></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">secret</hi>
                        <lb/>
                        <hi rendition="#small-caps">priority</hi></seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1943-11-08">8 November 1943</date>.</dateline>
                </opener>
                <p>Number 412 from the President to the Former Naval Person secret and personal.</p>
                <p>Your 493.<anchor n="2" xml:id="d197-f2"/></p>
                <p>I accept your suggestion that “Commanders responsible” in Paragraph 3 be changed
                    to “Combined Chiefs of Staff” and have so informed Harriman and have authorized
                    him to attach agreement to the protocol.</p>
                <closer><signed><hi rendition="#small-caps">Roosevelt</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d197-f1" n="1" type="source" xml:id="d197-f1-content">
                <p>Sent to the United States Naval Attaché, London, via Navy channels.</p>
            </note>
            <note corresp="#d197-f2" n="2" xml:id="d197-f2-content">
                <p>Ante, <ref target="#pg156">p. 156</ref>.</p>
