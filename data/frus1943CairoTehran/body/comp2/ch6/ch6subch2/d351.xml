    <text>
        <body>
            <div xml:id="d351">

                <pb facs="0555" n="453" sameAs="frus:frus1943CairoTehran/pg453"/>

                <note rend="inline" type="source">Roosevelt
                    Papers: Telegram</note>
                <head><hi rendition="#italic">The President’s Special Assistant</hi> (<hi rendition="#italic"
                        >Hopkins</hi>) <hi rendition="#italic">to the Presidents
                        Secretary</hi> (<hi rendition="#italic"
                            >Early</hi>)<anchor n="1" xml:id="d351-f1"/></head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Tehran</hi></placeName>,] <date calendar="gregorian"
                            when="1943-12-02">2 December 1943.</date></dateline>
                </opener>
                <p>For Mr. Early from Mr. Hopkins</p>
                <p>Text of Teheran Communiqué<anchor n="2" xml:id="d351-f2"/> will be released for
                    publication 1300 hours Washington time, 2000 hours Moscow time, December 6th.
                    Details of release will be sent later. Please send report concerning treatment
                    of Chinese communiqué including any violations release date or unauthorized
                    premature publication facts concerning Cairo or Teheran Conferences and your
                    suggestions.</p>
            </div>
        </body>
    </text>
