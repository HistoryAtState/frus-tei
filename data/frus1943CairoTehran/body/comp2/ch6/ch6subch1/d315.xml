    <text>
        <body>
            <div xml:id="d315">

                <pb facs="0517" n="415" sameAs="frus:frus1943CairoTehran/pg415"/>

                <note rend="inline" type="source">Roosevelt
                    Papers: Telegram</note>
                <head><hi rendition="#italic">Marshal Stalin to President Roosevelt</hi><anchor n="1" xml:id="d315-f1"/></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">secret</hi>
                        <lb/>
                        <hi rendition="#small-caps">urgent</hi></seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Moscow</hi></placeName>, <date calendar="gregorian"
                            when="1943-11-25">November 25, 1943.</date></dateline>
                </opener>
                <p>Personal and strictly secret from Premier Stalin to President Roosevelt. Your message from Cairo<anchor n="2" xml:id="d315-f2"
                    /> received. I will be at your service in Teheran the evening of November
                    twenty-eighth.</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d315-f1" n="1" type="source" xml:id="d315-f1-content">
                <p>Sent by Spalding at Moscow to Harriman at Cairo, via Navy channels.</p>
            </note>
            <note corresp="#d315-f2" n="2" xml:id="d315-f2-content">
                <p>Telegram of November 22, 1943, <hi rendition="#italic">ante</hi>, <ref
                        target="#pg373">p. 373</ref>.</p>
            </note>
        </listAnnotation>
