    <text>
        <body>
            <div xml:id="d326">

                <pb facs="0537" n="435" sameAs="frus:frus1943CairoTehran/pg435"/>

                <note rend="inline" type="source">Roosevelt Papers</note>
                <head><hi rendition="#italic">The Director of Economic Operations in the Middle
                        East</hi> (<hi rendition="#italic">Landis</hi>) <hi rendition="#italic">to
                        the President’s Special Assistant</hi> (<hi rendition="#italic"
                    >Hopkins</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Cairo</hi></placeName>, <date calendar="gregorian"
                            when="1943-11-26">November 26, 1943</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Dear Harry</hi>: Herewith is a memorandum that
                        Averill<anchor n="1" xml:id="d326-f1"/> asked me to prepare for you this
                    morning.</p>
                <pb facs="0538" n="436" xml:id="pg436"/>
                <p>I am grateful to you for your kindnesses to me this morning and for the
                    opportunity that it gave me to put a few of the significant issues that we face
                    in this area.</p>
                <p>You know that at any time I am at yours and the Boss’s beck and call for
                    anything.</p>
                <p>Sincerely yours,</p>
                <closer><signed><hi rendition="#small-caps">James M. Landis</hi></signed></closer>


                <xi:include href="d326-a1.xml" xpointer="d326-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
