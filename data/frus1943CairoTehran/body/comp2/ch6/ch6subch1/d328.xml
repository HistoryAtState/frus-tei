    <text>
        <body>
            <div xml:id="d328">

                <pb facs="0540" n="438" sameAs="frus:frus1943CairoTehran/pg438"/>

                <note rend="inline" type="source">Roosevelt Papers: Telegram</note>
                <head><hi rendition="#italic">President Roosevelt to Marshal Stalin</hi><anchor
                        n="1" xml:id="d328-f1"/></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">secret</hi>
                        <lb/>
                        <hi rendition="#small-caps">operational priority</hi></seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Cairo</hi></placeName>,] <date calendar="gregorian"
                            when="1943-11-26">26 November 1943</date>.</dateline>
                </opener>
                <p>Thank you much for your message of November 23rd informing me of your intention
                    to reach Teheran on the 28th or 29th.<anchor n="2" xml:id="d328-f2"/> I expect
                    to reach there on the 27th. It will be good to see you.</p>
                <closer><signed><hi rendition="#small-caps">Roosevelt</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d328-f1" n="1" type="source" xml:id="d328-f1-content">
                <p>Sent by Harriman to Spalding at Moscow, via Navy channels, for delivery to
                    Stalin.</p>
            </note>
            <note corresp="#d328-f2" n="2" xml:id="d328-f2-content">
                <p>See <hi rendition="#italic">ante</hi>, <ref target="#pg385">p. 385</ref>.</p>
            </note>
        </listAnnotation>
