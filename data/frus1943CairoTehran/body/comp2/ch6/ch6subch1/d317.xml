    <text>
        <body>
            <div xml:id="d317">

                <pb facs="0524" n="422" sameAs="frus:frus1943CairoTehran/pg422"/>

                <note rend="inline" type="source">Roosevelt
                    Papers: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the President</hi><anchor n="1" xml:id="d317-f1"
                    /></head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1943-11-25">November 25, 1943</date>.]</dateline>
                </opener>
                <p>For the President from the Secretary of State</p>
                <p>Lisbon’s cable no. 2835 of November 23, 1943<anchor n="2" xml:id="d317-f2"/>
                    announces the departure on the preceding day of the group of Army and Navy
                    technicians from Horta for Terceira Island, and adds that the early departure of
                    these American technicians was thanks to British cooperation in Horta.</p>
                <closer><signed>C[<hi rendition="#small-caps"
                            >ordell</hi>] H[<hi rendition="#small-caps"
                        >ull</hi>]</signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d317-f1" n="1" type="source" xml:id="d317-f1-content">
                <p>Sent by the White House Map Room, via military channels.</p>
            </note>
            <note corresp="#d317-f2" n="2" xml:id="d317-f2-content">
