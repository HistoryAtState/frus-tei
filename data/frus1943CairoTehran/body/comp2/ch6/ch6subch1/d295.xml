    <text>
        <body>
            <div xml:id="d295">

                <pb facs="0487" n="385" sameAs="frus:frus1943CairoTehran/pg385"/>

                <note rend="inline" type="source">Roosevelt Papers: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the President</hi><anchor
                        n="1" xml:id="d295-f1"/></head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1943-11-23">November 23, 1943</date>.</dateline>
                </opener>
                <p>For the President from Secretary Hull</p>
                <p>Marshal Stalin, who is at the front, states that he will arrive not later than
                    the 28th or 29th at the appointed place.<anchor n="2" xml:id="d295-f2"/></p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d295-f1" n="1" type="source" xml:id="d295-f1-content">
                <p>Sent by the White House Map Room, via military channels. The message from Stalin
                    had been incorporated in a note dated November 22, 1943, from Molotov to
                    Hamilton, who transmitted it the same day to the Department in telegram 2013,
                    signed Harriman (811.001 Roosevelt, F. D./9551½).</p>
            </note>
            <note corresp="#d295-f2" n="2" xml:id="d295-f2-content">
                <p>i. e., Tehran.</p>
            </note>
        </listAnnotation>
    </standOff>
