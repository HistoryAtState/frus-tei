            </note>
            <note corresp="#d304-f2" n="2" xml:id="d304-f2-content">
                <p><hi rendition="#italic">Ante</hi>, <ref target="#pg380">p. 380</ref>.</p>
            </note>
            <note corresp="#d304-f3" n="3" xml:id="d304-f3-content">
                <p>LST’s.</p>
            </note>
            <note corresp="#d304-f4" n="4" xml:id="d304-f4-content">
                <p>The reply is printed <hi rendition="#italic">post</hi>, <ref target="#pg617">p.
                        617</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
