    <text>
        <body>
            <div xml:id="d407">

                <pb facs="0738" n="634" sameAs="frus:frus1943CairoTehran/pg634"/>

                <note rend="inline" type="source">Hopkins
                    Papers</note>
                <head><hi rendition="#italic">The President’s Special Assistant</hi> (<hi rendition="#italic"
                        >Hopkins</hi>) <hi rendition="#italic">to the President</hi><anchor n="1" xml:id="d407-f1"/></head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Tehran</hi></placeName>, <date calendar="gregorian"
                            when="1943-12-01">December 1, 1943</date>.]</dateline>
                </opener>
                <p><hi rendition="#small-caps">Mr. President</hi>: <hi rendition="#italic">It is
                        8.10.</hi></p>
                <p>Do you wish at dinner to introduce the method of our occupation of Germany after
                    her collapse.</p>
                <closer><signed><hi rendition="#small-caps"
                            >Harry</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d407-f1" n="1" type="source" xml:id="d407-f1-content">
                <p>This message, which is handwritten, was presumably passed by Hopkins to Roosevelt near the end of the tripartite political meeting,
                    December 1, 1943, <hi rendition="#italic">ante</hi>, <ref target="#pg596">p.
                        596</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
