    <standOff>
        <listAnnotation>
            <note corresp="#d506-f1" n="1" xml:id="d506-f1-content">
                <p>Not printed herein. This paper, a memorandum by the Deputy Chief of Staff,
                    Southeast Asia Command (Wedemeyer), proposed an amendment to C. C. S. 411/2,
                    which is printed <hi rendition="#italic">ante</hi>, <ref target="#pg430">p.
                        430</ref>.</p>
            </note>
            <note corresp="#d506-f2" n="2" xml:id="d506-f2-content">
                <p>Admiral Mountbatten.</p>
            </note>
            <note corresp="#d506-f3" n="3" xml:id="d506-f3-content">
                <p>Presumably Major General George E. Stratemeyer.</p>
            </note>
        </listAnnotation>
    </standOff>
