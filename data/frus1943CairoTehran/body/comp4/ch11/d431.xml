    <text>
        <body>
            <div xml:id="d431">

                <pb facs="0770" n="666" sameAs="frus:frus1943CairoTehran/pg666"/>

                <note rend="inline" type="source">Roosevelt Papers</note>
                <head><hi rendition="#italic">President Roosevelt to President Inönü</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Cairo</hi></placeName>, <date calendar="gregorian"
                            when="1943-12-03">December 3, 1943</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">My Dear President Inonu</hi>, I am sending one of my
                    own planes to meet you and your party in Adana, together with my son-in-law,
                    Major John Boettiger, who will hand this to you.</p>
                <p>The plane is in command of Major Otis F. Bryan.</p>
                <p>I hope you will have a smooth trip and I am looking forward with great pleasure
                    to seeing you on Saturday afternoon.</p>
                <p>Very sincerely yours,</p>
                <closer><signed>F[<hi rendition="#small-caps">ranklin</hi>] D R[<hi
                            rendition="#small-caps">oosevelt</hi>]</signed></closer>
            </div>
        </body>
    </text>
