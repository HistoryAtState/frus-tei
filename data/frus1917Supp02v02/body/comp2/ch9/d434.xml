            <div xml:id="d434">

                <pb facs="0535" n="1289" sameAs="frus:frus1917Supp02v02/pg1289"/>

                <note rend="inline" type="source">File No. 763.72111/5687</note>
                <head>
                    <hi rendition="#italic">The Minister in Ecuador</hi> (<hi rendition="#italic"
                            >Hartman</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Quito</hi></placeName>, <date
                            calendar="gregorian" when="1917-10-19T11:00:00-05:14">
                            <hi rendition="#italic">October 19, 1917, 11 a.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received October 20, 3.40
                        a.m.</hi>]</dateline>
                </opener>
                <p>Department’s circular October 9, 3 p.m. No restrictions imposed by Ecuador.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Hartman</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
