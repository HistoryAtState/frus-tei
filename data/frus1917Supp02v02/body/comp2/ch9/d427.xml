    <text>
        <body>
            <div xml:id="d427">

                <pb facs="0533" n="1287" sameAs="frus:frus1917Supp02v02/pg1287"/>

                <note rend="inline" type="source">File No. 763.72111/5654a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            Diplomatic Representatives in Argentina, Chile,
                            Colombia, Ecuador, Paraguay, Peru, and Venezuela
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Circular telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-10-09T15:00:00-05:00">
                            <hi rendition="#italic">October 9, 1917, 3 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Inform Department by cable what restrictions, if any, are imposed by Government
                    of country to which you are accredited upon entrance into its ports of armed
                    American merchantmen engaged in commerce.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
