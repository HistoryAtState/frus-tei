                <note rend="inline" type="source">File No. 763.72111Sp1/58</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Spain</hi> (<hi rendition="#italic"
                        >Willard</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Madrid</hi></placeName>, <date
                            calendar="gregorian" when="1917-06-29T10:00:00+00:00">
                            <hi rendition="#italic">June 29, 1917, 10 a.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 3.55 p.m.</hi>]</dateline>
                </opener>
                <p>645. Embassy’s 638, June 26, 6 p.m. Submarine sailed 3 o’clock this morning.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Willard</hi>
                    </signed>
                </closer>
            </div>
