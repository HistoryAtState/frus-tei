    <text>
        <body>
            <div xml:id="d456">

                <pb facs="0544" n="1298" sameAs="frus:frus1917Supp02v02/pg1298"/>

                <note rend="inline" type="source">File No. 763.72111Sp1/105</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Chargé in Spain</hi> (<hi rendition="#italic">Wilson</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-11-19T17:00:00-05:00">
                            <hi rendition="#italic">November 19, 1917, 5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>755. Your 879 and 880.<anchor n="3" xml:id="d456-f1"/> You may join with the
                    Allied Ambassadors in similar representations urging the Spanish Government to
                    intern the crews of German vessels now in Spanish ports.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Polk</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
