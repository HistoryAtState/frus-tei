    <text>
        <body>
            <div xml:id="d393">

                <pb facs="0501" n="1255" sameAs="frus:frus1917Supp02v02/pg1255"/>

                <head>
                    <hi rendition="#italic">Executive Order No. 2625, May 22, 1917</hi>
                </head>
                <p>In accordance with a request of the Secretary of the Navy, concurred in by the
                    United States Shipping Board, the Secretary of the <pb facs="0502" n="1256"
                        xml:id="pg1256"/> Treasury is hereby directed to transfer the following
                    German vessels to the Navy for use as colliers and cargo carriers: <list>
                        <item>Hohenfelde</item>
                        <item>Frieda Leonhardt</item>
                        <item>Nicaria</item>
                        <item>Kiel</item>
                        <item>Rudolf Blumberg</item>
                        <item>Vogesen</item>
                        <item>Breslau</item>
                        <item>Saxonia.</item>
                    </list>
                </p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Woodrow Wilson</hi>
                        
                    </signed>
                    <lb/><dateline rendition="#float-left">
                        <placeName type="venue">
                            <hi rendition="#small-caps">The White House</hi>
                        </placeName>, <lb/>
                        <date calendar="gregorian" when="1917-05-22"><hi rendition="#italic">22 May,
                                1917</hi></date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
