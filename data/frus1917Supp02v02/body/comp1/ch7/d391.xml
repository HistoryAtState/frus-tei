    <text>
        <body>
            <div xml:id="d391">

                <pb facs="0501" n="1255" sameAs="frus:frus1917Supp02v02/pg1255"/>

                <head>
                    <hi rendition="#italic">Executive Order No. 2621, May 16, 1917</hi>
                </head>
                <p>In accordance with a request of the Secretary of the Navy, concurred in by the
                    United States Shipping Board, the Secretary of the Treasury is hereby directed
                    to transfer the German vessel <hi rendition="#italic">Atlas</hi>, now at San
                    Francisco, to the Commandant of the Twelfth Naval District, for use in harbor
                    patrol.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Woodrow Wilson</hi>
                        
                    </signed>
                    <lb/><dateline rendition="#float-left">
                        <placeName type="venue">
                            <hi rendition="#small-caps">The White House</hi>
                        </placeName>, <lb/>
                        <date calendar="gregorian" when="1917-05-16"><hi rendition="#italic">16 May,
                                1917</hi></date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
