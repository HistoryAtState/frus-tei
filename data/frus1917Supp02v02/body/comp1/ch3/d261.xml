    <text>
        <body>
            <div xml:id="d261">

                <pb facs="0387" n="1141" sameAs="frus:frus1917Supp02v02/pg1141"/>

                <note rend="inline" type="source">File No. 656.119/91</note>
                <head>
                    <hi rendition="#italic">The Commercial Adviser of the British Embassy</hi>
                        (<hi
                            rendition="#italic">Crawford</hi>) <hi rendition="#italic">to
                        the Counselor for the Department of State</hi> (<hi rendition="#italic"
                            >Polk</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-10-18">
                            <hi rendition="#italic">October 18, 1917</hi></date>. <lb/> [<hi
                            rendition="#italic">Received October 19.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Counsellor</hi>: I enclose copy of a
                    letter which has been written to Mr. McCormick in reference to
                    Holland.</p>
                <p>Yours very truly,</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">R. Crawford</hi>
                        
                    </signed>
                </closer>




