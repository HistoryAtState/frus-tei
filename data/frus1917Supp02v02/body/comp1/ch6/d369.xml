    <text>
        <body>
            <div xml:id="d369">

                <pb facs="0481" n="1235" sameAs="frus:frus1917Supp02v02/pg1235"/>

                <note rend="inline" type="source">File No. 841.711/2084a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Great
                        Britain</hi> (<hi rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-06-27T15:00:00-05:00">
                            <hi rendition="#italic">June 27, 1917, 3 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>5051. Consul General reports that all letters from United States addressed to
                    American consular officers in United Kingdom are still opened by British
                    censors. Make discreet inquiry and report treatment accorded correspondence of
                    consuls of France and other Allies.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
