    <text>
        <body>
            <div xml:id="d377">

                <pb facs="0487" n="1241" sameAs="frus:frus1917Supp02v02/pg1241"/>

                <note rend="inline" type="source">File No. 811.731/208</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Great
                        Britain</hi> (<hi rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-08-15T15:00:00-05:00">
                            <hi rendition="#italic">August 15, 1917, 3 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>5301. Your 6938, August 13, 1 p.m.<anchor n="1" xml:id="d377-f1"/> Beginning
                    midnight July 25–26, naval cable censorship began to censor all cablegrams
                    passing over Atlantic cables to, from, or in transit through, the United States.
                    Notwithstanding this added censorship, the Department would not deem it wise for
                    the British authorities to relax in any way their censorship.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
