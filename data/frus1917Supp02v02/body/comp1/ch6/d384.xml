    <text>
        <body>
            <div xml:id="d384">

                <pb facs="0490" n="1244" sameAs="frus:frus1917Supp02v02/pg1244"/>

                <note rend="inline" type="source">File No. 841.711/2240</note>
                <head>
                    <hi rendition="#italic">The Counselor for the Department of State</hi> (<hi
                        rendition="#italic">Polk</hi>) <hi rendition="#italic">to the Swedish
                        Minister</hi> (<hi rendition="#italic">Ekengren</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-11-09">
                            <hi rendition="#italic">November 9, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Minister</hi>: I beg to acknowledge the
                    receipt of your personal letter to me of October 29, 1917,<anchor n="1"
                        xml:id="d384-f1"/> enclosing two letters transmitted in the Swedish
                    diplomatic pouch.</p>
                <p>The letter to Mr. Alexander Britten has been forwarded to the Censorship Board. I
                    beg to return to you the letter addressed to Mr. Einar Ekstrand, the Consul of
                    Sweden in Chicago, and refer to Department circular memorandum of July 25,
                        1917.<anchor n="2" xml:id="d384-f2"/>
                </p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Frank L. Polk</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
