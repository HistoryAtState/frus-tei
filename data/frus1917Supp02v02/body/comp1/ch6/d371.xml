    <text>
        <body>
            <div xml:id="d371">

                <pb facs="0482" n="1236" sameAs="frus:frus1917Supp02v02/pg1236"/>

                <note rend="inline" type="source">File No. 811.731/145</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Great
                        Britain</hi> (<hi rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-07-03T20:00:00-05:00">
                            <hi rendition="#italic">July 3, 1917, 8 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>5087. Your 6540, June 26, 4 p.m.<anchor n="1" xml:id="d371-f1"/> United States
                    censors do not exercise jurisdiction over transatlantic cables originating in or
                    addressed to points in continental United States, but do have jurisdiction over
                    messages in transit through continental United States for transatlantic points.
                    Messages with test word in transit through the United States to or from
                    transatlantic points will not be censored as to test word qualifications by
                    United States censors.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
