    <text>
        <body>
            <div xml:id="d11">

                <pb facs="0060" n="814" sameAs="frus:frus1917Supp02v02/pg814"/>

                <note rend="inline" type="source">File No. 763.72112/5251</note>
                <head>
                    <hi rendition="#italic">The Governor of the Federal Reserve Board</hi>
                        (<hi
                            rendition="#italic">Harding</hi>) <hi rendition="#italic">to
                        the Counselor for the Department of State</hi> (<hi rendition="#italic"
                            >Polk</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-05-10">
                            <hi rendition="#italic">May 10, 1917</hi></date>. <lb/> [<hi
                            rendition="#italic">Received May 11.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Counselor</hi>: I have just received your
                    letter of the 10th instant,<anchor n="1" xml:id="d11-f1"/> returning tentative
                    draft of the letter to all Federal Reserve Banks based upon your communication
                    of April 27.<anchor n="1" xml:id="d11-f2"/> I have taken pleasure in making the
                    change suggested by you, and have sent the circular letters out this afternoon.
                    I enclose copy for your information, as requested.</p>
                <p>Very truly yours,</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">W. P. G. Harding</hi>
                        
                    </signed>
                </closer>


                <xi:include href="d11-a1.xml" xpointer="d11-a1"/>
            </div>
