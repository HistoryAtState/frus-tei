    <text>
        <body>
            <div xml:id="d12">

                <pb facs="0062" n="816" sameAs="frus:frus1917Supp02v02/pg816"/>

                <note rend="inline" type="source">File No. 763.72112/3642</note>
                <head>
                    <hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic"
                        >Sharp</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 5421</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1917-05-04">
                            <hi rendition="#italic">May 4, 1917</hi></date>. <lb/> [<hi
                            rendition="#italic">Received May 18.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to my telegram No. 2049 of the
                    26th instant [<hi rendition="#italic">ultimo</hi>],<anchor n="1" xml:id="d12-f1"
                    /> I have the honor to transmit herewith copies of the revised French black
                        list,<anchor n="1" xml:id="d12-f2"/> which appeared in the <hi
                        rendition="#italic">Journal Officiel</hi> of the 26th ultimo, as well as a
                    communication, in copy and translation from the Foreign Office, in which it is
                    stated that the names of all American houses and persons have been removed
                    because of the measures which the American Government expects to take for the
                    suppression of trade with enemy houses.</p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. G. Sharp</hi>
                    </signed>
                </closer>


                <xi:include href="d12-a1.xml" xpointer="d12-a1"/>
            </div>
        </body>
    </text>
