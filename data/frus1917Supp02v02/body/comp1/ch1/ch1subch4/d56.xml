    <text>
        <body>
            <div xml:id="d56">

                <pb facs="0157" n="911" sameAs="frus:frus1917Supp02v02/pg911"/>

                <note rend="inline" type="source">File No. 763.72112/4161</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic"
                            >Page</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1917-07-24T19:00:00+01:00">
                            <hi rendition="#italic">July 24, 1917, 7 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received July 27, 12.10 p.m.</hi>]</dateline>
                </opener>
                <p>6830. Your 4586, March 24, 6 p.m.<anchor n="2" xml:id="d56-f1"/> Ministry of
                    Blockade would appreciate word with regard to suggestions for extension of
                    financial blockade contained in my despatch No. 6451, June 22,<anchor n="3"
                        xml:id="d56-f2"/> and whether United States would be prepared to join in
                    principle in some such action as therein outlined.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Page</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
