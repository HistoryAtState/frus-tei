    <text>
        <body>
            <div xml:id="d90">

                <pb facs="0201" n="955" sameAs="frus:frus1917Supp02v02/pg955"/>

                <note rend="inline" type="source">File No. 600.119/401</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Ambassador in Great Britain</hi> (<hi rendition="#italic"
                            >Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-09-29T19:00:00-05:00">
                            <hi rendition="#italic">September 29, 1917, 7 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>5511. Your telegram September 17.<anchor n="1" xml:id="d90-f1"/> Except for
                    certain quantity of food grains which were allowed to go to Sweden and Norway as
                    result of agreements made with Governments those countries, whereby a double
                    quantity of food grains were released for Belgian Relief, and some few other
                    special isolated cases of shipments to Norway, nothing is going to Scandinavian
                    countries.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Polk</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
