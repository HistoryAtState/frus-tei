    <text>
        <body>
            <div xml:id="d75">

                <pb facs="0185" n="939" xml:id="pg939"/>

                <note rend="inline" type="source">War Trade Board Files</note>
                <head>
                    <hi rendition="#italic">Resolution of the Exports Administrative Board, August
                        30, 1917</hi>
                </head>
                <dateline>
                    <date ana="#date_undated-inferred-from-document-head" calendar="gregorian"
                        when="1917-08-30">August 30, 1917</date>
                </dateline>
                <p>
                    <hi rendition="#small-caps">Resolved</hi> that the following instructions are
                    hereby given to the Director of the Bureau of Export Licenses: … <quote
                        rend="blockquote">
                        <p>(<hi rendition="#italic">b</hi>) All licenses to export controlled
                            commodities to Norway, Holland, Denmark and Sweden are to be withheld
                            for the present and no applications for such licenses are to be referred
                            to any of the members of the board except upon their special request,
                            provided, however, that applications for licenses to export food to
                            Norway shall be brought to Mr. White’s
                            attention.</p>
                    </quote>
                </p>
            </div>
        </body>
