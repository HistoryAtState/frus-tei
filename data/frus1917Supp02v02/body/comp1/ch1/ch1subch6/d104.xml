                <head>
                    <hi rendition="#italic">The Secretary of State to the Consul at
                        Barranquilla</hi> (<hi rendition="#italic">Guyant</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-10-16">
                            <hi rendition="#italic">October 16, 1917</hi></date>.</dateline>
                </opener>
                <p>Your October 10 regarding invoices.<anchor n="1" xml:id="d104-f1"/> Yes.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
