    <text>
        <body>
            <div xml:id="d38">

                <pb facs="0131" n="885" sameAs="frus:frus1917Supp02v02/pg885"/>

                <note rend="inline" type="source">File No. 763.72112/3873</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Italy</hi> (<hi rendition="#italic"
                        >Page</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Rome</hi></placeName>, <date
                            calendar="gregorian" when="1917-06-26T13:00:00+02:00">
                            <hi rendition="#italic">June 26, 1917, 1 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 2.35 p.m.</hi>]</dateline>
                </opener>
                <p>1003. Department circular 23d. Suggestion made to Italian Foreign Office as
                    directed. Informal inquiry what is meant by following: “Consuls will perform
                    conventional consular services without regard to British black list.”</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Nelson Page</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
