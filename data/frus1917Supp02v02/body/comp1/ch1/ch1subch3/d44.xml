    <text>
        <body>
            <div xml:id="d44">

                <pb facs="0144" n="898" sameAs="frus:frus1917Supp02v02/pg898"/>

                <note rend="inline" type="source">File No. 763.72112/3873</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Italy</hi> (<hi rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-07-06T14:00:00-05:00">
                            <hi rendition="#italic">July 6, 1917, 2 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>860. Your 1003 June 26, 1 p.m.<anchor n="1" xml:id="d44-f1"/> Phrase means that
                    consuls will continue to perform notarial, invoice, and other like conventional
                    services for firms on British black list.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
