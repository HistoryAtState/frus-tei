    <text>
        <body>
            <div xml:id="d302">

                <pb facs="0424" n="1178" xml:id="pg1178"/>

                <note rend="inline" type="source">File No. 103.96/83</note>
                <head>
                    <hi rendition="#italic">The Special Representative of the War Trade Board</hi>
                        (<hi rendition="#italic">McCormick</hi>) <hi rendition="#italic">to the
                        Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1917-11-15T16:00:00+00:00">
                            <hi rendition="#italic">November 15, 1917, 4 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received November 15, 3.40
                        p.m.</hi>]</dateline>
                </opener>
                <p>For War Trade Board:</p>
                <p>Your 5812, our 3. Taylor and I will negotiate and will try to close Swiss
                    agreement in Paris.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">McCormick</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
