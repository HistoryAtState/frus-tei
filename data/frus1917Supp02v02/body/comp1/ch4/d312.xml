    <text>
        <body>
            <div xml:id="d312">

                <pb facs="0430" n="1184" sameAs="frus:frus1917Supp02v02/pg1184"/>

                <note rend="inline" type="source">File No. 654.119/66</note>
                <head>
                    <hi rendition="#italic">The Special Representative</hi> (<hi rendition="#italic"
                        >House</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1917-12-05T19:00:00+00:00">
                            <hi rendition="#italic">December 5, 1917, 7 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received December 6, 6.50
                        a.m.</hi>]</dateline>
                </opener>
                <p>From McCormick for War Trade Board: Swiss agreement signed this afternoon.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">House</hi>
                    </signed>
                </closer>
            </div>
