    <text>
        <body>
            <div xml:id="d314">

                <pb facs="0431" n="1185" sameAs="frus:frus1917Supp02v02/pg1185"/>

                <note rend="inline" type="source">File No. 654.119/84, 90</note>
                <head>
                    <hi rendition="#italic">The Chairman of the War Trade Board</hi> (<hi rendition="#italic"
                            >McCormick</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-12-20">
                            <hi rendition="#italic">December 20, 1917</hi></date>. <lb/> [<hi
                            rendition="#italic">Received December 21.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Secretary</hi>: I enclose herewith a
                    memorandum between the War Trade Board and the Swiss Government in regard to
                    exports from the United States to Switzerland, which was signed by Cailler,
                    Roussy and Heer for the Swiss Government and myself as chairman of the War Trade
                    Board, in Paris, December 5, 1917.<anchor n="2" xml:id="d314-f1"/>
                </p>
                <p>Yours very truly,</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Vance C. McCormick</hi>
                        
                    </signed>
                </closer>



                <xi:include href="d314-a1.xml" xpointer="d314-a1"/>
                <xi:include href="d314-a2.xml" xpointer="d314-a2"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d314-f1" n="2" xml:id="d314-f1-content">
                <p>For a brief narrative of the negotiation of this agreement, see Mr. McCormick’s report to Colonel
                        House, <ref
                        target="frus1917Supp02v01#pg_400">Vol. I, p. 400</ref>.</p>
            </note>
        </listAnnotation>
