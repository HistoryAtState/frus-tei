    <text>
        <body>
            <div xml:id="d291">

                <pb facs="0416" n="1170" sameAs="frus:frus1917Supp02v02/pg1170"/>

                <note rend="inline" type="source">File No. 600.001/121</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        France</hi> (<hi rendition="#italic">Sharp</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-07-17T17:00:00-05:00">
                            <hi rendition="#italic">July 17, 1917, 5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>2456. President has set aside necessary sum to cover expenses silk conference
                    proposals.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Polk</hi>
                    </signed>
                </closer>
            </div>
