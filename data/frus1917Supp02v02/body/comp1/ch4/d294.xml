                                    </item>
                                </list>
                            </item>
                            <item>
                                <hi rendition="#italic">Switzerland:</hi>
                                <list>
                                    <item>
                                        
                                            <hi rendition="#small-caps">Grobet-Roussy</hi>
                                        
                                    </item>
                                    <item>
                                        
                                            <hi rendition="#small-caps">A. Cailler</hi>
                                        
                                    </item>
                                    <item>
                                        
