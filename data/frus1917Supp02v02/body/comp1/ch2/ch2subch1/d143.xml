    <text>
        <body>
            <div xml:id="d143">

                <pb facs="0264" n="1018" sameAs="frus:frus1917Supp02v02/pg1018"/>

                <note rend="inline" type="source">File No. 763.72/4513</note>
                <head>
                    <hi rendition="#italic">The Minister in Sweden</hi> (<hi rendition="#italic"
                        >Morris</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Stockholm</hi></placeName>, <date
                            calendar="gregorian" when="1917-05-09">
                            <hi rendition="#italic">May 9, 1917</hi></date>. <lb/> [<hi
                            rendition="#italic">Received 10.15 p.m.</hi>]</dateline>
                </opener>
                <p>346. Prime Ministers and Foreign Ministers of Denmark and Norway have arrived in
                    Sweden to-day to confer with Swedish Government regarding matters of mutual
                    interest. I learn this is for similar purpose other conferences held by these
                    three countries heretofore.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Morris</hi>
                    </signed>
                </closer>
            </div>
        </body>
