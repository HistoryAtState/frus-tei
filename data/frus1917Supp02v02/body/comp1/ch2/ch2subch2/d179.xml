    <text>
        <body>
            <div xml:id="d179">

                <pb facs="0296" n="1050" xml:id="pg1050"/>

                <note rend="inline" type="source">File No. 657.119/56</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in Norway</hi>
                        (<hi rendition="#italic">Schmedeman</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-10-08T18:00:00-05:00">
                            <hi rendition="#italic">October 8, 1917, 6 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>166. Your 318, September 21, 5 p.m.<anchor n="1" xml:id="d179-f1"/> Our policy is
                    being formulated on the basis of our being unable to continue furnishing
                    supplies to Norway while they continue their exports for the benefit of the
                    enemy. British certificates will later be superseded by export licenses.
                    Agreements entered into by Norwegian mission have been of special character and
                    except for a few minor matters have been for 68,000 tons of cereals and
                    flour.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
