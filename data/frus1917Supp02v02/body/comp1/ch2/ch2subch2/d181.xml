    <text>
        <body>
            <div xml:id="d181">

                <pb facs="0297" n="1051" sameAs="frus:frus1917Supp02v02/pg1051"/>

                <note rend="inline" type="source">File No. 659.119/65</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Minister in Denmark</hi> (<hi rendition="#italic">Egan</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-10-13T14:00:00-05:00">
                            <hi rendition="#italic">October 13, 1917, 2 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>538. Your 1306, October 2, 6 p.m.<anchor n="1" xml:id="d181-f1"/> No licenses
                    being issued for shipments to Denmark and no boats going to Denmark pending
                    negotiations. Denmark submitted information requested by Exports Administration
                    Board and understanding probably shortly. Printer’s ink in itself, for printing
                    purposes, will not be restricted.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
