    <text>
        <body>
            <div xml:id="d521">

                <pb facs="0588" n="570" sameAs="frus:frus1946v11/pg570"/>

                <note rend="inline" type="source">825.20 Missions/4–1746: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Chile</hi> (<hi rendition="#italic">Bowers</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">secret</hi></seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Santiago</hi></placeName>, <date calendar="gregorian"
                            when="1946-04-17T14:00:00-04:00">April 17, 1946—2
                        p.m.</date><lb/>[Received 4:50 p.m.]</dateline>
                </opener>
                <p>403. Mytel 384, April 10.<anchor n="33"
                        xml:id="d521-f1"/> Chief Air Mission has received letter from Chilean Air
                    Force stating that Foreign Minister<anchor n="34" xml:id="d521-f2"/> has given
                    necessary instructions to Chilean Ambassador Washington proceed with renewal
                    contract US Military Aviation Mission in accordance with proposal made by
                    General Duncan.<anchor n="35" xml:id="d521-f3"/></p>
                <closer><signed><hi rendition="#small-caps">Bowers</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d521-f1" n="33" xml:id="d521-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d521-f2" n="34" xml:id="d521-f2-content">
                <p>Joaquín Fernández Fernández.</p>
            </note>
            <note corresp="#d521-f3" n="35" xml:id="d521-f3-content">
                <p>The Acting Secretary of State notified the Ambassador in telegram 348 of July 11,
                    1946, 4 p.m. that a renewal of the Aviation Mission Agreement was accomplished
                    by an exchange of notes on April 26 and May 15, 1946 (825.20
                    Missions/6–2746).</p>
            </note>
        </listAnnotation>
    </standOff>
