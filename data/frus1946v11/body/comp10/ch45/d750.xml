    <text>
        <body>
            <div xml:id="d750">

                <pb facs="0899" n="881" xml:id="pg881"/>

                <note rend="inline" type="source">822.51/8–2646</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        Ecuador</hi> (<hi rendition="#italic">Scotten</hi>)</head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">confidential</hi>
                        <lb/> No. 1618</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1946-08-26">August 26, 1946</date>.</dateline>
                </opener>
                <p>The Acting Secretary of State transmits herewith for the information of the
                    Officer in Charge a copy of the amendatory agreement signed July 12, 1946<anchor
                        n="1" xml:id="d750-f1"/> between the Republic of Ecuador and the
                    Export-Import Bank to increase the credit of $1,200,000 authorized on July 15,
                    1943 to $1,980,000 to assist in financing the cost of constructing the
                    Guamote-Tambo Highway and also to extend the expiry date of the former agreement
                    from December 31, 1946 to June 30, 1948.</p>
            </div>
        </body>
    </text>
