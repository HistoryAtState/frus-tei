            <div xml:id="d121">

                <pb facs="0170" n="152" sameAs="frus:frus1946v11/pg152"/>

                <note rend="inline" type="source">832.61311/10–446: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Chargé in Brazil</hi> (<hi
                            rendition="#italic">Darnels</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1946-10-04T19:00:00-05:00">October 4, 1946—7
                        p.m.</date></dateline>
                </opener>
                <p>1296. Arrangements made for fourth quarter allocation 120,000 long tons wheat and
                    wheat equivalent for Brazil in addition to 8,000 long tons wheat and 52,000 tons
                    flour (wheat equivalent) previously allocated for Sep–Oct. Arrange suitable
                    publicity.</p>
                <closer><signed><hi rendition="#small-caps">Acheson</hi></signed></closer>
            </div>
        </body>
    </text>
