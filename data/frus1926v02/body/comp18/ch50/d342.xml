    <text>
        <body>
            <div xml:id="d342">

                <pb facs="0634" n="538" xml:id="pg538"/>

                <note rend="inline" type="source">882.6176 F 51/197: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Liberia</hi> (<hi rendition="#italic"
                        >Wharton</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Monrovia</hi></placeName>, <date calendar="gregorian"
                            when="1926-03-06T13:00:00-00:44"><hi rendition="#italic">March 6, 1926—1
                                p.m.</hi></date><lb/>[Received 2:38 p.m.]</dateline></opener>
                <p>19. Department’s 12.<anchor n="38" xml:id="d342-f1"/> Liberian Government
                    desiring to clear up misunderstandings and consummate negotiations despatched De
                    la Rue today with complete certified texts, documents, and official
                    explanations. Available copies will be mailed.</p>
                <closer><signed><hi rendition="#small-caps">Wharton</hi></signed></closer>
            </div>
        </body>
    </text>
