    <text>
        <body>
            <div xml:id="d367">

                <pb facs="0669" n="573" sameAs="frus:frus1926v02/pg573"/>

                <note rend="inline" type="source">882.51/1925</note>
                <head><hi rendition="#italic">The Liberian Secretary of State</hi> (<hi rendition="#italic">Barclay</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Monrovia</hi></placeName>, <date calendar="gregorian"
                            when="1926-12-09"><hi rendition="#italic">December 9,
                        1926</hi></date>.<lb/>[Received January 31, 1927.]</dateline>
                    <seg rendition="#float-left">1199/M. F.</seg></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I have the honour to advise you of
                    the approval by the Legislature of Liberia of the Loan Agreement between the
                    Government of said Republic and the Finance Corporation of America, which
                    agreement provides for certain actions to be taken by the Secretary of State of
                    the United States in circumstances therein specified.</p>
                <pb facs="0670" n="574" xml:id="pg574"/>
                <p>I transmit herewith a certified copy of said Agreement and in behalf of my
                    Government request that the Department of State of the United States will
                    undertake the obligations imposed upon it by this Agreement.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Edwin Barclay</hi></signed></closer>




                <xi:include href="d367-a1.xml" xpointer="d367-a1"/>
