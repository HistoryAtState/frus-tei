                <pb facs="0620" n="524" sameAs="frus:frus1926v02/pg524"/>

                <note rend="inline" type="source">882.51/1864: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Liberia</hi> (<hi
                            rendition="#italic">Wharton</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Monrovia</hi></placeName>, <date calendar="gregorian"
                            when="1926-02-16T12:00:00-00:44"><hi rendition="#italic">February 16,
                                1926—noon</hi></date>.<lb/>[Received 7:47 p.m.]</dateline></opener>
                <p>12. Cannot hold Legislature longer. Loan reconsidered and passed in accordance
                    with Legation’s cable number 11. Arbitration convention ratified.<anchor n="21"
                        xml:id="d333-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Wharton</hi></signed></closer>
            </div>
        </body>
    </text>
