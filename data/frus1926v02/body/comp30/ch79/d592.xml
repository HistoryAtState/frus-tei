                <pb facs="1007" n="911" xml:id="pg911"/>

                <note rend="inline" type="source">811.111Kollontay,Madame Alexandra: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Consul General at Berlin</hi> (<hi
                            rendition="#italic">Coffin</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1926-11-02T17:00:00-05:00"><hi rendition="#italic">November 2,
                                1926—5 p.m.</hi></date></dateline></opener>
                <p>Your October 20, 5 p.m. Since Madame Kollontay is inadmissible to the United
                    States under the law, no visa or transit certificate may be issued to her.</p>
                <closer><signed><hi rendition="#small-caps">Kellogg</hi></signed></closer>
            </div>
        </body>
