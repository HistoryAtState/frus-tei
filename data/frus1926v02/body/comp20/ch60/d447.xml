            <div xml:id="d447">

                <pb facs="0849" n="753" sameAs="frus:frus1926v02/pg753"/>

                <note rend="inline" type="source">881.822/110</note>
                <head><hi rendition="#italic">The Diplomatic Agent and Consul General at
                        Tangier</hi> (<hi rendition="#italic"
                        >Blake</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Tangier</hi></placeName>, <date calendar="gregorian"
                            when="1926-06-07"><hi rendition="#italic">June 7,
                        1926</hi></date>.<lb/>[Received June 28.]</dateline>
                    <seg rendition="#float-left">No. 107</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith for
                    the information of the Department, a copy of the communication which I have
                    addressed to the President of the International Commission of the Lighthouse at
                    Cape Spartel, in pursuance of the Department’s telegraphic Instruction No. 4 of
                    May 17th, 1926, 2 p.m.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Maxwell Blake</hi></signed></closer>


                <xi:include href="d447-a1.xml" xpointer="d447-a1"/>
            </div>
