                <pb facs="0929" n="833" xml:id="pg833"/>

                <note rend="inline" type="source">711.192/217a</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Minister in Panama</hi> (<hi rendition="#italic"
                            >South</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1926-08-04"><hi rendition="#italic">August 4,
                        1926</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 433</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: There is enclosed herewith for your
                    confidential information a copy of the Treaty signed with Panama on July 28,
                    1926, together with copies of the five exchanges of notes made at the same time.
                    There is also enclosed a copy of the Claims convention signed at the same
                        time.<anchor n="5" xml:id="d535-f1"/></p>
                <p>You will of course not communicate these documents to anyone until the Senate
                    shall have removed the injunction of secrecy thereon.</p>
                <p>I am [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Frank B. Kellogg</hi></signed></closer>















