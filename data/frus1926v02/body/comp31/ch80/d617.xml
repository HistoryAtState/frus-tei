    <text>
        <body>
            <div xml:id="d617">

                <pb facs="1033" n="937" sameAs="frus:frus1926v02/pg937"/>

                <note rend="inline" type="source">816.00/577</note>
                <head><hi rendition="#italic">The Chargé in Salvador</hi> (<hi
                            rendition="#italic">Engert</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><seg rendition="#center">[Extract]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >San Salvador</hi></placeName>, <date calendar="gregorian"
                            when="1926-04-04"><hi rendition="#italic">April 4,
                        1926</hi></date>.<lb/>[Received April 16.]</dateline>
                    <seg rendition="#float-left">No. 1020G</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In continuation of the Legation’s despatch
                    No. 986G of February 20, 1926, I have the honor to transmit herewith a report on
                    the general conditions prevailing in El Salvador for the period from February
                    16, 1926 to March 31, 1926.</p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">C. Van H. Engert</hi></signed></closer>


                <xi:include href="d617-a1.xml" xpointer="d617-a1"/>
            </div>
