                <pb facs="1031" n="935" sameAs="frus:frus1926v02/pg935"/>

                <note rend="inline" type="source">816.00/574</note>
                <head><hi rendition="#italic">The Chargé in Salvador</hi> (<hi rendition="#italic"
                        >Engert</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><seg rendition="#center">[Extract]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >San Salvador</hi></placeName>, <date calendar="gregorian"
                            when="1926-01-19"><hi rendition="#italic">January 19,
                        1926</hi></date>.<lb/>[Received February 23(?).]</dateline>
                    <seg rendition="#float-left">No. 960 G</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In continuation of the Legation’s despatch
                    No. 913G of November 20, 1925,<anchor n="29" xml:id="d615-f1"/> I have the honor
                    to transmit herewith a report on the general conditions prevailing in El
                    Salvador for the period from November 16, 1925, to January 15, 1926.</p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">C. Van H. Engert</hi></signed></closer>


                <xi:include href="d615-a1.xml" xpointer="d615-a1"/>
            </div>
        </body>
    </text>
