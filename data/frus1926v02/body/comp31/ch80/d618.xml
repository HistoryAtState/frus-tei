                <pb facs="1034" n="938" sameAs="frus:frus1926v02/pg938"/>

                <note rend="inline" type="source">816.00/578</note>
                <head><hi rendition="#italic">The Chargé in Salvador</hi> (<hi rendition="#italic"
                        >Engert</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >San Salvador</hi></placeName>, <date calendar="gregorian"
                            when="1926-05-07"><hi rendition="#italic">May 7,
                        1926</hi></date>.<lb/>[Received May 28(?).]</dateline>
                    <seg rendition="#float-left">No. 1046G</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In continuation of the Legation’s despatch
                    No. 1020G of April 4, 1925, I have the honor to transmit herewith a report on
                    the general conditions prevailing in El Salvador for the month of April
                    1926.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">C. Van H. Engert</hi></signed></closer>


                <xi:include href="d618-a1.xml" xpointer="d618-a1"/>
