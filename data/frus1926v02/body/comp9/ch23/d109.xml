                <pb facs="0257" n="161" sameAs="frus:frus1926v02/pg161"/>

                <note rend="inline" type="source">462.00 R 294/525: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Ambassador in France</hi> (<hi rendition="#italic"
                            >Herrick</hi>)</head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1926-06-14T15:00:00-04:00"><hi rendition="#italic">June 14, 1926—3
                                p.m.</hi></date></dateline></opener>
                <p>173. For Hill. H–59. Tour H–113, June 5, 2 p.m. The Department perceives no
                    objection to agreement extending over more than the third annuity on the terms
                    stated in paragraph 4 your telegram.</p>
                <closer><signed><hi rendition="#small-caps">Kellogg</hi></signed></closer>
            </div>
        </body>
