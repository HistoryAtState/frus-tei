    <text>
        <body>
            <div xml:id="d3">

                <pb facs="0100" n="4" sameAs="frus:frus1926v02/pg4"/>

                <note rend="inline" type="source">411.19/13</note>
                <head><hi rendition="#italic">The Colombian Minister</hi> (<hi
                            rendition="#italic">Olaya</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><seg rendition="#center">[Translation<anchor n="19" xml:id="d3-f1"
                    />]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1926-11-04"><hi rendition="#italic">November 4,
                        1926</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1226</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In compliance with instructions from my
                    Government, I have the honor to enclose with this note a memorandum concerning
                    information <pb facs="0101" n="5" xml:id="pg5"/> of an official character
                    published by the press regarding a claims convention signed by the Governments
                    of the United States of America and Panama on July 28, last.<anchor n="20"
                        xml:id="d3-f2"/></p>
                <p>I avail myself [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Enrique Olaya</hi></signed></closer>


                <xi:include href="d3-a1.xml" xpointer="d3-a1"/>
            </div>
        </body>
    </text>
