    <text>
        <body>
            <div xml:id="d261">

                <pb facs="0533" n="437" xml:id="pg437"/>

                <note rend="inline" type="source">815.00/3998: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Vice Consul at Ceiba</hi> (<hi
                            rendition="#italic">Evans</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1926-10-30T18:00:00-05:00"><hi rendition="#italic">October 30,
                                1926—6 p.m.</hi></date></dateline></opener>
                <p>Department’s October 29, 7 p.m. Navy Department advises Destroyer <hi
                        rendition="#italic">Gilmer</hi> sailed from Bluefields at 7 a.m. to-day for
                    La Ceiba. Due arrive November 1st. Repeat to Legation.</p>
                <closer><signed><hi rendition="#small-caps">Grew</hi></signed></closer>
            </div>
        </body>
    </text>
