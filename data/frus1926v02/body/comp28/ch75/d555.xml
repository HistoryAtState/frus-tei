            <div xml:id="d555">

                <pb facs="0979" n="883" sameAs="frus:frus1926v02/pg883"/>

                <note rend="inline" type="source">853.51/259: Telegram</note>
                <head><hi rendition="#italic">The Minister in Portugal</hi> (<hi rendition="#italic">Dearing</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Lisbon</hi></placeName>, <date calendar="gregorian"
                            when="1925-02-03T18:00:00+00:00"><hi rendition="#italic">February 3,
                                1925—6 p.m.</hi></date><lb/>[Received 6:45 p.m.]</dateline></opener>
                <p>5. Foreign Minister requests [on] behalf of Portuguese Treasury statement
                    supposed number bonds tobacco loan 1891 to 1896 held by American citizens.
                    Please reply by telegraph.</p>
                <closer><signed><hi rendition="#small-caps">Dearing</hi></signed></closer>
            </div>
        </body>
    </text>
