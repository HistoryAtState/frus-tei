                <pb facs="0978" n="882" sameAs="frus:frus1926v02/pg882"/>

                <note rend="inline" type="source">853.51/247: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Portugal</hi> (<hi
                            rendition="#italic">Carroll</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Lisbon</hi></placeName>, <date calendar="gregorian"
                            when="1924-10-17T10:00:00+00:00"><hi rendition="#italic">October 17,
                                1924—10 a.m.</hi></date><lb/>[Received 5:38
                    p.m.]</dateline></opener>
                <p>51. Department’s 37, October 14, 2 p.m. British bondholders will receive the
                    actual amount of sterling specified on the coupon.</p>
                <closer><signed><hi rendition="#small-caps">Carroll</hi></signed></closer>
            </div>
        </body>
    </text>
