    <text>
        <body>
            <div xml:id="d667">

                <pb facs="1096" n="1000" sameAs="frus:frus1926v02/pg1000"/>

                <note rend="inline" type="source">611.6731/83</note>
                <head><hi rendition="#italic">The High Commissioner in Turkey</hi> (<hi rendition="#italic">Bristol</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><seg rendition="#center">[Extract]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1926-07-30"><hi rendition="#italic">July 30,
                        1926</hi></date>.<lb/>[Received August 23.]</dateline>
                    <seg rendition="#float-left">No. 2008</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my telegram of July 20, 5
                        P.M.,<anchor n="38" xml:id="d667-f1"/> I have the honor to enclose herewith
                    copies of the notes exchanged on July 20, 1926,<anchor n="39" xml:id="d667-f2"/>
                    between Tewfik Rouchdi Bey, Minister of Foreign Affairs, and myself, providing
                    for an extension of six months, dating from August 20, 1926, of the Commercial
                        <hi rendition="#italic">Modus Vivendi</hi> concluded between the Minister
                    and myself on February 19 [<hi rendition="#italic">18</hi>], last.</p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Mark L. Bristol</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d667-f1" n="38" xml:id="d667-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d667-f2" n="39" xml:id="d667-f2-content">
                <p>Not printed; they were substantially the same as those exchanged on Feb. 18,
                    1926.</p>
            </note>
        </listAnnotation>
    </standOff>
