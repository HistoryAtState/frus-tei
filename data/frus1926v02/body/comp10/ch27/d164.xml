    <text>
        <body>
            <div xml:id="d164">

                <pb facs="0346" n="250" sameAs="frus:frus1926v02/pg250"/>

                <note rend="inline" type="source">441.11 W 892/81</note>
                <head><hi rendition="#italic">Mr. Spencer Phenix, Assistant to Assistant Secretary
                        of State Olds, to the Secretary of State</hi></head>
                <opener><seg rendition="#center">[Extract]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1926-11-09"><hi rendition="#italic">November 9,
                        1926</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to submit herewith a
                    report on the subject of the claims and complaints against the British
                    Government which have been lodged with the Department of State since August 18,
                    1910, the date of the last special agreement for the arbitration of pecuniary
                    claims between the two Governments.<anchor n="24" xml:id="d164-f1"/></p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Spencer Phenix</hi></signed></closer>



                <xi:include href="d164-a1.xml" xpointer="d164-a1"/>
            </div>
        </body>
    </text>
