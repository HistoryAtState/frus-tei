    <text>
        <body>
            <div xml:id="d415">

                <pb facs="0805" n="709" sameAs="frus:frus1926v02/pg709"/>

                <note rend="inline" type="source">711.12151a/99</note>
                <head><hi rendition="#italic">The Ambassador in Mexico</hi> (<hi rendition="#italic">Sheffield</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1926-07-16"><hi rendition="#italic">July 16,
                        1926</hi></date>.<lb/>[Received July 23.]</dateline>
                    <seg rendition="#float-left">No. 2534</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my telegram No. 309 of July
                    13, 1926, 1 p.m.,<anchor n="98" xml:id="d415-f1"/> with respect to the Rio
                    Grande Boundary matter, I have the honor to transmit herewith a copy and
                    translation of the note from the Foreign Office on which my telegram was
                    based.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">James R.
                    Sheffield</hi></signed></closer>


                <xi:include href="d415-a1.xml" xpointer="d415-a1"/>
            </div>
        </body>
    </text>
