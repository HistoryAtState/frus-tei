                <pb facs="0765" n="669" sameAs="frus:frus1926v02/pg669"/>

                <note rend="inline" type="source">812.6363/1985</note>
                <head><hi rendition="#italic">The Secretary of State to the Chargé in Mexico</hi>
                        (<hi rendition="#italic">Schoenfeld</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1926-10-30"><hi rendition="#italic">October 30,
                        1926</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Enclosed is the original and one copy of a
                    note addressed by me under date of October 30th to the Mexican Secretary for
                    Foreign Relations. You are instructed to deliver this note immediately upon its
                    receipt, and to advise me by telegraph of the date and hour of delivery.</p>
                <p>I am [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Frank B. Kellogg</hi></signed></closer>


                <xi:include href="d382-a1.xml" xpointer="d382-a1"/>
