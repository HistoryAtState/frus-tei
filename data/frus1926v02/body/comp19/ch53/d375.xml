    <text>
        <body>
            <div xml:id="d375">

                <pb facs="0701" n="605" sameAs="frus:frus1926v02/pg605"/>

                <note rend="inline" type="source">812.6363/1721</note>
                <head><hi rendition="#italic">The Ambassador in Mexico</hi> (<hi rendition="#italic">Sheffield</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1926-01-21"><hi rendition="#italic">January 21,
                        1926</hi></date>.<lb/>[Received January 29.]</dateline>
                    <seg rendition="#float-left">No. 1674</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Confirming my telegram No. 33 of
                    yesterday’s date, four P.M.,<anchor n="2" xml:id="d375-f1"/> transmitting for
                    the Department’s information the translation of the text of the Mexican note
                    received yesterday in reply to my note of January 8, 1926,<anchor n="3"
                        xml:id="d375-f2"/> on the subject of the Mexican land and petroleum alien
                    laws, I have the honor herewith to enclose a copy with translation of the note
                    in question.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">James R.
                    Sheffield</hi></signed></closer>


                <xi:include href="d375-a1.xml" xpointer="d375-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
