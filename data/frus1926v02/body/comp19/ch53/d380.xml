    <text>
        <body>
            <div xml:id="d380">

                <pb facs="0738" n="642" sameAs="frus:frus1926v02/pg642"/>

                <note rend="inline" type="source">812.6363/1906</note>
                <head><hi rendition="#italic">The Secretary of State to the Ambassador in
                        Mexico</hi> (<hi rendition="#italic">Sheffield</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1926-07-30"><hi rendition="#italic">July 30,
                        1926</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. Ambassador</hi>: I enclose the original and
                    three copies of another note relating to the Alien Land and Petroleum Laws. It
                    is my idea that this note should be delivered immediately to the <pb facs="0739"
                        n="643" xml:id="pg643"/> Minister of Foreign Affairs, unless you feel that
                    on account of existing circumstances delivery should be deferred, and unless you
                    wish to suggest some change in the note itself. …</p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>I am [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Frank B. Kellogg</hi></signed></closer>


                <xi:include href="d380-a1.xml" xpointer="d380-a1"/>
            </div>
        </body>
    </text>
