            <div xml:id="d406">

                <pb facs="0789" n="693" sameAs="frus:frus1926v02/pg693"/>

                <note rend="inline" type="source">812.81/4</note>
                <head><hi rendition="#italic">The Ambassador in Mexico</hi> (<hi rendition="#italic">Sheffield</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1926-05-12"><hi rendition="#italic">May 12,
                        1926</hi></date>.<lb/>[Received May 20.]</dateline>
                    <seg rendition="#float-left">No. 2217</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith
                    enclosed for the Department’s information, copy and translation of an Executive
                    Decree <pb facs="0790" n="694" xml:id="pg694"/> from the <hi rendition="#italic"
                        >Diario Oficial</hi> of May 7, 1926 in regard to the procedure to be
                    followed by the agrarian authorities in the matter of the restitution and
                    dotation of waters.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">James R.
                    Sheffield</hi></signed></closer>


                <xi:include href="d406-a1.xml" xpointer="d406-a1"/>
            </div>
        </body>
