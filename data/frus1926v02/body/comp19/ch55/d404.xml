                <pb facs="0784" n="688" sameAs="frus:frus1926v02/pg688"/>

                <note rend="inline" type="source">812.52/1376</note>
                <head><hi rendition="#italic">The Ambassador in Mexico</hi> (<hi rendition="#italic"
                        >Sheffield</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1926-05-20"><hi rendition="#italic">May 20,
                        1926</hi></date>.<lb/>[Received May 28.]</dateline>
                    <seg rendition="#float-left">No. 2264</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith
                    enclosed for the Department’s information, the translation of the Law of
                    Colonization, based on article 27, which appeared in <hi rendition="#italic"
                        >Excelsior</hi> of May 20, 1926, together with five copies in the original
                    Spanish.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">James R.
                    Sheffield</hi></signed></closer>


                <xi:include href="d404-a1.xml" xpointer="d404-a1"/>
            </div>
