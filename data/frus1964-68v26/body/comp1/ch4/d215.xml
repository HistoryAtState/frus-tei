    <text>
        <body>
            <div xml:id="d215">

                <pb facs="0487" n="449" sameAs="frus:frus1964-68v26/pg449"/>

                <head>215. Memorandum From Secretary of State Rusk to President Johnson<anchor n="1" xml:id="d215-f1"/>
                </head>
                <opener><dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            when="1966-08-01">August 1, 1966</date>.</dateline></opener>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>National Security Council Meeting, August 4, 1966</item>
                </list>
                <p>I enclose a paper on Indonesia for discussion in the National Security Council
                    meeting on August 4, 1966.<anchor n="2" xml:id="d215-f2"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Dean Rusk
                        </hi><anchor n="3" xml:id="d215-f3"/>
                    </signed>
                </closer>



                <xi:include href="d215-a1.xml" xpointer="d215-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d215-f1" n="1" type="source" xml:id="d215-f1-content">
                <p>Source: National Archives and Records Administration, RG 59, Central Files
                    1964–66, POL 23–9 INDON. Secret. There is no
                    drafting officer indicated on the memorandum.</p>
            </note>
            <note corresp="#d215-f2" n="2" xml:id="d215-f2-content">
                <p>For a record of the discussion, see <ref target="#d217">Document 217</ref>.</p>
            </note>
            <note corresp="#d215-f3" n="3" xml:id="d215-f3-content">
                <p>Printed from a copy that indicates Rusk
                    signed the original.</p>
            </note>
        </listAnnotation>
