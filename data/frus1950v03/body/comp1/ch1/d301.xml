            <note corresp="#d301-f1" n="1" xml:id="d301-f1-content">
                <p>The draft text for the last paragraph had been transmitted in telegram 3122,
                    December 6, <ref target="#pg525">p. 525</ref>.</p>
            </note>
            <note corresp="#d301-f2" n="2" xml:id="d301-f2-content">
                <p>Transmitted in telegram 2987, November 29, <ref target="#pg496">p. 496</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
