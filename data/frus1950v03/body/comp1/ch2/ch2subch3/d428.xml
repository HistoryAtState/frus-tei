            </note>
            <note corresp="#d428-f3" n="2" xml:id="d428-f3-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d428-f4" n="3" xml:id="d428-f4-content">
                <p>Séan MacBride, President, Committee of Ministers, Council of Europe.</p>
            </note>
        </listAnnotation>
    </standOff>
