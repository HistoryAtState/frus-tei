    <text>
        <body>
            <div xml:id="d636">

                <pb facs="0700" n="690" xml:id="pg690"/>

                <note rend="inline" type="source">711.62114A/9–1444: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Minister in Sweden</hi> (<hi rendition="#italic"
                            >Johnson</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-09-14T12:00:00-04:00">September 14,
                            1944—noon.</date>
                    </dateline>
                </opener>
                <p>1834. Please inform Boheman<anchor n="63" xml:id="d636-f1"/> that this Government
                    expects the immediate release from internment of one American airman for each
                    German soldier offered the choice either of remaining in Sweden or returning to
                    Germany (third paragraph your 3566, September 8, 10 PM<anchor n="64"
                        xml:id="d636-f2"/>).</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d636-f1" n="63" xml:id="d636-f1-content">
                <p>Erik C. Boheman, Secretary General of the Swedish Ministry for Foreign
                    Affairs.</p>
            </note>
            <note corresp="#d636-f2" n="64" xml:id="d636-f2-content">
                <p>Not printed.</p>
            </note>
        </listAnnotation>
