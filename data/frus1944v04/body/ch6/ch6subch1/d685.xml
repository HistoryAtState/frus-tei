            <div xml:id="d685">

                <pb facs="0747" n="737" sameAs="frus:frus1944v04/pg737"/>

                <note rend="inline" type="source">740.00112 European War 1939/11119: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the United Kingdom</hi> (<hi
                        rendition="#italic">Winant</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1944-06-25T22:00:00+02:00">June 25, 1944—10
                            p.m.</date>
                        <lb/> [Received June 25—8:35 p.m.]</dateline>
                </opener>
                <p>5047. For Department and FEA from Lovitt. Reference your 5005, June 24. Embassy
                    and MEW agree with reference telegram which has been relayed to Bern and MEW has
                    sent instructions to British Minister to join in action contemplated.
                    [Lovitt.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Winant</hi>
                    </signed>
                </closer>
            </div>
        </body>
