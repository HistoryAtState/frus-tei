                <pb facs="0995" n="985" sameAs="frus:frus1944v04/pg985"/>

                <note rend="inline" type="source">033.1161/8–1544: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in the Soviet Union</hi> (<hi
                            rendition="#italic">Harriman</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-08-22T18:00:00-04:00">August 22, 1944—6
                            p.m.</date>
                    </dateline>
                </opener>
                <p>2004. Reurtel 3001, August 15, 9 p.m. The President has personally requested that
                    you take up again with Molotov the question of General Fleming’s visit. In your
                    conversation with Molotov you are authorized to express the personal interest of
                    the President in this case.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
