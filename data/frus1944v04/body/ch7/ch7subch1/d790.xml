    <text>
        <body>
            <div xml:id="d790">

                <pb facs="0873" n="863" sameAs="frus:frus1944v04/pg863"/>

                <note rend="inline" type="source">858.711/2: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in the Soviet Union</hi> (<hi
                        rendition="#italic">Hamilton</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Moscow</hi></placeName>, <date
                            calendar="gregorian" when="1944-04-28">April 28,
                        1944</date>.<lb/>[Received April 28—3:15 p.m.]</dateline>
                </opener>
                <p>1478. Moscow papers for April 26 publish a Tass despatch from Stockholm reporting
                    the decision of the Swedish Ministry for Foreign Affairs to revoke the
                    privileges formerly enjoyed by Germany for sending mail through Sweden and the
                    withdrawal of railroad cars with German personnel.<anchor n="46"
                        xml:id="d790-f1"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hamilton</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
