    <text>
        <body>
            <div xml:id="d1217">

                <pb facs="1322" n="1312" sameAs="frus:frus1944v04/pg1312"/>

                <note rend="inline" type="source">740.0011 European War 1939/34815</note>
                <head>
                    <hi rendition="#italic">The Apostolic Delegate at Washington</hi> (<hi
                        rendition="#italic">Cicognani</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-06-12">June 12, 1944</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I have the honor to
                    submit the enclosed Memorandum which contains the substance of a communication
                    just received from His Eminence, the Cardinal Secretary of State, in reference
                    to the Allied occupation of Rome.</p>
                <p>With the assurances of my highest considerations, and of my deep personal regard,
                    I remain</p>
                <p>Yours very sincerely,</p>
                <closer>
                    <signed>A. G. <hi rendition="#small-caps">Cicognani</hi>
                    </signed>
                    <lb/>
                    <hi rendition="#italic">Archbishop of Laodicea</hi>
                </closer>


                <xi:include href="d1217-a1.xml" xpointer="d1217-a1"/>
            </div>
        </body>
    </text>
