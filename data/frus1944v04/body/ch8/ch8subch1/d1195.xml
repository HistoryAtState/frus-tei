            <div xml:id="d1195">

                <pb facs="1305" n="1295" sameAs="frus:frus1944v04/pg1295"/>

                <note rend="inline" type="source">740.0011 European War 1939/33642</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Apostolic Delegate at Washington</hi> (<hi
                            rendition="#italic">Cicognani</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-04-15">April 15, 1944</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Archbishop</hi>: I have received your two
                    letters respectively dated March 18 and 22, 1944 with further reference to
                    aerial attacks on Rome.</p>
                <p>You may rest assured that your communications have been receiving appropriate
                    consideration.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Cordell Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
