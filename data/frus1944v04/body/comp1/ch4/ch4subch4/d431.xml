    <text>
        <body>
            <div xml:id="d431">

                <pb facs="0459" n="449" sameAs="frus:frus1944v04/pg449"/>

                <note rend="inline" type="source">852.79662/10–644: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        Spain</hi> (<hi rendition="#italic">Hayes</hi>)<anchor n="79"
                        xml:id="d431-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-10-24T20:00:00-04:00">October 24, 1944—8
                            p.m.</date>
                    </dateline>
                </opener>
                <p>2863. Reference Department’s 2721 October 6, midnight.<anchor n="80"
                        xml:id="d431-f2"/> The Foreign Office has informed our Embassy at London
                    that instructions have been sent to the British Ambassadors at Madrid and Lisbon
                    to make representations supporting our stand regarding suspension of
                    Lufthansa.</p>
                <p>Caffery<anchor n="81" xml:id="d431-f3"/> was informed on October 14 that the
                    French representative at Madrid would be similarly instructed.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stettinius</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d431-f1" n="79" type="source" xml:id="d431-f1-content">
                <p>Repeated to the Minister in Portugal as No. 2794.</p>
            </note>
            <note corresp="#d431-f2" n="80" xml:id="d431-f2-content">
                <p>See footnote 78, <ref target="#pg448">p. 448</ref>.</p>
            </note>
            <note corresp="#d431-f3" n="81" xml:id="d431-f3-content">
                <p>Jefferson Caffery, appointed United States representative to the <hi
                        rendition="#italic">de facto</hi> French Authority at Paris on September 21,
                    1944.</p>
            </note>
        </listAnnotation>
    </standOff>
