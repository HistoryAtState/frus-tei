            </note>
            <note corresp="#d423-f4" n="72" xml:id="d423-f4-content">
                <p>Generalissimo Francisco Franco, Spanish Chief of State.</p>
            </note>
            <note corresp="#d423-f5" n="73" xml:id="d423-f5-content">
                <p>September 11.</p>
            </note>
        </listAnnotation>
