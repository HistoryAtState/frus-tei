    <text>
        <body>
            <div xml:id="d399">

                <pb facs="0426" n="416" sameAs="frus:frus1944v04/pg416"/>

                <note rend="inline" type="source">740.0011 European War 1939/34391: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Spain</hi> (<hi rendition="#italic"
                            >Hayes</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-05-30T19:00:00-04:00">May 30, 1944—7
                            p.m.</date>
                    </dateline>
                </opener>
                <p>1549. Algiers 1744, May 27, 4 p.m., repeated by courier to Madrid and Tangier.
                    Please concert action with your British colleague<anchor n="34" xml:id="d399-f1"
                    /> and make firm representations urgently.</p>
                <p>Sent to Madrid, repeated to Algiers and Tangier.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d399-f1" n="34" xml:id="d399-f1-content">
                <p>Sir Samuel Hoare.</p>
            </note>
        </listAnnotation>
    </standOff>
