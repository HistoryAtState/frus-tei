    <text>
        <body>
            <div xml:id="d320">

                <pb facs="0314" n="304" sameAs="frus:frus1944v04/pg304"/>

                <note rend="inline" type="source">852.6363/1262: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Spain</hi> (<hi rendition="#italic"
                            >Hayes</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-01-27T19:00:00-04:00">January 27, 1944—7
                            p.m.</date>
                    </dateline>
                </opener>
                <p>219. Your 235, January 26 and your 195, January 21.<anchor n="26"
                        xml:id="d320-f1"/> You are authorized to notify Spaniards that February 21
                    and 22 loadings have been suspended.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
