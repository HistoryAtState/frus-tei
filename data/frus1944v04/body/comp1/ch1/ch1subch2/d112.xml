            <div xml:id="d112">

                <pb facs="0112" n="102" sameAs="frus:frus1944v04/pg102"/>

                <note rend="inline" type="source">811.20 Defense (M) Portugal/1476: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Brazil</hi> (<hi
                            rendition="#italic">Caffery</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Rio de Janeiro</hi></placeName>, <date
                            calendar="gregorian" when="1944-04-26T14:00:00-03:00">April 26, 1944—2
                            p.m.</date>
                        <lb/> [Received 4:30 p.m.]</dateline>
                </opener>
                <p>1545. Aranha says, in reference to Department’s telegram 1325 of April 25, 11
                    p.m., that he will send at once appropriate instructions to João Neves.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Caffery</hi>
                    </signed>
                </closer>
            </div>
        </body>
