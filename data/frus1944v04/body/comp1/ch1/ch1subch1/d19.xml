            </note>
            <note corresp="#d19-f2" n="46" xml:id="d19-f2-content">
                <p>Neither printed.</p>
            </note>
            <note corresp="#d19-f3" n="47" xml:id="d19-f3-content">
                <p>Capt. William G. Tomlinson, Commander U.S. Naval Forces, Azores.</p>
            </note>
