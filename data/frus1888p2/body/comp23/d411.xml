        <body>
            <div xml:id="d411">

                <pb facs="0685" n="1645" xml:id="pg1645"/>

                <head>No. 1124.<lb/><hi rendition="#italic">Mr. Scott to Mr. Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Carácas</hi></placeName>, <date calendar="gregorian"
                            when="1888-05-24"><hi rendition="#italic">May</hi> 24, 1888</date>.
                        (Received June 4.)</dateline>
                    <seg rendition="#float-left">No. 237.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit to you the
                    inclosed letter from President Lopez, of Venezuela, to President Cleveland.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charles L. Scott.</hi></signed></closer>


                <xi:include href="d411-a1.xml" xpointer="d411-a1"/>
