                <pb facs="0614" n="1574" sameAs="frus:frus1888p2/pg1574"/>

                <head>No. 1076.<lb/><hi rendition="#italic">Mr. Bayard to Mr. Straus.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1888-04-14"><hi rendition="#italic">April</hi> 14,
                        1888</date>.</dateline>
                    <seg rendition="#float-left">No. 92.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose for your information a copy of a
                    dispatch from Mr. H. M. Jewett, United States consul at Sivas, No. 33, of March
                    10,1888, concerning the attitude of the Turkish provincial authorities toward
                    American mission schools.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. F. Bayard.</hi></signed></closer>









