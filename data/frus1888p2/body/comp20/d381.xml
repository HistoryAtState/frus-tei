        <body>
            <div xml:id="d381">

                <pb facs="0647" n="1607" sameAs="frus:frus1888p2/pg1607"/>

                <head>No. 1094.<lb/><hi rendition="#italic">Mr. Bayard to Mr. King.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1888-09-21"><hi rendition="#italic">September</hi> 21,
                        1888</date>.</dateline>
                    <seg rendition="#float-left">No. 134.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit for your information and files a
                    copy of a protest from H. A. Proios, dated the 24th ultimo, in his case.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. F. Bayard.</hi></signed></closer>





