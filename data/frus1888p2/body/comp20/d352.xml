    <text>
        <body>
            <div xml:id="d352">

                <pb facs="0602" n="1562" xml:id="pg1562"/>

                <head>No. 1065.<lb/><hi rendition="#italic">Mr. Bayard to Mr. Straus.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1888-02-21"><hi rendition="#italic">February</hi> 21,
                        1888</date>.</dateline>
                    <seg rendition="#float-left">No. 74.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have received your dispatch No. 57, of
                    the 28th ultimo, relative to the prohibition against foreign Jews settling in
                    Jerusalem, and desire to approve your reported action in respect of American
                    citizens of that faith residing there as discreet and proper.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. F. Bayard.</hi></signed></closer>
            </div>
        </body>
    </text>
