        <body>
            <div xml:id="d374">

                <pb facs="0632" n="1592" sameAs="frus:frus1888p2/pg1592"/>

                <head>No. 1087.<lb/><hi rendition="#italic">Mr. Bayard to Mr. Straus.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1888-06-05"><hi rendition="#italic">June</hi> 5,
                        1888</date>.</dateline>
                    <seg rendition="#float-left">No. 107.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I desire to acknowledge the receipt of your
                    No. 80, of the 19th ultimo, in regard to the restrictions of the Sublime Porte
                    against foreign Jews resorting to Palestine, and to approve your presentation of
                    the matter to the minister for foreign affairs.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. F. Bayard</hi>.</signed></closer>
            </div>
        </body>
