        <body>
            <div xml:id="d356">

                <pb facs="0605" n="1565" sameAs="frus:frus1888p2/pg1565"/>

                <head>No. 1069.<lb/><hi rendition="#italic">Mr. Straus to Mr. Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1888-02-28"><hi rendition="#italic">February</hi> 28, 1888</date>.
                        (Received March 19.)</dateline>
                    <seg rendition="#float-left">No. 66.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose for your consideration a copy of
                    a letter from Mr. J. L. Barton, and a copy of my reply, touching the question of
                    protection to American citizens recently naturalized on returning to the country
                    of their origin.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">O. S. Straus.</hi></signed></closer>



                <xi:include href="d356-a1.xml" xpointer="d356-a1"/>
