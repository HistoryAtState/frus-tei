                <pb facs="0967" n="1925" sameAs="frus:frus1888p2/pg1925"/>

                <head>No. 48.<lb/><hi rendition="#italic">Mr. Anderson to Mr. Bayard</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Copenhagen</hi></placeName>, <date calendar="gregorian"
                            when="1888-02-24"><hi rendition="#italic">February</hi> 24, 1888</date>.
                        (Received March 12.)</dateline>
                    <seg rendition="#float-left">No. 208.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to report that, acting
                    upon the instructions contained in your printed circular dated July 9, 1887, I
                    embodied a request for the desired information in a note to the royal Danish
                    minister of foreign affairs, under date of August 11, 1887. Having just received
                    a reply from his excellency, I have herewith the honor of transmitting to you
                    copies of both notes, together with a translation of the latter.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">R. B. Anderson</hi>.</signed></closer>




                <xi:include href="d610-a1.xml" xpointer="d610-a1"/>
