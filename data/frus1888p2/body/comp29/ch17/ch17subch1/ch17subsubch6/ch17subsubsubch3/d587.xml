    <text>
        <body>
            <div xml:id="d587">

                <pb facs="0929" n="1887" sameAs="frus:frus1888p2/pg1887"/>

                <head>No. 25.<lb/><hi rendition="#italic">Mr. Reuterskiöld to Mr. Bayard</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of Sweden and Norway</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1885-06-17"><hi rendition="#italic">June</hi> 17, 1885</date>.
                        (Received June 18.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to our conversation this
                    morning I beg to inclose a short memorandum concerning the tonnage-tax question
                    I spoke to you about.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">L. Reuterskiöld.</hi></signed></closer>


                <xi:include href="d587-a1.xml" xpointer="d587-a1"/>
