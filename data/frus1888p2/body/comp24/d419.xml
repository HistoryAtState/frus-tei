    <text>
        <body>
            <div xml:id="d419">

                <pb facs="0702" n="1662" sameAs="frus:frus1888p2/pg1662"/>

                <head>No. 1132.<lb/><hi rendition="#italic">To the diplomatic and consular officers
                        of the United States.</hi></head>
                <opener><seg rendition="#center">[Circular.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1888-08-20"><hi rendition="#italic">August</hi> 20,
                        1888</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Gentlemen</hi>: I transmit herewith copies of a new
                    edition (July, 1888) of the forms of application for passports and of the
                    general instructions in regard thereto, which are to be used, in accordance with
                    the standing instructions of the Department, in the place of those -heretofore
                    transmitted.</p>
                <p>I am, gentlemen, your obedient servant,</p>
                <closer><signed><hi rendition="#small-caps">T. F. Bayard.</hi></signed></closer>





                <xi:include href="d419-a1.xml" xpointer="d419-a1"/>
