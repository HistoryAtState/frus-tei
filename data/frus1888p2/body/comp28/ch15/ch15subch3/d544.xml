    <text>
        <body>
            <div xml:id="d544">

                <pb facs="0885" n="1843" sameAs="frus:frus1888p2/pg1843"/>

                <head>No. 21.<lb/><hi rendition="#italic">Mr. Rives to Mr. Phelps.</hi><anchor n="†"
                        xml:id="d544-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1888-10-23"><hi rendition="#italic">October</hi> 23,
                        1888</date>.</dateline>
                    <seg rendition="#float-left">No. 982.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith, for your information, a
                    copy of a dispatch to this Department from Mr. Stevens, our consul at Victoria,
                    British Columbia, relative to the fur-seal industry, giving an account of the
                    business for the season which has just closed.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">G. L. Rives</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>


                <xi:include href="d544-a1.xml" xpointer="d544-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d544-f1" n="†" type="source" xml:id="d544-f1-content">
                <p>Identic instructions were sent to U. S. minister to Russia.</p>
            </note>
        </listAnnotation>
