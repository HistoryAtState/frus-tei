                <pb facs="0582" n="1542" xml:id="pg1542"/>

                <head>No. 1048.<lb/><hi rendition="#italic">Mr. Frey to Mr. Bayard.</hi></head>
                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of Switzerland</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1888-01-31"><hi rendition="#italic">January</hi> 31, 1888</date>.
                        (Received February 1.)</dateline></opener>
                <p>Mr. <hi rendition="#small-caps">Secretary of State</hi>: The undersigned,
                    minister of the Swiss Confederation, has the honor, by direction of his
                    Government, to transmit you the inclosed note from it, and avails, etc.,</p>
                <closer><signed><hi rendition="#small-caps">E. Frey.</hi></signed></closer>


