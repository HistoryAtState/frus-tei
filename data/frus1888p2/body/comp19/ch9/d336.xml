    <text>
        <body>
            <div xml:id="d336">

                <pb facs="0582" n="1542" sameAs="frus:frus1888p2/pg1542"/>

                <head>No. 1049.<lb/><hi rendition="#italic">Mr. Frey to Mr. Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of Switzerland</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1888-02-18"><hi rendition="#italic">February</hi> 18, 1888</date>.
                        (Received February 20.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: The undersigned, minister of the Swiss
                    Confederation, has the honor, in pursuance of instructions received from his
                    Government, herewith to transmit to you the inclosed note, and he avails,
                    etc.</p>
                <closer><signed><hi rendition="#small-caps">E. Frey.</hi></signed></closer>


                <xi:include href="d336-a1.xml" xpointer="d336-a1"/>
