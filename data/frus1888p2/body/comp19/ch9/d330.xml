                <pb facs="0577" n="1537" sameAs="frus:frus1888p2/pg1537"/>

                <head>No. 1043.<lb/><hi rendition="#italic">Mr. Kloss to Mr. Bayard.</hi></head>
                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Swiss Legation</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1887-08-20"><hi rendition="#italic">August</hi> 20, 1887</date>.
                        (Received August 22.)</dateline></opener>
                <p>Mr. <hi rendition="#small-caps">Secretary of State</hi>: We have the honor to
                    inclose a circular note which the Swiss Federal Council has just addressed to
                    the Governments of the states represented in Switzerland by diplomatic or
                    consular officers concerning the reciprocal prepayment of the correspondence
                    exchanged between these Governments and their representatives.</p>
                <p>Pray accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">K. Kloss.</hi></signed></closer>


                <xi:include href="d330-a1.xml" xpointer="d330-a1"/>
