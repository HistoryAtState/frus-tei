    <text>
        <body>
            <div xml:id="d339">

                <pb facs="0585" n="1545" sameAs="frus:frus1888p2/pg1545"/>

                <head>No. 1052.<lb/><hi rendition="#italic">Mr. Bayard to Mr. de
                        Claparéde.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1888-11-28"><hi rendition="#italic">November</hi> 28,
                        1888</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of the 27th instant, in which you convey the sad intelligence of
                    the death of His Excellency President Hertenstein on the preceding day.</p>
                <p>I instantly communicated by telegraph to the Chancellor of the Swiss
                    Confederation the sorrow experienced by the people of the United States in the
                    loss of the honored head of the Swiss Republic.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. F. Bayard.</hi></signed></closer>
            </div>
        </body>
    </text>
