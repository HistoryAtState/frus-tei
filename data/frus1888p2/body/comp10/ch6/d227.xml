    <text>
        <body>
            <div xml:id="d227">

                <pb facs="0435" n="1395" xml:id="pg1395"/>

                <head>No. 940.<lb/><hi rendition="#italic">Mr. Bayard to Baron d’Almeirim.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1888-07-03"><hi rendition="#italic">July</hi> 3,
                        1888</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of the 30th ultimo, in which you inform me that your Government has
                    declared a blockade, commencing June 12 last, of the port of Quissembo, on the
                    west coast of Africa, north of the Ambriz.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. F. Bayard.</hi></signed></closer>
            </div>
        </body>
