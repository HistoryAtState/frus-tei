    <text>
        <body>
            <div xml:id="d486-a4">

                <pb facs="0843" n="1801" sameAs="frus:frus1888p2/pg1801"/>

                <opener><seg rendition="#center">[Inclosure 4.—Copy of order.]</seg></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Barton Atkins</hi>,<lb/><hi
                        rendition="#italic">United States marshal for the district of
                    Alaska:</hi></p>
                <p>You are hereby directed to release the vessels <hi rendition="#italic">Carolena,
                        Onward, Thornton</hi>, and <hi rendition="#italic">San Diego</hi>, which
                    were seized in Behring Sea for violation of section 1956, United States
                    Statutes, together with their tackle, apparel, skins, guns, ammunition, small
                    boats, and everything pertaining to said vessels, this 19th day of February,
                    1887.</p>
                <closer><signed><hi rendition="#small-caps">Lafayette Dawson</hi>,<lb/><hi
                            rendition="#italic">District Judge, District of
                    Alaska.</hi></signed></closer>
            </div>
        </body>
    </text>
