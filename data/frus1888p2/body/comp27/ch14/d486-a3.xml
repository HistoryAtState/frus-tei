    <text>
        <body>
            <div xml:id="d486-a3">

                <pb facs="0843" n="1801" xml:id="pg1801"/>

                <opener><seg rendition="#center">[Inclosure 3.—Copy of telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington, D. C.</hi></placeName>, <date calendar="gregorian"
                            when="1887-01-26"><hi rendition="#italic">January</hi> 26,
                        1887</date>.</dateline></opener>
                <p rendition="#flush">Judge <hi rendition="#small-caps">Lafayette Dawson</hi>
                        and<lb/><hi rendition="#small-caps">M. D. Ball</hi>,<lb/><hi
                        rendition="#italic">United States district attorney, Sitka, Alaska:</hi></p>
                <p>I am directed by the President to instruct you to discontinue any further
                    proceedings in the matter of the seizure of the British vessels <hi
                        rendition="#italic">Carolena, Onward</hi>, and <hi rendition="#italic"
                        >Thornton</hi>, and discharge all vessels now held under such seizure and
                    release all persons that may be under arrest in connection therewith.</p>
                <closer><signed><hi rendition="#small-caps">A. H. Garland</hi>,<lb/><hi
                            rendition="#italic">Attorney-General.</hi></signed></closer>
            </div>
        </body>
    </text>
