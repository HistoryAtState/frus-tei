    <text>
        <body>
            <div xml:id="d520">

                <pb facs="0860" n="1818" sameAs="frus:frus1888p2/pg1818"/>

                <head>No. 65.<lb/><hi rendition="#italic">Mr. Bayard to Mr. Herbert</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1888-11-28"><hi rendition="#italic">November</hi> 28,
                        1888</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of the 23d instant, stating that the owners of the <hi
                        rendition="#italic">Ada</hi>, one of the four British vessels condemned for
                    taking seals illicitly in Behring Sea, do not object to the original
                    appraisement, and to say that I have made known the contents thereof to the
                    Attorney-General.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. F. Bayard.</hi></signed></closer>
            </div>
        </body>
    </text>
