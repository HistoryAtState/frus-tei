    <text>
        <body>
            <div xml:id="d174-a1">

                <pb facs="0366" n="1326" sameAs="frus:frus1888p2/pg1326"/>

                <opener><seg rendition="#center">[Inclosure 1 in No. 113.]</seg></opener>
                <head><hi rendition="#italic">Mr. Pels to Mr. Porter.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Consulate of the United States of America</hi>,<lb/><hi
                                rendition="#italic">Batavia</hi></placeName>, <date
                            calendar="gregorian" when="1887-11-29"><hi rendition="#italic"
                                >November</hi> 29, 1887</date>.</dateline>
                    <seg rendition="#float-left">No. 215.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I beg to own receipt of your letter No. 87,
                    dated October 4, 1887, witb inclosure, of which I took due note and contents of
                    which I transmitted to Mr. Ed. R. Connell.</p>
                <p>I now beg to inclose a letter from this gentleman addressed to me, dated November
                    28.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">P. Pels.</hi></signed></closer>
            </div>
        </body>
    </text>
