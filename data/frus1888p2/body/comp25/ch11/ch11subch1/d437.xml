                <pb facs="0745" n="1705" sameAs="frus:frus1888p2/pg1705"/>

                <head>No. 14.<lb/><hi rendition="#italic">Mr. Phelps to Mr. Bayard.</hi></head>
                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1888-12-05"><hi rendition="#italic">December</hi> 5, 1888</date>.
                        (Received December 17.)</dateline>
                    <seg rendition="#float-left">No. 861.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith copy of a note which I
                    addressed yesterday to Lord Salisbury concerning the action of the President in
                    respect to Lord Sackville, and transmitting certain papers thereto related.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">E. J. Phelps.</hi></signed></closer>



