                <pb facs="0739" n="1699" sameAs="frus:frus1888p2/pg1699"/>

                <head><hi rendition="#italic">Lord Sackville to the
                            Marquis of Salisbury.—</hi>(<hi
                        rendition="#italic">Received October</hi> 31.)</head>
                <opener><seg rendition="#center">[Telegraphic.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1888-10-31"><hi rendition="#italic">October</hi>
                        31</date>.</dateline></opener>
                <p>I beg to repudiate statement of Secretary of State, giving reasons for my
                    dismissal, as an unjust attack on my integrity.</p>
            </div>
