    <text>
        <body>
            <div xml:id="d434-a7">

                <pb facs="0739" n="1699" sameAs="frus:frus1888p2/pg1699"/>

                <head><hi rendition="#italic">The Marquis of Salisbury to Lord
                        Sackville.</hi><anchor n="*" xml:id="d434-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Foreign Office</hi></placeName>, <date calendar="gregorian"
                            when="1888-10-31"><hi rendition="#italic">October</hi>
                        31</date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Lord</hi>: I have received your telegram of
                    yesterday informing me that you had received your passports from the President
                    of the United States.</p>
                <p>I have therefore to request that you will place the honorable Michael Herbert,
                    who is the senior secretary at present on the spot, in charge of Her Majesty’s
                    legation.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Salisbury.</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d434-f1" n="*" type="source" xml:id="d434-f1-content">
                <p>Substance sent by telegraph.</p>
            </note>
        </listAnnotation>
