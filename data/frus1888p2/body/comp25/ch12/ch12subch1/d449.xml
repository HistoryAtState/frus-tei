    <text>
        <body>
            <div xml:id="d449">

                <pb facs="0769" n="1727" sameAs="frus:frus1888p2/pg1727"/>

                <head>No. 8.<lb/><hi rendition="#italic">Mr. Herbert to the Marquis of
                        Salisbury.—</hi>(<hi rendition="#italic">Received November</hi> 20.)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1888-11-09"><hi rendition="#italic">November</hi> 9,
                        1888</date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Lord</hi>: I have the honor to transmit a
                    statement by Lord Sackville in connection with the publication of his private
                    letter to Murchison.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Michael H.
                    Herbert.</hi></signed></closer>


                <xi:include href="d449-a1.xml" xpointer="d449-a1"/>
