                <pb facs="0507" n="1467" sameAs="frus:frus1888p2/pg1467"/>

                <head>No. 989.<lb/><hi rendition="#italic">Mr. Bayard to Mr. Curry.</hi></head>
                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1888-06-12"><hi rendition="#italic">June</hi> 12,
                        1888</date>.</dateline>
                    <seg rendition="#float-left">No. 298.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your No. 324 of the 26th ultimo, inclosing
                    the agreement signed by yourself and Mr. Moret prolonging the <hi
                        rendition="#italic">modus vivendi</hi>, has been received.</p>
                <p>Your course is approved</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. F. Bayard.</hi></signed></closer>
            </div>
        </body>
