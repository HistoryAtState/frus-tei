                <pb facs="0488" n="1448" sameAs="frus:frus1888p2/pg1448"/>

                <head>No. 982.<lb/><hi rendition="#italic">Mr. Curry to Mr. Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1888-03-03"><hi rendition="#italic">March</hi> 3, 1888</date>.
                        (Received March 19.)</dateline>
                    <seg rendition="#float-left">No. 304.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose a copy and
                    translation of a royal decree published in the Gaceta of February 29 last, which
                    embodies the measures to be taken by the Spanish Government for the celebration
                    of the four hundredth anniversary of the discovery of America.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">J. L. M. Curry.</hi></signed></closer>


                <xi:include href="d269-a1.xml" xpointer="d269-a1"/>
