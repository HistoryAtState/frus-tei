    <text>
        <body>
            <div xml:id="d271">

                <pb facs="0490" n="1450" sameAs="frus:frus1888p2/pg1450"/>

                <head>No. 984.<lb/><hi rendition="#italic">Mr. Bayard to Mr. Curry.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1888-03-21"><hi rendition="#italic">March</hi> 21,
                        1888</date>.</dateline>
                    <seg rendition="#float-left">No. 276.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your No. 304 of the 3d instant, inclosing
                    copy of the royal decree providing for an exposition at Madrid to celebrate the
                    four hundredth anniversary of the discovery of America, has been received and a
                    copy of it has been communicated to the Senate Committee on the Centennial of
                    the Constitution and the Discovery of America for their information.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. F. Bayard.</hi></signed></closer>
            </div>
        </body>
