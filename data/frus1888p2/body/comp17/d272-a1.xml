    <text>
        <body>
            <div xml:id="d272-a1">

                <pb facs="0491" n="1451" sameAs="frus:frus1888p2/pg1451"/>

                <opener><seg rendition="#center">[Inclosure 1 in No. 279.]</seg></opener>
                <head><hi rendition="#italic">Mr. Ehninger to Mr.
                            Rives.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Consulate</hi>,<lb/><hi rendition="#italic"
                                >Cienfuegos</hi></placeName>
                        <date calendar="gregorian" when="1888-03-19"><hi rendition="#italic"
                                >March</hi> 19, 1888</date>.</dateline>
                    <seg rendition="#float-left">No. 64.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to report another case
                    similar to that referred to in my No. 58 of January 18 ultimo.</p>
                <p>The accompanying protest of the master of the vessel will fully explain the
                    case.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Henry A.
                    Ehninger.</hi></signed></closer>
            </div>
        </body>
