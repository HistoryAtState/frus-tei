    <text>
        <body>
            <div xml:id="d266">

                <pb facs="0473" n="1433" sameAs="frus:frus1888p2/pg1433"/>

                <head>No. 979.<lb/><hi rendition="#italic">Mr. Bayard to Mr. Curry.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1888-02-11"><hi rendition="#italic">February</hi> 11,
                        1888</date>.</dateline>
                    <seg rendition="#float-left">No. 266.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my No. 262, of the 26th
                    ultimo, concerning the discriminating duty levied at Zaza, Cuba, upon the
                    American brig <hi rendition="#italic">J. W. Parker</hi>, I inclose a dispatch
                    from our consul at Cienfuegos relating to the subject.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. F. Bayard.</hi></signed></closer>




                <xi:include href="d266-a1.xml" xpointer="d266-a1"/>
