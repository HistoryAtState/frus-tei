                <pb facs="0242" n="1202" sameAs="frus:frus1888p2/pg1202"/>

                <opener><seg rendition="#center">[Inclosure 1 in No. 64.]</seg></opener>
                <head><hi rendition="#italic">Mr. Bragg to Mr.
                            Mariscal.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1888-06-02"><hi rendition="#italic">June</hi> 2,
                        1888</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit to your
                    excellency for consideration and action aijopy of an official communication from
                    the State Department at Washington concerning the murder of Leon M. Baldwin, and
                    the claim for indemnity based thereon.</p>
                <p>I avail, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Edwd. S. Bragg.</hi></signed></closer>
            </div>
        </body>
