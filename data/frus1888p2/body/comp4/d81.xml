    <text>
        <body>
            <div xml:id="d81">

                <pb facs="0242" n="1202" sameAs="frus:frus1888p2/pg1202"/>

                <head>No. 794.<lb/><hi rendition="#italic">Mr. Bragg to Mr. Bayard.</hi></head>
                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1888-06-05"><hi rendition="#italic">June</hi> 5, 1888</date>.
                        (Received June 11.)</dateline>
                    <seg rendition="#float-left">No. 64.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Herewith I have the honor to inclose copy
                    of my note transmitting to Mr. Mariscal copy of the original instructions of the
                    Department in the matter of Baldwin versus Mexico, and also a copy of Mr.
                    Mariscal’s note in reply.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Edwd. S. Bragg.</hi></signed></closer>



                <xi:include href="d81-a1.xml" xpointer="d81-a1"/>
