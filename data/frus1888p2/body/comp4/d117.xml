                <pb facs="0287" n="1247" sameAs="frus:frus1888p2/pg1247"/>

                <head>No. 830.<lb/><hi rendition="#italic">Mr. Whitehouse to Mr. Bayard.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1888-12-08"><hi rendition="#italic">December</hi> 8,
                        1888</date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Bayard</hi>,<lb/><hi
                        rendition="#italic">Secretary, Washington:</hi></p>
                <p>President Diaz returns hearty thanks for President Cleveland’s gracious
                    congratulations on entrance on new term of office.</p>
                <closer><signed><hi rendition="#small-caps">Whitehouse.</hi></signed></closer>
            </div>
        </body>
