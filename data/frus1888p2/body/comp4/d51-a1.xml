                <pb facs="0151" n="1111" sameAs="frus:frus1888p2/pg1111"/>

                <opener><seg rendition="#center">[Inclosure 1 in No. 258.]</seg></opener>
                <head><hi rendition="#italic">Mr. Lanham to Mr. Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >House of Representatives</hi>,<lb/><hi rendition="#italic"
                                >Washington, D. C.</hi></placeName>, <date calendar="gregorian"
                            when="1888-02-08"><hi rendition="#italic">February</hi> 8,
                        1888</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Sir</hi>: I respectfully transmit a
                    communication, with accompanying map, this day received by me from the president
                    of the El Paso Development Board.</p>
                <p>Your consideration of the matter stated is respectfully requested.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">S. W. T. Lanham.</hi></signed></closer>
            </div>
        </body>
