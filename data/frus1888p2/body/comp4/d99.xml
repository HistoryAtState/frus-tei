        <body>
            <div xml:id="d99">

                <pb facs="0269" n="1229" sameAs="frus:frus1888p2/pg1229"/>

                <head>No. 812.<lb/><hi rendition="#italic">Mr. Bragg to Mr. Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1888-09-19"><hi rendition="#italic">September</hi> 19,
                        1888</date>. (Received September 26.)</dateline>
                    <seg rendition="#float-left">No. 144.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith
                    copies in English and Spanish of the President’s message delivered to Congress
                    on the night of the 16th instant.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Edward S. Bragg.</hi></signed></closer>


                <xi:include href="d99-a1.xml" xpointer="d99-a1"/>
