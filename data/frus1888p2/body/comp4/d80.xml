                <pb facs="0241" n="1201" sameAs="frus:frus1888p2/pg1201"/>

                <head>No. 793.<lb/><hi rendition="#italic">Mr. Bragg to Mr. Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>. <date calendar="gregorian"
                            when="1888-05-31"><hi rendition="#italic">May</hi> 31, 1888</date>.
                        (Received June 6.)</dateline>
                    <seg rendition="#float-left">No. 58.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In further sequence to my No. 48 I have the
                    honor to inclose translated note from Mr. Mariscal stating that he has taken
                    under advisement your instructions in the case of A. K. Cutting.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Edwd. S. Bragg</hi>.</signed></closer>



                <xi:include href="d80-a1.xml" xpointer="d80-a1"/>
