    <text>
        <body>
            <div xml:id="d111-a1">

                <pb facs="0284" n="1244" sameAs="frus:frus1888p2/pg1244"/>

                <opener><seg rendition="#center">[Inclosure 1 in No.
                    190.—Translation.]</seg></opener>
                <head><hi rendition="#italic">Mr. Mariscal to Mr.
                            Whitehouse.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1888-11-15"><hi rendition="#italic">November</hi> 15,
                        1888</date>.</dateline>
                    <seg rendition="#float-left">Unofficial.]</seg></opener>
                <p><hi rendition="#small-caps">My Esteemed Mr. Whitehouse</hi>: As I promised you, I
                    send you herewith copy of some data relative to the works under way at Paso del
                    Norte, found in a dispatch I have just received from our consul at El Paso,
                    Texas.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Ignacio Mariscal.</hi></signed></closer>
            </div>
        </body>
    </text>
