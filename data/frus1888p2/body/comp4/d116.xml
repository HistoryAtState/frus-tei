                <pb facs="0287" n="1247" sameAs="frus:frus1888p2/pg1247"/>

                <head>No. 829.<lb/><hi rendition="#italic">Mr. Bayard to Mr. Whitehouse.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1888-12-01"><hi rendition="#italic">December</hi> 1,
                        1888</date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Whitehouse</hi>,<lb/><hi
                        rendition="#italic">Chargé, Mexico:</hi></p>
                <p>The President desires you to present to President Diaz his compliments and
                    congratulations at the entrance upon a new term of administration under which
                    Mexico has so prospered.</p>
                <closer><signed><hi rendition="#small-caps">Bayard.</hi></signed></closer>
            </div>
        </body>
