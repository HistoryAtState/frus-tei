        <body>
            <div xml:id="d77">

                <pb facs="0239" n="1199" sameAs="frus:frus1888p2/pg1199"/>

                <head>No. 790.<lb/><hi rendition="#italic">Mr. Bragg to Mr. Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1888-05-30"><hi rendition="#italic">May</hi> 30, 1888</date>.
                        (Received June 4.)</dateline>
                    <seg rendition="#float-left">No. 48.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to advise you that I have
                    this day transmitted copy of your views in the Cutting case, as set forth in
                    your dispatch No. 42, to Mr. Mariscal, and herewith inclose copy of my note
                    submitting the same.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Edwd. S. Bragg.</hi></signed></closer>


                <xi:include href="d77-a1.xml" xpointer="d77-a1"/>
