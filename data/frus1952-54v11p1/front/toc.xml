                                </list></item>
                            <item><hi rendition="#small-caps">Union of South Africa</hi>: <list>
                                    <item><ref target="#pg902">Principal policies and problems in
                                            relations with the Union of South Africa</ref></item>
                                </list></item>
                        </list></item>
