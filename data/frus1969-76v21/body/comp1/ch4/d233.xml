        <listAnnotation>
            <note corresp="#d233-f1" n="1" type="source" xml:id="d233-f1-content">
                <p>Source: National Archives, Nixon Presidential Materials, NSC Files, NSC Institutional Files
                    (H-Files), Box H–56, SRG Meeting, Chile,
                    6/3/71. Secret; Nodis. This meeting took
                    place in the White House Situation Room. Only the Summary of Conclusions is
                    printed here; for the full text, see <ref target="frus1969-76ve16#d73"><hi
                            rendition="#italic">Foreign Relations</hi>, 1969–1976, vol. E–16,
                        Documents on Chile, 1969–1973, Document 73</ref>.</p>
            </note>
        </listAnnotation>
