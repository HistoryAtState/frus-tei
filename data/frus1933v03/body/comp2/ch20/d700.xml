    <text>
        <body>
            <div xml:id="d700">

                <pb facs="0744" n="642" sameAs="frus:frus1933v03/pg642"/>

                <note rend="inline" type="source">803.51/5798b</note>
                <head><hi rendition="#italic">The Department of State to
                        the Chinese Legation</hi><anchor n="5"
                        xml:id="d700-f1"/></head>
                <dateline>
                    <date ana="#date_undated-inferred-from-document-content" calendar="gregorian"
                        type="received-date" when="1933-07-29">undated</date>
                </dateline>
                <p>The Department of State has recently received from several sources communications
                    which indicate that the present authorities in Manchuria are showing much
                    greater solicitude with regard to the meeting of past and current obligations to
                    American creditors than was shown by the former authorities in Manchuria or is
                    shown by the Nanking Government.</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d700-f1" n="5" type="source" xml:id="d700-f1-content">
                <p>Handed to the Chinese Minister by the Chief of the Division of Far Eastern
                    Affairs on July 29, 1933.</p>
            </note>
        </listAnnotation>
    </standOff>
