    <text>
        <body>
            <div xml:id="d502">

                <pb facs="0579" n="477" sameAs="frus:frus1933v03/pg477"/>

                <note rend="inline" type="source">493.11/1817</note>
                <head><hi rendition="#italic">The Consul General at Mukden (Myers) to the Minister
                        in China (Johnson)</hi><anchor n="3" xml:id="d502-f1"/></head>
                <opener>
                    <seg rendition="#center">[Extract]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 867</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mukden</hi></placeName>, <date calendar="gregorian"
                            when="1933-12-06">December 6, 1933</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to refer to this office’s
                    despatches Nos. 801 and 805 of July 11 and 28, 1933,<anchor n="4"
                        xml:id="d502-f2"/> respectively, concerning developments in the settlement
                    of American claims arising as a result of the Japanese occupation, and to
                    enclose herewith a copy of a letter<anchor n="5" xml:id="d502-f3"/> from Mr. H.
                    C. Reed, American Claims Representative, reporting the final settlement of all
                    claims which had been investigated and approved by the Commission for the
                    Liquidation of Claims.</p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>Respectfully yours,</p>
                <closer><signed>M. S. <hi rendition="#small-caps">Myers</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d502-f1" n="3" type="source" xml:id="d502-f1-content">
                <p>Copy transmitted to the Department by the Consul General at Mukden in his
                    despatch of December 8, 1933; received January 5, 1934.</p>
            </note>
            <note corresp="#d502-f2" n="4" xml:id="d502-f2-content">
                <p>Neither printed.</p>
            </note>
            <note corresp="#d502-f3" n="5" xml:id="d502-f3-content">
