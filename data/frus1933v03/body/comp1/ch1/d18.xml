            </note>
            <note corresp="#d18-f2" n="20" xml:id="d18-f2-content">
                <p>Sir Francis Lindley, British Ambassador to Japan.</p>
            </note>
            <note corresp="#d18-f3" n="21" xml:id="d18-f3-content">
                <p>Count Yasuya Uchida, Japanese Minister for Foreign Affairs.</p>
            </note>
            <note corresp="#d18-f4" n="22" xml:id="d18-f4-content">
                <p>Yosuke Matsuoka, Japanese chief delegate, League of Nations.</p>
            </note>
        </listAnnotation>
