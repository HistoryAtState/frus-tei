                <pb facs="1322" n="1306" sameAs="frus:frus1951v01/pg1306"/>

                <note rend="inline" type="source">394.31/3–2751: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Chairman of the United States Delegation to
                        the Torquay Conference</hi> (<hi rendition="#italic">Corse</hi>)</head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Torquay</hi></placeName>, <date
                            calendar="gregorian" when="1951-03-27T17:00:00+00:00">March 27, 1951—5
                            p. m</date>.</dateline>
                </opener>
                <p>617. USTAC. Just before delivery of our note to
                        FonOff in London, Stephen Holmes invited
                    Corse and Lewis to have dinner tomorrow night with Harold Wilson, who is
                    arriving Torquay tomorrow.</p>
                <p>Sent Department 617, repeated information London 241.</p>
                <closer>
                    <signed>[<hi rendition="#small-caps">Corse</hi>]</signed>
                </closer>
            </div>
        </body>
