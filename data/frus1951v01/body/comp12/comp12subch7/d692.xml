    <text>
        <body>
            <div xml:id="d692">

                <pb facs="1564" n="1548" xml:id="pg1548"/>

                <note rend="inline" type="source">394.31/11–2951: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Italy</hi> (<hi
                            rendition="#italic">Dunn</hi>) <hi rendition="#italic">to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">confidential</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Rome</hi></placeName>, <date
                            calendar="gregorian" when="1951-11-29T18:00:00+01:00">November 29,
                            1951—6 p. m</date>.</dateline>
                </opener>
                <p>2407. Ref: Deptel Brussels 778; rptd Rome
                    2447; November 27, 1951. Ital FonOff notified
                    November 28, with no reaction as yet.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Dunn</hi>
                    </signed>
                </closer>
            </div>
        </body>
