    <text>
        <body>
            <div xml:id="d232">

                <pb facs="0709" n="693" sameAs="frus:frus1951v01/pg693"/>

                <note rend="inline" type="source">G/PM Files, Lot 68 D 349</note>
                <head>
                    <hi rendition="#italic">Mr. Winston S. Churchill to President Truman</hi><anchor
                        n="1" xml:id="d232-f1"/>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">private</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1951-02-12">12 February,
                        1951</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Harry</hi>: Forgive me for bothering you
                    with the enclosed, but I felt it my duty to my Country to send it to you.</p>
                <p>With all good wishes</p>
                <p>Your friend,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Winston</hi> S. <hi rendition="#small-caps"
                            >Churchill</hi>
                    </signed>
                </closer>


                <xi:include href="d232-a1.xml" xpointer="d232-a1"/>
            </div>
        </body>
    </text>
