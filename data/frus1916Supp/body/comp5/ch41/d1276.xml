            <div xml:id="d1276">

                <pb facs="1239" n="953" sameAs="frus:frus1916Supp/pg953"/>

                <note rend="inline" type="source">File No. 763.72112/2611</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Great Britain</hi> (<hi
                            rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-06-03T17:00:00-05:00">
                            <hi rendition="#italic">July 3, 1916, 5 p. m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>3486. Department’s instruction 3681, June 2.<anchor n="2" xml:id="d1276-f1"/> You
                    may present Mr. Taft’s note to British
                    Government without comment.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
