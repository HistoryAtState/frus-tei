    <text>
        <body>
            <div xml:id="d1310-a5">

                <pb facs="1263" n="977" sameAs="frus:frus1916Supp/pg977"/>

                <head>D</head>
                <p>
                    <hi rendition="#small-caps">Whereas</hi> for the purpose of their common defense
                    against the enemy, the Allied powers have agreed to adopt a common economic
                    policy on the lines laid down in the resolutions which have been passed; and</p>
                <p>
                    <hi rendition="#small-caps">Whereas</hi> it is recognized that the effectiveness
                    of this policy depends absolutely upon these resolutions being put into
                    Operation forthwith, the representatives of the Allied Governments undertake to
                    recommend that their respective Governments shall take, without delay, all the
                    measures, whether temporary or permanent, requisite to giving full and complete
                    effect to this policy forthwith, and to communicate to each other the decisions
                    arrived at to attain the object.</p>
                <closer>
                    <dateline rendition="#float-left">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi>
                        </placeName>, <date calendar="gregorian" when="1916-06-17">
                            <hi rendition="#italic">June 17, 1916</hi>
                        </date>.</dateline>
                </closer>
                <postscript>
                    <p>Have signed these resolutions:<anchor n="1" xml:id="d1310-f1"/>
                    </p>
                </postscript>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1310-f1" n="1" xml:id="d1310-f1-content">
                <p>Signatures not printed of twenty-six delegates representing the Governments of
                    France, Belgium, Great Britain, Italy, Japan, Portugal, Russia, and Serbia.</p>
            </note>
        </listAnnotation>
    </standOff>
