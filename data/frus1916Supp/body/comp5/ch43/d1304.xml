    <text>
        <body>
            <div xml:id="d1304">

                <pb facs="1258" n="972" sameAs="frus:frus1916Supp/pg972"/>

                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in France</hi>
                        (<hi rendition="#italic">Sharp</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-03-10T16:00:00-05:00">
                            <hi rendition="#italic">March 10, 1916, 4 p. m</hi>
                        </date>
                    </dateline>
                </opener>
                <p>1413. Department is informed from Rome that there is to be a conference at Paris
                    for closer commercial relations between the Allies, and that efforts may be made
                    to apply restrictions possibly affecting American interests. Should this
                    conference take place, endeavor to ascertain its results, using every discretion
                    in doing so.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
