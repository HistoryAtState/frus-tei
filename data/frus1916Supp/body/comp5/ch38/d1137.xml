    <text>
        <body>
            <div xml:id="d1137">

                <pb facs="1151" n="865" sameAs="frus:frus1916Supp/pg865"/>

                <note rend="inline" type="source">File No. 763.72115/2552</note>
                <head>
                    <hi rendition="#italic">The Minister in Belgium</hi> (<hi rendition="#italic"
                        >Whitlock</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Brussels</hi></placeName>, <date
                            calendar="gregorian" when="1916-11-15T18:00:00+01:00">
                            <hi rendition="#italic">November 15, 1916, 6 p. m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received November 17, 1.45 p.
                        m.</hi>]</dateline>
                </opener>
                <p>16. Impressment of workmen continues, but somewhat less rigorously applied.
                    Members of organization of Comité National and Commission Relief Belgium now
                    fully respected.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Whitlock</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
