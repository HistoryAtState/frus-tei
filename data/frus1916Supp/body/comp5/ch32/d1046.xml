    <text>
        <body>
            <div xml:id="d1046">

                <pb facs="1086" n="800" sameAs="frus:frus1916Supp/pg800"/>

                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        Austria-Hungary</hi> (<hi rendition="#italic">Penfield</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-10-18T16:00:00-05:00">
                            <hi rendition="#italic">October 18, 1916, 4 p. m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>1387. Before answering your 1481, Department desires to receive more information
                    regarding Count Adam Tarnowski, whether his sentiments are friendly to the
                    United States, etc.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Polk</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
