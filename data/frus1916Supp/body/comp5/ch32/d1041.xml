    <text>
        <body>
            <div xml:id="d1041">

                <pb facs="1084" n="798" sameAs="frus:frus1916Supp/pg798"/>

                <note rend="inline" type="source">File No. 701.6311/210</note>
                <head>
                    <hi rendition="#italic">The Minister an Denmark</hi> (<hi rendition="#italic">Egan</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Copenhagen</hi></placeName>, <date
                            calendar="gregorian" when="1916-05-15">
                            <hi rendition="#italic">May 15, 1916 noon</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received 5.45 p. m.</hi>]</dateline>
                </opener>
                <p>250. High diplomatic Austrian authority tells me that Vienna would gladly send
                    ambassador but suggests that the United States give him passage on an American
                    man-of-war.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">American Minister</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
