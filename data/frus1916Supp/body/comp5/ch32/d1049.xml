    <text>
        <body>
            <div xml:id="d1049">

                <pb facs="1087" n="801" sameAs="frus:frus1916Supp/pg801"/>

                <note rend="inline" type="source">File No. 701.6311/226</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Austria-Hungary</hi> (<hi
                        rendition="#italic">Penfield</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Vienna</hi></placeName>, <date
                            calendar="gregorian" when="1916-11-09T17:00:00+01:00">
                            <hi rendition="#italic">November 9, 1916, 5 p. m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received November 10, 10.55 a.
                        m.</hi>]</dateline>
                </opener>
                <p>1522. The Austro-Hungarian Government to-day announces appointment Count
                    Tarnowski as Ambassador at Washington.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Penfield</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
