    <text>
        <body>
            <div xml:id="d1146">

                <pb facs="1157" n="871" xml:id="pg871"/>

                <note rend="inline" type="source">File No. 841.00/20a</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Ambassador in Great Britain</hi> (<hi rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-08-02T17:00:00-05:00">
                            <hi rendition="#italic">August 2, 1916, 5 p. m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>3608. Department’s 3606, August 2. Please report immediately if Senate resolution
                    presented to Foreign Office, and also any further details on Casement case.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Polk</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
