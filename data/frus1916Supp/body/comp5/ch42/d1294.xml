    <text>
        <body>
            <div xml:id="d1294">

                <pb facs="1249" n="963" sameAs="frus:frus1916Supp/pg963"/>

                <note rend="inline" type="source">File No. 763.72112/2643</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Germany</hi> (<hi rendition="#italic"
                    >Gerard</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berlin</hi></placeName>, <date
                            calendar="gregorian" when="1916-06-15T14:00:00+02:00">
                            <hi rendition="#italic">June 15, 1916, 2 p. m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received June 16, 11.30 a.
                        m.</hi>]</dateline>
                </opener>
                <p>4001. Your 3087, June 13, 6 p. m. See no objection to publication of Doctor
                        Taylor’s report of April 17.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Gerard</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
