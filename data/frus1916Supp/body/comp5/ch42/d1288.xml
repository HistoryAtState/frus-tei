    <text>
        <body>
            <div xml:id="d1288">

                <pb facs="1245" n="959" sameAs="frus:frus1916Supp/pg959"/>

                <note rend="inline" type="source">File No. 763.72112/2290</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Great
                        Britain</hi> (<hi rendition="#italic">Page</hi>)<anchor n="1"
                        xml:id="d1288-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-12-27">
                            <hi rendition="#italic">December 27, 1915</hi>
                        </date>.</dateline>
                </opener>
                <p>2639. Ascertain and report promptly whether British Government will permit
                    transportation of milk from this country to Germany and Austria, to be
                    distributed to babies in these countries under direction of American Red
                    Cross.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1288-f1" n="1" type="source" xml:id="d1288-f1-content">
                <p>The same, <hi rendition="#italic">mutatis mutandis</hi>, to the Ambassador in
                    France, No. 1280.</p>
            </note>
        </listAnnotation>
    </standOff>
