    <text>
        <body>
            <div xml:id="d1289">

                <pb facs="1245" n="959" sameAs="frus:frus1916Supp/pg959"/>

                <note rend="inline" type="source">File No. 763.72112/2291</note>
                <head>
                    <hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic"
                        >Sharp</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1916-01-13T18:00:00+00:00">
                            <hi rendition="#italic">January 13, 1916, 6 p. m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 8.45 p. m.</hi>]</dateline>
                </opener>
                <p>1210. Department’s 1280, December 27, repeated from London. French Government
                    replies under date of January 11:</p>
                <quote rend="blockquote">
                    <p>For military reasons, Government of the Republic is not disposed authorize
                        transit of milk from the United States to Germany and Austria even under
                        supervision of American Red Cross.</p>
                </quote>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Sharp</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
