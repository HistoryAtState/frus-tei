    <text>
        <body>
            <div xml:id="d1290">

                <pb facs="1246" n="960" xml:id="pg960"/>

                <note rend="inline" type="source">File No. 811.142/1383a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Germany</hi> (<hi
                            rendition="#italic">Gerard</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-02-11T17:00:00-05:00">
                            <hi rendition="#italic">February 11, 1916, 5 p. m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>2698. Please ascertain as soon as possible and report by cable the sources of the
                    milk supply of Germany for the two years preceding the opening of the present
                    war and the approximate amount of imports by countries for each year.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
