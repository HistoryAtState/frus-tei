    <text>
        <body>
            <div xml:id="d1292">

                <pb facs="1246" n="960" sameAs="frus:frus1916Supp/pg960"/>

                <note rend="inline" type="source">File No. 763.72112/2462½</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Germany</hi> (<hi rendition="#italic"
                        >Gerard</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 2946</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berlin</hi></placeName>, <date
                            calendar="gregorian" when="1916-04-18">
                            <hi rendition="#italic">April 18, 1916</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received May 8</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith, for
                    the Department’s information, a copy of a report dated April 17, 1916, which has
                    been <pb facs="1247" n="961" xml:id="pg961"/> made to me by Dr. A. E. Taylor,
                    one of the camp inspectors officially attached to my staff, regarding the
                    conditions in the milk supply of the German Empire, together with a discussion
                    of the relations in the health and death rate of infants and children.</p>
                <p>I have [etc.]</p>
                <closer>For the Ambassador: <lb/>
                    <signed>
                        <hi rendition="#small-caps">J. G. Grew</hi>
                    </signed>
                </closer>


                <xi:include href="d1292-a1.xml" xpointer="d1292-a1"/>
            </div>
