    <text>
        <body>
            <div xml:id="d1302">

                <pb facs="1254" n="968" sameAs="frus:frus1916Supp/pg968"/>

                <note rend="inline" type="source">File No. 763.72112/3063</note>
                <head>
                    <hi rendition="#italic">The Chargé in Germany</hi> (<hi rendition="#italic">Grew</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 4204</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berlin</hi></placeName>, <date
                            calendar="gregorian" when="1916-10-03">
                            <hi rendition="#italic">October 3, 1916</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received October 16</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith to
                    the Department in triplicate a report by Dr. Alonzo
                        E. Taylor, special assistant of the <pb facs="1255" n="969"
                        xml:id="pg969"/> State Department attached to this Embassy, bearing upon the
                    conditions in the milk supply of the German Empire.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">J. C. Grew</hi>
                        
                    </signed>
                </closer>


                <xi:include href="d1302-a1.xml" xpointer="d1302-a1"/>
            </div>
        </body>
    </text>
