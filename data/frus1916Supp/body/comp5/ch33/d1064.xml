    <text>
        <body>
            <div xml:id="d1064">

                <pb facs="1095" n="809" sameAs="frus:frus1916Supp/pg809"/>

                <note rend="inline" type="source">File No. 701.6211/366</note>
                <head>
                    <hi rendition="#italic">The German Ambassador</hi> (<hi rendition="#italic"
                        >Bernstorff</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Translation]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">J. Nr. A 2833</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-04-18">
                            <hi rendition="#italic">April 18, 1916</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received April 19</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Secretary of State</hi>: With reference to my
                    note of to-day, No. A 2826, I have the honor to inform your excellency that
                    according to advice just received, official papers belonging to this Embassy,
                    lying on Mr. von Igel’s table, were seized when he was arrested.</p>
                <p>I have the honor to request your excellency to have these papers sealed and
                    returned to me immediately also to prevent them from being read or copied by any
                    American official.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">J. Bernstorff</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
