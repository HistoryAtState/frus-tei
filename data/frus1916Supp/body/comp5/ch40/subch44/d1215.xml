    <text>
        <body>
            <div xml:id="d1215">

                <pb facs="1211" n="925" xml:id="pg925"/>

                <note rend="inline" type="source">File No. 811.142/1341</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Turkey (<hi rendition="#italic"
                            >Morgenthau</hi>) to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Constantinople</hi></placeName>, <date
                            calendar="gregorian" when="1916-01-27T17:00:00+02:00">
                            <hi rendition="#italic">January 27, 1916, 5 p. m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received January 31, 2.45 p.
                        m.</hi>]</dateline>
                </opener>
                <p>1520. My 1486, January 17, 11 a. m.<anchor n="1" xml:id="d1215-f1"/> Captain
                    Blakeley of the <hi rendition="#italic">Des Moines</hi> telegraphs from Naples
                    that he will be unable to proceed from Piraeus to Beirut as no ships whatever
                    are allowed to enter Syrian blockade. Only available route open for Red Cross
                    party is via Constantinople.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Morgenthau</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
