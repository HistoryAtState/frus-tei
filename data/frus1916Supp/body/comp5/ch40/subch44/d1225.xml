    <text>
        <body>
            <div xml:id="d1225">

                <pb facs="1214" n="928" xml:id="pg928"/>

                <note rend="inline" type="source">File No. 811.142/1549b</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Chargé in Turkey</hi> (<hi
                        rendition="#italic">Philip</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-04-18">
                            <hi rendition="#italic">April 18, 1916</hi>
                        </date>.</dateline>
                </opener>
                <p>2332. Pay $50,000 Constantinople chapter American Red Cross for use in
                    cooperation with Red Crescent Society in providing relief starving civilian
                    population Constantinople, Smyrna, Brusa, Adrianople, and other cities and
                    communities of Turkey in Europe and western part Turkey in Asia, from American
                    Red Cross.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
