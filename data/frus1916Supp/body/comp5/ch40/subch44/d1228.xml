    <text>
        <body>
            <div xml:id="d1228">

                <pb facs="1214" n="928" sameAs="frus:frus1916Supp/pg928"/>

                <note rend="inline" type="source">File No. 811.142/1542</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in France</hi> (<hi
                            rendition="#italic">Sharp</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-04-27">
                            <hi rendition="#italic">April 27, 1916</hi>
                        </date>.</dateline>
                </opener>
                <p>1486. Your 1344, April 4.<anchor n="2" xml:id="d1228-f1"/> Inquire if French
                    Government would permit boat to come out of port of Jaffa under proper
                    safeguards to meet American ship and receive medical supplies.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
