    <text>
        <body>
            <div xml:id="d1244">

                <pb facs="1222" n="936" sameAs="frus:frus1916Supp/pg936"/>

                <note rend="inline" type="source">File No. 811.142/1712</note>
                <head>
                    <hi rendition="#italic">The Chargé in France</hi> (<hi rendition="#italic"
                        >Bliss</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1916-08-22">
                            <hi rendition="#italic">August 22, 1916</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received 4 p. m.</hi>]</dateline>
                </opener>
                <p>1545. Department’s 1658, 15th.<anchor n="2" xml:id="d1244-f1"/> Conditions
                    imposed are that vessel transporting supplies must conform to measures
                    prescribed by French naval authorities for passage of line of blockade. Admiral
                    de Spitz has authority to make all arrangements.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bliss</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
