    <text>
        <body>
            <div xml:id="d1212">

                <pb facs="1210" n="924" sameAs="frus:frus1916Supp/pg924"/>

                <note rend="inline" type="source">File No. 811.142/1294b</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Turkey</hi>
                        (<hi rendition="#italic">Morgenthau</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-01-14">
                            <hi rendition="#italic">January 14, 1916</hi>
                        </date>.</dateline>
                </opener>
                <p>1710. Instruct <hi rendition="#italic">Des Moines</hi> to be at Piraeus February
                    6 to transport American Red Cross special agent and seven other Americans,
                    including three to five ladies, together with shipment of hospital and relief
                    supplies, to Beirut, and obtain permission Turkish Government for ship to enter
                    latter port.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
