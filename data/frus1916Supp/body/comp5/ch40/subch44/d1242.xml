    <text>
        <body>
            <div xml:id="d1242">

                <pb facs="1221" n="935" sameAs="frus:frus1916Supp/pg935"/>

                <note rend="inline" type="source">File No. 811.142/1700</note>
                <head>
                    <hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic"
                        >Sharp</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1916-08-11T17:00:00+01:00">
                            <hi rendition="#italic">August 11, 1916, 5 p. m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 7 p. m.</hi>]</dateline>
                </opener>
                <p>1525. My No. 1412,<anchor n="1" xml:id="d1242-f1"/> May 24. I am unofficially
                    informed by Foreign Office that French Government agrees to delivery of hospital
                    supplies for Jerusalem under certain conditions. American Consul at Alexandria
                    should consult with Admiral de Spitz, in command of blockading squadron, as to
                    manner of debarkation.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Sharp</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
