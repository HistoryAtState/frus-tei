                <pb facs="1214" n="928" sameAs="frus:frus1916Supp/pg928"/>

                <note rend="inline" type="source">File No. 811.142/1546</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Chargé in Turkey</hi> (<hi
                        rendition="#italic">Philip</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-04-24">
                            <hi rendition="#italic">April 24, 1916</hi>
                        </date>.</dateline>
                </opener>
                <p>2376. Your 1570, February 13.<anchor n="1" xml:id="d1227-f1"/> Can you suggest
                    any method transportation Red Cross supplies from Athens to Beirut?</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
