            <div xml:id="d1246">

                <pb facs="1223" n="937" sameAs="frus:frus1916Supp/pg937"/>

                <note rend="inline" type="source">File No. 867.48/413</note>
                <head>
                    <hi rendition="#italic">The Consul at Alexandria</hi> (<hi rendition="#italic"
                        >Garrels</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Alexandria</hi></placeName>, <date
                            calendar="gregorian" when="1916-09-07">
                            <hi rendition="#italic">September 7, 1916</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received 6.15 p. m.</hi>]</dateline>
                </opener>
                <p>Department’s 31st. Passage blockade arranged. Details to commander <hi
                        rendition="#italic">Des Moines</hi> on arrival Alexandria.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Garrels</hi>
                    </signed>
                </closer>
            </div>
        </body>
