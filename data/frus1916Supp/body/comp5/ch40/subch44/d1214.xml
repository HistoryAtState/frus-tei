    <text>
        <body>
            <div xml:id="d1214">

                <pb facs="1210" n="924" sameAs="frus:frus1916Supp/pg924"/>

                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Turkey</hi> (<hi
                            rendition="#italic">Morgenthau</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-01-26">
                            <hi rendition="#italic">January 26, 1916</hi>
                        </date>.</dateline>
                </opener>
                <p>1758. Your 1494, 17th. Supplies are for American Red Cross hospital Beirut,
                    except small portion thereof intended American community.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
