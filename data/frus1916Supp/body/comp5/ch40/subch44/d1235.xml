    <text>
        <body>
            <div xml:id="d1235">

                <pb facs="1217" n="931" sameAs="frus:frus1916Supp/pg931"/>

                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Chargé in Turkey</hi> (<hi
                            rendition="#italic">Philip</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-06-23T16:00:00-05:00">
                            <hi rendition="#italic">June 23, 1916, 4 p. m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>2779. Your 1889, June 17. Do not cease to urge the Ottoman Government to grant
                    permission for sending relief supplies to Syria. Keep Department fully and
                    promptly informed.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
