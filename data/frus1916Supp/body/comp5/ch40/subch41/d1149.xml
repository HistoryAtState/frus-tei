    <text>
        <body>
            <div xml:id="d1149">

                <pb facs="1169" n="883" sameAs="frus:frus1916Supp/pg883"/>

                <note rend="inline" type="source">File No. 855.48/366</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Page</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 3885</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1916-05-30">
                            <hi rendition="#italic">May 30, 1916</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received June 12.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose a copy of a
                    private note that I have received from Sir Edward Grey about the work of the
                    Commission for Belief in Belgium.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Walter Hines Page</hi>
                    </signed>
                </closer>



                <xi:include href="d1149-a1.xml" xpointer="d1149-a1"/>
            </div>
