    <text>
        <body>
            <div xml:id="d1157">

                <pb facs="1173" n="887" sameAs="frus:frus1916Supp/pg887"/>

                <note rend="inline" type="source">File No. 861.48/65</note>
                <head>
                    <hi rendition="#italic">The German Ambassador</hi> (<hi rendition="#italic"
                        >Bernstorff</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Translation]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">J. Nr. B 2258</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-02-28">
                            <hi rendition="#italic">February 28, 1916</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received February 29</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Secretary of State</hi>: By direction of the
                    Imperial Government I have the honor to inform your excellency that food
                    products intended for Poland will not be seized by the Imperial Government on
                    the <pb facs="1174" n="888" xml:id="pg888"/> way through Germany and will be
                    exclusively distributed among the Polish population.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">J. Bernstorff</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
