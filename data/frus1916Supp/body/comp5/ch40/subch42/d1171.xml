    <text>
        <body>
            <div xml:id="d1171">

                <pb facs="1182" n="896" sameAs="frus:frus1916Supp/pg896"/>

                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        Germany</hi> (<hi rendition="#italic">Gerard</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-05-31T19:00:00-05:00">
                            <hi rendition="#italic">May 31, 1916, 7 p. m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>3038. Your 3929. You may informally convey to Foreign Office substance of
                    Department’s 3034, May 27.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Polk</hi>
                    </signed>
                </closer>
            </div>
        </body>
