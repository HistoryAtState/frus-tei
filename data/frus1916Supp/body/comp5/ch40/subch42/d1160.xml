    <text>
        <body>
            <div xml:id="d1160">

                <pb facs="1175" n="889" xml:id="pg889"/>

                <note rend="inline" type="source">File No. 861.48/90</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Page</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 3282</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1916-03-20">
                            <hi rendition="#italic">March 20, 1916</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received April 5</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: As requested in your telegram No. 3046 of
                    March 16, 4 p. m.,<anchor n="1" xml:id="d1160-f1"/> I have the honor to transmit
                    herewith a draft of the plan as submitted to Sir Edward Grey, by Messrs. Hoover
                    and Walcott, regarding relief in Poland.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Walter Hines Page</hi>
                    </signed>
                </closer>


                <xi:include href="d1160-a1.xml" xpointer="d1160-a1"/>
            </div>
        </body>
    </text>
