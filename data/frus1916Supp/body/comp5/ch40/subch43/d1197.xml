    <text>
        <body>
            <div xml:id="d1197">

                <pb facs="1202" n="916" sameAs="frus:frus1916Supp/pg916"/>

                <note rend="inline" type="source">File No. 872.48/34</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Austria-Hungary</hi> (<hi rendition="#italic"
                        >Penfield</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Vienna</hi></placeName>, <date
                            calendar="gregorian" when="1916-02-09">
                            <hi rendition="#italic">February 9, 1916</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received February 10, 8 p.
                        m.</hi>]</dateline>
                </opener>
                <p>1140. Purport your 1093, January 21,<anchor n="2" xml:id="d1197-f1"/> via Berlin,
                    promptly communicated to Ministry. Early reply urged. Ministry now acknowledges
                    receipt agreeing in principle to shipments via Holland for Serbian relief, but
                    reserves final reply relative facilities and guarantees owing consultation with
                    other ministries.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Penfield</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
