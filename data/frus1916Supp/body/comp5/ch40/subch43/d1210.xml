    <text>
        <body>
            <div xml:id="d1210">

                <pb facs="1209" n="923" sameAs="frus:frus1916Supp/pg923"/>

                <note rend="inline" type="source">File No. 872.48/100</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Austria-Hungary</hi> (<hi
                        rendition="#italic">Penfield</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Vienna</hi></placeName>, <date
                            calendar="gregorian" when="1916-08-07">
                            <hi rendition="#italic">August 7, 1916</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received August 8, 8.20 a.
                        m.</hi>]</dateline>
                </opener>
                <p>1373. For Red Cross:</p>
                <quote rend="blockquote">
                    <p>34. Austrian Government accepts agreement 3<anchor n="1" xml:id="d1210-f1"/>
                        for shipments supplies from Roumania instead from America. Awaiting action
                        regarding Buck, Laughlin.</p>
                    <p rendition="#right">
                        <hi rendition="#small-caps">Stuart</hi>
                    </p>
                </quote>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Penfield</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1210-f1" n="1" xml:id="d1210-f1-content">
                <p>Summarized in the Ambassador’s telegram No. 1300, June 13, 1916, <hi
                        rendition="#italic">ante</hi>, <ref target="#pg920">p. 920</ref>.</p>
            </note>
