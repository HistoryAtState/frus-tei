    <text>
        <body>
            <div xml:id="d1203">

                <pb facs="1205" n="919" xml:id="pg919"/>

                <note rend="inline" type="source">File No. 811.142/1509</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Austria-Hungary</hi> (<hi
                        rendition="#italic">Penfield</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Vienna</hi></placeName>, <date
                            calendar="gregorian" when="1916-04-01T15:00:00+01:00">
                            <hi rendition="#italic">April 1, 1916, 3 p. m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received April 2, 7 p. m.</hi>]</dateline>
                </opener>
                <p>1215. For Red Cross:</p>
                <quote rend="blockquote">
                    <p>20. Expected note received from Government. More favorable than previous
                        note. Proceeding Belgrade confer local authorities.</p>
                    <p rendition="#right">
                        <hi rendition="#small-caps">Stuart</hi>
                    </p>
                </quote>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Penfield</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
