    <text>
        <body>
            <div xml:id="d1200">

                <pb facs="1203" n="917" sameAs="frus:frus1916Supp/pg917"/>

                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Austria-Hungary</hi> (<hi rendition="#italic">Penfield</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-02-29T18:00:00-05:00">
                            <hi rendition="#italic">February 29, 1916, 6 p. m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>1148. Your 1167, February 26. Communicate to Austrian Foreign Office substance
                    telegram 83, February 25 from Vopicka,
                    and <pb facs="1204" n="918" xml:id="pg918"/> ascertain definitely attitude
                    Austrian Government relative this matter. Prompt reply urgently desired.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
