    <text>
        <body>
            <div xml:id="d932">

                <pb facs="0999" n="713" xml:id="pg713"/>

                <note rend="inline" type="source">File No. 763.72111/4231</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Chile</hi> (<hi
                            rendition="#italic">Shea</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-11-14T15:00:00-05:00">
                            <hi rendition="#italic">November 14, 1916, 3 p. m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your November 11, 4 p. m. Department’s November 10, 2 p. m., would apply as well
                    to battleships or destroyers.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
