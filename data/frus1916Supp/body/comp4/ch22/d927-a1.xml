    <text>
        <body>
            <div xml:id="d927-a1">

                <pb facs="0995" n="709" xml:id="pg709"/>

                <opener>
                    <seg rendition="#center">[Enclosure—Translation]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">The German Foreign Office to
                        the American Embassy
                    </hi>
                </head>
                <p rendition="#flush">Nr. III a 3400/39494</p>
                <p rendition="#center">
                    <hi rendition="#small-caps">Note Verbale</hi>
                </p>
                <p>The Foreign Office has the honor to transmit herewith to the American Embassy two
                    copies of a memorandum regarding the stand taken by the Imperial German
                    Government in regard to the supply of munitions during the Spanish-American war
                    of 1898, and to request that the contents of said memorandum be brought to the
                    attention of the American Government.</p>
                <closer>
                    <dateline rendition="#float-left">
                        <placeName>
                            <hi rendition="#small-caps">Berlin</hi>
                        </placeName>, <date calendar="gregorian" when="1916-02-29">
                            <hi rendition="#italic">February 29, 1916</hi>
                        </date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
