    <text>
        <body>
            <div xml:id="d1004">

                <pb facs="1053" n="767" sameAs="frus:frus1916Supp/pg767"/>

                <note rend="inline" type="source">File No. 763.72111D48/13</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Germany</hi> (<hi rendition="#italic"
                    >Gerard</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berlin</hi></placeName>, <date
                            calendar="gregorian" when="1916-07-15T13:00:00+02:00">
                            <hi rendition="#italic">July 15, 1916, 1 p. m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received July 16, 8 p. m.</hi>]</dateline>
                </opener>
                <p>4123. Will <hi rendition="#italic">Deutschland</hi> be recognized as merchant
                    vessel? Germans much interested.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Gerard</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
