    <text>
        <body>
            <div xml:id="d1016">

                <pb facs="1060" n="774" sameAs="frus:frus1916Supp/pg774"/>

                <note rend="inline" type="source">File No. 763.72/2938</note>
                <head>
                    <hi rendition="#italic">The British Ambassador</hi> (<hi rendition="#italic">Spring
                        Rice</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 309</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-10-13">
                            <hi rendition="#italic">October 13 1916</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received October 14</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: In compliance with a verbal request I have
                    the honour to transmit herewith an affidavit signed by C. Smith, master of the ship <hi
                        rendition="#italic">Stephano</hi> sunk by a German submarine off the
                    American coast.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Cecil Spring Rice</hi>
                        
                    </signed>
                </closer>



                <xi:include href="d1016-a1.xml" xpointer="d1016-a1"/>
            </div>
