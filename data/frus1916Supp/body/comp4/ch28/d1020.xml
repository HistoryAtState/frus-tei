    <text>
        <body>
            <div xml:id="d1020">

                <pb facs="1063" n="777" sameAs="frus:frus1916Supp/pg777"/>

                <note rend="inline" type="source">File No. 763.72/2951</note>
                <head>
                    <hi rendition="#italic">The Minister in Sweden</hi> (<hi
                            rendition="#italic">Morris</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Stockholm</hi></placeName>, <date
                            calendar="gregorian" when="1916-10-16T12:00:00+01:00">
                            <hi rendition="#italic">October 16, 1916, 12 p. m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received October 17, 12.35 a.
                        m.</hi>]</dateline>
                </opener>
                <p>144. Foreign. Office informs me Swedish attitude regarding commercial submarines
                    corresponds to attitude adopted by American Government and that war submarines,
                    with exceptions noted my 142, October 14, 6 p. m.,<anchor n="1"
                        xml:id="d1020-f1"/> will be attacked.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">American Minister</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
