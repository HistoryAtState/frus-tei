    <text>
        <body>
            <div xml:id="d955">

                <pb facs="1013" n="727" sameAs="frus:frus1916Supp/pg727"/>

                <note rend="inline" type="source">File No. 763.72111Ap4/33</note>
                <head>
                    <hi rendition="#italic">The British Ambassador</hi> (<hi rendition="#italic">Spring
                        Rice</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-02-17">
                            <hi rendition="#italic">February 17, 1916</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received February 19</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Secretary</hi>: I have just received a
                    telegram from my Government instructing me to express the desire that the United
                    States Government should see its way to giving me an assurance that the <hi
                        rendition="#italic">Appam</hi> will not be allowed to leave pending a
                    decision as to her status. They also request that reasonable notice should be
                    given of the date on which such a decision will be notified, or from which it
                    will be operative.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Cecil Spring Rice</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
