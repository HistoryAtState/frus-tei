    <text>
        <body>
            <div xml:id="d2">

                <pb facs="0299" n="13" sameAs="frus:frus1916Supp/pg13"/>

                <note rend="inline" type="source">File No. 763.72/2330</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Italy</hi> (<hi rendition="#italic">Page</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Rome</hi></placeName>, <date
                            calendar="gregorian" when="1916-01-01">
                            <hi rendition="#italic">January 1, 1916</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received 1.30 p. m.</hi>]</dateline>
                </opener>
                <p>521. Press reports declaration war against Austria and Bulgaria by Essad Pasha’s <hi rendition="#italic">de
                        facto</hi> government, Albania.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">American Embassy</hi>
                    </signed>
                </closer>
            </div>
