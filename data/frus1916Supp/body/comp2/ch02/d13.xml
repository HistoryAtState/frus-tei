    <text>
        <body>
            <div xml:id="d13">

                <pb facs="0305" n="19" xml:id="pg19"/>

                <note rend="inline" type="source">File No. 763.72/2499</note>
                <head>
                    <hi rendition="#italic">The Minister in Portugal</hi> (<hi rendition="#italic">Birch</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Lisbon</hi></placeName>, <date
                            calendar="gregorian" when="1916-03-16T11:00:00+00:00">
                            <hi rendition="#italic">March 16, 1916, 11 a. m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 5 p. m.</hi>]</dateline>
                </opener>
                <p>36. Diplomatic relations broken off between Portugal and Austria-Hungary. No
                    declaration of war. Austro-Hungarian Minister leaving to-day.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Birch</hi>
                        
                    </signed>
                </closer>
                <postscript>
                    <p>[For statements regarding peace terms and the possibility of mediation made
                        by the Chancellor in a conversation with the Ambassador, see telegram No.
                        3640, March 18, 1916, received March 19, from the Ambassador in Germany, <hi
                            rendition="#italic">post</hi>, <ref target="#pg207">page 207</ref>.]</p>
                </postscript>
            </div>
        </body>
