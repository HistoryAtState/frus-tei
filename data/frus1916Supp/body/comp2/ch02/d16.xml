    <text>
        <body>
            <div xml:id="d16">

                <pb facs="0306" n="20" xml:id="pg20"/>

                <note rend="inline" type="source">File No. 763.72119/137</note>
                <head>
                    <hi rendition="#italic">The Minister in Switzerland</hi> (<hi rendition="#italic"
                        >Stovall</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berne</hi></placeName>, <date
                            calendar="gregorian" when="1916-03-25">
                            <hi rendition="#italic">March 25, 1916, noon</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received March 26, 9 a.
                        m.</hi>]</dateline>
                </opener>
                <p>340. Indications in diplomatic circles here suggest that Turkey is desirous of
                    making separate peace with Allies.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Stovall</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
