                <head>
                    <hi rendition="#italic">The Secretary of State to the Chargé in Germany</hi>
                        (<hi rendition="#italic">Grew</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-12-05T17:00:00-05:00">
                            <hi rendition="#italic">December 5, 1916, 5 p. m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>3644. Our 3621, November 29.<anchor n="1" xml:id="d103-f1"/> Please report if
                    message received and what action taken.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
