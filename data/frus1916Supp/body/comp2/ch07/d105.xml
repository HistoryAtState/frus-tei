    <text>
        <body>
            <div xml:id="d105">

                <pb facs="0366" n="80" xml:id="pg80"/>

                <note rend="inline" type="source">File No. 868.00/85</note>
                <head>
                    <hi rendition="#italic">The Minister in Greece</hi> (<hi rendition="#italic">Droppers</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Athens</hi></placeName>, <date
                            calendar="gregorian" when="1916-12-06T22:00:00+02:00">
                            <hi rendition="#italic">December 6, 1916, 10 p. m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received December 7, 8 a. m.</hi>]</dateline>
                </opener>
                <p>194. Your 154.<anchor n="1" xml:id="d105-f1"/> All Legation staff safe; situation
                    unaltered since yesterday. Systematic quiet persecution Venizelists
                    continues.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Droppers</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
