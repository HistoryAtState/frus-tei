    <text>
        <body>
            <div xml:id="d114">

                <pb facs="0369" n="83" sameAs="frus:frus1916Supp/pg83"/>

                <note rend="inline" type="source">File No. 763.72/3059</note>
                <head>
                    <hi rendition="#italic">The Minister in Greece</hi> (<hi rendition="#italic"
                        >Droppers</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Athens</hi></placeName>, <date
                            calendar="gregorian" when="1916-12-11T10:00:00+02:00">
                            <hi rendition="#italic">December 11, 1916, 10 a. m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received December 12, 9 a.
                        m.</hi>]</dateline>
                </opener>
                <p>199. Greek Minister for Foreign Affairs, in protest against blockade to neutral
                    legations as contrary to international law, draws attention to peaceful
                    relations subsisting between Greece and Allies and their failure to allege
                    motive.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Droppers</hi>
                    </signed>
                </closer>
            </div>
        </body>
