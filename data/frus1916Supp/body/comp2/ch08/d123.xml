    <text>
        <body>
            <div xml:id="d123">

                <pb facs="0375" n="89" sameAs="frus:frus1916Supp/pg89"/>

                <note rend="inline" type="source">File No. 763.72119/201</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Austria-Hungary</hi> (<hi rendition="#italic"
                        >Penfield</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Vienna</hi></placeName>, <date
                            calendar="gregorian" when="1916-12-12T14:00:00+01:00">
                            <hi rendition="#italic">December 12, 1916, 2 p. m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received December 14, 11 a.
                        m.</hi>]</dateline>
                </opener>
                <p>1573. Note No. 5915, dated December 12, 1916, from Austro-Hungarian Ministry of
                    Foreign Affairs just received.<anchor n="1" xml:id="d123-f1"/> . . .</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Penfield</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d123-f1" n="1" xml:id="d123-f1-content">
                <p>See footnote to telegram No. 4722, December 12, from the Chargé in Germany, <hi
                        rendition="#italic">ante</hi>, <ref target="#pg86">p. 86</ref>. The
                    translation sent by the Embassy in Austria-Hungary is printed, as enclosure to
                    despatch No 2308, in the publications cited in footnote 1 to telegram No. 4726
                    from the Chargé in Germany, <hi rendition="#italic">post</hi>, <ref
                        target="#pg90">p. 90</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
