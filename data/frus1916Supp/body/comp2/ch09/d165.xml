    <text>
        <body>
            <div xml:id="d165">

                <pb facs="0402" n="116" sameAs="frus:frus1916Supp/pg116"/>

                <note rend="inline" type="source">File No. 763.72119/240</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Chargé in Spain</hi> (<hi
                            rendition="#italic">Wilson</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-12-27T15:00:00-05:00">
                            <hi rendition="#italic">December 27, 1916, 3 p. m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>200. Your 302, December 22, 8 p. m.<anchor n="1" xml:id="d165-f1"/> Department’s
                    197, December 20, 7 p. m.,<anchor n="2" xml:id="d165-f2"/> was intended for
                    Spanish Government alone, and has not been sent to other neutral powers.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
