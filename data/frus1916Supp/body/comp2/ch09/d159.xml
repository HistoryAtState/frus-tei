    <text>
        <body>
            <div xml:id="d159">

                <pb facs="0398" n="112" sameAs="frus:frus1916Supp/pg112"/>

                <note rend="inline" type="source">File No. 763.72119/242</note>
                <head>
                    <hi rendition="#italic">The Minister in Norway</hi> (<hi rendition="#italic"
                        >Schmedeman</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Christiania</hi></placeName>, <date
                            calendar="gregorian" when="1916-12-23T14:00:00+01:00">
                            <hi rendition="#italic">December 23, 1916, 2 p. m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received December 24, 7.50 p.
                        m.</hi>]</dateline>
                </opener>
                <p>109. Department’s circular telegram December 20.<anchor n="2" xml:id="d159-f1"/>
                    The Minister for Foreign Affairs requests me to extend to the President his
                    sincere congratulations on his note to the belligerents and states that the
                    Norwegian Government stands ready to cooperate with the President in any action
                    he may take regarding peace proposals.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Schmedeman</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
