    <text>
        <body>
            <div xml:id="d59">

                <pb facs="0333" n="47" sameAs="frus:frus1916Supp/pg47"/>

                <note rend="inline" type="source">File No. 763.72/2826</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Italy</hi> (<hi rendition="#italic">Page</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Rome</hi></placeName>, <date
                            calendar="gregorian" when="1916-08-27T20:00:00+02:00">
                            <hi rendition="#italic">August 27, 1916, 8 p. m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received August 28, 9.50 a.
                        m.</hi>]</dateline>
                </opener>
                <p>695. To-night’s late editions evening papers announce officially Italian
                    Government has sent through Swiss Government declaration war against Germany
                    effective from to-morrow, August 28.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">American Embassy</hi>
                    </signed>
                </closer>
            </div>
