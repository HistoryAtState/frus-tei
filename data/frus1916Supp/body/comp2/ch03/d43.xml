    <text>
        <body>
            <div xml:id="d43">

                <pb facs="0321" n="35" sameAs="frus:frus1916Supp/pg35"/>

                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Germany</hi>
                        (<hi rendition="#italic">Gerard</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-05-13T16:00:00-05:00">
                            <hi rendition="#italic">June 13, 1916, 4 p. m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>3085. Your 3972, June 8. You are authorized to say that the Department has given
                    no statement whatsoever in regard to the internal economic conditions of
                    Germany.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
