    <text>
        <body>
            <div xml:id="d52">

                <pb facs="0326" n="40" sameAs="frus:frus1916Supp/pg40"/>

                <note rend="inline" type="source">File No. 871.6131/2</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Germany</hi> (<hi rendition="#italic"
                        >Gerard</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berlin</hi></placeName>, <date
                            calendar="gregorian" when="1916-08-10">
                            <hi rendition="#italic">August 10, 1916</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received August 11, 12
                        noon</hi>.]</dateline>
                </opener>
                <p>4214. New agreement between Roumania and Central powers concluded regarding sale
                    approximately 2,000 railway carloads peas at 5,600 lei each and 6,000 carloads
                    barley for brewing purposes at 4,500 lei each.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Gerard</hi>
                    </signed>
                </closer>
            </div>
        </body>
