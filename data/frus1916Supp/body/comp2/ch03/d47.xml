    <text>
        <body>
            <div xml:id="d47">

                <pb facs="0323" n="37" sameAs="frus:frus1916Supp/pg37"/>

                <note rend="inline" type="source">File No. 862.00/32</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Germany</hi> (<hi rendition="#italic"
                        >Gerard</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berlin</hi></placeName>, <date
                            calendar="gregorian" when="1916-06-29T13:00:00+02:00">
                            <hi rendition="#italic">June 29, 1916, 1 p. m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received June 30, 12.40 p.
                        m.</hi>]</dateline>
                </opener>
                <p>4071. Liebknecht sentenced to penitentiary for 2 years, 6 months, 3 days, by
                    court martial. Small disturbances in Berlin. Reported that workers in several
                    ammunition factories on strike. Streets filled with police.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Gerard</hi>
                    </signed>
                </closer>
            </div>
        </body>
