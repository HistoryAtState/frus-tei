    <text>
        <body>
            <div xml:id="d174">

                <pb facs="0407" n="121" sameAs="frus:frus1916Supp/pg121"/>

                <note rend="inline" type="source">File No. 763.72119/313</note>
                <head>
                    <hi rendition="#italic">The Norwegian Minister</hi> (<hi rendition="#italic"
                        >Bryn</hi>) <hi rendition="#italic">to the Secretary of State </hi><anchor
                        n="2" xml:id="d174-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-12-29">
                            <hi rendition="#italic">December 29, 1916</hi>
                        </date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary of State</hi>: I have pleasure
                    in handing you enclosed copy of a note which my Government has to-day addressed
                    to the governments of the belligerent nations.</p>
                <p>Believe me [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">H. Bryn</hi>
                    </signed>
                </closer>


                <xi:include href="d174-a1.xml" xpointer="d174-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d174-f1" n="2" type="source" xml:id="d174-f1-content">
                <p>Communications transmitting copies of notes, identical with the enclosure,
                    addressed to the belligerent governments by their own governments, were received
                    from the Danish Minister, December 29, and from the Swedish Minister, December
                    30, 1916 (File Nos. 763.72119/312, 345).</p>
            </note>
        </listAnnotation>
    </standOff>
