    <text>
        <body>
            <div xml:id="d85">

                <pb facs="0353" n="67" xml:id="pg67"/>

                <note rend="inline" type="source">File No. 763.72119/184</note>
                <head>
                    <hi rendition="#italic">The Chargé in Germany</hi> (<hi rendition="#italic">Grew</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berlin</hi></placeName>, <date
                            calendar="gregorian" when="1916-11-20T19:00:00+01:00">
                            <hi rendition="#italic">November 20, 1916, 7 p. m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received November 21, 4.50 p.
                        m.</hi>]</dateline>
                </opener>
                <p>4626. Referring to my telegram 4614,<anchor n="1" xml:id="d85-f1"/> November 17.
                        Hale’s cablegram has been unexpectedly delayed owing to
                    the Chancellor’s departure for General Headquarters but he expects to be able to
                    send it within a few days.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Grew</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
