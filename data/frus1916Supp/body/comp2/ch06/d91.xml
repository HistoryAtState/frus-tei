    <text>
        <body>
            <div xml:id="d91">

                <pb facs="0356" n="70" sameAs="frus:frus1916Supp/pg70"/>

                <note rend="inline" type="source">File No. 763.72/3031</note>
                <head>
                    <hi rendition="#italic">The Consul at Saloniki</hi> (<hi rendition="#italic"
                        >Kehl</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Saloniki</hi></placeName>, <date
                            calendar="gregorian" when="1916-11-24T19:00:00+02:00">
                            <hi rendition="#italic">November 24, 1916, 7 p. m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received November 29, 8.10 a.
                        m.</hi>]</dateline>
                </opener>
                <p>The Provisional Government of Greece, Saloniki, declares war on Bulgaria and
                    Germany as from to-day.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">American Consul</hi>
                    </signed>
                </closer>
            </div>
        </body>
