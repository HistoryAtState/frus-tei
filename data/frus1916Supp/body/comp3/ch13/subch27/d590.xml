    <text>
        <body>
            <div xml:id="d590">

                <pb facs="0770" n="484" sameAs="frus:frus1916Supp/pg484"/>

                <note rend="inline" type="source">File No. 300.115/10757</note>
                <head>
                    <hi rendition="#italic">The Vice Consul at London</hi> (<hi rendition="#italic"
                        >Westacott</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1916-11-10">
                            <hi rendition="#italic">November 10, 1916</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received November 21</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith, in
                    duplicate, a return of shipping detentions at Kirkwall during the month of
                    October 1916.</p>
                <p>I have [etc]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Richard Westacott</hi>
                    </signed>
                </closer>



                <xi:include href="d590-a1.xml" xpointer="d590-a1"/>
