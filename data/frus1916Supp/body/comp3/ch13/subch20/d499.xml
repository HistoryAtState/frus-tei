    <text>
        <body>
            <div xml:id="d499">

                <pb facs="0682" n="396" xml:id="pg396"/>

                <note rend="inline" type="source">File No. 763.72112/2609</note>
                <head>
                    <hi rendition="#italic">The Consul General at London</hi> (<hi rendition="#italic"
                        >Skinner</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1916-06-06">
                            <hi rendition="#italic">June 6, 1916</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received 2 p. m.</hi>]</dateline>
                </opener>
                <p>Department’s May 3.<anchor n="1" xml:id="d499-f1"/> Only information available
                        <hi rendition="#italic">re</hi> value of detained cargo is statement that on
                    June 2 “estimated value such cargo so far as can be gauged amounts approximately
                    to four million pounds.”</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Skinner</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
