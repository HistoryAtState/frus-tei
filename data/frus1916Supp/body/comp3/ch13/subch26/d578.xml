    <text>
        <body>
            <div xml:id="d578">

                <pb facs="0746" n="460" sameAs="frus:frus1916Supp/pg460"/>

                <note rend="inline" type="source">File No. 300.115/10373</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Page</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1916-10-19">
                            <hi rendition="#italic">October 19, 1916</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received 8.55 p. m.</hi>]</dateline>
                </opener>
                <p>5049. Your 3913,<anchor n="1" xml:id="d578-f1"/> October 10. Foreign Office
                    informs that on receipt of Embassy’s note the British Government was at once
                    requested to authorize the granting of bunkers to the S. S. <hi
                        rendition="#italic">Pathfinder</hi>.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Page</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
