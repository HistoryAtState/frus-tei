    <text>
        <body>
            <div xml:id="d581">

                <pb facs="0747" n="461" sameAs="frus:frus1916Supp/pg461"/>

                <note rend="inline" type="source">File No. 763.72112/3088</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Page</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 5021</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1916-10-12">
                            <hi rendition="#italic">October 12, 1916</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received October 24</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to the Department’s
                    telegram No. 3578,<anchor n="2" xml:id="d581-f1"/> of July 26, 1916, 10 p. m.,
                    and to my telegram No. 5003,<anchor n="3" xml:id="d581-f2"/> of the 11th <pb
                        facs="0748" n="462" xml:id="pg462"/> instant, I have the honor to enclose
                    herewith a printed copy of a note I have received from the Foreign Office
                    concerning the Trading with the Enemy Act.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Walter Hines Page</hi>
                    </signed>
                </closer>


                <xi:include href="d581-a1.xml" xpointer="d581-a1"/>
            </div>
        </body>
    </text>
