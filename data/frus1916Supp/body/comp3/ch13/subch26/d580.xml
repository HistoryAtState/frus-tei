    <text>
        <body>
            <div xml:id="d580">

                <pb facs="0747" n="461" sameAs="frus:frus1916Supp/pg461"/>

                <note rend="inline" type="source">File No. 763.72112/3089</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Page</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 4988</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1916-10-11">
                            <hi rendition="#italic">October 11, 1916</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received October 24</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the
                    receipt of the Department’s instruction No. 4191,<anchor n="1" xml:id="d580-f1"
                    /> of September 18, with respect to the Maritime Eights Order in Council, 1916,
                    and in reply to enclose herewith, for the information of the Department, a copy
                    of the note which has been received from the Foreign Office, under date of
                    October 10, in response to the Embassy’s representations in the premises.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Walter Hines Page</hi>
                    </signed>
                </closer>


                <xi:include href="d580-a1.xml" xpointer="d580-a1"/>
            </div>
        </body>
    </text>
