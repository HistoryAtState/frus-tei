                <pb facs="0669" n="383" sameAs="frus:frus1916Supp/pg383"/>

                <note rend="inline" type="source">File No. 763.72112/2475</note>
                <head>
                    <hi rendition="#italic">The Vice Consul at London</hi> (<hi rendition="#italic"
                        >Westacott</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1916-04-27">
                            <hi rendition="#italic">April 27, 1916</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received 6 p. m.</hi>]</dateline>
                </opener>
                <p>Department’s 22d to Ambassador [Consul General?].<anchor n="1" xml:id="d484-f1"/>
                    Figures showing value merchandise in prize court not available. Total goods sold
                    by prize court to March 31, £6,208,963.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Westacott</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
