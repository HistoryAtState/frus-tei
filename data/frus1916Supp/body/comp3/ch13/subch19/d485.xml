    <text>
        <body>
            <div xml:id="d485">

                <pb facs="0669" n="383" sameAs="frus:frus1916Supp/pg383"/>

                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Great Britain</hi> (<hi
                            rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-05-03T16:00:00-05:00">
                            <hi rendition="#italic">May 3, 1916, 4 p. m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Deliver following to Consul General:</p>
                <quote rend="blockquote">
                    <p>Your 27th <hi rendition="#italic">re</hi> value merchandise in prize court.
                        Is it not possible to get reasonably close estimates particularly with
                        reference American goods?</p>
                </quote>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
