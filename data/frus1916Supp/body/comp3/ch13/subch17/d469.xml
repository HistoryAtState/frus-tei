    <text>
        <body>
            <div xml:id="d469">

                <pb facs="0644" n="358" sameAs="frus:frus1916Supp/pg358"/>

                <note rend="inline" type="source">File No. 763.72112/2361</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Page</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 3191</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1916-03-07">
                            <hi rendition="#italic">March 7, 1916</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received March 20</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith, for
                    the information of the Department, a copy, in duplicate, of a proclamation
                    prohibiting <pb facs="0645" n="359" xml:id="pg359"/> trading with certain
                    persons, or bodies of persons, of enemy nationality or of enemy associations,
                    entitled the “Statutory List”, dated February 29, 1916, which has been received
                    by the Embassy from the Foreign Office.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Walter Hines Page</hi>
                    </signed>
                </closer>


                <xi:include href="d469-a1.xml" xpointer="d469-a1"/>
            </div>
