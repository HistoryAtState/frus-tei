    <text>
        <body>
            <div xml:id="d510">

                <pb facs="0695" n="409" sameAs="frus:frus1916Supp/pg409"/>

                <note rend="inline" type="source">File No. 763.72112/2726</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Germany</hi> (<hi rendition="#italic"
                    >Gerard</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 3488</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berlin</hi></placeName>, <date
                            calendar="gregorian" when="1916-06-29">
                            <hi rendition="#italic">June 29, 1916</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received July 17</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: At the request of the Imperial Foreign
                    Office I have the honor to enclose herewith an original copy of a “memorandum
                    prepared by the Imperial German Government, respecting the British measures, in
                    violation of international law, against neutral firms which maintain commercial
                    relations with Germans.” A translation of this document is appended hereto.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">James W. Gerard</hi>
                        
                    </signed>
                </closer>


                <xi:include href="d510-a1.xml" xpointer="d510-a1"/>
            </div>
