    <text>
        <body>
            <div xml:id="d518">

                <pb facs="0704" n="418" sameAs="frus:frus1916Supp/pg418"/>

                <note rend="inline" type="source">File No. 763.72112/2742</note>
                <head>
                    <hi rendition="#italic">The Russian Ambassador</hi> (<hi rendition="#italic">Bakhméteff</hi>) <hi
                        rendition="#italic">to the Acting Secretary of
                            State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 523</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Newport, R. I.</hi></placeName>, <date
                            calendar="gregorian" when="1916-07-20">
                            <hi rendition="#italic">July 20, 1916</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received July 25</hi>.]</dateline>
                </opener>
                <p rendition="#center">[Translation]</p>
                <p>
                    <hi rendition="#small-caps">Mr. Acting Secretary</hi>: I am instructed to inform
                    you that the Imperial Government, desirous of acting in perfect accord with its
                    allies on questions of maritime warfare, joins the English and French
                    Governments in denouncing the Declaration of London of 1909.</p>
                <p>Begging you to make the foregoing known to the Federal Government, I take this
                    opportunity [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">G. Bakhméteff</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
