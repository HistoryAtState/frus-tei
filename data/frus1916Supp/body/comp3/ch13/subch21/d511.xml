    <text>
        <body>
            <div xml:id="d511">

                <pb facs="0697" n="411" xml:id="pg411"/>

                <note rend="inline" type="source">File No. 763.72112/2731</note>
                <head>
                    <hi rendition="#italic">The Consul General at London</hi> (<hi
                        rendition="#italic">Skinner</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1916-07-19">
                            <hi rendition="#italic">July 19, 1916</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received 8 a. m.</hi>]</dateline>
                </opener>
                <p>Proclamation published blacklisting 85 concerns domiciled in United States with
                    whom trade relations prohibited as provided in Trading with Enemy (Extension of
                    Powers) Act. List follows by mail unless otherwise ordered.<anchor n="1"
                        xml:id="d511-f1"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Skinner</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
