    <text>
        <body>
            <div xml:id="d545">

                <pb facs="0723" n="437" sameAs="frus:frus1916Supp/pg437"/>

                <note rend="inline" type="source">File No. 763.72112/2938</note>
                <head>
                    <hi rendition="#italic">The Netherland Minister</hi> (<hi rendition="#italic"
                        >Van Rappard</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 4063</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-08-30">
                            <hi rendition="#italic">August 30, 1916</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received August 31</hi>.]</dateline>
                </opener>
                <p rendition="#center">[Translation]</p>
                <p>
                    <hi rendition="#small-caps">Mr. Secretary of State</hi>: By order of my
                    Government I have the honor to forward herewith to your excellency, for your
                    information, the text of notes that the Queen’s Government has addressed to the
                    British, French, and German Governments with respect to the British order in
                        council<anchor n="2" xml:id="d545-f1"/> repealing the order in council of
                    October 29, 1914, making the rules framed by the Declaration of London of
                    February 26, 1909 applicable with certain amendments and additions, the French
                    decree of July 7 last<anchor n="3" xml:id="d545-f2"/> which also repeals the
                    above-mentioned declaration, and the German decree of July 22 last<anchor n="4"
                        xml:id="d545-f3"/> containing additional lists of contraband of war and
                    further amendments and additions to the German prize code of September 30,
                    1909.</p>
                <p>Be pleased to accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. L. F. C. van Rappard</hi>
                    </signed>
                </closer>





