    <text>
        <body>
            <div xml:id="d551">

                <pb facs="0727" n="441" sameAs="frus:frus1916Supp/pg441"/>

                <note rend="inline" type="source">File No. 763.72112/2948a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Chargé in Great
                        Britain</hi> (<hi rendition="#italic">Laughlin</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-09-08T18:00:00-05:00">
                            <hi rendition="#italic">September 8, 1916, 6 p. m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>3806. Your 4814,<anchor n="1" xml:id="d551-f1"/> September 1, 12 noon. You will
                    say to Foreign Office that this Government would like to be informed as to
                    conditions under which the British Government subordinate the granting of
                    bunkering facilities to neutral ships.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
