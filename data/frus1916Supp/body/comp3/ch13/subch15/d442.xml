    <text>
        <body>
            <div xml:id="d442">

                <pb facs="0614" n="328" sameAs="frus:frus1916Supp/pg328"/>

                <note rend="inline" type="source">File No. 341.115Am319/91</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Great
                        Britain</hi> (<hi rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-12-29">
                            <hi rendition="#italic">December 29, 1915</hi>
                        </date>.</dateline>
                </opener>
                <p>2646. Ascertain and report promptly whereabouts and status of American
                    Transatlantic S. S. <hi rendition="#italic">Kankakee</hi>, seized last days of
                    October near Montevideo. Owners unable to communicate with ship’s captain.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
