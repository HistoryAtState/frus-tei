    <text>
        <body>
            <div xml:id="d445">

                <pb facs="0615" n="329" sameAs="frus:frus1916Supp/pg329"/>

                <note rend="inline" type="source">File No. 763.72112/2080</note>
                <head>
                    <hi rendition="#italic">The British Ambassador</hi> (<hi rendition="#italic"
                        >Spring Rice</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-01-05">
                            <hi rendition="#italic">January 5, 1916</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received January 6</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I have not failed to
                    communicate to my Government by telegram the substance of your unofficial letter
                    of to-day’s date requesting me to enquire of my Government when you may expect
                    its formal answer to your note of October 21 on the subject of trade
                    restrictions.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Cecil Spring Rice</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
