    <text>
        <body>
            <div xml:id="d457">

                <pb facs="0631" n="345" sameAs="frus:frus1916Supp/pg345"/>

                <note rend="inline" type="source">File No. 763.72112/2217</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Page</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 2903</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1916-01-24">
                            <hi rendition="#italic">January 24, 1916</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received February 17</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to the Department’s cablegram
                    No. 2599 of December 19 [18], 1915,<anchor n="1" xml:id="d457-f1"/> in regard to
                    British trade regulations now in force in China and the effect thereof on
                    American trade with that country, I have the honor to enclose herewith, for the
                    information of the Department, a copy of the memorandum received from the
                    Foreign Office in reply to my representations in this connection, and to which
                    reference is made in my cablegram No. 3637 of to-day’s date.<anchor n="2"
                        xml:id="d457-f2"/>
                </p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Walter Hines Page</hi>
                    </signed>
                </closer>


                <xi:include href="d457-a1.xml" xpointer="d457-a1"/>
            </div>
        </body>
    </text>
