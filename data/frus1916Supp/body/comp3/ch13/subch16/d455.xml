    <text>
        <body>
            <div xml:id="d455">

                <pb facs="0627" n="341" sameAs="frus:frus1916Supp/pg341"/>

                <note rend="inline" type="source">File No. 763.72112/2175</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Page</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 2878</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1916-01-20">
                            <hi rendition="#italic">January 20, 1916</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received February 1</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose, herewith, two
                    clippings from the <hi rendition="#italic">Morning Post</hi> of the 18th
                        instant.<anchor n="1" xml:id="d455-f1"/> The article from the Washington
                    correspondent of this paper is important and is exciting much comment and
                    interest.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Walter Hines Page</hi>
                    </signed>
                </closer>



                <xi:include href="d455-a1.xml" xpointer="d455-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d455-f1" n="1" xml:id="d455-f1-content">
                <p>As the two articles are rather similar in context, only one is here printed.</p>
            </note>
        </listAnnotation>
