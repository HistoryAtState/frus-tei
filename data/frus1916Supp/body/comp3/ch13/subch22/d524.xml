    <text>
        <body>
            <div xml:id="d524">

                <pb facs="0708" n="422" sameAs="frus:frus1916Supp/pg422"/>

                <note rend="inline" type="source">File No. 341.115Am319/236</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Page</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 4292</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1916-07-19">
                            <hi rendition="#italic">July 19, 1916</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received July 31</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to the Department’s
                    cablegram No. 3393 of June 3,<anchor n="1" xml:id="d524-f1"/> and to previous
                    correspondence in regard to the American Transatlantic Company, I have the honor
                    to enclose herewith, for the information of the Department, a copy of the note
                    which has been received from the Foreign Office, under date of July 18, in reply
                    to the Embassy’s representations in the premises based upon the Department’s
                    cablegram above mentioned.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Walter Hines Page</hi>
                    </signed>
                </closer>



                <xi:include href="d524-a1.xml" xpointer="d524-a1"/>
            </div>
        </body>
    </text>
