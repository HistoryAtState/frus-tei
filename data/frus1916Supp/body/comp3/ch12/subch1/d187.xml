    <text>
        <body>
            <div xml:id="d187">

                <pb facs="0429" n="143" sameAs="frus:frus1916Supp/pg143"/>

                <note rend="inline" type="source">File No. 841.857P43</note>
                <head>
                    <hi rendition="#italic">The Consul General at London</hi> (<hi rendition="#italic"
                        >Skinner</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1916-01-01">
                            <hi rendition="#italic">January 1, 1916</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received 9 a. m.</hi>]</dateline>
                </opener>
                <p>P. &amp; O. liner <hi rendition="#italic">Persia</hi> reported sunk, submarine,
                    while approaching Alexandria. Robert N.
                        McNeely, American Consul, Aden, going to post, left London as
                    passenger. Nearly all on board perished.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Skinner</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
