    <text>
        <body>
            <div xml:id="d330">

                <pb facs="0537" n="251" sameAs="frus:frus1916Supp/pg251"/>

                <note rend="inline" type="source">File No. 763.72/2638a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Great Britain</hi> (<hi
                            rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-04-28T18:00:00-05:00">
                            <hi rendition="#italic">April 28, 1916, 6 p. m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>3253. I learned from the British Ambassador that the British Government
                    transmitted to you copies of its instructions to British armed merchantmen dated
                    October 20, 1915, but Department has no record of having received them from you.
                    Please forward copies in next pouch.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
