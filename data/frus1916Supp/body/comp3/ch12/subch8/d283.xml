    <text>
        <body>
            <div xml:id="d283">

                <pb facs="0502" n="216" sameAs="frus:frus1916Supp/pg216"/>

                <note rend="inline" type="source">File No. 841.857En3/4</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Germany</hi> (<hi
                            rendition="#italic">Gerard</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-03-29">
                            <hi rendition="#italic">March 29, 1916, noon</hi>
                        </date>.</dateline>
                </opener>
                <p>2859. Department’s March 28, 4 p. m. <hi rendition="#italic">Englishman</hi>.
                    Department now has affidavit of American citizen stating that <hi
                        rendition="#italic">Englishman</hi> was sunk by German submarine <hi
                        rendition="#italic">U–19</hi> which he saw. Please add this to your previous
                    statement to the Foreign Office in regard to the steamer <hi rendition="#italic"
                        >Englishman</hi>.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
