    <text>
        <body>
            <div xml:id="d263">

                <pb facs="0492" n="206" sameAs="frus:frus1916Supp/pg206"/>

                <note rend="inline" type="source">File No. 763.72/2501</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Austria-Hungary</hi> (<hi rendition="#italic"
                        >Penfield</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Vienna</hi></placeName>, <date
                            calendar="gregorian" when="1916-03-15T18:00:00+01:00">
                            <hi rendition="#italic">March 15, 1916, 6 p. m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received March 16, 9.30 p.
                        m.</hi>]</dateline>
                </opener>
                <p>1188. Communicated your 1157<anchor n="1" xml:id="d263-f1"/> to Ministry of
                    Foreign Affairs to-day as instructed. Baron
                        Burian was impressed with clearness of your statement and said
                    that your <hi rendition="#italic">bona fides</hi> could not be questioned. He
                    remarked that the incident involved no question of veracity, but had been a case
                    of misunderstanding.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Penfield</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d263-f1" n="1" xml:id="d263-f1-content">
