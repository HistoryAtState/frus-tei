    <text>
        <body>
            <div xml:id="d255">

                <pb facs="0484" n="198" sameAs="frus:frus1916Supp/pg198"/>

                <note rend="inline" type="source">File No. 763.72/2466</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Germany</hi> (<hi rendition="#italic"
                    >Gerard</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berlin</hi></placeName>, <date
                            calendar="gregorian" when="1916-03-06T16:00:00+01:00">
                            <hi rendition="#italic">March 6, 1916, 4 p. m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received March 7, 11.15 a.
                        m.</hi>]</dateline>
                </opener>
                <p>3579. Learn fair authority Von Tirpitz
                    proposal for unlimited submarine blockade of England rejected in grand council
                    war at Charleville.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Gerard</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
