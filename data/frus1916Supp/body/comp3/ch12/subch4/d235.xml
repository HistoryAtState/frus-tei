    <text>
        <body>
            <div xml:id="d235">

                <pb facs="0459" n="173" sameAs="frus:frus1916Supp/pg173"/>

                <note rend="inline" type="source">File No. 763.72/2449</note>
                <head>
                    <hi rendition="#italic">The German Ambassador</hi> (<hi rendition="#italic"
                        >Bernstorff</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Translation]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-02-19">
                            <hi rendition="#italic">February 19, 1916</hi>
                        </date>.</dateline>
                </opener>
                <p>J. Nr. A 1082</p>
                <p>
                    <hi rendition="#small-caps">Mr. Secretary of State</hi>: Supplementing my
                    communication of the 66th instant, A 1146,<anchor n="2" xml:id="d235-f1"/> 1
                    have the honor to transmit to your excellency a copy of the confidential
                    instructions found on the <hi rendition="#italic">Appam</hi>, which contain,
                    among other things, the direction that any submarine approaching an English
                    merchant vessel is to be treated as hostile.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">J. Bernstorff</hi>
                    </signed>
                </closer>


                <xi:include href="d235-a1.xml" xpointer="d235-a1"/>
            </div>
        </body>
    </text>
