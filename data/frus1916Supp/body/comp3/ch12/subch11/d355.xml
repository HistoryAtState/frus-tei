    <text>
        <body>
            <div xml:id="d355">

                <pb facs="0557" n="271" xml:id="pg271"/>

                <note rend="inline" type="source">File No. 300.115/8525</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Austria-Hungary</hi> (<hi
                        rendition="#italic">Penfield</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Vienna</hi></placeName>, <date
                            calendar="gregorian" when="1916-05-24">
                            <hi rendition="#italic">May 24, 1916, noon</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received May 25, 1.20 p.
                        m.</hi>]</dateline>
                </opener>
                <p>1272. Your 1107, January 31, 4 p. m.<anchor n="1" xml:id="d355-f1"/> Following
                    official notice dated (?) April 22 published in <hi rendition="#italic">Wiener
                        Zeitung</hi> of May 19:</p>
                <quote rend="blockquote">
                    <p>By reason of destruction of Italian steamer <hi rendition="#italic"
                            >Ancona</hi> by ship of Austro-Hungarian naval forces, undersigned Prize
                        Investigation Commission will consider prize court procedure. Parties
                        interested herewith called upon to make known their rightful claims in
                        writing within three months accompanied by legal proof.</p>
                </quote>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Penfield</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
