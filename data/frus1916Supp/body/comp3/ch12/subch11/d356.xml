    <text>
        <body>
            <div xml:id="d356">

                <pb facs="0557" n="271" sameAs="frus:frus1916Supp/pg271"/>

                <note rend="inline" type="source">File No. 300.115/8720a</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Consul General at
                        Hamburg</hi> (<hi rendition="#italic">Morgan</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-05-31T16:00:00-05:00">
                            <hi rendition="#italic">May 31, 1916, 4 p. m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Endeavor ascertain discreetly and without officially communicating with German
                    authorities whether it is their intention [to] institute prize proceedings in
                    case S. S. <hi rendition="#italic">Arabic</hi>.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Polk</hi>
                    </signed>
                </closer>
            </div>
        </body>
