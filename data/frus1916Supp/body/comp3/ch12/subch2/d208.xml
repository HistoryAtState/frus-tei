    <text>
        <body>
            <div xml:id="d208">

                <pb facs="0441" n="155" sameAs="frus:frus1916Supp/pg155"/>

                <note rend="inline" type="source">File No. 300.115/6986a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Austria-Hungary</hi> (<hi rendition="#italic">Penfield</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-01-31T16:00:00-05:00">
                            <hi rendition="#italic">January 31, 1916, 4 p. m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>1107. Inform Department in case prize court proceedings are instituted in
                    relation to steamers <hi rendition="#italic">Ancona, Lasakumi Maru</hi>, and <hi
                        rendition="#italic">Persia</hi>. Do not communicate with Austro-Hungarian
                    authorities regarding this matter.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
