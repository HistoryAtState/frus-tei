    <text>
        <body>
            <div xml:id="d433">

                <pb facs="0609" n="323" sameAs="frus:frus1916Supp/pg323"/>

                <note rend="inline" type="source">File No. 841.857M331/61</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Great
                        Britain</hi> (<hi rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-12-11T17:00:00-05:00">
                            <hi rendition="#italic">December 11, 1916, 5 p. m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>4162. Your 5283<anchor n="3" xml:id="d433-f1"/>, December 6, 7 p. m. Please
                    hasten reply to other inquiries in Department’s 4116, December 2.<anchor n="4"
                        xml:id="d433-f2"/> Was the <hi rendition="#italic">Marina</hi> ever in the
                    service of the British Government, and if so, when did that service cease?</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
