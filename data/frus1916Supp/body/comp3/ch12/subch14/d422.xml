    <text>
        <body>
            <div xml:id="d422">

                <pb facs="0605" n="319" sameAs="frus:frus1916Supp/pg319"/>

                <note rend="inline" type="source">File No. 841.857/243</note>
                <head>
                    <hi rendition="#italic">The Chargé in Germany</hi> (<hi rendition="#italic">Grew</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berlin</hi></placeName>, <date
                            calendar="gregorian" when="1916-12-05T19:00:00+01:00">
                            <hi rendition="#italic">December 5, 1916, 7 p. m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received December 6, 4 p. m.</hi>]</dateline>
                </opener>
                <p>4692. Foreign Office requests me to say that the confidential and oral statement
                    cabled in my 4655,<anchor n="2" xml:id="d422-f1"/> November 27, 3 p. m.,
                    regarding the <hi rendition="#italic">Marina</hi> applies equally to the case of
                    the <hi rendition="#italic">Arabia</hi>.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Grew</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
