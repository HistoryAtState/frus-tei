    <text>
        <body>
            <div xml:id="d429">

                <pb facs="0608" n="322" sameAs="frus:frus1916Supp/pg322"/>

                <note rend="inline" type="source">File No. 857.857/42</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Chargé in Germany</hi>
                        (<hi rendition="#italic">Grew</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-12-09T19:00:00-05:00">
                            <hi rendition="#italic">December 9, 1916, 7 p. m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>3653. Department advised Norwegian steamer <hi rendition="#italic">Trippel</hi>,
                    with American citizens on board, was sunk by German submarine November 11, 18
                    miles off Villarica, while <hi rendition="#italic">en route</hi> from Baltimore
                    to Genoa.</p>
                <p>Bring to attention of Foreign Minister and request prompt investigation and
                    report.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
