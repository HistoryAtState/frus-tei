    <text>
        <body>
            <div xml:id="d388">

                <pb facs="0578" n="292" sameAs="frus:frus1916Supp/pg292"/>

                <note rend="inline" type="source">File No. 763.72/2906a</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Chargé in Germany</hi> (<hi
                            rendition="#italic">Grew</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-10-04T16:00:00-05:00">
                            <hi rendition="#italic">October 4, 1916, 4 p. m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>3448. Department is in receipt of information indicating German Admiralty
                    preparing for early resumption of submarine warfare in violation of neutral
                    rights. Discreetly investigate and report.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Polk</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
