    <text>
        <body>
            <div xml:id="d817">

                <pb facs="0901" n="615" xml:id="pg615"/>

                <note rend="inline" type="source">File No. 841.711/751</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Ambassador in Great Britain</hi> (<hi rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-07-24T17:00:00-05:00">
                            <hi rendition="#italic">July 24, 1916, 5 p. m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>3560. Your 4599. Memorandum published to-day. Please continue to urge British
                    Government to forward the reply of the Allied Governments without further
                    delay.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Polk</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
