    <text>
        <body>
            <div xml:id="d801">

                <pb facs="0881" n="595" xml:id="pg595"/>

                <note rend="inline" type="source">File No. 841.711/213</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Swedish Minister</hi> (<hi
                            rendition="#italic">Ekengren</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-01-28">
                            <hi rendition="#italic">January 28, 1916</hi>
                        </date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I beg to acknowledge the receipt of your
                    note of January 24, 1916, with reference to the interference by the British
                    authorities with the mails exchanged between neutral countries and have noted
                    all of your remarks in connection therewith.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Robert Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
