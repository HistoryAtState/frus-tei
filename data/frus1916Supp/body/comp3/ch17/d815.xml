    <text>
        <body>
            <div xml:id="d815">

                <pb facs="0898" n="612" sameAs="frus:frus1916Supp/pg612"/>

                <note rend="inline" type="source">File No 841.711/349</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Ambassador in Great Britain</hi> (<hi rendition="#italic">Page</hi>)<anchor n="1"
                        xml:id="d815-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-07-19T19:00:00-05:00">
                            <hi rendition="#italic">July 19, 1916, 7 p. m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>3538. Department’s 3363, May 25.<anchor n="2" xml:id="d815-f2"/> Department has
                    received no answer to or acknowledgment of its notes of May 24<anchor n="3"
                        xml:id="d815-f3"/> to the British and French Ambassadors regarding
                    censorship of mails, substance of which Department cabled you on May 25. You may
                    press for an immediate reply.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Polk</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d815-f1" n="1" type="source" xml:id="d815-f1-content">
                <p>The same to the Ambassador in France as No. 1615, referring to No. 1528, May 25,
                    which is not printed.</p>
            </note>
            <note corresp="#d815-f2" n="2" xml:id="d815-f2-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d815-f3" n="3" xml:id="d815-f3-content">
                <p>
                    <hi rendition="#italic">Ante</hi>, <ref target="#pg604">p. 604</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
