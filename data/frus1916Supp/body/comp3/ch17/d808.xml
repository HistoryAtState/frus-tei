    <text>
        <body>
            <div xml:id="d808">

                <pb facs="0888" n="602" sameAs="frus:frus1916Supp/pg602"/>

                <note rend="inline" type="source">File No. 841.711/349</note>
                <head>
                    <hi rendition="#italic">The British Ambassador</hi> (<hi rendition="#italic"
                        >Spring Rice</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 85</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-04-03">
                            <hi rendition="#italic">April 3, 1916</hi>
                        </date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honour, by direction of Sir
                    Edward Grey, His Majesty’s Principal Secretary of State for Foreign Affairs, to
                    transmit to you herewith a memorandum stating the contentions of His Majesty’s
                    Government and the French Government in regard to their right to detain and
                    examine parcels and letter mails on neutral vessels.<anchor n="1"
                        xml:id="d808-f1"/>
                </p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Cecil Spring Rice</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d808-f1" n="1" xml:id="d808-f1-content">
                <p>Not printed; identical with the memorandum of February 15, 1916, enclosed in the
                    French Ambassador’s note of April 3. See <hi rendition="#italic">ante</hi>, <ref
                        target="#pg599">p. 599</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
