    <text>
        <body>
            <div xml:id="d830">

                <pb facs="0915" n="629" sameAs="frus:frus1916Supp/pg629"/>

                <note rend="inline" type="source">File No. 841.711/1346</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        French Ambassador</hi> (<hi
                            rendition="#italic">Jusserand</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-10-24">
                            <hi rendition="#italic">October 24, 1916</hi>
                        </date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: I have the honor to acknowledge the
                    receipt of your excellency’s note of October 12, 1916, transmitting a memorandum
                    containing the views of the French and British Governments concerning the
                    examination and detention of the mails to and from the United States in reply to
                    this Government’s note of May 24, 1916.<anchor n="2" xml:id="d830-f1"/>
                </p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Robert Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
