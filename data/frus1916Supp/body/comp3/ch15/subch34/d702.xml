    <text>
        <body>
            <div xml:id="d702">

                <pb facs="0832" n="546" sameAs="frus:frus1916Supp/pg546"/>

                <note rend="inline" type="source">File No. 165.102/696a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Great Britain</hi> (<hi
                            rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-12-08T17:00:00-05:00">
                            <hi rendition="#italic">December 8, 1915, 5 p. m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>2533. We are informed that Charles H. Burr seeks to have
                    Republic Trading Corporation substituted for William A.
                        Mitchell in connection with British consent to safe passage
                    German dyestuffs. Please assist Burr to accomplish this and informally draw
                    attention of British authorities to pressing need of American industries for
                    dyestuffs.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
