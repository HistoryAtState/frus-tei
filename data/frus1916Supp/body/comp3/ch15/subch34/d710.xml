    <text>
        <body>
            <div xml:id="d710">

                <pb facs="0835" n="549" sameAs="frus:frus1916Supp/pg549"/>

                <note rend="inline" type="source">File No. 165.102/747</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Great
                        Britain</hi> (<hi rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-01-13">
                            <hi rendition="#italic">January 13, 1916</hi>
                        </date>.</dateline>
                </opener>
                <p>2709. Department’s 2644, December 28. Urge Foreign Office for early reply in view
                    pressing industrial need dyestuff in United States.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
