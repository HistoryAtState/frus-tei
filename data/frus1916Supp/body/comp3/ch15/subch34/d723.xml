    <text>
        <body>
            <div xml:id="d723">

                <pb facs="0840" n="554" sameAs="frus:frus1916Supp/pg554"/>

                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        German Ambassador</hi> (<hi
                            rendition="#italic">Bernstorff</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-04-01">
                            <hi rendition="#italic">April 1916</hi>
                        </date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: I have the honor to acknowledge the
                    receipt of your excellency’s note of April 20, 1916, stating that your
                    Government is willing to release 15,000 tons of dyestuffs for exportation to the
                    United States.</p>
                <p>This information has been carefully noted by the Department and I thank you
                    therefor.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Robert Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
