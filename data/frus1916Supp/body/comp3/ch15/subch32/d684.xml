    <text>
        <body>
            <div xml:id="d684">

                <pb facs="0824" n="538" sameAs="frus:frus1916Supp/pg538"/>

                <head>
                    <hi rendition="#italic">The Secretary of State to the Chargé in Great
                        Britain</hi> (<hi rendition="#italic">Laughlin</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-09-22T16:00:00-05:00">
                            <hi rendition="#italic">September 22, 1916, 4 p. m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>3855. Your 4916, September 20, 7 p. m., Mr. Stabler states informal understanding
                    regarding beet seed was reached with Mr. Aleck Cadogan, Commercial Department,
                    Foreign Office.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
