    <text>
        <body>
            <div xml:id="d735">

                <pb facs="0848" n="562" sameAs="frus:frus1916Supp/pg562"/>

                <note rend="inline" type="source">File No. 300.115/6711a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Great Britain</hi> (<hi
                            rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-01-11">
                            <hi rendition="#italic">January 11, 1916</hi>
                        </date>.</dateline>
                </opener>
                <p>2694. Department’s 2632, December 27. In view of urgent need in United States,
                    urge Foreign Office to give early reply to representation cyanide.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
