                <pb facs="0853" n="567" sameAs="frus:frus1916Supp/pg567"/>

                <note rend="inline" type="source">File No. 300.115/6816</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Page</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <hi
                            rendition="#italic"><date
                                ana="#date_undated-inferred-from-document-content-and-sibling-dates"
                                calendar="gregorian" notAfter="1916-01-27T12:45:00-05:00"
                                notBefore="1916-01-25T18:00:00-05:00">undated</date></hi>.<lb/>[<hi
                            rendition="#italic">Received January 27, 1916, 12.45 p.
                        m.</hi>]</dateline>
                </opener>
                <p>3653. Your 2778, January 25, 6 p. m. Understand that Foreign Office cabled
                    British Embassy that permit had been refused.</p>
                <closer>
                    <hi rendition="#small-caps">American Embassy</hi>
                </closer>
            </div>
