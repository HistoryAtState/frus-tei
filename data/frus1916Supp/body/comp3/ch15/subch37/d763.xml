    <text>
        <body>
            <div xml:id="d763">

                <pb facs="0859" n="573" sameAs="frus:frus1916Supp/pg573"/>

                <note rend="inline" type="source">File No. 300.115/10266a</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Consul General at London</hi> (<hi rendition="#italic">Skinner</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-10-07T17:00:00-05:00">
                            <hi rendition="#italic">October 7, 1916, 5 p. m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Make discreet inquiries about supplies and classes knitting needles available for
                    shipment to United States and give names of dealers. Confer with Embassy
                    regarding Foreign Office note of September 4 to Embassy in this matter.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Polk</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
