    <text>
        <body>
            <div xml:id="d759">

                <pb facs="0858" n="572" sameAs="frus:frus1916Supp/pg572"/>

                <head>
                    <hi rendition="#italic">The Secretary of State to the Chargé in Great
                        Britain</hi> (<hi rendition="#italic">Laughlin</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-08-28T19:00:00-05:00">
                            <hi rendition="#italic">August 28, 1916, 7 p. m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>3750. Department surprised that no reply received to Department’s instruction
                    3676, May 29, with reference to very urgent need knitting needles in United
                    States. Urge early and favorable reply in matter.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
