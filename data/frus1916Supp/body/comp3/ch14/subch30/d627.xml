    <text>
        <body>
            <div xml:id="d627">

                <pb facs="0796" n="510" sameAs="frus:frus1916Supp/pg510"/>

                <note rend="inline" type="source">File No. 763.72112/2421</note>
                <head>
                    <hi rendition="#italic">The Secretary of the Treasury</hi> (<hi rendition="#italic"
                    >McAdoo</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-04-10">
                            <hi rendition="#italic">April 10, 1916</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received April 12</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to a memorandum dated the 28th
                    ultimo of Mr. Charles A. Holder, foreign
                    trade adviser,<anchor n="1" xml:id="d627-f1"/> I have the honor to transmit
                    herewith for the information of your Department, a copy of a letter this day
                    addressed to collectors of customs in whose districts customs-bonded
                    manufacturing warehouses are located, instructing them relative to the issuance
                    of certificates as to the contents of packages of manufactured tobacco exported
                    from such warehouses.<anchor n="1" xml:id="d627-f2"/> By direction of the
                    Secretary.</p>
                <p>Respectfully,</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Wm. P. Malburn</hi>
                        
                    </signed>
                    <lb/>
                    <hi rendition="#italic">Assistant Secretary</hi>
                </closer>
            </div>
        </body>
    </text>
