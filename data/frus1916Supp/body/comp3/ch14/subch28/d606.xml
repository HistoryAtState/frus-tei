    <text>
        <body>
            <div xml:id="d606">

                <pb facs="0783" n="497" sameAs="frus:frus1916Supp/pg497"/>

                <note rend="inline" type="source">File No. 763.72112/3415</note>
                <head>
                    <hi rendition="#italic">The Commercial Adviser of the British Embassy</hi> (<hi
                        rendition="#italic">Crawford</hi>) <hi rendition="#italic">to the Foreign
                        Trade Adviser of the Department of State</hi> (<hi rendition="#italic"
                        >Holder</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-05-23">
                            <hi rendition="#italic">May 23, 1916</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received May 24</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Doctor Holder</hi>: In reply to your letter
                    of the 20th, the matter to which you call our attention had already come before
                    us, and we are in communication with the Foreign Office with regard to it.</p>
                <p>Yours very truly,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">R. Crawford</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
