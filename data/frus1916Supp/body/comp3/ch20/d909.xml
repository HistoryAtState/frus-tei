    <text>
        <body>
            <div xml:id="d909">

                <pb facs="0983" n="697" sameAs="frus:frus1916Supp/pg697"/>

                <note rend="inline" type="source">File No. 763.72/3043</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Page</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1916-12-06T17:00:00+00:00">
                            <hi rendition="#italic">December 6, 1916, 5 p. m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 4 p. m.</hi>]</dateline>
                </opener>
                <p>5278. The Department’s circular telegram December 4, 4 p. m., does not give the
                    subjects of the conference mentioned by the Swedish Minister. May I have this
                    information?</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Page</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
