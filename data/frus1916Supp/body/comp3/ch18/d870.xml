    <text>
        <body>
            <div xml:id="d870">

                <pb facs="0939" n="653" sameAs="frus:frus1916Supp/pg653"/>

                <note rend="inline" type="source">File No. 341.622a/192a</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in Great
                        Britain</hi> (<hi rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-07-24T19:00:00-05:00">
                            <hi rendition="#italic">July 24, 1916, 7 p. m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>3562. Your 4252,<anchor n="1" xml:id="d870-f1"/> May 5, and 4335,<anchor n="2"
                        xml:id="d870-f2"/> May 20. Please cable immediately whether all of the
                    Germans taken from the S. S. <hi rendition="#italic">China</hi> have been
                    released.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Polk</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
