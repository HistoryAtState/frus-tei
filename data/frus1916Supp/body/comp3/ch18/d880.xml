    <text>
        <body>
            <div xml:id="d880">

                <pb facs="0945" n="659" sameAs="frus:frus1916Supp/pg659"/>

                <note rend="inline" type="source">File No. 341.622a/243</note>
                <head>
                    <hi rendition="#italic">The Consul General at Sydney</hi> (<hi rendition="#italic"
                        >Brittain</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Sydney</hi></placeName>, <date
                            calendar="gregorian" when="1916-10-07">
                            <hi rendition="#italic">October 7, 1916</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received October 8, 9 a.
                        m.</hi>]</dateline>
                </opener>
                <p>Men from ship <hi rendition="#italic">China</hi> sailed yesterday ship <hi
                        rendition="#italic">Taiyuan</hi> Shanghai via Hongkong.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Brittain</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
