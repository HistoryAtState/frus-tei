    <text>
        <body>
            <div xml:id="d874">

                <pb facs="0943" n="657" sameAs="frus:frus1916Supp/pg657"/>

                <note rend="inline" type="source">File No. 341.622a/213a</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Page</hi>) <hi rendition="#italic">to the Chargé in
                        Great Britain</hi> (<hi rendition="#italic">Laughlin</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-08-23T16:00:00-05:00">
                            <hi rendition="#italic">August 23, 1916, 4 p. m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>For Gibson.<anchor n="1" xml:id="d874-f1"/> Crewe promised to give me names,
                    ages, status of those taken from <hi rendition="#italic">China</hi>. Please
                    procure them and send to the Department. The Secretary instructs me again to
                    request immediate release of these men. I asked his consent to my asking you to
                    remind Grey and telegraph as early definite answer as possible instead of
                    sending another formal note and protest against longer detention.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Page</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d874-f1" n="1" xml:id="d874-f1-content">
                <p>Secretary of Embassy.</p>
