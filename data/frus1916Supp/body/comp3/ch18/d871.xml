    <text>
        <body>
            <div xml:id="d871">

                <pb facs="0939" n="653" sameAs="frus:frus1916Supp/pg653"/>

                <note rend="inline" type="source">File No. 341.622a/200</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Page</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 4276</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1916-07-19">
                            <hi rendition="#italic">July 19, 1916</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received July 31</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to my telegram No. 4568,
                    July 17, 5 p. m.,<anchor n="3" xml:id="d871-f1"/>I have the honor to enclose
                    herewith a copy of the memorandum received from Sir
                        Edward Grey, under date of July 15.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Walter Hines Page</hi>
                        
                    </signed>
                </closer>


                <xi:include href="d871-a1.xml" xpointer="d871-a1"/>
            </div>
        </body>
    </text>
