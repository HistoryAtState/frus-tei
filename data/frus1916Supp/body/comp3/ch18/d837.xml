    <text>
        <body>
            <div xml:id="d837">

                <pb facs="0918" n="632" sameAs="frus:frus1916Supp/pg632"/>

                <note rend="inline" type="source">File No. 341.622a/30</note>
                <head>
                    <hi rendition="#italic">The Consul General at Hongkong</hi> (<hi rendition="#italic"
                        >Anderson</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Hongkong</hi></placeName>, <date
                            calendar="gregorian" when="1916-02-23">
                            <hi rendition="#italic">Feburary 23, 1916</hi>
                        </date>.<lb/>[<hi rendition="#italic">Received 8.15 a. m.</hi>]</dateline>
                </opener>
                <p>Thirty-eight Germans taken from American steamer <hi rendition="#italic"
                        >China</hi> on high seas near Shanghai by British auxiliary cruiser <hi
                        rendition="#italic">Laurentic</hi> arrived; detained here military detention
                    barracks.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Anderson</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
