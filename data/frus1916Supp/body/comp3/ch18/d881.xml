    <text>
        <body>
            <div xml:id="d881">

                <pb facs="0945" n="659" sameAs="frus:frus1916Supp/pg659"/>

                <note rend="inline" type="source">File No. 351.622a/67</note>
                <head>
                    <hi rendition="#italic">The Chargé in France</hi> (<hi rendition="#italic"
                        >Bliss</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1916-10-13T17:00:00+00:00">
                            <hi rendition="#italic">October 13, 1916, 5 p. m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 10 p. m.</hi>]</dateline>
                </opener>
                <p>1646. My 1636, October 9, 6 p. m.<anchor n="1" xml:id="d881-f1"/> Consul General,
                    Marseille, reports that Miller was released on 10th instant and that he has
                    arranged for Miller’s return passage to the United States on S. S. <hi
                        rendition="#italic">Satsuma</hi> to sail this week.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bliss</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
