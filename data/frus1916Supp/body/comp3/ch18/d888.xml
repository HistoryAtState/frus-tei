    <text>
        <body>
            <div xml:id="d888">

                <pb facs="0964" n="678" sameAs="frus:frus1916Supp/pg678"/>

                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Great
                        Britain</hi> (<hi rendition="#italic">Page</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-12-26">
                            <hi rendition="#italic">December 26, 1916</hi>
                        </date>.</dateline>
                </opener>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <p>4213. My mail instruction No. 4520, December 1.<anchor n="1" xml:id="d888-f1"/>
                    What have you to report?</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
