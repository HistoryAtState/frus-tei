    <text>
        <body>
            <div xml:id="d834">

                <pb facs="0917" n="825" sameAs="frus:frus1918Supp01v01/pg825"/>

                <note rend="inline" type="source">File No. 861.00/2709</note>
                <head>
                    <hi rendition="#italic">The Chargé in Japan</hi> (<hi rendition="#italic"
                        >Spencer</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Tokyo</hi></placeName>, <date
                            calendar="gregorian" when="1918-09-17T11:00:00+09:00">
                            <hi rendition="#italic">September 17, 1918, 11 a.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received September 18, 6.03
                        a.m.</hi>]</dateline>
                </opener>
                <p>Foreign Office confirms their public announcement made yesterday to the effect
                    that Japan recognizes Czecho-Slovak as Allied army under Czecho-Slovak National
                        Council.<anchor n="2" xml:id="d834-f1"/> Reuter given full text.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Spencer</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d834-f1" n="2" xml:id="d834-f1-content">
                <p>The date of the recognition was Sept. 9.</p>
            </note>
        </listAnnotation>
    </standOff>
