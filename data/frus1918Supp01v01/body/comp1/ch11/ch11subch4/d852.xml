            <div xml:id="d852">

                <pb facs="0948" n="856" sameAs="frus:frus1918Supp01v01/pg856"/>

                <note rend="inline" type="source">File No. 861.00/3041</note>
                <head>
                    <hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic"
                        >Sharp</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1918-10-25T00:00:00+00:00">
                            <hi rendition="#italic">October 25, 1918, 12 a.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received October 26, 1.57
                        a.m.</hi>]</dateline>
                </opener>
                <p>5569. French Government recognized Czecho-Slovak Provisional Government 15th
                    instant, Italian Government 21st instant.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Sharp</hi>
                    </signed>
                </closer>
            </div>
        </body>
