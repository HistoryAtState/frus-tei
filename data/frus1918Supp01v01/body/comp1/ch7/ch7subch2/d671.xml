    <text>
        <body>
            <div xml:id="d671">

                <pb facs="0800" n="708" sameAs="frus:frus1918Supp01v01/pg708"/>

                <note rend="inline" type="source">File No. 611.326/76</note>
                <head>
                    <hi rendition="#italic">The Brazilian Ambassador</hi> (<hi rendition="#italic">Da
                        Gama</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-07-08">
                            <hi rendition="#italic">July 8, 1918</hi></date>. <lb/> [<hi
                            rendition="#italic">Received July 9.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I have received a
                    telegram from my Government accepting the proposal Your Excellency made through
                    Ambassador Morgan<anchor n="1"
                        xml:id="d671-f1"/> to meet in conference with the Italian, British and
                    French High Commissioners and myself, with the purpose of studying the economic,
                    commercial and financial difficulties brought upon Brazil by the restrictions in
                    the international trade and transportation and devising means of removing or at
                    least attenuating them.</p>
                <p>I shall have the honor to attend to Your Excellencys’ appointment of any day and
                    hour for that meeting and I avail myself [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">D. da Gama</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d671-f1" n="1" xml:id="d671-f1-content">
                <p>See telegram of June 27, <hi rendition="#italic">ante</hi>, <ref target="#pg705"
                        >p. 705</ref>.</p>
            </note>
