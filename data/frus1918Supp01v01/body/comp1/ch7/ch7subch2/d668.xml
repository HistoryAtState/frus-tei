    <text>
        <body>
            <div xml:id="d668">

                <pb facs="0797" n="705" sameAs="frus:frus1918Supp01v01/pg705"/>

                <note rend="inline" type="source">File No. 611.326/64</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Italy</hi> (<hi rendition="#italic">Page</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Rome</hi></placeName>, <date
                            calendar="gregorian" when="1918-06-24T13:00:00+02:00">
                            <hi rendition="#italic">June 24, 1918, 1 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received June 25, 9.52 a.m.</hi>]</dateline>
                </opener>
                <p>1763. Your 1475, June 21, 3 p.m.<anchor n="2" xml:id="d668-f1"/> In conversation
                    this morning with Minister of Foreign Affairs he states that I am authorized to
                    say that he will act in entire harmony with the other Allies.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Nelson Page</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
