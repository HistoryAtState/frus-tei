    <text>
        <body>
            <div xml:id="d638">

                <pb facs="0777" n="685" sameAs="frus:frus1918Supp01v01/pg685"/>

                <note rend="inline" type="source">File No. 033.4120</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Page</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1918-04-24T16:00:00+01:00">
                            <hi rendition="#italic">April 24, 1918, 4 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 9.08 p.m.</hi>]</dateline>
                </opener>
                <p>9684. Sir Maurice de Bunsen, formerly
                    British Ambassador at Vienna, who has been acting during the war as extra
                    assistant under secretary at the Foreign Office, left last week for South
                    America on a mission the nature of which I understand has been communicated to
                    you by Lord Reading.<anchor n="1"
                        xml:id="d638-f1"/>
                </p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Page</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d638-f1" n="1" xml:id="d638-f1-content">
                <p>See telegrams to the Ambassador in Great Britain, No. 7761, May 16, and from the
                    Ambassador in Great Britain, No. 10106, May 17, <hi rendition="#italic"
                        >post</hi>, <ref target="#pg689">pp. 689</ref> and <ref target="#pg690"
                        >690</ref>, respectively.</p>
            </note>
