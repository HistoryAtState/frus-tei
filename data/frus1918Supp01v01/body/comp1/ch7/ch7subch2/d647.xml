    <text>
        <body>
            <div xml:id="d647">

                <pb facs="0782" n="690" sameAs="frus:frus1918Supp01v01/pg690"/>

                <note rend="inline" type="source">File No. 763.72/10059</note>
                <head>
                    <hi rendition="#italic">The Minister in Haiti</hi> (<hi rendition="#italic"
                        >Bailly-Blanchard</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Port au Prince</hi></placeName>, <date
                            calendar="gregorian" when="1918-05-18T18:00:00-05:00">
                            <hi rendition="#italic">May 18, 1918, 6 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received May 19, 3.30 p.m.</hi>]</dateline>
                </opener>
                <p>Your confidential May 10, 2 p.m. Instructions complied with. President in perfect
                    accord, and states that declaration will be made after adoption of
                    constitution.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Blanchard</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
