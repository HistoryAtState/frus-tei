                <pb facs="0781" n="689" sameAs="frus:frus1918Supp01v01/pg689"/>

                <note rend="inline" type="source">File No. 033.4120</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Great Britain</hi> (<hi
                            rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-05-16T16:00:00-04:00">
                            <hi rendition="#italic">May 16, 1918, 4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>7761. Your 9684, April 24, 4 p.m.<anchor n="1" xml:id="d644-f1"/> British
                    Ambassador has given Department no information regarding mission. Cable
                    Department nature of mission.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
