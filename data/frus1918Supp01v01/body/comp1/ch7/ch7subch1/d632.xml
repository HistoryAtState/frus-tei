    <text>
        <body>
            <div xml:id="d632">

                <pb facs="0774" n="682" xml:id="pg682"/>

                <note rend="inline" type="source">File No. 862.85/378</note>
                <head>
                    <hi rendition="#italic">The Minister in Cuba</hi> (<hi rendition="#italic">Gonzales</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Habana</hi></placeName>, <date
                            calendar="gregorian" when="1918-04-10T11:00:00-05:29">
                            <hi rendition="#italic">April 10, 1918, 11 a.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 1.46 p.m.</hi>]</dateline>
                </opener>
                <p>Your March 27, 4 p.m. Presidential decree issued carrying authority Shipping
                    Board desires for placing vessels under Cuban flag. Copy will be forwarded Cuban
                    Minister at Washington with authority to act in cooperation with representative
                    of Shipping Board.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Gonzales</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
