    <text>
        <body>
            <div xml:id="d711">

                <pb facs="0830" n="738" sameAs="frus:frus1918Supp01v01/pg738"/>

                <note rend="inline" type="source">File No. 862.85/617</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Chile</hi> (<hi rendition="#italic">Shea</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Santiago</hi></placeName>, <date
                            calendar="gregorian" when="1918-11-04T18:00:00-04:00">
                            <hi rendition="#italic">November 4, 1918, 6 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 9.5 p.m.</hi>]</dateline>
                </opener>
                <p>Reported from authentic sources all German vessels in Chilean ports occupied
                    early this morning by Chilean marines.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Shea</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
