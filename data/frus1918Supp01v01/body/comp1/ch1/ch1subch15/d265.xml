            <div xml:id="d265">

                <pb facs="0417" n="325" sameAs="frus:frus1918Supp01v01/pg325"/>

                <note rend="inline" type="source">File No. 763.72119/1957</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Minister in Switzerland</hi> (<hi
                            rendition="#italic">Stovall</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-09-28T11:00:00-04:00">
                            <hi rendition="#italic">September 28, 1918, 11 a.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>3013. For Murphy, Sofia:</p>
                <p>Department desires you to return immediately to Sofia and to take no part
                    whatsoever in present situation without instructions.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
