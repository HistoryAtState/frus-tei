            <div xml:id="d277">

                <pb facs="0429" n="337" xml:id="pg337"/>

                <note rend="inline" type="source">File No. 763.72/11630</note>
                <head>
                    <hi rendition="#italic">The Chargé in the Netherlands</hi> (<hi rendition="#italic">Bliss</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">The Hague</hi></placeName>, <date
                            calendar="gregorian" when="1918-10-04">
                            <hi rendition="#italic">October 4, 1918</hi></date>. <lb/> [<hi
                            rendition="#italic">Received 9.10 p.m.</hi>]</dateline>
                </opener>
                <p>4650. Dutch press, 4th. <hi rendition="#italic">Nieuwe Rotterdamsche</hi>
                    Wolff telegram: <quote rend="blockquote">
                        <p>
                            Prince Max [of Baden] has been
                            appointed Chancellor. At ordinary sitting Reichstag on 5th he will
                            disclose Government program. Groeber and Scheidemann appointed secretaries without portfolios.
                                Wallraf, Interior Secretary,
                            has tendered resignation and will be replaced by Centrist. Fischbeck
                            will be Prussian Minister for Commerce.</p>
                    </quote>
                </p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Bliss</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
