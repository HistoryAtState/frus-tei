        <body>
            <div xml:id="d326">

                <pb facs="0471" n="379" sameAs="frus:frus1918Supp01v01/pg379"/>

                <note rend="inline" type="source">File No. 763.72119/2377a</note>
                <head>
                    <hi rendition="#italic">The Swiss Chargé</hi> (<hi rendition="#italic"
                        >Oederlin</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-10-22">
                            <hi rendition="#italic">October 22, 1918</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: By direction of my Government, I have the
                    honor to transmit herewith to Your Excellency the original German text of a
                    communication dated October 20, 1918, from the German Government, which has
                    today been received from the Swiss Foreign Office. I beg to also enclose an
                    English translation of the communication in <pb facs="0472" n="380"
                        xml:id="pg380"/> question as transmitted to the Swiss Foreign Office by the
                    German Government with the request that it be forwarded to Your Excellency’s
                    Government.</p>
                <p>Please accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">F. Oederlin</hi>
                    </signed>
                </closer>


                <xi:include href="d326-a1.xml" xpointer="d326-a1"/>
            </div>
        </body>
    </text>
