    <text>
        <body>
            <div xml:id="d321">

                <pb facs="0468" n="376" sameAs="frus:frus1918Supp01v01/pg376"/>

                <note rend="inline" type="source">File No. 763.72/11569</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Chargé in the
                        Netherlands</hi> (<hi rendition="#italic">Bliss</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-10-21T17:00:00-04:00">
                            <hi rendition="#italic">October 21, 1918, 5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>2269. Your 4595<anchor n="1" xml:id="d321-f1"/> regarding pamphlet entitled <hi
                        rendition="#italic">The League of Nations the Way to Peace</hi>, by
                    Erzberger. Department desires to be furnished with copies of this pamphlet as
                    soon as it appears.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
