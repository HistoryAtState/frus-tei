    <text>
        <body>
            <div xml:id="d415">

                <pb facs="0583" n="491" sameAs="frus:frus1918Supp01v01/pg491"/>

                <note rend="inline" type="source">File No. 862.001W64/39</note>
                <head>
                    <hi rendition="#italic">The Chargé in the Netherlands</hi> (<hi
                        rendition="#italic">Bliss</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">The Hague</hi></placeName>, <date
                            calendar="gregorian" when="1918-11-10">
                            <hi rendition="#italic">November 10, 1918</hi></date>. <lb/> [<hi
                            rendition="#italic">Received 11.41 a.m.</hi>]</dateline>
                </opener>
                <p>The Emperor of Germany is reported to have crossed into Holland this morning near
                    Maestricht. He was accompanied by a numerous suite and is now staying at
                        Medachten,<anchor n="1" xml:id="d415-f1"/> the country place of Count
                    Bentinek.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bliss</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d415-f1" n="1" xml:id="d415-f1-content">
                <p>Corrected to “Amerongen” by a telegram next day.</p>
            </note>
        </listAnnotation>
