    <text>
        <body>
            <div xml:id="d412">

                <pb facs="0580" n="488" sameAs="frus:frus1918Supp01v01/pg488"/>

                <note rend="inline" type="source">File No. 763.72119/2491</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in Norway</hi>
                        (<hi rendition="#italic">Schmedeman</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-11-09T17:00:00-05:00">
                            <hi rendition="#italic">November 9, 1918, 5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your November 5, 2 p.m.<anchor n="1" xml:id="d412-f1"/> Department prefers to
                    make no answer to message of Bolshevik Minister for Foreign Affairs and is not
                    prepared to negotiate with Bolshevik authorities.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
