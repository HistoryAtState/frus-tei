    <text>
        <body>
            <div xml:id="d285">

                <pb facs="0436" n="344" xml:id="pg344"/>

                <note rend="inline" type="source">File No. 763.72119/2043</note>
                <head>
                    <hi rendition="#italic">The Minister in Belgium</hi> (<hi rendition="#italic">Whitlock</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Havre</hi></placeName>, <date
                            calendar="gregorian" when="1918-10-07T19:00:00+00:00">
                            <hi rendition="#italic">October 7, 1918, 7 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received October 8, 9.40
                        a.m.</hi>]</dateline>
                </opener>
                <p>143. Hymans, Minister for Foreign Affairs,
                    asks me today to convey to you the desire of the Belgian Government in event of
                    an armistice being considered to be heard as to the guarantees that it would
                    deem indispensable to the safety of Belgium.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Whitlock</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
