    <text>
        <body>
            <div xml:id="d150">

                <pb facs="0308" n="216" sameAs="frus:frus1918Supp01v01/pg216"/>

                <note rend="inline" type="source">File No. 763.72/9617</note>
                <head>
                    <hi rendition="#italic">The British Ambassador on Special Mission</hi>
                        (<hi rendition="#italic"
                            >Reading</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 415</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-04-18">
                            <hi rendition="#italic">April 18, 1918</hi></date>. <lb/> [<hi
                            rendition="#italic">Received April 19.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honour to inform you, under
                    instructions from His Majesty’s Government, that the French Government have
                    agreed to General Foch’s receiving the
                    designation of commander-in-chief of the Allied armies in France.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Reading</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
