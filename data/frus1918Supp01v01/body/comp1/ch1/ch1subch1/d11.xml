    <text>
        <body>
            <div xml:id="d11">

                <pb facs="0115" n="23" sameAs="frus:frus1918Supp01v01/pg23"/>

                <note rend="inline" type="source">File No. 763.72119/1146a</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Minister in the
                        Netherlands</hi> (<hi rendition="#italic">Garrett</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-01-11T17:00:00-05:00">
                            <hi rendition="#italic">January 11, 1918, 5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>907. Please endeavor to obtain from the same source which supplied comments at
                    end of your cablegram 1656 of November 19, <pb facs="0116" n="24" xml:id="pg24"
                    /> 1917,<anchor n="1" xml:id="d11-f1"/> and illuminating statement enclosed with
                    mail despatch 334 of November 27,<anchor n="2" xml:id="d11-f2"/> an account of
                    the reaction of the German Liberals to the President’s statement of peace terms.
                    Reply by cable.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Polk</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d11-f1" n="1" xml:id="d11-f1-content">
                <p> Kurt Hahn, German Liberal leader; see <ref target="frus1917Supp02v01#pg_311">
                        <hi rendition="#italic">Foreign Relations</hi>, 1917, Supplement 2, vol. I,
                        pp. 311</ref>–<ref target="frus1917Supp02v01#pg_316">316</ref>.</p>
            </note>
