    <text>
        <body>
            <div xml:id="d18">

                <pb facs="0124" n="32" sameAs="frus:frus1918Supp01v01/pg32"/>

                <note rend="inline" type="source">File No. 763.72119/1155</note>
                <head>
                    <hi rendition="#italic">The Consul General at London</hi> (<hi rendition="#italic"
                        >Skinner</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 5384</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1918-01-10">
                            <hi rendition="#italic">January 10, 1918</hi></date>. <lb/> [<hi
                            rendition="#italic">Received January 21.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose a statement on
                    behalf of the Parliamentary Committee of the Trade Union Congress, the Executive
                    of the Labor Party, and the Co-operative Representative Committee, setting forth
                    in terms of cordial approval their views on the President’s speech on war aims.
                    This unreserved approval of the British Labor organizations should be noted as a
                    matter of great political importance.</p>
                <p>The statement was made public on January 10, 1918.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Robert P. Skinner</hi>
                        
                    </signed>
                </closer>


                <xi:include href="d18-a1.xml" xpointer="d18-a1"/>
            </div>
