    <text>
        <body>
            <div xml:id="d103">

                <pb facs="0246" n="154" sameAs="frus:frus1918Supp01v01/pg154"/>

                <note rend="inline" type="source">File No. 763.72119/1489</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Page</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 8442</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1918-03-01">
                            <hi rendition="#italic">March 1, 1918</hi></date>. <lb/> [<hi
                            rendition="#italic">Received March 18.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to my telegram No. 8860 of
                    March 1, 1918, 6 p.m.,<anchor n="1" xml:id="d103-f1"/> in regard to the war aims
                    of the Inter-Allied [Labor] and Socialist Conference, I have the honor to
                    transmit herewith enclosed, <pb facs="0247" n="155" xml:id="pg155"/> for the
                    information of the Department, the memoranda in full adopted by the conference,
                    together with newspaper comments<anchor n="1" xml:id="d103-f2"/> on the same
                    subject.</p>
                <p>I have [etc.]</p>
                <closer>For the Ambassador: <lb/>
                    <signed>
                        <hi rendition="#small-caps">F. M. Gunther</hi>
                    </signed>
                </closer>


                <xi:include href="d103-a1.xml" xpointer="d103-a1"/>
            </div>
        </body>
    </text>
