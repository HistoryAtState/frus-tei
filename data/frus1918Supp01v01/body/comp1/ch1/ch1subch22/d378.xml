                <pb facs="0551" n="459" sameAs="frus:frus1918Supp01v01/pg459"/>

                <note rend="inline" type="source">File No. 763.72/12098a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Chargé in the Netherlands</hi> (<hi
                            rendition="#italic">Bliss</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-11-04T12:00:00-05:00">
                            <hi rendition="#italic">November 4, 1918, noon</hi></date>.</dateline>
                </opener>
                <p>2334. Cable at once full text of constitutional amendments passed by Reichstag
                    and Bundesrat.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
