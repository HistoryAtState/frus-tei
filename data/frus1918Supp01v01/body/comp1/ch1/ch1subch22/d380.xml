    <text>
        <body>
            <div xml:id="d380">

                <pb facs="0552" n="460" xml:id="pg460"/>

                <note rend="inline" type="source">File No. 763.72119/9054</note>
                <head>
                    <hi rendition="#italic">The Special Representative</hi> (<hi rendition="#italic">House</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1918-11-04T19:00:00+00:00">
                            <hi rendition="#italic">November 4, 1918, 7 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received November 4, 3.52
                        p.m.</hi>]</dateline>
                </opener>
                <p>45. You may announce to newspapers that the terms of the armistice to be offered
                    Germany have been agreed to and signed by the Inter-Allied Conference
                    unanimously. Diplomatic unity completely achieved under conditions of utmost
                    harmony. Do not permit this report to be cabled back to Europe or out of the
                    United States.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Edward House</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
