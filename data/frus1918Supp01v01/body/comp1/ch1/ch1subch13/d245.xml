                <pb facs="0396" n="304" sameAs="frus:frus1918Supp01v01/pg304"/>

                <note rend="inline" type="source">File No. 763.72/11349</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Minister in Belgium</hi> (<hi
                            rendition="#italic">Whitlock</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-09-11T16:00:00-04:00">
                            <hi rendition="#italic">September 11, 1918, 4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>310. Your 140, September 9, 7 p.m. This Government does not consider that Count
                        de Torring’s letter merits favorable consideration</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
