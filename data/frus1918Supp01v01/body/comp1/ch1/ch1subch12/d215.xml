            <div xml:id="d215">

                <pb facs="0374" n="282" sameAs="frus:frus1918Supp01v01/pg282"/>

                <note rend="inline" type="source">File No. 763.72119/1824a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in
                        Switzerland</hi> (<hi rendition="#italic">Stovall</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-07-10T22:00:00-04:00">
                            <hi rendition="#italic">July 10, 1918, 10 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>2273. Wilson from Harrison:</p>
                <p>Please advise Edelman<anchor n="1" xml:id="d215-f1"/> that we have received
                    information from agent in Egypt that it is rumored in connection with German and
                    Turkish propaganda in favor of the Arabs that an Arab committee composed of
                    prominent Syrians and others is on its way to Switzerland where propaganda will
                    be carried on in favor of the Arab provinces of the Ottoman Empire remaining
                    after the war under Turkish control as autonomous provinces of the Ottoman
                    Empire. Should commission reach Switzerland please cover activities and
                    discreetly endeavor to win them over to the program of America and the
                    Allies.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d215-f1" n="1" xml:id="d215-f1-content">
                <p> Samuel Edelman, Vice Consul at Geneva.</p>
            </note>
