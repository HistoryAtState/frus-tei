    <text>
        <body>
            <div xml:id="d393">

                <pb facs="0566" n="474" sameAs="frus:frus1918Supp01v01/pg474"/>

                <note rend="inline" type="source">File No. 763.72119/2499</note>
                <head>
                    <hi rendition="#italic">The Chargé in the Netherlands</hi> (<hi
                        rendition="#italic">Bliss</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">The Hague</hi></placeName>, <date
                            calendar="gregorian" when="1918-11-06">
                            <hi rendition="#italic">November 6, 1918</hi></date>. <lb/> [<hi
                            rendition="#italic">Received 6.40 p.m.</hi>]</dateline>
                </opener>
                <p>4962. Wolff despatch, Berlin, states German delegation to conclude armistice and
                    open peace negotiations left this afternoon for the west.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bliss</hi>
                    </signed>
                </closer>
            </div>
        </body>
