    <text>
        <body>
            <div xml:id="d398">

                <pb facs="0572" n="480" sameAs="frus:frus1918Supp01v01/pg480"/>

                <note rend="inline" type="source">File No. 763.72119/9092a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Special Representative</hi> (<hi
                            rendition="#italic">House</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-11-07T11:00:00-05:00">
                            <hi rendition="#italic">November 7, 1918, 11 a.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>15. Warburton<anchor n="1" xml:id="d398-f1"/> informs War
                    Department armistice signed. Please confirm and notify us of when we may publish
                    armistice.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d398-f1" n="1" xml:id="d398-f1-content">
                <p>Maj. Barclay H. Warburton, military attaché at Paris.</p>
            </note>
        </listAnnotation>
    </standOff>
