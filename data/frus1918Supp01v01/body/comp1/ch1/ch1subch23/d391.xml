    <text>
        <body>
            <div xml:id="d391">

                <pb facs="0564" n="472" sameAs="frus:frus1918Supp01v01/pg472"/>

                <note rend="inline" type="source">File No. 763.72119/2470</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Chargé in the Netherlands</hi> (<hi
                            rendition="#italic">Bliss</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-11-06T16:00:00-05:00">
                            <hi rendition="#italic">November 6, 1918, 4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>2356. Your 4765, October 12.<anchor n="1" xml:id="d391-f1"/> The President wishes
                    you to make in his behalf a very courteous acknowledgment of message from
                    Luxemburg, with statement to effect that you have been asked by him to say that
                    he will have every disposition to regard the interests of Luxemburg in the most
                    friendly way.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
