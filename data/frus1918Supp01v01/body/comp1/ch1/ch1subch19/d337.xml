    <text>
        <body>
            <div xml:id="d337">

                <pb facs="0490" n="398" xml:id="pg398"/>

                <note rend="inline" type="source">File No. 763.72119/2395</note>
                <head>
                    <hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic"
                        >Sharp</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 6686</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1918-10-14">
                            <hi rendition="#italic">October 14, 1918</hi></date>. <lb/> [<hi
                            rendition="#italic">Received October 29.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Confirming my telegram No. 5414 of October
                        13,<anchor n="1" xml:id="d337-f1"/> I have the honor to enclose copies in
                    translation of (1) text of the resolution adopted by the Congress of the French
                    Socialist Party giving its approbation to the reply of the Secretary of State in
                    the name of the President to the German proposal of acceptance of the
                    President’s fourteen bases of peace; (2) text of an appeal concurrently issued
                    by the General Labor Confederation to the working men of France; and (3) text of
                    a further resolution of the Socialist Party outlining its working programme for
                    the immediate future.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. G. Sharp</hi>
                    </signed>
                </closer>




                <xi:include href="d337-a1.xml" xpointer="d337-a1"/>
