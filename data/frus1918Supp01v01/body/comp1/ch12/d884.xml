    <text>
        <body>
            <div xml:id="d884">

                <pb facs="0977" n="885" sameAs="frus:frus1918Supp01v01/pg885"/>

                <note rend="inline" type="source">File No. 860c.01/161</note>
                <head>
                    <hi rendition="#italic">The Minister in Switzerland</hi> (<hi
                        rendition="#italic">Stovall</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berne</hi></placeName>, <date
                            calendar="gregorian" when="1918-11-10T13:00:00+01:00">
                            <hi rendition="#italic">November 10, 1918, 1 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received November 11, 4.28
                        a.m.</hi>]</dateline>
                </opener>
                <p>5693. Vienna Press Bureau 9th reports from Lublin that Socialist government has
                    been formed proclaiming Polish Republic. Participation in the movement of Polish
                    Populist Party is so far not assured.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stovall</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
