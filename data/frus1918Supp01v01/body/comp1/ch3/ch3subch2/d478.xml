    <text>
        <body>
            <div xml:id="d478">

                <pb facs="0648" n="556" xml:id="pg556"/>

                <note rend="inline" type="source">Food Administrator’s File</note>
                <head>
                    <hi rendition="#italic">The British Ambassador on Special Mission</hi> (<hi
                        rendition="#italic">Reading</hi>) <hi rendition="#italic">to the Food
                        Administrator</hi> (<hi rendition="#italic">Hoover</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-06-12">
                            <hi rendition="#italic">June 12, 1918</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Hoover</hi>: I have just received a
                    telegram from Mr. Balfour asking me to convey to you an invitation from His
                    Majesty’s Government to be their guest during your forthcoming visit to
                    England.</p>
                <p>I hope that you will feel that this invitation is from the British people as much
                    as from the British Government, and I trust that you may be able to authorize me
                    to inform Mr. Balfour that you will be able to accept it.</p>
                <p>Believe me [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Reading</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
