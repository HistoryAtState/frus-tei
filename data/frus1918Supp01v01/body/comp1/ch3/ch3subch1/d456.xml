    <text>
        <body>
            <div xml:id="d456">

                <pb facs="0628" n="536" sameAs="frus:frus1918Supp01v01/pg536"/>

                <note rend="inline" type="source">Food Administrator’s File</note>
                <head>
                    <hi rendition="#italic">The Food Administrator</hi> (<hi rendition="#italic">Hoover</hi>) <hi
                        rendition="#italic">to the Food Administration Representative at London</hi>
                        (<hi rendition="#italic"
                        >Sheldon</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-01-23">
                            <hi rendition="#italic">January 23, 1918</hi></date>.</dateline>
                </opener>
                <p>Inform Rhondda, your cable, we will
                    export every grain of wheat that the American people save from their normal
                    consumption. We shall appeal to them for greater endeavor and have already
                    introduced <pb facs="0629" n="537" xml:id="pg537"/> stronger measures and we
                    believe our people will not fail to meet the emergency.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Hoover</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
