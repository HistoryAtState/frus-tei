    <text>
        <body>
            <div xml:id="d602">

                <pb facs="0752" n="660" sameAs="frus:frus1918Supp01v01/pg660"/>

                <note rend="inline" type="source">File No. 763.72119/2457a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Japan</hi> (<hi
                            rendition="#italic">Morris</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-10-31T16:00:00-05:00">
                            <hi rendition="#italic">October 31, 1918—4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Cable brief summary of essential points of Okuma’s<anchor n="2" xml:id="d602-f1"
                    /> views on peace terms as published in recent number of <hi rendition="#italic"
                        >Kokumin</hi>. Promptly <pb facs="0753" n="661" xml:id="pg661"/> mail full
                    translation, also three copies translation of Ozaki’s book
                    on democracy.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d602-f1" n="2" xml:id="d602-f1-content">
                <p>Marquis Shigenobu Okuma, Japanese Prime Minister 1914–16.</p>
            </note>
        </listAnnotation>
    </standOff>
