    <text>
        <body>
            <div xml:id="d566">

                <pb facs="0729" n="637" sameAs="frus:frus1918Supp01v01/pg637"/>

                <note rend="inline" type="source">File No. 763.72115/3271</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Minister in China</hi> (<hi
                            rendition="#italic">Reinsch</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-03-11T18:00:00-05:00">
                            <hi rendition="#italic">March 11, 1918, 6 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your February 20, 4 p.m. Department today informing British Ambassador,
                    Washington, that Government of the United States is willing to incur its share
                    of expenses of deportation and internment of enemy alien subjects from
                        China.<anchor n="1" xml:id="d566-f1"/>
                </p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Polk</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d566-f1" n="1" xml:id="d566-f1-content">
                <p>The memorandum conveying this information, prepared as an answer to the British
                    Embassy’s memorandum of Feb. 23, <hi rendition="#italic">ante</hi>, <ref
                        target="#pg634">p. 634</ref>, bears annotations showing that it was not sent
                    (File No. 763.72115/3277).</p>
            </note>
        </listAnnotation>
    </standOff>
