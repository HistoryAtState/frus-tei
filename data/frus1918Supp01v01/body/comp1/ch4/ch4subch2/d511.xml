            <div xml:id="d511">

                <pb facs="0685" n="593" sameAs="frus:frus1918Supp01v01/pg593"/>

                <note rend="inline" type="source">File No. 800.24/73b</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Chargé in Great Britain</hi> (<hi
                            rendition="#italic">Laughlin</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-06-24T18:00:00-04:00">
                            <hi rendition="#italic">June 24, 1918, 6 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>8410. For Sheldon [from War Trade
                    Board]:</p>
                <p>No. 709. Your 762, Embassy 10583, June 12, 7 p.m. The several cables on this
                    subject are receiving very careful consideration and it is hoped that a definite
                    decision may be arrived at along the lines suggested, in the near future.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
