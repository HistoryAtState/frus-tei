    <text>
        <body>
            <div xml:id="d527">

                <pb facs="0700" n="608" xml:id="pg608"/>

                <note rend="inline" type="source">File No. 103.94/457</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Great
                        Britain</hi> (<hi rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-09-28T20:00:00-04:00">
                            <hi rendition="#italic">September 28, 1918, 8 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>1693. Summers from Baruch:</p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>Your 2134, September 23, 6 p.m.,<anchor n="1" xml:id="d527-f1"/> and your 1858
                        [<hi rendition="#italic">1853</hi>], September 13, 2 p.m. Distinctly
                    understood program committees would deal only with exportable surplus. Have no
                    statistics regarding domestic stocks and will not submit any. Therefore do not
                    delay program for this information. Legge.<anchor n="2" xml:id="d527-f2"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d527-f1" n="1" xml:id="d527-f1-content">
