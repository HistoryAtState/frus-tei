    <text>
        <body>
            <div xml:id="d521">

                <pb facs="0696" n="604" sameAs="frus:frus1918Supp01v01/pg604"/>

                <note rend="inline" type="source">File No. 103.94/361</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Page</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1918-09-03T00:00:00+01:00">
                            <hi rendition="#italic">September 3, 1918, 12 a.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 1.27 p.m.</hi>]</dateline>
                </opener>
                <p>1571. For Baruch from Summers:</p>
                <p>Representatives of the French and the Italian Governments have signed
                    inter-Allied tin agreement. Armsby.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Page</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
