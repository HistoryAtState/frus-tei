    <text>
        <body>
            <div xml:id="d783">

                <pb facs="0877" n="785" sameAs="frus:frus1918Supp01v01/pg785"/>

                <note rend="inline" type="source">File No. 701.7311/1a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in France</hi>
                        (<hi rendition="#italic">Sharp</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-09-05T15:00:00-05:00">
                            <hi rendition="#italic">September 5, 1917, 3 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>2606. Italian Embassy informs Department Montenegrin Government desirous of
                    establishing legation in Washington, and that inquiry was made through you. Have
                    you received such inquiry from Montenegrin Government?</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
