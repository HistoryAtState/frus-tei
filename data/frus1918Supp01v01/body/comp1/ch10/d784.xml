                <pb facs="0877" n="785" sameAs="frus:frus1918Supp01v01/pg785"/>

                <note rend="inline" type="source">File No. 701.7311/2</note>
                <head>
                    <hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic">Sharp</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1917-09-06T19:00:00+01:00">
                            <hi rendition="#italic">September 6, 1917, 7 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 11.20 p.m.</hi>]</dateline>
                </opener>
                <p>2462. Your 2606, September 5, 3 p.m. Montenegrin Minister for Foreign Affairs
                    requested me to ask whether it would be agreeable to the American Government
                    that the King of Montenegro create a legation in Washington. Copy of his letter
                    forwarded in my despatch 5622 of August 22.<anchor n="1" xml:id="d784-f1"/>
                </p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Sharp</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
