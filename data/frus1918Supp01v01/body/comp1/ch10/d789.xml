                <note rend="inline" type="source">File No. 701.7311/18</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        France</hi> (<hi rendition="#italic">Sharp</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-07-12T18:00:00-04:00">
                            <hi rendition="#italic">July 12, 1918, 6 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>4997. Your 4386, July 7, noon.<anchor n="1" xml:id="d789-f1"/> Doctor
                    Gvosdenovitch acceptable as minister from Montenegro.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Polk</hi>
                    </signed>
                </closer>
            </div>
