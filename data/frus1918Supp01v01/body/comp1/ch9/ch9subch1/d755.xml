    <text>
        <body>
            <div xml:id="d755">

                <pb facs="0856" n="764" xml:id="pg764"/>

                <note rend="inline" type="source">File No. 763.72119/1410</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Minister in
                        Rumania</hi> (<hi rendition="#italic">Vopicka</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-03-08T14:00:00-05:00">
                            <hi rendition="#italic">March 8, 1918, 2 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>176. Your 31 [<hi rendition="#italic">46</hi>], 1st. Department does not wish you
                    to join in representations regarding peace but you may reiterate assurances
                    already given.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Polk</hi>
                    </signed>
                </closer>
            </div>
        </body>
