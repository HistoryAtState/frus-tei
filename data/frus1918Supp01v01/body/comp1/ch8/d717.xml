    <text>
        <body>
            <div xml:id="d717">

                <pb facs="0833" n="741" sameAs="frus:frus1918Supp01v01/pg741"/>

                <note rend="inline" type="source">File No. 763.72/9593</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Great Britain</hi> (<hi
                            rendition="#italic">Page</hi>)<anchor n="1" xml:id="d717-f1"
                    />
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-04-10">
                            <hi rendition="#italic">April 10, 1918</hi></date>.</dateline>
                </opener>
                <p>7209. Following telegrams just received from Monrovia:</p>
                <p>[Here follow the two preceding telegrams.]</p>
                <p>Communicate above to Foreign Office and express the hope that help may be sent
                    immediately.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d717-f1" n="1" type="source" xml:id="d717-f1-content">
                <p>The same, on the same date, to the Ambassador in France (No. 3494).</p>
            </note>
        </listAnnotation>
    </standOff>
