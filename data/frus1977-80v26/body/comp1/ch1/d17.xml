                <pb facs="0073" n="42" xml:id="pg42"/>

                <head>17. Summary of Conclusions of a Special Coordination Committee Meeting<anchor
                        n="1" xml:id="d17-f1"/>
                </head>
                <opener><dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            from="1978-02-15T14:30:00-05:00" to="1978-02-15T15:45:00-05:00">February
                            15, 1978, 2:30–3:45 p.m.</date>
                    </dateline></opener>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>
                        ASAT Treaty</item>
                </list>
                <list subtype="participants" type="description">
                    <label>PARTICIPANTS</label>
