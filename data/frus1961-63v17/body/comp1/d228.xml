            <div xml:id="d228">

                <pb facs="0616" n="556" sameAs="frus:frus1961-63v17/pg556"/>

                <head>228. Memorandum From the Joint Chiefs of Staff to Secretary of Defense
                        McNamara<anchor n="0" xml:id="d228-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1962-03-29">March 29,
                    1962</date>.</dateline></opener>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>Visit of the Shah of Iran 10–17 April 1962 (U)</item>
                </list>
                <p rendition="#flush">JCSM-233–62</p>
                <list>
                    <label>1.</label>
                    <item>Reference is made to a memorandum from the Assistant Secretary of Defense
                        (ISA), dated 21 March 1962,<anchor n="1" xml:id="d228-f2"/> subject as
                        above.</item>
                    <label>2.</label>
                    <item>The papers prepared in response to the reference memorandum are
                        attached.</item>
                </list>
                <closer>For the Joint Chiefs of Staff:<lb/><signed><hi rendition="#bold">Curtis E.
                            LeMay</hi><lb/><hi rendition="#italic">Acting Chairman<lb/>Joint Chiefs
                            of Staff</hi></signed></closer>








