                <pb facs="0424" n="394" sameAs="frus:frus1952-54v02p1/pg394"/>

                <note rend="inline" type="source">Eisenhower Library, Eisenhower papers, Whitman file</note>
                <head><hi rendition="#italic">Minutes of the 155th Meeting of the National Security
                        Council, Thursday, July 16, 1953</hi><anchor n="1" xml:id="d79-f1"/></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">top secret</hi></seg>
                    <dateline rendition="#float-right">
                        <date ana="#date_undated-inferred-from-document-head" calendar="gregorian"
