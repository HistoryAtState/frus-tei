    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d68-f1" n="1" type="source" xml:id="d68-f1-content">
                <p>Copies to the Secretary of the Treasury; the Attorney General; the Directors of
                    Defense Mobilization and Central Intelligence; the Chairmen of the Atomic Energy
                    Commission, the Joint Chiefs of Staff, the Interdepartmental Intelligence
                    Conference, and the Interdepartmental Committee on Internal Security; and the
                    Federal Civil Defense Administrator.</p>
            </note>
            <note corresp="#d68-f2" n="2" xml:id="d68-f2-content">
                <p>Dated May 18, <ref target="#pg328">p. 328</ref>.</p>
            </note>
            <note corresp="#d68-f3" n="3" xml:id="d68-f3-content">
                <p>Not printed; it transmitted to the National Security Council additional and
                    revised materials for NSC 140/1 that are
                    included in the printed version of NSC
                    140/1.</p>
            </note>
        </listAnnotation>
    </standOff>
