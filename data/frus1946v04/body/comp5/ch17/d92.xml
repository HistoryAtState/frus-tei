                <note rend="inline" type="source">C.P.(Gen)Doc. 1.B.12.</note>
                <head><hi rendition="#small-caps">Article 68</hi></head>
                <dateline>
                    <date ana="#date_undated-inferred-from-outside-research" calendar="gregorian"
                        notAfter="1946-10-15T23:59:59+01:00" notBefore="1946-07-29T00:00:00+01:00"
                        >undated</date>
                </dateline>
                <p>In paragraph 8 <hi rendition="#italic">a</hi>., delete the words: <quote
                        rend="blockquote">
                        <p>“Provided that they also had this status at the date of the Armistice
                            with Italy.”</p>
                    </quote></p>
                <p>Similar amendments in: <list>
                        <item>Article 23.—Hungary;</item>
                        <item>Article 24.—Roumania;</item>
                        <item>Article 22.—Bulgaria;</item>
                        <item>Article 24—Finland.</item>
                    </list></p>
            </div>
