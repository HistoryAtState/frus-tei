                <pb facs="0755" n="743" sameAs="frus:frus1946v04/pg743"/>

                <note rend="inline" type="source">C.P.(Gen)Doc.1.U.16.</note>
                <head><hi rendition="#small-caps">Article 52</hi></head>
                <dateline>
                    <date ana="#date_undated-inferred-from-outside-research" calendar="gregorian"
                        notAfter="1946-10-15T23:59:59+01:00" notBefore="1946-07-29T00:00:00+01:00"
                        >undated</date>
                </dateline>
                <list>
                    <label>1.</label>
                    <item>Paragraph 1: The words, “30,000 Carabinieri” should be substituted for
                        “65,000 Carabinieri”, and “215,000” for “250,000”.</item>
                    <label>2.</label>
                    <item>The following new paragraph should be inserted after paragraph 1: <quote
                            rend="blockquote">
                            <p>“2. In no case shall any officer or non-commissioned officer of the
                                former Fascist Militia or of the former Fascist Republican Army be
                                admitted with Officer’s or non-commissioned officer’s rank to the
                                Italian Army, Navy or Air Force.”</p>
                        </quote></item>
                </list>
            </div>
        </body>
