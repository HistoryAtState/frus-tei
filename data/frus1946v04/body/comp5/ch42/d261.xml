                <head><hi rendition="#small-caps">Article 47</hi></head>
                <dateline>
                    <date ana="#date_undated-inferred-from-outside-research" calendar="gregorian"
                        notAfter="1946-10-15T23:59:59+01:00" notBefore="1946-07-29T00:00:00+01:00"
                        >undated</date>
                </dateline>
                <p>Paragraph 1<hi rendition="#italic">a</hi>. “Major War Vessels” should read as
                    follows: <quote rend="blockquote">
                        <p>“One, Battleship;</p>
                        <p>Three, Cruisers;</p>
                        <p>Twelve, Torpedo Boats;</p>
                        <p>Fourteen, Corvettes.”</p>
                    </quote></p>
            </div>
