                <pb facs="0106" n="4" sameAs="frus:frus1927v03/pg4"/>

                <note rend="inline" type="source">868.51 War Credits/467: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Minister in Greece</hi> (<hi rendition="#italic"
                            >Skinner</hi>)</head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1927-04-18T18:00:00-05:00"><hi rendition="#italic">April 18,
                                1927—6 p.m.</hi></date></dateline></opener>
                <p>17. Department desires brief telegraphic report as to reaction of Minister of
                    Foreign Affairs to representations made on basis of our telegram No. 16, of
                    April 9, 1 p.m. [<hi rendition="#italic">April 10, 7 p.m.</hi>].</p>
                <closer><signed><hi rendition="#small-caps">Kellogg</hi></signed></closer>
            </div>
        </body>
