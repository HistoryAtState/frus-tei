    <text>
        <body>
            <div xml:id="d25">

                <pb facs="0118" n="16" sameAs="frus:frus1927v03/pg16"/>

                <note rend="inline" type="source">868.51 War Credits/481</note>
                <head><hi rendition="#italic">The Under Secretary of the Treasury</hi> (<hi rendition="#italic">Mills</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1927-12-06"><hi rendition="#italic">December 6,
                        1927</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: Enclosed is a copy of the
                    statement issued yesterday by Secretary Mellon in connection with the proposed
                    settlement of the indebtedness of the Greek Government to the United States.</p>
                <p>Very truly yours,</p>
                <closer><signed><hi rendition="#small-caps">Ogden L. Mills</hi></signed></closer>


                <xi:include href="d25-a1.xml" xpointer="d25-a1"/>
