            <div xml:id="d11">

                <pb facs="0108" n="6" sameAs="frus:frus1927v03/pg6"/>

                <note rend="inline" type="source">868.51 War Credits/470a: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Minister in Greece</hi> (<hi rendition="#italic"
                            >Skinner</hi>)</head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1927-05-18T17:00:00-04:00"><hi rendition="#italic">May 18, 1927—5
                                p.m.</hi></date></dateline></opener>
                <p>21. Your telegram No. 33, May 14, noon.</p>
                <list>
                    <label>1.</label>
                    <item>The Department does not wish to have you make representations as
                        comprehensive as suggested in penultimate sentence of your telegram under
                        reference.</item>
                    <label>2.</label>
                    <item>If you think useful purpose would be served you should repeat point of
                        view presented in first and second paragraphs of our telegram No. 7, March
                        4, 4 p.m. You should emphasize your remarks by making appropriate reference
                        to paragraphs marked 1 and 2 of our telegram No. 16, April 10, 7 p.m.</item>
                </list>
                <closer><signed><hi rendition="#small-caps">Kellogg</hi></signed></closer>
            </div>
        </body>
    </text>
