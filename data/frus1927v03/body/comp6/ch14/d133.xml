    <text>
        <body>
            <div xml:id="d133">

                <pb facs="0227" n="125" sameAs="frus:frus1927v03/pg125"/>

                <note rend="inline" type="source">865.3311/73: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Italy</hi> (<hi rendition="#italic">Fletcher</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Rome</hi></placeName>, <date calendar="gregorian"
                            when="1927-06-17T12:00:00+01:00"><hi rendition="#italic">June 17,
                                1927—noon</hi></date>.<lb/>[Received June 17—9:05
                    a.m.]</dateline></opener>
                <p>82. Have addressed letter to Premier Mussolini today extending congratulations in
                    the name of the President and the people of the United States on De Pinedo’s
                    return from his air voyage.<anchor n="4" xml:id="d133-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Fletcher</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d133-f1" n="4" xml:id="d133-f1-content">
                <p>Commander De Pinedo had continued his flight in another plane sent from
                    Italy.</p>
            </note>
        </listAnnotation>
    </standOff>
