                <pb facs="0382" n="280" sameAs="frus:frus1927v03/pg280"/>

                <note rend="inline" type="source">862i.73/84</note>
                <head><hi rendition="#italic">The British Ambassador</hi> (<hi
                            rendition="#italic">Howard</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1927-05-02"><hi rendition="#italic">May 2,
                        1927</hi>.</date></dateline>
                    <seg rendition="#float-left">No. 302</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to my note No. 213 of March
                    31st, last, I have the honour to inform you, under instructions from His
                    Majesty’s Principal Secretary of State for Foreign Affairs, that His Majesty’s
                    Government consider that the Yap–Menado cable should be handed over at once to
                    the Netherlands Government without waiting for the resumption of the work of the
                    First Committee of the Washington Conference of 1920.</p>
                <p>I have [etc.]</p>
                <closer>(For the Ambassador)<lb/><signed><hi rendition="#small-caps">H. G.
                            Chilton</hi></signed></closer>
            </div>
        </body>
    </text>
