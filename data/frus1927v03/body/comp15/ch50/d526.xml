            <div xml:id="d526">

                <pb facs="0604" n="502" xml:id="pg502"/>

                <note rend="inline" type="source">819.6156 T 61/6</note>
                <head><hi rendition="#italic">The Minister in Panama</hi> (<hi rendition="#italic"
                        >South</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Panama</hi></placeName>, <date calendar="gregorian"
                            when="1927-02-21"><hi rendition="#italic">February 21,
                        1927</hi></date>.<lb/>[Received March 4.]</dateline>
                    <seg rendition="#float-left">No. 1333</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to my telegram of February
                    17th, 10:00 A.M. and to the Department’s reply of February 19th, 5:00 P.M., I
                    have the honor to transmit herewith a copy of a note which was delivered today
                    to the Panaman Foreign Office regarding the railroad concession embodied in the
                    recently approved contract with the Tonosí Fruit Company.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">J. G. South</hi></signed></closer>


                <xi:include href="d526-a1.xml" xpointer="d526-a1"/>
            </div>
