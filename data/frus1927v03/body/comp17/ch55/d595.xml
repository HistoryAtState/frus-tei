                <pb facs="0685" n="583" sameAs="frus:frus1927v03/pg583"/>

                <note rend="inline" type="source">791.003/17: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Minister in Persia</hi> (<hi rendition="#italic"
                            >Philip</hi>)</head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1927-05-18T17:00:00-04:00"><hi rendition="#italic">May 18, 1927—5
                                p.m.</hi></date></dateline></opener>
                <p>21. With reference to your telegram number 30 of May 18, 6 p.m., you are
                    authorized to transmit to the Persian Government at once the note contained in
                    paragraph number 1 of the Department’s telegram number 19 of May 16, 3 p.m.</p>
                <closer><signed><hi rendition="#small-caps">Kellogg</hi></signed></closer>
            </div>
        </body>
