    <text>
        <body>
            <div xml:id="d596">

                <pb facs="0685" n="583" sameAs="frus:frus1927v03/pg583"/>

                <note rend="inline" type="source">791.003/21: Telegram</note>
                <head><hi rendition="#italic">The Minister in Persia</hi> (<hi rendition="#italic"
                        >Philip</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Teheran</hi></placeName>, <date calendar="gregorian"
                            when="1927-05-23T12:00:00+03:25"><hi rendition="#italic">May 23,
                                1927—noon</hi></date>.<lb/>[Received May 23—10:33
                    a.m.]</dateline></opener>
                <p>35. Note bearing date of May 17 has been delivered to Persian Government in
                    accordance with Department’s instruction No. 22 of May 21.<anchor n="41"
                        xml:id="d596-f1"/> My trip to Tabriz has been postponed.</p>
                <closer><signed><hi rendition="#small-caps">Philip</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
