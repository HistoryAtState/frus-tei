                <pb facs="0657" n="555" sameAs="frus:frus1927v03/pg555"/>

                <note rend="inline" type="source">891.51A/378: Telegram</note>
                <head><hi rendition="#italic">The Minister in Persia</hi> (<hi
                            rendition="#italic">Philip</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Teheran</hi></placeName>, <date calendar="gregorian"
                            when="1927-08-04T13:00:00+03:25"><hi rendition="#italic">August 4,
                                1927—1 p.m.</hi></date><lb/>[Received August 4—9:35
                    a.m.]</dateline></opener>
                <p>51. Millspaugh left today, due New York via Italian vessel first week
                    September.</p>
                <closer><signed><hi rendition="#small-caps">Philip</hi></signed></closer>
            </div>
        </body>
