            <div xml:id="d575">

                <pb facs="0658" n="556" sameAs="frus:frus1927v03/pg556"/>

                <note rend="inline" type="source">891.51A/382: Telegram</note>
                <head><hi rendition="#italic">The Minister in Persia</hi> (<hi
                            rendition="#italic">Philip</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Teheran</hi></placeName>, <date calendar="gregorian"
                            when="1927-08-13T12:00:00+03:25"><hi rendition="#italic">August 13,
                                1927—noon</hi></date>.<lb/>[Received August 13—11:42
                        a.m.]</dateline></opener>
                <p>53. Acting under authorization of Department’s 39 [bis], August 9, I have today
                    delivered note to Persian Government.</p>
                <closer><signed><hi rendition="#small-caps">Philip</hi></signed></closer>
            </div>
        </body>
