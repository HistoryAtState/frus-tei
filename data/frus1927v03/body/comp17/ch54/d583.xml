    <text>
        <body>
            <div xml:id="d583">

                <pb facs="0665" n="563" sameAs="frus:frus1927v03/pg563"/>

                <note rend="inline" type="source">891.51A/415a</note>
                <head><hi rendition="#italic">The Secretary of State to the Minister in Persia</hi>
                        (<hi rendition="#italic">Philip</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1927-09-22"><hi rendition="#italic">September 22,
                        1927</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 581</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Adverting to the Department’s telegram No.
                    51 of September 19, 1927, 7 p.m.<anchor n="22" xml:id="d583-f1"/> with regard to
                    a statement to the Press made in <pb facs="0666" n="564" xml:id="pg564"/>
                    Washington on September 17th by Dr. A. C. Millspaugh, formerly Administrator
                    General of the Finances of Persia, concerning his work in that country and the
                    circumstances of his withdrawal, there is enclosed herewith for your information
                    and guidance a copy of the statement under reference.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State:<lb/><signed><hi rendition="#small-caps">W. R.
                            Castle</hi>, Jr.</signed></closer>


                <xi:include href="d583-a1.xml" xpointer="d583-a1"/>
            </div>
        </body>
    </text>
