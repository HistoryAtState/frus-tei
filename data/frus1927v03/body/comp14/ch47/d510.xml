            <div xml:id="d510">

                <pb facs="0584" n="482" sameAs="frus:frus1927v03/pg482"/>

                <note rend="inline" type="source">857.014/43</note>
                <head><hi rendition="#italic">The Minister in Norway</hi> (<hi rendition="#italic"
                        >Swenson</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Oslo</hi></placeName>, <date calendar="gregorian" when="1927-08-26"
                                ><hi rendition="#italic">August 26, 1927</hi></date>.<lb/>[Received
                        September 7.]</dateline>
                    <seg rendition="#float-left">No. 1043</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Adverting to the Department’s instruction
                    No. 353, of May 10, 1927,<anchor n="9" xml:id="d510-f1"/> with regard to the
                    claim of the Polarfront Company to certain land on the Island of Jan Mayen, I
                    have the honor to transmit herewith a self-explanatory note dated the
                    twenty-third instant from the Norwegian Foreign Office in which the Norwegian
                    Government reiterates its opinion that the Polarfront Company has no valid
                    claim.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Laurits S.
                    Swenson</hi></signed></closer>


                <xi:include href="d510-a1.xml" xpointer="d510-a1"/>
            </div>
        </body>
    </text>
