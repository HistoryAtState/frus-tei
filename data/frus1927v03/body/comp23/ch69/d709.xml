    <text>
        <body>
            <div xml:id="d709">

                <pb facs="0855" n="753" sameAs="frus:frus1927v03/pg753"/>

                <note rend="inline" type="source">711.582/24</note>
                <head><hi rendition="#italic">The Swedish Minister</hi> (<hi rendition="#italic"
                        >Boström</hi>) <hi rendition="#italic">to the Solicitor for the Department
                        of State</hi> (<hi rendition="#italic">Hackworth</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1927-06-14"><hi rendition="#italic">June 14,
                        1927</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Hackworth</hi>: Many thanks for your
                    letter of June 13th and the accompanying memorandum relating to certain points
                    in the proposed Treaty of Friendship, Commerce and Consular Eights between
                    Sweden and the United States.</p>
                <p>I have not failed to take the matter up with my Government and will be glad to
                    avail myself of your kind offer, should occasion arise later on.<anchor n="18"
                        xml:id="d709-f1"/></p>
                <p>Yours sincerely,</p>
                <closer><signed><hi rendition="#small-caps">W. Boström</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d709-f1" n="18" xml:id="d709-f1-content">
                <p>Continuation of negotiations did not result in the conclusion of a treaty.</p>
            </note>
        </listAnnotation>
    </standOff>
