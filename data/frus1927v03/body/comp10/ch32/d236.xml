    <text>
        <body>
            <div xml:id="d236">

                <pb facs="0365" n="263" xml:id="pg263"/>

                <note rend="inline" type="source">312.115 Ol 41/21</note>
                <head><hi rendition="#italic">The Ambassador in Mexico</hi> (<hi rendition="#italic">Sheffield</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1927-03-04"><hi rendition="#italic">March 4,
                        1927</hi>.</date><lb/>[Received March 10.]</dateline>
                    <seg rendition="#float-left">No. 3775</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my telegram No. 82 [<hi
                        rendition="#italic">83</hi>], 4 p.m., of today,<anchor n="91"
                        xml:id="d236-f1"/> I have the honor to transmit herewith a copy and
                    translation of the memorandum received today from the Mexican Foreign Office
                    with respect to the case of the Oliver Trading Company.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">James R.
                    Sheffield</hi></signed></closer>


                <xi:include href="d236-a1.xml" xpointer="d236-a1"/>
            </div>
        </body>
    </text>
