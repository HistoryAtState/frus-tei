    <text>
        <body>
            <div xml:id="d703">

                <pb facs="0838" n="736" sameAs="frus:frus1927v03/pg736"/>

                <note rend="inline" type="source">611.5231/539: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Spain</hi> (<hi rendition="#italic"
                        >Hammond</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1927-10-20T12:00:00+00:00"><hi rendition="#italic">October 20,
                                1927—noon</hi></date>.<lb/>[Received October 20—11:03
                        a.m.]</dateline></opener>
                <p>104. My telegram number 103, October 18, 10 a.m.<anchor n="69" xml:id="d703-f1"/>
                    Foreign Office requests that Kisliuk be authorized to investigate the tomato
                    situation in the Canary Islands, and urge the advisability thereof with a view
                    to securing fair solution of Spanish grievances and normalizing of commercial
                    relations by the new treaty.<anchor n="70" xml:id="d703-f2"/></p>
                <p>I strongly recommend compliance with the request.</p>
                <closer><signed><hi rendition="#small-caps">Hammond</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d703-f1" n="69" xml:id="d703-f1-content">
                <p><hi rendition="#italic">Ante</hi>, <ref target="#pg730">p. 730</ref>.</p>
            </note>
            <note corresp="#d703-f2" n="70" xml:id="d703-f2-content">
                <p>For negotiations for the renewal of the commercial agreement with Spain, see <ref
                        target="#pg729">pp. 729</ref> ff.</p>
            </note>
