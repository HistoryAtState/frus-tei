            <div xml:id="d487">

                <pb facs="0563" n="461" sameAs="frus:frus1927v03/pg461"/>

                <note rend="inline" type="source">417.00/263</note>
                <head><hi rendition="#italic">The Chargé in Nicaragua</hi> (<hi rendition="#italic">Dennis</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Managua</hi></placeName>, <date calendar="gregorian"
                            when="1926-12-09"><hi rendition="#italic">December 9,
                        1926</hi></date>.<lb/>[Received January 5, 1927.]</dateline>
                    <seg rendition="#float-left">No. 310</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my Despatch No. 302, of
                    November 25, 1926 in regard to the proposed Mixed Claims Commission, I have the
                    honor to transmit a translation, made by the High Commissioner, Mr. Hill, of the
                    law providing for this Commission as voted by Congress on December 1st.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Lawrence Dennis</hi></signed></closer>


                <xi:include href="d487-a1.xml" xpointer="d487-a1"/>
            </div>
