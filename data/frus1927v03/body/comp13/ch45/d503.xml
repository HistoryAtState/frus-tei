    <text>
        <body>
            <div xml:id="d503">

                <pb facs="0571" n="469" sameAs="frus:frus1927v03/pg469"/>

                <note rend="inline" type="source">711.1711/6</note>
                <head><hi rendition="#italic">The Minister in Nicaragua</hi> (<hi rendition="#italic">Eberhardt</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Managua</hi></placeName>, <date calendar="gregorian"
                            when="1927-02-23"><hi rendition="#italic">February 23,
                        1927</hi></date>.<lb/>[Received March 14.]</dateline>
                    <seg rendition="#float-left">No. 359</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In compliance with the Department’s
                    telegram No. 44, of February 21, 7 p.m.<anchor n="69" xml:id="d503-f1"/> I have
                    the honor to transmit herewith the full text of two notes, with translations,
                    from President Diaz in which there has been proposed a treaty of alliance,
                    defensive and offensive between the United States and Nicaragua.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Charles C.
                    Eberhardt</hi></signed></closer>




                <xi:include href="d503-a1.xml" xpointer="d503-a1"/>
                <xi:include href="d503-a2.xml" xpointer="d503-a2"/>
