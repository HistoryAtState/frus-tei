                <pb facs="0406" n="304" sameAs="frus:frus1927v03/pg304"/>

                <note rend="inline" type="source">817.00/4496a</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Secretary of the Navy</hi> (<hi rendition="#italic"
                            >Wilbur</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1927-01-27"><hi rendition="#italic">January 27,
                        1927</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to request that the
                    attached message be despatched immediately to Admiral Latimer, provided you see
                    no objection.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Frank B. Kellogg</hi></signed></closer>


                <xi:include href="d267-a1.xml" xpointer="d267-a1"/>
