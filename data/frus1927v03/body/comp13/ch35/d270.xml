            <div xml:id="d270">

                <pb facs="0408" n="306" sameAs="frus:frus1927v03/pg306"/>

                <note rend="inline" type="source">817.00/4540</note>
                <head><hi rendition="#italic">The Secretary of State to the Secretary of the
                        Navy</hi> (<hi rendition="#italic">Wilbur</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1927-02-07"><hi rendition="#italic">February 7,
                        1927</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to request that the
                    attached message be transmitted immediately to Admiral Latimer if you see no
                    objection.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Frank B. Kellogg</hi></signed></closer>


                <xi:include href="d270-a1.xml" xpointer="d270-a1"/>
