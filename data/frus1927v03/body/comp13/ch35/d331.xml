                <pb facs="0451" n="349" xml:id="pg349"/>

                <note rend="inline" type="source">817.00/4782: Telegram</note>
                <head><hi rendition="#italic">The Minister in Nicaragua</hi> (<hi
                        rendition="#italic">Eberhardt</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Managua</hi></placeName>, <date calendar="gregorian"
                            when="1927-05-16T11:00:00-05:45"><hi rendition="#italic">May 16, 1927—11
                                a.m.</hi></date><lb/>[Received 1 p.m.]</dateline></opener>
                <p>135. Mr. and Mrs. Stimson and Dawson left here for Corinto this morning. Will
                    sail this afternoon U. S. S. <hi rendition="#italic">Trenton</hi> for Hampton
                    Roads.</p>
                <closer><signed><hi rendition="#small-caps">Eberhardt</hi></signed></closer>
            </div>
        </body>
