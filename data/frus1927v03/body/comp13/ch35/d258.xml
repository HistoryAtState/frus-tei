    <text>
        <body>
            <div xml:id="d258">

                <pb facs="0390" n="288" sameAs="frus:frus1927v03/pg288"/>

                <note rend="inline" type="source">317.55/orig.: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Minister in Nicaragua</hi> (<hi rendition="#italic"
                            >Eberhardt</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1927-01-07T19:00:00-05:00"><hi rendition="#italic">January 7,
                                1927—7 p.m.</hi></date></dateline></opener>
                <p>11. The Belgian Ambassador has requested on behalf of his Government that the
                    United States Government afford protection to Belgian lives and property in
                        Nicaragua.<anchor n="8" xml:id="d258-f1"/> You may accord such protection to
                    Belgian nationals as may be possible and proper under the circumstances.</p>
                <closer><signed><hi rendition="#small-caps">Kellogg</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d258-f1" n="8" xml:id="d258-f1-content">
                <p>Request not printed.</p>
            </note>
        </listAnnotation>
    </standOff>
