    <text>
        <body>
            <div xml:id="d234">

                <pb facs="0333" n="259" xml:id="pg259"/>

                <head>Mr. Seward to Sir F.
                        Bruce</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1866-10-22"><hi rendition="#italic"
                                >October</hi> 22, 1866.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Dear Sir Frederick:</hi> I commend to your
                    attention the enclosed copy of a petition on behalf of Patrick O’Neill, a minor,
                    who is alleged to be detained at Toronto on suspicion of being implicated in the
                    late Fenian demonstration.</p>
                <p>In view of the circumstances set forth in the petition, I trust that, through
                    your kind offices, the young man may be released and permitted to return to his
                    relatives.</p>
                <p>I remain, my dear Sir Frederick, very faithfully yours,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p>The Hon. Sir <hi rendition="#small-caps">Frederick W. A. Bruce</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d234-a1.xml" xpointer="d234-a1"/>
