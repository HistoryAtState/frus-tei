    <text>
        <body>
            <div xml:id="d223-a4">

                <pb facs="0325" n="251" xml:id="pg251"/>

                <head>Telegram received from Hon. William McDougall.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Ottawa,</hi></placeName>
                        <date calendar="gregorian" when="1866-07-13"><hi rendition="#italic"
                                >July</hi> 13, 1866.</date></dateline></opener>
                <p><hi rendition="#small-caps">D. Thurston</hi>, <hi rendition="#italic">American
                        Consul, Toronto, C. W.:</hi></p>
                <p>The prisoners having been taken by the military authorities as persons engaged in
                    a piratical attack upon this province, can only be discharged after acquittal by
                    the proper legal tribunal.</p>
                <closer>
                    <signed>WILLIAM McDOUGALL.</signed></closer>
            </div>
        </body>
    </text>
