    <text>
        <body>
            <div xml:id="d241-a3">

                <pb facs="0338" n="264" sameAs="frus:frus1866p1/pg264"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">City Clerk’s Office</hi>, <hi
                                rendition="#italic">Chicago</hi>,</placeName>
                        <date calendar="gregorian" when="1866-11-15"><hi rendition="#italic"
                                >November</hi> 15, 1866.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi> I am directed by the common council of the
                    city of Chicago to send to your excellency a certified copy of the action
                    thereof, in relation to the accompanying preamble and appeal.</p>
                <p>Respectfully, &amp;c.,</p>
                <closer>
                    <signed>A. H. BODMAN, <hi rendition="#italic">City Clerk.</hi></signed></closer>
                <postscript>
                    <p>His Excellency <hi rendition="#small-caps">Andrew Johnson</hi>, <hi
                            rendition="#italic">President of the United States of America.</hi></p>
                </postscript>
            </div>
        </body>
