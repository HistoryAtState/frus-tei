    <text>
        <body>
            <div xml:id="d228-a3">

                <pb facs="0330" n="256" sameAs="frus:frus1866p1/pg256"/>

                <opener><dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Winchester, Randolph County
                                Indiana,</hi></placeName>
                        <date calendar="gregorian" when="1866-07-28"><hi rendition="#italic"
                                >July</hi> 28, 1866.</date></dateline></opener>
                <p><hi rendition="#small-caps">State of Indiana</hi>, <hi rendition="#italic"
                        >Randolph County, ss:</hi></p>
                <p>Subscribed and sworn to before me this July 28th, 1866. I also certify that the
                    persons whose names are hereunto attached are persons who live near me, in the
                    city of Winchester, and I consider them men of good character for truth and
                    veracity.</p>
                <closer>
                    <signed>WILLIAM D. FRAZEE, <hi rendition="#italic">Justice of the
                        Peace.</hi></signed></closer>
            </div>
        </body>
