    <text>
        <body>
            <div xml:id="d308">

                <pb facs="0412" n="338" sameAs="frus:frus1866p1/pg338"/>

                <head>Mr. Seward to Mr. Bigelow</head>
                <opener>
                    <seg rendition="#float-left">No. 516.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1866-08-24"><hi rendition="#italic"
                                >August</hi> 24, 1866.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit herewith for your information
                    copies of the President’s proclamation of the 17th instant, declaring null and
                    void a decree of Prince Maximilian closing certain ports in Mexico.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">John Bigelow,</hi> Esq.,<hi rendition="#italic">
                            &amp;c., &amp;c., &amp;c</hi>.</p>
                </postscript>


                <xi:include href="d308-a1.xml" xpointer="d308-a1"/>
            </div>
        </body>
    </text>
