    <text>
        <body>
            <div xml:id="d329">

                <pb facs="0442" n="368" sameAs="frus:frus1866p1/pg368"/>

                <head>Mr. Bigelow to Mr. Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 387.].</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1866-12-03"><hi rendition="#italic"
                                >December</hi> 3, 1866.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to enclose a copy of a
                    despatch, which I have this day transmitted to you in cipher by the Atlantic
                    telegraph.</p>
                <p>I am, sir, with great respect, our obedient servant,</p>
                <closer>
                    <signed>JOHN BIGELOW.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>


                <xi:include href="d329-a1.xml" xpointer="d329-a1"/>
            </div>
