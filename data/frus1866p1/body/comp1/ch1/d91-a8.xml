        <body>
            <div xml:id="d91-a8">

                <pb facs="0185" n="111" sameAs="frus:frus1866p1/pg111"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <p>We, the assessors of 20th ward, Philadelphia, Pennsylvania, do hereby certify
                    that Michael Kirwan, a colonel in company—13th regiment Pennsylvania cavalry,
                    has been duly assessed in said ward, and charged with ten cents county tax, in
                    pursuance of the act of assembly entitled “An act to regulate elections by
                    soldiers in actual military service,” approved August 25, 1864.</p>
                <closer>
                    <dateline rendition="#float-left">Witness our hands <date calendar="gregorian"
                            when="1864-09-30">this 30th day of September, A. D.
                        1864</date>.</dateline>
                    <lb/>
                    <signed>E. HERITAGE,</signed></closer>
                <closer>
                    <signed>jos. mountain, Jr., <hi rendition="#italic"
                    >Assessors.</hi></signed></closer>
            </div>
        </body>
    </text>
