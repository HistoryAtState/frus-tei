    <text>
        <body>
            <div xml:id="d119-a1">

                <pb facs="0212" n="138" xml:id="pg138"/>

                <head>Mr. Dixon to Mr.
                        Seward.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Senate,</hi></placeName>
                        <date calendar="gregorian" when="1866-06-12"><hi rendition="#italic"
                                >June</hi> 12, 1866.</date></dateline></opener>
                <p>I respectfully call the attention of Mr. Seward to the within, and ask his
                    interposition, if consistent with the public interest.</p>
                <closer>
                    <signed>JAMES DIXON.</signed></closer>
            </div>
        </body>
