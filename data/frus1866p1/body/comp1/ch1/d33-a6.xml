    <text>
        <body>
            <div xml:id="d33-a6">

                <pb facs="0130" n="56" sameAs="frus:frus1866p1/pg56"/>

                <head>The Earl of Clarendon to Mr. Adams.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Foreign Office,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1865-12-30"><hi rendition="#italic"
                                >December</hi> 30, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your letter of the 28th instant, enclosing further papers respecting the case
                    of the Shenandoah, and to state to you that they shall receive due
                    attention.</p>
                <p>I am, &amp;c.,</p>
                <closer>
                    <signed>CLARENDON.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
