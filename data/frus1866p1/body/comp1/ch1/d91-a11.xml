    <text>
        <body>
            <div xml:id="d91-a11">

                <pb facs="0186" n="112" sameAs="frus:frus1866p1/pg112"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Station, Light-house Point,
                                Virginia,</hi></placeName>
                        <date calendar="gregorian" when="1864-07-20"><hi rendition="#italic"
                                >July</hi> 20, 1864.</date></dateline></opener>
                <p>I certify on honor that I have at Light-house Point, Virginia, on this 20th day
                    of July, 1864, carefully examined this roll, and, as far as practicable, caused
                    the allowances, stoppages, and remarks to be justly and properly stated, and
                    mustered the officer for discharge, and he is hereby honorably discharged from
                    the service of the United States, to accept promotion.</p>
                <closer>
                    <signed>CHARLES TREICHEL, <hi rendition="#italic">Captain and A. C. of M.,
                            Mustering Officer.</hi></signed></closer>
            </div>
        </body>
    </text>
