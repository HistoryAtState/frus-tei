    <text>
        <body>
            <div xml:id="d115">

                <pb facs="0209" n="135" xml:id="pg135"/>

                <head>Mr. Seward to Mr. Adams.</head>
                <opener>
                    <seg rendition="#float-left">No. 1780.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1866-06-12"><hi rendition="#italic">June</hi>
                            12, 1866.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit to you for your information a
                    copy of a note* which, on the 11th instant, I addressed to Sir Frederick Bruce,
                    upon the subject of the recent Fenian expedition into Canada.</p>
                <p>A copy of the President’s proclamation of the 6th instant, relating to the
                    aforenamed movement, is also enclosed.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq.,<hi
                            rendition="#italic"> &amp;c</hi>., <hi rendition="#italic">&amp;c.
                            &amp;c.</hi></p>
                </postscript>


                <xi:include href="d115-a1.xml" xpointer="d115-a1"/>
            </div>
