    <text>
        <body>
            <div xml:id="d82">

                <pb facs="0178" n="104" sameAs="frus:frus1866p1/pg104"/>

                <head>Mr. Seward to Mr. Adams.</head>
                <opener>
                    <seg rendition="#float-left">No 1738.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>, </placeName>
                        <date calendar="gregorian" when="1866-04-17"><hi rendition="#italic"
                                >April</hi> 17, 1866.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to instruction No. 1737, of the
                    11th of this month, relative to the fishery question, growing out of the
                    termination of the reciprocity treaty, I now transmit for your information a
                    copy of a report made by this department to the President, in answer to a
                    resolution of the House of Representatives, of the 10th instant, requesting
                    information on the subject.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d82-a1.xml" xpointer="d82-a1"/>
            </div>
