    <text>
        <body>
            <div xml:id="d91-a3">

                <pb facs="0184" n="110" sameAs="frus:frus1866p1/pg110"/>

                <opener><dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Station, Light-house Point,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1864-07-20"><hi rendition="#italic"
                                >July</hi> 20, 1864.</date></dateline></opener>
                <p>I certify on honor that I have carefully examined the officer whose name is borne
                    on this roll, and have accepted him into the service of the United States for
                    the term of three years unless sooner discharged, from the 15th day of July,
                    1864.</p>
                <closer><signed>CHARLES TREICHEL, <hi rendition="#italic">Captain and A. C. of M.,
                            Mustering Officer.</hi></signed></closer>
            </div>
        </body>
    </text>
