    <text>
        <body>
            <div xml:id="d113">

                <pb facs="0202" n="128" sameAs="frus:frus1866p1/pg128"/>

                <head>Mr. Adams to Mr.
                        Seward.</head>
                <opener>
                    <seg rendition="#float-left">No. 1216.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">London</hi></placeName>, <date
                            calendar="gregorian" when="1866-06-07"><hi rendition="#italic">June</hi>
                            7, 1866.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit herewith a copy of a note
                    addressed to me on the 6th instant by Lord Clarendon, touching the questions
                    raised by the cruise of the Shenandoah, together with copies of the enclosed
                    papers.</p>
                <p>I likewise send a copy of my reply.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>CHARLES FRANCIS ADAMS.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>











