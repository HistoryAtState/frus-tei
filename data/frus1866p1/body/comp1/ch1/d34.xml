                <pb facs="0130" n="56" sameAs="frus:frus1866p1/pg56"/>

                <head>Mr. Hunter to Mr.
                        Adams.</head>
                <opener>
                    <seg rendition="#float-left">No. 1647.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1866-01-06"><hi rendition="#italic"
                                >January</hi> 6, 1866.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: At the request of the Secretary of the
                    Treasury I transmit for your information, and for such use as you may deem
                    proper, copies of the monthly statement of the public debt of the United
                    States.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>W. HUNTER, <hi rendition="#italic">Acting
                    Secretary.</hi></signed></closer>
