    <text>
        <body>
            <div xml:id="d141">

                <pb facs="0227" n="153" sameAs="frus:frus1866p1/pg153"/>

                <head>Mr. Seward to Mr.
                        Adams.</head>
                <opener>
                    <seg rendition="#float-left">No. 1812.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1866-07-24"><hi rendition="#italic">July</hi>
                            24, 1866.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I transmit a copy of a communication of the
                    20th instant from the honorable S. E. Ancona, of the House of Representatives,
                    relative to the case of <pb facs="0228" n="154" xml:id="pg154"/> Patrick Hasson,
                    who, it appears, has been arrested at Belfast, Ireland, as a Fenian. I will
                    thank you to adopt the best measures to obtain his release.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq.,<hi
                            rendition="#italic"> &amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>



                <xi:include href="d141-a1.xml" xpointer="d141-a1"/>
