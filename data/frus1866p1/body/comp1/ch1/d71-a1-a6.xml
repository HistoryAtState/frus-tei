    <text>
        <body>
            <div xml:id="d71-a1-a6">

                <pb facs="0166" n="92" sameAs="frus:frus1866p1/pg92"/>

                <opener><dateline rendition="#float-right">
                        <date calendar="gregorian" when="1866-03-20"><hi rendition="#small-caps"
                                >March</hi> 20, 1866,</date></dateline></opener>
                <p><hi rendition="#small-caps">Commonwealth of Massachusetts</hi>, <hi
                        rendition="#italic">Middlesex County, ss</hi>:</p>
                <p>Then personally appeared Matthew Donovan, whom I certify to be a respectable and
                    credible person, and made solemn oath to the truth of the foregoing affidavit,
                    by him subscribed, be fore me.</p>
                <p>In testimony whereof I have hereunto affixed my hand and official seal notarial,
                    at my office in the city of Lowell, in said county, on the day and year
                    aforesaid.</p>

                <closer>
                    <signed>EDWIN A. ALGER, <hi rendition="#italic">Notary
                    Public.</hi></signed></closer>
            </div>
        </body>
    </text>
