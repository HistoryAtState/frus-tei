    <text>
        <body>
            <div xml:id="d37">

                <pb facs="0133" n="59" sameAs="frus:frus1866p1/pg59"/>

                <head>Mr. Hunter to Mr. Adams.</head>
                <opener>
                    <seg rendition="#float-left">No. 1662.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1866-01-23"><hi rendition="#italic"
                                >January</hi> 23, 1866.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I enclose for your information a copy of a
                    letter of the 30th of December last from the Secretary of the Navy, relative to
                    the disposition of the Shenandoah.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>W. HUNTER, <hi rendition="#italic">Acting
                    Secretary</hi>.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d37-a1.xml" xpointer="d37-a1"/>
            </div>
