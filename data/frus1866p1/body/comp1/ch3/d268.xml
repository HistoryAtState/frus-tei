    <text>
        <body>
            <div xml:id="d268">

                <pb facs="0360" n="286" sameAs="frus:frus1866p1/pg286"/>

                <head>Mr. Bigelow to Mr.
                        Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 292.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1866-03-26"><hi rendition="#italic"
                                >March</hi> 26, 1866.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have received from Lord Cowley notice of
                    the payment of the second instalment of the Japanese indemnity. I have the honor
                    to enclose copies of his lordship’s letter and of my reply.</p>
                <p>I am, sir, with great respect, your obedient servant,</p>
                <closer>
                    <signed>JOHN BIGELOW.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>



                <xi:include href="d268-a1.xml" xpointer="d268-a1"/>
