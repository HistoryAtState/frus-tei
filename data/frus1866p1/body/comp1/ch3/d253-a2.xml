                <pb facs="0350" n="276" sameAs="frus:frus1866p1/pg276"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Headquarters Armies of the United
                                States</hi>, <hi rendition="#italic">Charleson, S.
                            C.,</hi></placeName>
                        <date calendar="gregorian" when="1865-12-01"><hi rendition="#italic"
                                >December</hi> 1, 1865.</date></dateline></opener>
                <p>Major General <hi rendition="#small-caps">P. H. Sheridan</hi>, <hi
                        rendition="#italic">New Orleans:</hi></p>
                <p>In view of probable action by Congress on Mexican affairs, do all you can to
                    preserve strict neutrality pending such action.</p>
                <closer>
                    <signed>U.S. GRANT, <hi rendition="#italic">Lieutenant
                    General.</hi></signed></closer>
            </div>
        </body>
