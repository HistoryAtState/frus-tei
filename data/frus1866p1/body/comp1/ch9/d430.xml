    <text>
        <body>
            <div xml:id="d430">

                <pb facs="0654" n="580" sameAs="frus:frus1866p1/pg580"/>

                <head>Mr. Seward to Mr. Hale</head>
                <opener>
                    <seg rendition="#float-left">No. 48.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1866-10-08"><hi rendition="#italic"
                                >October</hi> 8, 1866.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your despatch of the 15th of September, No.
                    58, has been received, and is approved.</p>
                <p>The sentiments expressed by the Spanish government, in reply to. your
                    communication therein mentioned, are in harmony with the general policy of
                    Spain, as understood here, and are very acceptable.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">John P. Hale,</hi> Esq., <hi rendition="#italic"
                            >&amp;c., &amp;c</hi><hi rendition="#italic">., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
