    <text>
        <body>
            <div xml:id="d332-a3">

                <pb facs="0451" n="377" sameAs="frus:frus1866p1/pg377"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Headquarters District Rio
                            Grande</hi>, <hi rendition="#italic">Brownsville, Texas,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1865-12-21"><hi rendition="#italic"
                                >December</hi> 21, 1865.</date></dateline></opener>
                <p>The proceedings and report of the military commission, hereto attached, convened
                    for the purpose of investigating the alleged pillaging of the shipwrecked
                    merchant vessel Le Verrier, and the firing upon her crew, are approved and
                    respectfully forwarded.</p>
                <closer>
                    <signed>G. WEITZEL, <hi rendition="#italic">Major General
                        Commanding.</hi></signed></closer>
            </div>
        </body>
    </text>
