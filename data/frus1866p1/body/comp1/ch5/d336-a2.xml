            <div xml:id="d336-a2">

                <pb facs="0456" n="382" sameAs="frus:frus1866p1/pg382"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <p rendition="#center">MAXIMILIAN, EMPEROR OF MEXICO.</p>
                <p>In consideration of the merits, combined with the qualifications, of Mr. Friaut,
                    intendant-in-chief of the expeditionary corps, we have thought proper to commit
                    to him the direction of the department of the treasury.</p>
                <closer><dateline rendition="#float-left">Given at <placeName>Mexico</placeName>
                        <date calendar="gregorian" when="1866-07-26">the 26th July,
                        1866</date>.</dateline>
                    <lb/>
                    <signed>MAXIMILIAN.</signed></closer>
                <postscript>
                    <p>By the Emperor: <hi rendition="#small-caps">José Salazar Ylarrequi</hi>, <hi
                            rendition="#italic">Minister of the Interior.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
