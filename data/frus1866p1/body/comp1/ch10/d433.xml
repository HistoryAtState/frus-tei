    <text>
        <body>
            <div xml:id="d433">

                <pb facs="0658" n="584" sameAs="frus:frus1866p1/pg584"/>

                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <head>Mr. Tassara to Mr.
                        Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of Spain</hi>, <hi
                                rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-12-16"><hi rendition="#italic"
                                >December</hi> 16, 1865.</date></dateline></opener>
                <p>The minister of Spain presents his compliments to the honorable Secretary of
                    State of the United States, and has the honor to place in his hands a copy of
                    the official Gazette of Madrid, in which is published the circular of her
                    Catholic Majesty’s department of state, which Mr. Tassara read to the Hon.
                    William H. Seward at his interview with him the day before yesterday.</p>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward, <hi rendition="#italic"
                                >&amp;c</hi></hi>., <hi rendition="#italic">&amp;c.,
                        &amp;c</hi>.</p>
                </postscript>


                <xi:include href="d433-a1.xml" xpointer="d433-a1"/>
