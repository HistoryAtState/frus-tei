    <text>
        <body>
            <div xml:id="d496">

                <pb facs="0744" n="670" sameAs="frus:frus1866p1/pg670"/>

                <head>Mr. Motley to Mr. Seward.</head>
                <opener>
                    <seg rendition="#float-left">No. 189.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">Vienna</hi></placeName>, <date
                            calendar="gregorian" when="1866-06-19"><hi rendition="#italic">June</hi>
                            19, 1866.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge receipt of
                    your Nos. 183 to 187, inclusive, together with a copy of your note of April 25,
                    to the Marquis de Montholon.</p>
                <pb facs="0745" n="671" xml:id="pg671"/>
                <p>I beg to thank you for the communication of this very important and interesting
                    document, and at the same time to express my sincere gratification that my
                    proceedings in regard to the volunteers for Mexico have met with the approval of
                    the President.</p>
                <p>Meantime, I have the honor to remain, sir, your obedient servant,</p>
                <closer>
                    <signed>J. LOTHROP MOTLEY</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
