    <text>
        <body>
            <div xml:id="d624">

                <pb facs="0941" n="821" sameAs="frus:frus1922v01/pg821"/>

                <note rend="inline" type="source">500. A 4e/150: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >Schurman</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1923-01-05T16:00:00+08:00"><hi rendition="#italic">January 5,
                                1923—4 p.m.</hi></date><lb/>[Received 4:45 p.m.]</dateline></opener>
                <p>10. My 1, January 2, 3 p.m.<anchor n="92" xml:id="d624-f1"/> Ministry of Foreign
                    Affairs has notified Diplomatic Body that as each power concerned has conveyed
                    to the Chinese Government its approval of revised import tariff it has been
                    decided to bring it into effect on January 17th and syndicate notifications to
                    that effect were issued on January 3rd.</p>
                <closer><signed><hi rendition="#small-caps">Schurman</hi></signed></closer>
            </div>
        </body>
    </text>
