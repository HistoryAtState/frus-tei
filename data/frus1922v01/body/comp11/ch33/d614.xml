                <pb facs="0938" n="818" sameAs="frus:frus1922v01/pg818"/>

                <note rend="inline" type="source">500. A 4e/23: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Consul General at Shanghai</hi> (<hi
                            rendition="#italic">Cunningham</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1922-04-22T16:00:00-05:00"><hi rendition="#italic">April 22,
                                1922—4 p.m.</hi></date></dateline></opener>
                <p>Your April 11, 10 a.m.</p>
                <p>For Arnold.</p>
                <p>W. A. Burns is hereby appointed Associate Member of Tariff Revision Commission.
                    Offer of voluntary services appreciated but under statute can not be accepted.
                    Confer with Burns and telegraph amount regarded as reasonable compensation.</p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
