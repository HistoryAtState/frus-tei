                <pb facs="0938" n="818" sameAs="frus:frus1922v01/pg818"/>

                <note rend="inline" type="source">500. A 4e/89a</note>
                <head><hi rendition="#italic">The Secretary of State to
                        Mr. Henry Blackwood, Special Deputy Collector
                        of Customs, Seattle</hi></head>
                <opener><seg rendition="#center">[Extract]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1922-05-27"><hi rendition="#italic">May 27,
                        1922</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: You are hereby appointed an Associate
                    Member of the American Delegation on the International Commission to revise the
                    Chinese Customs Tariff provided for in the treaty relating to Chinese Customs
                    Tariff, signed at Washington February 6, 1922.</p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>I am [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Charles E. Hughes</hi></signed></closer>
            </div>
        </body>
