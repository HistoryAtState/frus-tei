            <div xml:id="d612">

                <pb facs="0937" n="817" sameAs="frus:frus1922v01/pg817"/>

                <note rend="inline" type="source">500. A 4e/23: Telegram</note>
                <head><hi rendition="#italic">The Consul General at Shanghai</hi> (<hi
                        rendition="#italic">Cunningham</hi>) <hi rendition="#italic">to the
                        Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Shanghai</hi></placeName>, <date calendar="gregorian"
                            when="1922-04-11T10:00:00+08:00"><hi rendition="#italic">April 11,
                                1922—10 a.m.</hi></date><lb/>[Received April 10—11:27
                        p.m.]</dateline></opener>
                <p>4. From Arnold.</p>
                <p>Recommend the appointment W. A. Burns manager of the American Trading Company
                    Shanghai member American delegation Tariff Revision Commission without
                    remuneration. American Chamber of Commerce endorses.</p>
                <closer><signed><hi rendition="#small-caps">Cunningham</hi></signed></closer>
            </div>
        </body>
    </text>
