    <text>
        <body>
            <div xml:id="d666">

                <pb facs="0982" n="862" xml:id="pg862"/>

                <note rend="inline" type="source">893.00/4327</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">Schurman</hi>) <hi rendition="#italic">to
                        the Consular Officers in China</hi><anchor n="30"
                        xml:id="d666-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1922-03-29"><hi rendition="#italic">March 29,
                        1922</hi></date>.</dateline>
                    <seg rendition="#float-left">Circular No. 46</seg></opener>
                <p><hi rendition="#small-caps">Gentlemen</hi>: The Legation has to transmit herewith
                    for your information and guidance a copy of a note from the Ministry for Foreign
                    Affairs, dated March 23, 1922, relative to the present dangers to the travel of
                    foreigners in the border regions of Szechuan Province.</p>
                <p>I am [etc.]</p>
                <closer>(For the Minister)<lb/><signed><hi rendition="#small-caps">A. B.
                            Ruddock</hi></signed></closer>


                <xi:include href="d666-a1.xml" xpointer="d666-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d666-f1" n="30" type="source" xml:id="d666-f1-content">
                <p>Transmitted to the Department by the Minister in his despatch no. 517 of Apr. 3,
                    received about May 2.</p>
            </note>
        </listAnnotation>
    </standOff>
