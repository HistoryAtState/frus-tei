                <pb facs="0987" n="867" xml:id="pg867"/>

                <note rend="inline" type="source">393.1111—Lundeen, Anton: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Minister in China</hi> (<hi rendition="#italic"
                            >Schurman</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1922-11-24T18:00:00-05:00"><hi rendition="#italic">November 24,
                                1922—6 p.m.</hi></date></dateline></opener>
                <p>275. Your 449, November 16, 4 P.M. Department approves your action and awaits
                    with concern result of efforts now being made to obtain release of American
                    citizens.</p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
