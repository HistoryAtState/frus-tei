    <text>
        <body>
            <div xml:id="d547">

                <pb facs="0878" n="758" sameAs="frus:frus1922v01/pg758"/>

                <note rend="inline" type="source">893.113/384: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic"
                        >Herrick</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1922-11-03T16:00:00+00:00"><hi rendition="#italic">November 3,
                                1922—4 p.m.</hi></date><lb/>[Received 7:55 p.m.]</dateline></opener>
                <p>446. Your 319, October 17, 5 p.m.<anchor n="7" xml:id="d547-f1"/> Foreign Office
                    informs me it concurs with the views of the United States Government relative to
                    requesting the adhesion of those powers participating in or adhering to the arms
                    embargo of 1919.</p>
                <closer><signed><hi rendition="#small-caps">Herrick</hi></signed></closer>
            </div>
        </body>
    </text>
