            <div xml:id="d539">

                <pb facs="0873" n="753" sameAs="frus:frus1922v01/pg753"/>

                <note rend="inline" type="source">893.34/182: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic">Herrick</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1922-07-05T16:00:00+01:00"><hi rendition="#italic">July 5, 1922—4
                                p.m.</hi></date><lb/>[Received July 5—12:50
                    p.m.]</dateline></opener>
                <p>277. Your 131, May 4, 2 p.m.<anchor n="97" xml:id="d539-f1"/> Am officially
                    notified French Government prepared to subscribe to agreement relative to
                    Bethlehem Steel Corporation contract with China.</p>
                <closer><signed><hi rendition="#small-caps">Herrick</hi></signed></closer>
            </div>
        </body>
    </text>
