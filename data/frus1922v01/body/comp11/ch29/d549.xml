            <div xml:id="d549">

                <pb facs="0880" n="760" xml:id="pg760"/>

                <note rend="inline" type="source">893.113/388: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Japan</hi> (<hi rendition="#italic">Warren</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Tokyo</hi></placeName>, <date calendar="gregorian"
                            when="1922-11-13T13:00:00+09:00"><hi rendition="#italic">November 13,
                                1922—1 p.m.</hi></date><lb/>[Received November 13—2:46
                        a.m.]</dateline></opener>
                <p>195. Your 118, October 17, 6 p.m. The Japanese Government has no objection to
                    your proposal and request[s] American Government to communicate with other
                    governments.</p>
                <closer><signed><hi rendition="#small-caps">Warren</hi></signed></closer>
            </div>
        </body>
