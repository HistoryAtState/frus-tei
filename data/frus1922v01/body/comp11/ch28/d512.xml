                <pb facs="0857" n="737" sameAs="frus:frus1922v01/pg737"/>

                <note rend="inline" type="source">893.113/318: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Italy</hi> (<hi rendition="#italic">Child</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Rome</hi></placeName>, <date calendar="gregorian"
                            when="1922-07-24T13:00:00+01:00"><hi rendition="#italic">July 24, 1922—1
                                p.m.</hi></date><lb/>[Received July 24—12:40
                    p.m.]</dateline></opener>
                <p>121. Department’s 98, July 14, 7 [<hi rendition="#italic">4</hi>] p.m. After
                    repeated inquiries Foreign Office now professes inability to reply pending
                    resigned ministerial crisis.</p>
                <closer><signed><hi rendition="#small-caps">Child</hi></signed></closer>
            </div>
        </body>
    </text>
