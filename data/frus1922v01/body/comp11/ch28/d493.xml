                <pb facs="0845" n="725" sameAs="frus:frus1922v01/pg725"/>

                <note rend="inline" type="source">893.113/229</note>
                <head><hi rendition="#italic">The Ambassador in Italy</hi> (<hi rendition="#italic"
                        >Child</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Rome</hi></placeName>, <date calendar="gregorian" when="1922-01-30"
                                ><hi rendition="#italic">January 30, 1922</hi></date>.<lb/>[Received
                        February 20.]</dateline>
                    <seg rendition="#float-left">No. 192</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to the Department’s cable
                    instruction, No. 203 of December 23, 6 p.m.,<anchor n="60" xml:id="d493-f1"/> I
                    have the honor to transmit herewith a translation of <hi rendition="#italic"
                        >Note Verbale</hi> No. 4540/23 of the 24th instant from the Royal Ministry
                    of Foreign Affairs, in reply to my protest against the delivery of the arms in
                    question to the Military Governor of Pechili [<hi rendition="#italic"
                        >Chihli</hi>] Province.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Richard Washburn
                    Child</hi></signed></closer>


                <xi:include href="d493-a1.xml" xpointer="d493-a1"/>
            </div>
        </body>
    </text>
