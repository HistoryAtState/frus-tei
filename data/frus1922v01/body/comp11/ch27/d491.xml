            <div xml:id="d491">

                <pb facs="0845" n="725" xml:id="pg725"/>

                <note rend="inline" type="source">893.00/4493: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Minister in
                        China</hi> (<hi rendition="#italic">Schurman</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1922-06-26T15:00:00-04:00"><hi rendition="#italic">June 26, 1922—3
                                p.m.</hi></date></dateline></opener>
                <p>156. Your 285, June 25, 6 p.m.</p>
                <p>Department is unwilling that Consul at Canton should participate in any plan of
                    mediation. Your views in this regard have the Department’s unqualified
                    approval.</p>
                <closer><signed><hi rendition="#small-caps">Phillips</hi></signed></closer>
            </div>
        </body>
    </text>
