    <text>
        <body>
            <div xml:id="d795">

                <pb facs="1087" n="967" sameAs="frus:frus1922v01/pg967"/>

                <note rend="inline" type="source">793.94/1351</note>
                <head><hi rendition="#italic">The Ambassador in Japan</hi> (<hi rendition="#italic"
                        >Warren</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Tokyo</hi></placeName>, <date calendar="gregorian"
                            when="1922-05-08"><hi rendition="#italic">May 8,
                        1922</hi></date>.<lb/>[Received June 1.]</dateline>
                    <seg rendition="#float-left">No. 207</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to my despatch No. 197,
                    dated April 27, 1922,<anchor n="38" xml:id="d795-f1"/> I have the honor to
                    transmit herewith a copy of a statement handed to me to-day by the Foreign
                    Office announcing the completion of the withdrawal of Japanese troops from the
                    Shantung Railway Zone.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Charles B. Warren</hi></signed></closer>


                <xi:include href="d795-a1.xml" xpointer="d795-a1"/>
            </div>
        </body>
    </text>
