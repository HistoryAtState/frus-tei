    <text>
        <body>
            <div xml:id="d796">

                <pb facs="1087" n="967" sameAs="frus:frus1922v01/pg967"/>

                <note rend="inline" type="source">793.94/1404</note>
                <head><hi rendition="#italic">The Chargé in Japan</hi> (<hi rendition="#italic"
                        >Wilson</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Tokyo</hi></placeName>, <date calendar="gregorian"
                            when="1922-12-04"><hi rendition="#italic">December 4,
                        1922</hi></date>.<lb/>[Received December 28.]</dateline>
                    <seg rendition="#float-left">No. 430</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Supplementing my telegram No. 215 of
                    December 4, noon,<anchor n="38" xml:id="d796-f1"/> I have the honor to transmit
                    herewith a copy of the Foreign Office’s <pb facs="1088" n="968" xml:id="pg968"/>
                    statement of December 2, 1922, regarding the agreement covering the details of
                    the retrocession of the Leased Territory of Kiaochow to China.</p>
                <p>A copy of this document has been sent to the Legation at Peking.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Hugh R. Wilson</hi></signed></closer>


                <xi:include href="d796-a1.xml" xpointer="d796-a1"/>
            </div>
        </body>
    </text>
