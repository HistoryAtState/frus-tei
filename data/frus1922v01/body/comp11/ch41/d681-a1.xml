    <text>
        <body>
            <div xml:id="d681-a1">

                <pb facs="0996" n="876" xml:id="pg876"/>

                <opener><seg rendition="#center">[Enclosure—Translation]</seg></opener>
                <head><hi rendition="#italic">The Soviet Delegate in China</hi> (<hi
                        rendition="#italic">Paikes</hi>) <hi rendition="#italic">to the American
                        Minister in China</hi> (<hi rendition="#italic">Schurman</hi>)</head>
                <opener><dateline rendition="#float-right"><date calendar="gregorian"
                            when="1921-12-21"><hi rendition="#italic">December 21,
                        1921</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 173</seg></opener>
                <p><hi rendition="#small-caps">Mr. Minister</hi>: I have the honor, in accordance
                    with instructions received from my Government, to transmit to Your Excellency
                    the note attached concerning the question of the Chinese Eastern Railway, by
                    which the solution of this question is placed under the exclusive jurisdiction
                    of China and Russia.</p>
                <closer><signed><hi rendition="#small-caps">A. Paikes</hi></signed></closer>
            </div>
        </body>
    </text>
