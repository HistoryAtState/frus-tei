    <text>
        <body>
            <div xml:id="d750">

                <pb facs="1037" n="917" sameAs="frus:frus1922v01/pg917"/>

                <note rend="inline" type="source">861 A.01/364: Telegram</note>
                <head><hi rendition="#italic">The President of the Technical Board</hi> (<hi
                        rendition="#italic">Stevens</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Harbin</hi></placeName>, <date calendar="gregorian"
                            when="1922-10-01T13:00:00+08:26"><hi rendition="#italic">October 1,
                                1922—1 p.m.</hi></date><lb/>[Received October 1—11:04
                        a.m.]</dateline></opener>
                <p>Your Sept. 29, 6 p.m.<anchor n="93" xml:id="d750-f1"/> Japanese Army completed
                    evacuation Chinese Eastern zone September 26th excepting about eight of a
                    military mission.</p>
                <closer><signed><hi rendition="#small-caps">Stevens</hi></signed></closer>
            </div>
        </body>
    </text>
