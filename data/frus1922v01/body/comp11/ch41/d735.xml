                <pb facs="1031" n="911" sameAs="frus:frus1922v01/pg911"/>

                <note rend="inline" type="source">861.77/2641: Telegram</note>
                <head><hi rendition="#italic">The Consul at Harbin</hi> (<hi
                            rendition="#italic">Hanson</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Harbin</hi></placeName>, <date calendar="gregorian"
                            when="1922-08-16T11:00:00+08:26"><hi rendition="#italic">August 16,
                                1922—11 a.m.</hi></date><lb/>[Received August 17—4:30
                        a.m.]</dateline></opener>
                <p>Recent mutiny Chinese troops Pokotu reported by Stevens and hold up of train by
                    Russian brigands ample proof Chinese soldiers unable guard adequately Chinese
                    Eastern Railway.</p>
                <closer><signed><hi rendition="#small-caps">Hanson</hi></signed></closer>
            </div>
        </body>
    </text>
