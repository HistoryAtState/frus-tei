                <pb facs="1021" n="901" sameAs="frus:frus1922v01/pg901"/>

                <note rend="inline" type="source">861.77/2594: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >Schurman</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1922-07-01T13:00:00+08:00"><hi rendition="#italic">July 1, 1922—1
                                p.m.</hi></date><lb/>[Received July 1—4:36 a.m.]</dateline></opener>
                <p>291. Press carries today announcement by Board of Directors, Chinese Eastern
                    Railway, of issue July 1st 5-year 10 percent bonds value 3,000,000 roubles.
                    Stevens and Tokyo informed.</p>
                <closer><signed><hi rendition="#small-caps">Schurman</hi></signed></closer>
            </div>
        </body>
