            <div xml:id="d681">

                <pb facs="0995" n="875" sameAs="frus:frus1922v01/pg875"/>

                <note rend="inline" type="source">861.77/2397</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">Schurman</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1921-12-27"><hi rendition="#italic">December 27,
                        1921</hi></date>.<lb/>[Received January 27, 1922.]</dateline>
                    <seg rendition="#float-left">No. 281</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to refer to my telegram
                    No. 458, of December 22, 1921, 4 p.m.,<anchor n="48" xml:id="d681-f1"/> relative
                    to a protest addressed to me by Mr. Paikes on the Chinese Eastern Railway, and
                    to forward herewith the text of his letter with enclosure.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Jacob Gould
                    Schurman</hi></signed></closer>




                <xi:include href="d681-a1.xml" xpointer="d681-a1"/>
                <xi:include href="d681-a2.xml" xpointer="d681-a2"/>
