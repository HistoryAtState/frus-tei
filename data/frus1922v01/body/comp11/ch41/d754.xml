                <pb facs="1039" n="919" sameAs="frus:frus1922v01/pg919"/>

                <note rend="inline" type="source">861.77/2769: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic">Herrick</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1922-10-13T17:00:00+00:00"><hi rendition="#italic">October 13,
                                1922—5 p.m.</hi></date><lb/>[Received October 13—1:58
                        p.m.]</dateline></opener>
                <p>398. Note just received from Foreign Office, dated October 11th gives formal
                    adherence of French Government to your proposals regarding Chinese Eastern
                    Railway.</p>
                <closer><signed><hi rendition="#small-caps">Herrick</hi></signed></closer>
            </div>
        </body>
    </text>
