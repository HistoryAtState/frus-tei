    <text>
        <body>
            <div xml:id="d759">

                <pb facs="1043" n="923" xml:id="pg923"/>

                <note rend="inline" type="source">861.77/2780: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Italy</hi> (<hi rendition="#italic">Child</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Rome</hi></placeName>, <date calendar="gregorian"
                            when="1922-10-24T22:00:00+01:00"><hi rendition="#italic">October 24,
                                1922—10 p.m.</hi></date><lb/>[Received October 25—4:32
                        a.m.]</dateline></opener>
                <p>203. Department’s 119, August 11, 6 p.m.;<anchor n="4" xml:id="d759-f1"/> 128,
                    August 28, 3 p.m.;<anchor n="5" xml:id="d759-f2"/> and 147, October 13, 7
                        p.m.<anchor n="6" xml:id="d759-f3"/> Ministry of Foreign Affairs states that
                    the Italian Government adheres to the proposals contained in the memorandum of
                    the first instance (Department’s 119, August 11, 6 p.m.) for the cessation of
                    the Inter-Allied Committee and of the technical office instituted by the
                    Inter-Allied railway agreement of January, 1919, and to the common action
                    between the Powers interested in regard to the control and operation of the
                    Oriental Trans-Siberian Railway.</p>
                <closer><signed><hi rendition="#small-caps">Child</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d759-f1" n="4" xml:id="d759-f1-content">
