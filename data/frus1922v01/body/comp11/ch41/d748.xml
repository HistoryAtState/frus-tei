    <text>
        <body>
            <div xml:id="d748">

                <pb facs="1036" n="916" xml:id="pg916"/>

                <note rend="inline" type="source">861.77/2693: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Harvey</hi>) <hi
                        rendition="#italic">to the Acting Secretary of
                            State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1922-09-11T18:00:00+01:00"><hi rendition="#italic">September 11,
                                1922—6 p.m.</hi></date><lb/>[Received September 11—1:55
                        p.m.]</dateline></opener>
                <p>398. Your number 264, of August 28, 3 p.m. via Paris.<anchor n="91"
                        xml:id="d748-f1"/> British Government concurs in the suggestion of the
                    Japanese Government.</p>
                <closer><signed><hi rendition="#small-caps">Harvey</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d748-f1" n="91" xml:id="d748-f1-content">
                <p>Not printed; see telegram no. 95, Aug. 28, to the Ambassador in Japan, <ref
                        target="#pg913">p. 913</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
