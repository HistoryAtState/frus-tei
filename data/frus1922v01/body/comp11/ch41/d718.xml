                <pb facs="1021" n="901" sameAs="frus:frus1922v01/pg901"/>

                <note rend="inline" type="source">861.77/2596a: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Minister in China</hi>
                        (<hi rendition="#italic">Schurman</hi>)</head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1922-07-01T14:00:00-04:00"><hi rendition="#italic">July 1, 1922—2
                                p.m.</hi></date></dateline></opener>
                <p>163. Please report regarding any negotiations between Chinese Government and
                    Moscow or Chita representatives as to Chinese Eastern Railway, with special
                    reference to status of the Inter-Allied Technical Board.</p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
