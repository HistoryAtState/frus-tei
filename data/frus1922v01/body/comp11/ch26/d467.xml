                <pb facs="0831" n="711" sameAs="frus:frus1922v01/pg711"/>

                <note rend="inline" type="source">893.00/4412: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">Schurman</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1922-06-02T16:00:00+08:00"><hi rendition="#italic">June 2, 1922—4
                                p.m.</hi></date><lb/>[Received June 2—10:35
                    a.m.]</dateline></opener>
                <p>243. My 241, May 31, 9 p.m.<anchor n="46" xml:id="d467-f1"/> President Hsu
                    resigned this morning and left Peking at half past 3 o’clock this afternoon for
                    Tientsin.</p>
                <closer><signed><hi rendition="#small-caps">Schurman</hi></signed></closer>
            </div>
        </body>
    </text>
