    <text>
        <body>
            <div xml:id="d657">

                <pb facs="0978" n="858" xml:id="pg858"/>

                <note rend="inline" type="source">893.74/255: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >Schurman</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1922-12-04T17:00:00+08:00"><hi rendition="#italic">December 4,
                                1922—5 p.m.</hi></date><lb/>[Received December 4—4:10
                        p.m.]</dateline></opener>
                <p>475. Department’s 279 November 29, 5 p.m. Protest filed with Minister for Foreign
                    Affairs and Minister of Communications on basis of monopolistic clause in
                    supplementary letter to Mitsui wireless contract.<anchor n="21" xml:id="d657-f1"
                    /></p>
                <closer><signed><hi rendition="#small-caps">Schurman</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d657-f1" n="21" xml:id="d657-f1-content">
                <p>See telegram no. 92, Feb. 18, 1821, from the Minister in China, <ref
                        target="frus1921v01#pg_416"><hi rendition="#italic">Foreign Relations</hi>,
                        1921, vol. <hi rendition="#small-caps">i</hi>, p. 416</ref>.</p>
