    <text>
        <body>
            <div xml:id="d658">

                <pb facs="0978" n="858" sameAs="frus:frus1922v01/pg858"/>

                <note rend="inline" type="source">793.94/1395: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">Schurman</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1922-12-06T12:00:00+08:00"><hi rendition="#italic">December 6,
                                1922—noon</hi></date>.<lb/>[Received 12:50 p.m.]</dateline></opener>
                <p>479. Department’s 283, December 4, 1 [<hi rendition="#italic">7</hi>] p.m.<anchor
                        n="22" xml:id="d658-f1"/> Article 12 of agreement<anchor n="23"
                        xml:id="d658-f2"/> reads in translation as follows: <quote rend="blockquote">
                        <p>“The Government of China declares that upon expiration of the telegraph
                            and cable monopoly granted to the foreign concerns it will discontinue
                            the monopoly upon its own initiative and will not further grant any
                            monopoly for the electrical transmission of messages to any government,
                            company or individual.”</p>
                    </quote></p>
                <closer><signed><hi rendition="#small-caps">Schurman</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d658-f1" n="22" xml:id="d658-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d658-f2" n="23" xml:id="d658-f2-content">
                <p>Agreement between China and Japan on detailed arrangements for the settlement of
                    outstanding questions relative to Shantung, signed at Peking Dec. 1, 1922.</p>
            </note>
        </listAnnotation>
    </standOff>
