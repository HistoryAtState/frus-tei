    <text>
        <body>
            <div xml:id="d380-a2">

                <pb facs="0765" n="645" sameAs="frus:frus1922v01/pg645"/>

                <opener><dateline rendition="#float-right"><date calendar="gregorian"
                            when="1921-05-06"><hi rendition="#italic">May 6, 1921</hi> [<hi
                                rendition="#italic">1922</hi>]</date>.</dateline></opener>
                <p>The above proposition is hereby accepted with the understanding that the failure
                    of Congress to ratify this contract on or before May 12th as above provided
                    shall not create any liability on the part of the Republic.</p>
                <closer><hi rendition="#small-caps">Republic of Bolivia</hi><lb/><signed><hi
                            rendition="#small-caps">Ramón Rivero</hi></signed><lb/><hi
                        rendition="#italic">Financial Agent</hi><lb/><signed><hi
                            rendition="#small-caps">C. Gumucio</hi></signed><lb/><hi
                        rendition="#italic">Consul General</hi></closer>
                <postscript>
                    <p>Approved—<lb/><hi rendition="#small-caps">E. H. Bernheim</hi><lb/><hi
                            rendition="#small-caps">Samuel Abbot Maginnis</hi></p>
                </postscript>
            </div>
