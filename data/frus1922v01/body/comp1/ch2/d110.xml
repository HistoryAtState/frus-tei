    <text>
        <body>
            <div xml:id="d110">

                <pb facs="0514" n="394" sameAs="frus:frus1922v01/pg394"/>

                <note rend="inline" type="source">550 E 1/98</note>
                <head><hi rendition="#italic">The Italian Ambassador</hi> (<hi
                            rendition="#italic">Ricci</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <p>The Italian Ambassador presents his compliments to His Excellency the Secretary
                    of State and, by order of his Government, has the honor to inform him that,
                    according to an agreement passed between the Allied Governments, the date of the
                    opening of the International Conference in Genoa has been settled for the tenth
                    of April 1922.</p>
                <closer>
                    <dateline rendition="#float-left">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1922-03-13"><hi
                                rendition="#italic">March 13, 1922</hi></date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
