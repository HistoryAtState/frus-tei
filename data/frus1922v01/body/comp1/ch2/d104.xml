                <pb facs="0509" n="389" sameAs="frus:frus1922v01/pg389"/>

                <note rend="inline" type="source">550 E 1/14</note>
                <head><hi rendition="#italic">The Italian Ambassador</hi> (<hi
                            rendition="#italic">Ricci</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><seg rendition="#center">[Translation]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1922-01-23"><hi rendition="#italic">January 23,
                        1922</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: By order of my Government I have the
                    honor to advise Your Excellency that the Italian Government has been informed by
                    the Russian Government that the Pan-Russian Executive Committee has been called
                    to meet on January 27 and elect the Russian Delegation to the Genoa Conference
                    vesting it with extraordinary full powers.</p>
                <p>The Russian Government has asked the Italian Government to bring the foregoing to
                    the knowledge of the Government of the United States of America.</p>
                <p>Be pleased to accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps">V. Rolandi Ricci</hi></signed></closer>
            </div>
        </body>
    </text>
