    <text>
        <body>
            <div xml:id="d205">

                <pb facs="0581" n="461" sameAs="frus:frus1922v01/pg461"/>

                <note rend="inline" type="source">723.2515/871</note>
                <head><hi rendition="#italic">The Ambassador in Chile</hi> (<hi rendition="#italic">Collier</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Santiago</hi></placeName>, <date calendar="gregorian"
                            when="1922-01-31"><hi rendition="#italic">January 31,
                        1922</hi></date>.<lb/>[Received March 8, 1922.]</dateline>
                    <seg rendition="#float-left">No. 75</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In conformity with the instructions of the
                    Department, I have the honor to transmit herewith a copy and translation of a
                    confidential Note from the Chilean Minister for Foreign Affairs on the subject
                    of the unfulfilled provisions of the Treaty of Ancon, which was furnished to me
                    on the 19th[?], instant, in substitution for another communication, a free
                    translation of which was transmitted to the Department by telegraph on that
                        date.<anchor n="3" xml:id="d205-f1"/></p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Wm. Miller
                    Collier</hi></signed></closer>


                <xi:include href="d205-a1.xml" xpointer="d205-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d205-f1" n="3" xml:id="d205-f1-content">
                <p>See the Ambassador’s telegram no. 8, Jan. 19, 1922, 10 p.m., <ref target="#pg451"
                        >p. 451</ref>.</p>
            </note>
        </listAnnotation>
