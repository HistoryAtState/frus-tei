            <div xml:id="d21">

                <pb facs="0161" n="41" sameAs="frus:frus1922v01/pg41"/>

                <note rend="inline" type="source">500.A4a/59b</note>
                <head><hi rendition="#italic">The Secretary of State to
                        Mr. Balfour, of the British
                    Delegation</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1922-01-03"><hi rendition="#italic">January 3,
                        1922</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Balfour</hi>: I enclose a copy of the
                    draft of the proposed identic note left with me by Mr. van Karnebeek.</p>
                <p>Sincerely yours,</p>
                <closer><signed><hi rendition="#small-caps">Charles E. Hughes</hi></signed></closer>


                <xi:include href="d21-a1.xml" xpointer="d21-a1"/>
