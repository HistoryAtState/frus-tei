    <text>
        <body>
            <div xml:id="d43-a1">

                <pb facs="0192" n="72" sameAs="frus:frus1922v01/pg72"/>

                <opener><seg rendition="#center">[Annex]</seg></opener>
                <head><hi rendition="#italic">Comparison of Naval Strength</hi></head>
                <table cols="6" rend="bordered" rows="6">
                    <row>
                        <cell cols="2" rows="2"/>
                        <cell cols="2">United States</cell>
                        <cell cols="2">Japan</cell>
                    </row>
                    <row>
                        <cell>Japanese classification</cell>
                        <cell>American classification</cell>
                        <cell>Japanese classification</cell>
                        <cell>American classification</cell>
                    </row>
                    <row>
                        <cell>1</cell>
                        <cell>Pre-dreadnaughts Dreadnaughts Super-dreadnaughts</cell>
                        <cell>33 ships<lb/>728,390 tons<lb/>100%</cell>
                        <cell>39 ships<lb/>797,135 t.<lb/>100%</cell>
                        <cell>25 ships<lb/>550,250 t.<lb/>76%</cell>
                        <cell>25 ships<lb/>549,196 tons<lb/>*69%</cell>
                    </row>
                    <row>
                        <cell>2</cell>
                        <cell>Dreadnaughts Super-dreadnaughts</cell>
                        <cell>20 ships<lb/>532,650 tons<lb/>100%</cell>
                        <cell>18 ships<lb/>500,650 t.<lb/>100%</cell>
                        <cell>13 ships<lb/>375,020 t.<lb/>70%</cell>
                        <cell>11 ships<lb/>334,700 tons<lb/>67%</cell>
                    </row>
                    <row>
                        <cell>3</cell>
                        <cell>Super-dreadnaughts</cell>
                        <cell cols="2">12 ships<lb/>365,000 tons<lb/>100%</cell>
                        <cell cols="2">10 ships<lb/>313,300 tons<lb/>86%</cell>
                    </row>
                    <row>
                        <cell cols="2"><hi rendition="#small-caps">Remarks</hi></cell>
                        <cell cols="4">If battleships of over 20 years are eliminated in accordance
                            with original Hughes proposal, the Japanese percentage in (1)* will be
                            68%.</cell>
                    </row>
                </table>
            </div>
        </body>
    </text>
