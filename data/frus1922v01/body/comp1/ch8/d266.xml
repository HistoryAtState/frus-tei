                <pb facs="0646" n="526" sameAs="frus:frus1922v01/pg526"/>

                <note rend="inline" type="source">835.73/132a supp.: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Ambassador in
                        Argentina</hi> (<hi rendition="#italic">Riddle</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1922-03-13T17:00:00-05:00"><hi rendition="#italic">March 13,
                                1922—5 p.m.</hi></date></dateline></opener>
                <p>6. Referring Department’s telegram No. 3, February 4, 7 p.m.</p>
                <p>Please telegraph for information of Western Union present status of the
                    matter.</p>
                <p>Repeat to Montevideo as Department’s No. 5.</p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
