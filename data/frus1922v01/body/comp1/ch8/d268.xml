    <text>
        <body>
            <div xml:id="d268">

                <pb facs="0646" n="526" sameAs="frus:frus1922v01/pg526"/>

                <note rend="inline" type="source">833.73/45: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Uruguay</hi> (<hi
                            rendition="#italic">Armour</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Montevideo</hi></placeName>, <date calendar="gregorian"
                            when="1922-03-14T16:00:00-04:00"><hi rendition="#italic">March 14,
                                1922—4 p.m.</hi></date><lb/>[Received 8:05 p.m.]</dateline></opener>
                <p>18. Referring to the Department’s number 5.<anchor n="48" xml:id="d268-f1"/> No
                    reply received from the Uruguayan Government [relative to] the representations
                    of Western representative.</p>
                <closer><signed><hi rendition="#small-caps">Armour</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d268-f1" n="48" xml:id="d268-f1-content">
                <p>See last paragraph of telegram no. 6, Mar. 13, to the Ambassador in Argentina,
                    printed <hi rendition="#italic">supra.</hi></p>
            </note>
