                <pb facs="0655" n="535" sameAs="frus:frus1922v01/pg535"/>

                <note rend="inline" type="source">835.73/154: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Ambassador in Argentina</hi> (<hi rendition="#italic">Riddle</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1922-08-07T16:00:00-04:00"><hi rendition="#italic">August 7,
                                1922—4 p.m.</hi></date></dateline></opener>
                <p>34. Your 50, August 4, noon.<anchor n="65" xml:id="d278-f1"/></p>
                <p>Please make frequent inquiries of Argentine Government, impressing on authorities
                    extreme urgency and importance [of] matter. Keep Department promptly
                    informed.</p>
                <closer><signed><hi rendition="#small-caps">Harrison</hi></signed></closer>
            </div>
        </body>
    </text>
