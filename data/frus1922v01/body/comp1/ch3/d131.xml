    <text>
        <body>
            <div xml:id="d131">

                <pb facs="0526" n="406" xml:id="pg406"/>

                <note rend="inline" type="source">800.51 W 89 Italy/9: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Italy</hi> (<hi rendition="#italic">Child</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Rome</hi></placeName>, <date calendar="gregorian"
                            when="1922-07-27T13:00:00+01:00"><hi rendition="#italic">July 27, 1922—1
                                p.m.</hi></date><lb/>[Received 4:41 p.m.]</dateline></opener>
                <p>126. Department’s 85, June 20, 5 p.m.<anchor n="28" xml:id="d131-f1"/> Foreign
                    Office accepts proposal to send delegation to discuss war debts and requests
                    Embassy to communicate most opportune time for arrival of delegates at
                    Washington.</p>
                <closer><signed><hi rendition="#small-caps">Child</hi></signed></closer>
            </div>
        </body>
    </text>
