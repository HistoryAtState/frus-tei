    <text>
        <body>
            <div xml:id="d125">

                <pb facs="0522" n="402" sameAs="frus:frus1922v01/pg402"/>

                <note rend="inline" type="source">800.51 W 89 Hungary/5: Telegram</note>
                <head><hi rendition="#italic">The Minister in Hungary</hi> (<hi rendition="#italic">Brentano</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Budapest</hi></placeName>, <date calendar="gregorian"
                            when="1922-07-01T09:00:00+01:00"><hi rendition="#italic">July 1, 1922—9
                                a.m.</hi></date><lb/>[Received July 2—3:51 a.m.]</dateline></opener>
                <p>40. Your circular telegram dated April 21, noon. Hungarian Minister Foreign
                    Affairs states Hungary will be represented on <pb facs="0523" n="403"
                        xml:id="pg403"/> World War Foreign Debt Commission. Széchényi<anchor n="25"
                        xml:id="d125-f1"/> representative, Pelényi<anchor n="26" xml:id="d125-f2"/>
                    deputy.</p>
                <closer><signed><hi rendition="#small-caps">Brentano</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d125-f1" n="25" xml:id="d125-f1-content">
                <p>Count László Széchényi, Hungarian Minister to the United States.</p>
            </note>
            <note corresp="#d125-f2" n="26" xml:id="d125-f2-content">
                <p>John Pelényi, Hungarian Counselor of Legation at Washington.</p>
            </note>
        </listAnnotation>
