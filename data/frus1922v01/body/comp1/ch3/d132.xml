    <text>
        <body>
            <div xml:id="d132">

                <pb facs="0526" n="406" sameAs="frus:frus1922v01/pg406"/>

                <note rend="inline" type="source">800.51 W 89 Great Britain/28</note>
                <head><hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Harvey</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1922-08-04"><hi rendition="#italic">August 4,
                        1922</hi></date>.<lb/>[Received August 14.]</dateline>
                    <seg rendition="#float-left">No. 1550</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Supplementary to my telegram No. 336 of
                    August 4, 1 p.m.,<anchor n="28" xml:id="d132-f1"/> I have the honor to forward
                    to you herewith the authentic text of the Balfour Note.</p>
                <p>I have [etc.]</p>
                <closer>For the Ambassador:<lb/><signed><hi rendition="#small-caps">Post
                            Wheeler</hi></signed><lb/><hi rendition="#italic">Counselor of
                        Embassy</hi></closer>


                <xi:include href="d132-a1.xml" xpointer="d132-a1"/>
            </div>
        </body>
    </text>
