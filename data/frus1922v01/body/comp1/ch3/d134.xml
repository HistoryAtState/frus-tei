    <text>
        <body>
            <div xml:id="d134">

                <pb facs="0531" n="411" xml:id="pg411"/>

                <note rend="inline" type="source">800.51 W 89 Italy/9: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Ambassador in Italy</hi>
                        (<hi rendition="#italic">Child</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1922-08-04T17:00:00-04:00"><hi rendition="#italic">August 4,
                                1922—5 p.m.</hi></date></dateline></opener>
                <p>117. Your 126, July 27, 1 p.m.</p>
                <p>Please inform Foreign Office that the most opportune time for arrival Italian
                    delegates at Washington would be about the middle of October, 1922.<anchor
                        n="31" xml:id="d134-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d134-f1" n="31" xml:id="d134-f1-content">
                <p>The Italian Government did not open negotiations with the World War Foreign Debt
                    Commission until 1925; see <hi rendition="#italic">Combined Annual Reports of
                        the World War Foreign Debt Commission</hi>, 1922–1926 (Washington,
                    Government Printing Office, 1927), pp. 14, 27, 48–50.</p>
            </note>
        </listAnnotation>
    </standOff>
