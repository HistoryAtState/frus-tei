                <pb facs="0524" n="404" sameAs="frus:frus1922v01/pg404"/>

                <note rend="inline" type="source">800.51 W 89 Great Britain/6: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Harvey</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1922-07-17T11:00:00+01:00"><hi rendition="#italic">July 17,
                                1922—11 a.m.</hi></date><lb/>[Received July 17—7:20
                    a.m.]</dateline></opener>
                <p>295. The Embassy is officially informed by the Foreign Office that a special
                    delegation will proceed to the United States early in September to negotiate
                    terms for the funding of the British debt to the United States.</p>
                <closer><signed><hi rendition="#small-caps">Harvey</hi></signed></closer>
            </div>
        </body>
