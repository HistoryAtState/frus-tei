    <text>
        <body>
            <div xml:id="d169">

                <pb facs="0553" n="433" sameAs="frus:frus1922v01/pg433"/>

                <note rend="inline" type="source">813.00 Washington/76a: Circular telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Diplomatic Representatives in Costa Rica, Guatemala,
                            Honduras, Nicaragua, and Salvador</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1922-11-22T17:00:00-05:00"><hi rendition="#italic">November 22,
                                1922—5 p.m.</hi></date></dateline></opener>
                <p>Please inform the government to which you are accredited that, as it appears to
                    be the opinion of the governments of Central America that the Government of the
                    United States can most helpfully participate in the Conference on Central
                    American Affairs by the appointment of official delegates, this Government will
                    take pleasure in being so represented by the Secretary of State and Mr. Sumner
                        Welles.<anchor n="66" xml:id="d169-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
                <postscript>
                    <p>[For the proceedings of the Conference, see <hi rendition="#italic"
                            >Conference on Central American Affairs, Washington, December 4,
                            1922–February 7, 1923</hi> (Washington, Government Printing Office,
                        1923).]</p>
                </postscript>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d169-f1" n="66" xml:id="d169-f1-content">
                <p>Commissioner to the Dominican Republic.</p>
