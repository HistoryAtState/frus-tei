            <div xml:id="d877">

                <pb facs="1172" n="1052" sameAs="frus:frus1922v01/pg1052"/>

                <note rend="inline" type="source">837.00/2178a: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Representative on
                        Special Mission in Cuba</hi> (<hi rendition="#italic">Crowder</hi>)</head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1921-12-09T18:00:00-05:00"><hi rendition="#italic">December 9,
                                1921—6 p.m.</hi></date></dateline></opener>
                <p>185. The Government of Cuba has expressed desire that the Marines should be
                    withdrawn from the Province of Camaguey. Please cable whether in your opinion
                    their presence there is still necessary.</p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
