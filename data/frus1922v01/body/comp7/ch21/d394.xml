    <text>
        <body>
            <div xml:id="d394">

                <pb facs="0777" n="657" sameAs="frus:frus1922v01/pg657"/>

                <note rend="inline" type="source">832.607B/36: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Ambassador in Brazil</hi> (<hi rendition="#italic"
                            >Morgan</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1921-11-02T18:00:00-05:00"><hi rendition="#italic">November 2,
                                1921—6 p.m.</hi></date></dateline></opener>
                <p>46. Department’s 45, October 27, 6 p.m.<anchor n="12" xml:id="d394-f1"/></p>
                <p>President today signed joint resolution of Congress accepting the invitation of
                    the Republic of Brazil to take part in international exposition to be held in
                    Rio de Janeiro in 1922.<anchor n="13" xml:id="d394-f2"/> Inform Government.</p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
