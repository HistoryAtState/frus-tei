    <text>
        <body>
            <div xml:id="d402">

                <pb facs="0781" n="661" sameAs="frus:frus1922v01/pg661"/>

                <note rend="inline" type="source">033.1120 H 87/11: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Brazil</hi> (<hi rendition="#italic">Morgan</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Rio de Janeiro</hi></placeName>, <date calendar="gregorian"
                            when="1922-08-12T12:00:00-03:00"><hi rendition="#italic">August 12,
                                1922—noon</hi></date>.<lb/>[Received 4:14 p.m.]</dateline></opener>
                <p>89. Please instruct as to whether Mexican and Greek Special Ambassadors and
                    resident diplomats shall be invited to entertainments given by the Secretary
                    while here.<anchor n="24" xml:id="d402-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Morgan</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d402-f1" n="24" xml:id="d402-f1-content">
                <p>For papers relating to the question of the recognition of the Mexican Government,
                    see <ref target="frus1922v02#pg_639">vol. <hi rendition="#small-caps">ii</hi>,
                        pp. 639</ref> ff.; of the Greek Government, <ref target="frus1922v02#pg_409"
                            ><hi rendition="#italic">ibid.</hi>, pp. 409</ref> ff.</p>
            </note>
        </listAnnotation>
    </standOff>
