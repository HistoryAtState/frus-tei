                <pb facs="1096" n="976" sameAs="frus:frus1922v01/pg976"/>

                <note rend="inline" type="source">711.21/698: Telegram</note>
                <head><hi rendition="#italic">The Colombian Minister of Foreign Affairs</hi> (<hi
                        rendition="#italic">Uribe</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener><seg rendition="#center">[Translation]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Bogota</hi></placeName>, <date calendar="gregorian"
                            when="1922-03-01"><hi rendition="#italic">March 1,
                        1922</hi></date>.<lb/>[Received March 3.]</dateline></opener>
                <p>I have the honor to inform Your Excellency that on this day the exchange of
                    ratifications of the Treaty of April 6, 1914, between Colombia and the United
                    States of America was effected. The relations of cordial friendship which so
                    long existed between the two nations are thus restored.</p>
                <closer><signed><hi rendition="#small-caps">Antonio José
                    Uribe</hi></signed></closer>
            </div>
        </body>
