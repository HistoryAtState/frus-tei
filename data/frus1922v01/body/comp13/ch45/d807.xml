    <text>
        <body>
            <div xml:id="d807">

                <pb facs="1104" n="984" xml:id="pg984"/>

                <note rend="inline" type="source">211.18/15</note>
                <head><hi rendition="#italic">The Chargé in Costa Rica</hi> (<hi rendition="#italic">Thurston</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >San José</hi></placeName>, <date calendar="gregorian"
                            when="1921-10-29"><hi rendition="#italic">October 29,
                        1921</hi></date>.<lb/>[Received November 16.]</dateline>
                    <seg rendition="#float-left">No. 231</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Complementing my despatch number 230 of
                    October 27, I have the honor to inform the Department that I have received a
                    note from the Minister for Foreign Affairs withdrawing his proposed amendment of
                    the Treaty of Extradition regarding the death penalty, and requesting that his
                    other proposed alterations of text be submitted to the Department.</p>
                <p>A copy and translation of the note from the Minister for Foreign Affairs are
                    attached hereto.<anchor n="8" xml:id="d807-f1"/></p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Walter C.
                    Thurston</hi></signed></closer>
            </div>
        </body>
    </text>
