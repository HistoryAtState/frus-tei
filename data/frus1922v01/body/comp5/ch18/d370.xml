    <text>
        <body>
            <div xml:id="d370">

                <pb facs="0743" n="623" sameAs="frus:frus1922v01/pg623"/>

                <note rend="inline" type="source">862S.01/7</note>
                <head><hi rendition="#italic">The Chargé in Belgium</hi> (<hi rendition="#italic"
                        >Wadsworth</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Brussels</hi></placeName>, <date calendar="gregorian"
                            when="1922-02-15"><hi rendition="#italic">February 15,
                        1922</hi></date>.<lb/>[Received March 4.]</dateline>
                    <seg rendition="#float-left">No. 1442</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to the Department’s telegram No.
                    39, September 7th, 5 p.m., relative to the Memorandum on “A” and “B” mandates,
                    instructing the Embassy to transmit the text of the Memorandum to the Minister
                    of Foreign Affairs, I have the honor to inform the Department that I am advised
                    by the Minister of Foreign Affairs that the Belgian government entirely shares
                    the views of the French government with regard to the Mandates as expressed in a
                    note handed on December 22, 1921, to the American Ambassador in Paris by the
                    French government,<anchor n="3" xml:id="d370-f1"/> and in consequence submit the
                    proposals contained in a note from the Foreign Office, a copy of which I beg to
                    enclose herewith, together with a translation in triplicate and also triplicate
                    copies of the text of the Belgian draft of the Mandate on Ruanda and Urundi.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Craig W.
                    Wadsworth</hi></signed></closer>




                <xi:include href="d370-a1.xml" xpointer="d370-a1"/>
                <xi:include href="d370-a2.xml" xpointer="d370-a2"/>
