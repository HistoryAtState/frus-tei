    <text>
        <body>
            <div xml:id="d323">

                <pb facs="0461" n="449" sameAs="frus:frus1945v05/pg449"/>

                <note rend="inline" type="source">811.248/3–2845</note>
                <head>
                    <hi rendition="#italic">The American Chargé in Portugal</hi> (<hi rendition="#italic">Crocker</hi>) <hi
                        rendition="#italic">to the Portuguese Minister for Foreign Affairs</hi>
                        (<hi rendition="#italic">Salazar</hi>)<anchor
                        n="30" xml:id="d323-f1"/>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 971</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Lisbon</hi></placeName>, <date
                            calendar="gregorian" when="1945-03-27">March 27, 1945</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: The Governments of the United
                    States of America and of Portugal, having concluded an Agreement upon the terms
                    for the operation through Portuguese territory in Europe of the Air Transport
                    Command service, I have the honor, acting upon instructions from my Government,
                    to confirm that the enclosed document and annex thereto constitute the
                    above-mentioned Agreement which will take effect immediately upon this exchange
                    of notes between us.</p>
                <p>Please accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Edward S. Crocker</hi>
                    </signed>
                </closer>


                <xi:include href="d323-a1.xml" xpointer="d323-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d323-f1" n="30" type="source" xml:id="d323-f1-content">
                <p>Copy of note and annexes transmitted to the Department in despatch 1650, March
                    28, from Lisbon; received April 6.</p>
            </note>
        </listAnnotation>
    </standOff>
