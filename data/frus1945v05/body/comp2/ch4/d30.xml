    <text>
        <body>
            <div xml:id="d30">

                <pb facs="0050" n="38" sameAs="frus:frus1945v05/pg38"/>

                <note rend="inline" type="source">857.48/3–2245</note>
                <head>
                    <hi rendition="#italic">Mr. Harold H. Neff, Special Assistant to the Under
                        Secretary of War</hi> (<hi rendition="#italic">Patterson</hi>), <hi
                        rendition="#italic">to the Chief of the Division of Northern European
                        Affairs</hi> (<hi rendition="#italic">Gumming</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-03-22">22 March 1945</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Cumming</hi>: I am sending you attached the
                    statement which you requested from me in regard to SWNCC 24/4.<anchor n="25"
                        xml:id="d30-f1"/>
                </p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Harold</hi> H. <hi rendition="#small-caps"
                            >Neff</hi>
                    </signed>
                </closer>


                <xi:include href="d30-a1.xml" xpointer="d30-a1"/>
            </div>
        </body>
    </text>
