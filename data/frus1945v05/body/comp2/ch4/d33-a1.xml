    <text>
        <body>
            <div xml:id="d33-a1">

                <pb facs="0054" n="42" xml:id="pg42"/>

                <opener>
                    <seg rendition="#center">[Enclosure]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">President Roosevelt to
                        the Acting Secretary of War</hi> (<hi
                            rendition="#italic">Patterson</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1945-03-28">28 March 1945</date>.</dateline>
                </opener>
                <p>It is most important that the seed requested by the Norwegians to be shipped from
                    Sweden be sent them at once. Please let me know if this is being done.</p>
                <closer>
                    <signed>F[<hi rendition="#small-caps">ranklin</hi>] D. R[<hi
                            rendition="#small-caps">oosevelt</hi>]</signed>
                </closer>
            </div>
        </body>
    </text>
