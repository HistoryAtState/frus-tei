            <div xml:id="d911">

                <pb facs="1170" n="1158" sameAs="frus:frus1945v05/pg1158"/>

                <note rend="inline" type="source">340.1115/12–1945: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in the
                        Soviet Union</hi> (<hi rendition="#italic">Harriman</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-12-19T20:00:00-05:00">December 19,
                            1945—8 p.m.</date>
                    </dateline>
                </opener>
                <p>2581. Senator Green of Rhode Island has expressed strong interest in case of Jan
                    Czechel. Please renew representations with Soviet authorities with view to
                    obtaining exist visa.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
