                <pb facs="1171" n="1159" sameAs="frus:frus1945v05/pg1159"/>

                <note rend="inline" type="source">124.61/10–1245: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in the
                        Soviet Union</hi> (<hi rendition="#italic">Harriman</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-12-20T18:00:00-05:00">December 20,
                            1945—6 p.m.</date>
                    </dateline>
                </opener>
                <p>2592. ReDeptel 2133, Oct. 12, 1945. It is understood that progress is being made
                    in case of Mrs. Kemp Tolley. Please do anything possible to expedite her
                    departure as soon as she receives permission to leave the Soviet Union.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
