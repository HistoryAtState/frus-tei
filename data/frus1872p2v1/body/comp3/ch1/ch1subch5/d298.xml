            <div xml:id="d298">

                <pb facs="0753" n="739" sameAs="frus:frus1872p2v1/pg739"/>

                <head><seg type="margin">[767]</seg> *<hi rendition="#italic">Mr. Davis, Acting
                        Secretary of State, to Mr. Barlow, United States marshal.</hi></head>
                <dateline><placeName><hi rendition="#small-caps">Department of State</hi>,<lb/><hi
                            rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1869-08-13"><hi rendition="#italic">August</hi>
                        13, 1869</date>.</dateline>
                <p><hi rendition="#small-caps">Sir</hi>: I give you herewith, for your information,
                    a transcript of a letter from the Acting Secretary of the Navy, of the 11th
                    instant, relative to the transfer of the Spanish gun-boats which were recently
                    seized by order of the President, to the custody of the commandant of the
                    navy-yard at New York.</p>
                <p>I have the honor to be, &amp;c.,</p>
                <closer>
                    <signed>J. C. B. DAVIS,<lb/><hi rendition="#italic">Acting
                        Secretary.</hi></signed>
                </closer>
                <postscript>
                    <p><hi rendition="#small-caps">Francis C. Barlow</hi>, Esq.,<lb/><hi
                            rendition="#italic">United States Marshal, New York.</hi></p>
                </postscript>
            </div>
        </body>
