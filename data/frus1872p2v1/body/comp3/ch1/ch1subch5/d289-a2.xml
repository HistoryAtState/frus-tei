    <text>
        <body>
            <div xml:id="d289-a2">

                <pb facs="0748" n="734" sameAs="frus:frus1872p2v1/pg734"/>

                <opener>
                    <seg rendition="#center">[Inclosure No. 2.]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">Mr. Pierrepont, district attorney, to Mr. Soar,
                        Attorney-General.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <dateline><placeName><hi rendition="#small-caps">New York</hi></placeName>, <date
                        calendar="gregorian" when="1869-08-03"><hi rendition="#italic">August</hi>
                        3, 1869</date>.</dateline>
                <p rendition="#flush"><hi rendition="#small-caps">Attorney-General</hi>, <hi
                        rendition="#italic">Washington:</hi></p>
                <p>Yours received. The Spanish gun-boats will be stopped this day.</p>
                <closer>
                    <signed>EDWARDS PIERREPONT.</signed>
                </closer>
            </div>
        </body>
    </text>
