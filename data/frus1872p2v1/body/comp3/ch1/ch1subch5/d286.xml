    <text>
        <body>
            <div xml:id="d286">

                <pb facs="0746" n="732" sameAs="frus:frus1872p2v1/pg732"/>

                <head>
                    <hi rendition="#italic">Vice-Admiral Porter, for Secretary of Navy, to Mr. Fish,
                        Secretary of State.</hi>
                </head>
                <dateline><placeName><hi rendition="#small-caps">Navy Department</hi>,<lb/><hi
                            rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1869-05-15"><hi rendition="#italic">May</hi> 15,
                        1869</date>.</dateline>
                <p><hi rendition="#small-caps">Sir</hi>: As the inclosed information may be of use
                    to you, I beg leave to send it.</p>
                <p>Very respectfully,</p>
                <closer>
                    <signed>DAVID D. PORTER,<lb/><hi rendition="#italic">Vice-Admiral, for Secretary
                            of the Navy.</hi></signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">Hamilton Fish</hi>,<lb/><hi
                            rendition="#italic">Secretary of State.</hi></p>
                </postscript>


                <xi:include href="d286-a1.xml" xpointer="d286-a1"/>
