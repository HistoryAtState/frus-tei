    <text>
        <body>
            <div xml:id="d313">

                <pb facs="0767" n="753" xml:id="pg753"/>

                <head>
                    <hi rendition="#italic">Mr. Pierrepont, district attorney, to Mr. Fish,
                        Secretary of State.</hi>
                </head>
                <dateline><placeName><hi rendition="#small-caps">Office of the Attorney of the
                            United States for the Southern District of New York</hi>,<lb/>41 <hi
                            rendition="#italic">Chambers street</hi></placeName>, <date
                        calendar="gregorian" when="1869-12-10"><hi rendition="#italic">December</hi>
                        10, 1869</date>.</dateline>
                <p><hi rendition="#small-caps">Sir</hi>: By order of the court, this day made, the
                    Spanish Cuban gunboats are released. I have directed the marshal to keep them no
                    longer in custody; he will surrender them forthwith.</p>
                <p>Yours, very respectfully,</p>
                <closer>
                    <signed>EDWARDS PIERREPONT,<lb/><hi rendition="#italic">United States
                            Attorney.</hi></signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">Hamilton Fish</hi>,<lb/><hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
