    <text>
        <body>
            <div xml:id="d299">

                <pb facs="0753" n="739" sameAs="frus:frus1872p2v1/pg739"/>

                <head>
                    <hi rendition="#italic">Mr. Davis, Acting Secretary of State, to Mr. Hoar,
                        Attorney General.</hi>
                </head>
                <dateline><placeName><hi rendition="#small-caps">Department of State</hi>,<lb/><hi
                            rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1869-08-13"><hi rendition="#italic">August</hi>
                        13, 1869</date>.</dateline>
                <p><hi rendition="#small-caps">Sir</hi>: I give you herewith, for your information,
                    a transcript of a letter from the Acting Secretary of the Navy, of the 11th
                    instant, relative te the transfer of the Spanish gun-boats which were recently
                        <pb facs="0754" n="740" xml:id="pg740"/> seized by order of the President,
                    to the custody *of the commandant of the navy-yard at New York. <seg
                        type="margin">[768]</seg></p>
                <p>I am, sir, &amp;c.,</p>
                <closer>
                    <signed>J. C. B. DAVIS,<lb/><hi rendition="#italic">Acting
                        Secretary.</hi></signed>
                </closer>
                <postscript>
                    <p>The Hon. <hi rendition="#small-caps">E. R. Hoar</hi>,<lb/><hi
                            rendition="#italic">Attorney-General.</hi></p>
                    <p>[For inclosure see <hi rendition="#italic">ante</hi>, p. 739.]</p>
                </postscript>
            </div>
        </body>
    </text>
