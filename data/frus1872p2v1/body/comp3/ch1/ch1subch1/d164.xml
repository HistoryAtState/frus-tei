            <div xml:id="d164">

                <pb facs="0645" n="631" sameAs="frus:frus1872p2v1/pg631"/>

                <head><seg type="margin">[509]</seg> *<hi rendition="#italic">Mr. Joachinson, acting
                        district attorney, to Mr. Gushing, Attorney-General.</hi></head>
                <dateline><placeName><hi rendition="#small-caps">Southern District of New York,
                            United States District Attorney’s Office</hi></placeName>,<lb/><date
                        calendar="gregorian" when="1856-01-09T16:00:00-04:56"><hi
                            rendition="#italic">January</hi> 9, 1856—4 p.m</date>.</dateline>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to report to you that I
                    have just returned from the Star of the West. The President’s authority was
                    respected. Four arrests were made. The ship not having anything otherwise
                    unlawful, I permitted her to depart. I will give a detailed report
                    to-morrow.</p>
                <p>I remain, with great respect,</p>
                <closer>
                    <signed>P. J. JOACHINSON,<lb/><hi rendition="#italic">Acting United States
                            District Attorney.</hi></signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">Caleb Gushing</hi>,<lb/><hi
                            rendition="#italic">Attorney-General.</hi></p>
                </postscript>
            </div>
        </body>
