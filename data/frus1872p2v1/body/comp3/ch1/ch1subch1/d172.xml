    <text>
        <body>
            <div xml:id="d172">

                <pb facs="0648" n="634" sameAs="frus:frus1872p2v1/pg634"/>

                <head>
                    <hi rendition="#italic">Mr. Cushing,
                        Attorney-General, to Mr. Inge, district
                        attorney.</hi>
                </head>
                <dateline><placeName><hi rendition="#small-caps">Attorney-General’s
                        Office</hi></placeName>,<lb/><date calendar="gregorian" when="1856-03-01"
                            ><hi rendition="#italic">March</hi> 1, 1856</date>.</dateline>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my letters of January 16,
                    1854, and of December 14, 1855, I have to request of you a brief report of the
                    several prosecutions which have been instituted in your district for imputed
                    violation of the provisions of the act of Congress referred to.</p>
                <p>I am, very respectfully,</p>
                <closer>
                    <signed>C. CUSHING.</signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">S. W. Inge</hi>,<lb/><hi rendition="#italic"
                            >Attorney of the United States, San Francisco.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
