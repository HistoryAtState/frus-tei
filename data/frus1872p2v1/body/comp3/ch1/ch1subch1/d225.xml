                <head>
                    <hi rendition="#italic">Mr. Preston, Secretary
                        of the Navy, to Commodore Sloat, commandant
                        navy-yard</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <dateline><placeName><hi rendition="#small-caps">Navy Department</hi></placeName>,
                        <date calendar="gregorian" when="1850-05-15"><hi rendition="#italic"
                            >May</hi> 15, 1850</date>.</dateline>
                <p rendition="#flush">Commodore <hi rendition="#small-caps">J. D.
                        Sloat</hi>,<lb/><hi rendition="#italic">Commandant Navy Yara, Portsmouth,
                        Virginia:</hi></p>
                <p>Prepare the United States steamer Saranac for immediate service.
                    Sailing-instructions will be sent by mail.</p>
                <closer>
                    <signed>WILLIAM BALLARD PRESTON.</signed>
                </closer>
            </div>
        </body>
