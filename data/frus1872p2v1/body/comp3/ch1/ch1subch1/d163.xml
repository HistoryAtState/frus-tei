                <head>
                    <hi rendition="#italic">Mr. Pierce, President,
                        to Captain Bigelow, United States
                        navy-yard.</hi>
                </head>
                <dateline><placeName><hi rendition="#small-caps">Executive Mansion</hi></placeName>,
                        <date calendar="gregorian" when="1856-01-09"><hi rendition="#italic"
                            >January</hi> 9, 1856</date>.</dateline>
                <p rendition="#flush">Captain <hi rendition="#small-caps">Abram Bigelow</hi>,</p>
                <p rendition="#center">
                    <hi rendition="#italic">United States Navy-Yard, Brooklyn, New York:</hi>
                </p>
                <p>Arrest and detain any vessel in the port of New York charged with violation of
                    neutrality laws, upon advice of the district attorney, Hon. John McKeon.</p>
                <closer>
                    <signed>FRANKLIN PIERCE.</signed>
                </closer>
                <postscript>
                    <p>The original received, of which the above is a copy.</p>
                </postscript>
            </div>
        </body>
