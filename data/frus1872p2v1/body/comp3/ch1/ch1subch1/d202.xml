            <div xml:id="d202">

                <pb facs="0696" n="682" sameAs="frus:frus1872p2v1/pg682"/>

                <head><seg type="margin">[646]</seg> *<hi rendition="#italic">Mr. Clayton, Secretary
                        of State, to Don A. C. de la Barca</hi>.</head>
                <dateline><placeName><hi rendition="#small-caps">Department of State</hi>,<lb/><hi
                            rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1849-08-09"><hi rendition="#italic">August</hi>
                        9, 1849</date>.</dateline>
                <p><hi rendition="#small-caps">My Dear Sir</hi>: Business of great importance to the
                    interests of your government requires your immediate presence here; and I hope
                    to see you at Washington as soon after the receipt of this note as your
                    convenience will possibly allow you to repair hither.</p>
                <p>Very respectfully, &amp;c., &amp;c.,</p>
                <closer>
                    <signed>JOHN M. CLAYTON.</signed>
                </closer>
                <postscript>
                    <p>Don <hi rendition="#small-caps">A. Calderon de la Barca</hi>, <hi
                            rendition="#italic">&amp;c., &amp;C., &amp;C.<lb/>Glenn Cove, Long
                            Island.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
