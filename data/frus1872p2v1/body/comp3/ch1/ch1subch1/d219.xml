                <pb facs="0706" n="692" xml:id="pg692"/>

                <head>
                    <hi rendition="#italic">Mr. Clayton, Secretary of State, to Mr. Williams,
                        district attorney.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Per telegraph.]</seg>
                </opener>
                <dateline><placeName><hi rendition="#small-caps">Department of
                        State</hi></placeName>,<lb/><date calendar="gregorian" when="1850-05-25"><hi
                            rendition="#italic">May</hi> 25, 1850</date>.</dateline>
                <p rendition="#flush"><hi rendition="#small-caps">Henry Williams</hi>, Esq.,<lb/><hi
                        rendition="#italic">United States District Attorney, Savannah,
                    Georgia:</hi></p>
                <p>Proceed according to law to have General Lopez arrested for a violation of the
                    act of Congress of the 20th of April, 1818, and held in custody until he can be
                    transferred to the proper district for trial.</p>
                <closer>
                    <signed>JOHN M. CLAYTON,<lb/><hi rendition="#italic">Secretary of
                        State</hi>.</signed>
                </closer>
            </div>
        </body>
