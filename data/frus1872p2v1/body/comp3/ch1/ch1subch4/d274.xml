    <text>
        <body>
            <div xml:id="d274">

                <pb facs="0739" n="725" sameAs="frus:frus1872p2v1/pg725"/>

                <head>
                    <hi rendition="#italic">Mr. Hoar Attorney-General, to Mr. Fish, Secretary of
                        State.</hi>
                </head>
                <dateline><placeName><hi rendition="#small-caps">Attorney-General’s
                            Office</hi>,<lb/><hi rendition="#italic">Washington</hi></placeName>,
                        <date calendar="gregorian" when="1869-04-10"><hi rendition="#italic"
                            >April</hi> 10, 1869</date>.</dateline>
                <p><hi rendition="#small-caps">Sir</hi>: I am in the receipt of a letter from you of
                    the 3d instant, conveying certain information received by your Department from
                    the chargé d’affaires of Hayti, relative to the fitting out of a steamer named
                    Florida, at Chester, Pennsylvania, for the service of the insurgents now in arms
                    against his government.</p>
                <pb facs="0740" n="726" xml:id="pg726"/>
                <p>I inclose you herewith a copy of a communication addressed to the United States
                    attorney for the eastern district of Pennsylvania upon this subject.</p>
                <p>I have the honor to be yours, &amp;c.,</p>
                <closer>
                    <signed>E. R. HOAR,<lb/><hi rendition="#italic">Attorney-General.</hi></signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">Hamilton Fish</hi>,<lb/><hi
                            rendition="#italic">Secretary of State.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
