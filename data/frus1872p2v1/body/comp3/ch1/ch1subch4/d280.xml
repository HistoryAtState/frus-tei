                <pb facs="0743" n="729" sameAs="frus:frus1872p2v1/pg729"/>

                <head><hi rendition="#italic">Mr. Soar, Attorney-General, to Mr. Smith, district
                        attorney</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <dateline><placeName><hi rendition="#small-caps">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1869-05-18"><hi rendition="#italic">May</hi> 18,
                        1869</date>.</dateline>
                <p rendition="#flush"><hi rendition="#small-caps">Aubrey H. Smith</hi>, Esq., <hi
                        rendition="#italic">United States Attorney, Philadelphia:</hi></p>
                <p>Look out for the Florida. On proof of probable cause, libel and arrest her.</p>
                <closer>
                    <signed>E. R. HOAR.<lb/><hi rendition="#italic">Attorney-General.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
