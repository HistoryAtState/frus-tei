    <text>
        <body>
            <div xml:id="d407">

                <pb facs="0817" n="803" xml:id="pg803"/>

                <head>
                    <hi rendition="#italic">Mr. Barlow, United
                        States marshal, to Mr. Hoar,
                        Attorney-General.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <dateline><placeName><hi rendition="#small-caps">Brooklyn, New
                    York</hi></placeName>, <date calendar="gregorian" when="1869-07-02"><hi
                            rendition="#italic">July</hi> 2, 1869</date>.</dateline>
                <p rendition="#flush"><hi rendition="#small-caps">Attorney-General</hi>, <hi
                        rendition="#italic">Washington:</hi></p>
                <p>I have taken full charge of the men, according to your order of this morning, and
                    will see that they are rationed at my expense, and will hold them until further
                    orders.</p>
                <closer>
                    <signed>FRANCIS C. BARLOW,<lb/><hi rendition="#italic">United States
                            Marshal.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
