                <pb facs="0813" n="799" xml:id="pg799"/>

                <opener>
                    <seg rendition="#center"><seg type="margin">[81]</seg> *[Inclosure No. 6.]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">Mr. Boutwell, Secretary
                        of the Treasury, to Mr. Grinnell,
                        collector.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <dateline><placeName><hi rendition="#small-caps">Treasury Depatment</hi>,<lb/><hi
                            rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1869-06-30"><hi rendition="#italic">June</hi> 30,
                        1869</date>.</dateline>
                <p><hi rendition="#small-caps">Moses H. Grinnell</hi>, <hi rendition="#italic"
                        >Collector of Customs, New York:</hi></p>
                <p>Station one of revenue tugs in place of McCulloch, and put latter under temporary
                    orders of Marshal Barlow, if he wishes.</p>
                <closer>
                    <signed>GEO. S. BOUTWELL,<lb/><hi rendition="#italic">Secretary of the
                            Treasury.</hi></signed>
                </closer>
            </div>
        </body>
