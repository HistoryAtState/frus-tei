            <div xml:id="d397-a2">

                <pb facs="0811" n="797" sameAs="frus:frus1872p2v1/pg797"/>

                <opener>
                    <seg rendition="#center">[Inclosure No. 2.]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">Mr. Boutwell, Secretary
                        of the Treasury, to Mr. Grinnell,
                        collector.</hi>
                </head>
                <dateline><placeName><seg type="margin">[79]</seg> *<hi rendition="#small-caps"
                            >Treasury Department</hi>,<lb/><hi rendition="#italic"
                        >Washington</hi></placeName>
                    <date calendar="gregorian" when="1869-06-30"><hi rendition="#italic">June</hi>
                        30, 1869</date>.</dateline>
                <p rendition="#flush"><hi rendition="#small-caps">Lawrence Grinnell</hi>,<lb/><hi
                        rendition="#italic">Collector of Customs. New Bedford Massachusets:</hi></p>
                <p>See that no vessel at your port is employed in violating neutrality-laws.</p>
                <closer>
                    <signed>GEO. S. BOUTWELL,<lb/><hi rendition="#italic">Secretary of the
                            Treasury.</hi></signed>
                </closer>
            </div>
        </body>
