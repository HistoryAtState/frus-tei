    <text>
        <body>
            <div xml:id="d330">

                <pb facs="0779" n="765" xml:id="pg765"/>

                <head>
                    <hi rendition="#italic">Mr. Chandler, Assistant Secretary of the Treasury, to
                        Mr. Seward, Secretary of State.</hi>
                </head>
                <dateline><placeName><hi rendition="#small-caps">Treasury Department</hi>,<lb/><hi
                            rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1867-01-29"><hi rendition="#italic">January</hi>
                        29, 1867</date>.</dateline>
                <p><hi rendition="#small-caps">Sir</hi>: I am directed by the Secretary to transmit
                    for your information, a copy of a letter from J. R. Savage, of New York, giving
                    information of the alleged fitting out of a privateer at that port, submitted to
                    this Department, with the accompanying copy of a letter from the Secretary of
                    War. A copy of Mr. Savage’s letter has this day been transmitted to the
                    collector of the customs at New York, with instructions to him to cause an
                    examination as to the correctness of the charge to be made, and to report to
                    this Department the result of such investigation, with his views.</p>
                <p>I have the honor to be, &amp;c.,</p>
                <closer>
                    <signed>WM. E. CHANDLER,<lb/><hi rendition="#italic">Assistant
                        Secretary.</hi></signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>,<lb/><hi
                            rendition="#italic">Secretary of State.</hi></p>
                </postscript>
            </div>
        </body>
