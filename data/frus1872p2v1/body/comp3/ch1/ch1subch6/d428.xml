    <text>
        <body>
            <div xml:id="d428">

                <pb facs="0827" n="813" xml:id="pg813"/>

                <head>
                    <hi rendition="#italic">Mr. Potestad, of the
                        Spanish legation, to Mr. Davis, Acting
                        Secretary of State.</hi>
                </head>
                <dateline><placeName><hi rendition="#small-caps">Legation of Spain in
                            Washington</hi></placeName>,<lb/><date calendar="gregorian"
                        when="1869-08-21"><hi rendition="#italic">August</hi> 21,
                    1869</date>.</dateline>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose, agreeably to
                    your request, a memorandum relative to the subject of this morning’s
                    conversation.</p>
                <p>I remain, sir, with high regard, your most obedient servant,</p>
                <closer>
                    <signed>LUIS DE POTESTAD.</signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">J. C. Bancroft Dayis</hi>, <hi
                            rendition="#italic">&amp;c.</hi></p>
                </postscript>


                <xi:include href="d428-a1.xml" xpointer="d428-a1"/>
