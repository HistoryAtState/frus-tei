            <div xml:id="d373">

                <pb facs="0802" n="788" sameAs="frus:frus1872p2v1/pg788"/>

                <head><seg type="margin">[61]</seg> *<hi rendition="#italic">Mr. Fish, Secretary of
                        State, to Mr. Boutwell, Secretary of Treasury</hi>.</head>
                <dateline><placeName><hi rendition="#small-caps">Department of State</hi>,<lb/><hi
                            rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1869-05-21"><hi rendition="#italic">May</hi> 21,
                        1869</date>.</dateline>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your letter of the 18th instant, with its accompaniment, in relation to the
                    refusal of a clearance to the steamer Columbia [Quaker City,] and to inform you
                    that I have transmitted a copy of the same to Mr. Roberts, the Spanish minister,
                    for his information.</p>
                <p>I have the honor to be, &amp;c.,</p>
                <closer>
                    <signed>HAMILTON FISH.</signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">George S. Boutwell</hi>,<lb/><hi
                            rendition="#italic">Secretary of the Treasury.</hi></p>
                </postscript>
            </div>
        </body>
