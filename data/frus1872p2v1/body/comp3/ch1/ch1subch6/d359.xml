    <text>
        <body>
            <div xml:id="d359">

                <pb facs="0794" n="780" sameAs="frus:frus1872p2v1/pg780"/>

                <head><seg type="margin">[47]</seg> *<hi rendition="#italic">Mr. Boutwell, Secretary
                        of the Treasury, to Mr. Fish, Secretary of State.</hi></head>
                <dateline><placeName><hi rendition="#small-caps">Treasury Department</hi>,<lb/><hi
                            rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1869-05-10"><hi rendition="#italic">May</hi> 10,
                        1869</date>.</dateline>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge your letter
                    of the 8th instant, respecting the steamer Quaker City, and to advise you that,
                    pursuant <pb facs="0795" n="781" xml:id="pg781"/> to your request, the collector
                    of customs was on that day instructed to prevent the sailing of that vessel in
                    violation of the neutrality act.</p>
                <p>Very respectfully,</p>
                <closer>
                    <signed>GEO. S. BOUTWELL,<lb/><hi rendition="#italic">Secretary of the
                            Treasury.</hi></signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">Hamilton Fish</hi>,<lb/><hi
                            rendition="#italic">Secretary of State.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
