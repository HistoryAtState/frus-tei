    <text>
        <body>
            <div xml:id="d372">

                <pb facs="0801" n="787" sameAs="frus:frus1872p2v1/pg787"/>

                <head>
                    <hi rendition="#italic">Mr. Fish, Secretary of State, to Mr. Roberts, Spanish
                        minister.</hi>
                </head>
                <dateline><placeName><hi rendition="#small-caps">Department of State</hi>,<lb/><hi
                            rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1869-05-21"><hi rendition="#italic">May</hi> 21,
                        1869</date>.</dateline>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose for your
                    information a transcript of <pb facs="0802" n="788" xml:id="pg788"/> a letter of
                    the 18th instant, addressed to this Department by the Secretary of the Treasury,
                    transmitting a copy of a communication addressed to him by the collector of
                    customs at New York stating that a clearance had been refused to the steamer
                    Columbia [Quaker City] “because of suspicious circumstances connected with
                    her.”</p>
                <p>I am, sir, with, &amp;c.,</p>
                <closer>
                    <signed>HAMILTON FISH.</signed>
                </closer>
                <postscript>
                    <p>Señor Don <hi rendition="#small-caps">M. Lopez Roberts</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
