    <text>
        <body>
            <div xml:id="d377">

                <pb facs="0803" n="789" sameAs="frus:frus1872p2v1/pg789"/>

                <head>
                    <seg type="margin">[63]</seg>
                    <hi rendition="#italic">*Mr. Pierrepont,
                        district attorney, to Mr. Hoar,
                        Attorney-General.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <dateline><placeName><hi rendition="#small-caps">New York</hi></placeName>, <date
                        calendar="gregorian" when="1869-06-18"><hi rendition="#italic">June</hi> 18,
                        1869</date>.</dateline>
                <p><hi rendition="#small-caps">Sir</hi>: Yours of the seventeenth in relation to the
                    Cuban expedition is received. Action had already been taken by me.</p>
                <closer>
                    <signed>EDWARDS PIERREPONT,<lb/><hi rendition="#italic">United States
                            Attorney.</hi></signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">E. R. Hoar</hi>,<lb/><hi rendition="#italic"
                            >Attorney-General, Washington.</hi></p>
                </postscript>
            </div>
        </body>
