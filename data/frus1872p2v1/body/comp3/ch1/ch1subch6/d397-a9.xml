            <div xml:id="d397-a9">

                <pb facs="0814" n="800" xml:id="pg800"/>

                <opener>
                    <seg rendition="#center">[Inclosure No. 9.]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">Mr. Boutwell, Secretary of the Treasury, to Mr. Macey,
                        collector.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <dateline><placeName><hi rendition="#small-caps">Treasury Department</hi>,<lb/><hi
                            rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1869-06-30"><hi rendition="#italic">June</hi> 30,
                        1869</date>.</dateline>
                <p rendition="#flush"><hi rendition="#small-caps">Seth W. Macey</hi>,<lb/><hi
                        rendition="#italic">Collector of Customs, Newport, Rhode Island:</hi></p>
                <p>See that no vessel at your port is employed in violating neutrality laws.</p>
                <closer>
                    <signed>GEO. S. BOUTWELL,<lb/><hi rendition="#italic">Secretary of the
                            Treasury.</hi></signed>
                </closer>
            </div>
