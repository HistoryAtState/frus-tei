    <text>
        <body>
            <div xml:id="d363">

                <pb facs="0796" n="782" sameAs="frus:frus1872p2v1/pg782"/>

                <head>
                    <hi rendition="#italic">Mr. Boutwell, Secretary of the Treasury, to Mr. Fish,
                        Secretary State.</hi>
                </head>
                <dateline><placeName><hi rendition="#small-caps">Treasury Department</hi>,<lb/><hi
                            rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1872-05-12"><hi rendition="#italic">May</hi> 12,
                        1872</date>.</dateline>
                <p><hi rendition="#small-caps">Sir</hi>: In addition to the information which I had
                    the honor to submit on yesterday’s date relative to the steamer Quaker City at
                    New York, I herewith inclose copy of a letter from the collector of customs at
                    that port, dated the 11th instant.</p>
                <p><seg type="margin">[51]</seg> *Very respectfully,</p>
                <closer>
                    <signed>GEO. S. BOUTWELL,<lb/><hi rendition="#italic">Secretary of the
                            Treasury.</hi></signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">Hamilton Fish</hi>,<lb/><hi
                            rendition="#italic">Secretary of State.</hi></p>
                </postscript>



                <xi:include href="d363-a1.xml" xpointer="d363-a1"/>
