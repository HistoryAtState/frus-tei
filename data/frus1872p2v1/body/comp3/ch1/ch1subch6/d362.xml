    <text>
        <body>
            <div xml:id="d362">

                <pb facs="0795" n="781" sameAs="frus:frus1872p2v1/pg781"/>

                <head>
                    <hi rendition="#italic">Mr. Boutwell, Secretary of the Treasury, to Mr. Fish,
                        Secretary of State.</hi>
                </head>
                <dateline><placeName><hi rendition="#small-caps">Treasury Department</hi>,<lb/><hi
                            rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1869-05-11"><hi rendition="#italic">May</hi> 11,
                        1869</date>.</dateline>
                <p><seg type="margin">[49]</seg>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor herewith to trans*mit a
                    copy of a letter received from the collector of customs at New York, in reply to
                        <pb facs="0796" n="782" xml:id="pg782"/> my communication of the 8th
                    instant, informing him of the alleged intended fitting out of the steamer Quaker
                    City at that port to cruise against Spanish shipping under a letter of marque,
                    communicated to me in your letter of the 8th instant.</p>
                <p>Very respectfully,</p>
                <closer>
                    <signed>GEO. S. BOUTWELL,<lb/><hi rendition="#italic">Secretary of the
                            Treasury.</hi></signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">Hamilton Fish</hi>,<lb/><hi
                            rendition="#italic">Secretary of State.</hi></p>
                </postscript>


                <xi:include href="d362-a1.xml" xpointer="d362-a1"/>
            </div>
