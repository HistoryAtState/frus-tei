                <pb facs="0773" n="[759]" sameAs="frus:frus1872p2v1/pg759"/>

                <head><seg type="margin">[2]</seg> *<hi rendition="#italic">Mr. Hunter, Acting Secretary of State, to Mr.
                            Dickinson, district attorney.</hi></head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <dateline><placeName><hi rendition="#small-caps">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1866-01-25"><hi rendition="#italic">January</hi>
                        25, 1866</date>.</dateline>
                <p rendition="#flush"><hi rendition="#small-caps">D. S. Dickinson</hi>, <hi
                        rendition="#italic">United States Attorney, New York:</hi></p>
                <p>Your telegram of yesterday reached here too late in the evening to be then
                    answered. At present no suggestions or instructions from this Department
                    relative to the case of the Meteor are deemed necessary.</p>
                <closer>
                    <signed>W. HUNTER.</signed>
                </closer>
            </div>
        </body>
