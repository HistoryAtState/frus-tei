    <text>
        <body>
            <div xml:id="d432">

                <pb facs="0828" n="814" sameAs="frus:frus1872p2v1/pg814"/>

                <head>
                    <hi rendition="#italic">Mr. Milledge, district attorney, to Mr. Hoar,
                        Attorney-General.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <dateline><placeName><hi rendition="#small-caps">Atlanta, Georgia</hi></placeName>,
                        <date calendar="gregorian" when="1869-09-02"><hi rendition="#italic"
                            >September</hi> 2, 1869</date>.</dateline>
                <p rendition="#flush">To Attorney-General <hi rendition="#small-caps">E. R.
                        Hoar</hi>:</p>
                <p><seg type="margin">[110]</seg> Large parties are organizing in this State for
                    Cuba. Twenty-five have been arrested in Macon. I leave for that place to night.
                    Can the military be used *to assist in arresting? Please answer to Macon.</p>
                <closer>
                    <signed>JOHN MILLEDGE,<lb/><hi rendition="#italic">District
                        Attorney.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
