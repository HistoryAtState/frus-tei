    <text>
        <body>
            <div xml:id="d360">

                <pb facs="0795" n="781" sameAs="frus:frus1872p2v1/pg781"/>

                <head>
                    <hi rendition="#italic">Mr. Hoar, Attorney-General, to Mr. Pierrepont, district
                        attorney.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <dateline><placeName><hi rendition="#small-caps">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1869-05-11"><hi rendition="#italic">May</hi> 11,
                        1869</date>.</dateline>
                <p rendition="#flush"><hi rendition="#small-caps">Edwards Pierrepont</hi>, Esq., <hi
                        rendition="#italic">New York:</hi></p>
                <p>Look out for the Quaker City, and on complaint, with proof of probable cause,
                    libel and detain her.</p>
                <closer>
                    <signed>E. R. HOAR,<lb/><hi rendition="#italic">Attorney-General.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
