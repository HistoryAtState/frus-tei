                <pb facs="0828" n="814" sameAs="frus:frus1872p2v1/pg814"/>

                <head>
                    <hi rendition="#italic">Mr. Field, Acting Attorney-General, to Mr. Milledge,
                        district attorney.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <dateline><placeName><hi rendition="#small-caps">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1869-09-01"><hi rendition="#italic"
                            >September</hi> 1, 1869</date>.</dateline>
                <p rendition="#flush"><hi rendition="#small-caps">John Milledge</hi>, Esq.,<lb/><hi
                        rendition="#italic">United States Attorney, Savannah, Georgia:</hi></p>
                <p>If any illegal hostile expedition attempts to leave Savannah for Cuba or
                    elsewhere, stop it and indict the parties.</p>
                <closer>
                    <signed>W. A. FIELD,<lb/><hi rendition="#italic">Acting
                        Attorney-General.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
