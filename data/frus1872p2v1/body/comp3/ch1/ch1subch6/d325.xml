    <text>
        <body>
            <div xml:id="d325">

                <pb facs="0777" n="763" sameAs="frus:frus1872p2v1/pg763"/>

                <head>
                    <hi rendition="#italic">Mr. Speed, Attorney-General, to Mr. Kelby, district,
                        attorney.</hi>
                </head>
                <dateline><placeName><hi rendition="#small-caps">Office of the
                            Attorney-General</hi>,<lb/><hi rendition="#italic"
                        >Washington</hi></placeName>, <date calendar="gregorian" when="1866-04-21"
                            ><hi rendition="#italic">April</hi> 21, 1866</date>.</dateline>
                <p><seg type="margin">[9]</seg> *<hi rendition="#small-caps">Sir</hi>: I inclose to
                    you a copy of a letter this day received by me from the Secretary of State.</p>
                <p>You will be on the watch, and careful to see that the neutrality law is not
                    violated.</p>
                <p>Very respectfully, &amp;c.,</p>
                <closer>
                    <signed>JAMES SPEED,<lb/><hi rendition="#italic">Attorney-General.</hi></signed>
                </closer>
                <postscript>
                    <p><hi rendition="#small-caps">Hiram Kelby</hi>, Esq.,<lb/><hi
                            rendition="#italic">United States Attorney, New London,
                            Connecticut.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
