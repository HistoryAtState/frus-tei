                <pb facs="0825" n="811" sameAs="frus:frus1872p2v1/pg811"/>

                <head><seg type="margin">[105]</seg> *<hi rendition="#italic">Mr. Fish, Secretary of State, to Mr. Hoar, Attorney-General</hi>.</head>
                <dateline><placeName><hi rendition="#small-caps">Department of State</hi>,<lb/><hi
                            rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1869-07-16"><hi rendition="#italic">July</hi> 16,
                        1869</date>.</dateline>
                <p><hi rendition="#small-caps">Sir</hi>: Inclosed I send you a copy of a telegram
                    just received from the marshal of New York, and will thank you either to
                    instruct him on the subject, or to advise me what answer I shall give.</p>
                <p>I have the honor to be, &amp;c.,</p>
                <closer>
                    <signed>HAMILTON FISH.</signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">E. R. Hoar</hi>,<lb/><hi rendition="#italic"
                            >Attorney-General.</hi></p>
                </postscript>
            </div>
        </body>
