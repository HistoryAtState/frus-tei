    <text>
        <body>
            <div xml:id="d374">

                <pb facs="0802" n="788" sameAs="frus:frus1872p2v1/pg788"/>

                <head>
                    <hi rendition="#italic">Mr. Boutwell, Secretary
                        of the Treasury, to Mr. Grinnell,
                        collector.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <dateline><placeName><hi rendition="#small-caps">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1869-05-21"><hi rendition="#italic">May</hi> 21,
                        1869</date>.</dateline>
                <p rendition="#flush"><hi rendition="#small-caps">Moses H. Grinnell</hi>, <hi
                        rendition="#italic">Collector of Customs, New York:</hi></p>
                <p>If the Columbia has not cleared, withhold papers till further orders.</p>
                <closer>
                    <signed>GEORGE S. BOUTWELL.<lb/><hi rendition="#italic">Secretary of the
                            Treasury.</hi></signed>
                </closer>
            </div>
        </body>
