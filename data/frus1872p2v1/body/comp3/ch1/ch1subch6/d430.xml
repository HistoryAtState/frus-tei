                <pb facs="0828" n="814" sameAs="frus:frus1872p2v1/pg814"/>

                <head>
                    <hi rendition="#italic">Mr. Morrill, United States commissioner, to Mr. Hoar,
                        Attorney-General.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <dateline><placeName><hi rendition="#small-caps">Macon, Georgia</hi></placeName>,
                        <date calendar="gregorian" when="1869-08-31"><hi rendition="#italic"
                            >August</hi> 31, 1869</date>.</dateline>
                <p rendition="#flush">Attorney-General <hi rendition="#small-caps">Hoar</hi>:</p>
                <p>Eighty-three persons enlisted for Cuban army will try to leave for Florida
                    to-night. Have telegraphed to marshal at Savannah, and district attorney.</p>
                <closer>
                    <signed>W. C. MORRILL.</signed>
                </closer>
            </div>
        </body>
    </text>
