        <body>
            <div xml:id="d404">

                <pb facs="0816" n="802" xml:id="pg802"/>

                <head><seg type="margin">[86]</seg> *<hi rendition="#italic">Mr. Field, Assistant
                        Attorney-General, to Mr. Willey, district attorney.</hi></head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <dateline><placeName><hi rendition="#small-caps">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1869-07-02"><hi rendition="#italic">July</hi> 2,
                        1869</date>.</dateline>
                <p rendition="#flush"><hi rendition="#small-caps">Hiram Willey</hi>,<lb/><hi
                        rendition="#italic">United States Attorney, New London,
                    Connecticut:</hi></p>
                <p>Libel vessels and cargo, if you think they are forfeitable; otherwise detain
                    them, and report facts to this office.</p>
                <closer>
                    <signed>W. A. FIELD,<lb/><hi rendition="#italic">Assistant
                            Attorney-General.</hi></signed>
                </closer>
            </div>
        </body>
