    <text>
        <body>
            <div xml:id="d356">

                <pb facs="0793" n="779" xml:id="pg779"/>

                <head>
                    <hi rendition="#italic">Mr. Fish, Secretary of State, to Mr. Barlow, United
                        States marshal, New York.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <dateline><placeName><hi rendition="#small-caps">Department of State,.</hi><lb/><hi
                            rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1869-05-08"><hi rendition="#italic">May</hi> 8,
                        1869</date>.</dateline>
                <p rendition="#flush">General <hi rendition="#small-caps">Frances C. Barlow</hi>,
                        <hi rendition="#italic">United States Marshal, New York:</hi></p>
                <p>Dispatch received. Spanish minister been requested to communicate with you.
                    Confer with him or Spanish consul. Watch the ship, and seize whenever sufficient
                    proof.</p>
                <closer>
                    <signed>HAMILTON FISH.</signed>
                </closer>
            </div>
        </body>
    </text>
