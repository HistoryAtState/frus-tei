    <text>
        <body>
            <div xml:id="d397-a4">

                <pb facs="0812" n="798" sameAs="frus:frus1872p2v1/pg798"/>

                <opener>
                    <seg rendition="#center">[Inclosure No. 4.]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">Mr. Boutwell, Secretary
                        of the Treasury, to Mr. Marshall,
                        collector.</hi>
                </head>
                <opener>
                    <seg rendition="#center"><seg type="margin">[80]</seg> *[Telegram.]</seg>
                </opener>
                <dateline><placeName><hi rendition="#small-caps">Treasury Department</hi>,<lb/><hi
                            rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1869-06-30"><hi rendition="#italic">June</hi> 30,
                        1869</date>.</dateline>
                <p rendition="#flush"><hi rendition="#small-caps">Geo. T. Marshall</hi>, <hi
                        rendition="#italic">Collector of Customs, New London, Connecticut:</hi></p>
                <p>Direct commanding officer of revenue-cutter Campbell to obey any orders he may
                    receive from Marshal Barlow.</p>
                <closer>
                    <signed>GEO. S. BOUTWELL,<lb/><hi rendition="#italic">Secretary of the
                            Treasury.</hi></signed>
                </closer>
            </div>
        </body>
