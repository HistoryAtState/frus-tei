    <text>
        <body>
            <div xml:id="d392">

                <pb facs="0808" n="794" sameAs="frus:frus1872p2v1/pg794"/>

                <head>
                    <hi rendition="#italic">Mr. Fish, Secretary of
                        State, to the President.</hi>
                </head>
                <dateline><placeName><hi rendition="#small-caps">Department of State</hi>,<lb/><hi
                            rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1869-06-29"><hi rendition="#italic">June</hi> 29,
                        1869</date>.</dateline>
                <p>The Secretary of State has the honor to lay before the President the inclosed
                    telegram of this date, just received from Mr. Pierrepont, asking instructions as
                    to steps to be taken in regard to Colonel Ryan and his expeditionary party of
                    four hundred men at New York.<anchor n="1" xml:id="d392-f1"/></p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d392-f1" n="1" xml:id="d392-f1-content">
                <p>For inclosure see preceding letter.</p>
            </note>
        </listAnnotation>
    </standOff>
