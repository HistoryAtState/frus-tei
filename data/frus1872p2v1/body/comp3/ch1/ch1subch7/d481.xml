    <text>
        <body>
            <div xml:id="d481">

                <pb facs="0856" n="842" sameAs="frus:frus1872p2v1/pg842"/>

                <head>
                    <hi rendition="#italic">Mr. Boutwell, Secretary of the Treasury, to General
                        Sherman, Acting Secretary of War.</hi>
                </head>
                <dateline><placeName><hi rendition="#small-caps">Treasury Department</hi>,<lb/><hi
                            rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1869-10-04"><hi rendition="#italic">October</hi>
                        4, 1869</date>.</dateline>
                <p><hi rendition="#small-caps">Sir</hi>: I get information from the collector of
                    customs at Wilmington, North Carolina, that there is danger that the Hornet may
                    go to sea in defiance of our authority.</p>
                <p>I have directed the collector to take precautions to prevent this, and I have the
                    honor to request you to issue further orders, if you deem it necessary, to the
                    military officers, to assist in preventing her escape.</p>
                <p><seg type="margin">[167]</seg> *Very respectfully,</p>
                <closer>
                    <signed>
                        <list>
                            <item>GEO. S. BOUTWELL,<lb/><hi rendition="#italic"
                                >Secretary.</hi></item>
                            <item>General <hi rendition="#small-caps">W. T. Sherman</hi>,<lb/><hi
                                    rendition="#italic">Acting Secretary of War.</hi></item>
                        </list>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
