    <text>
        <body>
            <div xml:id="d483">

                <pb facs="0857" n="843" xml:id="pg843"/>

                <head>
                    <hi rendition="#italic">General Sherman, Acting Secretary of War, to Mr. Rumley,
                        collector.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <dateline><placeName><hi rendition="#small-caps">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1869-10-04"><hi rendition="#italic">October</hi>
                        4, 1869</date>.</dateline>
                <p rendition="#flush"><hi rendition="#small-caps">D. Rumley</hi>, <hi
                        rendition="#italic">Collector, Wilmington, North Carolina:</hi></p>
                <p>Notify commanding officer at Fort Johnson that he is ordered, by telegraph, to
                    detain the Hornet till she receives from you a regular clearance.</p>
                <closer>
                    <signed>W. T. SHERMAN,<lb/><hi rendition="#italic">General, and Acting Secretary
                            of War.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
