                <opener>
                    <seg rendition="#center">[Inclosure.]</seg>
                </opener>
                <head><hi rendition="#italic">Rear-Admiral Godon to Mr. Robeson, Secretary of the
                        Navy</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <dateline><placeName><hi rendition="#small-caps">Brooklyn, New
                    York</hi></placeName>, <date calendar="gregorian" when="1869-10-08"><hi
                            rendition="#italic">October</hi> 8, 1869</date>.</dateline>
                <p rendition="#flush">To <hi rendition="#small-caps">Hon. Geo. M. Robeson</hi>, <hi
                        rendition="#italic">Secretary Navy:</hi></p>
                <p>Frolic left the Battery last night at 8 o’clock p.m.</p>
                <closer>
                    <signed>S. W. GODON,<lb/><hi rendition="#italic">Commandant.</hi></signed>
                </closer>
            </div>
