    <text>
        <body>
            <div xml:id="d492">

                <pb facs="0859" n="845" sameAs="frus:frus1872p2v1/pg845"/>

                <head>
                    <hi rendition="#italic">Mr. Boutwell, Secretary
                        of the Treasury, to Mr. Rumley,
                        collector.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <dateline><placeName><hi rendition="#small-caps">Treasury Department</hi>,<lb/><hi
                            rendition="#italic">Washington, D. C.</hi></placeName>, <date
                        calendar="gregorian" when="1869-10-07"><hi rendition="#italic">October</hi>
                        7, 1869</date>.</dateline>
                <p rendition="#flush"><hi rendition="#small-caps">D. Rumley</hi>, <hi
                        rendition="#italic">Collector of Customs, Wilmington, North
                    Carolina:</hi></p>
                <p><seg type="margin">[173]</seg> I have ordered the steam revenue-cutter McCulloch,
                    at *Savannah, to proceed to Wilmington, and report to you for orders.</p>
                <closer>
                    <signed>GEO. S. BOUTWELL,<lb/><hi rendition="#italic">Secretary of
                            Treasury.</hi></signed>
                </closer>
            </div>
        </body>
