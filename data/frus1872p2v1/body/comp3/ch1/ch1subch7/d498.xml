    <text>
        <body>
            <div xml:id="d498">

                <pb facs="0863" n="849" sameAs="frus:frus1872p2v1/pg849"/>

                <head>
                    <hi rendition="#italic">Mr. Starbuck, district
                        attorney, to Mr. Soar, Attorney-General.</hi>
                </head>
                <dateline><placeName><hi rendition="#small-caps">Office of United States
                            Attorney</hi>,<lb/><hi rendition="#italic">Salem, North
                        Carolina</hi></placeName>, <date calendar="gregorian" when="1869-10-11"><hi
                            rendition="#italic">October</hi> 11, 1869</date>.</dateline>
                <p><seg type="margin">[179]</seg>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the
                    receipt of your letter concerning the steamer Hornet, detained in the port of
                    Wilmington, *and the case will soon undergo an investigation before the United
                    States commissioner, which I trust will develop the true character of the
                    vessel; then such proceedings will be instituted as the facts may warrant.</p>
                <p>I am, sir, very respectfully,</p>
                <closer>
                    <signed>D. H. STARBUCK,<lb/><hi rendition="#italic">United States
                        Attorney.</hi></signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">E. R. Hoar</hi>,<lb/><hi rendition="#italic"
                            >Attorney-General.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
