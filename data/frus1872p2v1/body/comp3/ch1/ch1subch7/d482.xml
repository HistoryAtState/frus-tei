                <pb facs="0856" n="842" sameAs="frus:frus1872p2v1/pg842"/>

                <head>
                    <hi rendition="#italic">General Sherman, Acting
                        Secretary of War, to commanding officer.</hi>
                </head>
                <dateline><placeName><hi rendition="#small-caps">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1869-10-04"><hi rendition="#italic">October</hi>
                        4, 1869</date>.</dateline>
                <p rendition="#flush">To <hi rendition="#small-caps">Commanding
                        Officer</hi>,<lb/><hi rendition="#italic">Fort Johnson, via Wilmington,
                        North Carolina:</hi></p>
                <p>Use your entire force to detain the steamer Lady Sterling, <hi
                        rendition="#italic">alias</hi> Hornet, till she is furnished a regular
                    clearance by the collector of the port.</p>
                <closer>
                    <signed>W. T. SHERMAN,<lb/><hi rendition="#italic">General, and Acting Secretary
                            of War.</hi></signed>
                </closer>
            </div>
        </body>
