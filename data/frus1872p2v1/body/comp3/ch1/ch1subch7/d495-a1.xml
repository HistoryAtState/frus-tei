            <div xml:id="d495-a1">

                <pb facs="0862" n="848" xml:id="pg848"/>

                <opener>
                    <seg rendition="#center">[Inclosure No. 1.]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">Rear-Admiral Godon to
                        Vice-Admiral Porter, Acting Secretary of
                        Navy</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <dateline><placeName><hi rendition="#small-caps">Brooklyn, New
                    York</hi></placeName>, <date calendar="gregorian" when="1869-10-07"><hi
                            rendition="#italic">October</hi> 7, 1869</date>.</dateline>
                <p rendition="#flush">To <hi rendition="#small-caps">Secretary of the Navy</hi>:</p>
                <p>Telegram received. The Frolic will sail by 8 o’clock.</p>
                <closer>
                    <signed>S. W. GODON,<lb/><hi rendition="#italic">Rear Admiral.</hi></signed>
                </closer>
            </div>
        </body>
