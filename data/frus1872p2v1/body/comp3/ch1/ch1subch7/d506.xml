    <text>
        <body>
            <div xml:id="d506">

                <pb facs="0867" n="853" sameAs="frus:frus1872p2v1/pg853"/>

                <head>
                    <hi rendition="#italic">Mr. Field, Assistant Attorney-General, to Mr. Phelps,
                        assistant district attorney.</hi>
                </head>
                <dateline><placeName><hi rendition="#small-caps">Department of Justice</hi>,<lb/><hi
                            rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1869-11-23"><hi rendition="#italic">November</hi>
                        23, 1869</date>.</dateline>
                <opener>
                    <seg rendition="#center"><seg type="margin">[188]</seg> *[Telegram.]</seg>
                </opener>
                <p rendition="#flush"><hi rendition="#small-caps">Benj. K. Phelps</hi>,<lb/><hi
                        rendition="#italic">Assistant United States Attorney, New Yorlc
                    City:</hi></p>
                <p>Go to Raleigh; oppose bonding of steamer Hornet and all recognition by the court
                    of any “republic of Cuba.”</p>
                <closer>
                    <signed>W. A. FIELD,<lb/><hi rendition="#italic">Assistant
                            Attorney-General.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
