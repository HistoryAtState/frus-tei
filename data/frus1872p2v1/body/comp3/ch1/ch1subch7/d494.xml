                <pb facs="0860" n="846" sameAs="frus:frus1872p2v1/pg846"/>

                <head>
                    <hi rendition="#italic">Mr. Porter, Vice-Admiral, to the President.</hi>
                </head>
                <dateline><placeName><hi rendition="#small-caps">Navy Department</hi>,<lb/><hi
                            rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1869-10-07"><hi rendition="#italic">October</hi>
                        7, 1869</date>.</dateline>
                <p><hi rendition="#small-caps">Sir</hi>: The inclosed telegrams have been sent in
                    different directions.</p>
                <p>I have the honor to be, very respectfully,</p>
                <closer>
                    <signed>DAVID D. PORTER,<lb/><hi rendition="#italic">Vice-Admiral.</hi></signed>
                </closer>
                <postscript>
                    <p>The <hi rendition="#small-caps">President.</hi></p>
                </postscript>





