    <text>
        <body>
            <div xml:id="d469">

                <pb facs="0847" n="833" sameAs="frus:frus1872p2v1/pg833"/>

                <head>
                    <hi rendition="#italic">Mr. Harlow, United States deputy marshal, to Mr. Fish,
                        Secretary of State.</hi>
                </head>
                <dateline><placeName><hi rendition="#small-caps">United States Marshal’s Office,
                            Southern District of New York</hi>,<lb/><hi rendition="#italic">New
                            York</hi></placeName>, <date calendar="gregorian" when="1869-08-19"><hi
                            rendition="#italic">August</hi> 19, 1869</date>.</dateline>
                <p><hi rendition="#small-caps">Sir</hi>: Inclosed please find all the information I
                    have relative to the Hornet. As the Attorney-General made the same request for
                    information as the State Department, would it not be well for that officer to
                    see the inclosed statement from our detectives?</p>
                <p>I have the honor to be, sir, very respectfully, &amp;c.,</p>
                <closer>
                    <signed>S. R. HARLOW,<lb/><hi rendition="#italic">Deputy Marshal.</hi></signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">Hamilton Fish</hi>,<lb/><hi
                            rendition="#italic">Secretary of State</hi>,</p>
                </postscript>



                <xi:include href="d469-a1.xml" xpointer="d469-a1"/>
            </div>
        </body>
    </text>
