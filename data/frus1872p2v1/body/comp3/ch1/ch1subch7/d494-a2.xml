    <text>
        <body>
            <div xml:id="d494-a2">

                <pb facs="0861" n="847" xml:id="pg847"/>

                <opener>
                    <seg rendition="#center">[Inclosure No. 2.]</seg>
                </opener>
                <head><hi rendition="#italic">Vice-Admired Porter
                        to commanding officer at Key West</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <dateline><placeName><hi rendition="#small-caps">Navy Department</hi>.<lb/><seg
                            type="margin">[175]</seg> *<hi rendition="#italic"
                        >Washington</hi></placeName>, <date calendar="gregorian" when="1869-10-07"
                            ><hi rendition="#italic">October</hi> 7, 1869</date>.</dateline>
                <p>Dispatch the fastest vessel you have without delay to Cape Fear River, North
                    Carolina, to prevent the steamer Cuba from going to sea. Sink her if the captain
                    refuses to obey your orders.</p>
                <closer>
                    <signed>D. D. PORTER,<lb/><hi rendition="#italic">Vice-Admiral.</hi></signed>
                </closer>
                <postscript>
                    <p><hi rendition="#small-caps">Commanding Officer</hi><lb/><hi
                            rendition="#italic">United States Naval Forces, Key West,
                        Florida</hi>.</p>
                </postscript>
            </div>
        </body>
    </text>
