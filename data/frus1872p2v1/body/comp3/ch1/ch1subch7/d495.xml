    <text>
        <body>
            <div xml:id="d495">

                <pb facs="0861" n="847" sameAs="frus:frus1872p2v1/pg847"/>

                <head><seg type="margin">[176]</seg> *<hi rendition="#italic">Vice-Admiral Porter to
                        the President</hi></head>
                <dateline><placeName><hi rendition="#small-caps">Navy Department</hi>,<lb/><hi
                            rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1869-10-08"><hi rendition="#italic">October</hi>
                        8, 1869</date>.</dateline>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to send herewith a copy of
                    a telegram received this a.m. from Rear-Admiral Godon, commandant of navy-yard,
                    New York, dated 7th instant, and copies of two telegrams from Commander Queen,
                    senior officer at Key West.</p>
                <p>Very respectfully, your obedient servant,</p>
                <closer>
                    <signed>DAVID D. PORTER,<lb/><hi rendition="#italic">Vice-Admiral.</hi></signed>
                </closer>
                <postscript>
                    <p>The <hi rendition="#small-caps">President.</hi></p>
                </postscript>




