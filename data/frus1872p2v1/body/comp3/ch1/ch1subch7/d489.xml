    <text>
        <body>
            <div xml:id="d489">

                <pb facs="0859" n="845" xml:id="pg845"/>

                <head>
                    <hi rendition="#italic">Mr. Porter, for Secretary of the Navy, to Mr. Fish,
                        Secretary of State.</hi>
                </head>
                <dateline><placeName><hi rendition="#small-caps">Navy Department</hi>,<lb/><hi
                            rendition="#italic">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1869-10-07"><hi rendition="#italic">October</hi>
                        7, 1869</date>.</dateline>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your three letters, two of the 4th, and the other of the 5th instant,
                    inclosing copies of communications from General F. C. Barlow, United States
                    marshal at New York, relative to the movements of hostile expeditions.</p>
                <p>Very respectfully,</p>
                <closer>
                    <signed>DAVID D. PORTER,<lb/><hi rendition="#italic">For Secretary of the
                            Navy.</hi></signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">Hamilton Fish</hi>,<lb/><hi
                            rendition="#italic">Secretary of State.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
