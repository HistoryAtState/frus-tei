                <pb facs="0846" n="832" sameAs="frus:frus1872p2v1/pg832"/>

                <head><seg type="margin">[146]</seg> *<hi rendition="#italic">Mr. Field, Acting Attorney-General, to Mr. Barlow, United States marshal.</hi></head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <dateline><placeName><hi rendition="#small-caps">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1869-08-18"><hi rendition="#italic">August</hi>
                        18, 1869</date>.</dateline>
                <p rendition="#flush"><hi rendition="#small-caps">F. C. Barlow</hi>, Esq., <hi
                        rendition="#italic">United States Marshal, New York City:</hi></p>
                <p>Have you any important facts about the steamer Hornet?</p>
                <closer>
                    <signed>W. A. FIELD,<lb/><hi rendition="#italic">Acting
                        Attorney-General.</hi></signed>
                </closer>
            </div>
        </body>
