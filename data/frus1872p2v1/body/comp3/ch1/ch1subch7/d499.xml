    <text>
        <body>
            <div xml:id="d499">

                <pb facs="0863" n="849" sameAs="frus:frus1872p2v1/pg849"/>

                <head>
                    <hi rendition="#italic">Messrs. Parson &amp;
                            French, attorneys for the United States, to Mr. Hoar, Attorney-General.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <dateline><placeName><hi rendition="#small-caps">Wilmington, North
                        Carolina</hi></placeName>, <date calendar="gregorian" when="1869-10-09"><hi
                            rendition="#italic">October</hi> 9, 1869</date>.</dateline>
                <p rendition="#flush">Hon. <hi rendition="#small-caps">E. R. Hoar</hi>, <hi
                        rendition="#italic">Attorney-General:</hi></p>
                <p>District attorney is not here. There is no telegraph. Mr. Hall should be here, we
                    think.</p>
                <closer>
                    <signed>PARSON &amp; FRENCH.</signed>
                </closer>
            </div>
        </body>
    </text>
