            <div xml:id="d472">

                <pb facs="0851" n="837" xml:id="pg837"/>

                <head><seg type="margin">[156]</seg> *<hi rendition="#italic">Mr. Field, Acting Attorney-General, to Mr. Davis, Acting Secretary of State.</hi></head>
                <dateline><placeName><hi rendition="#small-caps">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1869-08-19"><hi rendition="#italic">August</hi>
                        19, 1869</date>.</dateline>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith a
                    letter from the assistant United States attorney at Phildelphia, with an
                    inclosure, relating to the case of the steamer Hornet, which you are requested
                    to return when you have done with it.</p>
                <p>Very respectfully, &amp;c.,</p>
                <closer>
                    <signed>W. A. FIELD,<lb/><hi rendition="#italic">Acting
                        Attorney-General.</hi></signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">J. C. B. Davis</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary of State.</hi></p>
                </postscript>



                <xi:include href="d472-a1.xml" xpointer="d472-a1"/>
