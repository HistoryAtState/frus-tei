    <text>
        <body>
            <div xml:id="d240">

                <pb facs="0718" n="704" sameAs="frus:frus1872p2v1/pg704"/>

                <head><seg type="margin">[692]</seg> *<hi rendition="#italic">Commandant Newton,
                        United States Navy, to Commander Randolph, United States Navy.</hi></head>
                <dateline><placeName><hi rendition="#small-caps">Commandant’s Office</hi>,<lb/><hi
                            rendition="#italic">Navy-Yard, Pensacola</hi></placeName>, <date
                        calendar="gregorian" when="1849-08-17"><hi rendition="#italic">August</hi>
                        17, 1849</date>.</dateline>
                <p><hi rendition="#small-caps">Sir</hi>: You will prepare the United States
                    sloop-of-war Albany, under your command, for sea with all possible dispatch.</p>
                <p>I am, very respectfully, your obedient servant,</p>
                <closer>
                    <signed>
                        <list>
                            <item>JOHN THOMAS NEWTON,<lb/><hi rendition="#italic"
                                >Commandant.</hi></item>
                            <item>Commodore <hi rendition="#small-caps">V. M. Randolph</hi>,<lb/><hi
                                    rendition="#italic">Commanding United States Ship
                                    Albany,<lb/>Off Navy-Yard, Pensacola.</hi></item>
                        </list>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
