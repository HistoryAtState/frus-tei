    <text>
        <body>
            <div xml:id="d242">

                <pb facs="0719" n="705" sameAs="frus:frus1872p2v1/pg705"/>

                <head>
                    <hi rendition="#italic">Commandant Newton,
                        United States Navy, to Lieutenant-Commander Totten, United States Navy.</hi>
                </head>
                <dateline><placeName><hi rendition="#small-caps">Commandant’s Office</hi>,<lb/><hi
                            rendition="#italic">Navy Yard, Pensacola</hi></placeName>, <date
                        calendar="gregorian" when="1849-08-19"><hi rendition="#italic">August</hi>
                        19, 1849</date>.</dateline>
                <p><hi rendition="#small-caps">Sir</hi>: It is of the utmost government importance
                    that the steamer under your command should be prepared for active service with
                    as little delay as possible. You will be pleased, therefore, to have ready, and,
                    if possible, to go to sea some time during the day to-morrow.</p>
                <p><seg type="margin">[694]</seg> *I am, very respectfully, &amp;c.,</p>
                <closer>
                    <signed>
                        <list>
                            <item>JOHN THOMAS NEWTON,<lb/><hi rendition="#italic"
                                >Commandant.</hi></item>
                            <item>Lieutenant-Commandant <hi rendition="#small-caps">George M.
                                    Totten</hi>,<lb/><hi rendition="#italic">Commanding Steamer
                                    Water Witch, Off Navy Yard, Pensacola.</hi></item>
                        </list>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
