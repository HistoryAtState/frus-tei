    <text>
        <body>
            <div xml:id="d223">

                <pb facs="0437" n="409" xml:id="pg409"/>

                <head>223. Memorandum From Director of Central Intelligence Helms to President Johnson<anchor n="1" xml:id="d223-f1"/>
                </head>
                <opener><dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            when="1967-08-17">August 17, 1967</date>.</dateline></opener>
                <list>
                    <label>1.</label>
                    <item>[<hi rendition="#italic">5 lines of source text not declassified</hi>] We
                        thought the Shah’s mood as reflected in the most recent conversation would
                        be of interest to you in light of his visit with you here next week.</item>
                    <label>2.</label>
                    <item>I have not sent copies of this cable to anyone other than you [<hi
                            rendition="#italic">1½ lines of source text not
                        declassified</hi>].</item>
                </list>
                <closer>
                    <signed>
                        <hi rendition="#bold">
                            Richard Helms
                        </hi><anchor n="2" xml:id="d223-f2"/>
                    </signed>
                </closer>


                <xi:include href="d223-a1.xml" xpointer="d223-a1"/>
            </div>
        </body>
    </text>
