    <text>
        <body>
            <div xml:id="d189">

                <pb facs="0360" n="272" xml:id="pg272"/>

                <note rend="inline" type="source">763.72119/2669</note>
                <head>
                    <hi rendition="#italic">President Wilson to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1918-11-16">16 November,
                            1918</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: My interest in the
                    Armenians is profound and my sympathy for them really poignant, and I hope that
                    you will through the proper channels reply to the enclosed that in every way we
                    will do what we can.</p>
                <p>Cordially and sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Woodrow Wilson</hi>
                    </signed>
                </closer>


                <xi:include href="d189-a1.xml" xpointer="d189-a1"/>
