    <text>
        <body>
            <div xml:id="d183">

                <pb facs="0351" n="263" xml:id="pg263"/>

                <note rend="inline" type="source">Paris Peace Conf. 183.9 Bulgaria/2:
                    Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in Bulgaria</hi> (<hi
                            rendition="#italic">Wilson</hi>) <hi rendition="#italic">to
                        the Commission to Negotiate Peace
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Sofia</hi>
                        </placeName>, <date calendar="gregorian" when="1918-12-30T23:00:00+02:00"
                            >December 30, 1918—11 p.m.</date>
                        <lb/> [Received January 3, 1919—10 p.m.]</dateline>
                </opener>
                <p>5. 6, December 16, 11 a.m. [<hi rendition="#italic">12 a.m.?</hi>], to American
                    Embassy Paris. Would be grateful if some reply could be made to Bulgarian
                    request for permission to send delegates unofficially to Paris. Am in receipt of
                    daily inquiries from Bulgarian Government as to decision of my Government.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wilson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
