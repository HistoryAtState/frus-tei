    <text>
        <body>
            <div xml:id="d443">

                <pb facs="0614" n="526" sameAs="frus:frus1919Parisv02/pg526"/>

                <note rend="inline" type="source">Paris Peace Conf. 762.94/2</note>
                <head>
                    <hi rendition="#italic">President Wilson to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi>
                        </placeName>, <date calendar="gregorian" when="1919-01-10">10 January,
                            1919</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I am quite willing to
                    cooperate with the Allies in this matter<anchor n="30" xml:id="d443-f1"/> and
                    hope that you will do so in the appropriate way.</p>
                <p>Cordially and sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Woodrow Wilson</hi>
                    </signed>
                </closer>


                <xi:include href="d443-a1.xml" xpointer="d443-a1"/>
            </div>
        </body>
    </text>
