    <text>
        <body>
            <div xml:id="d38">

                <pb facs="0138" n="50" sameAs="frus:frus1919Parisv02/pg50"/>

                <note rend="inline" type="source">763.72119/2994</note>
                <head>
                    <hi rendition="#italic">The Assistant Secretary of the Treasury</hi> (<hi rendition="#italic">Rathbone</hi>) <hi
                        rendition="#italic">to the Acting Secretary of
                            State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1918-12-12">December 12,
                            1918</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Polk</hi>: I have the honor to enclose to
                    you herewith the copy of a letter which I have this day received from Mr. de
                    Billy, Deputy French High Commissioner, advising of the receipt of the Bank of
                    France of 91,000 kilograms of gold representing all or part of the gold payments
                    made by Russia to the German Government under the terms of the Brest-Litovsk
                        Treaty.<anchor n="24" xml:id="d38-f1"/>
                </p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Arthur Rathbone</hi>
                    </signed>
                </closer>


                <xi:include href="d38-a1.xml" xpointer="d38-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d38-f1" n="24" xml:id="d38-f1-content">
                <p>For text of treaty, see <ref target="frus1918Russiav01#pg_442">
                        <hi rendition="#italic">Foreign Relations</hi>, 1918, Russia, vol. <hi
                            rendition="#small-caps">i</hi>, p. 442</ref>.</p>
            </note>
