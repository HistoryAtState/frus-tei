    <text>
        <body>
            <div xml:id="d55">

                <pb facs="0154" n="66" sameAs="frus:frus1919Parisv02/pg66"/>

                <note rend="inline" type="source">763.72119/3484</note>
                <head>
                    <hi rendition="#italic">The British Chargé</hi> (<hi rendition="#italic"
                        >Barclay</hi>) <hi rendition="#italic">to the Acting Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 67</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1919-01-23">January 23,
                            1919</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honour to transmit to you,
                    herewith, by direction of my Government, a letter signed by Admiral Sir Rosslyn
                    Wemyss, together with a report of the Allied Naval Mission appointed to ensure
                    the execution of Article 28 of the conditions of Armistice with Germany.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Colville Barclay</hi>
                    </signed>
                </closer>



                <xi:include href="d55-a1.xml" xpointer="d55-a1"/>
                <xi:include href="d55-a2.xml" xpointer="d55-a2"/>
