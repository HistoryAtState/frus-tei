    <text>
        <body>
            <div xml:id="d26">

                <pb facs="0124" n="36" sameAs="frus:frus1919Parisv02/pg36"/>

                <note rend="inline" type="source">763.72119/2825</note>
                <head>
                    <hi rendition="#italic">The Swiss Minister</hi> (<hi rendition="#italic"
                        >Sulzer</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1918-11-27">November 27,
                            1918</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: By direction of my Government, I have the
                    honor to transmit to your Excellency the original text of a communication from
                    the German Government, received by this Legation this morning.</p>
                <p>A translation of this communication is likewise enclosed.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hans Sulzer</hi>
                    </signed>
                </closer>


                <xi:include href="d26-a1.xml" xpointer="d26-a1"/>
            </div>
