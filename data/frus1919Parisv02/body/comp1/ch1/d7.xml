    <text>
        <body>
            <div xml:id="d7">

                <pb facs="0109" n="21" xml:id="pg21"/>

                <note rend="inline" type="source">763.72119/2715</note>
                <head>
                    <hi rendition="#italic">The Swiss Minister</hi> (<hi
                            rendition="#italic">Sulzer</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1918-11-19">November 19,
                            1918</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: By direction of my Government, I have the
                    honor to transmit to your Excellency the original text of a communication of the
                    Government of the Republic of Bavaria.</p>
                <p>A translation of this communication is also enclosed.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hans Sulzer</hi>
                    </signed>
                </closer>


                <xi:include href="d7-a1.xml" xpointer="d7-a1"/>
            </div>
