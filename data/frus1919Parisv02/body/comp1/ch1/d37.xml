    <text>
        <body>
            <div xml:id="d37">

                <pb facs="0137" n="49" xml:id="pg49"/>

                <note rend="inline" type="source">Paris Peace Conf. 185.001/11</note>
                <head>
                    <hi rendition="#italic">The Minister in Switzerland</hi> (<hi
                        rendition="#italic">Stovall</hi>) <hi rendition="#italic">to the Commission
                        to Negotiate Peace </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 11</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berne</hi>
                        </placeName>, <date calendar="gregorian" when="1918-12-11">December 11,
                            1918</date>.<lb/>[Received December 18.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sirs</hi>: I have the honor to transmit herewith for
                    your consideration copies of a translation of a protest addressed to the
                    associated Governments by Dr. Solf, Secretary of State of the German Foreign
                    Office, objecting to certain measures which Marshal Foch is alleged to have
                    taken in regard to evacuating certain occupied territories on the left bank of
                    the Rhine. I beg to add that the enclosed documents were transmitted to the
                    Legation under cover of a note from the Swiss Political Department dated
                    December 10, 1918.<anchor n="23" xml:id="d37-f1"/>
                </p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Pleasant A. Stovall</hi>
                    </signed>
                </closer>


                <xi:include href="d37-a1.xml" xpointer="d37-a1"/>
            </div>
        </body>
    </text>
