    <text>
        <body>
            <div xml:id="d52">

                <pb facs="0149" n="61" sameAs="frus:frus1919Parisv02/pg61"/>

                <note rend="inline" type="source">Paris Peace Conf. 850e.00/2</note>
                <head>
                    <hi rendition="#italic">The Chargé in Switzerland</hi> (<hi rendition="#italic">Wilson</hi>) <hi rendition="#italic"
                        >to the Commission to Negotiate Peace
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 87</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berne</hi>
                        </placeName>, <date calendar="gregorian" when="1919-01-11">January 11,
                            1919</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sirs</hi>: I have the honor to transmit herewith for
                    your information a copy and translation of a note from the Swiss Political
                    Department, <pb facs="0150" n="62" xml:id="pg62"/> dated January ninth 1919,
                    enclosing a communication from the German Legation regarding the measures which
                    are said to have been taken by the French Authorities in regard to Alsace
                    Lorraine.</p>
                <p>I beg to add that copies of the enclosed note are being sent to the Department of
                    State.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hugh R. Wilson</hi>
                    </signed>
                </closer>



                <xi:include href="d52-a1.xml" xpointer="d52-a1"/>
