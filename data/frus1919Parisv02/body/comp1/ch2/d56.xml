    <text>
        <body>
            <div xml:id="d56">

                <pb facs="0159" n="71" sameAs="frus:frus1919Parisv02/pg71"/>

                <note rend="inline" type="source">763.72119/2804</note>
                <head>
                    <hi rendition="#italic">The Swiss Minister</hi> (<hi
                            rendition="#italic">Sulzer</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1918-11-26">November 26,
                            1918</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I am directed by my Government to inform
                    your Excellency that the German Government would be grateful to receive an early
                    reply from the United States and Allied Governments to its communication
                    regarding negotiations for a preliminary peace, which communication I had the
                    honor to transmit to your Excellency with my note of November 13, 1918.<anchor
                        n="1" xml:id="d56-f1"/>
                </p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hans Sulzer</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d56-f1" n="1" xml:id="d56-f1-content">
                <p>For text of the note of Nov. 13, see telegram No. 29, Dec. 14, 5 p.m., to the
                    Commission to Negotiate Peace, <ref target="#pg72">p. 72</ref>.</p>
            </note>
        </listAnnotation>
