    <text>
        <body>
            <div xml:id="d528">

                <pb facs="0731" n="643" xml:id="pg643"/>

                <note rend="inline" type="source">840.48/2598: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Special
                        Representative</hi> (<hi rendition="#italic">House</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1918-11-29T15:00:00-05:00"
                            >November 29, 1918—3 p.m.</date>
                    </dateline>
                </opener>
                <p>90. Your No. 188.<anchor n="16" xml:id="d528-f1"/> On the assumption that Mr.
                    Hoover agrees, the President authorizes you to propose the plan set forth.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
