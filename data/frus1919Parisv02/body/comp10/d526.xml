    <text>
        <body>
            <div xml:id="d526">

                <pb facs="0729" n="641" sameAs="frus:frus1919Parisv02/pg641"/>

                <note rend="inline" type="source">840.48/2598</note>
                <head>
                    <hi rendition="#italic">President Wilson to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1918-11-28">28 November,
                            1918</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: Will you not be kind
                    enough (unless you know some reason to the contrary) to send House word at once
                    that he may propose the plan here set forth<anchor n="14" xml:id="d526-f1"/> (I
                    presume it will not be necessary to repeat the text to him), stating that we
                    understand that Hoover agrees?</p>
                <p>Faithfully Yours,</p>
                <closer>
                    <signed>[<hi rendition="#small-caps">Woodrow Wilson</hi>]</signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d526-f1" n="14" xml:id="d526-f1-content">
                <p>See telegram No. 188, Nov. 27, 1918, 11 p.m., from Colonel House, <ref
                        target="#pg636">p. 636</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
