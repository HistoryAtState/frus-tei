    <text>
        <body>
            <div xml:id="d516">

                <pb facs="0719" n="631" sameAs="frus:frus1919Parisv02/pg631"/>

                <note rend="inline" type="source">Woodrow Wilson Papers</note>
                <head>
                    <hi rendition="#italic">The Food Administrator</hi> (<hi rendition="#italic"
                        >Hoover</hi>) <hi rendition="#italic">to President Wilson </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1918-11-14">November 14,
                            1918</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. President</hi>: I enclose herewith copy of
                    the cablegram which I have dispatched to Mr. Cotton in accordance with your
                    suggestion.</p>
                <p>Faithfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Herbert Hoover</hi>
                    </signed>
                </closer>


                <xi:include href="d516-a1.xml" xpointer="d516-a1"/>
