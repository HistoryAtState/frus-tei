    <text>
        <body>
            <div xml:id="d580">

                <pb facs="0783" n="695" sameAs="frus:frus1919Parisv02/pg695"/>

                <note rend="inline" type="source">Hunter Miller Papers</note>
                <head>
                    <hi rendition="#italic">The Food Administrator</hi> (<hi
                            rendition="#italic">Hoover</hi>) <hi rendition="#italic">to
                        Colonel E. M. House
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi>
                        </placeName>, <date calendar="gregorian" when="1919-01-02">2 January,
                            1919</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Colonel</hi>: Please find enclosed herewith
                    copy of letters which I have dispatched to the three Food Ministers. I believe
                    it is desirable that you should send these under covering letter from yourself
                    to the Ministries of Foreign Affairs and ask them to draw the attention of their
                    highest officials thereto.</p>
                <p>Yours faithfully,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Herbert Hoover</hi>
                    </signed>
                </closer>


                <xi:include href="d580-a1.xml" xpointer="d580-a1"/>
            </div>
        </body>
    </text>
