    <text>
        <body>
            <div xml:id="d704">

                <pb facs="0883" n="795" sameAs="frus:frus1919Parisv02/pg795"/>

                <note rend="inline" type="source">600.119/2009b: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in Great
                        Britain</hi> (<hi rendition="#italic">Davis</hi>)<anchor n="67"
                        xml:id="d704-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1919-01-13">January 13,
                            1919</date>.</dateline>
                </opener>
                <p>For Sheldon [from War Trade Board]: No. 2050. Applications for export licenses to
                    Allied countries are no longer being referred to the Allied Missions here.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Polk</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d704-f1" n="67" type="source" xml:id="d704-f1-content">
                <p>The same, on same date, to Embassies in France (for McFadden, No. 587, for
                    Taylor) and in Italy (for Stewart, No. 62).</p>
            </note>
        </listAnnotation>
    </standOff>
