    <text>
        <body>
            <div xml:id="d485">

                <pb facs="0659" n="571" sameAs="frus:frus1919Parisv02/pg571"/>

                <note rend="inline" type="source">Paris Peace Conf. 855.51/5</note>
                <head>
                    <hi rendition="#italic">President Wilson to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi>
                        </placeName>, <date calendar="gregorian" when="1919-01-17">17 January,
                            1919</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I would be obliged if
                    you would, as you suggest, reply to this<anchor n="34" xml:id="d485-f1"/> in the
                    sense suggested by General Bliss.</p>
                <p>Cordially and sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Woodrow Wilson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d485-f1" n="34" xml:id="d485-f1-content">
                <p>See Secretary Lansing’s letter of Jan. 14, regarding proposed loans to Belgium,
                        <ref target="#pg567">p. 567</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
