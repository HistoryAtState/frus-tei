                <pb facs="0463" n="375" sameAs="frus:frus1919Parisv02/pg375"/>

                <note rend="inline" type="source">Paris Peace Conf. 875.00/32</note>
                <head>
                    <hi rendition="#italic">The Embassy in France to the
                            Commission to Negotiate Peace
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi>
                        </placeName>, <date calendar="gregorian" when="1919-01-09">January 9,
                            1919</date>.</dateline>
                </opener>
                <p>The American Embassy in Paris presents its compliments to the American Commission
                    to Negotiate Peace, and has the honor to transmit herewith copy and translation
                    of a note of December 30th 1918 from the Italian Embassy concerning the present
                    situation in Albania.</p>


                <xi:include href="d301-a1.xml" xpointer="d301-a1"/>
