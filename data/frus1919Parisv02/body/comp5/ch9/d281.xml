    <text>
        <body>
            <div xml:id="d281">

                <pb facs="0446" n="358" sameAs="frus:frus1919Parisv02/pg358"/>

                <note rend="inline" type="source">873.00/33</note>
                <head>
                    <hi rendition="#italic">The Secretary of the Montenegrin Legation</hi>
                        (<hi rendition="#italic">Matanovitch</hi>)
                        <hi rendition="#italic">to the Acting Secretary of
                            State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 145</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1918-12-24">December 24,
                            1918</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to send you, herewith, a
                    copy of a cablegram received today by the Legation from the Montenegrin
                    Government.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">G. Matanovitch</hi>
                    </signed>
                </closer>


                <xi:include href="d281-a1.xml" xpointer="d281-a1"/>
