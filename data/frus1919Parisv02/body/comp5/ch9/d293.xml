    <text>
        <body>
            <div xml:id="d293">

                <pb facs="0458" n="370" sameAs="frus:frus1919Parisv02/pg370"/>

                <note rend="inline" type="source">Robert Lansing Papers</note>
                <head>
                    <hi rendition="#italic">President Wilson to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi>
                        </placeName>, <date calendar="gregorian" when="1919-01-11">11 January,
                            1919</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: King Nicholas of
                    Montenegro is seeking an interview with me. I would very much value a tip from
                    you and your fellow Commissioners as to whether it would be wise or serviceable
                    for me to give him an audience.</p>
                <p>Cordially and faithfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Woodrow Wilson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
