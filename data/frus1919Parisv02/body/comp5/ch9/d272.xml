    <text>
        <body>
            <div xml:id="d272">

                <pb facs="0436" n="348" sameAs="frus:frus1919Parisv02/pg348"/>

                <note rend="inline" type="source">873.00/28</note>
                <head>
                    <hi rendition="#italic">The Montenegrin Minister</hi> (<hi rendition="#italic"
                        >Gvosdenovitch</hi>) <hi rendition="#italic">to the Assistant Secretary of
                        State</hi> (<hi rendition="#italic">Phillips</hi>)</head>
                <opener>
                    <seg rendition="#center">[Translation]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 124</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1918-12-04">December 4,
                            1918</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Sir</hi>: I have the honor to forward herewith
                    to you a copy of a dispatch which I have just received from my Government.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <hi rendition="#small-caps">General</hi>
                    <signed>
                        <hi rendition="#small-caps">A. Gvosdenovitch</hi>
                    </signed>
                </closer>


                <xi:include href="d272-a1.xml" xpointer="d272-a1"/>
            </div>
