    <text>
        <body>
            <div xml:id="d389">

                <pb facs="0533" n="445" sameAs="frus:frus1919Parisv02/pg445"/>

                <note rend="inline" type="source">763.72119/3672</note>
                <head>
                    <hi rendition="#italic">The Minister in the Netherlands</hi> (<hi rendition="#italic">Garrett</hi>) <hi
                        rendition="#italic">to the Acting Secretary of
                            State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. Lux. 12</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">The Hague</hi>
                        </placeName>, <date calendar="gregorian" when="1919-01-11">January 11,
                            1919</date>.<lb/>[Received February 7.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to my telegram No. 5609 of
                    January 9th [<hi rendition="#italic">4th</hi>],<anchor n="12" xml:id="d389-f1"/>
                    I have the honor to transmit herewith for such action as may be deemed
                    appropriate, copy and translation of a note received yesterday from Mr. E.
                    Reuter, Minister for Foreign Affairs of the Grand Duchy of Luxembourg, under
                    date of December 31, 1918, informing me that the Government of the Grand Duchy
                    had denounced the conventions with Germany of November 11, 1902,<anchor n="13"
                        xml:id="d389-f2"/> as well as the treaty with Germany 20th/25th of October
                        1865.<anchor n="14" xml:id="d389-f3"/>
                </p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">J. W. Garrett</hi>
                    </signed>
                </closer>



                <xi:include href="d389-a1.xml" xpointer="d389-a1"/>
            </div>
        </body>
    </text>
