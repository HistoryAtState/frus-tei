    <text>
        <body>
            <div xml:id="d216-a1">

                <pb facs="0386" n="298" sameAs="frus:frus1919Parisv02/pg298"/>

                <opener>
                    <seg rendition="#center">[Enclosure—Translation]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">The President of the National Council of Zagreb</hi>
                        (<hi rendition="#italic">Korosec</hi>) <hi rendition="#italic">to the
                        American Minister in Switzerland</hi> (<hi rendition="#italic"
                    >Stovall</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berne</hi>
                        </placeName>, <date calendar="julian gregorian" when="1918-11-11">October
                            29/November 11, 1918</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to ask you to be so good
                    as to bring the enclosed protest to the knowledge of the government of the
                    United States of America.</p>
                <pb facs="0387" n="299" xml:id="pg299"/>
                <p>An analogous note will be presented by the government of His Majesty the King of
                    Servia.</p>
                <p>In thanking you for your kindness, I beg you [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">D. Korosec</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
