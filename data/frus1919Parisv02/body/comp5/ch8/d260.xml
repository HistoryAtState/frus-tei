    <text>
        <body>
            <div xml:id="d260">

                <pb facs="0429" n="341" sameAs="frus:frus1919Parisv02/pg341"/>

                <note rend="inline" type="source">763.72/12649</note>
                <head>
                    <hi rendition="#italic">The Chargé in France</hi> (<hi rendition="#italic"
                        >Bliss</hi>) <hi rendition="#italic">to the Acting Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 6889</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi>
                        </placeName>, <date calendar="gregorian" when="1918-12-26">December 26,
                            1918</date>.<lb/>[Received January 9, 1919.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose, in copy and
                    translation, a protest addressed by the Yougo-Slav Assembly to the Allied Powers
                    against the occupation by the Italian naval forces of certain territory claimed
                    by the Yougoslav nation.</p>
                <p>Copies of this protest have been forwarded to Colonel House’s mission.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Woods Bliss</hi>
                    </signed>
                </closer>


                <xi:include href="d260-a1.xml" xpointer="d260-a1"/>
            </div>
        </body>
    </text>
