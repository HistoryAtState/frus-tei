    <text>
        <body>
            <div xml:id="d244">

                <pb facs="0410" n="322" xml:id="pg322"/>

                <note rend="inline" type="source">Paris Peace Conf. 186.3411/93</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Italy</hi> (<hi
                            rendition="#italic">Page</hi>) <hi rendition="#italic">to the
                            Acting Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1087</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Rome</hi>
                        </placeName>, <date calendar="gregorian" when="1918-12-06">December 6,
                            1918</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith a
                    letter which has been handed to me by Mr. Roberto Ghiglianovich, Deputy to the
                    Dalmatian Diet. This letter sets forth the conditions at Spalato and the
                    indispensable occupation of that place by Allied troops.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Thomas Nelson Page</hi>
                    </signed>
                </closer>


                <xi:include href="d244-a1.xml" xpointer="d244-a1"/>
            </div>
        </body>
    </text>
