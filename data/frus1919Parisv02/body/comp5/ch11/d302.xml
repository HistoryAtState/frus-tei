    <text>
        <body>
            <div xml:id="d302">

                <pb facs="0464" n="376" sameAs="frus:frus1919Parisv02/pg376"/>

                <note rend="inline" type="source">763.72/12451</note>
                <head>
                    <hi rendition="#italic">The Chargé in Great Britain</hi> (<hi rendition="#italic">Laughlin</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 10241</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi>
                        </placeName>, <date calendar="gregorian" when="1918-11-18">November 18,
                            1918</date>.<lb/>[Received December 5.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to the Department’s
                    telegram No. 1663 of September 27, 7 p.m.,<anchor n="1" xml:id="d302-f1"/>
                    relative to the future boundaries of the Czecho-Slovak State, I have the honor
                    to transmit herewith enclosed a copy of a Note I have just received from the
                    Foreign Office together with a memorandum setting forth the difficulties with
                    which this question is connected. A map showing the ethnic distribution of the
                    Czecho-Slovaks is also enclosed.<anchor n="2" xml:id="d302-f2"/>
                </p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Irwin Laughlin</hi>
                    </signed>
                </closer>



                <xi:include href="d302-a1.xml" xpointer="d302-a1"/>
                <xi:include href="d302-a2.xml" xpointer="d302-a2"/>
            </div>
