    <text>
        <body>
            <div xml:id="d349">

                <pb facs="0498" n="410" xml:id="pg410"/>

                <note rend="inline" type="source">763.72119/2624½a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to President Wilson </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1918-11-18">November 18,
                            1918</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. President</hi>: I enclose two radiograms
                    which have been received—one addressed to the Governments of the four
                        Powers<anchor n="1" xml:id="d349-f1"/> and the other to you personally.</p>
                <p>Faithfully yours,</p>
                <closer>[File copy not signed]</closer>


                <xi:include href="d349-a1.xml" xpointer="d349-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d349-f1" n="1" xml:id="d349-f1-content">
                <p>This radiogram is a translation of part of note received through the Swiss
                    Minister, Nov. 26, 1918, <hi rendition="#italic">ante</hi>, <ref target="#pg34"
                        >p. 34</ref> (763.72119/2811).</p>
            </note>
        </listAnnotation>
    </standOff>
