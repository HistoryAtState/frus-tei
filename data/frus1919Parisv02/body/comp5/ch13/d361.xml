    <text>
        <body>
            <div xml:id="d361">

                <pb facs="0510" n="422" xml:id="pg422"/>

                <note rend="inline" type="source">763.72119/3897</note>
                <head>
                    <hi rendition="#italic">The Chargé in Denmark</hi> (<hi
                            rendition="#italic">Osborne</hi>) <hi rendition="#italic">to
                        the Acting Secretary of State
                    </hi><anchor n="10" xml:id="d361-f1"/>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1995</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Copenhagen</hi>
                        </placeName>, <date calendar="gregorian" when="1919-01-03">January 3,
                            1919</date>.<lb/>[Received February 25.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Adverting to my telegram No. 3385,<anchor
                        n="11" xml:id="d361-f2"/> of yesterday’s date, with regard to the visit of
                    M. Paderewski to Posen, I have the honor to enclose herewith the memorandum on
                    which that telegram was based.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lithgow Osborne</hi>
                    </signed>
                </closer>


                <xi:include href="d361-a1.xml" xpointer="d361-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d361-f1" n="10" type="source" xml:id="d361-f1-content">
                <p>A copy of this despatch, with its enclosure, was sent to the Commission to
                    Negotiate Peace, Jan. 18, 1919, by the American Embassy in Paris.</p>
            </note>
            <note corresp="#d361-f2" n="11" xml:id="d361-f2-content">
                <p>Not printed.</p>
            </note>
        </listAnnotation>
    </standOff>
