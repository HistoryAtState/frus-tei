            <div xml:id="d357">

                <pb facs="0504" n="416" sameAs="frus:frus1919Parisv02/pg416"/>

                <note rend="inline" type="source">860c.01/185a: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Ambassador in France</hi> (<hi
                            rendition="#italic">Sharp</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1918-12-21T15:00:00-05:00"
                            >December 21, 1918—3 p.m.</date>
                    </dateline>
                </opener>
                <p>6704. Investigate carefully and report promptly exact relations existing between
                    Polish National Committee in Paris and Polish officers in charge of affairs in
                    Poland.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Polk</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
