    <text>
        <body>
            <div xml:id="d326">

                <pb facs="0483" n="395" sameAs="frus:frus1919Parisv02/pg395"/>

                <note rend="inline" type="source">Paris Peace Conf. 185.3123/13</note>
                <head>
                    <hi rendition="#italic">The Minister in Switzerland</hi> (<hi rendition="#italic">Stovall</hi>) <hi
                        rendition="#italic">to Colonel E. M. House
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berne</hi>
                        </placeName>, <date calendar="gregorian" when="1918-12-07">December 7,
                            1918</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Colonel House</hi>: At the request of the
                    Roumanian Minister in Berne, and his associates, I desire to enclose you a copy
                    of an “Aide-Memoire” which he left with me and which bears on the proclamation
                    of Union made by Transylvania and other States with Roumania proper.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>P[<hi rendition="#small-caps">leasant</hi>] <hi rendition="#small-caps"
                            >A. Stovall</hi>
                    </signed>
                </closer>


                <xi:include href="d326-a1.xml" xpointer="d326-a1"/>
            </div>
        </body>
    </text>
