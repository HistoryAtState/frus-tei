    <text>
        <body>
            <div xml:id="d345">

                <pb facs="0495" n="407" sameAs="frus:frus1919Parisv02/pg407"/>

                <note rend="inline" type="source">Robert Lansing Papers</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        French Ambassador to the United States</hi> (<hi
                            rendition="#italic">Jusserand</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi>
                        </placeName>, <date calendar="gregorian" when="1919-01-13">13 January,
                            1919</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Ambassador</hi>: With reference to your
                    letter dated January 4th,<anchor n="26" xml:id="d345-f1"/> regarding the
                    question of making representations in connection with the publication of a
                    decree of the Roumanian Government uniting Transylvania and Banat to Roumania, I
                    take pleasure in informing you that the matter has been referred to the American
                    Embassy here for appropriate action.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
