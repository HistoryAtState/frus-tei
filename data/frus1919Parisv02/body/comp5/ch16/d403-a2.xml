    <text>
        <body>
            <div xml:id="d403-a2">

                <pb facs="0549" n="461" sameAs="frus:frus1919Parisv02/pg461"/>

                <opener>
                    <seg rendition="#center">[Enclosure 2—Translation]<anchor n="20"
                            xml:id="d403-f1"/></seg>
                </opener>
                <head>
                    <hi rendition="#italic">The Danish Minister for Foreign Affairs</hi> (<hi
                        rendition="#italic">Scavenius</hi>) <hi rendition="#italic">to the French
                        Minister for Foreign Affairs</hi> (<hi rendition="#italic"
                    >Pichon</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Copenhagen</hi>
                        </placeName>, <date calendar="gregorian" when="1918-12-12">December 12,
                            1918</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Minister</hi>: In reference to the <hi
                        rendition="#italic">note verbale</hi> from the Legation of the French
                    Republic dated the 10th of this month, concerning the procedure to be followed
                    further with view to the solution of the question of Schleswig, permit me to
                    turn to you as a friendly intermediary for forwarding to your government the
                    official request of the King’s government desiring to bring before the Peace
                    Conference the question mentioned above.</p>
                <closer>[File copy not signed]</closer>
            </div>
        </body>
    </text>
