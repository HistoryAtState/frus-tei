    <text>
        <body>
            <div xml:id="d399">

                <pb facs="0545" n="457" sameAs="frus:frus1919Parisv02/pg457"/>

                <note rend="inline" type="source">763.72119/3499</note>
                <head>
                    <hi rendition="#italic">The Chargé in Denmark</hi> (<hi
                            rendition="#italic">Grant-Smith</hi>) <hi rendition="#italic"
                        >to the Acting Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1962</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Copenhagen</hi>
                        </placeName>, <date calendar="gregorian" when="1918-12-14">December 14,
                            1918</date>.<lb/>[Received January 25, 1919.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Adverting to my telegram No. 3298, of
                    yesterday’s date, I have the honor to transmit herewith a copy and translation
                    of a note from the Danish Minister for Foreign Affairs, dated the 12th instant,
                    requesting me to convey to my Government the official request of the Danish
                    Government that the question of the future of North Slesvig be brought before
                    the peace conference.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">U. Grant-Smith</hi>
                    </signed>
                </closer>


                <xi:include href="d399-a1.xml" xpointer="d399-a1"/>
            </div>
        </body>
    </text>
