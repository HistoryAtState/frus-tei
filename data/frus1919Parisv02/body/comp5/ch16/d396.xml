        <body>
            <div xml:id="d396">

                <pb facs="0540" n="452" xml:id="pg452"/>

                <note rend="inline" type="source">759.6214/14</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        France</hi> (<hi rendition="#italic">Sharp</hi>)</head>
                <opener>
                    <seg rendition="#float-left">No. 2415</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1918-12-13">December 13,
                            1918</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The Department encloses, for the
                    information of Colonel House, copies of the following despatches from the
                    American Legation at Copenhagen, with reference to the cession of the Province
                    of North Slesvig:</p>
                <p>No. 1889, dated November 8, 1918; No. 1890, dated November 8, 1918, with
                    enclosure; No. 1895, dated November 12, 1918, with enclosure.</p>
                <p>I am [etc.]</p>
                <closer>For the Acting Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Breckinridge Long</hi>
                    </signed>
                </closer>





