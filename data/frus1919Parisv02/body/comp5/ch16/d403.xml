    <text>
        <body>
            <div xml:id="d403">

                <pb facs="0548" n="460" sameAs="frus:frus1919Parisv02/pg460"/>

                <note rend="inline" type="source">Robert Lansing Papers</note>
                <head>
                    <hi rendition="#italic">The French Ambassador to the United States</hi> (<hi
                        rendition="#italic">Jusserand</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName>
                            <hi rendition="#small-caps">Paris</hi>
                        </placeName>,] <date calendar="gregorian" when="1919-01-07">January 7,
                            1919</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: We are, as you know,
                    quite willing, and so are the British, and so are you, I believe, that the
                    question of the Slesvig be submitted by Denmark to the peace conference.</p>
                <p>Our minister in Copenhagen has exchanged letters on this subject with the Danish
                    For. Minister. As it may interest you to know those documents, I enclose
                    copies.</p>
                <p>Very sincerely yours</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Jusserand</hi>
                    </signed>
                </closer>




                <xi:include href="d403-a1.xml" xpointer="d403-a1"/>
