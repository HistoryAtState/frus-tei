    <text>
        <body>
            <div xml:id="d404">

                <pb facs="0549" n="461" sameAs="frus:frus1919Parisv02/pg461"/>

                <note rend="inline" type="source">Robert Lansing Papers</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the French Ambassador to the
                        United States</hi> (<hi rendition="#italic">Jusserand</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi>
                        </placeName>, <date calendar="gregorian" when="1919-01-09">January 9,
                            1919</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Ambassador</hi>: I have your letter of
                    January 7th enclosing certain documents regarding the Schleswig-Holstein
                    question and am indeed grateful to you for sending me the interesting
                    information.</p>
                <p>With kindest regards [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
