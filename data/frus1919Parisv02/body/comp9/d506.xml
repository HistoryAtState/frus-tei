                <pb facs="0707" n="619" sameAs="frus:frus1919Parisv02/pg619"/>

                <note rend="inline" type="source">Paris Peace Conf. 185.119/39a: Telegram</note>
                <head>
                    <hi rendition="#italic">The Commission to Negotiate
                            Peace to the Acting Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName>
                            <hi rendition="#small-caps">Paris</hi>
                        </placeName>,] <date calendar="gregorian" when="1919-01-09T12:00:00+00:00"
                            >January 9, 1919—12 noon</date>.</dateline>
                </opener>
                <p>211. [From Lansing.] The Commission would be glad to receive from the Department
                    by mail as soon as possible a statement of the claims of American Citizens
                    against Germany. Lansing.</p>
                <closer>
                    <hi rendition="#small-caps">Am</hi>[<hi rendition="#small-caps">erican</hi>] <hi
                        rendition="#small-caps">Mission</hi>
                </closer>
            </div>
        </body>
