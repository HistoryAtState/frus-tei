    <text>
        <body>
            <div xml:id="d496">

                <pb facs="0670" n="582" sameAs="frus:frus1919Parisv02/pg582"/>

                <note rend="inline" type="source">Paris Peace Conf. 184.023/3</note>
                <head>
                    <hi rendition="#italic">The Diplomatic Liaison Officer With the Supreme War
                        Council</hi> (<hi rendition="#italic">Frasier</hi>) <hi rendition="#italic"
                        >to Brigadier General C. H. McKinstry </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi>
                        </placeName>, <date calendar="gregorian" when="1918-12-06">December 6,
                            1918</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear General McKinstry</hi>: I enclose herewith a
                    copy of a letter just received from the Minister for Foreign Affairs in
                    connection with the estimate of damages caused to invaded parts of France by the
                    German Army of occupation.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Arthur Hugh Frasier</hi>
                    </signed>
                </closer>



                <xi:include href="d496-a1.xml" xpointer="d496-a1"/>
            </div>
