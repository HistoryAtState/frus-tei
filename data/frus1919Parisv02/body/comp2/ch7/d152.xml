    <text>
        <body>
            <div xml:id="d152">

                <pb facs="0312" n="224" sameAs="frus:frus1919Parisv02/pg224"/>

                <note rend="inline" type="source">Paris Peace Conf. 184.01102/2½</note>
                <head>
                    <hi rendition="#italic">The Secretary of the Commission to Negotiate Peace</hi>
                        (<hi rendition="#italic">Grew</hi>) <hi rendition="#italic">to Dr. S. E.
                        Mezes </hi>
                </head>
                <p>1. Will you kindly let me have a memorandum on the point raised in the marked
                    portion of this report,<anchor n="5" xml:id="d152-f1"/> and your recommendations
                    for appropriate action in the matter.</p>
                <closer>
                    <dateline rendition="#float-left">[<placeName>
                            <hi rendition="#small-caps">Paris</hi>
                        </placeName>,] <date calendar="gregorian" when="1919-01-05">January 5,
                            1919</date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d152-f1" n="5" xml:id="d152-f1-content">
                <p>The last sentence of Professor Coolidge’s report No. 4, Dec. 31, 1918, <ref
                        target="#pg221">p. 221</ref>.</p>
            </note>
        </listAnnotation>
