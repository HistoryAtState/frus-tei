        <body>
            <div xml:id="d145">

                <pb facs="0306" n="218" sameAs="frus:frus1919Parisv02/pg218"/>

                <note rend="inline" type="source">Paris Peace Conf. 184.011/15</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Professor A. C. Coolidge
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi>
                        </placeName>, <date calendar="gregorian" when="1918-12-26">December 26,
                            1918</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: You are hereby assigned to the American
                    Commission to Negotiate Peace for the purpose of proceeding to Austria for that
                    Commission to observe political conditions in Austria-Hungary and neighboring
                    countries.</p>
                <p>Yours very truly,</p>
                <closer>[File copy not signed]</closer>
            </div>
        </body>
