    <text>
        <body>
            <div xml:id="d119">

                <pb facs="0279" n="191" sameAs="frus:frus1919Parisv02/pg191"/>

                <note rend="inline" type="source">763.72119/2865</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Italy</hi> (<hi rendition="#italic"
                        >Page</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1060</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Rome</hi>
                        </placeName>, <date calendar="gregorian" when="1918-11-18">November 18,
                            1918</date>.<lb/>[Received December 3.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to my telegram No. 2366, of
                    November 16, 1918, I have the honor to enclose herewith a copy of the letter
                    which was received from the Swiss Minister in Rome.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Thos. Nelson Page</hi>
                    </signed>
                </closer>


                <xi:include href="d119-a1.xml" xpointer="d119-a1"/>
