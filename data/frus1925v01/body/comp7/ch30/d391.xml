    <text>
        <body>
            <div xml:id="d391">

                <pb facs="0684" n="558" sameAs="frus:frus1925v01/pg558"/>

                <note rend="inline" type="source">711.4216 M 58/53</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the British
                        Ambassador</hi> (<hi rendition="#italic">Howard</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1925-02-13"><hi rendition="#italic">February 13,
                        1925.</hi></date></dateline></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I have the honor to transmit
                    herewith for your information a copy of a notice of a hearing which will be held
                    in the office of the Secretary of War on February 20, 1925, on an application
                    made by the Sanitary District of Chicago for a permit to divert an annual
                    average of ten thousand cubic feet of water per second from Lake Michigan.</p>
                <p>Accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Joseph C. Grew</hi></signed></closer>


                <xi:include href="d391-a1.xml" xpointer="d391-a1"/>
