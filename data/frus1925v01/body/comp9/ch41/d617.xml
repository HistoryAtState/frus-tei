                <pb facs="0874" n="748" sameAs="frus:frus1925v01/pg748"/>

                <note rend="inline" type="source">893.00/6744: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">MacMurray</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1925-11-09T13:00:00+08:00"><hi rendition="#italic">November 9,
                                1925—1 p.m.</hi></date><lb/>[Received November 9—5:45
                        a.m.]</dateline></opener>
                <p>478. My 477, November 6, 4 p.m. Following from Swatow: <quote rend="blockquote">
                        <p>“November 7, 12 noon. Chiang Kai-shek arrived yesterday with several
                            thousand troops, quiet.”</p>
                    </quote></p>
                <closer><signed><hi rendition="#small-caps">MacMurray</hi></signed></closer>
            </div>
        </body>
