                <pb facs="0875" n="749" sameAs="frus:frus1925v01/pg749"/>

                <note rend="inline" type="source">893.00/6292: Telegram</note>
                <head><hi rendition="#italic">The Chargé in China</hi> (<hi rendition="#italic"
                        >Mayer</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1925-06-19T17:00:00+08:00"><hi rendition="#italic">June 19, 1925—5
                                p.m.</hi></date><lb/>[Received June 19—8:50
                    a.m.]</dateline></opener>
                <p>236. Following from consul general at Canton: <quote rend="blockquote">
                        <p>“June 18, 1 p.m. General strike against foreigners imminent. I am warning
                            American women and children to leave and the men who remain to be
                            prepared for immediate departure in event of danger.”</p>
                    </quote></p>
                <closer><signed><hi rendition="#small-caps">Mayer</hi></signed></closer>
            </div>
        </body>
