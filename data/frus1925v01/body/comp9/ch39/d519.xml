    <text>
        <body>
            <div xml:id="d519">

                <pb facs="0796" n="670" sameAs="frus:frus1925v01/pg670"/>

                <note rend="inline" type="source"><hi rendition="#superscript">701.0093 D
                    34</hi>/187 <hi rendition="#italic">bis</hi></note>
                <head><hi rendition="#italic">The Italian Minister in China</hi> (<hi
                        rendition="#italic">Cerruti</hi>), <hi rendition="#italic">Senior Minister,
                        to the American Chargé</hi> (<hi rendition="#italic">Mayer</hi>)<anchor
                        n="95" xml:id="d519-f1"/></head>
                <opener><seg rendition="#center">[Translation<anchor n="96" xml:id="d519-f2"
                        />]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1925-06-26"><hi rendition="#italic">June 26,
                        1925.</hi></date></dateline>
                    <seg rendition="#float-left">Circular No. 187 <hi rendition="#italic"
                        >bis</hi></seg></opener>
                <p rendition="#flush">Subject: Events at Shanghai</p>
                <p>The Senior minister has the honor to circulate herewith a note concerning the
                    events at Shanghai which was addressed to him by the Waichiaopu June 24.</p>


                <xi:include href="d519-a1.xml" xpointer="d519-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d519-f1" n="95" type="source" xml:id="d519-f1-content">
                <p>Copy (in French) received by the Department on September 9. The Chargé in China
                    reported the receipt of the enclosed note from the Chinese Foreign Office in
                    telegram No. 255, July 2.</p>
            </note>
            <note corresp="#d519-f2" n="96" xml:id="d519-f2-content">
