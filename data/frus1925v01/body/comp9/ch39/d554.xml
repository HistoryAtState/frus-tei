            <div xml:id="d554">

                <pb facs="0831" n="705" xml:id="pg705"/>

                <note rend="inline" type="source">893.5045/204: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Minister in China</hi> (<hi
                            rendition="#italic">MacMurray</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1925-09-04T17:00:00-04:00"><hi rendition="#italic">September 4,
                                1925—5 p.m.</hi></date></dateline></opener>
                <p>232. Your 379 September 4, 9 p.m. [<hi rendition="#italic">a.m.</hi>] Formula
                    satisfactory to Department. You are authorized to sign it or any modification
                    thereof importing no substantial alteration.</p>
                <p>Department is considering question of judge.</p>
                <closer><signed><hi rendition="#small-caps">Grew</hi></signed></closer>
            </div>
        </body>
