                <pb facs="0792" n="666" sameAs="frus:frus1925v01/pg666"/>

                <note rend="inline" type="source">893.5045/89: Telegram</note>
                <head><hi rendition="#italic">The Chargé in China</hi> (<hi
                            rendition="#italic">Mayer</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1925-06-14T15:00:00+08:00"><hi rendition="#italic">June 14, 1925—3
                                p.m.</hi></date><lb/>[Received June 14—10:25
                    a.m.]</dateline></opener>
                <p>225. My 211, June 8, 7 p.m. American consul, Shanghai, reports that owing to
                    improved situation part of defence forces have been withdrawn. Full publicity
                    being given.</p>
                <closer><signed><hi rendition="#small-caps">Mayer</hi></signed></closer>
            </div>
        </body>
