                <pb facs="0832" n="706" sameAs="frus:frus1925v01/pg706"/>

                <note rend="inline" type="source">893.5045/218: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Minister in China</hi>
                        (<hi rendition="#italic">MacMurray</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1925-09-11T17:00:00-04:00"><hi rendition="#italic">September 11,
                                1925—5 p.m.</hi></date></dateline></opener>
                <p>241. Your 389, September 10, 5 p.m. You may inform British Chargé that assurance
                    is satisfactory, and that you are ready to proceed with negotiations with
                    Chinese Government regarding Shanghai incident.</p>
                <closer><signed><hi rendition="#small-caps">Kellogg</hi></signed></closer>
            </div>
        </body>
    </text>
