            <div xml:id="d705">

                <pb facs="0983" n="857" sameAs="frus:frus1925v01/pg857"/>

                <note rend="inline" type="source">500.A 4 e/404: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Minister in China</hi>
                        (<hi rendition="#italic">MacMurray</hi>)</head>
                <opener><seg rendition="#center">[Extract]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1925-10-15T18:00:00-05:00"><hi rendition="#italic">October 15,
                                1925—6 p.m.</hi></date></dateline></opener>
                <p>292.</p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>Your action in regard to Chinese tentative agenda report in your No. 443 October
                    15, 3 p.m. is approved.</p>
                <closer><signed><hi rendition="#small-caps">Kellogg</hi></signed></closer>
            </div>
        </body>
