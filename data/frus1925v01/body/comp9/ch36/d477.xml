                <pb facs="0762" n="636" xml:id="pg636"/>

                <note rend="inline" type="source">123 M 221/143: Telegram</note>
                <head><hi rendition="#italic">The Chargé in China</hi> (<hi
                            rendition="#italic">Mayer</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1925-07-07T15:00:00+08:00"><hi rendition="#italic">July 7, 1925—3
                                p.m.</hi></date><lb/>[Received July 7—8:37 a.m.]</dateline></opener>
                <p>266. From MacMurray: Arrived today. Mayer will remain in charge pending
                    consultations with colleagues as to proposed presentation of letters of credence
                    to Tuan as Provisional Chief Executive.</p>
                <closer><signed><hi rendition="#small-caps">Mayer</hi></signed></closer>
            </div>
        </body>
