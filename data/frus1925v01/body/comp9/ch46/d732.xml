    <text>
        <body>
            <div xml:id="d732">

                <pb facs="1016" n="890" sameAs="frus:frus1925v01/pg890"/>

                <note rend="inline" type="source">793.003 C 73/235: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">MacMurray</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1926-01-04T16:00:00+08:00"><hi rendition="#italic">January 4,
                                1926—4 p.m.</hi></date><lb/>[Received January 4—8:14
                        a.m.]</dateline></opener>
                <p>3. Referring to your number 2, January 2, 7 p.m.<anchor n="96" xml:id="d732-f1"/>
                    All Commissioners having arrived, the Extraterritoriality Commission will
                    convene on January 8.<anchor n="97" xml:id="d732-f2"/></p>
                <closer><signed><hi rendition="#small-caps">MacMurray</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d732-f1" n="96" xml:id="d732-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d732-f2" n="97" xml:id="d732-f2-content">
                <p>The Commission did not meet until Jan. 12, 1926.</p>
            </note>
        </listAnnotation>
    </standOff>
