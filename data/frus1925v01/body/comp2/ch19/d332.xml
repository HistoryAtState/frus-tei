                <pb facs="0618" n="492" sameAs="frus:frus1925v01/pg492"/>

                <note rend="inline" type="source">875.01/266: Telegram</note>
                <head><hi rendition="#italic">The Minister in Albania</hi> (<hi rendition="#italic">Grant-Smith</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Tirana</hi></placeName>, <date calendar="gregorian"
                            when="1925-02-03T15:00:00+01:00"><hi rendition="#italic">February 3,
                                1925—3 p.m.</hi></date><lb/>[Received February 4—7:51
                        a.m.]</dateline></opener>
                <p>10. Department’s 5, January 30 [<hi rendition="#italic">31</hi>], 6 p.m.
                    Acknowledgment notification of vote of confidence and of adoption of republican
                    form of government made under date of 2d instant. Copy to European Information
                    Center.</p>
                <closer><signed><hi rendition="#small-caps">Grant-Smith</hi></signed></closer>
            </div>
        </body>
