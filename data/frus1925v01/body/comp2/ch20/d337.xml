    <text>
        <body>
            <div xml:id="d337">

                <pb facs="0620" n="494" sameAs="frus:frus1925v01/pg494"/>

                <note rend="inline" type="source">875.6363/160: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Minister in Albania</hi> (<hi rendition="#italic"
                            >Grant-Smith</hi>)</head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1925-02-10T15:00:00-05:00"><hi rendition="#italic">February 10,
                                1925—3 p.m.</hi></date></dateline></opener>
                <p>7. The Department has information that Mr. Sheffield<anchor n="10"
                        xml:id="d337-f1"/> is shortly to leave the United States and will proceed at
                    once to Tirana, where he should arrive about February 28th.</p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d337-f1" n="10" xml:id="d337-f1-content">
                <p>E. S. Sheffield, representative of the Standard Oil Co. of New York.</p>
            </note>
        </listAnnotation>
    </standOff>
