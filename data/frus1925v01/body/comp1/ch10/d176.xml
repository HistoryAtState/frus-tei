                <pb facs="0367" n="241" sameAs="frus:frus1925v01/pg241"/>

                <note rend="inline" type="source">121.5751/3: Telegram</note>
                <head><hi rendition="#italic">The Chargé in France</hi> (<hi rendition="#italic"
                        >Whitehouse</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1925-07-22T13:00:00+01:00"><hi rendition="#italic">July 22, 1925—1
                                p.m.</hi></date><lb/>[Received July 22—8:50
                    a.m.]</dateline></opener>
                <p>394. Your instruction number 1475, April 21st, 1925. Have just received note from
                    Foreign Office stating that it cannot grant diplomatic status to customs
                    attachés. Copy of the note going forward by next pouch.<anchor n="66"
                        xml:id="d176-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Whitehouse</hi></signed></closer>
            </div>
        </body>
    </text>
