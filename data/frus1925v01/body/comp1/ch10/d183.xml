    <text>
        <body>
            <div xml:id="d183">

                <pb facs="0374" n="248" sameAs="frus:frus1925v01/pg248"/>

                <note rend="inline" type="source">121.5793/3</note>
                <head><hi rendition="#italic">The Consul General at Hongkong</hi> (<hi rendition="#italic">Tredwell</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Hongkong</hi></placeName>, <date calendar="gregorian"
                            when="1925-09-22"><hi rendition="#italic">September 22,
                        1925</hi></date>.<lb/>[Received October 26.]</dateline>
                    <seg rendition="#float-left">No. 24</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith copy
                    of a communication received to-day from the Colonial Secretary of the Colonial
                    Government of Hongkong,<anchor n="78" xml:id="d183-f1"/> in which I am informed
                    that His Excellency the Governor has withdrawn the provisional recognition which
                    was accorded to Mr. H. C. Anderson, Assistant Customs Attaché, at this
                        port.<anchor n="79" xml:id="d183-f2"/></p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Roger Culver
                    Tredwell</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d183-f1" n="78" xml:id="d183-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d183-f2" n="79" xml:id="d183-f2-content">
                <p>The consul in charge at Hongkong had been instructed on May 5 to notify the local
                    authorities of the appointment of Mr. Anderson as assistant customs attaché at
                    Hongkong (file No. 121.5793/a).</p>
            </note>
        </listAnnotation>
    </standOff>
