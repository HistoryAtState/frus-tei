                <pb facs="0322" n="196" xml:id="pg196"/>

                <note rend="inline" type="source">463.00 R 29/171: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic"
                        >Herrick</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1925-03-03T12:00:00+00:00"><hi rendition="#italic">March 3,
                                1925—noon</hi></date>.<lb/>[Received March 3—11:02
                    a.m.]</dateline></opener>
                <p>150. Your 99, February 24, 4 p.m. Memorandum was presented to the Conference of
                    Ambassadors at its 275th meeting this morning. No comment was made but it was
                    reserved for future discussion.</p>
                <closer><signed><hi rendition="#small-caps">Herrick</hi></signed></closer>
            </div>
        </body>
