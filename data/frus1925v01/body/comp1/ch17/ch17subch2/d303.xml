    <text>
        <body>
            <div xml:id="d303">

                <pb facs="0589" n="463" sameAs="frus:frus1925v01/pg463"/>

                <note rend="inline" type="source">721.2315/183a: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Ambassador in Peru</hi> (<hi rendition="#italic"
                            >Poindexter</hi>)<anchor n="18" xml:id="d303-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1925-03-04T20:00:00-05:00"><hi rendition="#italic">March 4, 1925—8
                                p.m.</hi></date></dateline></opener>
                <p>11. Procès Verbal signed today. Much appreciate your able cooperation.</p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d303-f1" n="18" type="source" xml:id="d303-f1-content">
                <p>The same to the Ambassador in Brazil; first sentence, only, to the Minister in
                    Colombia (file No. 721.2315/183 b, c).</p>
            </note>
        </listAnnotation>
    </standOff>
