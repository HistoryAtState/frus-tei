                <pb facs="0584" n="458" xml:id="pg458"/>

                <note rend="inline" type="source">721.2315/179: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Brazil</hi> (<hi rendition="#italic"
                        >Morgan</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Rio de Janeiro</hi></placeName>, <date calendar="gregorian"
                            when="1925-03-03T12:00:00-03:00"><hi rendition="#italic">March 3,
                                1925—noon.</hi></date><lb/>[Received March 3—11
                    a.m.]</dateline></opener>
                <p>21. Your telegram number 17, March 2, 2 p.m. was communicated to the Minister for
                    Foreign Affairs this morning. Foreign Office on reading telegram considers
                    Grade’s instructions already adequate.</p>
                <closer><signed><hi rendition="#small-caps">Morgan</hi></signed></closer>
            </div>
        </body>
