                <pb facs="0286" n="160" sameAs="frus:frus1925v01/pg160"/>

                <note rend="inline" type="source">800.51 W 89Greece/10</note>
                <head><hi rendition="#italic">The Chargé in Greece</hi> (<hi rendition="#italic"
                        >Goold</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Athens</hi></placeName>, <date calendar="gregorian"
                            when="1925-09-05"><hi rendition="#italic">September 5,
                        1925</hi></date>.<lb/>[Received September 21.]</dateline>
                    <seg rendition="#float-left">No. 406</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In confirmation of my telegram of to-day,
                    No. 57, 12 noon,<anchor n="46" xml:id="d100-f1"/> I have the honor to state that
                    this morning I was handed Foreign Office note No. 11193, dated August 30th in
                    reply to my note No. 109 of August 14th which I had been directed to transmit by
                    your instruction No. 237 of July 31st.</p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">H. S. Goold</hi></signed></closer>


                <xi:include href="d100-a1.xml" xpointer="d100-a1"/>
            </div>
        </body>
    </text>
