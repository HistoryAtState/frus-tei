    <text>
        <body>
            <div xml:id="d212">

                <pb facs="0489" n="363" sameAs="frus:frus1925v01/pg363"/>

                <note rend="inline" type="source">723.2515/1547</note>
                <head><hi rendition="#italic">The Peruvian Ambassador</hi> (<hi rendition="#italic">Velarde</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><seg rendition="#center">[Translation]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1925-06-18"><hi rendition="#italic">June 18,
                        1925</hi>.</date></dateline></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: In compliance with instructions from
                    my Government I have the honor to apply to Your Excellency with a request <pb
                        facs="0490" n="364" xml:id="pg364"/> that you kindly place in the hands of
                    His Excellency the President of the United States of America, Arbitrator in the
                    case concerning the Provinces of Tacna and Arica the communication which I
                    append to this note.</p>
                <p>I renew [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Hernán Velarde</hi></signed></closer>


                <xi:include href="d212-a1.xml" xpointer="d212-a1"/>
            </div>
        </body>
    </text>
