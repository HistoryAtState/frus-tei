    <text>
        <body>
            <div xml:id="d207">

                <pb facs="0474" n="348" sameAs="frus:frus1925v01/pg348"/>

                <note rend="inline" type="source">723.2515/1416</note>
                <head><hi rendition="#italic">The Peruvian Ambassador</hi> (<hi rendition="#italic">Velarde</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><seg rendition="#center">[Translation]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1925-04-02"><hi rendition="#italic">April 2,
                        1925</hi>.</date></dateline></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I have the honor to deliver to Your
                    Excellency with the request that you forward it to its high destination the
                    enclosed memorial which the Peruvian Commission of Defense sends in the name of
                    the Government of Peru on the occasion of the Award made by the Arbitrator
                    concerning the Provinces of Tacna and <pb facs="0475" n="349" xml:id="pg349"/>
                    Arica to the Honorable Arbitrator, His Excellency, the President of the United
                    States of America.</p>
                <p>In making this request I renew [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Hernan Velarde</hi></signed></closer>


                <xi:include href="d207-a1.xml" xpointer="d207-a1"/>
            </div>
        </body>
    </text>
