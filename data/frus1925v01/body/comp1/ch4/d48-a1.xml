    <text>
        <body>
            <div xml:id="d48-a1">

                <pb facs="0186" n="60" xml:id="pg60"/>

                <opener><seg rendition="#center">[Enclosure]</seg></opener>
                <head><hi rendition="#italic">Statement Approving the Provisions of the Convention
                        and Consenting to Its Signature</hi></head>
                <p>The undersigned Delegates, having examined the text of the Convention for the
                    Control of the Trade in Arms, Ammunition and Implements of War, approve of its
                    provisions and consent to the signing thereof by the Chairman and Vice-Chairman
                    of the American Delegation.</p>
                <closer><signed>
                        <list>
                            <item><hi rendition="#small-caps">A. T. Long</hi></item>
                            <item><hi rendition="#small-caps">A. W. Dulles</hi></item>
                            <item><hi rendition="#small-caps">C. L’H. Ruggles</hi></item>
                        </list>
                    </signed>
                    <lb/>
                    <dateline rendition="#float-left"><placeName><hi rendition="#small-caps"
                                >Geneva</hi></placeName>, <date calendar="gregorian"
                            when="1925-06-17"><hi rendition="#italic">June 17,
                        1925</hi></date>.</dateline>
                </closer>
            </div>
        </body>
