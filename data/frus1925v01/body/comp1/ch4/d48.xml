    <text>
        <body>
            <div xml:id="d48">

                <pb facs="0185" n="59" sameAs="frus:frus1925v01/pg59"/>

                <note rend="inline" type="source">500.A14/355</note>
                <head><hi rendition="#italic">The Chairman of the American Delegation</hi>
                        (<hi rendition="#italic">Burton</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Geneva</hi></placeName>, <date calendar="gregorian"
                            when="1925-06-17"><hi rendition="#italic">June 17,
                        1925.</hi></date><lb/>[Received June 30.]</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. Secretary</hi>: I am enclosing a writing
                    signed by the three Delegates who did not join in the signature of the Treaties.
                    This might assume considerable importance and I send it to you.</p>
                <p>The Conference came to a close at three o’clock today and in reviewing what has
                    been done, I think we have great reason for satisfaction in the results.</p>
                <p>Very cordially yours,</p>
                <closer><signed><hi rendition="#small-caps">Theodore E.
                    Burton</hi></signed></closer>



                <xi:include href="d48-a1.xml" xpointer="d48-a1"/>
