    <text>
        <body>
            <div xml:id="d625">

                <pb facs="0620" n="616" sameAs="frus:frus1938v03/pg616"/>

                <note rend="inline" type="source">793.94116/50: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Japan</hi> (<hi rendition="#italic">Grew</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Tokyo</hi></placeName>, <date calendar="gregorian"
                            when="1938-06-08T11:00:00+09:00">June 8, 1938—11
                        a.m.</date><lb/>[Received June 7—10:41 p.m.]</dateline>
                </opener>
                <p>364. Our 359, June 6, 6 p.m.<anchor n="15" xml:id="d625-f1"/> My French colleague
                    now informs me that he has presented an <hi rendition="#italic"
                        >aide-mémoire</hi> to the Japanese Government protesting vigorously against
                    the bombing of the French hospital at Canton.</p>
                <p>Copy by mail.</p>
                <closer><signed><hi rendition="#small-caps">Grew</hi></signed></closer>
            </div>
        </body>
    </text>
