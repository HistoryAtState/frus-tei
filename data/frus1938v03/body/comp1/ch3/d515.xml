    <text>
        <body>
            <div xml:id="d515">

                <pb facs="0515" n="511" xml:id="pg511"/>

                <note rend="inline" type="source">793.94/13933: Telegram</note>
                <head><hi rendition="#italic">The Consul at Geneva</hi> (<hi
                            rendition="#italic">Bucknell</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Geneva</hi></placeName>, <date calendar="gregorian"
                            when="1938-09-22T11:00:00+01:00">September 22, 1938—11
                        a.m.</date><lb/>[Received September 22—9:10 a.m.]</dateline>
                </opener>
                <p>223. My telegram No. 211, September 19, 7 p.m. The Secretary-General this morning
                    received a telegram from the Japanese Foreign Minister<anchor n="63"
                        xml:id="d515-f1"/> stating that in the view of the Japanese Government the
                    measures envisaged by the Council would not serve to bring about a just
                    settlement and that therefore the Japanese Government would be unable to accept
                    the invitation addressed to it by the Council.</p>
                <closer><signed><hi rendition="#small-caps">Bucknell</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d515-f1" n="63" xml:id="d515-f1-content">
                <p>Gen. Kazushige Ugaki.</p>
            </note>
        </listAnnotation>
    </standOff>
