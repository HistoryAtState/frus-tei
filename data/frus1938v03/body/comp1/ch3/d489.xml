            </note>
            <note corresp="#d489-f4" n="44" xml:id="d489-f4-content">
                <p>Yvon Delbos, French Minister for Foreign Affairs.</p>
            </note>
            <note corresp="#d489-f5" n="45" xml:id="d489-f5-content">
                <p>V. K. Wellington Koo, Chinese Ambassador to France.</p>
            </note>
        </listAnnotation>
