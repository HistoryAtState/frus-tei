    <text>
        <body>
            <div xml:id="d862">

                <pb facs="1013" n="933" sameAs="frus:frus1902/pg933"/>

                <head><hi rendition="#italic">Mr. Riddle to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic">St.
                                Petersburg</hi></placeName>, <date calendar="gregorian"
                            when="1902-06-14"><hi rendition="#italic">June 14,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 580.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your telegram<anchor n="b" xml:id="d862-f1"/> of May 24.</p>
                <p>I inclose herewith the reply of the Russian Government to my request made in
                    accordance with your instructions.</p>
                <p>I have communicated the substance of this note to the consul-general in this
                    city, instructing him to inform all the consular representatives under him.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">J. W. Riddle</hi>,<lb/><hi
                            rendition="#italic">Chargé d’Affaires ad Interim.</hi></signed></closer>


                <xi:include href="d862-a1.xml" xpointer="d862-a1"/>
            </div>
        </body>
    </text>
