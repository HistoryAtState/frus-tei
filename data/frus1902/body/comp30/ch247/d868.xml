    <text>
        <body>
            <div xml:id="d868">

                <pb facs="1016" n="936" sameAs="frus:frus1902/pg936"/>

                <head><hi rendition="#italic">Mr. Riddle to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic">St.
                                Petersburg</hi></placeName>, <date calendar="gregorian"
                            when="1902-07-30"><hi rendition="#italic">July 30,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 592.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith, for
                    the information of future travelers, copy and translation of a note from the
                    minister for foreign affairs, announcing that special permission is no longer
                    required to travel on the Trans-Caspian Railway.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">J. W. Riddle</hi>,<lb/><hi
                            rendition="#italic">Chargé d’Affaires ad interim.</hi></signed></closer>


                <xi:include href="d868-a1.xml" xpointer="d868-a1"/>
            </div>
        </body>
    </text>
