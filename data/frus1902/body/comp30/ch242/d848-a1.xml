    <text>
        <body>
            <div xml:id="d848-a1">

                <pb facs="1001" n="921" xml:id="pg921"/>

                <opener><seg rendition="#center">[Inclosure.]</seg></opener>
                <head><hi rendition="#italic">Mr. Goodnow to Mr.
                            Peirce.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Consulate-General of the United States</hi>,<lb/><hi
                                rendition="#italic">Shanghai</hi></placeName>, <date
                            calendar="gregorian" when="1902-01-21"><hi rendition="#italic">January
                                21, 1902</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I hand you herewith copy of my No. 375, of
                    this date, to the United States minister at Pekin, being a report “Telegraphic
                    communication between this port and Niuchwang.”</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Goodnow</hi>, <hi
                            rendition="#italic">Consul-General.</hi></signed></closer>
            </div>
        </body>
