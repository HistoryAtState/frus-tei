    <text>
        <body>
            <div xml:id="d848-a6">

                <pb facs="1002" n="922" sameAs="frus:frus1902/pg922"/>

                <opener><seg rendition="#center">[Subinclosure 5.]</seg></opener>
                <head><hi rendition="#italic">The American Trading Company to Mr.
                    Goodnow.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Shanghai</hi></placeName>, <date calendar="gregorian"
                            when="1902-01-13"><hi rendition="#italic">January 13,
                        1902</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Goodnow</hi>: Following up my respects to
                    you of the 7th instant, I now beg to hand you copy of letter received from the
                    Joint Telegraph Company, which may prove of interest.</p>
                <p>I remain, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Frank P. Ball.</hi></signed></closer>
            </div>
        </body>
    </text>
