    <text>
        <body>
            <div xml:id="d335">

                <pb facs="0465" n="385" xml:id="pg385"/>

                <head><hi rendition="#italic">Mr. Adee to Señor
                            Vasquez</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-09-26"><hi rendition="#italic">September 26,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 19.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your telegram of the 24th instant, expressing your regret to learn of the
                    operation performed on the President as a result of the accident at
                    Pittsfield.</p>
                <p>I have the honor to express the Department’s appreciation of your courteous
                    telegram, and to assure you that the reports of the President’s condition
                    continue satisfactory.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alvey A. Adee</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
