    <text>
        <body>
            <div xml:id="d903-a2">

                <pb facs="1047" n="967" sameAs="frus:frus1902/pg967"/>

                <opener><seg rendition="#center">[Inclosure 2—Translation.]</seg></opener>
                <head><hi rendition="#italic">Mr. Lagerheim to Mr. Thomas.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Royal Foreign Office</hi>,<lb/><hi rendition="#italic"
                                >Stockholm</hi></placeName>, <date calendar="gregorian"
                            when="1902-11-07"><hi rendition="#italic">November 7,
                        1902</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Mr. Minister</hi>: Referring to your note of June 23
                    last, I have the honor to inform you that United States consular officers in
                    Sweden and Norway have received permission to assume the charge of the interests
                    of Cuba and of its citizens until Cuban consuls shall have been appointed.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Lagerheim.</hi></signed></closer>
            </div>
        </body>
    </text>
