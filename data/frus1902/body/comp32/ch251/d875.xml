    <text>
        <body>
            <div xml:id="d875">

                <pb facs="1025" n="945" sameAs="frus:frus1902/pg945"/>

                <head><hi rendition="#italic">Mr. King to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Bangkok</hi></placeName>, <date calendar="gregorian"
                            when="1902-06-17"><hi rendition="#italic">June 17,
                        1902</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: On May 25 the following cable<anchor n="a"
                        xml:id="d875-f1"/> was received and transmitted at once to the foreign
                    office.</p>
                <p>I have to-day received a reply to the same, a copy of which I inclose.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Hamilton King</hi>, <hi
                            rendition="#italic">Minister Resident.</hi></signed></closer>


                <xi:include href="d875-a1.xml" xpointer="d875-a1"/>
            </div>
        </body>
    </text>
