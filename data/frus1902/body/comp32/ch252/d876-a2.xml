                <pb facs="1026" n="946" sameAs="frus:frus1902/pg946"/>

                <opener><seg rendition="#center">[Inclosure 2.]</seg></opener>
                <head><hi rendition="#italic">List of the Crown Prince of Siam’s party who will
                        visit the United States.</hi></head>
                <list>
                    <item>His Royal Highness the Crown Prince of Siam.</item>
                    <item>Colonel Phya Rajavallobh, first aid-de-camp.</item>
                    <item>Captain Lusang Sarasiddhi, second aid-de-camp.</item>
                    <item>Mom R. Anuvatra, private secretary.</item>
                    <item>His Royal Highness Prince Chakrabongse, brother of the Crown
                        Prince.</item>
                    <item>An aid-de-camp or an officer in attendance.</item>
                    <item>Siamese Legation, Washington, July 30, 1902.</item>
                </list>
            </div>
