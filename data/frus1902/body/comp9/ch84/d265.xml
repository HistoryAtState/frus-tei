    <text>
        <body>
            <div xml:id="d265">

                <pb facs="0393" n="313" sameAs="frus:frus1902/pg313"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Hart</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-12-18"><hi rendition="#italic">December 18,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 441.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In compliance with, the suggestions
                    contained in your No. 678, of October 23 last, claims circulars have been sent
                    to the United States consulate-general at Panama for the benefit of American
                    citizens who have lost their property by military expropriations.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay</hi>.</signed></closer>
            </div>
        </body>
    </text>
