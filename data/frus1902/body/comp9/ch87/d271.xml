    <text>
        <body>
            <div xml:id="d271">

                <pb facs="0398" n="318" sameAs="frus:frus1902/pg318"/>

                <head><hi rendition="#italic">Mr. Adee to Mr. Hart</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-08-30"><hi rendition="#italic">August 30,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 420.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose for your information copies of a
                        note<anchor n="b" xml:id="d271-f1"/> from the Chinese minister at this
                    capital and of the Department’s instruction of the 27th instant to the United
                    States consul-general at Panama in regard to the protection to be afforded to
                    Chinese subjects by the United States consular officers on the Isthmus of
                    Panama.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alvey A. Adee</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>


                <xi:include href="d271-a1.xml" xpointer="d271-a1"/>
            </div>
        </body>
    </text>
