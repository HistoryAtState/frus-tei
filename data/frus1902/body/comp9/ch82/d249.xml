                <pb facs="0372" n="292" sameAs="frus:frus1902/pg292"/>

                <head><hi rendition="#italic">Mr. Hay to Mr. Beaupré.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-04-28"><hi rendition="#italic">April 28,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 394.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In reply to your No. 584, of the 22d
                    ultimo, I have to say that the Department has learned with great regret of the
                    death of the late President of Colombia.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay</hi>.</signed></closer>
            </div>
        </body>
    </text>
