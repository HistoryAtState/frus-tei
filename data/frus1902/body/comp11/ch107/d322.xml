    <text>
        <body>
            <div xml:id="d322">

                <pb facs="0452" n="372" sameAs="frus:frus1902/pg372"/>

                <head><hi rendition="#italic">Mr. Swenson to Mr. Hay</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Copenhagen</hi></placeName>, <date calendar="gregorian"
                            when="1902-05-02"><hi rendition="#italic">May 2,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 254.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith, for your information, a
                    copy of a letter which I addressed to a Mr. Severin Jacobsen, under date of
                    December 30, 1901, relative to the question of his liability to military duty in
                    Denmark.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Laurits S.
                    Swenson.</hi></signed></closer>


                <xi:include href="d322-a1.xml" xpointer="d322-a1"/>
