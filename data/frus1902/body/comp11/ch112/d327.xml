    <text>
        <body>
            <div xml:id="d327">

                <pb facs="0457" n="377" sameAs="frus:frus1902/pg377"/>

                <head><hi rendition="#italic">Mr. Swenson to Mr. Hay</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Copenhagen</hi></placeName>, <date calendar="gregorian"
                            when="1902-12-16"><hi rendition="#italic">December 16,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 286.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I beg to inclose herewith, for your
                    information, copies of a letter from C. Ravn and of mine in reply, respecting
                    the status of his citizenship.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Laurits S.
                    Swenson.</hi></signed></closer>



