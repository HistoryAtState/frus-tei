    <text>
        <body>
            <div xml:id="d788">

                <pb facs="0910" n="830" sameAs="frus:frus1902/pg830"/>

                <head><hi rendition="#italic">President Diaz to
                        President Roosevelt.</hi></head>
                <opener><seg rendition="#center">[Telegram.—Translation.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1902-09-04"><hi rendition="#italic">September 4,
                        1902</hi></date>.</dateline></opener>
                <p>Accept my cordial congratulations upon your escape from accident.</p>
                <closer><signed><hi rendition="#small-caps">Porfirio Diaz.</hi></signed></closer>
            </div>
        </body>
    </text>
