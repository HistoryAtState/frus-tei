    <text>
        <body>
            <div xml:id="d791">

                <pb facs="0912" n="832" sameAs="frus:frus1902/pg832"/>

                <head><hi rendition="#italic">Mr. Clayton to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1902-11-04"><hi rendition="#italic">November 4,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1618.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inform you that on the
                    30th ultimo the President of the Republic received General Carlos Garcia Velez
                    as envoy extraordinary and minister plenipotentiary of the Republic of Cuba.</p>
                <p>I inclose herewith copy and translation of the addresses delivered on that
                    occasion.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Powell Clayton.</hi></signed></closer>



                <xi:include href="d791-a1.xml" xpointer="d791-a1"/>
