    <text>
        <body>
            <div xml:id="d771">

                <pb facs="0888" n="808" sameAs="frus:frus1902/pg808"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Clayton.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-03-04"><hi rendition="#italic">March 4,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 656.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    dispatch No. 1274, of the 21st ultimo, containing a report on the arrest of
                    American citizens employed on railroads in Mexico, for negligence in causing
                    accidents.</p>
                <p>In view of your comprehensive investigation and report, it is unnecessary for you
                    to pursue the subject further, unless you are hereafter so instructed.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
    </text>
