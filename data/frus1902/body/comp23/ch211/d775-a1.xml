    <text>
        <body>
            <div xml:id="d775-a1">

                <pb facs="0892" n="812" sameAs="frus:frus1902/pg812"/>

                <opener><seg rendition="#center">[Inclosure.—Translation.]</seg></opener>
                <head><hi rendition="#italic">Mr. Marsical to Mr.
                            Clayton.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of Foreign Affairs</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1902-08-31"><hi rendition="#italic">August 31,
                        1902</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Mr. Ambassador</hi>: Referring to the note of the
                    embassy of October 31, 1901, relating to the suit for amparo brought by
                    Nathaniel F. Bonsall against a sentence of the third circuit court, I have the
                    honor to transmit to your excellency herewith a copy of a note addressed to me
                    by the said court in which it states that the supreme court of justice has
                    denied the said amparo.</p>
                <p>I renew, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Igno. Mariscal.</hi></signed></closer>
            </div>
        </body>
    </text>
