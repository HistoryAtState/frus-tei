    <text>
        <body>
            <div xml:id="d778">

                <pb facs="0895" n="815" sameAs="frus:frus1902/pg815"/>

                <head><hi rendition="#italic">Mr. Clayton to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1902-06-17"><hi rendition="#italic">June 17,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1430.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose copy and
                    translation of a treaty of commerce and navigation between Mexico and
                    Austria-Hungary, <pb facs="0896" n="816" xml:id="pg816"/> signed in this city
                    September 17, 1901, and promulgated by the President of Mexico on the 31st
                    ultimo.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Powell Clayton.</hi></signed></closer>


                <xi:include href="d778-a1.xml" xpointer="d778-a1"/>
            </div>
