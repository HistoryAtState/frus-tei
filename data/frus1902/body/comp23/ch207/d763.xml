    <text>
        <body>
            <div xml:id="d763">

                <pb facs="0869" n="789" xml:id="pg789"/>

                <head><hi rendition="#italic">Mr. Hill to Mr. Clayton.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-06-28"><hi rendition="#italic">June 28,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 730.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    No. 1434 of the 19th instant, reporting that the claim of Mr. M. Brown on
                    account of his illegal eviction and imprisonment in the City of Mexico has been
                    settled by the payment to him of $10,000.</p>
                <p>The Department is gratified at the satisfactory adjustment of the claim.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">David J. Hill</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>
            </div>
        </body>
