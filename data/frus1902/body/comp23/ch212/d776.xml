    <text>
        <body>
            <div xml:id="d776">

                <pb facs="0893" n="813" sameAs="frus:frus1902/pg813"/>

                <head><hi rendition="#italic">Mr. McCreery to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1902-05-07"><hi rendition="#italic">May 7,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1348.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose copy and
                    translation of a treaty of compulsory arbitration between Spain and Mexico,
                    signed in this city on January 11, 1902, and promulgated by the President of
                    Mexico on the 19th ultimo.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Fenton R.
                    McCreery.</hi></signed></closer>


                <xi:include href="d776-a1.xml" xpointer="d776-a1"/>
