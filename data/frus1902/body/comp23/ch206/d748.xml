    <text>
        <body>
            <div xml:id="d748">

                <pb facs="0834" n="754" xml:id="pg754"/>

                <head><hi rendition="#italic">Mr. McCreery to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1900-06-14"><hi rendition="#italic">June 14,
                        1900</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 703.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a copy
                    of my note to the foreign office, bringing again to the attention of the Mexican
                    Government, as instructed in your No. 369 of the 7th instant, the claim known as
                    “The Pious Fund of the Californias” against Mexico.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer><signed><hi rendition="#small-caps">Fenton R.
                    McCreery.</hi></signed></closer>


                <xi:include href="d748-a1.xml" xpointer="d748-a1"/>
