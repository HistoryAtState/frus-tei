    <text>
        <body>
            <div xml:id="d790">

                <pb facs="0911" n="831" sameAs="frus:frus1902/pg831"/>

                <head><hi rendition="#italic">Mr. Clayton to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1902-09-19"><hi rendition="#italic">September 19,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1583.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith, for
                    the information of the Department, copies in duplicate of President Diaz’s
                    message delivered to Congress on the 16th instant. The Department’s attention is
                    respectfully called to the President’s remarks under the head of “The Pious Fund
                    claim,” also under the head of “The silver question.”</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Powell Clayton.</hi></signed></closer>


                <xi:include href="d790-a1.xml" xpointer="d790-a1"/>
            </div>
