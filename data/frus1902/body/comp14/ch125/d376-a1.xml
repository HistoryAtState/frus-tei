    <text>
        <body>
            <div xml:id="d376-a1">

                <pb facs="0494" n="414" sameAs="frus:frus1902/pg414"/>

                <opener><seg rendition="#center">[Inclosure 1.]</seg></opener>
                <head><hi rendition="#italic">Mr. Root to Mr. Hay</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >War Department</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-06-17"><hi rendition="#italic">June 17,
                        1902</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose, for the
                    information of your Department, copy of the report of Capt. H. J. Gallagher,
                    commissary, United States Army, the officer who was sent by the Department to
                    Martinique in charge of the supplies donated by the Government and people of the
                    United States in aid of the sufferers from the disaster of May 8 last.</p>
                <p>Very respectfully,</p>
                <closer><signed><hi rendition="#small-caps">Elihu Root</hi>,<lb/><hi
                            rendition="#italic">Secretary of War.</hi></signed></closer>
            </div>
        </body>
