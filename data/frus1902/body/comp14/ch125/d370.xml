    <text>
        <body>
            <div xml:id="d370">

                <pb facs="0492" n="412" sameAs="frus:frus1902/pg412"/>

                <head><hi rendition="#italic">President Roosevelt to President Loubet</hi>.</head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Executive Mansion</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-05-10"><hi rendition="#italic">May 10,
                        1902</hi></date>.</dateline></opener>
                <p>I pray Your Excellency to accept the profound sympathy of the American people in
                    the appalling calamity which has come upon the people of Martinique.</p>
                <closer><signed><hi rendition="#small-caps">Theodore
                    Roosevelt.</hi></signed></closer>
            </div>
        </body>
    </text>
