    <text>
        <body>
            <div xml:id="d353">

                <pb facs="0479" n="399" sameAs="frus:frus1902/pg399"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            de Margerie.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-02-04"><hi rendition="#italic">February 4,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 444.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring again to your notes of November
                    24 and December 22 last, I have now the honor to inclose a copy of the report
                    from the district attorney of the United States for the district of Washington,
                    relative to the complaint of the violation of the consular convention of 1853
                    between the United States and France.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay</hi>.</signed></closer>


                <xi:include href="d353-a1.xml" xpointer="d353-a1"/>
