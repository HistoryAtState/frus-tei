    <text>
        <body>
            <div xml:id="d349">

                <pb facs="0476" n="396" sameAs="frus:frus1902/pg396"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Cambon</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-01-03"><hi rendition="#italic">January 3,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 439.]</seg></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I have the honor to acknowledge the
                    receipt of Mr. de Margerie’s note of the 22d ultimo, relating further to the
                    violation of the consular convention of February 23, 1853, by officials of the
                    United States and the States, in the ports on the Pacific coast, and to inform
                    you in reply that I have sent copies of it to the Attorney-General, the
                    Secretary of the Treasury, and the governors of California and Oregon for their
                    information and consideration.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay</hi>.</signed></closer>
            </div>
        </body>
    </text>
