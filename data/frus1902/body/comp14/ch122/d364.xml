    <text>
        <body>
            <div xml:id="d364">

                <pb facs="0487" n="407" sameAs="frus:frus1902/pg407"/>

                <head><hi rendition="#italic">Mr. Porter to Mr. Hay</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1902-01-02"><hi rendition="#italic">January 2,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 945.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: At the request of the American Chamber of
                    Commerce I send herewith a petition addressed to you representing that in many
                    instances American citizens residing in Paris have been unable to obtain a
                    passport, and asking that the regulation may be made less stringent in this
                    respect.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Horace Porter.</hi></signed></closer>


                <xi:include href="d364-a1.xml" xpointer="d364-a1"/>
            </div>
