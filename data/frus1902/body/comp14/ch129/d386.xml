    <text>
        <body>
            <div xml:id="d386">

                <pb facs="0499" n="419" sameAs="frus:frus1902/pg419"/>

                <head><hi rendition="#italic">President Roosevelt
                        to President Loubet</hi>.</head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Oyster Bay</hi></placeName>, <date calendar="gregorian"
                            when="1902-09-04"><hi rendition="#italic">September 4,
                        1902</hi></date>.</dateline></opener>
                <p>I cordially appreciate your friendly congratulations upon my providential
                    escape.</p>
                <closer><signed><hi rendition="#small-caps">Theodore
                    Roosevelt</hi>.</signed></closer>
            </div>
        </body>
    </text>
