    <text>
        <body>
            <div xml:id="d885">

                <pb facs="1030" n="950" sameAs="frus:frus1902/pg950"/>

                <head><hi rendition="#italic">Mr. Storer to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1902-03-03"><hi rendition="#italic">March 3,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 642.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Continuing the report to the Department
                    made by myself in my dispatch No. 634, bearing date February 26, 1902,
                    concerning the action of the Spanish authorities in the case of Mr. Antonio
                    Gisbert y Bayot, I have the honor to transmit herewith copy of an official
                    letter received this morning from the consul-general at Barcelona.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Bellamy Storer.</hi></signed></closer>


                <xi:include href="d885-a1.xml" xpointer="d885-a1"/>
