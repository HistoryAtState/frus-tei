    <text>
        <body>
            <div xml:id="d894">

                <pb facs="1039" n="959" sameAs="frus:frus1902/pg959"/>

                <head><hi rendition="#italic">Mr. Sickles to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1902-05-20"><hi rendition="#italic">May 20,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 662.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a
                    copy, together with a translation, of a note that has been received from the
                    ministry of state in connection with the taking of oath of His Majesty King
                    Alfonso XIII, informing this legation in official form of that act.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Stanton Sickles.</hi></signed></closer>


                <xi:include href="d894-a1.xml" xpointer="d894-a1"/>
