    <text>
        <body>
            <div xml:id="d896">

                <pb facs="1040" n="960" sameAs="frus:frus1902/pg960"/>

                <head><hi rendition="#italic">Señor Ojeda to Mr. Adee.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of Spain</hi>,<lb/><hi rendition="#italic">New
                            York</hi></placeName>, <date calendar="gregorian" when="1902-09-24"><hi
                                rendition="#italic">September 24,
                    1902</hi></date>.</dateline></opener>
                <p>I beg you to convey to His Excellency my deep sorrow for the untoward accident,
                    and my earnest wishes for his prompt and complete recovery.</p>
                <closer><signed><hi rendition="#small-caps">Ojeda.</hi></signed></closer>
            </div>
        </body>
    </text>
