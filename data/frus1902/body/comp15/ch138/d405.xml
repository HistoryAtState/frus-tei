    <text>
        <body>
            <div xml:id="d405">

                <pb facs="0510" n="430" sameAs="frus:frus1902/pg430"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            White</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-07-15"><hi rendition="#italic">July 15,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1368.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose copies of two dispatches from the
                    consul-general at Frankfort-on-the-Main, relative to the defilement of the coat
                    of arms of the United States at the United States consulate at Bamberg.</p>
                <p>A new coat of arms will be sent for the use of the consulate at Bamberg, and you
                    will ask for its admission free of duty.</p>
            </div>
        </body>
