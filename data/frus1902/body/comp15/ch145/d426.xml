                <pb facs="0529" n="449" sameAs="frus:frus1902/pg449"/>

                <head><hi rendition="#italic">Mr. Hay to Mr. White.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-03-22"><hi rendition="#italic">March 22,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1312.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your No. 1865, of the 26th ultimo, has been
                    received, and your course in refusing to issue to Joseph Duff a passport, under
                    the circumstances set out in the dispatch, is approved.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
    </text>
