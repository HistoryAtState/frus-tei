    <text>
        <body>
            <div xml:id="d580-a1">

                <pb facs="0648" n="568" sameAs="frus:frus1902/pg568"/>

                <opener><seg rendition="#center">[Inclosure.]</seg></opener>
                <head><hi rendition="#italic">Mr. Darling to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Navy Department</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1903-01-02"><hi rendition="#italic">January 2,
                        1903</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose, for your
                    information, a copy of part of a letter received from the commanding officer of
                    the U. S. S. <hi rendition="#italic">Hartford</hi> relative to a visit of that
                    ship to Athens and Piræus, Greece.</p>
                <p>Very respectfully,</p>
                <closer><signed><hi rendition="#small-caps">Chas. H. Darling</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
