    <text>
        <body>
            <div xml:id="d577-a1">

                <pb facs="0646" n="566" sameAs="frus:frus1902/pg566"/>

                <opener><seg rendition="#center">[Inclosure.]</seg></opener>
                <head><hi rendition="#italic">Mr. Long to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Navy Department</hi>, <hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-02-17"><hi rendition="#italic">February 17,
                        1902</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith for
                    the information of the Department of State a copy of a letter this day received
                    from the commander in chief, United States naval force on the European Station,
                    with regard to his visit to Piraeus, Greece.</p>
                <p>Very respectfully,</p>
                <closer><signed><hi rendition="#small-caps">J. W. Long</hi>, <hi rendition="#italic"
                            >Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
