                <pb facs="0647" n="567" sameAs="frus:frus1902/pg567"/>

                <head><hi rendition="#italic">Mr. Wilson to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Athens</hi></placeName>, <date calendar="gregorian"
                            when="1902-06-21"><hi rendition="#italic">June 21,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 77, Greek series.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inform you that I have
                    received permission from the Greek Government for the United States consular
                    officers in that country to use their good offices in the representation of Cuba
                    and of its citizens until Cuban consuls shall have been appointed, and I have
                    notified the United States consuls in Greece to that effect.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charles S. Wilson</hi>,<lb/><hi
                            rendition="#italic">Chargé d’Affaires ad interim.</hi></signed></closer>
            </div>
        </body>
    </text>
