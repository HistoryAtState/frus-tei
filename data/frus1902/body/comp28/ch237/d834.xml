    <text>
        <body>
            <div xml:id="d834">

                <pb facs="0984" n="904" sameAs="frus:frus1902/pg904"/>

                <head><hi rendition="#italic">Mr. Loomis to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Lisbon</hi></placeName>, <date calendar="gregorian"
                            when="1902-05-30"><hi rendition="#italic">May 30,
                        1902</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I beg leave to acknowledge the receipt of
                    your telegram<anchor n="a" xml:id="d834-f1"/> of May 24.</p>
                <p>The permission was asked and granted within six hours, and the consuls have been
                    notified.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Francis B.
                    Loomis.</hi></signed></closer>
            </div>
        </body>
    </text>
