    <text>
        <body>
            <div xml:id="d133">

                <pb facs="0237" n="157" sameAs="frus:frus1902/pg157"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Conger.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-01-31"><hi rendition="#italic">January 31,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 448.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith for your information a
                    copy of a dispatch<anchor n="b" xml:id="d133-f1"/> from the United States
                    ambassador to Russia, reporting the view taken by the Russian Government
                    respecting the recent conflict between seamen of the United States Navy and the
                    Russian police at Niuchwang.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay</hi>.</signed></closer>
            </div>
        </body>
    </text>
