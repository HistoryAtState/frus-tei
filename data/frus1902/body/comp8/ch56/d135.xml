    <text>
        <body>
            <div xml:id="d135">

                <pb facs="0238" n="158" sameAs="frus:frus1902/pg158"/>

                <head><hi rendition="#italic">Mr. Conger to Mr. Hay</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1902-04-02"><hi rendition="#italic">April 2,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 963.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose to you herewith
                    a copy of a dispatch from Consul Miller, of Niuchwang, in regard to the
                    favorable impression among; the Chinese from the presence there during the
                    winter of the U. S. S. <hi rendition="#italic">Vicksburg</hi>, and requesting
                    that our Government be urged to keep a gunboat at Niuchwang until the place is
                    returned to the Chinese authorities.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">E. H. Conger</hi>.</signed></closer>


                <xi:include href="d135-a1.xml" xpointer="d135-a1"/>
