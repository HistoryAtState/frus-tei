    <text>
        <body>
            <div xml:id="d132-a21">

                <pb facs="0236" n="156" sameAs="frus:frus1902/pg156"/>

                <opener><seg rendition="#center">[Subinclosure 2.]</seg></opener>
                <head><hi rendition="#italic">Mr. Miller to Captain
                            Eberhard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Consulate of the United States</hi>,<lb/><hi rendition="#italic"
                                >Niuchwang, China</hi></placeName>, <date calendar="gregorian"
                            when="1901-12-27"><hi rendition="#italic">December 27,
                        1901</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 93.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge your
                    dispatch of December 26, complaining that about 40 men from the foreign
                    men-of-war entered this city armed with rifles and swords on the evening of the
                    26th instant.</p>
                <p>I beg to advise you that none of these men belonged to the United States gunboat
                        <hi rendition="#italic">Vicksburg</hi> stationed here for the winter.</p>
                <p>I have the honor, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Henry B. Miller</hi>.</signed></closer>
            </div>
        </body>
    </text>
