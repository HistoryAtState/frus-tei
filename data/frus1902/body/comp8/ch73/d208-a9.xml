    <text>
        <body>
            <div xml:id="d208-a9">

                <pb facs="0339" n="259" sameAs="frus:frus1902/pg259"/>

                <opener><seg rendition="#center">[Inclosure 6.]</seg></opener>
                <head><hi rendition="#italic">Mr. Fesler to Mr. Conger</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Consulate of the United States</hi>,<lb/><hi rendition="#italic"
                                >Amoy</hi></placeName>, <date calendar="gregorian" when="1902-07-23"
                                ><hi rendition="#italic">July 23,
                    1902</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to confirm your
                        telegram.<anchor n="a" xml:id="d208-f1"/></p>
                <p>In pursuance of your instructions I have to-day entered a strong protest with the
                    taotai of Amoy, and shall report fully upon receipt of his reply.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John H. Fesler</hi>, <hi
                            rendition="#italic">Consul.</hi></signed></closer>
            </div>
        </body>
    </text>
