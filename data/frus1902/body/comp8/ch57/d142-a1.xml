    <text>
        <body>
            <div xml:id="d142-a1">

                <pb facs="0251" n="171" sameAs="frus:frus1902/pg171"/>

                <opener><seg rendition="#center">[Inclosure 1.—Telegram.]</seg></opener>
                <head><hi rendition="#italic">Dr. Canright to Mr.
                            Conger.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Chentu</hi></placeName>, <date calendar="gregorian"
                            when="1902-06-20"><hi rendition="#italic">June 20,
                        1902</hi></date>.</dateline></opener>
                <p>Sze-ch’uan repeating 1900. Chapel burned, 10 Christians killed. Boxers
                    multiplying four months; officials lax.</p>
                <closer><signed><hi rendition="#small-caps">Canright</hi>.</signed></closer>
            </div>
        </body>
    </text>
