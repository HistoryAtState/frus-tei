    <text>
        <body>
            <div xml:id="d145">

                <pb facs="0255" n="175" sameAs="frus:frus1902/pg175"/>

                <head><hi rendition="#italic">Mr. Conger to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1902-09-17"><hi rendition="#italic">September 17,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1091.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my No. 1079, of the 2d
                    instant, concerning the murder of two British missionaries at Ch’en-chou, in the
                    province of Hu-nan, I have the honor to inclose copy of an imperial edict
                    published on the 11th instant, and to be, etc.,</p>
                <closer><signed><hi rendition="#small-caps">E. H. Conger</hi>.</signed></closer>



                <xi:include href="d145-a1.xml" xpointer="d145-a1"/>
