    <text>
        <body>
            <div xml:id="d205">

                <pb facs="0332" n="252" sameAs="frus:frus1902/pg252"/>

                <head><hi rendition="#italic">Mr. Conger to Mr.
                            Hay</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1902-09-09"><hi rendition="#italic">September 9,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1084.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my No. 1070, of August 16,
                    concerning the complaint made by certain Chinese, citizens of the United States,
                    in Honolulu, against the Chinese consul there, and the vicarious punishment of
                    their relatives in China, resulting from his actions, I inclose further
                    correspondence with the foreign office, and have the honor, etc.,</p>
                <closer><signed><hi rendition="#small-caps">E. H. Conger.</hi></signed></closer>





