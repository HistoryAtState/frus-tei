    <text>
        <body>
            <div xml:id="d218">

                <pb facs="0350" n="270" sameAs="frus:frus1902/pg270"/>

                <head><hi rendition="#italic">Mr. Conger to Mr.
                            Hay</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1902-10-16"><hi rendition="#italic">October 16,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1121.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to confirm Department’s
                    telegram of October 10 concerning the death of Viceroy Liu K’un-yi, and to
                    report that its contents have been conveyed to the Chinese Government as
                    directed, and a reply received, copies of which communications are inclosed.</p>
                <p>I nave, etc.,</p>
                <closer><signed><hi rendition="#small-caps">E. H. Conger.</hi></signed></closer>



                <xi:include href="d218-a1.xml" xpointer="d218-a1"/>
