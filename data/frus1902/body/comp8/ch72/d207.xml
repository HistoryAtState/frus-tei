    <text>
        <body>
            <div xml:id="d207">

                <pb facs="0334" n="254" sameAs="frus:frus1902/pg254"/>

                <head><hi rendition="#italic">Mr. Conger to Mr.
                            Hay</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1902-07-02"><hi rendition="#italic">July 2,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1033.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Inclosed please find translation of a
                    proclamation issued by Governor Yuan Shih-k’ai, on the 1st instant, concerning
                    the carrying of arms by private citizens, and enjoining all Chinese, both
                    Christians and non-Christians, to avoid trouble and live in peace together.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">E. H. Conger</hi>.</signed></closer>


                <xi:include href="d207-a1.xml" xpointer="d207-a1"/>
