    <text>
        <body>
            <div xml:id="d186">

                <pb facs="0307" n="227" sameAs="frus:frus1902/pg227"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Conger.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-04-30"><hi rendition="#italic">April 30,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 512.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    No. 950, of the 19th ultimo, reporting that the Chinese Government declines to
                    issue passports for Thibet upon the applications of Messrs. Ruhl and Snyder,
                    American missionaries.</p>
                <p>Your action in declining to urge their request upon the Chinese Government is
                    approved.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay</hi>.</signed></closer>
            </div>
        </body>
    </text>
