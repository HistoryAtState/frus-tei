    <text>
        <body>
            <div xml:id="d231">

                <pb facs="0359" n="279" sameAs="frus:frus1902/pg279"/>

                <head><hi rendition="#italic">Mr. Bainbridge to Mr. Hay</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1902-04-17"><hi rendition="#italic">April 17,
                        1902</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In the absence of the minister I have the
                    honor to inclose a copy of the French text of the Russo-Chinese Manchurian
                    convention, which was signed at Peking on the 8th instant.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. E. Bainbridge.</hi></signed></closer>



                <xi:include href="d231-a1.xml" xpointer="d231-a1"/>
