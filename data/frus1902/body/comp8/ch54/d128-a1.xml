                <pb facs="0221" n="141" sameAs="frus:frus1902/pg141"/>

                <opener><seg rendition="#center">[Inclosure 1.]</seg></opener>
                <head><hi rendition="#italic">Chang Kai-chin et al. to Mr. Conger.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Fatshan</hi></placeName>, <date calendar="gregorian"
                            when="1902-02-23"><hi rendition="#italic">February 23,
                        1902</hi></date>.</dateline></opener>
                <p>The children of Chang Yin-huan offer their hearty thanks for the kindness shown
                    to their deceased father.</p>
                <closer><signed><hi rendition="#small-caps">Chang Kai-chin.</hi></signed></closer>
            </div>
        </body>
