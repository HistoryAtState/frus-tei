    <text>
        <body>
            <div xml:id="d190">

                <pb facs="0310" n="230" sameAs="frus:frus1902/pg230"/>

                <head><hi rendition="#italic">Mr. Hay to Mr. Conger.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-07-18"><hi rendition="#italic">July 18,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 545.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    No. 982, of May 10 last, and to inclose herewith for your information printed
                    copies of the rules which have been adopted governing the appointment,
                    organization, etc., of the corps of student interpreters in China provided for
                    by the diplomatic and consular act approved March 22, 1902.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay</hi>.</signed></closer>



                <xi:include href="d190-a1.xml" xpointer="d190-a1"/>
