    <text>
        <body>
            <div xml:id="d194">

                <pb facs="0314" n="234" sameAs="frus:frus1902/pg234"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Conger</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-10-28"><hi rendition="#italic">October 28,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 580.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    No. 1077, of August 29 last, and to inform you that an item for $8,000, for the
                    erection of a suitable building for the accommodation of the ten student
                    interpreters, and another for $1,000 for the payment of the yearly cost of their
                    tuition, have been inserted in the estimates for the next fiscal year.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay</hi>.</signed></closer>
            </div>
        </body>
    </text>
