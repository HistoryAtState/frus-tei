    <text>
        <body>
            <div xml:id="d917">

                <pb facs="1061" n="981" sameAs="frus:frus1902/pg981"/>

                <head><hi rendition="#italic">Mr. Hay to Mr. Hardy.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-05-06"><hi rendition="#italic">May 6,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 32.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose copy of a letter from Senator
                    Wetmore requesting a full history of the initiative and referendum in
                    Switzerland.</p>
                <p>I should be pleased to have you give this request immediate attention, so that
                    the information desired may reach the Department not later than July 15
                    next.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>



                <xi:include href="d917-a1.xml" xpointer="d917-a1"/>
            </div>
