    <text>
        <body>
            <div xml:id="d919">

                <pb facs="1074" n="994" sameAs="frus:frus1902/pg994"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Hardy.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-07-02"><hi rendition="#italic">July 2,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 40.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your No. 62, of the 10th ultimo,
                    transmitting, in compliance with the request made in the Department’s
                    instruction No. 32, of May 6 last, a report on the initiative and referendum in
                    Switzerland, has been received.</p>
                <p>The Department desires to commend the conscientious care shown in the preparation
                    of the report.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
    </text>
