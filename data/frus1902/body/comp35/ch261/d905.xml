    <text>
        <body>
            <div xml:id="d905">

                <pb facs="1049" n="969" sameAs="frus:frus1902/pg969"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Hardy.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-02-28"><hi rendition="#italic">February 28,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 27.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your No. 43 of the 13th instant relative to
                    the application of Helena Pecare for a passport has been received.</p>
                <p>Under the circumstances detailed in the dispatch your refusal to grant the
                    passport to Miss Pecare has the Department’s approval.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
