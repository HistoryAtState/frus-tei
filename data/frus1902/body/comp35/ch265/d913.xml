    <text>
        <body>
            <div xml:id="d913">

                <pb facs="1058" n="978" sameAs="frus:frus1902/pg978"/>

                <head><hi rendition="#italic">Mr. Adee to Mr.
                            Hardy.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-09-17"><hi rendition="#italic">September 17,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 46.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your No. 72 of the 1st instant has been
                    received, and your refusal to issue to Bernhard Kaufmann a passport under the
                    circumstances detailed in the dispatch is commended.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alvey A. Adee</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
