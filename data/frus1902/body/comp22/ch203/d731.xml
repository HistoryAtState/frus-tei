    <text>
        <body>
            <div xml:id="d731">

                <pb facs="0815" n="735" sameAs="frus:frus1902/pg735"/>

                <head><hi rendition="#italic">Mr. Hay to Mr. Allen.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-06-12"><hi rendition="#italic">June 12,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 196.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    dispatch No. 456, of the 7th ultimo, requesting that you be instructed to accept
                    a substitute <pb facs="0816" n="736" xml:id="pg736"/> amendment proposed by the
                    Japanese Government, of Article VI of the land regulations for the general
                    foreign settlement of Chemulpo, and to inform you in reply that you may agree to
                    the amendment proposed by Japan.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
