    <text>
        <body>
            <div xml:id="d588">

                <pb facs="0663" n="583" sameAs="frus:frus1902/pg583"/>

                <head><hi rendition="#italic">Mr. Bailey to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Guatemala and Honduras, Guatemala</hi></placeName>, <date
                            calendar="gregorian" when="1902-06-05"><hi rendition="#italic">June 5,
                                1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 644.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to confirm the
                    Department’s cablegram<anchor n="a" xml:id="d588-f1"/> of May 24, 1902.</p>
                <p>Permission has been granted in accordance with the request made in the above
                    cable by the Governments of Guatemala and Honduras. I have notified United
                    States consuls.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">James G. Bailey.</hi></signed></closer>
            </div>
        </body>
    </text>
