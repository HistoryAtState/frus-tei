                <pb facs="0664" n="584" sameAs="frus:frus1902/pg584"/>

                <head><hi rendition="#italic">President Roosevelt
                        to President Estrada.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >White House</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-09-05"><hi rendition="#italic">September 5,
                        1902</hi></date>.</dateline></opener>
                <p>I esteem your kindly greeting.</p>
                <closer><signed><hi rendition="#small-caps">Theodore
                    Roosevelt</hi>.</signed></closer>
            </div>
