    <text>
        <body>
            <div xml:id="d682">

                <pb facs="0762" n="682" sameAs="frus:frus1902/pg682"/>

                <head><hi rendition="#italic">Mr. Adee to Mr. Leger.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-09-08"><hi rendition="#italic">September 8,
                        1902</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: The Department sincerely appreciates your
                    note of the 4th instant expressing your satisfaction at the President’s escape
                    from serious injury in the accident at Pittsfield, Mass., and your sympathy with
                    the families of the victims.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alvey A. Adee</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
