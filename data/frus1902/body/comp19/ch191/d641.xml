    <text>
        <body>
            <div xml:id="d641">

                <pb facs="0729" n="649" sameAs="frus:frus1902/pg649"/>

                <head><hi rendition="#italic">Mr. Powell to Mr.
                            Hay.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Port au Prince</hi></placeName>, <date calendar="gregorian"
                            when="1902-09-07"><hi rendition="#italic">September 7,
                        1902</hi></date>.</dateline></opener>
                <p>Reported <hi rendition="#italic">Panther</hi> sunk <hi rendition="#italic"
                        >Crête</hi> yesterday; ordered her surrender; Killick refused; 30 shots
                    tired into her; Killick and crew went down with vessel.</p>
                <closer><signed><hi rendition="#small-caps">Powell.</hi></signed></closer>
            </div>
        </body>
    </text>
