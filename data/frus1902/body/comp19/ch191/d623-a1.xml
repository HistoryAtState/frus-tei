    <text>
        <body>
            <div xml:id="d623-a1">

                <pb facs="0700" n="620" sameAs="frus:frus1902/pg620"/>

                <opener><seg rendition="#center">[Inclosure 1.]</seg></opener>
                <head><hi rendition="#italic">Mr. Taylor to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Navy Department</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-07-29"><hi rendition="#italic">July 29,
                        1902</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose for your
                    information a copy of a letter from the commanding officer of the U. S. S. <hi
                        rendition="#italic">Marietta</hi>, dated the 9th instant, reporting a visit
                    to Port de Paix, Haiti.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">H. C. Taylor</hi>, <hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
