    <text>
        <body>
            <div xml:id="d617-a2">

                <pb facs="0695" n="615" sameAs="frus:frus1902/pg615"/>

                <opener><seg rendition="#center">[Inclosure 2.]</seg></opener>
                <head><hi rendition="#italic">Mr. Powell to Mr. Canel.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Port au Prince</hi></placeName>, <date calendar="gregorian"
                            when="1902-07-25"><hi rendition="#italic">July 25,
                        1902</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your favor, bringing to my attention as the dean of the diplomatic corps
                    certain matters that you desire to have communicated to them.</p>
                <p>Accept, etc.</p>
                <closer><signed><hi rendition="#small-caps">W. F. Powell.</hi></signed></closer>
            </div>
        </body>
