    <text>
        <body>
            <div xml:id="d623-a3">

                <pb facs="0701" n="621" xml:id="pg621"/>

                <opener><seg rendition="#center">[Inclosure 2.]</seg></opener>
                <head><hi rendition="#italic">Mr. Taylor to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Navy Department</hi></placeName>, <date calendar="gregorian"
                            when="1902-07-29"><hi rendition="#italic">July 29,
                        1902</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith, for
                    your information, a copy of a letter received from the commanding officer of the
                    U. S. S. <hi rendition="#italic">Marietta</hi>, dated the 13th instant,
                    reporting on the condition of affairs at Cape Haitien, Haiti.</p>
                <p>I have etc.,</p>
                <closer><signed><hi rendition="#small-caps">H. C. Taylor</hi>, <hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
