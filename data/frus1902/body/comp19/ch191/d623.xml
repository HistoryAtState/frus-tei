    <text>
        <body>
            <div xml:id="d623">

                <pb facs="0700" n="620" sameAs="frus:frus1902/pg620"/>

                <head><hi rendition="#italic">Mr. Adee to Mr.
                            Powell.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-08-02"><hi rendition="#italic">August 2,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 526.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose for your information copies of
                    two letters from the Secretary of the Navy forwarding” copies of letters from
                    the commanding officer of the U. S. S. <hi rendition="#italic">Marietta</hi>,
                    reporting concerning the condition of affairs at Cape Haitien and Fort de
                    Paix.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alvey A. Adee</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>






