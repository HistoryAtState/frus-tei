    <text>
        <body>
            <div xml:id="d678">

                <pb facs="0758" n="678" sameAs="frus:frus1902/pg678"/>

                <head><hi rendition="#italic">Mr. Powell to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Port au Prince</hi></placeName>, <date calendar="gregorian"
                            when="1902-06-04"><hi rendition="#italic">June 4,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1102.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose to the
                    Department copies of the correspondence which has passed between the foreign
                    office of the Provisional Government of this Republic and your legation
                    regarding the assent of the Haitian Government to the request that United States
                    consular officers be temporarily charged with the commercial interests of the
                    Republic of Cuba and the protection of its citizens resident in this
                    Republic.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. F. Powell.</hi></signed></closer>



                <xi:include href="d678-a1.xml" xpointer="d678-a1"/>
