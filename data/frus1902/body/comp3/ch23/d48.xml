    <text>
        <body>
            <div xml:id="d48">

                <pb facs="0141" n="61" sameAs="frus:frus1902/pg61"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            McCormick.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-01-03"><hi rendition="#italic">January 3,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 25.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose for investigation and appropriate
                    action a copy of a letter from which it appears that a man named Kristof, an
                    American citizen, is being compelled to perform military service in the army of
                    Austria-Hungary.</p>
                <p>His certificate of naturalization is also inclosed, and it has been suggested to
                    Mr. Klein to advise Kristof to address you.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>


                <xi:include href="d48-a1.xml" xpointer="d48-a1"/>
            </div>
