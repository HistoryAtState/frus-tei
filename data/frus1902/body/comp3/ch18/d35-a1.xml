    <text>
        <body>
            <div xml:id="d35-a1">

                <pb facs="0119" n="39" xml:id="pg39"/>

                <opener><seg rendition="#center">[Inclosure.]</seg></opener>
                <head><hi rendition="#italic">Mr. Landis to Mr. Hill.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Delphi, Ind.</hi></placeName>, <date calendar="gregorian"
                            when="1902-08-11"><hi rendition="#italic">August 11,
                        1902</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. Hill</hi>: I transmit herewith a letter in
                    the matter which I referred to you recently relative to the Sterling Remedy
                    Company’s attempt to establish itself in Vienna.</p>
                <p>Kindly make it a part of the papers.</p>
                <p>Very truly, yours,</p>
                <closer><signed><hi rendition="#small-caps">C. B. Landis.</hi></signed></closer>
            </div>
        </body>
    </text>
