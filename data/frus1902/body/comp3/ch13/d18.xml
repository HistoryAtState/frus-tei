    <text>
        <body>
            <div xml:id="d18">

                <pb facs="0106" n="26" sameAs="frus:frus1902/pg26"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            McCormick</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-02-03"><hi rendition="#italic">February 3,
                        1902</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to inclose herewith a copy of a
                    memorandum expressing the views of the United States in regard to the proposed
                    convention and arrangement between the Chinese and Russian Governments
                    respecting Manchuria, which has been cabled to the American missions at Pekin
                    and St. Petersburg. You will take early occasion to acquaint the Government to
                    which you are accredited with the text of this memorandum.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>


                <xi:include href="d18-a1.xml" xpointer="d18-a1"/>
