                <pb facs="0129" n="49" xml:id="pg49"/>

                <head><hi rendition="#italic">The President to the Emperor of Austria.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >White House</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-09-06"><hi rendition="#italic">September 6,
                        1902</hi></date>.</dateline></opener>
                <p>I cordially esteem Your Majesty’s solicitous sympathy.</p>
                <closer><signed><hi rendition="#small-caps">Theodore
                    Roosevelt.</hi></signed></closer>
            </div>
