    <text>
        <body>
            <div xml:id="d557-a6">

                <pb facs="0622" n="542" sameAs="frus:frus1902/pg542"/>

                <opener><seg rendition="#center">[Subinclosure 3.]</seg></opener>
                <head><hi rendition="#italic">Translation of summons.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Van</hi></placeName>, <date calendar="gregorian" when="1902-04-23"
                                ><hi rendition="#italic">April 23,
                    1902</hi></date>.</dateline></opener>
                <p rendition="#flush">To the honorable the <hi rendition="#small-caps">English
                        Vice-Consul</hi>:</p>
                <p>Dr. Ussher, who has been in Bitlis, but has now returned to Van, we request to
                    attend the examining department to give evidence in his case. This is judged to
                    be necessary by the assistant procurator.</p>
                <p>(Seal of the governor-general.)</p>
            </div>
        </body>
