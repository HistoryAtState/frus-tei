    <text>
        <body>
            <div xml:id="d550">

                <pb facs="0617" n="537" sameAs="frus:frus1902/pg537"/>

                <head><hi rendition="#italic">President Roosevelt to King Edward VII.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >White House</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-06-24"><hi rendition="#italic">June 24,
                        1902</hi></date>.</dateline></opener>
                <p>I ask Your Majesty to accept my sincere assurance of sympathy and wishes for
                    speedy convalescence.</p>
                <closer><signed><hi rendition="#small-caps">Theodore
                    Roosevelt</hi>.</signed></closer>
            </div>
        </body>
    </text>
