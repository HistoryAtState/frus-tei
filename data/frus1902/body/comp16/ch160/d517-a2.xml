    <text>
        <body>
            <div xml:id="d517-a2">

                <pb facs="0592" n="512" sameAs="frus:frus1902/pg512"/>

                <opener><seg rendition="#center">[Inclosure 2.]</seg></opener>
                <head><hi rendition="#italic">Lord Lansdowne to Mr. Choate</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Foreign Office</hi></placeName>, <date calendar="gregorian"
                            when="1902-02-19"><hi rendition="#italic">February 19,
                        1902</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Your Excellency</hi>: I have the honor to acknowledge
                    the receipt of your note of the 14th instant, transmitting a copy of a
                    memorandum which gives the views of the United States Government in regard to
                    some suggested arrangements between the Chinese and Russian Governments
                    respecting Manchuria.</p>
                <p>I have to thank your excellency for this interesting statement, the substance of
                    which you had already been good enough to communicate to me verbally.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Lansdowne.</hi></signed></closer>
            </div>
        </body>
    </text>
