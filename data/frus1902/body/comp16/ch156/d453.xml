    <text>
        <body>
            <div xml:id="d453">

                <pb facs="0544" n="464" sameAs="frus:frus1902/pg464"/>

                <head><hi rendition="#italic">Mr. Choate to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >London</hi></placeName>, <date calendar="gregorian" when="1900-10-27"
                                ><hi rendition="#italic">October 27, 1900</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 418.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to your instruction No. 468,
                    of the 16th instant, I have the honor to inclose herewith a copy of a note
                    which, on the 25th instant, I addressed to Her Majesty’s secretary of state for
                    foreign affairs.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Joseph H. Choate.</hi></signed></closer>



                <xi:include href="d453-a1.xml" xpointer="d453-a1"/>
