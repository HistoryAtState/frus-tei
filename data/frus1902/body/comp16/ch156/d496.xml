    <text>
        <body>
            <div xml:id="d496">

                <pb facs="0575" n="495" sameAs="frus:frus1902/pg495"/>

                <head><hi rendition="#italic">Mr. Choate to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >London</hi></placeName>, <date calendar="gregorian" when="1902-08-21"
                                ><hi rendition="#italic">August 21, 1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 923.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to my note of the 28th
                    ultimo, I have the honor to inclose herewith a list of prisoners of war at St.
                    Helena, who are citizens of the United States, which I have just received from
                    the foreign office.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Joseph H. Choate.</hi></signed></closer>



                <xi:include href="d496-a1.xml" xpointer="d496-a1"/>
