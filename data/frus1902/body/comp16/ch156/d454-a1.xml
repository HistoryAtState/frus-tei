    <text>
        <body>
            <div xml:id="d454-a1">

                <pb facs="0545" n="465" sameAs="frus:frus1902/pg465"/>

                <opener><seg rendition="#center">[Inclosure 1.]</seg></opener>
                <head><hi rendition="#italic">Mr. Wilson to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >House of Representatives</hi>,<lb/><hi rendition="#italic"
                                >Brooklyn, N. Y.</hi></placeName>, <date calendar="gregorian"
                            when="1900-10-15"><hi rendition="#italic">October 15,
                        1900</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose you herewith a
                    letter received from one of my constituents which will explain itself. I would
                    esteem it a great favor if you could secure the desired parole for Mr. William
                    Smith, if it be consistent with the practice of your Department.</p>
                <p>Very respectfully,</p>
                <closer><signed><hi rendition="#small-caps">Frank E. Wilson.</hi></signed></closer>
            </div>
        </body>
