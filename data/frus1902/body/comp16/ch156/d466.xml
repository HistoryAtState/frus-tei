    <text>
        <body>
            <div xml:id="d466">

                <pb facs="0554" n="474" xml:id="pg474"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Choate.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1901-06-04"><hi rendition="#italic">June 4,
                        1901</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 647.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith copy of a letter from
                    Hon. James R. Mann, a member of Congress from Illinois, who desires inquiry to
                    be made with a view to ascertain whether William Frederick Versluis, who is held
                    as a British prisoner of war on the island of Ceylon, may not be released on
                    parole on the understanding that he will return to the United States, his
                    brothers furnishing the passage money.</p>
                <p>You may make the inquiry.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>


                <xi:include href="d466-a1.xml" xpointer="d466-a1"/>
