    <text>
        <body>
            <div xml:id="d489">

                <pb facs="0572" n="492" xml:id="pg492"/>

                <head><hi rendition="#italic">Mr. Hay to Mr. Choate.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-05-21"><hi rendition="#italic">May 21,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 922.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose a copy of a letter from the Hon.
                    Henry F. Naphen, M. C., asking for a list of prisoners of war of American
                    nationality taken during the war in South Africa, together with a statement
                    showing the States from which the prisoners come.</p>
                <p>You will endeavor to obtain the information desired.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>


                <xi:include href="d489-a1.xml" xpointer="d489-a1"/>
