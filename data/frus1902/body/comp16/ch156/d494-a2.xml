    <text>
        <body>
            <div xml:id="d494-a2">

                <pb facs="0574" n="494" sameAs="frus:frus1902/pg494"/>

                <opener><seg rendition="#center">[Subinclosure 1.]</seg></opener>
                <head><hi rendition="#italic">United States citizens, Bermuda.</hi></head>
                <table cols="4" rows="5">
                    <row role="label">
                        <cell rendition="#border-bottom #border-right #border-top">No.</cell>
                        <cell rendition="#border-bottom #border-right #border-top">Name.</cell>
                        <cell rendition="#border-bottom #border-right #border-top">State or
                            Territory.</cell>
                        <cell rendition="#border-bottom #border-top">Remarks.</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">24131</cell>
                        <cell rendition="#nowrap #border-right">Du Queene, F. J</cell>
                        <cell rendition="#border-right">Indian Territory</cell>
                        <cell>Editor of Petit Bleu; said he had no nationality.</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">21229</cell>
                        <cell rendition="#nowrap #border-right">Molloy, J. L</cell>
                        <cell rendition="#border-right">Massachusetts</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell rendition="#border-right">11265</cell>
                        <cell rendition="#nowrap #border-right">Halley, M</cell>
                        <cell rendition="#border-right">Nevada</cell>
                        <cell>This man’s name was not included in rolls sent you on 13th instant,
                            No. S. A. 723/1, as he has only since given this information.</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right #border-bottom"/>
                        <cell rendition="#nowrap #border-right #border-bottom">Rubino,
                            Antonio</cell>
                        <cell rendition="#border-right #border-bottom">New York</cell>
                        <cell rendition="#border-bottom">Reported in House of Representatives as
                            being a citizen.</cell>
                    </row>
                </table>
                <closer>
                    <dateline rendition="#float-left"><placeName>Bermuda</placeName>, <date
                            calendar="gregorian" when="1902-06-24">June 24, 1902</date>.</dateline>
                    <lb/>
                    <signed><hi rendition="#small-caps">Le G. Geary</hi>,<lb/><hi
                            rendition="#italic">Lieutenant-General, Commanding the Troops,
                            Bermuda.</hi></signed></closer>
            </div>
