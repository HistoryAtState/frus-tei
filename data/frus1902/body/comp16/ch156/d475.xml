                <pb facs="0560" n="480" sameAs="frus:frus1902/pg480"/>

                <head><hi rendition="#italic">Mr. Hay to Mr. White.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1901-10-30"><hi rendition="#italic">October 30,
                        1901</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 758.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your No. 687, of the 19th instant,
                    regarding the reported release of three German prisoners of war who were
                    detained on Ceylon, has been received. The matter is commended to your
                    attention.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
    </text>
