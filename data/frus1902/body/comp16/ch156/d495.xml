    <text>
        <body>
            <div xml:id="d495">

                <pb facs="0575" n="495" sameAs="frus:frus1902/pg495"/>

                <head><hi rendition="#italic">Mr. Choate to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >London</hi></placeName>, <date calendar="gregorian" when="1902-08-11"
                                ><hi rendition="#italic">August 11, 1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 914.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a copy
                    of a note, dated August 8, which I have just received from the foreign office,
                    stating that 10 prisoners of war of American nationality are still in the island
                    of Ceylon, being unable to defray the cost of their passage home, and inquiring
                    whether the United States Government wishes to let them remain to await their
                    turn to be sent home or to make special arrangements for their conveyance.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Joseph H. Choate.</hi></signed></closer>


                <xi:include href="d495-a1.xml" xpointer="d495-a1"/>
