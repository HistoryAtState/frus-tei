    <text>
        <body>
            <div xml:id="d505">

                <pb facs="0581" n="501" sameAs="frus:frus1902/pg501"/>

                <head><hi rendition="#italic">Mr. Raikes to Mr.
                            Hay</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >British Embassy</hi></placeName>, <date calendar="gregorian"
                            when="1902-06-24"><hi rendition="#italic">June 24,
                        1902</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. Secretary</hi>: I deeply regret to inform
                    you that owing to the illness of the King, my sovereign, the coronation ceremony
                    and all festivities have been indefinitely postponed.</p>
                <p>I remain, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Arthur Raikes.</hi></signed></closer>
            </div>
        </body>
    </text>
