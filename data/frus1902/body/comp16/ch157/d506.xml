                <pb facs="0582" n="502" xml:id="pg502"/>

                <head><hi rendition="#italic">Mr. Choate to Mr.
                            Hay.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >London</hi></placeName>, <date calendar="gregorian" when="1902-06-24"
                                ><hi rendition="#italic">June 24,
                    1902</hi></date>.</dateline></opener>
                <p>Coronation has just been indefinitely postponed owing to the King’s
                    indisposition. * * *</p>
                <closer><signed><hi rendition="#small-caps">Choate.</hi></signed></closer>
            </div>
