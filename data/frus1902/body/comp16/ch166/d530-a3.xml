    <text>
        <body>
            <div xml:id="d530-a3">

                <pb facs="0605" n="525" sameAs="frus:frus1902/pg525"/>

                <opener><seg rendition="#center">[Inclosure 3.]</seg></opener>
                <head><hi rendition="#italic">Mr. Villiers to Mr.
                            White.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Foreign Office</hi></placeName>, <date calendar="gregorian"
                            when="1902-05-15T19:00:00+00:00"><hi rendition="#italic">May 15—7
                                p.m.</hi></date></dateline>
                    <seg rendition="#float-left">Immediate.]</seg></opener>
                <p><hi rendition="#small-caps">My Dear Mr. White</hi>: I inclose, for the
                    information of the ambassador, extract of a letter just received from the
                    colonial office. Lord Lansdowne will, of course, address an official note to his
                    excellency.</p>
                <p>Yours, sincerely,</p>
                <closer><signed><hi rendition="#small-caps">F. H. Villiers.</hi></signed></closer>
            </div>
        </body>
