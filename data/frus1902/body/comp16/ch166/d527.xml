    <text>
        <body>
            <div xml:id="d527">

                <pb facs="0603" n="523" sameAs="frus:frus1902/pg523"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Choate.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-05-12"><hi rendition="#italic">May 12,
                        1902</hi></date>.</dateline></opener>
                <p>Express to British Government the sympathy of the President and the people of
                    this country in the affliction which has befallen St. Vincent, and our desire to
                    share in the work of aid and rescue.</p>
                <closer><signed><hi rendition="#small-caps">Hay</hi>.</signed></closer>
            </div>
        </body>
