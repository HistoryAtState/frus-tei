    <text>
        <body>
            <div xml:id="d514">

                <pb facs="0590" n="510" sameAs="frus:frus1902/pg510"/>

                <head><hi rendition="#italic">Mr. Adee to Mr. Raikes</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-08-09"><hi rendition="#italic">August 9,
                        1902</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Chargé</hi>: As supplementary to my
                    telegram of the 6th instant (which I herewith confirm), I inclose a copy of a
                    report made by the commanding officer of the U. S. S. <hi rendition="#italic"
                        >Philadelphia</hi> regarding the protection by him of British interests in
                    Colombia.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alvey A. Adee.</hi></signed></closer>


                <xi:include href="d514-a1.xml" xpointer="d514-a1"/>
