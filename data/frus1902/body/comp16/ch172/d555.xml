    <text>
        <body>
            <div xml:id="d555">

                <pb facs="0618" n="538" sameAs="frus:frus1902/pg538"/>

                <head><hi rendition="#italic">Mr. Hill to Mr. Raikes.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-07-25"><hi rendition="#italic">July 25,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 2502.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose for your
                    information a copy of a dispatch (written in Washington) from the consul of the
                    United States in Gaudeloupe, giving a general account of his acts performed for
                    British subjects after the distressing death of His Majesty’s consul at
                    Martinique; the late James Japp.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">David J. Hill</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>


                <xi:include href="d555-a1.xml" xpointer="d555-a1"/>
