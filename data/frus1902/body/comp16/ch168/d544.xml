    <text>
        <body>
            <div xml:id="d544">

                <pb facs="0611" n="531" sameAs="frus:frus1902/pg531"/>

                <head><hi rendition="#italic">Mr. Raikes to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-05-31"><hi rendition="#italic">May 31,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 138.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have received the commands of the King,
                    my gracious sovereign, to convey to the President His Majesty’s high
                    appreciation of the signs of respect which the President himself as well as the
                    United States Government showed to the memory of Lord Pauncefote during the
                    recent ceremonies at this capital.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Arthur S. Raikes.</hi></signed></closer>
            </div>
        </body>
    </text>
