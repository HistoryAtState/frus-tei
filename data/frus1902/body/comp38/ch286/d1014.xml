    <text>
        <body>
            <div xml:id="d1014">

                <pb facs="1147" n="1067" sameAs="frus:frus1902/pg1067"/>

                <head><hi rendition="#italic">Mr. Bowen to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Caracas</hi></placeName>, <date calendar="gregorian"
                            when="1902-05-02"><hi rendition="#italic">May 2,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 92.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inform you that
                    diplomatic relations have been renewed between France and Venezuela, in
                    accordance with the terms of a protocol, copy of which I inclose.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Herbert W. Bowen.</hi></signed></closer>


                <xi:include href="d1014-a1.xml" xpointer="d1014-a1"/>
