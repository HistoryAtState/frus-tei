                <pb facs="1150" n="1070" sameAs="frus:frus1902/pg1070"/>

                <head><hi rendition="#italic">Mr. Bowen to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Caracas</hi></placeName>, <date calendar="gregorian"
                            when="1902-06-29"><hi rendition="#italic">June 29,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 105.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: * * * I inclose a translation of the decree
                    published yesterday declaring the “mouths” of the Orinoco and the port of Velade
                    Coro blockaded.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Herbert W. Bowen.</hi></signed></closer>


                <xi:include href="d1019-a1.xml" xpointer="d1019-a1"/>
