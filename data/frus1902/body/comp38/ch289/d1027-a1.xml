    <text>
        <body>
            <div xml:id="d1027-a1">

                <pb facs="1154" n="1074" sameAs="frus:frus1902/pg1074"/>

                <opener><seg rendition="#center">[Inclosure.]</seg></opener>
                <head><hi rendition="#italic">Mr. Taylor to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Navy Department</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-09-30"><hi rendition="#italic">September 30,
                        1902</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose for your
                    information a copy of a letter from the commanding officer of the <hi
                        rendition="#italic">Marietta</hi>, dated at La Guaira, Venezuela, the 22d
                    instant, relating to the use of the American flag by the gunboat <hi
                        rendition="#italic">Restaurador</hi>.</p>
                <p>Very respectfully,</p>
                <closer><signed><hi rendition="#small-caps">H. C. Taylor</hi>, <hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
