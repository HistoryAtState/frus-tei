    <text>
        <body>
            <div xml:id="d992">

                <pb facs="1128" n="1048" sameAs="frus:frus1902/pg1048"/>

                <head><hi rendition="#italic">President Roosevelt
                        to the Sultan of Turkey.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >White House</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-09-01"><hi rendition="#italic">September 1,
                        1902</hi></date>.</dateline></opener>
                <p>I ask Your Majesty to accept my congratulations upon the anniversary of your
                    accession to the Ottoman throne.</p>
                <closer><signed><hi rendition="#small-caps">Theodore
                    Roosevelt.</hi></signed></closer>
            </div>
        </body>
