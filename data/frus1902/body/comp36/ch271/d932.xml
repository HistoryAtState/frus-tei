    <text>
        <body>
            <div xml:id="d932">

                <pb facs="1087" n="1007" sameAs="frus:frus1902/pg1007"/>

                <head><hi rendition="#italic">Mr. Adee to Mr.
                            Eddy.</hi></head>
                <opener><seg rendition="#center">[Telegram.—Paraphrase.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1901-10-04"><hi rendition="#italic">October 4,
                        1901</hi></date>.</dateline></opener>
                <p>(Mr. Adee states that the people of the United States are thrilled with horror by
                    the kidnaping of Miss Stone, and directs Mr. Eddy to say to the Porte that the
                    Government of the United States urgently requests it to use its utmost efforts
                    to effect her rescue.)</p>
            </div>
        </body>
