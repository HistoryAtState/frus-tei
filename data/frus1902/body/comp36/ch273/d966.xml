    <text>
        <body>
            <div xml:id="d966">

                <pb facs="1106" n="1026" xml:id="pg1026"/>

                <head><hi rendition="#italic">President Roosevelt
                        to the Sultan of Turkey.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >White House</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-03-24"><hi rendition="#italic">March 24,
                        1902</hi></date>.</dateline></opener>
                <p>I tender Your Majesty cordial felicitations on the recurrence of Bairam.</p>
                <closer><signed><hi rendition="#small-caps">Theodore
                    Roosevelt.</hi></signed></closer>
            </div>
        </body>
