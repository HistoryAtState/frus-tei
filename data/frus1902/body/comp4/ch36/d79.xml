                <pb facs="0178" n="98" sameAs="frus:frus1902/pg98"/>

                <head><hi rendition="#italic">Mr. Adee to Mr.
                            Winthrop.</hi></head>
                <opener><seg rendition="#center">[Telegram.—Paraphrase.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-09-20"><hi rendition="#italic">September 20,
                        1902</hi></date>.</dateline></opener>
                <p>(Mr. Adee directs Mr. Winthrop to express, on behalf of the President and
                    Government of the United States, feelings of sincere sorrow and condolence by
                    reason of the death of Her Majesty the Queen.)</p>
            </div>
