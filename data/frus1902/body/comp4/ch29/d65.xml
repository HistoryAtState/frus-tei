    <text>
        <body>
            <div xml:id="d65">

                <pb facs="0156" n="76" sameAs="frus:frus1902/pg76"/>

                <head><hi rendition="#italic">Mr. Hay to Baron Moncheur.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1901-12-24"><hi rendition="#italic">December 24,
                        1901</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 14.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your memorandum of the 20th instant, relating further to the fine imposed in
                    March or April on the owners of the steamship <hi rendition="#italic"
                        >Belgika</hi>, and to inform you that I have once more called the attention
                    of the Secretary of War to the matter, with the request that he cause a report
                    of the proper authorities in the Philippine Islands to be made and sent to
                    me.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
    </text>
