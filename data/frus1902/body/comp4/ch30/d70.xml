    <text>
        <body>
            <div xml:id="d70">

                <pb facs="0160" n="80" sameAs="frus:frus1902/pg80"/>

                <head><hi rendition="#italic">Mr. Townsend to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Brussels</hi></placeName>, <date calendar="gregorian"
                            when="1902-03-06"><hi rendition="#italic">March 6,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 127.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith two
                    official copies, together with a translation, of the sugar convention signed at
                    Brussels, March 5, 1902, at 6 p.m.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Lawrence
                    Townsend.</hi></signed></closer>


                <xi:include href="d70-a1.xml" xpointer="d70-a1"/>
