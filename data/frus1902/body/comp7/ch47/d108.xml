                <pb facs="0201" n="121" sameAs="frus:frus1902/pg121"/>

                <head><hi rendition="#italic">Mr. Hutchinson to Mr.
                            Hay.</hi></head>
                <opener><seg rendition="#center">[Telegram.—Paraphrase.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Santiago</hi></placeName>, <date calendar="gregorian"
                            when="1902-11-08"><hi rendition="#italic">November 8,
                        1902</hi></date>.</dateline></opener>
                <p>(Mr. Hutchinson reports that the money paid for cleaning the U. S. S. <hi
                        rendition="#italic">Iowa</hi> has been returned by the Chilean Government,
                    that it is advisable to accept same, and requests immediate instructions in the
                    premises.)</p>
            </div>
        </body>
