    <text>
        <body>
            <div xml:id="d101">

                <pb facs="0194" n="114" sameAs="frus:frus1902/pg114"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Bryan.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-10-06"><hi rendition="#italic">October 6,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 296.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to your telegram of the 27th
                    ultimo, stating that the Thomsen case had been settled, I now take pleasure in
                    transmitting a copy of an appreciative letter from Messrs. Dickerson, Brown
                    &amp; Raegener, Mr. Thomsen’s attorneys.</p>
                <p>I am, etc.</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>


                <xi:include href="d101-a1.xml" xpointer="d101-a1"/>
