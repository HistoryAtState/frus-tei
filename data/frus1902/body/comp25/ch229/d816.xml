    <text>
        <body>
            <div xml:id="d816">

                <pb facs="0969" n="889" sameAs="frus:frus1902/pg889"/>

                <head><hi rendition="#italic">President Regalado to President Roosevelt.</hi></head>
                <opener><seg rendition="#center">[Telegram.—Translation.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >San Salvador</hi></placeName>, <date calendar="gregorian"
                            when="1902-09-10"><hi rendition="#italic">September 10,
                        1902</hi></date>.</dateline></opener>
                <p>I express to Your Excellency the painful sentiments caused me by the occurrence
                    that befell you, and I beg you to accept the expression of my sympathy for that
                    unfortunate event.</p>
                <closer><signed><hi rendition="#small-caps">Tomas Regalado.</hi></signed></closer>
            </div>
        </body>
    </text>
