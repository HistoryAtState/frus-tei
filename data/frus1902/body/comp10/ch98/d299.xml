    <text>
        <body>
            <div xml:id="d299">

                <pb facs="0431" n="351" sameAs="frus:frus1902/pg351"/>

                <head><hi rendition="#italic">Mr. Squiers to Mr. Hay</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Habana</hi></placeName>, <date calendar="gregorian"
                            when="1902-06-11"><hi rendition="#italic">June 11,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 17.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to confirm my telegram of
                    yesterday, announcing the passage by Congress of an act granting amnesty to
                    Americans for offenses committed during the period of intervention, and also
                    inclose copy of the act, together with translation.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">H. G. Squiers.</hi></signed></closer>



                <xi:include href="d299-a1.xml" xpointer="d299-a1"/>
