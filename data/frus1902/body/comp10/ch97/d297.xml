    <text>
        <body>
            <div xml:id="d297">

                <pb facs="0430" n="350" sameAs="frus:frus1902/pg350"/>

                <head><hi rendition="#italic">Mr. Squiers to Mr. Hay</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Habana</hi></placeName>, <date calendar="gregorian"
                            when="1902-06-03"><hi rendition="#italic">June 3,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 7.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose to you a copy
                    of a translation of a resolution passed by certain citizens of high standing of
                    the province of Matanzas on the occasion of the transfer of the Government by
                    the United States to Cuba.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">H. G. Squiers.</hi></signed></closer>


                <xi:include href="d297-a1.xml" xpointer="d297-a1"/>
