    <text>
        <body>
            <div xml:id="d283">

                <pb facs="0407" n="327" sameAs="frus:frus1902/pg327"/>

                <head><hi rendition="#italic">Mr. Squiers to Mr.
                            Flay</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Habana</hi></placeName>, <date calendar="gregorian"
                            when="1902-07-07"><hi rendition="#italic">July 7,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 59.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to confirm your telegram
                    of the 5th instant referring to President Palma’s message of congratulation by
                    reason of the national anniversary of the Independence of the United States, and
                    also to inclose a copy of my note to the foreign office conveying your cable
                    acknowledgment.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">H. G. Squiers.</hi></signed></closer>



                <xi:include href="d283-a1.xml" xpointer="d283-a1"/>
