    <text>
        <body>
            <div xml:id="d277">

                <pb facs="0405" n="325" sameAs="frus:frus1902/pg325"/>

                <head><hi rendition="#italic">Señor Quesada to Mr.
                            Say</hi>.</head>
                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of Cuba</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-06-17"><hi rendition="#italic">June 17,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 3.]</seg></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: In compliance with instructions of
                    my Government, I have the honor to send you a resolution of the House of
                    Representatives of the Republic of Cuba of the 23d of May last, and sent to the
                    honorable President of Cuba for transmission to the honorable President of the
                    United States.</p>
                <p>I avail, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Gonzalo de
                    Quesada.</hi></signed></closer>


                <xi:include href="d277-a1.xml" xpointer="d277-a1"/>
