    <text>
        <body>
            <div xml:id="d276">

                <pb facs="0404" n="324" sameAs="frus:frus1902/pg324"/>

                <head><hi rendition="#italic">Mr. Hay to Mr. Squiers</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-05-26"><hi rendition="#italic">May 26,
                        1902</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 4.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: You are instructed to communicate to the
                    foreign office the inclosed copy of the resolution of the Senate of the United
                    States, dated the 21st instant, congratulating the Cuban Republic on its
                    appearance among the nations of the world.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay</hi>.</signed></closer>


                <xi:include href="d276-a1.xml" xpointer="d276-a1"/>
