                <pb facs="0404" n="324" sameAs="frus:frus1902/pg324"/>

                <opener><seg rendition="#center">[Inclosure.]</seg></opener>
                <head><hi rendition="#italic">Senate resolution No. 232, Fifty-seventh Congress,
                        first session</hi>.</head>
                <p><hi rendition="#italic">Resolved by the Senate of the United States of
                        America</hi>, That the Senate views with satisfaction and expresses
                    congratulation at the appearance of the Cuban Republic among the nations of the
                    world.</p>
                <p><hi rendition="#italic">Resolved</hi>, That the Secretary of State be directed to
                    transmit to the President of the Cuban Republic a copy of these resolutions.</p>
            </div>
