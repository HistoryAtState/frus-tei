    <text>
        <body>
            <div xml:id="d6">

                <pb facs="0086" n="6" sameAs="frus:frus1902/pg6"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Lord.</hi><anchor n="a" xml:id="d6-f1"
                    /></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-05-20"><hi rendition="#italic">May 20,
                        1902</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I am directed by the President to inform
                    you that the military occupation of the island of Cuba by the United States has
                    this day ceased, and that an independent government, republican;n form, has been
                    inaugurated there, under the Presidency of His Excellency Señor Tomás Estrada
                    Palma.</p>
                <p>You are instructed to convey this information through the appropriate channel to
                    the Government to which you are accredited.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d6-f1" n="a" type="source" xml:id="d6-f1-content">
                <p>Same instruction, mutatis mutandis, to all United States diplomatic
                    representatives</p>
            </note>
        </listAnnotation>
    </standOff>
