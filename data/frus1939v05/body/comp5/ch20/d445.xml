            <div xml:id="d445">

                <pb facs="0425" n="417" sameAs="frus:frus1939v05/pg417"/>

                <note rend="inline" type="source">611.2531/368: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Chargé in Chile</hi> (<hi rendition="#italic"
                        >Frost</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1939-10-01T06:00:00-05:00">October 1, 1939—6
                            a.m.</date>
                    </dateline>
                </opener>
                <p>129. Your 167, September 30, 10 p.m. Endeavor obtain postponement release message
                    under reference to press if possible. Earliest practicable time release our
                    announcement to press Monday morning.<anchor n="26" xml:id="d445-f1"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
