    <text>
        <body>
            <div xml:id="d466">

                <pb facs="0446" n="438" sameAs="frus:frus1939v05/pg438"/>

                <note rend="inline" type="source">611.2531/629</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to President Roosevelt </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1940-01-03">January 3, 1940</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. President</hi>: I have received your
                    memorandum of December 20, 1939,<anchor n="43" xml:id="d466-f1"/> enclosing a
                    letter from the Honorable Claude G. Bowers, American Ambassador of Chile,
                    commenting on the proposals for Schedule II of the trade agreement with
                    Chile.</p>
                <p>I am enclosing a draft reply for your signature if you deem it appropriate.</p>
                <p>Faithfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Cordell Hull</hi>
                    </signed>
                </closer>


                <xi:include href="d466-a1.xml" xpointer="d466-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d466-f1" n="43" xml:id="d466-f1-content">
                <p>Not printed; it requested the Secretary to draft a reply to the enclosed letter
                        (<hi rendition="#italic">ante</hi>, <ref target="#pg432">p. 432</ref>).</p>
            </note>
        </listAnnotation>
    </standOff>
