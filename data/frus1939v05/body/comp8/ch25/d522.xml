    <text>
        <body>
            <div xml:id="d522">

                <pb facs="0530" n="522" sameAs="frus:frus1939v05/pg522"/>

                <note rend="inline" type="source">837.51 Public Works Debt/196</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Cuba</hi> (<hi
                            rendition="#italic">Wright</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1704</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Habana</hi></placeName>, <date
                            calendar="gregorian" when="1939-02-27">February 27,
                        1939</date>.<lb/>[Received March 2.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit, as of
                    interest to the Department, a self-explanatory memorandum of my conversation
                    with the Cuban Secretary of the Treasury<anchor n="2" xml:id="d522-f1"/> on
                    February 21st with regard to the Public Works Debt and certain correlated
                    matters.</p>
                <p>Respectfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">J. Butler Wright</hi>
                    </signed>
                </closer>


                <xi:include href="d522-a1.xml" xpointer="d522-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
