    <text>
        <body>
            <div xml:id="d692">

                <pb facs="0757" n="749" sameAs="frus:frus1939v05/pg749"/>

                <note rend="inline" type="source">811F.812/1109</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Panama</hi> (<hi rendition="#italic"
                            >Dawson</hi>)</head>
                <opener>
                    <seg rendition="#float-left">No. 19</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1939-08-19">August 19,
                        1939</date>.</dateline>
                </opener>
                <p>The Secretary of State refers to the Department’s telegram No. 62 dated August
                    16, 1939, 5 p.m.,<anchor n="4" xml:id="d692-f1"/> and transmits the text of a
                    statement made by the President at the time of giving his approval to H. R.
                    5129.</p>
                <p>The Ambassador is authorized to transmit a copy of the text of this statement to
                    the Panamanian Government for its information.</p>



                <xi:include href="d692-a1.xml" xpointer="d692-a1"/>
            </div>
        </body>
    </text>
