    <text>
        <body>
            <div xml:id="d278">

                <pb facs="0263" n="255" sameAs="frus:frus1939v05/pg255"/>

                <note rend="inline" type="source">611.3531/895: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        Argentina</hi> (<hi rendition="#italic">Armour</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1939-08-23T02:00:00-04:00">August 23, 1939—2
                            a.m.</date>
                    </dateline>
                </opener>
                <p>133. Your 135, August 22. Confirming arrangement made in telephone conversation
                    with Tuck<anchor n="19" xml:id="d278-f1"/> notice of intention to negotiate
                    trade agreement will be issued for publication in afternoon papers Wednesday,
                    August 23.<anchor n="20" xml:id="d278-f2"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Welles</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d278-f1" n="19" xml:id="d278-f1-content">
                <p>S. Pinkney Tuck, Counselor of Embassy in Argentina.</p>
            </note>
            <note corresp="#d278-f2" n="20" xml:id="d278-f2-content">
                <p>Department of State <hi rendition="#italic">Bulletin</hi>, August 26, 1939, pp.
