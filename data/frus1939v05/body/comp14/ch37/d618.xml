    <text>
        <body>
            <div xml:id="d618">

                <pb facs="0667" n="659" xml:id="pg659"/>

                <note rend="inline" type="source">812.52–Agrarian Commission/43: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Mexico</hi> (<hi
                            rendition="#italic">Daniels</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1939-05-31T13:00:00-05:00">May 31, 1939—1
                            p.m.</date>
                        <lb/> [Received 5 p.m.]</dateline>
                </opener>
                <p>149. General Hay<anchor n="15" xml:id="d618-f1"/> this morning handed me a check
                    for $1,000,000 on the Bank of Mexico as the first payment due May 31, 1939 under
                    the agrarian claims agreement.</p>
                <p>This check is made out to me as Ambassador and I have endorsed it and am sending
                    it to the Department in today’s pouch together with a copy and translation of
                    the receipt witnessed by General Hay which I signed.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Daniels</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d618-f1" n="15" xml:id="d618-f1-content">
                <p>Eduardo Hay, Mexican Minister for Foreign Affairs.</p>
            </note>
        </listAnnotation>
    </standOff>
