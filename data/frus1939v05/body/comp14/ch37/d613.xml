    <text>
        <body>
            <div xml:id="d613">

                <pb facs="0662" n="654" sameAs="frus:frus1939v05/pg654"/>

                <note rend="inline" type="source">812.52–Agrarian Commission/27<hi
                        rendition="#superscript">1/7</hi>
                </note>
                <head>
                    <hi rendition="#italic">The Chargé in Mexico</hi> (<hi
                            rendition="#italic">Boal</hi>) <hi rendition="#italic">to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 7858</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1938-12-24">December 24,
                        1938</date>.<lb/>[Received December 28.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to refer to my telegram
                    462 of December 24, 2 p.m., 1938,<anchor n="2" xml:id="d613-f1"/> and to enclose
                    a copy and a free translation of the DAPP<anchor n="3" xml:id="d613-f2"/>
                    release of a message sent by President Cárdenas to the Mexican Senate requesting
                    ratification of the recent agreement between the United States and Mexico with
                    respect to agrarian compensation.<anchor n="4" xml:id="d613-f3"/>
                </p>
                <p>Respectfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Pierre de L. Boal</hi>
                    </signed>
                </closer>


                <xi:include href="d613-a1.xml" xpointer="d613-a1"/>
            </div>
        </body>
    </text>
