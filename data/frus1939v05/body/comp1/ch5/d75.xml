    <text>
        <body>
            <div xml:id="d75">

                <pb facs="0058" n="50" xml:id="pg50"/>

                <note rend="inline" type="source">802.33/105: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in Nicaragua</hi> (<hi
                            rendition="#italic">Baldwin</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Managua</hi></placeName>, <date
                            calendar="gregorian" when="1939-12-29T13:00:00-06:00">December 29,
                            1939—1 p.m.</date>
                        <lb/> [Received 3:30 p.m.]</dateline>
                </opener>
                <p>154. Instruction No. 299, December 21<anchor n="3" xml:id="d75-f1"/> and my
                    telegram 125, October 18, 4 p.m.<anchor n="4" xml:id="d75-f2"/> The Foreign
                    Minister commends the suggested patrol and authorizes Nicaragua’s fullest
                    cooperation and extension of facilities under the terms and conditions
                    suggested.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Baldwin</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
