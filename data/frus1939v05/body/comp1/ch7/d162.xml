            <div xml:id="d162">

                <pb facs="0128" n="120" sameAs="frus:frus1939v05/pg120"/>

                <note rend="inline" type="source">740.0011 European War 1939/1296: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Chile</hi> (<hi
                            rendition="#italic">Bowers</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Santiago</hi></placeName>, <date
                            calendar="gregorian" when="1939-12-22T12:00:00-04:00">December 22,
                            1939—noon</date>.<lb/>[Received December 22—11:42 a.m.]</dateline>
                </opener>
                <p>241. My telegram No. 229, December 16, 3 p.m. May we have reaction to paragraph
                    No. 2 regarding patrol since Chilean Government formally requested it?</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bowers</hi>
                    </signed>
                </closer>
            </div>
        </body>
