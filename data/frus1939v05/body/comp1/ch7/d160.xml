    <text>
        <body>
            <div xml:id="d160">

                <pb facs="0125" n="117" sameAs="frus:frus1939v05/pg117"/>

                <note rend="inline" type="source">740.0011 European War 1939/1302: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in Panama</hi> (<hi rendition="#italic"
                        >Dawson</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Panama</hi></placeName>, <date
                            calendar="gregorian" when="1939-12-22T11:00:00-05:00">December 22,
                            1939—11 a.m.</date>
                        <lb/> [Received 2:21 p.m.]</dateline>
                </opener>
                <p>165. Department’s telegram No. 124, December 21, 6 p.m. Panamanian Minister for
                    Foreign Affairs cordially approves procedure suggested and the President of
                    Panama will transmit statement to the three belligerents tomorrow December 23, 5
                        p.m.<anchor n="38" xml:id="d160-f1"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Dawson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d160-f1" n="38" xml:id="d160-f1-content">
                <p>The statement was released by the Department of State on December 23; for text,
                    see Department of State <hi rendition="#italic">Bulletin</hi>, December 23,
                    1939, p. 723.</p>
            </note>
        </listAnnotation>
    </standOff>
