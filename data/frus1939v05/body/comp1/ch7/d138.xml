            <div xml:id="d138">

                <pb facs="0113" n="105" sameAs="frus:frus1939v05/pg105"/>

                <note rend="inline" type="source">740.0011 European War 1939/1219: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in Uruguay</hi> (<hi rendition="#italic"
                        >Wilson</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Montevideo</hi>
                        </placeName>
                        <date ana="#date_undated-inferred-from-document-content"
                            calendar="gregorian" notAfter="1939-12-17T18:30:00-05:00"
                            notBefore="1939-12-17T07:55:00-03:00" when="1939-12-17"
                        >[undated]</date>.<lb/>[Received December 17, 1939—6:30 p.m.]</dateline>
                </opener>
                <p>
                    <hi rendition="#italic">Graf Spee</hi> blown up 7:55 o’clock, 7 miles off shore,
                    both magazine groups exploded.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wilson</hi>
                    </signed>
                </closer>
            </div>
        </body>
