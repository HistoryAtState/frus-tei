    <text>
        <body>
            <div xml:id="d17">

                <pb facs="0015" n="9" sameAs="frus:frus1939v05/pg9"/>

                <note rend="inline" type="source">810.24/31a: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Minister in Nicaragua</hi> (<hi rendition="#italic"
                            >Nicholson</hi>)<anchor n="5" xml:id="d17-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1939-07-05T18:00:00-04:00">July 5, 1939—6
                            p.m.</date>
                    </dateline>
                </opener>
                <p>42. Please expedite reply to Department’s circular telegram of June 27, 7
                    p.m.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d17-f1" n="5" type="source" xml:id="d17-f1-content">
                <p>The same on the same date to the Ambassador in Cuba as telegram No. 78, and to
                    the Minister in Honduras as telegram No. 14.</p>
            </note>
        </listAnnotation>
    </standOff>
