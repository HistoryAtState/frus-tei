    <text>
        <body>
            <div xml:id="d67">

                <pb facs="0050" n="42" sameAs="frus:frus1939v05/pg42"/>

                <note rend="inline" type="source">710. Financial and Economic Advisory
                    Committee/2</note>
                <head>
                    <hi rendition="#italic">The Director General of the Pan American Union</hi>
                        (<hi rendition="#italic">Rowe</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1939-10-19">October 19,
                        1939</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I beg to send you
                    herewith a copy of the resolution adopted by the Governing Board of the Pan
                    American Union at the session held on Wednesday, October 18th, 1939.</p>
                <pb facs="0051" n="43" xml:id="pg43"/>
                <p>I will greatly appreciate if you will be good enough to send me the name of
                    United States representative on the Inter-American Financial and Economic
                    Advisory Committee as soon as the appointment has been made.</p>
                <p>I beg to remain [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">L. S. Rowe</hi>
                    </signed>
                </closer>


                <xi:include href="d67-a1.xml" xpointer="d67-a1"/>
            </div>
        </body>
    </text>
