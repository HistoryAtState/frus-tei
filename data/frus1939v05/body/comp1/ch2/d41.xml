            <div xml:id="d41">

                <pb facs="0028" n="22" sameAs="frus:frus1939v05/pg22"/>

                <note rend="inline" type="source">740.00111 A.R./96: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Panama</hi> (<hi rendition="#italic"
                        >Dawson</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Panama</hi></placeName>, <date
                            calendar="gregorian" when="1939-09-08T12:00:00-05:00">September 8,
                            1939—noon</date>.<lb/>[Received 1:45 p.m.]</dateline>
                </opener>
                <p>101. Department’s telegram No. 74, September 7, 3 p.m. Minister of Foreign
                    Affairs will send an invitation to the Director General of the Pan American
                    Union immediately.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Dawson</hi>
                    </signed>
                </closer>
            </div>
        </body>
