    <text>
        <body>
            <div xml:id="d88">

                <pb facs="0068" n="60" xml:id="pg60"/>

                <note rend="inline" type="source">862.852/15</note>
                <head>
                    <hi rendition="#italic">The Chargé in Mexico</hi> (<hi rendition="#italic"
                        >Boal</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 9198</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1939-09-27">September 27,
                        1939</date>.<lb/>[Received September 29.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose a memorandum
                    of a conversation I had this morning with Licenciado Beteta, Acting Minister for
                    Foreign Affairs, with regard to the desire of the Mexican Government to purchase
                    certain German vessels in Mexican ports.</p>
                <p>The enclosed is transmitted for the strictly confidential information of the
                    Department.</p>
                <p>Respectfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Pierre de L. Boal</hi>
                    </signed>
                </closer>


                <xi:include href="d88-a1.xml" xpointer="d88-a1"/>
            </div>
        </body>
    </text>
