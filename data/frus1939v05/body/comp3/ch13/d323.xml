                <pb facs="0319" n="311" sameAs="frus:frus1939v05/pg311"/>

                <note rend="inline" type="source">824.00/948: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in Bolivia</hi>
                        (<hi rendition="#italic">Dawson</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1939-08-29T14:00:00-04:00">August 29, 1939—2
                            p.m.</date>
                    </dateline>
                </opener>
                <p>26. Department’s 25 and your 55. The Department perceives no objection to your
                    attending today’s meeting with the Foreign Minister.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
