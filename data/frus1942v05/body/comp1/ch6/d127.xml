    <text>
        <body>
            <div xml:id="d127">

                <pb facs="0167" n="155" sameAs="frus:frus1942v05/pg155"/>

                <note rend="inline" type="source">810.74/497</note>
                <head><hi rendition="#italic">Memorandum by the Adviser on Political Relations</hi>
                        (<hi rendition="#italic">Duggan</hi>) <hi
                        rendition="#italic">to the Assistant Secretary of State</hi> (<hi rendition="#italic">Long</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1942-10-03">October 3, 1942</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Mr. Long</hi>: With regard to Mr. Bonsai’s memorandum
                        attached,<anchor n="89" xml:id="d127-f1"/> it is my understanding that the
                    Secretary, with full knowledge of the consequences, decided that the Department
                    should press ahead to bring about the severance of the circuits between
                    Argentina and Chile and the Axis countries.</p>
                <closer><signed><hi rendition="#small-caps">Laurence Duggan</hi></signed></closer>
            </div>
        </body>
    </text>
