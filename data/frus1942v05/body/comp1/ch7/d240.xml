    <text>
        <body>
            <div xml:id="d240">

                <pb facs="0264" n="252" sameAs="frus:frus1942v05/pg252"/>

                <note rend="inline" type="source">862.20210/2060: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Brazil</hi> (<hi rendition="#italic">Caffery</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">Río de
                                Janeiro</hi></placeName>, <date calendar="gregorian"
                            when="1942-11-20T15:00:00-03:00">November 20, 1942—3
                        p.m.</date><lb/>[Received 7:32 p.m.]</dateline>
                </opener>
                <p>4872. My despatch 8826 of October 22, 1942.<anchor n="91" xml:id="d240-f1"/>
                    Tribunal de Segurança Nacional has imposed the following prison sentences on
                    members of the Schlegel espionage ring: Theodore Friedrich Schlegel 14 years;
                    Gustav Eduard Utzinger, Erwin Backhaus, Nicolau von Bellingshausen, Karl Thielen
                    and Rolf Trautmann, 8 years each.</p>
                <closer><signed><hi rendition="#small-caps">Caffery</hi></signed></closer>
            </div>
        </body>
    </text>
