                <pb facs="0419" n="407" xml:id="pg407"/>

                <note rend="inline" type="source">800.857/671 Suppl.: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Ambassador in Argentina</hi> (<hi
                            rendition="#italic">Armour</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><placeName><hi
                                    rendition="#small-caps">Washington</hi></placeName></placeName>,
                            <date calendar="gregorian" when="1942-06-11T16:00:00-04:00">June 11,
                            1942—4 p.m.</date></dateline>
                </opener>
                <p>848. Your 955, May 21, 9 p.m.<anchor n="46" xml:id="d392-f1"/> Please telegraph
                    whether the decree has been suitably modified or extended for a further
                    period.</p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
    </text>
