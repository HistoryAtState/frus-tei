    <text>
        <body>
            <div xml:id="d733">

                <pb facs="0778" n="766" sameAs="frus:frus1942v05/pg766"/>

                <note rend="inline" type="source">832.796/720a: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Ambassador in Brazil</hi> (<hi rendition="#italic"
                            >Caffery</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1942-01-08T15:00:00-05:00">January 8, 1942—3
                        p.m.</date></dateline>
                </opener>
                <p>60. Press reports state Condor<anchor n="74" xml:id="d733-f1"/> has been
                    expropriated. Is there any basis for these reports? If so please furnish
                    available details.</p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d733-f1" n="74" xml:id="d733-f1-content">
                <p>Sindicato Condor, Ltda., Brazilian airline in which German interests had had
                    powerful influence.</p>
            </note>
        </listAnnotation>
    </standOff>
