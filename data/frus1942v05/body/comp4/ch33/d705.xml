                <pb facs="0750" n="738" sameAs="frus:frus1942v05/pg738"/>

                <note rend="inline" type="source">800.8830 Brazil/64a: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Ambassador in Brazil</hi> (<hi rendition="#italic"
                            >Caffery</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1942-07-22T00:00:00-04:00">July 22,
                        1942—midnight</date>.</dateline>
                </opener>
                <p>1999. Up to July 22, bookings have been arranged on ships sailing in July for
                    2,875 tons of newsprint destined to Brazil.</p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
