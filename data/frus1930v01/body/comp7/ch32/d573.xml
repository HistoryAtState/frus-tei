    <text>
        <body>
            <div xml:id="d573">

                <pb facs="0622" n="542" sameAs="frus:frus1930v01/pg542"/>

                <note rend="inline" type="source">811.7442/56</note>
                <head><hi rendition="#italic">The American Chargé in Canada</hi> (<hi rendition="#italic">Riggs</hi>) <hi
                        rendition="#italic">to the Canadian Secretary of State for External
                        Affairs</hi> (<hi rendition="#italic"
                        >Bennett</hi>)<anchor n="44" xml:id="d573-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Ottawa</hi></placeName>, <date calendar="gregorian"
                            when="1930-08-18">August 18, 1930</date>.</dateline>
                    <seg rendition="#float-left">No. 804</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to the Department of
                    External Affairs’ note No. 71 of June 19, 1930, and to previous correspondence
                    regarding the Aviation Radio Conference held in New York on April 10 and 11,
                    1930, I have the honor, upon instructions from my Government, to advise you that
                    on August 5, 1930, the Federal Radio Commission adopted the recommendations of
                    that Conference and will put them into effect as soon as practicably
                    possible.</p>
                <p>I avail myself [etc.]</p>
                <closer><signed><hi rendition="#small-caps">B. Reath Riggs</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d573-f1" n="44" type="source" xml:id="d573-f1-content">
                <p>Copy transmitted to the Department by the Minister in Canada as an enclosure to
                    his despatch No. 7, August 30, 1930; received September 8.</p>
            </note>
        </listAnnotation>
    </standOff>
