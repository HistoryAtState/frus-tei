    <text>
        <body>
            <div xml:id="d374">

                <pb facs="0467" n="387" sameAs="frus:frus1930v01/pg387"/>

                <note rend="inline" type="source">835.01/20: Telegram</note>
                <head><hi rendition="#italic">The Minister in Colombia</hi> (<hi rendition="#italic">Caffery</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Bogotá</hi></placeName>, <date calendar="gregorian"
                            when="1930-09-16T18:00:00-05:00">September 16, 1930—6
                        p.m.</date><lb/>[Received 9:35 p.m.]</dateline></opener>
                <p>114. Department’s telegram No. 47, September 16, 2 p.m.<anchor n="4"
                        xml:id="d374-f1"/> Olaya told me that he would recognize Argentina, Bolivia,
                    and Peru on Thursday, September 18.</p>
                <closer><signed><hi rendition="#small-caps">Caffery</hi></signed></closer>
            </div>
        </body>
    </text>
