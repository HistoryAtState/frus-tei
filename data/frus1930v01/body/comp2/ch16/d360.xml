                <pb facs="0459" n="379" sameAs="frus:frus1930v01/pg379"/>

                <note rend="inline" type="source">835.00/470: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Argentina</hi> (<hi
                        rendition="#italic">Bliss</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Buenos Aires</hi></placeName>, <date calendar="gregorian"
                            when="1930-09-05T19:00:00-04:00">September 5, 1930—7
                        p.m.</date><lb/>[Received September 5—6:45 p.m.]</dateline></opener>
                <p>120. Foreign Office confirms that President has on account of ill health
                    delegated his authority to the Vice President and that martial law is expected
                    shortly to be declared.</p>
                <closer><signed><hi rendition="#small-caps">Bliss</hi></signed></closer>
            </div>
        </body>
