    <text>
        <body>
            <div xml:id="d523">

                <pb facs="0554" n="474" sameAs="frus:frus1930v01/pg474"/>

                <note rend="inline" type="source">811.51632 National City Bank/49: Telegram</note>
                <head><hi rendition="#italic">The National City Bank of New York to the Secretary of
                        State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >New York</hi></placeName>, <date calendar="gregorian"
                            when="1930-07-25">July 25, 1930</date>.<lb/>[Received July 25—6:06
                        p.m.]</dateline></opener>
                <p>We greatly appreciate the interest which you and the other members of your
                    Department have taken in the matter of the Brazilian fine and thank you for the
                    friendly cooperation which you have given us.</p>
                <closer><signed><hi rendition="#small-caps">Charles E. Mitchell</hi></signed>, <hi
                        rendition="#italic">Chairman</hi><lb/><signed><hi rendition="#small-caps"
                            >Gordon S. Rentschler</hi></signed>, <hi rendition="#italic"
                        >President</hi></closer>
            </div>
        </body>
    </text>
