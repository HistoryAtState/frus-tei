                <pb facs="0533" n="453" xml:id="pg453"/>

                <note rend="inline" type="source">832.01/8: Telegram</note>
                <head><hi rendition="#italic">The Minister in Colombia</hi> (<hi rendition="#italic">Caffery</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Bogotá</hi></placeName>, <date calendar="gregorian"
                            when="1930-11-08T14:00:00-05:00">November 8, 1930—2
                        p.m.</date><lb/>[Received 11 p.m.]</dateline></opener>
                <p>132. Department’s 62.<anchor n="18" xml:id="d481-f1"/> Colombian Government also
                    recognizing the Brazilian Government today.</p>
                <closer><signed><hi rendition="#small-caps">Caffery</hi></signed></closer>
            </div>
        </body>
    </text>
