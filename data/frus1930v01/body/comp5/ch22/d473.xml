                <pb facs="0529" n="449" xml:id="pg449"/>

                <note rend="inline" type="source">832.01/6: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Brazil</hi> (<hi rendition="#italic"
                        >Morgan</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Rio de Janeiro</hi></placeName>, <date calendar="gregorian"
                            when="1930-11-06T16:00:00-03:00">November 6, 1930—4
                        p.m.</date><lb/>[Received 6:09 p.m.]</dateline></opener>
                <p>143. The press published today the texts of the official notes in which the
                    Ambassadors of Chile and Portugal and the Minister of Uruguay recognize, on
                    behalf of their Governments, the Provisional Government of Brazil as at present
                    constituted. The press states also that the newly arrived Ambassador of Italy
                    and the Minister of Ecuador who have not presented the [<hi rendition="#italic"
                        >their</hi>] credentials called yesterday at the Foreign Office and stated
                    that their Governments would recognize.</p>
                <closer><signed><hi rendition="#small-caps">Morgan</hi></signed></closer>
            </div>
        </body>
