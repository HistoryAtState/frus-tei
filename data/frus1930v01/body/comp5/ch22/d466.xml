                <pb facs="0525" n="445" sameAs="frus:frus1930v01/pg445"/>

                <note rend="inline" type="source">832.00 Revolutions/163: Telegram</note>
                <head><hi rendition="#italic">The Consul at Porto Alegre</hi> (<hi rendition="#italic">Nasmith</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Porto Alegre</hi></placeName>, <date calendar="gregorian"
                            when="1930-10-28T15:00:00-03:00">October 28, 1930—3
                        p.m.</date><lb/>[Received 3:10 p.m.]</dateline></opener>
                <p>Referring to my telegram of October 17, 4 p.m. Captain of the Port has informed
                    me that all lighthouses began to function again yesterday.</p>
                <closer><signed><hi rendition="#small-caps">Nasmith</hi></signed></closer>
            </div>
        </body>
