    <text>
        <body>
            <div xml:id="d459">

                <pb facs="0522" n="442" sameAs="frus:frus1930v01/pg442"/>

                <note rend="inline" type="source">832.113/29: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Ambassador in
                        Brazil</hi> (<hi rendition="#italic">Morgan</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1930-10-22T17:00:00-05:00">October 22, 1930—5
                        p.m.</date></dateline></opener>
                <p>72. At request of Brazilian Government, through Brazilian Ambassador here,<anchor
                        n="9" xml:id="d459-f1"/> stating that conditions of domestic violence exist
                    in <pb facs="0523" n="443" xml:id="pg443"/> certain portions of Brazil, the
                    President today issued a Proclamation prohibiting the export of arms and
                    munitions of war to Brazil except under license of the Secretary of
                        State.<anchor n="10" xml:id="d459-f2"/></p>
                <closer><signed><hi rendition="#small-caps">Stimson</hi></signed></closer>
            </div>
        </body>
    </text>
