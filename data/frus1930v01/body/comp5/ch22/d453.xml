                <pb facs="0521" n="441" xml:id="pg441"/>

                <note rend="inline" type="source">832.00 Revolutions/116: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Chargé in Brazil</hi>
                        (<hi rendition="#italic">Washington</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1930-10-20T11:00:00-05:00">October 20, 1930—11
                        a.m.</date></dateline></opener>
                <p>69. Your 107, October 18, noon. Inform Brazilian Government in usual manner of
                    visit of <hi rendition="#italic">Pensacola.</hi></p>
                <closer><signed><hi rendition="#small-caps">Stimson</hi></signed></closer>
            </div>
        </body>
