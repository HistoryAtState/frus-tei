                <pb facs="0507" n="427" xml:id="pg427"/>

                <note rend="inline" type="source">824.01/12: Telegram</note>
                <head><hi rendition="#italic">The Minister in Ecuador</hi> (<hi rendition="#italic">Dawson</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Quito</hi></placeName>, <date calendar="gregorian"
                            when="1930-09-09T11:00:00-05:14">September 9, 1930—11
                        a.m.</date><lb/>[Received 5:45 p.m.]</dateline></opener>
                <p>25. Ecuadorean Government has decided to give full recognition to existing
                    Governments of Bolivia and Peru and sent yesterday telegraphic instructions to
                    this effect to its mission in La Paz and a note to Peruvian Minister in
                    Quito.</p>
                <closer><signed><hi rendition="#small-caps">Dawson</hi></signed></closer>
            </div>
        </body>
    </text>
