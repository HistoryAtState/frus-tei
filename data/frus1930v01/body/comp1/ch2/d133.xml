    <text>
        <body>
            <div xml:id="d133">

                <pb facs="0229" n="149" sameAs="frus:frus1930v01/pg149"/>

                <note rend="inline" type="source">500.A15a3/1196</note>
                <head><hi rendition="#italic">The British Ambassador</hi> (<hi
                            rendition="#italic">Lindsay</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1930-10-26">October 26, 1930</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. Secretary</hi>: I think I ought to let you
                    know at once that in response to your message to London, our Ambassadors in
                    Paris and Rome have been instructed to make oral representations to the French
                    and Italian Governments. I enclose copy of what they are to say, and they must
                    have received their instructions this morning. They have been told that it is
                    important that they should take action today if possible.</p>
                <p>Believe me [etc.]</p>
                <closer><signed><hi rendition="#small-caps">R. C. Lindsay</hi></signed></closer>



                <xi:include href="d133-a1.xml" xpointer="d133-a1"/>
            </div>
