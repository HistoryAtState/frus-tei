    <text>
        <body>
            <div xml:id="d192">

                <pb facs="0283" n="203" sameAs="frus:frus1930v01/pg203"/>

                <note rend="inline" type="source">500.A15/1173: Telegram</note>
                <head><hi rendition="#italic">The Chairman of the American Delegation</hi>
                        (<hi rendition="#italic">Gibson</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Geneva</hi></placeName>, <date calendar="gregorian"
                            when="1930-12-09T22:00:00+01:00">December 9, 1930—10
                        p.m.</date><lb/>[Received December 9—6:51 p.m.]</dateline></opener>
                <p>60. Commission adjourned this morning [<hi rendition="#italic"
                        >afternoon</hi>].<anchor n="90" xml:id="d192-f1"/> Delegation pouch will be
                    forwarded via Paris.</p>
                <closer><signed><hi rendition="#small-caps">Gibson</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d192-f1" n="90" xml:id="d192-f1-content">
                <p>The 27th and last meeting was held at 3:30 p.m.</p>
            </note>
        </listAnnotation>
