                <pb facs="0277" n="197" xml:id="pg197"/>

                <note rend="inline" type="source">500.A15/1129: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Chairman of the American
                        Delegation</hi> (<hi rendition="#italic">Gibson</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1930-11-22T14:00:00-05:00">November 22, 1930—2
                        p.m.</date></dateline></opener>
                <p>10. Your 33, November 21, noon. Department considers the draft quoted
                    satisfactory and appreciates the reasons cited for the additions.</p>
                <closer><signed><hi rendition="#small-caps">Stimson</hi></signed></closer>
            </div>
        </body>
