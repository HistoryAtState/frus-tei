    <text>
        <body>
            <div xml:id="d348">

                <pb facs="0452" n="372" sameAs="frus:frus1930v01/pg372"/>

                <note rend="inline" type="source">715.1715/386: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Minister in
                        Nicaragua</hi> (<hi rendition="#italic">Hanna</hi>)<anchor n="96"
                        xml:id="d348-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1930-08-20T15:00:00-04:00">August 20, 1930—3
                        p.m.</date></dateline></opener>
                <p>86. The Department perceives no objection to your submitting to the Nicaraguan
                    Government for approval the changes in the boundary protocol suggested by the
                    Honduran Government and being forwarded to you from Tegucigalpa by air mail.</p>
                <closer><signed><hi rendition="#small-caps">Castle</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d348-f1" n="96" type="source" xml:id="d348-f1-content">
                <p>Repeated to the Minister in Honduras as telegram No. 43.</p>
            </note>
        </listAnnotation>
    </standOff>
