                <pb facs="0446" n="366" sameAs="frus:frus1930v01/pg366"/>

                <note rend="inline" type="source">715.1715/372: Telegram</note>
                <head><hi rendition="#italic">The Minister in Nicaragua</hi> (<hi rendition="#italic">Hanna</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Managua</hi></placeName>, <date calendar="gregorian"
                            when="1930-07-02T18:00:00-05:45">July 2, 1930—6
                        p.m.</date><lb/>[Received 9:15 p.m.]</dateline></opener>
                <p>80. Department’s 54, June 19, 7 p.m. The draft protocol of agreement transcribed
                    in Department’s mail instruction No. 16 of May 21<anchor n="88" xml:id="d336-f1"
                    /> was submitted to the Nicaraguan Government today.</p>
                <p>Repeated to Tegucigalpa.</p>
                <closer><signed><hi rendition="#small-caps">Hanna</hi></signed></closer>
            </div>
        </body>
    </text>
