    <text>
        <body>
            <div xml:id="d346">

                <pb facs="0451" n="371" sameAs="frus:frus1930v01/pg371"/>

                <note rend="inline" type="source">715.1715/382: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Minister in
                        Honduras</hi> (<hi rendition="#italic">Lay</hi>)<anchor n="95"
                        xml:id="d346-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1930-08-04T17:00:00-04:00">August 4, 1930—5
                    p.m.</date></dateline></opener>
                <p>39. Legation’s 69, August 1, 4 p.m. The Department perceives no objection to your
                    submitting to the Honduran Government for approval the changes in the boundary
                    protocol suggested by the Nicaraguan Government.</p>
                <closer><signed><hi rendition="#small-caps">Carr</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d346-f1" n="95" type="source" xml:id="d346-f1-content">
                <p>Repeated to the Minister in Nicaragua as telegram No. 78.</p>
            </note>
        </listAnnotation>
    </standOff>
