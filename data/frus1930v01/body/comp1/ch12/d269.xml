                <pb facs="0374" n="294" sameAs="frus:frus1930v01/pg294"/>

                <note rend="inline" type="source">810.154/266</note>
                <head><hi rendition="#italic">The Chargé in Panama</hi> (<hi rendition="#italic"
                        >Merrell</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Panama</hi></placeName>, <date calendar="gregorian"
                            when="1930-11-20">November 20, 1930</date>.<lb/>[Received November
                        29.]</dateline>
                    <seg rendition="#float-left">No. 274</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to enclose as of possible
                    interest to the Department a copy of a memorandum of a conversation between the
                    Costa Rican Minister to Panama and Mr. Thomas A. Forbes, Chairman,
                    Inter-American Highway Reconnaissance Surveys, Technical Committee.</p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">George R. Merrell,
                    Jr.</hi></signed></closer>


                <xi:include href="d269-a1.xml" xpointer="d269-a1"/>
