            <div xml:id="d10">

                <pb facs="0098" n="18" xml:id="pg18"/>

                <note rend="inline" type="source">500.A15a3/665: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Chairman of the American Delegation</hi> (<hi rendition="#italic">Stimson</hi>)</head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1930-02-05T10:00:00-05:00">February 5, 1930—10
                        a.m.</date></dateline></opener>
                <p>55. The suggestions contained in your telegram No. 35, February 4, have been
                    considered and are heartily approved by the President.</p>
                <closer><signed><hi rendition="#small-caps">Cotton</hi></signed></closer>
            </div>
        </body>
