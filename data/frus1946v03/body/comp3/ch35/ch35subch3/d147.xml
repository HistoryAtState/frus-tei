    <text>
        <body>
            <div xml:id="d147">

                <pb facs="0424" n="380" sameAs="frus:frus1946v03/pg380"/>

                <note rend="inline" type="source">CFM Files</note>
                <head><hi rendition="#italic">United States Delegation Journal</hi></head>
                <dateline>
                    <date ana="#date_undated-inferred-from-chapter-heading" calendar="gregorian"
                        when="1946-09-06T15:00:00+01:00">September 6, 1946, 3 p.m.</date>
                </dateline>
                <p rendition="#flush">USDel (PC) (Journal) 35</p>
                <p>The session was devoted to the presentation of the views of the Government of
                    Iraq on the subject of the Peace Treaties. The text of the address may be found
                    in CP Plen 26.<anchor n="44" xml:id="d147-f1"/></p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d147-f1" n="44" xml:id="d147-f1-content">
                <p>For text, see <hi rendition="#italic">Paris Peace Conference, 1946</hi>, p.
                    394.</p>
            </note>
        </listAnnotation>
    </standOff>
