                        <cell>Secretariat (Notes of Service)</cell>
                    </row>
                    <row>
                        <cell>P.C.</cell>
                        <cell>Paris Conference</cell>
                    </row>
                </table>
                <pb facs="0044" n="XL" xml:id="pgXL"/>
