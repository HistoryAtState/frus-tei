            </note>
            <note corresp="#d184-f2" n="2" xml:id="d184-f2-content">
                <p>
                    Scowcroft initialed “BS” above his typed
                    signature.</p>
            </note>
            <note corresp="#d184-f3" n="3" xml:id="d184-f3-content">
                <p>
                    Kissinger approved this option.</p>
            </note>
        </listAnnotation>
