            <div xml:id="d60">

                <pb facs="0147" n="49" sameAs="frus:frus1932v04/pg49"/>

                <note rend="inline" type="source">793.94 Commission/232: Telegram</note>
                <head><hi rendition="#italic">The Minister in China (Johnson) to the Secretary of
                        State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peiping</hi></placeName>, <date calendar="gregorian"
                            when="1932-06-02T16:00:00+08:00">June 2, 1932—4
                        p.m.</date><lb/>[Received June 2—7:35 a.m.]</dateline>
                </opener>
                <p>596. Following from Mukden: <quote rend="blockquote">
                        <p>“League Commission will leave Mukden on the morning of June 4th and
                            arrive at Peiping the evening of the following day.”</p>
                    </quote></p>
                <closer><signed><hi rendition="#small-caps">Johnson</hi></signed></closer>
            </div>
        </body>
