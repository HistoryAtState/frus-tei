            <div xml:id="d15">

                <pb facs="0110" n="12" sameAs="frus:frus1932v04/pg12"/>

                <note rend="inline" type="source">793.94 Commission/213: Telegram</note>
                <head><hi rendition="#italic">The Minister in China (Johnson) to the Acting
                        Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peiping</hi></placeName>, <date calendar="gregorian"
                            when="1932-05-11T12:00:00+08:00">May 11, 1932—noon</date>.<lb/>[Received
                        May 11—2:10 a.m.]</dateline>
                </opener>
                <p>519. Following from American Consul General at Harbin: <quote rend="blockquote">
                        <p>“May 10, 11 a.m. League Commission arrived here yesterday.”</p>
                    </quote></p>
                <closer>For the Minister:<lb/><signed><hi rendition="#small-caps"
                        >Perkins</hi></signed></closer>
            </div>
        </body>
