            <div xml:id="d344">

                <pb facs="0440" n="342" sameAs="frus:frus1932v04/pg342"/>

                <note rend="inline" type="source">793.94 Commission/516: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Acting Chairman of the
                        American Delegation to the General Disarmament Conference
                    (Gibson)</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1932-11-11T14:00:00-05:00">November 11, 1932—2
                        p.m.</date></dateline>
                </opener>
                <p>30. Your 36, November 9, 4 p.m. For Wilson and Norman Davis.</p>
                <list>
                    <label>1.</label>
                    <item>I approve the arrangement requested and your understanding thereof.</item>
                    <label>2.</label>
                    <item>I desire that at your discretion you make available in confidence to
                        General McCoy information which you have and may receive relating to Far
                        Eastern problems and pertinent to his problem and consideration of the
                        Lytton Report.</item>
                    <label>3.</label>
                    <item>Please so inform General McCoy.</item>
                </list>
                <closer><signed><hi rendition="#small-caps">Stimson</hi></signed></closer>
            </div>
        </body>
    </text>
