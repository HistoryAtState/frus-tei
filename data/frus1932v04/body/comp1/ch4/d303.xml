                <pb facs="0386" n="288" sameAs="frus:frus1932v04/pg288"/>

                <note rend="inline" type="source">893.01 Manchuria/532: Telegram</note>
                <head><hi rendition="#italic">The Minister in China (Johnson) to the Secretary of
                        State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peiping</hi></placeName>, <date calendar="gregorian"
                            when="1932-10-05T14:00:00+08:00">October 5, 1932—2
                        p.m.</date><lb/>[Received October 5—2:30 a.m.]</dateline>
                </opener>
                <p>1165. Following from American Consul General at Harbin: <quote rend="blockquote">
                        <p>“October 3, 3 p.m. Anti-Manchukuo forces captured Hulan, southern
                            terminus Huhai Railway on September 30th, held Anganghsi 4 hours October
                            1st, on the same day occupied Anta. Fortifications Tsitsihar City now
                            being strengthened.”</p>
                    </quote></p>
                <closer><signed><hi rendition="#small-caps">Johnson</hi></signed></closer>
            </div>
