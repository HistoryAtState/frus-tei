    <text>
        <body>
            <div xml:id="d186">

                <pb facs="0278" n="180" xml:id="pg180"/>

                <note rend="inline" type="source">793.94/5437: Telegram</note>
                <head><hi rendition="#italic">The Minister in China (Johnson) to the
                            Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peiping</hi></placeName>, <date calendar="gregorian"
                            when="1932-07-22T16:00:00+08:00">July 22, 1932—4
                        p.m.</date><lb/>[Received July 22—7:30 a.m.]</dateline>
                </opener>
                <p>839. Following from American Consul at Mukden: <quote rend="blockquote">
                        <p>“July 22, 11 a.m. According to a reliable source, official spokesman of
                            Japanese military headquarters said unofficially that if Chang Hsueh-liang sends
                            troops into Jehol it will be considered a hostile act.”</p>
                    </quote></p>
                <closer><signed><hi rendition="#small-caps"
                                >Johnson</hi></signed></closer>
            </div>
        </body>
