            <div xml:id="d199">

                <pb facs="0288" n="190" sameAs="frus:frus1932v04/pg190"/>

                <note rend="inline" type="source">793.95/5452: Telegram</note>
                <head><hi rendition="#italic">The Minister in China (Johnson) to the Secretary of
                        State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peiping</hi></placeName>, <date calendar="gregorian"
                            when="1932-07-30T13:00:00+08:00">July 30, 1932—1
                        p.m.</date><lb/>[Received July 30—7:20 a.m.]</dateline>
                </opener>
                <p>875. Following from American Consul at Mukden: <quote rend="blockquote">
                        <p>“July 29, 6 p.m. Spokesman of Japanese military headquarters confirms
                            press report that Japanese detachment defeated 3,000 volunteers near
                            Suichung after heavy fighting with considerable casualties.”</p>
                    </quote></p>
                <closer><signed><hi rendition="#small-caps">Johnson</hi></signed></closer>
            </div>
        </body>
