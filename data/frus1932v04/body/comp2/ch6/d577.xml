                <pb facs="0635" n="537" sameAs="frus:frus1932v04/pg537"/>

                <note rend="inline" type="source">893.00/12180: Telegram</note>
                <head><hi rendition="#italic">The Minister in China (Johnson) to the Secretary of
                        State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peiping</hi></placeName>, <date calendar="gregorian"
                            when="1932-10-25T11:00:00+08:00">October 25, 1932—11
                        a.m.</date><lb/>[Received October 25—1:40 a.m.]</dateline>
                </opener>
                <p>1211. Following from American Consul at Foochow: <quote rend="blockquote">
                        <p>“October 24, 10 a.m. Provincial Government confirms serious incursion of
                            Kiangsi Reds into Western Fukien and the capture of Kienning, Hsien and
                            Taining by the Reds. Shaowu and Chienyang also endangered. Americans
                            have been advised to withdraw from danger zone.”</p>
                    </quote></p>
                <closer><signed><hi rendition="#small-caps">Johnson</hi></signed></closer>
            </div>
