    <text>
        <body>
            <div xml:id="d499">

                <pb facs="0579" n="481" sameAs="frus:frus1932v04/pg481"/>

                <note rend="inline" type="source">393.11/1492: Telegram</note>
                <head><hi rendition="#italic">The Consul General at Hankow (Adams) to the Secretary
                        of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Hankow</hi></placeName>, <date calendar="gregorian"
                            when="1932-03-14T12:00:00+08:00">March 14,
                        1932—noon</date>.<lb/>[Received March 14—3 a.m.]</dateline>
                </opener>
                <p>42. My number 37, February 26, 3 p.m.<anchor n="18" xml:id="d499-f1"/> The
                    communist attack upon Kwangchow has been defeated and the danger to that city
                    removed for the time being. The Americans residing in Kwangchow are
                    unharmed.</p>
                <closer><signed><hi rendition="#small-caps">Adams</hi></signed></closer>
            </div>
        </body>
    </text>
