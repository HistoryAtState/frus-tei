                <pb facs="0824" n="794" xml:id="pg794"/>

                <head>Errata</head>
                <p>The following change has been made to <ref target="frus:frus1958-60v14"><hi
                            rendition="#italic">Foreign Relations</hi>, 1958–1960, Africa, Volume
                        XIV</ref>. Please be aware that printed volumes have not been revised.
                    <!--Revised information is in italic.--></p>
                <list type="simple">
                    <item><hi rendition="#bold">1. <ref target="#pg689">Document 318, Page 689</ref>
                            (date of correction: January 2, 2013)</hi></item>
                    <item>The citation to “Document 13 and footnote 1 thereto” in Footnote 1 has
                        been corrected to read “Document 13”.</item>
                </list>
            </div>
        </body>
