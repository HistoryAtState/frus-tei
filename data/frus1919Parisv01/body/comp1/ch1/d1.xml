                <pb facs="0071" n="1" sameAs="frus:frus1919Parisv01/pg1"/>

                <head>
                    <hi rendition="#italic">Announcement by President Wilson of the Signing of the
                        Armistice, November 11, 1918</hi><anchor n="2" xml:id="d1-f1"/>
                </head>
                <dateline>
                    <date ana="#date_undated-inferred-from-document-head" calendar="gregorian"
                        when="1918-11-11">November 11, 1918</date>
                </dateline>
                <p>
                    <hi rendition="#small-caps">My Fellow Countrymen</hi>: The armistice was signed
                    this morning. Everything for which America fought has been accomplished. It will
                    now be our fortunate duty to assist by example, by sober, friendly counsel, and
                    by material aid in the establishment of just democracy throughout the world.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Woodrow Wilson</hi>
                    </signed>
                </closer>
            </div>
        </body>
