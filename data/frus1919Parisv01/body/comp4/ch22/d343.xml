        <body>
            <div xml:id="d343">

                <pb facs="0449" n="379" sameAs="frus:frus1919Parisv01/pg379"/>

                <note rend="inline" type="source">
                    Woodrow Wilson Papers</note>
                <head>
                    <hi rendition="#italic">The French High Commissioner to the United States</hi>
                        (<hi rendition="#italic"
                            >Tardieu</hi>) <hi rendition="#italic">to Colonel E. M. House
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi>
                        </placeName>, <date calendar="gregorian" when="1918-12-24">December 24,
                            1918</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Colonel
                            House</hi>: The Cabinet this morning have agreed on the terms
                    of the following memorandum, which they asked me to forward to you to be
                    submitted to the President before he leaves for London.</p>
                <p>Believe me [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">André Tardieu</hi>
                        
                    </signed>
                </closer>
                <postscript>
                    <p rendition="#flush">[Autograph note by Colonel
                            House:]</p>
                    <p>
                        Tardieu was anxious for you to get
                        this before you reached London. He said Clemenceau was very interested in it.</p>
                    <closer>
                        <signed>
                            E. M. H.
                        </signed>
                    </closer>
                </postscript>


                <xi:include href="d343-a1.xml" xpointer="d343-a1"/>
