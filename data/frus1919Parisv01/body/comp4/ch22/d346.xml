    <text>
        <body>
            <div xml:id="d346">

                <pb facs="0466" n="396" sameAs="frus:frus1919Parisv01/pg396"/>

                <head>
                    <hi rendition="#italic">The Technical Advisers to the Commission to Negotiate
                        Peace</hi> (<hi rendition="#italic"
                            >Miller</hi>, 
                        <hi rendition="#italic">Scott</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi><anchor n="33" xml:id="d346-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName>
                            <hi rendition="#small-caps">Paris</hi>
                        </placeName>,] <date calendar="gregorian" when="1919-01-12">12 January,
                            1919</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Secretary</hi>: Enclosed please find
                    Observations on “Plan des Premières Conversations Entre Les Ministres Alliés à
                    Partir du <pb facs="0467" n="397" xml:id="pg397"/> 13 Janvier 1919,”<anchor
                        n="34" xml:id="d346-f2"/> prepared in accordance with your suggestion of the
                    10th instant for the use of the American Commission to Negotiate Peace.</p>
                <p>We are,</p>
                <p>Very sincerely yours,</p>
                <closer>
                    <signed>
                        <list>
                            <item>
                                
                                    <hi rendition="#small-caps">David Hunter Miller</hi>
                                
                            </item>
                            <item>
                                
                                    <hi rendition="#small-caps">James Brown Scott</hi>
                                
                            </item>
                        </list>
                    </signed>
                </closer>


                <xi:include href="d346-a1.xml" xpointer="d346-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d346-f1" n="33" type="source" xml:id="d346-f1-content">
                <p>This letter and its enclosure are reprinted from Miller, <hi rendition="#italic">My Diary</hi>, vol. <hi
                        rendition="#small-caps">iii</hi>, pp. 241—254.</p>
            </note>
            <note corresp="#d346-f2" n="34" xml:id="d346-f2-content">
                <p>For text of the “Plan des Premières Conversations …”, in translation, see <hi
                        rendition="#italic">supra.</hi>
                </p>
            </note>
        </listAnnotation>
    </standOff>
