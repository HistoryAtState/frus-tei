    <text>
        <body>
            <div xml:id="d345">

                <pb facs="0455" n="385" sameAs="frus:frus1919Parisv01/pg385"/>

                <note rend="inline" type="source">
                    Henry White Papers</note>
                <head>
                    <hi rendition="#italic">The Chargé in France</hi> (<hi rendition="#italic">Bliss</hi>) <hi
                        rendition="#italic">to Mr. Henry
                            White
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi>
                        </placeName>, <date calendar="gregorian" when="1919-01-09">January 9,
                            1919</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to send you herewith
                    enclosed the plan of the preliminary sittings of the Allied Ministers which I
                    have just received from the Minister for Foreign Affairs in the French text
                    accompanied by an English translation.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Robert Woods Bliss</hi>
                        
                    </signed>
                </closer>



                <xi:include href="d345-a1.xml" xpointer="d345-a1"/>
            </div>
        </body>
    </text>
