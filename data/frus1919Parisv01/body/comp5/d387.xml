    <text>
        <body>
            <div xml:id="d387">

                <pb facs="0581" n="511" sameAs="frus:frus1919Parisv01/pg511"/>

                <head>
                    <hi rendition="#italic">Mr. D. H. Miller to Colonel E. M. House </hi><anchor
                        n="8" xml:id="d387-f1"/>
                </head>
                <p>Herewith is a tentative draft of a Declaration respecting Equality of Trade
                    Conditions. The attempt primarily has been to indicate the difficulties and
                    points of divergence which must or may arise.</p>
                <closer>
                    <signed> D. H. M[<hi rendition="#small-caps">iller</hi>] </signed>
                    <lb/><dateline rendition="#float-left">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi>
                        </placeName>, <date calendar="gregorian" when="1918-12-01">1 December,
                            1918</date>.</dateline>
                </closer>



                <xi:include href="d387-a1.xml" xpointer="d387-a1"/>
                <xi:include href="d387-a2.xml" xpointer="d387-a2"/>
            </div>
        </body>
    </text>
