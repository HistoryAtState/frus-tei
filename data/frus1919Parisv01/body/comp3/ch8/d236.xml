    <text>
        <body>
            <div xml:id="d236">

                <pb facs="0295" n="225" sameAs="frus:frus1919Parisv01/pg225"/>

                <note rend="inline" type="source">763.72119/2928: Telegram</note>
                <head>
                    <hi rendition="#italic"> Colonel E. M. House to the Acting Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi>
                        </placeName>, <date calendar="gregorian" when="1918-12-08T16:00:00+00:00"
                            >December 8, 1918—4 p.m.</date>
                        <lb/> [Received December 8—2:08 p.m.]</dateline>
                </opener>
                <p>240. Your 141, December 7, 6 p.m.<anchor n="2" xml:id="d236-f1"/> You may advise
                    da Gama that I will press this matter<anchor n="3" xml:id="d236-f2"/> and see if
                    it can be arranged.</p>
                <p>There is considerable opposition here to bringing into the preliminary conference
                    but the great Allied powers and the United States.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Edward House</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d236-f1" n="2" xml:id="d236-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d236-f2" n="3" xml:id="d236-f2-content">
                <p>i. e., Brazilian representation at the preliminary conference.</p>
            </note>
        </listAnnotation>
