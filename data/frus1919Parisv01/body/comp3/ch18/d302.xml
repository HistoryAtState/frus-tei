    <text>
        <body>
            <div xml:id="d302">

                <pb facs="0346" n="276" xml:id="pg276"/>

                <note rend="inline" type="source">Paris Peace Conf. 861.00/102</note>
                <head>
                    <hi rendition="#italic">The Russian Ambassador</hi> (<hi rendition="#italic">Bakhmeteff</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi>
                        </placeName>, <date calendar="gregorian" when="1919-01-10">January 10,
                            1919</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I have the honor to
                    transmit herewith an <hi rendition="#italic">aide-mémoire</hi> concerning the
                    recognition of the Government of Omsk. This document is being handed by the
                    Ambassadors of Russia to the Allied Governments.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">B. Bakhmeteff</hi>
                        
                    </signed>
                </closer>


                <xi:include href="d302-a1.xml" xpointer="d302-a1"/>
            </div>
