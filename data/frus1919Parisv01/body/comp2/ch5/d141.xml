    <text>
        <body>
            <div xml:id="d141">

                <pb facs="0229" n="159" sameAs="frus:frus1919Parisv01/pg159"/>

                <note rend="inline" type="source"> Woodrow Wilson Papers</note>
                <head>
                    <hi rendition="#italic">Associate Justice Day, of the Supreme Court, to
                        President Wilson </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1918-11-14">November 14,
                            1918</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. President</hi>: I am deeply appreciative
                    of the honor which you have conferred upon me in the offer of a place upon the
                    Peace Commission.</p>
                <p>I wish it were practicable for me to accept this opportunity for service. I am,
                    however reluctantly, constrained to forego this privilege.</p>
                <p>Wishing you continued success in the great work before you, I am, with high
                    regard,</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">William R. Day</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
