    <text>
        <body>
            <div xml:id="d92">

                <pb facs="0200" n="130" sameAs="frus:frus1919Parisv01/pg130"/>

                <note rend="inline" type="source">
                    Woodrow Wilson Papers: Telegram</note>
                <head>
                    <hi rendition="#italic">President Wilson to the Special Representative</hi> (<hi rendition="#italic"
                    >House</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">[<placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1918-11-13">November 13,
                            1918</date>.]</dateline>
                </opener>
                <p>I expect to sail December 3rd.</p>
                <closer>
                    <signed>[<hi rendition="#small-caps">Woodrow
                                Wilson</hi>]</signed>
                </closer>
            </div>
