    <text>
        <body>
            <div xml:id="d114">

                <pb facs="0212" n="142" sameAs="frus:frus1919Parisv01/pg142"/>

                <note rend="inline" type="source">763.72119/2802: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Italy</hi> (<hi rendition="#italic"
                        >Page</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Rome</hi>
                        </placeName>, <date calendar="gregorian" when="1918-11-27T13:00:00+01:00"
                            >November 27, 1918—1 p.m.</date>
                        <lb/> [Received 8:33 p.m.]</dateline>
                </opener>
                <p>2415. Department 1864.<anchor n="23" xml:id="d114-f1"/> Please say to the
                    President for me: “For heavens sake don’t come to Europe without visiting Italy
                    before returning home.”</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Nelson Page</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
