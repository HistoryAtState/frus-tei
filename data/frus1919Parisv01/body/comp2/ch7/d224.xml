    <text>
        <body>
            <div xml:id="d224">

                <pb facs="0287" n="217" sameAs="frus:frus1919Parisv01/pg217"/>

                <note rend="inline" type="source">Paris Peace Conf. 184.82/5</note>
                <head>
                    <hi rendition="#italic">The Chief of the Press Bureau</hi> (<hi
                        rendition="#italic">Baker</hi>) <hi rendition="#italic">to the Secretary of
                        the Commission to Negotiate Peace</hi> (<hi rendition="#italic"
                    >Grew</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">[<placeName>
                            <hi rendition="#small-caps">Paris</hi>
                        </placeName>,] <date calendar="gregorian" when="1919-01-02">January 2,
                            1919</date>.</dateline>
                </opener>
                <p rendition="#flush">Subject: Appointments of British correspondents with the
                    commissioners.</p>
                <p>1. In reference to the decision of the Commission in regard to making
                    appointments for British correspondents, I have sent the enclosed letter to Mr.
                    Adam. I think it will cover the ground.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Ray Stannard Baker</hi>
                    </signed>
                </closer>


                <xi:include href="d224-a1.xml" xpointer="d224-a1"/>
