    <text>
        <body>
            <div xml:id="d202">

                <pb facs="0273" n="203" sameAs="frus:frus1919Parisv01/pg203"/>

                <note rend="inline" type="source">763.72119 P 43/1046</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        President Wilson
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1918-11-29">November 29,
                            1918</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. President</hi>: You are entirely correct
                    in assuming that my letter of the twenty-sixth of November relates to the
                    expenses of the arrangements for gathering political intelligence, which we have
                    been planning through Colonel House in
                    response to his telegrams.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Robert Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
