                    <item>Loans <list>
                            <item>Where floated</item>
                            <item>Where held</item>
                            <item>By whom <list>
                                    <item>Nationality</item>
                                    <item>Government participation</item>
                                </list>
                            </item>
                            <item>Debt Service <list>
                                    <item>To what applied</item>
                                </list>
                            </item>
                        </list>
                    </item>
                    <label>IV</label>
                    <item>Export Trade <list>
                            <item>Destination, volume and velocity, value</item>
                            <item>Character and nationality of commercial control</item>
                            <item>Bounties, laws, etc.</item>
                            <item>How financed</item>
                            <item>Firms engaged</item>
                        </list>
                    </item>
                    <label>V</label>
                    <item>Import Trade <list>
                            <item>Origin, route, volume, velocity, value, indispensability</item>
                            <item>How financed</item>
                            <item>Tariffs</item>
                            <item>Firms engaged, selling organization</item>
                        </list>
                    </item>
                    <label>VI</label>
                    <item>European colonies and European settlements</item>
