            </note>
            <note corresp="#d501-f2" n="82" xml:id="d501-f2-content">
                <p>Rear Adm. David McDougal LeBreton, commander, United States Yangtze Patrol.</p>
            </note>
            <note corresp="#d501-f3" n="83" xml:id="d501-f3-content">
                <p>China Merchants’ Steam Navigation Company.</p>
            </note>
        </listAnnotation>
