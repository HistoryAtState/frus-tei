    <text>
        <body>
            <div xml:id="d740">

                <pb facs="0548" n="544" sameAs="frus:frus1938v04/pg544"/>

                <note rend="inline" type="source">893.70/49: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Consul General at
                        Shanghai</hi> (<hi rendition="#italic">Gauss</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1938-11-23T20:00:00-05:00">November 23, 1938—8
                        p.m.</date></dateline>
                </opener>
                <p>631. Your 1416, November 16, 8 p.m. Proposed action as outlined in paragraph 2 of
                    your telegram is approved. Please advise Department <pb facs="0549" n="545"
                        xml:id="pg545"/> if and when reply is sent to Japanese authorities by your
                    British and Danish colleagues and yourself.</p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
    </text>
