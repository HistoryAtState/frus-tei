    <text>
        <body>
            <div xml:id="d694">

                <pb facs="0518" n="514" sameAs="frus:frus1938v04/pg514"/>

                <note rend="inline" type="source">393.1163 Lutheran Brethren Mission/22:
                    Telegram</note>
                <head><hi rendition="#italic">The Ambassador in China</hi> (<hi rendition="#italic"
                        >Johnson</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Chungking</hi></placeName>, <date calendar="gregorian"
                            when="1938-10-27T20:00:00+07:00">October 27, 1938—8
                        p.m.</date><lb/>[Received October 27—noon.]</dateline>
                </opener>
                <p>516. Following message from [E.] A. [<hi rendition="#italic">C</hi>.]
                        Aandahl<anchor n="28" xml:id="d694-f1"/> at Tangho Honan, dated 7:20 p.m.,
                    October 26 received here.</p>
                <quote rend="blockquote">
                    <p>“Tungpeh bombed Monday flag marked building deliberate destroyed, Mrs. Nyhus
                        and Ruthie wounded, Phoebe Killed, Nyhus Unhurt, all here, advice
                        requested.”</p>
                </quote>
                <p>Shanghai please inform Tokyo. Repeated to Hankow and Shanghai.</p>
                <closer><signed><hi rendition="#small-caps">Johnson</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d694-f1" n="28" xml:id="d694-f1-content">
                <p>Probably Rev. Elliot C. Aandahl, Jr., of the American Lutheran Brethren
                    Mission.</p>
            </note>
        </listAnnotation>
    </standOff>
