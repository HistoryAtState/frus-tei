    <text>
        <body>
            <div xml:id="d608">

                <pb facs="0454" n="450" sameAs="frus:frus1938v04/pg450"/>

                <note rend="inline" type="source">393.1162 Wuhu Clinic/15: Telegram</note>
                <head><hi rendition="#italic">The Consul General at Shanghai</hi> (<hi
                        rendition="#italic">Lockhart</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Shanghai</hi></placeName>, <date calendar="gregorian"
                            when="1938-08-24T14:00:00+08:00">August 24, 1938—2
                        p.m.</date><lb/>[Received August 24—7:15 a.m.]</dateline>
                </opener>
                <p>1159. My 1147, August 22, 1 p.m.<anchor n="63" xml:id="d608-f1"/> Japanese Consul
                    General informed me today that the Japanese Consul in Wuhu has the matter under
                    negotiation with Doctor Brown and that he believes the matter will be amicably
                    adjusted.</p>
                <p>Sent to Nanking.</p>
                <closer><signed><hi rendition="#small-caps">Lockhart</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d608-f1" n="63" xml:id="d608-f1-content">
                <p>Not printed; this telegram referred to the hospital clinic case at Wuhu.</p>
            </note>
        </listAnnotation>
    </standOff>
