    <text>
        <body>
            <div xml:id="d81">

                <pb facs="0064" n="60" xml:id="pg60"/>

                <note rend="inline" type="source">693.001/356: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Japan</hi> (<hi rendition="#italic"
                        >Grew</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Tokyo</hi></placeName>, <date calendar="gregorian"
                            when="1938-10-07T17:00:00+09:00">October 7, 1938—5
                        p.m.</date><lb/>[Received October 7—6:20 a.m.]</dateline>
                </opener>
                <p>651. Department’s telegram No. 346, October 6, 7 p.m.,<anchor n="88"
                        xml:id="d81-f1"/> American rights in China. Note with approved changes was
                    delivered at the Foreign Office this afternoon.<anchor n="89" xml:id="d81-f2"/>
                    Copy will be sent tomorrow to Shanghai by registered mail.</p>
                <closer><signed><hi rendition="#small-caps">Grew</hi></signed></closer>
            </div>
        </body>
    </text>
