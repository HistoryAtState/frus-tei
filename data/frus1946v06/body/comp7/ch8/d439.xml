                <pb facs="0655" n="641" sameAs="frus:frus1946v06/pg641"/>

                <note rend="inline" type="source">611.7131/10–2546</note>
                <head><hi rendition="#italic">Memorandum of Conversation, by Mr. Howard J. Hilton,
                        Jr., of the Division of Commercial Policy</hi></head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1946-10-25">October 25, 1946</date>.</dateline>
                </opener>
                <table>
