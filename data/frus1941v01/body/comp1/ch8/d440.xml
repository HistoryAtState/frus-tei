    <text>
        <body>
            <div xml:id="d440">

                <pb facs="0448" n="436" xml:id="pg436"/>

                <note rend="inline" type="source">840.48 Refugees/2490: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Ambassador in the United Kingdom</hi> (<hi
                            rendition="#italic">Winant</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1941-03-24">March 24, 1941</date>.</dateline>
                </opener>
                <p>1000. For Achilles.<anchor n="8" xml:id="d440-f1"/> Mr. Myron Taylor<anchor n="9"
                        xml:id="d440-f2"/> wishes you to inform Lord Winterton and Sir Herbert
                        Emerson<anchor n="10" xml:id="d440-f3"/> that the Secretary of State has
                    designated Mr. Edward S. Maney, a Foreign Service officer,<anchor n="11"
                        xml:id="d440-f4"/> as Secretary of the Intergovernmental Committee,
                    succeeding Mr. Alfred Wagg who resigned on March 1, 1941.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Welles</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d440-f1" n="8" xml:id="d440-f1-content">
                <p>Theodore C. Achilles, Third Secretary of Embassy.</p>
            </note>
            <note corresp="#d440-f2" n="9" xml:id="d440-f2-content">
                <p>Chairman of the American Delegation to the Intergovernmental Committee on
                    Political Refugees.</p>
            </note>
            <note corresp="#d440-f3" n="10" xml:id="d440-f3-content">
                <p>Director of the Intergovernmental Committee.</p>
            </note>
            <note corresp="#d440-f4" n="11" xml:id="d440-f4-content">
                <p>Assigned to the Division of European Affairs.</p>
            </note>
        </listAnnotation>
    </standOff>
