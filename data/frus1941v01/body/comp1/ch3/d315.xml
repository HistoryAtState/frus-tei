            </note>
            <note corresp="#d315-f2" n="65" xml:id="d315-f2-content">
                <p>Nicholas Horthy de Nagybánya.</p>
            </note>
            <note corresp="#d315-f3" n="66" xml:id="d315-f3-content">
                <p>Paul, Count Teleki de Szék committed suicide April 3, 1941.</p>
            </note>
        </listAnnotation>
