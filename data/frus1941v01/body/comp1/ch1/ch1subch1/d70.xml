                <pb facs="0070" n="58" sameAs="frus:frus1941v01/pg58"/>

                <note rend="inline" type="source">811.20 (D) Regulations/5514</note>
                <head>
                    <hi rendition="#italic">Memorandum by the Acting Chief of the Division of
                        European Affairs</hi> (<hi rendition="#italic"
                            >Atherton</hi>) <hi rendition="#italic">to the Division of Controls
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1941-08-21">August 21, 1941</date>.</dateline>
                </opener>
                <p rendition="#center">
                    <hi rendition="#small-caps">Recommended Policy With Respect To The Issuance Of
                        Export Licenses Covering Products Destined For Finland</hi>
                </p>
                <p>Until further notice it is recommended that applications for licenses covering
                    products destined for Finland be rejected.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Ray Atherton</hi>
                    </signed>
                </closer>
            </div>
        </body>
