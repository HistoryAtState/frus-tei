            <div xml:id="d159">

                <pb facs="0165" n="153" sameAs="frus:frus1941v01/pg153"/>

                <note rend="inline" type="source">740.0011 European War 1939/12433b: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Ambassador in the Soviet Union</hi> (<hi
                            rendition="#italic">Steinhardt</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1941-06-24T19:00:00-04:00">June 24, 1941—7
                            p.m.</date>
                    </dateline>
                </opener>
                <p>840. Has the Soviet Union issued a formal proclamation of war against Germany or
                    against Italy? If so, please telegraph text and date.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Welles</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
