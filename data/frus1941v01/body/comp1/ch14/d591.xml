            <div xml:id="d591">

                <pb facs="0604" n="592" sameAs="frus:frus1941v01/pg592"/>

                <note rend="inline" type="source">740.0011 European War 1939/17497: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in Hungary</hi> (<hi
                            rendition="#italic">Pell</hi>) <hi rendition="#italic">to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Budapest</hi></placeName>, <date
                            calendar="gregorian" when="1941-12-13">December 13,
                        1941</date>.<lb/>[Received December 13—2:36 p.m.]</dateline>
                </opener>
                <p>710. The Prime Minister informed me at 5:30 this afternoon that Hungary considers
                    war to exist between Hungary and United States. All codes destroyed.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Pell</hi>
                    </signed>
                </closer>
            </div>
        </body>
