    <text>
        <body>
            <div xml:id="d570">

                <pb facs="0591" n="579" xml:id="pg579"/>

                <note rend="inline" type="source">811.24546/6: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Consul at Nouméa</hi> (<hi
                        rendition="#italic">MacVitty</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1941-10-29T23:00:00-05:00">October 29,
                            1941—11 p.m.</date>
                    </dateline>
                </opener>
                <p>20. Your 22, October 22, 10 a.m. Department approves your action in not
                    presenting matter to High Commissioner in view of circumstances described. The
                    War Department has instructed the Commanding General at Hawaii<anchor n="13"
                        xml:id="d570-f1"/> to communicate with the Australians with reference to
                    bases in New Caledonia.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d570-f1" n="13" xml:id="d570-f1-content">
                <p>Gen. Walter Campbell Short.</p>
            </note>
        </listAnnotation>
    </standOff>
