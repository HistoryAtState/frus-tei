    <text>
        <body>
            <div xml:id="d569">

                <pb facs="0590" n="578" sameAs="frus:frus1941v01/pg578"/>

                <note rend="inline" type="source">811.24546/13: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in the United Kingdom</hi> (<hi
                            rendition="#italic">Winant</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1941-10-28T19:00:00-05:00">October 28, 1941—7
                            p.m.</date>
                    </dateline>
                </opener>
                <p>4787. Your 5045, October 22, 7 p.m. and 5073, October 24, 5 p.m.<anchor n="12"
                        xml:id="d569-f1"/> The War Department has a supply ship ready to sail from
                    Hawaii for Christmas Island October 30. Please request British concurrence in
                    starting immediate construction. You may add, if the question is raised, that we
                    regard any construction there as without prejudice to the general question of
                    sovereignty over the island.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
