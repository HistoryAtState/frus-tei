    <text>
        <body>
            <div xml:id="d454">

                <pb facs="0462" n="450" sameAs="frus:frus1941v01/pg450"/>

                <note rend="inline" type="source">851.00/2567: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador to the Polish Government in Exile</hi>
                        (<hi rendition="#italic">Biddle</hi>) <hi rendition="#italic">to the
                        Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1941-12-16T20:00:00+01:00">December 16,
                            1941—8 p.m.</date>
                        <lb/> [Received December 16—2 p.m.]</dateline>
                </opener>
                <p>Polish Series 55. My 54, December 15, 7 p.m. Polish Foreign Office now states
                    Russians have consented to take part in proposed conference.</p>
                <closer>
                    <signed>[<hi rendition="#small-caps">Biddle</hi>]</signed>
                </closer>
            </div>
        </body>
