            </note>
            <note corresp="#d529-f2" n="93" xml:id="d529-f2-content">
                <p>Loyd V. Steere, Agricultural Attaché, American Embassy at London.</p>
            </note>
            <note corresp="#d529-f3" n="94" xml:id="d529-f3-content">
                <p>Paul H. Appleby, Under Secretary of Agriculture.</p>
            </note>
            <note corresp="#d529-f4" n="95" xml:id="d529-f4-content">
                <p>Rudolph M. Evans, Director, Agriculture Adjustment Administration.</p>
            </note>
            <note corresp="#d529-f5" n="96" xml:id="d529-f5-content">
                <p>R. S. Hudson, British Minister of Agriculture and Fisheries.</p>
            </note>
        </listAnnotation>
