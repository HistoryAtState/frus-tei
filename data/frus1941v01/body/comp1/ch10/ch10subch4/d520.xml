            <div xml:id="d520">

                <pb facs="0533" n="521" sameAs="frus:frus1941v01/pg521"/>

                <note rend="inline" type="source">800.6354/272: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the United Kingdom</hi> (<hi rendition="#italic">Winant</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1941-05-16">May 16,
                        1941</date>.<lb/>[Received May 16—9:16 a.m.]</dateline>
                </opener>
                <p>1943. No communiqué was issued following the tin meeting yesterday. None of the
                    delegations had received instructions from their Governments concerning renewal
                    of control.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Winant</hi>
                    </signed>
                </closer>
            </div>
        </body>
