    <text>
        <body>
            <div xml:id="d498">

                <pb facs="0503" n="491" sameAs="frus:frus1941v01/pg491"/>

                <note rend="inline" type="source">585.61B1/596: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in the United
                        Kingdom</hi> (<hi rendition="#italic">Winant</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1941-08-09">August 9, 1941</date>.</dateline>
                </opener>
                <p>3053. Department’s 3014, 7th. The President has today issued a proclamation
                    declaring the load line convention suspended for the duration of the present
                        emergency.<anchor n="39" xml:id="d498-f1"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d498-f1" n="39" xml:id="d498-f1-content">
                <p>For text of proclamation and public announcement issued August 9, 1941, see
                    Department of State <hi rendition="#italic">Bulletin</hi>, August 9, 1941, p.
                    114; see also 55 Stat. 1660.</p>
            </note>
        </listAnnotation>
