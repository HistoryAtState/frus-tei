    <text>
        <body>
            <div xml:id="d654">

                <pb facs="0669" n="657" sameAs="frus:frus1941v01/pg657"/>

                <note rend="inline" type="source">701.6111/1061a: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in the Soviet Union</hi> (<hi
                            rendition="#italic">Steinhardt</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1941-11-10T22:00:00-05:00">November 10,
                            1941—10 p.m.</date>
                    </dateline>
                </opener>
                <p>1207. Following for Litvinov from Joseph E. Davies:<anchor n="30"
                        xml:id="d654-f1"/>
                    <quote rend="blockquote">
                        <p>“None among your many friends found more satisfaction in your appointment
                            to Washington than did we. We have found the greatest admiration and
                            pride in the extraordinary effectiveness and magnificent heroism which
                            the Soviet Union is displaying every day in this decisive battle for the
                            preservation of civilization and freedom. Please give regards to Premier
                            Stalin, Prime Minister Molotov, Ambassador Oumansky, Troyanovsky<anchor
                                n="31" xml:id="d654-f2"/> and our other friends. A warm welcome will
                            be awaiting you here.”</p>
                    </quote>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d654-f1" n="30" xml:id="d654-f1-content">
                <p>Mr. Davies had been the American Ambassador in the Soviet Union during part of
                    the years 1937 and 1938.</p>
            </note>
            <note corresp="#d654-f2" n="31" xml:id="d654-f2-content">
                <p>Alexander Antonovich Troyanovsky had been the Ambassador of the Soviet Union to
                    the United States from early 1934 until 1939.</p>
            </note>
        </listAnnotation>
    </standOff>
