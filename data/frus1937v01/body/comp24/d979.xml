                <pb facs="0997" n="985" sameAs="frus:frus1937v01/pg985"/>

                <note rend="inline" type="source">702.0011B/7</note>
                <head><hi rendition="#italic">The Secretary of War</hi> (<hi
                            rendition="#italic">Woodring</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1937-05-25">May 25, 1937</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Dear Mr. Secretary</hi>: I am inclosing for your
                    information a translation of a coded radiogram, dated May 22, 1937, received in
                    the Bureau of Insular Affairs of this Department from the High Commissioner to
                    the Philippine Islands.</p>
                <p>Sincerely yours,</p>
                <closer><signed><hi rendition="#small-caps">Harry H. Woodring</hi></signed></closer>


                <xi:include href="d979-a1.xml" xpointer="d979-a1"/>
