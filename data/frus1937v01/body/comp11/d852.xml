    <text>
        <body>
            <div xml:id="d852">

                <pb facs="0838" n="826" sameAs="frus:frus1937v01/pg826"/>

                <note rend="inline" type="source">640.0031/92a: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Minister in the
                        Netherlands</hi> (<hi rendition="#italic">Emmet</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1937-03-04T12:00:00-05:00">March 4, 1937—noon</date>.</dateline>
                </opener>
                <p>8. Please keep Department fully informed of discussions at conference of members
                    of the Oslo Convention now assembled at The Hague.<anchor n="3" xml:id="d852-f1"
                    /></p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d852-f1" n="3" xml:id="d852-f1-content">
                <p>Conference, March 3–7, 1937, of experts from Finland and the States signatories
                    of the Oslo Convention of December 22, 1930, Belgium, Denmark, Luxembourg, the
                    Netherlands, Norway and Sweden; for text of the Oslo Convention, see League of
                    Nations Treaty Series, vol. <hi rendition="#small-caps">cxxvi</hi>, p. 341.</p>
            </note>
        </listAnnotation>
    </standOff>
