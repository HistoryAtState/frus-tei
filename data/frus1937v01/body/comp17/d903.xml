    <text>
        <body>
            <div xml:id="d903">

                <pb facs="0912" n="900" sameAs="frus:frus1937v01/pg900"/>

                <note rend="inline" type="source">856D.6176/407: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in the United Kingdom</hi> (<hi
                        rendition="#italic">Bingham</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1937-03-25T18:00:00+00:00">March 25, 1937—6
                        p.m.</date><lb/>[Received March 25—2:02 p.m.]</dateline>
                </opener>
                <p>171. Foreign Office has asked Atherton<anchor n="31" xml:id="d903-f1"/> and
                        Butterworth<anchor n="32" xml:id="d903-f2"/> to meet with Colonial and
                    Foreign Office representatives under chairmanship of Assistant Secretary of
                    State on Tuesday, March 30, at 3 o’clock to discuss rubber situation.</p>
                <closer><signed><hi rendition="#small-caps">Bingham</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d903-f1" n="31" xml:id="d903-f1-content">
                <p>Ray Atherton, Counselor of Embassy.</p>
            </note>
            <note corresp="#d903-f2" n="32" xml:id="d903-f2-content">
                <p>William W. Butterworth, Jr., Second Secretary of Embassy.</p>
            </note>
        </listAnnotation>
    </standOff>
