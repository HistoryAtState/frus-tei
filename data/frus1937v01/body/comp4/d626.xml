    <text>
        <body>
            <div xml:id="d626">

                <pb facs="0624" n="612" xml:id="pg612"/>

                <note rend="inline" type="source">765.94/60: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Japan</hi> (<hi rendition="#italic"
                        >Grew</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Tokyo</hi></placeName>, <date calendar="gregorian"
                            when="1937-11-05T18:00:00+09:00">November 5, 1937—6
                        p.m.</date><lb/>[Received November 5—6:40 a.m.]</dateline>
                </opener>
                <p>522. I am confidentially informed by a member of the Italian Embassy that
                    arrangements have been completed for signature at Rome on November 6 at 7 p.m.,
                    of the Japanese-Italian Anti-Communist Pact.<anchor n="14" xml:id="d626-f1"
                    /></p>
                <closer><signed><hi rendition="#small-caps">Grew</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d626-f1" n="14" xml:id="d626-f1-content">
                <p>For translation of text of protocol concluded by Italy, Germany, and Japan
                    November 6, 1937, see <ref target="frus1931-41v02#pg_159"><hi
                            rendition="#italic">Foreign Relations</hi>, Japan, 1931–1941, vol. <hi
                            rendition="#small-caps">ii</hi>, p. 159</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
