    <text>
        <body>
            <div xml:id="d246">

                <pb facs="0349" n="337" sameAs="frus:frus1937v01/pg337"/>

                <note rend="inline" type="source">852.00/5841</note>
                <head><hi rendition="#italic">The Mexican Ambassador</hi> (<hi rendition="#italic"
                        >Castillo Nájera</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener>
                    <seg rendition="#center">[Translation]</seg>
                </opener>
                <p>The Ambassador of Mexico presents his compliments to His Excellency the Secretary
                    of State, Mr. Cordell Hull, and takes pleasure in sending to him the text of the
                    communication which he had the honor to transmit this morning to His Excellency
                    the President of the United States Franklin Delano Roosevelt.</p>
                <closer>
                    <dateline rendition="#float-left">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1937-06-24">June 24,
                            1937</date>.</dateline>
                </closer>



                <xi:include href="d246-a1.xml" xpointer="d246-a1"/>
            </div>
