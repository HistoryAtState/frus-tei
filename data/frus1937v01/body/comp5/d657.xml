            </note>
            <note corresp="#d657-f2" n="26" xml:id="d657-f2-content">
                <p>Yvon Delbos, French Minister for Foreign Affairs, and delegate to the League of
                    Nations Assembly.</p>
            </note>
            <note corresp="#d657-f3" n="27" xml:id="d657-f3-content">
                <p>Léon Blum, President of the French Council of Ministers.</p>
            </note>
            <note corresp="#d657-f4" n="28" xml:id="d657-f4-content">
                <p>H. H. Kung, Chinese Minister of Finance.</p>
            </note>
        </listAnnotation>
