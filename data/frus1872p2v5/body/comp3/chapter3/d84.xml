            <div xml:id="d84">

                <pb facs="0185" n="155" sameAs="frus:frus1872p2v5/pg155"/>

                <note rend="inline" type="source">No. 58.</note>
                <head>The Attorney-General to the Secretary of State.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of Justice</hi>, <hi
                                rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1872-04-06"><hi rendition="#italic"
                                >April</hi> 6, 1872.</date></dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose for your
                    consideration and use * * a statement prepared and addressed to me by Henry R.
                    Crosby, esq., for whose reliability I am willing to vouch. * * *</p>
                <closer>
                    <signed>GEO. H. WILLIAMS, <hi rendition="#italic"
                        >Attorney-General.</hi></signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">Hamilton Fish</hi>, <hi rendition="#italic"
                            >Secretary of State.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
