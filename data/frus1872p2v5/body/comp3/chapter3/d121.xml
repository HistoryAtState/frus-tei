    <text>
        <body>
            <div xml:id="d121">

                <pb facs="0219" n="189" xml:id="pg189"/>

                <head>No. 76.</head>
                <opener>
                    <dateline rendition="#float-right">[<date
                            ana="#date_undated-inferred-from-document-content" calendar="gregorian"
                            when="1872-03-29">March 29, 1872</date>]</dateline>
                    <lb/>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">United States of America</hi>, <lb/>
                        <hi rendition="#italic">Department of State</hi>.</seg>
                </opener>
                <p><hi rendition="#italic">To all to whom these presents shall come</hi>, <hi
                        rendition="#italic">Greeting:</hi></p>
                <p>I certify that the paper hereto annexed is a correct copy of the Statement
                    furnished by the Acting Superintendent of the Census, of the returns of the
                    Ninth Census, from the “disputed” Islands in the County of Whatcom, Territory of
                    Washington. In testimony whereof, I, Hamilton Fish, Secretary of State of the
                    United States, have hereunto subscribed my name and caused the seal of the
                    Department of State to be affixed. Done at the City of Washington, this
                    twenty-ninth day of March, A. D. 1872, and of the Independence of the United
                    States of America the ninety-sixth.</p>
                <closer>
                    <signed>HAMILTON FISH.</signed>
                </closer>


                <xi:include href="d121-a1.xml" xpointer="d121-a1"/>
