    <text>
        <body>
            <div xml:id="d142">

                <pb facs="0288" n="258" sameAs="frus:frus1872p2v5/pg258"/>

                <note rend="inline" type="source">No. 4.</note>
                <head>Mr. Bancroft to Mr. Fish.</head>
                <opener>
                    <seg rendition="#float-left">No. 255.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">American Legation</hi>, <hi
                                rendition="#italic">Berlin</hi></placeName>, <date
                            calendar="gregorian" when="1871-09-01"><hi rendition="#italic"
                                >September</hi> 1, 1871</date>. (Received September 20.)</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose a copy of the note which I have
                    received this day from the German Secretary of State, notifying me formally that
                    the Emperor of Germany has accepted the office of arbitrator in the controversy
                    on the northwestern boundary between the United States and Great Britain.<seg
                        type="margin">Formal acceptance by the Emperor of Germany of the office of
                        Arbitrator.</seg></p>
                <p>I remain, &amp;c.,</p>
                <closer>
                    <signed>GEO. BANCROFT.</signed>
                </closer>
            </div>
        </body>
    </text>
