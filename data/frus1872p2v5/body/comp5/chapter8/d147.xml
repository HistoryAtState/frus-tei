                <pb facs="0290" n="260" sameAs="frus:frus1872p2v5/pg260"/>

                <note rend="inline" type="source">No. 8.</note>
                <head>Mr. Bancroft to Mr.
                        Fish.</head>
                <opener>
                    <seg rendition="#float-left">No. 314.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">American Legation</hi>, <hi
                                rendition="#italic">Berlin</hi></placeName>, <date
                            calendar="gregorian" when="1871-12-28"><hi rendition="#italic">December
                                28,</hi> 1871</date>. (Received Jan. 16.)</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: Herewith I inclose a translation of a
                    letter received from the Chancellor of the German Empire, acknowledging the
                    receipt of the American memorial on the northwest boundary question, and
                    informing me that he was on the point of laying it before the Emperor.<seg
                        type="margin">Receipt of memorial acknowledged.</seg></p>
                <p>I remain, &amp;c.,</p>
                <closer>
                    <signed>GEO. BANCROFT.</signed>
                </closer>


                <xi:include href="d147-a1.xml" xpointer="d147-a1"/>
