    <text>
        <body>
            <div xml:id="d161">

                <pb facs="0300" n="270" sameAs="frus:frus1872p2v5/pg270"/>

                <note rend="inline" type="source">No. 22.</note>
                <head>Sir E. Thornton to Mr.
                        Fish.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">British Legation</hi>, <hi
                                rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1872-11-23"><hi rendition="#italic"
                                >November</hi> 23, 1872.</date></dateline>
                </opener>
                <p><hi rendition="#small-caps">My Dear Mr</hi>. <hi rendition="#small-caps"
                        >Fish</hi>: I have just received a telegram from Lord Granville in the
                    following words: <seg type="margin">San Juan evacuated by British.</seg></p>
                <pb facs="0301" n="271" xml:id="pg271"/>
                <p>Admiralty have received a telegram repeating that the detachment of Royal Marines
                    has evacuated San Juan.</p>
                <p>Believe me, very truly, yours,</p>
                <closer>
                    <signed>EDW’D THORNTON.</signed>
                </closer>
            </div>
        </body>
    </text>
