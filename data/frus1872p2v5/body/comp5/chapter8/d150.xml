    <text>
        <body>
            <div xml:id="d150">

                <pb facs="0293" n="263" sameAs="frus:frus1872p2v5/pg263"/>

                <note rend="inline" type="source">No. 11.</note>
                <opener>
                    <seg rendition="#center">[Extract.]</seg>
                </opener>
                <head>Mr. Bancroft to Mr. Fish.</head>
                <opener>
                    <seg rendition="#float-left">No. 377.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">American Legation</hi>, <hi
                                rendition="#italic">Berlin</hi></placeName>, <date
                            calendar="gregorian" when="1872-06-24"><hi rendition="#italic">June</hi>
                            24, 1872</date>. (Received July 13.)</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: * * * * * * *</p>
                <p>I transmit a translation of the acknowledgment that the definitive statements of
                    both parties are already in the hands of the Imperial Arbitrator.<seg
                        type="margin">Receipts of definitive statements by the Imperial Arbitrator
                        acknowledged.</seg></p>
                <p>I remain, &amp;c.,</p>
                <closer>
                    <signed>GEO. BANCROFT.</signed>
                </closer>


                <xi:include href="d150-a1.xml" xpointer="d150-a1"/>
            </div>
