                <pb facs="0071" n="45" sameAs="frus:frus1872p2v5/pg45"/>

                <head>[Untitled]</head>
                <opener>
                    <dateline rendition="#center"><hi rendition="#italic">Extract from the speech of
                            Mr. Cass, of Michigan, in the Senate</hi>, <date
                            ana="#date_imprecise-inferred-from-document-content"
                            calendar="gregorian" notAfter="1846-06-30" notBefore="1846-06-01"><hi
                                rendition="#italic">June,</hi> 1846</date></dateline>
                </opener>
                <p>* * * “We are seeking a doubtful good, at the certainty of a great sacrifice.” *
                    * * “Those who believe that our title to all Oregon is so ‘clear and
                    unquestionable’ that no portion of it ought to be relinquished, may well contend
                    for its whole extent, and risk the consequences.” * * *<seg type="margin">To
                        accept the line of 49° regarded as a sacrifice.</seg></p>
            </div>
        </body>
