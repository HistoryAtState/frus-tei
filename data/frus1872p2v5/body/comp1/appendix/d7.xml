            <div xml:id="d7">

                <pb facs="0048" n="22" xml:id="pg22"/>

                <head>[Untitled]</head>
                <opener>
                    <dateline rendition="#center"><hi rendition="#italic">Extract from the charter
                            granted by Charles II of England to the lords proprietors of
                            Carolina</hi>, <date calendar="gregorian" when="1863-03-24"><hi
                                rendition="#italic">March</hi> 24, 1663</date>.</dateline>
                </opener>
                <p>* * * * “all that territory or tract of ground” * * * “extending from the North
                    end of the Island called Lucke-Island, which lieth in the Southern Virginia Seas
                    and within six and thirty degrees of the Northern Latitude, and to the West as
                    far as the South Seas, and so southerly as far as the river St. Matthias, which
                    bordereth upon the coast of Florida, and within one and thirty degrees of
                    Northern Latitude, and so West in a direct line as far as the South Seas
                    aforesaid;” * * * *</p>
            </div>
        </body>
