    <text>
        <body>
            <div xml:id="d627">

                <pb facs="1146" n="1130" sameAs="frus:frus1950v04/pg1130"/>

                <note rend="inline" type="source">411.6131/3–1350: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Embassy in the Soviet
                        Union </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1950-03-23T19:00:00-05:00">March 23, 1950—7
                            p. m.</date>
                    </dateline>
                </opener>
                <p>243. Urtels 805 Mar 10, 829 Mar 13.<anchor n="1" xml:id="d627-f1"/> Abrogation
                    US–USSR commercial agreement on ground Sov establishment unrealistic exchange
                    rate renders agreement obsolete, making impossible normal traditional commercial
                    exchanges, considered inadvisable because ruble not internatl currency nor
                    element US-Sov trade. Embdes 233 Mar 3 being carefully considered and Dept
                    believes more appropriate opportunity action this connection may arise.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d627-f1" n="1" xml:id="d627-f1-content">
                <p>Latter telegram not printed.</p>
            </note>
        </listAnnotation>
    </standOff>
