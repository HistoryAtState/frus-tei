    <text>
        <body>
            <div xml:id="d609">

                <pb facs="1128" n="1112" xml:id="pg1112"/>

                <note rend="inline" type="source">761.13/2–2650: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in the Soviet Union</hi> (<hi rendition="#italic">Barbour</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Moscow</hi></placeName>, <date
                            calendar="gregorian" when="1950-02-26">February 26,
                        1950</date>.</dateline>
                </opener>
                <p>676. Soviet Press February 26 carries decree Supreme Soviet USSR ordering
                    separation naval forces from Ministry Armed Forces and formation All-Union Naval
                    Ministry USSR. Ministry Armed Forces renamed War Ministry. Admiral I. S.
                    Yumashev named Naval Minister.<anchor n="1" xml:id="d609-f1"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Barbour</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d609-f1" n="1" xml:id="d609-f1-content">
                <p>Admiral Ivan Stepanovich Yumashev was the Commander in Chief of the Naval Forces
                    of the Soviet Union, 1947–1951.</p>
            </note>
        </listAnnotation>
    </standOff>
