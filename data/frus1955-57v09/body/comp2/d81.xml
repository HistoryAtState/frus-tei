    <text>
        <body>
            <div xml:id="d81">

                <pb facs="0251" n="221" sameAs="frus:frus1955-57v09/pg221"/>

                <head>81. Letter From Minister of External Affairs Casey to Secretary of State Dulles<anchor n="1" xml:id="d81-f1"/>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#italic"
                                >Canberra</hi></placeName>, <date calendar="gregorian"
                            when="1957-03-13"><hi rendition="#italic">March 13,
                        1957</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Secretary Of State</hi>: I am attaching a
                    memorandum prepared by my Ministerial colleagues concerning setting out the
                    Australian attitude towards the disposal of United States Agricultural
                    surpluses.</p>
                <p>I had hoped for an opportunity to have had a few moments’ discussion with you on
                    this subject, but I am afraid there will not now be an opportunity.</p>
                <p>I am,</p>
                <p>Yours sincerely,</p>
                <closer><signed><hi rendition="#bold">R.G.
                            Casey</hi><anchor n="2" xml:id="d81-f2"/></signed></closer>



                <xi:include href="d81-a1.xml" xpointer="d81-a1"/>
            </div>
        </body>
    </text>
