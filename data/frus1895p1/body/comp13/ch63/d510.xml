    <text>
        <body>
            <div xml:id="d510">

                <pb facs="0586" n="526" sameAs="frus:frus1895p1/pg526"/>

                <head><hi rendition="#italic">Mr. Runyon to Mr.
                            Gresham</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >Berlin</hi></placeName>, <date calendar="gregorian"
                            when="1895-04-11"><hi rendition="#italic">April 11,
                        1895</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 248.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my dispatch No. 248,<anchor
                        n="1" xml:id="d510-f1"/> of October 31 last, I have the honor to inclose
                    herewith a copy, with translation, of a note to-day received from the imperial
                    foreign office, in the case of Frederick Sauer, a naturalized American citizen,
                    and to be, etc.</p>
                <closer><signed><hi rendition="#small-caps">Theodore Runyon</hi></signed>.</closer>



                <xi:include href="d510-a1.xml" xpointer="d510-a1"/>
            </div>
        </body>
    </text>
