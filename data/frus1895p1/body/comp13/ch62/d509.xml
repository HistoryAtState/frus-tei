        <body>
            <div xml:id="d509">

                <pb facs="0585" n="525" sameAs="frus:frus1895p1/pg525"/>

                <head><hi rendition="#italic">Mr. Runyon to Mr. Olney</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >Berlin</hi></placeName>, <date calendar="gregorian"
                            when="1895-12-31"><hi rendition="#italic">December 31, 1895</hi></date>.
                        (Received Jan. 17, 1896.)</dateline>
                    <seg rendition="#float-left">No. 442.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my dispatch, No. 281, of June
                    29 last, I have the honor to append hereto a memorandum report of certain
                    military cases, more particularly mentioned below, which have not yet been
                    referred to <pb facs="0586" n="526" xml:id="pg526"/> in my correspondence with
                    the Department, and to be, sir, your obedient servant,</p>
                <closer><signed><hi rendition="#small-caps">Theodore Runyon</hi></signed>.</closer>


                <xi:include href="d509-a1.xml" xpointer="d509-a1"/>
