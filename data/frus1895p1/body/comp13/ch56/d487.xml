    <text>
        <body>
            <div xml:id="d487">

                <pb facs="0564" n="504" xml:id="pg504"/>

                <head><hi rendition="#italic">Mr. Runyon to Mr. Gresham</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >Berlin</hi></placeName>, <date calendar="gregorian"
                            when="1895-03-24"><hi rendition="#italic">March 24, 1895</hi></date>.
                        (Received April 5.)</dateline>
                    <seg rendition="#float-left">No. 230.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    to-day of the Department’s instructions No. 237, of the 11th instant, relating
                    to the kinds of certificates and stamps used by the Department of Agriculture in
                    connection with the microscopic examination of meat intended for export, and to
                    inclose herein a copy of my note addressed to the Imperial foreign office in
                    compliance with the directions therein contained.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Theodore Runyon</hi></signed>.</closer>


                <xi:include href="d487-a1.xml" xpointer="d487-a1"/>
