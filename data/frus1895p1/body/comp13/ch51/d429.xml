    <text>
        <body>
            <div xml:id="d429">

                <pb facs="0501" n="441" sameAs="frus:frus1895p1/pg441"/>

                <head><hi rendition="#italic">Mr. Adee to Mr. Runyon</hi>.</head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-08-29"><hi rendition="#italic">August 29,
                        1895</hi></date>.</dateline></opener>
                <p>Private advices from representative of the Mutual Life Company in Prussia
                    indicate favorable outcome if views of the United States vigorously and
                    persistently put forward. This you are authorized to do with good judgment and
                    discretion.</p>
                <closer><signed><hi rendition="#small-caps">Adee</hi>, <hi rendition="#italic"
                            >Acting</hi></signed>.</closer>
            </div>
        </body>
    </text>
