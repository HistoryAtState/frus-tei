    <text>
        <body>
            <div xml:id="d432">

                <pb facs="0503" n="443" sameAs="frus:frus1895p1/pg443"/>

                <head><hi rendition="#italic">Mr. Runyon to Mr. Olney</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi></placeName>,<lb/><date
                            calendar="gregorian" when="1895-09-21"><hi rendition="#italic">September
                                21, 1895</hi></date>. (Received October 9.)</dateline>
                    <seg rendition="#float-left">No. 371.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to the Department’s telegraphic
                    instructions of the 5th instant, I have the honor to transmit herewith a copy of
                    a note to-day addressed by me to the German Government, which constitutes a
                    general answer to the various objections which have been made verbally and in
                    writing to the Mutual Life Insurance Company of New York, and to its business
                    methods, and to be, sir,</p>
                <p>Your obedient servant,</p>
                <closer><signed><hi rendition="#small-caps">Theodore Runyon</hi></signed>.</closer>


                <xi:include href="d432-a1.xml" xpointer="d432-a1"/>
