    <text>
        <body>
            <div xml:id="d218">

                <pb facs="0275" n="215" sameAs="frus:frus1895p1/pg215"/>

                <head><hi rendition="#italic">Mr. Smythe to Mr.
                            Gresham</hi>.</head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States to Santo Domingo</hi>,<lb/><hi
                                rendition="#italic">Port au Prince</hi></placeName>, <date
                            calendar="gregorian" when="1893-12-15"><hi rendition="#italic">December
                                15, 1893</hi></date>.</dateline></opener>
                <p>Commandant killed at Azua, Santo Domingo. Bold attempt to assassinate Heureaux.
                        Meade<anchor n="†" xml:id="d218-f1"/> cables American schooner attacked; two
                    sailors wounded at Azua. Have cabled instructions.</p>
                <closer><signed><hi rendition="#small-caps">Smythe</hi></signed>.</closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d218-f1" n="†" xml:id="d218-f1-content">
                <p>Consul at Santo Domingo City.</p>
            </note>
        </listAnnotation>
    </standOff>
