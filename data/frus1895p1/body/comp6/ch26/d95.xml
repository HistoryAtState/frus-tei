    <text>
        <body>
            <div xml:id="d95">

                <pb facs="0165" n="105" sameAs="frus:frus1895p1/pg105"/>

                <head><hi rendition="#italic">Mr. Denby to Mr.
                            Olney</hi>.</head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States in China</hi></placeName>,<lb/><date
                            calendar="gregorian" when="1895-08-14"><hi rendition="#italic">August
                                14, 1895</hi></date>.</dateline></opener>
                <p>I refused to have anything to do with the Szechuan commission three weeks
                    ago.</p>
                <closer><signed><hi rendition="#small-caps">Denby</hi></signed>.</closer>
            </div>
        </body>
    </text>
