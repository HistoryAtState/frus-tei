    <text>
        <body>
            <div xml:id="d187">

                <pb facs="0230" n="170" sameAs="frus:frus1895p1/pg170"/>

                <head><hi rendition="#italic">Mr. Olney to Mr. Denby</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-11-11"><hi rendition="#italic">November 11,
                        1895</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1188.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    No. 2362, of September 21 last, and to approve your instructions to the Kutien
                    commission on the question of clemency.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Richard Olney</hi></signed>.</closer>
            </div>
        </body>
    </text>
