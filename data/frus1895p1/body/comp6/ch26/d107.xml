        <body>
            <div xml:id="d107">

                <pb facs="0173" n="113" sameAs="frus:frus1895p1/pg113"/>

                <head><hi rendition="#italic">Mr. Denby to Mr.
                            Olney</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1895-08-22"><hi rendition="#italic">August 22, 1895</hi></date>.
                        (Received Oct. 8.)</dateline>
                    <seg rendition="#float-left">No. 2319.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose a clipping from
                    the North-China News of Monday, the 12th instant, containing an account of the
                    Kutien massacre.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charles Denby</hi></signed>.</closer>



                <xi:include href="d107-a1.xml" xpointer="d107-a1"/>
