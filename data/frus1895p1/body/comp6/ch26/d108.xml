    <text>
        <body>
            <div xml:id="d108">

                <pb facs="0176" n="116" sameAs="frus:frus1895p1/pg116"/>

                <head><hi rendition="#italic">Mr. Denby to Mr. Olney</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1895-08-24"><hi rendition="#italic">August 24, 1895</hi></date>.
                        (Received Oct. 8.)</dateline>
                    <seg rendition="#float-left">No. 2322.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inform you that I sent
                    the following telegram to Foochow on the 21st instant: <quote rend="blockquote">
                        <p rendition="#flush"><hi rendition="#small-caps">Hixson</hi>, <hi
                                rendition="#italic">Foochow:</hi></p>
                        <p>Have demanded that authorities cooperate with you; that an official be
                            delegated for the purpose; that you be present at examination, and no
                            obstruction offered.</p>
                        <p rendition="#right"><hi rendition="#small-caps"
                    >Denby</hi>.</p></quote></p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charles Denby</hi></signed>.</closer>
            </div>
        </body>
    </text>
