    <text>
        <body>
            <div xml:id="d136">

                <pb facs="0195" n="135" sameAs="frus:frus1895p1/pg135"/>

                <head><hi rendition="#italic">Mr. Denby to Mr.
                            Olney</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1895-09-16"><hi rendition="#italic">September 16,
                        1895</hi></date>. (Received Nov. 8.)</dateline>
                    <seg rendition="#float-left">No. 2351.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose a translation
                    of a communication received by me from the Tsung-li Yamên, relating to the
                    proposed American commission to investigate the Szechuan riots; also a copy of
                    my communication in reply thereto.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charles Denby</hi></signed>.</closer>



                <xi:include href="d136-a1.xml" xpointer="d136-a1"/>
