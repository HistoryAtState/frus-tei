    <text>
        <body>
            <div xml:id="d135">

                <pb facs="0194" n="134" sameAs="frus:frus1895p1/pg134"/>

                <head><hi rendition="#italic">Mr. Denby to Mr. Olney</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1895-09-16"><hi rendition="#italic">September 16,
                        1895</hi></date>. (Received Nov. 8.)</dateline>
                    <seg rendition="#float-left">No. 2350.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a copy
                    of a telegram received by me on the 14th instant from Mr. Hixson, United States
                    consul at Foochow, now engaged in investigating the murders at Kutien, and a
                    copy of a dispatch thereupon sent by me to the Tsung-li Yamên.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charles Denby</hi></signed>.</closer>




                <xi:include href="d135-a1.xml" xpointer="d135-a1"/>
