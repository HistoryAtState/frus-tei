    <text>
        <body>
            <div xml:id="d138">

                <pb facs="0197" n="137" sameAs="frus:frus1895p1/pg137"/>

                <head><hi rendition="#italic">Mr. Olney to Mr. Denby</hi>.</head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-09-18"><hi rendition="#italic">September 18,
                        1895</hi></date>.</dateline></opener>
                <p>Continue Szechuan efforts. Have all ready to go at once. Designate Cheshire
                    secretary, with rank of member, but no voice.</p>
                <closer><signed><hi rendition="#small-caps">Olney</hi></signed>.</closer>
            </div>
        </body>
    </text>
