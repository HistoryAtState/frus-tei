    <text>
        <body>
            <div xml:id="d163">

                <pb facs="0211" n="151" sameAs="frus:frus1895p1/pg151"/>

                <head><hi rendition="#italic">Mr. Denby to Mr. Olney</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1895-10-01"><hi rendition="#italic">October 1, 1895</hi></date>.
                        (Received Nov. 8.)</dateline>
                    <seg rendition="#float-left">No. 2377.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inform you that Mr.
                    Cheshire left Peking to-day to proceed to Chengtu with the American commission.
                    I inclose herewith a copy of my instructions to the commission. I suppose that
                    you will give such further instructions as may seem proper to you.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charles Denby</hi></signed>.</closer>



                <xi:include href="d163-a1.xml" xpointer="d163-a1"/>
