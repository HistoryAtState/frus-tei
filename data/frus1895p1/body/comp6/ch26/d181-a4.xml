                <pb facs="0227" n="167" sameAs="frus:frus1895p1/pg167"/>

                <opener><seg rendition="#center">[Inclosure 4 in No. 2407.—Telegram.]</seg></opener>
                <head><hi rendition="#italic">Mr. Denby to Mr. Hixson</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1895-10-22"><hi rendition="#italic">October 22,
                        1895</hi></date>.</dateline></opener>
                <p>Wired yesterday. Return to Foochow.</p>
                <closer><signed><hi rendition="#small-caps">Denby</hi></signed>.</closer>
            </div>
