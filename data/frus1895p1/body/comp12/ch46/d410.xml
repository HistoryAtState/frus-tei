        <body>
            <div xml:id="d410">

                <pb facs="0480" n="420" sameAs="frus:frus1895p1/pg420"/>

                <head><hi rendition="#italic">Mr. Eustis to Mr. Olney</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1895-07-19"><hi rendition="#italic">July 19, 1895</hi></date>.
                        (Received July 29.)</dateline>
                    <seg rendition="#float-left">No. 339.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Upon receipt of your dispatch No. 422, with
                    reference to the consular rights of Mr. Chapelié in Tunis, I addressed a note to
                    Mr. Hanotaux, a copy of which I inclose herewith.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">J. B. Eustis</hi></signed>.</closer>


                <xi:include href="d410-a1.xml" xpointer="d410-a1"/>
