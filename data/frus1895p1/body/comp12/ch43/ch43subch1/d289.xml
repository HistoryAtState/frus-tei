    <text>
        <body>
            <div xml:id="d289">

                <pb facs="0343" n="283" sameAs="frus:frus1895p1/pg283"/>

                <head><hi rendition="#italic">Mr. Olney to Mr.
                            Eustis</hi>.</head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-09-20"><hi rendition="#italic">September 20,
                        1895</hi></date>.</dateline></opener>
                <p>Your instructions cover supply of Mrs. Waller’s reasonable wants as well as
                    passage home. If she desires to see her husband, arrange for visit to prison and
                    access to him in conformity with usual regulations.</p>
                <closer><signed><hi rendition="#small-caps">Olney</hi></signed>.</closer>
            </div>
        </body>
    </text>
