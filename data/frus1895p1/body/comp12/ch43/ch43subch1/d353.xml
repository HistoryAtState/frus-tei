    <text>
        <body>
            <div xml:id="d353">

                <pb facs="0374" n="314" sameAs="frus:frus1895p1/pg314"/>

                <head><hi rendition="#italic">Mr. Eustis to Mr.
                            Olney</hi>.<anchor n="1" xml:id="d353-f1"
                    /></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1896-02-20"><hi rendition="#italic">February 20,
                        1896</hi></date>.</dateline></opener>
                <p>The President signed this morning Waller’s pardon. Orders are being issued for
                    his release.</p>
                <closer><signed><hi rendition="#small-caps">Eustis</hi></signed>.</closer>
            </div>
        </body>
    </text>
