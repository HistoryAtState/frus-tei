    <text>
        <body>
            <div xml:id="d283">

                <pb facs="0337" n="277" xml:id="pg277"/>

                <head><hi rendition="#italic">Mr. Eustis to Mr.
                            Adee</hi>.</head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1895-08-26"><hi rendition="#italic">August 26,
                        1895</hi></date>.</dateline></opener>
                <p>Second secretary and Alexander, legal adviser, returned from visit Waller.
                    Instructions in your cable 22d [21st] fully carried out by them. I will forward
                    deposition of Waller.</p>
                <closer><signed><hi rendition="#small-caps">Eustis</hi></signed>.</closer>
            </div>
        </body>
    </text>
