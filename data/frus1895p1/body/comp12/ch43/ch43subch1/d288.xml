    <text>
        <body>
            <div xml:id="d288">

                <pb facs="0343" n="283" sameAs="frus:frus1895p1/pg283"/>

                <head><hi rendition="#italic">Mr. Eustis to Mr.
                            Olney</hi>.</head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1895-09-20"><hi rendition="#italic">September 20,
                        1895</hi></date>.</dateline></opener>
                <p>Waller family arrived Marseilles without means. Consul directed to send them
                    here; according to instructions 488, I propose to pay their passage home and
                    provide for their wants.</p>
                <closer><signed><hi rendition="#small-caps">Eustis</hi></signed>.</closer>
            </div>
        </body>
    </text>
