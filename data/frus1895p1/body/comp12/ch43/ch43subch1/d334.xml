    <text>
        <body>
            <div xml:id="d334">

                <pb facs="0364" n="304" sameAs="frus:frus1895p1/pg304"/>

                <head><hi rendition="#italic">Mr. Eustis to Mr.
                            Olney</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1895-12-12"><hi rendition="#italic">December 12, 1895</hi></date>.
                        (Received December 23.)</dateline>
                    <seg rendition="#float-left">No. 422.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my No. 416, of December 6,
                    inclosing a copy of the original French text of Mr. Clunet’s opinion in re John
                    Waller, I now send herewith an English translation of the same.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">J. B. Eustis</hi></signed>.</closer>


                <xi:include href="d334-a1.xml" xpointer="d334-a1"/>
