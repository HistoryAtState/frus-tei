    <text>
        <body>
            <div xml:id="d265">

                <pb facs="0329" n="269" sameAs="frus:frus1895p1/pg269"/>

                <head><hi rendition="#italic">Mr. Uhl to Mr. Eustis</hi>.</head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-07-03"><hi rendition="#italic">July 3,
                        1895</hi></date>.</dateline></opener>
                <p>It is confidently expected that copy of evidence upon which Waller was convicted
                    will be furnished and you permitted to see him. Validity of his concession not
                    involved in this inquiry.</p>
                <closer><signed><hi rendition="#small-caps">Uhl</hi>, <hi rendition="#italic"
                            >Acting</hi></signed>.</closer>
            </div>
        </body>
    </text>
