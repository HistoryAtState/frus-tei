        <body>
            <div xml:id="d326">

                <pb facs="0359" n="299" sameAs="frus:frus1895p1/pg299"/>

                <head><hi rendition="#italic">Mr. Eustis to Mr.
                            Olney</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1895-12-03"><hi rendition="#italic">December 3, 1895</hi></date>.
                        (Received December 14.)</dateline>
                    <seg rendition="#float-left">No. 413.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I send herewith copy of a letter received
                    from Mr. Waller in reply to mine of November 18 last, asking whether pardon was
                    acceptable to him under terms offered by the French Government. Dated November
                    22, it was received yesterday, unsealed, through the foreign office.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">J. B. Eustis</hi></signed>.</closer>


                <xi:include href="d326-a1.xml" xpointer="d326-a1"/>
