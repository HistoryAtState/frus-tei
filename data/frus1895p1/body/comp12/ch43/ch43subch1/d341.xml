    <text>
        <body>
            <div xml:id="d341">

                <pb facs="0372" n="312" xml:id="pg312"/>

                <head><hi rendition="#italic">Mr. Eustis to Mr.
                            Olney</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1896-01-18"><hi rendition="#italic">January 18,
                        1896</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 445.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my No. 413, of December 3,
                    1895, sending you a copy of Mr. Waller’s letter of November 22, stating the
                    terms upon which he is willing to accept his release from the French Government,
                    I inclose herewith copy of another letter from the same, dated January 4, 1896,
                    received only this morning, in which he maintains his right to claim an
                    indemnity from the French Government for unlawful deportation and detention.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">J. B. Eustis</hi></signed>.</closer>


                <xi:include href="d341-a1.xml" xpointer="d341-a1"/>
