    <text>
        <body>
            <div xml:id="d360">

                <pb facs="0393" n="333" sameAs="frus:frus1895p1/pg333"/>

                <head><hi rendition="#italic">Mr. Uhl to Mr. Campbell</hi>.</head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><date calendar="gregorian"
                            when="1895-03-27"><hi rendition="#small-caps">March</hi> 27,
                        1895</date>.</dateline></opener>
                <p>Newspapers report Waller, formerly United States consul, imprisoned under
                    sentence by court-martial at Tamatave. Inquire. Telegraph facts briefly.</p>
                <closer><signed><hi rendition="#small-caps">Uhl</hi>, <hi rendition="#italic"
                            >Acting</hi></signed>.</closer>
            </div>
        </body>
    </text>
