    <text>
        <body>
            <div xml:id="d365">

                <pb facs="0394" n="334" sameAs="frus:frus1895p1/pg334"/>

                <head><hi rendition="#italic">Mr. Adee to Mr. Campbell</hi>.</head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-08-06"><hi rendition="#italic">August 6,
                        1895</hi></date>.</dateline></opener>
                <p>Draw on ambassador, Paris, reasonable expense sending Waller’s family to Paris.
                    Cable compliance.</p>
                <closer><signed><hi rendition="#small-caps">Adee</hi>, <hi rendition="#italic"
                            >Acting</hi></signed>.</closer>
            </div>
        </body>
    </text>
