    <text>
        <body>
            <div xml:id="d30">

                <pb facs="0097" n="37" sameAs="frus:frus1895p1/pg37"/>

                <head><hi rendition="#italic">Mr. Olney to Mr. Ewing</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1896-01-08"><hi rendition="#italic">January 8,
                        1896</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 189.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to inform you that your dispatch No.
                    165, of the 19th ultimo, relative to the prohibition of the importation of
                    American cattle into Belgium, has been received.</p>
                <p>The Department fully approves your note of the 19th ultimo to the Belgian foreign
                    office on the subject.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Richard Olney</hi></signed>.</closer>
            </div>
        </body>
    </text>
