    <text>
        <body>
            <div xml:id="d23">

                <pb facs="0088" n="28" sameAs="frus:frus1895p1/pg28"/>

                <head><hi rendition="#italic">Mr. Gresham to Mr.
                            Ewing</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-04-01"><hi rendition="#italic">April 1,
                        1895</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 111.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose for your information a copy of a
                    letter of the 27th ultimo from the Secretary of Agriculture, inclosing a copy of
                    a communication <pb facs="0089" n="29" xml:id="pg29"/> addressed by him to Mr.
                    Burnet Landreth, of Bristol, Pa., in regard to the sanitary condition of
                    American cattle.</p>
                <p>You may avail yourself of any opportune occasion which may occur to communicate a
                    copy of Mr. Morton’s letter to the Government of Belgium.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. Q. Gresham</hi></signed>.</closer>



                <xi:include href="d23-a1.xml" xpointer="d23-a1"/>
