    <text>
        <body>
            <div xml:id="d3">

                <pb facs="0064" n="4" sameAs="frus:frus1895p1/pg4"/>

                <head><hi rendition="#italic">Mr. Buchanan to Mr.
                            Gresham</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Buenos Ayres</hi></placeName>, <date calendar="gregorian"
                            when="1895-01-10"><hi rendition="#italic">January 10, 1895</hi></date>.
                        (Received Feb. 11.)</dateline>
                    <seg rendition="#float-left">No. 86.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I cabled you to-day as follows: <quote
                        rend="blockquote">
                        <p rendition="#flush"><hi rendition="#small-caps">Gresham</hi>, <hi
                                rendition="#italic">Washington:</hi></p>
                        <p>Tariff bill passed; advantages mentioned in my Nos. 63, 64, and 74
                            secured, except canned goods raised to 15 cents.</p></quote></p>
                <closer><signed><hi rendition="#small-caps">Buchanan</hi></signed>.</closer>
            </div>
        </body>
    </text>
