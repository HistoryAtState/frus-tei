    <text>
        <body>
            <div xml:id="d40">

                <pb facs="0108" n="48" sameAs="frus:frus1895p1/pg48"/>

                <head><hi rendition="#italic">Mr. Uhl to Mr.
                            Mendonça</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-03-19"><hi rendition="#italic">March 19,
                        1895</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 6.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of the 16th instant, announcing the reestablishment of diplomatic
                    relations between Brazil and Portugal, and offering the sincere thanks of your
                    Government to the President for the protection extended by the minister of the
                    United States at Lisbon to citizens of Brazil resident in Portugal.</p>
                <p>I have taken pleasure in communicating the contents of your note to the President
                    and beg to express his gratification at the announcement made.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Edwin F. Uhl</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary</hi></signed>.</closer>
            </div>
        </body>
    </text>
