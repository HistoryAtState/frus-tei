    <text>
        <body>
            <div xml:id="d52">

                <pb facs="0120" n="60" sameAs="frus:frus1895p1/pg60"/>

                <head><hi rendition="#italic">Mr. Thompson to Mr. Olney</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Petropolis</hi></placeName>, <date calendar="gregorian"
                            when="1895-11-19"><hi rendition="#italic">November 19, 1895</hi></date>.
                        (Received Dec. 20.)</dateline>
                    <seg rendition="#float-left">No. 441.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a copy
                    of the regulations promulgated by the minister of the fazenda for the execution
                    of the law recently passed by the National Congress in regard to foreign life
                    insurance companies.</p>
                <p>I also inclose an article from the Rio News upon the withdrawal of the New York
                    Life Insurance Company.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Thos. L.
                    Thompson</hi></signed>.</closer>



                <xi:include href="d52-a1.xml" xpointer="d52-a1"/>
