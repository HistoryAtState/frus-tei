        <body>
            <div xml:id="d51">

                <pb facs="0119" n="59" sameAs="frus:frus1895p1/pg59"/>

                <head><hi rendition="#italic">Mr. Thompson to Mr.
                            Olney</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Petropolis</hi></placeName>, <date calendar="gregorian"
                            when="1895-10-07"><hi rendition="#italic">October 7, 1895</hi></date>.
                        (Received Nov. 5.)</dateline>
                    <seg rendition="#float-left">No. 418.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith copy
                    and translation of decree No. 294, of September 5, 1895, providing regulations
                    for the operation of foreign life insurance companies in Brazil.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Thos. L.
                    Thompson</hi></signed>.</closer>


                <xi:include href="d51-a1.xml" xpointer="d51-a1"/>
