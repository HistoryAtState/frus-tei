    <text>
        <body>
            <div xml:id="d660">

                <pb facs="0774" n="714" sameAs="frus:frus1895p1/pg714"/>

                <head><hi rendition="#italic">Mr. Gresham to Sir
                            Julian Pauncefote</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-02-21"><hi rendition="#italic">February 21,
                        1895</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 35.]</seg></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I have the honor to transmit
                    herewith, for the information of the Government of the Dominion of Canada, a
                    copy of an act of Congress approved February 8, 1895, entitled “An act to
                    regulate navigation on the Great Lakes and their connecting and tributary
                    waters.”</p>
                <p>It is hoped by this Government that the Dominion of Canada may be disposed to
                    adopt like regulations for the government of Canadian vessels on the Great Lakes
                    and their connecting and tributary waters.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">W. Q. Gresham</hi>.</signed>
                </closer>


                <xi:include href="d660-a1.xml" xpointer="d660-a1"/>
