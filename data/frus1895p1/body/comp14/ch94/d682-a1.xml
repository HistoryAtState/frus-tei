    <text>
        <body>
            <div xml:id="d682-a1">

                <pb facs="0798" n="738" sameAs="frus:frus1895p1/pg738"/>

                <opener><seg rendition="#center">[Inclosure in No. 22.]</seg></opener>
                <head><hi rendition="#italic">Mr. Hamlin to Mr. Gresham</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Treasury Department,<lb/>Office of the Secretary</hi>,<lb/><hi
                                rendition="#italic">Washington, D. C.</hi></placeName>, <date
                            calendar="gregorian" when="1895-01-28"><hi rendition="#italic">January
                                28, 1895</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Further replying to your letter of the 4th
                    instant, transmitting copy of a dispatch from the American ambassador at London
                    relative to the fires on cotton ships, I have the honor to transmit for his
                    information copy of a letter from the president of the Savannah Cotton Exchange,
                    dated the 22d instant.</p>
                <p>Respectfully, yours,</p>
                <closer>
                    <signed><hi rendition="#small-caps">C. S. Hamlin</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
