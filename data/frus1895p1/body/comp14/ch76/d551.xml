    <text>
        <body>
            <div xml:id="d551">

                <pb facs="0652" n="592" sameAs="frus:frus1895p1/pg592"/>

                <head><hi rendition="#italic">Mr. Uhl to Sir
                            Julian Pauncefote</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-03-13"><hi rendition="#italic">March 13,
                        1895</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 51.]</seg></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I have the honor to acknowledge the
                    receipt of your note of the 6th instant, inclosing a copy of an order of Her
                    Majesty in council, dated the 2d ultimo, entitled “The Bering Sea award order in
                    council, 1895.”</p>
                <pb facs="0653" n="593" xml:id="pg593"/>
                <p>The Department has noted your observations in regard to the document, and will
                    give the subject due consideration.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">Edwin F. Uhl</hi>, <hi rendition="#italic"
                            >Acting Secretary.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
