    <text>
        <body>
            <div xml:id="d569">

                <pb facs="0690" n="630" sameAs="frus:frus1895p1/pg630"/>

                <head><hi rendition="#italic">Sir Julian Pauncefote
                        to Mr. Uhl</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >British Embassy</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-06-03"><hi rendition="#italic">June 3,
                        1895</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to the concluding paragraph
                    of Mr. Gresham’s note of April 29 last, and subsequent correspondence, I have
                    the honor to transmit herewith a list of British sealing vessels cleared from
                    Canadian ports for the Bering Sea since November last.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">Julian Pauncefote</hi>.</signed>
                </closer>



                <xi:include href="d569-a1.xml" xpointer="d569-a1"/>
