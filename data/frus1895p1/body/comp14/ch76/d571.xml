    <text>
        <body>
            <div xml:id="d571">

                <pb facs="0692" n="632" sameAs="frus:frus1895p1/pg632"/>

                <head><hi rendition="#italic">Mr. Uhl to Mr. Bayard</hi>.</head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-06-04"><hi rendition="#italic">June 4,
                        1895</hi></date>.</dateline></opener>
                <p>Treasury Department inquires touching nature of bill relative to seals announced
                    for introduction in Parliament by Sir Edward Gray. Please telegraph earliest
                    obtainable information.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Uhl</hi>, <hi rendition="#italic"
                            >Acting.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
