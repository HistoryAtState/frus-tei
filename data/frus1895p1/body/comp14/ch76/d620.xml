    <text>
        <body>
            <div xml:id="d620">

                <pb facs="0741" n="681" sameAs="frus:frus1895p1/pg681"/>

                <head><hi rendition="#italic">Mr. Bayard to Mr. Olney</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1895-11-26"><hi rendition="#italic">November 26, 1895</hi></date>
                        (Received Dec. 7.)</dateline>
                    <seg rendition="#float-left">No. 541.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: To-day I obtained copies of a royal order
                    in council, of November 21st instant, regulating the capture of seals in the
                    zones of Bering Sea contiguous to the Russian coasts and islands, together with
                    a definition of the mutual powers of Russian and British officers in relation to
                    such seal captures.</p>
                <p>I have now the honor to inclose herewith the copies above referred to.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">T. F. Bayard</hi>.</signed>
                </closer>


                <xi:include href="d620-a1.xml" xpointer="d620-a1"/>
            </div>
        </body>
    </text>
