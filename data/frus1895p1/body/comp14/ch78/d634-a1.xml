    <text>
        <body>
            <div xml:id="d634-a1">

                <pb facs="0754" n="694" sameAs="frus:frus1895p1/pg694"/>

                <opener><seg rendition="#center">[Inclosure in No. 319.]</seg></opener>
                <head><hi rendition="#italic">Mr. Foster to Mr. Olney</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >State of Louisiana, Executive Department</hi>,<lb/><hi
                                rendition="#italic">Baton Rouge, La.</hi></placeName>, <date
                            calendar="gregorian" when="1896-02-03"><hi rendition="#italic">February
                                3, 1896</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your letter of the 25th ultimo, and
                    inclosures, came while I was confined to my bed with la grippe, and was
                    therefore referred to the attorney-general for investigation.</p>
                <p>I herewith inclose his answer, which I adopt and make my own.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">Murphy J. Foster</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
