    <text>
        <body>
            <div xml:id="d634">

                <pb facs="0754" n="694" sameAs="frus:frus1895p1/pg694"/>

                <head><hi rendition="#italic">Mr. Olney to Sir
                            Julian Pauncefote</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1896-02-07"><hi rendition="#italic">February 7,
                        1896</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 319.]</seg></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: In the matter of the claim of Purser
                    Bain, I have the honor to inclose herewith copy of a letter just received from
                    the governor of Louisiana, with copy of the inclosure therein referred to, to
                    wit, a letter to me from the attorney-general of the State of Louisiana.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Richard Olney</hi></signed>.</closer>



                <xi:include href="d634-a1.xml" xpointer="d634-a1"/>
