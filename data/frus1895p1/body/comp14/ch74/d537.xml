    <text>
        <body>
            <div xml:id="d537">

                <pb facs="0639" n="579" sameAs="frus:frus1895p1/pg579"/>

                <head><hi rendition="#italic">Viscount Gough to Mr. Uhl</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >British Embassy</hi>,<lb/><hi rendition="#italic">Newport, R.
                                I.</hi></placeName>, <date calendar="gregorian" when="1895-06-11"
                                ><hi rendition="#italic">June 11,
                    1895</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of the 6th instant, informing me of the steps taken by the
                    Secretary of the Treasury to facilitate the passage of stores for twenty
                    Canadian mounted police.</p>
                <p>I beg that you will express to Mr. Secretary Carlisle my sense of the courtesy he
                    has shown in this matter.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">Hugh Gough</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
