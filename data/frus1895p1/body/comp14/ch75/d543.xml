    <text>
        <body>
            <div xml:id="d543">

                <pb facs="0643" n="583" xml:id="pg583"/>

                <head><hi rendition="#italic">Mr. Bayard to Mr. Olney</hi>.</head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1896-01-04"><hi rendition="#italic">January 4,
                        1896</hi></date>.</dateline></opener>
                <p>Will procure and send by next mail newspaper containing report of proceedings of
                    Boston Grammar School in August last.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Bayard</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
