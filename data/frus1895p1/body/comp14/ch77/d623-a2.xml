    <text>
        <body>
            <div xml:id="d623-a2">

                <pb facs="0745" n="685" sameAs="frus:frus1895p1/pg685"/>

                <opener><seg rendition="#center">[Inclosure 2 in No. 429.]</seg></opener>
                <head><hi rendition="#italic">Lord Kimberley to Mr. Bayard</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Foreign Office</hi></placeName>, <date calendar="gregorian"
                            when="1895-03-21"><hi rendition="#italic">March 21,
                        1895</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Your Excellency</hi>: I have the honor to acknowledge
                    the receipt of your excellency’s note of the 14th instant, in which you inquire
                    the date on which it is proposed to issue an order in council for the
                    enforcement of the revised regulations for preventing collisions at sea.</p>
                <p>I beg to state that your excellency’s note shall receive the early consideration
                    of Her Majesty’s Government.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">Kimberley</hi>.</signed>
                </closer>
            </div>
        </body>
