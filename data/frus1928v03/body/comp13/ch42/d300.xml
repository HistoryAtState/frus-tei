    <text>
        <body>
            <div xml:id="d300">

                <pb facs="0483" n="373" sameAs="frus:frus1928v03/pg373"/>

                <note rend="inline" type="source">881.00/1420</note>
                <head><hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic">Herrick</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1928-08-02"><hi rendition="#italic">August 2,
                        1928</hi></date>.<lb/>[Received August 13.]</dateline>
                    <seg rendition="#float-left">No. 8836</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to my despatch No. 8807 of
                    July 19, 1928<anchor n="24" xml:id="d300-f1"/> concerning the recently signed
                    Tangier Agreement, I have the honor to forward herewith in copy and translation
                    a note from the Foreign Office dated July 31, 1928, transmitting two copies of
                    the final protocol of the Tangier Conference. I am enclosing the one of these
                    copies which is certified,<anchor n="24" xml:id="d300-f2"/> retaining the other
                    for the files of the Embassy.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Myron T. Herrick</hi></signed></closer>


                <xi:include href="d300-a1.xml" xpointer="d300-a1"/>
            </div>
        </body>
    </text>
