                <pb facs="0481" n="371" sameAs="frus:frus1928v03/pg371"/>

                <note rend="inline" type="source">881.00/1382: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Ambassador in Spain</hi> (<hi rendition="#italic"
                            >Hammond</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1928-03-07T17:00:00-05:00"><hi rendition="#italic">March 7, 1928—5
                                p.m.</hi></date></dateline></opener>
                <p>24. Your 33, March 5, 11 a.m. Department perceives no objection to your
                    discussing Moroccan matters with Primo on the basis of its 21, February 29, 3
                    p.m.</p>
                <closer><signed><hi rendition="#small-caps">Kellogg</hi></signed></closer>
            </div>
        </body>
