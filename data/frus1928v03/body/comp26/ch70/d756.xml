                <pb facs="1002" n="892" sameAs="frus:frus1928v03/pg892"/>

                <note rend="inline" type="source">858.5123 P 34/8</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Minister in Sweden</hi> (<hi rendition="#italic"
                            >Harrison</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1928-11-10"><hi rendition="#italic">November 10,
                        1928</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 82</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: The Department refers to the Legation’s
                    despatch No. 370 of September 8, 1928, in further relation to the subject of
                    taxation of American citizens residing in Sweden and encloses for your
                    information a copy of a letter of October 26, 1928, received from the Treasury
                    Department which is believed to be self-explanatory.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State:<lb/><signed><hi rendition="#small-caps">Nelson
                            Trusler Johnson</hi></signed></closer>



                <xi:include href="d756-a1.xml" xpointer="d756-a1"/>
            </div>
        </body>
