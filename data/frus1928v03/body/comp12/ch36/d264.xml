    <text>
        <body>
            <div xml:id="d264">

                <pb facs="0435" n="325" sameAs="frus:frus1928v03/pg325"/>

                <note rend="inline" type="source">811.71212/66: Telegram</note>
                <head><hi rendition="#italic">President Calles to
                        President Coolidge</hi><anchor n="45"
                        xml:id="d264-f1"/></head>
                <opener><seg rendition="#center">[Translation<anchor n="46" xml:id="d264-f2"
                        />]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1928-10-01T11:30:00-06:00"><hi rendition="#italic">October 1,
                                1928—11:30 a.m.</hi></date></dateline></opener>
                <p>I congratulate Your Excellency most cordially on the establishment of the air
                    mail service between our countries, which, being initiated today, now marks a
                    new spirit looking toward better relations between the peoples of Mexico and the
                    United States.</p>
                <closer><signed>P[<hi rendition="#small-caps">lutarco</hi>] <hi
                            rendition="#small-caps">Elias Calles</hi></signed></closer>
            </div>
        </body>
    </text>
