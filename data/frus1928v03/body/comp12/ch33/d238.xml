            <div xml:id="d238">

                <pb facs="0409" n="299" sameAs="frus:frus1928v03/pg299"/>

                <note rend="inline" type="source">812.6363/2536</note>
                <head><hi rendition="#italic">The Ambassador in Mexico</hi> (<hi rendition="#italic"
                        >Morrow</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1928-03-27"><hi rendition="#italic">March 27,
                        1928</hi></date>.<lb/>[Received April 3.]</dateline>
                    <seg rendition="#float-left">No. 471</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Confirming my telegram No. 90 of today’s
                    date, 5 P.M.,<anchor n="16" xml:id="d238-f1"/> reporting that I had addressed to
                    the Mexican Minister of Industry, Commerce and Labor a letter setting forth my
                    understanding of the purport of Article 152, amended, of the Regulations of the
                    Mexican Petroleum Law, promulgated by Executive Decree today,<anchor n="17"
                        xml:id="d238-f2"/> I have the honor to enclose for the Department’s
                    information a copy of that letter.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Dwight W. Morrow</hi></signed></closer>



                <xi:include href="d238-a1.xml" xpointer="d238-a1"/>
            </div>
        </body>
    </text>
