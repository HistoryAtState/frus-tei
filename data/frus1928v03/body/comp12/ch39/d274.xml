    <text>
        <body>
            <div xml:id="d274">

                <pb facs="0449" n="339" sameAs="frus:frus1928v03/pg339"/>

                <note rend="inline" type="source">411.12P/408: Telegram</note>
                <head><hi rendition="#italic">The Minister in the Netherlands</hi> (<hi rendition="#italic">Tobin</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >The Hague</hi></placeName>, <date calendar="gregorian"
                            when="1928-04-26T11:00:00+00:19"><hi rendition="#italic">April 26,
                                1928—11 a.m.</hi></date><lb/>[Received April 26—7:52
                        a.m.]</dateline></opener>
                <p>17. Department’s 13, April 23, 9 p.m. Foreign Minister<anchor n="58"
                        xml:id="d274-f1"/> has accepted.</p>
                <closer><signed><hi rendition="#small-caps">Tobin</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d274-f1" n="58" xml:id="d274-f1-content">
                <p>The Netherlands Minister for Foreign Affairs acts as President of the Permanent
                    Administrative Council. See art. XLIX of the convention of October 18, 1907,
                        <ref target="frus1907p2#pg_1191"><hi rendition="#italic">ibid.</hi>, 1907,
                        pt. 2, p. 1191</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
