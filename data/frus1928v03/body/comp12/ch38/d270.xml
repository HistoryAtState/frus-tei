                <pb facs="0446" n="336" sameAs="frus:frus1928v03/pg336"/>

                <note rend="inline" type="source">812.00 Colima/9: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Chargé in
                        Mexico</hi> (<hi rendition="#italic">Schoenfeld</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1928-06-12T16:00:00-04:00"><hi rendition="#italic">June 12, 1928—4
                                p.m.</hi></date></dateline></opener>
                <p>147. Reference telegram June 11, noon, from Consulate at Manzanillo, regarding
                    revolutionary disturbances. Department assumes you will make suitable
                    representations.</p>
                <closer><signed><hi rendition="#small-caps">Olds</hi></signed></closer>
            </div>
        </body>
