            <div xml:id="d256">

                <pb facs="0427" n="317" sameAs="frus:frus1928v03/pg317"/>

                <note rend="inline" type="source">611.125/107: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Mexico</hi> (<hi rendition="#italic">Morrow</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1928-03-08T12:00:00-06:00"><hi rendition="#italic">March 8,
                                1928—noon</hi></date>.<lb/>[Received 2:10 p.m.]</dateline></opener>
                <p>73. Department’s 65, March 7, 6 p.m.<anchor n="40" xml:id="d256-f1"/> Foreign
                    Office states March 16 will be entirely satisfactory for signing of convention.
                    Foreign Office will issue statement to this effect for publication in the
                    morning press of March 9.</p>
                <closer><signed><hi rendition="#small-caps">Morrow</hi></signed></closer>
            </div>
        </body>
    </text>
