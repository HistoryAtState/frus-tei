    <text>
        <body>
            <div xml:id="d694">

                <pb facs="0932" n="822" sameAs="frus:frus1928v03/pg822"/>

                <note rend="inline" type="source">111/309</note>
                <head><hi rendition="#italic">The Secretary of State to the Chairman of the
                        Republican National Committee</hi> (<hi rendition="#italic"
                    >Butler</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1928-02-23"><hi rendition="#italic">February 23,
                        1928</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My dear Senator Butler</hi>: In compliance with your
                    request for a statement covering the activities of the Department of State for
                    the past four years,<anchor n="1" xml:id="d694-f1"/> I take pleasure in sending
                    such a statement herewith, which I hope will meet your requirements.</p>
                <p>Very sincerely yours,</p>
                <closer><signed><hi rendition="#small-caps">Frank B. Kellogg</hi></signed></closer>



                <xi:include href="d694-a1.xml" xpointer="d694-a1"/>
                <xi:include href="d694-a2.xml" xpointer="d694-a2"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d694-f1" n="1" xml:id="d694-f1-content">
                <p>Butler’s letter containing the request, dated November 16, 1927. not printed.</p>
            </note>
        </listAnnotation>
    </standOff>
