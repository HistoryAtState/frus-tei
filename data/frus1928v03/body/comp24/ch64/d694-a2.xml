    <text>
        <body>
            <div xml:id="d694-a2">

                <pb facs="0935" n="825" sameAs="frus:frus1928v03/pg825"/>

                <opener><seg rendition="#center">[Subenclosure—Appendix A]</seg></opener>
                <head><hi rendition="#small-caps">Russian Imports</hi></head>
                <p rendition="#center">(In Rubles; 1 Ruble equals $.5146.)</p>
                <table cols="4" rend="width: 95%;" rendition="#center" rows="5">
                    <row>
                        <cell/>
                        <cell><hi rendition="#italic">From United States</hi></cell>
                        <cell><hi rendition="#italic">From Great Britain</hi></cell>
                        <cell><hi rendition="#italic">From Germany</hi></cell>
                    </row>
                    <row>
                        <cell>1909–13<anchor n="*" xml:id="d694-f1"/></cell>
                        <cell role="num">80,261,337</cell>
                        <cell role="num">150,448,418</cell>
                        <cell role="num">497,078,481</cell>
                    </row>
                    <row>
                        <cell>1924–25</cell>
                        <cell role="num">201,163,000</cell>
                        <cell role="num">110,698,000</cell>
                        <cell role="num">102,651,000</cell>
                    </row>
                    <row>
                        <cell>1925–26</cell>
                        <cell role="num">122,127,000</cell>
                        <cell role="num">129,536,000</cell>
                        <cell role="num">176,057,000</cell>
                    </row>
                    <row>
                        <cell>1926–27<anchor n="**" xml:id="d694-f2"/></cell>
                        <cell role="num">143,400,000</cell>
                        <cell role="num">97,100,000</cell>
                        <cell role="num">157,700,000</cell>
                    </row>
                </table>
                <p>The Soviet fiscal year begins October 1 and ends September 30.</p>
            </div>
