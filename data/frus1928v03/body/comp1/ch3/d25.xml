                <pb facs="0129" n="19" sameAs="frus:frus1928v03/pg19"/>

                <note rend="inline" type="source">711.682 (1928)/3: Telegram</note>
                <head><hi rendition="#italic">The Minister in Greece</hi> (<hi
                            rendition="#italic">Skinner</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Athens</hi></placeName>, <date calendar="gregorian"
                            when="1928-02-17T17:00:00+02:00"><hi rendition="#italic">February 17,
                                1928—5 p.m.</hi></date><lb/>[Received February 17—1:40
                        p.m.]</dateline></opener>
                <p>12. Department’s 12, February 7 [<hi rendition="#italic">8</hi>], 6 p.m. Greek
                    Government accepts suggestion that commercial treaty be negotiated here and
                    invites draft proposals.</p>
                <closer><signed><hi rendition="#small-caps">Skinner</hi></signed></closer>
            </div>
        </body>
