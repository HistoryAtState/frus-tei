                <pb facs="0535" n="425" sameAs="frus:frus1928v03/pg425"/>

                <note rend="inline" type="source">817.00/5299</note>
                <head><hi rendition="#italic">The Assistant Secretary of State</hi> (<hi rendition="#italic">White</hi>), <hi
                        rendition="#italic">Then in Habana, to the Secretary of
                            State</hi></head>
                <opener><dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Habana</hi></placeName>,] <date calendar="gregorian"
                            when="1928-01-17"><hi rendition="#italic">January 17,
                        1928</hi></date>.<lb/>[Received January 23.]</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith a
                    memorandum of my conversation with Dr. Cuadra Pasos on January 15 and a copy of
                    the Secretary’s conversation with him on January 17 [<hi rendition="#italic"
                        >16</hi>].</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Francis White</hi></signed></closer>




