    <text>
        <body>
            <div xml:id="d456">

                <pb facs="0633" n="523" sameAs="frus:frus1928v03/pg523"/>

                <note rend="inline" type="source">817.51/1886: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Nicaragua</hi> (<hi rendition="#italic"
                        >Munro</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Managua</hi></placeName>, <date calendar="gregorian"
                            when="1928-01-13T11:00:00-05:45"><hi rendition="#italic">January 13,
                                1928—11 a.m.</hi></date><lb/>[Received 2:15
                    p.m.]</dateline></opener>
                <p>24. A financial plan which differs in material respects from that prepared by the
                        bankers<anchor n="61" xml:id="d456-f1"/> is being prepared by Dr.
                    Cumberland. The Department may desire to transmit this information to the
                    bankers in order to avoid a duplication of effort.</p>
                <closer><signed><hi rendition="#small-caps">Munro</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d456-f1" n="61" xml:id="d456-f1-content">
                <p>J. &amp; W. Seligman &amp; Co. and Guaranty Trust Company of New York.</p>
            </note>
        </listAnnotation>
