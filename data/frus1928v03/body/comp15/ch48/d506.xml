    <text>
        <body>
            <div xml:id="d506">

                <pb facs="0679" n="569" xml:id="pg569"/>

                <note rend="inline" type="source">817.00/5590</note>
                <head><hi rendition="#italic">The Secretary of the Navy</hi> (<hi rendition="#italic">Wilbur</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1928-03-16"><hi rendition="#italic">March 16,
                        1928</hi></date>.</dateline>
                    <seg rendition="#float-left">P9–2/EF49 (280227)</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to forward herewith copy
                    of a letter from Commander Special Service Squadron of February 27, 1928, on
                    affairs in Nicaragua.<anchor n="96" xml:id="d506-f1"/> Your attention is
                    particularly invited to the enclosure with this letter which purports to be a
                    reply written by Sandino to the letter of the Squadron Commander mentioned in
                    previous correspondence.<anchor n="97" xml:id="d506-f2"/></p>
                <p>Respectfully,</p>
                <closer><signed><hi rendition="#small-caps">Curtis D. Wilbur</hi></signed></closer>


                <xi:include href="d506-a1.xml" xpointer="d506-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d506-f1" n="96" xml:id="d506-f1-content">
                <p>Not printed; its enclosure is printed <hi rendition="#italic">infra.</hi></p>
            </note>
            <note corresp="#d506-f2" n="97" xml:id="d506-f2-content">
                <p>See undated letter from the Commander of the U. S. Special Service Squadron to
                    General Sandino, <ref target="#pg562">p. 562</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
