    <text>
        <body>
            <div xml:id="d666-a1">

                <pb facs="0891" n="781" xml:id="pg781"/>

                <opener><seg rendition="#center">[Enclosure 1]</seg></opener>
                <head><hi rendition="#italic">The American Chargé</hi> (<hi
                            rendition="#italic">Andrews</hi>) <hi rendition="#italic">to
                        the Portuguese Minister for Foreign Affairs</hi> (<hi
                            rendition="#italic">Rodrigues</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Lisbon</hi></placeName>, <date calendar="gregorian"
                            when="1928-05-02"><hi rendition="#italic">May 2,
                        1928</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Mr. Minister</hi>: I trust that it may not escape
                    your observation that in my Note No. 726, of today, enclosed herewith, no
                    reference has been made to subsidies payable direct to shipowners.</p>
                <p>I am. [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Wm. Whiting
                    Andrews</hi></signed></closer>
            </div>
        </body>
    </text>
