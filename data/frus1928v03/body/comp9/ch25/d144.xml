        <body>
            <div xml:id="d144">

                <pb facs="0292" n="182" xml:id="pg182"/>

                <note rend="inline" type="source">711.60p2/19: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Minister in Latvia</hi> (<hi
                            rendition="#italic">Coleman</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1927-02-24T17:00:00-05:00"><hi rendition="#italic">February 24,
                                1927—5 p.m.</hi></date></dateline></opener>
                <p>7. Your 16, February 21, 4 p.m. Department has no objection to including in
                    Article 16 the last paragraph of Article 7 of draft and the first eleven lines
                    of last paragraph of Article 7 of United States-German Treaty.</p>
                <p>Please submit proposed text to Department before final agreement.</p>
                <closer><signed><hi rendition="#small-caps">Grew</hi></signed></closer>
            </div>
        </body>
    </text>
