                <pb facs="1044" n="934" sameAs="frus:frus1928v03/pg934"/>

                <note rend="inline" type="source">711.542/24</note>
                <head><hi rendition="#italic">The Minister in Switzerland</hi> (<hi rendition="#italic">Wilson</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Berne</hi></placeName>, <date calendar="gregorian"
                            when="1928-09-10"><hi rendition="#italic">September 10,
                        1928</hi></date>.<lb/>[Received October 1.]</dateline>
                    <seg rendition="#float-left">No. 582</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my despatch No. 415, of April
                    24, 1928, and other correspondence relating to the Swiss draft of a treaty of
                    friendship, commerce, and consular rights between the United States and
                    Switzerland, I have the honor to transmit herewith copy and translation of a
                    letter dated August 22, 1928, addressed to me by Mr. Dinichert, Chief of the
                    Division of Foreign Affairs in the Federal Political Department, in which he
                    informs me, in a purely personal manner, of certain modifications which the
                    Swiss Government would be prepared to make to its draft treaty if judged
                    advisable by the American Government.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Hugh R. Wilson</hi></signed></closer>



                <xi:include href="d766-a1.xml" xpointer="d766-a1"/>
