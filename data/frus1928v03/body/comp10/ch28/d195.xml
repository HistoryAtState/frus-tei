    <text>
        <body>
            <div xml:id="d195">

                <pb facs="0358" n="248" sameAs="frus:frus1928v03/pg248"/>

                <note rend="inline" type="source">882.51A/7: Telegram</note>
                <head><hi rendition="#italic">The Secretary to the President</hi> (<hi rendition="#italic">Sanders</hi>) <hi
                        rendition="#italic">to the Secretary of
                        State</hi><anchor n="22" xml:id="d195-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Superior, Wis.</hi></placeName>, <date calendar="gregorian"
                            when="1928-07-16"><hi rendition="#italic">July 16,
                        1928</hi></date>.<lb/>[Received July 16.]</dateline></opener>
                <p>The President approves designation of Mr. John Loomis, of Strasburg, Virginia, as
                    Financial Adviser to the Republic of Liberia as recommended in your letter of
                    July 13.</p>
                <closer><signed><hi rendition="#small-caps">Everett Sanders</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d195-f1" n="22" type="source" xml:id="d195-f1-content">
                <p>This telegram was confirmed by letter of the same date (file No. 882.51A/8).</p>
            </note>
        </listAnnotation>
    </standOff>
