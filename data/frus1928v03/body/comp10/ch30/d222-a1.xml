                <pb facs="0384" n="274" sameAs="frus:frus1928v03/pg274"/>

                <opener><seg rendition="#center">[Enclosure 1]</seg></opener>
                <head><hi rendition="#italic">President King of Liberia to the American
                        Minister</hi> (<hi rendition="#italic">Francis</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Monrovia</hi></placeName>, <date calendar="gregorian"
                            when="1928-08-16"><hi rendition="#italic">August 16,
                        1928</hi></date>.</dateline>
                    <seg rendition="#float-left">691/241</seg></opener>
                <p><hi rendition="#small-caps">Dear Minister Francis</hi>: In keeping with my
                    promise at our last interview, I have the honour to transmit [to] you herewith
                    copies of correspondence and cablegrams exchanged between the Liberian
                    Government and the Firestone Plantations Company, relative to granting the
                    latter a public Utility License for operating a Radio Station between the United
                    States and Liberia.</p>
                <p>With due regards [etc.]</p>
                <closer><signed>C. D. B. <hi rendition="#small-caps">King</hi></signed></closer>
            </div>
        </body>
    </text>
