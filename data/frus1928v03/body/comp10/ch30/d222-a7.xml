    <text>
        <body>
            <div xml:id="d222-a7">

                <pb facs="0388" n="278" sameAs="frus:frus1928v03/pg278"/>

                <opener><seg rendition="#center">[Enclosure 5—Telegram 1]</seg></opener>
                <head><hi rendition="#italic">President King of Liberia to the Radio Corporation of
                        America</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Monrovia</hi></placeName>, <date calendar="gregorian"
                            when="1928-08-20"><hi rendition="#italic">August 20,
                        1928</hi></date>.</dateline></opener>
                <p>Received your radio August 20th. Thanks for message. Appreciate amicable
                    understanding with the Federal Radio Commission which insures Transatlantic
                    radio communication between Liberia and the United States.</p>
                <closer><signed><hi rendition="#small-caps">King</hi></signed></closer>
            </div>
        </body>
    </text>
