                <pb facs="1062" n="952" xml:id="pg952"/>

                <note rend="inline" type="source">611.6731/105: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Turkey</hi> (<hi rendition="#italic"
                        >Grew</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1928-05-14T11:00:00+02:00"><hi rendition="#italic">May 14, 1928—11
                                a.m.</hi></date><lb/>[Received 1:30 p.m.]</dateline></opener>
                <p>71. Department’s 47, May 10, 2 p.m. Foreign Office approves suggested
                    substitution. Notes will be exchanged in Angora, May 19th.</p>
                <closer><signed><hi rendition="#small-caps">Grew</hi></signed></closer>
            </div>
        </body>
    </text>
