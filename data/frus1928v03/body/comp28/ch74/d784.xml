                <pb facs="1060" n="950" sameAs="frus:frus1928v03/pg950"/>

                <note rend="inline" type="source">611.6731/102: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Turkey</hi> (<hi rendition="#italic">Grew</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1928-04-28T11:00:00+02:00"><hi rendition="#italic">April
                                28</hi>[<hi rendition="#italic">29?</hi>], <hi rendition="#italic"
                                >1928—11 a.m.</hi></date><lb/>[Received April 29—4:55
                        p.m.]</dateline></opener>
                <p>63. Am orally informed by Foreign Office that Council of Ministers has approved
                    prolongation of commercial <hi rendition="#italic">modus vivendi</hi> with the
                    United States until April 10, 1929, according to existing provisions of law.</p>
                <closer><signed><hi rendition="#small-caps">Grew</hi></signed></closer>
            </div>
        </body>
