                <pb facs="1090" n="980" sameAs="frus:frus1928v03/pg980"/>

                <note rend="inline" type="source">367.1164 Brusa School Trial/50: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Turkey</hi> (<hi rendition="#italic"
                        >Grew</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1928-08-30T17:00:00+02:00"><hi rendition="#italic">August 30,
                                1928—5 p.m.</hi></date><lb/>[Received August 31—1:20
                        a.m.]</dateline></opener>
                <p>104. Press today announces that on account of questions of procedure Court of
                    Appeals has annulled judgment against American teachers of Brusa School and that
                    case will be heard again.</p>
                <closer><signed><hi rendition="#small-caps">Grew</hi></signed></closer>
            </div>
        </body>
    </text>
