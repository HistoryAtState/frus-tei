            <div xml:id="d325">

                <pb facs="0512" n="402" sameAs="frus:frus1928v03/pg402"/>

                <note rend="inline" type="source">856d.6363/544: Telegram</note>
                <head><hi rendition="#italic">The Minister in the Netherlands</hi> (<hi rendition="#italic">Tobin</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >The Hague</hi></placeName>, <date calendar="gregorian"
                            when="1928-07-17T16:00:00+01:19"><hi rendition="#italic">July 17, 1928—4
                                p.m.</hi></date><lb/>[Received July 17—12:55
                    p.m.]</dateline></opener>
                <p>35. My 34, July 7, 3 p.m.<anchor n="21" xml:id="d325-f1"/> Minister for the
                    Colonies has today signed and delivered Koloniale [Petroleum Company]
                    contracts.</p>
                <closer><signed><hi rendition="#small-caps">Tobin</hi></signed></closer>
            </div>
        </body>
    </text>
