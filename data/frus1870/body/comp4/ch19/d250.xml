    <text>
        <body>
            <div xml:id="d250">

                <pb facs="0442" n="408" xml:id="pg408"/>

                <note rend="inline" type="source">No. 251.</note>
                <head>Mr. Thornton to Mr.
                        Fish.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1870-04-14"><hi rendition="#italic"
                                >April</hi> 14, 1870.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> With reference to your note of the 1st
                    instant, I have the honor to inclose copy of a dispatch which I have received
                    from the Governor General of Canada, forwarding a memorandum from Sir John A.
                    Macdonald, together with a copy of the fishery act of May 22, 1868.</p>
                <closer>
                    <signed>EDWARD THORNTON.</signed></closer>


                <xi:include href="d250-a1.xml" xpointer="d250-a1"/>
