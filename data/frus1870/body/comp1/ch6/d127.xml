                <pb facs="0211" n="177" sameAs="frus:frus1870/pg177"/>

                <note rend="inline" type="source">No. 127.</note>
                <head>Mr. Motley to Mr.
                        Fish.</head>
                <opener>
                    <seg rendition="#float-left">No. 489.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United
                                States,</hi><hi rendition="#italic"> London</hi></placeName>, <date
                            calendar="gregorian" when="1870-10-15"><hi rendition="#italic"
                                >October</hi> 15, 1870</date>. (Received October
                    29.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Referring to my No. 482, I have the honor
                    to send herewith the reply of Count Bernstorff to the letter of Lord Granville,
                    extracted from the Times of the 10th instant.</p>
                <closer>
                    <signed>JOHN LOTHROP MOTLEY.</signed></closer>


                <xi:include href="d127-a1.xml" xpointer="d127-a1"/>
