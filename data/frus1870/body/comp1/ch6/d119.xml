                <pb facs="0184" n="150" sameAs="frus:frus1870/pg150"/>

                <note rend="inline" type="source">No. 119.</note>
                <head>Mr. Motley to Mr. Fish.</head>
                <opener>
                    <seg rendition="#float-left">No. 394.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United
                                States,</hi><hi rendition="#italic"> London</hi></placeName>, <date
                            calendar="gregorian" when="1870-07-21"><hi rendition="#italic">July</hi>
                            21, 1870</date>. (Received August 3.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to send herewith two
                    copies of a proclamation of her Majesty the Queen, commanding British subjects
                    to observe strict neutrality in the war now existing between the Emperor of the
                    French and the King of Prussia.</p>
                <closer>
                    <signed>JOHN LOTHROP MOTLEY.</signed></closer>



                <xi:include href="d119-a1.xml" xpointer="d119-a1"/>
