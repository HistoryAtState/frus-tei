                <pb facs="0217" n="183" sameAs="frus:frus1870/pg183"/>

                <note rend="inline" type="source">No. 129.</note>
                <head>Mr. Motley to Mr.
                        Fish.</head>
                <opener>
                    <seg rendition="#float-left">No. 502.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United
                                States,</hi><hi rendition="#italic"> London</hi></placeName>, <date
                            calendar="gregorian" when="1870-11-01"><hi rendition="#italic"
                                >November</hi> 1, 1870</date>. (Received November
                    15.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Referring to my Nos. 482 and 489, I have
                    now the honor to send herewith a copy taken from yesterday’s Times, of a letter
                    addressed by Lord Granville, on the 21st ultimo, to Count Bernstorff, in reply
                    to his note of the 8th ultimo.</p>
                <closer>
                    <signed>JOHN LOTHROP MOTLEY.</signed></closer>


                <xi:include href="d129-a1.xml" xpointer="d129-a1"/>
