    <text>
        <body>
            <div xml:id="d10">

                <pb facs="0087" n="53" xml:id="pg53"/>

                <note rend="inline" type="source">No. 10.</note>
                <head>Mr. Jones to Mr. Fish.</head>
                <opener>
                    <seg rendition="#float-left">No. 74.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United
                                States,</hi><hi rendition="#italic"> Brussels</hi></placeName>,
                            <date calendar="gregorian" when="1870-11-14"><hi rendition="#italic"
                                >November</hi> 14, 1870.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith
                    circulars of Count Bismarck and M. Jules Favre, on the subject of the
                    negotiations with M. Thiers for an armistice.</p>
                <p rendition="#center">* * * * * * * *</p>
                <p>I have the honor to be, very respectfully, your obedient servant,</p>
                <closer>
                    <signed>J. R. JONES.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">Hamilton Fish,</hi>
                        <hi rendition="#italic">Secretary of State.</hi></p>
                </postscript>



                <xi:include href="d10-a1.xml" xpointer="d10-a1"/>
