                <pb facs="0090" n="56" sameAs="frus:frus1870/pg56"/>

                <note rend="inline" type="source">No. 11.</note>
                <head>Mr. Jones to Mr.
                        Fish.</head>
                <opener>
                    <seg rendition="#float-left">No. 76.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United
                                States,</hi><hi rendition="#italic"> Brussels</hi></placeName>,
                            <date calendar="gregorian" when="1870-11-15"><hi rendition="#italic"
                                >November</hi> 15, 1870</date>. (Received December
                    1.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to inclose herewith a
                    circular of Count Bismarck, of the 10th October, in regard to the demand of the
                    members of the diplomatic corps remaining in Paris for permission to continue
                    their correspondence with their governments, which, I believe, has not been made
                    public until now.</p>
                <closer>
                    <signed>J. R. JONES.</signed></closer>


                <xi:include href="d11-a1.xml" xpointer="d11-a1"/>
