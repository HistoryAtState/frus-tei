        <body>
            <div xml:id="d173">

                <pb facs="0252" n="218" sameAs="frus:frus1870/pg218"/>

                <note rend="inline" type="source">No. 173.</note>
                <head>Mr. Davis to Baron
                        Gerolt.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi><hi
                                rendition="#italic"> Washington</hi></placeName>, <date
                            calendar="gregorian" when="1870-07-25"><hi rendition="#italic">July</hi>
                            25, 1870.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Dear Baron:</hi> For your information and use, I
                    inclose a copy of a cable dispatch from Mr. Washburne of this date, stating the
                    position of France as to the declaration of Paris.</p>
                <p>Very truly yours,</p>
                <closer>
                    <signed>J. C. B. DAVIS.</signed></closer>


                <xi:include href="d173-a1.xml" xpointer="d173-a1"/>
