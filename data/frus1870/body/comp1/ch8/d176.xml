            <div xml:id="d176">

                <pb facs="0255" n="221" sameAs="frus:frus1870/pg221"/>

                <note rend="inline" type="source">No. 176.</note>
                <head>Baron Gerolt to Mr. Fish.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the North German
                                Union,</hi>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1870-08-26"><hi rendition="#italic"
                                >August</hi> 26, 1870</date>. (Received August
                    26.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to present to you the
                    inclosed copy of a telegram just received from the secretary of state at Berlin,
                    referring to a <pb facs="0256" n="222" xml:id="pg222"/> former telegram, a copy
                    of which is also inclosed, and which has been published in the American
                    newspapers.</p>
                <p>I have the honor to be, with the highest consideration, your obedient
                    servant,</p>
                <closer>
                    <signed>FR. v. GEROLT.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">Hamilton Fish,</hi>
                        <hi rendition="#italic">Secretary of State of the United States</hi>, <hi
                            rendition="#italic">Washington</hi>, <hi rendition="#italic">D.
                        C.</hi></p>
                </postscript>



                <xi:include href="d176-a1.xml" xpointer="d176-a1"/>
