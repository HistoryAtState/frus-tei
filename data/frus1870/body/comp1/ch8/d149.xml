                <pb facs="0230" n="196" sameAs="frus:frus1870/pg196"/>

                <note rend="inline" type="source">No. 149.</note>
                <head>Mr. Fish to Mr.
                        Bancroft.</head>
                <opener>
                    <seg rendition="#float-left">No. 269.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi><hi
                                rendition="#italic"> Washington</hi></placeName>, <date
                            calendar="gregorian" when="1870-11-22"><hi rendition="#italic"
                                >November</hi> 22, 1870.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir: I</hi> inclose, for your information, a copy of
                    a note of yesterday to Baron Gerolt, respecting the question of intercourse
                    between diplomatic representatives at Paris and their governments.</p>
                <closer>
                    <signed>HAMILTON FISH.</signed></closer>


                <xi:include href="d149-a1.xml" xpointer="d149-a1"/>
