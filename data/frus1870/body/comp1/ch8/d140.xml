            <div xml:id="d140">

                <pb facs="0226" n="192" sameAs="frus:frus1870/pg192"/>

                <note rend="inline" type="source">No. 140.</note>
                <head>Mr. Davis to Mr.
                        Bancroft.</head>
                <opener>
                    <seg rendition="#float-left">No. <hi rendition="#small-caps">226.]</hi></seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi><hi
                                rendition="#italic"> Washington</hi></placeName>, <date
                            calendar="gregorian" when="1870-08-25"><hi rendition="#italic"
                                >August</hi> 25, 1870.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I inclose herewith, for your information, a
                    copy of a dispatch of the 11th instant, No. 251, and of its accompaniments, from
                    Mr. Washburne, relative to a certificate of protection desired by German
                    residents in France.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>J. C. B. DAVIS.</signed></closer>
                <postscript>
                    <p>[For this inclosure see, <hi rendition="#italic">ante</hi>, “France,” Mr.
                        Washburne’s dispatch No. 251, dated August 11, 1870.]</p>
                </postscript>
            </div>
        </body>
