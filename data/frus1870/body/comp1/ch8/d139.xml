    <text>
        <body>
            <div xml:id="d139">

                <pb facs="0226" n="192" xml:id="pg192"/>

                <note rend="inline" type="source">No. 139.</note>
                <head>Mr. Davis to Mr. Bancroft</head>
                <opener>
                    <seg rendition="#float-left">No. 225.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi><hi
                                rendition="#italic"> Washington</hi></placeName>, <date
                            calendar="gregorian" when="1870-08-23"><hi rendition="#italic"
                                >August</hi> 23, 1870.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I inclose herewith, for your information, a
                    copy of a dispatch, No. 253, of the 12th instant, from Mr. Washburne, relative
                    to the measures taken by him for the protection of North Germans in France.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>J. C. B. DAVIS.</signed></closer>
                <postscript>
                    <p>[For this inclosure see, <hi rendition="#italic">ante,</hi> “France,” Mr.
                        Washburne’s dispatch No. 253, dated August 12, 1870.]</p>
                </postscript>
            </div>
        </body>
