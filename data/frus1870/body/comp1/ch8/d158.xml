                <pb facs="0239" n="205" sameAs="frus:frus1870/pg205"/>

                <note rend="inline" type="source">No. 158.</note>
                <opener><seg rendition="#center">[By cable.—Received 11.52 a. m., September
                        3.]</seg></opener>
                <head>Mr. Bancroft to Mr. Davis.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <date calendar="gregorian" when="1870-09-03"><hi rendition="#small-caps"
                                >September</hi> 3, 1870.</date></dateline></opener>
                <p><hi rendition="#small-caps">Davis,</hi>
                    <hi rendition="#italic">Secretary</hi>, <hi rendition="#italic">Washington, D.
                        C.:</hi></p>
                <p>MacMahon’s army capitulated. Emperor Napoleon surrendered to King William without
                    prejudice to Paris regency.</p>
                <closer>
                    <signed>BANCROFT, <hi rendition="#italic">Berlin.</hi></signed></closer>
            </div>
        </body>
