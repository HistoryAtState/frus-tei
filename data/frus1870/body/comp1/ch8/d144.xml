            <div xml:id="d144">

                <pb facs="0227" n="193" sameAs="frus:frus1870/pg193"/>

                <note rend="inline" type="source">No. 144.</note>
                <head>Mr. Fish to Mr. Bancroft</head>
                <opener>
                    <seg rendition="#float-left">No. 242.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi><hi
                                rendition="#italic"> Washington</hi></placeName>, <date
                            calendar="gregorian" when="1870-09-22"><hi rendition="#italic"
                                >September</hi> 22, 1870.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose, for your information, a
                    translation of a communication of the 16th instant, from M. Berthemy, in
                    refutation of the accusations made by the government of North Germany that the
                    French army had disregarded the rules of international law in the present
                    war.</p>
                <closer>
                    <signed>HAMILTON FISH.</signed></closer>
                <postscript>
                    <p>[For this inclosure see Mr. Berthemy’s note to Mr. Fish, dated September 16,
                            <hi rendition="#italic">ante,</hi> “France.”]</p>
                </postscript>
            </div>
        </body>
