                <pb facs="0178" n="144" sameAs="frus:frus1870/pg144"/>

                <note rend="inline" type="source">No. 108.</note>
                <head>Mr. Read to Mr.
                        Davis.</head>
                <opener><seg rendition="#center">[By cable.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris,</hi></placeName>
                        <date calendar="gregorian" when="1870-08-17"><hi rendition="#italic"
                                >August</hi> 17, 1870</date>. (Received at 3.35 p. m., August
                        17.)</dateline></opener>
                <p><hi rendition="#small-caps">Davis,</hi>
                    <hi rendition="#italic">Acting Secretary of State</hi>, <hi rendition="#italic"
                        >Washington:</hi></p>
                <p>No gold to be had; only silver.</p>
                <closer>
                    <signed>READ, <hi rendition="#italic">Paris</hi>.</signed></closer>
            </div>
        </body>
