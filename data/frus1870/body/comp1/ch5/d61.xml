            <div xml:id="d61">

                <pb facs="0127" n="93" sameAs="frus:frus1870/pg93"/>

                <note rend="inline" type="source">No. 61.</note>
                <head>Mr. E. B. Washburne to Mr. Fish.</head>
                <opener>
                    <seg rendition="#float-left">No. 254.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United
                                States,</hi><hi rendition="#italic"> Paris</hi></placeName>, <date
                            calendar="gregorian" when="1870-08-12"><hi rendition="#italic"
                                >August</hi> 12, 1870</date>. (Received August 23,
                    1870.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> In the tremendous rush upon me, I have only
                    time to send you the accompanying printed list of the new ministry. I was in
                    hopes to have been able to give you some account of them, but it is impossible
                    to do so to-day.</p>
                <closer>
                    <signed>E. B. WASHBURNE.</signed></closer>


                <xi:include href="d61-a1.xml" xpointer="d61-a1"/>
