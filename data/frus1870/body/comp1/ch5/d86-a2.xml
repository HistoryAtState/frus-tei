    <text>
        <body>
            <div xml:id="d86-a2">

                <pb facs="0155" n="121" sameAs="frus:frus1870/pg121"/>

                <head>Mr. E. B. Washburne to Messrs, Hecht, Held and Kayser.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Paris,</hi></placeName>
                        <date calendar="gregorian" when="1870-08-31"><hi rendition="#italic"
                                >August</hi> 31, 1870.</date></dateline></opener>
                <p><hi rendition="#small-caps">Gentlemen:</hi> I have this morning received your
                    letter of the 29th instant.</p>
                <p>I shall immediately telegraph you that the order of General Trochu does not
                    include naturalized citizens of the United States of German birth. <hi
                        rendition="#italic">Such persons are citizens of the United States, and all
                        proper protection will be extended to them, under all circumstances and at
                        all hazards.</hi></p>
                <p>I have the honor to be, very respectfully, your obedient servant,</p>
                <closer>
                    <signed>E. B. WASHBURNE.</signed></closer>
                <postscript>
                    <p>Messrs. <hi rendition="#small-caps">Hecht, Held</hi> and <hi
                            rendition="#small-caps">Kayser,</hi>
                        <hi rendition="#italic">Dieppe, France.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
