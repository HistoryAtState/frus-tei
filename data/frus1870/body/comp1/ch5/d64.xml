                <note rend="inline" type="source">No. 64.</note>
                <head>Mr. Washburne to Mr.
                        Fish.</head>
                <opener>
                    <seg rendition="#float-left">No. 261.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United
                                States,</hi><hi rendition="#italic"> Paris</hi></placeName>, <date
                            calendar="gregorian" when="1870-08-19"><hi rendition="#italic"
                                >August</hi> 19, 1870.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I am to-day in receipt of a communication
                    from the minister of foreign affairs, inclosing two official copies of the
                    notification of the blockade of the North German coast by the French fleet. I am
                    requested by the Prince de la Tour d’Auvergne to transmit this notification to
                    my Government, in order that it may communicate the information to American
                    citizens.</p>
                <closer>
                    <signed>E. B. WASHBURNE.</signed></closer>


                <xi:include href="d64-a1.xml" xpointer="d64-a1"/>
