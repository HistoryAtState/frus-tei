            <div xml:id="d87">

                <pb facs="0156" n="122" xml:id="pg122"/>

                <note rend="inline" type="source">No. 87.</note>
                <head>Mr. E. B. Washburne to Mr. Fish.</head>
                <opener>
                    <seg rendition="#float-left">No. 296.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United
                                States,</hi><hi rendition="#italic"> Paris</hi></placeName>, <date
                            calendar="gregorian" when="1870-10-26"><hi rendition="#italic"
                                >September</hi> 26, 1870</date>. (Received October
                    19.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to inclose you herewith
                    the proceedings of a meeting of the diplomatic corps, as drawn up by my private
                    secretary, and which fully explain themselves.</p>
                <closer>
                    <signed>E. B. WASHBURNE.</signed></closer>


                <xi:include href="d87-a1.xml" xpointer="d87-a1"/>
