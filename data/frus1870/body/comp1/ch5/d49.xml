                <pb facs="0112" n="78" xml:id="pg78"/>

                <note rend="inline" type="source">No. 49.</note>
                <opener><seg rendition="#center">[Telegram.—Received July 25, 1870, at 9.30
                        a.m.]</seg></opener>
                <head>Mr. E. B. Washburne to Mr. Fish.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Paris,</hi></placeName>
                        <date calendar="gregorian" when="1870-07-24"><hi rendition="#italic"
                                >July</hi> 24, 1870.</date></dateline></opener>
                <p><hi rendition="#small-caps">Fish,</hi>
                    <hi rendition="#italic">Washington:</hi></p>
                <p>French government assents to our protecting North Germans and Saxons. Hesse
                    Grand-Ducale and Saxe-Coburg-Gotha also ask protection.</p>
                <closer>
                    <signed>WASHBURNE.</signed></closer>
            </div>
        </body>
