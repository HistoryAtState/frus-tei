            <div xml:id="d69">

                <pb facs="0142" n="108" sameAs="frus:frus1870/pg108"/>

                <note rend="inline" type="source">No. 69.</note>
                <head>Mr. E. B. Washburne to Mr. Fish.</head>
                <opener>
                    <seg rendition="#float-left">No. 272.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United
                                States,</hi><hi rendition="#italic"> Paris</hi></placeName>, <date
                            calendar="gregorian" when="1870-08-31"><hi rendition="#italic"
                                >August</hi> 31, 1870</date>. (Received September
                    15.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Referring to my dispatch No. 261, of August
                    17, I have the honor to inclose you an extract from the official journals,
                    fixing the date of the commencement of the blockade of the North German coast at
                    the 19th instead of the 15th of August.</p>
                <closer>
                    <signed>E B. WASHBURNE.</signed></closer>



                <xi:include href="d69-a1.xml" xpointer="d69-a1"/>
