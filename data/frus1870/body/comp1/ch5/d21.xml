                <pb facs="0099" n="65" sameAs="frus:frus1870/pg65"/>

                <note rend="inline" type="source">No. 21.</note>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <head>Mr. Davis to Mr. E. B.
                        Washburne.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi><hi
                                rendition="#italic"> Washington</hi></placeName>, <date
                            calendar="gregorian" when="1870-07-25"><hi rendition="#italic">July</hi>
                            25, 1870.</date></dateline></opener>
                <p>Take subjects of Saxony, Hesse, and Coburg under protection, France consenting. *
                    * * * * * *</p>
                <closer>
                    <signed>DAVIS, <hi rendition="#italic">Acting Secretary.</hi></signed></closer>
            </div>
        </body>
