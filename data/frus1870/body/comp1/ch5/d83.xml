                <pb facs="0154" n="120" sameAs="frus:frus1870/pg120"/>

                <note rend="inline" type="source">No. 83.</note>
                <head>Mr. E. B. Washburne to Mr. Fish.</head>
                <opener>
                    <seg rendition="#float-left">No. 287.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United
                                States,</hi><hi rendition="#italic"> Paris</hi></placeName>, <date
                            calendar="gregorian" when="1870-09-13"><hi rendition="#italic"
                                >September</hi> 13, 1870</date>. (Received September
                    29.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Contrary to the first notice, the
                    government of the national defense has determined to remain in Paris, the
                    minister of justice, M. Crémieux, only going away, and he goes to Tours. I
                    intend, therefore, to remain at my post here, at least until circumstances shall
                    make it my duty to go away.</p>
                <p rendition="#center">* * * * * * *</p>
                <closer>
                    <signed>E. B. WASHBURNE.</signed></closer>
            </div>
