                <note rend="inline" type="source">No. 107.</note>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <head>Mr. Davis to Mr.
                        Read.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1870-08-16"><hi rendition="#italic"
                                >August</hi> 16, 1870.</date></dateline></opener>
                <p>R<hi rendition="#small-caps">ead,</hi>
                    <hi rendition="#italic">Consul General, Paris:</hi></p>
                <p>Secretary Treasury says: Take gold till further ordered.</p>
                <closer>
                    <signed>DAVIS.</signed></closer>
            </div>
