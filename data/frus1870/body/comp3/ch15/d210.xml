            <div xml:id="d210">

                <pb facs="0324" n="290" sameAs="frus:frus1870/pg290"/>

                <note rend="inline" type="source">No. 210.</note>
                <head>Mr. Thomas H. Nelson to Mr. Fish.</head>
                <opener>
                    <seg rendition="#float-left">No. 308.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1870-10-28"><hi rendition="#italic"
                                >October</hi> 28, 1870</date>. (Received November
                    14.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to transmit herewith a
                    copy of the very interesting and valuable response of our acting consul at Aguas
                    Calientes to the circular of the Department of State of the 18th of August, in
                    regard to the commercial relations between the United States and Mexico.</p>
                <closer>
                    <signed>THOMAS H. NELSON.</signed></closer>


                <xi:include href="d210-a1.xml" xpointer="d210-a1"/>
