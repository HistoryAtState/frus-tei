    <text>
        <body>
            <div xml:id="d209-a1">

                <pb facs="0323" n="289" sameAs="frus:frus1870/pg289"/>

                <head>Statement of freights per steamers and via Panama from Guayaquil to New
                    York:</head>
                <table cols="2">
                    <row role="label">
                        <cell>Bark, per pound, American gold</cell>
                        <cell rendition="#nowrap" role="num">$0 03</cell>
                    </row>
                    <row>
                        <cell>Cocoa, per pound, American gold</cell>
                        <cell rendition="#nowrap" role="num">1¾ </cell>
                    </row>
                    <row>
                        <cell>Cochineal, per pound, American gold</cell>
                        <cell rendition="#nowrap" role="num">3½</cell>
                    </row>
                    <row>
                        <cell>Copper and tin in bars, per pound, American gold</cell>
                        <cell rendition="#nowrap" role="num">1⅜</cell>
                    </row>
                    <row>
                        <cell>Cotton, raw, per cubic foot, American gold</cell>
                        <cell rendition="#nowrap" role="num">56</cell>
                    </row>
                    <row>
                        <cell>Hats, Panama, per cubic foot, American gold</cell>
                        <cell rendition="#nowrap" role="num">2 00</cell>
                    </row>
                    <row>
                        <cell>India-rubber, pressed, per pound, American gold</cell>
                        <cell rendition="#nowrap" role="num">2¼</cell>
                    </row>
                    <row>
                        <cell>Merchandise not specified, per cubic foot, American gold</cell>
                        <cell rendition="#nowrap" role="num">1 50</cell>
                    </row>
                    <pb facs="0324" n="290" xml:id="pg290"/>
                    <row>
                        <cell>Nitrate of soda, per pound, American gold</cell>
                        <cell rendition="#nowrap" role="num">$0 01½</cell>
                    </row>
                    <row>
                        <cell>Orchilla weed, pressed, per pound, American gold</cell>
                        <cell role="num">2½</cell>
                    </row>
                    <row>
                        <cell>Skins, goat and deer, per pound, American gold</cell>
                        <cell rendition="#nowrap" role="num">2¾ </cell>
                    </row>
                    <row>
                        <cell>Sugar, per pound, American gold</cell>
                        <cell rendition="#nowrap" role="num">1½</cell>
                    </row>
                    <row>
                        <cell>Tobacco, per pound, American gold</cell>
                        <cell rendition="#nowrap" role="num">3</cell>
                    </row>
                    <row>
                        <cell>Whale oil, per gallon, American gold</cell>
                        <cell rendition="#nowrap" role="num">14</cell>
                    </row>
                    <row>
                        <cell>Whalebone, per pound, American gold</cell>
                        <cell rendition="#nowrap" role="num">2¼</cell>
                    </row>
                    <row>
                        <cell>Wool, alpaca, per pound, American gold</cell>
                        <cell rendition="#nowrap" role="num">2¾</cell>
                    </row>
                    <row>
                        <cell>Wool, all other classes, per pound, American gold</cell>
                        <cell rendition="#nowrap" role="num">2⅜</cell>
                    </row>
                    <row>
                        <cell>Specie, gold, American gold</cell>
                        <cell rendition="#nowrap" role="num">1¾ pc.</cell>
                    </row>
                    <row>
                        <cell>Specie, silver, American gold</cell>
                        <cell rendition="#nowrap" role="num">1⅞ pc.</cell>
                    </row>
                    <row>
                        <cell>Silver mineral in bags, per pound, American gold</cell>
                        <cell rendition="#nowrap" role="num">1½</cell>
                    </row>
                </table>
                <closer>
                    <dateline rendition="#float-left">
                        <placeName>United States Consulate, Guayaquil</placeName>, <date
                            calendar="gregorian" when="1870-09-30">September 30,
                        1870.</date></dateline>
                    <lb/>
                    <signed>GEO. P. BRAGDON, <hi rendition="#italic">United States Vice
                        Consul.</hi></signed></closer>
            </div>
        </body>
