                <pb facs="0284" n="250" sameAs="frus:frus1870/pg250"/>

                <head>III. <hi rendition="#italic">Memorandum of the populations of the four groups
                        of countries referred to in this paper</hi>.</head>
                <p rendition="#center"><hi rendition="#small-caps">Group 1.—Sterling.</hi></p>
                <table cols="2">
                    <row role="label">
                        <cell>United Kingdom</cell>
                        <cell role="num">30,157,473</cell>
                    </row>
                    <row>
                        <cell>Dependencies, including India</cell>
                        <cell role="num">159,269,858</cell>
                    </row>
                    <row>
                        <cell>Treaty provinces of China</cell>
                        <cell role="num">270,000,000</cell>
                    </row>
                    <row>
                        <cell>Japan</cell>
                        <cell rendition="#border-bottom" role="num">35,000,000</cell>
                    </row>
                    <row>
                        <cell>Total</cell>
                        <cell rendition="#border-bottom" role="num">494,427,331</cell>
                    </row>
                </table>
                <pb facs="0285" n="251" xml:id="pg251"/>
