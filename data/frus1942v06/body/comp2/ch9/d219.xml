    <text>
        <body>
            <div xml:id="d219">

                <pb facs="0203" n="189" sameAs="frus:frus1942v06/pg189"/>

                <note rend="inline" type="source">811.20 Defense (M) Colombia/108: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in Colombia</hi> (<hi
                            rendition="#italic">Keith</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Bogotá</hi></placeName>, <date
                            calendar="gregorian" when="1942-07-02T21:00:00-05:00">July 2, 1942—9
                            p.m.</date>
                        <lb/> [Received July 3—1:29 a.m.]</dateline>
                </opener>
                <p>907. Embassy’s telegram No. 888, July 1, noon.<anchor n="70" xml:id="d219-f1"/>
                    Rubber agreement signed July 1 by Caja and Pocklington and approved by Minister
                    of National Economy and Ambassador Lane. Copy being taken to Washington by the
                        Ambassador.<anchor n="71" xml:id="d219-f2"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Keith</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
