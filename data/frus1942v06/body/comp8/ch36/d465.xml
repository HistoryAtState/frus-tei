    <text>
        <body>
            <div xml:id="d465">

                <pb facs="0464" n="450" sameAs="frus:frus1942v06/pg450"/>

                <note rend="inline" type="source">814.24/372</note>
                <head>
                    <hi rendition="#italic">The American Minister in Guatemala</hi> (<hi rendition="#italic">Des Portes</hi>) <hi
                        rendition="#italic">to the Guatemalan Minister for Foreign Affairs</hi>
                        (<hi rendition="#italic">Salazar</hi>)<anchor
                        n="26" xml:id="d465-f1"/>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 338</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Guatemala</hi></placeName>, <date
                            calendar="gregorian" when="1942-11-16">November 16,
                        1942</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: I have the honor to inform Your
                    Excellency that I have received a communication from the Department of State in
                        <pb facs="0465" n="451" xml:id="pg451"/> Washington, D.C., informing me that
                    the full powers authorizing me to sign the Lend-Lease Agreement and the
                    accompanying Note and Memorandum of Agreement have been signed by the President
                    of the United States of America and are being transmitted to me by air mail.</p>
                <p>Pending the receipt of the full powers, which will of course be delivered
                    promptly to Your Excellency, it is requested that this communication be accepted
                    in lieu thereof for the purpose of the signature on this date of the Lend-Lease
                    Agreement and accompanying documents.</p>
                <p>Please accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Fay Allen Des Portes</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d465-f1" n="26" type="source" xml:id="d465-f1-content">
                <p>Copy transmitted to the Department by the Minister in Guatemala in his despatch
                    No. 3378, November 17; received November 20.</p>
            </note>
        </listAnnotation>
    </standOff>
