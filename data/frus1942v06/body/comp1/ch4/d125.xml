    <text>
        <body>
            <div xml:id="d125">

                <pb facs="0120" n="106" sameAs="frus:frus1942v06/pg106"/>

                <note rend="inline" type="source">811.20 Defense (M) Chile/208: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Chile</hi> (<hi rendition="#italic"
                            >Bowers</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1942-07-21T19:00:00-04:00">July 21, 1942—7
                            p.m.</date>
                    </dateline>
                </opener>
                <p>822. Your 1141, July 11, 4 p.m.<anchor n="53" xml:id="d125-f1"/> Vessels have
                    been withdrawn from Chilean iron ore trade and are being utilized for urgent
                    needs of war effort.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d125-f1" n="53" xml:id="d125-f1-content">
                <p>Not printed; it indicated that representatives of the Bethlehem Chile Iron mines
                    said their mines were closing because of the loss of vessels.</p>
            </note>
        </listAnnotation>
    </standOff>
