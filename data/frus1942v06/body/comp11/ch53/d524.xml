            </note>
            <note corresp="#d524-f2" n="68" xml:id="d524-f2-content">
                <p>William G. MacLean of the Division of the American Republics.</p>
            </note>
            <note corresp="#d524-f3" n="69" xml:id="d524-f3-content">
                <p>Maj. John O. Walker, Assistant Administrator of the Farm Security Administration,
                    Department of Agriculture.</p>
            </note>
        </listAnnotation>
