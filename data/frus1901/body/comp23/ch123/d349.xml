    <text>
        <body>
            <div xml:id="d349">

                <pb facs="0496" n="416" sameAs="frus:frus1901/pg416"/>

                <head><hi rendition="#italic">Mr. Hill to Mr.
                            Newel.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1901-01-07"><hi rendition="#italic">January 7,
                        1901</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 263.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    dispatch No. 353,<anchor n="a" xml:id="d349-f1"/> of the 15th ultimo, relative
                    to the marriage of the Queen of The Netherlands.</p>
                <p>You will make all necessary congratulations and participate in such manner as may
                    be expected of the diplomatic corps.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">David J. Hill</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
