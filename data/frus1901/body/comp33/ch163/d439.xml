    <text>
        <body>
            <div xml:id="d439">

                <pb facs="0574" n="494" sameAs="frus:frus1901/pg494"/>

                <head><hi rendition="#italic">Mr. Grip to Mr.
                            Hay.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of Sweden and Norway</hi>,<lb/><hi rendition="#italic">Bar
                                Harbor, Me.</hi></placeName>, <date calendar="gregorian"
                            when="1901-09-14"><hi rendition="#italic">September 14,
                        1901</hi></date>.</dateline></opener>
                <p>I am directed by my Government to convey to the Government of the United States
                    the expressions of deep sympathy of the King and the United Kingdoms of Sweden
                    and Norway.</p>
                <closer><signed><hi rendition="#small-caps">A. Grip.</hi></signed></closer>
            </div>
        </body>
    </text>
