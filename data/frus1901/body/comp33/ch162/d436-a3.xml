    <text>
        <body>
            <div xml:id="d436-a3">

                <pb facs="0570" n="490" sameAs="frus:frus1901/pg490"/>

                <opener><seg rendition="#center">[Subinclosure.—Translation.]</seg></opener>
                <p>I hereby certify that Johannes Peterson Hoiland notified me of his intention to
                    emigrate to America (without being able to state the year) and that he
                    thereafter emigrated.</p>
                <closer><signed><hi rendition="#small-caps">Soren Westlye</hi>,<lb/><hi
                            rendition="#italic">Formerly District Commissioner.</hi></signed>
                    <lb/>
                    <dateline rendition="#float-left"><placeName><hi rendition="#small-caps"
                                >Westlye</hi></placeName>, <date calendar="gregorian"
                            when="1901-06-22"><hi rendition="#italic">June 22,
                        1901</hi></date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
