    <text>
        <body>
            <div xml:id="d46">

                <pb facs="0113" n="33" sameAs="frus:frus1901/pg33"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Lenderink.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1901-03-28"><hi rendition="#italic">March 28,
                        1901</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 183.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose copy of a portion of the report
                    made by the commanding officer of the U. S. S. <hi rendition="#italic"
                        >Philadelphia</hi>, relative to the courtesies and aid extended to him by
                    the Chilean authorities in removing the remains of Lieut. Selim E. Woodworth,
                    United States Navy, from the cemetery at Valparaiso.</p>
                <p>You will advise the Chilean foreign office that this Government sincerely
                    appreciates the courtesies extended.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>



                <xi:include href="d46-a1.xml" xpointer="d46-a1"/>
