    <text>
        <body>
            <div xml:id="d372">

                <pb facs="0509" n="429" sameAs="frus:frus1901/pg429"/>

                <head><hi rendition="#italic">Mr. Dudley to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Lima</hi></placeName>, <date calendar="gregorian" when="1901-07-31"
                                ><hi rendition="#italic">July 31, 1901.</hi></date></dateline>
                    <seg rendition="#float-left">No. 496.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>:</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I inclose herewith copy and translation of the note from the Peruvian foreign
                    office transmitting check for 8,000 soles in settlement of the claim (James H.
                    Hayball), and a copy of the legation’s acknowledgment of its receipt.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Irving B. Dudley.</hi></signed></closer>




