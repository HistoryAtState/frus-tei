    <text>
        <body>
            <div xml:id="d368">

                <pb facs="0507" n="427" sameAs="frus:frus1901/pg427"/>

                <head><hi rendition="#italic">Mr. Bayard to Mr.
                            Buck.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic">Washington,
                                D. C.</hi></placeName>, <date calendar="gregorian" when="1886-06-05"
                                ><hi rendition="#italic">June 5, 1886</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 68.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose with a reference to your No.
                        99<anchor n="a" xml:id="d368-f1"/> a copy of “Report No. 210” in the matter
                    of the J. H. Hayball claim <hi rendition="#italic">v</hi>. Peru, prepared by the
                    Solicitor of the Department.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. F. Bayard.</hi></signed></closer>


                <xi:include href="d368-a1.xml" xpointer="d368-a1"/>
            </div>
        </body>
    </text>
