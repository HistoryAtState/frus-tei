                <pb facs="0521" n="441" sameAs="frus:frus1901/pg441"/>

                <head><hi rendition="#italic">Mr. Hay to Mr. Stourdza.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>, <hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1901-09-16"><hi rendition="#italic">September 16,
                        1901</hi></date>.</dateline></opener>
                <p>Pray accept on behalf of the American Government and people grateful thanks for
                    Roumanian sympathy in their deep affliction.</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
