    <text>
        <body>
            <div xml:id="d474">

                <pb facs="0606" n="526" sameAs="frus:frus1901/pg526"/>

                <head><hi rendition="#italic">Mr. Leishman to Mr.
                            Cole</hi>.</head>
                <opener><seg rendition="#center">[Telegram sent in
                    Turkish.—Translation.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1901-07-04"><hi rendition="#italic">July 4,
                        1901</hi>.</date></dateline></opener>
                <p>Did you receive my telegram of Monday last? Please answer promptly.</p>
                <closer><signed><hi rendition="#small-caps">Leishman.</hi></signed></closer>


                <xi:include href="d474-a1.xml" xpointer="d474-a1"/>
