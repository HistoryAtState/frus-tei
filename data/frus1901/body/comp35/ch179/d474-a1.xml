    <text>
        <body>
            <div xml:id="d474-a1">

                <pb facs="0606" n="526" sameAs="frus:frus1901/pg526"/>

                <opener><seg rendition="#center">[Inclosure 3.—Telegram.]</seg></opener>
                <head><hi rendition="#italic">Mr. Cole to Mr.
                            Leishman.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Bitlis</hi></placeName>, <date calendar="gregorian"
                            when="1901-07-06"><hi rendition="#italic">July 6,
                        1901</hi></date>.</dateline></opener>
                <p>Received your telegram. Vali’s representative says instructions arrived that no
                    hindrance to my traveling. See letter.</p>
                <closer><signed><hi rendition="#small-caps">Cole</hi>.</signed></closer>
            </div>
        </body>
    </text>
