    <text>
        <body>
            <div xml:id="d365">

                <pb facs="0505" n="425" sameAs="frus:frus1901/pg425"/>

                <head><hi rendition="#italic">President Roosevelt
                        to the Shah of Persia.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Executive Mansion</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1901-09-23"><hi rendition="#italic">September 23,
                        1901</hi></date>.</dateline></opener>
                <p>I reciprocate your friendly greeting with cordial wishes for your welfare and the
                    prosperity of Persia.</p>
                <closer><signed><hi rendition="#small-caps">Theodore
                    Roosevelt.</hi></signed></closer>
            </div>
        </body>
    </text>
