                <head><hi rendition="#italic">Mr. Hay to Mr. White.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1901-12-21"><hi rendition="#italic">December 21,
                        1901</hi></date>.</dateline></opener>
                <p>Accept proposed settlement and hand amount over to Lillywhite against full
                    receipt.</p>
                <closer><signed><hi rendition="#small-caps">Hay</hi>.</signed></closer>
            </div>
