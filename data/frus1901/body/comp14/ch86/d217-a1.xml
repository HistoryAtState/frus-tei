    <text>
        <body>
            <div xml:id="d217-a1">

                <pb facs="0298" n="218" sameAs="frus:frus1901/pg218"/>

                <opener><seg rendition="#center">[Inclosure 1.]</seg></opener>
                <head><hi rendition="#italic">Mr. White to Mr. Crane.</hi></head>
                <opener><dateline rendition="#float-right"><placeName>6 <hi rendition="#small-caps"
                                >Whitehall Gardens, S. W.</hi>,<lb/><hi rendition="#italic"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1901-10-27"><hi rendition="#italic">October 27,
                        1901</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Crane</hi>: I have heard from Mr. Hay, and
                    you are hereby authorized to accept the offer of £6,000, which you told me on
                    Saturday has been made by His Majesty’s Government, in full settlement of all
                    our South African deportation claims to this date.</p>
                <p>Yours, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Henry White.</hi></signed></closer>
            </div>
        </body>
