    <text>
        <body>
            <div xml:id="d214">

                <pb facs="0296" n="216" sameAs="frus:frus1901/pg216"/>

                <head><hi rendition="#italic">Mr. Choate to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >London</hi></placeName>, <date calendar="gregorian" when="1901-04-12"
                                ><hi rendition="#italic">April 12, 1901</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 542.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a copy
                    of a notice which appeared in the London Gazette of the 9th instant, announcing
                    the appointment of a commission for investigating the claims to compensation
                    which have been or may be made by persons the subjects of friendly powers in
                    consequence of their deportation to Europe by the British military authorities
                    in South Africa.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Joseph H. Choate.</hi></signed></closer>


                <xi:include href="d214-a1.xml" xpointer="d214-a1"/>
            </div>
