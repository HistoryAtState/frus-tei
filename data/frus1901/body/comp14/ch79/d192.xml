    <text>
        <body>
            <div xml:id="d192">

                <pb facs="0286" n="206" sameAs="frus:frus1901/pg206"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Choate</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1901-07-09"><hi rendition="#italic">July 9,
                        1901</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 668.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    No. 599 of the 21st ultimo, inclosing copy of a note from the foreign office
                    suggesting that the Government of the Kongo Free State be notified that His
                    Britannic Majesty’s consul at Boma has been authorized to take charge of
                    American interests there.</p>
                <p>You will inform the foreign office that this has been done.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
    </text>
