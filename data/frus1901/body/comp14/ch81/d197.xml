    <text>
        <body>
            <div xml:id="d197">

                <pb facs="0289" n="209" sameAs="frus:frus1901/pg209"/>

                <head><hi rendition="#italic">Mr. Hay to Mr. Choate.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1901-01-22"><hi rendition="#italic">January 22,
                        1901</hi></date>.</dateline></opener>
                <p>You will express to Lord Lansdowne the profound sorrow of the Government and
                    people of the United States at the death of the Queen and the deep sympathy we
                    feel with the people of the British Empire in their great affliction.</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
    </text>
