    <text>
        <body>
            <div xml:id="d201">

                <pb facs="0291" n="211" sameAs="frus:frus1901/pg211"/>

                <head><hi rendition="#italic">Mr. Hay to Mr. Choate.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1901-01-29"><hi rendition="#italic">January 29,
                        1901</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 536.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit herewith an engrossed copy of
                    the resolution relating to the death of Queen Victoria, passed by the Senate on
                    January 22, 1901, which, in accordance with its terms, you are to deliver to
                    Lord Salisbury. I also inclose an open copy of the resolution.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>


                <xi:include href="d201-a1.xml" xpointer="d201-a1"/>
            </div>
