    <text>
        <body>
            <div xml:id="d382">

                <pb facs="0517" n="437" sameAs="frus:frus1901/pg437"/>

                <head><hi rendition="#italic">Mr. Thieriot to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Lisbon</hi></placeName>, <date calendar="gregorian"
                            when="1900-12-24"><hi rendition="#italic">December 24,
                        1900</hi>.</date></dateline>
                    <seg rendition="#float-left">No. 58.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my No. 55, of November 26,
                    with reference to the sale of Ayer’s medicines, I have the honor to state that I
                    have just received a letter from the J. C. Ayer Company on the above subject, of
                    which the inclosed is a copy. I await Department’s instructions how to proceed
                    further in this matter.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">J. H. Thieriot.</hi></signed></closer>


                <xi:include href="d382-a1.xml" xpointer="d382-a1"/>
