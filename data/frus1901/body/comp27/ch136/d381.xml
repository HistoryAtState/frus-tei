    <text>
        <body>
            <div xml:id="d381">

                <pb facs="0516" n="436" sameAs="frus:frus1901/pg436"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Thieriot.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1900-12-21"><hi rendition="#italic">December 21,
                        1900</hi>.</date></dateline>
                    <seg rendition="#float-left">No. 30.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to the Department’s instruction
                    of yesterday’s date, I inclose copy of a later letter from the J. C. Ayer
                    Company relative to the “exclusion of their medicines from Portugal.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>



                <xi:include href="d381-a1.xml" xpointer="d381-a1"/>
