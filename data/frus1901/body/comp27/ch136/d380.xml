    <text>
        <body>
            <div xml:id="d380">

                <pb facs="0516" n="436" xml:id="pg436"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Thieriot.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1900-12-20"><hi rendition="#italic">December 20,
                        1900</hi>.</date></dateline>
                    <seg rendition="#float-left">No. 29.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to your No. 55, of the 26th
                    ultimo, I inclose copy of a letter from the J. C. Ayer Company, of Lowell,
                    Mass., urging that one more effort may be made to obtain authorization for the
                    sale of certain of their medicines.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>


                <xi:include href="d380-a1.xml" xpointer="d380-a1"/>
