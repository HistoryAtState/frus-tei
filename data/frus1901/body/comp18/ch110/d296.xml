    <text>
        <body>
            <div xml:id="d296">

                <pb facs="0392" n="312" sameAs="frus:frus1901/pg312"/>

                <head><hi rendition="#italic">Mr. Hay to Cardinal
                            Rampolla.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1901-09-19"><hi rendition="#italic">September 19,
                        1901</hi></date>.</dateline></opener>
                <p>I have the honor to request you to convey to His Holiness the deep appreciation
                    here felt for his expression of sympathy with the sorrowing people of this
                    country.</p>
                <closer><signed><hi rendition="#small-caps">John Hay</hi>, <hi rendition="#italic"
                            >Secretary of State.</hi></signed></closer>
            </div>
        </body>
    </text>
