    <text>
        <body>
            <div xml:id="d266">

                <pb facs="0368" n="288" sameAs="frus:frus1901/pg288"/>

                <head><hi rendition="#italic">Mr. Hill to Signor
                            Carignani.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1901-07-25"><hi rendition="#italic">July 25,
                        1901</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 691.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to the Department’s note of the
                    20th instant, I have the honor to inclose for your information copy of a letter
                    from the governor of Mississippi showing the action taken by the State
                    authorities for the purpose of discovering the persons engaged in the killing at
                    Erwin of two persons of Italian origin and the wounding of a third.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">David J. Hill</hi>, <hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>


                <xi:include href="d266-a1.xml" xpointer="d266-a1"/>
