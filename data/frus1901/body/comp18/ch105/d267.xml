    <text>
        <body>
            <div xml:id="d267">

                <pb facs="0369" n="289" sameAs="frus:frus1901/pg289"/>

                <head><hi rendition="#italic">Mr. Hill to Signor Carignani.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1901-07-27"><hi rendition="#italic">July 27,
                        1901</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 693.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of the 24th instant transmitting statements received by the Italian
                    consul at Erwin, Miss.</p>
                <p>A copy of your note has been forwarded to the governor of Mississippi for the
                    information of the State authorities.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">David J. Hill</hi>, <hi
                            rendition="#italic">Acting Secretary</hi>.</signed></closer>
            </div>
        </body>
    </text>
