    <text>
        <body>
            <div xml:id="d283">

                <pb facs="0380" n="300" sameAs="frus:frus1901/pg300"/>

                <head><hi rendition="#italic">Mr. Meyer to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Rome</hi></placeName>, <date calendar="gregorian" when="1901-12-11"><hi
                                rendition="#italic">December 11, 1901</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 121.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: * * * I have the honor to send you herewith
                    three copies of the treaty between Italy and Sultan Osman Mahmud of
                    Somaliland.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">G. V. L. Meyer.</hi></signed></closer>


                <xi:include href="d283-a1.xml" xpointer="d283-a1"/>
