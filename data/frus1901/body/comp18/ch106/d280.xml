    <text>
        <body>
            <div xml:id="d280">

                <pb facs="0379" n="299" sameAs="frus:frus1901/pg299"/>

                <head><hi rendition="#italic">Mr. Adee to Mr. Iddings.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1901-07-31"><hi rendition="#italic">July 31,
                        1901</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 32.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: * * * I inclose copy of a letter<anchor
                        n="a" xml:id="d280-f1"/> from the attorneys of the United States Lloyds, who
                    are anxious to ascertain exactly what the relations between Italy and the Sultan
                    Osman Mahmud are.</p>
                <p>You will investigate the matter and report.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alvey A. Adee</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
