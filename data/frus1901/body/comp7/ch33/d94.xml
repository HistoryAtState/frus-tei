                <pb facs="0210" n="130" sameAs="frus:frus1901/pg130"/>

                <head><hi rendition="#italic">Mr. Conger to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Pekin</hi></placeName>, <date calendar="gregorian"
                            when="1901-11-04"><hi rendition="#italic">November 4,
                        1901</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 804.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose to you herewith
                    copies of correspondence relating to the claim to American citizenship of one
                    Lanx Chung Wa, a Chinese living at Canton, and to be, etc.</p>
                <closer><signed><hi rendition="#small-caps">E. H. Conger.</hi></signed></closer>





