    <text>
        <body>
            <div xml:id="d60-a22">

                <pb facs="0127" n="47" sameAs="frus:frus1901/pg47"/>

                <opener><seg rendition="#center">[Inclosure 16.]</seg></opener>
                <head><hi rendition="#italic">Mr. Ragsdale to Mr.
                            Conger.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Consulate of the United States</hi>,<lb/><hi rendition="#italic"
                                >Tientsin</hi></placeName>, <date calendar="gregorian"
                            when="1900-12-28"><hi rendition="#italic">December 28,
                        1900</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith an
                    express just circulated by the Japanese consul. It speaks for itself.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">James W. Ragsdale</hi>, <hi
                            rendition="#italic">Consul.</hi></signed></closer>
            </div>
        </body>
