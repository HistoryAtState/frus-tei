    <text>
        <body>
            <div xml:id="d487">

                <pb facs="0613" n="533" sameAs="frus:frus1901/pg533"/>

                <head><hi rendition="#italic">The President of Paraguay
                        to the President of the United States.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Ascunsion, Paraguay</hi></placeName>, <date calendar="gregorian"
                            when="1901-09-14"><hi rendition="#italic">September 14,
                            1901</hi>.</date></dateline></opener>
                <p>The Government and people of Paraguay join in the great American sorrow.</p>
                <closer><signed><hi rendition="#small-caps">Emilio Aceval</hi>, <hi
                            rendition="#italic">President</hi>.</signed></closer>
            </div>
        </body>
    </text>
