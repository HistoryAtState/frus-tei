    <text>
        <body>
            <div xml:id="d485">

                <pb facs="0613" n="533" sameAs="frus:frus1901/pg533"/>

                <head><hi rendition="#italic">The Minister for Foreign Affairs of
                            Uruguay to Mr. Hay.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Montevideo</hi></placeName>, <date calendar="gregorian"
                            when="1901-09-16"><hi rendition="#italic">September 16,
                        1901</hi></date>.</dateline></opener>
                <p>I present in the name of the Government of Uruguay condolences for the demise of
                    President McKinley. Greetings.</p>
                <closer><signed><hi rendition="#small-caps">German Roosen</hi>,<lb/><hi
                            rendition="#italic">Minister for Foreign Affairs.</hi></signed></closer>
            </div>
        </body>
    </text>
