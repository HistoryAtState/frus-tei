    <text>
        <body>
            <div xml:id="d481">

                <pb facs="0611" n="531" sameAs="frus:frus1901/pg531"/>

                <head><hi rendition="#italic">Mr. Finch to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Montevideo, Uruguay</hi></placeName>, <date calendar="gregorian"
                            when="1901-05-21"><hi rendition="#italic">May 21,
                        1901</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 442.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose copy of a letter from Mr. John G.
                    Hufnagel, United States commercial agent at Paysandu, Uruguay, dated May 11,
                    1901, in which he requests me to issue a certificate of citizenship to his son
                    to replace one issued by the United States minister in Germany.</p>
                <p>The case of Mr. Hufnagel seems unusual to me and is referred to you for
                    instructions.</p>
                <p>Respectfully,</p>
                <closer><signed><hi rendition="#small-caps">William R. Finch.</hi></signed></closer>


                <xi:include href="d481-a1.xml" xpointer="d481-a1"/>
            </div>
