    <text>
        <body>
            <div xml:id="d484">

                <pb facs="0613" n="533" xml:id="pg533"/>

                <head><hi rendition="#italic">Mr. Finch to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Montevideo, Uruguay</hi></placeName>, <date calendar="gregorian"
                            when="1901-08-05"><hi rendition="#italic">August 5,
                        1901</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 457.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose copy and translation of an
                    extract from the annual message of the minister of foreign affairs of Paraguay
                    to the Congress of that country, in which he alludes to me.</p>
                <p>Respectfully,</p>
                <closer><signed><hi rendition="#small-caps">William R. Finch.</hi></signed></closer>


