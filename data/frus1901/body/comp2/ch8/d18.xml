    <text>
        <body>
            <div xml:id="d18">

                <pb facs="0095" n="15" sameAs="frus:frus1901/pg15"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            McCormick.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1901-09-16"><hi rendition="#italic">September 16,
                        1901</hi></date>.</dateline></opener>
                <p>I am charged to request you to convey in the name of the President and Government
                    of the United States, through the appropriate channel, grateful acknowledgment
                    of the message of condolence sent through Mr. Callenberg by His Imperial and
                    Royal Majesty.</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
    </text>
