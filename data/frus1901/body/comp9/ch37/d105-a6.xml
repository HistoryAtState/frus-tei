    <text>
        <body>
            <div xml:id="d105-a6">

                <pb facs="0217" n="137" sameAs="frus:frus1901/pg137"/>

                <opener><seg rendition="#center">[Inclosure 6.]</seg></opener>
                <head><hi rendition="#italic">Mr. Sörensen to Mr. Swenson.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Bramminge</hi></placeName>, <date calendar="gregorian"
                            when="1901-01-24"><hi rendition="#italic">January 24,
                        1901</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Replying to yours of November 29, 1900, I
                    beg of you to kindly inform me if I am stricken off the conscription rolls and
                    exempted from military duty.</p>
                <p>Please let me know soon as possible.</p>
                <p>Respectfully, yours,</p>
                <closer><signed><hi rendition="#small-caps">Sören L.
                    Sörensen.</hi></signed></closer>
            </div>
        </body>
    </text>
