    <text>
        <body>
            <div xml:id="d104">

                <pb facs="0215" n="135" sameAs="frus:frus1901/pg135"/>

                <head><hi rendition="#italic">Mr. Swenson to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Copenhagen</hi></placeName>, <date calendar="gregorian"
                            when="1901-03-13"><hi rendition="#italic">March 13,
                        1901</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 194.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith, for
                    your information, a copy of a letter from Lars Chris. Jensen, Cooleyville,
                    Minn., and of mine in reply thereto, regarding the effect of his naturalization
                    in the United States on his former allegiance to Denmark.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Laurits S.
                    Swenson.</hi></signed></closer>



