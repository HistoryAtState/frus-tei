                <pb facs="0222" n="142" sameAs="frus:frus1901/pg142"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Swenson.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1901-09-17"><hi rendition="#italic">September 17,
                        1901</hi></date>.</dateline></opener>
                <p>Please make earnest acknowledgment of condolences of His Majesty, the Crown
                    Prince, the King of the Hellenes, and Empress Dowager of Russia, in name of
                    Government, American people, and Mrs. McKinley.</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
