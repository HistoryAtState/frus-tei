    <text>
        <body>
            <div xml:id="d252">

                <pb facs="0358" n="278" sameAs="frus:frus1901/pg278"/>

                <head><hi rendition="#italic">Mr. Powell to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Port au Prince, Haiti</hi></placeName>, <date calendar="gregorian"
                            when="1901-02-18"><hi rendition="#italic">February 18,
                        1901</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 883.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In reply to dispatch No. 452 I have the
                    honor to inclose copy of a dispatch forwarded to-day to the Haitian foreign
                    office, according to Department’s instruction.</p>
                <p>I remain, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. F. Powell.</hi></signed></closer>



                <xi:include href="d252-a1.xml" xpointer="d252-a1"/>
