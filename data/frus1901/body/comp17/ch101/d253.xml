    <text>
        <body>
            <div xml:id="d253">

                <pb facs="0359" n="279" sameAs="frus:frus1901/pg279"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Powell.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1901-03-01"><hi rendition="#italic">March 1,
                        1901</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 458.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    No. 883, of the 18th ultimo, and approve your note to the Haitian foreign office
                    in regard to the imposition of higher duties on American than on French tonnage.
                    You will continue to press the matter.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
    </text>
