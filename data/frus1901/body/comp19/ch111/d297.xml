    <text>
        <body>
            <div xml:id="d297">

                <pb facs="0393" n="313" sameAs="frus:frus1901/pg313"/>

                <head><hi rendition="#italic">Mr. Buck to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Legation</hi>,<lb/><hi rendition="#italic">Tokyo,
                                Japan</hi></placeName>, <date calendar="gregorian" when="1899-07-29"
                                ><hi rendition="#italic">July 29, 1899</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 338.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith
                    translations of various new regulations and notifications issued by the Japanese
                    Government recently, which are of interest as relating to foreigners.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">A. E. Buck.</hi></signed></closer>



