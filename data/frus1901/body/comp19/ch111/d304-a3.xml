    <text>
        <body>
            <div xml:id="d304-a3">

                <pb facs="0402" n="322" sameAs="frus:frus1901/pg322"/>

                <opener><seg rendition="#center">[Inclosure 3.]</seg></opener>
                <head><hi rendition="#italic">Mr. Gowey to Mr. Buck.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Consulate-General</hi>,<lb/><hi rendition="#italic"
                                >Yokohama, Japan</hi></placeName>, <date calendar="gregorian"
                            when="1900-01-24"><hi rendition="#italic">January 24,
                        1900</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1685.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a copy
                    of a letter of this date addressed to me by Mr. John Lindsley, an American
                    merchant of Yokohama, accompanying a copy of a resolution passed at a meeting of
                    certain foreigners at Yokohama relative to land titles.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">J. F. Gowey.</hi></signed></closer>
            </div>
        </body>
