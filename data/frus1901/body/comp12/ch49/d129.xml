    <text>
        <body>
            <div xml:id="d129">

                <pb facs="0236" n="156" sameAs="frus:frus1901/pg156"/>

                <head><hi rendition="#italic">Mr. Hay to Mr. Deleassé.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1901-09-16"><hi rendition="#italic">September 16,
                        1901</hi></date>.</dateline></opener>
                <p>In the name of the American people and their Government I thank your excellency
                    for the fraternal message of sympathy and sorrow on the part of the French
                    Government and people.</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
    </text>
