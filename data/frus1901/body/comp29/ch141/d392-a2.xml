    <text>
        <body>
            <div xml:id="d392-a2">

                <pb facs="0525" n="445" sameAs="frus:frus1901/pg445"/>

                <opener><seg rendition="#center">[Inclosure 2.—Translation.]</seg></opener>
                <head><hi rendition="#italic">Certificate.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Moscow</hi></placeName>, <date calendar="gregorian"
                            when="1901-10-07"><hi rendition="#italic">October 7,
                        1901</hi></date>.</dateline></opener>
                <p>I certify hereby that Madame Louisa Ivanovna Lassonne, an American citizen, aged
                    54, is, suffering from chronic arteriosclerosis, together with myocarditis, in
                    consequence of which it is impossible for her to undertake a long journey.</p>
                <closer><signed><hi rendition="#small-caps">Nicholas Kramoreff, M. D.</hi>,<lb/><hi
                            rendition="#italic">Court Counsellor.</hi></signed></closer>
            </div>
        </body>
