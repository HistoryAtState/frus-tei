    <text>
        <body>
            <div xml:id="d512">

                <pb facs="0628" n="548" xml:id="pg548"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Russell.</hi></head>
                <opener><seg rendition="#center">[Telegram.—Paraphrase.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1901-06-22"><hi rendition="#italic">June 22,
                        1901</hi>.</date></dateline></opener>
                <p>(Mr. Hay states that the visit of the <hi rendition="#italic">Mayflower</hi> to
                    Margarita Island was in accordance with custom, and that the request of the
                    United States Government to be furnished with a list of closed Venezuelan ports
                    has not been complied with.)</p>
            </div>
        </body>
