    <text>
        <body>
            <div xml:id="d526">

                <pb facs="0633" n="553" sameAs="frus:frus1901/pg553"/>

                <head><hi rendition="#italic">The President of the United States to the President of
                        Venezuela.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Executive Mansion</hi></placeName>,<lb/><date calendar="gregorian"
                            when="1901-09-21"><hi rendition="#italic">September 21,
                        1901</hi></date>.</dateline></opener>
                <p>The sympathy of Venezuelan Government and people is deeply appreciated.</p>
                <closer><signed><hi rendition="#small-caps">Roosevelt.</hi></signed></closer>
            </div>
        </body>
    </text>
