    <text>
        <body>
            <div xml:id="d522">

                <pb facs="0632" n="552" sameAs="frus:frus1901/pg552"/>

                <head><hi rendition="#italic">Mr. Adee to Mr.
                            Russell.</hi></head>
                <opener><seg rendition="#center">[Telegram.—Paraphrase.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1901-08-05"><hi rendition="#italic">August 5,
                        1901</hi>.</date></dateline></opener>
                <p>(Mr. Adee authorizes Mr. Russell to take charge of Colombian interests by way of
                    good offices, without assuming any representative character, if he is requested
                    by the Colombian minister to do so and the Government of Venezuela
                    acquiesces.)</p>
            </div>
        </body>
