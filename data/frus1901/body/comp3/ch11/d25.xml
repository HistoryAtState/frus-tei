    <text>
        <body>
            <div xml:id="d25">

                <pb facs="0103" n="23" sameAs="frus:frus1901/pg23"/>

                <head><hi rendition="#italic">Mr. Wauters, chargé
                        d’affaires, to Mr. Hay.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Nahant, Mass.</hi></placeName>, <date calendar="gregorian"
                            when="1901-09-14"><hi rendition="#italic">September 14,
                        1901</hi></date>.</dateline></opener>
                <p>I beg your excellency to present, on behalf of the King and Belgian Government
                    and in my own name, the deepest sympathy and condolence to the family of
                    President McKinley and to the United States Government.</p>
                <closer><signed><hi rendition="#small-caps">Wauters.</hi></signed></closer>
            </div>
        </body>
    </text>
