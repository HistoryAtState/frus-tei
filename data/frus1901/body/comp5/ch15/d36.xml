    <text>
        <body>
            <div xml:id="d36">

                <pb facs="0108" n="28" sameAs="frus:frus1901/pg28"/>

                <head><hi rendition="#italic">Mr. Hay to Senhor Brasil.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1901-06-05"><hi rendition="#italic">June 5,
                        1901</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. Minister</hi>: The President will be pleased
                    to receive you and the officers of the Brazilian man-of-war <hi
                        rendition="#italic">Benjamin Constant</hi> on Friday morning, June 7, at 10
                    o’clock.</p>
                <p>Very sincerely, yours,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
    </text>
