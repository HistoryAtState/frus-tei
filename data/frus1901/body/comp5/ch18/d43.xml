    <text>
        <body>
            <div xml:id="d43">

                <pb facs="0111" n="31" sameAs="frus:frus1901/pg31"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Bryan.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1901-09-16"><hi rendition="#italic">September 16,
                        1901</hi></date>.</dateline></opener>
                <p>Please express in the name of President Roosevelt heartfelt thanks for condolence
                    of President Campos. Our people greatly esteem Brazilian sympathy.</p>
                <closer><signed><hi rendition="#small-caps">Hay.</hi></signed></closer>
            </div>
        </body>
    </text>
