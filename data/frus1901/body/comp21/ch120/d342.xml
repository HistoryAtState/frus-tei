                <pb facs="0486" n="406" sameAs="frus:frus1901/pg406"/>

                <head><hi rendition="#italic">Mr. Smith to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Monrovia</hi></placeName>, <date calendar="gregorian"
                            when="1901-10-31"><hi rendition="#italic">October 31,
                        1901</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith
                    copies of official correspondence between this legation and the Liberian
                    Government, resulting from the death of the Hon. William McKinley, late
                    President of the United States.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Owen L. W. Smith.</hi></signed></closer>



