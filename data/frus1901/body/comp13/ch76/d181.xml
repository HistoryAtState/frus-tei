    <text>
        <body>
            <div xml:id="d181">

                <pb facs="0277" n="197" sameAs="frus:frus1901/pg197"/>

                <head><hi rendition="#italic">Mr. Hay to Mr. von Holleben.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1901-12-16"><hi rendition="#italic">December 16,
                        1901</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Excellency</hi>: I have the honor to inclose a
                    memorandum giving the views of the President in reference to the memorandum
                    which you kindly left with me a few days ago.</p>
                <p>Yours, faithfully,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>


                <xi:include href="d181-a1.xml" xpointer="d181-a1"/>
