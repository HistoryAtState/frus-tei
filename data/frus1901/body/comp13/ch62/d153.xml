    <text>
        <body>
            <div xml:id="d153">

                <pb facs="0257" n="177" sameAs="frus:frus1901/pg177"/>

                <head><hi rendition="#italic">Mr. White to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States of America</hi>,<lb/><hi
                                rendition="#italic">Berlin</hi></placeName>, <date
                            calendar="gregorian" when="1901-05-04"><hi rendition="#italic">May 4,
                                1901</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1624.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith a
                    report made to me to-day by Mr. Jackson (to whom the instruction was addressed)
                    with reference to your No. 1189, of April 15, 1901, which was received at the
                    embassy on the 26th ultimo.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Andrew D. White.</hi></signed></closer>


                <xi:include href="d153-a1.xml" xpointer="d153-a1"/>
