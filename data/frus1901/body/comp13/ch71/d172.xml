    <text>
        <body>
            <div xml:id="d172">

                <pb facs="0270" n="190" sameAs="frus:frus1901/pg190"/>

                <head><hi rendition="#italic">Count von Quadt to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Imperial German Embassy</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1901-09-30"><hi rendition="#italic">September 30,
                        1901</hi></date></dateline></opener>
                <p><hi rendition="#small-caps">Mr. Secretary of State</hi>: I have the honor, in
                    pursuance of instructions received from my Government, most respectfully to
                    inform your excellency that, in accordance with the plans approved by his
                    majesty the Emperor and King, his majesty’s schoolship <hi rendition="#italic"
                        >Moltke</hi> will be at Baltimore from the 24th to the 30th of January next,
                    and at Annapolis from January 30 to February 5.</p>
                <p>His majesty’s schoolship <hi rendition="#italic">Stein</hi> will be at San Juan
                    de Puerto Rico from the 3d to the 6th of January next, at Cienfuegos from the
                    16th to the 18th, and at Habana from the 22d to the 28th of the aforesaid
                    month.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">A. Quadt.</hi></signed></closer>
            </div>
        </body>
    </text>
