    <text>
        <body>
            <div xml:id="d141">

                <pb facs="0246" n="166" sameAs="frus:frus1901/pg166"/>

                <head><hi rendition="#italic">Mr. White to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >Berlin</hi></placeName>, <date calendar="gregorian"
                            when="1901-03-09"><hi rendition="#italic">March 9,
                        1901</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1565.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    this morning of your telegraphic instructions,<anchor n="a" xml:id="d141-f1"/>
                    and to inform you that I have at once acted in accordance with the same and have
                    communicated with Baron Richthofen, the imperial secretary of state for foreign
                    affairs.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Andrew D. White.</hi></signed></closer>
            </div>
        </body>
    </text>
