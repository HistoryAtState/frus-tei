    <text>
        <body>
            <div xml:id="d176">

                <pb facs="0272" n="192" sameAs="frus:frus1901/pg192"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Jackson.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1901-12-07"><hi rendition="#italic">December 7,
                        1901</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1272.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: At the request of the Secretary of the
                    Navy, dated the 5th instant, you are instructed to express to the German
                    Government the thanks of the Navy Department for the unusual courtesy extended
                    to the United States naval attaché in that marked facilities for visiting the
                    German Torpedo Schoolship and Depot have been granted him.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
    </text>
