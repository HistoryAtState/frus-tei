    <text>
        <body>
            <div xml:id="d253-a1">

                <pb facs="0839" n="1629" sameAs="frus:frus1952-54v01p2/pg1629"/>

                <head>Appendix</head>
                <p rendition="#center"><hi rendition="#small-caps">Tentative Allocation by National
                        in the Maximum of</hi> 240,000</p>
                <table cols="2" rows="7">
                    <row role="label">
                        <cell role="num">50,000</cell>
                        <cell>Refugees now in West Germany, Berlin, Austria and Trieste (mainly
                            German).</cell>
                    </row>
                    <row>
                        <cell role="num">60,000</cell>
                        <cell>Ethnic Germans expelled from Eastern Europe after World War II, and
                            German nationals.</cell>
                    </row>
                    <row>
                        <cell role="num">15,000</cell>
                        <cell>Refugees now in NATO countries.</cell>
                    </row>
                    <row>
                        <cell role="num">75,000</cell>
                        <cell>Italian nationals.</cell>
                    </row>
                    <row>
                        <cell role="num">20,000</cell>
                        <cell>Greek nationals.</cell>
                    </row>
                    <row>
                        <cell role="num">20,000</cell>
                        <cell>Dutch nationals.</cell>
                    </row>
                    <row>
                        <cell role="num">240,000</cell>
                        <cell/>
                    </row>
                </table>
            </div>
        </body>
    </text>
