    <text>
        <body>
            <div xml:id="d283">

                <pb facs="0905" n="1695" sameAs="frus:frus1952-54v01p2/pg1695"/>

                <note rend="inline" type="source">711.022/10–2953</note>
                <head><hi rendition="#italic">Memorandum by the Under Secretary of State (Smith) to the President</hi><anchor n="1" xml:id="d283-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1953-10-29">October 29, 1953</date>.</dateline></opener>
                <list subtype="subject" type="description">
                    <item>Subject:</item>
                    <item>Fishing Rights in Coastal Waters</item>
                </list>
                <pb facs="0906" n="1696" xml:id="pg1696"/>
                <p>There is enclosed a suggested reply to the letter of August 6, 1953 addressed to
                    you by Senators Daniel, Holland and Saltonstall,<anchor n="2" xml:id="d283-f2"/>
                    a copy of which was transmitted to the Secretary for suggested reply.</p>
                <p>The suggested reply has been submitted to the Attorney General and has been
                    approved by him.</p>
                <closer><signed><hi rendition="#small-caps">Walter B. Smith</hi></signed></closer>


                <xi:include href="d283-a1.xml" xpointer="d283-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d283-f1" n="1" type="source" xml:id="d283-f1-content">
                <p>Drafted by Yingling and Edward G. Piatt, Jr., of the Executive Secretariat’s
                    Staff Operations.</p>
            </note>
            <note corresp="#d283-f2" n="2" xml:id="d283-f2-content">
