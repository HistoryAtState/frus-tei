    <text>
        <body>
            <div xml:id="d325">

                <pb facs="0586" n="571" sameAs="frus:frus1949v04/pg571"/>

                <note rend="inline" type="source">S/S–NSC Files, Lot 63D351, NSC 19 File</note>
                <head>
                    <hi rendition="#italic">Memorandum by the Executive Secretary of the National
                        Security Council</hi> (<hi rendition="#italic">Souers</hi>) <hi
                        rendition="#italic">to the President </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1949-08-04">August 4, 1949</date>.</dateline>
                </opener>
                <p rendition="#flush"> NSC 19/5</p>
                <p rendition="#center">
                    <hi rendition="#small-caps">U.S. Position on the Disposition of the Former
                        Italian Colonies</hi>
                </p>
                <p>Reference: NSC 19/4.<anchor n="1" xml:id="d325-f1"/> The National Security
                    Council, at its 44th Meeting,<anchor n="2" xml:id="d325-f2"/> adopted NSC 19/4
                    subject to amendment of paragraphs 8 and 22 as shown herein.</p>
                <p>The National Security Council recommends that the President approve the
                    “Recommendations” contained herein, as a basis for negotiations by the Secretary
                    of State.<anchor n="3" xml:id="d325-f3"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Sidney</hi> W. <hi rendition="#small-caps"
                            >Souers</hi>
                    </signed>
                </closer>



                <xi:include href="d325-a1.xml" xpointer="d325-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d325-f1" n="1" xml:id="d325-f1-content">
