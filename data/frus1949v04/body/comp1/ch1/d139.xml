    <text>
        <body>
            <div xml:id="d139">

                <pb facs="0275" n="261" sameAs="frus:frus1949v04/pg261"/>

                <note rend="inline" type="source">840.20/3–3149</note>
                <head>
                    <hi rendition="#italic">The Ambassador of the Soviet Union</hi> (<hi
                        rendition="#italic">Panyushkin</hi>) <hi rendition="#italic">to the
                        Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Informal Translation]</seg>
                    <seg rendition="#float-left">No. 32</seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1949-03-31">March 31, 1949</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Upon instructions from the Soviet
                    Government I enclose herewith for the Government of the USA a memorandum of the
                    Soviet Government concerning the North Atlantic Pact.</p>
                <p>At the same time I enclose the text of the declaration of the Ministry of Foreign
                    Affairs of the USSR of January 29, 1949 concerning the North Atlantic
                        Pact.<anchor n="1" xml:id="d139-f1"/>
                </p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>A. <hi rendition="#small-caps">Panyushkin</hi>
                    </signed>
                </closer>


                <xi:include href="d139-a1.xml" xpointer="d139-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d139-f1" n="1" xml:id="d139-f1-content">
