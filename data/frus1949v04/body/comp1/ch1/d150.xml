    <text>
        <body>
            <div xml:id="d150">

                <pb facs="0303" n="289" sameAs="frus:frus1949v04/pg289"/>

                <note rend="inline" type="source">840.20/4–749</note>
                <head>
                    <hi rendition="#italic">Memorandum by the Secretary of
                            State to the President
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1949-04-07">April 7, 1949</date>.</dateline>
                </opener>
                <p rendition="#center">
                    <hi rendition="#small-caps">Memorandum for the President</hi>
                </p>
                <p rendition="#flush">Subject: North Atlantic Treaty</p>
                <p>I attach my report on the North Atlantic Treaty<anchor n="1" xml:id="d150-f1"/>
                    together with a draft message to the Senate<anchor n="2" xml:id="d150-f2"/> for
                    your consideration and transmission to the Senate if you approve.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Dean Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d150-f1" n="1" xml:id="d150-f1-content">
                <p>For text of report, dated April 7, see Department of State <hi
                        rendition="#italic">Bulletin</hi>, April 24, 1949, p. 532.</p>
            </note>
            <note corresp="#d150-f2" n="2" xml:id="d150-f2-content">
                <p>For text of final version, dated April 12, see <hi rendition="#italic"
                    >ibid.</hi>, May 8, 1949, p. 599.</p>
            </note>
        </listAnnotation>
    </standOff>
