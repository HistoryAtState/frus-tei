    <text>
        <body>
            <div xml:id="d184-a2">

                <pb facs="0342" n="328" xml:id="pg328"/>

                <head>Attachment B</head>
                <p rendition="#center">
                    <hi rendition="#small-caps">Aide-Mémoire</hi>
                </p>
                <p>The United States will appoint representatives to play an active role in the work
                    of the three European regional planning groups within the limits of the policy
                    of the United States Joint Chiefs of Staff, and it is hoped that their work will
                    lead to the further development of policy by the Joint Chiefs of Staff as may be
                    necessary.</p>
                <closer><dateline rendition="#float-left">
                        <placeName><hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1949-09-14">September 14,
                        1949</date>.</dateline></closer>
            </div>
        </body>
    </text>
