                <pb facs="0367" n="352" sameAs="frus:frus1949v04/pg352"/>

                <note rend="inline" type="source">840.20/12–149</note>
                <head>
                    <hi rendition="#italic">Note by the Secretary of the North Atlantic Defense
                        Committee</hi> (<hi rendition="#italic">Donnelly</hi>) <hi
                        rendition="#italic">to the Committee </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>,] <date calendar="gregorian"
                            when="1949-12-01">1 December 1949</date>.</dateline>
                </opener>
                <p rendition="#flush">D.C. 6/1</p>
                <p>The enclosed report is a revision of DC 6<anchor n="1" xml:id="d204-f1"/> as
                    approved by the North Atlantic Defense Committee at its meeting on 1 December
                    1949.</p>
                <closer>
                    <signed>C. H. <hi rendition="#small-caps">Donnelly</hi>
                    </signed>
                    <lb/>
                    <hi rendition="#italic">Colonel, USA</hi>
                </closer>



                <xi:include href="d204-a1.xml" xpointer="d204-a1"/>
