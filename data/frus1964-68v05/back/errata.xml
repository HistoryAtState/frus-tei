            <div xml:id="errata">

                <pb facs="1215" n="1175" sameAs="frus:frus1964-68v05/pg1175"/>

                <head>Errata</head>
                <p>The following change has been made to <ref target="frus:frus1964-68v05"><hi
                            rendition="#italic">Foreign Relations</hi>, 1964-68, Volume V, Vietnam,
                        1967</ref>. Please be aware that printed volumes have not been revised.
                    <!--Revised information is in italic.--></p>
                <list type="simple">
                    <item><hi rendition="#bold">1. <ref target="#d74">Document 74</ref>, Page 160
                            (date of correction: February 8, 2017)</hi></item>
                    <item>The dateline of Document 74 has been corrected from “Washington, February
                        11, 1967, 0533Z” to “Washington, February 13, 1967, 0533Z”.</item>
                </list>
            </div>
        </body>
