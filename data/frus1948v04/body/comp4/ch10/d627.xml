            </note>
            <note corresp="#d627-f2" n="2" xml:id="d627-f2-content">
                <p>Fedor Tarasovich Gusyev (Gusev), Deputy Minister for Foreign Affairs of the
                    Soviet Union.</p>
            </note>
        </listAnnotation>
