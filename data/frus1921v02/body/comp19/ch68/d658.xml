            <div xml:id="d658">

                <pb facs="0808" n="712" sameAs="frus:frus1921v02/pg712"/>

                <note rend="inline" type="source">861.00/8874</note>
                <head><hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Harvey</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1921-07-15"><hi rendition="#italic">July 15,
                        1921</hi></date>.<lb/>[Received July 27.]</dateline>
                    <seg rendition="#float-left">No. 266</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith, as
                    of possible interest to the Department, the official report of Questions and
                    Answers in the House of Commons on July 6th, regarding the movement of Japanese
                    troops in certain portions of Eastern Siberia.</p>
                <p>I have [etc.]</p>
                <closer>(For the Ambassador)<lb/>[No signature indicated]<lb/><hi
                        rendition="#italic">Counselor of Embassy</hi></closer>


                <xi:include href="d658-a1.xml" xpointer="d658-a1"/>
