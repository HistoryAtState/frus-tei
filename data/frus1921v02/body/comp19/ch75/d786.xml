                <pb facs="0909" n="813" sameAs="frus:frus1921v02/pg813"/>

                <note rend="inline" type="source">861.48/1635</note>
                <head><hi rendition="#italic">The Commissioner at Riga</hi> (<hi rendition="#italic"
                        >Young</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Riga</hi></placeName>, <date calendar="gregorian" when="1921-08-23"
                                ><hi rendition="#italic">August 23, 1921</hi></date>.<lb/>[Received
                        September 13.]</dateline>
                    <seg rendition="#float-left">No. 1166</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to forward, in triplicate,
                    copy of the agreements signed by Messrs. Brown and Litvinov on August 20th.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Evan E. Young</hi></signed></closer>


                <xi:include href="d786-a1.xml" xpointer="d786-a1"/>
