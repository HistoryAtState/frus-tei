                <note rend="inline" type="source">123 C 12/140: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Japan</hi> (<hi rendition="#italic"
                        >Warren</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Tokyo</hi></placeName>, <date calendar="gregorian"
                            when="1921-11-04T10:00:00+09:00"><hi rendition="#italic">November 4,
                                1921—10 a.m.</hi></date><lb/>[Received November 4—3:41
                        a.m.]</dateline></opener>
                <p>369. My 367, November 1, 10 a.m.<anchor n="55" xml:id="d710-f1"/> Caldwell
                    arrived Chita November 2.</p>
                <closer><signed><hi rendition="#small-caps">Warren</hi></signed></closer>
            </div>
        </body>
