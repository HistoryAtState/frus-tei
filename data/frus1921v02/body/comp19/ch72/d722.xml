                <pb facs="0859" n="763" sameAs="frus:frus1921v02/pg763"/>

                <note rend="inline" type="source">641.6131/19: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Great Britain</hi> (<hi rendition="#italic">Wright</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1921-03-16T12:00:00+00:00"><hi rendition="#italic">March 16,
                                1921—noon</hi></date>.<lb/>[Received March 16—11
                    a.m.]</dateline></opener>
                <p>216. Trade agreement with Soviet Russia signed last night at Board of Trade. This
                    information is from official source. I have informed Berlin, Copenhagen, Paris
                    and Warsaw.</p>
                <closer><signed><hi rendition="#small-caps">Wright</hi></signed></closer>
            </div>
        </body>
