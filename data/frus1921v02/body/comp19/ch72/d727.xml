                <pb facs="0865" n="769" sameAs="frus:frus1921v02/pg769"/>

                <note rend="inline" type="source">661.1115/277: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Consul at Reval</hi>
                        (<hi rendition="#italic">Albrecht</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1921-04-02T16:00:00-05:00"><hi rendition="#italic">April 2, 1921—4
                                p.m.</hi></date></dateline></opener>
                <p>Your March 27, 2 p.m.</p>
                <p>You may receive informally and without comment any communication it is desired to
                    transmit.</p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
