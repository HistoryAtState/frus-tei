                <pb facs="0549" n="453" sameAs="frus:frus1921v02/pg453"/>

                <note rend="inline" type="source">611.127/394</note>
                <head><hi rendition="#italic">The President of the Standard Oil Company of New
                        Jersey</hi> (<hi rendition="#italic">W. C.
                        Teagle</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >New York</hi></placeName>, <date calendar="gregorian"
                            when="1921-08-18"><hi rendition="#italic">August 18,
                        1921</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. Secretary</hi>: Because of the urgent nature
                    of the matter mentioned in the accompanying communication to you, I have taken
                    the liberty of sending it by special messenger, for delivery at your residence
                    tonight.</p>
                <p>Very sincerely yours,</p>
                <closer><signed><hi rendition="#small-caps">W. C. Teagle</hi></signed></closer>


                <xi:include href="d394-a1.xml" xpointer="d394-a1"/>
