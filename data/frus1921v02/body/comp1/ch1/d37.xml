                <pb facs="0131" n="35" sameAs="frus:frus1921v02/pg35"/>

                <note rend="inline" type="source">711.62119/98: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Chargé in Germany</hi> (<hi rendition="#italic"
                            >Dresel</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1921-11-26T19:00:00-05:00"><hi rendition="#italic">November 26,
                                1921—7 p.m.</hi></date></dateline></opener>
                <p>1547. Your 806, November 23, 4 p.m.</p>
                <p>Executive Proclamation of Peace with Germany reads in part as follows “The war
                    between the United States and Germany terminated on July 2, 1921.”</p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
