    <text>
        <body>
            <div xml:id="d60">

                <pb facs="0150" n="54" sameAs="frus:frus1921v02/pg54"/>

                <note rend="inline" type="source">462.00 R 29/711</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Belgian Ambassador</hi> (<hi rendition="#italic">De
                            Cartier</hi>)<anchor n="42" xml:id="d60-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1921-04-29"><hi rendition="#italic">April 29,
                        1921</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Ambassador</hi>: I have received today
                    the enclosed memorandum from Berlin<anchor n="43" xml:id="d60-f2"/> correcting
                    the memorandum of April 24th, with respect to reparations, in the particulars
                    noted.</p>
                <p>Believe me [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Charles E. Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d60-f1" n="42" type="source" xml:id="d60-f1-content">
                <p>The same, <hi rendition="#italic">mutatis mutandis</hi>, to the British, Italian,
                    and Japanese Ambassadors.</p>
            </note>
            <note corresp="#d60-f2" n="43" xml:id="d60-f2-content">
                <p>See telegram no. 464, Apr. 28, from the Commissioner at Berlin, <ref
                        target="#pg53">p. 53</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
