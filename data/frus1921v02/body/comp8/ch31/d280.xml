    <text>
        <body>
            <div xml:id="d280">

                <pb facs="0387" n="291" sameAs="frus:frus1921v02/pg291"/>

                <note rend="inline" type="source">862i.01/144½</note>
                <head><hi rendition="#italic">The Japanese Embassy to the
                            Department of State</hi><anchor n="35"
                        xml:id="d280-f1"/></head>
                <dateline>
                    <date ana="#date_undated-inferred-from-document-content" calendar="gregorian"
                        type="received-date" when="1921-06-18">undated</date>
                </dateline>
                <p rendition="#flush">(Tentative draft)</p>
                <p>It is agreed that the United States shall have free access to the Island of Yap
                    on the footing of entire equality with Japan or any other nation, in all that
                    relates to the landing and operation of the existing Yap–Guam cable or of any
                    cable which may hereafter be laid by the United States or its nationals.</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d280-f1" n="35" type="source" xml:id="d280-f1-content">
                <p>Handed to the Secretary of State by the Japanese Ambassador, June 18.</p>
            </note>
        </listAnnotation>
    </standOff>
