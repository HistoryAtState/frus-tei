    <text>
        <body>
            <div xml:id="d312">

                <pb facs="0448" n="352" sameAs="frus:frus1921v02/pg352"/>

                <note rend="inline" type="source">894c.111/25</note>
                <head><hi rendition="#italic">The Ambassador to Great Britain</hi> (<hi
                        rendition="#italic">Davis</hi>) <hi rendition="#italic">to the Acting
                        Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1921-01-19"><hi rendition="#italic">January 19,
                        1921</hi></date>.<lb/>[Received February 2.]</dateline>
                    <seg rendition="#float-left">No. 4089</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of the Department’s telegraphic instruction No. 4 dated January 2 [<hi
                        rendition="#italic">3</hi>], 7 p.m.,<anchor n="11" xml:id="d312-f1"/> in
                    regard to the acceptance by foreign governments of the Japanese passport
                    regulations in China and to transmit herewith copy of a note No. F 86/70/10
                    dated January 13, 1921, which I have received from the Foreign Office in this
                    connection.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">John W. Davis</hi></signed></closer>


                <xi:include href="d312-a1.xml" xpointer="d312-a1"/>
            </div>
        </body>
    </text>
