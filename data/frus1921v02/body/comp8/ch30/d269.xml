    <text>
        <body>
            <div xml:id="d269">

                <pb facs="0366" n="270" sameAs="frus:frus1921v02/pg270"/>

                <note rend="inline" type="source">862i.01/64</note>
                <head><hi rendition="#italic">The Ambassador in Italy</hi> (<hi rendition="#italic"
                        >Johnson</hi>) <hi rendition="#italic">to the Acting Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Rome</hi></placeName>, <date calendar="gregorian" when="1920-12-28"
                                ><hi rendition="#italic">December 28,
                        1920</hi></date>.<lb/>[Received January 19, 1921.]</dateline>
                    <seg rendition="#float-left">No. 255</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to the Department’s telegraphic
                    instruction No. 233 of December 6th, five p.m.,<anchor n="17" xml:id="d269-f1"/>
                    I have the honor to report that I duly transmitted to Count Sforza the
                    Department’s communication setting forth the views of the American Government
                    relative to the status of the Island of Yap, and have received the reply
                    enclosed.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Robert Underwood
                    Johnson</hi></signed></closer>


                <xi:include href="d269-a1.xml" xpointer="d269-a1"/>
            </div>
        </body>
    </text>
