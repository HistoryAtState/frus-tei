    <text>
        <body>
            <div xml:id="d335">

                <pb facs="0485" n="389" sameAs="frus:frus1921v02/pg389"/>

                <note rend="inline" type="source">882.51/1338</note>
                <head><hi rendition="#italic">The Assistant Secretary of State</hi> (<hi
                        rendition="#italic">Dearing</hi>) <hi rendition="#italic">to President
                        King</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1921-11-08"><hi rendition="#italic">November 8,
                        1921</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. President</hi>: In view of the execution
                    of the financial agreement on October 28, 1921, in terms of a proposed new
                    credit of $5,000,000 subject to appropriate action of Congress, I have the <pb
                        facs="0486" n="390" xml:id="pg390"/> honor to inform you, in keeping with
                    previous verbal expressions of the Department of State, that the balance of the
                    credit established in favor of Liberia with the United States Treasury September
                    12, 1918,<anchor n="11" xml:id="d335-f1"/> but not deemed available, has
                    therefore been withdrawn.</p>
                <p>I am [etc.]</p>
                <closer><signed><hi rendition="#small-caps">F. M. Dearing</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d335-f1" n="11" xml:id="d335-f1-content">
                <p>Credit established by Treasury Department on Sept. 9, 1918; Liberia notified by
                    State Department on Sept. 12, 1918; see <ref target="frus1918#pg_537"><hi
                            rendition="#italic">Foreign Relations</hi>, 1918, p. 537</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
