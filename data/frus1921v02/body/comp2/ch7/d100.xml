                <pb facs="0211" n="115" sameAs="frus:frus1921v02/pg115"/>

                <note rend="inline" type="source">867n.01/215</note>
                <head><hi rendition="#italic">The Chargé in Great Britain</hi> (<hi rendition="#italic">Wheeler</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1921-12-30"><hi rendition="#italic">December 30,
                        1921</hi></date>.<lb/>[Received January 12, 1922.]</dateline>
                    <seg rendition="#float-left">No. 831</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to my despatch No. 811 of
                    the 23rd instant, I have the honor to transmit herewith copies of a further note
                    just received from the Foreign Office on the question of Mandates.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Post Wheeler</hi></signed></closer>


                <xi:include href="d100-a1.xml" xpointer="d100-a1"/>
