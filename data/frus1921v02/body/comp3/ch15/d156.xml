                <pb facs="0266" n="170" sameAs="frus:frus1921v02/pg170"/>

                <note rend="inline" type="source">368.117/100: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Chargé in Greece</hi>
                        (<hi rendition="#italic">Hall</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1921-04-07T14:00:00-05:00"><hi rendition="#italic">April 7, 1921—2
                                p.m.</hi></date></dateline></opener>
                <p>34. Your 36, March 17, 2 p.m.</p>
                <p>Informally ask Foreign Minister why American passports seized by Greek
                    authorities have not been returned in accordance with promise mentioned in your
                    274, December 23, and renew request for return. Telegraph reply.</p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
