            <div xml:id="d590">

                <pb facs="0742" n="646" sameAs="frus:frus1921v02/pg646"/>

                <note rend="inline" type="source">891.6363 Standard Oil/39½</note>
                <head><hi rendition="#italic">The Chargé in Persia</hi> (<hi rendition="#italic"
                        >Engert</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><seg rendition="#center">[Extract]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Teheran</hi></placeName>, <date calendar="gregorian"
                            when="1921-10-24"><hi rendition="#italic">October 24,
                        1921</hi></date>.<lb/>[Received January 24, 1922.]</dateline>
                    <seg rendition="#float-left">No. 748</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring once more to the Department’s
                    Instruction No. 184 of April 9, 1921,<anchor n="21" xml:id="d590-f1"/> I have
                    the honor to enclose herewith translations of further documents<anchor n="22"
                        xml:id="d590-f2"/> …</p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">C. Van H. Engert</hi></signed></closer>


                <xi:include href="d590-a1.xml" xpointer="d590-a1"/>
            </div>
        </body>
    </text>
