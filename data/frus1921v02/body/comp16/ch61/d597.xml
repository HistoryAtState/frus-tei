            <div xml:id="d597">

                <pb facs="0748" n="652" xml:id="pg652"/>

                <note rend="inline" type="source">891.6363 Standard Oil/65: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Chargé in Persia</hi> (<hi rendition="#italic"
                            >Engert</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1921-12-13T18:00:00-05:00"><hi rendition="#italic">December 13,
                                1921—6 p.m.</hi></date></dateline></opener>
                <p>44. Your 78 December 9, 9 P.M.</p>
                <p>Department knows of no rivalry. Endeavor discreetly and if possible in
                    cooperation with Thompson to prevent any local appearance of rivalry.</p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
