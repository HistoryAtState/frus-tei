                <pb facs="0343" n="247" sameAs="frus:frus1921v02/pg247"/>

                <note rend="inline" type="source">815.51/437: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Honduras</hi> (<hi
                            rendition="#italic">Spencer</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Tegucigalpa</hi></placeName>, <date calendar="gregorian"
                            when="1921-08-26T10:00:00-06:00"><hi rendition="#italic">August 26,
                                1921—10 a.m.</hi></date><lb/>[Received 6:35
                    p.m.]</dateline></opener>
                <p>114. Department’s telegram 26.<anchor n="4" xml:id="d241-f1"/> Young contract
                    terminated, he will report to the Department September 15.</p>
                <closer><signed><hi rendition="#small-caps">Spencer</hi></signed></closer>
            </div>
        </body>
    </text>
