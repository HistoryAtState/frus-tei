            <div xml:id="d610">

                <pb facs="0754" n="658" sameAs="frus:frus1921v02/pg658"/>

                <note rend="inline" type="source">823.51/196</note>
                <head><hi rendition="#italic">The Administrator of Customs for Peru</hi> (<hi rendition="#italic">Cumberland</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1921-10-31"><hi rendition="#italic">October 31,
                        1921</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I take pleasure in transmitting herewith
                    for the records of the Department a copy of a contract which was signed on
                    October 28. 1921, between Ambassador Pezet, acting for the Republic of Peru, <pb
                        facs="0755" n="659" xml:id="pg659"/> and myself, under the terms of which I
                    shall assume the duties of Administrator of Customs for Peru.</p>
                <p>Very truly yours,</p>
                <closer><signed><hi rendition="#small-caps">W. W. Cumberland</hi></signed></closer>


                <xi:include href="d610-a1.xml" xpointer="d610-a1"/>
            </div>
