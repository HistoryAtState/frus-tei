                <pb facs="0778" n="682" sameAs="frus:frus1921v02/pg682"/>

                <note rend="inline" type="source">423.11 L 23/329: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Peru</hi> (<hi
                            rendition="#italic">Gonzales</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Lima</hi></placeName>, <date calendar="gregorian"
                            when="1921-06-21T15:00:00-05:00"><hi rendition="#italic">June 21, 1921—3
                                p.m.</hi></date><lb/>[Received June 22—9:25
                    a.m.]</dateline></opener>
                <p>50. Department’s 33, June 20, 4 p.m. Peruvian Government has appointed Señor
                    Carlos Prevost Commissioner in Landreau arbitration.</p>
                <closer><signed><hi rendition="#small-caps">Gonzales</hi></signed></closer>
            </div>
        </body>
