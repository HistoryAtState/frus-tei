                <pb facs="0637" n="541" sameAs="frus:frus1921v02/pg541"/>

                <note rend="inline" type="source">856d.6363/83: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Minister in the Netherlands</hi> (<hi
                            rendition="#italic">Phillips</hi>)</head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1921-05-05T18:00:00-04:00"><hi rendition="#italic">May 5, 1921—6
                                p.m.</hi></date></dateline></opener>
                <p>31. Reference your telegram no. 53 of April 29, 8 p.m. Your action approved.
                    Continue to act at your discretion. Your suggestion is being followed by the
                    Department.</p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
