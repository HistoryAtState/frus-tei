                <pb facs="0294" n="198" sameAs="frus:frus1921v02/pg198"/>

                <note rend="inline" type="source">711.38/171</note>
                <head><hi rendition="#italic">The Secretary of State to the Minister in Haiti</hi>
                        (<hi rendition="#italic">Bailly-Blanchard</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1921-04-26"><hi rendition="#italic">April 26,
                        1921</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 398</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: The Department is enclosing herewith a
                    personal letter from the President in reply to one from the President of Haiti
                    under date of March 4, 1921, transmitted through the Haitian Legation at
                    Washington on March 24th.</p>
                <p>You will transmit this letter of the President to its high destination.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State<lb/><signed><hi rendition="#small-caps">Henry P.
                            Fletcher</hi></signed></closer>


                <xi:include href="d188-a1.xml" xpointer="d188-a1"/>
