                <pb facs="0356" n="260" sameAs="frus:frus1921v02/pg260"/>

                <note rend="inline" type="source">701.6411/orig.: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Commissioner at Budapest</hi> (<hi
                            rendition="#italic">Grant-Smith</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1921-12-23T15:00:00-05:00"><hi rendition="#italic">December 23,
                                1921—3 p.m.</hi></date></dateline></opener>
                <p>355. Your 355, December 17, 8 p.m.</p>
                <p>Szechenyi acceptable as Minister to this Government.<anchor n="7"
                        xml:id="d256-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d256-f1" n="7" xml:id="d256-f1-content">
                <p>Count Széchényi presented his letters of credence Jan. 11, 1922.</p>
            </note>
        </listAnnotation>
    </standOff>
