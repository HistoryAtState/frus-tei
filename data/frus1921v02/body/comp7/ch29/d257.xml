    <text>
        <body>
            <div xml:id="d257">

                <pb facs="0357" n="261" xml:id="pg261"/>

                <note rend="inline" type="source">123 Sm 61/184: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Hungary</hi> (<hi rendition="#italic"
                        >Grant-Smith</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Budapest</hi></placeName>, <date calendar="gregorian"
                            when="1921-12-30T22:00:00+01:00"><hi rendition="#italic">December 30,
                                1921—10 p.m.</hi></date><lb/>[Received January 3, 1922—1:43
                        p.m.]</dateline></opener>
                <p>1. Your 354, December 21 [<hi rendition="#italic">20</hi>], 6 p.m. I have been
                    granted provisional recognition by the Hungarian Government as Chargé d’Affaires
                    as from December 26th.</p>
                <closer><signed><hi rendition="#small-caps">Grant-Smith</hi></signed></closer>
            </div>
        </body>
