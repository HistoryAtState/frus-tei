                <pb facs="0845" n="806" sameAs="frus:frus1977-80v13/pg806"/>

                <head>218. Summary of Conclusions of a Special Coordination Committee Meeting<anchor
                        n="1" xml:id="d218-f1"/>
                </head>
                <opener><dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            from="1979-02-18T09:00:00-05:00" to="1979-02-18T09:35:00-05:00">February
                            18, 1979, 9–9:35 a.m.</date>
                    </dateline></opener>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>Sino-Vietnamese Conflict</item>
                </list>
                <list subtype="participants" type="description">
                    <label>PARTICIPANTS</label>
