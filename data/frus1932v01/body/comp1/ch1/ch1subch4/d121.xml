    <text>
        <body>
            <div xml:id="d121">

                <pb facs="0300" n="180" sameAs="frus:frus1932v01/pg180"/>

                <note rend="inline" type="source">500.A15A4/1074½</note>
                <head>
                    <hi rendition="#italic">President Hoover to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1932-05-24">May 24, 1932</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: Please find enclosed
                    herewith copy of the memorandum I read at Cabinet this morning. I am putting
                    this forward only for your consideration.</p>
                <p>Yours faithfully,</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Herbert Hoover</hi>
                        
                    </signed>
                </closer>


                <xi:include href="d121-a1.xml" xpointer="d121-a1"/>
