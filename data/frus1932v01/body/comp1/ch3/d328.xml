    <text>
        <body>
            <div xml:id="d328">

                <pb facs="0596" n="476" xml:id="pg476"/>

                <note rend="inline" type="source">500.A15A4 Steering Committee/228</note>
                <head>
                    <hi rendition="#italic">The Chargé in France (Marriner) to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 3117</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1932-11-28">November 28,
                        1932</date>.<lb/>[Received December 6.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to the Embassy’s telegram
                    No. 673, November 27, 7 p.m.,<anchor n="88" xml:id="d328-f1"/> I have the honor
                    to enclose a copy of a memorandum of the confidential conversation concerning
                    various aspects of the disarmament problem which took place between M. Herriot
                    and the Honorable Norman Davis on Saturday, November 26th.</p>
                <p>Respectfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Theodore Marriner</hi>
                    </signed>
                </closer>


                <xi:include href="d328-a1.xml" xpointer="d328-a1"/>
            </div>
        </body>
    </text>
