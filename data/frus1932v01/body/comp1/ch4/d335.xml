    <text>
        <body>
            <div xml:id="d335">

                <pb facs="0649" n="529" sameAs="frus:frus1932v01/pg529"/>

                <note rend="inline" type="source">550.S1/172: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain (Mellon) to the
                        Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Extract]<anchor n="9" xml:id="d335-f1"/></seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1932-09-10T14:00:00+01:00">September 10,
                            1932—2 p.m.</date>
                        <lb/> [Received September 10—12:35 p.m.]</dateline>
                </opener>
                <p>260. For Norman Davis.</p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>… Simon would be very happy for a discussion of those naval matters referred to
                    in paragraph 2 of your 237 September 9th, 6 p.m.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Mellon</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d335-f1" n="9" xml:id="d335-f1-content">
                <p>For extracted portion of this telegram, see <ref target="#pg822">p.
                    822</ref>.</p>
            </note>
