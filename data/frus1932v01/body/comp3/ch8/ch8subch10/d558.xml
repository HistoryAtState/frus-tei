            <div xml:id="d558">

                <pb facs="0927" n="807" sameAs="frus:frus1932v01/pg807"/>

                <note rend="inline" type="source">800.51W89 Poland/96</note>
                <head>
                    <hi rendition="#italic">The Polish Embassy to the Department of State </hi>
                </head>
                <p>The Polish Government has the honour to acknowledge receipt of the note of the
                    United States Government of December 15th, 1932.</p>
                <p>The Polish Government holds itself fully at the disposal of the United States
                    Government for the survey of the problem of Poland’s war debt to the United
                    States with a view to safeguarding the general interests of our two
                    countries.</p>
                <closer>
                    <dateline rendition="#float-left">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1932-12-21">December 21,
                            1932</date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
