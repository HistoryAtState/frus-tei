    <text>
        <body>
            <div xml:id="d431">

                <pb facs="0749" n="629" sameAs="frus:frus1932v01/pg629"/>

                <note rend="inline" type="source">800.51W89 Hungary/84</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Minister in Hungary (Roosevelt)</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 98</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1932-06-06">June 6, 1932</date>.</dateline>
                </opener>
                <p>The Secretary of State refers to previous correspondence regarding the
                    President’s Proposal of June 20, 1931, for postponement of intergovernmental
                    debts and transmits for the information of the American Minister copy of the
                    “Agreement between the Kingdom of Hungary and the United States of America, May
                    27, 1932”.<anchor n="59" xml:id="d431-f1"/>
                </p>
            </div>
        </body>
