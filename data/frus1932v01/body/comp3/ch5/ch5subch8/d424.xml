    <text>
        <body>
            <div xml:id="d424">

                <pb facs="0745" n="625" sameAs="frus:frus1932v01/pg625"/>

                <note rend="inline" type="source">800.51W89 Great Britain/317a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Great Britain (Mellon)</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 74</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1932-06-10">June 10, 1932</date>.</dateline>
                </opener>
                <p>The Secretary of State refers to previous correspondence regarding the
                    President’s Proposal of June 20, 1931, for postponement of intergovernmental
                    debts and transmits for the information of the American Ambassador copy of the
                    “Agreement between the Government of the United Kingdom and the United States of
                    America, June 4, 1932”.<anchor n="54" xml:id="d424-f1"/>
                </p>
            </div>
        </body>
