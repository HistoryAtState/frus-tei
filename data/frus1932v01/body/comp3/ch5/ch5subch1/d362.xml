    <text>
        <body>
            <div xml:id="d362">

                <pb facs="0708" n="588" sameAs="frus:frus1932v01/pg588"/>

                <note rend="inline" type="source">800.51W89 Austria/26a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Minister in Austria (Stockton)</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 189</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1932-09-19">September 19,
                        1932</date>.</dateline>
                </opener>
                <p>The Secretary of State refers to previous correspondence regarding the
                    President’s Proposal of June 20, 1931, for postponement of intergovernmental
                    debts and transmits for the information of the American Minister copy of the
                    “Agreement between the Republic of Austria and the United States of America,
                    September 14, 1932”.<anchor n="13" xml:id="d362-f1"/>
                </p>
            </div>
        </body>
    </text>
