    <text>
        <body>
            <div xml:id="d440">

                <pb facs="0753" n="633" sameAs="frus:frus1932v01/pg633"/>

                <note rend="inline" type="source">800.51W89 Poland/78a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Chargé in Poland (Flack)</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 333</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1932-06-28">June 28, 1932</date>.</dateline>
                </opener>
                <p>The Secretary of State refers to previous correspondence regarding the
                    President’s Proposal of June 20, 1931, for postponement of inter-governmental
                        <pb facs="0754" n="634" xml:id="pg634"/> debts and transmits for the
                    information of the American Chargé d’Affaires copy of the “Agreement between the
                    Republic of Poland and the United States of America, June 10, 1932”.<anchor
                        n="63" xml:id="d440-f1"/>
                </p>
            </div>
        </body>
    </text>
