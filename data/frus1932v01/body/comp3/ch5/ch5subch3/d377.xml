    <text>
        <body>
            <div xml:id="d377">

                <pb facs="0715" n="595" sameAs="frus:frus1932v01/pg595"/>

                <note rend="inline" type="source">800.51W89 Czechoslovakia/188a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Chargé in Czechoslovakia (Hibbard)</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 165</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1932-06-27">June 27, 1932</date>.</dateline>
                </opener>
                <p>The Secretary of State refers to previous correspondence regarding the
                    President’s Proposal of June 20, 1931, for postponement of intergovernmental
                    debts and transmits for the information of the American Chargé d’Affaires copy
                    of the “Agreement between the Czechoslovak Republic and the United States of
                    America, June 10, 1932”.<anchor n="25" xml:id="d377-f1"/>
                </p>
            </div>
        </body>
    </text>
