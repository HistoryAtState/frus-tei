    <text>
        <body>
            <div xml:id="d441">

                <pb facs="0754" n="634" sameAs="frus:frus1932v01/pg634"/>

                <note rend="inline" type="source">800.51W89 Rumania/148a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in Rumania
                        (Wilson)</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 248</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1932-06-28">June 28, 1932</date>.</dateline>
                </opener>
                <p>The Secretary of State refers to previous correspondence regarding the
                    President’s Proposal of June 20, 1931, for postponement of intergovernmental
                    debts and transmits for the information of the American Minister copy of the
                    “Agreement between the Kingdom of Rumania and the United States of America, June
                    11, 1932”.<anchor n="64" xml:id="d441-f1"/>
                </p>
            </div>
        </body>
    </text>
