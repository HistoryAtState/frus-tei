    <text>
        <body>
            <div xml:id="d5">

                <pb facs="0136" n="4" sameAs="frus:frus1926v01/pg4"/>

                <note rend="inline" type="source">500.C114/445d</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Ambassador in Belgium</hi> (<hi rendition="#italic"
                            >Phillips</hi>)<anchor n="9" xml:id="d5-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1926-02-12"><hi rendition="#italic">February 12,
                        1926</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 226</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I am enclosing, for transmission to Baron
                    Raymond de Waha, still accredited as Chargé d’Affaires of Luxemburg to the
                    United States, a note<anchor n="10" xml:id="d5-f2"/> concerning the conditions,
                    reservations and understandings contained in the Resolution of the Senate, dated
                    January 27, 1926, for the adherence by the United States to the Protocol of
                    Signature and Statute of the Permanent Court of International Justice.</p>
                <p>I am [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Frank B. Kellogg</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d5-f1" n="9" type="source" xml:id="d5-f1-content">
                <p>Also Minister to Luxemburg.</p>
            </note>
            <note corresp="#d5-f2" n="10" xml:id="d5-f2-content">
                <p>Text identical with that of the note to the Austrian Minister, February 12, <ref
                        target="#pg3">p. 3</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
