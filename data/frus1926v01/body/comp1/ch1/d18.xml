    <text>
        <body>
            <div xml:id="d18">

                <pb facs="0145" n="13" sameAs="frus:frus1926v01/pg13"/>

                <note rend="inline" type="source">500.C114/445c</note>
                <head><hi rendition="#italic">The Chargé in Liberia</hi> (<hi rendition="#italic"
                        >Clark</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Monrovia</hi></placeName>, <date calendar="gregorian"
                            when="1926-05-12"><hi rendition="#italic">May 12,
                        1926</hi></date>.<lb/>[Received June 17.]</dateline>
                    <seg rendition="#float-left">No. 370</seg>
                    <lb/>
                    <seg rendition="#float-left">Diplomatic</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to refer to the
                    Department’s instruction No. 270 of February 12, 1926,<anchor n="22"
                        xml:id="d18-f1"/> and, in confirmation of my telegram of this date,<anchor
                        n="23" xml:id="d18-f2"/> to enclose herewith in duplicate a certified true
                    copy of the Liberian Government’s reply to my note of May 7, 1926, with
                    reference <pb facs="0146" n="14" xml:id="pg14"/> to the acceptance by the
                    Liberian Government of the conditions, reservations and understandings contained
                    in the Senate Resolution of January 27, 1926.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Reed Paige Clark</hi></signed></closer>


                <xi:include href="d18-a1.xml" xpointer="d18-a1"/>
            </div>
        </body>
    </text>
