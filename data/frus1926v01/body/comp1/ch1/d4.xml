    <text>
        <body>
            <div xml:id="d4">

                <pb facs="0136" n="4" sameAs="frus:frus1926v01/pg4"/>

                <note rend="inline" type="source">500.C114/445b</note>
                <head><hi rendition="#italic">The Secretary of State to the Minister in Albania</hi>
                        (<hi rendition="#italic">Hart</hi>)<anchor n="8" xml:id="d4-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1926-02-12"><hi rendition="#italic">February 12,
                        1926</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 25</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: You should address the following note to
                    the Minister of Foreign Affairs:</p>
                <p>[Here follows the text of the note, which is the same as the note of February 12
                    to the Austrian Minister, printed <hi rendition="#italic">supra</hi>.]</p>
                <p>Upon the receipt of a reply from the Albanian Government you will communicate a
                    brief resume by telegram and a certified true copy of the note by mail.</p>
                <p>I am [etc.]</p>
                <closer>[<signed><hi rendition="#small-caps">Frank B.
                    Kellogg</hi></signed>]</closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d4-f1" n="8" type="source" xml:id="d4-f1-content">
                <p>Same, <hi rendition="#italic">mutatis mutandis</hi>, on the same date, to the
                    American Chargé in Liberia as Department’s No. 270.</p>
            </note>
        </listAnnotation>
    </standOff>
