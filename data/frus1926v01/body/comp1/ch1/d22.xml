                <pb facs="0148" n="16" sameAs="frus:frus1926v01/pg16"/>

                <note rend="inline" type="source">500.C114/445b</note>
                <head><hi rendition="#italic">The Albanian Minister</hi> (<hi
                            rendition="#italic">Konitza</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1926-08-20"><hi rendition="#italic">August 20,
                        1926</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to confirm that my
                    Government has approved the United States reservations for adherence to the
                    Permanent Court of International Justice. The Albanian delegate to the League of
                    Nations has received instructions in accordance with this decision.</p>
                <p>I beg [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Faik Konitza</hi></signed></closer>
            </div>
        </body>
    </text>
