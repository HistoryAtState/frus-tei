            <div xml:id="d7">

                <pb facs="0137" n="5" sameAs="frus:frus1926v01/pg5"/>

                <note rend="inline" type="source">500.C114/388</note>
                <head><hi rendition="#italic">The Secretary of State to the Minister in
                        Switzerland</hi> (<hi rendition="#italic">Gibson</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1926-03-02"><hi rendition="#italic">March 2,
                        1926</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 388</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: There is enclosed, for transmission in the
                    usual manner, a Note to the Secretary General of the League of Nations,
                    regarding the resolution of the Senate concerning the conditions of the adhesion
                    by this Government to the Protocol and Statute of the Permanent Court of
                    International Justice.</p>
                <p>I am [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Frank B. Kellogg</hi></signed></closer>


                <xi:include href="d7-a1.xml" xpointer="d7-a1"/>
