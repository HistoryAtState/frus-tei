    <text>
        <body>
            <div xml:id="d382">

                <pb facs="0678" n="546" xml:id="pg546"/>

                <note rend="inline" type="source">738.3915/299</note>
                <head><hi rendition="#italic">The Minister in the Dominican Republic</hi> (<hi
                        rendition="#italic">Young</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Santo Domingo</hi></placeName>, <date calendar="gregorian"
                            when="1926-11-30"><hi rendition="#italic">November 30,
                        1926</hi></date>.<lb/>[Received December 8.]</dateline>
                    <seg rendition="#float-left">No. 348</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to forward herewith for
                    the Department’s confidential information a copy of a memorandum of a
                    conversation which I had yesterday with the Haitian Minister in regard to the
                    boundary question.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Evan E. Young</hi></signed></closer>


                <xi:include href="d382-a1.xml" xpointer="d382-a1"/>
