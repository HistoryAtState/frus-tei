                <note rend="inline" type="source">500.A15/369: Telegram</note>
                <head><hi rendition="#italic">The American Delegate on the Preparatory
                        Commission</hi> (<hi rendition="#italic"
                        >Gibson</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Geneva</hi></placeName>, <date calendar="gregorian"
                            when="1926-09-20T11:00:00+01:00"><hi rendition="#italic">September 20,
                                1926—11 a.m.</hi></date><lb/>[Received 2:05 a.m.
                    (p.m.?)]</dateline></opener>
                <p>105. My 103, September 17, 10 a.m.<anchor n="1" xml:id="d85-f1"/> Preparatory
                    Commission summoned to meet September 22, 10 a.m.</p>
                <closer><signed><hi rendition="#small-caps">Gibson</hi></signed></closer>
            </div>
        </body>
    </text>
