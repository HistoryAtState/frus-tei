    <text>
        <body>
            <div xml:id="d96">

                <pb facs="0257" n="125" xml:id="pg125"/>

                <note rend="inline" type="source">462.00 R 29/4138: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic">Herrick</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1927-02-01T14:00:00+00:00"><hi rendition="#italic">February 1,
                                1927—2 p.m.</hi></date><lb/>[Received February 1—9:13
                        a.m.]</dateline></opener>
                <p>42. Reparation 1. Wilson has taken over reparation work from Hill as of
                        today.<anchor n="15" xml:id="d96-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Herrick</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d96-f1" n="15" xml:id="d96-f1-content">
                <p>The transfer of the office to the Embassy was effected February 28.</p>
            </note>
        </listAnnotation>
    </standOff>
