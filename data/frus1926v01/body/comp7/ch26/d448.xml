                <pb facs="0745" n="613" sameAs="frus:frus1926v01/pg613"/>

                <note rend="inline" type="source">893.00/7328: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">MacMurray</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1926-04-15T20:00:00+08:00"><hi rendition="#italic">April 15,
                                1926—8 p.m.</hi></date><lb/>[Received April 15—11:10
                        a.m.]</dateline></opener>
                <p>178. My telegram number 177, April 15, 2 p.m.</p>
                <list>
                    <label>1.</label>
                    <item>Tungchow was occupied this morning by Fengtien troops. Kuominchun is
                        withdrawing from Peking and has turned over control of police to committee
                        of safety.</item>
                    <label>2.</label>
                    <item>Repeated to Tokyo.</item>
                </list>
                <closer><signed><hi rendition="#small-caps">MacMurray</hi></signed></closer>
            </div>
        </body>
    </text>
