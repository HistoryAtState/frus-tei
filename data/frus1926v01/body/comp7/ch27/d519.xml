                <pb facs="0789" n="657" sameAs="frus:frus1926v01/pg657"/>

                <note rend="inline" type="source">893.00/7888: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">MacMurray</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1926-12-01T17:00:00+08:00"><hi rendition="#italic">December 1,
                                1926—5 p.m.</hi></date><lb/>[Received December 1—8:42
                        a.m.]</dateline></opener>
                <p>592. My 587, November 30, 7 p.m. Commander in chief has ordered warship to
                    proceed Foochow.</p>
                <closer><signed><hi rendition="#small-caps">MacMurray</hi></signed></closer>
            </div>
        </body>
    </text>
