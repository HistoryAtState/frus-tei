                <pb facs="0760" n="628" sameAs="frus:frus1926v01/pg628"/>

                <note rend="inline" type="source">893.00/7636: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Chargé in China</hi> (<hi
                            rendition="#italic">Mayer</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1926-09-14T17:00:00-04:00"><hi rendition="#italic">September 14,
                                1926—5 p.m.</hi></date></dateline></opener>
                <p>192. Your 400, September 14, 5 p.m. Instructions to consul at Swatow referred to
                    in paragraph 2 are approved. See in this connection your 447 of October 16, 7
                    p.m., 1925, and Department’s 308 of October 29, 6 p.m.<anchor n="27"
                        xml:id="d478-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Grew</hi></signed></closer>
            </div>
        </body>
    </text>
