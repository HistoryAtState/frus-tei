                <pb facs="0859" n="727" sameAs="frus:frus1926v01/pg727"/>

                <note rend="inline" type="source">893.5045/376: Telegram</note>
                <head><hi rendition="#italic">The Chargé in China</hi> (<hi
                            rendition="#italic">Mayer</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1926-09-14T16:00:00+08:00"><hi rendition="#italic">September 14,
                                1926—4 p.m.</hi></date><lb/>[Received September 14—9:27
                        a.m.]</dateline></opener>
                <p>399. Following radiogram received by American naval attaché from U. S. S. <hi
                        rendition="#italic">Sacramento</hi> at Swatow, September 14th.</p>
                <quote rend="blockquote">
                    <p>“After September 11th the British discontinued campaigns against the striking
                        pickets of the Canton River. Negotiations concerning removal of boycott are
                        to be resumed between the British and Canton Governments.”</p>
                </quote>
                <closer><signed><hi rendition="#small-caps">Mayer</hi></signed></closer>
            </div>
        </body>
    </text>
