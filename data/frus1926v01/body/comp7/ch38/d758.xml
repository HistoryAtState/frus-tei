    <text>
        <body>
            <div xml:id="d758">

                <pb facs="1115" n="983" sameAs="frus:frus1926v01/pg983"/>

                <note rend="inline" type="source">793.003 C 73/351: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Minister in China</hi> (<hi
                            rendition="#italic">MacMurray</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1926-11-27T20:00:00-05:00"><hi rendition="#italic">November 27,
                                1926—8 p.m.</hi></date></dateline></opener>
                <p>285. Department is publishing report of Extraterritorial[ity] Commission on
                    November 29.<anchor n="69" xml:id="d758-f1"/> This date has been notified to
                    other <pb facs="1116" n="984" xml:id="pg984"/> governments concerned and it is
                    understood that publication will be made in other capitals on same date except
                    in London where there has been delay due to lateness of receiving report and
                    getting it printed.</p>
                <closer><signed><hi rendition="#small-caps">Grew</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d758-f1" n="69" xml:id="d758-f1-content">
                <p>Department of State, <hi rendition="#italic">Report of the Commission on
                        Extraterritoriality in China, Peking, September 16, 1926</hi> (Washington,
                    Government Printing Office, 1926).</p>
            </note>
