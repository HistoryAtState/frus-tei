    <text>
        <body>
            <div xml:id="d853">

                <pb facs="1231" n="1099" xml:id="pg1099"/>

                <note rend="inline" type="source">701.6193/85: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">MacMurray</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1926-09-01T20:00:00+08:00"><hi rendition="#italic">September 1,
                                1926—8 p.m.</hi></date><lb/>[Received September 1—11:12
                        a.m.]</dateline></opener>
                <p>367. My 331, August 18, noon. I am informed by Admiral Tsai that Karakhan, in
                    consequence of Chinese representations, is to be withdrawn in a few days from
                        Peking.<anchor n="98" xml:id="d853-f1"/></p>
                <closer><signed><hi rendition="#small-caps">MacMurray</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d853-f1" n="98" xml:id="d853-f1-content">
                <p>L. Karakhan, Soviet Ambassador in China, sailed from Shanghai Sept. 26, 1926.</p>
            </note>
        </listAnnotation>
    </standOff>
