    <text>
        <body>
            <div xml:id="d95">

                <pb facs="0192" n="94" sameAs="frus:frus1920v01/pg94"/>

                <note rend="inline" type="source">551.A1/34: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Davis</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1920-08-13T13:00:00+01:00"><hi rendition="#italic">August 13,
                                1920—1 p.m.</hi></date><lb/>[Received August 13—9:50
                        a.m.]</dateline></opener>
                <p>1222. My 1015, July 2, noon.<anchor n="69" xml:id="d95-f1"/> Drummond now informs
                    me date of Brussels International Financial Conference has been fixed for
                    September 24th.</p>
                <closer><signed><hi rendition="#small-caps">Davis</hi></signed></closer>
            </div>
        </body>
    </text>
