                <pb facs="0192" n="94" sameAs="frus:frus1920v01/pg94"/>

                <note rend="inline" type="source">551.A1/20: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Davis</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1920-06-08T19:00:00+01:00"><hi rendition="#italic">June 8, 1920—7
                                p.m.</hi></date><lb/>[Received June 8—2:23 p.m.]</dateline></opener>
                <p>913. Your 562, May 28, 5 p.m., communicated to Drummond May 29th. He replies that
                    Conference will probably not take place before middle of July.</p>
                <closer><signed><hi rendition="#small-caps">Davis</hi></signed></closer>
            </div>
        </body>
