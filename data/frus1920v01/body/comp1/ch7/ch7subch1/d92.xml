    <text>
        <body>
            <div xml:id="d92">

                <pb facs="0189" n="91" sameAs="frus:frus1920v01/pg91"/>

                <note rend="inline" type="source">551.A1/9</note>
                <head><hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Davis</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1920-04-19"><hi rendition="#italic">April 19,
                        1920</hi></date>.<lb/>[Received May 1.]</dateline>
                    <seg rendition="#float-left">No. 2686</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to refer to my telegram
                    No. 627 of April 16th,<anchor n="65" xml:id="d92-f1"/> transmitting an
                    invitation from the Council of the League of Nations to the United States
                    Government to be represented or associated in the coming International
                    Conference to study financial conditions. The full text of the invitation is
                    transmitted herewith.<anchor n="66" xml:id="d92-f2"/></p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">John W. Davis</hi></signed></closer>




                <xi:include href="d92-a1.xml" xpointer="d92-a1"/>
                <xi:include href="d92-a2.xml" xpointer="d92-a2"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d92-f1" n="65" xml:id="d92-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d92-f2" n="66" xml:id="d92-f2-content">
                <p>The two enclosures printed <hi rendition="#italic">infra</hi> were transmitted by
                    the Secretary General of the League of Nations to the American Ambassador in
                    Great Britain in a covering letter dated Apr. 15 (not printed).</p>
            </note>
        </listAnnotation>
    </standOff>
