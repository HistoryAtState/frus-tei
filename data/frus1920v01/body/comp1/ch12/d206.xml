            <div xml:id="d206">

                <pb facs="0316" n="218" sameAs="frus:frus1920v01/pg218"/>

                <note rend="inline" type="source">710.D4/188</note>
                <head><hi rendition="#italic">The Argentine Ambassador</hi> (<hi rendition="#italic">Le Breton</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><seg rendition="#center">[Translation]</seg></opener>
                <opener><seg rendition="#float-left">No. 37</seg></opener>
                <p rendition="#center"><hi rendition="#small-caps">Note Verbale</hi></p>
                <p>The Argentine Ambassador presents his compliments to His Excellency the Secretary
                    of State, and takes pleasure in forwarding to him the enclosed papers which the
                    Ministry of Foreign Relations and Worship of the Argentine Republic places in
                    Your Excellency’s hands through the Embassy.</p>
                <closer>
                    <dateline rendition="#float-left">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1920-07-12"><hi
                                rendition="#italic">July 12, 1920</hi></date>.</dateline>
                </closer>



                <xi:include href="d206-a1.xml" xpointer="d206-a1"/>
