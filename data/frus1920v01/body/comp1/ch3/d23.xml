                <pb facs="0111" n="13" sameAs="frus:frus1920v01/pg13"/>

                <note rend="inline" type="source">500.C114/22: Telegram</note>
                <head><hi rendition="#italic">The Minister in the Netherlands</hi> (<hi
                        rendition="#italic">Phillips</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >The Hague</hi></placeName>, <date calendar="gregorian"
                            when="1920-05-26T13:00:00+01:19"><hi rendition="#italic">May 26, 1920—1
                                p.m.</hi></date><lb/>[Received 5:54 p.m.]</dateline></opener>
                <p>88. My 87 May 25th. Please advise in what capacity Mr. Root attends forthcoming
                    international conference at The Hague.</p>
                <closer><signed><hi rendition="#small-caps">Phillips</hi></signed></closer>
            </div>
        </body>
