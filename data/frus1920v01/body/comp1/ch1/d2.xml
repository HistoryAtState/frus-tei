                <pb facs="0099" n="1" sameAs="frus:frus1920v01/pg1"/>

                <note rend="inline" type="source">763.72119/8937: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Ambassador in Great
                        Britain</hi> (<hi rendition="#italic">Davis</hi>)</head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-02-09T17:00:00-05:00"><hi rendition="#italic">February 9,
                                1920—5 p.m.</hi></date></dateline></opener>
                <p>124. Your 205 of February 6. The President does not wish you to attend London
                    meeting of Premiers in any capacity even if you should be invited.</p>
                <closer><signed><hi rendition="#small-caps">Lansing</hi></signed></closer>
            </div>
        </body>
