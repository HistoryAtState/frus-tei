    <text>
        <body>
            <div xml:id="d284">

                <pb facs="0381" n="283" sameAs="frus:frus1920v01/pg283"/>

                <note rend="inline" type="source">860C.48/400</note>
                <head><hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Davis</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1920-06-25"><hi rendition="#italic">June 25,
                        1920</hi></date>.<lb/>[Received July 14.]</dateline>
                    <seg rendition="#float-left">No. 3079</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: At the request of the Secretary-General of
                    the League of Nations, I have the honor to transmit herewith enclosed documents
                    Nos. 20/31/36A and 20/41/16<anchor n="33" xml:id="d284-f1"/> regarding the
                    Typhus situation in Poland.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">John W. Davis</hi></signed></closer>


                <xi:include href="d284-a1.xml" xpointer="d284-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d284-f1" n="33" xml:id="d284-f1-content">
                <p>The latter not printed.</p>
            </note>
        </listAnnotation>
