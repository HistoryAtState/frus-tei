                <pb facs="0337" n="239" sameAs="frus:frus1920v01/pg239"/>

                <note rend="inline" type="source">860c.48/282a: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Commission to Negotiate
                        Peace</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1919-11-17T18:00:00-05:00"><hi rendition="#italic">November 17,
                                1919—6 p.m.</hi></date></dateline></opener>
                <p>3797. For Polk.</p>
                <p>President authorized Julius H. Barnes, United States Wheat Director and President
                    Grain Corporation, to sell to Polish Government on credit or otherwise 100,000
                    tons of wheat and wheat flour. Please inform Warsaw.</p>
                <closer><signed><hi rendition="#small-caps">Lansing</hi></signed></closer>
            </div>
        </body>
