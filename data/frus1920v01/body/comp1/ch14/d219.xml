    <text>
        <body>
            <div xml:id="d219">

                <pb facs="0328" n="230" sameAs="frus:frus1920v01/pg230"/>

                <note rend="inline" type="source">033.1132/16: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Argentina</hi> (<hi rendition="#italic"
                        >Wadsworth</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Buenos Aires</hi></placeName>, <date calendar="gregorian"
                            when="1920-11-05T12:00:00-04:00"><hi rendition="#italic">November 5,
                                1920—noon</hi></date>.<lb/>[Received 2 p.m.]</dateline></opener>
                <p>242. Your 118 and 123, and my 239.<anchor n="86" xml:id="d219-f1"/> Reply has
                    been made through the Foreign Office that the Government of Argentina will
                    receive the visit of the Secretary of State with the greatest pleasure.</p>
                <closer><signed><hi rendition="#small-caps">Wadsworth</hi></signed></closer>
            </div>
        </body>
    </text>
