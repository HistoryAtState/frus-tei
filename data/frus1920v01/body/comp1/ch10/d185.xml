                <pb facs="0300" n="202" sameAs="frus:frus1920v01/pg202"/>

                <note rend="inline" type="source">511.3B1/15</note>
                <head><hi rendition="#italic">The British Chargé</hi> (<hi
                            rendition="#italic">Lindsay</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-01-22"><hi rendition="#italic">January 22,
                        1920</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 51</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to previous correspondence
                    on the subject of the Arms Traffic Convention, I have the honour to inform you
                    that I have received a communication from my Government stating that they
                    propose in the future to inform the Japanese Government whenever they request a
                    non-signatory Power to sign the Convention or to give a guarantee to observe its
                    conditions and whenever they receive notification that a guarantee has been
                    given or the Convention signed.</p>
                <p>His Majesty’s Government express the hope that the United States Government will
                    adopt similar measures.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">R. C. Lindsay</hi></signed></closer>
            </div>
        </body>
    </text>
