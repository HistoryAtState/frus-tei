                            <placeName>Saint-Germain-en-Laye</placeName>,<anchor n="55"
                            xml:id="d174-f1"/> in a single copy, <date calendar="gregorian"
                            when="1919-09-10">the tenth day of September, one thousand nine hundred
                            and nineteen</date>.</dateline>
