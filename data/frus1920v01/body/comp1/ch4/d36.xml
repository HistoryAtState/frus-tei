            <div xml:id="d36">

                <pb facs="0133" n="35" xml:id="pg35"/>

                <note rend="inline" type="source">758.6114AI/135a: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Ambassador in France</hi> (<hi
                            rendition="#italic">Wallace</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-10-09T14:00:00-04:00"><hi rendition="#italic">October 9,
                                1920—2 p.m.</hi></date></dateline></opener>
                <p>1546. Your 1778, October 5, 9 p.m.</p>
                <p>You may informally advise Professor Mantoux that the President would consider
                    favorably request to nominate an American for appointment on the Committee.</p>
                <closer><signed><hi rendition="#small-caps">Davis</hi></signed></closer>
            </div>
        </body>
