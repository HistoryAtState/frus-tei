    <text>
        <body>
            <div xml:id="d140">

                <pb facs="0230" n="132" sameAs="frus:frus1920v01/pg132"/>

                <note rend="inline" type="source">574.D1/198a</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the British Ambassador</hi> (<hi
                            rendition="#italic">Geddes</hi>)<anchor n="12"
                        xml:id="d140-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-10-07"><hi rendition="#italic">October 7,
                        1920</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I have the honor to advise you that
                    the first meeting of the International Conference on Communications will be held
                    in the Reception Room of the Department of State at 3:00 o’clock Friday
                        afternoon.<anchor n="13" xml:id="d140-f2"/></p>
                <p>Accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Norman H. Davis</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d140-f1" n="12" type="source" xml:id="d140-f1-content">
                <p>The same note to the Italian and Japanese Ambassadors; a <hi rendition="#italic"
                        >note verbale</hi>, in similar terms, was addressed to the French
                    Embassy.</p>
            </note>
            <note corresp="#d140-f2" n="13" xml:id="d140-f2-content">
                <p>Oct. 8.</p>
            </note>
        </listAnnotation>
    </standOff>
