            <div xml:id="d157">

                <pb facs="0260" n="162" sameAs="frus:frus1920v01/pg162"/>

                <note rend="inline" type="source">574.D1/411a</note>
                <head><hi rendition="#italic">Report of Subcommittee on Improvement of Communication
                        Facilities between the Five Principal Allied and Associated
                    Powers</hi></head>
                <dateline>
                    <date ana="#date_undated-inferred-from-sibling-dates" calendar="gregorian"
                        notAfter="1920-12-14T23:59:59-05:00" notBefore="1920-12-10T00:00:00-05:00"
                        >undated</date>
                </dateline>
                <p rendition="#flush">To the Honorable <hi rendition="#small-caps">Norman H.
                        Davis</hi>, <hi rendition="#italic">President</hi><lb/><hi
                        rendition="#italic">Preliminary Conference on Electrical
                    Communications</hi>.</p>
                <p>The Subcommittee on Improvement of Communication Facilities between the Five
                    Principal Allied and Associated Powers begs to report that it has held ten
                    meetings, and has unanimously agreed to the appended fifteen (15) <hi
                        rendition="#italic">voeux</hi> which it recommends for adoption by the
                    Conference.</p>
                <closer><signed><hi rendition="#small-caps">E. Lanel</hi></signed><lb/><hi
                        rendition="#italic">Chairman</hi></closer>


                <xi:include href="d157-a1.xml" xpointer="d157-a1"/>
