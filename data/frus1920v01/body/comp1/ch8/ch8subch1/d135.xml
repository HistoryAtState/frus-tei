            <div xml:id="d135">

                <pb facs="0227" n="129" sameAs="frus:frus1920v01/pg129"/>

                <note rend="inline" type="source">574.D1/139a</note>
                <head><hi rendition="#italic">The Secretary of State to the Japanese Ambassador</hi>
                        (<hi rendition="#italic">Shidehara</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-09-15"><hi rendition="#italic">September 15,
                        1920</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I have the honor to inform you that,
                    at the instance of the French Government, and owing to the fact that the French
                    delegation, as well as the English delegation, will not arrive at Washington in
                    time for the Preliminary Conference on Communications scheduled for September
                    fifteen, it has been found necessary to postpone the opening of this Conference
                    until October eight.</p>
                <p>Accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Bainbridge Colby</hi></signed></closer>
            </div>
        </body>
