                <pb facs="0226" n="128" sameAs="frus:frus1920v01/pg128"/>

                <note rend="inline" type="source">574.D1/103: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Ambassador in Great Britain</hi> (<hi
                            rendition="#italic">Davis</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-08-12T17:00:00-04:00"><hi rendition="#italic">August 12,
                                1920—5 p.m.</hi></date></dateline></opener>
                <p>878. Your 1192, August 9th, 4 p.m.</p>
                <p>This Government concurs with British Government’s suggestion that Main Conference
                    be postponed and date of its convocation be determined by agreement at
                    Preliminary Conference.</p>
                <closer><signed><hi rendition="#small-caps">Colby</hi></signed></closer>
            </div>
        </body>
