    <text>
        <body>
            <div xml:id="d124">

                <pb facs="0220" n="122" sameAs="frus:frus1920v01/pg122"/>

                <note rend="inline" type="source">574.D1/51: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Japan</hi> (<hi rendition="#italic"
                        >Bell</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Tokyo</hi></placeName>, <date calendar="gregorian"
                            when="1920-05-31T13:00:00+09:00"><hi rendition="#italic">May 31, 1920—1
                                p.m.</hi></date><lb/>[Received May 31—4:36 a.m.]</dateline></opener>
                <p>271. Department’s 133, April 8, 5 p.m.<anchor n="98" xml:id="d124-f1"/> Japanese
                    Government has decided to send a representative to Preliminary Conference August
                    1st, provided that the majority of the Principal Allied and Associated
                    Governments participate in Preliminary Conference.</p>
                <closer><signed><hi rendition="#small-caps">Bell</hi></signed></closer>
            </div>
        </body>
    </text>
