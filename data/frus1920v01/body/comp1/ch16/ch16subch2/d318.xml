                <pb facs="0414" n="316" sameAs="frus:frus1920v01/pg316"/>

                <note rend="inline" type="source">714.1515/319: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Minister in
                        Guatemala</hi> (<hi rendition="#italic">McMillin</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-07-02T17:00:00-04:00"><hi rendition="#italic">July 2, 1920—5
                                p.m.</hi></date></dateline></opener>
                <p>57. Department’s 13 February 28, 1 p.m.<anchor n="64" xml:id="d318-f1"/> Please
                    ascertain discreetly President Herrera’s attitude towards proposal.</p>
                <closer><signed><hi rendition="#small-caps">Davis</hi></signed></closer>
            </div>
        </body>
    </text>
