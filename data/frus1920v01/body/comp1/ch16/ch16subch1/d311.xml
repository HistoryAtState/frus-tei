    <text>
        <body>
            <div xml:id="d311">

                <pb facs="0406" n="308" xml:id="pg308"/>

                <note rend="inline" type="source">738.3915/218</note>
                <head><hi rendition="#italic">The Minister in the Dominican Republic</hi> (<hi rendition="#italic">Russell</hi>) <hi
                        rendition="#italic">to the Acting Secretary of
                            State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Santo Domingo</hi></placeName>, <date calendar="gregorian"
                            when="1920-12-03"><hi rendition="#italic">December 3,
                        1920</hi></date>.<lb/>[Received December 28.]</dateline>
                    <seg rendition="#float-left">No. 641</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith the
                    following documents in regard to the settlement of the Dominican-Haitian
                    boundary question:—</p>
                <p>Copy of the final project of the protocol.</p>
                <p>Copy of the note from the Foreign Office of the Dominican Government in
                    transmitting the above to the Haitian Minister.<anchor n="56" xml:id="d311-f1"
                    /></p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">William W.
                    Russell</hi></signed></closer>


                <xi:include href="d311-a1.xml" xpointer="d311-a1"/>
            </div>
        </body>
    </text>
