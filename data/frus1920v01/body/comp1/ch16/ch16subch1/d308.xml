    <text>
        <body>
            <div xml:id="d308">

                <pb facs="0402" n="304" sameAs="frus:frus1920v01/pg304"/>

                <note rend="inline" type="source">738.3915/213</note>
                <head><hi rendition="#italic">The Minister in the Dominican Republic</hi> (<hi
                        rendition="#italic">Russell</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Santo Domingo</hi></placeName>, <date calendar="gregorian"
                            when="1920-08-12"><hi rendition="#italic">August 12,
                        1920</hi></date>.<lb/>[Received August 31.]</dateline>
                    <seg rendition="#float-left">No. 598</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith a copy
                    and translation of a note to this Legation from the Ministry of Foreign Affairs
                    in regard to the proposed protocol for the arbitration of the boundary question
                    with the Haitian Republic, and to request that telegraphic instructions be sent
                    relative to the reply to be made by the Dominican Government to the amendments
                    proposed by Haiti.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">William W.
                    Russell</hi></signed></closer>




