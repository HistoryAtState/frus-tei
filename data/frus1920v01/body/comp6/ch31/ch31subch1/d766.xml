            <div xml:id="d766">

                <pb facs="0833" n="735" sameAs="frus:frus1920v01/pg735"/>

                <note rend="inline" type="source">693.003/589</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >Crane</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1920-09-20"><hi rendition="#italic">September 20,
                        1920</hi></date>.<lb/>[Received October 27.]</dateline>
                    <seg rendition="#float-left">No. 225</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith a
                    copy of a Note dated June 12, 1920 from the Chinese Foreign Office respecting
                    the limitation of duration of inward transit passes, together with a copy of my
                    reply thereto of September 18th, 1920.</p>
                <p>There is likewise enclosed copy of Dean Circular No. 162 on the subject.<anchor
                        n="86" xml:id="d766-f1"/></p>
                <p>I have [etc.]</p>
                <closer>(For the Minister)<lb/><signed><hi rendition="#small-caps">A. B.
                            Ruddock</hi></signed></closer>




                <xi:include href="d766-a1.xml" xpointer="d766-a1"/>
                <xi:include href="d766-a2.xml" xpointer="d766-a2"/>
            </div>
