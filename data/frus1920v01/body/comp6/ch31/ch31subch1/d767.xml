                <pb facs="0835" n="737" sameAs="frus:frus1920v01/pg737"/>

                <note rend="inline" type="source">693.003/589</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Minister in China</hi> (<hi rendition="#italic"
                            >Crane</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-11-08"><hi rendition="#italic">November 8,
                        1920</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 62</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: The Department has received your despatch
                    No. 225 of September 20, 1920, enclosing a copy of your communication to the
                    Chinese Foreign Office objecting to the enforcement at the present time of any
                    time limitation on inward Transit Passes in view of transportation difficulties
                    in the Chinese interior. The Department approves of your action in this
                    matter.</p>
                <closer>For the Secretary of State:<lb/><signed><hi rendition="#small-caps">Alvey A.
                            Adee</hi></signed></closer>
            </div>
