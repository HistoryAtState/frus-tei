                <pb facs="0916" n="818" sameAs="frus:frus1920v01/pg818"/>

                <note rend="inline" type="source">793.94/1094</note>
                <head><hi rendition="#italic">The Chargé in Japan</hi> (<hi rendition="#italic"
                        >Bell</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Tokyo</hi></placeName>, <date calendar="gregorian"
                            when="1920-06-17"><hi rendition="#italic">June 17,
                        1920</hi></date>.<lb/>[Received July 22.]</dateline>
                    <seg rendition="#float-left">No. 594</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith the
                    full text of the Foreign Office statement referred to in my telegram Number 301,
                    June 16, 6 P.M.<anchor n="60" xml:id="d867-f1"/></p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Edward Bell</hi></signed></closer>


                <xi:include href="d867-a1.xml" xpointer="d867-a1"/>
            </div>
        </body>
    </text>
