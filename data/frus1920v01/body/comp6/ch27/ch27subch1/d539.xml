    <text>
        <body>
            <div xml:id="d539">

                <pb facs="0653" n="555" xml:id="pg555"/>

                <note rend="inline" type="source">893.51/2879: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic"
                        >Wallace</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1920-07-20T19:00:00+01:00"><hi rendition="#italic">July 20, 1920—7
                                p.m.</hi></date><lb/>[Received 7:40 p.m.]</dateline></opener>
                <p>1414. Your 1227.<anchor n="63" xml:id="d539-f1"/> The French Government has
                    instructed its representative at Tokyo to notify the Japanese Government of its
                    approval of the contents of letters exchanged between Lamont and the Japanese
                    banking group.</p>
                <closer><signed><hi rendition="#small-caps">Wallace</hi></signed></closer>
            </div>
        </body>
    </text>
