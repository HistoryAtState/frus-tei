                <pb facs="0643" n="545" sameAs="frus:frus1920v01/pg545"/>

                <note rend="inline" type="source">893.51/2851: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Minister in China</hi> (<hi
                            rendition="#italic">Crane</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-06-28T17:00:00-04:00"><hi rendition="#italic">June 28, 1920—5
                                p.m.</hi></date></dateline></opener>
                <p>156. Your 149, June 26, noon.</p>
                <p>Notes approved by this Government on March 30th. Tokyo is being instructed to
                    repeat to you Department’s 112, March 30, 5 p.m.<anchor n="32" xml:id="d526-f1"
                    /></p>
                <closer><signed><hi rendition="#small-caps">Davis</hi></signed></closer>
            </div>
        </body>
    </text>
