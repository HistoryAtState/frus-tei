            <div xml:id="d525">

                <pb facs="0643" n="545" xml:id="pg545"/>

                <note rend="inline" type="source">893.51/2851: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >Crane</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1920-06-26T12:00:00+08:00"><hi rendition="#italic">June 26,
                                1920—noon</hi></date>.<lb/>[Received June 26—6:47
                    a.m.]</dateline></opener>
                <p>149. Japanese Minister demands formal approval of all governments concerned to
                    notes exchanged between Lamont and Japanese group before the same are
                    communicated to the Chinese Government. Please telegraph approval. If no reply
                    is received by July 3d the Legation will assume that the notes are approved.</p>
                <closer><signed><hi rendition="#small-caps">Crane</hi></signed></closer>
            </div>
        </body>
    </text>
