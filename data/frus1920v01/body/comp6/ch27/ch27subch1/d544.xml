            <div xml:id="d544">

                <pb facs="0657" n="559" sameAs="frus:frus1920v01/pg559"/>

                <note rend="inline" type="source">893.51/2870: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Ambassador in Great
                        Britain</hi> (<hi rendition="#italic">Davis</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-07-24T17:00:00-04:00"><hi rendition="#italic">July 24, 1920—5
                                p.m.</hi></date></dateline></opener>
                <p>780. Your 1075, July 16, 5 p.m.</p>
                <p>Japanese Ambassador [<hi rendition="#italic">Chargé</hi>] communicated to the
                    Department of State October 8, 1919,<anchor n="66" xml:id="d544-f1"/> Japanese
                    Government’s acceptance of the formula submitted by the French Government in the
                    sense of the modified form as suggested by the American Government referred to
                    in your Despatch 1061 of July 21, 1919.<anchor n="67" xml:id="d544-f2"/></p>
                <closer><signed><hi rendition="#small-caps">Colby</hi></signed></closer>
            </div>
        </body>
    </text>
