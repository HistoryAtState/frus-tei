            <div xml:id="d556">

                <pb facs="0664" n="566" sameAs="frus:frus1920v01/pg566"/>

                <note rend="inline" type="source">893.51/2926: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Davis</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1920-08-13T14:00:00+01:00"><hi rendition="#italic">August 13,
                                1920—2 p.m.</hi></date><lb/>[Received August 13—10:47
                        a.m.]</dateline></opener>
                <p>1225. My 1216, August 12, 5 p.m.<anchor n="79" xml:id="d556-f1"/> Foreign Office
                    has now telegraphed Peking its approval of draft text of announcement to Chinese
                    Government concerning consortium. Paris informed.</p>
                <closer><signed><hi rendition="#small-caps">Davis</hi></signed></closer>
            </div>
        </body>
    </text>
