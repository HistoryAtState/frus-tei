    <text>
        <body>
            <div xml:id="d591">

                <pb facs="0701" n="603" xml:id="pg603"/>

                <note rend="inline" type="source">803.51/3279</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">Crane</hi>) <hi rendition="#italic">to
                        the Acting Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1921-01-19"><hi rendition="#italic">January 19,
                        1921</hi></date>.<lb/>[Received February 24.]</dateline>
                    <seg rendition="#float-left">No. 734</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to refer to the Legation’s
                    telegram No. 9, of January 6th, 7 p.m.,<anchor n="44" xml:id="d591-f1"/> and to
                    forward herewith copy of a note addressed to the Minister of Foreign Affairs
                    dated January 13th, 1921, and signed by the representatives of America, Great
                    Britain, France and Japan, signifying full approval of the four interested
                    Governments to the new Consortium.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Charles R. Crane</hi></signed></closer>


                <xi:include href="d591-a1.xml" xpointer="d591-a1"/>
            </div>
        </body>
    </text>
