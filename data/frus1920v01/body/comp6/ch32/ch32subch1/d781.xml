    <text>
        <body>
            <div xml:id="d781">

                <pb facs="0845" n="747" sameAs="frus:frus1920v01/pg747"/>

                <note rend="inline" type="source">693.119/351</note>
                <head><hi rendition="#italic">The Chief of the Far Eastern Division, Bureau of
                        Foreign and Domestic Commerce, Department of Commerce</hi> (<hi
                        rendition="#italic">Eldridge</hi>) <hi rendition="#italic">to the Assistant
                        Chief of the Division of Far Eastern Affairs, Department of State</hi> (<hi
                        rendition="#italic">Lockhart</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-09-10"><hi rendition="#italic">September 10,
                        1920</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Lockhart</hi>: We are enclosing herewith
                    copy of a report on aeroplanes in China, recently received from our Acting
                    Commercial Attaché, Peking, China, in which it is thought you might be
                    interested.</p>
                <p>Very truly yours,</p>
                <closer><signed><hi rendition="#small-caps">F. R. Eldridge</hi>,
                    Jr.</signed></closer>


                <xi:include href="d781-a1.xml" xpointer="d781-a1"/>
            </div>
