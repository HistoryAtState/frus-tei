                <pb facs="0848" n="750" sameAs="frus:frus1920v01/pg750"/>

                <note rend="inline" type="source">693.119/353: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Minister in China</hi>
                        (<hi rendition="#italic">Crane</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-10-01T11:00:00-04:00"><hi rendition="#italic">October 1,
                                1920—11 a.m.</hi></date></dateline></opener>
                <p>254. Report to Department substance of replies received by British, French and
                    Japanese Ministers to identic note quoted in your 267 of September 23, 6 p.m. In
                    the meantime take no further action.</p>
                <closer><signed><hi rendition="#small-caps">Colby</hi></signed></closer>
            </div>
        </body>
