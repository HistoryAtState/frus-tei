    <text>
        <body>
            <div xml:id="d776">

                <pb facs="0841" n="743" sameAs="frus:frus1920v01/pg743"/>

                <note rend="inline" type="source">693.119/330: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">Crane</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1920-06-24T18:00:00+08:00"><hi rendition="#italic">June 24, 1920—6
                                p.m.</hi></date><lb/>[Received June 24—6:06
                    p.m.]</dateline></opener>
                <p>147. Your June 18, 6 p.m.<anchor n="94" xml:id="d776-f1"/> In a note from Belgian
                    Chargé d’Affaires to the Chinese Foreign Office dated May 30, 1919 Belgium
                    announced its intention to withhold the exportation of munitions of war to China
                    as expressed in the terms of the joint declaration.</p>
                <closer><signed><hi rendition="#small-caps">Crane</hi></signed></closer>
            </div>
        </body>
    </text>
