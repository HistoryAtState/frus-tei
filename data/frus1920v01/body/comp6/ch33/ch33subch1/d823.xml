            <div xml:id="d823">

                <pb facs="0876" n="778" sameAs="frus:frus1920v01/pg778"/>

                <note rend="inline" type="source">761.93/159: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Minister in China</hi> (<hi rendition="#italic"
                            >Crane</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-11-16T18:00:00-05:00"><hi rendition="#italic">November 16,
                                1920—6 p.m.</hi></date></dateline></opener>
                <p>335. Your 374, November 13, 1 a.m., and 375 of November 13, 9 p.m.</p>
                <p>You may join your colleagues in communicating note to Chinese Government.<anchor
                        n="31" xml:id="d823-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Colby</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d823-f1" n="31" xml:id="d823-f1-content">
                <p>The note was communicated under date of Nov. 18.</p>
            </note>
        </listAnnotation>
    </standOff>
