    <text>
        <body>
            <div xml:id="d798">

                <pb facs="0855" n="757" xml:id="pg757"/>

                <note rend="inline" type="source">761.93/135: Telegram</note>
                <head><hi rendition="#italic">The Chargé in China</hi> (<hi
                            rendition="#italic">Tenney</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1919-11-25T10:00:00+08:00"><hi rendition="#italic">November 25,
                                1919—10 a.m.</hi></date><lb/>[Received 10:36
                    a.m.]</dateline></opener>
                <p>Legation’s November 24, 4 p.m. Russian Legation has protested to the Chinese
                    Government regarding cancellation of Russian agreements with China and Mongolia
                    of 1912, 1913 and 1915<anchor n="5" xml:id="d798-f1"/> reserving all Russian
                    rights under said agreement[s].</p>
                <closer><signed><hi rendition="#small-caps">Tenney</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d798-f1" n="5" xml:id="d798-f1-content">
                <p>MacMurray, <hi rendition="#italic">Treaties</hi> vol. <hi rendition="#small-caps"
                        >ii</hi>, pp. 992, 1066, and 1239, respectively.</p>
            </note>
