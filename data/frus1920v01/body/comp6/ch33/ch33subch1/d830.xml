            <div xml:id="d830">

                <pb facs="0884" n="786" sameAs="frus:frus1920v01/pg786"/>

                <note rend="inline" type="source">761.93/199</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >Crane</hi>) <hi rendition="#italic">to the Acting Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1920-12-17"><hi rendition="#italic">December 17,
                        1920</hi></date>.<lb/>[Received February 3, 1921.]</dateline>
                    <seg rendition="#float-left">No. 583</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to forward herewith
                    translation of a Presidential Mandate issued December 1st, 1920, regarding the
                    welfare of law-abiding Russians residing within Chinese territory.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Charles R. Crane</hi></signed></closer>


                <xi:include href="d830-a1.xml" xpointer="d830-a1"/>
