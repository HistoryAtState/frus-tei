            <div xml:id="d828">

                <pb facs="0882" n="784" xml:id="pg784"/>

                <note rend="inline" type="source">761.93/191</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >Crane</hi>) <hi rendition="#italic">to the Acting Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1920-12-07"><hi rendition="#italic">December 7,
                        1920</hi></date>.<lb/>[Received January 14, 1921.]</dateline>
                    <seg rendition="#float-left">No. 546</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith, as
                    of interest to the Department, copies of Circular No. 241 of the Dean of the
                    Diplomatic Corps, regarding the status of Russian citizens.</p>
                <p>I have [etc.]</p>
                <closer>(For the Minister)<lb/><signed><hi rendition="#small-caps">A. B.
                            Ruddock</hi></signed></closer>




