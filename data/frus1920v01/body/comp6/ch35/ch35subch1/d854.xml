                <pb facs="0904" n="806" sameAs="frus:frus1920v01/pg806"/>

                <note rend="inline" type="source">393.116/205: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >Crane</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1920-06-19T15:00:00+08:00"><hi rendition="#italic">June 19, 1920—3
                                p.m.</hi></date><lb/>[Received June 19—9:45
                    a.m.]</dateline></opener>
                <p>140. Your June 17, 5 p.m.<anchor n="53" xml:id="d854-f1"/> Name of murdered
                    missionary William A. Reimert of the Reform Church.</p>
                <closer><signed><hi rendition="#small-caps">Crane</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d854-f1" n="53" xml:id="d854-f1-content">
                <p>“Telegraph name of murdered missionary.” (File no. 393.116/204.)</p>
