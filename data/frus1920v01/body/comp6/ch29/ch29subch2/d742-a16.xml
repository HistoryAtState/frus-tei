    <text>
        <body>
            <div xml:id="d742-a16">

                <pb facs="0819" n="721" sameAs="frus:frus1920v01/pg721"/>

                <opener><seg rendition="#center">[Annex 15]</seg></opener>
                <head><hi rendition="#italic">The Representative of the Russo-Asiatic Bank</hi> (<hi
                        rendition="#italic">Raindre</hi>) <hi rendition="#italic">to the Chinese
                        Minister of Communications</hi></head>
                <opener><dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>,] <date calendar="gregorian"
                            when="1920-10-06"><hi rendition="#italic">October 6,
                        1920</hi></date>.</dateline></opener>
                <p>I have the honor to certify that the Russo-Asiatic Bank is a corporation of
                    Russian nationality and is registered at Petrograd.</p>
                <p>With compliments [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Raindre</hi></signed></closer>
            </div>
        </body>
    </text>
