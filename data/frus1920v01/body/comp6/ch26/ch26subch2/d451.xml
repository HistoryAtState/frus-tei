            <div xml:id="d451">

                <pb facs="0546" n="448" sameAs="frus:frus1920v01/pg448"/>

                <note rend="inline" type="source">893.00/3448</note>
                <head><hi rendition="#italic">The Consul General at Tientsin</hi> (<hi rendition="#italic">Fuller</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Tientsin</hi></placeName>, <date calendar="gregorian"
                            when="1920-07-19"><hi rendition="#italic">July 19,
                        1920</hi></date>.<lb/>[Received August 17.]</dateline>
                    <seg rendition="#float-left">No. 254</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith
                    copies of my despatches Nos. 214 and 217<anchor n="24" xml:id="d451-f1"/> sent
                    to the Legation today, together with copies <pb facs="0547" n="449"
                        xml:id="pg449"/> of the correspondence of the Consular Body, in regard to
                    protection of the railway, foreign concessions, and city of Tientsin during the
                    present disturbances.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Stuart J. Fuller</hi></signed></closer>








