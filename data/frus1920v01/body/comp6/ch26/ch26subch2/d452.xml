            <div xml:id="d452">

                <pb facs="0549" n="451" sameAs="frus:frus1920v01/pg451"/>

                <note rend="inline" type="source">893.00/3396: Telegram</note>
                <head><hi rendition="#italic">The Consul General at Tientsin</hi> (<hi rendition="#italic">Fuller</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Tientsin</hi></placeName>, <date calendar="gregorian"
                            when="1920-07-19T12:00:00+08:00"><hi rendition="#italic">July 19,
                                1920—noon</hi></date>.<lb/>[Received July 19—8:18
                    a.m.]</dateline></opener>
                <p>Foreign military contingents expect to send military train through to Peking July
                    19, 3 p.m.</p>
                <closer><signed><hi rendition="#small-caps">Fuller</hi></signed></closer>
            </div>
        </body>
