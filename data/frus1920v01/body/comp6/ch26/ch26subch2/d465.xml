    <text>
        <body>
            <div xml:id="d465">

                <pb facs="0555" n="457" sameAs="frus:frus1920v01/pg457"/>

                <note rend="inline" type="source">893.00/3498</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >Crane</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1920-08-02"><hi rendition="#italic">August 2,
                        1920</hi></date>.<lb/>[Received September 17, 1920.]</dateline>
                    <seg rendition="#float-left">No. 66</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: There are enclosed herewith, as of interest
                    to the Department, copies of certain recent correspondence, newspaper clippings,
                    etc., on the question of asylum in the Diplomatic Quarter in Peking,<anchor
                        n="38" xml:id="d465-f1"/> which has been actively discussed in the
                    Diplomatic Body and by the newspapers.</p>
                <p>I have [etc.]</p>
                <closer>For the Minister:<lb/><signed><hi rendition="#small-caps">A. B.
                        Ruddock</hi></signed></closer>





                <xi:include href="d465-a1.xml" xpointer="d465-a1"/>
                <xi:include href="d465-a2.xml" xpointer="d465-a2"/>
                <xi:include href="d465-a3.xml" xpointer="d465-a3"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d465-f1" n="38" xml:id="d465-f1-content">
                <p>Only three of these enclosures are printed.</p>
            </note>
