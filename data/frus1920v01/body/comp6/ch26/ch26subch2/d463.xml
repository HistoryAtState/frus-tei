    <text>
        <body>
            <div xml:id="d463">

                <pb facs="0554" n="456" sameAs="frus:frus1920v01/pg456"/>

                <note rend="inline" type="source">893.00/3486</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">Crane</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1920-07-28"><hi rendition="#italic">July 28,
                        1920</hi></date>.<lb/>[Received September 17, 1920.]</dateline>
                    <seg rendition="#float-left">No. 53</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith
                    translation copies of circular No. 108 of the Dean of the Diplomatic Corps,
                    regarding the safety of foreigners in Peking during the present crisis.<anchor
                        n="36" xml:id="d463-f1"/></p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Charles R. Crane</hi></signed></closer>


                <xi:include href="d463-a1.xml" xpointer="d463-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d463-f1" n="36" xml:id="d463-f1-content">
                <p>The first part of the circular, addressed to the dean’s colleagues and
                    transmitting copies of his note to the Chinese Foreign Office (enclosure
                    hereto), not printed.</p>
            </note>
        </listAnnotation>
    </standOff>
