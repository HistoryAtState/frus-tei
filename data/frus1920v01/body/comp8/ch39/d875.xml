                <pb facs="0932" n="834" sameAs="frus:frus1920v01/pg834"/>

                <note rend="inline" type="source">818.00/991a: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Consul at San José</hi>
                        (<hi rendition="#italic">Chase</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-08-02T12:00:00-04:00"><hi rendition="#italic">August 2,
                                1920—noon</hi></date>.</dateline></opener>
                <p>16. The President has issued instructions to recognize the present Government of
                    Costa Rica. You are therefore directed to communicate this fact to the Minister
                    for Foreign Affairs and to be governed accordingly.</p>
                <closer><signed><hi rendition="#small-caps">Colby</hi></signed></closer>
            </div>
        </body>
    </text>
