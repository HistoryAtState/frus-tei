                <pb facs="0475" n="377" sameAs="frus:frus1920v01/pg377"/>

                <note rend="inline" type="source">824.00/70: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Minister in Bolivia</hi>
                        (<hi rendition="#italic">Maginnis</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-07-23T19:00:00-04:00"><hi rendition="#italic">July 23, 1920—7
                                p.m.</hi></date></dateline></opener>
                <p>49. Your July 21, noon.</p>
                <p>You are instructed to refrain from taking charge of the private property of any
                    Bolivian citizens.</p>
                <closer><signed><hi rendition="#small-caps">Colby</hi></signed></closer>
            </div>
        </body>
    </text>
