    <text>
        <body>
            <div xml:id="d383">

                <pb facs="0475" n="377" sameAs="frus:frus1920v01/pg377"/>

                <note rend="inline" type="source">824.00/79: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Brazil</hi> (<hi rendition="#italic"
                        >Morgan</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Rio de Janeiro</hi></placeName>, <date calendar="gregorian"
                            when="1920-07-24T10:00:00-03:00"><hi rendition="#italic">July 24,
                                1920—10 a.m.</hi></date><lb/>[Received 2 p.m.]</dateline></opener>
                <p>62. New Bolivian Government has requested Brazilian Government to grant it
                    recognition. Alencar<anchor n="3" xml:id="d383-f1"/> has been instructed to
                    inquire <pb facs="0476" n="378" xml:id="pg378"/> whether American Government
                    intends to recognize. Embassy will appreciate an intimation as to Department’s
                    intention.</p>
                <closer><signed><hi rendition="#small-caps">Morgan</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d383-f1" n="3" xml:id="d383-f1-content">
                <p>Augusto Cochrane de Alencar, Brazilian Ambassador at Washington.</p>
            </note>
        </listAnnotation>
    </standOff>
