            <div xml:id="d413">

                <pb facs="0502" n="404" sameAs="frus:frus1920v01/pg404"/>

                <note rend="inline" type="source">711.428/600</note>
                <head><hi rendition="#italic">The Secretary of State to the British Ambassador</hi>
                        (<hi rendition="#italic">Geddes</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-07-20"><hi rendition="#italic">July 20,
                        1920</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I have the honor to refer to your
                    note No. 354 of June 10, 1920, relative to the publication of the report of the
                    International Fisheries Commission.</p>
                <p>I have the honor to inform you that this Government consents to the publication
                    of the report in question, on July 26, 1920.</p>
                <p>Accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Bainbridge Colby</hi></signed></closer>
            </div>
        </body>
