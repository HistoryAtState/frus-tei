    <text>
        <body>
            <div xml:id="d170">

                <pb facs="0308" n="248" sameAs="frus:frus1868p2/pg248"/>

                <head>Mr. Seward to Mr. Asboth.</head>
                <opener>
                    <seg rendition="#float-left">No. 52.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1868-02-20"><hi rendition="#italic"
                                >February</hi> 20, 1868.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> You will receive herewith the
                        correspondence<anchor n="*" xml:id="d170-f1"/> which has taken place between
                    this department and Mr. Marsh, United States minister at Florence, on the
                    subject of an Italian fleet from the Mediterranean to the waters of the La
                    Plata.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Alexander Asboth,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d170-f1" n="*" xml:id="d170-f1-content">
                <p>For inclosures see correspondence with the United States minister to Italy.</p>
            </note>
        </listAnnotation>
    </standOff>
