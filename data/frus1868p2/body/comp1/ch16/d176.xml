    <text>
        <body>
            <div xml:id="d176">

                <pb facs="0322" n="[262]" sameAs="frus:frus1868p2/pg262"/>

                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <head>Mr. Webb to Mr. Seward.</head>
                <opener><seg rendition="#float-left">No. 57.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">Petropolis, Monday,</hi></placeName>
                        <date calendar="gregorian" when="1868-01-27"><hi rendition="#italic"
                                >January</hi> 27, 1868.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi></p>
                <p rendition="#center">* * * * * * *</p>
                <p>This country is greatly agitated in consequence of the continuance of the
                    fruitless war against Paraguay, and I have, therefore, to-day addressed a note
                    to the minister of foreign affairs, a copy of which you will find inclosed,
                    marked A.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I have the honor to be, very respectfully, your obedient servant,</p>
                <closer>
                    <signed>J. WATSON WEBB.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>


                <xi:include href="d176-a1.xml" xpointer="d176-a1"/>
            </div>
