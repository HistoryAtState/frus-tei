    <text>
        <body>
            <div xml:id="d190">

                <pb facs="0331" n="271" sameAs="frus:frus1868p2/pg271"/>

                <head>Mr. Seward to Mr. Webb.</head>
                <opener>
                    <seg rendition="#float-left">No. 228.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1868-03-30"><hi rendition="#italic"
                                >March</hi> 30, 1868.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I herewith inclose to you a copy of a
                    communication addressed to this department by James A. Scrymser, projector and
                    director of the International Ocean Telegraph Company, desiring to obtain aid
                    and authority from the Brazilian government to extend the lines of his company
                    over the West India Islands to a convenient point on the coast of Brazil.</p>
                <p>You are instructed to give such assistance as may be in your power towards
                    effecting the accomplishment of the object in view.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">James Watson Webb, Esq.,</hi>
                        <hi rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d190-a1.xml" xpointer="d190-a1"/>
            </div>
