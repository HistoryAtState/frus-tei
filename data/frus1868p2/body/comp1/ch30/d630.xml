                <pb facs="1080" n="1020" xml:id="pg1020"/>

                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <head>Mr. Sullivan to Mr.
                        Seward.</head>
                <opener><seg rendition="#float-left">No. 13.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">Bogota,</hi></placeName>
                        <date calendar="gregorian" when="1867-08-12"><hi rendition="#italic"
                                >August</hi> 12, 1867.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> * * * * * *</p>
                <p>The decree of General Mosquera, dated November 17, 1866, upon the adjudication of
                    maritime prizes, and against which you have protested, was, on the 31st ultimo,
                    annulled by decree of the President of Colombia.</p>
                <p rendition="#center">* * * * * *</p>
                <p>I have the honor to be sir, your obedient servant,</p>
                <closer>
                    <signed>PETER J. SULLIVAN</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>
            </div>
        </body>
