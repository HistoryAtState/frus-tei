    <text>
        <body>
            <div xml:id="d638-a1">

                <pb facs="1094" n="1034" sameAs="frus:frus1868p2/pg1034"/>

                <head>Mr. Rebello to Mr. Sullivan.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">Bogota,</hi></placeName>
                        <date calendar="gregorian" when="1867-08-10"><hi rendition="#italic"
                                >August</hi> 10, 1867.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Herewith I beg to hand you an original of a
                    contract entered into by me, as attorney of the International Ocean Telegraph
                    Company of New York, with the secretary of finance of the Colombian government,
                    signed by us, and approved by the president, H. E. Santos Acosta, this day.</p>
                <p>I beg you to place same on the records of your legation.</p>
                <p>I am, sir, very respectfully, your most obedient servant,</p>
                <closer>
                    <signed>CHARLES REBELLO.</signed></closer>
                <postscript>
                    <p>General <hi rendition="#small-caps">Peter</hi> J. <hi rendition="#small-caps"
                            >Sullivan,</hi>
                        <hi rendition="#italic">Minister Resident of the United States of
                            America.</hi></p>
                </postscript>



                <xi:include href="d638-a1-a1.xml" xpointer="d638-a1-a1"/>
            </div>
        </body>
    </text>
