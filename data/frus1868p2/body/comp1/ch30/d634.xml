    <text>
        <body>
            <div xml:id="d634">

                <pb facs="1091" n="1031" sameAs="frus:frus1868p2/pg1031"/>

                <head>Mr. Sullivan to Mr. Seward.</head>
                <opener>
                    <seg rendition="#float-left">No. 25.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">Bogota,</hi></placeName>
                        <date calendar="gregorian" when="1867-09-16"><hi rendition="#italic"
                                >September</hi> 16, 1867.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Inclosed are copies of correspondence had
                    between the United States consul at Carthagena and myself, on the rumor that an
                    American citizen was shot by General Herrera at Rio Hatché.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>PETER J. SULLIVAN.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
