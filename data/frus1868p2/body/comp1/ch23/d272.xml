    <text>
        <body>
            <div xml:id="d272">

                <pb facs="0492" n="432" sameAs="frus:frus1868p2/pg432"/>

                <head>Mr. Plumb to Mr.
                        Seward.</head>
                <opener>
                    <seg rendition="#float-left">No. 83.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">City of Mexico,</hi></placeName>
                        <date calendar="gregorian" when="1868-02-29"><hi rendition="#italic"
                                >February</hi> 29, 1868.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to transmit to the
                    department herewith, translation of a decree published by this government,
                    opening to foreign commerce and the coasting trade a new port called Puerto
                    Angel, on the Pacific coast, in the State of Oaxaca.</p>
                <p>This port, it is stated, is favorably situated for the commerce of that State,
                    which is now taking the direction of the Pacific, instead of passing by way of
                    Vera Cruz, as heretofore.</p>
                <p>I am, sir, very respectfully, your obedient servant,</p>
                <closer>
                    <signed>E. L. PLUMB.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>


                <xi:include href="d272-a1.xml" xpointer="d272-a1"/>
