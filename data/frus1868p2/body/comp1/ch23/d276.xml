    <text>
        <body>
            <div xml:id="d276">

                <pb facs="0497" n="437" sameAs="frus:frus1868p2/pg437"/>

                <head>Mr. Plumb to Mr. Seward.</head>
                <opener>
                    <seg rendition="#float-left">No. 93.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">City of Mexico,</hi></placeName>
                        <date calendar="gregorian" when="1868-03-23"><hi rendition="#italic"
                                >March</hi> 23, 1868.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I nave the honor to transmit to the
                    department herewith, translation of an editorial published in the official paper
                    of this government on the 21st instant, entitled “Foreigners in Mexico.”</p>
                <p>I am, very respectfully, your obedient servant,</p>
                <closer>
                    <signed>E. L. PLUMB.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>


                <xi:include href="d276-a1.xml" xpointer="d276-a1"/>
            </div>
