    <text>
        <body>
            <div xml:id="d273-a2">

                <pb facs="0494" n="434" sameAs="frus:frus1868p2/pg434"/>

                <opener><dateline rendition="#center">[From the Diario Oficial, city of
                            <placeName>Mexico</placeName>, <date calendar="gregorian"
                            when="1868-03-11">March 11,
                    1868</date>.—Translation.]</dateline></opener>
                <head><hi rendition="#italic">Result of the auction that has taken place to-day for
                        bonds of the Spanish convention.</hi></head>
                <table cols="2">
                    <row role="label">
                        <cell>The citizen M. Goytia sold at 13⅞ per cent. of payment</cell>
                        <cell rendition="#nowrap" role="num">$180,245 13</cell>
                    </row>
                    <row>
                        <cell>Value in money</cell>
                        <cell rendition="#nowrap #border-bottom" role="num">25,000 00</cell>
                    </row>
                    <row>
                        <cell>Gain</cell>
                        <cell rendition="#nowrap #border-bottom" role="num">155,245 13</cell>
                    </row>
                </table>
                <closer>
                    <dateline rendition="#float-left"><placeName><hi rendition="#small-caps"
                                >Mexico,</hi></placeName>
                        <date calendar="gregorian" when="1868-03-09"><hi rendition="#italic"
                                >March</hi> 9, 1868</date>.</dateline>
                    <lb/>
                    <signed>M. P. IZAGUIRRE.</signed></closer>
            </div>
        </body>
    </text>
