    <text>
        <body>
            <div xml:id="d294-a2">

                <pb facs="0523" n="463" xml:id="pg463"/>

                <head>Mr. Ulrich to Mr.
                        Plumb.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Consulate of the United States,</hi>
                            <hi rendition="#italic">Monterey, Mexico,</hi></placeName>
                        <date calendar="gregorian" when="1868-04-26"><hi rendition="#italic"
                                >April</hi> 26, 1868.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring you to my dispatch dated 24th
                    instant, I beg to call your attention to an article on the same subject in the
                    Atalaya newspaper published in this city, which I inclose herewith.</p>
                <p>I have the honor to be, your obedient servant,</p>
                <closer>
                    <signed>J. ULRICH, <hi rendition="#italic">Consul.</hi></signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">E. L. Plumb,</hi>
                        <hi rendition="#italic">Chargé d’Affaires of the United States,
                        Mexico.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
