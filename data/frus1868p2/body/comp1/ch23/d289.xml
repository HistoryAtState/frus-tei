    <text>
        <body>
            <div xml:id="d289">

                <pb facs="0515" n="455" xml:id="pg455"/>

                <head>Mr. Plumb to Mr. Seward.</head>
                <opener>
                    <seg rendition="#float-left">No. 117.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">City of Mexico,</hi></placeName>
                        <date calendar="gregorian" when="1868-04-23"><hi rendition="#italic"
                                >April</hi> 23, 1868.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith
                    translation of a decree issued by this government on the 21st instant, closing
                    the port of Mazatlan to foreign and coasting trade, so long as it is withdrawn
                    from obedience to the government.</p>
                <p>I am, very respectfully, your obedient servant,</p>
                <closer>
                    <signed>E. L. PLUMB.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>


                <xi:include href="d289-a1.xml" xpointer="d289-a1"/>
            </div>
        </body>
    </text>
