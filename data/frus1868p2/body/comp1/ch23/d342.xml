                <pb facs="0664" n="604" sameAs="frus:frus1868p2/pg604"/>

                <opener><seg rendition="#center">[Telegram per cable.]</seg></opener>
                <head>Mr. La Reintrie to Mr.
                        Seward.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Consulate General of the United
                                States</hi>, <hi rendition="#italic">Havana</hi>,</placeName>
                        <date calendar="gregorian" when="1868-10-07"><hi rendition="#italic"
                                >October</hi> 7, 1868.</date></dateline></opener>
                <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi rendition="#italic"
                        >Secretary of State, Washington, D. C.</hi>:</p>
                <p>The captain general has ordered Santa Anna to leave Cuba for plotting, while
                    here, against the peace of Mexico.</p>
                <closer>
                    <signed>H. R. DE LA REINTRIE, <hi rendition="#italic">Vice-Consul
                        General.</hi></signed></closer>
            </div>
        </body>
