    <text>
        <body>
            <div xml:id="d263-a5">

                <pb facs="0467" n="407" sameAs="frus:frus1868p2/pg407"/>

                <opener><dateline rendition="#center">[From the paper published in the city of
                            <placeName>Mexico</placeName>, called the Siglo XIX, No. 193, of the
                        afternoon of <date calendar="gregorian" when="1868-01-23">January 23,
                            1868</date>.]</dateline></opener>
                <head>[Telegram.—Translation.]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">San Luis Potosi,</hi></placeName>
                        <date calendar="gregorian" when="1868-01-23"><hi rendition="#italic"
                                >January</hi> 23, 1868</date>. (Received in Mexico, at 12.25 a.
                        m.)</dateline></opener>
                <p><hi rendition="#small-caps">Editors of the Siglo</hi> XIX: All of our houses have
                    been embargoed and the effects sold at the lowest prices. The embargoes are to
                    be repeated to complete the loan. We are still imprisoned.</p>
                <p>Please to publish this.</p>
                <closer>
                    <signed>JOHN PITMAN.</signed></closer>
                <closer>
                    <signed>ANASTASIO ROMANO.</signed></closer>
                <closer>
                    <signed>PABLO NARESO.</signed></closer>
                <closer>
                    <signed>M. DE ENDAZA.</signed></closer>
                <closer>
                    <signed>ANTERO LASEOZ.</signed></closer>
                <closer>
                    <signed>MARTIN DOZAL.</signed></closer>
                <closer>
                    <signed>E. CLAVERIE.</signed></closer>
                <closer>
                    <signed>E. VARONA.</signed></closer>
                <closer>
                    <signed>LUIS BESCAS.</signed></closer>
            </div>
        </body>
    </text>
