    <text>
        <body>
            <div xml:id="d273-a3">

                <pb facs="0494" n="434" sameAs="frus:frus1868p2/pg434"/>

                <head><hi rendition="#italic">Result of the auction that has taken place to-day in
                        this general treasury, of the sum of</hi> $25,000, <hi rendition="#italic"
                        >destined to the redemption of bonds of the extinguished English
                        convention.</hi></head>
                <table cols="2">
                    <row role="label">
                        <cell>The citizen Ramon Rodriguez sold at 33 per cent</cell>
                        <cell rendition="#nowrap" role="num">75,757 57</cell>
                    </row>
                    <row>
                        <cell>Which amounts to</cell>
                        <cell rendition="#nowrap #border-bottom" role="num">25,000 00</cell>
                    </row>
                    <row>
                        <cell>Gain to the public treasury</cell>
                        <cell rendition="#nowrap #border-bottom" role="num">50,757 57</cell>
                    </row>
                </table>
                <closer>
                    <dateline rendition="#float-left"><placeName><hi rendition="#small-caps"
                                >Mexico,</hi></placeName>
                        <date calendar="gregorian" when="1868-03-10"><hi rendition="#italic"
                                >March</hi> 10, 1868</date>.</dateline>
                    <lb/>
                    <signed>M. P. IZAGUIRRE.</signed></closer>
            </div>
        </body>
