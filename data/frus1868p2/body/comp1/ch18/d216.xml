    <text>
        <body>
            <div xml:id="d216">

                <pb facs="0394" n="334" sameAs="frus:frus1868p2/pg334"/>

                <head>Mr. F. W. Seward to Mr. Blair.</head>
                <opener>
                    <seg rendition="#float-left">No. 5.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1868-11-05"><hi rendition="#italic"
                                >November</hi> 5, 1868.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    dispatch No. 2, of the 10th ultimo.</p>
                <p>Your proceedings as described since your arrival in the republic are approved.
                    Your cordial reception by its government, and the very friendly remarks made on
                    that occasion by the President, are extremely gratifying.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>F. W. SEWARD, <hi rendition="#italic">Acting
                    Secretary.</hi></signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Jacob B. Blair</hi>, Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
