    <text>
        <body>
            <div xml:id="d6">

                <pb facs="0064" n="4" sameAs="frus:frus1868p2/pg4"/>

                <head>Mr. Hale to Mr. Seward.</head>
                <opener>
                    <seg rendition="#float-left">No. 119.</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">Madrid,</hi></placeName>
                        <date calendar="gregorian" when="1868-01-02"><hi rendition="#italic"
                                >January</hi> 2, 1868.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your dispatch No. 93 has been received, and
                    inclosed you will find a copy of the communication which I made to the Spanish
                    government, pursuant to your instructions on the subject.</p>
                <p>With much respect, I have the honor to be yours,</p>
                <closer>
                    <signed>JOHN P. HALE.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>


                <xi:include href="d6-a1.xml" xpointer="d6-a1"/>
            </div>
