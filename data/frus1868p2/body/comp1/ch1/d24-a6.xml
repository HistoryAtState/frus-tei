    <text>
        <body>
            <div xml:id="d24-a6">

                <pb facs="0084" n="24" sameAs="frus:frus1868p2/pg24"/>

                <opener><seg rendition="#center">[Telegram per cable.]</seg></opener>
                <head>Mr. Seward to Mr. Hale.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1868-10-13"><hi rendition="#italic"
                                >October</hi> 13, 1868.</date></dateline></opener>
                <p>Reciprocate in President’s name the salutations of the provisional government,
                    communicated by Spanish minister here, and tender best wishes of United States
                    for peace, prosperity, and happiness of Spain, under present and definitive
                    government.</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">John P. Hale</hi> Esq., <hi rendition="#italic"
                            >&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
