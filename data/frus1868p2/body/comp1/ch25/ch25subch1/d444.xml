            <div xml:id="d444">

                <pb facs="0861" n="801" sameAs="frus:frus1868p2/pg801"/>

                <head><hi rendition="#italic">List of persons now resident in the legation of the
                        United States in Asuncion,</hi></head>
                <p>The minister, wife, and child; Mrs. Leite Pereira; Carlos Meincke, private
                    secretary; Kate Leahy; George F. Masterman, medical attendant; Porter C. Bliss,
                    translator; George Hamilton, Baltazar Carreras, Bazilio Jara, Melchora Jara,
                    Lucia Rivas, (lavandera.)</p>
                <closer><dateline rendition="#float-left"><date calendar="gregorian"
                            when="1868-08-13"><hi rendition="#small-caps">August 13</hi>,
                            1868</date>.</dateline></closer>
            </div>
