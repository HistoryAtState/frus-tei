    <text>
        <body>
            <div xml:id="d401">

                <pb facs="0751" n="691" sameAs="frus:frus1868p2/pg691"/>

                <head>Mr. Seward to Mr.
                        McMahon.</head>
                <opener>
                    <seg rendition="#float-left">No. 9.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1868-11-27"><hi rendition="#italic"
                                >November</hi> 27, 1868.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your interesting dispatch from Rio de
                    Janeiro, No. 6, of the 26th ultimo, has been received.</p>
                <p>The instruction, No. 7, of the 21st instant, makes it unnecessary to write to you
                    further upon the subject at present.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Martin T. McMahon</hi>, Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
