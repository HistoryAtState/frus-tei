    <text>
        <body>
            <div xml:id="d205">

                <pb facs="0382" n="322" sameAs="frus:frus1868p2/pg322"/>

                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <head>Mr. Seward to Mr. Kilpatrick.</head>
                <opener><seg rendition="#float-left">No. 60.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1868-04-30"><hi rendition="#italic"
                                >April</hi> 30, 1868.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    dispatch No. 104, Unclosing a copy of the note of the minister of foreign
                    affairs of Chili, dated on the 24th March last, with reference to mediation in
                    the Spanish-American question. His reply will be communicated to the Spanish
                    government.</p>
                <p rendition="#center">* * * * * * * *</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Judson Kilpatrick,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
