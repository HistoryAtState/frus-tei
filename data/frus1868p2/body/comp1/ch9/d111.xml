    <text>
        <body>
            <div xml:id="d111">

                <pb facs="0176" n="116" sameAs="frus:frus1868p2/pg116"/>

                <head>Mr. Morris to Mr.
                        Seward.</head>
                <opener>
                    <seg rendition="#float-left">No. 269.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">Constantinople,</hi></placeName>
                        <date calendar="gregorian" when="1868-10-02"><hi rendition="#italic"
                                >October</hi> 2, 1868.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit inclosed a
                    translated copy of a note from the Sublime Porte relative to the passage of the
                    Dardanelles and Bosphorus by vessels of war in time of peace.</p>
                <p>I am, sir, very respectfully, your obedient servant,</p>
                <closer>
                    <signed>E. JOY MORRIS,</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>



                <xi:include href="d111-a1.xml" xpointer="d111-a1"/>
            </div>
        </body>
    </text>
