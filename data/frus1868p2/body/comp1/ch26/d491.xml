    <text>
        <body>
            <div xml:id="d491">

                <pb facs="0917" n="857" sameAs="frus:frus1868p2/pg857"/>

                <head>Mr. Hovey to Mr. Seward.</head>
                <opener>
                    <seg rendition="#float-left">No. 117.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">Lima, Peru,</hi></placeName>
                        <date calendar="gregorian" when="1868-02-22"><hi rendition="#italic"
                                >February</hi> 22, 1868.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to transmit herewith, for
                    the information of the department, the copy of an unofficial letter received by
                    me from <pb facs="0918" n="858" xml:id="pg858"/> Commander J. H. Gillis,
                    commanding the United States steamer Wateree, giving an account of the state of
                    affairs in the north of Peru.</p>
                <p>I have the honor to be, your obedient servant,</p>
                <closer>
                    <signed>ALVIN P. HOVEY.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>


                <xi:include href="d491-a1.xml" xpointer="d491-a1"/>
            </div>
        </body>
    </text>
