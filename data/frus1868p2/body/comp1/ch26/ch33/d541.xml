                <pb facs="0975" n="915" sameAs="frus:frus1868p2/pg915"/>

                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <head>Mr. Seward to Señor
                        Garcia.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1868-11-24"><hi rendition="#italic"
                                >November</hi> 24, 1868.</date></dateline></opener>
                <p>The direction you desire has been given to the collector.</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p>Señor Don <hi rendition="#small-caps">José Antonio Garcia y Garcia,</hi>
                        <hi rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
