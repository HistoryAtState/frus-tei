    <text>
        <body>
            <div xml:id="d531">

                <pb facs="0959" n="899" sameAs="frus:frus1868p2/pg899"/>

                <head>Mr. Seward to Señor Garcia.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1868-04-27"><hi rendition="#italic"
                                >April</hi> 27, 1868.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit for your information a copy of
                    the reply<anchor n="*" xml:id="d531-f1"/> of this department to a note of Señor
                    Don Ignacio Gomez, the minister plenipotentiary of the republic of Nicaragua,
                    upon the subject of the good offices of the state of Central America towards
                    putting an end to the war between Spain on the one side, and Ecuador, Peru,
                    Bolivia, and Chili on the other.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p>Señor Don <hi rendition="#small-caps">José Antonio Garcia y Garcia</hi><hi
                            rendition="#italic">, &amp;c<hi rendition="#italic">., &amp;</hi>c<hi
                                rendition="#italic">.,</hi> &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d531-f1" n="*" xml:id="d531-f1-content">
