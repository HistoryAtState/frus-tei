                <pb facs="0576" n="490" sameAs="frus:frus1945Malta/pg490"/>

                <head>Interdelegation dinner meeting, January 31, 1945, evening, government
                    house</head>
                <p rendition="#center">
                    <hi rendition="#small-caps">Present</hi>
                </p>
                <table cols="2" rows="5">
                    <row role="label">
                        <cell>
                            <hi rendition="#small-caps">United States</hi>
                        </cell>
                        <cell>
                            <hi rendition="#small-caps">United Kingdom</hi>
                        </cell>
                    </row>
                    <row>
                        <cell>Secretary Stettinius </cell>
                        <cell>Prime Minister Churchill </cell>
                    </row>
                    <row>
                        <cell/>
                        <cell>Foreign Secretary Eden </cell>
                    </row>
                    <row>
                        <cell/>
                        <cell>Lieutenant General Schreiber </cell>
                    </row>
                    <row>
                        <cell cols="2">and various other members of the two Delegations</cell>
                    </row>
                </table>


                <xi:include href="ch6subch8/d298.xml" xpointer="d298"/>
