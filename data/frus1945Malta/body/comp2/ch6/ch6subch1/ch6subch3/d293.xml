    <text>
        <body>
            <div xml:id="d293">

                <pb facs="0563" n="477" sameAs="frus:frus1945Malta/pg477"/>

                <note rend="inline" type="source">J. C. S. Files</note>
                <head>
                    <hi rendition="#italic">Memorandum by the British Chiefs of Staff</hi><anchor
                        n="1" xml:id="d293-f1"/>
                </head>
                <dateline>
                    <date ana="#date_undated-inferred-from-document-content" calendar="gregorian"
                        when="1945-01-30">January 30, 1945</date>
                </dateline>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                </opener>
                <p rendition="#center">
                    <hi rendition="#small-caps">Proposed Programme of Work</hi>
                </p>
                <p rendition="#flush">
                    <hi rendition="#italic">Tuesday, 30th January</hi>
                </p>
                <p>1. A. War Against Germany</p>
                <p>1. C. Co-ordination of Operations<lb/>Bomblines, etc.</p>
                <pb facs="0564" n="478" xml:id="pg478"/>
                <p>1. E. Combined Bomber Offensive</p>
                <p>1. F. Planning Date for End of German War</p>
                <p rendition="#flush">
                    <hi rendition="#italic">Wednesday, 31st January</hi>
                </p>
                <p>1. B. Strategy in Mediterranean</p>
                <p>2. War Against Japan <list>
                        <label>A.</label>
                        <item>South-East Asia</item>
                        <label>B.</label>
                        <item>Allocation of Resources Between S. E. A. C. and China</item>
                    </list>
                </p>
                <p rendition="#flush">
                    <hi rendition="#italic">Thursday, 1st February</hi>
                </p>
                <p>2. C. Pacific Operations</p>
                <p>2. D. Planning Date for End of Japanese War</p>
                <p>1. D. U-Boat Threat</p>
                <p rendition="#flush">
                    <hi rendition="#italic">Friday, 2nd February</hi>
                </p>
                <p>3. Review of Cargo Shipping <list>
                        <item>Additional Item.</item>
                        <item>Oil Stocks</item>
                    </list>
                </p>
                <p>4. Basic undertakings</p>
                <p>
                    <hi rendition="#small-caps">Castille</hi>,<anchor n="2" xml:id="d293-f2"/>
                    30.1.45.</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d293-f1" n="1" type="source" xml:id="d293-f1-content">
                <p>Annexed to the Combined Chiefs of Staff minutes of the 182d Meeting.</p>
            </note>
            <note corresp="#d293-f2" n="2" xml:id="d293-f2-content">
                <p>The Auberge de Castile, in Valletta, built in 1574 and altered in 1744, one of
                    the national palaces of the Order of Malta.</p>
            </note>
        </listAnnotation>
    </standOff>
