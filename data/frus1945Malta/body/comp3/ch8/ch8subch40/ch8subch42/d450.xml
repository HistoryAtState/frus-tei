                <note rend="inline" type="source">Bohlen Collection</note>
                <head>
                    <hi rendition="#italic">
                        Harriman Memorandum of
                        Conversations</hi><anchor n="1" xml:id="d450-f1"/>
                </head>
                <dateline>
