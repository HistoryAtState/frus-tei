                <head>Meeting of the Foreign Ministers, February 6, 1945, noon, Livadia
                    Palace</head>
                <p rendition="#center">
                    <hi rendition="#small-caps">Present</hi>
                </p>
                <p>
                    <table cols="3" rows="8">
                        <row role="label">
                            <cell>
                                <hi rendition="#small-caps">United States</hi>
                            </cell>
                            <cell>
                                <hi rendition="#small-caps">United Kingdom</hi>
                            </cell>
                            <cell>
                                <hi rendition="#small-caps">Soviet Union</hi>
                            </cell>
                        </row>
                        <row>
                            <cell>Secretary Stettinius
                            </cell>
                            <cell>Foreign Secretary Eden
                            </cell>
                            <cell>Foreign Commissar Molotov
                            </cell>
                        </row>
                        <row>
                            <cell>Mr. Harriman
                            </cell>
                            <cell>
                                Sir Alexander Cadogan
                            </cell>
                            <cell/>
                        </row>
                        <row>
                            <cell>Mr. Matthews
                            </cell>
                            <cell>
                                Sir Archibald Clark Kerr
                            </cell>
                            <cell>Mr. Vyshinsky
                            </cell>
                        </row>
                        <row>
                            <cell>Mr. Hiss
                            </cell>
                            <cell>Mr. Jebb
                            </cell>
                            <cell>Mr. Maisky
                            </cell>
                        </row>
                        <row>
                            <cell>Mr. Bohlen
                            </cell>
                            <cell>Mr. Dixon
                            </cell>
                            <cell>Mr. Gusev
                            </cell>
                        </row>
                        <row>
                            <cell>Mr. Foote
                            </cell>
