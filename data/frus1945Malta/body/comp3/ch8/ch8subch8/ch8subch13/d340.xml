    <text>
        <body>
            <div xml:id="d340">

                <pb facs="0730" n="634" sameAs="frus:frus1945Malta/pg634"/>

                <note rend="inline" type="source">Hopkins Papers</note>
                <head>
                    <hi rendition="#italic">The President’s Special Assistant</hi> (<hi
                        rendition="#italic">Hopkins</hi>) <hi rendition="#italic">to the President
                        </hi><anchor n="1" xml:id="d340-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Yalta</hi></placeName>, <date calendar="gregorian"
                            when="1945-02-05">February 5, 1945.</date>]</dateline>
                </opener>
                <p>
                    <del rendition="#strikethrough">Why</del>
                    <del rendition="#strikethrough">not</del>
                    <del rendition="#strikethrough">agree</del>
                    <del rendition="#strikethrough">to</del>
                    <del rendition="#strikethrough">a</del>
                    <del rendition="#strikethrough">French</del>
                    <del rendition="#strikethrough">zone</del>
                    <del rendition="#strikethrough">and</del>
                    <del rendition="#strikethrough">consider</del>
                    <del rendition="#strikethrough">later</del>
                    <del rendition="#strikethrough">the</del>
                    <del rendition="#strikethrough">question</del>
                    <del rendition="#strikethrough">of</del>
                    <del rendition="#strikethrough">putting</del>
                    <del rendition="#strikethrough">them</del>
                    <del rendition="#strikethrough">on</del>
                    <del rendition="#strikethrough">control</del>
                    <del rendition="#strikethrough">commission</del>
                    <del rendition="#strikethrough">for</del>
                    <del rendition="#strikethrough">Germany?</del>
                    <del rendition="#strikethrough">or</del>
                    <del rendition="#strikethrough">not</del>—</p>
                <p>Could you not add that French participation on Control Commission might be
                    considered later?</p>
            </div>
