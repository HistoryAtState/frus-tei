    <text>
        <body>
            <div xml:id="d341">

                <pb facs="0730" n="634" sameAs="frus:frus1945Malta/pg634"/>

                <note rend="inline" type="source">Hopkins Papers</note>
                <head>
                    <hi rendition="#italic">The President’s Special Assistant</hi> (<hi rendition="#italic"
                        >Hopkins</hi>) <hi rendition="#italic">to the President
                    </hi><anchor n="1" xml:id="d341-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Yalta</hi></placeName>, <date calendar="gregorian"
                            when="1945-02-05">February 5, 1945.</date>]</dateline>
                </opener>
                <p rendition="#flush">Could you ask him</p>
                <p>1. Why not take all Gestapo-Storm Troopers
                    and other Nazi criminals.</p>
            </div>
        </body>
