                <head>Meeting of the Foreign Ministers, February 9, 1945, noon, Livadia
                    Palace</head>
                <p rendition="#center">
                    <hi rendition="#small-caps">Present</hi>
                </p>
                <table cols="3" rows="8">
                    <row role="label">
                        <cell>
                            <hi rendition="#small-caps">United States</hi>
                        </cell>
