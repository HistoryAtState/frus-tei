    <text>
        <body>
            <div xml:id="d407">

                <pb facs="0910" n="814" sameAs="frus:frus1945Malta/pg814"/>

                <note rend="inline" type="source">
                    Hiss Collection</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Head of the Reconstruction
                        Department of the British Foreign Office</hi> (<hi rendition="#italic"
                        >Jebb</hi>)<anchor n="1" xml:id="d407-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Yalta</hi></placeName>, <date calendar="gregorian"
                            when="1945-02-09">February 9, 1945</date>.]</dateline>
                </opener>
                <p>We must be sure—no respon.—rests on us relative to Iceland, Turkey, <del
                        rendition="#strikethrough">ete</del> Egypt<anchor n="2" xml:id="d407-f2"/>
                    on joining World Organ</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d407-f1" n="1" type="source" xml:id="d407-f1-content">
                <p>This message, in Stettinius’ handwriting, bears the following notation in the
                    handwriting of Alger Hiss: “A. H. gave Jebb this message 2/9 12.30 p. m. during
                    For. Mins. meetings”.</p>
            </note>
            <note corresp="#d407-f2" n="2" xml:id="d407-f2-content">
                <p>The word “Egypt” is inserted in Hiss’ handwriting.</p>
            </note>
        </listAnnotation>
    </standOff>
