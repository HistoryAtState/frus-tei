    <text>
        <body>
            <div xml:id="d378">

                <pb facs="0825" n="729" xml:id="pg729"/>

                <note rend="inline" type="source">Hopkins Papers</note>
                <head>
                    <hi rendition="#italic">The President’s Special Assistant</hi> (<hi rendition="#italic"
                        >Hopkins</hi>) <hi rendition="#italic">to the President
                    </hi><anchor n="1" xml:id="d378-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Yalta</hi></placeName>, <date calendar="gregorian"
                            when="1945-02-07">February 7, 1945</date>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. President</hi> I think you should try to get
                    this referred to Foreign ministers before there is trouble.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Harry</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d378-f1" n="1" type="source" xml:id="d378-f1-content">
                <p>The relationship of this note to the Fourth Plenary Meeting appears from internal
                    evidence and from Sherwood, pp. 855–856. See <hi rendition="#italic">ante</hi>,
                        <ref target="#pg713">p. 713</ref>.</p>
            </note>
        </listAnnotation>
