    <text>
        <body>
            <div xml:id="d370">

                <pb facs="0803" n="707" xml:id="pg707"/>

                <note rend="inline" type="source">Bohlen Collection</note>
                <head>
                    <hi rendition="#italic">Soviet Proposal on French Zone of Occupation in
                        Germany</hi><anchor n="1" xml:id="d370-f1"/>
                </head>
                <dateline>
                    <date ana="#date_undated-inferred-from-document-head" calendar="gregorian"
                        when="1945-02-07T12:00:00+03:00">February 7, 1945, noon</date>
                </dateline>
                <p rendition="#center">
                    <hi rendition="#small-caps">Regarding a Separate Zone of Occupation in Germany
                        To Be Allotted to France</hi>
                </p>
                <p>1. It has been found desirable to allot to France a separate zone of occupation
                    in Germany for occupation by French forces.</p>
                <p>2. It has been decided that the French occupational authorities shall exercise
                    control in their zone of occupation under the general guidance of the Control
                    Council.</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d370-f1" n="1" type="source" xml:id="d370-f1-content">
                <p>Undated but submitted by Molotov on
                    February 7, 1945. See <hi rendition="#italic">ante</hi>, <ref target="#pg701">p.
