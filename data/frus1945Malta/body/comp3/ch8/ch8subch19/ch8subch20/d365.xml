    <text>
        <body>
            <div xml:id="d365">

                <pb facs="0794" n="698" sameAs="frus:frus1945Malta/pg698"/>

                <note rend="inline" type="source">J. C. S. Files</note>
                <head>
                    <hi rendition="#italic">The President’s Chief of Staff</hi> (<hi
                        rendition="#italic">Leahy</hi>) <hi rendition="#italic">to the First Deputy
                        Chief of General Staff of the Soviet Army</hi> (<hi rendition="#italic"
                        >Antonov</hi>)</head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Yalta</hi></placeName>,] <date calendar="gregorian"
                            when="1945-02-07">7 February 1945</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear General Antonov</hi>: The U. S. Chiefs of
                    Staff desire to meet with the Soviet Chiefs for a most secret discussion
                    tomorrow, Thursday, February 8 at 3 P. M. at the Russian headquarters. No one to
                    be present but the Chiefs of Staff and one interpreter, your Russian interpreter
                    being satisfactory for our purpose.</p>
                <closer>For the U. S. Chiefs of Staff: <lb/>
                    <signed>
                        <hi rendition="#small-caps">William</hi> D. <hi rendition="#small-caps"
                            >Leahy</hi>
                    </signed>
                    <lb/>
                    <hi rendition="#italic">Fleet Admiral, U. S. Navy</hi>
                </closer>
            </div>
        </body>
    </text>
