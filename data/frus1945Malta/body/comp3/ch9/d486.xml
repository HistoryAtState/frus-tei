    <text>
        <body>
            <div xml:id="d486">

                <pb facs="1055" n="959" xml:id="pg959"/>

                <note rend="inline" type="source">Defense Files: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Acting Secretary of
                        State</hi> (<hi rendition="#italic">Grew</hi>)</head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                </opener>
                <p>
                    <hi rendition="#small-caps"> Argonaut </hi> 71A. Crypto-War for Acting Secretary
                    of State only from Secretary Stettinius.</p>
                <p>The British are disturbed over our having entered into an aviation agreement with
                        Ireland<anchor n="1" xml:id="d486-f1"/> without consulting or informing
                    them. Please send us promptly an appropriate explanation for us to present to
                    the British on this matter.</p>
                <closer>
                    <dateline rendition="#float-left">
                        <hi rendition="#small-caps">
                            <placeName>Argonaut</placeName></hi>, <date calendar="gregorian"
                            when="1945-02-07">February 7, 1945</date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d486-f1" n="1" xml:id="d486-f1-content">
                <p>For the text of this agreement relating to air-transport service, which was
                    signed at Washington February 3, 1945, see Department of State Executive
                    Agreement Series No. 460, or 59 Stat. 1402.</p>
            </note>
        </listAnnotation>
    </standOff>
