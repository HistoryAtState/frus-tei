    <text>
        <body>
            <div xml:id="d53">

                <pb facs="0116" n="34" sameAs="frus:frus1945Malta/pg34"/>

                <note rend="inline" type="source">Roosevelt Papers: Telegram</note>
                <head>
                    <hi rendition="#italic">President Roosevelt to Prime Minister Churchill
                        </hi><anchor n="1" xml:id="d53-f1"/>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                        <lb/>
                        <hi rendition="#small-caps">priority</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1945-01-12">12 January 1945</date>.</dateline>
                </opener>
                <p>Number 699, Personal and Top Secret, from the President to the Prime
                    Minister.</p>
                <p>Your 884.<anchor n="2" xml:id="d53-f2"/> It is regretted that projected business
                    here for the Secretary of State will prevent Stettinius’ arrival Malta before
                    January 31.</p>
                <p>It is my present intention to send Harry Hopkins to England some days in advance
                    of the Malta date to talk with you and Eden.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Roosevelt</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d53-f1" n="1" type="source" xml:id="d53-f1-content">
                <p>Sent to the United States Naval Attaché, London, via Navy channels.</p>
            </note>
            <note corresp="#d53-f2" n="2" xml:id="d53-f2-content">
