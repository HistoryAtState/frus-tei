    <text>
        <body>
            <div xml:id="d63">

                <pb facs="0120" n="38" sameAs="frus:frus1945Malta/pg38"/>

                <note rend="inline" type="source">Roosevelt Papers: Telegram</note>
                <head>
                    <hi rendition="#italic">President Roosevelt to Prime Minister Churchill
                        </hi><anchor n="1" xml:id="d63-f1"/>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                        <lb/>
                        <hi rendition="#small-caps">priority</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1945-01-22">22 January 1945</date>.</dateline>
                </opener>
                <p>Number 704, Personal and Top Secret, for the Prime Minister from the
                    President.</p>
                <p>I am in full agreement with the suggestion regarding press representatives and
                    photographers made in your 891.<anchor n="2" xml:id="d63-f2"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Roosevelt</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d63-f1" n="1" type="source" xml:id="d63-f1-content">
                <p>Sent to the United States Naval Attaché, London, via Navy channels.</p>
            </note>
            <note corresp="#d63-f2" n="2" xml:id="d63-f2-content">
                <p> Churchill replied, in his telegram No. 892, “Please tell U. J.” (Roosevelt
                    Papers).</p>
            </note>
        </listAnnotation>
    </standOff>
