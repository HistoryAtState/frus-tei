    <text>
        <body>
            <div xml:id="d62">

                <pb facs="0120" n="38" sameAs="frus:frus1945Malta/pg38"/>

                <note rend="inline" type="source">Roosevelt Papers: Telegram</note>
                <head>
                    <hi rendition="#italic">Prime Minister Churchill to President Roosevelt
                        </hi><anchor n="1" xml:id="d62-f1"/>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1945-01-21">January 21,
                        1945</date>.</dateline>
                </opener>
                <p>Prime Minister to President Roosevelt Personal and Top Secret Number 891.</p>
                <p>I suggest that the press should be entirely excluded from <hi
                        rendition="#small-caps">Argonaut</hi>, but that each of us should be free to
                    bring not more than three or four uniformed service photographers to take
                    “still” and cinematograph pictures to be released when we think fit. Please let
                    me know if you agree.</p>
                <p>There will of course be the usual agreement communiqué, or communiqués.</p>
                <p>I am sending a similar telegram to U. J.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Prime</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d62-f1" n="1" type="source" xml:id="d62-f1-content">
                <p>Sent by the United States Military Attaché, London, via Army channels.</p>
            </note>
        </listAnnotation>
    </standOff>
