    <text>
        <body>
            <div xml:id="d51">

                <pb facs="0115" n="33" sameAs="frus:frus1945Malta/pg33"/>

                <note rend="inline" type="source">Roosevelt Papers: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the Soviet Union</hi> (<hi rendition="#italic"
                        >Harriman</hi>) <hi rendition="#italic">to the President
                    </hi><anchor n="1" xml:id="d51-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Moscow</hi></placeName>, <date
                            calendar="gregorian" when="1945-01-11">11 January
                        1945</date>.</dateline>
                </opener>
                <p>Personal and Top Secret for the President from Harriman.</p>
                <p>
                    Molotov advises me that Marshal Stalin has accepted the code name Argonaut and
                    has so advised Mr. Churchill. This is in
                    reply to your White House 160 Jan
                        7.<anchor n="2" xml:id="d51-f2"/>
                </p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d51-f1" n="1" type="source" xml:id="d51-f1-content">
                <p>Sent by the United States Naval Attaché, Moscow, via Navy channels.</p>
            </note>
            <note corresp="#d51-f2" n="2" xml:id="d51-f2-content">
                <p>See <hi rendition="#italic">ante</hi>, <ref target="#pg30">p. 30</ref>, footnote
                    3.</p>
            </note>
        </listAnnotation>
    </standOff>
