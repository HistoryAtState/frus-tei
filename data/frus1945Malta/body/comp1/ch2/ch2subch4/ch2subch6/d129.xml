    <text>
        <body>
            <div xml:id="d129">

                <pb facs="0254" n="172" sameAs="frus:frus1945Malta/pg172"/>

                <note rend="inline" type="source">740.00119 EW/11–2244</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State</hi> (<hi
                        rendition="#italic">Stettinius</hi>) <hi rendition="#italic">to the
                        President </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1944-11-22">November 22, 1944</date>.</dateline>
                </opener>
                <p rendition="#center">
                    <hi rendition="#small-caps">Memorandum for the President</hi>
                </p>
                <p rendition="#flush">Subject: Economic Treatment of Germany</p>
                <p>At the time that you redraft the memorandum on the Economic Treatment of Germany
                    you might find the attached memorandum useful.</p>
                <closer>
                    <signed> E. R. <hi rendition="#small-caps">Stettinius, Jr</hi>. </signed>
                </closer>



                <xi:include href="d129-a1.xml" xpointer="d129-a1"/>
