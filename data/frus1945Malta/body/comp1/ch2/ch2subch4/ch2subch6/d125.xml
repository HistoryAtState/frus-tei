    <text>
        <body>
            <div xml:id="d125">

                <pb facs="0245" n="163" sameAs="frus:frus1945Malta/pg163"/>

                <note rend="inline" type="source">Matthews Files</note>
                <head>
                    <hi rendition="#italic">The Secretary of the Treasury</hi> (<hi rendition="#italic"
                        >Morgenthau</hi>) <hi rendition="#italic">to the Under Secretary
                        of State</hi> (<hi
                            rendition="#italic">Stettinius</hi>)<anchor n="1"
                        xml:id="d125-f1"/>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-11-03">November 3,
                        1944</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Ed</hi>: I am sending you herewith Memorandum
                    on the British Draft of Policy Directive for Germany.</p>
                <p>This was shown to the War Department, and with their approval<anchor n="2"
                        xml:id="d125-f2"/> I gave a copy of it to Lord
                        Cherwell just before he left.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Henry</hi>
                        
                    </signed>
                </closer>


                <xi:include href="d125-a1.xml" xpointer="d125-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d125-f1" n="1" type="source" xml:id="d125-f1-content">
                <p>Printed from a copy presumably typed in the Department of State.</p>
            </note>
            <note corresp="#d125-f2" n="2" xml:id="d125-f2-content">
                <p>For the War Department position, see the memorandum by Matthews of November 4, 1944, <hi
                        rendition="#italic">post</hi>, <ref target="#pg165">p. 165</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
