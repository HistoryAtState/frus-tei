    <text>
        <body>
            <div xml:id="d188">

                <pb facs="0360" n="274" sameAs="frus:frus1945Malta/pg274"/>

                <note rend="inline" type="source">865.01/12–944</note>
                <head>
                    <hi rendition="#italic">The British Ambassador</hi> (<hi rendition="#italic"
                        >Halifax</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-12-09">December 9,
                        1944</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Ed</hi>: I have just received a telegram
                    asking me to convey to you the enclosed personal message from Anthony, in reply
                    to yours of December 7th.</p>
                <p>Yours ever,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Edward</hi>
                    </signed>
                </closer>


                <xi:include href="d188-a1.xml" xpointer="d188-a1"/>
