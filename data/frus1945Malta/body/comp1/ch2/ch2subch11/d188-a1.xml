    <text>
        <body>
            <div xml:id="d188-a1">

                <pb facs="0360" n="274" sameAs="frus:frus1945Malta/pg274"/>

                <opener>
                    <seg rendition="#center">[Enclosure]</seg>
                </opener>
                <p rendition="#center">
                    <hi rendition="#small-caps">Personal Message From Mr. Eden to Mr. Stettinius
                    </hi>
                </p>
                <p>Thank you so much for your helpful and understanding message which I received
                    through Winant. It is my keen desire that we should work close together.<anchor
                        n="1" xml:id="d188-f1"/>
                </p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d188-f1" n="1" xml:id="d188-f1-content">
                <p>Copies of the Stettinius-Eden messages were sent to the President on December 10,
                    1944.</p>
            </note>
        </listAnnotation>
    </standOff>
