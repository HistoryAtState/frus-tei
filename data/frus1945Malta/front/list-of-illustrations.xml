    <text>
        <body>
            <div xml:id="list-of-illustrations">

                <pb facs="0013" n="IX" xml:id="pgIX"/>

                <head>List of illustrations and maps</head>
                <p rendition="#center">(These photographic illustrations will be found in a group
                    following page 546.)</p>
                <p rendition="#center">Plate</p>
                <list>
                    <item>Meeting of the Combined Chiefs of Staff in Montgomery House, Malta, January 31, 1945 1</item>
                    <item>President Roosevelt and Prime
                        Minister Churchill aboard the U. S. S.
                            <hi rendition="#italic">Quincy</hi> at Malta, February 2, 1945 2</item>
                    <item>President Roosevelt and the Joint
                        Chiefs of Staff in conference aboard the U. S. S. <hi rendition="#italic"
                            >Quincy</hi> at Malta, February 2, 1945 3</item>
                    <item>Meeting of President Roosevelt with
                        his advisers in Livadia Palace, Yalta, February 4, 1945. 4</item>
                    <item>Plenary Meeting in Livadia Palace, Yalta, February 1945 5</item>
                    <item>Meeting of the Foreign Ministers in Yusupov Palace, Koreiz, February 7,
                        1945 6</item>
                    <item>Prime Minister Churchill, President
                            Roosevelt, and Marshal Stalin in the patio of Livadia Palace,
                        Yalta, February 10, 1945 7</item>
                    <item>Tripartite Luncheon Meeting in Livadia Palace, Yalta, February 11, 1945.
                        8</item>
                </list>
                <p rendition="#center">MAPS</p>
                <list>
                    <item>
                        <ref target="#pg200">Bremen and Bremerhaven Enclave (<hi rendition="#italic"
                                >in color</hi>) <hi rendition="#italic">facing</hi>
                        </ref>
                    </item>
                    <item>
                        <ref target="#pg233">Germany-Poland: Proposed Territorial Changes <hi
                                rendition="#italic">facing</hi>
                        </ref>
                    </item>
                    <item>
                        <ref target="#pg612">Germany: Proposed Zones of Occupation <hi
                                rendition="#italic">facing</hi>
                        </ref>
                    </item>
                </list>
            </div>
