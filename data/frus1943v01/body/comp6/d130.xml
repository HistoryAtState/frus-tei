            <div xml:id="d130">

                <pb facs="0174" n="164" sameAs="frus:frus1943v01/pg164"/>

                <note rend="inline" type="source">548.G1/55: Telegram</note>
                <head>
                    <hi rendition="#italic">The Consul General at Hamilton</hi> (<hi
                        rendition="#italic">Beck</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Hamilton, Bermuda</hi></placeName>, <date
                            calendar="gregorian" when="1943-04-24T22:00:00-04:00">April 24, 1943—10
                            p.m.</date>
                        <lb/> [Received April 25—2:29 a.m.]</dateline>
                </opener>
                <p>140. For Long from Dodds. Draft proposal regarding Intergovernmental Committee
                    tentatively accepted today in general with only language modifications. Will
                    telegraph final draft when approved. [Dodds.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Beck</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
