            <div xml:id="d215">

                <pb facs="0257" n="247" sameAs="frus:frus1943v01/pg247"/>

                <note rend="inline" type="source">840.48 Refugees/4926: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the United Kingdom</hi> (<hi
                        rendition="#italic">Winant</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1943-12-29">December 29,
                        1943</date>.<lb/>[Received December 29—11:19 a.m.]</dateline>
                </opener>
                <p>9034. Director states that December 28th Soviet Embassy informed him that Soviet
                    Government accepts membership in Intergovernmental Committee on Refugees.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Winant</hi>
                    </signed>
                </closer>
            </div>
        </body>
