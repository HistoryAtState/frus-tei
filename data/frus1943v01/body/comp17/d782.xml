    <text>
        <body>
            <div xml:id="d782">

                <pb facs="0893" n="883" sameAs="frus:frus1943v01/pg883"/>

                <note rend="inline" type="source">840.48/6090</note>
                <head>
                    <hi rendition="#italic">The Soviet Ambassador</hi> (<hi rendition="#italic"
                        >Litvinov</hi>) <hi rendition="#italic">to the Assistant Secretary of
                        State</hi> (<hi rendition="#italic">Acheson</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-03-18">March 18, 1943</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Acheson</hi>: I am sending you herewith in
                    writing my Government’s remarks on the latest amendments to the draft agreement
                    on Relief and Rehabilitation.</p>
                <p>I am at your disposal to discuss these remarks at any time convenient for
                    you.</p>
                <p>Yours sincerely,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Maxim Litvinoff</hi>
                    </signed>
                </closer>



                <xi:include href="d782-a1.xml" xpointer="d782-a1"/>
            </div>
