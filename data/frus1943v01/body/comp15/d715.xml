    <text>
        <body>
            <div xml:id="d715">

                <pb facs="0816" n="806" sameAs="frus:frus1943v01/pg806"/>

                <note rend="inline" type="source">740.00119 EAC/11: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the Soviet Union</hi> (<hi
                        rendition="#italic">Harriman</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Moscow</hi></placeName>, <date
                            calendar="gregorian" when="1943-11-22">November 22,
                        1943</date>.<lb/>[Received November 23—1:25 p.m.]</dateline>
                </opener>
                <p>2012. <hi rendition="#italic">Pravda</hi> for November 22nd carried an
                    announcement of the appointment of the principal representative of the USSR on
                    the European Advisory Commission reading as follows: <quote rend="blockquote">
                        <p>“In accordance with the decision of the Moscow Conference regarding the
                            establishment in London of the European Advisory Commission the Soviet
                            Government has appointed as principal representative of the Soviet Union
                            on this Commission the Ambassador of the USSR in Great Britain Comrade
                            F. T. Gusev.”<anchor n="14" xml:id="d715-f1"/>
                        </p>
                    </quote>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Harriman</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d715-f1" n="14" xml:id="d715-f1-content">
                <p>Feodor Tarasoviteh Gousev.</p>
            </note>
        </listAnnotation>
    </standOff>
