    <text>
        <body>
            <div xml:id="d736">

                <pb facs="0835" n="825" sameAs="frus:frus1943v01/pg825"/>

                <note rend="inline" type="source">550.AD1/15: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in the United Kingdom</hi> (<hi
                        rendition="#italic">Matthews</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1943-03-29T20:00:00+01:00">March 29, 1943—8
                            p.m.</date>
                        <lb/> [Received March 29—6:30 p.m.]</dateline>
                </opener>
                <p>2236. Department’s telegram number 1819, March 24, midnight.<anchor n="12"
                        xml:id="d736-f1"/> The Prime Minister informs me that the British Government
                    has no objection to inviting the four countries concerned.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Matthews</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
