    <text>
        <body>
            <div xml:id="d751">

                <pb facs="0848" n="838" sameAs="frus:frus1943v01/pg838"/>

                <note rend="inline" type="source">550.AD1/319a: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Consul General at Algiers</hi> (<hi rendition="#italic"
                            >Wiley</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-04-26T00:00:00-04:00">April 26,
                            1943—midnight.</date>
                    </dateline>
                </opener>
                <p>803. For Murphy. Your 679, April 22.<anchor n="33" xml:id="d751-f1"/> On the
                    understanding that a delegation will be named jointly by the High Command and
                        <pb facs="0849" n="839" xml:id="pg839"/> the National Committee, you are
                    authorized to extend formally to the appropriate French authorities the
                    invitation quoted in the Department’s 712, April 14.<anchor n="35"
                        xml:id="d751-f2"/> It is, of course, understood that the French
                    representatives will participate in the food conference with the same status as
                    representatives of other countries.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d751-f1" n="33" xml:id="d751-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d751-f2" n="35" xml:id="d751-f2-content">
                <p>See telegram No. 2384, April 14, midnight, to the Ambassador in the United
                    Kingdom, <ref target="#pg837">p. 837</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
