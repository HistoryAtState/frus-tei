                <pb facs="0800" n="790" sameAs="frus:frus1943v01/pg790"/>

                <note rend="inline" type="source">740.00119 MPC/9b: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in the
                        United Kingdom</hi> (<hi rendition="#italic">Winant</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-09-28T23:00:00-04:00">September 28,
                            1943—11 p.m.</date>
                    </dateline>
                </opener>
                <p>5974. The President has appointed Mr. Edwin C. Wilson, presently Ambassador to
                    Panama, as the representative of this Government on the Mediterranean
                    Commission.</p>
                <p>Please inform the appropriate authorities.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Berle</hi>
                    </signed>
                </closer>
            </div>
        </body>
