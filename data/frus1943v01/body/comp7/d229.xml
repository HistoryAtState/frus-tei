            <div xml:id="d229">

                <pb facs="0267" n="257" xml:id="pg257"/>

                <note rend="inline" type="source">852.48/1408: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Spain</hi>
                        (<hi rendition="#italic">Hayes</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-01-28T19:00:00-04:00">January 28, 1943—7
                            p.m.</date>
                    </dateline>
                </opener>
                <p>187. Your 17, January 4, 10 a.m., and 75, January 12, midnight. This matter was
                    discussed with Ambassador Cárdenas on Tuesday on the basis of your telegrams
                    under reference.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
