    <text>
        <body>
            <div xml:id="d276">

                <pb facs="0298" n="288" xml:id="pg288"/>

                <note rend="inline" type="source">852.48/1489: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Spain</hi> (<hi
                            rendition="#italic">Hayes</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Madrid</hi></placeName>, <date
                            calendar="gregorian" when="1943-04-08T13:00:00+01:00">April 8, 1943—1
                            p.m.</date>
                        <lb/> [Received April 8—12:35 p.m.]</dateline>
                </opener>
                <p>844. My 793, April 1, midnight. Foreign Office has given oral assurances refugees
                    who succeed in entering Spain will not be returned to France.</p>
                <p>Repeated to Algiers for Murphy.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hayes</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
