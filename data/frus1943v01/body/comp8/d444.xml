            <div xml:id="d444">

                <pb facs="0441" n="431" sameAs="frus:frus1943v01/pg431"/>

                <note rend="inline" type="source">740.00116 European War 1939/1130: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Chargé in the United Kingdom</hi> (<hi
                            rendition="#italic">Bucknell</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-12-03">December 3,
                        1943</date>.</dateline>
                </opener>
                <p>7644. The Department is interested in learning of the progress that is being made
                    looking to the establishment of the proposed technical committee of experts to
                    advise on tribunals, procedure, rules of evidence, etc., referred to in your
                    7238, October 21, and previous exchanges of communications.</p>
                <p>The Department is considering whether this Government should name a member of the
                    committee.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
