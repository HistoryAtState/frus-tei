    <text>
        <body>
            <div xml:id="d417">

                <pb facs="0416" n="406" sameAs="frus:frus1943v01/pg406"/>

                <note rend="inline" type="source">740.00116 European War 1939/925</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        President Roosevelt
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-05-11">May 11, 1943</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. President</hi>: In accordance with your
                    request I enclose a draft statement which you may wish to make with respect to
                    the use of poison gas by any of our enemies.</p>
                <p>Faithfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Cordell Hull</hi>
                    </signed>
                </closer>


                <xi:include href="d417-a1.xml" xpointer="d417-a1"/>
