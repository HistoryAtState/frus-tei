    <text>
        <body>
            <div xml:id="d492">

                <pb facs="0495" n="485" sameAs="frus:frus1943v01/pg485"/>

                <note rend="inline" type="source">740.00119 European War 1939/1348: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Spain</hi> (<hi rendition="#italic"
                        >Hayes</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Madrid</hi></placeName>, <date
                            calendar="gregorian" when="1943-03-21T14:00:00+01:00">March 21, 1943—2
                            p.m.</date>
                        <lb/> [Received 9:30 p.m.]</dateline>
                </opener>
                <p>W6. Argentine Ambassador<anchor n="2" xml:id="d492-f1"/> informs me that Rumanian
                        Minister<anchor n="3" xml:id="d492-f2"/> on behalf of his Government
                    yesterday requested him and Portuguese Ambassador<anchor n="4" xml:id="d492-f3"
                    /> to serve as intermediaries in communicating Rumania’s desire to make peace
                    with United Nations at earliest possible moment.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hayes</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
