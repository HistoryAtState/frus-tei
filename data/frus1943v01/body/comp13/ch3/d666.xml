    <text>
        <body>
            <div xml:id="d666">

                <pb facs="0742" n="732" sameAs="frus:frus1943v01/pg732"/>

                <note rend="inline" type="source">740.0011 Moscow/10–1943</note>
                <head>
                    <hi rendition="#italic">Mr. Adrian Holman of
                        the British Delegation to Mr. John D.
                            Jernegan of the American Delegation</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Moscow</hi></placeName>, <date
                            calendar="gregorian" when="1943-10-25">25 October,
                        1943</date>.</dateline>
                </opener>
                <p rendition="#center">Conference Document No. 27</p>
                <p>
                    <hi rendition="#small-caps">Dear Jernegan</hi>: I enclose two copies of each of
                    two draft Declarations with respect to Allied policy in Iran which the British
                    Delegation wish to submit as a basis of discussion by the sub-Committee on
                    Iran.</p>
                <p>Copies have been sent also the Soviet Delegation.</p>
                <p>Yours sincerely,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Adrian Holman</hi>
                    </signed>
                </closer>



                <xi:include href="d666-a1.xml" xpointer="d666-a1"/>
                <xi:include href="d666-a2.xml" xpointer="d666-a2"/>
            </div>
