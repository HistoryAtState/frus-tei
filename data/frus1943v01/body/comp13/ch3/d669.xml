                <pb facs="0746" n="736" sameAs="frus:frus1943v01/pg736"/>

                <note rend="inline" type="source">740.0011 Moscow/10–1943</note>
                <head>
                    <hi rendition="#italic">Report of Sub-Committee on Iran Adopted by the
                        Conference</hi>
                </head>
                <dateline>
                    <date ana="#date_undated-inferred-from-chapter-heading" calendar="gregorian"
                        notAfter="1943-11-01T23:59:59+03:00" notBefore="1943-10-18T00:00:00+03:00"
                        >undated</date>
                </dateline>
                <p rendition="#center">Conference Document No. 30</p>
                <quote rend="blockquote">
                    <list>
                        <item>“(<hi rendition="#italic">a</hi>) After an exchange of views, the
                            Committee detects no fundamental difference in the policy towards Iran
                            of any of the three Governments;</item>
                        <item>“(<hi rendition="#italic">b</hi>) the Committee was unable to reach
                            agreement on the expediency of making any immediate declaration or
                            declarations with regard to Iran; and</item>
                        <item>“(<hi rendition="#italic">c</hi>) the issue of such a declaration or
                            declarations might be further considered by the representatives of the
                            three Governments in Tehran, with a view to the three Governments coming
                            to a decision about the expediency of issuing such a declaration or
                            declarations after the signature of the proposed Irano-American
                            Agreement and after appropriate consultation with the Government of
                            Iran.”</item>
                    </list>
                </quote>
            </div>
        </body>
    </text>
