                <pb facs="0747" n="737" sameAs="frus:frus1943v01/pg737"/>

                <note rend="inline" type="source">740.0011 Moscow/10–1943</note>
                <head>
                    <hi rendition="#italic">British Draft of Resolution on Peace Feelers From Enemy
                        Countries</hi>
                </head>
                <dateline>
                    <date ana="#date_undated-inferred-from-chapter-heading" calendar="gregorian"
                        notAfter="1943-11-01T23:59:59+03:00" notBefore="1943-10-18T00:00:00+03:00"
                        >undated</date>
                </dateline>
                <p rendition="#center">Conference Document No. 33</p>
                <quote rend="blockquote">
                    <p>“The Governments of the United Kingdom, the United States of America and the
                        U.S.S.R. agree to inform each other immediately of any peace-feelers which
                        they may receive from the Government of, or from any groups or individuals
                        in, a country with which any of them is at war.</p>
                    <p>The three Governments further agree to consult together with a view to
                        concerting their action in regard to such approaches.”</p>
                </quote>
            </div>
