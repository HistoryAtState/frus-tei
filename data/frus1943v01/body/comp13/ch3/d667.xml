    <text>
        <body>
            <div xml:id="d667">

                <pb facs="0744" n="734" xml:id="pg734"/>

                <note rend="inline" type="source">740.0011 Moscow/10–1943</note>
                <head>
                    <hi rendition="#italic">Mr. W. A. B. Iliff of the British Delegation to Mr. John
                        D. Jernegan of the American Delegation</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Moscow</hi></placeName>, <date
                            calendar="gregorian" when="1943-10-25">25 October,
                        1943</date>.</dateline>
                </opener>
                <p rendition="#center">Conference Document No. 28</p>
                <p>
                    <hi rendition="#small-caps">Dear Jernegan</hi>: I enclose two copies of Draft
                    Proposals for a Financial Agreement under Article IV (2) of the
                    Anglo-Soviet-Persian Treaty of January 1942, with respect to the use by the
                    Allies of the Iranian State Railway.</p>
                <p>The document has been prepared by the British Delegation as a basis for
                    discussion by the sub-Committee on Persia.</p>
                <p>Copies have been sent to the Soviet Delegation.</p>
                <p>Yours sincerely,</p>
                <closer>
                    <signed>W. A. B. <hi rendition="#small-caps">Iliff</hi>
                    </signed>
                </closer>


                <xi:include href="d667-a1.xml" xpointer="d667-a1"/>
            </div>
        </body>
    </text>
