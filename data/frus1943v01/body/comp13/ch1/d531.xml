                <pb facs="0538" n="528" sameAs="frus:frus1943v01/pg528"/>

                <note rend="inline" type="source">740.0011 European War/9–1843: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Chargé in the Soviet Union</hi> (<hi rendition="#italic"
                            >Hamilton</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-09-21T20:00:00-04:00">September 21,
                            1943—8 p.m.</date>
                    </dateline>
                </opener>
                <p>886. Reference Department’s 874, September 18, 7 p.m. Please endeavor to
                    ascertain from the Soviet Government when we may expect their suggestions for an
                    agenda and comments on those submitted in our telegram under reference.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
