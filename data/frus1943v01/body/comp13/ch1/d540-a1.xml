    <text>
        <body>
            <div xml:id="d540-a1">

                <pb facs="0548" n="538" sameAs="frus:frus1943v01/pg538"/>

                <opener>
                    <seg rendition="#center">[Enclosure]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">The British Secretary of State for Foreign Affairs</hi>
                        (<hi rendition="#italic">Eden</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >London</hi></placeName>,] <date calendar="gregorian"
                            when="1943-10-03">October 3, 1943</date>.</dateline>
                </opener>
                <p>So glad we are to do this work together. Delighted to meet you for preliminary
                    talks either in London or in Cairo whichever suits you. Please let me know your
                    dates and mode of travel.</p>
                <closer>[File copy not signed]</closer>
            </div>
        </body>
    </text>
