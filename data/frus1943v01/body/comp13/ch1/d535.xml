    <text>
        <body>
            <div xml:id="d535">

                <pb facs="0541" n="531" sameAs="frus:frus1943v01/pg531"/>

                <note rend="inline" type="source">740.0011 Moscow/8½</note>
                <head>
                    <hi rendition="#italic">The British Embassy to the Department of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 612</seg>
                </opener>
                <p>His Majesty’s Embassy enclose the text of an amendment which His Majesty’s
                    Government desire to offer to the draft 4-Power Declaration.<anchor n="36a"
                        xml:id="d535-f1"/> The proposed amendment has been approved by the Cabinet
                    in London after consultation with the Governments of His Majesty’s <pb
                        facs="0542" n="532" xml:id="pg532"/> Dominions. Unless the United States
                    Government sees any objection, His Majesty’s Government propose to communicate
                    it to the Soviet Government.</p>
                <closer>
                    <dateline rendition="#float-left">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1943-09-28">September 28,
                            1943</date>.</dateline>
                </closer>



                <xi:include href="d535-a1.xml" xpointer="d535-a1"/>
                <xi:include href="d535-a2.xml" xpointer="d535-a2"/>
            </div>
