    <text>
        <body>
            <div xml:id="d619">

                <pb facs="0695" n="685" xml:id="pg685"/>

                <head>
                    <hi rendition="#italic">President Roosevelt to the Secretary of State
                        </hi><anchor n="49" xml:id="d619-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1943-10-30T20:20:00-04:00">30 October 1943—8:20 p.m.</date>
                    </dateline>
                </opener>
                <p>310051. Personal for the Secretary of State. My 302232.<anchor n="50"
                        xml:id="d619-f2"/> Final disposition of all Italian ships should apply to
                    those used by British and Americans as well as to those used by Russians.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Roosevelt</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
