        <body>
            <div xml:id="d2">

                <pb facs="0010" n="2" xml:id="pg2"/>

                <note rend="inline" type="source">741.5127/3a: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Chargé in the
                        United Kingdom</hi> (<hi rendition="#italic">Johnson</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1939-01-09T19:00:00-05:00">January 9, 1939—7
                        p.m.</date></dateline>
                </opener>
                <p>24. Department’s 13, January 6, 6 p.m., Antarctic. In a supplementary note please
                    request the appropriate authorities to be good enough to convey the contents of
                    your first note to His Majesty’s Governments in Australia and New Zealand.</p>
                <closer><signed><hi rendition="#small-caps">Welles</hi></signed></closer>
            </div>
        </body>
