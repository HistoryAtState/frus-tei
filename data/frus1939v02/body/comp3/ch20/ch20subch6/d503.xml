                <pb facs="0555" n="547" xml:id="pg547"/>

                <note rend="inline" type="source">851.731/143: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic">Bullitt</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1939-10-16T12:00:00+01:00">October 16,
                        1939—noon</date>.<lb/>[Received October 16—10:25 a.m.]</dateline>
                </opener>
                <p>2481. Your 1210, October 10, 7 p.m., and my 2415, October 11, 11 a.m. Bern
                    authorities have approved the six codes mentioned in my 2203 and communication
                    companies have been so informed effective today.</p>
                <closer><signed><hi rendition="#small-caps">Bullitt</hi></signed></closer>
            </div>
        </body>
