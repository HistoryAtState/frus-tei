    <text>
        <body>
            <div xml:id="d355">

                <pb facs="0410" n="402" sameAs="frus:frus1939v02/pg402"/>

                <note rend="inline" type="source">765.75/458</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Albanian Minister</hi> (<hi rendition="#italic"
                            >Konitza</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1939-04-14">April 14, 1939</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your communication of April 8, 1939 informing me that, in supplement to the
                    oral protest you made on April 7, 1939 against Italian aggression in Albania,
                    the Albanian authorities have directed you to enter a new protest against the
                    violation of treaties signed by Albania and Italy, including the Kellogg
                    Pact.</p>
                <p>I have the honor to inform you that I made a statement to the press on April 8,
                    1939 setting forth the views of this Government with respect to this
                        matter.<anchor n="46" xml:id="d355-f1"/></p>
                <p>Accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Cordell Hull</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d355-f1" n="46" xml:id="d355-f1-content">
                <p>See Department of State, <hi rendition="#italic">Press Releases</hi>, April 8,
                    1939, p. 261.</p>
            </note>
        </listAnnotation>
    </standOff>
