    <text>
        <body>
            <div xml:id="d623">

                <pb facs="0683" n="675" xml:id="pg675"/>

                <note rend="inline" type="source">124.60C/92: Telegram</note>
                <head><hi rendition="#italic">The Minister in Switzerland</hi> (<hi rendition="#italic">Harrison</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Bern</hi></placeName>, <date calendar="gregorian" when="1939-09-15"
                            >September 15, 1939</date>.<lb/>[Received September 15—1:35
                        p.m.]</dateline>
                </opener>
                <p>107. My 106, September 13, 5 p.m.<anchor n="12" xml:id="d623-f1"/> I have
                    received following telegram from Biddle from Krzemieniec<anchor n="13"
                        xml:id="d623-f2"/> dated September 11, 11 a.m.</p>
                <quote rend="blockquote">
                    <p>“Embassy has been evacuated with Government from Warsaw. Cable address now
                        American Embassy Poland. Embassy unable at present time to communicate with
                        Consulate General which remains in Warsaw.”</p>
                </quote>
                <closer><signed><hi rendition="#small-caps">Harrison</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d623-f1" n="12" xml:id="d623-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d623-f2" n="13" xml:id="d623-f2-content">
                <p>In southeastern Poland.</p>
            </note>
        </listAnnotation>
    </standOff>
