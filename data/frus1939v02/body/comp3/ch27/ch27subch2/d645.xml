            </note>
            <note corresp="#d645-f2" n="45" xml:id="d645-f2-content">
                <p>R. A. Alexis Leger, Secretary-General of the French Ministry for Foreign
                    Affairs.</p>
            </note>
            <note corresp="#d645-f3" n="46" xml:id="d645-f3-content">
                <p>Edouard Daladier, French Prime Minister.</p>
            </note>
        </listAnnotation>
