                <pb facs="0287" n="271" xml:id="pg271"/>

                <note rend="inline" type="source">795.00/3–2751</note>
                <head>
                    <hi rendition="#italic">Memorandum of Conversation, by Robert E. Barbour of the
                        Bureau of Far Eastern Affairs</hi><anchor n="1" xml:id="d188-f1"/>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1951-03-27">March 27, 1951</date>.</dateline>
                </opener>
                <p rendition="#flush">Subject: Briefing of Ambassadors on Korea</p>
                <table cols="3" rows="26">
                    <row role="label">
                        <cell rendition="#top">Participants:</cell>
