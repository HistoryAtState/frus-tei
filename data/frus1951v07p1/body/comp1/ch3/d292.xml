                <pb facs="0458" n="442" sameAs="frus:frus1951v07p1/pg442"/>

                <note rend="inline" type="source">795.00/5–1851</note>
                <head>
                    <hi rendition="#italic">Memorandum of Conversation, by Windsor G. Hackler of the
                        Bureau of Far Eastern Affairs</hi>
                </head>
                <opener>
