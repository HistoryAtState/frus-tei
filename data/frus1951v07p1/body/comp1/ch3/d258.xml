                <pb facs="0394" n="378" sameAs="frus:frus1951v07p1/pg378"/>

                <note rend="inline" type="source">795.00/4–2451</note>
                <head>
                    <hi rendition="#italic">Memorandum of Conversation, by Robert E. Barbour of the
