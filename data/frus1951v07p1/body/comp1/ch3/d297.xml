        <body>
            <div xml:id="d297">

                <pb facs="0471" n="455" sameAs="frus:frus1951v07p1/pg455"/>

                <note rend="inline" type="source">795.00/5–2551</note>
                <head>
                    <hi rendition="#italic">Memorandum of Conversation, by Windsor G. Hackler of the
                        Bureau of Far Eastern Affairs</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1951-05-25">May 25, 1951</date>.</dateline>
                </opener>
                <p rendition="#flush">Subject: Briefing of Ambassadors on Korea</p>
                <table cols="3" rows="23">
                    <row role="label">
                        <cell>Participants:</cell>
                        <cell>Australia</cell>
                        <cell>—Mr. McNichol, Second Secretary</cell>
