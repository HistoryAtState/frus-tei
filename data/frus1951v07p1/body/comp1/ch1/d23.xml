            </note>
            <note corresp="#d23-f3" n="2" xml:id="d23-f3-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d23-f4" n="3" xml:id="d23-f4-content">
                <p>Syngman Rhee, President of the Republic of Korea.</p>
            </note>
            <note corresp="#d23-f5" n="2" xml:id="d23-f5-content">
