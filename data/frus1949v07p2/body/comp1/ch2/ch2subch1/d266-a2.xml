                <pb facs="0462" n="1048" sameAs="frus:frus1949v07p2/pg1048"/>

                <head>Appendix A</head>
                <p rendition="#center">
                    <hi rendition="#small-caps">Facts Bearing on the Problem</hi>
                </p>
                <p>1. Strength of South Korean Security Forces.</p>
