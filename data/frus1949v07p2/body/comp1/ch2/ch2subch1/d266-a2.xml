                            </cell>
                            <cell/>
                            <cell/>
                        </row>
                        <row>
                            <cell/>
                            <cell role="dot-leader">Peoples Army</cell>
                            <cell role="num">46,000</cell>
                            <cell/>
                        </row>
                        <row>
                            <cell/>
                            <cell role="dot-leader">Police and para-military forces</cell>
                            <cell rendition="#underline" role="num"> 56,350</cell>
                            <cell/>
                        </row>
