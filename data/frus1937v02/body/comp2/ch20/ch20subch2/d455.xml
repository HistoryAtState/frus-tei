    <text>
        <body>
            <div xml:id="d455">

                <pb facs="0603" n="592" sameAs="frus:frus1937v02/pg592"/>

                <note rend="inline" type="source">611.60H31/68</note>
                <head><hi rendition="#italic">The Yugoslav Minister</hi> (<hi
                            rendition="#italic">Fotitch</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi><anchor n="11"
                        xml:id="d455-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1937-11-11">November 11, 1937</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: With reference to your
                    memorandum of June 4, 1937, with which you had the kindness to send me the
                    proposals of your Government for the regulation of commercial relations between
                    our two countries, I have the honor to send you herewith enclosed the proposals
                    of the Yugoslav Government. At this occasion I would like to point out that the
                    Royal Government, in drawing up these proposals, was animated by the desire to
                    meet the wishes of the American Government to the utmost, in order to bring
                    about the improvement and strengthening of commercial relations between our two
                    countries.</p>
                <p>Accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Constantin
                    Fotitch</hi></signed></closer>


                <xi:include href="d455-a1.xml" xpointer="d455-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d455-f1" n="11" type="source" xml:id="d455-f1-content">
                <p>Handed to the Under Secretary of State on November 12.</p>
            </note>
