    <text>
        <body>
            <div xml:id="d321">

                <pb facs="0444" n="433" sameAs="frus:frus1937v02/pg433"/>

                <note rend="inline" type="source">211.68/156: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Greece</hi> (<hi rendition="#italic"
                        >Shantz</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Athens</hi></placeName>, <date calendar="gregorian"
                            when="1937-09-02T14:00:00+02:00">September 2, 1937—2
                        p.m.</date><lb/>[Received September 2—9:45 a.m.]</dateline>
                </opener>
                <p>63. Department’s telegram No. 34, August 9, 5 p.m. Protocol signed today.<anchor
                        n="21" xml:id="d321-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Shantz</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d321-f1" n="21" xml:id="d321-f1-content">
                <p>Printed as Department of State Executive Agreement Series No. 114. Text identical
                    with draft protocol, <ref target="#pg428">p. 428</ref>. In despatch No. 2185,
                    March 28, 1938, the Minister in Greece reported that the Greek Government had
                    ratified the interpretative protocol by Emergency Law No. 1115 of February 26,
                    1938, making it legally effective as of the date of its signature
                    (211.68/167).</p>
            </note>
        </listAnnotation>
    </standOff>
