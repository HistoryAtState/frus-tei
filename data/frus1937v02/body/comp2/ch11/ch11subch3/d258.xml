    <text>
        <body>
            <div xml:id="d258">

                <pb facs="0361" n="350" sameAs="frus:frus1937v02/pg350"/>

                <note rend="inline" type="source">462.11L5232/834</note>
                <head><hi rendition="#italic">The Secretary of State to the German Ambassador</hi>
                        (<hi rendition="#italic">Luther</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1937-04-08">April 8, 1937</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I have the honor to acknowledge the
                    receipt of your note of April 5 regarding the attitude of your Government with
                    respect to the so-called sabotage claims pending before the Mixed Claims
                    Commission, United States and Germany, and to state that a copy of your note has
                    been transmitted to the American Agent with the request that he lay it before
                    the Commission for its consideration.</p>
                <p>Accept [etc.]</p>
                <closer>For the Secretary of State:<lb/>[File copy not signed.]</closer>
            </div>
        </body>
    </text>
