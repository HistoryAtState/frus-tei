    <text>
        <body>
            <div xml:id="d294">

                <pb facs="0406" n="395" sameAs="frus:frus1937v02/pg395"/>

                <note rend="inline" type="source">862.1121 Hirsch, Helmut/14: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Ambassador in Germany</hi> (<hi rendition="#italic"
                            >Dodd</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1937-04-21T18:00:00-05:00">April 21, 1937—6 p.m.</date></dateline>
                </opener>
                <p>31. Your number 77, April 20, 4 p.m.<anchor n="4" xml:id="d294-f1"/>
                    Investigation shows that Helmut Hirsch is an American citizen. You are
                    authorized to communicate this information to the German officials, and do
                    whatever is possible to prevent any injustice to the party.</p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
    </text>
