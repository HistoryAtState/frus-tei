    <text>
        <body>
            <div xml:id="d169">

                <pb facs="0252" n="241" sameAs="frus:frus1937v02/pg241"/>

                <note rend="inline" type="source">611.60F31/185: Telegram</note>
                <head><hi rendition="#italic">The Minister in Czechoslovakia</hi> (<hi
                        rendition="#italic">Wright</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Praha</hi></placeName>, <date calendar="gregorian"
                            when="1937-03-30T16:00:00+01:00">March 30, 1937—4
                        p.m.</date><lb/>[Received March 30—12:40 p.m.]</dateline>
                </opener>
                <p>16. Your telegram No. 6, March 27, 2 p.m.<anchor n="8" xml:id="d169-f1"/>
                    Proposal for undertaking of trade agreement negotiations discussed today with
                    Minister for Foreign Affairs<anchor n="9" xml:id="d169-f2"/> and Chief of
                    Economic Section Foreign Office and copy of <hi rendition="#italic"
                        >aide-mémoire</hi> given to each. Czech Legation has reported receipt of
                    your note and immediate consideration of matter is promised.</p>
                <closer><signed><hi rendition="#small-caps">Wright</hi></signed></closer>
            </div>
        </body>
    </text>
