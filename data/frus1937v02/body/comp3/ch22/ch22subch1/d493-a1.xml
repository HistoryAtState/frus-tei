                    <item>Luxor Boys.</item>
                    <label>16.</label>
                    <item>Beni Suef Girls.</item>
                    <label>17.</label>
                    <item>Benha Girls.</item>
                    <pb facs="0672" n="661" xml:id="pg661"/>
                    <label>18.</label>
                    <item>Mansura Girls.</item>
                    <label>19.</label>
