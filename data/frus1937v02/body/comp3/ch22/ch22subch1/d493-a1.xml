                    <label>20.</label>
                    <item>Minet el Gamh.</item>
                    <label>21.</label>
                    <item>Estanha.</item>
                    <label>22.</label>
                    <item>Mehella Kubra.</item>
                    <label>23.</label>
                    <item>Dessouk.</item>
                    <label>24.</label>
                    <item>Sombat.</item>
                    <label>25.</label>
                    <item>Birket es Saba.</item>
                    <label>26.</label>
                    <item>Mit Yaish.</item>
                    <label>27.</label>
                    <item>Benha Boys.</item>
                    <label>28.</label>
                    <item>Mansura Boys.</item>
                    <label>29.</label>
