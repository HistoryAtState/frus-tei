    <text>
        <body>
            <div xml:id="d654">

                <pb facs="0872" n="861" sameAs="frus:frus1937v02/pg861"/>

                <note rend="inline" type="source">781.003/26: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in the United Kingdom</hi> (<hi
                        rendition="#italic">Bingham</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1937-07-30T13:00:00+01:00">July 30, 1937—1
                        p.m.</date><lb/>[Received July 30—9:15 a.m.]</dateline>
                </opener>
                <p>512. My 506, July 27, 6 p.m.<anchor n="8" xml:id="d654-f1"/> Foreign Office
                    informs me that Anglo-French Convention for the Abolition of British
                    capitulations in French Morocco was signed in London yesterday.<anchor n="9"
                        xml:id="d654-f2"/></p>
                <closer><signed><hi rendition="#small-caps">Bingham</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d654-f1" n="8" xml:id="d654-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d654-f2" n="9" xml:id="d654-f2-content">
                <p>For text, see British Treaty Series No. 8 (1938), or British Cmd. 5538,
                    Miscellaneous No. 7 (1937): <hi rendition="#italic">Convention for the Abolition
                        of Capitulations in Morocco and Zanzibar.</hi></p>
            </note>
        </listAnnotation>
