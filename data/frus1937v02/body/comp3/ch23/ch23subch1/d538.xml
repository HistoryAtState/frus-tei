    <text>
        <body>
            <div xml:id="d538">

                <pb facs="0708" n="697" sameAs="frus:frus1937v02/pg697"/>

                <note rend="inline" type="source">123H875/245: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Ethiopia</hi> (<hi
                            rendition="#italic">Hughes</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi><anchor n="9"
                        xml:id="d538-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">Addis
                                Ababa</hi></placeName>, <date calendar="gregorian"
                            when="1937-04-08T18:00:00+03:00">April 8, 1937—6
                        p.m.</date><lb/>[Received April 10—6:05 a.m.]</dateline>
                </opener>
                <p>90. Departing for Djibouti tomorrow early with Hunter and Colquitt.<anchor n="10"
                        xml:id="d538-f2"/>…</p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d538-f1" n="9" type="source" xml:id="d538-f1-content">
                <p>This is the last message from the Legation at Addis Ababa. The Legation and
                    Consulate were closed and all official American representatives were
                    withdrawn.</p>
            </note>
            <note corresp="#d538-f2" n="10" xml:id="d538-f2-content">
                <p>Robert L. Hunter and Adrian B. Colquitt, Vice Consuls.</p>
            </note>
        </listAnnotation>
    </standOff>
