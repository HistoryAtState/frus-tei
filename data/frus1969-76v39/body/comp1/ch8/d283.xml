                <pb facs="0855" n="820" sameAs="frus:frus1969-76v39/pg820"/>

                <head>283. Minutes of Secretary of State Kissinger’s Staff Meeting<anchor n="1" xml:id="d283-f1"/>
                </head>
                <opener><dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            when="1975-05-16T08:00:00-04:00">May 16, 1975, 8 a.m.</date>
                    </dateline></opener>
                <p rendition="#flush">IN ATTENDANCE</p>
