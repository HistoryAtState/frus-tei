    <text>
        <body>
            <div xml:id="d303">

                <pb facs="0355" n="343" sameAs="frus:frus1945v08/pg343"/>

                <note rend="inline" type="source">868.00/8–845: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Ambassador in the Soviet Union</hi> (<hi
                            rendition="#italic">Harriman</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-09-10T17:00:00-04:00">September 10,
                            1945—5 p.m.</date>
                    </dateline>
                </opener>
                <p>1988. Deptels 1710, July 31 and 1818, Aug. 13.<anchor n="78" xml:id="d303-f1"/>
                    Please inform FonOff that Dept has now received replies from French and Brit
                    Govts agreeing to participate in appointing proposed commission and that Dept
                    will appreciate an early expression of Soviet views in matter.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
