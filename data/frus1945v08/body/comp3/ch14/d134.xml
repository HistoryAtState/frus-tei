            <div xml:id="d134">

                <pb facs="0184" n="172" sameAs="frus:frus1945v08/pg172"/>

                <note rend="inline" type="source">868.00/10–945: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Greece</hi> (<hi
                            rendition="#italic">MacVeagh</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Athens</hi></placeName>, <date
                            calendar="gregorian" when="1945-10-09">October 9,
                        1945</date>.<lb/>[Received October 9—4:45 p.m.]</dateline>
                </opener>
                <p>1139. Regent accepted resignation Voulgaris Cabinet noon today.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">MacVeagh</hi>
                    </signed>
                </closer>
            </div>
        </body>
