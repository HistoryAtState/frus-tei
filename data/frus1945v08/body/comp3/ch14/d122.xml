    <text>
        <body>
            <div xml:id="d122">

                <pb facs="0176" n="164" sameAs="frus:frus1945v08/pg164"/>

                <note rend="inline" type="source">868.00/9–2645: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Greece</hi> (<hi rendition="#italic"
                        >MacVeagh</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Athens</hi></placeName>, <date
                            calendar="gregorian" when="1945-09-26T17:00:00+02:00">September 26,
                            1945—5 p.m.</date>
                        <lb/> [Received September 27—8:30 a.m.]</dateline>
                </opener>
                <p>1082. In reply urtel 59, Sept. 24.<anchor n="29" xml:id="d122-f1"/> Matter being
                    concerted with British, French colleagues in accordance your wishes but
                    Frenchman still awaiting instructions (mytel 103 Sept. 25).<anchor n="30"
                        xml:id="d122-f2"/>
                </p>
                <p>Sent London as 105 repeated Dept as 1082.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">MacVeagh</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d122-f1" n="29" xml:id="d122-f1-content">
