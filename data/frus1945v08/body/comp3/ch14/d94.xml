                <pb facs="0155" n="143" sameAs="frus:frus1945v08/pg143"/>

                <note rend="inline" type="source">868.00/8–1845: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Greece</hi> (<hi rendition="#italic"
                            >MacVeagh</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-08-18T15:00:00-04:00">August 18, 1945—3
                            p.m.</date>
                    </dateline>
                </opener>
                <p>827. Please inform Moscow by direct telegram of Greek Govts approval of Allied
                    supervision of elections as soon as conveyed to you by Greek Govt.</p>
                <p>Sent to Athens. Repeated to Moscow, Paris, London.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Byrnes</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
