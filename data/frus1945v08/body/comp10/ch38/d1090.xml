                <pb facs="1133" n="1121" sameAs="frus:frus1945v08/pg1121"/>

                <note rend="inline" type="source">890D.01/5–3145: Telegram</note>
                <head>
                    <hi rendition="#italic">President Truman to the
                        British Prime Minister</hi> (<hi rendition="#italic"
                            >Churchill</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-05-31">31 May, 1945</date>.</dateline>
                </opener>
                <p>50. The telegram to General de Gaulle proposed in your number 59<anchor n="79"
                        xml:id="d1090-f1"/> meets with my approval.</p>
                <closer>[<signed>
                        <hi rendition="#small-caps">Harry</hi> S <hi rendition="#small-caps"
                            >Truman</hi>
                    </signed>]</closer>
            </div>
        </body>
    </text>
