            <div xml:id="d369">

                <pb facs="0419" n="407" xml:id="pg407"/>

                <note rend="inline" type="source">740.00119 Council/9–745: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        Iran</hi> (<hi rendition="#italic">Murray</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-09-13T19:00:00-04:00">September 13,
                            1945—7 p.m.</date>
                    </dateline>
                </opener>
                <p>521. Urtel 702, Sept 7. Dept has communicated Iranian Govt’s views to Secretary
                    in London, on basis of similar representations made by Iranian Legation in
                    Washington.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
