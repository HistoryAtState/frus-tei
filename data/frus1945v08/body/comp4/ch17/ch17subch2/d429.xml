    <text>
        <body>
            <div xml:id="d429">

                <pb facs="0469" n="457" sameAs="frus:frus1945v08/pg457"/>

                <note rend="inline" type="source">891.00/11–2645: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Iran</hi> (<hi rendition="#italic"
                            >Murray</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-11-26T16:00:00-05:00">November 26,
                            1945—4 p.m.</date>
                    </dateline>
                </opener>
                <p>649. Please give the Iranian Government a copy of the note to the Soviet
                    Government contained in the Department’s telegram No. 644, November 23, 5
                        p.m.<anchor n="70" xml:id="d429-f1"/> The text is being released to the
                    press here today.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Byrnes</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d429-f1" n="70" xml:id="d429-f1-content">
                <p>Same as No. 10209 to London, <ref target="#pg450">p. 450</ref>.</p>
