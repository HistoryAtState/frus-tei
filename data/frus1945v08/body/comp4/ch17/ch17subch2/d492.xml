    <text>
        <body>
            <div xml:id="d492">

                <pb facs="0522" n="510" sameAs="frus:frus1945v08/pg510"/>

                <note rend="inline" type="source">740.00119 Council/12–2345: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the Soviet Union</hi> (<hi rendition="#italic">Harriman</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Moscow</hi></placeName>, <date
                            calendar="gregorian" when="1945-12-23T13:00:00+03:00">December 23,
                            1945—1 p.m.</date>
                        <lb/> [Received December 23—3:30 a.m.]</dateline>
                </opener>
                <p>4261. Tehran’s 342, Dec 16<anchor n="35" xml:id="d492-f1"/> and <ref
                        target="#pg359">359</ref>, Dec 20.<anchor n="36" xml:id="d492-f2"/>
                        Note<anchor n="37" xml:id="d492-f3"/> sent Foreign Commissariat urging
                    immediate issuance passes for Minor and Gagarine. Secretary prefers not take up
                    this question in Foreign Ministers Conference.</p>
                <p>Sent Tehran 186, repeated Dept 4261.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Harriman</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d492-f1" n="35" xml:id="d492-f1-content">
                <p>Same as telegram 1136, from Tehran, <ref target="#pg499">p. 499</ref>.</p>
            </note>
            <note corresp="#d492-f2" n="36" xml:id="d492-f2-content">
                <p>Same as telegram 1159, from Tehran, <ref target="#pg507">p. 507</ref>.</p>
            </note>
            <note corresp="#d492-f3" n="37" xml:id="d492-f3-content">
                <p>Dated December 22, 1945.</p>
            </note>
        </listAnnotation>
    </standOff>
