    <text>
        <body>
            <div xml:id="d1266">

                <pb facs="1306" n="1294" sameAs="frus:frus1945v08/pg1294"/>

                <note rend="inline" type="source">867.24/12–2944: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Turkey</hi> (<hi rendition="#italic"
                            >Steinhardt</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-01-01T20:00:00-04:00">January 1, 1945—8
                            p.m.</date>
                    </dateline>
                </opener>
                <p>7. Your 2427 of December 29 and your 2437 of December 30.<anchor n="19"
                        xml:id="d1266-f1"/> You are authorized to sign the proposed lend-lease
                    agreement without the accompanying proposed exchange of notes if necessary
                    provided paragraph 4 of such notes is included in the agreement.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stettinius</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
