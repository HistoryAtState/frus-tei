            <div xml:id="d897">

                <pb facs="0930" n="918" sameAs="frus:frus1945v08/pg918"/>

                <note rend="inline" type="source">890F.248/6–2845: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Minister in Saudi
                        Arabia</hi> (<hi rendition="#italic">Eddy</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-06-28T13:00:00-04:00">June 28, 1945—1
                            p.m.</date>
                    </dateline>
                </opener>
                <p>180. Deptel 177 June 25. For your background info during forthcoming discussions
                    with Ibn Saud you are advised that President Truman has approved recommendation
                    for construction of US military airfield at Dhahran.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Grew</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
