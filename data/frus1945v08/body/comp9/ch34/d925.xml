    <text>
        <body>
            <div xml:id="d925">

                <pb facs="0964" n="952" sameAs="frus:frus1945v08/pg952"/>

                <note rend="inline" type="source">890F.24/9–1145: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Minister in Saudi Arabia</hi> (<hi
                            rendition="#italic">Eddy</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-09-11T17:00:00-04:00">September 11,
                            1945—5 p.m.</date>
                    </dateline>
                </opener>
                <p>274. Lend-Lease assistance Saudi Arabia as programmed will be continued 1945
                    despite general discontinuance. Please inform SAG and British
                    representative.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
