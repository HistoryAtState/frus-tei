    <text>
        <body>
            <div xml:id="d907">

                <pb facs="0941" n="929" sameAs="frus:frus1945v08/pg929"/>

                <note rend="inline" type="source">711.90F27/7–1445: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in Saudi Arabia</hi> (<hi
                        rendition="#italic">Eddy</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Jidda</hi></placeName>, <date
                            calendar="gregorian" when="1945-07-14T12:00:00+03:06">July 14,
                            1945—noon</date>.<lb/>[Received 4:10 p.m.]</dateline>
                </opener>
                <p>267. Dept’s 188, July 5. King agreeable to proposal that Dept submit draft
                    bilateral civil air transport agreement for his consideration. Please forward
                    such draft.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Eddy</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
