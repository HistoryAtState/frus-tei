    <text>
        <body>
            <div xml:id="d655">

                <pb facs="0682" n="670" sameAs="frus:frus1945v08/pg670"/>

                <note rend="inline" type="source">881.00/11–2045</note>
                <head>
                    <hi rendition="#italic">The Diplomatic Agent and Consul General at Tangier</hi>
                        (<hi rendition="#italic">Alling</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 146</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Tangier</hi></placeName>, <date
                            calendar="gregorian" when="1945-11-20">November 20,
                        1945</date>.<lb/>[Received November 27.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose a copy of my
                    Note of November 6, 1945, addressed to the President of the Committee of
                    Control, informing him of the method previously used in obtaining the approval
                    of the United States to laws enacted in the International Zone of Tangier. I
                    also enclose a copy of the reply<anchor n="1" xml:id="d655-f1"/> of my French
                    colleague who also informed me orally that he had submitted the matter to the
                    Protectorate authorities at Rabat.</p>
                <p>Very respectfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Paul</hi> H. <hi rendition="#small-caps"
                            >Alling</hi>
                    </signed>
                </closer>


                <xi:include href="d655-a1.xml" xpointer="d655-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d655-f1" n="1" xml:id="d655-f1-content">
                <p>November 17, 1945, not printed; it was an acknowledgment of receipt of the
                    Diplomatic Agent’s note of November 6.</p>
            </note>
        </listAnnotation>
    </standOff>
