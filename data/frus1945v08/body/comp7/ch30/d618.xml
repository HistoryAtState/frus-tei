    <text>
        <body>
            <div xml:id="d618">

                <pb facs="0655" n="643" sameAs="frus:frus1945v08/pg643"/>

                <note rend="inline" type="source">881.00/8–1745: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in France</hi>
                        (<hi rendition="#italic">Caffery</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-08-21T18:00:00-04:00">August 21, 1945—6
                            p.m.</date>
                    </dateline>
                </opener>
                <p>3940. For Villard. Embtel 4978 Aug. 17, 7 p.m.<anchor n="71" xml:id="d618-f1"/>
                    You will be authorized to sign or initial final act after approval of text by
                    Dept.</p>
                <p>French invitation should be transmitted to Dept by the French Embassy in
                    Washington.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Byrnes</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d618-f1" n="71" xml:id="d618-f1-content">
                <p>Not printed; it transmitted a form of a final act of the Conference approved by
                    the four delegations (881.00/8–1745).</p>
            </note>
        </listAnnotation>
    </standOff>
