    <text>
        <body>
            <div xml:id="d821">

                <pb facs="0852" n="840" sameAs="frus:frus1945v08/pg840"/>

                <note rend="inline" type="source">867N.01/12–1045</note>
                <head>
                    <hi rendition="#italic">The British Ambassador to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-12-10">December 10,
                        1945</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Secretary</hi>: I have the honour, under
                    instructions from His Majesty’s Principal Secretary of State for Foreign
                    Affairs, to inform Your Excellency that His Majesty’s Government in the United
                    Kingdom are in agreement with the terms of your note of the 10th December about
                    the Joint Anglo-American Committee of Enquiry to report on the position of the
                    Jews in certain countries of Europe and in Palestine.</p>
                <p>I have the honour [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Halifax</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
