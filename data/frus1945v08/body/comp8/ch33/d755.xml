    <text>
        <body>
            <div xml:id="d755">

                <pb facs="0796" n="784" sameAs="frus:frus1945v08/pg784"/>

                <note rend="inline" type="source">867N.01/10–2245: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in Iraq</hi> (<hi
                            rendition="#italic">Moreland</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi><anchor n="80" xml:id="d755-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Baghdad</hi></placeName>, <date
                            calendar="gregorian" when="1945-10-22T08:00:00+03:00">October 22, 1945—8
                            a.m.</date>
                        <lb/> [Received 10:13 a.m.]</dateline>
                </opener>
                <p>400. Instr 312, April 21.<anchor n="81" xml:id="d755-f2"/> FonOff has asked
                    whether any objection to release of Roosevelt letter dated April 12 to Regent
                    assuring “full consultation with both Arabs and Jews” re Palestine.</p>
                <p>In view similarity with letter quoted Deptel 312, October 18,<anchor n="82"
                        xml:id="d755-f3"/> I told Foreign Office I perceived no objection.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Moreland</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d755-f1" n="80" type="source" xml:id="d755-f1-content">
                <p>Marginal notation by the Secretary of State: “O.K. J[ames] F. B[yrnes].”</p>
            </note>
            <note corresp="#d755-f2" n="81" xml:id="d755-f2-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d755-f3" n="82" xml:id="d755-f3-content">
                <p>Not printed, but see footnote 70, <ref target="#pg770">p. 770</ref>, and
                    President Roosevelt’s letter of April 5 to King Ibn Saud, <ref target="#pg698"
                        >p. 698</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
