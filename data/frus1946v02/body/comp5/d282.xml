    <text>
        <body>
            <div xml:id="d282">

                <pb facs="0965" n="941" sameAs="frus:frus1946v02/pg941"/>

                <note rend="inline" type="source">740.0011 EW (Peace)/9–346</note>
                <head><hi rendition="#italic">The Chinese Foreign Minister</hi> (<hi rendition="#italic">Wang Shih-chieh</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1946-09-03">September 3, 1946</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Dear Mr. Byrnes</hi>: I beg to send you herewith for
                    your consideration a memorandum containing the views of my Government on the
                    question of the procedure to be followed by the Council of Foreign Ministers
                    regarding peace settlement with Germany.</p>
                <p>This memorandum is being addressed to other Members of the Council of Foreign
                    Ministers.</p>
                <p>Yours sincerely,</p>
                <closer><signed><hi rendition="#small-caps">Wang Shih-chieh</hi></signed></closer>


                <xi:include href="d282-a1.xml" xpointer="d282-a1"/>
