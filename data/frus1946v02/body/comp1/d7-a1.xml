                <opener>
                    <seg rendition="#center">[Enclosure]</seg>
                </opener>
                <head><hi rendition="#small-caps">Statistical Data</hi></head>
                <table cols="4" rows="6">
                    <row role="label">
                        <cell rendition="#border-bottom #border-right #border-top"><hi
                                rendition="#italic">Point of<lb/>Adjustment</hi></cell>
                        <cell rendition="#border-bottom #border-right #border-top"><hi
                                rendition="#italic">Localities<lb/>included</hi></cell>
                        <cell rendition="#border-bottom #border-right #border-top"><hi
                                rendition="#italic">Population</hi></cell>
                        <cell rendition="#border-bottom #border-top"><hi rendition="#italic"
                                >Area</hi><lb/>(<hi rendition="#italic">in Sq. Km</hi>).</cell>
                    </row>
                    <row>
                        <cell rendition="#border-bottom #border-right">1. Little St. Bernard.</cell>
                        <cell rendition="#border-bottom #border-right">None</cell>
                        <cell rendition="#border-bottom #border-right #nowrap">Very small</cell>
                        <cell rendition="#border-bottom" role="num">3</cell>
                    </row>
                    <row>
                        <cell rendition="#border-bottom #border-right">2. Mont Cenis.</cell>
                        <cell rendition="#border-bottom #border-right">None</cell>
                        <cell rendition="#border-bottom #border-right #nowrap">Very small</cell>
                        <cell rendition="#border-bottom" role="num">80</cell>
                    </row>
                    <row>
                        <cell rendition="#border-bottom #border-right">3. Area
                            Mont-Thabor-Chaberton.</cell>
                        <cell rendition="#border-bottom #border-right">None</cell>
                        <cell rendition="#border-bottom #border-right #nowrap">Very small</cell>
                        <cell rendition="#border-bottom" role="num">61</cell>
                    </row>
                    <row>
                        <cell rendition="#border-bottom #border-right">4. Tenda Area.</cell>
                        <cell rendition="#border-bottom #border-right">Tenda San Dalmazzo Brigue a
                            few small villages.</cell>
                        <cell rendition="#border-bottom #border-right" role="num">5,000</cell>
                        <cell rendition="#border-bottom" role="num">580</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell>Total</cell>
                        <cell rendition="#nowrap">5,000 approx.</cell>
                        <cell rendition="#nowrap" role="num">720 approx.</cell>
                    </row>
                </table>
