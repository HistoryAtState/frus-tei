    <text>
        <body>
            <div xml:id="d28">

                <pb facs="0052" n="34" sameAs="frus:frus1946v02/pg34"/>

                <note rend="inline" type="source">841.002/3–2246</note>
                <head><hi rendition="#italic">The British Ambassador</hi> (<hi
                            rendition="#italic">Halifax</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">top secret</hi>
                        <lb/>
                        <hi rendition="#small-caps">urgent</hi></seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1946-03-22">22 March, 1946</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">My Dear Secretary of State</hi>: Mr. Bevin received
                    your message through the United States Chargé d’Affaires in London early this
                    morning, March 22nd.<anchor n="56" xml:id="d28-f1"/></p>
                <p>He has asked me to give you the enclosed personal message in reply.</p>
                <p>This personal message was despatched after Mr. Bevin had received my account of
                    my telephone talk with you yesterday.</p>
                <p>Yours sincerely,</p>
                <closer><signed><hi rendition="#small-caps">Halifax</hi></signed></closer>


                <xi:include href="d28-a1.xml" xpointer="d28-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d28-f1" n="56" xml:id="d28-f1-content">
                <p>Reference here is to the message quoted in telegram 2740, March 21, to London,
                        <hi rendition="#italic">supra</hi>.</p>
            </note>
        </listAnnotation>
    </standOff>
