                <pb facs="1402" n="1378" sameAs="frus:frus1946v02/pg1378"/>

                <note rend="inline" type="source">C.F.M. Files: Lot M–88: Box 2080: Records of
                    Decisions</note>
                <head><hi rendition="#italic">Record of Decisions, Council of Foreign Ministers,
                        Third Session, Thirteenth Meeting, Waldorf-Astoria Hotel, New York, December
                        2, 1948, 4 p.m.</hi><anchor n="21" xml:id="d373-f1"/></head>
                <dateline>
                    <placeName>New York</placeName>, <date
                        ana="#date_undated-inferred-from-document-head" calendar="gregorian"
                        when="1948-12-02T16:00:00-05:00">December 2, 1948, 4 p.m.</date>
                </dateline>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">secret</hi></seg>
                    <lb/>
                    <seg rendition="#float-left">CFM(46) (NY) 13th Meeting</seg>
                </opener>
                <p rendition="#center"><hi rendition="#small-caps">Present</hi></p>
