    <text>
        <body>
            <div xml:id="d325">

                <pb facs="1167" n="1143" sameAs="frus:frus1946v02/pg1143"/>

                <note rend="inline" type="source">C.F.M. Files: Lot
                    M–88: Box 2080: Records of Decisions</note>
                <head><hi rendition="#italic">Record of Decisions, Council of Foreign Ministers,
                        Third Session, Eighth Meeting, Waldorf-Astoria Hotel, New York, November 13,
                        1946, 4 p.m.</hi></head>
                <dateline>
                    <placeName>New York</placeName>, <date
                        ana="#date_undated-inferred-from-document-head" calendar="gregorian"
                        when="1946-11-13T16:00:00-05:00">November 13, 1946, 4 p.m.</date>
                </dateline>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">secret</hi></seg>
                    <lb/>
                    <seg rendition="#float-left">CFM(46) (NY)
                        8th Meeting</seg>
                </opener>
                <p rendition="#center"><hi rendition="#small-caps">Present</hi></p>
                <table>
                    <row>
                        <cell/>
                        <cell rend="padding-left: 4em">U.S.S.R.</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell/>
                        <cell>M. Molotov (Chairman)</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell/>
                        <cell>M. Vyshinsky</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell/>
                        <cell>M. Gousev</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell rend="padding-left: 4em">U.K.</cell>
                        <cell/>
                        <cell rend="padding-left: 4em">U.S.A</cell>
                    </row>
                    <row>
                        <cell>Mr. Bevin</cell>
                        <cell/>
                        <cell>Mr. Byrnes</cell>
                    </row>
                    <row>
                        <cell>Sir Oliver Harvey</cell>
                        <cell/>
                        <cell>Mr. Connally</cell>
                    </row>
                    <row>
                        <cell>Mr. Jebb</cell>
                        <cell/>
                        <cell>Mr. Dunn</cell>
                    </row>
                    <row>
                        <cell>Mr. Sterndale Bennett</cell>
                        <cell/>
                        <cell/>
                    </row>
                    <row>
                        <cell/>
                        <cell rend="padding-left: 4em"><hi rendition="#small-caps"
                            >France</hi></cell>
                        <cell/>
                    </row>
                    <row>
                        <cell/>
                        <cell>M. Couve de Murville</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell/>
                        <cell>M. Bonnet</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell/>
                        <cell>M. Alphand</cell>
                        <cell/>
                    </row>
                </table>
                <p rendition="#flush">I <hi rendition="#italic">Peace Treaty With Italy</hi> (<hi
                        rendition="#italic">Continuation of discussion</hi>) <hi rendition="#italic"
                        >Article 16</hi>.</p>
                <p>After an exchange of views on the proposals of the Soviet Delegation set forth in
                        CFM(46) (NY) 13,<anchor n="12"
                        xml:id="d325-f1"/> a decision on this Article was <hi rendition="#italic"
                        >deferred</hi>.</p>
                <p rendition="#flush">II <hi rendition="#italic">Next Meeting of the
                    Council</hi></p>
                <p>Thursday, November 14, at 4:00 p.m.</p>
                <closer>
                    <dateline rendition="#float-left">
                        <placeName>
                            <hi rendition="#small-caps">New York</hi>
                        </placeName>, <date calendar="gregorian" when="1946-11-20">November 20,
                            1946</date>.</dateline>
                </closer>
