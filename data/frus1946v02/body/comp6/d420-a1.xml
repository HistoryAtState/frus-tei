    <text>
        <body>
            <div xml:id="d420-a1">

                <pb facs="1586" n="1562" sameAs="frus:frus1946v02/pg1562"/>

                <opener>
                    <seg rendition="#center">[Enclosure 1]</seg>
                </opener>
                <head><hi rendition="#italic">Copy of a Letter From the President of the
                        Inter-Allied Reparations Agency</hi> (<hi
                            rendition="#italic">Rueff</hi>) <hi rendition="#italic">to
                        the Members of the Council of Foreign
                        Ministers</hi></head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>,] <date calendar="gregorian"
                            when="1946-10-08">October 8, 1946</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Mr. Minister</hi>: In behalf of the Assembly of the
                    Inter-Allied Reparations Agency, I have the honor to transmit to you the
                    enclosed Resolution.</p>
                <p>The Assembly has instructed me to request you to be good enough to place this
                    Resolution on the Agenda of the next meeting of the Council of Foreign
                    Ministers.</p>
                <p>I am sending an identical letter to the Ministers of Foreign Affairs of the
                    Government of. . . . .</p>
                <p>Please accept, etc.</p>
                <closer><signed><hi rendition="#small-caps">Jacques Rueff</hi></signed></closer>
            </div>
        </body>
    </text>
