                <pb facs="1499" n="1475" sameAs="frus:frus1946v02/pg1475"/>

                <note rend="inline" type="source">C.F.M. Files: Lot
                    M–88: Box 2080: Records of Decisions</note>
                <head><hi rendition="#italic">Record of Decisions, Council of Foreign Ministers,
                        Third Session, Eighteenth Meeting, Waldorf-Astoria Hotel, New York, December
                        7, 1946, 10:30 a.m.</hi></head>
                <dateline>
                    <placeName>New York</placeName>, <date
                        ana="#date_undated-inferred-from-document-head" calendar="gregorian"
                        when="1946-12-07T10:30:00-05:00">December 7, 1946, 10:30 a.m.</date>
                </dateline>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">secret</hi></seg>
                    <lb/>
                    <seg rendition="#float-left">CFM(46) (NY)
                        18th Meeting</seg>
                </opener>
                <p rendition="#center"><hi rendition="#small-caps">Present</hi></p>
                <table>
                    <row>
                        <cell/>
