    <text>
        <body>
            <div xml:id="d200">

                <pb facs="0635" n="613" sameAs="frus:frus1946v02/pg613"/>

                <note rend="inline" type="source">C.F.M. Files: Lot
                    M–88: Box 2061: CFM Documents</note>
                <head><hi rendition="#italic">Proposal by the Soviet
                            Delegation to the Council of Foreign
                            Ministers</hi><anchor n="10" xml:id="d200-f1"/></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">secret</hi>
                        <lb/>
                        C.F.M.(46)135</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1946-06-24">24 June, 1946</date>.</dateline>
                </opener>
                <p rendition="#center"><hi rendition="#small-caps">The Danube</hi></p>
                <p>The Council of Foreign Ministers is confident that the riparian States will
                    maintain navigation on the Danube, its navigable tributaries and the canals
                    connected therewith in such a way that this navigation will be free and open to
                    the nationals, merchant vessels and goods of all States, subject to compliance,
                    so long as Allied forces are stationed on the Danube, with the regulations
                    issued by the Officers commanding such forces in the respective zones of
                    occupation.</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d200-f1" n="10" type="source" xml:id="d200-f1-content">
                <p>This proposal was read by Foreign Minister Molotov at the 25th Meeting of the
                    Council of Foreign Ministers, June 24, 1946; for the United States Delegation
                    Record of that meeting, see <ref target="#pg601">p. 601</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
