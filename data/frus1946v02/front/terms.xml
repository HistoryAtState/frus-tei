        <body>
            <div xml:id="terms">

                <pb facs="0017" n="XIII" xml:id="pgXIII"/>

                <head>List of abbreviations and symbols</head>
                <p><hi rendition="#small-caps">Editor’s Note</hi>.—This list does not include
                    standard abbreviations in common usage; unusual abbreviations of rare occurrence
                    which are clarified at appropriate points; and those abbreviations and
                    contractions which, although uncommon, are understandable from the context.</p>
                <list type="terms">
                    <item><hi rendition="#bold"><term sameAs="#t_AC1">AC</term>,</hi> Allied Council
                        for Austria</item>
                    <item><hi rendition="#bold"><term sameAs="#t_AC2">A–C</term>,</hi> Office of the
                        Assistant Secretary of State for Economic Affairs</item>
                    <item><hi rendition="#bold"><term sameAs="#t_ACC1">ACC</term>,</hi> Allied
                        Control Council (for Germany) or Allied Control Commission</item>
                    <item><hi rendition="#bold"><term sameAs="#t_AFHQ1">AFHQ</term>,</hi> Allied
                        Force Headquarters</item>
                    <item><hi rendition="#bold"><term sameAs="#t_AmDel1">AmDel</term>,</hi> American
                        Delegation</item>
                    <item><hi rendition="#bold"><term sameAs="#t_AmPolAd1">AmPolAd</term>,</hi>
                        American Political Adviser</item>
                    <item><hi rendition="#bold"><term sameAs="#t_CCS1">CCS</term>,</hi> Combined
                        Chiefs of Staff</item>
                    <item><hi rendition="#bold"><term sameAs="#t_CE1">CE</term>,</hi> Division of
                        Central European Affairs, Department of State</item>
                    <item><hi rendition="#bold"><term sameAs="#t_CFM1">CFM</term>,</hi> Council of
                        Foreign Ministers</item>
                    <item><hi rendition="#bold"><term sameAs="#t_CFM461">C.F.M.(46)</term>,</hi>
                        document designation for official papers of the Council of Foreign
                        Ministers, second session, Paris</item>
                    <item><hi rendition="#bold"><term sameAs="#t_CFM46NY1"
                            >C.F.M.(46)(NY)</term>,</hi> document designation for official papers of
                        the Council of Foreign Ministers, third session, New York</item>
                    <item><hi rendition="#bold"><term sameAs="#t_CFMD461">C.F.M.(D)(46)</term>,</hi>
                        document designation for official papers of the Deputies of the Council of
                        Foreign Ministers, at London and Paris</item>
                    <item><hi rendition="#bold"><term sameAs="#t_CFMD46NY1"
                            >C.F.M.(D)(46)(NY)</term>,</hi> document designation for official papers
                        of the Deputies of the Council of Foreign Ministers at the third session of
                        the Council, at New York</item>
                    <item><hi rendition="#bold"><term sameAs="#t_CFMDB461"
                            >C.F.M.(D)(B)(46)</term>,</hi> document designation for official papers
                        of the Deputies of the Council of Foreign Ministers, concerned with the
                        Balkan peace treaties</item>
                    <item><hi rendition="#bold"><term sameAs="#t_Delsec1">Delsec</term>,</hi>
                        indicator for telegrams from the United States Delegation to the Council of
                        Foreign Ministers, or the Paris Peace Conference, at times headed by the
                        Secretary of State</item>
                    <item><hi rendition="#bold"><term sameAs="#t_Dept1">Dept</term>,</hi> Department
                        of State</item>
                    <item><hi rendition="#bold"><term sameAs="#t_Emb1">Emb</term>,</hi>
                        Embassy</item>
                    <item><hi rendition="#bold"><term sameAs="#t_Embtel1">Embtel</term>,</hi>
                        Embassy telegram</item>
                    <item><hi rendition="#bold"><term sameAs="#t_FEA1">FEA</term>,</hi> Foreign
                        Economic Administration</item>
                    <item><hi rendition="#bold"><term sameAs="#t_FoMin1">FoMin</term>,</hi> Foreign
                        Minister</item>
                    <item><hi rendition="#bold"><term sameAs="#t_FonMins1">FonMins</term>,</hi>
                        Foreign Ministers, or Council of Foreign Ministers</item>
                    <item><hi rendition="#bold"><term sameAs="#t_FonOff1">FonOff</term>,</hi>
                        Foreign Office</item>
                    <item><hi rendition="#bold"><term sameAs="#t_MRP1">MRP</term>,</hi>
                        <hi rendition="#italic">Mouvement Républicain Populaire</hi> (French
                        political party)</item>
                    <item><hi rendition="#bold"><term sameAs="#t_MTB1">MTB</term>,</hi> Motor
                        Torpedo Boat</item>
                    <item><hi rendition="#bold"><term sameAs="#t_MS1">M/S</term>,</hi>
                        minesweeper</item>
                    <item><hi rendition="#bold"><term sameAs="#t_mytel1">mytel</term>,</hi> my
                        telegram</item>
                    <item><hi rendition="#bold"><term sameAs="#t_NE1">NE</term>,</hi> Division of
                        Near Eastern Affairs, Department of State</item>
                    <item><hi rendition="#bold"><term sameAs="#t_NEA1">NEA</term>,</hi> Office of
                        Near Eastern and African Affairs</item>
                    <item><hi rendition="#bold"><term sameAs="#t_Niact1">Niact</term>,</hi> night
                        action telegram; communications indicator requiring attention by the
                        recipient at any hour of the day or night</item>
                    <item><hi rendition="#bold"><term sameAs="#t_PM1">P.M.</term>,</hi> Prime
                        Minister</item>
                    <item><hi rendition="#bold"><term sameAs="#t_POW1">POW</term>,</hi> Prisoner(s)
                        of War</item>
                    <item><hi rendition="#bold"><term sameAs="#t_reEmbtel1">reEmbtel</term>,</hi>
                        regarding Embassy telegram</item>
                    <item><hi rendition="#bold"><term sameAs="#t_RN1">RN</term>,</hi> Royal
                        Navy</item>
                    <item><hi rendition="#bold"><term sameAs="#t_RNVR1">RNVR</term>,</hi> Royal
                        Naval Volunteer Reserve</item>
                    <item><hi rendition="#bold"><term sameAs="#t_Secdel1">Secdel</term>,</hi>
                        indicator for telegrams to the United States Delegation to the Council of
                        Foreign Ministers, or the Paris Peace Conference, at times headed by the
                        Secretary of State</item>
                    <item><hi rendition="#bold"><term sameAs="#t_tels1">tels</term>,</hi>
                        telegrams</item>
                    <item><hi rendition="#bold"><term sameAs="#t_UNO1">UNO</term>,</hi> United
                        Nations Organization</item>
                    <item><hi rendition="#bold"><term sameAs="#t_UNRRA1">UNRRA</term>,</hi> United
                        Nations Relief and Rehabilitation Administration</item>
                    <item><hi rendition="#bold"><term sameAs="#t_urtel1">urtel</term>,</hi> your
                        telegram</item>
                    <item><hi rendition="#bold"><term sameAs="#t_USDel1">USDel</term>,</hi> United
                        States Delegation</item>
                    <item><hi rendition="#bold"><term sameAs="#t_USDELCFM46NY1"
                                >USDEL(CFM)(46)(NY)</term>,</hi> document designation for the United
                        States Delegation minutes of the meetings of the third session of the
                        Council of Foreign Ministers, at New York</item>
                    <item><hi rendition="#bold"><term sameAs="#t_USN1">USN</term>,</hi> United
                        States Navy</item>
                    <item><hi rendition="#bold"><term sameAs="#t_USNR1">USNR</term>,</hi> United
                        States Naval Reserve</item>
                    <item><hi rendition="#bold"><term sameAs="#t_VEDay1">V–E Day</term>,</hi> the
                        day of Allied victory in Europe, May 7, 1945</item>
                    <item><hi rendition="#bold"><term sameAs="#t_Yugos1">Yugos</term>,</hi>
                        Yugoslavs</item>
                </list>
            </div>
        </body>
    </text>
