    <text>
        <body>
            <div xml:id="d439">

                <pb facs="0512" n="438" sameAs="frus:frus1918Russiav01/pg438"/>

                <note rend="inline" type="source">File No. 763.72119/1572</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Page</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 8633</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1918-03-25">
                            <hi rendition="#italic">March 25, 1918</hi></date>. <lb/> [<hi
                            rendition="#italic">Received April 8.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to my telegram, No. 9157 of
                    March 21,<anchor n="1" xml:id="d439-f1"/> regarding the statement concerning
                    Russia and the German peace made public by the Supreme War Council held in
                    London last week, I have the honor to transmit herewith the text of the
                    statement referred to.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Walter Hines Page</hi>
                    </signed>
                </closer>


                <xi:include href="d439-a1.xml" xpointer="d439-a1"/>
            </div>
        </body>
    </text>
