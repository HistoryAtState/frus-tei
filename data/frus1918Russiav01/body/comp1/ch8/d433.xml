            <div xml:id="d433">

                <pb facs="0507" n="433" sameAs="frus:frus1918Russiav01/pg433"/>

                <note rend="inline" type="source">File No. 763.72119/1401</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Russia</hi> (<hi rendition="#italic"
                        >Francis</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Petrograd</hi></placeName>, <date
                            calendar="gregorian" when="1918-02-24">
                            <hi rendition="#italic">February 24, 1918</hi></date>. <lb/> [<hi
                            rendition="#italic">Received March 1, 3.21 p.m.</hi>]</dateline>
                </opener>
                <p>2409. Executive Committee approved German peace terms as follows: 116 for, 85
                    against, 26 abstaining, Bolsheviks voting solidly <pb facs="0508" n="434"
                        xml:id="pg434"/> for acceptance. Bolshevik caucus voted 72 for, 26 against,
                    12 abstaining. Telegraphic acceptance wired Berlin 6 this morning.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Francis</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
