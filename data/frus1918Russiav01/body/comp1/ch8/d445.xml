    <text>
        <body>
            <div xml:id="d445">

                <pb facs="0550" n="476" xml:id="pg476"/>

                <note rend="inline" type="source">File No. 763.72/11443</note>
                <head>
                    <hi rendition="#italic">The Chargé in Sweden</hi> (<hi rendition="#italic">Whitehouse</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Extract]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 1321</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Stockholm</hi></placeName>, <date
                            calendar="gregorian" when="1918-08-23">
                            <hi rendition="#italic">August 23, 1918</hi></date>. <lb/> [<hi
                            rendition="#italic">Received September 12.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith to
                    the Department, for its information, translated extracts from the <hi
                        rendition="#italic">Stockholms Aftontidningen</hi> of July 28 on Russia’s
                    losses in the Brest peace. …</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Sheldon Whitehouse</hi>
                        
                    </signed>
                </closer>


                <xi:include href="d445-a1.xml" xpointer="d445-a1"/>
            </div>
        </body>
    </text>
