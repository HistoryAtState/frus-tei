    <text>
        <body>
            <div xml:id="d592">

                <pb facs="0699" n="625" sameAs="frus:frus1918Russiav01/pg625"/>

                <note rend="inline" type="source">File No. 123 F84/65a</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Ambassador in Russia</hi> (<hi
                            rendition="#italic">Francis</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-08-03T19:00:00-04:00">
                            <hi rendition="#italic">August 3, 1918, 7 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Department believes important you should remain in Russia and approves your
                    decision to do so.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Polk</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
