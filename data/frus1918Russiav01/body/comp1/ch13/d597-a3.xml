    <text>
        <body>
            <div xml:id="d597-a3">

                <pb facs="0710" n="636" sameAs="frus:frus1918Russiav01/pg636"/>

                <opener>
                    <seg rendition="#center">[Appendix 2—Telegram]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">The American Ambassador</hi> (<hi rendition="#italic"
                        >Francis</hi>) <hi rendition="#italic">to the Soviet Commissar for Foreign
                        Affairs</hi> (<hi rendition="#italic">Chicherin</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <date calendar="gregorian" when="1918-07-24">
                            <hi rendition="#italic">July 24, 1918</hi></date>.</dateline>
                </opener>
                <p>Thank you for your telegram. We fully appreciate the uninterrupted interest you
                    have taken in our personal safety and have decided to follow your advice and are
                    leaving Vologda.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Francis</hi>
                    </signed>
                </closer>
            </div>
        </body>
