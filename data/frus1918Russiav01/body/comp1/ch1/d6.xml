    <text>
        <body>
            <div xml:id="d6">

                <pb facs="0078" n="4" sameAs="frus:frus1918Russiav01/pg4"/>

                <note rend="inline" type="source">File No. 861.00/287</note>
                <head>
                    <hi rendition="#italic">The Russian Ambassador</hi> (<hi rendition="#italic">Bakméteff</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-03-18">
                            <hi rendition="#italic">March 18, 1917</hi></date>. <lb/> [<hi
                            rendition="#italic">Received March 19.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Secretary of State</hi>: I have the honor to
                    transmit herewith a copy of a communication which I have just received from the
                    Minister of Foreign Affairs at Petrograd.</p>
                <p>I take this occasion to renew [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">G. Bakhméteff</hi>
                        
                    </signed>
                </closer>


                <xi:include href="d6-a1.xml" xpointer="d6-a1"/>
