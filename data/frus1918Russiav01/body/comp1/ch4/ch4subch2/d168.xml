    <text>
        <body>
            <div xml:id="d168">

                <pb facs="0275" n="201" sameAs="frus:frus1918Russiav01/pg201"/>

                <note rend="inline" type="source">File No. 861.00/559</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        Russia</hi> (<hi rendition="#italic">Francis</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-10-01">
                            <hi rendition="#italic">October 1, 1917</hi></date>.</dateline>
                </opener>
                <p>1754. Your 1808, September 27, received late night of 30th. The matter will be
                    taken up and reply given at earliest moment.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Polk</hi>
                    </signed>
                </closer>
            </div>
        </body>
