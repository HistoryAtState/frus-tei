    <text>
        <body>
            <div xml:id="d136">

                <pb facs="0250" n="176" sameAs="frus:frus1918Russiav01/pg176"/>

                <note rend="inline" type="source">File No. 861.00/469</note>
                <head>
                    <hi rendition="#italic">The Secretary Attached to the Russian Embassy</hi>
                        (<hi rendition="#italic"
                        >Sookine</hi>) <hi rendition="#italic">to the Counselor for the
                        Department of State</hi> (<hi
                            rendition="#italic">Polk</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-08-09">
                            <hi rendition="#italic">August 9, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Polk</hi>: I have the honor to send you herewith for the
                    information of the Department of State a copy of a telegram which has been
                    received from Petrograd concerning the internal situation in Russia.</p>
                <p>Believe me [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Sookine</hi>
                        
                    </signed>
                </closer>


                <xi:include href="d136-a1.xml" xpointer="d136-a1"/>
            </div>
