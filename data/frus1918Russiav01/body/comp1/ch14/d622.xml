    <text>
        <body>
            <div xml:id="d622">

                <pb facs="0753" n="679" sameAs="frus:frus1918Russiav01/pg679"/>

                <note rend="inline" type="source">File No. 861.00/2900</note>
                <head>
                    <hi rendition="#italic">The Chargé in Norway</hi> (<hi
                            rendition="#italic">Schoenfeld</hi>) <hi rendition="#italic"
                        >to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Christiania</hi></placeName>, <date
                            calendar="gregorian" when="1918-10-07T12:00:00+01:00">
                            <hi rendition="#italic">October 7, 1918, noon</hi></date>. <lb/> [<hi
                            rendition="#italic">Received 10 p.m.</hi>]</dateline>
                </opener>
                <p>1216. <hi rendition="#italic">Note verbale</hi> from the Foreign Office dated
                    October 4 states that a telegram from Norwegian Legation, Petrograd, under date
                    of October 3 reports that the British and French citizens who had sought asylum
                    in the American Consulate General, Moscow, had left and that Norwegian
                    extraterritoriality had not been violated.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Schoenfeld</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
