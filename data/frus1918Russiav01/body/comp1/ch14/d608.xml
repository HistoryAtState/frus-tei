    <text>
        <body>
            <div xml:id="d608">

                <pb facs="0737" n="663" sameAs="frus:frus1918Russiav01/pg663"/>

                <note rend="inline" type="source">File No. 861.00/2774</note>
                <head>
                    <hi rendition="#italic">The Chargé in Sweden</hi> (<hi rendition="#italic"
                        >Whitehouse</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1359</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Stockholm</hi></placeName>, <date
                            calendar="gregorian" when="1918-09-05">
                            <hi rendition="#italic">September 5, 1918</hi></date>. <lb/> [<hi
                            rendition="#italic">Received September 23.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to my telegram No. 2779 of
                    September 5, 1918,<anchor n="1" xml:id="d608-f1"/> I have the honor to enclose
                    herewith a copy and translation of the note sent by the neutral Ministers, in
                    charge of Allied interests in Russia, to Chicherin, the Commissioner of Foreign
                    Affairs, on August 26 last.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Sheldon Whitehouse</hi>
                    </signed>
                </closer>



                <xi:include href="d608-a1.xml" xpointer="d608-a1"/>
            </div>
        </body>
    </text>
