    <text>
        <body>
            <div xml:id="d618">

                <pb facs="0747" n="673" xml:id="pg673"/>

                <note rend="inline" type="source">File No. 861.00/2744</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Great Britain</hi> (<hi
                            rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-09-24T18:00:00-04:00">
                            <hi rendition="#italic">September 24, 1918, 6 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>1581. Department understands important confidential mail report regarding
                    conditions in Petrograd cabled British Foreign Office from Christiania September
                    17 and originated with Netherland Minister to Russia. Department understands
                    Foreign Office might consent to furnishing copy. If so please forward by mail
                    soon as possible.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
