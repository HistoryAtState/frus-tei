    <text>
        <body>
            <div xml:id="d615">

                <pb facs="0745" n="671" sameAs="frus:frus1918Russiav01/pg671"/>

                <note rend="inline" type="source">File No. 123 P 78/48b</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in France</hi>
                        (<hi rendition="#italic">Sharp</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-09-14T19:00:00-04:00">
                            <hi rendition="#italic">September 14, 1918, 7 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>5623. Please forward following telegram for Poole at Moscow immediately by any
                    route available: <quote rend="blockquote">
                        <p>Department has approved your remaining at Moscow but now desires you to
                            proceed immediately Stockholm, Archangel or Omsk whichever you can
                            arrange and report from there. Any Americans remaining should accompany
                            you if possible.</p>
                    </quote>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
