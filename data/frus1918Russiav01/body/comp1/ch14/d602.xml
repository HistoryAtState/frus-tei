    <text>
        <body>
            <div xml:id="d602">

                <pb facs="0720" n="646" sameAs="frus:frus1918Russiav01/pg646"/>

                <note rend="inline" type="source">File No. 861.00/2818</note>
                <head>
                    <hi rendition="#italic">The Consul at Moscow</hi> (<hi rendition="#italic"
                        >Poole</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 10</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Moscow</hi></placeName>, <date
                            calendar="gregorian" when="1918-08-20">
                            <hi rendition="#italic">August 20, 1918</hi></date>. <lb/> [<hi
                            rendition="#italic">Received September 26.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith a
                    memorandum in duplicate concerning the arrest of British and French civilians in
                    Moscow and the detention of the Allied consular corps and military missions.
                    This memorandum has been drawn up at my request by Mr. Armour, Second Secretary
                    of the Embassy, who recently arrived from Vologda, and covers events up until
                    August 13, inclusive. Copies of the documents upon which this memorandum is
                    based are also attached.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">DeW. C. Poole</hi>, Jr. </signed>
                </closer>









