                <pb facs="0190" n="116" sameAs="frus:frus1918Russiav01/pg116"/>

                <note rend="inline" type="source">File No. 763.72/5347</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Russia</hi> (<hi rendition="#italic"
                        >Francis</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Petrograd</hi></placeName>, <date
                            calendar="gregorian" when="1917-06-14">
                            <hi rendition="#italic">June 14, 1917</hi></date>. <lb/> [<hi
                            rendition="#italic">Received June 17, 11 p.m.</hi>]</dateline>
                </opener>
                <p>1397. Presented Diplomatic Commission Minister Foreign Affairs, All commissioners
                    comfortably located Winter Palace. Shall present them formally to Council of
                    Ministers, evening 15th. Everything working satisfactorily.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Francis</hi>
                    </signed>
                </closer>
            </div>
        </body>
