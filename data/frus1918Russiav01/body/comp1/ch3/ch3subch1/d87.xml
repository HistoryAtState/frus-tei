    <text>
        <body>
            <div xml:id="d87">

                <pb facs="0187" n="113" sameAs="frus:frus1918Russiav01/pg113"/>

                <note rend="inline" type="source">File No. 763.72/5548</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Russia</hi> (<hi rendition="#italic"
                        >Francis</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 781</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Petrograd</hi></placeName>, <date
                            calendar="gregorian" when="1917-06-02">
                            <hi rendition="#italic">June 2, 1917</hi></date>. <lb/> [<hi
                            rendition="#italic">Received June 26.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith a
                    copy of a translation of a note from the Russian Minister for Foreign Affairs,
                    dated May 15/28, 1917, in which, acknowledging my communication to him relative
                    to the arrival in Russia of the Special Diplomatic Mission headed by the
                    Honorable Elihu Root, the appreciation of the Russian Government is set forth in
                    terms that will undoubtedly prove as gratifying to the Department as to this
                    Embassy.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">David R. Francis</hi>
                    </signed>
                </closer>


                <xi:include href="d87-a1.xml" xpointer="d87-a1"/>
            </div>
