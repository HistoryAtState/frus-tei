    <text>
        <body>
            <div xml:id="d112">

                <pb facs="0228" n="154" sameAs="frus:frus1918Russiav01/pg154"/>

                <note rend="inline" type="source">File No. 763.72/4531</note>
                <head>
                    <hi rendition="#italic">The Russian Chargé</hi> (<hi rendition="#italic">Onou</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 354</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-05-09">
                            <hi rendition="#italic">May 9, 1917</hi></date>. <lb/> [<hi
                            rendition="#italic">Received May 10.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: Referring to my verbal
                    communication of May 7 instant, I have the honor to transmit herewith to your
                    excellency a memorandum relative to the Extraordinary Embassy which the Russian
                    Provisional Government proposes to send to the United States.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">C. Onou</hi>
                        
                    </signed>
                </closer>


                <xi:include href="d112-a1.xml" xpointer="d112-a1"/>
            </div>
