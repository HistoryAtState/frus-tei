    <text>
        <body>
            <div xml:id="d113">

                <pb facs="0229" n="155" sameAs="frus:frus1918Russiav01/pg155"/>

                <note rend="inline" type="source">File No. 763.72/5078d</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Chargé in Japan</hi> (<hi
                            rendition="#italic">Wheeler</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-05-28T18:00:00-05:00">
                            <hi rendition="#italic">May 28, 1917, 6 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Russian commission to United States reported intending to sail Yokohama for
                    Seattle June 1. Please advise of departure, personnel of commission and port of
                    destination.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
