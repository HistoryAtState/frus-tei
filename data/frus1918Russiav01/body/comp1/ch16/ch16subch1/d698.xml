    <text>
        <body>
            <div xml:id="d698">

                <pb facs="0803" n="729" sameAs="frus:frus1918Russiav01/pg729"/>

                <note rend="inline" type="source">File No. 861.00/3284</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Minister in Sweden</hi> (<hi
                            rendition="#italic">Morris</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-12-02T14:00:00-05:00">
                            <hi rendition="#italic">December 2, 1918, 2 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>1331. Your 3233, November 27, 5 p.m. Repeat to Embassy at London and to Paris for
                    Colonel House. Follow same procedure all
                    similar reports to Department regarding Bolshevik activities. Please
                    acknowledge.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
