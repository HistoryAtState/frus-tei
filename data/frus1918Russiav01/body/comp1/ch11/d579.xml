    <text>
        <body>
            <div xml:id="d579">

                <pb facs="0661" n="587" sameAs="frus:frus1918Russiav01/pg587"/>

                <note rend="inline" type="source">File No. 861.00/2817</note>
                <head>
                    <hi rendition="#italic">The Consul at Moscow</hi> (<hi rendition="#italic">Poole</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 9</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Moscow</hi></placeName>, <date
                            calendar="gregorian" when="1918-08-20">
                            <hi rendition="#italic">August 20, 1918</hi></date>. <lb/> [<hi
                            rendition="#italic">Received September 26.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith four
                    copies of a translation of the constitution of the Russian Socialistic Federated
                    Republic of Soviets, as it appeared in the official Bolshevik journal, the <hi
                        rendition="#italic">Izvestia</hi>, of July 19, 1918.<anchor n="1"
                        xml:id="d579-f1"/>
                </p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">DeW. C. Poole</hi>, Jr.
                    </signed>
                </closer>


                <xi:include href="d579-a1.xml" xpointer="d579-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d579-f1" n="1" xml:id="d579-f1-content">
                <p>The constitution was adopted July 10, 1918; a later constitution of the Union of
                    Soviet Socialist Republics was adopted July 6, 1923.</p>
            </note>
        </listAnnotation>
    </standOff>
