    <text>
        <body>
            <div xml:id="d638">

                <pb facs="0767" n="693" xml:id="pg693"/>

                <note rend="inline" type="source">File No. 861.00/2763a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Consul at Vladivostok</hi>
                        (<hi rendition="#italic">Caldwell</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-09-24T19:00:00-04:00">
                            <hi rendition="#italic">September 24, 1918, 7 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your 158, September 21, 3 p.m. You will please not concur in British proposal and
                    will await Department’s circular telegram on the general subject being repeated
                    to you from Tokyo.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
