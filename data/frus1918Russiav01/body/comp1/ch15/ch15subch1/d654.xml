    <text>
        <body>
            <div xml:id="d654">

                <pb facs="0774" n="700" sameAs="frus:frus1918Russiav01/pg700"/>

                <note rend="inline" type="source">File No 861.00/2879</note>
                <head>
                    <hi rendition="#italic">The Minister in Persia</hi> (<hi rendition="#italic">Caldwell</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Teheran</hi></placeName>, <date
                            calendar="gregorian" when="1918-10-02T16:00:00+03:25">
                            <hi rendition="#italic">October 2, 1918, 4 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received October 3, 3.23
                        p.m.</hi>]</dateline>
                </opener>
                <p>17. Department’s circular of September 20, 6 p.m. Minister for Foreign Affairs
                    states he will send appropriate instructions to Persian Chargé d’Affaires in
                    Moscow.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Caldwell</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
