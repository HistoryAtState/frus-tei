    <text>
        <body>
            <div xml:id="d641">

                <pb facs="0768" n="694" xml:id="pg694"/>

                <note rend="inline" type="source">File No. 861.00/2815a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in
                        Switzerland</hi> (<hi rendition="#italic">Stovall</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-09-25T12:00:00-04:00">
                            <hi rendition="#italic">September 25, 1918, noon</hi></date>.</dateline>
                </opener>
                <p>Please deliver copy Department’s circular 20th regarding Russian massacres to
                    Bulgarian Minister for transmission to Murphy,<anchor n="1" xml:id="d641-f1"/>
                    instructing latter to present matter to Bulgarian Government.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d641-f1" n="1" xml:id="d641-f1-content">
                <p> Dominic I. Murphy, Consul General at Sofia.</p>
            </note>
        </listAnnotation>
    </standOff>
