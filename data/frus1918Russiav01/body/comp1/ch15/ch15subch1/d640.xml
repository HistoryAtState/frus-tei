    <text>
        <body>
            <div xml:id="d640">

                <pb facs="0767" n="693" sameAs="frus:frus1918Russiav01/pg693"/>

                <note rend="inline" type="source">File No. 861.00/2800</note>
                <head>
                    <hi rendition="#italic">The Chargé in Siam</hi> (<hi rendition="#italic"
                        >White</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Bangkok</hi></placeName>, <date
                            calendar="gregorian" when="1918-09-25T11:00:00+06:42">
                            <hi rendition="#italic">September 25, 1918, 11 a.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received September 26, 11.14
                        p.m.</hi>]</dateline>
                </opener>
                <p>Replying circular telegram September 20, 6 p.m. Siamese Government, sharing the
                    United States Government’s friendliness towards Russia, is in principle disposed
                    to join United States and Allied powers in the name of humanity in a protest
                    against wanton destruction life and liberty in Russia.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">White</hi>
                    </signed>
                </closer>
            </div>
        </body>
