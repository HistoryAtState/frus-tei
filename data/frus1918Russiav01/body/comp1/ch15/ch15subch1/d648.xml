        <body>
            <div xml:id="d648">

                <pb facs="0771" n="697" sameAs="frus:frus1918Russiav01/pg697"/>

                <note rend="inline" type="source">File No. 861.00/3034</note>
                <head>
                    <hi rendition="#italic">The Minister in Switzerland</hi> (<hi rendition="#italic"
                        >Stovall</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 4667</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berne</hi></placeName>, <date
                            calendar="gregorian" when="1918-09-30">
                            <hi rendition="#italic">September 30, 1918</hi></date>. <lb/> [<hi
                            rendition="#italic">Received October 23.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Confirming my telegram No. 4926 of
                    September 27, noon,<anchor n="2" xml:id="d648-f1"/> I have the honor to transmit
                    herewith copy and translation of the <hi rendition="#italic">aide-mémoire</hi>,
                    and enclosure thereto, of the Swiss Government dated September 24 concerning the
                    protestation against acts committed by the Soviets in Petrograd.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Pleasant A. Stovall</hi>
                        
                    </signed>
                </closer>



                <xi:include href="d648-a1.xml" xpointer="d648-a1"/>
                <xi:include href="d648-a2.xml" xpointer="d648-a2"/>
