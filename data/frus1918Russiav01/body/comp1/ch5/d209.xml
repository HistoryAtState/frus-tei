    <text>
        <body>
            <div xml:id="d209">

                <pb facs="0304" n="230" sameAs="frus:frus1918Russiav01/pg230"/>

                <note rend="inline" type="source">File No. 861.00/650</note>
                <head>
                    <hi rendition="#italic">The Minister in the Netherlands</hi> (<hi rendition="#italic"
                        >Garrett</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">The Hague</hi></placeName>, <date
                            calendar="gregorian" when="1917-11-12T19:00:00+00:19">
                            <hi rendition="#italic">November 12, 1917, 7 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 8.30 p.m.</hi>]</dateline>
                </opener>
                <p>1619. Russian Chargé d’Affaires says that all Russian diplomatic missions in
                    western Europe, with one exception not heard from, have communicated with each
                    other and agreed not to recognize Lenin
                    government nor to carry out any instructions that may be received from it.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Garrett</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
