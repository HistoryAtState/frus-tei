    <text>
        <body>
            <div xml:id="d385">

                <pb facs="0460" n="386" sameAs="frus:frus1918Russiav01/pg386"/>

                <note rend="inline" type="source">File No. 861.00/1144</note>
                <head>
                    <hi rendition="#italic">The Consul General at Moscow</hi> (<hi rendition="#italic"
                    >Summers</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Moscow</hi></placeName>, <date
                            calendar="gregorian" when="1918-02-23T12:00:00+02:31">
                            <hi rendition="#italic">February 23, 1918, noon</hi></date>. <lb/> [<hi
                            rendition="#italic">Received February 24, 11.55 a.m.</hi>]</dateline>
                </opener>
                <p>201. German advance Moscow, Petrograd continues and communication with staff may
                    be cut at any moment. Most Americans leaving to-day for Samara. Consulate
                    General will go to the same place in case of necessity.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Summers</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
