                <pb facs="0476" n="402" sameAs="frus:frus1918Russiav01/pg402"/>

                <note rend="inline" type="source">File No. 861.00/1302</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Russia</hi> (<hi
                            rendition="#italic">Francis</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-03-19T15:00:00-05:00">
                            <hi rendition="#italic">March 19, 1918, 3 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>13. Your 7, March 12, 5 p.m. Department considers President’s message to Russian
                    people and address to Congress adequate answer.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
