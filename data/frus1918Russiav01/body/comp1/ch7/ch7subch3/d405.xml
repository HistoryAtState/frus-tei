    <text>
        <body>
            <div xml:id="d405">

                <pb facs="0475" n="401" xml:id="pg401"/>

                <note rend="inline" type="source">File No. 861.00/1294</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Russia</hi> (<hi
                            rendition="#italic">Francis</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram—Extract]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-03-15T19:00:00-05:00">
                            <hi rendition="#italic">March 15, 1918, 7 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>10. … Approve your staying at Vologda until further instructions unless
                    circumstances require you to move without consulting Department. Important that
                    all American representatives in Russia should keep in closest touch
                    possible.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
