    <text>
        <body>
            <div xml:id="d373">

                <pb facs="0453" n="379" sameAs="frus:frus1918Russiav01/pg379"/>

                <note rend="inline" type="source">File No. 861.00/1049</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in France</hi>
                        (<hi rendition="#italic">Sharp</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-02-11T16:00:00-05:00">
                            <hi rendition="#italic">February 11, 1918, 4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>3165. Please repeat your 3138, February 3, 10 p.m.,<anchor n="1" xml:id="d373-f1"
                    /> to London with Department’s instructions to bring views reported therein to
                    attention of British Foreign Office.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
