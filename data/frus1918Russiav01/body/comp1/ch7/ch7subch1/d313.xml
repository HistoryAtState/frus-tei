    <text>
        <body>
            <div xml:id="d313">

                <pb facs="0393" n="319" sameAs="frus:frus1918Russiav01/pg319"/>

                <note rend="inline" type="source">File No. 861.00/823</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Russia</hi> (<hi
                            rendition="#italic">Francis</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-12-20T13:00:00-05:00">
                            <hi rendition="#italic">December 20, 1917, 1 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>1917. Your 2091, December 12, 8 p.m., last sentence.<anchor n="1"
                        xml:id="d313-f1"/> Red Cross members in uniform certainly included in
                    instructions Department’s 1883, December 6.<anchor n="2" xml:id="d313-f2"/> Red
                    Cross is so advising Robins.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
