    <text>
        <body>
            <div xml:id="d260">

                <pb facs="0348" n="274" sameAs="frus:frus1918Russiav01/pg274"/>

                <note rend="inline" type="source">File No. 861.00/703</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Russia</hi>
                        (<hi rendition="#italic">Francis</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-11-30T19:00:00-05:00">
                            <hi rendition="#italic">November 30, 1917, 7 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>1874. Referring your 2001, November 20, 10 p.m.<anchor n="2" xml:id="d260-f1"/>
                    Department believes conference impracticable such as you indicate first
                    paragraph and does not desire you to participate therein.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
