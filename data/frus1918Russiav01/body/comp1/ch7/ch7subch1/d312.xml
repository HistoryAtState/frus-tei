                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Russia</hi> (<hi
                            rendition="#italic">Francis</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-12-18T16:00:00-05:00">
                            <hi rendition="#italic">December 18, 1917, 4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>1910. Your 2092, December 12, 9 p.m., last paragraph.<anchor n="1"
                        xml:id="d312-f1"/> Department prefers no action at present.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
