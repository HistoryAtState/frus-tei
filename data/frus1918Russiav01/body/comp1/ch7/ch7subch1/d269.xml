    <text>
        <body>
            <div xml:id="d269">

                <pb facs="0355" n="281" xml:id="pg281"/>

                <note rend="inline" type="source">File No. 861.00/757</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Russia</hi> (<hi rendition="#italic"
                        >Francis</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Petrograd</hi></placeName>, <date
                            calendar="gregorian" when="1917-12-02T18:00:00+03:31">
                            <hi rendition="#italic">December 2, 1917, 6 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received December 5, 11.10
                        a.m.</hi>]</dateline>
                </opener>
                <p>2053. Your 1873, November 30, 6 p.m., received to-day. Have done nothing, not
                    even mentioned to colleagues action suggested in last sentence of my No. 2027,
                    November 25, 8 p.m.<anchor n="1" xml:id="d269-f1"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Francis</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
