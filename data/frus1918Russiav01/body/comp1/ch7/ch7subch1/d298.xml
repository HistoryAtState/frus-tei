    <text>
        <body>
            <div xml:id="d298">

                <pb facs="0374" n="300" xml:id="pg300"/>

                <note rend="inline" type="source">File No. 861.00/793</note>
                <head>
                    <hi rendition="#italic">The Minister in Sweden</hi> (<hi rendition="#italic"
                        >Morris</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Stockholm</hi></placeName>, <date
                            calendar="gregorian" when="1917-12-12T16:00:00+01:00">
                            <hi rendition="#italic">December 12, 1917, 4 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 8.45 p.m.</hi>]</dateline>
                </opener>
                <p>1166. Russian Minister, Copenhagen, informs me that Danish Minister for Foreign
                    Affairs told him that Danish Government would take no action with reference to
                    recognition of Bolshevik government for the present and would await
                    developments.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Morris</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
