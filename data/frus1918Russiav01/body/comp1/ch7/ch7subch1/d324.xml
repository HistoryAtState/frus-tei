    <text>
        <body>
            <div xml:id="d324">

                <pb facs="0403" n="329" sameAs="frus:frus1918Russiav01/pg329"/>

                <note rend="inline" type="source">File No. 861.00/808</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Russia</hi> (<hi
                            rendition="#italic">Francis</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-12-27T19:00:00-05:00">
                            <hi rendition="#italic">December 27, 1917, 7 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>1938. Referring Department’s 1906, December 15, 6 p.m.,<anchor n="1"
                        xml:id="d324-f1"/> and your 2133<anchor n="2" xml:id="d324-f2"/> Department
                    thoroughly realizes chaotic conditions may arise, appreciates your purpose to
                    remain and hopes you may judge it practicable to do so.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
