    <text>
        <body>
            <div xml:id="d309">

                <pb facs="0391" n="317" xml:id="pg317"/>

                <note rend="inline" type="source">File No. 861.01/9a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Diplomatic Representatives
                        in European Countries, Japan, China, and Siam </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Circular telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-12-15T20:00:00-05:00">
                            <hi rendition="#italic">December 15, 1917, 8 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Pending further instructions you should have no official relations with Russian
                    diplomatic officers who recognize or who are appointed by Bolshevik
                    government.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
