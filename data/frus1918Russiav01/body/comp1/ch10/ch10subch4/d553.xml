            <div xml:id="d553">

                <pb facs="0636" n="562" sameAs="frus:frus1918Russiav01/pg562"/>

                <note rend="inline" type="source">File No. 701.6111/221</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Russia</hi>
                        (<hi rendition="#italic">Francis</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-06-13T17:00:00-04:00">
                            <hi rendition="#italic">June 13, 1918, 5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>181. Your 1 and 2, June 5, Petrograd.<anchor n="2" xml:id="d553-f1"/> Make no
                    answer for the present or without consulting Department.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
