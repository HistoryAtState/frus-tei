    <text>
        <body>
            <div xml:id="d561">

                <pb facs="0641" n="567" sameAs="frus:frus1918Russiav01/pg567"/>

                <note rend="inline" type="source">File No. 861.00/2143a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Great Britain</hi> (<hi
                            rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-06-27">
                            <hi rendition="#italic">June 27, 1918</hi></date>.</dateline>
                </opener>
                <p>8459. This Government believes it is inadvisable for Kerensky to come to America at the present time. Lord Reading is aware of this fact and has so
                    advised the Foreign Office.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
