    <text>
        <body>
            <div xml:id="d549">

                <pb facs="0633" n="559" sameAs="frus:frus1918Russiav01/pg559"/>

                <note rend="inline" type="source">File No. 861.00/1988</note>
                <head>
                    <hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic"
                        >Sharp</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1918-06-10T18:00:00+01:00">
                            <hi rendition="#italic">June 10, 1918, 6 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 9.35 p.m.</hi>]</dateline>
                </opener>
                <p>4151. My 3569, April 10, 6 p.m., and Department’s 3673, April 23, 5 p.m.<anchor
                        n="1" xml:id="d549-f1"/> Russian Ambassador here is informed by French
                    postal <pb facs="0634" n="560" xml:id="pg560"/> authorities that his cipher
                    telegram sent June 6 addressed Ambarusse, Washington, has been stopped by
                    American censor. Please investigate and inform me what answer I am to make
                    him.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Sharp</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d549-f1" n="1" xml:id="d549-f1-content">
                <p>Not printed; both referred to interference with Russian Ambassador’s cables.</p>
            </note>
        </listAnnotation>
    </standOff>
