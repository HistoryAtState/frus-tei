    <text>
        <body>
            <div xml:id="d507">

                <pb facs="0599" n="525" sameAs="frus:frus1918Russiav01/pg525"/>

                <note rend="inline" type="source">File No. 811.142/3335f</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Russia</hi> (<hi
                            rendition="#italic">Francis</hi>)<anchor n="1"
                        xml:id="d507-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-05-09T17:00:00-04:00">
                            <hi rendition="#italic">May 9, 1918, 5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>115. For Robins: <quote rend="blockquote">
                        <p>Reconsidered our 10095.<anchor n="2" xml:id="d507-f2"/> Now considered
                            desirable that you remain in Russia for three weeks longer awaiting
                            further advices. Davison.</p>
                    </quote>
                </p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d507-f1" n="1" type="source" xml:id="d507-f1-content">
                <p>Also to the Consul at Moscow, No. 29, May 9.</p>
            </note>
            <note corresp="#d507-f2" n="2" xml:id="d507-f2-content">
                <p>Department’s No. 22, May 7, to the Consul at Moscow, <hi rendition="#italic"
                        >ante</hi>, <ref target="#pg523">p. 523</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
