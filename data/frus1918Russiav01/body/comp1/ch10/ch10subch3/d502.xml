            <div xml:id="d502">

                <pb facs="0596" n="522" xml:id="pg522"/>

                <note rend="inline" type="source">File No. 861.00/1970</note>
                <head>
                    <hi rendition="#italic">The Military Attaché in Russia</hi> (<hi rendition="#italic"
                        >Ruggles</hi>) <hi rendition="#italic">to the War Department
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Vologda</hi></placeName>, <date
                            calendar="gregorian" when="1918-05-03">
                            <hi rendition="#italic">May 3, 1918</hi></date>. <lb/> [<hi
                            rendition="#italic">Copy received from War Department May
                        23.</hi>]</dateline>
                </opener>
                <p>23. The Russian Government has forbidden the sending of coded telegrams without
                    the approval of the Commissary Foreign Affairs each case.</p>
                <p>This applies to all the Allies.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Ruggles</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
