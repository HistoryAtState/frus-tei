                <pb facs="0623" n="549" sameAs="frus:frus1918Russiav01/pg549"/>

                <note rend="inline" type="source">File No. 861.00/1899</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Russia</hi> (<hi
                            rendition="#italic">Francis</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-06-01T16:00:00-04:00">
                            <hi rendition="#italic">June 1, 1918, 4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>152. Your 210, May 27, 6 a.m.<anchor n="1" xml:id="d536-f1"/> Red Cross has
                    ordered Robins to-day to continue
                    journey home.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
