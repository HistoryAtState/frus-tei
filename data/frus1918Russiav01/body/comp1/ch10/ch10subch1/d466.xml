                <pb facs="0566" n="492" sameAs="frus:frus1918Russiav01/pg492"/>

                <note rend="inline" type="source">File No. 360d.1121 R 25/18</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Russia</hi>
                        (<hi rendition="#italic">Francis</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-04-02T18:00:00-04:00">
                            <hi rendition="#italic">April 2, 1918, 6 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>41. Your unnumbered March 29, 9 p.m. Ask Summers source of statement Moscow
                    press. Not authorized by Department.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
