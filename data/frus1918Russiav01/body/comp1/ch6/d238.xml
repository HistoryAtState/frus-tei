    <text>
        <body>
            <div xml:id="d238">

                <pb facs="0328" n="254" xml:id="pg254"/>

                <note rend="inline" type="source">File No. 763.72119/967</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Russia</hi>
                        (<hi rendition="#italic">Francis</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-12-01T15:00:00-05:00">
                            <hi rendition="#italic">December 1, 1917, 3 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>1875. Your 2034, November 27; 2039, November 28; and 2040, November 29. You are
                    to make no reply to communications mentioned in these telegrams and are informed
                    that this Government awaits further developments. The President has made no
                    statement.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
