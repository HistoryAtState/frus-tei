    <text>
        <body>
            <div xml:id="d53">

                <pb facs="0161" n="87" xml:id="pg87"/>

                <note rend="inline" type="source">File No. 763.72/5171d</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Russia</hi>
                        (<hi rendition="#italic">Francis</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-06-02T11:00:00-05:00">
                            <hi rendition="#italic">June 2, 1917, 11 a.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>1460. Most urgent. Department’s 1426, May 22, noon,<anchor n="1" xml:id="d53-f1"
                    /> and 1456, May 31, 6 p.m., concerning presidential communication. Immediate
                    answer imperative. Report date and hour of receipt of No. 1426.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
