    <text>
        <body>
            <div xml:id="d74">

                <pb facs="0180" n="106" sameAs="frus:frus1918Russiav01/pg106"/>

                <note rend="inline" type="source">File No. 763.72/5638</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Russia</hi> (<hi
                            rendition="#italic">Francis</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-07-03T17:00:00-05:00">
                            <hi rendition="#italic">July 3, 1917, 5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>1531. Your 1453, June 30. Impossible to supply information regarding munitions
                    furnished to Russia or time shipped because purchase made by Russian agents and
                    shipment arranged by them.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
