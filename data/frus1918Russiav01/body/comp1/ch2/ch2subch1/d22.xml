            <div xml:id="d22">

                <pb facs="0095" n="21" sameAs="frus:frus1918Russiav01/pg21"/>

                <note rend="inline" type="source">File No. 861.00/316</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Russia</hi> (<hi rendition="#italic"
                        >Francis</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Petrograd</hi></placeName>, <date
                            calendar="gregorian" when="1917-04-07">
                            <hi rendition="#italic">April 7, 1917</hi></date>. <lb/> [<hi
                            rendition="#italic">Received April 8, 12.30 p.m.</hi>]</dateline>
                </opener>
                <p>1163. Your 1292. Gompers’s cable delivered
                    to Cheidze, Milyukov and press. Think it excellent and will have good
                    effect.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Francis</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
