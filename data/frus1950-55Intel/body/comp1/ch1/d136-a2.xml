    <text>
        <body>
            <div xml:id="d136-a2">

                <pb facs="0395" n="366" xml:id="pg366"/>

                <head>Enclosure</head>
                <dateline><placeName>Washington</placeName>, <date
                        ana="#date_undated-inferred-from-document-content-and-sibling-dates"
                        calendar="gregorian" notAfter="1952-11-20T23:59:59-05:00"
                        notBefore="1952-11-04T00:00:00-05:00">undated</date>.</dateline>
                <p rendition="#flush">Memorandum From Secretary of Defense Lovett<anchor n="7"
                        xml:id="d136-f1"/></p>
                <list type="description">
                    <label>MEMORANDUM FOR THE</label>
                    <item>Secretary of the Army</item>
                    <item>Secretary of the Navy</item>
                    <item>Secretary of the Air Force</item>
                    <item>Joint Chiefs of Staff</item>
                    <item>Director, Communications-Electronics</item>
                    <item>Director, National Security Agency</item>
                </list>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>Interim Responsibility for Communication Security</item>
                </list>
                <p>Pending the issuance of additional instructions, the responsibilities for
                    Communication Security (COMSEC) activities and related matters assigned to the
                    Director, Armed Forces Security Agency, shall continue to be assigned to the
                    Director, National Security Agency.</p>
                <closer><signed>Lovett</signed><anchor n="8" xml:id="d136-f2"/></closer>
            </div>
        </body>
    </text>
