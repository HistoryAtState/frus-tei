    <text>
        <body>
            <div xml:id="d37-a1">

                <pb facs="0821" n="811" xml:id="pg811"/>

                <head>Appendix A to HD–78</head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps"
                            >commander-in-chief<lb/>of the<lb/>allied armies<lb/>general
                            staff<lb/>1st section</hi>
                        <lb/> 5080</seg>
                    <dateline rendition="#float-right"><placeName>G. H. Q.</placeName>, <date
                            calendar="gregorian" when="1919-10-23">October 23,
                        1919</date>.</dateline>
                </opener>
                <p rendition="#center">Translation</p>
                <p rendition="#flush">From: Marshal Foch.</p>
                <p rendition="#flush">To: President of the Council, President of the Peace
                    Conference. (Secretariat General)</p>
                <p>In compliance with the prescriptions of a resolution of the Supreme Council,
                    under date of October 20th,<anchor n="6" xml:id="d37-f1"/> I have the honor to
                    enclose herewith the list of the Armistice clauses<anchor n="*" xml:id="d37-f2"
                    /> which have not yet been executed by Germany.</p>
                <closer><signed><hi rendition="#small-caps"
                    >Weygand</hi></signed><lb/>Major-General</closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d37-f1" n="6" xml:id="d37-f1-content">
                <p>HD–73, minute 8, <ref target="#pg714">p. 714</ref>.</p>
            </note>
            <note corresp="#d37-f2" n="*" xml:id="d37-f2-content">
                <p>Initial convention of November 11, 1919 [<hi rendition="#italic">1918</hi>],
                    renewal of conventions and protocols. [Footnote in the original.]</p>
            </note>
