    <text>
        <body>
            <div xml:id="d5-a6">

                <pb facs="0103" n="93" sameAs="frus:frus1919Parisv08/pg93"/>

                <head>Appendix D to HD–46</head>
                <opener><seg rendition="#center">[Translation<anchor n="9" xml:id="d5-f1"
                    />]</seg></opener>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">peace
                            conference<lb/>secretariat general</hi></seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1919-08-27">August 27, 1919</date>.</dateline>
                </opener>
                <p rendition="#center">[<hi rendition="#italic">Note From the Drafting
                        Committee</hi>]</p>
                <p rendition="#flush">Treaty with Bulgaria (Article 25, Economic clauses)</p>
                <p>In response to the request made to it by the Supreme Council, on August 23 last,
                    the Drafting Committee has the honor to transmit the appended note.</p>
                <closer>For the Drafting Committee<lb/><signed><hi rendition="#small-caps">Henri
                            Fromageot</hi></signed></closer>
            </div>
        </body>
    </text>
