    <text>
        <body>
            <div xml:id="d17-a8">

                <pb facs="0329" n="319" sameAs="frus:frus1919Parisv08/pg319"/>

                <opener> A. P. O. S. 31 <lb/> B. Troops cantonned in France <lb/>
                    <dateline>
                        <date calendar="gregorian" when="1919-08-30"><hi rendition="#small-caps"
                                >August</hi> 30, 1919</date>.</dateline>
                </opener>
                <pb facs="0330" n="320" xml:id="pg320"/>
                <p rendition="#flush">To General Nollet, Chief of the Interallied Military
                    Commission of Control.</p>
                <p>Sent with reference to the minutes of the commission appointed to fix the
                    commutation to be allotted to the officers, non-commissioned officers and
                    privates going into Germany with the Interallied Commissions of Control.</p>
                <closer><signed><hi rendition="#small-caps">T. R. Ubsdell</hi></signed><lb/><hi
                        rendition="#italic">Lt. Colonel</hi></closer>
            </div>
        </body>
    </text>
