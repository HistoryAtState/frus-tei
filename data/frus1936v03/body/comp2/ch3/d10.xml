    <text>
        <body>
            <div xml:id="d10">

                <pb facs="0077" n="12" sameAs="frus:frus1936v03/pg12"/>

                <note rend="inline" type="source">883.0513/137: Telegram (part air)</note>
                <head><hi rendition="#italic">The Minister in Egypt</hi> (<hi rendition="#italic"
                        >Fish</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Cairo</hi></placeName>, <date calendar="gregorian"
                            when="1936-06-17T18:00:00+02:00">June 17, 1936—6
                        p.m.</date><lb/>[Received June 22—6:15 a.m.]</dateline>
                </opener>
                <p>33. My despatch No. 661 of May 28th.<anchor n="8" xml:id="d10-f1"/> Judge
                    Crabitès submitted his resignation today as a member of the Mixed Court to the
                    Egyptian authorities. Resignation effective November 1st, next.</p>
                <closer><signed><hi rendition="#small-caps">Fish</hi></signed></closer>
            </div>
        </body>
    </text>
