            <div xml:id="d509">

                <pb facs="0491" n="426" sameAs="frus:frus1936v03/pg426"/>

                <note rend="inline" type="source">452.11/329: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Diplomatic Agent and
                        Consul General at Tangier</hi> (<hi rendition="#italic">Blake</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1936-01-30T17:00:00-05:00">January 30, 1936—5
                        p.m.</date></dateline>
                </opener>
                <p>1. If you have not already sent in a report, may we have your comments and
                    suggestions by mail with regard to the Madrid Embassy’s despatch 1012, January
                    13?</p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
    </text>
