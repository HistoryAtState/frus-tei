                <note rend="inline" type="source">124.84/65: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in the United Kingdom</hi> (<hi rendition="#italic">Bingham</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1936-05-05">May 5, 1936</date>.<lb/>[Received May 5—5:35
                        a.m.]</dateline>
                </opener>
                <p>United States Legation safely evacuated.</p>
                <closer><signed><hi rendition="#small-caps">Bingham</hi></signed></closer>
            </div>
        </body>
