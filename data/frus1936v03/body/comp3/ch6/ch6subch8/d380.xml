                <pb facs="0379" n="314" sameAs="frus:frus1936v03/pg314"/>

                <note rend="inline" type="source">665D.006/A: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Minister Resident in
                        Ethiopia</hi> (<hi rendition="#italic">Engert</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1936-09-26T13:00:00-04:00">September 26, 1936—1
                        p.m.</date></dateline>
                </opener>
                <p>360. Please submit a comprehensive report on Italian trade regulations in
                    Ethiopia, including data on foreign exchange restriction, etc., and complete
                    information as to the effect of such measures upon American trade.</p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
    </text>
