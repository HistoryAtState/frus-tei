    <text>
        <body>
            <div xml:id="d400">

                <pb facs="0395" n="330" xml:id="pg330"/>

                <note rend="inline" type="source">365D.1163/25: Telegram</note>
                <head><hi rendition="#italic">The Minister Resident in Ethiopia</hi> (<hi rendition="#italic">Engert</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">Addis
                                Ababa</hi></placeName>, <date calendar="gregorian"
                            when="1936-12-28T13:00:00+03:00">December 28, 1936—1
                        p.m.</date><lb/>[Received 9:40 p.m.]</dateline>
                </opener>
                <p>700. Department’s 406, December 22, 6 p.m.<anchor n="80" xml:id="d400-f1"/> I am
                    making inquiries of authorities regarding the properties<anchor n="81"
                        xml:id="d400-f2"/> at Sayo and also at Gore.</p>
                <p>I understand that property of Seventh Day Adventists at Debra Tabor and Ghimbi
                    and property of Sudan Interior Mission at Debra Markos have been occupied by the
                    Italian military. No American citizens any of these places.</p>
                <closer><signed><hi rendition="#small-caps">Engert</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d400-f1" n="80" xml:id="d400-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d400-f2" n="81" xml:id="d400-f2-content">
                <p>Properties of the American (United Presbyterian) Mission.</p>
            </note>
