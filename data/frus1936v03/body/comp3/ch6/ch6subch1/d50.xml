                <pb facs="0114" n="49" sameAs="frus:frus1936v03/pg49"/>

                <note rend="inline" type="source">765.84/3964: Telegram</note>
                <head><hi rendition="#italic">The Minister Resident in Ethiopia</hi> (<hi
                        rendition="#italic">Engert</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">Addis
                                Ababa</hi></placeName>, <date calendar="gregorian"
                            when="1936-03-20T11:00:00+02:35">March 20, 1936—11
                        a.m.</date><lb/>[Received 7 p.m.]</dateline>
                </opener>
                <p>169. Government announces that on March 18 Korem was subjected to intensive
                    bombing with a new kind of gas which causes much suffering.</p>
                <closer><signed><hi rendition="#small-caps">Engert</hi></signed></closer>
            </div>
        </body>
