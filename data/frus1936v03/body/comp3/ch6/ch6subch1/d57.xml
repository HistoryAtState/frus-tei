    <text>
        <body>
            <div xml:id="d57">

                <pb facs="0117" n="52" sameAs="frus:frus1936v03/pg52"/>

                <note rend="inline" type="source">765.84116/97: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Italy</hi> (<hi rendition="#italic"
                        >Long</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Rome</hi></placeName>, <date calendar="gregorian"
                            when="1936-04-08T18:00:00+01:00">April 8, 1936—6
                        p.m.</date><lb/>[Received April 8—1:25 p.m.]</dateline>
                </opener>
                <p>98. Virginio Gayda<anchor n="25" xml:id="d57-f1"/> in today’s <hi
                        rendition="#italic">Giornale</hi> denies categorically the use of poison gas
                    by the Italians in Abyssinia.</p>
                <closer><signed><hi rendition="#small-caps">Long</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d57-f1" n="25" xml:id="d57-f1-content">
                <p>Italian Foreign Office spokesman.</p>
