                                    Schleswig–Holstein</hi>
                            </item>
                            <item>
                                <hi rendition="#small-caps">Dr. Reinhold
                                        Maier
                                </hi>
                                <lb/>
                                <hi rendition="#italic">Minister President of
                                    Wuerttemberg–Baden</hi>
                            </item>
                            <item>
                                <hi rendition="#small-caps">Dr. Gebhard
                                        Mueller
                                </hi>
                                <lb/>
                                <hi rendition="#italic">State President of
                                    Wuerttemberg–Hohenzollern</hi>
                            </item>
                        </list>
                    </signed>
                </closer>


