            <div xml:id="d791">

                <pb facs="0863" n="759" sameAs="frus:frus1932v05/pg759"/>

                <note rend="inline" type="source">812.001C13/125: Telegram</note>
                <head>
                    <hi rendition="#italic">The Consul at Nuevo Laredo</hi> (<hi rendition="#italic"
                        >Wormuth</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Nuevo Laredo</hi></placeName>, <date
                            calendar="gregorian" when="1932-06-17T20:00:00-06:00">June 17, 1932—8
                            p.m.</date>
                        <lb/> [Received 10:45 p.m.]</dateline>
                </opener>
                <p>Your telegram reference General Calles. Entire party passed border without
                    difficulty. Report follows.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wormuth</hi>
                    </signed>
                </closer>
            </div>
        </body>
