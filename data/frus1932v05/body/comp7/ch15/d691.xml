        <body>
            <div xml:id="d691">

                <pb facs="0720" n="616" xml:id="pg616"/>

                <note rend="inline" type="source">816.00 Revolutions/58: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in El Salvador</hi> (<hi rendition="#italic"
                        >McCafferty</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">San Salvador</hi></placeName>, <date
                            calendar="gregorian" when="1932-01-23T15:00:00-06:00">January 23, 1932—3
                            p.m.</date>
                        <lb/> [Received January 23—2:55 p.m.]</dateline>
                </opener>
                <p>16. Two British destroyers arrived today at Acajutla.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">McCafferty</hi>
                        
                    </signed>
                </closer>
            </div>
