            <div xml:id="d683">

                <pb facs="0716" n="612" sameAs="frus:frus1932v05/pg612"/>

                <note rend="inline" type="source">816.01/272: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in El Salvador</hi> (<hi rendition="#italic"
                        >McCafferty</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">San Salvador</hi></placeName>, <date
                            calendar="gregorian" when="1932-12-06T14:00:00-06:00">December 6, 1932—2
                            p.m.</date>
                        <lb/> [Received 8:35 p.m.]</dateline>
                </opener>
                <p>107. German Government has recognized Martínez regime.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">McCafferty</hi>
                    </signed>
                </closer>
            </div>
        </body>
