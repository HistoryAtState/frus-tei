                <note rend="inline" type="source">816.01/244: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Brazil</hi> (<hi
                            rendition="#italic">Morgan</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1932-10-01T14:00:00-05:00">October 1, 1932—2
                            p.m.</date>
                    </dateline>
                </opener>
                <p>86. Your 117, September 28, 3 p.m. Please express appreciation to the
                    Minister.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Stimson</hi>
                        
                    </signed>
                </closer>
            </div>
