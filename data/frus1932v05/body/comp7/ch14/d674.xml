    <text>
        <body>
            <div xml:id="d674">

                <pb facs="0712" n="608" sameAs="frus:frus1932v05/pg608"/>

                <note rend="inline" type="source">816.01/237: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Brazil</hi> (<hi rendition="#italic"
                        >Morgan</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Rio de Janeiro</hi></placeName>, <date
                            calendar="gregorian" when="1932-09-20T11:00:00-03:00">September 20,
                            1932—11 a.m.</date>
                        <lb/> [Received September 20—10:35 a.m.]</dateline>
                </opener>
                <p>109. Foreign Minister states that Argentina wishes Brazil to recognize in
                    immediate future on same day and hour <hi rendition="#italic">de facto</hi>
                    government Salvador.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Morgan</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
