            <div xml:id="d681">

                <pb facs="0715" n="611" sameAs="frus:frus1932v05/pg611"/>

                <note rend="inline" type="source">816.01/267: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in El Salvador</hi> (<hi rendition="#italic"
                        >McCafferty</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">San Salvador</hi></placeName>, <date
                            calendar="gregorian" when="1932-11-25T17:00:00-06:00">November 25,
                            1932—5 p.m.</date>
                        <lb/> [Received 6:55 p.m.]</dateline>
                </opener>
                <p>105. The Italian Consul General in San Salvador today officially announced the
                    recognition of the Martínez regime by
                    Italy.</p>
                <p>Repeated to Guatemala.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">McCafferty</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
