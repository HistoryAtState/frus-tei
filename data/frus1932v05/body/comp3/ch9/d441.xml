                <note rend="inline" type="source">123M82/252: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Brazil</hi> (<hi rendition="#italic"
                    >Morgan</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Rio de Janeiro</hi></placeName>, <date
                            calendar="gregorian" when="1932-08-15T09:00:00-03:00">August 15, 1932—9
                            a.m.</date>
                        <lb/> [Received 10:45 a.m.]</dateline>
                </opener>
                <p>88. Assumed charge today.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Morgan</hi>
                        
                    </signed>
                </closer>
            </div>
