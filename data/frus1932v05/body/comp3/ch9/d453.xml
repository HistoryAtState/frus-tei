                <pb facs="0521" n="417" sameAs="frus:frus1932v05/pg417"/>

                <note rend="inline" type="source">832.00 Revolutions/385: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Brazil</hi> (<hi
                            rendition="#italic">Morgan</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1932-09-26T19:00:00-05:00">September 26,
                            1932—7 p.m.</date>
                    </dateline>
                </opener>
                <p>83. The Department fully approves the actions reported in your 110, September 21,
                    7 p.m., and 111, September 22, 10 a.m.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Stimson</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
