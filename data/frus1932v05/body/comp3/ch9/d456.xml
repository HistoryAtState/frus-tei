    <text>
        <body>
            <div xml:id="d456">

                <pb facs="0522" n="418" sameAs="frus:frus1932v05/pg418"/>

                <note rend="inline" type="source">832.00 Revolutions/387: Telegram</note>
                <head>
                    <hi rendition="#italic">The Consul General at São Paulo</hi> (<hi
                        rendition="#italic">Cameron</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">São Paulo</hi></placeName>, <date
                            calendar="gregorian" when="1932-09-27T16:00:00-03:00">September 27,
                            1932—4 p.m.</date>
                        <lb/> [Received, September 27—2:40 p.m.]</dateline>
                </opener>
                <p>With reference to my telegram September 27, noon, British warship is now anchored
                    at San Sebastian 75 miles from Santos.</p>
                <p>Repeated to Embassy at Rio de Janeiro.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Cameron</hi>
                    </signed>
                </closer>
            </div>
        </body>
