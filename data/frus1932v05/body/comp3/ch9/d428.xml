            <div xml:id="d428">

                <pb facs="0507" n="403" sameAs="frus:frus1932v05/pg403"/>

                <note rend="inline" type="source">123M82/245: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Great
                        Britain</hi> (<hi rendition="#italic">Mellon</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1932-07-19T14:00:00-04:00">July 19, 1932—2
                            p.m.</date>
                    </dateline>
                </opener>
                <p>197. For Ambassador Morgan. In view of most recent reports from Brazil please
                    return there as soon as possible.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stimson</hi>
                    </signed>
                </closer>
            </div>
        </body>
