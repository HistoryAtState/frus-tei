                <pb facs="0507" n="403" sameAs="frus:frus1932v05/pg403"/>

                <note rend="inline" type="source">123M82/247: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Brazil</hi> (<hi rendition="#italic"
                    >Morgan</hi>), <hi rendition="#italic">Temporarily at Paris, to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi>
                        </placeName> [<date
                            ana="#date_undated-inferred-from-document-content-and-sibling-dates"
                            calendar="gregorian" notAfter="1932-07-21T10:35:00+02:00"
                            notBefore="1932-07-19T20:00:00+02:00">undated</date>].<lb/>[Received
                        July 21, 1932—4:35 a.m.]</dateline>
                </opener>
                <p>Sailing Brazil first available steamer.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Morgan</hi>
                        
                    </signed>
                </closer>
            </div>
