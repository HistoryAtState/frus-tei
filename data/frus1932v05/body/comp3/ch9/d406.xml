    <text>
        <body>
            <div xml:id="d406">

                <pb facs="0494" n="390" sameAs="frus:frus1932v05/pg390"/>

                <note rend="inline" type="source">832.00 Revolutions/238: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in Brazil</hi> (<hi
                            rendition="#italic">Thurston</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Rio de Janeiro</hi></placeName>, <date
                            calendar="gregorian" when="1932-07-10T16:00:00-03:00">July 10, 1932—4
                            p.m.</date>
                        <lb/> [Received 5:49 p.m.]</dateline>
                </opener>
                <p>51. Consul General Cameron’s July 10, 11
                    a.m. Unconfirmed reports indicate movement involves in addition to São Paulo the
                    three southern States and Minas Geraes. Rio quiet.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Thurston</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
