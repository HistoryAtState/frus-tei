    <text>
        <body>
            <div xml:id="d414">

                <pb facs="0497" n="393" sameAs="frus:frus1932v05/pg393"/>

                <note rend="inline" type="source">123M82/242: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Mellon</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1932-07-13T12:00:00+01:00">July 13,
                            1932—noon</date>.<lb/>[Received July 13—6:46 a.m.]</dateline>
                </opener>
                <p>220. From Ambassador Morgan. Watching Brazilian situation closely. Prepared to
                    sail for Brazil July 19th if you desire. Please reply American Embassy,
                    London.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Mellon</hi>
                    </signed>
                </closer>
            </div>
        </body>
