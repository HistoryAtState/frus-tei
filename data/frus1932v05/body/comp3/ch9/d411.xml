    <text>
        <body>
            <div xml:id="d411">

                <pb facs="0496" n="392" sameAs="frus:frus1932v05/pg392"/>

                <note rend="inline" type="source">832.00 Revolutions/246: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Consul General at São Paulo</hi> (<hi
                            rendition="#italic">Cameron</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1932-07-12T18:00:00-04:00">July 12, 1932—6
                            p.m.</date>
                    </dateline>
                </opener>
                <p>Your telegram July 12, noon. Your telegrams July 10, 11 a.m. and July 11, noon,
                    have been received. Your reports are most helpful. Please continue to telegraph
                    all important facts.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Stimson</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
