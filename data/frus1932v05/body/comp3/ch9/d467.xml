    <text>
        <body>
            <div xml:id="d467">

                <pb facs="0528" n="424" sameAs="frus:frus1932v05/pg424"/>

                <note rend="inline" type="source">832.00 Revolutions/401: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Brazil</hi> (<hi rendition="#italic"
                        >Morgan</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Rio de Janeiro</hi></placeName>, <date
                            calendar="gregorian" when="1932-10-03T12:00:00-02:00">October 3,
                            1932—noon</date>.<lb/>[Received October 3—10 a.m.]</dateline>
                </opener>
                <p>118. Provisional Government states that armistice has been arranged. All São
                    Paulo military equipment will be surrendered.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Morgan</hi>
                    </signed>
                </closer>
            </div>
        </body>
