    <text>
        <body>
            <div xml:id="d728">

                <pb facs="0784" n="680" sameAs="frus:frus1932v05/pg680"/>

                <note rend="inline" type="source">838.51/2506: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in Haiti</hi> (<hi rendition="#italic"
                        >Heath</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Port-au-Prince</hi></placeName>, <date
                            calendar="gregorian" when="1932-09-15T14:00:00-05:00">September 15,
                            1932—2 p.m.</date>
                        <lb/> [Received 2:23 p.m.]</dateline>
                </opener>
                <p>107. Haitian legislative body today voted to reject the new treaty. It is
                    reported that there were no dissenting votes.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Heath</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
