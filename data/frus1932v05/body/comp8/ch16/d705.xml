                <note rend="inline" type="source">838.51 A/213: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in Haiti</hi>
                        (<hi rendition="#italic">Munro</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1931-10-23T18:00:00-05:00">October 23, 1931—6
                            p.m.</date>
                    </dateline>
                </opener>
                <p>79. Your 124, October 22, 10 a.m. The Department approves your proposed
                    reply.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stimson</hi>
                    </signed>
                </closer>
            </div>
