    <text>
        <body>
            <div xml:id="d726">

                <pb facs="0775" n="671" sameAs="frus:frus1932v05/pg671"/>

                <note rend="inline" type="source">838.51/2510</note>
                <head>
                    <hi rendition="#italic">The Minister in Haiti</hi> (<hi rendition="#italic">Munro</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 490</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Port-au-Prince</hi></placeName>, <date
                            calendar="gregorian" when="1932-09-14">September 14,
                        1932</date>.<lb/>[Received September 16.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to forward herewith the
                    original of the Treaty which was signed on September 3, 1932.</p>
                <p>Respectfully yours,</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Dana G. Munro</hi>
                        
                    </signed>
                </closer>


                <xi:include href="d726-a1.xml" xpointer="d726-a1"/>
