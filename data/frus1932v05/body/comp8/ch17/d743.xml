                <note rend="inline" type="source">838.105/410: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in Haiti</hi>
                        (<hi rendition="#italic">Munro</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1932-06-07T17:00:00-04:00">June 7, 1932—5
                            p.m.</date>
                    </dateline>
                </opener>
                <p>31. Your 61, June 6, noon. The Department approves proposed text and authorizes
                    you to sign.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stimson</hi>
                    </signed>
                </closer>
            </div>
        </body>
