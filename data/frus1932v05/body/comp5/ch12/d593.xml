    <text>
        <body>
            <div xml:id="d593">

                <pb facs="0636" n="532" sameAs="frus:frus1932v05/pg532"/>

                <note rend="inline" type="source">818.001J56/11: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in Costa Rica</hi> (<hi rendition="#italic">Eberhardt</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">San José</hi></placeName>, <date
                            calendar="gregorian" when="1932-05-08T16:00:00-06:00">May 8, 1932—4
                            p.m.</date>
                        <lb/> [Received 9:25 p.m.]</dateline>
                </opener>
                <p>38. Ricardo Jiménez inaugurated President
                    at noon today by the Congress before an orderly and enthusiastic populace.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Eberhardt</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
