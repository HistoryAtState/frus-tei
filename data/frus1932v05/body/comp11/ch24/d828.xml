    <text>
        <body>
            <div xml:id="d828">

                <pb facs="0910" n="806" xml:id="pg806"/>

                <note rend="inline" type="source">817.00 Woodward Electoral Mission/91</note>
                <head>
                    <hi rendition="#italic">The Minister in Nicaragua</hi> (<hi rendition="#italic"
                        >Hanna</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Managua</hi></placeName>, <date
                            calendar="gregorian" when="1932-06-21T11:00:00-05:45">June 21, 1932—11
                            a.m.</date>
                        <lb/> [Received 2:45 p.m.]</dateline>
                </opener>
                <p>97. Admiral Woodward arrived here yesterday accompanied by Mrs. Woodward.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hanna</hi>
                    </signed>
                </closer>
            </div>
        </body>
