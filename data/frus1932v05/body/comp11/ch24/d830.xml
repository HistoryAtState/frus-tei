    <text>
        <body>
            <div xml:id="d830">

                <pb facs="0911" n="807" xml:id="pg807"/>

                <note rend="inline" type="source">817.00 Woodward Electoral Mission/93: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in Nicaragua</hi> (<hi rendition="#italic">Hanna</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Managua</hi></placeName>, <date
                            calendar="gregorian" when="1932-06-23T12:00:00-05:45">June 23,
                            1932—noon</date>.<lb/>[Received 9:54 p.m.]</dateline>
                </opener>
                <p>98. Admiral Woodward took oath of office
                    as President of the National Board of Elections before the Supreme Court of
                    Justice at 11:30 this morning.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Hanna</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
