    <text>
        <body>
            <div xml:id="d798">

                <pb facs="0871" n="767" sameAs="frus:frus1932v05/pg767"/>

                <note rend="inline" type="source">817.011/91</note>
                <head>
                    <hi rendition="#italic">The Nicaraguan Chargé</hi> (<hi rendition="#italic"
                        >Debayle</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 89</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1932-02-03">February 3,
                        1932</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: In accordance with instructions I
                    have just received from His Excellency President Moncada, I have the honor to
                    present herewith a letter addressed to Your Excellency, which for your
                    convenience, I have accompanied by a translation into English.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Luis M. Debayle</hi>
                    </signed>
                </closer>


                <xi:include href="d798-a1.xml" xpointer="d798-a1"/>
            </div>
