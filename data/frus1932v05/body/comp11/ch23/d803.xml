    <text>
        <body>
            <div xml:id="d803">

                <pb facs="0879" n="775" sameAs="frus:frus1932v05/pg775"/>

                <note rend="inline" type="source">817.011/79</note>
                <head>
                    <hi rendition="#italic">The Chargé in Nicaragua</hi> (<hi rendition="#italic"
                        >Beaulac</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Managua</hi></placeName>, <date
                            calendar="gregorian" when="1932-03-21T12:00:00-05:45">March 21,
                            1932—noon</date>.<lb/>[Received 8:48 p.m.]</dateline>
                </opener>
                <p>51. My 45, March 17, 4 p.m.<anchor n="15" xml:id="d803-f1"/> Liberal Grand
                    Convention meeting in Leon, generally recognized as having better claim to
                    legitimacy, denounced mission of Doctor Morales to Washington. Other decisions
                    of Grand Convention will be telegraphed later.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Beaulac</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
