            <div xml:id="d937">

                <pb facs="1053" n="949" sameAs="frus:frus1932v05/pg949"/>

                <note rend="inline" type="source">823.00 Revolutions/336: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in Peru</hi> (<hi rendition="#italic"
                        >Burdett</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Lima</hi></placeName>, <date
                            calendar="gregorian" when="1932-07-13T16:00:00-05:00">July 13, 1932—4
                            p.m.</date>
                        <lb/> [Received 4:45 p.m.]</dateline>
                </opener>
                <p>107. Following telegram from Whyte: <quote rend="blockquote">
                        <p>“July 13, 11 a.m. All Americans Trujillo well”.</p>
                    </quote>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Burdett</hi>
                    </signed>
                </closer>
            </div>
        </body>
