    <text>
        <body>
            <div xml:id="d925">

                <pb facs="1048" n="944" sameAs="frus:frus1932v05/pg944"/>

                <note rend="inline" type="source">823.00 Revolutions/323: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in Peru</hi> (<hi rendition="#italic"
                        >Burdett</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Lima</hi></placeName>, <date
                            calendar="gregorian" when="1932-07-07T14:00:00-05:00">July 7, 1932—2
                            p.m.</date>
                        <lb/> [Received 3:45 p.m.]</dateline>
                </opener>
                <p>96. Radical uprising occurred Trujillo early today. Military activities in Lima
                    but no disorder.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Burdett</hi>
                    </signed>
                </closer>
            </div>
        </body>
