    <text>
        <body>
            <div xml:id="d939">

                <pb facs="1054" n="950" xml:id="pg950"/>

                <note rend="inline" type="source">823.00 Revolutions/345</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Peruvian Ambassador</hi>
                        (<hi rendition="#italic">Freyre</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1932-07-15">July 15, 1932</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: I have the honor to acknowledge the
                    receipt of Your Excellency’s courteous communications of July 9 and 12,
                        1932,<anchor n="6" xml:id="d939-f1"/> inquiring under instructions from your
                    Government regarding the possibility of the sale to it by the United States of
                    300 explosive bombs for bombing airplanes to be delivered at the Canal Zone. My
                    Government has given careful consideration to this request and regrets that the
                    War Department finds it impossible to deplete its reserve stock of bombs at the
                    present time.</p>
                <p>Accept [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Francis White</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
