    <text>
        <body>
            <div xml:id="d944-a3">

                <pb facs="1066" n="962" sameAs="frus:frus1932v05/pg962"/>

                <opener>
                    <seg rendition="#center">[Enclosure 3]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">The American Ambassador</hi> (<hi rendition="#italic"
                        >Dearing</hi>) <hi rendition="#italic">to the Peruvian Minister for Foreign
                        Affairs</hi> (<hi rendition="#italic">Zavala Loayza</hi>)</head>
                <opener>
                    <seg rendition="#float-left">No. 296</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Lima</hi></placeName>, <date
                            calendar="gregorian" when="1932-09-10">September 10,
                        1932</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: I have the honor to refer to Your
                    Excellency’s note Number 76 of August 29, 1932, concerning the right of the
                    Government of Peru to utilize in times of domestic disorders the services of
                    American citizens who are pilots of the Panagra Company, and have put before my
                    Government the consideration therein expressed.</p>
                <p>I shall be glad to communicate to your Excellency such reply as my Government may
                    instruct me to make.</p>
                <p>I avail myself [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Fred Morris Dearing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
