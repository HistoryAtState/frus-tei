            <div xml:id="d483">

                <pb facs="0542" n="438" sameAs="frus:frus1932v05/pg438"/>

                <note rend="inline" type="source">825.516/129: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Chile</hi> (<hi
                            rendition="#italic">Culbertson</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1932-06-10T13:00:00-04:00">June 10, 1932—1
                            p.m.</date>
                    </dateline>
                </opener>
                <p>28. Your 70, June 9, 4 p.m. Please cable estimate of total amount of credits and
                    deposits in gold and foreign currency held by American companies and nationals
                    in banks in Chile which would be affected by decree.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Stimson</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
