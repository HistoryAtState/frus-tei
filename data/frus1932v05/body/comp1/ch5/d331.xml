                <pb facs="0424" n="320" sameAs="frus:frus1932v05/pg320"/>

                <note rend="inline" type="source">733.35/20: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in Uruguay (Wright) to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Montevideo</hi></placeName>, <date
                            calendar="gregorian" when="1932-07-16T14:00:00-03:30">July 16, 1932—2
                            p.m.</date>
                        <lb/> [Received 1:45 p.m.]</dateline>
                </opener>
                <p>40. Your 13, July 15, 4 p.m. Minister for Foreign Affairs states Uruguayan
                    Government will be happy to accept good offices of the United States.</p>
                <p>Repeated to Buenos Aires.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Wright</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
