        <body>
            <div xml:id="d350">

                <pb facs="0436" n="332" sameAs="frus:frus1932v05/pg332"/>

                <note rend="inline" type="source">713.1311/117</note>
                <head>
                    <hi rendition="#italic">The Minister in Costa Rica (Eberhardt) to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1194</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">San José</hi></placeName>, <date
                            calendar="gregorian" when="1932-11-15">November 15,
                        1932</date>.<lb/>[Received November 21.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: For the information of the Department, I
                    have the honor to transmit herewith two self-explanatory memoranda which refer
                    to the subject of my telegram No. 70 of November 15, 2 p.m. (1932).</p>
                <p>Respectfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Charles C. Eberhardt</hi>
                    </signed>
                </closer>



