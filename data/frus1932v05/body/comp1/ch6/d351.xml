                <pb facs="0438" n="334" sameAs="frus:frus1932v05/pg334"/>

                <note rend="inline" type="source">713.1311/109: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Minister in Costa Rica (Eberhardt)</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1932-11-16T18:00:00-05:00">November 16,
                            1932—6 p.m.</date>
                    </dateline>
                </opener>
                <p>38. Your 70, November 15, 2 p.m. Please continue to keep Department fully
                    informed and in case Foreign Minister Pacheco proceeds to Guatemala keep the Legation there, as well
                    as the other Legations in Central America, appropriately informed.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Stimson</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
