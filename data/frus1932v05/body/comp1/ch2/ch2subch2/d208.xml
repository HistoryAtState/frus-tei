            <div xml:id="d208">

                <pb facs="0307" n="203" sameAs="frus:frus1932v05/pg203"/>

                <note rend="inline" type="source">724.3415/2280: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Brazil (Morgan) to the Secretary of
                            State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Rio de Janeiro</hi></placeName>, <date
                            calendar="gregorian" when="1932-09-14T15:00:00-03:00">September 14,
                            1932—3 p.m.</date>
                        <lb/> [Received 3:30 p.m.]</dateline>
                </opener>
                <p>106. Department’s circular September 12 [<hi rendition="#italic">13</hi>], 6 p.m.
                    Foreign Minister cordially approves Neutrals’ memorandum and will instruct
                    Brazilian Ambassador to agree to and work under its terms.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Morgan</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
