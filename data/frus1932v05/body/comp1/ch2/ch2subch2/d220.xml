    <text>
        <body>
            <div xml:id="d220">

                <pb facs="0321" n="217" sameAs="frus:frus1932v05/pg217"/>

                <note rend="inline" type="source">724.3415/2666: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Brazil (Morgan) to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Rio de Janeiro</hi></placeName>, <date
                            calendar="gregorian" when="1932-12-20T15:00:00-02:00">December 20,
                            1932—3 p.m.</date>
                        <lb/> [Received December 20—1:10 p.m.]</dateline>
                </opener>
                <p>128. Department’s telegram 97.<anchor n="81" xml:id="d220-f1"/> Brazilian
                    Government telegraphed Bolivian, Paraguayan Foreign Ministers Saturday, December
                    17, in the sense you desired.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Morgan</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
