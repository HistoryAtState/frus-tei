    <text>
        <body>
            <div xml:id="d268">

                <pb facs="0361" n="257" sameAs="frus:frus1932v05/pg257"/>

                <note rend="inline" type="source">724.3415/2707</note>
                <head>
                    <hi rendition="#italic">The Irish Minister (MacWhite) to the Chairman of the
                        Commission of Neutrals (White)</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1932-12-17">17 December,
                        1932</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. White</hi>: I have received from the
                    President of the Council of the League of Nations the following confidential
                    despatch in code for transmission to you:— <quote rend="blockquote">
                        <p>“Council Committee asks me to state that they feel strongly prompt
                            despatch of Commission to be set up under point five would greatly
                            contribute to ensure success of your Committee’s scheme.”</p>
                    </quote>
                </p>
                <p>Yours sincerely,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">M. MacWhite</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
