    <text>
        <body>
            <div xml:id="d235">

                <pb facs="0338" n="234" sameAs="frus:frus1932v05/pg234"/>

                <note rend="inline" type="source">724.3415/2339: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Consul at Geneva (Gilbert)</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1932-09-27T14:00:00-05:00">September 27,
                            1932—2 p.m.</date>
                    </dateline>
                </opener>
                <p>141. Your 269, September 26, 5 p.m. Wilson
                    has been informed<anchor n="15" xml:id="d235-f1"/> regarding Chaco developments.
                    Please advise him of De Valera’s
                    conversation with you.<anchor n="16" xml:id="d235-f2"/>
                </p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Stimson</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d235-f1" n="15" xml:id="d235-f1-content">
                <p>See <hi rendition="#italic">supra.</hi>
                </p>
            </note>
            <note corresp="#d235-f2" n="16" xml:id="d235-f2-content">
                <p>As set forth in telegram No. 269, September 26, 5 p.m., from the Consul at
                    Geneva, <ref target="#pg232">p. 232</ref>.</p>
            </note>
        </listAnnotation>
