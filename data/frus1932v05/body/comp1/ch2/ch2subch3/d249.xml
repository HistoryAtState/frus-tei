    <text>
        <body>
            <div xml:id="d249">

                <pb facs="0347" n="243" sameAs="frus:frus1932v05/pg243"/>

                <note rend="inline" type="source">724.3415/2480: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Acting Chairman of
                        the American Delegation to the General Disarmament Conference (Gibson)</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1932-11-02T17:00:00-05:00">November 2, 1932—5
                            p.m.</date>
                    </dateline>
                </opener>
                <p>28. For Wilson. Your 32, November 2, 10 a.m. Commission of Neutrals will send a
                    telegram to the President of the Council. Please advise when the Committee will
                    meet so that the telegram may be sent at that time.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Carr</hi>
                    </signed>
                </closer>
            </div>
        </body>
