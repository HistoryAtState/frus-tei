            <div xml:id="d227">

                <pb facs="0333" n="229" sameAs="frus:frus1932v05/pg229"/>

                <note rend="inline" type="source">724.3415/2282: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in Switzerland
                        (Wilson)</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1932-09-15T11:00:00-04:00">September 15,
                            1932—11 a.m.</date>
                    </dateline>
                </opener>
                <p>62. Department approves suggestion made by you in last paragraph of your 81,
                    September 14, 1 p.m. If this action should be taken it would help very
                    materially.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stimson</hi>
                    </signed>
                </closer>
            </div>
        </body>
