                <pb facs="0176" n="72" sameAs="frus:frus1932v05/pg72"/>

                <note rend="inline" type="source">724.3415/2090: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Minister in
                        Paraguay (Wheeler)</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1932-08-18T14:00:00-04:00">August 18, 1932—2
                            p.m.</date>
                    </dateline>
                </opener>
                <p>34. Your 89, August 17, 7 p.m. Please cable alternative suggestion referred to as
                    quickly as possible.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Castle</hi>
                    </signed>
                </closer>
            </div>
