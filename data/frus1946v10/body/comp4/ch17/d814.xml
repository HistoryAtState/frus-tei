    <text>
        <body>
            <div xml:id="d814">

                <pb facs="1098" n="1088" sameAs="frus:frus1946v10/pg1088"/>

                <note rend="inline" type="source">893.24/10–1146: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Consul General at
                        Shanghai</hi> (<hi rendition="#italic">Davis</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1946-10-11T18:00:00-05:00">October 11, 1946—6
                            p.m.</date>
                    </dateline>
                </opener>
                <p>1822. Dept understands Stanvac<anchor n="25" xml:id="d814-f1"/> suggesting
                    Shanghai office attempt arrange for import <hi rendition="#italic">Balch</hi>
                        cargo<anchor n="26" xml:id="d814-f2"/> in bond pending decision matters at
                    issue (your 1929 [bis], Oct 7). Dept feels import in bond if authorized would
                    represent reasonable ad interim compromise present impasse and authorizes ConGen
                    to support Stanvac’s representations in foregoing sense.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d814-f1" n="25" xml:id="d814-f1-content">
                <p>Standard–Vacuum Oil Company.</p>
            </note>
            <note corresp="#d814-f2" n="26" xml:id="d814-f2-content">
                <p>Cargo aboard S.S. <hi rendition="#italic">Allen C. Balch</hi>.</p>
            </note>
        </listAnnotation>
    </standOff>
