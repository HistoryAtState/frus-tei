    <text>
        <body>
            <div xml:id="d763">

                <pb facs="1047" n="1037" sameAs="frus:frus1946v10/pg1037"/>

                <note rend="inline" type="source">Marshall Mission Files, Lot 54–D270:
                    Telegram</note>
                <head>
                    <hi rendition="#italic">General Marshall to
                        Colonel Marshall S. Carter
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Nanking</hi></placeName>,] <date calendar="gregorian"
                            when="1946-05-04">4 May 1946</date>.</dateline>
                </opener>
                <p>640. I concur with State and Treasury regarding maintenance of our present
                    position with respect to offset principle. Your 85205 refers. Please keep me
                    informed of any future proposals to obtain reversal of agreements previously
                    reached with me.<anchor n="17" xml:id="d763-f1"/>
                </p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d763-f1" n="17" xml:id="d763-f1-content">
                <p>See telegram No. 294, February 14, 11 a.m., from the Counselor of Embassy in
                    China, <ref target="#pg939">p. 939</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
