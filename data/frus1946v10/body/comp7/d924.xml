    <text>
        <body>
            <div xml:id="d924">

                <pb facs="1200" n="1190" xml:id="pg1190"/>

                <note rend="inline" type="source">125.3516/11–146: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in the Soviet Union</hi> (<hi rendition="#italic">Durbrow</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Moscow</hi></placeName>, <date
                            calendar="gregorian" when="1946-11-01T16:00:00+03:00">November 1, 1946—4
                            p.m.</date>
                        <lb/> [Received November 1—3:41 p.m.]</dateline>
                </opener>
                <p>4037. Dekanozov<anchor n="45" xml:id="d924-f1"/> informed by letter dated
                    November first of unsatisfactory telegraphic service between Embassy and Dairen
                    and requested to make necessary arrangements for sending such messages via
                    Vladivostok. (Deptel 1901, October 28.)</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Durbrow</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d924-f1" n="45" xml:id="d924-f1-content">
                <p>Vladimir Georgiyevich Dekanozov, Soviet Deputy Minister for Foreign Affairs.</p>
            </note>
        </listAnnotation>
    </standOff>
