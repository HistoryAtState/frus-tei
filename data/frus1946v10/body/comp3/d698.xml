    <text>
        <body>
            <div xml:id="d698">

                <pb facs="0991" n="981" xml:id="pg981"/>

                <note rend="inline" type="source">893.51/4–1246: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Embassy in China </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1946-04-13T13:00:00-05:00">April 13, 1946—1
                            p.m.</date>
                    </dateline>
                </opener>
                <p>643. Decision on deferment for exchange of letters and publicity on Eximbank
                    credit as recommended your 670, Apr 12, 6 p.m., taken prior to departure of
                    General Marshall yesterday.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Byrnes</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
