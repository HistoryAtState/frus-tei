    <text>
        <body>
            <div xml:id="d628">

                <pb facs="0921" n="911" sameAs="frus:frus1946v10/pg911"/>

                <note rend="inline" type="source">893.51/1–446: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            Embassy in China
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1946-01-04T16:00:00-05:00">January 4, 1946—4
                            p.m.</date>
                    </dateline>
                </opener>
                <p>18. For General Marshall.<anchor n="2" xml:id="d628-f1"/> Board of Directors of
                        Eximbank<anchor n="3" xml:id="d628-f2"/> approved Jan 3 a line of credit of
                    $33,000,000 to finance shipments of cotton to China.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Byrnes</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d628-f1" n="2" xml:id="d628-f1-content">
                <p>General of the Army George C. Marshall, Special Representative of President
                    Truman in China.</p>
            </note>
            <note corresp="#d628-f2" n="3" xml:id="d628-f2-content">
                <p>Export–Import Bank of Washington.</p>
            </note>
        </listAnnotation>
    </standOff>
