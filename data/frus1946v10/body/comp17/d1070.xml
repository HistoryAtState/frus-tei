    <text>
        <body>
            <div xml:id="d1070">

                <pb facs="1358" n="1348" xml:id="pg1348"/>

                <note rend="inline" type="source">893.516/6–1446</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Mr.
                            Thomas W. Lamont, of New York</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1946-07-17">July 17, 1946</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Lamont</hi>: I acknowledge with
                    appreciation your letter of June 14, 1946 with enclosures, informing this
                    Department of recent correspondence with the Honkgong and Shanghai Banking
                    Corporation regarding steps to be taken towards termination of the China
                    Consortium. The Department would be interested to learn of the action taken with
                    reference to final dissolution of the Consortium, and of the procedure adopted
                    for notifying the Chinese Government.</p>
                <p>Sincerely yours,</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">William</hi> L. <hi rendition="#small-caps"
                            >Clayton</hi>
                    </signed>
                    <lb/>
                    <hi rendition="#italic">Assistant Secretary</hi>
                </closer>
            </div>
        </body>
    </text>
