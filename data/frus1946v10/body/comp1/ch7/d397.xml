    <text>
        <body>
            <div xml:id="d397">

                <pb facs="0724" n="714" sameAs="frus:frus1946v10/pg714"/>

                <note rend="inline" type="source">Marshall Mission Files, Lot 54–D270:
                    Telegram</note>
                <head>
                    <hi rendition="#italic">Colonel George V.
                            Underwood to Lieutenant General Alvan C.
                            Gillem, Jr., at Peiping</hi><anchor n="21" xml:id="d397-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Nanking</hi></placeName>, <date
                            calendar="gregorian" when="1947-02-11">11 February
                        1947</date>.</dateline>
                </opener>
                <p>2067. This message is sent at the request of Doctor Stuart.</p>
                <p>The Generalissimo asked Doctor Stuart to inform you that he earnestly hoped the
                    inactivation of Executive Headquarters would not remove you from the China
                    scene. He expressed admiration for <pb facs="0725" n="715" xml:id="pg715"/> you
                    personally and genuine appreciation for your past efforts and assistance.</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d397-f1" n="21" type="source" xml:id="d397-f1-content">
                <p>Repeated to Colonel Carter in Washington.</p>
            </note>
        </listAnnotation>
    </standOff>
