    <text>
        <body>
            <div xml:id="d92">

                <pb facs="0204" n="194" xml:id="pg194"/>

                <note rend="inline" type="source">Marshall Mission Files: Lot 54–D270</note>
                <head>
                    <hi rendition="#italic">Memorandum by General Chou En-lai to General Marshall
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">SM 827</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Nanking</hi></placeName>, <date
                            calendar="gregorian" when="1946-09-16">September 16,
                        1946</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear General</hi>: Because of some business that
                    requires my attendance, I am called upon to leave for Shanghai to-day. In case
                    there is any matter that you want to communicate to me, please contact my
                    associates Messrs. Liao Cheng-chih and Wang Ping-nan here.</p>
                <p>As soon as you have decided to convene the Committee of Three, I will be back on
                    your notice.</p>
                <p>Faithfully yours,</p>
                <closer>[Signature in Chinese] <lb/>
                    <signed>(<hi rendition="#small-caps">Chou En-lai</hi>)</signed>
                </closer>
            </div>
        </body>
    </text>
