    <text>
        <body>
            <div xml:id="d116">

                <pb facs="0235" n="225" sameAs="frus:frus1946v10/pg225"/>

                <note rend="inline" type="source">Marshall Mission Files, Lot 54–D270:
                    Telegram</note>
                <head>
                    <hi rendition="#italic">President Truman to
                        General Marshall
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1946-09-26">26 September, 1946</date>.</dateline>
                </opener>
                <p>81554. Personal for General Marshall from the President.</p>
                <quote rend="blockquote">
                    <p>“<hi rendition="#small-caps">Dear General Marshall</hi>: Have read your 1549
                        of September 23d with great interest. I have the utmost confidence in you. I
                        know you can ‘pull the chestnut out of the cross fire.’ If it can be done at
                        all. The President.”</p>
                </quote>
            </div>
        </body>
