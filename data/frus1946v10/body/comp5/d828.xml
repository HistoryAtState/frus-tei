    <text>
        <body>
            <div xml:id="d828">

                <pb facs="1113" n="1103" xml:id="pg1103"/>

                <note rend="inline" type="source">893.00 Manchuria/1–2046: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            Embassy in China
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1946-02-01T15:00:00-05:00">February 1, 1946—3
                            p.m.</date>
                    </dateline>
                </opener>
                <p>198. Dept appreciates your reports on Manchurian developments (Urtel 136 Jan 20
                    11 a.m. and previous) and desires that you continue to maintain contact with
                    Sino authorities with view to keeping us currently informed on matters of
                    significance occurring in that area.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Byrnes</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
