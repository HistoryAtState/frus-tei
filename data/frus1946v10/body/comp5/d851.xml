    <text>
        <body>
            <div xml:id="d851">

                <pb facs="1135" n="1125" xml:id="pg1125"/>

                <note rend="inline" type="source">893.60 Manchuria/4–3046: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Consul General at Mukden</hi> (<hi
                            rendition="#italic">Clubb</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1946-04-30T17:00:00-04:00">April 30, 1946—5
                            p.m.</date>
                    </dateline>
                </opener>
                <p>12. Dept would appreciate such detailed info as may be available regarding
                    Russian seizure of Jap industrial enterprises Manchuria, especially Anshan.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
