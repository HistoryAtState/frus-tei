            <div xml:id="d1006">

                <pb facs="1286" n="1276" sameAs="frus:frus1946v10/pg1276"/>

                <note rend="inline" type="source">811.42793/2–1446: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Embassy in China </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1946-02-26T14:00:00-05:00">February 26,
                            1946—2 p.m.</date>
                    </dateline>
                </opener>
                <p>342. For General Marshall:</p>
                <p>Technical and cultural collaboration programs. Department gratified by your
                    suggestions for handling technical and cultural collaboration programs in China
                    (refer Embtel 287, February 14, 1946). You are assured of full cooperation of
                    the Department.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Byrnes</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
