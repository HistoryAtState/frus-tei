            </note>
            <note corresp="#d557-f4" n="98" xml:id="d557-f4-content">
                <p>Lt. Gen. John E. Hull, Assistant Chief of Staff, Operations Division, War
                    Department.</p>
            </note>
        </listAnnotation>
