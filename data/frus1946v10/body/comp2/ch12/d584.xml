    <text>
        <body>
            <div xml:id="d584">

                <pb facs="0886" n="876" sameAs="frus:frus1946v10/pg876"/>

                <note rend="inline" type="source">893.00/9–2546: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Ambassador in China</hi> (<hi rendition="#italic"
                            >Stuart</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1946-09-25T18:00:00-04:00">September 25,
                            1946—6 p.m.</date>
                    </dateline>
                </opener>
                <p>788. For General Marshall. Thank you for information contained in your
                        1556.<anchor n="65" xml:id="d584-f1"/> As you know by now the Soviet
                    proposal was defeated in the Security Council yesterday by vote of 7 to 2 but I
                    want to let you know that the advice you gave the Chinese was in full accord
                    with the views of the State Department. With best regards.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Clayton</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d584-f1" n="65" xml:id="d584-f1-content">
                <p>
                    <hi rendition="#italic">Supra</hi>.</p>
            </note>
