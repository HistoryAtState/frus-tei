    <text>
        <body>
            <div xml:id="d523">

                <pb facs="0827" n="817" xml:id="pg817"/>

                <note rend="inline" type="source">SWNCC Files: Lot 52 M 45</note>
                <head>
                    <hi rendition="#italic">Note by the Secretaries of the State–War–Navy
                        Coordinating Committee</hi><anchor n="10" xml:id="d523-f1"/>
                </head>
                <opener>
                    <seg rendition="#float-left">SWNCC 83/17</seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1946-02-13">13 February 1946</date>.</dateline>
                </opener>
                <p rendition="#center">
                    <hi rendition="#small-caps">Establishment of a</hi> U. S. <hi
                        rendition="#small-caps">Military Advisory Group to China</hi>
                </p>
                <p>The enclosure, a memorandum on the above subject from the Secretary, Joint Chiefs
                    of Staff, is circulated for consideration by the Committee as a matter of
                    priority.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Alexander</hi> D. <hi rendition="#small-caps"
                            >Reid</hi>
                        <lb/> B. L. <hi rendition="#small-caps">Austin</hi>
                        <lb/>
                        <hi rendition="#small-caps">Raymond</hi> E. <hi rendition="#small-caps"
                            >Cox</hi>
                    </signed>
                </closer>



                <xi:include href="d523-a1.xml" xpointer="d523-a1"/>
                <xi:include href="d523-a2.xml" xpointer="d523-a2"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d523-f1" n="10" type="source" xml:id="d523-f1-content">
                <p>Approved by the Committee on February 14 and copy forwarded to the Secretary of
                    State for implementation.</p>
            </note>
