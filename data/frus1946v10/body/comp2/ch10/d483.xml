    <text>
        <body>
            <div xml:id="d483">

                <pb facs="0798" n="788" sameAs="frus:frus1946v10/pg788"/>

                <note rend="inline" type="source">893.85/2–446: Telegram</note>
                <head>
                    <hi rendition="#italic">The Counselor of Embassy in China</hi> (<hi
                        rendition="#italic">Smyth</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Chungking</hi></placeName>, <date
                            calendar="gregorian" when="1946-02-04T09:00:00+07:00">February 4, 1946—9
                            a.m.</date>
                        <lb/> [Received 2:46 p.m.]</dateline>
                </opener>
                <p>211. From General Marshall for Colonel Davis. [Apparent omission] two additional
                    Liberties approved if WSA representative Shanghai (reference your telegram 185,
                    January 30) concurs in essentiality Chinese need. [Marshall.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Smyth</hi>
                    </signed>
                </closer>
            </div>
        </body>
