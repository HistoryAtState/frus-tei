    <text>
        <body>
            <div xml:id="d514">

                <pb facs="0816" n="806" sameAs="frus:frus1946v10/pg806"/>

                <note rend="inline" type="source">Marshall Mission Files, Lot 54–D270</note>
                <head>
                    <hi rendition="#italic">Memorandum by Colonel J. Hart Caughey </hi><anchor
                        n="81a" xml:id="d514-f1"/>
                    <hi rendition="#italic">to the Minister-Counselor of Embassy in China</hi> (<hi
                        rendition="#italic">Butterworth</hi>)</head>
                <opener>
                    <seg rendition="#float-left">OSE 606</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Nanking</hi></placeName>, <date
                            calendar="gregorian" when="1946-11-29">29 November
                        1946</date>.</dateline>
                </opener>
                <p>Reference is made to 1779, 18 November 1946, copy of which was furnished to you.
                    Colonel Carter has now advised us that he has arranged for the temporary
                    suspension of actual transfer of the subject escort carriers to the Chinese.</p>
                <closer>
                    <signed>J. <hi rendition="#small-caps">Hart Caughey</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
