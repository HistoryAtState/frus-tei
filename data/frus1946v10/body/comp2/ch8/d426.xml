    <text>
        <body>
            <div xml:id="d426">

                <pb facs="0765" n="755" xml:id="pg755"/>

                <note rend="inline" type="source">Marshall Mission Files, Lot 54–D270:
                    Telegram</note>
                <head>
                    <hi rendition="#italic">General Marshall to
                        Colonel Marshall S. Carter
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Nanking</hi></placeName>, <date
                            calendar="gregorian" when="1946-07-24">24 July 1946</date>.</dateline>
                </opener>
                <p>1173. Prefer to let bill expire with Congress as indicated last para your
                        95280<anchor n="51" xml:id="d426-f1"/> if that can be arranged. If deemed
                    desirable, you are at liberty to acquaint Sol Bloom with views in 1164.<anchor
                        n="52" xml:id="d426-f2"/>
                </p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d426-f1" n="51" xml:id="d426-f1-content">
                <p>
                    <hi rendition="#italic">Supra.</hi>
                </p>
            </note>
            <note corresp="#d426-f2" n="52" xml:id="d426-f2-content">
                <p>Telegram of July 22, <ref target="#pg753">p. 753</ref>.</p>
            </note>
