    <text>
        <body>
            <div xml:id="d433">

                <pb facs="0768" n="758" sameAs="frus:frus1946v10/pg758"/>

                <note rend="inline" type="source">811.79693/9–746: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Ambassador in China</hi> (<hi rendition="#italic"
                            >Stuart</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1946-09-10T19:00:00-04:00">September 10,
                            1946—7 p.m.</date>
                    </dateline>
                </opener>
                <p>736. If Gen Marshall concurs Bond should be informally told this Govt desires
                    CNAC not utilize US personnel in flights of (Shanghai’s 1672, Sept 7, 1 p.m.)
                    character described.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Clayton</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
