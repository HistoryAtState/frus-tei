            </note>
            <note corresp="#d934-f4" n="5" xml:id="d934-f4-content">
                <p>Liu Tse-jung, Chinese Commissioner for Foreign Affairs in Sinkiang.</p>
            </note>
        </listAnnotation>
    </standOff>
