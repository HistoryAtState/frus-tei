    <text>
        <body>
            <div xml:id="d788">

                <pb facs="0731" n="559" sameAs="frus:frus1917Supp01v01/pg559"/>

                <note rend="inline" type="source">File No. 763.72111/4515</note>
                <head>
                    <hi rendition="#italic">The Governor of the Hawaiian Islands</hi> (<hi
                        rendition="#italic">Pinkham</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Honolulu</hi></placeName>, <date
                            ana="#date_undated-inferred-from-document-content-and-sibling-dates"
                            calendar="gregorian" notAfter="1917-02-13T21:20:00-05:00"
                            notBefore="1917-02-12T00:00:00-05:00"><hi rendition="#italic"
                                >undated</hi></date>. <lb/> [<hi rendition="#italic">Received
                            February 13, 1917, 9.20 p.m.</hi>]</dateline>
                </opener>
                <p>All transactions of local representatives have been respectively reported
                    Treasury, Justice, Immigration, War, and Navy Departments, Washington. The
                    policy you specify is being carried out.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Pinkham</hi>
                    </signed>
                </closer>
            </div>
        </body>
