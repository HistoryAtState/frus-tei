    <text>
        <body>
            <div xml:id="d765">

                <pb facs="0722" n="550" xml:id="pg550"/>

                <note rend="inline" type="source">File No. 763.72111/4541</note>
                <head>
                    <hi rendition="#italic">The British Ambassador</hi> (<hi rendition="#italic"
                        >Spring Rice</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-02-19">
                            <hi rendition="#italic">February 19, 1917</hi></date>.</dateline>
                </opener>
                <p>The undersigned British Ambassador hereby certifies that according to a sworn
                    statement made to the British Consul at Norfolk, Va., by the master of the
                    British ship <hi rendition="#italic">Oxonian</hi>, the gun on that vessel has
                    never been used except in self-defence and that no attack has been made on a
                    hostile warship.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Cecil Spring Rice</hi>
                    </signed>
                </closer>
            </div>
        </body>
