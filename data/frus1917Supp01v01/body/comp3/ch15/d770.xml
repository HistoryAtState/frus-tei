    <text>
        <body>
            <div xml:id="d770">

                <pb facs="0723" n="551" sameAs="frus:frus1917Supp01v01/pg551"/>

                <note rend="inline" type="source">File No. 763.72/3432</note>
                <head>
                    <hi rendition="#italic">The Minister in Sweden</hi> (<hi rendition="#italic">Morris</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Stockholm</hi></placeName>, <date
                            calendar="gregorian" when="1917-03-06T17:00:00+01:00">
                            <hi rendition="#italic">March 6, 1917, 5 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received midnight.</hi>]</dateline>
                </opener>
                <p>208. Your 137. Foreign Office considers Government’s attitude undetermined, case
                    in point not yet having arisen. More explicit answer promised after careful
                    consideration.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Morris</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
