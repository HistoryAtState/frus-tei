    <text>
        <body>
            <div xml:id="d767">

                <pb facs="0722" n="550" sameAs="frus:frus1917Supp01v01/pg550"/>

                <note rend="inline" type="source">File No. 763.72/3421a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Minister in Denmark</hi> (<hi
                            rendition="#italic">Egan</hi>)<anchor n="2" xml:id="d767-f1"
                    />
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-03-03T16:00:00-05:00">
                            <hi rendition="#italic">March 3, 1917, 4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>268. Please ascertain officially and telegraph whether government to which you
                    are accredited prohibits the entrance and departure of merchant vessels armed
                    for defensive purposes.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d767-f1" n="2" type="source" xml:id="d767-f1-content">
                <p>The same, on the same date, to the diplomatic representatives in Spain (No. 303),
                    Norway (No. 86), Sweden (No. 137); and on Mar. 8, 10 a.m. to the representative
                    in the Netherlands (No. 431).</p>
            </note>
        </listAnnotation>
    </standOff>
