    <text>
        <body>
            <div xml:id="d67">

                <pb facs="0248" n="76" sameAs="frus:frus1917Supp01v01/pg76"/>

                <note rend="inline" type="source">File No. 868.00/100</note>
                <head>
                    <hi rendition="#italic">The Minister in Greece</hi> (<hi rendition="#italic">Droppers</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Athens</hi></placeName>, <date
                            calendar="gregorian" when="1917-03-30T15:00:00+02:00">
                            <hi rendition="#italic">March 30, 1917, 3 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received March 31, 6 a.m.</hi>]</dateline>
                </opener>
                <p>285. Provisional Government Saloniki requests recognition by Government of the
                    United States with a view to sending accredited agent Washington.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Droppers</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
