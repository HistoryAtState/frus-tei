    <text>
        <body>
            <div xml:id="d2">

                <pb facs="0175" n="3" sameAs="frus:frus1917Supp01v01/pg3"/>

                <note rend="inline" type="source">File No. 763.72/3107</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Italy</hi> (<hi rendition="#italic"
                        >Page</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Rome</hi></placeName>, <date
                            calendar="gregorian" when="1917-01-04">
                            <hi rendition="#italic">January 4, 1917</hi></date>. <lb/> [<hi
                            rendition="#italic">Received January 5, 9.43 p.m.</hi>]</dateline>
                </opener>
                <p>771. Noon press report confirmed that British and French Prime Ministers, French
                    War and Munition Ministers, and General Robertson, Lord Milner, and Russian
                    General Palitsyn will arrive Rome to-morrow, Friday morning. General Cadorna
                    also here.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Nelson Page</hi>
                    </signed>
                </closer>
            </div>
        </body>
