    <text>
        <body>
            <div xml:id="d9">

                <pb facs="0182" n="10" xml:id="pg10"/>

                <note rend="inline" type="source">File No. 763.72/3126</note>
                <head>
                    <hi rendition="#italic">The Minister in Greece</hi> (<hi rendition="#italic"
                        >Droppers</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Athens</hi></placeName>, <date
                            calendar="gregorian" when="1917-01-11T11:00:00+02:00">
                            <hi rendition="#italic">January 11, 1917, 11 a.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 5 p.m.</hi>]</dateline>
                </opener>
                <p>222. Ultimatum referred to in my 221, January 9, 10 p.m., accepted in principle,
                    Greek Government absolutely guaranteed against aggression on the part of
                    Provisional Government both by land and sea.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Droppers</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
