    <text>
        <body>
            <div xml:id="d42">

                <pb facs="0226" n="54" xml:id="pg54"/>

                <note rend="inline" type="source">File No. 763.72/3336</note>
                <head>
                    <hi rendition="#italic">The Minister in Greece</hi> (<hi rendition="#italic"
                        >Droppers</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Athens</hi></placeName>, <date
                            calendar="gregorian" when="1917-02-15T11:00:00+02:00">
                            <hi rendition="#italic">February 15, 1917, 11 a.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received February 16, 2.50
                        a.m.</hi>]</dateline>
                </opener>
                <p>254. Entente Ministers satisfied that Greek Government not in good faith in
                    regard to execution of terms of ultimatum, prospects of raising blockade worse
                    than last week.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Droppers</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
