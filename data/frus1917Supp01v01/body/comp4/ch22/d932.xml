    <text>
        <body>
            <div xml:id="d932">

                <pb facs="0829" n="657" sameAs="frus:frus1917Supp01v01/pg657"/>

                <note rend="inline" type="source">File No. 855.48/512</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Commission for Relief in
                        Belgium </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-03-27">
                            <hi rendition="#italic">March 27, 1917</hi></date>.</dateline>
                </opener>
                <p>Your telegram received. Please inform London office, Department considers it
                    desirable that members of commission leave at once.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
