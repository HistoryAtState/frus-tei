    <text>
        <body>
            <div xml:id="d914">

                <pb facs="0820" n="648" xml:id="pg648"/>

                <note rend="inline" type="source">File No. 124.55/9</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in Belgium</hi>
                        (<hi rendition="#italic">Whitlock</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-03-02T20:00:00-05:00">
                            <hi rendition="#italic">March 2, 1917, 8 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>264. Your 45. Obtain assurances in writing from German authorities that the
                    American members of the commission may leave Belgium when they desire.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
