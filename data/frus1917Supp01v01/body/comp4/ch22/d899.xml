    <text>
        <body>
            <div xml:id="d899">

                <pb facs="0809" n="637" sameAs="frus:frus1917Supp01v01/pg637"/>

                <note rend="inline" type="source">File No. 855.48/483</note>
                <head>
                    <hi rendition="#italic">The Netherland Minister</hi> (<hi rendition="#italic"
                        >Van Rappard</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <p rendition="#center">
                    <hi rendition="#small-caps">Confirmation</hi>
                </p>
                <p>The Netherland Minister presents his compliments to his excellency the Secretary
                    of State and begs leave to bring to the latter’s <pb facs="0810" n="638"
                        xml:id="pg638"/> notice that in case the American citizens now engaged in
                    the relief work in Belgium would be compelled by the circumstances to leave that
                    country, the Netherland Government would be glad to form a committee of Dutch
                    subjects who would work under its patronage and take over, either alone or in
                    concerted action with other neutrals, the duties till now performed by the
                    American commission.</p>
                <closer>
                    <dateline rendition="#float-left">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1917-02-14"><hi
                                rendition="#italic">14 February 1917</hi></date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
