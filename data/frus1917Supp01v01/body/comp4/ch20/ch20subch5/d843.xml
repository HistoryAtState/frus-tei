    <text>
        <body>
            <div xml:id="d843">

                <pb facs="0782" n="610" xml:id="pg610"/>

                <note rend="inline" type="source">File No. 701.6292/5</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Chargé in Siam</hi> (<hi
                            rendition="#italic">Arnold</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-08-08T16:00:00-05:00">
                            <hi rendition="#italic">August 8, 1917, 4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your August 5, 1 p.m. Please state to Minister for Foreign Affairs that this
                    Government regrets that it can not permit German and Austrian charges to take
                    ship through Panama Canal.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
