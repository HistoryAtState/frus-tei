    <text>
        <body>
            <div xml:id="d833-a1">

                <pb facs="0775" n="603" sameAs="frus:frus1917Supp01v01/pg603"/>

                <opener>
                    <seg rendition="#center">[Enclosure—Translation]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">The Turkish Minister of Foreign Affairs</hi> (<hi
                        rendition="#italic">Nessimi</hi>) <hi rendition="#italic">to the American
                        Ambassador</hi> (<hi rendition="#italic">Elkus</hi>)</head>
                <opener>
                    <seg rendition="#float-left">No. 95995/172</seg>
                    <dateline rendition="#float-right">
                        <date calendar="gregorian" when="1917-04-20">
                            <hi rendition="#italic">April 20, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Ambassador</hi>: The Embassy of the United
                    States of America having informed the Imperial Ministry of Foreign Affairs by
                    its <hi rendition="#italic">note verbale</hi> of April 8, 1917, No. 2422, that
                    its Government is in a state of war with the German Empire, I have the honor to
                    inform your excellency that the Imperial Ottoman Government, ally of this
                    Empire, is obliged to break its diplomatic relations with the Government of the
                    United States of America beginning from to-day.</p>
                <p>Please accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Ahmed Nessimi</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
