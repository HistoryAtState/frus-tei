    <text>
        <body>
            <div xml:id="d820">

                <pb facs="0764" n="592" sameAs="frus:frus1917Supp01v01/pg592"/>

                <note rend="inline" type="source">File No. 701.6211/408</note>
                <head>
                    <hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic">Sharp</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1917-02-07T13:00:00+00:00">
                            <hi rendition="#italic">February 7, 1917, 1 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 6.30 p.m.</hi>]</dateline>
                </opener>
                <p>1854. My 1853.<anchor n="3" xml:id="d820-f1"/> Foreign Office informs me that it
                    will accord safe-conduct to German Ambassador and party.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Sharp</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
