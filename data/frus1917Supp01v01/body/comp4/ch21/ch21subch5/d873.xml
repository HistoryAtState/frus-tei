    <text>
        <body>
            <div xml:id="d873">

                <pb facs="0793" n="621" sameAs="frus:frus1917Supp01v01/pg621"/>

                <note rend="inline" type="source">File No. 705.6752/–</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Spanish Ambassador</hi> (<hi
                            rendition="#italic">Riaño</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-05-01">
                            <hi rendition="#italic">May 1, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: I have the honor to acknowledge the
                    receipt of your note of April 27, 1917, in which you state that you have on that
                    date taken charge of the interests of Turkey in the United States.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Robert Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
