    <text>
        <body>
            <div xml:id="d872">

                <pb facs="0793" n="621" sameAs="frus:frus1917Supp01v01/pg621"/>

                <note rend="inline" type="source">File No. 705.6752/–</note>
                <head>
                    <hi rendition="#italic">The Spanish Ambassador</hi> (<hi rendition="#italic"
                    >Riaño</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Translation]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-04-27">
                            <hi rendition="#italic">April 27, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Secretary</hi>: I have the honor to advise your
                    excellency that, under instructions received from His Majesty’s Government, I
                    have on this day taken charge of the interests of Turkey in the United
                    States.</p>
                <p>I avail myself [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Juan Riaño</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
