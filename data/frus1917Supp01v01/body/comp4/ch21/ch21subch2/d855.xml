    <text>
        <body>
            <div xml:id="d855">

                <pb facs="0786" n="614" sameAs="frus:frus1917Supp01v01/pg614"/>

                <note rend="inline" type="source">File No. 703.5262/19</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Chargé d’Affaires in the Netherlands</hi> (<hi rendition="#italic">Langhorne</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-07-03T16:00:00-05:00">
                            <hi rendition="#italic">July 3, 1917, 4, p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>585. Your 1026. Please inform Spanish Minister that the Department has no
                    alternative than to request the Swiss Legation here to dispense with the
                    services of the former German Embassy employees.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
