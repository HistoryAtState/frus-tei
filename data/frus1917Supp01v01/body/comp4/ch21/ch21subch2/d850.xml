    <text>
        <body>
            <div xml:id="d850">

                <pb facs="0784" n="612" sameAs="frus:frus1917Supp01v01/pg612"/>

                <note rend="inline" type="source">File No. 705.6254/–</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Swiss Minister</hi> (<hi
                        rendition="#italic">Ritter</hi>)</head>
                <opener>
                    <seg rendition="#float-left">No. 342</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-02-09">
                            <hi rendition="#italic">February 9, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the
                    receipt of your note of February 6, 1917, informing me that by instructions of
                    your Government you have assumed charge of German interests in the United States
                    and asking whether there is any objection thereto on the part of this
                    Government.</p>
                <p>In reply, I have the honor to inform you that this Government sees no objection
                    to your assuming charge of the interests named, <pb facs="0785" n="613"
                        xml:id="pg613"/> nor to the Swiss consular officers taking over the German
                    consulates in the cities listed in your note.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
