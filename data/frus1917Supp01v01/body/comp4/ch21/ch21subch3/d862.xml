    <text>
        <body>
            <div xml:id="d862">

                <pb facs="0790" n="618" sameAs="frus:frus1917Supp01v01/pg618"/>

                <note rend="inline" type="source">File No. 124.63/12a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Spain</hi>
                        (<hi rendition="#italic">Willard</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-02-04T14:00:00-05:00">
                            <hi rendition="#italic">February 4, 1917, 2 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>210. Inquire of Spanish Government whether they would take charge of the
                    interests of this Government in Austria-Hungary in the event of severance of
                    relations between Austria-Hungary and the United States.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
