    <text>
        <body>
            <div xml:id="d869">

                <pb facs="0792" n="620" sameAs="frus:frus1917Supp01v01/pg620"/>

                <note rend="inline" type="source">File No. 705.6352/–</note>
                <head>
                    <hi rendition="#italic">The Spanish Ambassador</hi> (<hi rendition="#italic"
                        >Riaño</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Translation]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-05-26">
                            <hi rendition="#italic">May 26, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Secretary</hi>: I have the honor to inform your
                    excellency that I have just received a telegram from the Minister of State by
                    which he instructs me to notify your excellency that at the request of the
                    Austro-Hungarian Government the Consul of Spain at Honolulu, where Sweden has no
                    representative, has been instructed to take charge of the protection of
                    Austro-Hungarian interests in that island.</p>
                <p>I avail myself [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Juan Riaño</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
