    <text>
        <body>
            <div xml:id="d868">

                <pb facs="0791" n="619" sameAs="frus:frus1917Supp01v01/pg619"/>

                <note rend="inline" type="source">File No. 705.6358/1</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Swedish Minister</hi> (<hi
                            rendition="#italic">Ekengren</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-04-23">
                            <hi rendition="#italic">April 23, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the
                    receipt of your note of April 10, 1917, in which you state that you had been
                    instructed on <pb facs="0792" n="620" xml:id="pg620"/> that day by your
                    Government to assume charge of the Austro-Hungarian interests in the United
                    States and that you have accordingly taken over those interests.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Robert Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
