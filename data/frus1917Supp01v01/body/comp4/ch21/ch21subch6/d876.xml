            <div xml:id="d876">

                <pb facs="0794" n="622" sameAs="frus:frus1917Supp01v01/pg622"/>

                <note rend="inline" type="source">File No. 704.6241/29</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Page</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1917-02-07">
                            <hi rendition="#italic">February 7, 1917</hi></date>. <lb/> [<hi
                            rendition="#italic">Received 5 p.m.</hi>]</dateline>
                </opener>
                <p>5627. At the formal request of the Swiss Minister I have to-day turned over to
                    him the care of the German interests in this country pursuant to last clause of
                    your telegraphic circular instruction of February 3, 5 p.m.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Page</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
