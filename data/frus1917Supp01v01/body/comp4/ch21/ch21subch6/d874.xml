    <text>
        <body>
            <div xml:id="d874">

                <pb facs="0794" n="622" sameAs="frus:frus1917Supp01v01/pg622"/>

                <note rend="inline" type="source">File No. 701.4162/5a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Great
                        Britain</hi> (<hi rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-02-03T14:00:00-05:00">
                            <hi rendition="#italic">February 3, 1917, 2 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>4385. German Ambassador here, together with his staff, will be handed passport at
                    2 p.m. to-day. In accordance with the desire of the British Government expressed
                    last April, the American Ambassador at Berlin has been instructed to turn over
                    British interests in Germany to Dutch Minister there.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
