    <text>
        <body>
            <div xml:id="d953">

                <pb facs="0846" n="674" sameAs="frus:frus1917Supp01v01/pg674"/>

                <note rend="inline" type="source">File No. 701.7211</note>
                <head>
                    <hi rendition="#italic">The Chargé in France</hi> (<hi
                            rendition="#italic">Bliss</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1916-09-11T12:00:00+01:00">
                            <hi rendition="#italic">September 11, 1916, noon</hi></date>. <lb/> [<hi
                            rendition="#italic">Received 12.43 p.m.</hi>]</dateline>
                </opener>
                <p>1590. Serbian Minister at Paris desires me to ascertain whether the nomination of
                    Mr. Lioubomir Michaїlovitch as Envoy
                    Extraordinary and Minister Plenipotentiary of Serbia to the United States will
                    be agreeable to our Government.<anchor n="1" xml:id="d953-f1"/> He was formerly
                    Serbian Minister to Montenegro.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Bliss</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d953-f1" n="1" xml:id="d953-f1-content">
                <p>Serbia had no diplomatic representative in the United States.</p>
            </note>
        </listAnnotation>
    </standOff>
