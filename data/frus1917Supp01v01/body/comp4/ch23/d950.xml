    <text>
        <body>
            <div xml:id="d950">

                <pb facs="0840" n="668" sameAs="frus:frus1917Supp01v01/pg668"/>

                <note rend="inline" type="source">File No. 763.72115/2759</note>
                <head>
                    <hi rendition="#italic">The German Ambassador</hi> (<hi rendition="#italic"
                        >Bernstorff</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Translation]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">J. No. A 131</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-01-08">
                            <hi rendition="#italic">January 8, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Secretary of State</hi>: I have the honor to
                    inclose a memorial sent me by my Government on the employment of Belgian
                    laborers in Germany, refuting the false statements of Germany’s enemies. In case
                    your excellency should not express any objections, I intend to publish it here
                    in the near future.</p>
                <p>Please accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">J. Bernstorff</hi>
                    </signed>
                </closer>


                <xi:include href="d950-a1.xml" xpointer="d950-a1"/>
            </div>
        </body>
    </text>
