    <text>
        <body>
            <div xml:id="d740">

                <pb facs="0697" n="525" sameAs="frus:frus1917Supp01v01/pg525"/>

                <note rend="inline" type="source">File No. 841.711/2090</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Page</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 6435</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1917-06-20">
                            <hi rendition="#italic">June 20, 1917</hi></date>. <lb/> [<hi
                            rendition="#italic">Received July 6.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to the Department’s
                    instruction No. 4916 of April 6, 1917, in regard to remittances from American
                    citizens to persons in Germany, Austria-Hungary, and to neutral countries, which
                    have not reached their destinations owing to their reported detention by British
                    authorities, I have the honor to transmit herewith, for the information of the
                    Department, a copy of a note, dated June 19, 1917, which I have received from
                    the Foreign Office in reply to my representations in this connection.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Walter Hines Page</hi>
                        
                    </signed>
                </closer>


                <xi:include href="d740-a1.xml" xpointer="d740-a1"/>
