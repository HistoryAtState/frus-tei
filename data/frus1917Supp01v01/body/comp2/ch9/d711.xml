    <text>
        <body>
            <div xml:id="d711">

                <pb facs="0679" n="507" sameAs="frus:frus1917Supp01v01/pg507"/>

                <note rend="inline" type="source">File No. 341.115C71/3</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Page</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1917-01-17T13:00:00+00:00">
                            <hi rendition="#italic">January 17, 1917, 1 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 2.30 p.m.</hi>]</dateline>
                </opener>
                <p>5488. Your 4232, December 29, 4 p.m. Foreign Office informs me steamship <hi
                        rendition="#italic">Balboa</hi> has been removed from black list.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Page</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
