    <text>
        <body>
            <div xml:id="d700">

                <pb facs="0658" n="486" xml:id="pg486"/>

                <note rend="inline" type="source">File No. 768.72/6870</note>
                <head>
                    <hi rendition="#italic">The Minister in Liberia</hi> (<hi rendition="#italic"
                        >Curtis</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 124</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Monrovia</hi></placeName>, <date
                            calendar="gregorian" when="1917-08-11">
                            <hi rendition="#italic">August 11, 1917</hi></date>. <lb/> [<hi
                            rendition="#italic">Received September 14.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith
                    enclosed for the information of Department a copy of the Liberian Government’s
                    reply to the protest of the Imperial German Government, through the Spanish
                    Consul, against the contemplated deportation of the Germans resident in Liberia,
                    whereby the thread of the narrative begun in Legation’s No. 120,<anchor n="1"
                        xml:id="d700-f1"/> is woven into a completed story.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">James L. Curtis</hi>
                    </signed>
                </closer>


                <xi:include href="d700-a1.xml" xpointer="d700-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
