    <text>
        <body>
            <div xml:id="d668">

                <pb facs="0635" n="463" sameAs="frus:frus1917Supp01v01/pg463"/>

                <note rend="inline" type="source">File No. 763.72/4664</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Page</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1917-05-15T13:00:00+01:00">
                            <hi rendition="#italic">May 15, 1917, 1 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 4.05 p.m.</hi>]</dateline>
                </opener>
                <p>6219. My 6208, May 14, noon, and previous telegrams. Liberian Minister here asks
                    me to urge strongly the desire of his Government that all German subjects in
                    Liberia be deported immediately; their continued presence constitutes a public
                    danger.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Page</hi>
                    </signed>
                </closer>
            </div>
        </body>
