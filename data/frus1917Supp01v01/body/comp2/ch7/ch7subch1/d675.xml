    <text>
        <body>
            <div xml:id="d675">

                <pb facs="0638" n="466" sameAs="frus:frus1917Supp01v01/pg466"/>

                <note rend="inline" type="source">File No. 763.72/5018</note>
                <head>
                    <hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic">Sharp</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 5452</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1917-05-15">
                            <hi rendition="#italic">May 15, 1917</hi></date>. <lb/> [<hi
                            rendition="#italic">Received May 31.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Confirming my telegram No. 2086 of the 8th
                        instant,<anchor n="1" xml:id="d675-f1"/> relative to the attitude of the
                    French Government regarding the breaking off of relations between the Liberian
                    and the German Imperial Governments, I have the honor to enclose herewith a copy
                    and translation of a note from the Ministry for Foreign Affairs sent me
                    following the verbal statement made by that Ministry on which my said telegram
                    was based.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">W. G. Sharp</hi>
                        
                    </signed>
                </closer>


                <xi:include href="d675-a1.xml" xpointer="d675-a1"/>
            </div>
        </body>
    </text>
