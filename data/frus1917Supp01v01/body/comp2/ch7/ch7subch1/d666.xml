    <text>
        <body>
            <div xml:id="d666">

                <pb facs="0635" n="463" sameAs="frus:frus1917Supp01v01/pg463"/>

                <note rend="inline" type="source">File No. 763.72/4458</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in Liberia</hi>
                        (<hi rendition="#italic">Curtis</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-05-11T15:00:00-05:00">
                            <hi rendition="#italic">May 11, 1917, 3 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your May 7, 4 p.m. Definite instructions will be sent you after conclusion
                    consultation with British Government.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
