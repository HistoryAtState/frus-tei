    <text>
        <body>
            <div xml:id="d533">

                <pb facs="0536" n="364" sameAs="frus:frus1917Supp01v01/pg364"/>

                <note rend="inline" type="source">File No. 763.72111/6765</note>
                <head>
                    <hi rendition="#italic">The Minister in Panama</hi> (<hi rendition="#italic">Price</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Panama</hi></placeName>, <date
                            calendar="gregorian" when="1917-11-10T17:00:00-05:00">
                            <hi rendition="#italic">November 10, 1917, 5 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 11 p.m.</hi>]</dateline>
                </opener>
                <p>Referring to my cable of October 29, 5 p.m.<anchor n="1" xml:id="d533-f1"/>
                    Guatemala replies that it considers its attitude defined by its breaking
                    diplomatic relations <pb facs="0537" n="365" xml:id="pg365"/> with the German
                    Government and declines to participate in conference.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Price</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
