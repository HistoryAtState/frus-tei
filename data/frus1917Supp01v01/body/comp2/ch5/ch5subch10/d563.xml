    <text>
        <body>
            <div xml:id="d563">

                <pb facs="0555" n="383" xml:id="pg383"/>

                <note rend="inline" type="source">File No. 763.72119/990</note>
                <head>
                    <hi rendition="#italic">The Minister in Panama</hi> (<hi rendition="#italic">Price</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Panama</hi></placeName>, <date
                            calendar="gregorian" when="1917-12-07T17:00:00-05:00">
                            <hi rendition="#italic">December 7, 1917, 5 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 8.24 p.m.</hi>]</dateline>
                </opener>
                <p>Costa Rican Minister for Foreign Affairs cables Argentine Minister for Foreign
                    Affairs, Costa Rica abstains from appointing delegates owing to special
                    conditions in the country and regrets that circumstances beyond his control
                    prevent taking part in so important assembly.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Price</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
