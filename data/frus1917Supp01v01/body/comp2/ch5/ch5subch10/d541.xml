    <text>
        <body>
            <div xml:id="d541">

                <pb facs="0541" n="369" sameAs="frus:frus1917Supp01v01/pg369"/>

                <note rend="inline" type="source">File No. 763.72/7770</note>
                <head>
                    <hi rendition="#italic">The Minister in Uruguay</hi> (<hi rendition="#italic"
                        >Jeffery</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 288</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Montevideo</hi></placeName>, <date
                            calendar="gregorian" when="1917-10-17">
                            <hi rendition="#italic">October 17, 1917</hi></date>. <lb/> [<hi
                            rendition="#italic">Received November 17.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith copy
                    of the communication from the Uruguayan Foreign Office advising that on October
                    15 the decrees of neutrality heretofore proclaimed by the Uruguayan Government
                    have been revoked.</p>
                <p>It will be noticed that the reasons assigned for this action are based upon the
                    principle of American solidarity rather than for reasons of direct grievances
                    suffered from the German Government.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Robert Emmett Jeffery</hi>
                        
                    </signed>
                </closer>


                <xi:include href="d541-a1.xml" xpointer="d541-a1"/>
            </div>
        </body>
