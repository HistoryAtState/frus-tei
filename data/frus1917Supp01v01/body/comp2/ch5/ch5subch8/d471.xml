    <text>
        <body>
            <div xml:id="d471">

                <pb facs="0497" n="325" sameAs="frus:frus1917Supp01v01/pg325"/>

                <note rend="inline" type="source">File No. 701.6235/1</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Argentina</hi> (<hi
                        rendition="#italic">Stimson</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Buenos Aires</hi></placeName>, <date
                            calendar="gregorian" when="1917-09-12T14:00:00-04:16">
                            <hi rendition="#italic">September 12, 1917, 2 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 8.50 p.m.</hi>]</dateline>
                </opener>
                <p> Havas<anchor n="2" xml:id="d471-f1"/> telephones me that his passports have been
                    sent to Luxburg.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stimson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
