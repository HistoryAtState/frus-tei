            <div xml:id="d483">

                <pb facs="0502" n="330" sameAs="frus:frus1917Supp01v01/pg330"/>

                <note rend="inline" type="source">File No. 763.72/6987</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Argentina</hi> (<hi rendition="#italic"
                        >Stimson</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Buenos Aires</hi></placeName>, <date
                            calendar="gregorian" when="1917-09-25T10:00:00-04:16">
                            <hi rendition="#italic">September 25, 1917, 10 a.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 1.20 p.m.</hi>]</dateline>
                </opener>
                <p>
                    Havas telephones House voted rupture of diplomatic relations with Germany 53 to
                    19.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Stimson</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
