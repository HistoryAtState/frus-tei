    <text>
        <body>
            <div xml:id="d339">

                <pb facs="0428" n="256" sameAs="frus:frus1917Supp01v01/pg256"/>

                <note rend="inline" type="source">File No. 763.72/3865</note>
                <head>
                    <hi rendition="#italic">The Minister in Uruguay</hi> (<hi rendition="#italic"
                        >Jeffery</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Montevideo</hi></placeName>, <date
                            calendar="gregorian" when="1917-04-16T17:00:00-03:44">
                            <hi rendition="#italic">April 16, 1917, 5 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 11 p.m.</hi>]</dateline>
                </opener>
                <p>The Uruguayan Government has expressed its sympathy for the Brazilian Government
                    on the occasion of its having broken off relations with the Imperial Government
                    of Germany.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Jeffery</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
