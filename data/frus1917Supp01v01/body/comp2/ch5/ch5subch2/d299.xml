    <text>
        <body>
            <div xml:id="d299">

                <pb facs="0409" n="237" sameAs="frus:frus1917Supp01v01/pg237"/>

                <note rend="inline" type="source">File No. 763.72/3438</note>
                <head>
                    <hi rendition="#italic">The Minister in Nicaragua</hi> (<hi rendition="#italic"
                        >Jefferson</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 339</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Managua</hi></placeName>, <date
                            calendar="gregorian" when="1917-02-09">
                            <hi rendition="#italic">February 9, 1917</hi></date>. <lb/> [<hi
                            rendition="#italic">Received March 6</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: In accordance with the Department’s
                    telegraphic circular instruction of February 3, 1917, relative to the break in
                    diplomatic relations between the United States and Germany, I have the honor to
                    report that immediately upon receipt of the same I transmitted a note to the
                    Minister for Foreign Affairs, F. O. 181, of February 4, 1917, a copy of which I
                    am herewith enclosing.<anchor n="2" xml:id="d299-f1"/> I also have the honor to
                    enclose a copy and translation of the reply of the Foreign Office thereto.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Benjamin L. Jefferson</hi>
                    </signed>
                </closer>


                <xi:include href="d299-a1.xml" xpointer="d299-a1"/>
            </div>
