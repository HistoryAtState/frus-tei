    <text>
        <body>
            <div xml:id="d298">

                <pb facs="0408" n="236" sameAs="frus:frus1917Supp01v01/pg236"/>

                <note rend="inline" type="source">File No. 763.72/3439</note>
                <head>
                    <hi rendition="#italic">The Minister in Honduras</hi> (<hi rendition="#italic"
                        >Ewing</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 420</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Tegucigalpa</hi></placeName>, <date
                            calendar="gregorian" when="1917-02-17">
                            <hi rendition="#italic">February 17, 1917</hi></date>. <lb/> [<hi
                            rendition="#italic">Received March 6.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to submit herewith the
                    reply of the Honduran Government to the note delivered February 4 last, in
                    compliance with the Department’s cabled circular instruction of February 3
                    last.</p>
                <p>This reply was received late yesterday and is submitted in the original Spanish
                    together with a translation made in this office.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Jno. Ewing</hi>
                    </signed>
                </closer>


                <xi:include href="d298-a1.xml" xpointer="d298-a1"/>
            </div>
