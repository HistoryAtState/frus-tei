    <text>
        <body>
            <div xml:id="d583">

                <pb facs="0565" n="393" sameAs="frus:frus1917Supp01v01/pg393"/>

                <note rend="inline" type="source">File No. 763.72/8296</note>
                <head>
                    <hi rendition="#italic">The Cuban Chargé</hi> (<hi
                            rendition="#italic">Torralbas</hi>) <hi rendition="#italic"
                        >to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Translation]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 170</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-12-21">
                            <hi rendition="#italic">December 21, 1917</hi></date>. <lb/> [<hi
                            rendition="#italic">Received December 22.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Secretary</hi>: I have the honor to inform your
                    excellency that the Congress of my nation in joint session of the 16th instant
                    declared and the President of the Republic proclaimed a state of war between the
                    Republic of Cuba and the Imperial and Royal Government of Austria-Hungary.</p>
                <p>I avail myself [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Dr. J. R. Torralbas
                        </hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
