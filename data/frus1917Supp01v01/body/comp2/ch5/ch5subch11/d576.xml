    <text>
        <body>
            <div xml:id="d576">

                <pb facs="0562" n="390" sameAs="frus:frus1917Supp01v01/pg390"/>

                <note rend="inline" type="source">File No. 763.72111/6825</note>
                <head>
                    <hi rendition="#italic">The Minister in Ecuador</hi> (<hi rendition="#italic"
                        >Hartman</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Quito</hi></placeName>, <date
                            calendar="gregorian" when="1917-12-17T11:00:00-05:14">
                            <hi rendition="#italic">December 17, 1917, 11 a.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 4.05 p.m.</hi>]</dateline>
                </opener>
                <p>Note from the Minister for Foreign Affairs says that Ecuadoran Government will
                    receive in Ecuadoran waters friendly war vessels <pb facs="0563" n="391"
                        xml:id="pg391"/> without subjecting them to restrictions in force against
                    belligerent war vessels, and that wireless station at Salinas will receive and
                    send telegrams from and to said vessels.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Hartman</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
