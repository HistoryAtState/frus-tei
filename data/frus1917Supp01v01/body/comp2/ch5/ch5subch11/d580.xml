    <text>
        <body>
            <div xml:id="d580">

                <pb facs="0564" n="392" sameAs="frus:frus1917Supp01v01/pg392"/>

                <note rend="inline" type="source">File No. 763.72/8166</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in Panama</hi>
                        (<hi rendition="#italic">Price</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-12-20T15:00:00-05:00">
                            <hi rendition="#italic">December 20, 1917, 3 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your December 16, 3 p.m. Department understands position taken by you in
                    informally suggesting to Government of Panama that National Assembly declare
                    existence of state of war between Panama and Austria-Hungary. Your action is
                    approved.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
