    <text>
        <body>
            <div xml:id="d500">

                <pb facs="0513" n="341" sameAs="frus:frus1917Supp01v01/pg341"/>

                <note rend="inline" type="source">File No. 710/6</note>
                <head>
                    <hi rendition="#italic">The Ecuadoran Minister</hi> (<hi rendition="#italic"
                        >Elizalde</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Translation]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 36</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-10-09">
                            <hi rendition="#italic">October 9, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Secretary of State</hi>: I have the honor of
                    placing in your hands the circular note dated the 11th of September last, which
                    the Chancellery of Ecuador addressed to the American Chancelleries, together
                    with the memorandum to which this note refers.</p>
                <p>I avail myself [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">R. H. Elizalde</hi>
                    </signed>
                </closer>




                <xi:include href="d500-a1.xml" xpointer="d500-a1"/>
