                <note rend="inline" type="source">File No. 835.032/24</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Argentina</hi> (<hi
                            rendition="#italic">Stimson</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-07-03T17:00:00-05:00">
                            <hi rendition="#italic">July 3, 1917, 5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your July 1, 12 noon. Cable brief outline plan of congress of neutrals in message
                    of President.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
