    <text>
        <body>
            <div xml:id="d264">

                <pb facs="0391" n="219" sameAs="frus:frus1917Supp01v01/pg219"/>

                <note rend="inline" type="source">File No. 763.72119/230f</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            Diplomatic Representatives in All Neutral
                            Countries
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Circular telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-12-20">
                            <hi rendition="#italic">December 20, 1916</hi></date>.</dateline>
                </opener>
                <p>Department’s circular December 18 regarding peace.<anchor n="1" xml:id="d264-f1"
                    /> Please deliver quoted note to the Government to which you are accredited for
                    its information.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d264-f1" n="1" xml:id="d264-f1-content">
                <p>The President’s communication of that date to the belligerent governments. <ref
                        target="frus1916Supp#pg_97">
                        <hi rendition="#italic">Foreign Relations</hi>, 1916, Supplement, pp.
                        97</ref>–<ref target="frus1916Supp#pg_99">99</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
