    <text>
        <body>
            <div xml:id="d272">

                <pb facs="0394" n="222" sameAs="frus:frus1917Supp01v01/pg222"/>

                <note rend="inline" type="source">File No. 763.72/3237</note>
                <head>
                    <hi rendition="#italic">The Minister in Bolivia</hi> (<hi rendition="#italic"
                        >O’Rear</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">La Paz</hi></placeName>, <date
                            calendar="gregorian" when="1917-02-06T15:00:00-04:32">
                            <hi rendition="#italic">February 6, 1917, 3 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 7.45 p.m.</hi>]</dateline>
                </opener>
                <p>Note received from Bolivian Government announces that it is thoroughly in accord
                    with view of the Government of the United <pb facs="0395" n="223" xml:id="pg223"
                    /> States on Germany’s submarine policy but declares it has not been notified by
                    German Government. As soon as it is advised by Germany, will immediately notify
                    me of policy adopted by Bolivia.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">O’Rear</hi>
                    </signed>
                </closer>
            </div>
        </body>
