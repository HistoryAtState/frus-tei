    <text>
        <body>
            <div xml:id="d418">

                <pb facs="0469" n="297" xml:id="pg297"/>

                <note rend="inline" type="source">File No. 763.72119/636</note>
                <head>
                    <hi rendition="#italic">The Minister in Paraguay</hi> (<hi rendition="#italic"
                        >Mooney</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Asuncion</hi></placeName>, <date
                            calendar="gregorian" when="1917-06-11T16:00:00-03:50">
                            <hi rendition="#italic">June 11, 1917, 4 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 8 p.m.</hi>]</dateline>
                </opener>
                <p>The Paraguayan Government is not in favor of a convention of the neutral American
                    states nor of any other than that of the American states.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Mooney</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
