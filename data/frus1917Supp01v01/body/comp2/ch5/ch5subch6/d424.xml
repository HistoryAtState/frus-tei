    <text>
        <body>
            <div xml:id="d424">

                <pb facs="0472" n="300" sameAs="frus:frus1917Supp01v01/pg300"/>

                <note rend="inline" type="source">File No. 763.72/5336</note>
                <head>
                    <hi rendition="#italic">The Minister in Uruguay</hi> (<hi rendition="#italic"
                        >Jeffery</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Montevideo</hi></placeName>, <date
                            calendar="gregorian" when="1917-06-15T18:00:00-03:44">
                            <hi rendition="#italic">June 15, 1917, 6 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received June 16, 2 a.m.</hi>]</dateline>
                </opener>
                <p>Uruguayan Minister for Foreign Affairs authorizes me to say to Department of
                    State that all ships of the American Navy, of any kind whatsoever, may now and
                    henceforth visit the ports of Uruguay, for any purpose whatsoever, where they
                    will be received as friend, and not as belligerent, and without
                    restrictions.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Jeffery</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
