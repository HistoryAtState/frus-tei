    <text>
        <body>
            <div xml:id="d334">

                <pb facs="0427" n="255" xml:id="pg255"/>

                <note rend="inline" type="source">File No. 763.72/3860</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Argentina</hi> (<hi rendition="#italic"
                        >Stimson</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Buenos Aires</hi></placeName>, <date
                            calendar="gregorian" when="1917-04-15T11:00:00-04:16">
                            <hi rendition="#italic">April 15, 1917, 11 a.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 4 p.m.</hi>]</dateline>
                </opener>
                <p>Brigantine <hi rendition="#italic">Monte Protegido</hi>, under Argentine flag,
                    sunk off Scilly Islands by German submarine; will probably not cause
                    intervention. Captain and crew all Norwegian but severance of diplomatic
                    relations with Germany likely at any moment.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Stimson</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
