    <text>
        <body>
            <div xml:id="d373">

                <pb facs="0447" n="275" sameAs="frus:frus1917Supp01v01/pg275"/>

                <note rend="inline" type="source">File No. 838.032/28</note>
                <head>
                    <hi rendition="#italic">The Minister in Haiti</hi> (<hi rendition="#italic">Bailly-Blanchard</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Port au Prince</hi></placeName>, <date
                            calendar="gregorian" when="1917-05-04T15:00:00-05:00">
                            <hi rendition="#italic">May 4, 1917, 3 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 8.30 p.m.</hi>]</dateline>
                </opener>
                <p>National Assembly met to-day; war message of the President of Haiti read,
                    discussed, and referred to committee for report.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Blanchard</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
