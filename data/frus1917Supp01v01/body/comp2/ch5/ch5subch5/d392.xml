    <text>
        <body>
            <div xml:id="d392">

                <pb facs="0456" n="284" sameAs="frus:frus1917Supp01v01/pg284"/>

                <note rend="inline" type="source">File No. 763.72/4723</note>
                <head>
                    <hi rendition="#italic">The Minister in Honduras</hi> (<hi rendition="#italic"
                        >Ewing</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Tegucigalpa</hi></placeName>, <date
                            calendar="gregorian" when="1917-05-17T16:00:00-05:48">
                            <hi rendition="#italic">May 17, 1917, 4 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 9 p.m.</hi>]</dateline>
                </opener>
                <p>The President to-day decrees adherence to United States and diplomatic relations
                    with the German Government broken, followed by second decree regarding public
                    safety declaring Republic in <hi rendition="#italic">estado de sitio</hi>.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Ewing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
