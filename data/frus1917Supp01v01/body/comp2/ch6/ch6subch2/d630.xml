    <text>
        <body>
            <div xml:id="d630">

                <pb facs="0603" n="431" sameAs="frus:frus1917Supp01v01/pg431"/>

                <note rend="inline" type="source">File No. 763.72/4004</note>
                <head>
                    <hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >Reinsch</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Peking</hi></placeName>, <date
                            calendar="gregorian" when="1917-04-23T12:00:00+08:00">
                            <hi rendition="#italic">April 23, 1917, 12 noon</hi></date>. <lb/> [<hi
                            rendition="#italic">Received April 23, 8.30 a.m.</hi>]</dateline>
                </opener>
                <p>Your April 19, 4 p.m. If the Department has made any statements to the Chinese
                    Minister with respect to eventual financial assistance, I beg to be
                    informed.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Reinsch</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
