    <text>
        <body>
            <div xml:id="d166">

                <pb facs="0324" n="152" sameAs="frus:frus1917Supp01v01/pg152"/>

                <note rend="inline" type="source">File No. 300.115L98/13</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Austria-Hungary</hi> (<hi
                        rendition="#italic">Penfield</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Vienna</hi></placeName>, <date
                            calendar="gregorian" when="1917-02-27T11:00:00+01:00">
                            <hi rendition="#italic">February 27, 1917, 11 a.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 9 p.m.</hi>]</dateline>
                </opener>
                <p>1729. In informal conference to-day with Minister for Foreign Affairs he stated
                    that American sailing ship <hi rendition="#italic">Lyman M. Law</hi> was not
                    sunk by Austro-Hungarians.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Penfield</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
