    <text>
        <body>
            <div xml:id="d106">

                <pb facs="0286" n="114" sameAs="frus:frus1917Supp01v01/pg114"/>

                <note rend="inline" type="source">File No. 841.857/313</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Page</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1917-02-05">
                            <hi rendition="#italic">February 5, 1917</hi></date>. <lb/> [<hi
                            rendition="#italic">Received 9.15 p.m.</hi>]</dateline>
                </opener>
                <p>5607. I am informed by the Official Press Bureau that British ship <hi
                        rendition="#italic">Eavestone, en route</hi> Newport News to Liverpool, was
                    to-day <pb facs="0287" n="115" xml:id="pg115"/> shelled by German submarine; men
                    took to boats and submarine continued shelling; captain and three seamen killed
                    while in small boats, one of latter being American citizen, Richard
                        Wallace of Baltimore.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Page</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
