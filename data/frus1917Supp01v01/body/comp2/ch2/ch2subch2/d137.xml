    <text>
        <body>
            <div xml:id="d137">

                <pb facs="0306" n="134" xml:id="pg134"/>

                <note rend="inline" type="source">File No. 841.857/343</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Page</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1917-02-14">
                            <hi rendition="#italic">February 14, 1917</hi></date>. <lb/> [<hi
                            rendition="#italic">Received February 15, 9.40 a.m.</hi>]</dateline>
                </opener>
                <p>5689. British sailing ship <hi rendition="#italic">Ainsdale</hi>, from Buenos
                    Ayres November 1 for England, stopped by submarine 180 miles from Cape Clear,
                    February 5; crew of 25 ordered into boats; ship sunk; crew rescued after 10
                    hours; suffered great hardship. Consul, Liverpool, forwarding affidavit only
                    American member crew.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Page</hi>
                    </signed>
                </closer>
            </div>
        </body>
