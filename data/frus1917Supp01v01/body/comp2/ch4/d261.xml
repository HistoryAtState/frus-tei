    <text>
        <body>
            <div xml:id="d261">

                <pb facs="0387" n="215" sameAs="frus:frus1917Supp01v01/pg215"/>

                <note rend="inline" type="source">File No. 763.72111M72/9</note>
                <head>
                    <hi rendition="#italic">The Chargé in the Netherlands</hi> (<hi
                        rendition="#italic">Langhorne</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 879</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">The Hague</hi></placeName>, <date
                            calendar="gregorian" when="1917-04-18">
                            <hi rendition="#italic">April 18, 1917</hi></date>. <lb/> [<hi
                            rendition="#italic">Received May 15.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith a
                    copy and translation of a communication dated April 14, 1917, from the Royal
                    Spanish Minister at The Hague, enclosing certain correspondence regarding the
                    American citizens captured by the German cruiser <hi rendition="#italic"
                        >Moewe</hi>, which the Spanish Ambassador at Berlin forwarded to The Hague
                    for the information of this Legation.<anchor n="1" xml:id="d261-f1"/>
                </p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Marshall Langhorne</hi>
                    </signed>
                </closer>


                <xi:include href="d261-a1.xml" xpointer="d261-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d261-f1" n="1" xml:id="d261-f1-content">
                <p>The German memorandum of Mar. 30, 1917, only, is printed.</p>
            </note>
        </listAnnotation>
