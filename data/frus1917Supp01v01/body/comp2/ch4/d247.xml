        <body>
            <div xml:id="d247">

                <pb facs="0382" n="210" sameAs="frus:frus1917Supp01v01/pg210"/>

                <note rend="inline" type="source">File No. 763.72111Y2/16</note>
                <head>
                    <hi rendition="#italic">The Swiss Minister</hi> (<hi rendition="#italic">Ritter</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-02-12">
                            <hi rendition="#italic">February 12, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Upon cable instructions from my
                    Government, dated February 11, I have the honor to transmit to the American
                    Government the following communication from the German Government.</p>
                <quote rend="blockquote">
                    <p>The immediate release of about 70 Americans, brought in as prisoners of war
                        by the steamer <hi rendition="#italic">Yarrowdale</hi>, is conditional to
                        the German vessels in American waters not being seized and their crews not
                        being interned.</p>
                </quote>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">P. Ritter</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
