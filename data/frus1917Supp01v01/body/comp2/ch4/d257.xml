    <text>
        <body>
            <div xml:id="d257">

                <pb facs="0386" n="214" xml:id="pg214"/>

                <note rend="inline" type="source">File No. 763.72111M72/–</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Ambassador in Spain</hi> (<hi
                            rendition="#italic">Willard</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-03-24T18:00:00-05:00">
                            <hi rendition="#italic">March 24, 1917, 6 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>349. For Berlin. It is reported that the German auxiliary cruiser <hi
                        rendition="#italic">Moewe</hi> has returned to Germany with 592 prisoners
                    taken from ships sunk by that vessel. Please ascertain from German Government
                    whether there are any American citizens among these prisoners and, if so,
                    facilitate their immediate departure from Germany.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Polk</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
