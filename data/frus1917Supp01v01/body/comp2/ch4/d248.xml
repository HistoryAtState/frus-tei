    <text>
        <body>
            <div xml:id="d248">

                <pb facs="0383" n="211" xml:id="pg211"/>

                <note rend="inline" type="source">File No. 763.72111Y2/17</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Spain</hi> (<hi rendition="#italic"
                        >Willard</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Madrid</hi></placeName>, <date
                            calendar="gregorian" when="1917-02-17T11:00:00+00:00">
                            <hi rendition="#italic">February 17, 1917, 11 a.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 6 p.m.</hi>]</dateline>
                </opener>
                <p>355. Minister for Foreign Affairs reports that German Minister for Foreign
                    Affairs told Spanish Ambassador, Berlin, that the American prisoners, S. S. <hi
                        rendition="#italic">Yarrowdale</hi>, and such other nonbelligerents will be
                    liberated in a very short time.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Willard</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
