    <text>
        <body>
            <div xml:id="d250">

                <pb facs="0383" n="211" sameAs="frus:frus1917Supp01v01/pg211"/>

                <note rend="inline" type="source">File No. 763.72111Y2/18</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Spain</hi> (<hi rendition="#italic"
                        >Willard</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Madrid</hi></placeName>, <date
                            calendar="gregorian" when="1917-02-25T16:00:00+00:00">
                            <hi rendition="#italic">February 25, 1917, 4 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 10 p.m.</hi>]</dateline>
                </opener>
                <p>370. Department’s 269, February 20, 3 p.m. Foreign Office has just informed me
                        <hi rendition="#italic">Yarrowdale</hi> prisoners were released 16th
                    instant.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Willard</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
