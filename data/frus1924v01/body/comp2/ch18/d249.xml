            <div xml:id="d249">

                <pb facs="0422" n="308" xml:id="pg308"/>

                <note rend="inline" type="source">875.00/134: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Italy</hi> (<hi rendition="#italic">Fletcher</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Rome</hi></placeName>, <date calendar="gregorian"
                            when="1924-06-05T11:00:00+01:00"><hi rendition="#italic">June 5, 1924—11
                                a.m.</hi></date><lb/>[Received June 5—8:15 a.m.]</dateline></opener>
                <p>105. Albanian revolution seems to be succeeding. Details as far as known here are
                    fully covered in Associated Press reports. Copy to European Information
                    Center.</p>
                <closer><signed><hi rendition="#small-caps">Fletcher</hi></signed></closer>
            </div>
        </body>
    </text>
