                <pb facs="0455" n="341" sameAs="frus:frus1924v01/pg341"/>

                <note rend="inline" type="source">711.428/813</note>
                <head><hi rendition="#italic">The British Ambassador</hi> (<hi
                            rendition="#italic">Howard</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1924-05-28"><hi rendition="#italic">May 28,
                        1924</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 479</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honour to refer to the note
                    which you were so good as to address to me on the 27th instant regarding the
                    convention for the preservation of the Halibut Fishery of the Northern Pacific,
                    signed on March 2nd, 1923, and to inform you that I am in receipt of a
                    communication from the Government of Canada to the effect that the Halibut
                    Fishery Amendment Act, recently passed by the two Houses of the Canadian
                    Parliament, received the Royal assent on the evening of the 27th instant. The
                    Bill in question thus becomes effective as law.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Esme Howard</hi></signed></closer>
            </div>
        </body>
    </text>
