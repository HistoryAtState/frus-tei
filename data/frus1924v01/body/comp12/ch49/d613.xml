    <text>
        <body>
            <div xml:id="d613">

                <pb facs="0771" n="657" sameAs="frus:frus1924v01/pg657"/>

                <note rend="inline" type="source">839.51/2482</note>
                <head><hi rendition="#italic">Lee, Higginson &amp; Company to the Department of
                        State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >New York</hi></placeName>, <date calendar="gregorian"
                            when="1924-10-30"><hi rendition="#italic">October 30,
                        1924</hi></date>.<lb/>[Received October 31.]</dateline></opener>
                <p><hi rendition="#small-caps">Sirs</hi>: At Mr. Greene’s<anchor n="29"
                        xml:id="d613-f1"/> request, we take pleasure in enclosing copy of a contract
                    with the Dominican Republic dated September 25, 1924, regarding the issue of
                    $2,500,000 Dominican Republic Two-Year 5½% Collateral Trust Gold Notes. Very
                    truly yours,</p>
                <closer><hi rendition="#small-caps">Lee, Higginson</hi> &amp; Co.</closer>


                <xi:include href="d613-a1.xml" xpointer="d613-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d613-f1" n="29" xml:id="d613-f1-content">
                <p>Jerome D. Greene, a partner in the firm of Lee, Higginson &amp; Co.</p>
            </note>
