                <pb facs="0362" n="248" sameAs="frus:frus1924v01/pg248"/>

                <note rend="inline" type="source">858.116 M 82/29: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Minister in Sweden</hi> (<hi rendition="#italic"
                            >Morris</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1921-04-07T18:00:00-05:00"><hi rendition="#italic">April 7, 1921—6
                                p.m.</hi></date></dateline></opener>
                <p>20. Department’s No. 17, April 2, 5 p.m. Your No. 40 April 4, 4 p.m.</p>
                <p>Telegraph Swedish Government’s reasons for expelling Mormons. Request no drastic
                    action be taken until matter can be fully investigated.</p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
