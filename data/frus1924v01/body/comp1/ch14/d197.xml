                <pb facs="0364" n="250" sameAs="frus:frus1924v01/pg250"/>

                <note rend="inline" type="source">357.116 M 82/1: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Minister in Norway</hi> (<hi rendition="#italic"
                            >Schmedeman</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1921-04-09T18:00:00-05:00"><hi rendition="#italic">April 9, 1921—6
                                p.m.</hi></date></dateline></opener>
                <p>14. Department’s circular April 5, 1 p.m.<anchor n="34" xml:id="d197-f1"/> Your
                    No. 11, April 9, 3 p.m. Mormon case.</p>
                <p>Request careful reconsideration of matter, and ask no drastic action be taken
                    until case can be fully investigated.</p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
