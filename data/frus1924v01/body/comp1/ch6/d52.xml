                <pb facs="0215" n="101" sameAs="frus:frus1924v01/pg101"/>

                <note rend="inline" type="source">511.4 A 2/110: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Minister in
                        Switzerland</hi> (<hi rendition="#italic">Gibson</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1924-10-15T18:00:00-05:00"><hi rendition="#italic">October 15,
                                1924—6 p.m.</hi></date></dateline></opener>
                <p>78. You may inform the Secretary General of the League of Nations in reply to his
                    telegram received today that the United States accepts the invitation to be
                    represented at the Opium Conference on the third Monday in November, 1924.</p>
                <closer><signed><hi rendition="#small-caps">Grew</hi></signed></closer>
            </div>
        </body>
