    <text>
        <body>
            <div xml:id="d170">

                <pb facs="0351" n="237" xml:id="pg237"/>

                <note rend="inline" type="source">811.2300/30: Telegram</note>
                <head><hi rendition="#italic">The Minister in Denmark</hi> (<hi rendition="#italic"
                        >Prince</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Copenhagen</hi></placeName>, <date calendar="gregorian"
                            when="1924-01-23T12:00:00+01:00"><hi rendition="#italic">January 23,
                                1924—noon</hi></date>.<lb/>[Received January 23—9:20
                        a.m.]</dateline></opener>
                <p>6. Department’s 3, January 18, 7 p.m.<anchor n="99" xml:id="d170-f1"/> Am
                    informed verbally by Director General of Foreign Office that permission will be
                    granted for requests as outlined. Written confirmation to follow.</p>
                <closer><signed><hi rendition="#small-caps">Prince</hi></signed></closer>
            </div>
        </body>
    </text>
