    <text>
        <body>
            <div xml:id="d188">

                <pb facs="0359" n="245" sameAs="frus:frus1924v01/pg245"/>

                <note rend="inline" type="source">811.2300/87b: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Ambassador in Great
                        Britain</hi> (<hi rendition="#italic">Kellogg</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1924-04-03T17:00:00-05:00"><hi rendition="#italic">April 3, 1924—5
                                p.m.</hi></date></dateline></opener>
                <p>84. World Flight. Through inadvertence Department did not request permission from
                    British Government for flight to pass through <pb facs="0360" n="246"
                        xml:id="pg246"/> Hongkong. Please endeavor to obtain permission immediately
                    and telegraph reply.<anchor n="26" xml:id="d188-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d188-f1" n="26" xml:id="d188-f1-content">
                <p>The Ambassador telegraphed on Apr. 25, 1 p.m., that permission had been granted
                    (file no. 811.2300/96).</p>
            </note>
        </listAnnotation>
    </standOff>
