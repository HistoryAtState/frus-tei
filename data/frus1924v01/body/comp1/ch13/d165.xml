                <pb facs="0349" n="235" sameAs="frus:frus1924v01/pg235"/>

                <note rend="inline" type="source">811.2300/25: Telegram</note>
                <head><hi rendition="#italic">The Minister in Persia</hi> (<hi rendition="#italic"
                        >Kornfeld</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Teheran</hi></placeName>, <date calendar="gregorian"
                            when="1924-01-21T12:00:00+03:25"><hi rendition="#italic">January 21,
                                1924—12 noon</hi></date>.<lb/>[Received January 22—1:25
                        a.m.]</dateline></opener>
                <p>4. Department’s January 18, 5 p.m.<anchor n="96" xml:id="d165-f1"/> Persian
                    Government consents to flight. See Legation’s telegram 2, January 10, 12
                        noon.<anchor n="96" xml:id="d165-f2"/></p>
                <closer><signed><hi rendition="#small-caps">Kornfeld</hi></signed></closer>
            </div>
        </body>
    </text>
