    <text>
        <body>
            <div xml:id="d168">

                <pb facs="0350" n="236" sameAs="frus:frus1924v01/pg236"/>

                <note rend="inline" type="source">811.2300/26: Telegram</note>
                <head><hi rendition="#italic">The Minister in the Kingdom of the Serbs, Groats and
                        Slovenes</hi> (<hi rendition="#italic"
                        >Dodge</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Belgrade</hi></placeName>, <date calendar="gregorian"
                            when="1924-01-21T17:00:00+01:00"><hi rendition="#italic">January 21,
                                1924—5 p.m.</hi></date><lb/>[Received 11:50
                    p.m.]</dateline></opener>
                <p>6. Your January 18, 7 p.m.<anchor n="97" xml:id="d168-f1"/> Minister of War has
                    just informed me that he is happy to grant all requests your 19, December 22, 3
                        p.m.,<anchor n="98" xml:id="d168-f2"/> and will shortly send me confirmation
                    in writing.</p>
                <closer><signed><hi rendition="#small-caps">Dodge</hi></signed></closer>
            </div>
        </body>
    </text>
