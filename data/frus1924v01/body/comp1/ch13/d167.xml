                <pb facs="0350" n="236" sameAs="frus:frus1924v01/pg236"/>

                <note rend="inline" type="source">811.2300/24: Telegram</note>
                <head><hi rendition="#italic">The Minister in Siam</hi> (<hi rendition="#italic"
                        >Brodie</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Bangkok</hi></placeName>, <date calendar="gregorian"
                            when="1924-01-21T15:00:00+07:00"><hi rendition="#italic">January 21,
                                1924—3 p.m.</hi></date><lb/>[Received January 21—2:42
                        p.m.]</dateline></opener>
                <p>1. Department’s telegram 17, December 22, 3 p.m.<anchor n="98" xml:id="d167-f1"/>
                    Permission granted in accordance with Department’s telegram covering all
                    requests. Mail despatch following.<anchor n="97" xml:id="d167-f2"/></p>
                <closer><signed><hi rendition="#small-caps">Brodie</hi></signed></closer>
            </div>
        </body>
    </text>
