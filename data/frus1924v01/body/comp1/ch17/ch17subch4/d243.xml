            </note>
            <note corresp="#d243-f2" n="90" xml:id="d243-f2-content">
                <p>Ecuadoran Minister for Foreign Affairs.</p>
            </note>
            <note corresp="#d243-f3" n="91" xml:id="d243-f3-content">
                <p>Peruvian Minister in Ecuador.</p>
            </note>
            <note corresp="#d243-f4" n="92" xml:id="d243-f4-content">
                <p>Despatch no. 356, June 30; not printed. No further action in fulfillment of the
                    protocol was taken by the Governments of Ecuador and Peru until 1934.</p>
            </note>
        </listAnnotation>
