                <pb facs="0249" n="135" sameAs="frus:frus1924v01/pg135"/>

                <note rend="inline" type="source">551.A1a/22: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Ambassador in Great Britain</hi> (<hi rendition="#italic">Kellogg</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1924-07-18T19:00:00-04:00"><hi rendition="#italic">July 18, 1924—7
                                p.m.</hi></date></dateline></opener>
                <p>226. Department’s 171, June 21, 2 p.m.,<anchor n="2" xml:id="d73-f1"/> regarding
                    relief credits committee.</p>
                <p>Meeting of Committee postponed to July 29. Please have representative attend at
                    that time.</p>
                <closer><signed><hi rendition="#small-caps">Grew</hi></signed></closer>
            </div>
        </body>
    </text>
