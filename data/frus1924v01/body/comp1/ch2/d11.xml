    <text>
        <body>
            <div xml:id="d11">

                <pb facs="0128" n="14" sameAs="frus:frus1924v01/pg14"/>

                <note rend="inline" type="source">500.A4b/290</note>
                <head><hi rendition="#italic">The Chairman of the House of Representatives Committee
                        on Naval Affairs</hi> (<hi rendition="#italic">Butler</hi>) <hi
                        rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1924-12-30"><hi rendition="#italic">December 30,
                        1924</hi></date></dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. Secretary</hi>: I have the honor to transmit
                    herewith on behalf of the Committee on Naval Affairs of the House of
                    Representatives <pb facs="0129" n="15" xml:id="pg15"/> (H. Res. 387) requesting
                    certain information, and to request that same be furnished if not incompatible
                    with the public interest.</p>
                <p>Believe me [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Thomas S. Butler</hi></signed></closer>


                <xi:include href="d11-a1.xml" xpointer="d11-a1"/>
            </div>
