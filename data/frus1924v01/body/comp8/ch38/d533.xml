            <div xml:id="d533">

                <pb facs="0664" n="550" sameAs="frus:frus1924v01/pg550"/>

                <note rend="inline" type="source">893.51/4668</note>
                <head><hi rendition="#italic">The American Group to the
                            Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >New York</hi></placeName>, <date calendar="gregorian"
                            when="1924-07-29"><hi rendition="#italic">July 29,
                        1924</hi></date>.<lb/>[Received July 30.]</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: We enclose, for the information and files
                    of the Department, printed text of Minutes of the Meeting of the Consortium
                    Council held in London on July 14th. …</p>
                <p>Respectfully,</p>
                <closer><hi rendition="#small-caps">J. P. Morgan</hi> &amp; Co.<lb/><hi
                        rendition="#italic">For the American Group</hi></closer>


                <xi:include href="d533-a1.xml" xpointer="d533-a1"/>
