                <pb facs="0624" n="510" sameAs="frus:frus1924v01/pg510"/>

                <note rend="inline" type="source">861.77/3660: Telegram</note>
                <head><hi rendition="#italic">The Consul at Harbin</hi> (<hi rendition="#italic"
                        >Hanson</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Harbin</hi></placeName>, <date calendar="gregorian"
                            when="1924-10-03T18:00:00+08:26"><hi rendition="#italic">October 3,
                                1924—6 p.m.</hi></date><lb/>[Received 8:50 p.m.]</dateline></opener>
                <p>General Manager Ostroumoff arrested and imprisoned by Chinese police; charges
                    unknown. Informed the Legation and Mukden.</p>
                <closer><signed><hi rendition="#small-caps">Hanson</hi></signed></closer>
            </div>
        </body>
    </text>
