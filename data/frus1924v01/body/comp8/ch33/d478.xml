    <text>
        <body>
            <div xml:id="d478">

                <pb facs="0609" n="495" sameAs="frus:frus1924v01/pg495"/>

                <note rend="inline" type="source">761.93/494</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">Schurman</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1924-06-18"><hi rendition="#italic">June 18,
                        1924</hi></date>.<lb/>[Received July 15.]</dateline>
                    <seg rendition="#float-left">No. 2324</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my telegram No. 186 of June
                    17, 7 p.m., 1924,<anchor n="18" xml:id="d478-f1"/> and to previous
                    correspondence regarding the Sino-Russian Agreements, Declarations, and exchange
                    of notes, signed May 31, 1924, I have the honor to transmit herewith three
                    copies of the pamphlet issued yesterday by the Ministry of Foreign Affairs
                    containing the above documents.<anchor n="19" xml:id="d478-f2"/></p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>I have [etc.]</p>
                <closer>(For the Minister)<lb/><signed><hi rendition="#small-caps">Edward
                        Bell</hi></signed></closer>



                <xi:include href="d478-a1.xml" xpointer="d478-a1"/>
                <xi:include href="d478-a2.xml" xpointer="d478-a2"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d478-f1" n="18" xml:id="d478-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d478-f2" n="19" xml:id="d478-f2-content">
                <p><hi rendition="#italic">Agreements between the Republic of China and the Union of
                        Soviet Socialist Republics and Annexes</hi>. The declarations and exchange
                    of notes printed in this pamphlet are not reproduced here. They are included in
                    the agreements printed in the League of Nations Treaty Series, vol. <hi
                        rendition="#small-caps">xxxvii</hi>, pp. 176 ff.</p>
            </note>
        </listAnnotation>
    </standOff>
