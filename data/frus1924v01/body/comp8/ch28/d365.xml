                <pb facs="0512" n="398" sameAs="frus:frus1924v01/pg398"/>

                <note rend="inline" type="source">893.00/5786: Telegram</note>
                <head><hi rendition="#italic">The Consul General at Shanghai</hi> (<hi
                        rendition="#italic">Cunningham</hi>) <hi rendition="#italic">to the
                        Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Shanghai</hi></placeName>, <date calendar="gregorian"
                            when="1924-11-22"><hi rendition="#italic">November 22,
                        1924</hi></date>.<lb/>[Received November 22—1:45 p.m.]</dateline></opener>
                <p>Following from Nanking: <quote rend="blockquote">
                        <p>“November 22, 11 a.m. Please send following telegram to the Department:
                            ‘Marshal Chi embarrassed by Wu’s unauthorized use of his name in
                            manifesto proclaiming Yangtze military government, and has repeated
                            circular telegram endorsing Tuan. He will assist Wu defensively but
                            considers aggression impracticable.</p>
                        <p>Situation delicate and uncertain. Davis.’ ”</p></quote></p>
                <closer><signed><hi rendition="#small-caps">Cunningham</hi></signed></closer>
            </div>
        </body>
