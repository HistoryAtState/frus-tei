                <pb facs="0528" n="414" sameAs="frus:frus1924v01/pg414"/>

                <note rend="inline" type="source">893.51/4709</note>
                <head><hi rendition="#italic">The British Ambassador</hi> (<hi
                            rendition="#italic">Howard</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1924-10-25"><hi rendition="#italic">October 25,
                        1924</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1006</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honour to inform you that His
                    Majesty’s Government have learnt that the Canton Government are again
                    threatening to seize the Customs House and to declare Canton a free port.</p>
                <p>I am directed by my Government to express the earnest hope that you will
                    authorize the United States Representative at Peking to concert with His
                    Majesty’s Representative in arranging for a renewal of the naval
                    demonstration.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Esme Howard</hi></signed></closer>
            </div>
        </body>
    </text>
