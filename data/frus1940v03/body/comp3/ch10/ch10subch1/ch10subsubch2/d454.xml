    <text>
        <body>
            <div xml:id="d454">

                <pb facs="0571" n="559" sameAs="frus:frus1940v03/pg559"/>

                <note rend="inline" type="source">740.0011 European War 1939/6621a: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in Greece</hi>
                        (<hi rendition="#italic">MacVeagh</hi>)<anchor n="47" xml:id="d454-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1940-11-07T18:00:00-05:00">November 7, 1940—6
                            p.m.</date>
                    </dateline>
                </opener>
                <p>248. You are instructed to inquire of the Greek Government whether it considers a
                    state of war exists between Greece and Italy.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d454-f1" n="47" type="source" xml:id="d454-f1-content">
                <p>The same, <hi rendition="#italic">mutatis mutandis</hi>, as telegram No. 536,
                    November 7, 7 p.m., to the Chargé in Italy.</p>
            </note>
        </listAnnotation>
    </standOff>
