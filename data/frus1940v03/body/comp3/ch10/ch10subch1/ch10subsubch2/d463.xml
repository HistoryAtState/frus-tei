    <text>
        <body>
            <div xml:id="d463">

                <pb facs="0575" n="563" sameAs="frus:frus1940v03/pg563"/>

                <note rend="inline" type="source">740.0011 European War 1939/6819: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in Italy</hi> (<hi
                            rendition="#italic">Reed</hi>) <hi rendition="#italic">to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Rome</hi></placeName>, <date
                            calendar="gregorian" when="1940-11-23T09:00:00+02:00">November 23,
                            1940—9 a.m.</date>
                        <lb/> [Received November 23—8 a.m.]</dateline>
                </opener>
                <p>1115. Department’s No. 536, November 7, 7 p.m.<anchor n="52" xml:id="d463-f1"/>
                    By note dated November 20 just received the Foreign Office states that Greece is
                    considered an enemy state since October 28.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Reed</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
