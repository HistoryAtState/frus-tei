                <pb facs="0908" n="896" sameAs="frus:frus1940v03/pg896"/>

                <note rend="inline" type="source">740.0011 European War 1939/4485a: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in the United Kingdom</hi> (<hi
                            rendition="#italic">Kennedy</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1940-07-03">July 3, 1940</date>.</dateline>
                </opener>
                <p>1578. Can you confirm press reports that the Foreign Office has issued a
                    statement expressing the determination of Britain to prevent Syria and Lebanon
                    from being occupied by any hostile power.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
