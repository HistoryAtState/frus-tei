                <pb facs="0904" n="892" sameAs="frus:frus1940v03/pg892"/>

                <note rend="inline" type="source">740.0011 European War 1939/4174d: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Consul General at
                        Beirut</hi> (<hi rendition="#italic">Palmer</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1940-06-24T13:00:00-04:00">June 24, 1940—1
                            p.m.</date>
                    </dateline>
                </opener>
                <p>31. Please report regarding attitude of Allied army in Near East and of the
                    French authorities in your area concerning present situation.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
