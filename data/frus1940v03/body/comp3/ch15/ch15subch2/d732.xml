            <div xml:id="d732">

                <pb facs="0808" n="796" xml:id="pg796"/>

                <note rend="inline" type="source">881.00/1793a: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Chargé in the United
                        Kingdom</hi> (<hi rendition="#italic">Johnson</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1940-12-10T15:00:00-05:00">December 10,
                            1940—3 p.m.</date>
                    </dateline>
                </opener>
                <p>3736. Please forward Department by telegraph text of statement made in House of
                    Commons by Butler on December 4 regarding Tangier and send copy to Tangier by
                    mail.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
