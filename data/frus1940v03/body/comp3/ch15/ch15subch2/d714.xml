            </note>
            <note corresp="#d714-f2" n="17b" xml:id="d714-f2-content">
                <p>
                    <hi rendition="#italic">Mehal-la Jalifiana</hi>.</p>
            </note>
            <note corresp="#d714-f3" n="17c" xml:id="d714-f3-content">
                <p>
                    <hi rendition="#italic">en nombre de mi Gobierno</hi>.</p>
            </note>
        </listAnnotation>
