            <div xml:id="d685">

                <pb facs="0765" n="753" sameAs="frus:frus1940v03/pg753"/>

                <note rend="inline" type="source">811.3340/1045: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in Liberia</hi> (<hi
                            rendition="#italic">Wharton</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Monrovia</hi></placeName>, <date
                            calendar="gregorian" when="1940-10-06T13:00:00-00:44">October 6, 1940—1
                            p.m.</date>
                        <lb/> [Received October 7—8:10 a.m.]</dateline>
                </opener>
                <p>59. In reply to my request for visit Simpson states his Government will be
                    pleased to receive <hi rendition="#italic">Omaha</hi>.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wharton</hi>
                    </signed>
                </closer>
            </div>
        </body>
