            <div xml:id="d682">

                <pb facs="0763" n="751" sameAs="frus:frus1940v03/pg751"/>

                <note rend="inline" type="source">811.3340/1043: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Chargé in Liberia</hi>
                        (<hi rendition="#italic">Wharton</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1940-10-01T17:00:00-05:00">October 1, 1940—5
                            p.m.</date>
                    </dateline>
                </opener>
                <p>37. Please request permission for the U.S.S. <hi rendition="#italic">Omaha</hi>,
                    Flagship of Rear Admiral David M. LeBreton, commanded by Captain L. A. Davidson,
                    to visit Monrovia informally from October 9 to 11, inclusive.</p>
                <p>Telegraph reply.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
