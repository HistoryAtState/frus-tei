            <div xml:id="d693">

                <pb facs="0772" n="760" sameAs="frus:frus1940v03/pg760"/>

                <note rend="inline" type="source">752.822/4: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in Liberia</hi> (<hi rendition="#italic"
                        >Wharton</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Monrovia</hi></placeName>, <date
                            calendar="gregorian" when="1940-08-24T14:00:00-00:44">August 24, 1940—2
                            p.m.</date>
                        <lb/> [Received August 25—1:20 a.m.]</dateline>
                </opener>
                <p>50. In answer to your telegram 32, August 21, 6 p.m., Simpson states that no
                    action will be taken.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wharton</hi>
                    </signed>
                </closer>
            </div>
        </body>
