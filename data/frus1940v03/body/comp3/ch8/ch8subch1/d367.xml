                <pb facs="0502" n="490" sameAs="frus:frus1940v03/pg490"/>

                <note rend="inline" type="source">740.0011 European War 1939/7304a: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in Egypt</hi>
                        (<hi rendition="#italic">Fish</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1940-12-26T21:00:00-05:00">December 26,
                            1940—9 p.m.</date>
                    </dateline>
                </opener>
                <p>162. Please report whether or not combat operations of any kind have recently
                    taken place on or over the Red Sea, the Gulf of Aden, and the Straits of Bab el
                    Mandeb.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
