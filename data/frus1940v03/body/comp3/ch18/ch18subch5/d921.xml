    <text>
        <body>
            <div xml:id="d921">

                <pb facs="1016" n="1004" xml:id="pg1004"/>

                <note rend="inline" type="source">390D.11/189: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Turkey</hi> (<hi rendition="#italic"
                            >MacMurray</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1940-04-02T17:00:00-05:00">April 2, 1940—5
                            p.m.</date>
                    </dateline>
                </opener>
                <p>23. Your 21, February 29, 11 a.m. and Department’s 12, February 29, 11
                        a.m.<anchor n="58" xml:id="d921-f1"/> The Department is willing to transmit
                    to Turkey requests of American citizens that they be released from Turkish
                    allegiance, and will require satisfactory evidence that the persons whose
                    requests are transmitted have acquired American citizenship.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d921-f1" n="58" xml:id="d921-f1-content">
                <p>Latter not printed.</p>
