            <div xml:id="d890">

                <pb facs="0969" n="957" sameAs="frus:frus1940v03/pg957"/>

                <note rend="inline" type="source">811.20 Defense (M)/489: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Turkey</hi> (<hi
                            rendition="#italic">MacMurray</hi>) <hi rendition="#italic"
                        >to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Ankara</hi></placeName>, <date
                            calendar="gregorian" when="1940-10-15T17:00:00+02:00">October 15, 1940—5
                            p.m.</date>
                        <lb/> [Received 7:58 p.m.]</dateline>
                </opener>
                <p>169. Embassy’s 166, October 9, 5 p.m. The British Embassy received today the
                    written consent of the Turkish Government to the resale of Turkish chrome to us
                    by Great Britain.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">MacMurray</hi>
                    </signed>
                </closer>
            </div>
        </body>
