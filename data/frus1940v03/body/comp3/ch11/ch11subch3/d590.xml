                <pb facs="0673" n="661" sameAs="frus:frus1940v03/pg661"/>

                <note rend="inline" type="source">891.6363 Standard Oil/428: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Chargé in Iran</hi> (<hi
                        rendition="#italic">Engert</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1940-01-20T11:00:00-05:00">January 20,
                            1940—11 a.m.</date>
                    </dateline>
                </opener>
                <p>8. The substance of your 11, January 17, 11 a.m., has been transmitted to the
                    Standard Oil Company of New Jersey.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
