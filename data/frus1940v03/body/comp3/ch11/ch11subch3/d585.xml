            <div xml:id="d585">

                <pb facs="0671" n="659" sameAs="frus:frus1940v03/pg659"/>

                <note rend="inline" type="source">891.6363 Standard Oil Co./422: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in Iran</hi> (<hi rendition="#italic"
                        >Engert</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Tehran</hi></placeName>, <date
                            calendar="gregorian" when="1939-12-21T19:00:00+03:25">December 21,
                            1939—7 p.m.</date>
                        <lb/> [Received December 21—2:05 p.m.]</dateline>
                </opener>
                <p>170. Representative of Standard Oil Company of New Jersey, Lawrence Anderson,
                    arrived today to seek an important oil concession. He believes his company
                    advised the Department of the purpose of his coming.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Engert</hi>
                    </signed>
                </closer>
            </div>
        </body>
