            <div xml:id="d576">

                <pb facs="0664" n="652" sameAs="frus:frus1940v03/pg652"/>

                <note rend="inline" type="source">891.248/87: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in Iran</hi> (<hi
                            rendition="#italic">Engert</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Tehran</hi></placeName>, <date
                            calendar="gregorian" when="1940-08-26T09:00:00+03:25">August 26, 1940—9
                            a.m.</date>
                        <lb/> [Received 3:05 p.m.]</dateline>
                </opener>
                <p>193. Minister of Foreign Affairs inquires whether he may expect a reply to my
                    178, July 29, noon.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Engert</hi>
                    </signed>
                </closer>
            </div>
        </body>
