    <text>
        <body>
            <div xml:id="d640">

                <pb facs="0714" n="702" sameAs="frus:frus1940v03/pg702"/>

                <note rend="inline" type="source">391.1164/167: Telegram</note>
                <head>
                    <hi rendition="#italic">Dr. J. L. Dodds of the
                        Presbyterian Board of Foreign Missions to the Chief of the Division of Near
                        Eastern Affairs</hi> (<hi rendition="#italic"
                            >Murray</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">New York</hi></placeName>, <date
                            calendar="gregorian" when="1940-12-19T12:40:00-05:00">December 19,
                            1940—12:40 p.m.</date>
                        <lb/> [Received 3:22 p.m.]</dateline>
                </opener>
                <p>First payment 100,000 received this morning from Iran.</p>
                <closer>
                    <signed>J. L. <hi rendition="#small-caps">Dodds</hi>
                    </signed>
                </closer>
                <postscript>
                    <p>[For statement on this subject released to the press January 9, 1941, see
                        Department of State <hi rendition="#italic">Bulletin</hi>, January 11, 1941,
                        page 61.]</p>
                </postscript>
            </div>
        </body>
