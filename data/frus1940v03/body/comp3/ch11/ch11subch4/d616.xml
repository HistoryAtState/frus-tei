            <div xml:id="d616">

                <pb facs="0697" n="685" sameAs="frus:frus1940v03/pg685"/>

                <note rend="inline" type="source">611.9131/123: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in Iran</hi> (<hi rendition="#italic"
                        >Engert</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Tehran</hi></placeName>, <date
                            calendar="gregorian" when="1940-10-09T12:00:00+03:25">October 9,
                            1940—noon</date>.<lb/>[Received 12:05 p.m.]</dateline>
                </opener>
                <p>221. I should like if possible to communicate to the Prime Minister some sort of
                    reply with regard to the matter referred to in my 194, August 26, 10 a.m.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Engert</hi>
                    </signed>
                </closer>
            </div>
        </body>
