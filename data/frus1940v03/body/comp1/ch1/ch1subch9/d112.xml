                <pb facs="0139" n="127" sameAs="frus:frus1940v03/pg127"/>

                <note rend="inline" type="source">611.48N16/78: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Chargé in the United Kingdom</hi> (<hi
                            rendition="#italic">Johnson</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1940-01-24T19:00:00-05:00">January 24, 1940—7
                            p.m.</date>
                    </dateline>
                </opener>
                <p>150. Department’s 1661 of December 22, 6 p.m. Please endeavor to obtain a
                    definite statement as to the British attitude.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
