    <text>
        <body>
            <div xml:id="d110">

                <pb facs="0268" n="250" xml:id="pg250"/>

                <note rend="inline" type="source">Lot 54D423</note>
                <head>
                    <hi rendition="#italic">The Assistant Secretary of State for Far Eastern
                        Affairs</hi> (<hi rendition="#italic"
                        >Rusk</hi>) <hi rendition="#italic">to the Secretary of Foreign
                        Affairs of the Philippines</hi> (<hi rendition="#italic"
                            >Romulo</hi>)<anchor n="1" xml:id="d110-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1951-08-29">August 29, 1951</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: In connection with the
                    Mutual Defense Treaty which we are about to sign I want to confirm to you our
                    understanding that there is an interdependence between this Treaty and the
                    contemplated Japanese Peace Treaty in the sense that it is assumed that both of
                    us will sign and ratify both Treaties.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Dean Rusk</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d110-f1" n="1" type="source" xml:id="d110-f1-content">
                <p>Letter drafted by Mr. Dulles.</p>
            </note>
        </listAnnotation>
    </standOff>
