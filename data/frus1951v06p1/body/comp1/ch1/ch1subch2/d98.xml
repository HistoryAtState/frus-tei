    <text>
        <body>
            <div xml:id="d98">

                <pb facs="0256" n="238" sameAs="frus:frus1951v06p1/pg238"/>

                <note rend="inline" type="source">796.5/851</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of Defense</hi> (<hi
                        rendition="#italic">Lovett</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1951-08-08">August 8, 1951</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Secretary</hi>: In view of the urgency of
                    the US-Philippine Security Treaty, I am transmitting immediately for your
                    information and consideration the views of the Joint Chiefs of Staff. These are
                    in response to your letter of 2 August 1951<anchor n="1" xml:id="d98-f1"/> and
                    have already been informally presented to you and to Mr. Dulles.</p>
                <p>Faithfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert</hi> A. <hi rendition="#small-caps"
                            >Lovett</hi>
                    </signed>
                </closer>


                <xi:include href="d98-a1.xml" xpointer="d98-a1"/>
            </div>
        </body>
    </text>
