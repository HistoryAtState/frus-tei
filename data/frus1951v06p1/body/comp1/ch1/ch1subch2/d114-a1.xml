                <pb facs="0272" n="254" xml:id="pg254"/>

                <opener>
                    <seg rendition="#center">[Attachment]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">Pacific Council</hi>
                </head>
                <p rendition="#center">(Foreign Ministers or Deputies)</p>
                <p rendition="#center">Meeting at Agreed Times and Places</p>
                <table cols="2" rows="3">
                    <row role="label">
                        <cell rend="padding-left: 1.5em">
                            <hi rendition="#italic">Committee of the Council</hi> Washington</cell>
                        <cell rend="padding-left: 1.5em">
                            <hi rendition="#italic">Military Committee</hi>
                        </cell>
                    </row>
                    <row>
                        <cell rendition="#top #hanging-indent">(Ambassadors for Australia and New
                            Zealand and High-Level Official of Department of State with
                            Representative of OSD and Service
                            Attachés Australia and New Zealand as Advisors.)</cell>
                        <cell rendition="#top #hanging-indent">(U.S. Commander-in-Chief Pacific, and
                            Chairmen Australian and New Zealand Chiefs of Staff Committees or their
                            Deputies.)</cell>
                    </row>
                    <row>
                        <cell rendition="#top #hanging-indent">Meeting at stated intervals or when
                            called on.</cell>
                        <cell rendition="#top #hanging-indent">Meeting at Agreed Times and
                            Places.</cell>
                    </row>
                </table>
            </div>
