    <standOff>
        <listAnnotation>
            <note corresp="#d12-f1" n="1" xml:id="d12-f1-content">
                <p>Master Files of National Security Council documentation, 1947–1961, retired by
                    the Executive Secretariat of the Department of State.</p>
            </note>
            <note corresp="#d12-f2" n="2" xml:id="d12-f2-content">
                <p> NSC 48/2, a report titled “The Position of the United States With Respect to
                    Asia,” December 30, 1949, is printed in <ref target="frus1949v07p2#pg_1215">
