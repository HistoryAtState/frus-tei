    <text>
        <body>
            <div xml:id="d729">

                <pb facs="1348" n="1330" xml:id="pg1330"/>

                <note rend="inline" type="source">794.5621/9–451</note>
                <head>
                    <hi rendition="#italic">The Secretary of Defense</hi> (<hi rendition="#italic"
                        >Marshall</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1951-09-04">September 4,
                        1951</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Secretary</hi>: I am forwarding herewith,
                    for whatever action your Department considers necessary, a photostatic copy of
                    my letter to the President, dated 28 August 1951, concerning the new policy for
                    arming Japanese-manned ships. The President approved this policy on 29 August
                    1951.</p>
                <p>The Joint Chiefs of Staff have been requested to take appropriate action to
                    implement this policy, at the appropriate time.</p>
                <p>Faithfully yours,</p>
                <closer>
                    <signed>G. C. <hi rendition="#small-caps">Marshall</hi>
                    </signed>
                </closer>


                <xi:include href="d729-a1.xml" xpointer="d729-a1"/>
            </div>
