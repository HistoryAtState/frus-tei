    <text>
        <body>
            <div xml:id="d566">

                <pb facs="1037" n="1019" sameAs="frus:frus1951v06p1/pg1019"/>

                <note rend="inline" type="source">Lot 54D423</note>
                <head>
                    <hi rendition="#italic">Memorandum by the Consultant to the Secretary</hi>
                        (<hi rendition="#italic">Dulles</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1951-04-25">April 25, 1951</date>.</dateline>
                </opener>
                <p>I attach herewith a memorandum of the talk I had at the Pentagon this
                    morning.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">John Foster Dulles</hi>
                    </signed>
                </closer>


