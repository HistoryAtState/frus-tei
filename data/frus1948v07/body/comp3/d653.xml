    <text>
        <body>
            <div xml:id="d653">

                <pb facs="0784" n="774" sameAs="frus:frus1948v07/pg774"/>

                <note rend="inline" type="source">693.0031 Tibet/8–648</note>
                <head>
                    <hi rendition="#italic">The Tibetan Cabinet Ministers
                        to President Truman
                    </hi><anchor n="20" xml:id="d653-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Translation]</seg>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: For the welfare of Tibet, the Financial
                    Secretary of the Government of Tibet, Tsepon Shakabpa, with his assistant
                    Khenchung Changkhimpa have been sent to observe the trade conditions regarding
                    imports from India, America, China, and England, and export of wool, Yak’s tail,
                    and fur skins from Tibet and also to purchase gold and silver.</p>
                <p>Kindly recognise them as our trade mission and necessary help in their discussion
                    on trade matters and in purchasing gold and silver, considering the good
                    relation between America and Tibet.</p>
                <closer>
                    <dateline rendition="#float-left">With our customary greeting scarf, dated <date
                            calendar="tibetan-phugpa" when="1947-10-10">26th of the 8th month of
                            Tibetan Fire-Pig year [1947]</date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d653-f1" n="20" type="source" xml:id="d653-f1-content">
                <p>A similar message sent to the Secretary of State, not printed.</p>
            </note>
        </listAnnotation>
    </standOff>
