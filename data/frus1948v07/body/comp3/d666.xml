    <text>
        <body>
            <div xml:id="d666">

                <pb facs="0795" n="785" sameAs="frus:frus1948v07/pg785"/>

                <note rend="inline" type="source">811.001 Truman, H. S./8–2748</note>
                <head>
                    <hi rendition="#italic">The Acting Chief of Protocol</hi> (<hi rendition="#italic">Muir</hi>) <hi rendition="#italic"
                        >to the Leader of the Tibetan Trade Mission</hi> (<hi
                            rendition="#italic">Shakabpa</hi>), <hi rendition="#italic"
                        >in New York</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1948-09-07">September 7,
                        1948</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Shakabpa</hi>: At the direction of the
                    President I am forwarding herewith for His Holiness the Dalai Lama an
                    autographed photograph of the President.</p>
                <p>It is requested that you present this photograph to His Holiness with the good
                    wishes of the President upon your return to Tibet.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>R. D. <hi rendition="#small-caps">Muir</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
