            <div xml:id="d689">

                <pb facs="0806" n="796" sameAs="frus:frus1948v07/pg796"/>

                <note rend="inline" type="source">125.3516/8–3148: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Consul at
                        Dairen</hi> (<hi rendition="#italic">Paddock</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1948-10-12T13:00:00-05:00">October 12, 1948—1
                            p. m.</date>
                    </dateline>
                </opener>
                <p>62. Neither at Secty press conference Aug 25 nor Dept spokesman conference
                    succeeding days was possibility closing Consulate Dairen discussed (Dairen
                    unnumbered Aug 31 rptd Nanking 38).</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lovett</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
