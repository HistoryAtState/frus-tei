            <div xml:id="d681">

                <pb facs="0802" n="792" sameAs="frus:frus1948v07/pg792"/>

                <note rend="inline" type="source">125.3516/9–2048: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the Soviet Union</hi> (<hi
                        rendition="#italic">Smith</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Moscow</hi></placeName>, <date
                            calendar="gregorian" when="1948-09-20T19:00:00+03:00">September 20,
                            1948—7 p. m.</date>
                        <lb/> [Received September 21—5:59 a. m.]</dateline>
                </opener>
                <p>2057. Have complied instruction second paragraph Deptel 1137, September 17,
                    repeated Nanking 1334, Shanghai 1634, Dairen 55. Will advise developments.</p>
                <p>Sent Dept 2057, Dept pass Nanking 27, Shanghai 30, Dairen 18.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Smith</hi>
                    </signed>
                </closer>
            </div>
        </body>
