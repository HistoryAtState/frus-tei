    <text>
        <body>
            <div xml:id="d766">

                <pb facs="0855" n="845" sameAs="frus:frus1948v07/pg845"/>

                <note rend="inline" type="source">125.6336/12–948: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Ambassador in the Soviet Union</hi> (<hi
                            rendition="#italic">Smith</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1948-12-13T19:00:00-05:00">December 13,
                            1948—7 p. m.</date>
                    </dateline>
                </opener>
                <p>1388. In your discretion pls use subject matter Dairen’s 97, Dec 9,<anchor n="66"
                        xml:id="d766-f1"/> as basis for request Sov FonOff for according of such
                    facilities as would give us such a temporary means of communication with ConGen
                    Mukden.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lovett</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d766-f1" n="66" xml:id="d766-f1-content">
                <p>Sent to the Department as telegram No. 230, <ref target="#pg844">p.
                    844</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
