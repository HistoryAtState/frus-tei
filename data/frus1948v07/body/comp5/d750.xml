    <text>
        <body>
            <div xml:id="d750">

                <pb facs="0847" n="837" sameAs="frus:frus1948v07/pg837"/>

                <note rend="inline" type="source">125.6336/11–1848: Telegram</note>
                <head>
                    <hi rendition="#italic">The Consul General at Shanghai</hi> (<hi
                        rendition="#italic">Cabot</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Shanghai</hi></placeName>, <date
                            calendar="gregorian" when="1948-11-18T17:00:00+08:00">November 18,
                            1948—5 p. m.</date>
                        <lb/> [Received November 18—5:13 a. m.]</dateline>
                </opener>
                <p>2465. ReDeptel 1938 repeated Nanking 1635.<anchor n="52" xml:id="d750-f1"/>
                    Mukden radio transmitter seized today. Mukden notified monitor newscast
                    frequencies and will follow same procedure as Dairen traffic.</p>
                <p>Sent Department 2465; repeated Nanking 1864.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Cabot</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d750-f1" n="52" xml:id="d750-f1-content">
                <p>November 16, 6 p. m., above.</p>
