    <text>
        <body>
            <div xml:id="d614">

                <pb facs="0753" n="743" sameAs="frus:frus1948v07/pg743"/>

                <note rend="inline" type="source">893.796/9–348: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in China</hi>
                        (<hi rendition="#italic">Stuart</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1948-09-03T18:00:00-04:00">September 3,
                            1948—6 p. m.</date>
                    </dateline>
                </opener>
                <p>1269. Request verification press reports Hollington Tong<anchor n="34"
                        xml:id="d614-f1"/> officially announced China notified USSR desire terminate
                    Sino-Soviet Agreement Hami-Alma Ata airline.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Marshall</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d614-f1" n="34" xml:id="d614-f1-content">
                <p>Director of the Chinese Government Information Office.</p>
            </note>
        </listAnnotation>
    </standOff>
