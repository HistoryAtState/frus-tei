    <text>
        <body>
            <div xml:id="d609">

                <pb facs="0750" n="740" xml:id="pg740"/>

                <note rend="inline" type="source">893.796/8–1248: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in China</hi>
                        (<hi rendition="#italic">Stuart</hi>)<anchor n="25" xml:id="d609-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1948-08-27T19:00:00-04:00">August 27, 1948—7
                            p. m.</date>
                    </dateline>
                </opener>
                <p>1239. Your 1489, Aug 12 and Tihwa’s 159, Aug 26 to Emb.<anchor n="26"
                        xml:id="d609-f2"/> Providing Emb concurs Dept authorizes Emb inform
                    Tungling, FonOff director American Affairs, orally Dept gratified hear ChiGovt
                    has given USSR notice intention terminate agreement.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Marshall</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d609-f1" n="25" type="source" xml:id="d609-f1-content">
                <p>Repeated to the Consul at Tihwa as No. 32.</p>
            </note>
            <note corresp="#d609-f2" n="26" xml:id="d609-f2-content">
                <p>For the latter, see telegram No. 81, <hi rendition="#italic">supra</hi>.</p>
            </note>
        </listAnnotation>
    </standOff>
