            <div xml:id="d435">

                <pb facs="0549" n="539" sameAs="frus:frus1948v07/pg539"/>

                <note rend="inline" type="source">811.20200(D)/10–2748: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        China</hi> (<hi rendition="#italic">Stuart</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1948-11-04T16:00:00-05:00">November 4, 1948—4
                            p. m.</date>
                    </dateline>
                </opener>
                <p>1545. Carefully considering urtel 2015 Oct. 27. Attempting increase immediately
                    present output materials needed expose threat international communism to China.
                    Pending full reply following soon, continue regular program.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lovett</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
