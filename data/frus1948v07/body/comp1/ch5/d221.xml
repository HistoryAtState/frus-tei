    <text>
        <body>
            <div xml:id="d221">

                <pb facs="0288" n="278" sameAs="frus:frus1948v07/pg278"/>

                <note rend="inline" type="source">893.00/6–548: Telegram</note>
                <head>
                    <hi rendition="#italic">The Consul at Tientsin</hi> (<hi rendition="#italic"
                        >Hinke</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Tientsin</hi></placeName>, <date
                            calendar="gregorian" when="1948-06-05">June 5,
                        1948</date>.<lb/>[Received June 5—8:56 a. m.]</dateline>
                </opener>
                <p>156. Peiyang University students engaged in 3-day strike against US support to
                    Japan as result petition signed by majority student body.</p>
                <pb facs="0289" n="279" xml:id="pg279"/>
                <p>Sent Nanking as 306, repeated Department as 156, Shanghai as 262 and Peiping.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hinke</hi>
                    </signed>
                </closer>
            </div>
        </body>
