    <text>
        <body>
            <div xml:id="d574">

                <pb facs="0700" n="690" xml:id="pg690"/>

                <note rend="inline" type="source">893.00/12–2848: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in China</hi> (<hi
                            rendition="#italic">Stuart</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Nanking</hi></placeName>, <date
                            calendar="gregorian" when="1948-12-28T11:00:00+08:00">December 28,
                            1948—11 a. m.</date>
                        <lb/> [Received December 28—2:47 a. m.]</dateline>
                </opener>
                <p>2632. [To Shanghai:] Suggestion of Carsun Chang contained urtel 2169, December
                    26, 5 p. m.<anchor n="76" xml:id="d574-f1"/> appreciated. However, Chang Chun
                    has access to Ambassador and other Embassy officers here and trip to Shanghai
                    for this purpose unnecessary.</p>
                <p>Sent Shanghai 1316, repeated Department.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stuart</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d574-f1" n="76" xml:id="d574-f1-content">
                <p>Repeated to the Department as telegram No. 2891, <ref target="#pg687">p.
                        687</ref>.</p>
            </note>
        </listAnnotation>
