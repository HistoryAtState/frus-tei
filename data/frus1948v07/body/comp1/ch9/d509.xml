    <text>
        <body>
            <div xml:id="d509">

                <pb facs="0634" n="624" sameAs="frus:frus1948v07/pg624"/>

                <note rend="inline" type="source">893.00/12–148: Telegram</note>
                <head>
                    <hi rendition="#italic">The Consul General at Shanghai</hi> (<hi
                        rendition="#italic">Cabot</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Shanghai</hi></placeName>, <date
                            calendar="gregorian" when="1948-12-01T13:00:00+08:00">December 1, 1948—1
                            p. m.</date>
                        <lb/> [Received December 1—8:15 a. m.]</dateline>
                </opener>
                <p>2585. Remytel 2449, November 17,<anchor n="79" xml:id="d509-f1"/> repeated
                    Nanking 1855, Taipei 133. Local Chinese source very intimately connected Madame
                    Wei Tao-ming<anchor n="80" xml:id="d509-f2"/> states Taiwan as place of refuge
                    for Chinese untenable as it is anticipated Taiwan uprising will follow
                    disintegration central Government.</p>
                <p>Sent Dept 2585, pouched Nanking 1951, Taipei 138.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Cabot</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d509-f1" n="79" xml:id="d509-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d509-f2" n="80" xml:id="d509-f2-content">
                <p>Wife of the Governor of Taiwan.</p>
            </note>
        </listAnnotation>
    </standOff>
