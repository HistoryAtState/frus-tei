            <div xml:id="d507">

                <pb facs="0633" n="623" sameAs="frus:frus1948v07/pg623"/>

                <note rend="inline" type="source">893.00/11–3048: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Consul General at
                        Tsingtao</hi> (<hi rendition="#italic">Turner</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1948-11-30T18:00:00-05:00">November 30,
                            1948—6 p. m.</date>
                    </dateline>
                </opener>
                <p>173. Dept understands Chinese press reports govt forces Tsingtao attacking
                    Communists Chiaohsien area. Request info reported operations.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Marshall</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
