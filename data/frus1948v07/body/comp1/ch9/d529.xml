    <text>
        <body>
            <div xml:id="d529">

                <pb facs="0650" n="640" sameAs="frus:frus1948v07/pg640"/>

                <note rend="inline" type="source">893.00/12–1348: Telegram</note>
                <head>
                    <hi rendition="#italic">The Consul General at Shanghai</hi> (<hi
                        rendition="#italic">Cabot</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Shanghai</hi></placeName>, <date
                            calendar="gregorian" when="1948-12-13T22:00:00+08:00">December 13,
                            1948—10 p. m.</date>
                        <lb/> [Received December 12—10:59 p. m.]</dateline>
                </opener>
                <p>2740. CAT<anchor n="12" xml:id="d529-f1"/> pilot arriving Shanghai 4 a. m.
                    December 13 states all airfields Peiping closed last night. Traffic on Tientsin
                    extremely heavy. CAF reported evacuating Peiping.</p>
                <p>Sent Department 2740, repeated Nanking 2055, Peiping 268.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Cabot</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d529-f1" n="12" xml:id="d529-f1-content">
                <p>Chinese Air Transport.</p>
