    <text>
        <body>
            <div xml:id="d523">

                <pb facs="0647" n="637" sameAs="frus:frus1948v07/pg637"/>

                <note rend="inline" type="source">893.002/12–1048: Telegram</note>
                <head>
                    <hi rendition="#italic">The Consul General at Shanghai</hi> (<hi
                        rendition="#italic">Cabot</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Shanghai</hi></placeName>, <date
                            calendar="gregorian" when="1948-12-10">December 10,
                        1948</date>.<lb/>[Received December 12—11:07 p. m.]</dateline>
                </opener>
                <p>2742. <hi rendition="#italic">China Press</hi> reports that General Chang
                    Chih-chung promised join Sun Fo’s Cabinet. Hu Shih reported new Foreign Minister
                    choice, and Liu Wei-chih<anchor n="10" xml:id="d523-f1"/> also slated for new
                    position.</p>
                <p>Sent Nanking 2056, repeated to Department 2742.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Cabot</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d523-f1" n="10" xml:id="d523-f1-content">
                <p>Chairman of the Overseas Chinese Affairs Commission.</p>
            </note>
        </listAnnotation>
    </standOff>
