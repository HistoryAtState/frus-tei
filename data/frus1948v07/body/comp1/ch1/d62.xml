                <pb facs="0094" n="84" sameAs="frus:frus1948v07/pg84"/>

                <note rend="inline" type="source">893.00/1–348: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in China</hi> (<hi rendition="#italic"
                            >Stuart</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1948-02-06T20:00:00-05:00">February 6, 1948—8
                            p. m.</date>
                    </dateline>
                </opener>
                <p>201. Please submit your comments and recommendations with respect suggestions
                    contained Peiping despatch to Emb 2 January 3 that US consular officer visit
                    Communist areas north China on intelligence mission.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Marshall</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
