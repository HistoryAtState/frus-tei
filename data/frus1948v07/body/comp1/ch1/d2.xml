    <text>
        <body>
            <div xml:id="d2">

                <pb facs="0014" n="4" sameAs="frus:frus1948v07/pg4"/>

                <note rend="inline" type="source">893.113/12–3147: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Ambassador in China</hi> (<hi rendition="#italic"
                            >Stuart</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1947-12-31T18:00:00-05:00">December 31,
                            1947—6 p. m.</date>
                    </dateline>
                </opener>
                <p>1594. Nov 30 issue <hi rendition="#italic">Monthly Report</hi> published by
                    Millard Publishing Co carries story ChiGovt after capture Chefoo found large
                    supplies US arms ammo reportedly obtained by Communists from National Govt
                    sources through arms ring. Emb requested report any info obtainable this
                    story.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lovett</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
