            </note>
            <note corresp="#d441-f2" n="40" xml:id="d441-f2-content">
                <p>Joint U. S. Military Advisory Group.</p>
            </note>
            <note corresp="#d441-f3" n="41" xml:id="d441-f3-content">
                <p>Commander in Chief of the North China Bandit Suppression Forces.</p>
            </note>
            <note corresp="#d441-f4" n="42" xml:id="d441-f4-content">
                <p>Commander of the Chinese Communist armies in Central China.</p>
            </note>
            <note corresp="#d441-f5" n="43" xml:id="d441-f5-content">
                <p>Paul G. Hoffman, Administrator of the Economic Cooperation Administration.</p>
            </note>
        </listAnnotation>
