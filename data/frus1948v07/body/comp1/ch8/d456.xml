            <div xml:id="d456">

                <pb facs="0571" n="561" xml:id="pg561"/>

                <note rend="inline" type="source">893.00/11–1148: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in China</hi> (<hi rendition="#italic"
                        >Stuart</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Nanking</hi></placeName>, <date
                            calendar="gregorian" when="1948-11-11">November 11,
                        1948</date>.<lb/>[Received November 11—4:44 a. m.]</dateline>
                </opener>
                <p>2174. Nanking Defense Command informs Military Attaché that martial law declared
                    at midnight November 10 in area bounded roughly by Hangchow, Shanghai, Pangfou
                        [<hi rendition="#italic">Pengpu?</hi>], Anking, Wuhu and Nanking. Nightly
                    curfew 2300 hours to 0600 hours.</p>
                <p>Sent Department 2174; repeated Shanghai 1078.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stuart</hi>
                    </signed>
                </closer>
            </div>
        </body>
