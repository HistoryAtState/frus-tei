    <text>
        <body>
            <div xml:id="d143">

                <pb facs="0244" n="142" sameAs="frus:frus1935v01/pg142"/>

                <note rend="inline" type="source">500.A15A5/531: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Ambassador in the United Kingdom</hi> (<hi
                            rendition="#italic">Bingham</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1935-11-06T17:00:00-05:00">November 6, 1935—5
                            p.m.</date>
                    </dateline>
                </opener>
                <p>327. Your 555, November 6, 10 a.m.</p>
                <list>
                    <label>(1)</label>
                    <item>We interpose no objection to the British Government’s inviting a League
                        observer to the Naval Conference in the same manner and under the same
                        conditions as in 1930.</item>
                    <label>(2)</label>
                    <item>You are authorized formally to inform the British Government that the
                        Government of the United States accepts the invitation to the Naval
                        Conference.</item>
                </list>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Phillips</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
