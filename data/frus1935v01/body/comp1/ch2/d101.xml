    <text>
        <body>
            <div xml:id="d101">

                <pb facs="0197" n="95" sameAs="frus:frus1935v01/pg95"/>

                <note rend="inline" type="source">500.A15A5/478</note>
                <head>
                    <hi rendition="#italic">The Chargé in France</hi> (<hi rendition="#italic"
                        >Marriner</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 2104</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1935-08-20">August 20,
                        1935</date>.<lb/>[Received August 30.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to confirm my telegram
                    No. 717, August 20, 5 P.M.,<anchor n="53" xml:id="d101-f1"/> quoting the
                    pertinent paragraphs of the French reply to the British memorandum of August 2,
                        1935,<anchor n="54" xml:id="d101-f2"/> relative to naval construction, and
                    to forward herewith a copy and translation of the reply together with the
                    transmitting note from the Foreign Office,<anchor n="55" xml:id="d101-f3"/> also
                    in translation.</p>
                <p>Respectfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Theodore Marriner</hi>
                    </signed>
                </closer>


                <xi:include href="d101-a1.xml" xpointer="d101-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d101-f1" n="53" xml:id="d101-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d101-f2" n="54" xml:id="d101-f2-content">
                <p>The British memorandum is quoted in telegram No. 359, August 9, 7 p.m., from the
                    Chargé in the United Kingdom, <ref target="#pg87">p. 87</ref>.</p>
            </note>
            <note corresp="#d101-f3" n="55" xml:id="d101-f3-content">
                <p>Latter not printed.</p>
            </note>
        </listAnnotation>
    </standOff>
