                <pb facs="0205" n="103" sameAs="frus:frus1935v01/pg103"/>

                <note rend="inline" type="source">500.A15A5/473: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Chargé in the United
                        Kingdom</hi> (<hi rendition="#italic">Atherton</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1935-08-27T14:00:00-04:00">August 27, 1935—2
                            p.m.</date>
                    </dateline>
                </opener>
                <p>230. Your 407, August 27, noon, is eminently satisfactory to us. We approve your
                    not making the suggestions contained in the last sentence of our instructions
                    and authorize you to bring them up in your discretion if and when the occasion
                    calls for this.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
