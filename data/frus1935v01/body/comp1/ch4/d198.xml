    <text>
        <body>
            <div xml:id="d198">

                <pb facs="0350" n="248" sameAs="frus:frus1935v01/pg248"/>

                <note rend="inline" type="source">862.20/998</note>
                <head>
                    <hi rendition="#italic">The Acting Chairman of the American Delegation to the
                        Disarmament Conference</hi> (<hi rendition="#italic">Wilson</hi>) <hi
                        rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 113</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Geneva</hi></placeName>, <date
                            calendar="gregorian" when="1935-04-17">April 17,
                        1935</date>.<lb/>[Received May 3.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Supplementing my telegram No. 1038, April
                    17, 6 p.m.,<anchor n="97" xml:id="d198-f1"/> I have the honor to transmit
                    herewith the complete memorandum of my conversation with Sir John Simon, which
                    was summarized in the telegram under reference.</p>
                <p>Respectfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hugh R. Wilson</hi>
                    </signed>
                </closer>



                <xi:include href="d198-a1.xml" xpointer="d198-a1"/>
            </div>
        </body>
    </text>
