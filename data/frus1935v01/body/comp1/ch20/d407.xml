    <text>
        <body>
            <div xml:id="d407">

                <pb facs="0625" n="523" sameAs="frus:frus1935v01/pg523"/>

                <note rend="inline" type="source">500.C111/887: Telegram</note>
                <head>
                    <hi rendition="#italic">The Consul at Geneva</hi> (<hi rendition="#italic"
                        >Gilbert</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Geneva</hi></placeName>, <date
                            calendar="gregorian" when="1935-09-28T14:00:00+01:00">September 28,
                            1935—2 p.m.</date>
                        <lb/> [Received September 28—1:45 p.m.]</dateline>
                </opener>
                <p>391. My 380, September 26, 4 p.m.<anchor n="4" xml:id="d407-f1"/> The report and
                    resolutions of the Second Committee were adopted by the Assembly without
                    discussion today.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Gilbert</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
