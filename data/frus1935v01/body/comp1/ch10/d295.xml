    <text>
        <body>
            <div xml:id="d295">

                <pb facs="0516" n="414" sameAs="frus:frus1935v01/pg414"/>

                <note rend="inline" type="source">811.114 St. Pierre-Miquelon/207: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic"
                        >Straus</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1935-04-17T12:00:00+01:00">April 17,
                            1935—noon</date>.<lb/>[Received April 17—5:34 a.m.]</dateline>
                </opener>
                <p>344. <hi rendition="#italic">Journal Officiel</hi> of April 14 carried a decree
                    containing among others the three provisions enumerated in the Department’s No.
                    118, April 4, 6 p.m.,<anchor n="38" xml:id="d295-f1"/> in regard to suppressing
                    illicit alcohol trade from St. Pierre-Miquelon. Text of decree by mail.<anchor
                        n="39" xml:id="d295-f2"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Straus</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d295-f1" n="38" xml:id="d295-f1-content">
                <p>Not printed; for the provisions in question, subsequently embodied in the decree
                    of April 9, 1935, see note of March 15 from the French Embassy, <ref
                        target="#pg412">p. 412</ref>.</p>
            </note>
            <note corresp="#d295-f2" n="39" xml:id="d295-f2-content">
                <p>Despatch No. 1803, April 17, not printed.</p>
            </note>
        </listAnnotation>
    </standOff>
