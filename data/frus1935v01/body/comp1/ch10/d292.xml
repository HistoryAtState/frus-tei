    <text>
        <body>
            <div xml:id="d292">

                <pb facs="0513" n="411" sameAs="frus:frus1935v01/pg411"/>

                <note rend="inline" type="source">811.114 Newfoundland/1215</note>
                <head>
                    <hi rendition="#italic">The Counselor of the British Embassy</hi> (<hi rendition="#italic">Osborne</hi>) <hi
                        rendition="#italic">to the Secretary of the Treasury</hi> (<hi rendition="#italic">Morgenthau</hi>)<anchor n="34"
                        xml:id="d292-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1935-02-25">25 February,
                        1935</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Secretary</hi>: I am pleased to be able to
                    inform you that we are now authorized to advise you that action is being taken
                    by the Government of Newfoundland which will ensure: (<hi rendition="#italic"
                        >a</hi>) that clearance for “the high seas” with exports of liquor be
                    prohibited, (<hi rendition="#italic">b</hi>) that no liquor may be exported from
                    St. John’s in a vessel of less than 200 tons (this prohibition already applies
                    in regard to other Newfoundland ports), and (<hi rendition="#italic">c</hi>)
                    that a bond be required in respect of liquor exported from, or transshipped in,
                    Newfoundland, whether in the case of St. John’s or other ports of
                    Newfoundland.</p>
                <p>Believe me [etc.]</p>
                <closer>
                    <signed>D. G. <hi rendition="#small-caps">Osborne</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d292-f1" n="34" type="source" xml:id="d292-f1-content">
                <p>Copy transmitted to the Department of State by the British Embassy.</p>
