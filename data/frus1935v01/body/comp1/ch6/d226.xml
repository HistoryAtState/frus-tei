    <text>
        <body>
            <div xml:id="d226">

                <pb facs="0418" n="316" sameAs="frus:frus1935v01/pg316"/>

                <note rend="inline" type="source">811.113/582</note>
                <head>
                    <hi rendition="#italic">Memorandum by President Roosevelt for the Secretary of
                        State</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1935-02-23">February 23,
                        1935</date>.</dateline>
                </opener>
                <p>After you get back will you speak with me about the advisability of a message on
                    war profits and kindred subjects. I enclose a memorandum, but I do not know who
                    it is from.<anchor n="1" xml:id="d226-f1"/>
                </p>
                <closer>
                    <signed>F[<hi rendition="#small-caps">ranklin</hi>] D. R[<hi
                            rendition="#small-caps">oosevelt</hi>]</signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d226-f1" n="1" xml:id="d226-f1-content">
                <p>Undated memorandum by Bernard M. Baruch, not printed.</p>
            </note>
        </listAnnotation>
    </standOff>
