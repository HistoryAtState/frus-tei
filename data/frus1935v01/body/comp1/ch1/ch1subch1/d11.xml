    <text>
        <body>
            <div xml:id="d11">

                <pb facs="0112" n="10" sameAs="frus:frus1935v01/pg10"/>

                <note rend="inline" type="source">500.A15A4 Permanent Disarmament Commission/89:
                    Telegram</note>
                <head>
                    <hi rendition="#italic">The American Delegate</hi> (<hi
                            rendition="#italic">Wilson</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Geneva</hi></placeName>, <date
                            calendar="gregorian" when="1935-02-02T11:00:00+01:00">February 2,
                            1935—11 a.m.</date>
                        <lb/> [Received February 2—8:22 a.m.]</dateline>
                </opener>
                <p>971. Convocations have been issued for a meeting of the Committee on
                    Miscellaneous Provisions (Bourquin<anchor n="29" xml:id="d11-f1"/> Committee) to
                    be held on February 18th. The agenda consists of the examination of the
                    questions referred to this Committee by the Chinese Minister [<hi
                        rendition="#italic">Conference Bureau?</hi>] on November 20th<anchor n="30"
                        xml:id="d11-f2"/> which include the draft articles submitted by the American
                    Delegation and the Soviet proposal for a permanent peace conference.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wilson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d11-f1" n="29" xml:id="d11-f1-content">
                <p>Maurice Bourquin, Belgian delegate to the General Disarmament Conference.</p>
            </note>
            <note corresp="#d11-f2" n="30" xml:id="d11-f2-content">
                <p>
                    <hi rendition="#italic">Preliminary Report on the Work of the Conference</hi>
                    (Conf. D. 171 (1)), p. 137.</p>
            </note>
        </listAnnotation>
    </standOff>
