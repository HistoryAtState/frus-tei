                <pb facs="0143" n="41" sameAs="frus:frus1935v01/pg41"/>

                <note rend="inline" type="source">500.A15A4 General Committee (Arms)/186:
                    Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the American Delegate</hi>
                        (<hi rendition="#italic">Wilson</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1935-03-30T12:00:00-05:00">March 30,
                            1935—noon</date>.</dateline>
                </opener>
                <p>493. Your No. 1028, March 29, 10 a.m. We entirely approve of the position you
                    have assumed.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
