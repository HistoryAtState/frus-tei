    <text>
        <body>
            <div xml:id="d379">

                <pb facs="0598" n="496" sameAs="frus:frus1935v01/pg496"/>

                <note rend="inline" type="source">548.F1/19</note>
                <head>
                    <hi rendition="#italic">The Minister in Switzerland</hi> (<hi rendition="#italic">Wilson</hi>) <hi rendition="#italic"
                        >to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 3970</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Bern</hi></placeName>, <date
                            calendar="gregorian" when="1935-07-22">July 22,
                        1935</date>.<lb/>[Received July 30.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith
                    Circular Letter No. 111 addressed to you on July 19, 1935 by the Secretary
                    General of the League of Nations, requesting information regarding the
                    possibility of settling refugees in the United States. Any information which the
                    Secretary General receives will be transmitted to the Nansen International
                    Office.</p>
                <p>Respectfully yours,</p>
                <closer>For the Minister: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Stanley Hawks</hi>
                    </signed>
                    <lb/>
                    <hi rendition="#italic">Secretary of Legation</hi>
                </closer>


                <xi:include href="d379-a1.xml" xpointer="d379-a1"/>
            </div>
        </body>
    </text>
