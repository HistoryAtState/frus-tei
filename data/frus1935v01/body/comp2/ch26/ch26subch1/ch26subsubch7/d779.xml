            <div xml:id="d779">

                <pb facs="0996" n="894" xml:id="pg894"/>

                <note rend="inline" type="source">765.84/1761: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Italy</hi>
                        (<hi rendition="#italic">Long</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1935-10-12T14:00:00-05:00">October 12, 1935—2
                            p.m.</date>
                    </dateline>
                </opener>
                <p>170. Your 697, October 12, 1 p.m. You may make on humanitarian grounds oral
                    representations similar to but not exceeding those made by your colleagues.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
