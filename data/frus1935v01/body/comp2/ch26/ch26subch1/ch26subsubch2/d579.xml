    <text>
        <body>
            <div xml:id="d579">

                <pb facs="0811" n="709" sameAs="frus:frus1935v01/pg709"/>

                <note rend="inline" type="source">765.84/3049: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in Ethiopia</hi> (<hi
                            rendition="#italic">Engert</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Addis Ababa</hi></placeName>, <date
                            calendar="gregorian" when="1935-12-13T12:00:00+02:35">December 13,
                            1935—noon</date>.<lb/>[Received 2:55 p.m.]</dateline>
                </opener>
                <p>225. Anglo-French proposals were submitted this morning and will be forwarded to
                    the Emperor at Dessie by plane. Precise terms not yet known here.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Engert</hi>
                    </signed>
                </closer>
            </div>
        </body>
