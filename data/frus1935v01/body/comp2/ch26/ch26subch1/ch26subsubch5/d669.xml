    <text>
        <body>
            <div xml:id="d669">

                <pb facs="0896" n="794" xml:id="pg794"/>

                <note rend="inline" type="source">765.84/1556: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the United Kingdom</hi> (<hi rendition="#italic">Bingham</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1935-10-04T16:00:00+01:00">October 4, 1935—4
                            p.m.</date>
                        <lb/> [Received October 4—11:10 a.m.]</dateline>
                </opener>
                <p>493. My 492, October 4, noon. His Majesty’s Government do not consider a state of
                    war exists. They have promised to keep in touch with me on this question.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bingham</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
