            <div xml:id="d677">

                <pb facs="0900" n="798" sameAs="frus:frus1935v01/pg798"/>

                <note rend="inline" type="source">711.00111 Armament Control/65: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to President Roosevelt </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1935-10-05T18:20:00-05:00">October 5,
                            1935—6:20 p.m.</date>
                    </dateline>
                </opener>
                <p>Your message authorizing immediate action received. I am preparing to act tonight
                    but awaiting any possible further comment or suggestions in reply to my long 3
                    section message of this afternoon.<anchor n="13" xml:id="d677-f1"/> If no
                    message received from you, will act tonight.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
