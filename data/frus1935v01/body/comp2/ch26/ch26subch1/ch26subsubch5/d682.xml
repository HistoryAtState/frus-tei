                <pb facs="0903" n="801" sameAs="frus:frus1935v01/pg801"/>

                <note rend="inline" type="source">711.00111 Armament Control/67c: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Italy</hi> (<hi rendition="#italic"
                            >Long</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1935-10-06T12:00:00-05:00">October 6,
                            1935—noon</date>.</dateline>
                </opener>
                <p>161. Suggest you take any precautionary measures you may consider appropriate for
                    the protection of American citizens in case of reaction by Italians against
                    President’s Proclamation of Arms Embargo and travel on belligerent ships.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
