    <text>
        <body>
            <div xml:id="d611">

                <pb facs="0835" n="733" sameAs="frus:frus1935v01/pg733"/>

                <note rend="inline" type="source">765.84/697: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in the United Kingdom</hi> (<hi rendition="#italic">Atherton</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1935-08-01T11:00:00+01:00">August 1, 1935—11
                            a.m.</date>
                        <lb/> [Received August 1—6:11 a.m.]</dateline>
                </opener>
                <p>349. Foreign Office expresses appreciation for advance information contained in
                    your 198, July 31, 11 p.m., and knows of no reason for delaying
                        statement.<anchor n="51" xml:id="d611-f1"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Atherton</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d611-f1" n="51" xml:id="d611-f1-content">
                <p>Statement was issued to the press by the President on August 1 at 11:30 a.m.; see
                    Department of State, <hi rendition="#italic">Press Releases</hi>, August 10,
                    1935, p. 119.</p>
            </note>
        </listAnnotation>
    </standOff>
