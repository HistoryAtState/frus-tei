                        </cell>
                        <cell role="num">8,376</cell>
                    </row>
                    <row>
                        <cell>Other drugs (5%–10%)</cell>
                        <cell role="num">4,267</cell>
                    </row>
                    <row>
                        <cell>Chemical products of all kinds (10%–30%)</cell>
                        <cell role="num">4,232</cell>
                    </row>
                    <row>
                        <cell>Nails, screws, rivets, etc. (5%–12%)</cell>
                        <cell role="num">3,663</cell>
                    </row>
                    <row>
                        <cell>Cotton cloth of all kinds<anchor n="*" xml:id="d801-f7"/>
                        </cell>
