        <body>
            <div xml:id="toc">

                <pb facs="0007" n="III" xml:id="pgIII"/>

                <head>Contents</head>
                <list type="toc">
                    <item>
                        <ref target="#pgIX">
                            <hi rendition="#small-caps">List of Papers</hi>
                        </ref>
                    </item>
                    <item>
                        <hi rendition="#small-caps">The British Commonwealth of Nations</hi>: <list>
                            <item>
                                <hi rendition="#small-caps">Great Britain</hi>: <list>
                                    <item>
                                        <ref target="#pg1">Applicability of Imperial tariff
                                            preference to grain shipped from Canada through the
                                            United States to the United Kingdom</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg11">Proposed supplementary convention
                                            between the United States and Great Britain regarding
                                            tenure and disposition of real and personal
                                            property</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg17">Indefinite postponement of negotiations
                                            for a treaty of arbitration between the United States
                                            and Great Britain</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg19">Citizenship status of adopted child
                                            whose father has acquired American citizenship by
                                            naturalization</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg23">Exchange of notes regarding reporting by
                                            American and British consular officers to tax
                                            authorities of the compensation received by native
                                            employees</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg29">Assessment of certain taxes by the
                                            British Government against American consular officers in
                                            the United Kingdom</ref>
                                    </item>
                                </list>
                            </item>
                            <item>
                                <hi rendition="#small-caps">Canada</hi>: <list>
                                    <item>
                                        <ref target="#pg37">Preliminary discussions respecting a
                                            trade agreement between the United States and
                                            Canada</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg52">Continued negotiations with the Canadian
                                            Government regarding damages to property in the State of
                                            Washington by fumes from the smelter at Trail, B.
                                            C.</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg67">Representations regarding the seizure of
                                            American salmon trollers <hi rendition="#italic">May,
                                                Queen City, Sunrise</hi>, and <hi
                                                rendition="#italic">Tillie M</hi>. by the Canadian
                                            vessel <hi rendition="#italic">Rividus</hi>
                                        </ref>
                                    </item>
                                    <item>
                                        <ref target="#pg79">Representations regarding treatment of
                                            an American citizen in a Canadian prison and right of
                                            consular officers to visit their nationals in
                                            prison</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg92">Agreement between the United States and
                                            Canada for the dredging of certain shoal areas in the
                                            St. Clair River</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg98">Agreement concerning the diversion of
                                            water through the Massena Canal and Grass River as
                                            affected by provisions of the St. Lawrence Deep Waterway
                                            Treaty, effected by exchange of notes, January 13,
                                            1933</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg100">Agreement concerning the Chicago
                                            diversion of water as affected by provisions of the St.
                                            Lawrence Deep Waterway Treaty, effected by exchange of
                                            notes, April 5, 1933</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg102">Load line convention between the United
                                            States and Canada, signed December 9, 1933</ref>
                                    </item>
                                    <pb facs="0008" n="IV" xml:id="pgIV"/>
                                    <item>
                                        <ref target="#pg104">Effect upon American citizenship of
                                            oaths required of aliens who teach in Canadian
                                            schools</ref>
                                    </item>
                                </list>
                            </item>
                            <item>
                                <hi rendition="#small-caps">Irish Free State</hi>: <list>
                                    <item>
                                        <ref target="#pg107">Representations by the Irish Free State
                                            concerning the allotment given to the importation into
                                            the United States of Irish whiskey</ref>
                                    </item>
                                </list>
                            </item>
                            <item>
                                <hi rendition="#small-caps">New Zealand</hi>: <list>
                                    <item>
                                        <ref target="#pg110">Preliminary discussions regarding
                                            possible negotiation of a trade agreement between the
                                            United States and New Zealand</ref>
                                    </item>
                                </list>
                            </item>
                            <item>
                                <hi rendition="#small-caps">Union of South Africa</hi>: <list>
                                    <item>
                                        <ref target="#pg123">Arrangement between the United States
                                            and the Union of South Africa for air navigation,
                                            effected by exchange of notes signed March 17, 1933, and
                                            September 20, 1933</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg128">Arrangement between the United States
                                            and the Union of South Africa for pilot licenses to
                                            operate civil aircraft, effected by exchange of notes
                                            signed March 17, 1933, and September 20, 1933</ref>
                                    </item>
                                </list>
                            </item>
                        </list>
                    </item>
                    <item>
                        <hi rendition="#small-caps">Europe</hi>: <list>
                            <item>
                                <hi rendition="#small-caps">Albania</hi>: <list>
                                    <item>
                                        <ref target="#pg133">Extradition treaty between the United
                                            States and Albania, signed March 1, 1933</ref>
                                    </item>
                                </list>
                            </item>
                            <item>
                                <hi rendition="#small-caps">Czechoslovakia</hi>: <list>
                                    <item>
                                        <ref target="#pg139">Discussion of the application of the
                                            quota system to American motion picture films in
                                            Czechoslovakia</ref>
                                    </item>
                                </list>
                            </item>
                            <item>
                                <hi rendition="#small-caps">Finland</hi>: <list>
                                    <item>
                                        <ref target="#pg145">Proposed military service convention
                                            between the United States and Finland</ref>
                                    </item>
                                </list>
                            </item>
                            <item>
                                <hi rendition="#small-caps">France</hi>: <list>
                                    <item>
                                        <ref target="#pg155">Representations on account of
                                            discriminations against American products imported into
                                            France</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg165">Increase in quota for importation of
                                            French wines and liquors in return for increase by
                                            France in quotas for certain American products</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg168">Representations regarding the proposed
                                            French petroleum monopoly</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg176">Agreement between the United States and
                                            France regarding the interpretation of article 7 of the
                                            consular convention concluded February 23, 1853,
                                            effected by exchange of notes signed February 23 and
                                            March 4, 1933</ref>
                                    </item>
                                </list>
                            </item>
                            <item>
                                <hi rendition="#small-caps">Germany</hi>: <list>
                                    <item>
                                        <ref target="#pg183">Political developments in Germany under
                                            the National Socialist regime</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg270">The Nazi control of business, industry
                                            and labor in Germany</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg292">Relations of the Nazi regime with the
                                            Evangelical and Roman Catholic Churches</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg313">Nazification of German institutions of
                                            learning</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg320">Persecution of Jews in Germany</ref>
                                    </item>
                                    <pb facs="0009" n="V" xml:id="pgV"/>
                                    <item>
                                        <ref target="#pg366">American participation in the
                                            establishment of the High Commission for Refugees
                                            (Jewish and other) coming from Germany</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg381">Status of William E. Dodd as appointed
                                            Ambassador to Germany pending his reception by President
                                            Hindenburg</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg385">Attacks upon American citizens in
                                            Germany</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg398">German representations urging the
                                            recall of Edgar Ansel Mowrer, an American newspaper
                                            correspondent in Germany</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg406">Efforts to protect rights of the Watch
                                            Tower Bible and Tract Society, an American religious
                                            organization operating in Germany</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg418">Efforts of the Consul General at Berlin
                                            to protect American business interests threatened by
                                            Nazi discriminatory measures</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg439">Representations regarding German
                                            discrimination against American scrip and bond holders
                                            in the execution of the German transfer moratorium</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg460">Discrimination against American
                                            products under the German law providing tax exemption
                                            for replacement acquisition</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg470">German discrimination against American
                                            and other foreign shipping companies</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg478">Representations against German
                                            imposition of discriminatory quotas on importation of
                                            American products</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg483">Status with regard to taxation of
                                            German corporations, subsidiaries of American
                                            corporations</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg486">Action by the United States similar to
                                            that taken by other powers to prevent the sale of
                                            military airplanes to Germany</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg492">Petitions for rehearings in the
                                            so-called sabotage cases: Black Tom and Kingsland</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg502">Representations by the German Embassy
                                            against collection of customs duties on German coal in
                                            violation of treaty provisions for most-favored-nation
                                            treatment</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg534">Representations by the German Embassy
                                            against the Beverage Control Law of the State of New
                                            York as being in violation of treaty rights</ref>
                                    </item>
                                </list>
                            </item>
                            <item>
                                <hi rendition="#small-caps">Greece</hi>: <list>
                                    <item>
                                        <ref target="#pg544">Insistence by the United States upon
                                            Greek responsibility for the service of American loans
                                            to Greece under the agreements of May 10, 1929, and May
                                            24, 1932</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg547">Representations to the Greek Government
                                            against proposals to extend throughout Greece the
                                            Government monopoly in the sale of refined oil</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg552">Unsuccessful attempts to obtain
                                            extradition of Samuel Insull from Greece; denunciation
                                            by the United States of extradition treaty of May 6,
                                            1931</ref>
                                    </item>
                                </list>
                            </item>
                            <item>
                                <hi rendition="#small-caps">Italy</hi>: <list>
                                    <item>
                                        <ref target="#pg570">Proposed treaty between the United
                                            States and Italy concerning nationality and military
                                            obligations</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg585">Fascist pressure on naturalized
                                            American citizens visiting Italy</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg591">Representations by the Italian Embassy
                                            respecting violent death of an Italian national while
                                            detained in jail at New Orleans</ref>
                                    </item>
                                </list>
                            </item>
                            <pb facs="0010" n="VI" xml:id="pgVI"/>
                            <item>
                                <hi rendition="#small-caps">Latvia</hi>: <list>
                                    <item>
                                        <ref target="#pg602">Representations regarding alleged
                                            discrimination against American trade in Latvia</ref>
                                    </item>
                                </list>
                            </item>
                            <item>
                                <hi rendition="#small-caps">Netherlands</hi>: <list>
                                    <item>
                                        <ref target="#pg617">Proposal for the establishment of a
                                            reciprocal air navigation arrangement between the United
                                            States and the Netherlands</ref>
                                    </item>
                                </list>
                            </item>
                            <item>
                                <hi rendition="#small-caps">Norway</hi>: <list>
                                    <item>
                                        <ref target="#pg624">Preliminary discussions respecting a
                                            trade agreement between the United States and
                                            Norway</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg630">Arrangement between the United States
                                            and Norway regarding air navigation, effected by
                                            exchange of notes signed October 16, 1933</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg635">Arrangement between the United States
                                            and Norway regarding pilot licenses to operate civil
                                            aircraft, effected by exchange of notes signed October
                                            16, 1933</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg638">Arrangement between the United States
                                            and Norway regarding reciprocal recognition of
                                            certificates of airworthiness for imported aircraft,
                                            effected by exchange of notes signed October 16,
                                            1933</ref>
                                    </item>
                                </list>
                            </item>
                            <item>
                                <hi rendition="#small-caps">Portugal</hi>: <list>
                                    <item>
                                        <ref target="#pg640">Preliminary discussions respecting a
                                            trade agreement between the United States and
                                            Portugal</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg649">Representations regarding
                                            discriminatory charges in Portuguese ports</ref>
                                    </item>
                                </list>
                            </item>
                            <item>
                                <hi rendition="#small-caps">Rumania</hi>: <list>
                                    <item>
                                        <ref target="#pg656">Recognition by the United States of
                                            Rumania’s <hi rendition="#italic">de facto</hi>
                                            sovereignty over Bessarabia</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg683">Suspension of payments by Rumania on
                                            war damage bonds held by the Romano-Americana,
                                            subsidiary of the Standard Oil Company of New
                                            Jersey</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg687">Representations against the application
                                            of the Rumanian system of import quotas</ref>
                                    </item>
                                </list>
                            </item>
                            <item>
                                <hi rendition="#small-caps">Spain</hi>: <list>
                                    <item>
                                        <ref target="#pg694">Efforts of the Governments of the
                                            United States and Spain to eliminate mutual trade
                                            grievances</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg698">Representations against bills
                                            introduced in the Spanish Cortes to annul the contract
                                            of the International Telephone and Telegraph
                                            Company</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg703">Representations respecting
                                            discrimination against American automobile trade in
                                            Spain</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg706">Representations to mitigate severity of
                                            treatment of Americans held at Palma for alleged attack
                                            upon civil guards</ref>
                                    </item>
                                </list>
                            </item>
                            <item>
                                <hi rendition="#small-caps">Sweden</hi>: <list>
                                    <item>
                                        <ref target="#pg719">Preliminary discussions respecting a
                                            trade agreement between the United States and
                                            Sweden</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg723">Refusal of the Swedish State Railways
                                            to pay Dexter and Carpenter, Inc., judgment granted by a
                                            United States Court</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg758">Convention between the United States
                                            and Sweden for the exemption from military service of
                                            persons having dual nationality, signed January 31,
                                            1933</ref>
                                    </item>
                                    <pb facs="0011" n="VII" xml:id="pgVII"/>
                                    <item>
                                        <ref target="#pg765">Reciprocal air navigation arrangement
                                            between the United States and Sweden, effected by
                                            exchange of notes, September 8 and 9, 1933</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg770">Reciprocal arrangement between the
                                            United States and Sweden for the issuance of pilot
                                            licenses to operate civil aircraft, effected by exchange
                                            of notes, September 8 and 9, 1933</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg772">Arrangement between the United States
                                            and Sweden providing for the reciprocal recognition of
                                            certificates of airworthiness for imported aircraft,
                                            effected by exchange of notes, September 8 and 9,
                                            1933</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg774">Reciprocal extension by the United
                                            States and Sweden of free entry privileges for Legation
                                            employees</ref>
                                    </item>
                                </list>
                            </item>
                            <item>
                                <hi rendition="#small-caps">Switzerland</hi>: <list>
                                    <item>
                                        <ref target="#pg776">Exemption of Swiss Consuls in the
                                            United States from various excise taxes</ref>
                                    </item>
                                </list>
                            </item>
                            <item>
                                <hi rendition="#small-caps">Union of Soviet Socialist
                                Republics</hi>: <list>
                                    <item>
                                        <ref target="#pg778">Recognition by the United States of the
                                            Soviet Union, November 16, 1933</ref>
                                    </item>
                                </list>
                            </item>
                        </list>
                    </item>
                    <item>
                        <hi rendition="#small-caps">The Near East and Africa</hi>: <list>
                            <item>
                                <hi rendition="#small-caps">Egypt</hi>: <list>
                                    <item>
                                        <ref target="#pg841">Failure of the United States to
                                            conclude a treaty of extradition with Egypt</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg845">Discrimination in favor of British
                                            firms in awarding contracts for the building of
                                            irrigation works in the Anglo-Egyptian Sudan</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg848">Suspension of the Egyptian Government’s
                                            attempt to regulate automotive traffic by decree</ref>
                                    </item>
                                </list>
                            </item>
                            <item>
                                <hi rendition="#small-caps">Ethiopia</hi>: <list>
                                    <item>
                                        <ref target="#pg851">Cooperation by the United States in
                                            efforts to effect a reform of the Special Court at Addis
                                            Ababa</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg863">Project for construction of a dam at
                                            Lake Tsana</ref>
                                    </item>
                                </list>
                            </item>
                            <item>
                                <hi rendition="#small-caps">Hedjaz and Nejd</hi>. <hi
                                    rendition="#italic">See</hi>
                                <hi rendition="#small-caps">Saudi Arabia.</hi>
                            </item>
                            <item>
                                <hi rendition="#small-caps">Liberia</hi>: <list>
                                    <item>
                                        <ref target="#pg878">Continued efforts to obtain cooperation
                                            between the Liberian Government and the Firestone
                                            interests in the administrative and fiscal
                                            reorganization of Liberia as proposed by the League of
                                            Nations Plan of Assistance</ref>
                                    </item>
                                </list>
                            </item>
                            <item>
                                <hi rendition="#small-caps">Morocco</hi>: <list>
                                    <item>
                                        <ref target="#pg967">Reservation of American rights with
                                            respect to certain measures in the French Zone of
                                            Morocco</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg976">Representations respecting the
                                            violation of American treaty rights to trade in the
                                            Spanish Zone of Morocco</ref>
                                    </item>
                                </list>
                            </item>
                            <pb facs="0012" n="VIII" xml:id="pgVIII"/>
                            <item>
                                <hi rendition="#small-caps">Saudi Arabia</hi>: <list>
                                    <item>
                                        <ref target="#pg986">Provisional agreement between the
                                            United States and Saudi Arabia with regard to consular
                                            and diplomatic representation, juridical protection,
                                            commerce and navigation</ref>
                                    </item>
                                </list>
                            </item>
                            <item>
                                <hi rendition="#small-caps">Syria</hi>: <list>
                                    <item>
                                        <ref target="#pg1002">Assent by the United States to changes
                                            of frontier between Syria and Jebel Druse on the one
                                            hand and Trans-Jordan on the other</ref>
                                    </item>
                                </list>
                            </item>
                            <item>
                                <ref target="#pg1013">
                                    <hi rendition="#small-caps">Index</hi>
                                </ref>
                            </item>
                        </list>
                    </item>
                </list>
            </div>
        </body>
    </text>
