            <div xml:id="d83">

                <pb facs="0213" n="109" sameAs="frus:frus1933v02/pg109"/>

                <note rend="inline" type="source">611.41D6 Liquor/4</note>
                <head>
                    <hi rendition="#italic">The Irish Minister (MacWhite) to the Assistant Economic Adviser (Livesey)</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1933-12-16">16 December,
                        1933</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Livesey</hi>: I am enclosing herewith the
                    memorandum submitted yesterday with the rectifications agreed upon.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">M. MacWhite</hi>
                    </signed>
                </closer>


                <xi:include href="d83-a1.xml" xpointer="d83-a1"/>
