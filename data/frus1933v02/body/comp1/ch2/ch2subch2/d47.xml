    <text>
        <body>
            <div xml:id="d47">

                <pb facs="0166" n="62" sameAs="frus:frus1933v02/pg62"/>

                <note rend="inline" type="source">711.4215 Air Pollution/458</note>
                <head>
                    <hi rendition="#italic">The Minister in Canada (Robbins) to the Acting Secretary
                        of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 318</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Ottawa</hi></placeName>, <date
                            calendar="gregorian" when="1933-12-26">December 26,
                        1933</date>.<lb/>[Received December 29.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to refer to my despatch
                    No. 313 of December 21, 1933,<anchor n="23" xml:id="d47-f1"/> regarding the
                    Trail Smelter question and to enclose herewith a note on this subject dated
                    December 26, 1933, which has just been received from the Prime Minister.</p>
                <p>Respectfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Warren D. Robbins</hi>
                    </signed>
                </closer>


                <xi:include href="d47-a1.xml" xpointer="d47-a1"/>
            </div>
        </body>
    </text>
