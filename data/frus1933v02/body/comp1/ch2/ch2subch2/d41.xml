        <body>
            <div xml:id="d41">

                <pb facs="0161" n="57" xml:id="pg57"/>

                <note rend="inline" type="source">711.4215 Air Pollution/414: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Chargé in Canada
                        (Boal)</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1933-04-19T17:00:00-05:00">April 19, 1933—5
                            p.m.</date>
                    </dateline>
                </opener>
                <p>15. Endeavor obtain from Canadian Government answer to inquiry stated in
                    Department’s telegram No. 9 of March 7, 6 p.m., 1933, Trail Smelter.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
