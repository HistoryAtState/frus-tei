    <text>
        <body>
            <div xml:id="d3">

                <pb facs="0108" n="4" sameAs="frus:frus1933v02/pg4"/>

                <note rend="inline" type="source">611.42251/157</note>
                <head>
                    <hi rendition="#italic">The Chargé in Great Britain (Atherton) to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 787</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1933-04-06">April 6,
                        1933</date>.<lb/>[Received April 15.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Confirming the Embassy’s telegram No. 76,
                    April 6, 12 noon,<anchor n="3" xml:id="d3-f1"/> I have the honor to transmit
                    herewith copies of the full text of a note <pb facs="0109" n="5" xml:id="pg5"/>
                    dated April 5 from the Foreign Office, in reply to the Embassy’s <hi
                        rendition="#italic">Aide-Mémoire</hi> based on the Department’s telegraphic
                    instruction No. 16, January 19, 1 p.m.,<anchor n="4" xml:id="d3-f2"/> concerning
                    the difficulties at present encountered in shipping Canadian wheat to the United
                    Kingdom via United States ports.</p>
                <p>Respectfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Ray Atherton</hi>
                    </signed>
                </closer>


                <xi:include href="d3-a1.xml" xpointer="d3-a1"/>
            </div>
        </body>
    </text>
