    <text>
        <body>
            <div xml:id="d445">

                <pb facs="0720" n="616" xml:id="pg616"/>

                <note rend="inline" type="source">660P.1111/6</note>
                <head>
                    <hi rendition="#italic">The Chargé in Latvia (Cole) to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1657</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Riga</hi></placeName>, <date
                            calendar="gregorian" when="1933-10-13">October 13,
                        1933</date>.<lb/>[Received October 26.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: In compliance with the last paragraph of
                    the Department’s instruction No. 182, dated April 4, 1933, I have the honor to
                    report that during the September 1933 quarter no new legislation operating to
                    restrict or discriminate against American trade has been enacted in Latvia, nor
                    have any specific instances of discrimination come to the attention of the
                    Legation or Consulate.</p>
                <p>Respectfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Felix Cole</hi>
                    </signed>
                </closer>
            </div>
        </body>
