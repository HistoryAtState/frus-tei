    <text>
        <body>
            <div xml:id="d388">

                <pb facs="0656" n="552" sameAs="frus:frus1933v02/pg552"/>

                <note rend="inline" type="source">251.11 Insull, Samuel/6: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in Greece (Morris) to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Athens</hi></placeName>, <date
                            calendar="gregorian" when="1932-10-10T11:00:00+02:00">October 10,
                            1932—11 a.m.</date>
                        <lb/> [Received October 10—6:42 a.m.]</dateline>
                </opener>
                <p>107. Samuel Insull<anchor n="17" xml:id="d388-f1"/> just arrested by the police
                    on their own responsibility and is being detained on technical inquiry into his
                    identity and <pb facs="0657" n="553" xml:id="pg553"/> purpose at Athens. Failing
                    arrival of request for extradition he will be released in 24 hours.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Morris</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d388-f1" n="17" xml:id="d388-f1-content">
                <p>Former Chairman of the Board of Directors of the Middle West Utilities Co. and
                    the Mississippi Valley Utility Investment Co.</p>
            </note>
        </listAnnotation>
    </standOff>
