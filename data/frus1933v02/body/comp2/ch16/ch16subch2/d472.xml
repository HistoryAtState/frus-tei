            <div xml:id="d472">

                <pb facs="0756" n="652" sameAs="frus:frus1933v02/pg652"/>

                <note rend="inline" type="source">853.116/114: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in Portugal (South) to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Lisbon</hi></placeName>, <date
                            calendar="gregorian" when="1933-01-04T12:00:00+00:00">January 4,
                            1933—noon</date>.<lb/>[Received January 4—11:10 a.m.]</dateline>
                </opener>
                <p>1. My despatch No. 718, of September 29. Reductions in discriminatory duties of 2
                    and 4 percent, respectively, conceded by decree of January 2nd, effective that
                    day.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">South</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
