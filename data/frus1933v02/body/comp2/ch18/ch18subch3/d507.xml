    <text>
        <body>
            <div xml:id="d507">

                <pb facs="0808" n="704" xml:id="pg704"/>

                <note rend="inline" type="source">652.116/27: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Spain (Bowers) to the Acting Secretary of
                            State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Madrid</hi></placeName>, <date
                            calendar="gregorian" when="1933-06-10T12:00:00+00:00">June 10,
                            1933—noon</date>.<lb/>[Received June 10—11:30 a.m.]</dateline>
                </opener>
                <p>33. Embassy’s despatch number 1189, May 17. Commercial Attaché<anchor n="26"
                        xml:id="d507-f1"/> unofficially informed that Spain is seriously considering
                    granting “benefits” of 30 percent to French automobiles under decree of May
                    9th.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bowers</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d507-f1" n="26" xml:id="d507-f1-content">
