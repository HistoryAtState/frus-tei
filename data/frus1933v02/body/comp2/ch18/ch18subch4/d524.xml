    <text>
        <body>
            <div xml:id="d524">

                <pb facs="0818" n="714" xml:id="pg714"/>

                <note rend="inline" type="source">352.1121 Blodgett, Walton/134: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Spain (Bowers) to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Madrid</hi></placeName>, <date
                            calendar="gregorian" when="1933-10-27T10:00:00+00:00">October 27,
                            1933—10 a.m.</date>
                        <lb/> [Received October 27—7:45 a.m.]</dateline>
                </opener>
                <p>65. My telegram No. 64.<anchor n="47" xml:id="d524-f1"/> Following from Dawson at
                    Palma de Mallorca: <quote rend="blockquote">
                        <p>“Acquittal all five subject to review.”</p>
                    </quote>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bowers</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d524-f1" n="47" xml:id="d524-f1-content">
                <p>Dated October 25, not printed; it indicated that the trial of the five Americans
                    would take place October 26th.</p>
            </note>
        </listAnnotation>
    </standOff>
