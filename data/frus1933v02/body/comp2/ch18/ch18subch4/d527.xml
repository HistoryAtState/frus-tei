    <text>
        <body>
            <div xml:id="d527">

                <pb facs="0819" n="715" xml:id="pg715"/>

                <note rend="inline" type="source">352.1121 Blodgett, Walton/165: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Spain (Bowers) to the Acting Secretary of
                            State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Madrid</hi></placeName>, <date
                            calendar="gregorian" when="1934-01-11T13:00:00+00:00">January 11, 1934—1
                            p.m.</date>
                        <lb/> [Received January 11—9:35 a.m.]</dateline>
                </opener>
                <p>2. Department’s telegram No. 61, December 26, 6 p.m.<anchor n="48"
                        xml:id="d527-f1"/> Trial held and concluded before the Supreme Court this
                    morning. Decision expected any time within 8 days.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bowers</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
