    <text>
        <body>
            <div xml:id="d546">

                <pb facs="0861" n="757" sameAs="frus:frus1933v02/pg757"/>

                <note rend="inline" type="source">458.11 Dexter and Carpenter/179: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in Sweden (Steinhardt) to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Stockholm</hi></placeName>, <date
                            calendar="gregorian" when="1933-08-29T12:00:00+01:00">August 29,
                            1933—noon</date>.<lb/>[Received August 29—10:50 a.m.]</dateline>
                </opener>
                <p>23. With reference to Department’s telegram August 28, 4 p.m.,<anchor n="15"
                        xml:id="d546-f1"/> settlement agreed upon for $150,000. Payment promised
                    September 18th, in no event later than October 1st. Please advise Haight.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Steinhardt</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
