    <text>
        <body>
            <div xml:id="d586">

                <pb facs="0909" n="805" sameAs="frus:frus1933v02/pg805"/>

                <note rend="inline" type="source">711.61/343½</note>
                <head>
                    <hi rendition="#italic">The Soviet Commissar for Foreign Affairs (Litvinov) to President Roosevelt
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1933-11-16">November 16,
                        1933</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. President</hi>: I am very happy to
                    inform you that the Government of the Union of Soviet Socialist Republics is
                    glad to establish normal diplomatic relations with the Government of the United
                    States and to exchange ambassadors.</p>
                <p>I, too, share the hope that the relations now established between our peoples may
                    forever remain normal and friendly, and that our nations henceforth may
                    cooperate for their mutual benefit and for the preservation of the peace of the
                    world.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Maxim Litvinoff</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
