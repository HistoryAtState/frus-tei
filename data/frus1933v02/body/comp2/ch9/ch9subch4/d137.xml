    <text>
        <body>
            <div xml:id="d137">

                <pb facs="0284" n="180" sameAs="frus:frus1933v02/pg180"/>

                <note rend="inline" type="source">851.502/68</note>
                <head>
                    <hi rendition="#italic">The Chargé in France (Marriner) to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 3400</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1933-03-07">March 7,
                        1933</date>.<lb/>[Received March 14.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to the Embassy’s telegram No. 64
                    of February 23/5 p.m., 1933,<anchor n="25" xml:id="d137-f1"/> I have the honor
                    to transmit herewith for the Department’s information and the completion of its
                    files a copy and translation of the Embassy’s note of February 23 and of the
                    Ministry for Foreign Affairs’ note of March 4, 1933,<anchor n="26"
                        xml:id="d137-f2"/> in interpretation of the rights of American citizens
                    under the French rent laws as governed by the Consular Convention of 1853.</p>
                <p>Respectfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Theodore Marriner</hi>
                    </signed>
                </closer>



                <xi:include href="d137-a1.xml" xpointer="d137-a1"/>
                <xi:include href="d137-a2.xml" xpointer="d137-a2"/>
            </div>
        </body>
    </text>
    <standOff>
