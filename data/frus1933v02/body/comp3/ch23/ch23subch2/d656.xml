                <note rend="inline" type="source">884.6461 Tsana Dam/402: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Minister in Egypt (Jardine)</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1933-06-01T17:00:00-04:00">June 1, 1933—5
                            p.m.</date>
                    </dateline>
                </opener>
                <p>12. White Engineering Corporation requests you cable status Tsana proposal.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Phillips</hi>
                    </signed>
                </closer>
            </div>
