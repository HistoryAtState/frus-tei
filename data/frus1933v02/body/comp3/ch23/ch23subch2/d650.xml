                <pb facs="0975" n="871" sameAs="frus:frus1933v02/pg871"/>

                <note rend="inline" type="source">884.6481 Tsana Dam/369: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Minister in Ethiopia (Southard)</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1932-12-22T12:00:00-05:00">December 22,
                            1932—noon</date>.</dateline>
                </opener>
                <p>23. Following from White Engineering Corporation: <quote rend="blockquote">
                        <p>“Please accept Emperor’s invitation. Lardner will arrive Addis Ababa
                            January 27th.”</p>
                    </quote>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stimson</hi>
                    </signed>
                </closer>
            </div>
        </body>
