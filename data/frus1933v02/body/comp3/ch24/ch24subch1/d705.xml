            </note>
            <note corresp="#d705-f2" n="57" xml:id="d705-f2-content">
                <p>Quoted from a memorandum by President Roosevelt for the Under Secretary of State,
                    dated August 19; not printed.</p>
            </note>
        </listAnnotation>
