                <pb facs="1068" n="964" sameAs="frus:frus1933v02/pg964"/>

                <note rend="inline" type="source">882.01 Foreign Control/742: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Chargé in Liberia (Werlich)</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1933-12-14T15:00:00-05:00">December 14,
                            1933—3 p.m.</date>
                    </dateline>
                </opener>
                <p>63. Your telegram No. 97, December 12, noon. We believe that our position has
                    been made so abundantly clear that for the present no further action need be
                    taken.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Phillips</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
