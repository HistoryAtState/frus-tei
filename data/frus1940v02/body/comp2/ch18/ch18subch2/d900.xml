    <text>
        <body>
            <div xml:id="d900">

                <pb facs="0789" n="780" sameAs="frus:frus1940v02/pg780"/>

                <note rend="inline" type="source">840.51 Frozen Credits/648: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in Rumania</hi>
                        (<hi rendition="#italic">Gunther</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1940-10-11T20:00:00-05:00">October 11, 1940—8
                            p.m.</date>
                    </dateline>
                </opener>
                <p>333. Executive Order 8565, October 10, 1940<anchor n="12" xml:id="d900-f1"/>
                    extended all provisions of Executive Order 8389 of April 10, 1940,<anchor n="13"
                        xml:id="d900-f2"/> as amended, to include Rumania. For reference see last
                    paragraph of Radio Bulletin No. 85, April 10, 1940.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d900-f1" n="12" xml:id="d900-f1-content">
                <p>
                    <hi rendition="#italic">Federal Register</hi>, October 12, 1940, p. 4062.</p>
            </note>
            <note corresp="#d900-f2" n="13" xml:id="d900-f2-content">
                <p>
                    <hi rendition="#italic">Ibid.</hi>, April 12, 1940, pp. 1400–1401. This order
                    froze all the assets of Denmark and Norway in the United States.</p>
            </note>
        </listAnnotation>
    </standOff>
