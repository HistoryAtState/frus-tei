            <div xml:id="d782">

                <pb facs="0681" n="672" xml:id="pg672"/>

                <note rend="inline" type="source">840.4061 Motion Pictures/41: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Chargé in
                        Germany</hi> (<hi rendition="#italic">Morris</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1940-11-13T15:00:00-05:00">November 13,
                            1940—3 p.m.</date>
                    </dateline>
                </opener>
                <p>2998. Your 4515, October 30, 7 p.m. You are instructed to present a note to the
                    German Government in the form recommended in your telegram.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Welles</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
