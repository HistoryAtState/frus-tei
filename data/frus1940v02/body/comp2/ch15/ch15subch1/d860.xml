    <text>
        <body>
            <div xml:id="d860">

                <pb facs="0745" n="736" sameAs="frus:frus1940v02/pg736"/>

                <note rend="inline" type="source">750.94/108</note>
                <head>
                    <hi rendition="#italic">The British Ambassador</hi> (<hi
                            rendition="#italic">Lothian</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1940-05-12">May 12, 1940</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Secretary</hi>: Confirming my telephone
                    conversation this morning I enclose a brief summary of the information I
                    obtained by telephone from London in response to the representations you made to
                    me yesterday.</p>
                <p>Believe me [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lothian</hi>
                    </signed>
                </closer>



                <xi:include href="d860-a1.xml" xpointer="d860-a1"/>
