    <text>
        <body>
            <div xml:id="d825">

                <pb facs="0718" n="709" sameAs="frus:frus1940v02/pg709"/>

                <note rend="inline" type="source">740.0011 European War 1939/3303<hi
                        rendition="#superscript">4/5</hi>
                </note>
                <head>
                    <hi rendition="#italic">The British Ambassador</hi> (<hi rendition="#italic"
                        >Lothian</hi>) <hi rendition="#italic">to President Roosevelt </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1940-05-26">May 26, 1940</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. President</hi>: I enclose two copies of the
                    proposal for a communication by yourself to Mussolini which I discussed with you
                    last night. I am also sending one to Mr. Hull, though I am not certain it will
                    reach him before he sees you. The text has been agreed with the French
                    Ambassador.</p>
                <p>Believe me [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lothian</hi>
                    </signed>
                </closer>
                <postscript>
                    <p>P. S. I presume that the U. S. A. would participate in this discussion to the
                        extent that its own interests were engaged.</p>
                    <p rendition="#right">L</p>
                </postscript>


                <xi:include href="d825-a1.xml" xpointer="d825-a1"/>
