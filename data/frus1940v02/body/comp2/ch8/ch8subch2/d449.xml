            <div xml:id="d449">

                <pb facs="0375" n="366" sameAs="frus:frus1940v02/pg366"/>

                <note rend="inline" type="source">859B.01/194b: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Consul at Godthaab</hi> (<hi rendition="#italic"
                            >Penfield</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1940-05-27T17:00:00-04:00">May 27, 1940—5
                            p.m.</date>
                    </dateline>
                </opener>
                <p>9. Kauffmann has expressed his complete approval of the project outlined in our
                    8, May 26, 3 p.m. We expect shortly to receive a <pb facs="0376" n="367"
                        xml:id="pg367"/> message from him for Governor Svane to be transmitted
                    through you.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
