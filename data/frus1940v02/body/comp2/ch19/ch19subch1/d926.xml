            <div xml:id="d926">

                <pb facs="0809" n="800" sameAs="frus:frus1940v02/pg800"/>

                <note rend="inline" type="source">852.51/503: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Spain</hi>
                        (<hi rendition="#italic">Weddell</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1940-06-19T18:00:00-04:00">June 19, 1940—6
                            p.m.</date>
                    </dateline>
                </opener>
                <p>94. Your 199, June 17, 8 p.m., last paragraph. You are authorized to proceed in
                    your discretion in the manner indicated.<anchor n="9" xml:id="d926-f1"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d926-f1" n="9" xml:id="d926-f1-content">
                <p>For account of Ambassador Weddell’s conference with Franco, see telegram No. 232,
                    June 22, 9 p.m., from the Ambassador in Spain, <ref target="#pg887">p.
                    887</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
