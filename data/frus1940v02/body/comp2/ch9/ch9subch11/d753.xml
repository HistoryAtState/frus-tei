    <text>
        <body>
            <div xml:id="d753">

                <pb facs="0660" n="651" sameAs="frus:frus1940v02/pg651"/>

                <note rend="inline" type="source">811.20 Defense (M)/47<hi rendition="#superscript"
                        >13/22</hi>: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic"
                        >Bullitt</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">La Bourboule</hi></placeName>, <date
                            calendar="gregorian" when="1940-07-05T08:00:00+02:00">July 5, 1940—8
                            a.m.</date>
                        <lb/> [Received July 7—9:33 p.m.]</dateline>
                </opener>
                <p>18. My number 12 of July 3, noon.<anchor n="28" xml:id="d753-f1"/> The Ministry
                    of Colonies has been discovered<anchor n="29" xml:id="d753-f2"/> and
                        Chauvel<anchor n="30" xml:id="d753-f3"/> stated yesterday that a telegram
                    ordering the immediate release of our wolfram ore and antimony in Indochina had
                    gone forward.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bullitt</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d753-f1" n="28" xml:id="d753-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d753-f2" n="29" xml:id="d753-f2-content">
                <p>The Ministry of Colonies was in the process of moving from Bordeaux to Vichy.</p>
            </note>
            <note corresp="#d753-f3" n="30" xml:id="d753-f3-content">
                <p>Jean Chauvel, Chief of the Far Eastern Division of the French Foreign Office.</p>
            </note>
        </listAnnotation>
    </standOff>
