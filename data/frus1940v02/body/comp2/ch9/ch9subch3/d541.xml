    <text>
        <body>
            <div xml:id="d541">

                <pb facs="0481" n="472" sameAs="frus:frus1940v02/pg472"/>

                <note rend="inline" type="source">740.0011 European War 1939/4787½</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        French Ambassador</hi> (<hi rendition="#italic"
                            >Saint-Quentin</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1940-07-16">July 16, 1940</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: The President has asked me to
                    request that Your Excellency be good enough to inform Marshal Pétain that his
                    message of July 4 regarding the naval action at Oran, which you handed
                    personally to the President, has been read with interest.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Cordell Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
