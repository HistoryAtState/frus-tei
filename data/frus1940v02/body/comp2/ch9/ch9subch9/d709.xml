                <pb facs="0634" n="625" sameAs="frus:frus1940v02/pg625"/>

                <note rend="inline" type="source">740.0011 European War 1939/6997: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Consul at Dakar</hi> (<hi
                        rendition="#italic">Wasson</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1940-12-07T18:00:00-05:00">December 7, 1940—6
                            p.m.</date>
                    </dateline>
                </opener>
                <p>34. Please comment on report from Algiers that nine German aviators, reported to
                    be members of an armistice commission, have just passed through that city
                    returning from Dakar.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
