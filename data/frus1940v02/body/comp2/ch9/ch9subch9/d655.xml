            <div xml:id="d655">

                <pb facs="0596" n="587" sameAs="frus:frus1940v02/pg587"/>

                <note rend="inline" type="source">740.0011 European War 1939/5634: Telegram</note>
                <head>
                    <hi rendition="#italic">The Consul General at Casablanca</hi> (<hi rendition="#italic">Goold</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Casablanca</hi></placeName>, <date
                            calendar="gregorian" when="1940-09-23T18:00:00+01:00">September 23,
                            1940—6 p.m.</date>
                        <lb/> [Received September 23—4:45 p.m.]</dateline>
                </opener>
                <p>136. A German port commission of five members arrived today for a visit of 2 days
                    after which they will proceed to Dakar.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Goold</hi>
                    </signed>
                </closer>
            </div>
