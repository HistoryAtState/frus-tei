            <div xml:id="d635">

                <pb facs="0579" n="570" sameAs="frus:frus1940v02/pg570"/>

                <note rend="inline" type="source">740.0011 European War 1939/3966: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Consul General at Casablanca</hi> (<hi
                            rendition="#italic">Goold</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1940-06-24T18:00:00-04:00">June 24, 1940—6
                            p.m.</date>
                    </dateline>
                </opener>
                <p>21. Your 30, June 18, 10 p.m.<anchor n="36" xml:id="d635-f1"/> Please continue to
                    keep the Department informed of all developments relating to the position of
                    French Morocco toward the war.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
