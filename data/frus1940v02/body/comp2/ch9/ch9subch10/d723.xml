    <text>
        <body>
            <div xml:id="d723">

                <pb facs="0645" n="636" sameAs="frus:frus1940v02/pg636"/>

                <note rend="inline" type="source">740.0011 European War 1939/4174a: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Consul at Lagos</hi> (<hi rendition="#italic"
                            >Jester</hi>)<anchor n="12" xml:id="d723-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1940-06-24T18:00:00-04:00">June 24, 1940—6
                            p.m.</date>
                    </dateline>
                </opener>
                <p>Department would appreciate receiving by telegraph any information you may be
                    able to obtain in regard to the attitude of the armed forces in French colonial
                    territories toward carrying on the war.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d723-f1" n="12" type="source" xml:id="d723-f1-content">
                <p>The same telegram was sent on the same date to the Consul at Leopoldville.</p>
            </note>
        </listAnnotation>
    </standOff>
