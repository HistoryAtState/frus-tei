            <div xml:id="d735">

                <pb facs="0651" n="642" sameAs="frus:frus1940v02/pg642"/>

                <note rend="inline" type="source">740.0011 European War 1939/6581: Telegram</note>
                <head>
                    <hi rendition="#italic">The Consul at Dakar</hi> (<hi rendition="#italic"
                        >Wasson</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Dakar</hi></placeName>, <date
                            calendar="gregorian" when="1940-11-10T09:00:00-01:00">November 10,
                            1940—9 a.m.</date>
                        <lb/> [Received 3:10 p.m.]</dateline>
                </opener>
                <p>53. In official circles it is stated that the military forces under the command
                    of De Gaulle have completed the occupation of Gabon.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wasson</hi>
                    </signed>
                </closer>
            </div>
        </body>
