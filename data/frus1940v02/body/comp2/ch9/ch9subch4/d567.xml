    <text>
        <body>
            <div xml:id="d567">

                <pb facs="0504" n="495" xml:id="pg495"/>

                <note rend="inline" type="source">710. Consultation (2)/68: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Italy</hi> (<hi rendition="#italic"
                        >Phillips</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Rome</hi></placeName>, <date
                            calendar="gregorian" when="1940-06-24T16:00:00+02:00">June 24, 1940—4
                            p.m.</date>
                        <lb/> [Received June 24—1:25 p.m.]</dateline>
                </opener>
                <p>619. Your telegram number 210, June 17, 11 a.m.<anchor n="52" xml:id="d567-f1"/>
                    Reply dated June 22 received today merely states “I have the honor to
                    acknowledge receipt of your note number 1521 of June 18. Accept, et
                    cetera,”.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Phillips</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
