    <text>
        <body>
            <div xml:id="d43">

                <pb facs="0069" n="60" sameAs="frus:frus1940v02/pg60"/>

                <note rend="inline" type="source">740.00112 European War 1939/1573: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in Sweden</hi> (<hi
                            rendition="#italic">Sterling</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Stockholm</hi></placeName>, <date
                            calendar="gregorian" when="1940-05-03T17:00:00+01:00">May 3, 1940—5
                            p.m.</date>
                        <lb/> [Received May 3—3:25 p.m.]</dateline>
                </opener>
                <p>434. From Commercial Attaché.<anchor n="56" xml:id="d43-f1"/> For our information
                    and to answer repeated inquiries from Swedish firms dependent on American trade
                    we would appreciate advice as to any negotiations undertaken by the Government
                    of the United States looking toward agreements with belligerents to allow
                    resumption of direct trade between the United States and Sweden. Large tractor
                    and other orders awaiting the possibility of import and it has been suggested
                    that Vladivostok and <pb facs="0070" n="61" xml:id="pg61"/> trans-Russia route
                    could be utilized and information as to this possibility also urgently
                    needed.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Sterling</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d43-f1" n="56" xml:id="d43-f1-content">
                <p>George C. Howard.</p>
            </note>
        </listAnnotation>
    </standOff>
