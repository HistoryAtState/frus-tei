            <div xml:id="d24">

                <pb facs="0039" n="30" sameAs="frus:frus1940v02/pg30"/>

                <note rend="inline" type="source">740.00111A Combat Areas/177: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Chargé in the United
                        Kingdom</hi> (<hi rendition="#italic">Johnson</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1940-03-05T15:00:00-05:00">March 5, 1940—3
                            p.m.</date>
                    </dateline>
                </opener>
                <p>418. Your 490, February 28, 8 p.m. Please convey following message to the Naval
                    Person from the President: <quote rend="blockquote">
                        <p>“Upon my return to Washington, I received your message. I deeply
                            appreciate your efforts. I am having the situation thoroughly studied
                            and will communicate with you further as soon as possible.”</p>
                    </quote>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
