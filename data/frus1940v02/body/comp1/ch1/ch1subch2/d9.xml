    <text>
        <body>
            <div xml:id="d9">

                <pb facs="0019" n="10" sameAs="frus:frus1940v02/pg10"/>

                <note rend="inline" type="source">740.00111A Combat Areas/140: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in the United Kingdom</hi> (<hi
                        rendition="#italic">Johnson</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1940-01-29T19:00:00+00:00">January 29, 1940—7
                            p.m.</date>
                        <lb/> [Received January 29—1:20 p.m.]</dateline>
                </opener>
                <p>265. Personal for the President from Naval Person.<anchor n="14" xml:id="d9-f1"/>
                </p>
                <quote rend="blockquote">
                    <p>“I gave orders last night that no American ship should, in any circumstances,
                        be diverted into the combat zone round the British Islands declared by you.
                        I trust this will be satisfactory.”</p>
                </quote>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Johnson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d9-f1" n="14" xml:id="d9-f1-content">
                <p>Code name for Winston Churchill, British First Lord of the Admiralty.</p>
            </note>
        </listAnnotation>
    </standOff>
