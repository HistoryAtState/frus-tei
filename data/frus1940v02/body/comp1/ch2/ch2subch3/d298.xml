    <text>
        <body>
            <div xml:id="d298">

                <pb facs="0236" n="227" sameAs="frus:frus1940v02/pg227"/>

                <note rend="inline" type="source">840.48 Refugees/2135: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Italy</hi> (<hi
                            rendition="#italic">Phillips</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Rome</hi></placeName>, <date
                            calendar="gregorian" when="1940-05-10T20:00:00+01:00">May 10, 1940—8
                            p.m.</date>
                        <lb/> [Received May 10—3:10 p.m.]</dateline>
                </opener>
                <p>18. For the President from Myron Taylor. In view of changed conditions the
                    meeting of Intergovernmental Committee suggested in my telegram yesterday<anchor
                        n="62" xml:id="d298-f1"/> may be impracticable therefore will await on
                    events before taking further action.<anchor n="63" xml:id="d298-f2"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Phillips</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d298-f1" n="62" xml:id="d298-f1-content">
                <p>Not found in Department files.</p>
            </note>
            <note corresp="#d298-f2" n="63" xml:id="d298-f2-content">
                <p>There was some further discussion as to time and place for a meeting but
                    apparently no meeting was held in 1940.</p>
            </note>
        </listAnnotation>
    </standOff>
