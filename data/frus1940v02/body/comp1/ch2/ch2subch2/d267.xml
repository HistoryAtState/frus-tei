    <text>
        <body>
            <div xml:id="d267">

                <pb facs="0207" n="198" sameAs="frus:frus1940v02/pg198"/>

                <note rend="inline" type="source">740.00115 European War 1939/28: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Chargé in France</hi> (<hi
                        rendition="#italic">Murphy</hi>)<anchor n="15" xml:id="d267-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1940-03-26T19:00:00-05:00">March 26, 1940—7
                            p.m.</date>
                    </dateline>
                </opener>
                <p>229. Department’s 1107, September 29, 5 p.m.<anchor n="16" xml:id="d267-f2"/>
                    Please inquire at Foreign Office and report present status of negotiations.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d267-f1" n="15" type="source" xml:id="d267-f1-content">
                <p>The same, <hi rendition="#italic">mutatis mutandis</hi>, to the Ambassador in the
                    United Kingdom, as telegram No. 565, March 26, 7 p.m., and to the Chargé in
                    Germany, as telegram No. 738, March 26, 11 p.m.</p>
            </note>
            <note corresp="#d267-f2" n="16" xml:id="d267-f2-content">
