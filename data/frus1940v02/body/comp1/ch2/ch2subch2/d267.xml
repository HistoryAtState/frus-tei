                    <ref target="frus1939v01#pg_641">
                        <hi rendition="#italic">Foreign Relations</hi>, 1939, vol. <hi
                            rendition="#small-caps">i</hi>, p. 641</ref>.</p>
            </note>
        </listAnnotation>
