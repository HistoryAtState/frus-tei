    <text>
        <body>
            <div xml:id="d137">

                <pb facs="0125" n="116" sameAs="frus:frus1940v02/pg116"/>

                <note rend="inline" type="source">340.1115A/734: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in Germany</hi> (<hi rendition="#italic"
                        >Heath</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berlin</hi></placeName>, <date
                            calendar="gregorian" when="1940-05-29T11:00:00+02:00">May 29, 1940—11
                            a.m.</date>
                        <lb/> [Received 12:24 p.m.]</dateline>
                </opener>
                <p>1558. Department’s 1393, May 24.<anchor n="77" xml:id="d137-f1"/> This additional
                    information was communicated to the Foreign Office by note on May 25. The
                    Foreign Office has now formally acknowledged receipt of this note and has stated
                    that it has not failed to communicate the contents to the competent domestic
                    authorities.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Heath</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d137-f1" n="77" xml:id="d137-f1-content">
                <p>Not printed; it contained the information that the <hi rendition="#italic"
                        >President Roosevelt</hi> had sailed May 24 and would arrive at Galway June
                    1 (340.1115A/693a).</p>
            </note>
        </listAnnotation>
    </standOff>
