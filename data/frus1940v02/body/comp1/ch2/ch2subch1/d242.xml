                <pb facs="0186" n="177" sameAs="frus:frus1940v02/pg177"/>

                <note rend="inline" type="source">340.1115A/1635: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Chargé in the United Kingdom</hi> (<hi
                            rendition="#italic">Johnson</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1940-11-30T21:00:00-05:00">November 30,
                            1940—9 p.m.</date>
                    </dateline>
                </opener>
                <p>3688. Your 3907, November 29, 10 p.m. Department appreciates your clear and
                    helpful discussion of situation and approves position taken by you as indicated
                    in final paragraph. Please communicate any further developments.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
