    <text>
        <body>
            <div xml:id="d89">

                <pb facs="0099" n="90" sameAs="frus:frus1940v02/pg90"/>

                <note rend="inline" type="source">340.1115A/617a: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Minister in Switzerland</hi> (<hi rendition="#italic"
                            >Harrison</hi>)<anchor n="46" xml:id="d89-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1940-05-15T10:00:00-04:00">May 15, 1940—10
                            a.m.</date>
                    </dateline>
                </opener>
                <p>47. S. S. <hi rendition="#italic">Washington</hi>, United States Lines, now at
                    Genoa planning sail Saturday. Ship has sold many passages but has some
                    additional space and has 800 cots. Consular certificate being issued and ship
                    prepared to accommodate passengers aboard ship until boat sails. This
                    information is sent you for the benefit of Americans in your district desiring
                    repatriation and who may desire to avail themselves of the sailing of the <hi
                        rendition="#italic">Washington.</hi>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d89-f1" n="46" type="source" xml:id="d89-f1-content">
                <p>Sent on the same date to the Consul General at Genoa (No. 120), the Ambassador in
                    Italy (No. 118), and the Ministers in Yugoslavia (No. 28) and Hungary (No.
                    97).</p>
            </note>
        </listAnnotation>
    </standOff>
