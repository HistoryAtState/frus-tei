    <text>
        <body>
            <div xml:id="d182">

                <pb facs="0149" n="140" xml:id="pg140"/>

                <note rend="inline" type="source">340.1115A/993: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Consul at Capetown</hi> (<hi rendition="#italic"
                            >Denby</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1940-07-03T18:00:00-04:00">July 3, 1940—6
                            p.m.</date>
                    </dateline>
                </opener>
                <p>Your telegram, June 25, 5 p.m.<anchor n="20" xml:id="d182-f1"/> Department
                    informed that Maritime Commission has authorized carriage of passengers from
                    Capetown on <hi rendition="#italic">President Polk</hi>, sailing July 5.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
