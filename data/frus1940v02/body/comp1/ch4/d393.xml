                <pb facs="0327" n="318" sameAs="frus:frus1940v02/pg318"/>

                <note rend="inline" type="source">500.C115/1412: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Consul General at
                        Geneva</hi> (<hi rendition="#italic">Tittmann</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1940-06-18T18:00:00-04:00">June 18, 1940—6
                            p.m.</date>
                    </dateline>
                </opener>
                <p>67. Your 90, June 14, 8 p.m. From State and Labor:</p>
                <p>Please inform Winant that we regret that it is not possible at this time to
                    extend such an invitation.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
