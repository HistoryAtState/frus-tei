    <text>
        <body>
            <div xml:id="d198">

                <pb facs="0287" n="183" xml:id="pg183"/>

                <note rend="inline" type="source">File No. 893.51/1434.</note>
                <head>
                    <hi rendition="#italic">The American Group to the
                            Secretary of State.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">New York</hi></placeName>, <date
                            calendar="gregorian" when="1913-06-06">
                            <hi rendition="#italic">June 6, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: We beg to enclose herewith, for your
                    information and files, copy of letter received today from the International
                    Banking Corporation quoting a cable received from their London office in regard
                    to the repayment of the Treasury bills from the proceeds of the reorganization
                    loan.</p>
                <p>Yours very truly,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Willard Straight</hi>.</signed>
                </closer>


                <xi:include href="d198-a1.xml" xpointer="d198-a1"/>
