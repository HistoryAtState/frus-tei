    <text>
        <body>
            <div xml:id="d186">

                <pb facs="0272" n="168" sameAs="frus:frus1913/pg168"/>

                <note rend="inline" type="source">File No. 893.51/1383.</note>
                <head>
                    <hi rendition="#italic">The American Chargé d’Affaires to the Secretary of
                        State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 778.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Peking</hi></placeName>, <date
                            calendar="gregorian" when="1913-03-17">
                            <hi rendition="#italic">March 17, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose, for the
                    information and files of the Department, copy in translation of a letter dated
                    March 11, 1913, from the Minister of Finance to the sextuple group relative to
                    the negotiations for the reorganization loan.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">E. T. Williams</hi>.</signed>
                </closer>



                <xi:include href="d186-a1.xml" xpointer="d186-a1"/>
            </div>
