    <text>
        <body>
            <div xml:id="d204">

                <pb facs="0299" n="195" sameAs="frus:frus1913/pg195"/>

                <note rend="inline" type="source">File No. 893.51/1321.</note>
                <head>
                    <hi rendition="#italic">The American Group to the Secretary of State.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">New York</hi></placeName>, <date
                            calendar="gregorian" when="1913-02-25">
                            <hi rendition="#italic">February 25, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: We enclose herewith, for your information,
                    a copy of a letter received by us from Messers. Morgan, Grenfell &amp; Co.,
                    dated February 14th, together with a copy of the memorandum referred to therein,
                    relating to a meeting of the representatives of the four groups and Dr.
                    Vissering in London, on January 11th, 1913.</p>
                <p>Very truly yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Willard Straight</hi>.</signed>
                </closer>



                <xi:include href="d204-a1.xml" xpointer="d204-a1"/>
