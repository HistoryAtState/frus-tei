    <text>
        <body>
            <div xml:id="d120">

                <pb facs="0235" n="131" sameAs="frus:frus1913/pg131"/>

                <note rend="inline" type="source">File No. 893.001Y9/3.</note>
                <head>
                    <hi rendition="#italic">The Chinese Chargé d’Affaires to the Secretary of
                        State.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Legation of China</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-10-06">
                            <hi rendition="#italic">October 6, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to inform you that the
                    Legation is in receipt of a telegram from the Foreign Office stating that the
                    Chinese National Assembly has this day elected the present Provisional
                    President, Yuan Shih Kai, the President of the Republic of China. The telegram
                    further states that the President will be inaugurated on October 10, 1913.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Chang Kang-jen</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
