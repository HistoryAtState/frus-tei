    <text>
        <body>
            <div xml:id="d110">

                <pb facs="0228" n="124" sameAs="frus:frus1913/pg124"/>

                <note rend="inline" type="source">File No. 893.00/1826.</note>
                <head>
                    <hi rendition="#italic">The American Chargé
                            d’Affaires to the Secretary of
                        State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 936.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Peking</hi></placeName>, <date
                            calendar="gregorian" when="1913-07-22">
                            <hi rendition="#italic">July 22, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose, for the
                    information and files of the Department, a copy in translation of a memorandum,
                    dated July 20, 1913, from the Wai Chiao Pu, regarding the present disturbances
                    in the South, and the desire of the Government speedily to restore the country
                    to its normal condition.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">E. T. Williams</hi>.</signed>
                </closer>


                <xi:include href="d110-a1.xml" xpointer="d110-a1"/>
            </div>
        </body>
    </text>
