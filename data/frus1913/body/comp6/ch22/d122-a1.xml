    <text>
        <body>
            <div xml:id="d122-a1">

                <pb facs="0236" n="132" sameAs="frus:frus1913/pg132"/>

                <opener>
                    <seg rendition="#center">[Inclosure—Translation.]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">The Chinese Minister for Foreign
                            Affairs to the American Chargé
                            d’Affaires.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 465.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Foreign Office</hi>, <lb/>
                            <hi rendition="#italic">Peking</hi></placeName>, <date
                            calendar="gregorian" when="1913-10-07">
                            <hi rendition="#italic">October 7, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to inform you that I have
                    received, simultaneously, notes from the Ministers for Sweden, Spain, Belgium,
                    Russia, Denmark, France, Portugal, Japan, The Netherlands, Great Britain,
                    Austria-Hungary, Italy and Germany, informing me that they are in receipt of
                    instructions from their respective Governments directing them, to accord formal
                    recognition to the Republic of China.</p>
                <p>I have the honor to request that this information be conveyed to the American
                    Government.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Sun Pao Ki</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
