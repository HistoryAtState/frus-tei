    <text>
        <body>
            <div xml:id="d128-a2">

                <pb facs="0239" n="135" xml:id="pg135"/>

                <opener>
                    <seg rendition="#center">[Inclosure 2—Translation.]</seg>
                </opener>
                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <opener>
                    <seg rendition="#float-left">No. 473.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Foreign Office</hi>, <lb/>
                            <hi rendition="#italic">Peking</hi></placeName>, <date
                            calendar="gregorian" when="1913-10-10">
                            <hi rendition="#italic">October 10, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to state that on October
                    8, 1913, I received a telegram from the Federal Council of the Swiss
                    Confederation stating that it was in receipt of instructions from the Government
                    of that nation to extend formal recognition to the Republic of China.</p>
                <p>I have the honor to request that this information be transmitted to the American
                    Government.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Sun Pao Ki</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
