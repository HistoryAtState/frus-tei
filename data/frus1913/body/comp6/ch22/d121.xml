                <pb facs="0235" n="131" sameAs="frus:frus1913/pg131"/>

                <note rend="inline" type="source">File No. 893.001Y9/4.</note>
                <head>
                    <hi rendition="#italic">The Chinese Chargé d’Affaires
                        to the Acting Secretary of State.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Legation of China</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-10-08">
                            <hi rendition="#italic">October 8, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to inform you that the
                    Legation is in receipt of a telegram from the Foreign Office stating that the
                    National Assembly has elected General Li Yuan Hung the Vice President of the
                    Republic of China.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Chang Kang-jen</hi>.</signed>
                </closer>
            </div>
