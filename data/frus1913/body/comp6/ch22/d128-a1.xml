    <text>
        <body>
            <div xml:id="d128-a1">

                <pb facs="0238" n="134" sameAs="frus:frus1913/pg134"/>

                <opener>
                    <seg rendition="#center">[Inclosure 1—Translation.]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">The Chinese Minister for Foreign Affairs to the American
                        Chargé d’Affaires.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 472.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Foreign Office</hi>, <lb/>
                            <hi rendition="#italic">Peking</hi></placeName>, <date
                            calendar="gregorian" when="1913-10-10">
                            <hi rendition="#italic">October 10, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to inform you that on
                    October 9, 1913, I received a note from the British Minister, acting on behalf
                    of Norway, stating that he was in receipt of instructions from the Government of
                    that country directing him to extend formal recognition to the Republic of
                    China.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Sun Pao Ki</hi>.</signed>
                </closer>
            </div>
        </body>
