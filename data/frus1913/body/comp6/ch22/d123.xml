    <text>
        <body>
            <div xml:id="d123">

                <pb facs="0236" n="132" sameAs="frus:frus1913/pg132"/>

                <note rend="inline" type="source">File No. 893.00/1951.</note>
                <head>
                    <hi rendition="#italic">The American Minister to
                            Switzerland to the Secretary of
                        State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Berne</hi></placeName>, <date
                            calendar="gregorian" when="1913-10-08">
                            <hi rendition="#italic">October 8, 1913</hi></date>.</dateline>
                </opener>
                <p>The Republic of China was recognized by the Swiss Government on October 8.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stovall</hi>.</signed>
                </closer>
            </div>
        </body>
