    <text>
        <body>
            <div xml:id="d113">

                <pb facs="0230" n="126" sameAs="frus:frus1913/pg126"/>

                <note rend="inline" type="source">File No. 893.00/1790.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the American Chargé
                        d’Affaires.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-07-28">
                            <hi rendition="#italic">July 28, 1913</hi></date>.</dateline>
                </opener>
                <p>Your views as to strict non-interference at this time are approved by the
                    Department and you will so inform the Consulate.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
