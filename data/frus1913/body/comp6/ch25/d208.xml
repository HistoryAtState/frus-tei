    <text>
        <body>
            <div xml:id="d208">

                <pb facs="0303" n="199" sameAs="frus:frus1913/pg199"/>

                <note rend="inline" type="source">File No. 893.51/1365.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            American Group.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-04-03">
                            <hi rendition="#italic">April 3, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sirs</hi>: I have to acknowledge the receipt of your
                    letter of March 31 on the subject of loans made to the Chinese Government for
                    the education of Chinese students in the United States under the arrangement
                    made following the remission of the Boxer indemnity and in reply to state that
                    the matter will be given due consideration by the Department.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. J. Bryan</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
