    <text>
        <body>
            <div xml:id="d641">

                <pb facs="0675" n="571" sameAs="frus:frus1913/pg571"/>

                <note rend="inline" type="source">File No. 814.51/253.</note>
                <head>
                    <hi rendition="#italic">The American Chargé d’Affaires to the Secretary of
                        State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 441.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Guatemala</hi></placeName>, <date
                            calendar="gregorian" when="1913-05-15">
                            <hi rendition="#italic">May 15, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith a
                    copy, together with a translation, of the agreement between the British
                    bondholders and the Government of Guatemala, referred to in my despatch number
                    438 of May 13.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hugh R. Wilson</hi>.</signed>
                </closer>



                <xi:include href="d641-a1.xml" xpointer="d641-a1"/>
                <xi:include href="d641-a2.xml" xpointer="d641-a2"/>
