                <pb facs="0673" n="569" xml:id="pg569"/>

                <note rend="inline" type="source">File No. 814.51/243.</note>
                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Guatemala</hi></placeName>, <date
                            calendar="gregorian" when="1913-05-06">
                            <hi rendition="#italic">May 6, 1913</hi></date>.</dateline>
                </opener>
                <p>The British Legation has informed me that a British cruiser has arrived at
                    Belize.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wilson</hi>.</signed>
                </closer>
            </div>
