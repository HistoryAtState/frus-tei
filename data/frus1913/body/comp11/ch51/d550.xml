    <text>
        <body>
            <div xml:id="d550">

                <pb facs="0609" n="505" sameAs="frus:frus1913/pg505"/>

                <note rend="inline" type="source">File No. 822.124/276.</note>
                <head>
                    <hi rendition="#italic">The Secretary of War to the
                            Secretary of State.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">War Department</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-03-01">
                            <hi rendition="#italic">March 1, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I have the honor to
                    transmit to you herewith the report of Colonel W. C. Gorgas<anchor n="2"
                        xml:id="d550-f1"/> in regard to sanitary conditions at Guayaquil,
                    Ecuador.</p>
                <p>Very sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Henry L. Stimson</hi>.</signed>
                </closer>


                <xi:include href="d550-a1.xml" xpointer="d550-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d550-f1" n="2" xml:id="d550-f1-content">
                <p>The report is dated at Ancon, Canal Zone, January 9, 1913.</p>
            </note>
        </listAnnotation>
    </standOff>
