    <text>
        <body>
            <div xml:id="d572">

                <pb facs="0627" n="523" sameAs="frus:frus1913/pg523"/>

                <note rend="inline" type="source">File No. 822.5048/1.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the American Minister.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 10.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-09-08">
                            <hi rendition="#italic">September 8, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The Department encloses herewith, for your
                    information, a copy of a personal note from the British Ambassador relating to
                    the alleged traffic at Iquitos in slaves from the Napo river region of
                    Ecuador.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">John E. Osborne</hi>.</signed>
                </closer>


                <xi:include href="d572-a1.xml" xpointer="d572-a1"/>
            </div>
        </body>
    </text>
