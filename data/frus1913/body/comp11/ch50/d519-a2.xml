    <text>
        <body>
            <div xml:id="d519-a2">

                <pb facs="0582" n="478" sameAs="frus:frus1913/pg478"/>

                <opener>
                    <seg rendition="#center">[Inclosure 2—Translation.]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">The Minister for Foreign
                            Affairs to the American Chargé
                            d’Affaires.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 212.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Ministry for Foreign Affairs</hi>, <lb/>
                            <hi rendition="#italic">Quito</hi></placeName>, <date
                            calendar="gregorian" when="1913-02-13">
                            <hi rendition="#italic">February 13, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Confirming my note No. 202, dated the 7th
                    instant, it gives me pleasure to inform you that Dr. Alfredo Baquerizo Moreno,
                    Representative of the President of Ecuador on the Arbitral Tribunal that is to
                    take cognizance of and decide all differences between the Government and the
                    Railroad Company of the South, arrived in the Capital today.</p>
                <p>I avail [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">C. Carrera</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
