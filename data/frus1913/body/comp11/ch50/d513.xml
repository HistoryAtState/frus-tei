    <text>
        <body>
            <div xml:id="d513">

                <pb facs="0577" n="473" sameAs="frus:frus1913/pg473"/>

                <note rend="inline" type="source">File No. 422.11G93/555b.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to Henry L. Janes,
                        American Arbitrator.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-12-14">
                            <hi rendition="#italic">December 14, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: In accordance with your personal request,
                    I enclose herewith for your information a copy and paraphrase of telegraphic
                    instructions <pb facs="0578" n="474" xml:id="pg474"/> transmitted to the
                    American Legation at Quito in connection with the arbitration of the claims of
                    the Guayaquil and Quito Railroad and of the Government of Ecuador, and your
                    designation as arbitrator under the terms of the contract.<anchor n="1"
                        xml:id="d513-f1"/>
                </p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Huntington Wilson</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
