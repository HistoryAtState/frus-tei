    <text>
        <body>
            <div xml:id="d521">

                <pb facs="0584" n="480" sameAs="frus:frus1913/pg480"/>

                <note rend="inline" type="source">File No. 422.11G93/594.</note>
                <head>
                    <hi rendition="#italic">The American Chargé d’Affaires to the Secretary of
                        State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 193.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Quito</hi></placeName>, <date
                            calendar="gregorian" when="1913-02-28">
                            <hi rendition="#italic">February 28, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor, with reference to my
                    despatch No. 189 and to its enclosure, note No. 151 from the Legation to the
                    Ecuadorean Foreign Office, to enclose herewith duplicate copies and translations
                    of note No. 230, dated February 25, 1913, from the Ecuadorean Foreign Office in
                    reply to the Legation’s No. 151 above mentioned.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Rutherfurd Bingham</hi>.</signed>
                </closer>


                <xi:include href="d521-a1.xml" xpointer="d521-a1"/>
            </div>
