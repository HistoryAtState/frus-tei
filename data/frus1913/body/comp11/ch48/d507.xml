    <text>
        <body>
            <div xml:id="d507">

                <pb facs="0575" n="471" sameAs="frus:frus1913/pg471"/>

                <note rend="inline" type="source">File No. 822.032/11.</note>
                <head>
                    <hi rendition="#italic">The American Minister to the
                            Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 19.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Quito</hi></placeName>, <date
                            calendar="gregorian" when="1913-08-13">
                            <hi rendition="#italic">August 13, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith
                    copies of the Message of the President of the Republic to Congress which was
                    read at the first session on August 10th. The message chiefly draws attention to
                    the reforms begun by General Plaza in the general administration of the
                    country.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Montgomery Schuyler</hi>.</signed>
                </closer>


                <xi:include href="d507-a1.xml" xpointer="d507-a1"/>
            </div>
