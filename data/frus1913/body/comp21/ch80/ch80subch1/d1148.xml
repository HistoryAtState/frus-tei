    <text>
        <body>
            <div xml:id="d1148">

                <pb facs="1002" n="898" sameAs="frus:frus1913/pg898"/>

                <note rend="inline" type="source">File No. 312.52/2.</note>
                <head>
                    <hi rendition="#italic">The American Ambassador to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Mexico</hi>
                        </placeName> (<date ana="#date_undated-inferred-from-document-content"
                            calendar="gregorian" notAfter="1913-03-04T23:59:59-05:00"
                            notBefore="1913-03-01T00:00:00-06:36"><hi rendition="#italic">not
                                dated</hi></date><hi rendition="#italic">; received March 4,
                            1913</hi>).</dateline>
                </opener>
                <p>73. I have instructed the Consul at Piedras Negras (Ciudad Porfirio Diaz),
                    Coahuila, to give to Spanish subjects in his district such protection as may be
                    consistent and necessary. This action is taken at the request of the Spanish
                    Minister.</p>
                <closer>
                    <signed>. <hi rendition="#small-caps">Wilson</hi>.</signed>
                </closer>
            </div>
        </body>
