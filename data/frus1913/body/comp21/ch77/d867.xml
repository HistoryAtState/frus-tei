    <text>
        <body>
            <div xml:id="d867">

                <pb facs="0839" n="735" sameAs="frus:frus1913/pg735"/>

                <note rend="inline" type="source">File No. 812.00/6421.</note>
                <head>
                    <hi rendition="#italic">The American Consul at Ciudad
                            Porfirio Díaz to the Secretary of
                        State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Extract.]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 654.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">Ciudad Porfirio Díaz</hi></placeName>, <date
                            calendar="gregorian" when="1913-02-24">
                            <hi rendition="#italic">February 24, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to advise that up to this
                    minute the officials of this city have not received from the Governor of the
                    State of Coahuila anything that indicates that he has recognized the new Mexican
                    administration. * * *</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Luther T. Ellsworth</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
