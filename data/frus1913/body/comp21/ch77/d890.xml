            <div xml:id="d890">

                <pb facs="0850" n="746" sameAs="frus:frus1913/pg746"/>

                <note rend="inline" type="source">File No. 812.00/6436.</note>
                <head>
                    <hi rendition="#italic">The American Vice Consul at Nogales to the Secretary of
                        State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">Nogales</hi></placeName>, <date
                            calendar="gregorian" when="1913-02-28">
                            <hi rendition="#italic">February 28, 1913</hi></date>.</dateline>
                </opener>
                <p>Consular agent at Cananea, Sonora, telegraphs: <quote rend="blockquote">
                        <p>The present state of affairs is very unfavorable. Revolution has broken
                            out. Troops wanted.</p>
                    </quote>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Simpich</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
