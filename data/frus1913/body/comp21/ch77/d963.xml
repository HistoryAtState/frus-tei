    <text>
        <body>
            <div xml:id="d963">

                <pb facs="0893" n="789" sameAs="frus:frus1913/pg789"/>

                <note rend="inline" type="source">File No. 812.00/7392.</note>
                <head>
                    <hi rendition="#italic">The Mexican Chargé d’Affaires to the Secretary of
                        State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Translation.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-04-07">
                            <hi rendition="#italic">April 7, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: In compliance with instructions
                    received from my Government, I have the honor to apply to your excellency with a
                    request that you be pleased to use your good offices to the end that every
                    possible facility be extended to a Mexican Commission composed of eight persons
                    and headed by Licenciado don Ramon Gonzalez Suárez which will go to El Paso,
                    Texas, via Brownsville or Laredo, for the purpose of holding peace conferences
                    there.</p>
                <p>I have pleasure [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Arturo de la Cueva</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
