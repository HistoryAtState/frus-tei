    <text>
        <body>
            <div xml:id="d1050">

                <pb facs="0944" n="840" sameAs="frus:frus1913/pg840"/>

                <note rend="inline" type="source">File No. 812.00/9367.</note>
                <head>
                    <hi rendition="#italic">The American Chargé
                            d’Affaires to the Secretary of
                        State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 2093.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1913-10-14">
                            <hi rendition="#italic">October 14, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith for
                    the Department’s information, a clipping from the Mexican Herald of October 11,
                    1913, in regard to the dissolution of the Mexican Congress.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Nelson O’Shaughnessy</hi>.</signed>
                </closer>




                <xi:include href="d1050-a1.xml" xpointer="d1050-a1"/>
