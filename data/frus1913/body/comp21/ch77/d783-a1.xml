    <text>
        <body>
            <div xml:id="d783-a1">

                <pb facs="0799" n="695" sameAs="frus:frus1913/pg695"/>

                <opener>
                    <seg rendition="#center">[Inclosure—Telegram.]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">The Governor of Texas to the
                            President.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Austin, Texas</hi></placeName>, <date
                            calendar="gregorian" when="1913-01-30">
                            <hi rendition="#italic">January 30, 1913</hi></date>.</dateline>
                </opener>
                <p>Am advised that one thousand rebels under Salazar surrounding Juarez, prospective
                    battle in forty-eight hours. Will you kindly direct necessary steps be taken to
                    prevent firing into El Paso. Please answer.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">O. B. Colquitt</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
