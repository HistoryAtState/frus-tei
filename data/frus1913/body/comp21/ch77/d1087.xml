    <text>
        <body>
            <div xml:id="d1087">

                <pb facs="0960" n="856" xml:id="pg856"/>

                <note rend="inline" type="source">File No. 812.00/9628.</note>
                <head>
                    <hi rendition="#italic">The Constitutionalist Secretary for Foreign Affairs to
                        the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Translation.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Nogales</hi></placeName>, <date
                            calendar="gregorian" when="1913-11-06">
                            <hi rendition="#italic">November 6, 1913</hi></date>.</dateline>
                </opener>
                <p>I have the honor to inform you of the appointment of Señor Roberto V. Pesqueira
                    as Confidential Agent of the Constitutionalist Government at Washington.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Francisco Escudero</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
