    <text>
        <body>
            <div xml:id="d965">

                <pb facs="0894" n="790" sameAs="frus:frus1913/pg790"/>

                <note rend="inline" type="source">File No. 812.00/7071.</note>
                <head>
                    <hi rendition="#italic">The American Minister to Chile to the Secretary of
                        State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Santiago</hi></placeName>, <date
                            calendar="gregorian" when="1913-04-10">
                            <hi rendition="#italic">April 10, 1913</hi></date>.</dateline>
                </opener>
                <p>The Minister for Foreign Affairs informs me that the action of Chile in regard to
                    recognition of the Mexican Government will largely conform to that of the United
                    States.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Fletcher</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
