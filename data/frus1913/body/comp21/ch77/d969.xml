        <body>
            <div xml:id="d969">

                <pb facs="0895" n="791" sameAs="frus:frus1913/pg791"/>

                <note rend="inline" type="source">File No. 812.00/7253.</note>
                <head>
                    <hi rendition="#italic">The American Ambassador to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1924.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1913-04-15">
                            <hi rendition="#italic">April 15, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Supplementing my despatch No. 1917 of
                    April 2, 1913, in which I transmitted copies of correspondence exchanged with
                    the Minister for Foreign Affairs of the Provisional Government of Mexico
                    relative to the continuance of American war vessels in the port of Vera Cruz, I
                    have the honor to transmit herewith further correspondence in the matter.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Henry Lane Wilson</hi>.</signed>
                </closer>






