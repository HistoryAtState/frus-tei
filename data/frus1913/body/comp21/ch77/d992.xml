    <text>
        <body>
            <div xml:id="d992">

                <pb facs="0909" n="805" sameAs="frus:frus1913/pg805"/>

                <head>
                    <hi rendition="#italic">The American Ambassador to
                        the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegrams—Paraphrases.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1913-05-21T17:00:00-06:36">
                            <hi rendition="#italic">May 21, 1913—5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>245. The Provisional Government of Mexico has today been formally recognized by
                    the Governments of Belgium and Guatemala.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Henry Lane Wilson</hi>.</signed>
                </closer>
            </div>
        </body>
