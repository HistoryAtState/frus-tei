                <pb facs="0955" n="851" sameAs="frus:frus1913/pg851"/>

                <note rend="inline" type="source">File No. 812.00/9361.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            American Ambassador to Great Britain.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-10-27">
                            <hi rendition="#italic">October 27, 1913</hi></date>.</dateline>
                </opener>
                <p>Your October 24, 8 p.m., is sufficiently covered for the present by your October
                    27, 2 p.m.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi>.</signed>
                </closer>
            </div>
        </body>
