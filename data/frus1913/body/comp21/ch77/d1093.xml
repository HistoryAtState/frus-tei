    <text>
        <body>
            <div xml:id="d1093">

                <pb facs="0962" n="858" sameAs="frus:frus1913/pg858"/>

                <note rend="inline" type="source">File No. 812.00/9632.</note>
                <head>
                    <hi rendition="#italic">The American Ambassador to Brazil to the Secretary of
                        State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Rio de Janeiro</hi></placeName>, <date
                            calendar="gregorian" when="1913-11-09T12:00:00-03:06">
                            <hi rendition="#italic">Nov. 9, 1913—noon</hi></date>.</dateline>
                </opener>
                <p>Department’s November 8, 11 p.m.<anchor n="1" xml:id="d1093-f1"/> The Brazilian
                    Minister to Mexico has been instructed by telegraph as you suggest.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Morgan</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
