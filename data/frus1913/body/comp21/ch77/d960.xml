    <text>
        <body>
            <div xml:id="d960">

                <pb facs="0892" n="788" sameAs="frus:frus1913/pg788"/>

                <note rend="inline" type="source">File No. 812.00/7011.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            American Ambassador.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-04-05">
                            <hi rendition="#italic">April 5, 1913</hi></date>.</dateline>
                </opener>
                <p>171. The Department assumes that such action as you have taken on your own
                    initiative in regard to General Angeles, as reported in your April 4, 1 p.m., is
                    based solely on humanitarian grounds and is entirely informal and
                    unofficial.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
