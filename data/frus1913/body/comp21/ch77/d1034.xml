    <text>
        <body>
            <div xml:id="d1034">

                <pb facs="0933" n="829" sameAs="frus:frus1913/pg829"/>

                <head>
                    <hi rendition="#italic">The American Minister to
                            Salvador to the Secretary of
                        State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 327.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">San Salvador</hi></placeName>, <date
                            calendar="gregorian" when="1913-09-02">
                            <hi rendition="#italic">September 2, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to report due compliance
                    with the requirements of the Department’s telegram of August 28, 2 p.m.</p>
                <p>I respectfully inclose a copy and translation of the pleasing response of the
                    Minister for Foreign Affairs, dated today.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">William Heimké</hi>.</signed>
                </closer>



                <xi:include href="d1034-a1.xml" xpointer="d1034-a1"/>
            </div>
        </body>
    </text>
