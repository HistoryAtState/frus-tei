                <pb facs="0912" n="808" sameAs="frus:frus1913/pg808"/>

                <note rend="inline" type="source">File No. 812.002/29.</note>
                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1913-07-08T19:00:00-06:36">
                            <hi rendition="#italic">July 8, 1913—7 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>315. De la Barra resigned the position of Minister of Foreign Affairs today. The
                    Department should advise me as to my attitude toward the new Minister. I have
                    not yet ascertained the cause of De la Barra’s resignation.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Henry Lane Wilson</hi>.</signed>
                </closer>
            </div>
