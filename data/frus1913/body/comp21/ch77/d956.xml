    <text>
        <body>
            <div xml:id="d956">

                <pb facs="0889" n="785" sameAs="frus:frus1913/pg785"/>

                <note rend="inline" type="source">File No. 812.00/7109.</note>
                <head>
                    <hi rendition="#italic">The American Ambassador to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1917.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1913-04-02">
                            <hi rendition="#italic">April 2, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: For the information of the Department I
                    have the honor to transmit herewith copies of the correspondence exchanged with
                    the Minister for Foreign Affairs of the Provisional Government of Mexico
                    relative to the retention of American war vessels in Mexican waters.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Henry Lane Wilson</hi>.</signed>
                </closer>





