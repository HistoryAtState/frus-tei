    <text>
        <body>
            <div xml:id="d1080">

                <pb facs="0956" n="852" sameAs="frus:frus1913/pg852"/>

                <note rend="inline" type="source">File No. 812.00/9402.</note>
                <head>
                    <hi rendition="#italic">The American Ambassador to Japan to the Secretary of
                        State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Tokio</hi></placeName>, <date
                            calendar="gregorian" when="1913-10-27">
                            <hi rendition="#italic">October 27, 1913</hi></date>.</dateline>
                </opener>
                <p>Your October 24, 6 p.m. The Minister for Foreign Affairs would like to receive as
                    soon as possible a statement of our Government’s position.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Guthrie</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
