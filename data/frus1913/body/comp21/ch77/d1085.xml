    <text>
        <body>
            <div xml:id="d1085">

                <pb facs="0959" n="855" sameAs="frus:frus1913/pg855"/>

                <note rend="inline" type="source">File No. 812.00/9455.</note>
                <head>
                    <hi rendition="#italic">The American Ambassador to Italy to the Secretary of
                        State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Rome</hi></placeName>, <date
                            calendar="gregorian" when="1913-10-29">
                            <hi rendition="#italic">October 29, 1913</hi></date>.</dateline>
                </opener>
                <p>Department’s October 24:, 6 p.m. Italy’s representatives in Mexico and at
                    Washington are being instructed to cooperate as far as possible in furtherance
                    of our Government’s views.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Nelson Page</hi>.</signed>
                </closer>
            </div>
        </body>
