    <text>
        <body>
            <div xml:id="d783">

                <pb facs="0799" n="695" sameAs="frus:frus1913/pg695"/>

                <note rend="inline" type="source">File No. 812.00/6019.</note>
                <head>
                    <hi rendition="#italic">The President’s Secretary to the Secretary of
                        State.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">The White House</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-01-30">
                            <hi rendition="#italic">January 30, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Secretary</hi>: The President directs me to
                    send you for attention the enclosed copy of a telegram from Governor
                    Colquitt.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Charles D. Hilles</hi>.</signed>
                </closer>


                <xi:include href="d783-a1.xml" xpointer="d783-a1"/>
