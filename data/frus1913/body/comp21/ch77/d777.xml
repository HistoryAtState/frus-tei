    <text>
        <body>
            <div xml:id="d777">

                <pb facs="0797" n="693" sameAs="frus:frus1913/pg693"/>

                <note rend="inline" type="source">File No. 312.112F821/9.</note>
                <head>
                    <hi rendition="#italic">The American Ambassador to
                        the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1913-01-11">
                            <hi rendition="#italic">January 11, 1913</hi></date>.</dateline>
                </opener>
                <p>Francisco Villa is reported in the local papers to be in El Paso.<anchor n="1"
                        xml:id="d777-f1"/> Villa was a former Federal leader and ex-bandit who has
                    been in prison in Mexico City for the murder of Fountain and for other
                    anti-American activities, as a result of the Embassy’s representations last
                    spring.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wilson</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d777-f1" n="1" xml:id="d777-f1-content">
                <p>Confirmed on January 14 by the American Consul at Ciudad Juarez. File no.
                    312.11F821/10.</p>
            </note>
        </listAnnotation>
    </standOff>
