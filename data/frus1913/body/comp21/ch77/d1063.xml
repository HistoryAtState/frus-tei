                <pb facs="0951" n="847" sameAs="frus:frus1913/pg847"/>

                <note rend="inline" type="source">File No. 812.00/9305.</note>
                <head>
                    <hi rendition="#italic">The American Minister to
                            Argentina to the Secretary of
                        State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Buenos Aires</hi></placeName>, <date
                            calendar="gregorian" when="1913-10-21">
                            <hi rendition="#italic">October 21, 1913</hi></date>.</dateline>
                </opener>
                <p>Your October 14, 7 p.m. The Acting President expresses sympathy in the difficult
                    situation but carefully refrains from making any comment.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Garrett</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
