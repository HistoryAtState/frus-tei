    <text>
        <body>
            <div xml:id="d1203">

                <pb facs="1027" n="923" xml:id="pg923"/>

                <note rend="inline" type="source">File No. 312.93/55.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Chinese Chargé
                        d’Affaires.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 262.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-12-16">
                            <hi rendition="#italic">December 16, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The Department has received a telegram
                    dated the 10th instant from the American Consul at Mazatlan in which he informs
                    it that Chinese residents in Mazatlan have asked his advice and that he has
                    advised them in case of danger to concentrate in a building which they have
                    taken near the Consulate and where they have stored nearly half a million
                    dollars’ worth of merchandise.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">J. B. Moore</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
