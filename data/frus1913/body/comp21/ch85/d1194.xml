    <text>
        <body>
            <div xml:id="d1194">

                <pb facs="1023" n="919" sameAs="frus:frus1913/pg919"/>

                <note rend="inline" type="source">File No. 312.93/48.</note>
                <head>
                    <hi rendition="#italic">The American Chargé d’Affaires at Peking to the
                        Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1002.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Peking</hi></placeName>, <date
                            calendar="gregorian" when="1913-09-10">
                            <hi rendition="#italic">September 10, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose copy in
                    translation of a note dated the 9th instant from the Ministry of Foreign
                    Affairs, informing the Legation that the Chinese Chargé d’Affaires at Washington
                    has been instructed to express the appreciation of the Chinese <pb facs="1024"
                        n="920" xml:id="pg920"/> Government for the protection afforded by the
                    American consular representatives in Mexico to Chinese residents.</p>
                <p>I have [etc]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">E. T. Williams</hi>.</signed>
                </closer>


                <xi:include href="d1194-a1.xml" xpointer="d1194-a1"/>
            </div>
        </body>
    </text>
