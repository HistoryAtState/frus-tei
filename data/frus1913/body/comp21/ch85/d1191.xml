    <text>
        <body>
            <div xml:id="d1191">

                <pb facs="1022" n="918" sameAs="frus:frus1913/pg918"/>

                <note rend="inline" type="source">File No. 812.00/8021.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of the
                            Navy to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Extract.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Navy Department</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-07-10">
                            <hi rendition="#italic">July 10, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to forward herewith for
                    the information of the Department of State copy of a telegram dated the 9th
                    instant received from the Commander-in-Chief of the Pacific Fleet, at Guaymas,
                    Mexico, reporting on conditions in that vicinity.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">F. D. Roosevelt</hi>.</signed>
                </closer>


                <xi:include href="d1191-a1.xml" xpointer="d1191-a1"/>
            </div>
