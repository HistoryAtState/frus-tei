    <text>
        <body>
            <div xml:id="d1202">

                <pb facs="1026" n="922" sameAs="frus:frus1913/pg922"/>

                <note rend="inline" type="source">File No. 312.93/53.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            American Consul General at Monterey.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-11-03">
                            <hi rendition="#italic">November 3, 1913</hi></date>.</dateline>
                </opener>
                <p>Chinese Legation here requests that you give such assistance as may be necessary
                    to destitute Chinese. Please comply, keeping separate account of such
                    expenditures in order that a bill may be submitted to Chinese Legation for
                    reimbursement.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
