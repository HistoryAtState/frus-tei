            <div xml:id="d1293">

                <pb facs="1096" n="992" sameAs="frus:frus1913/pg992"/>

                <note rend="inline" type="source">File No. 711.1216 M/420a.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the American
                        Ambassador.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-05-02">
                            <hi rendition="#italic">May 2, 1913</hi></date>.</dateline>
                </opener>
                <p>Colorado River. Has the Foreign Office accepted changes proposed to its counter
                    draft indicated in Department’s amended convention inclosed in Department’s
                    instruction of February 8, 1913?</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Moore</hi>.</signed>
                </closer>
            </div>
        </body>
