    <text>
        <body>
            <div xml:id="d1239">

                <pb facs="1061" n="957" sameAs="frus:frus1913/pg957"/>

                <note rend="inline" type="source">File No. 711.1215/374.</note>
                <head>
                    <hi rendition="#italic">The Mexican Ambassador to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 510.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1911-10-12">
                            <hi rendition="#italic">October 12, 1911.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: The memorandum<anchor n="3"
                        xml:id="d1239-f1"/> of the Department of State, replying to that of this
                    Embassy dated September 12, concerning the Chamizal award, was received
                    today.</p>
                <p>I am communicating its contents to the Ministry of Foreign Relations and am
                    awaiting instructions before addressing your excellency again on the
                    subject.</p>
                <p>Meanwhile I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Gilberto Crespo y Martínez</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1239-f1" n="3" xml:id="d1239-f1-content">
                <p>
                    <ref target="frus1911#pg_604">For Rel. 1911, pp. 604</ref>–<ref
                        target="frus1911#pg_605">605</ref>. The memorandum under acknowledgment is
                    that of October 6, 1911.</p>
            </note>
        </listAnnotation>
    </standOff>
