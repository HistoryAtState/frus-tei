    <text>
        <body>
            <div xml:id="d1258">

                <pb facs="1071" n="967" sameAs="frus:frus1913/pg967"/>

                <note rend="inline" type="source">File No. 711.1215/423.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Mexican Ambassador.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-06-06">
                            <hi rendition="#italic">June 6, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: I have the honor to acknowledge the
                    receipt of Señor de la Cueva’s note of the 9th ultimo, by which he informs the
                    Department that your excellency holds the instructions and powers necessary to
                    take charge of the negotiations relating to the final settlement of the Chamizal
                    case, and beg to say in reply that due note has been taken of Señor de la
                    Cueva’s statement.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">P. C. Knox</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
