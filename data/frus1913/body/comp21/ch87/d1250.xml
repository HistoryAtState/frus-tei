    <text>
        <body>
            <div xml:id="d1250">

                <pb facs="1068" n="964" xml:id="pg964"/>

                <note rend="inline" type="source">File No. 711.1215/406.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            Officer of the United States in charge of the
                            maintenance of the status quo in the Chamizal Tract.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-02-07">
                            <hi rendition="#italic">February 7, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I enclose herewith for your information a
                    copy of a note<anchor n="1" xml:id="d1250-f1"/> from the Ambassador of Mexico at
                    this capital, stating that the Government of Mexico is of the opinion that there
                    was no violation of the status quo in the Chamizal Tract in the recent ejection
                    of occupants of land therein intended for the Pearson establishment.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">P. C. Knox</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1250-f1" n="1" xml:id="d1250-f1-content">
