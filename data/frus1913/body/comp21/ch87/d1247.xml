    <text>
        <body>
            <div xml:id="d1247">

                <pb facs="1065" n="961" sameAs="frus:frus1913/pg961"/>

                <note rend="inline" type="source">File No. 711.1215/395.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            Secretary of the International Boundary
                            Commission.</hi><anchor n="1" xml:id="d1247-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1911-12-20">
                            <hi rendition="#italic">December 20, 1911</hi></date>.</dateline>
                </opener>
                <p>Communicate the text of your telegraphic reports of December 14 and 18 to the
                    Mexican Commissioner, Puga.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Knox</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1247-f1" n="1" type="source" xml:id="d1247-f1-content">
                <p>See the title given Mr. Keblinger in the telegram of February 7, 1912.</p>
            </note>
