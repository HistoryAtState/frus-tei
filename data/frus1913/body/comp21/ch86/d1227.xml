    <text>
        <body>
            <div xml:id="d1227">

                <pb facs="1051" n="947" sameAs="frus:frus1913/pg947"/>

                <note rend="inline" type="source">File No. 812.00/7101.</note>
                <head>
                    <hi rendition="#italic">The American Ambassador to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1914.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1913-04-01">
                            <hi rendition="#italic">April 1, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith for
                    the information of the Department a memorandum of an interview held at the
                    National Palace with the Provisional President of Mexico on March 27, 1913, at 5
                    p.m.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Henry Lane Wilson</hi>.</signed>
                </closer>


                <xi:include href="d1227-a1.xml" xpointer="d1227-a1"/>
            </div>
