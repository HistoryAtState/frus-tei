    <text>
        <body>
            <div xml:id="d1298">

                <pb facs="1112" n="1008" xml:id="pg1008"/>

                <note rend="inline" type="source">File No. 412.11T54/219.</note>
                <head>
                    <hi rendition="#italic">The American Ambassador to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1913-04-29">
                            <hi rendition="#italic">April 29, 1913</hi></date>.</dateline>
                </opener>
                <p>Tlahualilo contract of agreement signed by the Government today<anchor n="1"
                        xml:id="d1298-f1"/> and the case may be considered as absolutely closed.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wilson</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1298-f1" n="1" xml:id="d1298-f1-content">
                <p>The contract was, however, signed the 28th; see post.</p>
            </note>
        </listAnnotation>
    </standOff>
