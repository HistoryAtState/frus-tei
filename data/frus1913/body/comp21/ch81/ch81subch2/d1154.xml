    <text>
        <body>
            <div xml:id="d1154">

                <pb facs="1004" n="900" sameAs="frus:frus1913/pg900"/>

                <note rend="inline" type="source">File No. 312.52/38.</note>
                <head>
                    <hi rendition="#italic">The American Chargé
                            d’Affaires to the Secretary of
                        State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 2099.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1913-10-20">
                            <hi rendition="#italic">October 20, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit to the
                    Department herewith copies as well as translations of two letters received by me
                    under date of October 16th, from the Spanish Minister here. The Spanish Minister
                    has since informed me that several more of the Spaniards have met their death at
                    the hands of the so-called Constitutionalists of the North.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Nelson O’Shaughnessy</hi>.</signed>
                </closer>



                <xi:include href="d1154-a1.xml" xpointer="d1154-a1"/>
                <xi:include href="d1154-a2.xml" xpointer="d1154-a2"/>
            </div>
