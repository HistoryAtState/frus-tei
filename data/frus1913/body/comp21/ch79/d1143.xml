            <div xml:id="d1143">

                <pb facs="1000" n="896" sameAs="frus:frus1913/pg896"/>

                <note rend="inline" type="source">File No.312.11/3047a.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the American Consular Officers in Mexico.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-12-26T18:00:00-05:00">
                            <hi rendition="#italic">December 26, 1913—6 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Prepare and transmit continuation to January 1, 1914, of report called for in
                    first paragraph of instruction of August 8th last.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">J. B. Moore</hi>.</signed>
                </closer>
            </div>
