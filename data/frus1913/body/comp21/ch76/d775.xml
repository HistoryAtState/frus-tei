    <text>
        <body>
            <div xml:id="d775">

                <pb facs="0795" n="691" sameAs="frus:frus1913/pg691"/>

                <note rend="inline" type="source">File No. 812.032/15.</note>
                <head>
                    <hi rendition="#italic">The American Chargé
                            d’Affaires to the Secretary of
                        State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 2060.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1913-09-17">
                            <hi rendition="#italic">September 17, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: For the informal of the Department, I have
                    the honor to transmit herewith the original text of the message read by the
                    Provisional President of the United Mexican States, at the opening of <pb
                        facs="0796" n="692" xml:id="pg692"/> Congress last night. I also transmit
                    herewith a clipping from the Mexican Herald of today which contains the
                    translation thereof.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Nelson O’Shaughnessy</hi>.</signed>
                </closer>


                <xi:include href="d775-a1.xml" xpointer="d775-a1"/>
            </div>
        </body>
    </text>
