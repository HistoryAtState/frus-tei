    <text>
        <body>
            <div xml:id="d774">

                <pb facs="0795" n="691" sameAs="frus:frus1913/pg691"/>

                <note rend="inline" type="source">File No. 812.032/14.</note>
                <head>
                    <hi rendition="#italic">The American Ambassador to
                        the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1916.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1913-04-02">
                            <hi rendition="#italic">April 2, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith in
                    duplicate the official copy of the Report of the Citizen President of the
                    Republic to the Second Session of the 26th Congress of the United Mexican
                    States, as well as a translation of the same in duplicate taken from the Mexican
                    Herald of this morning.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Henry Lane Wilson</hi>.</signed>
                </closer>


                <xi:include href="d774-a1.xml" xpointer="d774-a1"/>
            </div>
