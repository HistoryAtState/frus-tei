                <pb facs="0574" n="470" sameAs="frus:frus1913/pg470"/>

                <note rend="inline" type="source">File No. 123.R911/79.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the American Minister.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-02-14">
                            <hi rendition="#italic">February 14, 1913</hi></date>.</dateline>
                </opener>
                <p>If you feel disposed to act as arbitrator without compensation, you are
                    authorized to do so.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Knox</hi>.</signed>
                </closer>
            </div>
        </body>
