    <text>
        <body>
            <div xml:id="d483">

                <pb facs="0564" n="460" sameAs="frus:frus1913/pg460"/>

                <note rend="inline" type="source">File No. 839.51/937.</note>
                <head>
                    <hi rendition="#italic">The American Minister to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Santo Domingo</hi></placeName>, <date
                            calendar="gregorian" when="1913-01-22">
                            <hi rendition="#italic">January 22, 1913</hi></date>.</dateline>
                </opener>
                <p>The National City Bank’s loan proposition has been accepted by the Dominican
                    Government on exactly the terms given in your telegram of the 7th instant,
                    except 97½ instead of 96½.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Russell</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
