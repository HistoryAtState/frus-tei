    <text>
        <body>
            <div xml:id="d480">

                <pb facs="0562" n="458" sameAs="frus:frus1913/pg458"/>

                <note rend="inline" type="source">File No. 839.51/919.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            American Minister.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-12-31">
                            <hi rendition="#italic">December 31, 1912</hi></date>.</dateline>
                </opener>
                <p>The Department hopes to cable you soon a contract form now in preparation.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Knox</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
