    <text>
        <body>
            <div xml:id="d407">

                <pb facs="0528" n="424" xml:id="pg424"/>

                <note rend="inline" type="source">File No. 839.001 BG4/1.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the American Chargé
                        d’Affaires.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 147.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-07-08">
                            <hi rendition="#italic">July 8, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I enclose, with office copy, a
                        letter<anchor n="1" xml:id="d407-f1"/> addressed by the President to His
                    Excellency General José Bordas Valdes, acknowledging His Excellency’s letter of
                    April 14, last in which he announced his assumption of the Presidency of the
                    Dominican Republic, and his entrance upon the duties of that office.</p>
                <p>I am [etc.]</p>
                <closer>(For the Secretary of State:) <lb/>
                    <signed>
                        <hi rendition="#small-caps">J. B. Moore</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
