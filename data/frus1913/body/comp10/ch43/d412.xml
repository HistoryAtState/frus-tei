                <pb facs="0529" n="425" sameAs="frus:frus1913/pg425"/>

                <note rend="inline" type="source">File No. 839.00/861.</note>
                <head>
                    <hi rendition="#italic">The American Vice Consul at Puerto
                            Plata to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Puerto Plata</hi></placeName>, <date
                            calendar="gregorian" when="1913-09-06T12:00:00-04:40">
                            <hi rendition="#italic">September 6, 1913—12 m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Telegraphic communication with Santo Domingo cut off. Dominican gunboats are
                    shelling Puerto Plata, endangering the lives and property of Americans.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Esteva</hi>.</signed>
                </closer>
            </div>
        </body>
