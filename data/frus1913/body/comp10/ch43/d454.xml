                <pb facs="0545" n="441" sameAs="frus:frus1913/pg441"/>

                <note rend="inline" type="source">File No. 839.00/1001a, 1001b and 1001c.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Representatives of the Department of State appointed to observe the
                        Dominican elections: Hugh S. Gibson, Frederick A.
                            Sterling and Jordan Herbert Stabler.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Identic Instruction.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-12-06">
                            <hi rendition="#italic">December 6, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: You will proceed via Key West and Habana
                    to Santiago de Cuba where you will board the <hi rendition="#italic"
                        >Nashville</hi> and proceed to Santo Domingo where you will report to the
                    American Minister and act under his instructions.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. J. Bryan</hi>.</signed>
                </closer>
            </div>
        </body>
