    <text>
        <body>
            <div xml:id="d437">

                <pb facs="0538" n="434" sameAs="frus:frus1913/pg434"/>

                <note rend="inline" type="source">File No. 839.00/977.</note>
                <head>
                    <hi rendition="#italic">The Minister of the Dominican Republic to the Secretary
                        of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Translation.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Dominican Legation</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-10-15">
                            <hi rendition="#italic">October 15, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Secretary</hi>: I have the honor to inform you
                    that the Dominican Government having recovered the Province of Samaná, and the
                    state of rebellion that caused the blockade and closure of the ports of Samaná
                    and Sánchez having come to an end, those two ports have again been opened to
                    commerce and the blockade has been raised there.</p>
                <p>I avail [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Fran’co J. Peynado</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
