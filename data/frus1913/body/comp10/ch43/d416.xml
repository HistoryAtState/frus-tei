    <text>
        <body>
            <div xml:id="d416">

                <pb facs="0531" n="427" xml:id="pg427"/>

                <note rend="inline" type="source">File No. 839.00/868.</note>
                <head>
                    <hi rendition="#italic">The Vice Consul at Puerto
                            Plata to the Secretary of
                    State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Puerto Plata</hi></placeName>, <date
                            calendar="gregorian" when="1913-09-12">
                            <hi rendition="#italic">September 12, 1913</hi></date>.</dateline>
                </opener>
                <p>Your instruction of September 10 has been complied with, jointly with Commander
                    Long. We notified Céspedes and Vásquez.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Esteva</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
