    <text>
        <body>
            <div xml:id="d419">

                <pb facs="0532" n="428" xml:id="pg428"/>

                <note rend="inline" type="source">File No. 839.00/875.</note>
                <head>
                    <hi rendition="#italic">The American Vice Consul at Puerto Plata to the
                        Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#italic">Puerto Plata</hi></placeName>, <date
                            calendar="gregorian" when="1913-09-16">
                            <hi rendition="#italic">September 16, 1913</hi></date>.</dateline>
                </opener>
                <p>Engagement at Navarrete reported in favor of revolutionists who are now attacking
                    Las Lagunas.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Esteva</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
