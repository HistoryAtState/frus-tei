    <text>
        <body>
            <div xml:id="d396">

                <pb facs="0526" n="422" sameAs="frus:frus1913/pg422"/>

                <note rend="inline" type="source">File No. 839.00/812.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the American Chargé
                        d’Affaires.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-03-24">
                            <hi rendition="#italic">March 24, 1913</hi></date>.</dateline>
                </opener>
                <p>The revenue cutter <hi rendition="#italic">Algonquin</hi> will proceed at once to
                    Dominican waters to establish radio communication with the <hi
                        rendition="#italic">Wheeling</hi>.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Adee</hi>.</signed>
                </closer>
            </div>
        </body>
