                <pb facs="0572" n="468" sameAs="frus:frus1913/pg468"/>

                <note rend="inline" type="source">File No. 738.3915/188.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            Minister of the Dominican Republic.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-02-11">
                            <hi rendition="#italic">February 11, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the
                    receipt of your note of the 31st ultimo enclosing a copy of a note [etc.]</p>
                <p>In reply I have the honor to inform you that your note and its enclosure will
                    receive the Department’s consideration.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">P. C. Knox</hi>.</signed>
                </closer>
            </div>
        </body>
