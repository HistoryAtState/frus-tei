            <div xml:id="d386">

                <pb facs="0521" n="417" sameAs="frus:frus1913/pg417"/>

                <note rend="inline" type="source">File No. 839.032/6.</note>
                <head>
                    <hi rendition="#italic">The American Minister to the
                            Secretary of State.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Santo Domingo</hi></placeName>, <date
                            calendar="gregorian" when="1913-03-15">
                            <hi rendition="#italic">March 15, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith a
                    copy in Spanish text of the message which the Provisional President of the
                    Republic, Archbishop Nouel, presented to Congress convened in ordinary session
                    on February 27th.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">William W. Russell</hi>.</signed>
                </closer>


                <xi:include href="d386-a1.xml" xpointer="d386-a1"/>
            </div>
