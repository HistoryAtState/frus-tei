                <pb facs="0639" n="535" sameAs="frus:frus1913/pg535"/>

                <note rend="inline" type="source">File No. 731.51/50.</note>
                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <opener>
                    <seg rendition="#float-left">No. 142.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Caracas</hi></placeName>, <date
                            calendar="gregorian" when="1913-02-14">
                            <hi rendition="#italic">February 14, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith
                    copies and translations of a note received by me from the Minister of Foreign
                    Affairs on February 13, 1913.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Jefferson Caffery</hi>.</signed>
                </closer>


