            <div xml:id="d593">

                <pb facs="0641" n="537" sameAs="frus:frus1913/pg537"/>

                <note rend="inline" type="source">File No. 731.51/53.</note>
                <head>
                    <hi rendition="#italic">The American Minister to the
                            Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 165.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Caracas</hi></placeName>, <date
                            calendar="gregorian" when="1913-03-25">
                            <hi rendition="#italic">March 25, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith copy
                    and translation of the protocol signed for the renewal of relations between
                    France and Venezuela.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Elliott Northcott</hi>.</signed>
                </closer>


                <xi:include href="d593-a1.xml" xpointer="d593-a1"/>
