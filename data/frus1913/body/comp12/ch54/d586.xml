    <text>
        <body>
            <div xml:id="d586">

                <pb facs="0638" n="534" sameAs="frus:frus1913/pg534"/>

                <note rend="inline" type="source">File No. 731.51/44.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the American Chargé
                        d’Affaires.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-12-24">
                            <hi rendition="#italic">December 24, 1912</hi></date>.</dateline>
                </opener>
                <p>You may inform the Government that the French plenipotentiary will arrive at
                    Caracas January 20.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wilson</hi>.</signed>
                </closer>
            </div>
        </body>
