    <text>
        <body>
            <div xml:id="d590">

                <pb facs="0640" n="536" xml:id="pg536"/>

                <note rend="inline" type="source">File No. 731./52.</note>
                <head>
                    <hi rendition="#italic">The American Chargé
                            d’Affaires to the Secretary of
                        State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 152.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Caracas</hi></placeName>, <date
                            calendar="gregorian" when="1913-02-19">
                            <hi rendition="#italic">February 19, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to state that Baron
                    d’Avril, the French Plenipotentiary, called at the Legation and said that he was
                    charged by his Government to express appreciation of the part played by the
                    American Government in the negotiations leading up to the signing of the
                    Protocol for the renewal of relations between the two countries.</p>
                <p>I have the honor to enclose herewith copies and translations of a note received
                    by me from M. d’Avril in this regard.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Jefferson Caffery</hi>.</signed>
                </closer>


                <xi:include href="d590-a1.xml" xpointer="d590-a1"/>
            </div>
        </body>
    </text>
