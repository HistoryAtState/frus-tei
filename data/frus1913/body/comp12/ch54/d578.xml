    <text>
        <body>
            <div xml:id="d578">

                <pb facs="0633" n="529" sameAs="frus:frus1913/pg529"/>

                <note rend="inline" type="source">File No. 731.51/32.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the American Minister to
                        Venezuela.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 14.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-07-03">
                            <hi rendition="#italic">July 3, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to your telegram of June 3,
                    regarding the relations between France and Venezuela, the Department encloses
                        <pb facs="0634" n="530" xml:id="pg530"/> therewith for information of copy
                    and translation of memorandum from the French Embassy left at the Department on
                    March 6, 1912.</p>
                <p>The Department was informed by the Secretary of the French Embassy, on June 28th,
                    that the attitude of the French Government continues as described in the
                    enclosed memorandum.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">P. C. Knox</hi>.</signed>
                </closer>


                <xi:include href="d578-a1.xml" xpointer="d578-a1"/>
            </div>
        </body>
    </text>
