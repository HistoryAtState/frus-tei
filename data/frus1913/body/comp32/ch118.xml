                <pb facs="1467" n="1363" xml:id="pg1363"/>

                <head>Convention and Final Protocol between the United States and other Powers for
                    the Protection of Industrial Property (replacing the Paris Convention and Final
                    Protocol of March 20, 1883, the Protocol of Madrid of April 15, 1891, and the
                    Additional Act signed at Brussels on December 14, 1900) signed at Washington,
                    June 2, 1911<anchor n="1" xml:id="ch118-f1"/>
                </head>
                <p rendition="#flush">
                    <hi rendition="#italic">Signed at Washington, June 2, 1911; ratification advised
                        by the Senate, February 6, 1912; ratified by the President, June 20, 1912;
                        ratifications deposited with the Government of the United States, April 1,
                        1913; proclaimed, April 29, 1913.</hi>
                </p>

