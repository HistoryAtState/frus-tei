                <pb facs="1479" n="1375" xml:id="pg1375"/>

                <head>Radiotelegraph Convention between the United States and other Powers; Final
                    Protocol; Service Regulations and Supplements thereto; signed at London, July 5,
                        1912<anchor n="1" xml:id="ch119-f1"/>
                </head>
                <p rendition="#flush">
                    <hi rendition="#italic">Signed at London, July 5, 1912; ratification advised by
                        the Senate, January 22, 1913; ratified by the President, February 5, 1913;
                        ratification of the United States deposited with the Government of Great
                        Britain, February 20, 1913; proclaimed, July 8, 1913.</hi>
                </p>

