    <text>
        <body>
            <div xml:id="d1686">

                <pb facs="1431" n="1327" sameAs="frus:frus1913/pg1327"/>

                <note rend="inline" type="source">File No. 367.114M69/159.</note>
                <head>
                    <hi rendition="#italic">The American Ambassador to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 247.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Constantinople</hi></placeName>, <date
                            calendar="gregorian" when="1912-07-18">
                            <hi rendition="#italic">July 18, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: In confirmation of my telegram of July
                    16th, I have the honor to enclose herewith copy with translation of the note
                    received from the Minister for Foreign Affairs on the subject of the
                    jurisdiction and trial of captain of the <hi rendition="#italic">Texas.</hi>
                </p>
                <p>I shall forward copy of my reply as soon as it has been communicated to the
                    Sublime Porte.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. W. Rockhill</hi>.</signed>
                </closer>


                <xi:include href="d1686-a1.xml" xpointer="d1686-a1"/>
            </div>
        </body>
    </text>
