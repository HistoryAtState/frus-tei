    <text>
        <body>
            <div xml:id="d1691">

                <pb facs="1438" n="1334" xml:id="pg1334"/>

                <note rend="inline" type="source">File No. 367.114M69/172.</note>
                <head>
                    <hi rendition="#italic">The American Consul General at
                            Smyrna to the Secretary of State.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate General</hi>, <lb/>
                            <hi rendition="#italic">Smyrna</hi></placeName>, <date
                            calendar="gregorian" when="1912-10-22">
                            <hi rendition="#italic">October 22, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to hand herewith to the
                    Department a copy of a despatch I have this day addressed to the Embassy at
                    Constantinople, regarding the present status of the case of the captain of S. S.
                        <hi rendition="#italic">Texas</hi> before the Ottoman court.<anchor n="1"
                        xml:id="d1691-f1"/>
                </p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">George Horton</hi>.</signed>
                </closer>



                <xi:include href="d1691-a1.xml" xpointer="d1691-a1"/>
                <xi:include href="d1691-a2.xml" xpointer="d1691-a2"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1691-f1" n="1" xml:id="d1691-f1-content">
                <p>Inclosure 2 is attached to this despatch although not mentioned.</p>
            </note>
        </listAnnotation>
