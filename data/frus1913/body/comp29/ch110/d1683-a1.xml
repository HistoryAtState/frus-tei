            <div xml:id="d1683-a1">

                <pb facs="1429" n="1325" sameAs="frus:frus1913/pg1325"/>

                <opener>
                    <seg rendition="#center">[Inclosure 1.]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">The American Consul General at Smyrna to the American
                        Embassy.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">Smyrna</hi></placeName>, <date
                            calendar="gregorian" when="1912-07-09">
                            <hi rendition="#italic">July 9, 1912</hi></date>.</dateline>
                </opener>
                <p>Trial <hi rendition="#italic">Texas</hi> Captain commenced in Turkish penal
                    court. Cable instructions.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Horton</hi>.</signed>
                </closer>
            </div>
        </body>
