                <pb facs="1425" n="1321" sameAs="frus:frus1913/pg1321"/>

                <note rend="inline" type="source">File No. 367.114M69/141.</note>
                <head>
                    <hi rendition="#italic">The American Consul General at
                            Smyrna to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate General</hi>, <lb/>
                            <hi rendition="#italic">Smyrna</hi></placeName>, <date
                            calendar="gregorian" when="1912-06-26">
                            <hi rendition="#italic">June 26, 1912</hi></date>.</dateline>
                </opener>
                <p>The Captain of the <hi rendition="#italic">Texas</hi> has been removed from the
                    hospital prison and thrown into the common prison of condemned criminals.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Horton</hi>.</signed>
                </closer>
            </div>
        </body>
