    <text>
        <body>
            <div xml:id="d1661">

                <pb facs="1415" n="1311" sameAs="frus:frus1913/pg1311"/>

                <note rend="inline" type="source">File No. 367.114M69/118.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the American
                        Ambassador.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-05-03">
                            <hi rendition="#italic">May 3, 1912</hi></date>.</dateline>
                </opener>
                <p>You may send the Commander of the <hi rendition="#italic">Scorpion</hi> and a
                    member of the Embassy to Smyrna to investigate <hi rendition="#italic"
                        >Texas</hi> matter.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wilson</hi>.</signed>
                </closer>
            </div>
        </body>
