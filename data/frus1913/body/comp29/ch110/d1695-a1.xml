    <text>
        <body>
            <div xml:id="d1695-a1">

                <pb facs="1441" n="1337" sameAs="frus:frus1913/pg1337"/>

                <opener>
                    <seg rendition="#center">[Inclosure 1—Telegram.]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">The American Consul General at
                            Smyrna to the American Ambassador.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate General</hi>, <lb/>
                            <hi rendition="#italic">Smyrna</hi></placeName>, <date
                            calendar="gregorian" when="1912-11-10">
                            <hi rendition="#italic">November 10, 1912</hi></date>.</dateline>
                </opener>
                <p>Captain of the <hi rendition="#italic">Texas</hi> has been condemned to eighteen
                    months imprisonment. Telegraph instructions.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Horton</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
