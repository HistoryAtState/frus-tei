    <text>
        <body>
            <div xml:id="d1685">

                <pb facs="1431" n="1327" sameAs="frus:frus1913/pg1327"/>

                <note rend="inline" type="source">File No. 367.114M69/153.</note>
                <head>
                    <hi rendition="#italic">The American Ambassador to
                        the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Extract.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Pera</hi></placeName>, <date
                            calendar="gregorian" when="1912-07-16">
                            <hi rendition="#italic">July 16, 1912</hi></date>.</dateline>
                </opener>
                <p>I have received from the Minister for Foreign Affairs today reply to my various
                    notes concerning our claim of jurisdiction over Captain steamship <hi
                        rendition="#italic">Texas</hi> and request for surrender.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Rockhill</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
