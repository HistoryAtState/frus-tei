    <text>
        <body>
            <div xml:id="d1702">

                <pb facs="1448" n="1344" sameAs="frus:frus1913/pg1344"/>

                <note rend="inline" type="source">File No. 367.11/152.</note>
                <head>
                    <hi rendition="#italic">The American Ambassador to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 494.</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Constantinople</hi></placeName>, <date
                            calendar="gregorian" when="1913-06-06">
                            <hi rendition="#italic">June 6, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to my despatch No. 481 of April
                    29, 1913, on the subject of requisitions for war purposes, I have the honor to
                    enclose herewith a copy and translation of an identic note verbale sent by the
                    diplomatic missions to the Sublime Porte in reply to its circular note verbale
                    of April 23, 1913 [Inclosure 4 with despatch No. 481], copy of which was
                    transmitted to the Department in my above-mentioned despatch.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. W. Rockhill</hi>.</signed>
                </closer>


                <xi:include href="d1702-a1.xml" xpointer="d1702-a1"/>
            </div>
