                <pb facs="1414" n="1310" sameAs="frus:frus1913/pg1310"/>

                <note rend="inline" type="source">File No. 767.70/430.</note>
                <head>
                    <hi rendition="#italic">The American Charge d’Affaires at Athens to the
                        Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Athens</hi></placeName>, <date
                            calendar="gregorian" when="1913-11-14">
                            <hi rendition="#italic">November 14, 1913</hi>.</date>
                    </dateline>
                </opener>
                <p>Turkish-Greek treaty signed today.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">De Billier</hi>.</signed>
                </closer>
            </div>
