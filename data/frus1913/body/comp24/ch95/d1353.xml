    <text>
        <body>
            <div xml:id="d1353">

                <pb facs="1160" n="1056" xml:id="pg1056"/>

                <note rend="inline" type="source">File No. 817.51/599a.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                            Brown Bros. &amp; Co. and Seligman &amp;
                        Co.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-10-06">
                            <hi rendition="#italic">October 6, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Gentlemen</hi>: Please find enclosed carbon copy of
                    a letter<anchor n="1" xml:id="d1353-f1"/> addressed to Pedro Rafael Cuadra,
                    Minister of Finance of Nicaragua.</p>
                <p>I understood in my telephonic conversation with Mr. Thatcher Brown that there
                    would be no objection to incorporating this clause in the proper contract.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. J. Bryan</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
