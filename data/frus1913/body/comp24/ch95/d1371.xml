    <text>
        <body>
            <div xml:id="d1371">

                <pb facs="1169" n="1065" sameAs="frus:frus1913/pg1065"/>

                <note rend="inline" type="source">File No. 817.51/614.</note>
                <head>
                    <hi rendition="#italic"> Brown Brothers and Company and J. and W. Seligman and
                        Company to the Chief of Bureau of Latin-American Affairs.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">New York</hi></placeName>, <date
                            calendar="gregorian" when="1913-11-24">
                            <hi rendition="#italic">November 24, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Long</hi>: For the information of the State
                    Department we beg to enclose herewith statement which was given to the press on
                    Saturday [November 20] with reference to the Gold Reserve Fund for the
                    redemption of Nicaraguan Bank Notes, etc.</p>
                <p>Yours, very truly,</p>
                <closer>
                    <hi rendition="#small-caps">Brown Brothers</hi> &amp; Co.</closer>


                <xi:include href="d1371-a1.xml" xpointer="d1371-a1"/>
            </div>
