    <text>
        <body>
            <div xml:id="d1341">

                <pb facs="1149" n="1045" sameAs="frus:frus1913/pg1045"/>

                <note rend="inline" type="source">File No. 817.51/551.</note>
                <head>
                    <hi rendition="#italic">
                        Brown Brothers and Company and J. and W. Seligman and
                            Company to the Secretary of State.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">New York</hi></placeName>, <date
                            calendar="gregorian" when="1913-07-24">
                            <hi rendition="#italic">July 24, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: We have the honor to enclose herewith for
                    your information, copy of a decree which was issued by the President of
                    Nicaragua on June 22nd,<anchor n="1" xml:id="d1341-f1"/> 1913, and which was put
                    in the form of a contract which bears date of June 30th, .1913.</p>
                <p>We beg [etc.]</p>
                <closer>
                    <hi rendition="#small-caps">Brown Brothers</hi> &amp; Co. <lb/>
                    <hi rendition="#small-caps">J. &amp; W. Seligman</hi> &amp; Co.</closer>


                <xi:include href="d1341-a1.xml" xpointer="d1341-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1341-f1" n="1" xml:id="d1341-f1-content">
                <p>Should be 23d.</p>
