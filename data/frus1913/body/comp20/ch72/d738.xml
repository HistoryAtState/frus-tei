    <text>
        <body>
            <div xml:id="d738">

                <pb facs="0766" n="662" sameAs="frus:frus1913/pg662"/>

                <note rend="inline" type="source">File No. 882.00/447.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the American Chargé
                        d’Affaires.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Extract.]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 37.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-11-13">
                            <hi rendition="#italic">November 13, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The Department has received and read with
                    interest your despatch No. 53, of October 12, 1912, with reference to certain
                    recent disturbances that occurred in Monrovia, and in reply informs you that the
                    attitude taken by you in the matter has the Department’s approval.* * *</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">P. C. Knox</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
