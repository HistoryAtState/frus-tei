    <text>
        <body>
            <div xml:id="d768-a2">

                <pb facs="0791" n="687" sameAs="frus:frus1913/pg687"/>

                <opener>
                    <seg rendition="#center">[Inclosure 2.]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">The General Superintendent of Public Instruction of
                        Liberia to the Liberian Consul General at Baltimore, Maryland.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Monrovia</hi></placeName>, <date
                            calendar="gregorian" when="1911-07-24">
                            <hi rendition="#italic">July 24, 1911</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Confirming my telegram of the 17th instant
                    I have the honor to hereby appoint you agent of the Department of Education with
                    full power to conclude all necessary arrangements with the American Colonization
                    Society with reference to the Donovan Funds.</p>
                <p>I have [etc.]</p>
                <closer>[<signed>
                        <hi rendition="#small-caps">Barclay</hi>.</signed>]</closer>
            </div>
        </body>
    </text>
