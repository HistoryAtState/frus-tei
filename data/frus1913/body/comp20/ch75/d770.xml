            <div xml:id="d770">

                <pb facs="0793" n="689" xml:id="pg689"/>

                <note rend="inline" type="source">File No. 882.42/7.</note>
                <head>
                    <hi rendition="#italic">The President of Liberia to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Monrovia</hi></placeName>, <date
                            calendar="gregorian" when="1911-10-22">
                            <hi rendition="#italic">October 22, 1911</hi></date>.</dateline>
                </opener>
                <p>Consul General Lyon authorized receive Donovan fund and release Society.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">President Barclay</hi>.</signed>
                </closer>
            </div>
        </body>
