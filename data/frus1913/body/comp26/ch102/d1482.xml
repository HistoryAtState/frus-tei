    <text>
        <body>
            <div xml:id="d1482">

                <pb facs="1244" n="1140" sameAs="frus:frus1913/pg1140"/>

                <note rend="inline" type="source">File No. 823.032/10.</note>
                <head>
                    <hi rendition="#italic">The American Minister to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Extract.]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 227.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Lima</hi></placeName>, <date
                            calendar="gregorian" when="1913-08-02">
                            <hi rendition="#italic">August 2, 1913</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith
                    extracts from the message delivered by President Billinghurst to the Peruvian
                    Congress on the 28th day of July, 1913, which includes such topics as may be of
                    interest to the Department.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">H. Clay Howard</hi>.</signed>
                </closer>


                <xi:include href="d1482-a1.xml" xpointer="d1482-a1"/>
            </div>
        </body>
    </text>
