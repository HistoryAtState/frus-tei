                <pb facs="1329" n="1225" sameAs="frus:frus1913/pg1225"/>

                <note rend="inline" type="source">File No. 723.2515/273.</note>
                <head>
                    <hi rendition="#italic">The American Minister to Peru
                        to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Lima</hi></placeName>, <date
                            calendar="gregorian" when="1912-11-13">
                            <hi rendition="#italic">Nov. 13, 1912</hi></date>.</dateline>
                </opener>
                <p>Your November 12. The President confirms the report and says Congress will ratify
                    the agreement.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Howard</hi>.</signed>
                </closer>
            </div>
        </body>
