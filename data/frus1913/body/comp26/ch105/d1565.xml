                <pb facs="1310" n="1206" sameAs="frus:frus1913/pg1206"/>

                <note rend="inline" type="source">File No. 723.2515/195.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            American Minister to Peru.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1910-11-21">
                            <hi rendition="#italic">November 21, 1910</hi></date>.</dateline>
                </opener>
                <p>The Department desires to know the source of the information contained in your
                    telegram of November 19.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Knox</hi>.</signed>
                </closer>
            </div>
