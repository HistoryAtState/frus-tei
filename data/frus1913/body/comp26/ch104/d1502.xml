    <text>
        <body>
            <div xml:id="d1502">

                <pb facs="1253" n="1149" xml:id="pg1149"/>

                <note rend="inline" type="source">File No. 722.2315/586.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            American Minister to Ecuador.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-05-26">
                            <hi rendition="#italic">May 26, 1913</hi></date>.</dateline>
                </opener>
                <p>Department desires report from you as to Howard’s May 17 regarding mediation,
                    which he was instructed to repeat to you.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
