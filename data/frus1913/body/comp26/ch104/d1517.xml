    <text>
        <body>
            <div xml:id="d1517">

                <pb facs="1268" n="1164" xml:id="pg1164"/>

                <note rend="inline" type="source">File No. 722.2315/601.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Minister of Peru.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-09-10">
                            <hi rendition="#italic">September 10, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the
                    receipt of your esteemed note dated August 10, with which you enclose a
                    confidential memorandum together with four enclosures and a map with reference
                    to the boundary dispute between Peru and Ecuador. These have been read with much
                    interest.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">John E. Osborne</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
