    <text>
        <body>
            <div xml:id="d1516">

                <pb facs="1261" n="1157" sameAs="frus:frus1913/pg1157"/>

                <note rend="inline" type="source">File No. 722.2315/601.</note>
                <head>
                    <hi rendition="#italic">The Minister of Peru to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Not a translation.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Legation of Peru</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-08-10">
                            <hi rendition="#italic">August 10, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Acting on instructions of my Government I
                    have the honor to enclose a confidential memorandum with four annexes and a map,
                    in reference to the boundary dispute between Peru and Ecuador.</p>
                <p>Accept [etc.].</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">F. A. Pezet</hi>.</signed>
                </closer>


                <xi:include href="d1516-a1.xml" xpointer="d1516-a1"/>
            </div>
