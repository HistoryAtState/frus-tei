    <text>
        <body>
            <div xml:id="d1514">

                <pb facs="1260" n="1156" sameAs="frus:frus1913/pg1156"/>

                <note rend="inline" type="source">File No. 722.2315/596.</note>
                <head>
                    <hi rendition="#italic">The Chargé d’Affaires of Brazil to the Counselor of the
                        Department of State.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Embassy of Brazil</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-07-24">
                            <hi rendition="#italic">July 24, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Moore</hi>: Many thanks for your personal
                    letter of July 22nd, contents of which I cabled to my Government. As soon as I
                    receive an answer on the subject I will communicate with you.</p>
                <p>Thanking you again [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">E. L. Chermont</hi>.</signed>
                </closer>
            </div>
        </body>
