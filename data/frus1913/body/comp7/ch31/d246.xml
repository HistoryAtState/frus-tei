    <text>
        <body>
            <div xml:id="d246">

                <pb facs="0431" n="327" sameAs="frus:frus1913/pg327"/>

                <note rend="inline" type="source">File No. 711.21/205.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            American Chargé d’Affaires.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-11-29T10:00:00-05:00">
                            <hi rendition="#italic">November 29, 1913—10 a.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Department received note from the Minister of Colombia dated November 24
                    requesting that reply to Legation’s October 22, 7 p.m., be expedited.</p>
                <pb facs="0432" n="328" xml:id="pg328"/>
                <p>Please inform Minister for Foreign Affairs that enormous pressure of other
                    vitally important matters has prevented the President from receiving this
                    question. It is hoped reply may be sent next week.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
