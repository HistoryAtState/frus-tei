    <text>
        <body>
            <div xml:id="d234">

                <pb facs="0400" n="296" sameAs="frus:frus1913/pg296"/>

                <note rend="inline" type="source">H. R. Doc. No. 1444. 62d Cong., 3d sess.</note>
                <head>
                    <hi rendition="#italic">Message from the President to Congress, transmitting a
                        report by the Secretary of State on the subject of relations between the
                        United States and the Republic of Colombia.</hi>
                </head>
                <dateline>[<date calendar="gregorian" when="1913-03-01">March 1,
                    1913</date>]</dateline>
                <p rendition="#center">[Read March 1, 1913. Referred to the Committee on Foreign
                    Affairs.]</p>
                <p rendition="#flush">
                    <hi rendition="#italic">To the Senate and the House of Representatives:</hi>
                </p>
                <p>I transmit herewith for the information of the Congress a report<anchor n="1"
                        xml:id="d234-f1"/> made to me on February 20, 1913, by the Secretary of
                    State, on the <pb facs="0401" n="297" xml:id="pg297"/> subject of relations
                    between the United States and the Republic of Colombia.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wm. H. Taft</hi>.</signed>
                </closer>
                <postscript>
                    <p>
                        <hi rendition="#small-caps">The White House</hi>, <lb/>
                        <hi rendition="#italic">Washington, March 1, 1913.</hi>
                    </p>
                </postscript>


                <xi:include href="d234-a1.xml" xpointer="d234-a1"/>
            </div>
        </body>
    </text>
