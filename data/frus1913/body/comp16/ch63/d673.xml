    <text>
        <body>
            <div xml:id="d673">

                <pb facs="0692" n="588" sameAs="frus:frus1913/pg588"/>

                <note rend="inline" type="source">File No. 838.111/150.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the American
                        Minister.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-11-26">
                            <hi rendition="#italic">November 26, 1913</hi></date>.</dateline>
                </opener>
                <p>Use your best efforts to secure another extension for Daniel John.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Moore</hi>.</signed>
                </closer>
            </div>
        </body>
