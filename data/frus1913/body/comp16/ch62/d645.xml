    <text>
        <body>
            <div xml:id="d645">

                <pb facs="0678" n="574" xml:id="pg574"/>

                <note rend="inline" type="source">File No. 838.00/710.</note>
                <head>
                    <hi rendition="#italic">The American Minister to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegrams—Paraphrases.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Port au Prince</hi></placeName>, <date
                            calendar="gregorian" when="1913-05-05">
                            <hi rendition="#italic">May 5, 1913</hi></date>.</dateline>
                </opener>
                <p>Senator Michel Oreste was elected President by Congress by a majority of
                    forty-eight votes. The President elect is a lawyer and is pro-American.
                    Instruction requested regarding recognition of the new President.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Furniss</hi>.</signed>
                </closer>
            </div>
        </body>
