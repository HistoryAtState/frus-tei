            <div xml:id="d24">

                <pb facs="0127" n="23" xml:id="pg23"/>

                <note rend="inline" type="source">File No. 363.117/8</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            American Chargé d’Affaires.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 318.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-08-26">
                            <hi rendition="#italic">August 26, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The Department has received your despatch
                    No. 514, of August 4, 1913, transmitting a copy of your note of August 2nd to
                    the Austro-Hungarian Foreign Office protesting against unwarranted arrests of
                    naturalized American citizens in Austria-Hungary.</p>
                <p>The Department approves of your note and hopes that it may have the desired
                    effect.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">J. B. Moore</hi>.</signed>
                </closer>
            </div>
        </body>
