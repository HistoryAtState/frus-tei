    <text>
        <body>
            <div xml:id="d25">

                <pb facs="0127" n="23" sameAs="frus:frus1913/pg23"/>

                <note rend="inline" type="source">File No. 363.117R271/2.</note>
                <head>
                    <hi rendition="#italic">The American Chargé d’Affaires to the Secretary of
                        State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 528.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Vienna</hi></placeName>, <date
                            calendar="gregorian" when="1913-09-04">
                            <hi rendition="#italic">September 4, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: In reply to the Department’s No. 305 of
                    July 16, 1913, instructing this Embassy to ask for the immediate return of the
                    naturalization certificate and a bond taken from Julius Reich at the time of his
                    arrest on June 2nd for alleged evasion of military service, I have the honor to
                    report that the Embassy is in receipt of a notice from the Foreign Office
                    stating that the certificate of naturalization and the bond of 200 crowns were
                    returned to Julius Reich on July 16th of the present year.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">U. Grant-Smith</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
