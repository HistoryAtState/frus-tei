            <div xml:id="d610">

                <pb facs="0657" n="553" sameAs="frus:frus1913/pg553"/>

                <note rend="inline" type="source">File No. 868.001 G 29/9.</note>
                <head>
                    <hi rendition="#italic"> King Constantine to the President.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Saloniki</hi></placeName>, <date
                            calendar="gregorian" when="1913-03-24">
                            <hi rendition="#italic">March 24, 1913</hi></date>.</dateline>
                </opener>
                <p>Deeply touched by your kind sympathy and good wishes. Send sincere and heartfelt
                    thanks.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Constantine</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
