    <text>
        <body>
            <div xml:id="d602">

                <pb facs="0655" n="551" sameAs="frus:frus1913/pg551"/>

                <note rend="inline" type="source">File No. 868.001 G 29/2A.</note>
                <head>
                    <hi rendition="#italic">The President to Queen Olga.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">White House</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-03-18">
                            <hi rendition="#italic">March 18, 1913</hi></date>.</dateline>
                </opener>
                <p>I am inexpressibly shocked to hear of the terrible crime which has resulted in
                    the death of the King, and I offer to Your Majesty, to the royal family and to
                    the Grecian nation the sincere condolences of the Government and people of the
                    United States and the expression of my own deep sympathy,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Woodrow Wilson</hi>.</signed>
                </closer>
            </div>
        </body>
