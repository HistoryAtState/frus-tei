    <text>
        <body>
            <div xml:id="d612">

                <pb facs="0658" n="554" sameAs="frus:frus1913/pg554"/>

                <note rend="inline" type="source">File No. 868.001 G 29/7.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the American Minister.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-03-26">
                            <hi rendition="#italic">March 26, 1913</hi></date>.</dateline>
                </opener>
                <p>You are hereby accredited as special and personal representative of the President
                    to attend the funeral of the late King on April second.</p>
                <p>Inform Foreign Office.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Alvey A. Adee</hi>.</signed>
                </closer>
            </div>
        </body>
