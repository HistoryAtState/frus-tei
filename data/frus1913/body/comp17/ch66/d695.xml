        <body>
            <div xml:id="d695">

                <pb facs="0706" n="602" xml:id="pg602"/>

                <note rend="inline" type="source">File No. 815.77/117.</note>
                <head>
                    <hi rendition="#italic">The American Minister to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 117.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Tegucigalpa</hi></placeName>, <date
                            calendar="gregorian" when="1912-04-18">
                            <hi rendition="#italic">April 18, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Acknowledging the Department’s instruction
                    No. 56 of the 6th ultimo, in regard to the complaint of Mr. W. S. Valentine, I
                    have the honor to enclose herewith a copy of a note addressed by me on the 12th
                    instant to the Minister for Foreign Affairs in accordance therewith, and to be,
                    Sir, [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Charles D. White</hi>.</signed>
                </closer>


                <xi:include href="d695-a1.xml" xpointer="d695-a1"/>
