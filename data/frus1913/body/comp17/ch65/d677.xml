    <text>
        <body>
            <div xml:id="d677">

                <pb facs="0696" n="592" xml:id="pg592"/>

                <note rend="inline" type="source">File No. 815.001 B 64/10.</note>
                <head>
                    <hi rendition="#italic">The Minister of Honduras to
                        the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Translation.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Legation of Honduras</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-03-22">
                            <hi rendition="#italic">March 22, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Secretary</hi>: With profound sorrow I discharge
                    the duty of informing your excellency that, on the 21st instant, General Don
                    Manuel Bonilla, President of the Republic of Honduras, died at Tegucigalpa.</p>
                <p>I renew [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Alberto Membreño</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
