    <text>
        <body>
            <div xml:id="d684">

                <pb facs="0698" n="594" sameAs="frus:frus1913/pg594"/>

                <note rend="inline" type="source">File No. 815.001 B 46/2.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            American Minister.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 141.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-06-16">
                            <hi rendition="#italic">June 16, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I inclose, with office copy, a letter
                    addressed by the President to His Excellency Francisco Bertrand,<anchor n="1"
                        xml:id="d684-f1"/> acknowledging His Excellency’s letter of April 1 last in
                    which he announced his assumption on March 21 last of the Presidency of the
                    Republic of Honduras and his entrance upon the duties of that office.</p>
                <p>You will forward the copy to the Foreign Office and deliver the original in the
                    manner most agreeable to His Excellency.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">J. B. Moore</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
