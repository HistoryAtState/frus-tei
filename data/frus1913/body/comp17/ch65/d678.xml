    <text>
        <body>
            <div xml:id="d678">

                <pb facs="0696" n="592" sameAs="frus:frus1913/pg592"/>

                <note rend="inline" type="source">File No. 815.001 B 64/9.</note>
                <head>
                    <hi rendition="#italic">The President to the President of Honduras.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">The White House</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-03-22">
                            <hi rendition="#italic">March 22, 1913</hi></date>.</dateline>
                </opener>
                <p>The Government and people of the United States of America join me in offering
                    heartfelt condolences in the great loss which has been sustained by the Republic
                    of Honduras in the lamented death of His Excellency, President Bonilla.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Woodrow Wilson</hi>.</signed>
                </closer>
            </div>
        </body>
