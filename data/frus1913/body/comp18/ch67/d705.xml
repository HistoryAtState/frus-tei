    <text>
        <body>
            <div xml:id="d705">

                <pb facs="0715" n="611" xml:id="pg611"/>

                <note rend="inline" type="source">File No. 765.003.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the American Consul General at
                        Genoa.</hi><anchor n="1" xml:id="d705-f1"/>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 152.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-03-10">
                            <hi rendition="#italic">March 10, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: There is enclosed for your information a
                    copy of an instruction with accompanying enclosures addressed to the American
                    Ambassador at Rome on the subject of the extension of Italian sovereignty to
                    Libya, and as to the relinquishment of extraterritorial rights in Tripolitania
                    and Cyrenaica.</p>
                <p>You are directed to conform to the legal situation established in Libya through
                    the cessation of the special régime formerly enjoyed by foreigners by virtue of
                    the Capitulations of the Ottoman Empire. I am [etc.]</p>
                <closer>For <signed>Mr. Bryan</signed>: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Wilbur J. Carr</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d705-f1" n="1" type="source" xml:id="d705-f1-content">
                <p>The same to the American Consul at Tripoli-in-Barbary.</p>
            </note>
        </listAnnotation>
    </standOff>
