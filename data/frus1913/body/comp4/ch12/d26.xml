    <text>
        <body>
            <div xml:id="d26">

                <pb facs="0128" n="24" sameAs="frus:frus1913/pg24"/>

                <note rend="inline" type="source">File No. 832.032/5.</note>
                <head>
                    <hi rendition="#italic">The American Ambassador to the Secretary of Stale.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Extract.]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 175.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Rio de Janeiro</hi></placeName>, <date
                            calendar="gregorian" when="1913-05-17">
                            <hi rendition="#italic">May 17, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith, for
                    the Department’s information, two copies of the annual message of the President
                    of Brazil addressed to the National Congress on May 3, 1913, the day of the
                    opening of the regular session of that body.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Edwin V. Morgan</hi>.</signed>
                </closer>


                <xi:include href="d26-a1.xml" xpointer="d26-a1"/>
            </div>
        </body>
    </text>
