                <pb facs="0176" n="72" sameAs="frus:frus1913/pg72"/>

                <note rend="inline" type="source">File No. 033.3211/57.</note>
                <head>
                    <hi rendition="#italic">The Brazilian Minister for Foreign
                            Affairs, on Special Mission to the President.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">New York</hi></placeName>, <date
                            calendar="gregorian" when="1913-07-16">
                            <hi rendition="#italic">July 16, 1913</hi></date>.</dateline>
                </opener>
                <p>Will Your Excellency allow me the honor of conveying to you my most respectful
                    and grateful compliments on my leaving this great republic.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lauro Müller</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
