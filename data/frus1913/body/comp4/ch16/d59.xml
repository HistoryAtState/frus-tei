    <text>
        <body>
            <div xml:id="d59">

                <pb facs="0171" n="67" sameAs="frus:frus1913/pg67"/>

                <note rend="inline" type="source">File No. 033.3211/3.</note>
                <head>
                    <hi rendition="#italic">The American Ambassador to
                        the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Extract.]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 124.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Rio de Janeiro</hi></placeName>, <date
                            calendar="gregorian" when="1913-02-11">
                            <hi rendition="#italic">February 11, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to the Embassy’s despatch No.
                        11<anchor n="2" xml:id="d59-f1"/> of the 30th ulto. I have the honor to
                    enclose a copy of the personal letter which I addressed on January 21st last to
                    Dr. Lauro Müller, the Brazilian Minister for Foreign Affairs.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Edwin V. Morgan</hi>.</signed>
                </closer>


                <xi:include href="d59-a1.xml" xpointer="d59-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
