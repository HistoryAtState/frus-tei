    <text>
        <body>
            <div xml:id="d52">

                <pb facs="0166" n="62" sameAs="frus:frus1913/pg62"/>

                <note rend="inline" type="source">File No. 832.61333/123.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the American
                        Ambassador.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-12-23">
                            <hi rendition="#italic">December 23, 1912</hi></date>.</dateline>
                </opener>
                <p>Sielcken has ceased to press for a hearing. Sales should now proceed as
                    agreed.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wilson</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
