    <text>
        <body>
            <div xml:id="d35">

                <pb facs="0143" n="39" sameAs="frus:frus1913/pg39"/>

                <note rend="inline" type="source">File No. 832.61333/76.</note>
                <head>
                    <hi rendition="#italic">The Acting Attorney General
                        to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Extract]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of Justice</hi>, <lb/>
                            <hi rendition="#italic">Washington, D. C.</hi></placeName>, <date
                            calendar="gregorian" when="1911-07-12">
                            <hi rendition="#italic">July 12, 1911</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Will you kindly give formal authority to
                    your Mr. Joseph J. Slechta, Vice and Deputy Consul General of the United States
                    at Rio de Janeiro, to give to this Department, and particularly to Mr. William
                    T. Chantland, Special Assistant to the Attorney General, who has the matter in
                    charge, all the facts and information he has relative to the Brazilian coffee
                    valorization scheme.</p>
                <p>Very respectfully,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">J. A. Fowler</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
