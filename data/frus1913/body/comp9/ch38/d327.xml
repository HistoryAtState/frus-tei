    <text>
        <body>
            <div xml:id="d327">

                <pb facs="0483" n="379" sameAs="frus:frus1913/pg379"/>

                <note rend="inline" type="source">File No: 837.156/138.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            American Minister.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 210.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-03-13">
                            <hi rendition="#italic">March 13, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The Department has received your No. 637
                    of February 26, 1913, regarding the Habana-Casa Blanca bridge project.</p>
                <p>You will endeavor to keep yourself informed of the developments in the matter and
                    promptly advise the Department.</p>
                <p>I am [etc.]</p>
                <closer>For <signed>Mr. Bryan</signed>: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Huntington Wilson</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
