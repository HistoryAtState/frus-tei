                <pb facs="0467" n="363" sameAs="frus:frus1913/pg363"/>

                <note rend="inline" type="source">File No. 437.13/21.</note>
                <head>
                    <hi rendition="#italic">The American Minister to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Habana</hi></placeName>, <date
                            calendar="gregorian" when="1913-05-01T20:00:00-05:29">
                            <hi rendition="#italic">May 1, 1913—8 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>The bill differs materially only as mentioned in my telegram of May 1, 10
                    a.m.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Beaupré</hi>.</signed>
                </closer>
            </div>
        </body>
