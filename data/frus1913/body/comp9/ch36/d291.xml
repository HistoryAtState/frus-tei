            <div xml:id="d291">

                <pb facs="0465" n="361" sameAs="frus:frus1913/pg361"/>

                <note rend="inline" type="source">File No. 837.13/12.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            American Minister.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-03-12">
                            <hi rendition="#italic">March 12, 1913</hi></date>.</dateline>
                </opener>
                <p>Inform the Minister for Foreign Affairs that in answer to the Cuban Minister’s
                    pro memoria the Department has replied as follows [see <hi rendition="#italic"
                        >supra.</hi>]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi>.</signed>
                </closer>
            </div>
        </body>
