    <text>
        <body>
            <div xml:id="d299">

                <pb facs="0467" n="363" sameAs="frus:frus1913/pg363"/>

                <note rend="inline" type="source">File No. 837.13/20.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the American
                        Minister.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-05-01">
                            <hi rendition="#italic">May 1, 1913</hi></date>.</dateline>
                </opener>
                <p>How does the new bill differ from that of the last session?</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Moore</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
