    <text>
        <body>
            <div xml:id="d385">

                <pb facs="0520" n="416" sameAs="frus:frus1913/pg416"/>

                <note rend="inline" type="source">File No. 811.413 M28/10.</note>
                <head>
                    <hi rendition="#italic">The American Chargé d’Affaires to the Secretary of
                        State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 722.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Habana</hi></placeName>, <date
                            calendar="gregorian" when="1913-06-30">
                            <hi rendition="#italic">June 30, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the
                    receipt of the Department’s instruction No. 238 of the 19th instant, enclosing a
                    letter addressed to the Minister of Foreign Affairs (Secretary of State) of
                    Cuba, acknowledging a telegram sent by him in regard to the reception accorded
                    the Cuban representatives to the Maine memorial ceremonies; and to report that I
                    have transmitted the letter in question to Mr. Torriente.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hugh S. Gibson</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
