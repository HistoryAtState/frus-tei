    <text>
        <body>
            <div xml:id="d335">

                <pb facs="0486" n="382" xml:id="pg382"/>

                <note rend="inline" type="source">File No. 837.77/69.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the American
                        Minister.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1912-05-14">
                            <hi rendition="#italic">May 14, 1912</hi></date>.</dateline>
                </opener>
                <p>The Department cannot give its approval to the railroad project in its present
                    form if its understanding thereof is correct.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wilson</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
