    <text>
        <body>
            <div xml:id="d347">

                <pb facs="0492" n="388" sameAs="frus:frus1913/pg388"/>

                <note rend="inline" type="source">File No. 837.77/87.</note>
                <head>
                    <hi rendition="#italic">The American Minister to the
                            Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 530.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Habana</hi></placeName>, <date
                            calendar="gregorian" when="1912-12-05">
                            <hi rendition="#italic">December 5, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to your telegraphic instructions
                    of December 4, I have the honor to enclose herewith copy of a note which I have
                    today addressed in pursuance of your instructions to His Excellency the
                    President of the Republic of Cuba.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">A.M. Beaupré</hi>.</signed>
                </closer>



                <xi:include href="d347-a1.xml" xpointer="d347-a1"/>
            </div>
