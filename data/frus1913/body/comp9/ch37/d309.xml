        <body>
            <div xml:id="d309">

                <pb facs="0472" n="368" xml:id="pg368"/>

                <note rend="inline" type="source">File No. 837.6112/32.</note>
                <head>
                    <hi rendition="#italic">The American Minister to the
                            Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 664.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Habana</hi></placeName>, <date
                            calendar="gregorian" when="1913-03-22">
                            <hi rendition="#italic">March 22, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith in
                    copy and translation Decree No. 83, which revives the Zapata concession upon
                    terms which seem to conform with the Department’s previous objections.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">A. M. Beaupré</hi>.</signed>
                </closer>


                <xi:include href="d309-a1.xml" xpointer="d309-a1"/>
            </div>
