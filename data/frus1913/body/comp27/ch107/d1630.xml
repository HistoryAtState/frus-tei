    <text>
        <body>
            <div xml:id="d1630">

                <pb facs="1399" n="1295" sameAs="frus:frus1913/pg1295"/>

                <note rend="inline" type="source">File No. 353.117R33/1.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the American Consul at
                        St. Michael’s.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 345.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-03-27">
                            <hi rendition="#italic">March 27, 1913</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The Department has received your despatch
                    No. 765 of February 27, 1913, concerning the action of the officials in the
                    Azores, especially in the district of Horta, in requiring military service, or
                    imposing fines in lieu thereof, in cases of persons born in the Azores whose
                    fathers, also natives of the Azores, had previously obtained naturalization as
                    citizens of the United States.</p>
                <p>I enclose herewith, for your information, a copy of an instruction of this day to
                    the Legation at Lisbon concerning the matter.<anchor n="2" xml:id="d1630-f1"/>
                </p>
                <p>I am [etc.]</p>
                <closer>For <signed>Mr. Adee, Acting Secretary</signed>: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Wilbur J. Carr</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
