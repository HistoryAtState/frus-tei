            <div xml:id="d1379">

                <pb facs="1177" n="1073" sameAs="frus:frus1913/pg1073"/>

                <note rend="inline" type="source">File No. 419.11D29/37.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the American Minister.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-02-17">
                            <hi rendition="#italic">February 17, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The Department has received your No. 313,
                    of February 1 last, reporting your recent action in the matter of your
                    negotiations with the Panaman Government with a view to the investigation of lie
                    case of the riot on July 4 last in which certain Americans were killed and
                    wounded.</p>
                <p>Your action in the matter is approved.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">P. C. Knox</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
