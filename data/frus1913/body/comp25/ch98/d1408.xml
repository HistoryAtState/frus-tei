    <text>
        <body>
            <div xml:id="d1408">

                <pb facs="1195" n="1091" sameAs="frus:frus1913/pg1091"/>

                <note rend="inline" type="source">File No. 819.77/157.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the American Minister.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-02-25">
                            <hi rendition="#italic">February 25, 1913</hi></date>.</dateline>
                </opener>
                <p>Your February 24. When the contract is withdrawn you will express to the Minister
                    for Foreign Affairs the appreciation by the Government of the United States of
                    the action of the Government of Panama.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Knox</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
