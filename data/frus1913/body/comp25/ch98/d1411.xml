    <text>
        <body>
            <div xml:id="d1411">

                <pb facs="1197" n="1093" sameAs="frus:frus1913/pg1093"/>

                <note rend="inline" type="source">File No. 819.77/158.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Secretary of War.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-03-07">
                            <hi rendition="#italic">March 7, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the
                    receipt of your Department’s letter of February 26 last enclosing a memorandum
                    from the Chief of Staff in regard to the proposed Duncan Concession for a
                    railroad in the Republic of Panama.</p>
                <p>Copies of your letter and its enclosure have been forwarded to the American
                    Minister at Panama.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. J. Bryan</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
