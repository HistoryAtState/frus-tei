    <text>
        <body>
            <div xml:id="d1410">

                <pb facs="1197" n="1093" sameAs="frus:frus1913/pg1093"/>

                <note rend="inline" type="source">File No. 819.77/158.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            American Minister.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 108.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-03-07">
                            <hi rendition="#italic">March 7, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to previous correspondence on
                    the subject, I enclose for your information a copy of a letter from the
                    Secretary of War, dated February 26 last, with which he forwards a memorandum
                    from the Chief of Staff on the subject of the proposed Duncan Concession for a
                    railroad in Panama.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. J. Bryan</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
