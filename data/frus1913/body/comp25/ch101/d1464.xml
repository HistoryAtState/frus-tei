    <text>
        <body>
            <div xml:id="d1464">

                <pb facs="1235" n="1131" sameAs="frus:frus1913/pg1131"/>

                <note rend="inline" type="source">File No. 819.55/32.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Chinese Chargé
                        d’Affaires.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-11-14">
                            <hi rendition="#italic">November 14, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Chargé</hi>: I have the honor to enclose
                    herewith, for your information and for transmission to your Government, a
                    paraphrase <pb facs="1236" n="1132" xml:id="pg1132"/> of a telegram, dated
                    November 13, just received, from the American Chargé d’Affaires at Panama
                    regarding Chinese interests in that country.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">J. B. Moore</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
