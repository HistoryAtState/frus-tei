    <text>
        <body>
            <div xml:id="d1480">

                <pb facs="1243" n="1139" sameAs="frus:frus1913/pg1139"/>

                <note rend="inline" type="source">File No. 702.9319/13.</note>
                <head>
                    <hi rendition="#italic">The American Minister to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Panama</hi></placeName>, <date
                            calendar="gregorian" when="1913-12-13">
                            <hi rendition="#italic">December 13, 1913</hi></date>.</dateline>
                </opener>
                <p>Your December 12. Panaman Minister for Foreign Affairs just now replies favorably
                    and says that exequatur will be given new Chinese Consul General upon
                    presentation of proper credentials.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Price</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
