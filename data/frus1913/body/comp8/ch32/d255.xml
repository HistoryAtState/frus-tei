    <text>
        <body>
            <div xml:id="d255">

                <pb facs="0436" n="332" sameAs="frus:frus1913/pg332"/>

                <note rend="inline" type="source">File No. 200.11L44/17.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            American Chargé d’Affaires.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 30.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-07-31">
                            <hi rendition="#italic">July 31, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The Department has received your
                    unnumbered despatch of July 19 [etc.]</p>
                <p>The Department approves your action in having Lawson arrested and deported as an
                    objectionable foreigner, in accordance with the suggestion of the Costa Rican
                    Government that you would thus avoid any possible objection of the Central
                    American Court of Justice to the granting of extradition in the absence of
                    treaty provisions applicable to the case.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">J. B. Moore</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
