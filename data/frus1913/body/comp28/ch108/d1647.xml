    <text>
        <body>
            <div xml:id="d1647">

                <pb facs="1410" n="1306" xml:id="pg1306"/>

                <note rend="inline" type="source">File No. 816.001Ar1/2.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Señora de Araújo.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-02-10">
                            <hi rendition="#italic">February 10, 1913</hi></date>.</dateline>
                </opener>
                <p>Mrs. Knox and I join in extending to you our heartfelt sympathy in this great
                    loss which you have been called upon to suffer in the lamentable death of your
                    distinguished husband.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">P. C. Knox</hi>.</signed>
                </closer>
            </div>
        </body>
