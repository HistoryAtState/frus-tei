    <text>
        <body>
            <div xml:id="d1649">

                <pb facs="1410" n="1306" sameAs="frus:frus1913/pg1306"/>

                <note rend="inline" type="source">File No. 816.001Ar1/11.</note>
                <head>
                    <hi rendition="#italic">The American Minister to the
                            Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 283.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">San Salvador</hi></placeName>, <date
                            calendar="gregorian" when="1913-02-11">
                            <hi rendition="#italic">February 11, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to the telegram of the
                    Department dated February 10, repeating to me a telegram which the President has
                    sent to the Acting President of Salvador, [etc.] I have the honor to transmit
                    herewith a copy of the note which I addressed to the Minister for Foreign
                    Affairs in compliance with the before-mentioned instruction of the
                    Department.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wm. Heimke</hi>.</signed>
                </closer>


                <xi:include href="d1649-a1.xml" xpointer="d1649-a1"/>
            </div>
