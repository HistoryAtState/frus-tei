    <text>
        <body>
            <div xml:id="d1651">

                <pb facs="1411" n="1307" sameAs="frus:frus1913/pg1307"/>

                <note rend="inline" type="source">File No. 816.001Ar1/5.</note>
                <head>
                    <hi rendition="#italic">The President of Salvador to
                        the President.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">San Salvador</hi></placeName>, <date
                            calendar="gregorian" when="1913-02-13">
                            <hi rendition="#italic">February 13, 1913</hi></date>.</dateline>
                </opener>
                <p>May Your Excellency deign to accept the expression of cordial sincere gratitude
                    of the Government and people of Salvador for your noble evidence of sympathy at
                    this time of so great sorrow to our country.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Presidente Meléndez</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
