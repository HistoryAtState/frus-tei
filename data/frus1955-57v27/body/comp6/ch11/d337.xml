    <text>
        <body>
            <div xml:id="d337">

                <pb facs="0877" n="839" xml:id="pg839"/>

                <head>337. Letter From Secretary of State Dulles to Foreign Secretary Lloyd<anchor
                        n="1" xml:id="d337-f1"/></head>
                <opener><dateline rendition="#float-right"><hi rendition="#italic"
                                ><placeName>Washington</placeName>, <date calendar="gregorian"
                                when="1957-10-29">October 29, 1957</date>.</hi></dateline></opener>
                <p><hi rendition="#small-caps">Dear Selwyn</hi>: Thank you for your letter of
                    October 25, 1957,<anchor n="2" xml:id="d337-f2"/> confirming that the present
                    Government of the United Kingdom will not seek or support, without prior
                    agreement with the United States Government, any change in regard to the
                    representation of China in the United Nations, its dependent agencies and other
                    international organizations in which this question may arise.</p>
                <p>Sincerely yours,</p>
                <closer><signed><hi rendition="#bold">John Foster Dulles</hi><anchor n="3"
                            xml:id="d337-f3"/></signed></closer>
            </div>
        </body>
    </text>
