    <text>
        <body>
            <div xml:id="d133">

                <pb facs="0262" n="206" sameAs="frus:frus1944Quebec/pg206"/>

                <note rend="inline" type="source">865.48/9–144: Telegram</note>
                <head><hi rendition="#italic">The President to the
                        President’s Personal Representative at Vatican City</hi> (<hi rendition="#italic">Taylor</hi>)<anchor n="1"
                        xml:id="d133-f1"/></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">top secret</hi></seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1944-09-03">3 September 1944</date>.</dateline>
                </opener>
                <p>Please ask General O’Dwyer to report to me as soon as possible, preferably
                    Washington by Friday morning,<anchor n="2" xml:id="d133-f2"/> or if he cannot
                    make this then in Quebec on Monday morning the eleventh.<anchor n="3"
                        xml:id="d133-f3"/></p>
                <closer><signed><hi rendition="#small-caps">Roosevelt</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d133-f1" n="1" type="source" xml:id="d133-f1-content">
                <p>Sent to the Commanding General, Allied Force Headquarters, Italy, via Army
                    channels, with instructions to pass to Taylor at Vatican City.</p>
            </note>
            <note corresp="#d133-f2" n="2" xml:id="d133-f2-content">
                <p>September 8.</p>
            </note>
            <note corresp="#d133-f3" n="3" xml:id="d133-f3-content">
                <p>O’Dwyer reached Washington in time to see the President at 11:15 a.m., September
                    8. See <hi rendition="#italic">post</hi>, <ref target="#pg210">p. 210</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
