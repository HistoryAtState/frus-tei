    <text>
        <body>
            <div xml:id="d76">

                <pb facs="0134" n="80" sameAs="frus:frus1944Quebec/pg80"/>

                <note rend="inline" type="source">Hopkins Papers</note>
                <head><hi rendition="#italic">The Chief of the Division of Central European
                        Affairs</hi> (<hi rendition="#italic">Riddleberger</hi>) <hi
                        rendition="#italic">to the President’s Special Assistant</hi> (<hi
                        rendition="#italic">Hopkins</hi>)<anchor n="1" xml:id="d76-f1"/></head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1944-09-01">September 1, 1944</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Dear Mr. Hopkins</hi>. Attached is the memo which I
                    promised for use in the meeting at your office tomorrow morning. I shall bring
                    enough copies for all. It’s a rush job, but I think I have hit most of the high
                    spots.</p>
                <closer><signed><hi rendition="#small-caps">Jimmie
                    Riddleberger</hi></signed></closer>



                <xi:include href="d76-a1.xml" xpointer="d76-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d76-f1" n="1" type="source" xml:id="d76-f1-content">
                <p>This covering memorandum is entirely in Riddleberger’s handwriting.</p>
            </note>
        </listAnnotation>
