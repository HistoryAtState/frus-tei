    <text>
        <body>
            <div xml:id="d102">

                <pb facs="0223" n="167" xml:id="pg167"/>

                <note rend="inline" type="source">841.244/8–3044</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the President</hi></head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1944-08-30">August 30, 1944</date>.</dateline>
                </opener>
                <p rendition="#center"><hi rendition="#small-caps">Memorandum for the
                    President</hi></p>
                <p rendition="#flush">Subject: Argentina</p>
                <p>I attach hereto a draft of telegram which I would suggest that you send to the
                    Prime Minister, if you agree.<anchor n="1" xml:id="d102-f1"/></p>
                <closer><signed>C[<hi rendition="#small-caps">ordell</hi>] H[<hi
                            rendition="#small-caps">ull</hi>]</signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d102-f1" n="1" xml:id="d102-f1-content">
                <p>Roosevelt sent the suggested message to Churchill on August 31, 1944. See <hi
                        rendition="#italic">infra</hi>.</p>
            </note>
        </listAnnotation>
    </standOff>
