    <text>
        <body>
            <div xml:id="d266">

                <pb facs="0504" n="442" sameAs="frus:frus1944Quebec/pg442"/>

                <note rend="inline" type="source">J.C.S.
                    Files</note>
                <head><hi rendition="#italic">Memorandum by the United States Chiefs of
                        Staff</hi><anchor n="1" xml:id="d266-f1"/></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">top secret</hi>
                        <lb/>
                        C.C.S. 676</seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Quebec</hi></placeName>,] <date calendar="gregorian"
                            when="1944-09-12">12 September 1944</date>.</dateline>
                </opener>
                <p rendition="#center"><hi rendition="#small-caps">General Progress Report on Recent
                        Operations in the Pacific</hi></p>
                <p>The enclosure, compiled from reports of the area commanders in the Pacific, is
                    presented for the information of the Combined Chiefs of Staff.</p>



                <xi:include href="d266-a1.xml" xpointer="d266-a1"/>
            </div>
