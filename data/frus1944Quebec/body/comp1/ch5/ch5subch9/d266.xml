    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d266-f1" n="1" type="source" xml:id="d266-f1-content">
                <p>Noted by the Combined Chiefs of Staff at their 173d Meeting, September 13, 1944.
                    See <hi rendition="#italic">ante</hi>, <ref target="#pg321">p. 321</ref>.</p>
            </note>
