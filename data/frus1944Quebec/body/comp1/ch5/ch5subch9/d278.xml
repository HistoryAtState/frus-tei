    <text>
        <body>
            <div xml:id="d278">

                <pb facs="0524" n="462" sameAs="frus:frus1944Quebec/pg462"/>

                <note rend="inline" type="source">J.C.S. Files</note>
                <head><hi rendition="#italic">Memorandum by the British Chiefs of Staff</hi><anchor
                        n="1" xml:id="d278-f1"/></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">top secret</hi>
                        <lb/> C.C.S. 682</seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Quebec</hi></placeName>,] <date calendar="gregorian"
                            when="1944-09-15">15 September 1944</date>.</dateline>
                </opener>
                <p rendition="#center"><hi rendition="#small-caps">Operation “Highball”</hi></p>
                <p>The American Chiefs of Staff are asked to take note that Operation <hi
                        rendition="#small-caps">Highball</hi> will be available in the Eastern
                    Theatre at the end of November, 1944.</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d278-f1" n="1" type="source" xml:id="d278-f1-content">
                <p>Noted by the Combined Chiefs of Staff at their 175th Meeting, September 15, 1944.
                    See <hi rendition="#italic">ante</hi>, <ref target="#pg357">p. 357</ref>.</p>
            </note>
        </listAnnotation>
