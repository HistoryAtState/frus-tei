    <text>
        <body>
            <div xml:id="d38">

                <pb facs="0078" n="24" sameAs="frus:frus1944Quebec/pg24"/>

                <note rend="inline" type="source">Roosevelt Papers: Telegram</note>
                <head><hi rendition="#italic">President Roosevelt to Prime Minister
                        Churchill</hi><anchor n="1" xml:id="d38-f1"/></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">top secret</hi>
                        <lb/>
                        <hi rendition="#small-caps">priority</hi></seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1944-08-30">30 August 1944</date>.</dateline>
                </opener>
                <p>Number 611, personal and top secret, from the President for the Prime
                        Minister.<anchor n="2" xml:id="d38-f2"/></p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>We can renew our Teheran talk about Trieste and Istria<anchor n="3"
                        xml:id="d38-f3"/> at <hi rendition="#small-caps">Octagon</hi>.</p>
                <closer><signed><hi rendition="#small-caps">Roosevelt</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d38-f1" n="1" type="source" xml:id="d38-f1-content">
                <p>Sent to the United States Naval Attaché, London, via Navy channels.</p>
            </note>
            <note corresp="#d38-f2" n="2" xml:id="d38-f2-content">
                <p>For the paragraphs of this message omitted here, see <hi rendition="#italic"
                        >post</hi>, <ref target="#pg222">pp. 222</ref>–<ref target="#pg223"
                        >223</ref>.</p>
            </note>
            <note corresp="#d38-f3" n="3" xml:id="d38-f3-content">
                <p>See <ref target="frus1943CairoTehran#pg_493"><hi rendition="#italic">Foreign
                            Relations</hi>, The Conferences at Cairo and Tehran, 1943, pp.
                    493</ref>, <ref target="frus1943CairoTehran#pg_503">503</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
