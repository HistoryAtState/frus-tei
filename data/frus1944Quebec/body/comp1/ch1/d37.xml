    <text>
        <body>
            <div xml:id="d37">

                <pb facs="0078" n="24" sameAs="frus:frus1944Quebec/pg24"/>

                <note rend="inline" type="source">Roosevelt Papers: Telegram</note>
                <head><hi rendition="#italic">President Roosevelt
                        to Prime Minister Churchill</hi><anchor n="1"
                        xml:id="d37-f1"/></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">top secret</hi>
                        <lb/>
                        <hi rendition="#small-caps">priority</hi></seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1944-08-30">30 August 1944</date>.</dateline>
                </opener>
                <p>Number 610, personal and top secret, from the President for the Prime
                    Minister.</p>
                <p>Your 771.<anchor n="2" xml:id="d37-f2"/> I am pleased that our final arrangements
                    for <hi rendition="#small-caps">Octagon</hi>
                    will keep the number who will participate in the conference to the Teheran level
                    insofar as practicable.</p>
                <closer><signed><hi rendition="#small-caps">Roosevelt</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d37-f1" n="1" type="source" xml:id="d37-f1-content">
                <p>Sent to the United States Naval Attaché London, via Navy channels.</p>
            </note>
            <note corresp="#d37-f2" n="2" xml:id="d37-f2-content">
                <p><hi rendition="#italic">Ante</hi>, <ref target="#pg23">p. 23</ref>.</p>
