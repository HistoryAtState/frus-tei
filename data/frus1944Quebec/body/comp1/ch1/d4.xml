    <text>
        <body>
            <div xml:id="d4">

                <pb facs="0058" n="4" sameAs="frus:frus1944Quebec/pg4"/>

                <note rend="inline" type="source">Roosevelt Papers: Telegram</note>
                <head><hi rendition="#italic">President Roosevelt to Prime Minister
                        Churchill</hi><anchor n="1" xml:id="d4-f1"/></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">secret</hi>
                        <lb/>
                        <hi rendition="#small-caps">priority</hi></seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1944-03-22">22 March 1944</date>.</dateline>
                </opener>
                <p>Number 507. Personal and secret. From the President for the Former Naval
                    Person.</p>
                <p>Your 629<anchor n="2" xml:id="d4-f2"/> received and my Chiefs of Staff have been
                    told.</p>
                <p>I join you in hoping that we may arrange to have a meeting before the great event
                    is launched.</p>
                <closer><signed><hi rendition="#small-caps">Roosevelt</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d4-f1" n="1" type="source" xml:id="d4-f1-content">
                <p>Sent to the United States Naval Attaché, London, via Navy channels.</p>
            </note>
            <note corresp="#d4-f2" n="2" xml:id="d4-f2-content">
                <p><hi rendition="#italic">Supra</hi>.</p>
            </note>
        </listAnnotation>
    </standOff>
