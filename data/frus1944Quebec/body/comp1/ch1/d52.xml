    <text>
        <body>
            <div xml:id="d52">

                <pb facs="0087" n="33" xml:id="pg33"/>

                <note rend="inline" type="source">Roosevelt Papers: Telegram</note>
                <head><hi rendition="#italic">President Roosevelt to Prime Minister
                        Churchill</hi><anchor n="1" xml:id="d52-f1"/></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">top secret</hi>
                        <lb/>
                        <hi rendition="#small-caps">priority</hi></seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps">Hyde
                                Park</hi></placeName>,] <date calendar="gregorian" when="1944-09-03"
                            >3 September 1944</date>.</dateline>
                </opener>
                <p>Number 616. Personal and top secret. From the President for the Prime
                        Minister.<anchor n="2" xml:id="d52-f2"/></p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>As to the exact employment of our forces in Italy in the future, this is a matter
                    we can discuss at <hi rendition="#small-caps">Octagon</hi>.…</p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <closer><signed><hi rendition="#small-caps">Roosevelt</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d52-f1" n="1" type="source" xml:id="d52-f1-content">
                <p>Sent to the White House Map Room; forwarded to the United States Naval Attaché,
                    London, via Navy channels.</p>
            </note>
            <note corresp="#d52-f2" n="2" xml:id="d52-f2-content">
                <p>For the portions of this message omitted here, see <hi rendition="#italic"
                        >post</hi>, <ref target="#pg229">p. 229</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
