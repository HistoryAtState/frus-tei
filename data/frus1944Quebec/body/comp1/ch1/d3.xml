    <text>
        <body>
            <div xml:id="d3">

                <pb facs="0058" n="4" sameAs="frus:frus1944Quebec/pg4"/>

                <note rend="inline" type="source">Roosevelt Papers: Telegram</note>
                <head><hi rendition="#italic">Prime Minister Churchill to President
                        Roosevelt</hi><anchor n="1" xml:id="d3-f1"/></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">most secret</hi></seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1944-03-21">21 March 1944</date>.</dateline>
                </opener>
                <p>Prime Minister to President Roosevelt. Number 629 most secret and personal. Your
                        506.<anchor n="2" xml:id="d3-f2"/></p>
                <list>
                    <label>1.</label>
                    <item>I am indeed grieved and trust rest will do you good.</item>
                    <label>2.</label>
                    <item>I do not think the staff meeting worthwhile without our being
                        there.</item>
                    <label>3.</label>
                    <item>I hope you are still planning your visit here for the great event<anchor
                            n="3" xml:id="d3-f3"/> after you are fully recovered.</item>
                </list>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d3-f1" n="1" type="source" xml:id="d3-f1-content">
                <p>Sent by the United States Military Attaché, London, via Army channels.</p>
            </note>
            <note corresp="#d3-f2" n="2" xml:id="d3-f2-content">
                <p><hi rendition="#italic">Supra.</hi></p>
            </note>
            <note corresp="#d3-f3" n="3" xml:id="d3-f3-content">
                <p>The Allied invasion of Normandy (<hi rendition="#small-caps">Overlord</hi>).</p>
            </note>
        </listAnnotation>
    </standOff>
