    <text>
        <body>
            <div xml:id="d67">

                <pb facs="0097" n="43" sameAs="frus:frus1944Quebec/pg43"/>

                <note rend="inline" type="source">Roosevelt Papers: Telegram</note>
                <head><hi rendition="#italic">The President to the War
                        Shinning Administrator</hi> (<hi rendition="#italic"
                            >Land</hi>)<anchor n="1" xml:id="d67-f1"/></head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Quebec</hi></placeName>,] <date calendar="gregorian"
                            when="1944-09-12">12 September 1944</date>.</dateline>
                </opener>
                <p>Please come to Quebec without delay.</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d67-f1" n="1" type="source" xml:id="d67-f1-content">
                <p>Sent to the White House Map Room at Washington. The message was delivered to Land
                    by Major Henry W. Putnam of the Map Room staff on the evening of September
                    12.</p>
            </note>
        </listAnnotation>
    </standOff>
