    <text>
        <body>
            <div xml:id="photographs-toc">

                <pb facs="0013" n="IX" xml:id="pgIX"/>

                <head>List of Photographs and Maps</head>
                <p rendition="#center">PHOTOGRAPHS</p>
                <p rendition="#center">(These photographs will be found in a group following <ref
                        target="#pg294">page 294</ref>.)</p>
                <list>
                    <item><ref target="#pg1">Prime Minister Churchill leaves his train on arrival at
                            Quebec</ref></item>
                    <item><ref target="#pg2">Prime Minister Churchill and President Roosevelt at
                            Wolfe’s Cove Station, Quebec</ref></item>
                    <item><ref target="#pg3">The United States Joint Chiefs of Staff</ref></item>
                    <item><ref target="#pg4">The British Chiefs of Staff</ref></item>
                    <item><ref target="#pg5">The Heads of Government and the Governor General of
                            Canada</ref></item>
                    <item><ref target="#pg6">The Heads of Government and the Governor General of
                            Canada and their wives</ref></item>
                    <item><ref target="#pg7">The Heads of Government and the Combined Chiefs of
                            Staff</ref></item>
                    <item><ref target="#pg8">The Heads of Government at the press conference held at
                            the conclusion of the Second Quebec Conference</ref></item>
                </list>
                <p rendition="#center">MAPS</p>
                <list>
                    <item><ref target="#pg86">Treasury Department recommendations for territorial
                            changes in central Europe (<hi rendition="#italic">in color</hi>) <hi
                                rendition="#italic">facing</hi></ref></item>
                    <item><ref target="#pg392">A suggestion by President Roosevelt for the postwar
                            partition of Germany (<hi rendition="#italic">in color</hi>) <hi
                                rendition="#italic">facing</hi></ref></item>
                    <item><ref target="#pg476">Zones of occupation in Germany as approved at the
                            Second Quebec Conference (<hi rendition="#italic">in color</hi>) <hi
                                rendition="#italic">facing</hi></ref></item>
                </list>
            </div>
        </body>
    </text>
