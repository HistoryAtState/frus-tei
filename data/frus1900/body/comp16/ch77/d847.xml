    <text>
        <body>
            <div xml:id="d847">

                <pb facs="0828" n="730" sameAs="frus:frus1900/pg730"/>

                <head><hi rendition="#italic">Mr. Adee to Baron
                            Fava.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1900-10-19"><hi rendition="#italic">October 19,
                        1900</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 621.]</seg></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I have the honor to acknowledge the
                    receipt of your note of the 14th instant, relating to the lynching of certain
                    Italian subjects and persons of Italian origin at Tallulah, La.</p>
                <p>The suggestion contained in your note will be taken into consideration.</p>
                <p>Accept, etc.</p>
                <closer><signed><hi rendition="#small-caps">Alvey A. Adee</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
