    <text>
        <body>
            <div xml:id="d857">

                <pb facs="0832" n="734" sameAs="frus:frus1900/pg734"/>

                <head><hi rendition="#italic">The President to the King of Italy.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Executive Mansion</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1900-07-30"><hi rendition="#italic">July 30,
                        1900</hi></date>.</dateline></opener>
                <p>In my name, and on behalf of the American people, I offer Your Majesty and the
                    Italian nation sincere condolences in this hour of deep bereavement.</p>
                <closer><signed><hi rendition="#small-caps">William McKinley.</hi></signed></closer>
            </div>
        </body>
    </text>
