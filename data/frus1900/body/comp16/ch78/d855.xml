    <text>
        <body>
            <div xml:id="d855">

                <pb facs="0831" n="733" sameAs="frus:frus1900/pg733"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Draper.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1900-05-16"><hi rendition="#italic">May 16,
                        1900</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 461.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose copy of a letter from the
                    Secretary of the Navy requesting that the thanks of his Department may be
                    conveyed to the Italian Government for courtesies shown to the U. S. S. <hi
                        rendition="#italic">Dixie</hi> by the authorities of the dockyard at
                    Naples.</p>
                <p>You will carry out Mr. Long’s wishes.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay</hi>.</signed></closer>


                <xi:include href="d855-a1.xml" xpointer="d855-a1"/>
            </div>
        </body>
    </text>
