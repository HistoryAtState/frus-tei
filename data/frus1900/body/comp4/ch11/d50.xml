    <text>
        <body>
            <div xml:id="d50">

                <pb facs="0157" n="61" sameAs="frus:frus1900/pg61"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Bryan.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1900-11-23"><hi rendition="#italic">November 23,
                        1900</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 222.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to your No. 278, of September 20
                    last, in regard to the Portuguese label law, I inclose copy of a letter from
                    Frederick Stearns &amp; Co., protesting against the law.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>


                <xi:include href="d50-a1.xml" xpointer="d50-a1"/>
