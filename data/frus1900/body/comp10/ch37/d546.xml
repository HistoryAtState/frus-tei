    <text>
        <body>
            <div xml:id="d546">

                <pb facs="0550" n="452" sameAs="frus:frus1900/pg452"/>

                <head><hi rendition="#italic">Mr. Hay to Mr. Porter.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1899-11-03"><hi rendition="#italic">November 3,
                        1899</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 683.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith copies of
                        memoranda<anchor n="1" xml:id="d546-f1"/> from and to the French embassy at
                    Washington in reference to the inviolability, under section 3 of the consular
                    convention between the United States and France of February 23, 1853, of the
                    residence at Arcachon of Mr. Tourgée, the United States Consul at Bordeaux.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
    </text>
