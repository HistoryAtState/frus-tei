    <text>
        <body>
            <div xml:id="d554">

                <pb facs="0564" n="466" sameAs="frus:frus1900/pg466"/>

                <head><hi rendition="#italic">Mr. Hay to Thiebaut.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1900-07-06"><hi rendition="#italic">July 6,
                        1900</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 334.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to receive with great
                    appreciation the expression of the thanks of the Government of the French
                    Republic, as conveyed in your note of the 2d instant, on the occasion of the
                    dedication of the statue erected to Lafayette in Paris by the Congress and the
                    school children of the United States.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
    </text>
