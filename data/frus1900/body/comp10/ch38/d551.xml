    <text>
        <body>
            <div xml:id="d551">

                <pb facs="0554" n="456" sameAs="frus:frus1900/pg456"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Porter.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1900-06-12"><hi rendition="#italic">June 12,
                        1900</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 789.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: The President being requested by the joint
                    resolution approved June 6, 1900, respecting the unveiling of the statue of
                    Lafayette at Paris, July 4, 1900, to transmit a copy thereof to the Government
                    of France, I inclose herewith, by the President’s direction, a copy for that
                    purpose.</p>
                <p>I am, sir, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>



                <xi:include href="d551-a1.xml" xpointer="d551-a1"/>
