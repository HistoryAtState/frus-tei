    <text>
        <body>
            <div xml:id="d586">

                <pb facs="0581" n="483" xml:id="pg483"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Cambon.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1900-05-18"><hi rendition="#italic">May 18,
                        1900</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 309.]</seg></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: Referring to your excellency’s note
                    of the 3d instant, I have the honor to inclose herewith copy of a letter from
                    the governor of Utah expressing thanks for and appreciation of the generous
                    sympathy of the President and Government of France on account of the mine
                    calamity in that State.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>


                <xi:include href="d586-a1.xml" xpointer="d586-a1"/>
