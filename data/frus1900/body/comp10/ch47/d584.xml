    <text>
        <body>
            <div xml:id="d584">

                <pb facs="0580" n="482" sameAs="frus:frus1900/pg482"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Porter.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1900-05-03"><hi rendition="#italic">May 3,
                        1900</hi></date>.</dateline></opener>
                <p>The President desires you to express through the appropriate channel his deep
                    appreciation of the touching message of His Excellency President Loubet, on the
                    occasion of the calamity in Utah, and his grateful sense of the sympathy of the
                    French people.</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
    </text>
