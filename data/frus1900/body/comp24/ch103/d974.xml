    <text>
        <body>
            <div xml:id="d974">

                <pb facs="0944" n="846" sameAs="frus:frus1900/pg846"/>

                <head><hi rendition="#italic">Mr. Thieriot to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Lisbon</hi></placeName>, <date calendar="gregorian"
                            when="1900-07-24"><hi rendition="#italic">July 24,
                        1900</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 44.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to state that I have
                    received from the minister of foreign affairs a note advising me that payment
                    has been made in London of the amount awarded by the Berne Court of Arbitration
                    in the Lourenço Marquez Railway affair, with the interest thereon in
                    addition.</p>
                <p>I have inclosed herewith a translation of the note referred to, and I have the
                    honor to be, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. H. Thieriot</hi>,<lb/><hi
                            rendition="#italic">In Charge of the Affairs of the
                        Legation.</hi></signed></closer>


                <xi:include href="d974-a1.xml" xpointer="d974-a1"/>
            </div>
        </body>
    </text>
