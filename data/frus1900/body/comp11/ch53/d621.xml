                <pb facs="0615" n="517" sameAs="frus:frus1900/pg517"/>

                <head><hi rendition="#italic">Mr. Jackson to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >Berlin</hi></placeName>, <date calendar="gregorian"
                            when="1900-09-29"><hi rendition="#italic">September 29,
                        1900</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1416.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to the embassy’s dispatch No.
                    1284, of June 30 last, I have the honor to transmit herewith a memorandum report
                    of certain military cases, mentioned particularly below, in regard to which
                    action has been taken during the quarter ending to-morrow, and I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John B. Jackson.</hi></signed></closer>


                <xi:include href="d621-a1.xml" xpointer="d621-a1"/>
