    <text>
        <body>
            <div xml:id="d911">

                <pb facs="0883" n="785" sameAs="frus:frus1900/pg785"/>

                <head><hi rendition="#italic">Mr. Hay to Señor Azpíroz.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1900-10-17"><hi rendition="#italic">October 17,
                        1900</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 121.]</seg></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I have the honor to inclose herewith
                    copy of a letter from the governor of Texas acknowledging the receipt of the
                    draft for $14,851.48 which you inclosed to this Department with your note of the
                    2d instant and expressing to the President, the Congress, and the people of
                    Mexico the most grateful appreciation of himself and of the people of Texas for
                    this generous contribution to the relief of the storm sufferers at
                    Galveston.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay</hi></signed></closer>



                <xi:include href="d911-a1.xml" xpointer="d911-a1"/>
            </div>
        </body>
