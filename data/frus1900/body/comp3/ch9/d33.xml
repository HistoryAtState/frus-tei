                <pb facs="0136" n="40" sameAs="frus:frus1900/pg40"/>

                <head><hi rendition="#italic">Mr. Hay to Mr. Townsend</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1901-02-05"><hi rendition="#italic">February 5,
                        1901</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 68.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I beg to inform you that the formal
                    instrument of adhesion of the United States to the Brussels convention of June
                    8, 1899, for the regulation of the importation of spirituous liquors into
                    certain regions of Africa, is sent to you to-day through the dispatch agent at
                    London.</p>
                <p>Upon its receipt you will deposit the instrument of adhesion with the Belgian
                    Government.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay</hi>.</signed></closer>
            </div>
        </body>
