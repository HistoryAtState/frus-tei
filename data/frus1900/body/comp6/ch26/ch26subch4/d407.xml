    <text>
        <body>
            <div xml:id="d407">

                <pb facs="0433" n="335" sameAs="frus:frus1900/pg335"/>

                <head><hi rendition="#italic">Mr. Jackson to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >Berlin</hi></placeName>, <date calendar="gregorian"
                            when="1900-09-04"><hi rendition="#italic">September 4,
                        1900</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a
                    translation of a memorandum sent me from the foreign office this morning by
                    Baron Richthofen, the acting assistant secretary of state for foreign affairs,
                    and to append hereto a copy of my telegram,<anchor n="1" xml:id="d407-f1"/>
                    reciting the contents of the same assent you this afternoon, in regard to the
                    proposed withdrawal of the international troops from Pekin.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer><signed><hi rendition="#small-caps">John B. Jackson.</hi></signed></closer>


                <xi:include href="d407-a1.xml" xpointer="d407-a1"/>
            </div>
        </body>
    </text>
