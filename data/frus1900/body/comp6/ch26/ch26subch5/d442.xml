    <text>
        <body>
            <div xml:id="d442">

                <pb facs="0448" n="350" sameAs="frus:frus1900/pg350"/>

                <head><hi rendition="#italic">Lord Pauncefote to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >British Embassy</hi>,<lb/><hi rendition="#italic">Newport, R.
                                I.</hi></placeName>, <date calendar="gregorian" when="1900-07-24"
                                ><hi rendition="#italic">July 24, 1900</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 208.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor, by direction of Her
                    Majesty’s principal secretary of state for foreign affairs, to communicate to
                    you, for the information of the United States Government, the substance of a
                    telegram which has been received in London from Mr. Warren, Her Majesty’s acting
                    consul-general at Shanghai, dated July 22.</p>
                <p>I have the honor to be, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Pauncefote.</hi></signed></closer>


                <xi:include href="d442-a1.xml" xpointer="d442-a1"/>
