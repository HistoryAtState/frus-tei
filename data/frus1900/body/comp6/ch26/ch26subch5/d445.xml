    <text>
        <body>
            <div xml:id="d445">

                <pb facs="0450" n="352" sameAs="frus:frus1900/pg352"/>

                <head><hi rendition="#italic">Lord Pauncefote to
                        Mr. Adee.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Newport</hi></placeName>, <date calendar="gregorian"
                            when="1900-09-03"><hi rendition="#italic">September 3,
                        1900</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 254.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: By direction of the Marquis of Salisbury, I
                    have the honor to transmit herewith, for the information of your Government, a
                    copy of a proclamation which was issued by Her Majesty the Queen on the 7th
                    ultimo, prohibiting the exportation of arms and ammunition to China.</p>
                <p>I have the honor to be, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Pauncefote.</hi></signed></closer>


                <xi:include href="d445-a1.xml" xpointer="d445-a1"/>
            </div>
