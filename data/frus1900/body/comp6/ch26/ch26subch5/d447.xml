    <text>
        <body>
            <div xml:id="d447">

                <pb facs="0451" n="353" sameAs="frus:frus1900/pg353"/>

                <head><hi rendition="#italic">Lord Pauncefote to
                        Mr. Hill.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >British Embassy</hi>,<lb/><hi rendition="#italic">Newport, R.
                                I.</hi></placeName>, <date calendar="gregorian" when="1900-09-05"
                                ><hi rendition="#italic">September 5,
                    1900</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. Hill</hi>: I have much pleasure in sending
                    you the accompanying copy of a letter received by me and signed by four
                    missionaries from Manchuria, who are desirous that I should bring to the notice
                    of your Government the great kindness they experienced at the hands of Mr.
                    Richard T. Greener, United States commercial agent at Vladivostock, and I beg to
                    join in their expression of gratitude to him for his humane and praiseworthy
                    action.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Pauncefote.</hi></signed></closer>


                <xi:include href="d447-a1.xml" xpointer="d447-a1"/>
            </div>
