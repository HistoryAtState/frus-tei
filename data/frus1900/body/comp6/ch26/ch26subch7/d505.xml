    <text>
        <body>
            <div xml:id="d505">

                <pb facs="0478" n="380" sameAs="frus:frus1900/pg380"/>

                <head><hi rendition="#italic">Mr. de Wollant to Mr. Adee.</hi></head>
                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Russian Embassy</hi>, <hi rendition="#italic">Cape
                            May</hi></placeName>, <date calendar="gregorian" when="1900-09-23"><hi
                                rendition="#italic">September 23,
                    1900</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Mr. Acting Secretary</hi>: I have the honor to
                    transmit herewith a translation of the “communiqué” of August 12 (25),
                    concerning the views of the Imperial Government on events in China.</p>
                <p>I seize this occasion, etc.,</p>
                <closer><signed><hi rendition="#small-caps">G. de Wollant.</hi></signed></closer>


                <xi:include href="d505-a1.xml" xpointer="d505-a1"/>
