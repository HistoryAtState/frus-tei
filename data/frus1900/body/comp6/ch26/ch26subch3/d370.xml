    <text>
        <body>
            <div xml:id="d370">

                <pb facs="0413" n="315" sameAs="frus:frus1900/pg315"/>

                <head><hi rendition="#italic">Mr. Porter to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1900-08-07"><hi rendition="#italic">August 7,
                        1900</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 711.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your cable received on the 2d
                        instant,<anchor n="2" xml:id="d370-f1"/> transmitting the substance of the
                    suggestion made by Li Hung Chang, was communicated to the minister of foreign
                    affairs, who acknowledged receipt of this information by a short note, copy
                    herewith inclosed.</p>
                <p>I have the honor to be, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Horace Porter.</hi></signed></closer>


                <xi:include href="d370-a1.xml" xpointer="d370-a1"/>
            </div>
        </body>
    </text>
