    <text>
        <body>
            <div xml:id="d299">

                <pb facs="0377" n="279" sameAs="frus:frus1900/pg279"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Wu Ting-fang.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1900-07-18"><hi rendition="#italic">July 18,
                        1900</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. Wu</hi>: The President has transmitted to
                    our officers in Tientsin the request of the viceroys and his hope that it may be
                    complied with.</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
    </text>
