    <text>
        <body>
            <div xml:id="d296">

                <pb facs="0375" n="277" sameAs="frus:frus1900/pg277"/>

                <head><hi rendition="#italic">Mr. Wu Ting-fang to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Chinese Legation</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1900-07-11"><hi rendition="#italic">July 11,
                        1900</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I have the pleasure to
                    acknowledge receipt of your letter of the 5th instant inclosing copies of
                    telegrams sent to the American consul-general at Shanghai on the 27th of June
                    and the 1st of July, respectively, for which please accept my sincere
                    thanks.</p>
                <closer><signed><hi rendition="#small-caps">Wu Ting-fang.</hi></signed></closer>
            </div>
        </body>
    </text>
