    <text>
        <body>
            <div xml:id="d295">

                <pb facs="0375" n="277" sameAs="frus:frus1900/pg277"/>

                <head><hi rendition="#italic">Mr. Hay to Mr. Wu Ting-fang.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1900-07-05"><hi rendition="#italic">July 5,
                        1900</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. Minister</hi>: I inclose copies of telegrams
                    sent to the American consul-general at Shanghai on the 27th of June and the 1st
                    of July.<anchor n="1" xml:id="d295-f1"/></p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
    </text>
