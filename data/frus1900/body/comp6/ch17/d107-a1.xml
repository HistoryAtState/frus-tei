    <text>
        <body>
            <div xml:id="d107-a1">

                <pb facs="0223" n="127" xml:id="pg127"/>

                <opener><seg rendition="#center">[Inclosure 1—Telegram.]</seg></opener>
                <head><hi rendition="#italic">Mr. Conger to Admiral
                            Kempff at Yokohama.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Pekin</hi></placeName>, <date calendar="gregorian"
                            when="1900-05-17"><hi rendition="#italic">May 17,
                        1900</hi></date>.</dateline></opener>
                <p>Situation becoming serious. Request warship Taku soon as possible.</p>
                <closer><signed><hi rendition="#small-caps">Conger.</hi></signed></closer>
            </div>
        </body>
