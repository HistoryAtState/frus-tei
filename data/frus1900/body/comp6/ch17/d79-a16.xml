                <head><hi rendition="#italic">Mr. Conger to Mr. Smith.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Pekin</hi></placeName>, <date calendar="gregorian"
