                <head><hi rendition="#italic">Mr. Conger to Mr. Hay.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Pekin</hi></placeName>, <date calendar="gregorian"
                            when="1900-01-25"><hi rendition="#italic">January 25,
