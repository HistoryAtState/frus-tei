    <text>
        <body>
            <div xml:id="d254">

                <pb facs="0349" n="251" sameAs="frus:frus1900/pg251"/>

                <head><hi rendition="#italic">Mr. Goodnow to Mr. Cridler.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Consulate-General of the United States</hi>,<lb/><hi
                                rendition="#italic">Shanghai</hi></placeName>, <date
                            calendar="gregorian" when="1900-07-03"><hi rendition="#italic">July 3,
                                1900</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I beg to hand you herewith (in duplicate)
                    proclamation issued here at request of the admirals allied fleet.</p>
                <p>I have the honor to be, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Goodnow</hi>, <hi
                            rendition="#italic">Consul-General.</hi></signed></closer>


                <xi:include href="d254-a1.xml" xpointer="d254-a1"/>
