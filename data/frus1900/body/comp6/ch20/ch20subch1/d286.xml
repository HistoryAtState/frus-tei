    <text>
        <body>
            <div xml:id="d286">

                <pb facs="0365" n="267" sameAs="frus:frus1900/pg267"/>

                <head><hi rendition="#italic">Mr. Cridler to Mr. Goodnow.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1900-09-11"><hi rendition="#italic">September 11,
                        1900</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 218.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    dispatch No. 285, of the 2d ultimo, in regard to the refusal of the Tsungli
                    Yamen to deliver your cipher message to Minister Conger, and to express the
                    Department’s approval of your actions in the premises.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer><signed><hi rendition="#small-caps">Thos. W. Cridler</hi>,<lb/><hi
                            rendition="#italic">Third Assistant Secretary.</hi></signed></closer>
            </div>
        </body>
