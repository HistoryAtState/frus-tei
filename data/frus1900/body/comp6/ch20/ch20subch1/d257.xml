    <text>
        <body>
            <div xml:id="d257">

                <pb facs="0353" n="255" sameAs="frus:frus1900/pg255"/>

                <head><hi rendition="#italic">Mr. Goodnow to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Consulate-General of the United States.</hi><lb/><hi
                                rendition="#italic">Shanghai</hi></placeName>, <date
                            calendar="gregorian" when="1900-07-13"><hi rendition="#italic">July 13,
                                1900</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I beg to hand you (in duplicate)
                    translation of edict of June 29. As a piece of special pleading and
                    self-justification I know of no equal to it.</p>
                <p>I have the honor to be, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Goodnow</hi>,<lb/><hi
                            rendition="#italic">Consul-General.</hi></signed></closer>


                <xi:include href="d257-a1.xml" xpointer="d257-a1"/>
