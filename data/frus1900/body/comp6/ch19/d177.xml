                <pb facs="0299" n="201" sameAs="frus:frus1900/pg201"/>

                <head><hi rendition="#italic">Mr. Conger to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Pekin, China</hi></placeName>, <date calendar="gregorian"
                            when="1900-09-20"><hi rendition="#italic">September 20,
                        1900</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 416.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith
                    translation of Prince Ching’s reply to my informal note of the 16th instant
                    regarding the return of the Emperor to Pekin, copy of which I transmitted in my
                    No. 413 of the 16th instant.</p>
                <p>I have the honor to be, etc.,</p>
                <closer><signed><hi rendition="#small-caps">E. H. Conger.</hi></signed></closer>



                <xi:include href="d177-a1.xml" xpointer="d177-a1"/>
