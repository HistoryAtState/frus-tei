    <text>
        <body>
            <div xml:id="d334">

                <pb facs="0392" n="294" sameAs="frus:frus1900/pg294"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Wu Ting-fang.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1900-07-23"><hi rendition="#italic">July 23,
                        1900</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Minister</hi>: I inclose a copy of a
                    letter from the President to the Emperor of China which I beg you will transmit
                    by telegraph to its high destination.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>


                <xi:include href="d334-a1.xml" xpointer="d334-a1"/>
