    <text>
        <body>
            <div xml:id="d136">

                <pb facs="0252" n="156" sameAs="frus:frus1900/pg156"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Rockhill.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1900-07-19"><hi rendition="#italic">July 19,
                        1900</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith the commission of the
                        President,<anchor n="2" xml:id="d136-f1"/> dated to-day, appointing you
                    Commissioner of the United States of America to China.</p>
                <p>You will proceed to that country and act in compliance with the instructions
                    which have been given to you orally.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
    </text>
