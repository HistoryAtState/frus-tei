    <text>
        <body>
            <div xml:id="d162">

                <pb facs="0293" n="195" sameAs="frus:frus1900/pg195"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Conger.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1900-10-11"><hi rendition="#italic">October 11,
                        1900</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 285.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith for your information a
                    copy of a letter from the American Board of Commissioners for Foreign Missions
                    in relation to the massacre of the missionaries and their families connected
                    with the board, in the province of Shansi, and the participation of the governor
                    of the province in the deed.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
    </text>
