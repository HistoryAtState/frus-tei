    <text>
        <body>
            <div xml:id="d159">

                <pb facs="0291" n="193" sameAs="frus:frus1900/pg193"/>

                <head><hi rendition="#italic">Mr. Conger to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Pekin, China</hi></placeName>, <date calendar="gregorian"
                            when="1900-09-22"><hi rendition="#italic">September 22,
                        1900</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 417.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I herewith inclose copy of a very
                    interesting letter from Dr. John Wherry, giving additional particulars of the
                    fiendish murder of the Americans at Paoting-fu,</p>
                <p>And to be, sir, etc.,</p>
                <closer><signed><hi rendition="#small-caps">E. H. Conger.</hi></signed></closer>


                <xi:include href="d159-a1.xml" xpointer="d159-a1"/>
