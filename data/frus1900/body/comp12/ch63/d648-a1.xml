            <div xml:id="d648-a1">

                <pb facs="0634" n="536" xml:id="pg536"/>

                <opener><seg rendition="#center">[Inclosure 1.]</seg></opener>
                <head><hi rendition="#italic">Shipments to Delagoa Bay per steamship
                    Mashona.</hi></head>
                <table cols="3" rend="bordered" rows="7">
                    <row>
                        <cell>Marks.</cell>
                        <cell/>
                        <cell>Total value invoices.</cell>
                    </row>
                    <row>
                        <cell>T N Z ASM Crossman <lb/><figure>
                                <graphic url="figure_0634"/>
                            </figure><lb/> Delagoa Bay</cell>
                        <cell>1,000 cases lubricating oil (consigned to Netherlands So. African
                            Ry).</cell>
                        <cell role="num">$2,895.95</cell>
                    </row>
                    <row>
                        <cell><figure>
                                <graphic url="figure_0634a"/>
                            </figure><lb/> 1/30<lb/>Delagoa Bay</cell>
                        <cell>30 bolts duck (consigned to order).</cell>
                        <cell role="num">367.34</cell>
                    </row>
                    <row>
                        <cell><figure>
                                <graphic url="figure_0634b"/>
                            </figure><lb/> 1549/58<lb/>Delagoa Bay</cell>
                        <cell>10 cases hatchets, 100 coils barb wire (consigned to order).</cell>
                        <cell role="num">447.90</cell>
                    </row>
                    <row>
                        <cell><figure>
                                <graphic url="figure_0634c"/>
                            </figure><lb/> B<lb/>Delagoa Bay</cell>
                        <cell>513 bags corn meal, 1 case “Cracker-jack” machine; 5 pckgs., each 2
                            cases, sausage and sauerkraut (consigned to B. Elsasser).</cell>
                        <cell role="num">1,008.11</cell>
                    </row>
                    <row>
                        <cell>HS<lb/>ACR<lb/>Lourenço Marquez</cell>
                        <cell>50 cases corned beef (consigned to order).</cell>
                        <cell rendition="#border-bottom" role="num">253.17</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell/>
                        <cell role="num">4,972.47</cell>
                    </row>
                </table>
            </div>
