    <text>
        <body>
            <div xml:id="d665">

                <pb facs="0644" n="546" sameAs="frus:frus1900/pg546"/>

                <head><hi rendition="#italic">Mr. Toomey to Mr.
                            Hay.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >New York</hi></placeName>, <date calendar="gregorian"
                            when="1900-01-06"><hi rendition="#italic">January 6,
                        1900</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: The 2,000 bags branded Speria, on steamer
                        <hi rendition="#italic">Maria</hi>, marked O &amp; Co., Delagoa Bay; the
                    1,500 Goldfields, same steamer, marked diamond T with letter S outside diamond,
                    also Delagoa Bay; the 4,300 branded Johannesburg, on <hi rendition="#italic"
                        >Beatrice</hi>, marked diamond B, letter M outside, Delagoa Bay; the 1,300
                    Goldfields, same steamer, diamond T, S outside, Delagoa Bay; the 3,100 branded
                    Johannesburg, on steamer <hi rendition="#italic">Mashona</hi>, marked diamond B,
                    letter M outside diamond, Delagoa Bay.</p>
                <closer><signed><hi rendition="#small-caps">A. J. Toomey</hi>,<lb/><hi
                            rendition="#italic">President Pennsylvania Milling and Export
                        Co.</hi></signed></closer>
            </div>
        </body>
    </text>
