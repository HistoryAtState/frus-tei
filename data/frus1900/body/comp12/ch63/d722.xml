    <text>
        <body>
            <div xml:id="d722">

                <pb facs="0689" n="591" sameAs="frus:frus1900/pg591"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Choate.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1900-02-21"><hi rendition="#italic">February 21,
                        1900</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 313.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose for your use a copy of a letter
                    from Messrs. Arkell &amp; Douglas, of New York City, relative to the shipment of
                    certain merchandise by said firm by the steamships <hi rendition="#italic"
                        >Maria, Beatrice</hi>, and <hi rendition="#italic">Mashona</hi>, which were
                    recently seized and detained by the British naval authorities off the east coast
                    of Africa.</p>
                <p>Bills of lading<anchor n="1" xml:id="d722-f1"/> in duplicate for the merchandise
                    in question are herewith transmitted to you.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>


                <xi:include href="d722-a1.xml" xpointer="d722-a1"/>
            </div>
        </body>
    </text>
