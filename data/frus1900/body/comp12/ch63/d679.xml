                <pb facs="0650" n="552" sameAs="frus:frus1900/pg552"/>

                <head><hi rendition="#italic">Mr. Choate to Mr.
                            Hay.</hi></head>
                <opener><seg rendition="#center">[Telegram in cipher—Paraphrase.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1900-01-12"><hi rendition="#italic">January 12,
                        1900</hi></date>.</dateline></opener>
                <p>[Mr. Choate states that in answer to his pressing inquiries foreign office states
                    that it has no information regarding seizures not already possessed by the
                    United States Government, and that it would furnish facts as soon as it received
                    them.]</p>
            </div>
        </body>
