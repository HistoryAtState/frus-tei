    <text>
        <body>
            <div xml:id="d710">

                <pb facs="0675" n="577" sameAs="frus:frus1900/pg577"/>

                <head><hi rendition="#italic">Mr. Hay to Mr. Choate.</hi></head>
                <opener><dateline rendition="#float-right"><date calendar="gregorian"
                            when="1900-01-30"><hi rendition="#small-caps">January</hi> 30,
                            1900</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I herewith transmit to you the manifest of
                    the ship <hi rendition="#italic">Mashona</hi>, certified by the collector of the
                    port of New York, as suggested by you in your cablegram of the 21th instant. A
                    copy has been forwarded to our consul at Cape Town.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
    </text>
