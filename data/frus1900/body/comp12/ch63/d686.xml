                <pb facs="0656" n="558" sameAs="frus:frus1900/pg558"/>

                <head><hi rendition="#italic">Mr. Choate to Mr.
                            Hay.</hi></head>
                <opener><seg rendition="#center">[Telegram in cipher.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1900-01-15"><hi rendition="#italic">January 15,
                        1900</hi></date>.</dateline></opener>
                <opener><seg rendition="#center">[Paraphrase.]</seg></opener>
                <p>[Mr. Choate reports that the question of the ownership of the <hi
                        rendition="#italic">Mashona’s</hi> cargo was embarrassed by the fact that
                    the British foreign office was advised that the vessel had no manifest, and
                    inquires as to the correctness of this advice.]</p>
            </div>
        </body>
