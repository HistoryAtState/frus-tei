    <text>
        <body>
            <div xml:id="d691">

                <pb facs="0659" n="561" xml:id="pg561"/>

                <head><hi rendition="#italic">Messrs. C. C. Abel &amp; Co. to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >New York</hi></placeName>, <date calendar="gregorian"
                            when="1900-01-17"><hi rendition="#italic">January 17,
                        1900</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: We are in receipt of your communication of
                    the 16th instant, and thank you for your courteous and prompt reply to our
                    letter of the 12th instant.</p>
                <p>It will be necessary for us to put ourselves in further correspondence with the
                    consignees of the petroleum to enable us to give you the required
                    particulars.</p>
                <p>We are, sir, your obedient servants,</p>
                <closer><hi rendition="#small-caps">C. C. Abel</hi> &amp; Co.</closer>
            </div>
        </body>
    </text>
