    <text>
        <body>
            <div xml:id="d706-a3">

                <pb facs="0672" n="574" sameAs="frus:frus1900/pg574"/>

                <opener><seg rendition="#center">[Inclosure 3 in No. 237.]</seg></opener>
                <head><hi rendition="#italic">Mr. Bertie to Mr. Choate.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Foreign Office</hi></placeName>, <date calendar="gregorian"
                            when="1900-01-26"><hi rendition="#italic">January 26,
                        1900</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Your Excellency</hi>: With reference to my note of
                    the 10th instant, respecting the case of the <hi rendition="#italic">Maria</hi>,
                    I have the honor to inclose a copy of a memorandum on the subject which has been
                    drawn up in this department, and which contains all the facts of the case so far
                    as they are at present known in this country.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Francis Bertie</hi></signed>,<lb/>(For
                    the Marquis of Salisbury.)</closer>
            </div>
        </body>
    </text>
