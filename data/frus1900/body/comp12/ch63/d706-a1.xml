    <text>
        <body>
            <div xml:id="d706-a1">

                <pb facs="0672" n="574" sameAs="frus:frus1900/pg574"/>

                <opener><seg rendition="#center">[Inclosure 1 in No. 237.]</seg></opener>
                <head><hi rendition="#italic">Lord Salisbury to Mr.
                            Choate.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Foreign Office</hi></placeName>, <date calendar="gregorian"
                            when="1900-01-24"><hi rendition="#italic">January 24,
                        1900</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Your Excellency</hi>: I have the honor to acknowledge
                    the receipt of your note of the 15th instant respecting certain goods which were
                    shipped from New York on board the British steamer <hi rendition="#italic"
                        >Beatrice</hi>, and I have to inform your excellency that Her Majesty’s high
                    commissioner for South Africa has been instructed by telegraph to send home a
                    full report of the circumstances of the case.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Salisbury.</hi></signed></closer>
            </div>
        </body>
    </text>
