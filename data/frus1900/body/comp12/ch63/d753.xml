    <text>
        <body>
            <div xml:id="d753">

                <pb facs="0714" n="616" xml:id="pg616"/>

                <head><hi rendition="#italic">Mr. Hay to Mr. Choate.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1900-06-25"><hi rendition="#italic">June 25,
                        1900</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 401.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I confirm my telegram of the 22d instant
                    with regard to the shipments of Mr. Geldart on the <hi rendition="#italic"
                        >Mashona</hi> and <hi rendition="#italic">Beatrice.</hi></p>
                <p>In this connection I inclose for your information copy of his letter on the
                    subject, dated June 20.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>


                <xi:include href="d753-a1.xml" xpointer="d753-a1"/>
            </div>
