        <body>
            <div xml:id="d721-a4">

                <pb facs="0689" n="591" xml:id="pg591"/>

                <opener><seg rendition="#center">[Subinclosure 3.]</seg></opener>
                <head><hi rendition="#italic">Invoice of cottonseed oil shipped by the undersigned
                        per steamship Maria to Delagoa Bay, South Africa, for account and risk of
                        Messrs. Patlansky Brothers, of Johannesburg.</hi></head>
                <p rendition="#flush">Marks: P. B.—J. Delagoa Bay. No. 1/100.</p>
                <table cols="3" rows="9">
                    <row role="label">
                        <cell cols="2">100 c/s summer oil, containing 1,000 gallons and costing 42
                            cents, le per cent</cell>
                        <cell role="num">$415.80</cell>
                    </row>
                    <row>
                        <cell>Charges:</cell>
                        <cell/>
                        <cell/>
                    </row>
                    <row>
                        <cell rend="padding-left: 3em;">Freight.</cell>
                        <cell role="num">$60.27</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell rend="padding-left: 3em;">Bill of lading stamp</cell>
                        <cell role="num">.10</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell rend="padding-left: 3em;">Insurance</cell>
                        <cell role="num">4.50</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell rend="padding-left: 3em;">Bill stamps</cell>
                        <cell role="num">.08</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell rend="padding-left: 3em;">Commission</cell>
                        <cell rendition="#border-bottom" role="num">12.02</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell/>
                        <cell/>
                        <cell rendition="#border-bottom" role="num">76.97</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell/>
                        <cell role="num">492.77</cell>
                    </row>
                </table>
                <closer><signed><hi rendition="#small-caps">R. W. Geldart.</hi></signed>
                    <lb/>
                    <dateline rendition="#float-left">E. &amp; O. E.,<lb/><placeName><hi
                                rendition="#italic">New York</hi></placeName>, <date
                            calendar="gregorian" when="1899-08-23"><hi rendition="#italic">August
                                23, 1899</hi></date>.</dateline>
                </closer>
            </div>
