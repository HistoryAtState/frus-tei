    <text>
        <body>
            <div xml:id="d776">

                <pb facs="0730" n="632" sameAs="frus:frus1900/pg632"/>

                <head><hi rendition="#italic">Lord Pauncefote to
                        Mr. Hill.</hi></head>
                <opener><seg rendition="#center">[Personal.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >British Embassy</hi>,<lb/><hi rendition="#italic">Newport R.
                                I.</hi></placeName>, <date calendar="gregorian" when="1900-09-15"
                                ><hi rendition="#italic">September 15,
                    1900</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. Hill</hi>: I have received a telegram from
                    the Marquis of Salisbury in which he desires me to convey to the Secretary of
                    State the deep sympathy of Her Majesty’s Government on the occasion of the
                    terrible disaster at Galveston.</p>
                <p>I take this opportunity of expressing my own sorrow at this calamitous event.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Pauncefote.</hi></signed></closer>
            </div>
        </body>
    </text>
