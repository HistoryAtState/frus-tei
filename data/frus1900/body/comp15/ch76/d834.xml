    <text>
        <body>
            <div xml:id="d834">

                <pb facs="0812" n="714" sameAs="frus:frus1900/pg714"/>

                <head><hi rendition="#italic">Mr. Adee to Mr. Léger.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1900-09-18"><hi rendition="#italic">September 18,
                        1900</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 50.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of the 15th instant, expressing your sorrow on learning of the
                    terrible disaster in Texas.</p>
                <p>In reply I have the honor to advise you that this Government sincerely
                    appreciated your message of sympathy.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alvey A. Adee.</hi></signed></closer>
            </div>
        </body>
    </text>
