            <div xml:id="d867-a9">

                <pb facs="0841" n="743" xml:id="pg743"/>

                <opener><seg rendition="#center">[Inclosure 9.]</seg></opener>
                <head><hi rendition="#italic">Dr. Wyman to Dr. Kinyoun.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington, D. C.</hi></placeName>, <date calendar="gregorian"
                            when="1900-05-16"><hi rendition="#italic">May 16,
                        1900</hi></date>.</dateline></opener>
                <p>In event plague becomes offcially proclaimed, see J. C. Stubbs, third
                    vice-president, or J. C. Kruchtnitt, general manager; request refusal of tickets
                    to Chinese and Japanese, without accompanied by certificate signed by
                    marine-hospital officer.</p>
                <closer><signed><hi rendition="#small-caps">Wyman.</hi></signed></closer>
            </div>
        </body>
