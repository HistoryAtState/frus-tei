    <text>
        <body>
            <div xml:id="d874">

                <pb facs="0846" n="748" sameAs="frus:frus1900/pg748"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Nabeshima.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1900-06-15"><hi rendition="#italic">June 15,
                        1900</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 40.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of the 12th instant, and to say in reply that the complaints made
                    by you of the quarantine regulations of Colorado and San Francisco are receiving
                    the careful consideration of the Department, the result of which will be
                    communicated to you as soon as a conclusion is reached.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
    </text>
