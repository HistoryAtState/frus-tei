    <text>
        <body>
            <div xml:id="d964">

                <pb facs="0934" n="836" sameAs="frus:frus1900/pg836"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Dudley.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1900-01-04"><hi rendition="#italic">January 4,
                        1900</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 220.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    No. 327 of the 6th ultimo, forwarding the United States copy of the treaty
                    providing for the extradition of criminals, signed by yourself and the Peruvian
                    minister for foreign affairs.</p>
                <p>The same has been transmitted to the Senate to receive the advice and consent of
                    that body to its ratification.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
    </text>
