    <text>
        <body>
            <div xml:id="d966">

                <pb facs="0935" n="837" sameAs="frus:frus1900/pg837"/>

                <head><hi rendition="#italic">Mr. Dudley to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Lima Peru</hi></placeName>, <date calendar="gregorian"
                            when="1900-03-10"><hi rendition="#italic">March 10,
                        1900</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 352.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your instruction No. 224, of February 12, 1900, informing me of the
                    ratification, in a slightly amended form, of the treaty of extradition between
                    the United States and Peru by the United States Senate, and beg to submit
                    herewith copy of notes since exchanged in relation thereto between this legation
                    and the Peruvian foreign office.</p>
                <p>I regret to state that in the ordinary course the Peruvian Congress will not
                    reconvene until the 28th of July next.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Irving B. Dudley.</hi></signed></closer>




                <xi:include href="d966-a1.xml" xpointer="d966-a1"/>
