    <text>
        <body>
            <div xml:id="d786">

                <pb facs="0740" n="642" sameAs="frus:frus1900/pg642"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Hardy.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1900-04-28"><hi rendition="#italic">April 28,
                        1900</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 20, Greek series.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to previous correspondence
                    concerning the military-service case of Mr. Economopoulos, I have to inform you
                    that your note of the 3d instant, recalling the matter in question to the
                    attention of the Greek foreign office, has been received and read with
                    approval.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
    </text>
