    <text>
        <body>
            <div xml:id="d1061-a4">

                <pb facs="1035" n="937" xml:id="pg937"/>

                <opener><seg rendition="#center">[Inclosure 4.]</seg></opener>
                <p>I, the undersigned, George Joseph, do hereby solemnly declare, under oath, that I
                    left the United States July 8, 1899; that before leaving I made several
                    inquiries as to the requirements for entering Syria; that I was instructed to
                    provide myself with a Turkish passporrt, as such passport would be absolutely
                    necessary; that I came to Syria on a Turkish passport; that I do not intend to
                    submit to Turkish authority over me as a subject, but shall remain a loyal
                    American.</p>
                <closer><signed><hi rendition="#small-caps">George Joseph.</hi></signed></closer>
                <closer>
                    <dateline rendition="#float-right"><hi rendition="#small-caps">Consulate of the
                            United States</hi>, <lb/>
                        <placeName><hi rendition="#italic">Beirut, Syria</hi></placeName>, <date
                            calendar="gregorian" when="1899-11-15"><hi rendition="#italic">November
                                15, 1899</hi></date>.</dateline>
                    <lb/> Subscribed and sworn to before me this day and year next above written. <lb/>
                    <signed><hi rendition="#small-caps">G. Bie Ravndal.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
