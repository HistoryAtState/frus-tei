                <pb facs="0794" n="696" sameAs="frus:frus1900/pg696"/>

                <head><hi rendition="#italic">Mr. Hay to Mr. Everett.</hi></head>
                <opener><seg rendition="#center">[Telegram.—Paraphrase.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1900-10-10"><hi rendition="#italic">October 10,
                        1900</hi></date>.</dateline></opener>
                <p>(Mr. Hay directs Mr. Everett to insist upon the payment of $10,000 in gold, the
                    offer of the Government of Honduras being unacceptable.)</p>
            </div>
