    <text>
        <body>
            <div xml:id="d66">

                <pb facs="0167" n="71" xml:id="pg71"/>

                <head><hi rendition="#italic">Señor Infante to Mr.
                            Hay.</hi></head>
                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Chilean Legation</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1900-01-22"><hi rendition="#italic">January 22,
                        1900</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In compliance with instructions of my
                    Government, I have the honor of remitting to your excellency a check on the
                    Riggs National Bank for the sum of $3,500 for the purpose of paying the
                    indemnity which was granted under the protocol of May 24, 1897, to the heirs of
                    Patrick Shields.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">E. Infante.</hi></signed></closer>
            </div>
        </body>
    </text>
