    <text>
        <body>
            <div xml:id="d8">

                <pb facs="0106" n="10" sameAs="frus:frus1900/pg10"/>

                <head><hi rendition="#italic">Mr. Hay to Mr. Wilde</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1900-06-28"><hi rendition="#italic">June 28,
                        1900</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 4.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose for your
                    information copies of letters addressed by the Secretary of the Navy to officers
                    of his Department directing that every courtesy shall be shown to the officers
                    and cadets of the Argentine school ship <hi rendition="#italic">Presidente
                        Sarmiento</hi>.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay</hi>.</signed></closer>




