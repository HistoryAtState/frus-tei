    <text>
        <body>
            <div xml:id="d4-a1">

                <pb facs="0104" n="8" xml:id="pg8"/>

                <opener><seg rendition="#center">[Inclosure.]</seg></opener>
                <head><hi rendition="#italic">Mr. Long to Mr. Hay</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Navy Department</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1900-03-09"><hi rendition="#italic">March 9,
                        1900</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith for
                    the information of the State Department a copy of a letter received from the
                    commander in chief of the South Atlantic Station, wherein he requests that the
                    Department of State may be informed of the good impression made by Mr. François
                    S. Jones, chargé d’affaires ad interim at Buenos Ayres, Argentina.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John D. Long</hi>.</signed></closer>
            </div>
        </body>
