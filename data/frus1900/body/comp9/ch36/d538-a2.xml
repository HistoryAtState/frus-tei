    <text>
        <body>
            <div xml:id="d538-a2">

                <pb facs="0523" n="425" sameAs="frus:frus1900/pg425"/>

                <opener><seg rendition="#center">[Inclosure 2.]</seg></opener>
                <head><hi rendition="#italic">Mr. Powell to Mr.
                            Henriquez y Carvajal.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Santo Domingo City</hi></placeName>, <date calendar="gregorian"
                            when="1900-01-15"><hi rendition="#italic">January 15,
                        1900</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Having arrived in your city to-day I will
                    be glad if you will name such time that I may have the pleasure of paying my
                    respects to you.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. F. Powell.</hi></signed></closer>
            </div>
        </body>
