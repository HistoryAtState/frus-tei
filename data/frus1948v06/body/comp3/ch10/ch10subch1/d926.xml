    <text>
        <body>
            <div xml:id="d926">

                <pb facs="1351" n="1337" sameAs="frus:frus1948v06/pg1337"/>

                <note rend="inline" type="source">740.00119 Control (Korea)/12–1748</note>
                <head>
                    <hi rendition="#italic">Memorandum by the Chief of the Division of Northeast
                        Asian Affairs</hi> (<hi rendition="#italic"
                            >Bishop</hi>) <hi rendition="#italic">to the Director of the
                        Office of Far Eastern Affairs</hi> (<hi
                            rendition="#italic">Butterworth</hi>)</head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1948-12-17">December 17, 1948</date>.</dateline>
                </opener>
                <p>Attached is a draft of a memorandum which Niles Bond and I have prepared for your
                    consideration. We would suggest that it be a memorandum from you to the Acting
                    Secretary.</p>



                <xi:include href="d926-a1.xml" xpointer="d926-a1"/>
            </div>
