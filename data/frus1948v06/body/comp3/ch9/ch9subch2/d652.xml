    <text>
        <body>
            <div xml:id="d652">

                <pb facs="0983" n="969" sameAs="frus:frus1948v06/pg969"/>

                <note rend="inline" type="source">894.50/4–2348</note>
                <head>
                    <hi rendition="#italic">The Acting Political Adviser in Japan</hi> (<hi rendition="#italic">Sebald</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">restricted</hi>
                        <lb/> No. 243</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Tokyo</hi></placeName>, <date
                            calendar="gregorian" when="1948-04-23">April 23, 1948.</date>
                        <lb/> [Received May 3.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: As of possible interest to the Department
                    in connection with this Mission’s view that the economic deconcentration program
                    in Japan should be completed as a matter of urgency, I have the honor to
                    transmit as enclosures herewith copies of certain self-explanatory papers
                    prepared in the Antitrust and Cartels Division.<anchor n="1" xml:id="d652-f1"/>
                    Other pertinent papers were forwarded with the Mission’s despatch 126, February
                    27, 1948.<anchor n="2" xml:id="d652-f2"/>
                </p>
                <p>Respectfully yours,</p>
                <closer>
                    <signed>W. J. <hi rendition="#small-caps">Sebald</hi>
                    </signed>
                </closer>


                <xi:include href="d652-a1.xml" xpointer="d652-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
