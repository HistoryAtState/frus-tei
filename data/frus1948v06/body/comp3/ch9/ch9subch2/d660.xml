    <text>
        <body>
            <div xml:id="d660">

                <pb facs="0996" n="982" sameAs="frus:frus1948v06/pg982"/>

                <note rend="inline" type="source">740.00119 PW/7–848</note>
                <head>
                    <hi rendition="#italic">Memorandum by the Assistant Secretary of State for
                        Occupied Areas</hi> (<hi rendition="#italic">Saltzman</hi>) <hi
                        rendition="#italic">to the United States Representative on the Far Eastern
                        Commission</hi> (<hi rendition="#italic">McCoy</hi>)</head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">restricted</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1948-07-08">July 8, 1948</date>.</dateline>
                </opener>
                <p>With reference to questions raised by various members at the meeting of the Far
                    Eastern Commission on July 1, 1948 with respect to the source and substance of
                    articles appearing in Japanese newspapers and dealing with the deliberations of
                    the Far Eastern Commission on the subject of a program of replacement of lost
                    cultural objects, the United States Member is authorized to transmit the
                    substance of the attached statement to the other members of the Far Eastern
                    Commission.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Charles</hi> E. <hi rendition="#small-caps"
                            >Saltzman</hi>
                    </signed>
                </closer>


                <xi:include href="d660-a1.xml" xpointer="d660-a1"/>
            </div>
        </body>
    </text>
