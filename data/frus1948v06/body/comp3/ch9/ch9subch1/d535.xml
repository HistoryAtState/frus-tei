    <text>
        <body>
            <div xml:id="d535">

                <pb facs="0764" n="750" sameAs="frus:frus1948v06/pg750"/>

                <note rend="inline" type="source">894.50/4–948</note>
                <head>
                    <hi rendition="#italic">Memorandum by the Assistant Secretary of State for
                        Occupied Areas</hi> (<hi rendition="#italic"
                            >Saltzman</hi>), <hi rendition="#italic">to the United States
                        Representative on the Far Eastern Commission</hi> (<hi
                            rendition="#italic">McCoy</hi>)</head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">confidential</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1948-05-06">May 6, 1948</date>.</dateline>
                </opener>
                <p>In reference to your letter of April 9, 1948 to the Secretary of State<anchor
                        n="1" xml:id="d535-f1"/> concerning a statement of the Soviet representative
                    on the Far Eastern Commission presented at the meeting on April 8, 1948, I am
                    enclosing a proposed reply for your use in the Commission.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Charles</hi> E. <hi rendition="#small-caps"
                            >Saltzman</hi>
                    </signed>
                </closer>


                <xi:include href="d535-a1.xml" xpointer="d535-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d535-f1" n="1" xml:id="d535-f1-content">
                <p>Not printed, but see memorandum of April 8, <ref target="#pg724">p. 724</ref>,
                    and annex 2, <ref target="#pg725">p. 725</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
