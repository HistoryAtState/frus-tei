    <text>
        <body>
            <div xml:id="d429">

                <pb facs="0586" n="572" sameAs="frus:frus1948v06/pg572"/>

                <note rend="inline" type="source">501.BC Indonesia/12–1848: Telegram</note>
                <head>
                    <hi rendition="#italic">The Consul General at Batavia</hi> (<hi
                        rendition="#italic">Livengood</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                        <lb/>
                        <hi rendition="#small-caps">us urgent</hi>
                        <lb/>
                        <hi rendition="#small-caps">niact</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Batavia</hi></placeName>, <date
                            calendar="gregorian" when="1948-12-18T11:00:00+08:00">December 18,
                            1948—11 a. m.</date>
                        <lb/> [Received December 18—10:02 a. m.]</dateline>
                </opener>
                <p>1107. Gocus 492.1 delivered to Schuurman December 18, 9:40 a. m., following
                    letter dated Kaliurang December 17 addressed Schuurman signed Cochran.</p>
                <p>[Here follows text printed in SC, <hi rendition="#italic">3rd yr., Suppl.</hi>
                    (Dec.), page 220.]</p>
                <p>Signed Cochran.<anchor n="1" xml:id="d429-f1"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Livengood</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d429-f1" n="1" xml:id="d429-f1-content">
                <p>For reply by the acting chairman of the Netherlands delegation, dated Batavia,
                    December 20, see SC, <hi rendition="#italic">3rd yr., Suppl.</hi> (Dec.), p.
                    241. The text was transmitted in telegram 1127, December 21, noon, from Batavia
                    (Gocus 502), and repeated in telegram 4901, December 22, 7 p. m., to Paris (for
                    Jessup).</p>
            </note>
        </listAnnotation>
    </standOff>
