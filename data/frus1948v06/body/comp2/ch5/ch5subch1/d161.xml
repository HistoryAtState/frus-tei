    <text>
        <body>
            <div xml:id="d161">

                <pb facs="0232" n="218" sameAs="frus:frus1948v06/pg218"/>

                <note rend="inline" type="source">501.BC
                    Indonesia/6–548</note>
                <head>
                    <hi rendition="#italic">The United States Representative, Committee of Good
                        Offices</hi> (<hi rendition="#italic"
                        >duBois</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">restricted</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Kaliurang, Java</hi></placeName>, <date
                            calendar="gregorian" when="1948-06-05">June 5, 1948.</date>
                        <lb/> [Received June 22.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to submit a draft of a
                    suggestion for the outline of a political agreement between the Kingdom of the
                    Netherlands and the Republic of Indonesia which the United States Delegation
                    yesterday presented to the Australian and Belgian Delegations in the hope that a
                    working paper by the Committee of Good Offices can be agreed upon on the basis
                    of this draft and presented to the parties.</p>
                <p>Respectfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Coert duBois</hi>
                    </signed>
                </closer>



                <xi:include href="d161-a1.xml" xpointer="d161-a1"/>
