            </note>
            <note corresp="#d483-f2" n="2" xml:id="d483-f2-content">
                <p>Signed at Manila, November 16, 1946; for text, see Department of State <hi
                        rendition="#italic">Bulletin</hi>, February 9, 1947, p. 254.</p>
            </note>
        </listAnnotation>
