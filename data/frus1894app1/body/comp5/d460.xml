    <text>
        <body>
            <div xml:id="d460">

                <pb facs="0508" n="502" sameAs="frus:frus1894app1/pg502"/>

                <head><hi rendition="#italic">Mr. Wharton to Señor Bolet-Peraza.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1892-03-22"><hi rendition="#italic">March 22,
                        1892</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a half
                    dozen printed copies of the President’s proclamation of the 15th instant,
                    suspending the free admission into the United States of certain articles the
                    production of the Republic of Venezuela.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">William F. Wharton</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>


                <xi:include href="d460-a1.xml" xpointer="d460-a1"/>
            </div>
