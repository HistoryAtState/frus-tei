                <pb facs="0499" n="493" sameAs="frus:frus1894app1/pg493"/>

                <head><hi rendition="#italic">Mr. Gresham to Señor Hurtado.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1893-10-10"><hi rendition="#italic">October 10,
                        1893</hi></date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#italic">My dear</hi> Mr. <hi
                        rendition="#small-caps">Hurtado</hi>:</p>
                <p>If convenient to you, I shall be greatly obliged if you will call at the
                    Department to-morrow, Wednesday, the 11th instant, any time between 10 and 11
                    o’clock in the morning, for a conference in relation to your note of October 5,
                    1893.</p>
                <p>Very truly, yours,</p>
                <closer><signed><hi rendition="#small-caps">W. Q. Gresham.</hi></signed></closer>
            </div>
        </body>
    </text>
