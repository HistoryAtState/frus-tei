    <text>
        <body>
            <div xml:id="d226">

                <pb facs="0220" n="214" sameAs="frus:frus1894app1/pg214"/>

                <head><hi rendition="#italic">Sir Julian Pauncefote
                        to Mr. Gresham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1894-08-01"><hi rendition="#italic">August 1,
                        1894</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In accordance with instructions which I
                    have received from the Earl of Kimberley, I have the honor to inclose herewith
                    copy of an Order in Council of the 27th ultimo, providing for the special form
                    of license to be granted to sealing vessels in the Bering Sea, and describing
                    the distinctive flag to be flown by them.</p>
                <p>I have etc.,</p>
                <closer><signed><hi rendition="#small-caps">Julian
                    Pauncefote.</hi></signed></closer>




