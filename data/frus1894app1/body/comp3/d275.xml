                <pb facs="0270" n="264" sameAs="frus:frus1894app1/pg264"/>

                <head><hi rendition="#italic">Mr. Braida to Mr. Uhl.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Consulate of the United States</hi>,<lb/><hi rendition="#italic"
                                >Bluefields</hi></placeName>, <date calendar="gregorian"
                            when="1894-03-29"><hi rendition="#italic">March 29, 1894</hi></date>.
                        (Received April 11.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith a
                    decree issued last night and sent to me by the Honorable Minister Don José
                    Madriz.</p>
                <p>I beg to remain, etc.,</p>
                <closer><signed><hi rendition="#small-caps">S. C. Braida.</hi></signed></closer>





