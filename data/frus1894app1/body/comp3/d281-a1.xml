    <text>
        <body>
            <div xml:id="d281-a1">

                <pb facs="0275" n="269" sameAs="frus:frus1894app1/pg269"/>

                <opener><seg rendition="#center">[Inclosure.—Translation.]</seg></opener>
                <head><hi rendition="#italic">Mr. Rivas to Mr. Baker.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><placeName type="venue"><hi
                                    rendition="#small-caps">National Palace</hi></placeName>, <lb/>
                            <placeName type="city"><hi rendition="#italic"
                            >Managua</hi></placeName></placeName>, <date calendar="gregorian"
                            when="1894-04-02"><hi rendition="#italic">April 2,
                        1894</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Mr. Minister</hi>: With the present communication I
                    have the honor to remit to your excellency an authorized copy of the telegram
                    directed to His Excellency the President by the commissioner of the Mosquito
                    Reserve, enunciating the basis stipulated with the English consul for the
                    provisional administration of the said reserve.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">R. Mayorga Rivas.</hi></signed></closer>
            </div>
        </body>
