    <text>
        <body>
            <div xml:id="d254">

                <pb facs="0241" n="235" xml:id="pg235"/>

                <head><hi rendition="#italic">Mr. Baker to Mr. Gresham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Managua, Nicaragua</hi></placeName>, <date calendar="gregorian"
                            when="1894-02-09"><hi rendition="#italic">February 9, 1894</hi></date>,
                        (Received March 5.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have just received from United States
                    Consul Braida a report from B. B. Seat, United States consular agent at
                    Bluefields, a communication of which I inclose herewith a copy.</p>
                <p>It relates to the unsatisfactory condition of political affairs in the Mosquito
                    Reservation.</p>
                <p>There seems to be trouble brewing in that quarter.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Lewis Baker.</hi></signed></closer>


                <xi:include href="d254-a1.xml" xpointer="d254-a1"/>
