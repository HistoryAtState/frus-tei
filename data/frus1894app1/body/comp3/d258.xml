    <text>
        <body>
            <div xml:id="d258">

                <pb facs="0245" n="239" sameAs="frus:frus1894app1/pg239"/>

                <head><hi rendition="#italic">Mr. Guzman to Mr.
                            Gresham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the Republic of Nicaragua</hi>,<lb/><hi
                                rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1894-03-05"><hi rendition="#italic">March 5,
                                1894</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Appended to the present communication I
                    have the honor to send to Your Excellency copy of a telegram addressed to me by
                    the vice-consul of Nicaragua at New York.</p>
                <p>The report contained in this dispatch has been already published in the American
                    daily papers, as Your Excellency may have seen.</p>
                <p>With all consideration, I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">H. Guzman.</hi></signed></closer>


                <xi:include href="d258-a1.xml" xpointer="d258-a1"/>
