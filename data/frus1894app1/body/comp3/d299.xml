    <text>
        <body>
            <div xml:id="d299">

                <pb facs="0312" n="306" sameAs="frus:frus1894app1/pg306"/>

                <head><hi rendition="#italic">Mr. Guzman to Mr. Gresham.</hi></head>
                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the Republic of Nicaragua</hi>,<lb/><hi
                                rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1894-07-12"><hi rendition="#italic">July 12,
                                1894</hi></date>. (Received July 18.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to send your excellency
                    copy of a cablegram I have just received from my Government, and I permit myself
                    to invite your excellency’s attention to the gravity of the matter which gives
                    rise to that dispatch.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">H. Guzman.</hi></signed></closer>


                <xi:include href="d299-a1.xml" xpointer="d299-a1"/>
