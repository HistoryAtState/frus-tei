    <text>
        <body>
            <div xml:id="d598">

                <pb facs="0615" n="609" sameAs="frus:frus1894app1/pg609"/>

                <head><hi rendition="#italic">Sir Julian Pauncefote
                        to Mr. Gresham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1893-12-12"><hi rendition="#italic">December 12,
                        1893</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In accordance with instructions which I
                    have received from the Earl of Rosebery, I have the honor to inclose a copy of a
                    dispatch addressed to his lordship by Her Majesty’s consul at Apia, reporting on
                    the collection of native taxes in the Navigators Islands.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Julian
                    Pauncefote.</hi></signed></closer>


                <xi:include href="d598-a1.xml" xpointer="d598-a1"/>
            </div>
