    <text>
        <body>
            <div xml:id="d498">

                <pb facs="0549" n="543" xml:id="pg543"/>

                <head><hi rendition="#italic">Mr. Adee to Mr. Herbert.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1892-08-15"><hi rendition="#italic">August 15,
                        1892</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of the 8th instant, inclosing a copy of a letter from Mr. Thomas
                    Maben, stating the reasons which have led him to accept the appointment of
                    secretary of state in the Samoan Government.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alvey A. Adee</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
