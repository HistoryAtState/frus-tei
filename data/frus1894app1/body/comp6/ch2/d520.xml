    <text>
        <body>
            <div xml:id="d520">

                <pb facs="0578" n="572" sameAs="frus:frus1894app1/pg572"/>

                <head><hi rendition="#italic">Mr. Foster to Mr.
                            Herbert.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1892-09-30"><hi rendition="#italic">September 30,
                        1892</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of the 27th instant, with which were inclosed copies of the
                    correspondence between the foreign office and the German embassy in London, in
                    relation to the “real property ordinance, 1891,” issued by the chief justice of
                    Samoa.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John W. Foster.</hi></signed></closer>
            </div>
        </body>
    </text>
