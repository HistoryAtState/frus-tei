    <text>
        <body>
            <div xml:id="d494">

                <pb facs="0546" n="540" sameAs="frus:frus1894app1/pg540"/>

                <head><hi rendition="#italic">Mr. Foster to Mr. Herbert.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1892-07-11"><hi rendition="#italic">July 11,
                        1892</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of Sir Julian Pauncefote’s note of April 19 last, and of your note of the 5th
                    instant, and to inclose for your information a copy of an instruction to the
                    vice consul of the United States at Apia of the 11th instant, concerning the
                    joint action of the three treaty powers in Samoa in the use of their war vessels
                    to aid in the enforcement and execution of the warrant issuing from the superior
                    court of Samoa.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John W. Foster.</hi></signed></closer>



                <xi:include href="d494-a1.xml" xpointer="d494-a1"/>
            </div>
