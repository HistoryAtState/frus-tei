    <text>
        <body>
            <div xml:id="d539">

                <pb facs="0587" n="581" sameAs="frus:frus1894app1/pg581"/>

                <head><hi rendition="#italic">Mr. Herbert to Mr. Foster.</hi></head>
                <opener><seg rendition="#center">[Personal.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1892-11-04"><hi rendition="#italic">November 4,
                        1892</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. Foster</hi>: If you have no objection will
                    you kindly send me copies, of Baron Ketteler’s notes of the 15th and 24th
                    ultimo, relative to Samoa, quoted in your note to him of yesterday.</p>
                <p>I am called up to Kew York this evening, but shall be back again by Sunday
                    evening should you desire to see me.</p>
                <p>Very truly, yours,</p>
                <closer><signed><hi rendition="#small-caps">M. H. Herbert.</hi></signed></closer>
            </div>
        </body>
    </text>
