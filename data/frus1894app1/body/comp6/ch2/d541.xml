    <text>
        <body>
            <div xml:id="d541">

                <pb facs="0588" n="582" xml:id="pg582"/>

                <head><hi rendition="#italic">Mr. Foster to Mr.
                            Herbert.</hi></head>
                <opener><seg rendition="#center">[Personal.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1892-11-05"><hi rendition="#italic">November 5,
                        1892</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. Herbert</hi>: In compliance with the request
                    contained in your personal note of the 4th instant, I inclose herewith copies of
                    Baron Ketteler’s notes of the 15th and 24th ultimo in relation to the Samoan
                    question.</p>
                <p>Very truly, yours,</p>
                <closer><signed><hi rendition="#small-caps">John W. Foster.</hi></signed></closer>



                <xi:include href="d541-a1.xml" xpointer="d541-a1"/>
