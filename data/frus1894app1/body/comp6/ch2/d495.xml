    <text>
        <body>
            <div xml:id="d495">

                <pb facs="0547" n="541" sameAs="frus:frus1894app1/pg541"/>

                <head><hi rendition="#italic">Mr. Foster to Mr.
                            Herbert.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1892-07-13"><hi rendition="#italic">July 13,
                        1892</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inform you that the
                    copy of a dispatch from Her Majesty’s consul in Samoa that accompanied your note
                    of the 11th instant has been read with interest.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John W. Foster.</hi></signed></closer>
            </div>
        </body>
    </text>
