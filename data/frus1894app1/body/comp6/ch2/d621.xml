    <text>
        <body>
            <div xml:id="d621">

                <pb facs="0628" n="622" sameAs="frus:frus1894app1/pg622"/>

                <head><hi rendition="#italic">Mr. Uhl to Sir Julian Pauncefote.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1894-05-16"><hi rendition="#italic">May 16,
                        1894</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I have the honor to acknowledge the
                    receipt of your note of the 14th instant, in which you inclose copy of a
                    dispatch from Her Majesty’s consul at Apia, reporting the steps taken by the
                    consular representatives of the three powers with a view to the restoration of
                    peace in the Navigators Islands.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Edwin F. Uhl</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
