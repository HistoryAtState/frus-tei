    <text>
        <body>
            <div xml:id="d607">

                <pb facs="0621" n="615" xml:id="pg615"/>

                <head><hi rendition="#italic">Sir Julian Pauncefote
                        to Mr. Gresham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >British Embassy</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1894-02-21"><hi rendition="#italic">February 21,
                        1894</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In accordance with instructions received
                    from the Earl of Rosebery, I have the honor to inclose copy of a dispatch
                    addressed to his lordship by Her Majesty’s consul at Apia, reporting further
                    complications in the Navigators Islands and the action which it is proposed to
                    take in the matter.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Julian
                    Pauncefote.</hi></signed></closer>


                <xi:include href="d607-a1.xml" xpointer="d607-a1"/>
