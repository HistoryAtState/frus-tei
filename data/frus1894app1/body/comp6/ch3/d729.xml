    <text>
        <body>
            <div xml:id="d729">

                <pb facs="0698" n="692" sameAs="frus:frus1894app1/pg692"/>

                <head><hi rendition="#italic">Mr. Adee to Baron Saurma.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1893-10-14"><hi rendition="#italic">October 14,
                        1893</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I have the honor to acknowledge the
                    receipt of your note of the 11th instant, wherein you set forth the probable
                    cost of deportation of Mataafa and his eleven followers to Jaluit, one of the
                    Marshall Islands, and of their maintenance thereon.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alvey A. Adee</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
