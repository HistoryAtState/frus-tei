    <text>
        <body>
            <div xml:id="d767">

                <pb facs="0724" n="718" sameAs="frus:frus1894app1/pg718"/>

                <head><hi rendition="#italic">Baron Saurma to Mr.
                            Gresham.</hi></head>
                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Imperial German Embassy</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1894-07-27"><hi rendition="#italic">July 27,
                        1894</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Mr. Secretary of State</hi>: Adverting to the note of
                    the 16th ultimo from Mr. Uhl, Acting Secretary of State, concerning the increase
                    in salary of Chief Justice Ide in Samoa, I have the honor to inform your
                    excellency that the imperial consulate at Apia has been instructed to pay to Mr.
                    Ide $333.33⅓, the Imperial Government’s share of the additional traveling
                    expenses of $1,000 which has been allowed him.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Saurma.</hi></signed></closer>
            </div>
        </body>
    </text>
