    <text>
        <body>
            <div xml:id="d758">

                <pb facs="0718" n="712" sameAs="frus:frus1894app1/pg712"/>

                <head><hi rendition="#italic">Mr. Uhl to Baron
                            Saurma.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1894-05-31"><hi rendition="#italic">May 31,
                        1894</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I have the honor to acknowledge the
                    receipt of your note of the 26th instant, transmitting a copy of a report from
                    the German consul at Apia, dated March 26, 1894, on the situation in Samoa.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Edwin E. Uhl</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
