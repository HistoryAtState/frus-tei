    <text>
        <body>
            <div xml:id="d770">

                <pb facs="0727" n="721" sameAs="frus:frus1894app1/pg721"/>

                <head><hi rendition="#italic">From the German Embassy, September 12,
                    1894.</hi></head>
                <opener><dateline rendition="#float-right">[<date
                            ana="#date_undated-inferred-from-document-head" calendar="gregorian"
                            when="1894-09-12">September 12, 1894</date>.]</dateline></opener>
                <p rendition="#center">[Samoa Times of June 30, 1894.]</p>
                <p rendition="#center"><hi rendition="#small-caps">our imports and exports</hi>.</p>
                <p>The following figures, under different headings and in detail, have been
                    furnished to us by the courtesy of the collector of customs, Mr. I. B. Hay. We
                    publish only the totals:</p>
                <p rendition="#center">1893.</p>
                <p rendition="#center"><hi rendition="#italic">Imports</hi>.</p>
                <table cols="3" rend="bordered" rows="6">
                    <row>
                        <cell/>
                        <cell>Special duties.</cell>
                        <cell>Ad valorem.</cell>
                    </row>
                    <row>
                        <cell>German</cell>
                        <cell role="num">$29,477</cell>
                        <cell role="num">$152,916</cell>
                    </row>
                    <row>
                        <cell>British</cell>
                        <cell role="num">1,956</cell>
                        <cell role="num">58,504</cell>
                    </row>
                    <row>
                        <cell>American</cell>
                        <cell role="num">3,264</cell>
                        <cell role="num">40,519</cell>
                    </row>
                    <row>
                        <cell>Other nations</cell>
                        <cell role="num">3,907</cell>
                        <cell role="num">39,650</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell role="num">38,604</cell>
                        <cell role="num">291,589</cell>
                    </row>
                </table>
                <p rendition="#center"><hi rendition="#italic">Import duties paid by different
                        nationalities</hi>.</p>
                <table cols="4" rend="bordered" rows="6">
                    <row>
                        <cell/>
                        <cell>Specific.</cell>
                        <cell>Ad valorem.</cell>
                        <cell>Total.</cell>
                    </row>
                    <row>
                        <cell>German</cell>
                        <cell role="num">$9,109.49</cell>
                        <cell role="num">$2,751.85</cell>
                        <cell role="num">$11,861.34</cell>
                    </row>
                    <row>
                        <cell>British</cell>
                        <cell role="num">1,204.19</cell>
                        <cell role="num">1,163.19</cell>
                        <cell role="num">2,367.38</cell>
                    </row>
                    <row>
                        <cell>American</cell>
                        <cell role="num">1,368.37</cell>
                        <cell role="num">800.71</cell>
                        <cell role="num">2,169.08</cell>
                    </row>
                    <row>
                        <cell>Other nations</cell>
                        <cell role="num">1,703.36</cell>
                        <cell role="num">789.05</cell>
                        <cell role="num">2,492.41</cell>
                    </row>
                    <row>
                        <cell>Total</cell>
                        <cell/>
                        <cell/>
                        <cell role="num">18,890.21</cell>
                    </row>
                </table>
                <p rendition="#center"><hi rendition="#italic">Produce exports</hi>.</p>
                <table cols="2" rows="5">
                    <row>
                        <cell/>
                        <cell>Pounds.</cell>
                    </row>
                    <row>
                        <cell>Copra</cell>
                        <cell role="num">10,310,500</cell>
                    </row>
                    <row>
                        <cell>Cotton</cell>
                        <cell role="num">156,312</cell>
                    </row>
                    <row>
                        <cell>Coffee</cell>
                        <cell role="num">17,731</cell>
                    </row>
                    <row>
                        <cell>Total</cell>
                        <cell role="num">10,484,543</cell>
                    </row>
                </table>
                <pb facs="0728" n="722" xml:id="pg722"/>
                <p rendition="#center"><hi rendition="#italic">Value of exports—Produce and
                        goods.</hi></p>
                <table cols="2" rows="5">
                    <row role="label">
                        <cell>German</cell>
                        <cell role="num">$170,481</cell>
                    </row>
                    <row>
                        <cell>British</cell>
                        <cell role="num">519</cell>
                    </row>
                    <row>
                        <cell>American</cell>
                        <cell role="num">398</cell>
                    </row>
                    <row>
                        <cell>Other nations</cell>
                        <cell role="num">233</cell>
                    </row>
                    <row>
                        <cell>Total</cell>
                        <cell role="num">171,631</cell>
                    </row>
                </table>
                <p rendition="#center"><hi rendition="#italic">Export duties paid by different
                        nationalities.</hi></p>
                <table cols="2" rows="5">
                    <row>
                        <cell>German:</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell>Copra</cell>
                        <cell role="num">$3,221.82</cell>
                    </row>
                    <row>
                        <cell>Cotton</cell>
                        <cell role="num">164.13</cell>
                    </row>
                    <row>
                        <cell>Coffee</cell>
                        <cell role="num">42.56</cell>
                    </row>
                    <row>
                        <cell>Total</cell>
                        <cell role="num">3,428.51</cell>
                    </row>
                </table>
                <p rendition="#center"><hi rendition="#italic">Amounts paid by different
                        nationalities for licenses and taxes to the Samoan Government and
                        municipality.</hi></p>
                <table cols="3" rend="bordered" rows="7">
                    <row>
                        <cell/>
                        <cell>To Government.</cell>
                        <cell>To municipality.</cell>
                    </row>
                    <row>
                        <cell>German</cell>
                        <cell role="num">$2,686</cell>
                        <cell role="num">$2,095</cell>
                    </row>
                    <row>
                        <cell>British</cell>
                        <cell role="num">859</cell>
                        <cell role="num">1,560</cell>
                    </row>
                    <row>
                        <cell>American</cell>
                        <cell role="num">141</cell>
                        <cell role="num">543</cell>
                    </row>
                    <row>
                        <cell>Other nationalities</cell>
                        <cell role="num">385</cell>
                        <cell role="num">759</cell>
                    </row>
                    <row>
                        <cell>Samoan natives</cell>
                        <cell role="num">20,948</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell/>
                        <cell role="num">25,019</cell>
                        <cell role="num">4,957</cell>
                    </row>
                </table>


