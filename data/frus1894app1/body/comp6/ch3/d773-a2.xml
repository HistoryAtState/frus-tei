    <text>
        <body>
            <div xml:id="d773-a2">

                <pb facs="0735" n="729" sameAs="frus:frus1894app1/pg729"/>

                <opener><seg rendition="#center">[Inclosure A.—Translation.]</seg></opener>
                <head><hi rendition="#italic">Names of the women and girls whom the Samoan chiefs
                        here desire to have sent to them.</hi></head>
                <list>
                    <label>1.</label>
                    <item>Lealosi, wife of Chief Leiatana.</item>
                    <label>2.</label>
                    <item>Tuliloa, wife of Chief Fiame.</item>
                    <label>3.</label>
                    <item>Taafiu, wife of Chief Laulu.</item>
                    <label>4.</label>
                    <item>Palepa, wife of Chief Taumuiga.</item>
                    <label>5.</label>
                    <item>Taofi, wife of Chief Tupuola.</item>
                    <label>6.</label>
                    <item>Tui, wife of Chief Tagaloa.</item>
                    <label>7.</label>
                    <item>Siamoa, wife of Chief Mulipola.</item>
                    <label>8.</label>
                    <item>Taevale, wife of Chief Soa.</item>
                    <label>9.</label>
                    <item>Siaima, wife of Chief Telea.</item>
                    <label>10.</label>
                    <item>Selepa, wife of Chief Sauini.</item>
                </list>
                <p rendition="#center"><hi rendition="#italic">Names of the girls.</hi></p>
                <list>
                    <label>1.</label>
                    <item>Alaimaca.</item>
                    <label>2.</label>
                    <item>Talapasia.</item>
                    <label>3.</label>
                    <item>Avele.</item>
                    <label>4.</label>
                    <item>Sose.</item>
                    <label>5.</label>
                    <item>Siagiagi.</item>
                    <label>6.</label>
                    <item>Salacvalu.</item>
                    <label>7.</label>
                    <item>Tagii Malie.</item>
                    <label>8.</label>
                    <item>Paola.</item>
                    <label>9.</label>
                    <item>Tuupu.</item>
                    <label>10.</label>
                    <item>Sausua.</item>
                </list>
                <p rendition="#center"><hi rendition="#italic">Names of Mataafa’s sons.</hi></p>
                <list>
                    <label>1.</label>
                    <item>Tagoti.</item>
                    <label>2.</label>
                    <item>Taigafi.</item>
                    <label>3.</label>
                    <item>Muliaiga</item>
                </list>
                <p rendition="#center">* * * * * * *</p>
            </div>
