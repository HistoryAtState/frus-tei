                <pb facs="0633" n="627" sameAs="frus:frus1894app1/pg627"/>

                <head><hi rendition="#italic">Mr. Blaine to Mr. von Mumm.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1890-11-21"><hi rendition="#italic">November 21,
                        1890</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. yon Mumm</hi>: I have the honor to
                    acknowledge the receipt of your personal note of the 18th instant, informing me
                    that Mr. Carl Eggert, the German member of the Samoan land commission, would
                    leave for Apia early in December.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">James G. Blaine.</hi></signed></closer>
            </div>
        </body>
    </text>
