    <text>
        <body>
            <div xml:id="d649">

                <pb facs="0643" n="637" xml:id="pg637"/>

                <head><hi rendition="#italic">Mr. Wharton to Mr. von Holleben.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1892-05-21"><hi rendition="#italic">May 21,
                        1892</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. von Holleben</hi>: Adverting to our
                    recent conferences, I have now the pleasure to inclose, for such use as you may
                    decide to make of it, a memorandum as to the understanding of the Government of
                    the United States touching the differences between the chief justice of Samoa
                    and the land commission as to the interpretation of section 6 of Article <hi
                        rendition="#small-caps">iv</hi> of the general act of Berlin concluded June
                    14, 1889.</p>
                <p>Very truly, yours,</p>
                <closer><signed><hi rendition="#small-caps">William F.
                    Wharton.</hi></signed></closer>


                <xi:include href="d649-a1.xml" xpointer="d649-a1"/>
