    <text>
        <body>
            <div xml:id="d696">

                <pb facs="0677" n="671" sameAs="frus:frus1894app1/pg671"/>

                <head><hi rendition="#italic">Mr. Gresham to Mr.
                            von Hollehen</hi></head>
                <opener><seg rendition="#center">[Personal.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1893-05-03"><hi rendition="#italic">May 3,
                        1893</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Sir</hi>: Referring to Baron Ketteler’s
                    conversation with Mr. Adee of to-day, I beg to inclose a memorandum in relation
                    to the resignation of Baron Senfft von Pilsach as president of the municipal
                    council in Samoa.</p>
                <p>Very truly, yours,</p>
                <closer><signed><hi rendition="#small-caps">W. Q. Gresham.</hi></signed></closer>


                <xi:include href="d696-a1.xml" xpointer="d696-a1"/>
