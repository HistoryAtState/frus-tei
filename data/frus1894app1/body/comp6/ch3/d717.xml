    <text>
        <body>
            <div xml:id="d717">

                <pb facs="0689" n="683" sameAs="frus:frus1894app1/pg683"/>

                <head><hi rendition="#italic">Baron Ketteler to Mr. Gresham</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >New York</hi></placeName>, <date calendar="gregorian"
                            when="1893-08-24"><hi rendition="#italic">August 24,
                        1893</hi></date>.</dateline></opener>
                <p>Received instructions to represent to Department desirability of early presence
                    of American member of land commission in Samoa in order to avoid further
                    prolongation of term.</p>
                <closer><signed><hi rendition="#small-caps">Ketteler.</hi></signed></closer>
            </div>
        </body>
    </text>
