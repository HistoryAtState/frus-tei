    <text>
        <body>
            <div xml:id="d761">

                <pb facs="0720" n="714" sameAs="frus:frus1894app1/pg714"/>

                <head><hi rendition="#italic">Mr. Gresham to Baron Saurma.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1894-06-01"><hi rendition="#italic">June 1,
                        1894</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I have the honor to hand you
                    herewith a memorandum in response to the one you delivered to me on the 28th
                    ultimo relative to the conclusion of the labors of the Samoan land
                    commission.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. Q. Gresham.</hi></signed></closer>


                <xi:include href="d761-a1.xml" xpointer="d761-a1"/>
