    <text>
        <body>
            <div xml:id="d785">

                <pb facs="0750" n="744" sameAs="frus:frus1894app1/pg744"/>

                <head><hi rendition="#italic">Mr. White to Mr. Gresham.</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 997.]</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1893-05-19"><hi rendition="#italic">May 19,
                        1893</hi></date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my dispatch, No. 994, of the
                    17th instant, I have the honor to inclose herewith, for your information, an
                    article which appeared in the Times newspaper of yesterday relative to the
                    affairs of Samoa.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Henry White.</hi></signed></closer>


                <xi:include href="d785-a1.xml" xpointer="d785-a1"/>
