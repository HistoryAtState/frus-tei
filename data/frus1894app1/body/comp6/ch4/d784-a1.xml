                <pb facs="0750" n="744" sameAs="frus:frus1894app1/pg744"/>

                <opener><seg rendition="#center">[Inclosure No. 1.]</seg></opener>
                <head><hi rendition="#italic">Mr. Gresham to Mr.
                            White.</hi></head>
                <dateline>[<date ana="#date_undated-inferred-from-document-content"
                        calendar="gregorian" when="1893-05-17">May 17, 1893</date>]</dateline>
                <p rendition="#center">[Copy of telegram received at the legation May 17, 1893.]</p>
                <p>German Government having likewise agreed, this Government accepts extension of
                    Samoan land commission until March 31, 1894. New American commissioner, vice
                    Ormsbee, resigned, will he at once named. Notify foreign office.</p>
                <closer><signed><hi rendition="#small-caps">Gresham.</hi></signed></closer>
            </div>
        </body>
    </text>
