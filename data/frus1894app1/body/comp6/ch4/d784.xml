    <text>
        <body>
            <div xml:id="d784">

                <pb facs="0749" n="743" sameAs="frus:frus1894app1/pg743"/>

                <head><hi rendition="#italic">Mr. White to Mr. Gresham.</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 994.]</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1893-05-17"><hi rendition="#italic">May 17,
                        1893</hi></date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith the
                    copy of a cablegram which I received from yon at an early hour this morning,
                    instructing <pb facs="0750" n="744" xml:id="pg744"/> me to inform the foreign
                    office of our acceptance of the extension of the Samoa land commission until
                    March 31, 1894.</p>
                <p>I also inclose the copy of a note which I thereupon addressed to the Earl of
                    Rosebery.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Henry White.</hi></signed></closer>



                <xi:include href="d784-a1.xml" xpointer="d784-a1"/>
