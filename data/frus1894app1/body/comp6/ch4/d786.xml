    <text>
        <body>
            <div xml:id="d786">

                <pb facs="0752" n="746" sameAs="frus:frus1894app1/pg746"/>

                <head><hi rendition="#italic">Mr. White to Mr.
                            Gresham.</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 1001.]</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >London</hi></placeName>
                        <date calendar="gregorian" when="1893-05-24"><hi rendition="#italic">May 24,
                                1893</hi></date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my dispatch, No. 994, of May
                    17, I have the honor to inclose herewith a copy of the note which I have
                    received from the Earl of Rosebery in reply to mine of the aforesaid date,
                    relative to the extension of the Samoan land commission.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Henry White.</hi></signed></closer>


                <xi:include href="d786-a1.xml" xpointer="d786-a1"/>
