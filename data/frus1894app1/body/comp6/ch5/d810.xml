    <text>
        <body>
            <div xml:id="d810">

                <pb facs="0760" n="754" xml:id="pg754"/>

                <head><hi rendition="#italic">Mr. Uhl to Mr.
                            Runyon.</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 53.]</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1894-02-02"><hi rendition="#italic">February 2,
                        1894</hi></date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose for your information a copy of a
                    note of the 29th ultimo, addressed by this Department to the ambassador of
                    Germany at this capital in reply to an unofficial communication from him
                    relative to a reported insurrection in Samoa.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Edwin F. Uhl</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>


                <xi:include href="d810-a1.xml" xpointer="d810-a1"/>
