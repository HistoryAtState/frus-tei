                <pb facs="0759" n="753" sameAs="frus:frus1894app1/pg753"/>

                <head><hi rendition="#italic">Mr. Gresham to Mr. Runyon.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1894-01-20"><hi rendition="#italic">January 20,
                        1894</hi></date>.</dateline></opener>
                <p>Your 25 received. Having ascertained concurrence of Great Britain, this
                    Government agrees to continue land commission in Samoa until end of this year if
                    necessary to complete its work.</p>
                <closer><signed><hi rendition="#small-caps">Gresham.</hi></signed></closer>
            </div>
        </body>
    </text>
