                <pb facs="0753" n="747" sameAs="frus:frus1894app1/pg747"/>

                <head><hi rendition="#italic">Mr. Blaine to Mr. Phelps.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1891-12-29"><hi rendition="#italic">December 29,
                        1891</hi></date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Phelps</hi>, <hi
                        rendition="#italic">Minister, Berlin:</hi></p>
                <p>Ascertain by thorough investigation and advise as to character and fitness of
                    Baron Senfft von Pilsach for president municipal council, Apia.</p>
                <closer><signed><hi rendition="#small-caps">Blaine.</hi></signed></closer>
            </div>
        </body>
    </text>
