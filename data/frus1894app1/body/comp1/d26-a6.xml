    <text>
        <body>
            <div xml:id="d26-a6">

                <pb facs="0041" n="35" sameAs="frus:frus1894app1/pg35"/>

                <opener><seg rendition="#center">[Inclosure 6 in No. 27.]</seg></opener>
                <head><hi rendition="#italic">Mr. Gardner to Mr.
                            Otori.</hi></head>
                <opener><dateline rendition="#float-right"><date calendar="gregorian"
                            when="1894-07-17"><hi rendition="#small-caps">July</hi> 17,
                        1894</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge receipt of your
                    letter of yesterday’s date.</p>
                <p>I would suggest that you should apply through usual, channels for any information
                    you may desire as to the communications made by me to my Government.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">C. T. Gardner</hi>,<lb/><hi
                            rendition="#italic">Her Majesty’s Acting
                    Consul-General.</hi></signed></closer>
            </div>
        </body>
    </text>
