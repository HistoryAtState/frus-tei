                <pb facs="0086" n="80" sameAs="frus:frus1894app1/pg80"/>

                <head><hi rendition="#italic">Mr. Gresham to Mr. Yang Yü.</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 78.]</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1894-11-20"><hi rendition="#italic">November 20,
                        1894</hi></date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inform you that our
                    minister at Tokyo is advised that any direct overtures for peace made by China
                    to Japan through the American minister at Peking will be considered.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. Q. Gresham.</hi></signed></closer>
            </div>
        </body>
    </text>
