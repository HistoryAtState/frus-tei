        <body>
            <div xml:id="d95">

                <pb facs="0101" n="95" sameAs="frus:frus1894app1/pg95"/>

                <head><hi rendition="#italic">Mr. Denby to Mr. Gresham.</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 96.]</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Pelting</hi></placeName>, <date calendar="gregorian"
                            when="1895-01-17"><hi rendition="#italic">January 17, 1895</hi></date>.
                        (Received March 7.)</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose a translation
                    of a proclamation issued and circulated in Manchuria by the commander of the
                    Japanese forces.</p>
                <p>It will be seen that it is well calculated to produce an impression on the
                    Chinese populace.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charles Denby.</hi></signed></closer>


                <xi:include href="d95-a1.xml" xpointer="d95-a1"/>
