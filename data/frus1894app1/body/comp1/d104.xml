    <text>
        <body>
            <div xml:id="d104">

                <pb facs="0112" n="106" sameAs="frus:frus1894app1/pg106"/>

                <head><hi rendition="#italic">Mr. Denby to Mr.
                            Gresham.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener>
                    <seg rendition="#float-left">No. 105.]</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1895-03-02"><hi rendition="#italic">March 2,
                        1895</hi></date>.</dateline>
                </opener>
                <p>Japan agrees to receive Li. Changes are to be made in letters patent. Place of
                    meeting, Shimonoseki. Time not fixed. Plenipotentiary may use cipher.</p>
            </div>
        </body>
    </text>
