    <text>
        <body>
            <div xml:id="d416">

                <pb facs="0444" n="438" sameAs="frus:frus1894app1/pg438"/>

                <head><hi rendition="#italic">Mr. Taylor to Mr.
                            Gresham</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 137.]</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1894-03-05"><hi rendition="#italic">March 5, 1894</hi></date>.
                        (Received March 15.)</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to report that I have
                    received the formal memorandum (in reply to your No. 16, of the 14th of July,
                    touching the Mora claim) promised by the minister of state in his note of
                    January 1, a copy of which I transmitted in my No. 97, of January 4. Inclosed
                    please find a copy of the memorandum, with a carefully prepared translation, and
                    also a copy, with translation, of the note accompanying it.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Hannis Taylor.</hi></signed></closer>




                <xi:include href="d416-a1.xml" xpointer="d416-a1"/>
