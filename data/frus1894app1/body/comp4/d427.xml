    <text>
        <body>
            <div xml:id="d427">

                <pb facs="0455" n="449" sameAs="frus:frus1894app1/pg449"/>

                <head><hi rendition="#italic">Mr. Taylor to Mr.
                            Gresham</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 242.]</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1894-10-03"><hi rendition="#italic">October 3,
                        1894</hi></date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herein, with
                    translation, a copy of the minister of state’s reply to my note of the 29th
                    ultimo, touching his failure to answer your note of the 22d of June last in
                    reference to the Mora claim.</p>
                <p>I am etc.,</p>
                <closer><signed><hi rendition="#small-caps">Hannis Taylor.</hi></signed></closer>



                <xi:include href="d427-a1.xml" xpointer="d427-a1"/>
