    <text>
        <body>
            <div xml:id="d653">

                <pb facs="0776" n="770" sameAs="frus:frus1942v03/pg770"/>

                <note rend="inline" type="source">361.1121/41: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the Soviet Union</hi> (<hi
                        rendition="#italic">Standley</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Moscow</hi></placeName>, <date
                            calendar="gregorian" when="1943-06-10T09:00:00+03:00">June 10, 1943—9
                            a.m.</date>
                        <lb/> [Received 3; 40 p.m.]</dateline>
                </opener>
                <p>639. Department’s 263, April 28, 7 p.m.<anchor n="18" xml:id="d653-f1"/> and 269,
                    April 30,<anchor n="19" xml:id="d653-f2"/> re Isaiah Oggins. Embassy has been
                    refused permission to see Oggins again and is informed that the competent Soviet
                    authorities find it impossible to reconsider his case. Funds released for,
                    refund depositor.<anchor n="20" xml:id="d653-f3"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Standley</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d653-f1" n="18" xml:id="d653-f1-content">
                <p>Not printed. Mrs. Nerma Oggins of New York City bad deposited the sum of $400
                    towards the expense of the return of her husband. The Department of State had
                    authorized on April 20, 1943, the issuance of a passport valid only for return
                    to the United States. (361.1121/40a)</p>
            </note>
            <note corresp="#d653-f2" n="19" xml:id="d653-f2-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d653-f3" n="20" xml:id="d653-f3-content">
                <p>The deposited money was returned to Mrs. Oggins on June 22, 1943.</p>
            </note>
        </listAnnotation>
    </standOff>
