    <text>
        <body>
            <div xml:id="d357">

                <pb facs="0418" n="412" xml:id="pg412"/>

                <note rend="inline" type="source">740.0011 European War 1939/18844: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Chargé in Switzerland</hi>
                        (<hi rendition="#italic">Huddle</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1942-01-28T23:00:00-05:00">January 28,
                            1942—11 p.m.</date>
                    </dateline>
                </opener>
                <p>252. For Tittmann.<anchor n="24" xml:id="d357-f1"/> Your 11, January 20.<anchor
                        n="25" xml:id="d357-f2"/> In answer to inquiries you may state in confidence
                    that the policy of your Government with regard to the Baltic States has
                    undergone ho change.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d357-f1" n="24" xml:id="d357-f1-content">
                <p>Harold H. Tittmann, Jr., Assistant to the personal representative of President
                    Roosevelt (Myron C. Taylor) to Pope Pius XII, Vatican City.</p>
            </note>
            <note corresp="#d357-f2" n="25" xml:id="d357-f2-content">
                <p>Not printed. This telegram, relayed from Bern as No. 237 of January 23, 1942,
                    announced that inquiries were being pressed regarding rumors, probably of German
                    origin, that while the British Secretary of State for Foreign Affairs, Anthony
                    Eden, had been in Moscow in December 1941, a bargain had been struck whereby the
                    Soviet Union in principle “received a free hand in the Baltic States.”</p>
            </note>
        </listAnnotation>
    </standOff>
