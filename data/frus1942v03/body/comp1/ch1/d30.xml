    <text>
        <body>
            <div xml:id="d30">

                <pb facs="0028" n="22" sameAs="frus:frus1942v03/pg22"/>

                <note rend="inline" type="source">859A.00/128</note>
                <head>
                    <hi rendition="#italic">The Minister in Iceland</hi> (<hi rendition="#italic"
                        >Morris</hi>) <hi rendition="#italic">to the Icelandic Minister for Foreign
                        Affairs</hi> (<hi rendition="#italic">Thors</hi>)<anchor n="27"
                        xml:id="d30-f1"/>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 5</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Reykjavik</hi></placeName>, <date
                            calendar="gregorian" when="1942-10-14">October 14,
                        1942</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: With reference to the oral message
                    conveyed to Your Excellency on September 27, 1942, by the American Chargé
                    d’Affaires ad interim, I have the honor to confirm herewith that there would be
                    no objection whatsoever on the part of the Government of the United States of
                    America to the proposal which Your Excellency now has under consideration,
                    namely, that a resolution be approved by the new Parliament when it convenes
                    declaring that in 1944 Iceland will become a republic.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Leland Morris</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d30-f1" n="27" type="source" xml:id="d30-f1-content">
                <p>Copy transmitted to the Department by the Minister in Iceland in his despatch No.
                    8, October 21; received October 31.</p>
            </note>
