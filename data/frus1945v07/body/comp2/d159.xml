    <text>
        <body>
            <div xml:id="d159">

                <pb facs="0229" n="219" sameAs="frus:frus1945v07/pg219"/>

                <note rend="inline" type="source">893.00/2–1645: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Ambassador in China</hi> (<hi rendition="#italic"
                            >Hurley</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-02-16T21:00:00-04:00">February 16,
                            1945—9 p.m.</date>
                    </dateline>
                </opener>
                <p>267. In connection with press reports in today’s and yesterday’s newspapers here
                    of interviews given by Wang Shih-chieh, Chou En-lai and General Wedemeyer, we
                    would appreciate receiving by radio full text of statements made to the press in
                    Chungking by these officials.<anchor n="85" xml:id="d159-f1"/>
                    <pb facs="0230" n="220" xml:id="pg220"/> We would also appreciate receiving in a
                    separate telegram such interpretive comment as you are in a position to make
                    with regard to the statements.<anchor n="86" xml:id="d159-f2"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Grew</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
