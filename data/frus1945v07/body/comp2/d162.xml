    <text>
        <body>
            <div xml:id="d162">

                <pb facs="0240" n="230" sameAs="frus:frus1945v07/pg230"/>

                <note rend="inline" type="source">893.00/2–1845: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in China</hi> (<hi
                            rendition="#italic">Hurley</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Chungking</hi></placeName>, <date
                            calendar="gregorian" when="1945-02-18T23:00:00+07:00">February 18,
                            1945—11 p.m. [<hi rendition="#italic">a.m.</hi>]</date>
                        <lb/> [Received February 18—10:25 a.m.]</dateline>
                </opener>
                <p>243. [Text of National Government’s draft of January 24.<anchor n="1"
                        xml:id="d162-f1"/>] Besides the three points contained in the previous
                    Government proposal,<anchor n="2" xml:id="d162-f2"/> the National Government is
                    prepared to take the three following measures:</p>
                <p>[Here follows text of Statement by Chinese Government Representatives printed on
                        <ref target="#pg185">page 185</ref>.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hurley</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d162-f1" n="1" xml:id="d162-f1-content">
                <p>For presentation of this draft by Wang Shih-chieh to the Ambassador in China, see
                    the Ambassador’s telegram No. 242, <hi rendition="#italic">supra</hi>.</p>
            </note>
            <note corresp="#d162-f2" n="2" xml:id="d162-f2-content">
                <p>Telegram No. 143, January 31, 8 p.m., from the Ambassador in China, not
                    printed.</p>
            </note>
        </listAnnotation>
    </standOff>
