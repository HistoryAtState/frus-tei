    <text>
        <body>
            <div xml:id="d278">

                <pb facs="0420" n="410" sameAs="frus:frus1945v07/pg410"/>

                <note rend="inline" type="source">893.00/6–1145: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        China</hi> (<hi rendition="#italic">Hurley</hi>)<anchor n="67"
                        xml:id="d278-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-06-11T16:00:00-04:00">June 11, 1945—4
                            p.m.</date>
                    </dateline>
                </opener>
                <p>893. We have read with interest your telegram (ReEmbs June 9) and find helpful
                    the information reported by you and by members of your staff in making our
                    estimate of developments in China.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Grew</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d278-f1" n="67" type="source" xml:id="d278-f1-content">
                <p>Copy transmitted to President Truman on June 11.</p>
            </note>
        </listAnnotation>
