            <div xml:id="d994">

                <pb facs="1341" n="1331" sameAs="frus:frus1945v07/pg1331"/>

                <note rend="inline" type="source">893.4061 Motion Pictures/7–3145: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in China</hi>
                        (<hi rendition="#italic">Hurley</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-08-09T18:00:00-04:00">August 9, 1945—6
                            p.m.</date>
                    </dateline>
                </opener>
                <p>1230. Hays Office now requests Emb inform U. S. film representatives Chungking
                    (Urtel 1256, July 31) results negotiations concerning remittances.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Byrnes</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
