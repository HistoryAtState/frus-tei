    <text>
        <body>
            <div xml:id="d990">

                <pb facs="1339" n="1329" sameAs="frus:frus1945v07/pg1329"/>

                <note rend="inline" type="source">893.4061 Motion Pictures/7–545: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in China</hi> (<hi
                            rendition="#italic">Hurley</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Chungking</hi></placeName>, <date
                            calendar="gregorian" when="1945-07-05T10:00:00+07:00">July 5, 1945—10
                            a.m.</date>
                        <lb/> [Received 12:40 p.m.]</dateline>
                </opener>
                <p>1102. Negotiations are being conducted by Robertson<anchor n="7" xml:id="d990-f1"
                    /> with Minister of Finance (ReDeptel 500 [<hi rendition="#italic">900</hi>],
                    June 12, 5 p.m. and 1012, June 21 [<hi rendition="#italic">29</hi>], 1
                        p.m.<anchor n="8" xml:id="d990-f2"/>). We are hopeful of satisfactory
                    settlement in the near future.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hurley</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d990-f1" n="7" xml:id="d990-f1-content">
                <p>Walter S. Robertson, Economic Counselor of Embassy.</p>
            </note>
            <note corresp="#d990-f2" n="8" xml:id="d990-f2-content">
                <p>Latter not printed.</p>
            </note>
