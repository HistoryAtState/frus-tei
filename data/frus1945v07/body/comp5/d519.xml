            <div xml:id="d519">

                <pb facs="0711" n="701" sameAs="frus:frus1945v07/pg701"/>

                <note rend="inline" type="source">800.20293/12–1945: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Chargé in China</hi> (<hi rendition="#italic"
                            >Robertson</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-12-19T12:00:00-05:00">December 19,
                            1945—noon</date>.</dateline>
                </opener>
                <p>2014. Dept is withholding action on proposed Sino-American intelligence
                    organization pending receipt of Embassy’s comments. (Deptel 1899, Nov. 26, 8
                        p.m.<anchor n="3" xml:id="d519-f1"/>) An early reply would be
                    appreciated.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
