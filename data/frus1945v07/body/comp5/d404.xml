    <text>
        <body>
            <div xml:id="d404">

                <pb facs="0555" n="545" sameAs="frus:frus1945v07/pg545"/>

                <note rend="inline" type="source">740.00119 P. W./9–145: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in China</hi> (<hi rendition="#italic"
                        >Hurley</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Chungking</hi></placeName>, <date
                            calendar="gregorian" when="1945-09-01T08:00:00+07:00">September 1,
                            1945—8 a.m.</date>
                        <lb/> [Received September 1—2:30 a.m.]</dateline>
                </opener>
                <p>1492. The following message is from Generalissimo Chiang Kai-shek for President
                    Truman.</p>
                <quote rend="blockquote">
                    <p>“The United States Fleet and United States Forces are welcome at any port in
                        China. The British Fleet and British Forces and other imperialist forces are
                        not welcome in China. I respectfully request that if and when the American
                        Fleet enters any China port it will not be accompanied by any British ships
                        or contingent.”</p>
                </quote>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hurley</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
