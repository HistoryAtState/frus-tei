    <text>
        <body>
            <div xml:id="d516">

                <pb facs="0708" n="698" xml:id="pg698"/>

                <note rend="inline" type="source">893.00/11–2345: Telegram</note>
                <head>
                    <hi rendition="#italic">President Truman to President Chiang Kai-shek </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1945-12-13">December 13, 1945</date>.</dateline>
                </opener>
                <p>[White House No. 382.] Referring to your message of November 23<anchor n="97"
                        xml:id="d516-f1"/> in regard to your need for additional personnel shipping,
                    the matter therein presented has been carefully studied by my staff.</p>
                <p>General Marshall who will arrive in Chungking in about a week is fully informed
                    on the subject.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Harry</hi> S. <hi rendition="#small-caps"
                            >Truman</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d516-f1" n="97" xml:id="d516-f1-content">
                <p>See telegram No. 2022, November 23, 8 a.m., from the Chargé in China, <ref
                        target="#pg660">p. 660</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
