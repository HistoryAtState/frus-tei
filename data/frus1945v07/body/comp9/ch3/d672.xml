    <text>
        <body>
            <div xml:id="d672">

                <pb facs="0964" n="954" sameAs="frus:frus1945v07/pg954"/>

                <note rend="inline" type="source">761.93/8–445: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the Soviet Union</hi> (<hi
                        rendition="#italic">Harriman</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Berlin</hi></placeName>,] <date calendar="gregorian"
                            when="1945-08-04">4 August 1945</date>.</dateline>
                </opener>
                <p>040931. Am advised Soong and new Foreign Minister<anchor n="9" xml:id="d672-f1"/>
                    arriving Moscow Monday August 6. I will be back in Moscow by then. I request
                    that I be instructed along the lines of my memorandum to you of July 31.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Harriman</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d672-f1" n="9" xml:id="d672-f1-content">
                <p>Wang Shih-chieh.</p>
            </note>
        </listAnnotation>
    </standOff>
