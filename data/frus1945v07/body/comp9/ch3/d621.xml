    <text>
        <body>
            <div xml:id="d621">

                <pb facs="0903" n="893" xml:id="pg893"/>

                <note rend="inline" type="source">740.0011 P.W./6–445: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the Soviet Union</hi> (<hi
                        rendition="#italic">Harriman</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Moscow</hi></placeName>, <date
                            calendar="gregorian" when="1945-06-04T13:00:00+03:00">June 4, 1945—1
                            p.m.</date>
                        <lb/> [Received 1:40 p.m.]</dateline>
                </opener>
                <p>1883. Personal for the Secretary. Hopkins<anchor n="49" xml:id="d621-f1"/> has
                    cabled the President<anchor n="50" xml:id="d621-f2"/> the results of our talks
                    regarding Soviet activity in the Far East (Reurtel 1200, June 2, 3 p.m.). As a
                    result we have no intention, unless instructed otherwise, to go further at this
                    time or to discuss any other subjects in the Dept’s memorandum referred to.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Harriman</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d621-f1" n="49" xml:id="d621-f1-content">
                <p>Harry L. Hopkins engaged in a series of conversations with Marshal Stalin on May
                    26–June 6; he had retired from Government service about May 12.</p>
            </note>
            <note corresp="#d621-f2" n="50" xml:id="d621-f2-content">
                <p>Not found in Department files; but see memorandum of conversation of June 14,
                        <ref target="#pg901">p. 901</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
