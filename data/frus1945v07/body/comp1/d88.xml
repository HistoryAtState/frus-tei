    <text>
        <body>
            <div xml:id="d88">

                <pb facs="0134" n="124" sameAs="frus:frus1945v07/pg124"/>

                <note rend="inline" type="source">740.0011 P.W./5–2545: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Ambassador in China</hi> (<hi rendition="#italic"
                            >Hurley</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-06-30T13:00:00-04:00">June 30, 1945—1
                            p.m.</date>
                    </dateline>
                </opener>
                <p>1016. Concerning proposed establishment safety zone Shanghai (Deptel 585 April
                    16) Dept informing Swiss and Swedish missions <pb facs="0135" n="125"
                        xml:id="pg125"/> here<anchor n="55" xml:id="d88-f1"/> that proposal has been
                    considered by U S military authorities and suggestion is one to which U S govt
                    cannot accede.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Grew</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d88-f1" n="55" xml:id="d88-f1-content">
                <p>By memoranda to the Swedish and Swiss Legations, dated June 30, not printed.</p>
            </note>
        </listAnnotation>
    </standOff>
