    <text>
        <body>
            <div xml:id="d87">

                <pb facs="0134" n="124" sameAs="frus:frus1945v07/pg124"/>

                <note rend="inline" type="source">893.001 Chiang Kai Shek/6–2845: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        China</hi> (<hi rendition="#italic">Hurley</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-06-28T19:00:00-04:00">June 28, 1945—7
                            p.m.</date>
                    </dateline>
                </opener>
                <p>1010. We would appreciate receiving as soon as practicable interpretative
                        comment<anchor n="53" xml:id="d87-f1"/> on Chiang’s press interview of June
                        28th.<anchor n="54" xml:id="d87-f2"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Grew</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
