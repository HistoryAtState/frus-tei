    <text>
        <body>
            <div xml:id="d113">

                <pb facs="0156" n="146" sameAs="frus:frus1945v07/pg146"/>

                <note rend="inline" type="source">740.0011 PW/8–345: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Ambassador in China</hi> (<hi rendition="#italic"
                            >Hurley</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-08-06T11:00:00-04:00">August 6, 1945—11
                            a.m.</date>
                    </dateline>
                </opener>
                <p>1204. The following telegram has been received from the Secretary in reply to
                    your No. 1279:<anchor n="80" xml:id="d113-f1"/>
                </p>
                <quote rend="blockquote">
                    <p>“By direction of the President, please inform Chiang Kai-shek that no
                        American officers will be assigned to high command in the China Theater who
                        are objectionable to him.</p>
                    <p>General Stilwell will not be assigned to the China Theater.”</p>
                </quote>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Grew</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
