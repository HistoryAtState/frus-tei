                <pb facs="1475" n="1465" sameAs="frus:frus1945v07/pg1465"/>

                <note rend="inline" type="source">125.8576/9–1945: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Ambassador in China</hi> (<hi rendition="#italic"
                            >Hurley</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-10-01T17:00:00-05:00">October 1, 1945—5
                            p.m.</date>
                    </dateline>
                </opener>
                <p>1585. Navy Dept authorizes radio station suggested your 1625 Sept 19. Please
                    request permission from Chinese govt to install and operate a station in Embassy
                    at Nanking. In your discretion include request for permission install stations
                    in consulates where commerical facilities inadequate.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
