    <text>
        <body>
            <div xml:id="d370">

                <pb facs="0521" n="511" sameAs="frus:frus1945v07/pg511"/>

                <note rend="inline" type="source">Nanking Embassy Files, Lot F–73: Telegram</note>
                <head>
                    <hi rendition="#italic">President Truman to
                        President Chiang Kai-shek
                    </hi><anchor n="33" xml:id="d370-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1945-08-23">August 23, 1945</date>.</dateline>
                </opener>
                <p>[White House No. 338.] Please accept this expression of my appreciation of your
                    considerate action in regard to the surrender of the Japanese in Hong Kong to a
                    British commander by which action you eased a difficult situation.</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d370-f1" n="33" type="source" xml:id="d370-f1-content">
                <p>Transmitted to the Ambassador in China for delivery to Generalissimo Chiang
                    Kai-shek.</p>
            </note>
        </listAnnotation>
    </standOff>
