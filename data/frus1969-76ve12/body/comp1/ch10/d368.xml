            <div xml:id="d368">

                <pb facs="d368-1" n="1" xml:id="d368-1"/>

                <head>368. Memorandum From President Nixon to Secretary of State Rogers, Washington,
                    April 19, 1973.<anchor n="1" xml:id="d368-f1"/>
                    <anchor n="2" xml:id="d368-f2"/>
                </head>
                <opener>
                    <dateline>
                        <placeName>Washington</placeName>, <date
                            ana="#date_undated-inferred-from-document-head" calendar="gregorian"
                            when="1973-04-19">April 19, 1973</date>
                    </dateline>
                </opener>
                <p>THE WHITE HOUSE<lb/>WASHINGTON</p>
                <p>April 19, 1973</p>
                <p>MEMORANDUM FOR<lb/>THE SECRETARY OF STATE</p>
                <p>I have decided to appoint Ambassador Henry A. Byroade as United States Ambassador
                    to Thailand, to replace Ambassador Leonard Unger, and Dr. William A. Kintner as
                    Ambassador to Cambodia, to replace Ambassador Emory C. Swank. I am aware of the
                    objection to these changes from the Foreign Service, but I feel very strongly
                    the need to have men in these very important and sensitive posts in whom I have
                    personal confidence.</p>
                <p>[signed Richard Nixon]</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d368-f1" n="1" type="source" xml:id="d368-f1-content">
                <p>Source: National Archives, Nixon Presidential Materials, NSC Files, Box 286,
                    Agency Files, State, Vol. 18. Confidential. </p>
            </note>
            <note corresp="#d368-f2" n="2" xml:id="d368-f2-content">
                <p>Nixon announced the appointment of Ambassadors to Thailand and Cambodia.</p>
            </note>
        </listAnnotation>
    </standOff>
