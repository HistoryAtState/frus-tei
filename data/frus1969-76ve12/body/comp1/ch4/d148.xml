    <standOff>
        <listAnnotation>
            <note corresp="#d148-f1" n="1" type="source" xml:id="d148-f1-content">
                <p>Source: National Archives, RG 59, Transcripts of Secretary of State Kissinger’s
                    Staff Meetings, 1973–1977, E5177, Box 9. Secret. The minutes are incorrectly
                    dated January 12, 1975.</p>
            </note>
            <note corresp="#d148-f2" n="2" xml:id="d148-f2-content">
                <p> Kissinger and his aides discussed the situation in East Timor.</p>
            </note>
