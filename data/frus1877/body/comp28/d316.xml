    <text>
        <body>
            <div xml:id="d316">

                <pb facs="0596" n="548" sameAs="frus:frus1877/pg548"/>

                <head>No. 316.<lb/><hi rendition="#italic">Mr. Fish
                        to Mr. Evarts.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation op the United States</hi>,<lb/><hi rendition="#italic"
                                >Berne</hi></placeName>, <date calendar="gregorian"
                            when="1877-08-07"><hi rendition="#italic">August</hi> 7, 1877</date>.
                        (Received August 20.)</dateline>
                    <seg rendition="#float-left">No. 8.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor, in compliance with your
                    instruction No. 2, to inclose herewith a copy of a note I have this day
                    addressed to Mr. Heer, the minister for foreign affairs, transmitting the four
                    copies of the circular “Separate” of June 28 last, authorizing a continuance of
                    the protection of Swiss citizens by the diplomatic and consular officers of the
                    United States.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>NICHOLAS FISH.</signed></closer>


                <xi:include href="d316-a1.xml" xpointer="d316-a1"/>
            </div>
        </body>
    </text>
