    <text>
        <body>
            <div xml:id="d265">

                <pb facs="0512" n="464" sameAs="frus:frus1877/pg464"/>

                <head>No. 265.<lb/><hi rendition="#italic">Mr. Boker to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation, of the United States</hi>,<lb/><hi rendition="#italic"
                                >St. Petersburg</hi></placeName>, <date calendar="gregorian"
                            when="1876-12-08"><hi rendition="#italic">December</hi> 8, 1876</date>.
                        (Received December 27.)</dateline>
                    <seg rendition="#float-left">No. 111.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith two
                    copies of an article from the Journal de t. Petersburg, with a translation of
                    the same, giving a synopsis of the principal provisions for levying troops in
                    Russia, under the law of compulsory military service.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>GEO. H. BOKER.</signed></closer>


                <xi:include href="d265-a1.xml" xpointer="d265-a1"/>
            </div>
