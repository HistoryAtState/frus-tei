    <text>
        <body>
            <div xml:id="d37">

                <pb facs="0092" n="44" sameAs="frus:frus1877/pg44"/>

                <head>No. 37.<lb/><hi rendition="#italic">Mr. Merrill to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Brussels</hi></placeName>, <date calendar="gregorian"
                            when="1876-10-03"><hi rendition="#italic">October</hi> 3, 1876</date>.
                        (Received October 17.)</dateline>
                    <seg rendition="#float-left">No. 57.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith an
                    extract from the Moniteur Beige, (with translation of the same,) in reference to
                    the geographical congress lately held in this city, the subject being the
                    exploration of Central Africa.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>A. P. MERRILL.</signed></closer>


                <xi:include href="d37-a1.xml" xpointer="d37-a1"/>
            </div>
