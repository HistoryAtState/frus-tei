    <text>
        <body>
            <div xml:id="d105">

                <pb facs="0218" n="170" sameAs="frus:frus1877/pg170"/>

                <head>No. 105.<lb/><hi rendition="#italic">Mr. Noyes to Mr. Evarts.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1877-09-21"><hi rendition="#italic">September</hi> 21,
                        1877</date>. (Received October 3.)</dateline>
                    <seg rendition="#float-left">No. 8.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith, for
                    the information of the State Department, a copy of the recent manifesto of
                    President Mac-Mahon, together with the comments of various French journals
                    thereon.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>EDWARD F. NOYES.</signed></closer>


                <xi:include href="d105-a1.xml" xpointer="d105-a1"/>
