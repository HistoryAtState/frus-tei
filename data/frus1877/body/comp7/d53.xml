    <text>
        <body>
            <div xml:id="d53">

                <pb facs="0116" n="68" sameAs="frus:frus1877/pg68"/>

                <head>No. 53.<lb/><hi rendition="#italic">Mr. Williamson to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Valparaiso</hi></placeName>, <date calendar="gregorian"
                            when="1876-10-01"><hi rendition="#italic">October</hi> 1, 1876</date>.
                        (Received Nov. 13.)</dateline>
                    <seg rendition="#float-left">No. 16.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose, for such
                    action as the Department may deem proper, a copy of a communication received by
                    me from Capt. John K. Nickerson, late master of the American steamship Georgia,
                    lost in the Straits of Magellan.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>D. J. WILLIAMSON.</signed></closer>



                <xi:include href="d53-a1.xml" xpointer="d53-a1"/>
            </div>
