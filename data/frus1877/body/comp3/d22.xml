    <text>
        <body>
            <div xml:id="d22">

                <pb facs="0070" n="22" sameAs="frus:frus1877/pg22"/>

                <head>No. 22.<lb/><hi rendition="#italic">Mr. Beale to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Vienna</hi></placeName>, <date calendar="gregorian"
                            when="1877-01-31"><hi rendition="#italic">January</hi> 31, 1877</date>.
                        (Received March 3.)</dateline>
                    <seg rendition="#float-left">No. 31.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my No. 27, I herewith forward
                    through the United States consulate at Hamburg two publications this morning
                    received from the foreign office, accompanying a note of which are herein
                    inclosed a copy together with translation.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>E. F. BEALE.</signed></closer>


                <xi:include href="d22-a1.xml" xpointer="d22-a1"/>
            </div>
