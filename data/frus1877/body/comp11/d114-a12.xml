                        <cell/>
                        <cell rendition="#top" role="num">7</cell>
                        <cell rendition="#border-right #top" role="num">6</cell>
                        <cell/>
                        <cell rendition="#border-right #top" role="num">26¼</cell>
                        <cell cols="2">When 6 cwt. and upward are exported 3 sgr. per gross cwt.are
                            refunded.</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right #top" role="num">1<hi rendition="#italic"
                                >b</hi></cell>
