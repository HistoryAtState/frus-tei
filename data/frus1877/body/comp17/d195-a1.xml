                <pb facs="0401" n="353" sameAs="frus:frus1877/pg353"/>

                <opener><seg rendition="#center">[Inclosure 1 in No.
                    518.—Translation.]</seg></opener>
                <head><hi rendition="#small-caps">from the emperor’s temporary quarters.</hi></head>
                <p>Proclamation is hereby made that the following notification has been sent to
                    Kagoshima Ken.</p>
                <closer><signed>SANJO SANEYOSHI,<lb/><hi rendition="#italic">Daijo
                        Daijin.</hi></signed>
                    <lb/>
                    <dateline rendition="#float-left"><date calendar="japanese-nengō"
                            when="1877-02-25">25th of 2d month of 10th year of
                        Meiji</date>.</dateline></closer>


