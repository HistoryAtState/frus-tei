            <div xml:id="d189-a1">

                <pb facs="0391" n="343" sameAs="frus:frus1877/pg343"/>

                <opener><seg rendition="#center">[Inclosure.]</seg></opener>
                <head>The financial statement and estimates.</head>
                <p rendition="#center">[From the Tokiô Times, January 27, 1877.]</p>
                <p rendition="#center"><hi rendition="#italic">Notification No</hi>. 12.</p>
                <p rendition="#center">To the In, Sho, Shi, Fu, Ken:</p>
                <p>It is hereby notified that the following tables of the revenues and expenditures
                    for the year between July of the 9th and June of the 10th year of Meiji,
                    inclusive, have been presented by Okuma Shigenobu, minister of the finance
                    department.</p>
                <closer><signed>SANJOSANEYOSHI,<lb/><hi rendition="#italic">Daijo
                        Daijin.</hi></signed>
                    <lb/>
                    <dateline rendition="#float-left"><date calendar="japanese-nengō"
                            when="1877-01-20">20th January, 10th year of
                    Meiji</date>.</dateline></closer>



                <xi:include href="d189-a1-a1.xml" xpointer="d189-a1-a1"/>
