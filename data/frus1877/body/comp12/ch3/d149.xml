                <pb facs="0327" n="279" sameAs="frus:frus1877/pg279"/>

                <head>No. 149.<lb/><hi rendition="#italic">Mr. Pierrepont to Mr. Fish.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1876-12-04"><hi rendition="#italic">December</hi> 4,
                        1876</date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Fish</hi>, <hi rendition="#italic"
                        >Secretary, Washington:</hi></p>
                <p>Brent arrested; heard; committed. Extradition-warrant will issue after fifteen
                    days. He says will not contest warrant. I shall appoint man to take him.</p>
                <p rendition="#center">* * * * * * *</p>
                <closer><signed>PIERREPONT.</signed></closer>
            </div>
        </body>
    </text>
