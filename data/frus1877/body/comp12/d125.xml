        <body>
            <div xml:id="d125">

                <pb facs="0310" n="262" sameAs="frus:frus1877/pg262"/>

                <head>No. 125.<lb/><hi rendition="#italic">Mr. Pierrepont to Mr. Evarts.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1877-07-16"><hi rendition="#italic">July</hi> 16, 1877</date>.
                        (Received July 30.)</dateline>
                    <seg rendition="#float-left">No. 192.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to your instruction No. 161, I
                    have the honor to inclose a copy of the correspondence between myself and Lord
                    Derby upon the subject to which it relates.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>EDWARDS PIERREPONT.</signed></closer>



                <xi:include href="d125-a1.xml" xpointer="d125-a1"/>
