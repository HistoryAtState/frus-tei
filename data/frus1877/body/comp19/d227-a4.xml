    <text>
        <body>
            <div xml:id="d227-a4">

                <pb facs="0463" n="415" xml:id="pg415"/>

                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Headquarters of the Army, Adjutant-General’s Office</hi>,<lb/><hi
                                rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1877-06-13"><hi rendition="#italic">June</hi>
                            13, 1877</date>.</dateline></opener>
                <p rendition="#flush">Lieutenant-General <hi rendition="#small-caps">P. H,
                        Sheridan</hi>,<lb/><hi rendition="#italic">Commanding Division Missouri,
                        Chicago, Ill.:</hi></p>
                <p>Your dispatch of 12th, concerning crossing of Mexican troops into Texas, read to
                    the President, and orders for our troops not to cross approved.</p>
                <closer><signed>E. D. TOWNSEND,<lb/><hi rendition="#italic"
                        >Adjutant-General.</hi></signed></closer>
            </div>
        </body>
    </text>
