    <text>
        <body>
            <div xml:id="d227-a7">

                <pb facs="0463" n="415" sameAs="frus:frus1877/pg415"/>

                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Headquarters of the Army</hi>,<lb/><hi rendition="#italic"
                                >Washington, D. C.</hi></placeName>, <date calendar="gregorian"
                            when="1877-06-15"><hi rendition="#italic">June</hi> 15,
                        1877</date>.</dateline></opener>
                <p rendition="#flush">Lieutenant-General <hi rendition="#small-caps"
                        >Sheridan</hi>,<lb/><hi rendition="#italic">Commanding Division Missouri,
                        Chicago, Ill.:</hi></p>
                <p>Your dispatch concerning interned Mexicans has been submitted to the President,
                    who directs that, if necessary to preserve peace on the borders, they be kept
                    under the present restraint and rationed until further orders.</p>
                <closer><signed>E. D. TOWNSEND,<lb/><hi rendition="#italic"
                        >Adjutant-General.</hi></signed></closer>
            </div>
        </body>
