    <text>
        <body>
            <div xml:id="d227-a9-a1">

                <pb facs="0464" n="416" xml:id="pg416"/>

                <head>[First indorsement.]</head>
                <opener><hi rendition="#small-caps">Headquarters Military Division
                            Missouri</hi>,<lb/><placeName><hi rendition="#italic"
                        >Chicago</hi></placeName>, <date calendar="gregorian" when="1877-06-13"><hi
                            rendition="#italic">June</hi> 13, 1877</date>.</opener>
                <p>Respectfully forwarded to the Adjutant-General of the Army.</p>
                <closer><signed>P. H. SHERIDAN,<lb/><hi rendition="#italic">Lieutenant-General,
                            Commanding.</hi></signed></closer>
            </div>
        </body>
    </text>
