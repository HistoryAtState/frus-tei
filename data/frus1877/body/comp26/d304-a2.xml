    <standOff>
        <listAnnotation>
            <note corresp="#d304-f1" n="*" xml:id="d304-f1-content">
                <p>No. 10.—New award, and not included in first payment; consequently interest is
                    calculatad on whole amount up to and including 27th September, 1877.</p>
            </note>
            <note corresp="#d304-f2" n="†" xml:id="d304-f2-content">
                <p>No. 66.—New award; interest has been calculated on whole amount up to and
                    including 27th September, 1877, but amount paid ($198.44½) 28th March, 1877, on
                    old award has been deducted.</p>
            </note>
        </listAnnotation>
    </standOff>
