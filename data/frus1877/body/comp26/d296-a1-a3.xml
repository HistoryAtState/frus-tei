    <text>
        <body>
            <div xml:id="d296-a1-a3">

                <pb facs="0560" n="512" sameAs="frus:frus1877/pg512"/>

                <head><hi rendition="#small-caps">impost of navigation.</hi></head>
                <p><hi rendition="#italic">Tariff:</hi> For each ton of measurement.</p>
                <table cols="2" rows="5">
                    <row>
                        <cell>Seagoing-vessels:</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell>Those of all classes and nationalities</cell>
                        <cell role="num">$0 08</cell>
                    </row>
                    <row>
                        <cell>Coasting craft:</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell>Those measuring up to 20 tons, inclusive</cell>
                        <cell role="num">02</cell>
                    </row>
                    <row>
                        <cell>Those measuring from 21 tons upward</cell>
                        <cell role="num">05</cell>
                    </row>
                </table>
                <p>Approved.</p>
                <closer><signed>MALCAMPO.</signed></closer>
                <postscript>
                    <p>A true copy.<lb/><hi rendition="#small-caps">martin de herrera.</hi></p>
                </postscript>
            </div>
        </body>
