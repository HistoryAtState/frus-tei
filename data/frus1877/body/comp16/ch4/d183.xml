    <text>
        <body>
            <div xml:id="d183">

                <pb facs="0382" n="334" sameAs="frus:frus1877/pg334"/>

                <head>No. 183.<lb/><hi rendition="#italic">Mr. Seward to Count Litta.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1877-09-20"><hi rendition="#italic">September</hi> 20,
                        1877</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Count</hi>: I have the honor to acknowledge the
                    receipt of your note of the 15th instant, giving notice of a desire on the part
                    of the Government of Italy to terminate the consular convention concluded with
                    the United States February 8, 1868, in accordance with the provisions of article
                    17 of the treaty. Be pleased to accept, &amp;c.</p>
                <closer><signed>F. W. SEWAED,<lb/><hi rendition="#italic">Acting
                        Secretary</hi></signed></closer>
            </div>
        </body>
    </text>
