    <text>
        <body>
            <div xml:id="d323-a3">

                <pb facs="0627" n="579" xml:id="pg579"/>

                <opener><seg rendition="#center">[Inclosure 3 in No. 148.]</seg></opener>
                <head><hi rendition="#italic">Mr. Smithers to Mr. Maynard.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Smyrna</hi></placeName>, <date calendar="gregorian"
                            when="1877-04-28"><hi rendition="#italic">April</hi> 28,
                        1877</date>.</dateline></opener>
                <p rendition="#flush">Mr. <hi rendition="#small-caps">Maynard</hi>,<lb/><hi
                        rendition="#italic">American Minister, Constantinople:</hi></p>
                <p>Russian vice consul at Mytilene asks protection of United States for Russian
                    subjects. No German agent there.</p>
                <closer><signed>SMITHERS.</signed></closer>
            </div>
        </body>
    </text>
