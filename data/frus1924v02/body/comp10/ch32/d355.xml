    <text>
        <body>
            <div xml:id="d355">

                <pb facs="0535" n="441" sameAs="frus:frus1924v02/pg441"/>

                <note rend="inline" type="source">812.00/27065</note>
                <head><hi rendition="#italic">The Mexican Chargé</hi> (<hi
                            rendition="#italic">Téllez</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><seg rendition="#center">[Translation]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1924-02-12"><hi rendition="#italic">February 12,
                        1924</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Mr. Secretary</hi>: I have the honor of informing
                    Your Excellency that the port of Vera Cruz having been occupied yesterday by the
                    Government forces was immediately reopened to international traffic.<anchor
                        n="19" xml:id="d355-f1"/></p>
                <p>I am [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Manuel C. Téllez</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d355-f1" n="19" xml:id="d355-f1-content">
                <p>By similar notes dated Mar. 19, Apr. 25, and May 31, the Mexican Embassy informed
                    the Department of the opening of the ports of Acapulco, Progreso, and
                    Frontera.</p>
            </note>
        </listAnnotation>
    </standOff>
