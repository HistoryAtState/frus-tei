    <text>
        <body>
            <div xml:id="d330">

                <pb facs="0524" n="430" xml:id="pg430"/>

                <note rend="inline" type="source">812.113/9423</note>
                <head><hi rendition="#italic">The Chargé in Mexico</hi> (<hi
                            rendition="#italic">Summerlin</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1924-01-11"><hi rendition="#italic">January 11,
                        1924</hi></date>.<lb/>[Received January 19.]</dateline>
                    <seg rendition="#float-left">No. 8208</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In confirmation of the Department’s
                    telegram No. 16 January 7, 6 p.m., in regard to the embargo on the shipment of
                    arms and munitions from the United States to Mexico, I have the honor to enclose
                    herewith a copy and translation of Foreign Office note No. 261 of January 9,
                    1924, in reply to my note of the 8th instant.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">George T.
                    Summerlin</hi></signed></closer>


                <xi:include href="d330-a1.xml" xpointer="d330-a1"/>
            </div>
