            <div xml:id="d338">

                <pb facs="0528" n="434" xml:id="pg434"/>

                <note rend="inline" type="source">812.00/26803: Telegram</note>
                <head><hi rendition="#italic">The Vice Consul at Salina Cruz</hi> (<hi
                        rendition="#italic">Wood</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Salina Cruz</hi></placeName>, <date calendar="gregorian"
                            when="1924-01-20T09:00:00-07:00"><hi rendition="#italic">January 20,
                                1924—9 a.m.</hi></date><lb/>[Received January 21—3:10
                        a.m.]</dateline></opener>
                <p>Your cable January 19, 6 p.m. Federal Government officials have mined the
                    port.</p>
                <closer><signed><hi rendition="#small-caps">Wood</hi></signed></closer>
            </div>
        </body>
