    <text>
        <body>
            <div xml:id="d336">

                <pb facs="0527" n="433" sameAs="frus:frus1924v02/pg433"/>

                <note rend="inline" type="source">812.00/26794: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Vice Consul at Salina
                        Cruz</hi> (<hi rendition="#italic">Wood</hi>)<anchor n="9" xml:id="d336-f1"
                    /></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1924-01-19T18:00:00-05:00"><hi rendition="#italic">January 19,
                                1924—6 p.m.</hi></date></dateline></opener>
                <p>Telegraph immediately whether rebels or Federal Government officials are placing
                    mines reported in your January 18, 4 p.m.<anchor n="10" xml:id="d336-f2"/></p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
