                <pb facs="0359" n="265" sameAs="frus:frus1924v02/pg265"/>

                <note rend="inline" type="source">868.01/197</note>
                <head><hi rendition="#italic">President Coolidge to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1924-01-25"><hi rendition="#italic">January 25,
                        1924</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: The recommendations you
                    make in your communication of January 25th, concerning the relations between
                    this country and Greece, are approved.</p>
                <p>Very truly yours,</p>
                <closer><signed><hi rendition="#small-caps">Calvin Coolidge</hi></signed></closer>
            </div>
        </body>
    </text>
