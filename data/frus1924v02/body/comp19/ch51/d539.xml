    <text>
        <body>
            <div xml:id="d539">

                <pb facs="0715" n="621" xml:id="pg621"/>

                <note rend="inline" type="source">871.6363/210</note>
                <head><hi rendition="#italic">The Minister in Rumania</hi> (<hi rendition="#italic"
                        >Jay</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Bucharest</hi></placeName>, <date calendar="gregorian"
                            when="1924-07-26"><hi rendition="#italic">July 26,
                        1924</hi></date>.<lb/>[Received August 14.]</dateline>
                    <seg rendition="#float-left">No. 635</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith by
                    open mail copy of Note No. 38331 from the Foreign Office, together with the
                    memorandum and enclosures handed me by the Minister for Foreign Affairs on
                    Monday, July 21st,<anchor n="27" xml:id="d539-f1"/> which has been the subject
                    of the Department’s telegram #31 of July 22, 1924.<anchor n="28"
                        xml:id="d539-f2"/></p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Peter A. Jay</hi></signed></closer>


                <xi:include href="d539-a1.xml" xpointer="d539-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d539-f1" n="27" xml:id="d539-f1-content">
                <p>The Foreign Office note and the enclosures to the memorandum are not printed.</p>
            </note>
