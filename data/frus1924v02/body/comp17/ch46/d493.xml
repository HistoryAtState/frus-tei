                <pb facs="0659" n="565" sameAs="frus:frus1924v02/pg565"/>

                <note rend="inline" type="source">891.512/–: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Minister in Persia</hi> (<hi rendition="#italic"
                            >Kornfeld</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1923-07-31T17:00:00-04:00"><hi rendition="#italic">July 31, 1923—5
                                p.m.</hi></date></dateline></opener>
                <p>17. Department is informed that you and other diplomatic representatives in
                    Teheran addressed a note to the Persian Government on the subject of taxation of
                    foreigners in Persia. If so telegraph date and substance of the communication
                    and mail full text immediately.</p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
