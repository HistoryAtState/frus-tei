    <text>
        <body>
            <div xml:id="d490">

                <pb facs="0655" n="561" xml:id="pg561"/>

                <note rend="inline" type="source">891.77 Ulen &amp; Company/16</note>
                <head><hi rendition="#italic">The Minister in Persia</hi> (<hi
                            rendition="#italic">Kornfeld</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Teheran</hi></placeName>, <date calendar="gregorian"
                            when="1924-04-29"><hi rendition="#italic">April 29,
                        1924</hi></date>.<lb/>[Received June 4.]</dateline>
                    <seg rendition="#float-left">No. 476</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to the Legation’s telegram No. 35
                    of this date,<anchor n="22" xml:id="d490-f1"/> I have the honor to enclose
                    herewith copy of the memorandum of agreement between the Persian Government and
                    Ulen &amp; Company for the submission and consideration of the proposal for the
                    investigation, planning, and construction of railroads or motor roads in
                    Persia.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Joseph S.
                    Kornfeld</hi></signed></closer>


                <xi:include href="d490-a1.xml" xpointer="d490-a1"/>
            </div>
        </body>
    </text>
