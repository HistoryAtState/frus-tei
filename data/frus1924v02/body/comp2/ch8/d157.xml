            <div xml:id="d157">

                <pb facs="0289" n="195" sameAs="frus:frus1924v02/pg195"/>

                <note rend="inline" type="source">800.01 M 31/201</note>
                <head><hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Kellogg</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1924-07-31"><hi rendition="#italic">July 31,
                        1924</hi></date>.<lb/>[Received August 11.]</dateline>
                    <seg rendition="#float-left">No. 623</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to enclose a copy, in
                    triplicate, of a note dated July 29, 1924, from the Foreign Office regarding the
                    proposed treaties affecting the former German territories in Central Africa (B
                    Mandates). …</p>
                <p>I have [etc.]</p>
                <closer>For the Ambassador:<lb/><signed><hi rendition="#small-caps">F. A.
                            Sterling</hi></signed><lb/><hi rendition="#italic">Counselor of
                        Embassy</hi></closer>


                <xi:include href="d157-a1.xml" xpointer="d157-a1"/>
            </div>
