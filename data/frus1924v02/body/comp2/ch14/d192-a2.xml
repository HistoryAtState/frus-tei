    <text>
        <body>
            <div xml:id="d192-a2">

                <pb facs="0343" n="249" xml:id="pg249"/>

                <opener><seg rendition="#center">[Enclosure 2]</seg></opener>
                <head><hi rendition="#italic">The British Secretary of State for Foreign
                        Affairs</hi> (<hi rendition="#italic"
                        >Chamberlain</hi>) <hi rendition="#italic">to the American
                        Ambassador</hi> (<hi rendition="#italic"
                        >Kellogg</hi>)</head>
                <opener><dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >London</hi></placeName>,] <date calendar="gregorian"
                            when="1924-12-12"><hi rendition="#italic">12th December,
                            1924</hi></date>.</dateline>
                    <seg rendition="#float-left">No. A6753/984/45</seg></opener>
                <p><hi rendition="#small-caps">Your Excellency</hi>, With reference to Your
                    Excellency’s note of November 17th, I have the honour to inform you that the
                    establishment of the Irish Free State is not regarded as affecting the position
                    in connection with the applicability to Ireland of the convention of the 2nd
                    March, 1899, relative to the disposal of real and personal property.</p>
                <p>I have [etc.]</p>
                <closer>(For the Secretary of State)<lb/><signed><hi rendition="#small-caps">G. R.
                            Warner</hi></signed></closer>
            </div>
        </body>
