                <pb facs="0266" n="172" sameAs="frus:frus1924v02/pg172"/>

                <note rend="inline" type="source">811.348 Z 4/133: Telegram</note>
                <head><hi rendition="#italic">The Minister in the Netherlands</hi> (<hi rendition="#italic">Tobin</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >The Hague</hi></placeName>, <date calendar="gregorian"
                            when="1923-11-19T11:00:00+00:19"><hi rendition="#italic">November 19,
                                1923—11 a.m.</hi></date><lb/>[Received November 19—11:02
                        a.m.]</dateline></opener>
                <p>62. Your September 18th. Foreign Office grants permission for <hi
                        rendition="#italic">ZR–3</hi> to fly over Dutch territory.</p>
                <closer><signed><hi rendition="#small-caps">Tobin</hi></signed></closer>
            </div>
        </body>
