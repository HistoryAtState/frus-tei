    <text>
        <body>
            <div xml:id="d118">

                <pb facs="0255" n="161" sameAs="frus:frus1924v02/pg161"/>

                <note rend="inline" type="source">362.115 St 21/351</note>
                <head><hi rendition="#italic">The Unofficial Representative on the Reparation
                        Commission</hi> (<hi rendition="#italic">Logan</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1924-07-03"><hi rendition="#italic">July 3,
                        1924</hi></date>.<lb/>[Received July 14.]</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I have the honor to
                    enclose herewith, in triplicate, copies of the official report of the
                    Arbitrators appointed in the matter of the Standard Oil tank steamers. The
                    report was circulated to the Reparation Commission yesterday.</p>
                <p>Faithfully yours,</p>
                <closer><signed><hi rendition="#small-caps">James A. Logan,
                    Jr.</hi></signed></closer>


                <xi:include href="d118-a1.xml" xpointer="d118-a1"/>
