                <pb facs="0220" n="126" sameAs="frus:frus1924v02/pg126"/>

                <note rend="inline" type="source">462.00 R 296/814: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic"
                        >Herrick</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1925-01-03T11:00:00+00:00"><hi rendition="#italic">January 3,
                                1925—11 a.m.</hi></date><lb/>[Received 2:43
                    p.m.]</dateline></opener>
                <p>7. Your 3, January 2, 6 p.m.<anchor n="21a" xml:id="d86-f1"/> Note accepting
                    invitation to finance conference was delivered on December 31st in form
                    telegraphed in Department’s 492, December 30, 7 p.m.</p>
                <closer><signed><hi rendition="#small-caps">Herrick</hi></signed></closer>
            </div>
        </body>
    </text>
