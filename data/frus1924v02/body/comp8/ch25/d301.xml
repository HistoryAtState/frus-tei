    <text>
        <body>
            <div xml:id="d301">

                <pb facs="0489" n="395" sameAs="frus:frus1924v02/pg395"/>

                <note rend="inline" type="source">711.945/1105a supp.: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Ambassador in Japan</hi>
                        (<hi rendition="#italic">Woods</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1924-05-26T12:00:00-04:00"><hi rendition="#italic">May 26,
                                1924—noon</hi></date>.</dateline></opener>
                <p>81. My telegram No. 80, May 23, 6 p.m.<anchor n="56" xml:id="d301-f1"/> The
                    President today signed the Immigration Bill, and is issuing a public statement
                    in regard to it which will be telegraphed to you as soon as possible.</p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
