    <text>
        <body>
            <div xml:id="d311">

                <pb facs="0502" n="408" sameAs="frus:frus1924v02/pg408"/>

                <note rend="inline" type="source">711.945/1189</note>
                <head><hi rendition="#italic">The Chargé in Japan</hi> (<hi rendition="#italic"
                        >Caffery</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Tokyo</hi></placeName>, <date calendar="gregorian"
                            when="1924-07-08"><hi rendition="#italic">July 8,
                        1924</hi></date>.<lb/>[Received July 25.]</dateline>
                    <seg rendition="#float-left">No. 571–E</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to the Embassy’s telegram No.
                    174, of July 2, 1924,<anchor n="68" xml:id="d311-f1"/> I have the honor to
                    transmit herewith the full text of the speech delivered by Baron Shidehara at
                    the opening of the Diet on July 1, 1924.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Jefferson Caffery</hi></signed></closer>


                <xi:include href="d311-a1.xml" xpointer="d311-a1"/>
            </div>
        </body>
    </text>
