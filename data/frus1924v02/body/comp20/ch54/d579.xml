                <pb facs="0769" n="675" sameAs="frus:frus1924v02/pg675"/>

                <note rend="inline" type="source">707.1161/4: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Minister in Austria</hi> (<hi rendition="#italic"
                            >Washburn</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1924-05-27T17:00:00-04:00"><hi rendition="#italic">May 27, 1924—5
                                p.m.</hi></date></dateline></opener>
                <p>24. Your No. 25, May 26, 7 p.m. You may personally and unofficially acknowledge
                    the note of the Soviet representative and informally receive him should he call
                    on you but you should not return his call or otherwise assume any official
                    relation.</p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
