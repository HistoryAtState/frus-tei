                <pb facs="0590" n="496" sameAs="frus:frus1924v02/pg496"/>

                <note rend="inline" type="source">817.00/3137a: Telegram</note>
                <head><hi rendition="#italic">The Chief of the Division of Latin American Affairs,
                        Department of State</hi> (<hi rendition="#italic"
                            >Munro</hi>) <hi rendition="#italic">to Dr. Harold W. Dodds</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1924-08-14"><hi rendition="#italic">August 14,
                        1924</hi></date>.</dateline></opener>
                <p>Give up plan for trip to Nicaragua. Letter follows.<anchor n="9" xml:id="d425-f1"
                    /></p>
                <closer><signed><hi rendition="#small-caps">Dana G. Munro</hi></signed></closer>
            </div>
        </body>
