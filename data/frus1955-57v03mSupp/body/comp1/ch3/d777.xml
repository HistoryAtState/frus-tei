    <text>
        <body>
            <div xml:id="d777">

                <pb facs="d776-1" n="1" sameAs="frus:frus1955-57v03mSupp/d776-1"/>

                <head>777. Telegram 712 from Geneva<anchor n="1" xml:id="d777-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Geneva</placeName>, <date
                            calendar="gregorian" when="1957-01-19">January 19, 1957, 6
                        p.m.</date></dateline>
                </opener>
                <pb facs="d777-1" n="1" type="facsimile" xml:id="d777-1"/>
                <p>712. From Johnson.</p>
                <p>Minutes 64th meeting being pouched leaving Geneva January 20.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Gowen</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
