    <text>
        <body>
            <div xml:id="d815">

                <pb facs="d814-3" n="3" sameAs="frus:frus1955-57v03mSupp/d814-3"/>

                <head>815. Telegram 37 from Geneva<anchor n="1" xml:id="d815-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Geneva</placeName>, <date
                            calendar="gregorian" when="1957-07-12">July 12, 1957, 10
                        a.m.</date></dateline>
                </opener>
                <pb facs="d815-1" n="1" type="facsimile" xml:id="d815-1"/>
                <p>37. Reference Hong Kong Niact to Department 62, repeated Information London 5,
                    Geneva 2.</p>
                <pb facs="1437" n="1390" type="typeset" xml:id="pg1390"/>
                <p>Johnson-Wang Talks.</p>
                <p>Johnson left Geneva by air for Prague this morning. Reference telegram repeated
                    Prague.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Gowen</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
