    <text>
        <body>
            <div xml:id="d795">

                <pb facs="d794-1" n="1" sameAs="frus:frus1955-57v03mSupp/d794-1"/>

                <head>795. Telegram 899 to Geneva<anchor n="1" xml:id="d795-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1957-03-13">March 13, 1957, 4:52
                        p.m.</date></dateline>
                </opener>
                <pb facs="d795-1" n="1" type="facsimile" xml:id="d795-1"/>
                <p>899. Your 874.</p>
                <p>Lee Li-chuen departed February 23 President Wilson ETA Hong Kong March 18.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Herter</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
