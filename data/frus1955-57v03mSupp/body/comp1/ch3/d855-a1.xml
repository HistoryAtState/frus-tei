    <text>
        <body>
            <div xml:id="d855-a1">

                <pb facs="d855-3" n="3" sameAs="frus:frus1955-57v03mSupp/d855-3"/>


                <head>Receipt from Martin<anchor n="2"
                        xml:id="d855-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Geneva</placeName>, <date
                            calendar="gregorian" when="1957-12-12">December 12,
                        1957</date></dateline>
                </opener>
                <pb facs="d855-4" n="4" type="facsimile" xml:id="d855-4"/>
                <p rendition="#center"><hi rendition="#italic">RECEIPT</hi></p>
                <p>Received from U. Alexis Johnson the sum
                    of Swiss Francs 750.- representing official special funds of the United States
                    Government for disbursement for approved official purposes.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Edwin W.
                            Martin</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
