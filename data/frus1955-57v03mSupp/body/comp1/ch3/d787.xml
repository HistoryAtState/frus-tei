                <head>787. Telegram 784 from Geneva<anchor n="1" xml:id="d787-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Geneva</placeName>, <date
                            calendar="gregorian" when="1957-02-14">February 14, 1957, 2
                        p.m.</date></dateline>
                </opener>
                <pb facs="d787-1" n="1" type="facsimile" xml:id="d787-1"/>
                <p>784. Your 815.</p>
                <p>Concur.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Gowen</hi>
                    </signed>
                </closer>
            </div>
        </body>
