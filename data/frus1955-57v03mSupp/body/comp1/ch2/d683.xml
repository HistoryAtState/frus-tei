    <text>
        <body>
            <div xml:id="d683">

                <pb facs="1154" n="1107" sameAs="frus:frus1955-57v03mSupp/pg1107"/>

                <head>683. Telegram 70 to Geneva<anchor n="1" xml:id="d683-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1956-07-23">July 23, 1956, 4:02
                        p.m.</date></dateline>
                </opener>
                <pb facs="d683-1" n="1" type="facsimile" xml:id="d683-1"/>
                <p>70. For Johnson.</p>
                <p>Chinese convict Lu Ping Yeou No. 25 on list released from prison July 20. Four
                    released 30 remain.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Hoover</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
