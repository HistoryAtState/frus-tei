    <text>
        <body>
            <div xml:id="d658">

                <pb facs="d657-2" n="2" sameAs="frus:frus1955-57v03mSupp/d657-2"/>

                <head>658. Telegram 53 from Geneva to Prague<anchor n="1" xml:id="d658-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Geneva</placeName>, <date
                            calendar="gregorian" when="1956-06-13">June 13, 1956,
                        noon</date></dateline>
                </opener>
                <pb facs="d658-1" n="1" type="facsimile" xml:id="d658-1"/>
                <p>53. From Osborn. Sending Wang copies
                    Department’s release number 315.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Gowen</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
