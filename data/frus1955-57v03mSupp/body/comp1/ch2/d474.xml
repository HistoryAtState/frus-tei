    <text>
        <body>
            <div xml:id="d474">

                <pb facs="0753" n="706" xml:id="pg706"/>

                <head>474. Telegram 1573 to Geneva<anchor n="1" xml:id="d474-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1956-02-02">February 2, 1956, 10:23
                            a.m.</date></dateline>
                </opener>
                <pb facs="d474-1" n="1" type="facsimile" xml:id="d474-1"/>
                <p>1573. For Johnson.</p>
                <p>Your 1440. You are authorized your discretion handle Chinese names as you suggest
                    provided Wang afforded no grounds for
                    misinterpretation.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Dulles</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
