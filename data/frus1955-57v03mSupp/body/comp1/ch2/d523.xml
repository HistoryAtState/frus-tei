    <text>
        <body>
            <div xml:id="d523">

                <pb facs="d522-1" n="1" sameAs="frus:frus1955-57v03mSupp/d522-1"/>

                <head>523. Telegram 1730 to Geneva<anchor n="1" xml:id="d523-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1956-03-07">March 7, 1956, 6:25
                        p.m.</date></dateline>
                </opener>
                <pb facs="d523-1" n="1" type="facsimile" xml:id="d523-1"/>
                <p>1730. For Johnson.</p>
                <p>Medical case history Liu Yung-ming received from Missouri State Hospital No. 4.
                    It is being forwarded promptly to American Red Cross for transmittal to Red
                    Cross in Peiping. You may inform Wang to this effect at tomorrow’s meeting.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Hoover</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
