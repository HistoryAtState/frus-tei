    <text>
        <body>
            <div xml:id="d689">

                <pb facs="1169" n="1122" sameAs="frus:frus1955-57v03mSupp/pg1122"/>

                <head>689. Memorandum from Robertson to
                        Dulles<anchor n="1" xml:id="d689-f1"
                    /></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1956-07-31">July 31, 1956</date></dateline>
                </opener>
                <pb facs="d689-1" n="1" type="facsimile" xml:id="d689-1"/>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>Letter of Commendation from President to Ambassador Johnson</item>
                </list>
                <p>There is attached (Tab A), a memorandum from you to the President recommending
                    that he sign the enclosed draft of a letter of commendation to Ambassador
                        Johnson (Tab B) on the occasion of
                    the anniversary of the Geneva talks. This letter was prepared in accordance with
                    your oral request of July 20.</p>




                <xi:include href="d689-a1.xml" xpointer="d689-a1"/>
                <xi:include href="d689-a2.xml" xpointer="d689-a2"/>
            </div>
        </body>
    </text>
