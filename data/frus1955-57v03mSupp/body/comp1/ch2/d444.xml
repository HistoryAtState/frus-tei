            <div xml:id="d444">

                <pb facs="d443-22" n="22" sameAs="frus:frus1955-57v03mSupp/d443-22"/>

                <head>444. Telegram 1365 from Geneva<anchor n="1" xml:id="d444-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Geneva</placeName>, <date
                            calendar="gregorian" when="1956-01-13">January 13, 1956, 10
                        a.m.</date></dateline>
                </opener>
                <pb facs="d444-1" n="1" type="facsimile" xml:id="d444-1"/>
                <p>1365. From Johnson.</p>
                <p>Fol list handed me by Wang January 12
                    meeting (para 66 Mytel 1364):</p>
                <p>[<hi rendition="#italic">text not declassified</hi>]</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Gowen</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
