    <text>
        <body>
            <div xml:id="d655">

                <pb facs="1101" n="1054" sameAs="frus:frus1955-57v03mSupp/pg1054"/>

                <head>655. Telegram 2033 from Geneva<anchor n="1" xml:id="d655-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Geneva</placeName>, <date
                            calendar="gregorian" when="1956-06-12">June 12, 1956,
                        noon</date></dateline>
                </opener>
                <pb facs="d655-1" n="1" type="facsimile" xml:id="d655-1"/>
                <p>2033. From Osborn. CHICOMS have just announced press conference for 3:30 our
                    time.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Gowen</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
