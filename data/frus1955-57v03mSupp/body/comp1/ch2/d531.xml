    <text>
        <body>
            <div xml:id="d531">

                <pb facs="0906" n="859" sameAs="frus:frus1955-57v03mSupp/pg859"/>

                <head>531. Telegram Tosec 54 to Djakarta<anchor n="1" xml:id="d531-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1956-03-11">March 11, 1956, 5:51
                        p.m.</date></dateline>
                </opener>
                <pb facs="d531-1" n="1" type="facsimile" xml:id="d531-1"/>
                <p>Tosec 54. For Secretary and Robertson.</p>
                <p>(Code room: Repeat text Geneva’s 1621 control 6674.)</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Hoover</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d531-f1" n="1" type="source" xml:id="d531-f1-content">
                <p>Source: Department of State, Central Files, 611.93/3–1156. Official Use Only.
                    Drafted by McConaughy and an officer in
                    DCT. Also sent to Prague for Johnson as
                    telegram 289.</p>
            </note>
        </listAnnotation>
