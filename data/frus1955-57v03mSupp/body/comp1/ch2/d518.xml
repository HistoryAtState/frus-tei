    <text>
        <body>
            <div xml:id="d518">

                <pb facs="d517-1" n="1" sameAs="frus:frus1955-57v03mSupp/d517-1"/>

                <head>518. Telegram Tosec 3 to Karachi<anchor n="1" xml:id="d518-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1956-03-04">March 4, 1956, 5:54
                        p.m.</date></dateline>
                </opener>
                <pb facs="d518-1" n="1" type="facsimile" xml:id="d518-1"/>
                <p>Tosec 3. DCT please repeat Geneva’s 1587 Mar 4, 4 pm Control 2083 to Karachi
                    captioned</p>
                <p>For the Secretary and Robertson.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Hoover</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
