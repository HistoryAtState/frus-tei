    <text>
        <body>
            <div xml:id="d545">

                <pb facs="0916" n="869" xml:id="pg869"/>

                <head>545. Telegram 1772 to Geneva<anchor n="1" xml:id="d545-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1956-03-20">March 20, 1956, 3:44
                        p.m.</date></dateline>
                </opener>
                <pb facs="d545-1" n="1" type="facsimile" xml:id="d545-1"/>
                <p>1772. For Johnson.</p>
                <p>(Code room: Please repeat Colombo Dulte 22, March 11, Control 6737)</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Hoover</hi>
                    </signed>
                </closer>
                <postscript>
                    <p>Re: Summary of views Nehru expressed to Secretary.</p>
                </postscript>
            </div>
        </body>
    </text>
