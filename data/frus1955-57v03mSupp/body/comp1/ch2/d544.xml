    <text>
        <body>
            <div xml:id="d544">

                <pb facs="d543-1" n="1" sameAs="frus:frus1955-57v03mSupp/d543-1"/>

                <head>544. Telegram 1652 from Geneva<anchor n="1" xml:id="d544-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Geneva</placeName>, <date
                            calendar="gregorian" when="1956-03-20">March 20, 1956, 5
                        p.m.</date></dateline>
                </opener>
                <pb facs="d544-1" n="1" type="facsimile" xml:id="d544-1"/>
                <p>1652. From Johnson. Re Deptel 1769.</p>
                <p>Reports conversations New Delhi not (repeat not) yet received other than
                    summaries of memos contained Deptel 1750. Tokyo conversation also not
                    received.</p>
                <p>Draft history talks transmitted by letter March 17.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Gowen</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
