    <text>
        <body>
            <div xml:id="d575">

                <pb facs="0961" n="914" xml:id="pg914"/>

                <head>575. Telegram 1874 to Geneva<anchor n="1" xml:id="d575-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1956-04-13">April 13, 1956, 1:40
                        p.m.</date></dateline>
                </opener>
                <pb facs="d575-1" n="1" type="facsimile" xml:id="d575-1"/>
                <p>1874. For Johnson.</p>
                <p>(Code Room: Please repeat Department’s telegram to Prague 327, Control 05588,
                    April 12.)</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Dulles</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
