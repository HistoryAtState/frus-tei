    <text>
        <body>
            <div xml:id="d643">

                <pb facs="1082" n="1035" xml:id="pg1035"/>

                <head>643. Telegram 2102 to Geneva<anchor n="1" xml:id="d643-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1956-06-06">June 6, 1956, 7:15
                        p.m.</date></dateline>
                </opener>
                <pb facs="d643-1" n="1" type="facsimile" xml:id="d643-1"/>
                <p>2102. For Johnson.</p>
                <p>(CODE ROOM: Please repeat Taipei’s 1080, June 4, Control 1662)</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Dulles</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
