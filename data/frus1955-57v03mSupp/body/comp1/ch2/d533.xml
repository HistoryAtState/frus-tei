    <text>
        <body>
            <div xml:id="d533">

                <pb facs="d532-1" n="1" sameAs="frus:frus1955-57v03mSupp/d532-1"/>

                <head>533. Telegram 1750 to Geneva<anchor n="1" xml:id="d533-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1956-03-12">March 12, 1956, 6:47
                        p.m.</date></dateline>
                </opener>
                <pb facs="d533-1" n="1" type="facsimile" xml:id="d533-1"/>
                <p>1750. For Johnson.</p>
                <p>Code Room: Please repeat Colombo’s Secto 43, Control 6696, March 11, 1956.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Hoover</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
