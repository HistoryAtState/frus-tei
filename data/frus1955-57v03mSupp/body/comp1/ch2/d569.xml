    <text>
        <body>
            <div xml:id="d569">

                <pb facs="0953" n="906" xml:id="pg906"/>

                <head>569. Telegram 1742 from Geneva<anchor n="1" xml:id="d569-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Geneva</placeName>, <date
                            calendar="gregorian" when="1956-04-09">April 9, 1956, 7
                        p.m.</date></dateline>
                </opener>
                <pb facs="d569-1" n="1" type="facsimile" xml:id="d569-1"/>
                <p>1742. From Johnson.</p>
                <p>Departing for Prague morning April 10 returning Geneva April 17.</p>
                <p>Have no comments on today’s meeting other than those contained my telegram
                    1737.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Gowen</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
