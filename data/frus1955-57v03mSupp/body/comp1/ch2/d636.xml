                <head>636. Telegram 1985 from Geneva<anchor n="1" xml:id="d636-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Geneva</placeName>, <date
                            calendar="gregorian" when="1956-06-04">June 4, 1956, 3
