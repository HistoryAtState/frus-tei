    <text>
        <body>
            <div xml:id="d507">

                <pb facs="d506-1" n="1" sameAs="frus:frus1955-57v03mSupp/d506-1"/>

                <head>507. Telegram 1697 to Geneva<anchor n="1" xml:id="d507-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1956-02-29">February 29,
                        1956</date></dateline>
                </opener>
                <pb facs="d507-1" n="1" type="facsimile" xml:id="d507-1"/>
                <p>1697. For Johnson.</p>
                <p>Our 1693 first paragraph.</p>
                <p>In citing arrivals Chinese in Communist China from US you may make further
                    itemization. Our records show minimum 67 arrivals between September 10 and
                    December 20 and 35 since December 20.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Dulles</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d507-f1" n="1" type="source" xml:id="d507-f1-content">
                <p>Source: Department of State, Central Files, 611.93/2–2956. Secret; Priority;
                    Limit Distribution. Drafted by McConaughy. The time of transmission is illegible.</p>
            </note>
        </listAnnotation>
    </standOff>
