    <text>
        <body>
            <div xml:id="d737">

                <pb facs="1275" n="1228" xml:id="pg1228"/>

                <head>737. Telegram 189 from Prague<anchor n="1" xml:id="d737-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Prague</placeName>, <date
                            calendar="gregorian" when="1956-10-19">October 19, 1956, 5
                        p.m.</date></dateline>
                </opener>
                <pb facs="d737-1" n="1" type="facsimile" xml:id="d737-1"/>
                <p>189. In order obtain maximum coverage and assist relations with press in Geneva
                    suggest that press officer Geneva be authorized make simultaneous release
                    proposed press statement on CHICOM implementation agreed announcement.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Johnson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d737-f1" n="1" type="source" xml:id="d737-f1-content">
                <p>Source: Department of State, Central Files, 611.93/10–1956. Confidential; Limit
                    Distribution. Repeated to Geneva for Osborn as telegram 9.</p>
            </note>
        </listAnnotation>
