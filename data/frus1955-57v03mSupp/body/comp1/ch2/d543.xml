    <text>
        <body>
            <div xml:id="d543">

                <pb facs="0915" n="868" sameAs="frus:frus1955-57v03mSupp/pg868"/>

                <head>543. Telegram 1771 to Geneva<anchor n="1" xml:id="d543-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1956-03-19">March 19, 1956, 6:51
                        p.m.</date></dateline>
                </opener>
                <pb facs="d543-1" n="1" type="facsimile" xml:id="d543-1"/>
                <p>1771. For Johnson.</p>
                <p>(Code room: Please repeat Taipei’s 848, March 18, Control 10953.) Re: Summary of
                    Conferences with President Chiang.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Hoover</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
