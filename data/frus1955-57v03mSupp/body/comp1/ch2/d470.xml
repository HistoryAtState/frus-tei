    <text>
        <body>
            <div xml:id="d470">

                <pb facs="d469-1" n="1" sameAs="frus:frus1955-57v03mSupp/d469-1"/>

                <head>470. Circular Telegram 500<anchor n="1" xml:id="d470-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1956-01-27">January 27, 1956, 6:09
                            p.m.</date></dateline>
                </opener>
                <pb facs="d470-1" n="1" type="facsimile" xml:id="d470-1"/>
                <p>500. Joint State–USIA.</p>
                <p>Department and Agency request telegraphic report reaction to Chinese Communist
                    foreign office statement January 18 concerning Ambassadorial talks at Geneva,
                    Department’s reply January 21 and rebuttal by Chinese Communist foreign office
                    January 24. Report should cover same points listed circular 426 December 23.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Dulles</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d470-f1" n="1" type="source" xml:id="d470-f1-content">
                <p>Source: Department of State, Central Files, 611.93/1–2756. Confidential. Drafted
                    by Henderson; cleared in USIA, NEA/P, EUR/P, and by Clough. Sent to Bangkok, Bern, Bombay, Brussels, Bonn, Calcutta,
                    Colombo, Djakarta, Hong Kong, London, Madras, Manila, New Delhi, Paris, Rangoon,
                    Rome, Saigon, Singapore, Stockholm, Taipei, and Tokyo.</p>
            </note>
        </listAnnotation>
    </standOff>
