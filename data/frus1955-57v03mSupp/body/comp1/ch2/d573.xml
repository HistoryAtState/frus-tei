    <text>
        <body>
            <div xml:id="d573">

                <pb facs="0960" n="913" xml:id="pg913"/>

                <head>573. Telegram 324 to Prague<anchor n="1" xml:id="d573-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1956-04-12">April 12, 1956, 4:24
                        p.m.</date></dateline>
                </opener>
                <pb facs="d573-1" n="1" type="facsimile" xml:id="d573-1"/>
                <p>324. For Amb Johnson.</p>
                <p>Following is text Department’s 1860 to Geneva:</p>
                <p>QUOTE</p>
                <p>(Code Room: Please repeat Department’s 1860, Control 04671, April 11, 1956)</p>
                <p>UNQUOTE</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Dulles</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
