    <text>
        <body>
            <div xml:id="d522">

                <pb facs="0886" n="839" xml:id="pg839"/>

                <head>522. Telegram 1603 from Geneva<anchor n="1" xml:id="d522-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Geneva</placeName>, <date
                            calendar="gregorian" when="1956-03-07">March 7, 1956, 3
                        p.m.</date></dateline>
                </opener>
                <pb facs="d522-1" n="1" type="facsimile" xml:id="d522-1"/>
                <p>1603. From Johnson.</p>
                <p>Would appreciate information soonest on when Department plans release reply to
                    CHICOM March 4 statement and confirmation of text.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Gowen</hi>
                    </signed>
                </closer>
                <postscript>
                    <p>Note: Mr. Waddell’s office (FE) notified 3/7/12:15 p.m. LWH</p>
                </postscript>
            </div>
        </body>
    </text>
