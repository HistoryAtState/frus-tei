    <text>
        <body>
            <div xml:id="d632">

                <pb facs="d631-1" n="1" sameAs="frus:frus1955-57v03mSupp/d631-1"/>

                <head>632. Telegram 730 to Taipei<anchor n="1" xml:id="d632-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1956-05-31">May 31, 1956, 8:29
                        p.m.</date></dateline>
                </opener>
                <pb facs="d632-1" n="1" type="facsimile" xml:id="d632-1"/>
                <p>730. (CODE ROOM: Please repeat Department’s 2066 to Geneva, Control 13989, May
                    29.)</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Hoover</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d632-f1" n="1" type="source" xml:id="d632-f1-content">
                <p>Source: Department of State, Central Files, 611.93/5–3156. Secret. Drafted by
                    McConaughy; cleared in SOA. Also sent to London as telegram 7256 and New Delhi
                    as telegram 2925.</p>
            </note>
        </listAnnotation>
    </standOff>
