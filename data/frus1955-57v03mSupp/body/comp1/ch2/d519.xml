    <text>
        <body>
            <div xml:id="d519">

                <pb facs="0883" n="836" xml:id="pg836"/>

                <head>519. Telegram Tosec 7 to Karachi<anchor n="1" xml:id="d519-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1956-03-05">March 5, 1956, 1:56
                        p.m.</date></dateline>
                </opener>
                <pb facs="d519-1" n="1" type="facsimile" xml:id="d519-1"/>
                <p>Tosec 7. (Code room: Please repeat Geneva’s 1574, March 1, Control No. 540.)</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Hoover</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
