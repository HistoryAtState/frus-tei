        <body>
            <div xml:id="d457">

                <pb facs="d456-2" n="2" sameAs="frus:frus1955-57v03mSupp/d456-2"/>

                <head>457. Telegram 1405 from Geneva<anchor n="1" xml:id="d457-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Geneva</placeName>, <date
                            calendar="gregorian" when="1956-01-10">January 10, 1956, 1
                        a.m.</date></dateline>
                </opener>
                <pb facs="d457-1" n="1" type="facsimile" xml:id="d457-1"/>
                <p>1405. From Johnson.</p>
                <p>Fol is list handed me by Wang at board [<hi rendition="#italic">33rd</hi>?]
                    meeting:</p>
                <p>[<hi rendition="#italic">text not declassified</hi>]</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Gowen</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
