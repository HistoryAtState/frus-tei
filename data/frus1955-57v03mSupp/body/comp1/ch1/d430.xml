    <text>
        <body>
            <div xml:id="d430">

                <pb facs="0674" n="627" xml:id="pg627"/>

                <head>430. Telegram 194 to Prague<anchor n="1" xml:id="d430-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1955-12-30">December 30, 1955, 3:26
                            p.m.</date></dateline>
                </opener>
                <pb facs="d430-1" n="1" type="facsimile" xml:id="d430-1"/>
                <p>194. For Ambassador.</p>
                <p>(Code Room: Please repeat Geneva’s 1320, December 28; control 13398)</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Dulles</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
