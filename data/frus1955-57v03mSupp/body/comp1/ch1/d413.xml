    <text>
        <body>
            <div xml:id="d413">

                <pb facs="0633" n="586" sameAs="frus:frus1955-57v03mSupp/pg586"/>

                <head>413. Telegram 1283 from Geneva<anchor n="1" xml:id="d413-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Geneva</placeName>, <date
                            calendar="gregorian" when="1955-12-13">December 13, 1955, 5
                        p.m.</date></dateline>
                </opener>
                <pb facs="d413-1" n="1" type="facsimile" xml:id="d413-1"/>
                <p>1283. From Johnson. Reference: Paragraph
                    3 Department’s 1377.</p>
                <p>It is my understanding proposed recess to begin after meeting December 22.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Gowen</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
