    <text>
        <body>
            <div xml:id="d284">

                <pb facs="0439" n="392" sameAs="frus:frus1955-57v03mSupp/pg392"/>

                <head>284. Telegram 864 from Geneva<anchor n="1" xml:id="d284-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Geneva</placeName>, <date
                            calendar="gregorian" when="1955-10-14">October 14, 1955, 9
                        a.m.</date></dateline>
                </opener>
                <pb facs="d284-1" n="1" type="facsimile" xml:id="d284-1"/>
                <p>864. From Johnson.</p>
                <p>Would appreciate prompt extension by Defense of Colonel Ekvall’s orders which
                    expired September 20.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Gowen</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
