    <text>
        <body>
            <div xml:id="d127">

                <pb facs="0206" n="159" sameAs="frus:frus1955-57v03mSupp/pg159"/>

                <head>127. Telegram 616 to Geneva<anchor n="1" xml:id="d127-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1955-08-23">August 23, 1955, 7:38
                        p.m.</date></dateline>
                </opener>
                <pb facs="d127-1" n="1" type="facsimile" xml:id="d127-1"/>
                <p>616. For Johnson.</p>
                <p>FYI. Secretary has sent following to U Nu in response to inquiry from latter:</p>
                <p>QUOTE (Code Room: Please recite here text of letter contained in Department’s 150
                    to Rangoon) QUOTE</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Dulles</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
