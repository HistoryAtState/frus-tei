    <text>
        <body>
            <div xml:id="d193">

                <pb facs="d192-1" n="1" sameAs="frus:frus1955-57v03mSupp/d192-1"/>

                <head>193. Telegram 728 to Geneva<anchor n="1" xml:id="d193-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1955-09-15">September 15,
                        1955</date></dateline>
                </opener>
                <pb facs="d193-1" n="1" type="facsimile" xml:id="d193-1"/>
                <p>728. For Johnson.</p>
                <p>Following is text London’s 1034:</p>
                <p>(Code Room please repeat London’s 1034, Control 7183)</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Hoover</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
