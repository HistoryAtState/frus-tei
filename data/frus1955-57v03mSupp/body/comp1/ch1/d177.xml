    <text>
        <body>
            <div xml:id="d177">

                <pb facs="d176-3" n="3" sameAs="frus:frus1955-57v03mSupp/d176-3"/>

                <head>177. Telegram 705 to Geneva<anchor n="1" xml:id="d177-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1955-09-09">September 9, 1955, 7:39
                            p.m.</date></dateline>
                </opener>
                <pb facs="d177-1" n="1" type="facsimile" xml:id="d177-1"/>
                <p>705. For Johnson.</p>
                <p>Your 700. Following is text of revised press background talking paper. Now
                    planned for Suydam rather than Robertson
                    meet with Press September 10.</p>
                <p>Code room: Please repeat Department’s Tel. ________ omitting first paragraph and
                    submitting the above paragraph.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Hoover</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d177-f1" n="1" type="source" xml:id="d177-f1-content">
                <p>Source: Department of State, Central Files, 611.93/9–955. Confidential; Priority.
                    Drafted by McConaughy; cleared by
                        Robertson.</p>
            </note>
