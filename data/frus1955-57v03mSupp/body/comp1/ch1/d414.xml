    <text>
        <body>
            <div xml:id="d414">

                <pb facs="0634" n="587" xml:id="pg587"/>

                <head>414. Telegram 1393 to Geneva<anchor n="1" xml:id="d414-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1955-12-14">December 14, 1955, 1:12
                            p.m.</date></dateline>
                </opener>
                <pb facs="d414-1" n="1" type="facsimile" xml:id="d414-1"/>
                <p>1393. For Johnson. Your 1283.</p>
                <p>Department’s intention is that proposed recess begin after December 15 meeting.
                    Re Our 1366 Colm may leave immediately after next meeting assuming recess agreed
                    to.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Hoover</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d414-f1" n="1" type="source" xml:id="d414-f1-content">
                <p>Source: Department of State, Central Files, 611.93/12–1355. Secret; Priority;
                    Limit Distribution. Drafted by McConaughy; cleared by Sebald and in substance by
                    Yager.</p>
            </note>
        </listAnnotation>
