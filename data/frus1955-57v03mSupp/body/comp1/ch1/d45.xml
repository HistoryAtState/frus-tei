    <text>
        <body>
            <div xml:id="d45">

                <pb facs="0098" n="51" xml:id="pg51"/>

                <head>45. Telegram 356 from Geneva<anchor n="1" xml:id="d45-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Geneva</placeName>, <date
                            calendar="gregorian" when="1955-08-08">August 8, 1955, 9
                        p.m.</date></dateline>
                </opener>
                <pb facs="d45-1" n="1" type="facsimile" xml:id="d45-1"/>
                <p>356. From Johnson.</p>
                <p>Denny article August 4 referred to Deptel 400 not available here.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Gowen</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
