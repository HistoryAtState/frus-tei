    <text>
        <body>
            <div xml:id="d290">

                <pb facs="0449" n="402" xml:id="pg402"/>

                <head>290. Telegram 886 to Geneva<anchor n="1" xml:id="d290-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1955-10-14">October 14, 1955, 6:20
                            p.m.</date></dateline>
                </opener>
                <pb facs="d290-1" n="1" type="facsimile" xml:id="d290-1"/>
                <p>886. For Johnson. Your 864.</p>
                <p>Defense arranging assign Ekvall
                    European post and detail Geneva for duration talks. Letter from Godel
                    enroute.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Dulles</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
