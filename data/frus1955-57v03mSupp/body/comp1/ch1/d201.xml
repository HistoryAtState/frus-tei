    <text>
        <body>
            <div xml:id="d201">

                <pb facs="0312" n="265" xml:id="pg265"/>

                <head>201. Telegram 750 to Geneva<anchor n="1" xml:id="d201-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1955-09-19">September 19, 1955, 6:39
                            p.m.</date></dateline>
                </opener>
                <pb facs="d201-1" n="1" type="facsimile" xml:id="d201-1"/>
                <p>750. For Johnson.</p>
                <p>For completion our records forward exact text statements released by you and Wang
                    to press September 14.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Dulles</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
