    <text>
        <body>
            <div xml:id="d53">

                <pb facs="d52-1" n="1" sameAs="frus:frus1955-57v03mSupp/d52-1"/>

                <head>53. Despatch 2 from Geneva<anchor n="1" xml:id="d53-f1"/></head>
                <opener>
                    <seg rendition="#float-left">No. 2</seg>
                    <dateline rendition="#float-right"><placeName>Geneva</placeName>, <date
                            calendar="gregorian" when="1955-08-09">August 9, 1955</date></dateline>
                </opener>
                <list type="references">
                    <head>REF</head>
                    <item>Geneva Telegram 315, August 4, 1955</item>
                </list>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>Transmitting Text of Ambassador Johnson’s Statement to Ambassador Wang on
                        United States Immigration Procedures</item>
                </list>
                <pb facs="d53-1" n="1" type="facsimile" xml:id="d53-1"/>
                <p>With reference to my telegram No. 315 of August 4, 1955, I am enclosing the full
                    text of my remarks to Ambassador Wang Ping-nan on the subject of United States
                    Immigration procedure. These remarks were summarized only very briefly in the
                    reference telegram to reduce its length.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">U. Alexis Johnson</hi>
                        <lb/>
                        <hi rendition="#italic">American Ambassador</hi>
                    </signed>
                </closer>
                <pb facs="0105" n="58" type="typeset" xml:id="pg58"/>



                <xi:include href="d53-a1.xml" xpointer="d53-a1"/>
            </div>
