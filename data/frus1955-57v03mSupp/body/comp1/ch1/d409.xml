    <text>
        <body>
            <div xml:id="d409">

                <pb facs="0630" n="583" xml:id="pg583"/>

                <head>409. Telegram 1376 to Geneva<anchor n="1" xml:id="d409-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1955-12-12">December 12, 1955, 3:48
                            p.m.</date></dateline>
                </opener>
                <pb facs="d409-1" n="1" type="facsimile" xml:id="d409-1"/>
                <p>1376. For Johnson.</p>
                <p>Urtel 1262. Failure receive significant flow FBIS due paucity pertinent items.
                    Requirements under review however to ensure coverage your interest.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Dulles</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
