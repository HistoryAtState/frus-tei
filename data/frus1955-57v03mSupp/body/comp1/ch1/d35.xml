    <text>
        <body>
            <div xml:id="d35">

                <pb facs="0085" n="38" xml:id="pg38"/>

                <head>35. Telegram 333 from Geneva<anchor n="1" xml:id="d35-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Geneva</placeName>, <date
                            calendar="gregorian" when="1955-08-06">August 6, 1955, 5
                        p.m.</date></dateline>
                </opener>
                <pb facs="d35-1" n="1" type="facsimile" xml:id="d35-1"/>
                <p>333. From Johnson. Re Deptel 389, August
                    5.</p>
                <p>Telegraph text.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Gowen</hi>
                    </signed>
                </closer>
                <postscript>
                    <p>Note: Mr. Bardach (FE) informed 3:05 p. m., 8/6/55 CWO/FED</p>
                </postscript>
            </div>
        </body>
    </text>
