    <text>
        <body>
            <div xml:id="d316">

                <pb facs="0487" n="440" xml:id="pg440"/>

                <head>316. Telegram 1003 to Geneva<anchor n="1" xml:id="d316-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1955-10-26">October 26, 1955, 12:29
                            p.m.</date></dateline>
                </opener>
                <pb facs="d316-1" n="1" type="facsimile" xml:id="d316-1"/>
                <p>1003. For Johnson. Your 962.</p>
                <p>Defense unable supply specific information requested your 871 from Washington
                    files. Have asked Army to have search made of more complete files stored Kansas
                    City.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Hoover</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
