    <text>
        <body>
            <div xml:id="d314">

                <pb facs="0486" n="439" xml:id="pg439"/>

                <head>314. Telegram 962 from Geneva<anchor n="1" xml:id="d314-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Geneva</placeName>, <date
                            calendar="gregorian" when="1955-10-26">October 26, 1955, 10
                        a.m.</date></dateline>
                </opener>
                <pb facs="d314-1" n="1" type="facsimile" xml:id="d314-1"/>
                <p>962. From Johnson.</p>
                <p>Would appreciate some reply my 871 prior to tomorrow’s WPP Meeting.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Gowen</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
