    <text>
        <body>
            <div xml:id="d33">

                <pb facs="d32-2" n="2" sameAs="frus:frus1955-57v03mSupp/d32-2"/>

                <head>33. Telegram 389 to Geneva<anchor n="1" xml:id="d33-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1955-08-05">August 5, 1955</date></dateline>
                </opener>
                <pb facs="d33-1" n="1" type="facsimile" xml:id="d33-1"/>
                <p>389. For Johnson.</p>
                <p>Do you have text June 3 statement Immigration Commissioner J.M. Swing? If not we
                    will telegraph text since it may be of use at next meeting.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Dulles</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
