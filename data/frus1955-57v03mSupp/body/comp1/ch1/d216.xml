    <text>
        <body>
            <div xml:id="d216">

                <pb facs="d215-3" n="3" sameAs="frus:frus1955-57v03mSupp/d215-3"/>

                <head>216. Despatch 5 from Geneva<anchor n="1" xml:id="d216-f1"/></head>
                <opener>
                    <seg rendition="#float-left">No. 5</seg>
                    <dateline rendition="#float-right"><placeName>Geneva</placeName>, <date
                            calendar="gregorian" when="1955-09-21">September 21,
                        1955</date></dateline>
                </opener>
                <pb facs="d216-1" n="1" type="facsimile" xml:id="d216-1"/>
                <list type="references">
                    <head>REF</head>
                    <item>Geneva’s Telegram 739, September 18, 1955</item>
                </list>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>Transmitting Letter Received from Ambassador Wang Ping-nan Regarding
                        Implementation of the Agreed Announcement</item>
                </list>
                <p>There is enclosed a copy of the full text of the translation of a letter
                    addressed to me in Chinese by Ambassador Wang Ping-nan on September 16, 1955.
                    The signed original of the Chinese letter was accompanied by this translation
                    which was evidently hastily done and contains some inaccuracies. However, it has
                    been checked with the Chinese text and was found to be correct in its essential
                    substance.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">U. Alexis Johnson</hi>
                        <lb/>
                        <hi rendition="#italic">American Ambassador</hi>
                    </signed>
                </closer>



                <xi:include href="d216-a1.xml" xpointer="d216-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
