    <text>
        <body>
            <div xml:id="d93">

                <pb facs="0165" n="118" xml:id="pg118"/>

                <head>93. Telegram 523 to Geneva<anchor n="1" xml:id="d93-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1955-08-16">August 16, 1955, 5:18
                        p.m.</date></dateline>
                </opener>
                <pb facs="d93-1" n="1" type="facsimile" xml:id="d93-1"/>
                <p>523. For Johnson.</p>
                <p>Code Room: Please repeat USUN’s 112 of August 15, 1955, Control Number 7865.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Dulles</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
