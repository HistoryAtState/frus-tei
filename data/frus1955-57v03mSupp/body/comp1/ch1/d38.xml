    <text>
        <body>
            <div xml:id="d38">

                <pb facs="d37-1" n="1" sameAs="frus:frus1955-57v03mSupp/d37-1"/>

                <head>38. Telegram 399 to Geneva<anchor n="1" xml:id="d38-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1955-08-06">August 6, 1955, 2:40
                        p.m.</date></dateline>
                </opener>
                <pb facs="d38-1" n="1" type="facsimile" xml:id="d38-1"/>
                <p>399. For Johnson.</p>
                <p>You will recognize Deptel 384 is only speculative intelligence round-up and does
                    not represent any agreed Departmental estimate of probable Chinese Communist
                    course of action.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Dulles</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
