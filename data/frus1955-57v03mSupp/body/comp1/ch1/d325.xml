    <text>
        <body>
            <div xml:id="d325">

                <pb facs="0496" n="449" sameAs="frus:frus1955-57v03mSupp/pg449"/>

                <head>325. Telegram Tedul 28 to Geneva<anchor n="1" xml:id="d325-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1955-10-29">October 29, 1955, 5:10
                            p.m.</date></dateline>
                </opener>
                <pb facs="d325-1" n="1" type="facsimile" xml:id="d325-1"/>
                <p>Tedul 28. Secretary should see Deptels 1052 and 1053 to Geneva FOR JOHNSON.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Hoover</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
