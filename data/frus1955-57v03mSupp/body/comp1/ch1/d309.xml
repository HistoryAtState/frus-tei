    <text>
        <body>
            <div xml:id="d309">

                <pb facs="d308-4" n="4" sameAs="frus:frus1955-57v03mSupp/d308-4"/>

                <head>309. Telegram 980 to Geneva<anchor n="1" xml:id="d309-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1955-10-24">October 24, 1955, 6:59
                            p.m.</date></dateline>
                </opener>
                <pb facs="d309-1" n="1" type="facsimile" xml:id="d309-1"/>
                <p>980. For Johnson.</p>
                <p>Your 915. USIA detailing Lawrence Howse, Press Attache at Paris, as your press
                    officer.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Hoover</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
