    <text>
        <body>
            <div xml:id="d218">

                <pb facs="0334" n="287" sameAs="frus:frus1955-57v03mSupp/pg287"/>

                <head>218. Telegram 764 to Geneva<anchor n="1" xml:id="d218-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1955-09-22">September 22, 1955, 4:53
                            p.m.</date></dateline>
                </opener>
                <pb facs="d218-1" n="1" type="facsimile" xml:id="d218-1"/>
                <p>764. For Johnson.</p>
                <p>(Code Room: Please repeat London’s 1119, Control No. 10430, dated September 20,
                    1955)</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Hoover</hi>
                        <lb/>
                        <hi rendition="#italic">Acting</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
