    <text>
        <body>
            <div xml:id="d141">

                <pb facs="d140-2" n="2" sameAs="frus:frus1955-57v03mSupp/d140-2"/>

                <head>141. Telegram 628 from Geneva<anchor n="1" xml:id="d141-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Geneva</placeName>, <date
                            calendar="gregorian" when="1955-08-26">August 26, 1955, 11
                        a.m.</date></dateline>
                </opener>
                <pb facs="d141-1" n="1" type="facsimile" xml:id="d141-1"/>
                <p>628. From Johnson. Deptel 633.</p>
                <p>I have requested next meeting Wednesday, August 31, 10 a.m.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Gowen</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
