            </note>
            <note corresp="#d170-f13" n="13" xml:id="d170-f13-content">
                <p>Maj. Gen. Elmer J. Rogers, Jr., U.S. Air Force Member, Joint
                    Strategic Survey Committee, Joint Chiefs of Staff.</p>
            </note>
            <note corresp="#d170-f14" n="14" xml:id="d170-f14-content">
                <p>Maj. Gen. Alonzo P. Fox, U.S. Army Member, JSSC.</p>
            </note>
            <note corresp="#d170-f15" n="15" xml:id="d170-f15-content">
                <p>Rear Adm. Walter F. Boone, U.S. Navy Member, JSSC.</p>
            </note>
