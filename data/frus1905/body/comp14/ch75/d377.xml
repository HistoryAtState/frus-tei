    <text>
        <body>
            <div xml:id="d377">

                <pb facs="0539" n="419" sameAs="frus:frus1905/pg419"/>

                <head><hi rendition="#italic">The Acting Secretary of
                            State to General Porter.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1905-04-15"><hi rendition="#italic">April 15,
                        1905</hi></date>.</dateline></opener>
                <p>The Department has great pleasure in sending cordial congratulations upon your
                    success in finding body of Paul Jones.</p>
                <closer><signed><hi rendition="#small-caps">Loomis.</hi></signed></closer>
            </div>
        </body>
    </text>
