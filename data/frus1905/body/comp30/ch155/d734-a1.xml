                <pb facs="0849" n="729" sameAs="frus:frus1905/pg729"/>

                <opener><seg rendition="#center">[Inclosure 1.]</seg></opener>
                <head><hi rendition="#italic">The British Minister to Minister Pearson.</hi></head>
                <opener><dateline rendition="#float-right"><date calendar="gregorian"
                            when="1905-02-05"><hi rendition="#small-caps">February</hi> 5,
                            1905</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. Pearson</hi>: I inclose to you herewith a
                    copy of a telegram I have just received rrom Mr. Stevens at Tabriz, together
                    with the reply which I would propose to send if you should approve.</p>
                <p>Believe, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Arthur H.
                    Hardinge.</hi></signed></closer>
            </div>
        </body>
