    <text>
        <body>
            <div xml:id="d249">

                <pb facs="0360" n="240" sameAs="frus:frus1905/pg240"/>

                <head><hi rendition="#italic">Minister Russell to the Secretary of
                    State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Bogotá</hi></placeName>, <date calendar="gregorian" when="1905-03-20"
                                ><hi rendition="#italic">March 20, 1905</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 30.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith text
                    and translation of a treaty concluded between Colombia and Ecuador for the
                    settlement of their pending boundary dispute.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">William W.
                    Russell.</hi></signed></closer>



                <xi:include href="d249-a1.xml" xpointer="d249-a1"/>
