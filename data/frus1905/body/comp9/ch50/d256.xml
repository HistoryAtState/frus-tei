    <text>
        <body>
            <div xml:id="d256">

                <pb facs="0365" n="245" sameAs="frus:frus1905/pg245"/>

                <head><hi rendition="#italic">The Acting Secretary of State to the Colombian
                        Minister.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1905-05-29"><hi rendition="#italic">May 29,
                        1905</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith for
                    your use a copy of the President’s reply to the remarks made by you this
                    afternoon on the occasion of the presentation of your letters of credence as
                    envoy extraordinary and minister plenipotentiary of Colombia near this
                    government.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">F. B. Loomis.</hi></signed></closer>


                <xi:include href="d256-a1.xml" xpointer="d256-a1"/>
