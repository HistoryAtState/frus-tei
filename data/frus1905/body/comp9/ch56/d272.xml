    <text>
        <body>
            <div xml:id="d272">

                <pb facs="0382" n="262" sameAs="frus:frus1905/pg262"/>

                <head><hi rendition="#italic">President Roosevelt
                        to President Reyes.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1905-12-22"><hi rendition="#italic">December 22,
                        1905</hi></date>.</dateline></opener>
                <p>I offer you my congratulations upon the frustration of the reported attempt
                    against your personal safety.</p>
                <closer><signed><hi rendition="#small-caps">Theodore
                    Roosevelt.</hi></signed></closer>
            </div>
        </body>
    </text>
