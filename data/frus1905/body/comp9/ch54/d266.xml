    <text>
        <body>
            <div xml:id="d266">

                <pb facs="0375" n="255" sameAs="frus:frus1905/pg255"/>

                <head><hi rendition="#italic">Chargé Snyder to the
                            Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Bogotá</hi></placeName>, <date calendar="gregorian" when="1905-10-10"
                                ><hi rendition="#italic">October 10, 1905</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 89.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith
                    copies and translations of the treaties referred to in my No. 88 of September
                    18, 1905.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alban G. Snyder.</hi></signed></closer>







