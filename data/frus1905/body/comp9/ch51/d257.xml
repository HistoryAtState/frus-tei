    <text>
        <body>
            <div xml:id="d257">

                <pb facs="0366" n="246" sameAs="frus:frus1905/pg246"/>

                <head><hi rendition="#italic">Chargé Snyder to the
                            Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Bogotá</hi></placeName>, <date calendar="gregorian" when="1905-06-29"
                                ><hi rendition="#italic">June 29, 1905</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 61.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith copy
                    and translation of a telegram just received by me in reference to the murder of
                    one Joseff Otto, American citizen, in the town of Segovia, Colombia, together
                    with copy of my note to the minister of foreign affairs on the subject.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alban G. Snyder.</hi></signed></closer>


                <xi:include href="d257-a1.xml" xpointer="d257-a1"/>
