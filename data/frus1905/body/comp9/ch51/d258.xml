    <text>
        <body>
            <div xml:id="d258">

                <pb facs="0366" n="246" sameAs="frus:frus1905/pg246"/>

                <head><hi rendition="#italic">Chargé Snyder to the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Bogotá</hi></placeName>, <date calendar="gregorian" when="1905-07-04"
                                ><hi rendition="#italic">July 4, 1905</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 62.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my No. 61 of June 29, 1905, I
                    have the honor to send you herewith copy and translation of a note received from
                    the minister for foreign affairs in answer to my note of June 29, 1905.</p>
                <p>I am, sir, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alban G. Snyder.</hi></signed></closer>



                <xi:include href="d258-a1.xml" xpointer="d258-a1"/>
