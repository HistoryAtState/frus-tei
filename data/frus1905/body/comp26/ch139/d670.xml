    <text>
        <body>
            <div xml:id="d670">

                <pb facs="0788" n="668" sameAs="frus:frus1905/pg668"/>

                <head><hi rendition="#italic">Ambassador McCormick to Acting Secretary of State
                        Adee.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1905-07-10"><hi rendition="#italic">July 10,
                        1905</hi></date>.</dateline></opener>
                <p>France, with agreement of England, accepts invitation of Morocco to a conference
                    on the understanding with Germany that her rights are respected, and that her
                    arrangements with England and Spain will not be questioned nor will the
                    open-door policy be altered.</p>
                <closer><signed><hi rendition="#small-caps">McCormick.</hi></signed></closer>
            </div>
        </body>
    </text>
