    <text>
        <body>
            <div xml:id="d672">

                <pb facs="0789" n="669" sameAs="frus:frus1905/pg669"/>

                <head><hi rendition="#italic">The Acting Secretary of
                            State to Ambassador Tower.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1905-07-10"><hi rendition="#italic">July 10,
                        1905</hi></date>.</dateline></opener>
                <p>Answering your telegram of 10th. The President is greatly obliged, and is more
                    than satisfied if he has been of any use whatever in helping toward the result
                    that has been achieved.</p>
                <closer><signed><hi rendition="#small-caps">Adee.</hi></signed></closer>
            </div>
        </body>
    </text>
