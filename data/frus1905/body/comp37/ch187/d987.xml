                <pb facs="1003" n="883" sameAs="frus:frus1905/pg883"/>

                <head><hi rendition="#italic">President Roosevelt
                        to the Sultan of Turkey.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >The White House</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1905-07-22"><hi rendition="#italic">July 22,
                        1905</hi></date>.</dateline></opener>
                <p>I felicitate Your Majesty on your fortunate escape.</p>
                <closer><signed><hi rendition="#small-caps">Theodore
                    Roosevelt.</hi></signed></closer>
            </div>
