            <div xml:id="ch103">

                <pb facs="0674" n="554" sameAs="frus:frus1905/pg554"/>

                <head>Treaty between the United States and the Republic of Haiti for the mutual
                    extradition of criminals</head>
                <p><hi rendition="#italic">Signed at Washington, August 9, 1904.</hi></p>
                <p><hi rendition="#italic">Ratification advised by the Senate, December 15,
                        1904.</hi></p>
                <p><hi rendition="#italic">Ratified by the President, June 17, 1905.</hi></p>
                <p><hi rendition="#italic">Ratified by Haiti, August 25, 1904.</hi></p>
                <p><hi rendition="#italic">Ratifications exchanged at Washington, June 28,
                        1905.</hi></p>
                <p><hi rendition="#italic">Proclaimed, June 28, 1905.</hi></p>

                <xi:include href="ch103/d510.xml" xpointer="d510"/>
