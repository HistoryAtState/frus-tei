                <pb facs="0663" n="543" sameAs="frus:frus1905/pg543"/>

                <opener><seg rendition="#center">[Inclosure 1.]</seg></opener>
                <head><hi rendition="#italic">Minister Powell to Consular Agent Abegg.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">Port au
                                Prince</hi></placeName>, <date calendar="gregorian"
                            when="1905-03-29"><hi rendition="#italic">March 29,
                        1905</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Please send me at your earliest convenience
                    the date that Mr. Paradis left Porto Rico and how long he has resided in
                    Haiti.</p>
                <closer><signed><hi rendition="#small-caps">W. F. Powell.</hi></signed></closer>
            </div>
        </body>
