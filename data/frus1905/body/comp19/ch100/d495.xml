    <text>
        <body>
            <div xml:id="d495">

                <pb facs="0665" n="545" sameAs="frus:frus1905/pg545"/>

                <head><hi rendition="#italic">Chargé Terres to the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">Port au
                                Prince</hi></placeName>, <date calendar="gregorian"
                            when="1905-06-28"><hi rendition="#italic">June 28,
                        1905</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1823.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith the
                    passport of Mr. Jose R. Paradis, who, on being informed of the decision of the
                    Department relative to his claim, handed same to our consular agent, and which
                    he has forwarded to this legation.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John B. Terres.</hi></signed></closer>
            </div>
        </body>
    </text>
