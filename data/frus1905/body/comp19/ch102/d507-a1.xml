    <text>
        <body>
            <div xml:id="d507-a1">

                <pb facs="0672" n="552" xml:id="pg552"/>

                <opener><seg rendition="#center">[Inclosure 1.]</seg></opener>
                <head><hi rendition="#italic">Minister Powell to
                        the Minister of Foreign Relations.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">Port au
                                Prince</hi></placeName>, <date calendar="gregorian"
                            when="1905-06-10"><hi rendition="#italic">June 10,
                        1905</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inform your excellency
                    that Mr. Charles Cameau, a resident of this city and one of your citizens, has
                    received asylum at our legation.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. F. Powell.</hi></signed></closer>
            </div>
        </body>
