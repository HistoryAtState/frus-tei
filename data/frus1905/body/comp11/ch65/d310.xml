    <text>
        <body>
            <div xml:id="d310">

                <pb facs="0416" n="296" xml:id="pg296"/>

                <head><hi rendition="#italic">President Roosevelt to the King Elect of
                    Norway.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1905-11-20"><hi rendition="#italic">November 20,
                        1905</hi></date>.</dateline></opener>
                <p>I felicitate Your Majesty on being chosen by the Norwegian people to succeed to
                    the throne of Haakon and Olaf—of Harold and S gurd.</p>
                <closer><signed><hi rendition="#small-caps">Theodore
                    Roosevelt.</hi></signed></closer>
            </div>
        </body>
    </text>
