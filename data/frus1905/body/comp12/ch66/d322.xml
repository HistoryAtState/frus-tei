    <text>
        <body>
            <div xml:id="d322">

                <pb facs="0436" n="316" sameAs="frus:frus1905/pg316"/>

                <head><hi rendition="#italic">Minister Dawson to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">Santo
                                Domingo</hi></placeName>, <date calendar="gregorian"
                            when="1905-02-07"><hi rendition="#italic">February 7,
                        1905</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 109.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I herewith inclose originals in English and
                    in Spanish of the protocol between the American and the Dominican Governments
                    signed by me in virtue of the full powers telegraphed on February 6 by the
                    President of the United States to the President of the Dominican Republic.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. C. Dawson.</hi></signed></closer>
            </div>
        </body>
