                <pb facs="0143" n="23" sameAs="frus:frus1905/pg23"/>

                <head><hi rendition="#italic">The President of Salvador
                        to President Roosevelt.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >San Salvador</hi></placeName>, <date calendar="gregorian"
                            when="1905-07-03"><hi rendition="#italic">July 3,
                        1905</hi></date>.</dateline></opener>
                <p>I deplore the death of Secretary Hay.</p>
                <closer><signed><hi rendition="#small-caps">Escalon.</hi></signed></closer>
            </div>
