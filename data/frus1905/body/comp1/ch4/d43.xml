    <text>
        <body>
            <div xml:id="d43">

                <pb facs="0138" n="18" sameAs="frus:frus1905/pg18"/>

                <head><hi rendition="#italic">The Korean Chargé to the Acting Secretary of
                        State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of Korea</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1905-07-05"><hi rendition="#italic">July 5,
                        1905</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I am directed by the minister of foreign
                    affairs to express, on behalf of His Majesty the Emperor and the Government of
                    Korea, the warmest sympathy and condolence with the United States on the death
                    of Hon. John Hay, Secretary of State.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Yun Chung Kim.</hi></signed></closer>
            </div>
        </body>
    </text>
