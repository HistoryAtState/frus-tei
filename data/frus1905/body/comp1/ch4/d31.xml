    <text>
        <body>
            <div xml:id="d31">

                <pb facs="0133" n="13" xml:id="pg13"/>

                <head><hi rendition="#italic">The President of the French Republic to President
                        Roosevelt.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1905-07-02"><hi rendition="#italic">July 2,
                        1905</hi></date>.</dateline></opener>
                <p>Being very deeply affected by the death of the eminent statesman whom your
                    excellency has just lost, I wish to express to you the sincere condolences of
                    the Government of the French Republic.</p>
                <closer><signed><hi rendition="#small-caps">Emile Loubet.</hi></signed></closer>
            </div>
        </body>
    </text>
