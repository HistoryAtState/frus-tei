                <pb facs="0132" n="12" sameAs="frus:frus1905/pg12"/>

                <head><hi rendition="#italic">The President of the Dominican Republic to President
                        Roosevelt.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >San Domingo</hi></placeName>, <date calendar="gregorian"
                            when="1905-07-01"><hi rendition="#italic">July 1,
                        1905</hi></date>.</dateline></opener>
                <p>Accept sympathies for death Secretary Hay.</p>
                <closer><signed><hi rendition="#small-caps">President
                    Morales.</hi></signed></closer>
            </div>
        </body>
