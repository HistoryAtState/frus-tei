    <text>
        <body>
            <div xml:id="d45">

                <pb facs="0139" n="19" sameAs="frus:frus1905/pg19"/>

                <head><hi rendition="#italic">Chargé Garrett to the Acting Secretary of
                    State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">The Hague, The
                                Netherlands</hi></placeName>, <date calendar="gregorian"
                            when="1905-07-07"><hi rendition="#italic">July 7,
                        1905</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 31. Luxemburg Series.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>:</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I have the honor to inclose herewith a copy of the telegrams which have passed
                    between this legation and the Luxemburg Government in regard to the death of
                    Secretary Hay.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John W. Garrett.</hi></signed></closer>


                <xi:include href="d45-a1.xml" xpointer="d45-a1"/>
            </div>
