    <text>
        <body>
            <div xml:id="d51">

                <pb facs="0141" n="21" sameAs="frus:frus1905/pg21"/>

                <head><hi rendition="#italic">The President of Panama to President
                    Roosevelt.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Panama</hi></placeName>, <date calendar="gregorian"
                            when="1905-07-01"><hi rendition="#italic">July 1,
                        1905</hi></date>.</dateline></opener>
                <p>The Government and people of Panama participate in the sorrow of the Government
                    and people of the United States at the death of their eminent Secretary of
                    State, Mr. John Hay.</p>
                <closer><signed><hi rendition="#small-caps">M. Amador
                    Guerrero.</hi></signed></closer>
            </div>
        </body>
    </text>
