    <text>
        <body>
            <div xml:id="d13">

                <pb facs="0126" n="6" sameAs="frus:frus1905/pg6"/>

                <head><hi rendition="#italic">The Acting Secretary of State to the Diplomatic and
                        Consular Officers of the United States.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1905-07-03"><hi rendition="#italic">July 3,
                        1905</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Gentlemen</hi>: I append a copy of the proclamation
                    of the President concering the death of the Hon. John Hay, Secretary of
                    State.</p>
                <p>In obedience to this proclamation, and as a mark of respect to the memory of the
                    deceased statesman, and in tribute to his distinguished services, you will cause
                    the flag of the United States to be displayed at half-mast over your respective
                    offices for a period of ten days.</p>
                <p>I am, etc.</p>
                <closer><signed><hi rendition="#small-caps">Herbert H. D.
                    Peirce.</hi></signed></closer>



                <xi:include href="d13-a1.xml" xpointer="d13-a1"/>
