    <text>
        <body>
            <div xml:id="d62">

                <pb facs="0144" n="24" sameAs="frus:frus1905/pg24"/>

                <head><hi rendition="#italic">Minister Graves to the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Stockholm</hi></placeName>, <date calendar="gregorian"
                            when="1905-07-08"><hi rendition="#italic">July 8,
                        1905</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 18.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith a
                    letter of the minister for foreign affairs, expressing the condolence of the
                    Government of Sweden and Norway at the decease of Mr. Hay.</p>
                <p>I have the honor to be, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charles H.
                    Graves.</hi></signed></closer>


                <xi:include href="d62-a1.xml" xpointer="d62-a1"/>
