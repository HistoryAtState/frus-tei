    <text>
        <body>
            <div xml:id="d67">

                <pb facs="0146" n="26" sameAs="frus:frus1905/pg26"/>

                <head><hi rendition="#italic">The Secretary of State to
                        the Diplomatic and Consular Officers of the United
                            States.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1905-07-19"><hi rendition="#italic">July 19,
                        1905</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Gentlemen</hi>: I have to inform you that the
                    President has appointed me to be Secretary of State of the United States, and
                    that I have this day entered upon the duties of the office.</p>
                <p>I am, gentlemen, your most obedient servant,</p>
                <closer><signed><hi rendition="#small-caps">Elihu Root.</hi></signed></closer>
            </div>
        </body>
    </text>
