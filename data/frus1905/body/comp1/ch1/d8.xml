    <text>
        <body>
            <div xml:id="d8">

                <pb facs="0124" n="4" sameAs="frus:frus1905/pg4"/>

                <head><hi rendition="#italic">Minister Bryan to the
                            Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">Lisbon,
                                Portugal</hi></placeName>, <date calendar="gregorian"
                            when="1905-02-21"><hi rendition="#italic">February 21,
                        1905</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 129.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to confirm my cipher
                    dispatch of February the 18th, in reply to Department’s telegram of the 13th
                    instant.</p>
                <p>I inclose a copy of a note on this subject from the minister for foreign
                    affaris.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charles Page
                    Bryan.</hi></signed></closer>


                <xi:include href="d8-a1.xml" xpointer="d8-a1"/>
