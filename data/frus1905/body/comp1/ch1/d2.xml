    <text>
        <body>
            <div xml:id="d2">

                <pb facs="0121" n="1" sameAs="frus:frus1905/pg1"/>

                <head><hi rendition="#italic">Ambassador Storer to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Vienna</hi></placeName>, <date calendar="gregorian" when="1905-01-24"
                                ><hi rendition="#italic">January 24, 1905</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 208.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to report that I have this
                    morning received the written answer of the Austro-Hungarian Government from the
                    ministry of foreign affairs to the expressions of views and intentions of <pb
                        facs="0122" n="2" xml:id="pg2"/> the American Government regarding the
                    integrity of China, which was received by telegram of 13th of January, 1905, and
                    has been already acknowledged.</p>
                <p>I beg to inclose a copy and a translation of this note of the ministry of foreign
                    affairs.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Bellamy Storer.</hi></signed></closer>


                <xi:include href="d2-a1.xml" xpointer="d2-a1"/>
            </div>
        </body>
    </text>
