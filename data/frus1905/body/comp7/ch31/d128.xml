                <pb facs="0224" n="104" sameAs="frus:frus1905/pg104"/>

                <head><hi rendition="#italic">Chargé Ames to the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Santiago</hi></placeName>, <date calendar="gregorian" when="1905-03-28"
                                ><hi rendition="#italic">March 28, 1905</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 427.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a copy
                    and translation of the Chile-Bolivia treaty. * * *</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Edward Winslow
                    Ames.</hi></signed></closer>


                <xi:include href="d128-a1.xml" xpointer="d128-a1"/>
