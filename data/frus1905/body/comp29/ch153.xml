            <div xml:id="ch153">

                <pb facs="0833" n="713" xml:id="pg713"/>

                <head>Treaty between the United States and Panama for the mutual extradition of
                    criminals</head>
                <p><hi rendition="#italic">Signed at the City of Panama, May 25, 1904.</hi></p>
                <p><hi rendition="#italic">Ratification advised by the Senate, January 6,
                    1905.</hi></p>
                <p><hi rendition="#italic">Ratified by the President, January 20, 1905.</hi></p>
                <p><hi rendition="#italic">Ratified by Panama, May 25, 1904.</hi></p>
                <p><hi rendition="#italic">Ratifications exchanged at City of Panama, April 8,
                        1905.</hi></p>
                <p><hi rendition="#italic">Proclaimed, May 12, 1905.</hi></p>

                <xi:include href="ch153/d725.xml" xpointer="d725"/>
