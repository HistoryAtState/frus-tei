    <text>
        <body>
            <div xml:id="d721">

                <pb facs="0828" n="708" sameAs="frus:frus1905/pg708"/>

                <head><hi rendition="#italic">Minister Barrett to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Panama</hi></placeName>, <date calendar="gregorian" when="1905-04-17"
                                ><hi rendition="#italic">April 17, 1905</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 131.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to recent correspondence in
                    regard to American diplomatic and consular officers exercising their good
                    offices, when necessary, in behalf of Chinese subjects, I have the honor to
                    inclose a translation <pb facs="0829" n="709" xml:id="pg709"/> of an order just
                    issued by the Panama Government and communicated to me by the foreign
                    office.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Barrett.</hi></signed></closer>


                <xi:include href="d721-a1.xml" xpointer="d721-a1"/>
            </div>
