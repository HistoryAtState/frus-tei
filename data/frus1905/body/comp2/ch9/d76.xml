    <text>
        <body>
            <div xml:id="d76">

                <pb facs="0150" n="30" sameAs="frus:frus1905/pg30"/>

                <head><hi rendition="#italic">The Acting Secretary of State to Minister
                        Beaupré.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1905-04-26"><hi rendition="#italic">April 26,
                        1905</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: The Department has read with pleasure the
                    announcement contained in your dispatch No. 136, of the 16th ultimo, of the
                    resumption of diplomatic relations between the Argentine Republic and
                    Uruguay.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alvey A. Adee.</hi></signed></closer>
            </div>
        </body>
    </text>
