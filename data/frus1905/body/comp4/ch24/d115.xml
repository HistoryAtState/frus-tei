    <text>
        <body>
            <div xml:id="d115">

                <pb facs="0198" n="78" sameAs="frus:frus1905/pg78"/>

                <head><hi rendition="#italic">The Belgian Chargé to Acting Secretary of State
                        Loomis.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Belgian Legation</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1905-06-07"><hi rendition="#italic">June 7,
                        1905</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: The Belgian legation has
                    just received the text of the exposition of the motives accompanying the
                    proposed law submitted to the Belgian chambers for the approval of the
                    obligatory treaties of arbitration concluded between Belgium and other
                    governments.</p>
                <p>I hasten to place one copy of the same at your disposal.</p>
                <p>Please accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">E. Havenith.</hi></signed></closer>










