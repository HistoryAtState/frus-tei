                <pb facs="0191" n="71" sameAs="frus:frus1905/pg71"/>

                <head><hi rendition="#italic">Minister Townsend to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Brussels</hi></placeName>, <date calendar="gregorian" when="1905-03-16"
                                ><hi rendition="#italic">March 16, 1905</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 253.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of Department’s cable of yesterday’s date. * * *</p>
                <p>In conformity with instructions, I have signed the protocol of the International
                    Maritime Conference held at Brussels, February 25 last. * * *</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Lawrence
                    Townsend.</hi></signed></closer>
            </div>
        </body>
