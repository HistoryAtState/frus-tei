    <text>
        <body>
            <div xml:id="d111">

                <pb facs="0193" n="73" xml:id="pg73"/>

                <head><hi rendition="#italic">The Secretary of State to Minister Wilson</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1905-10-27"><hi rendition="#italic">October 27,
                        1905</hi></date>.</dateline></opener>
                <p>You may sign protocol of Maritime Conference similar to that of February 25, last
                    signed by Mr. Townsend.</p>
                <closer><signed><hi rendition="#small-caps">Root.</hi></signed></closer>
            </div>
        </body>
