    <text>
        <body>
            <div xml:id="d107-a1">

                <pb facs="0190" n="70" sameAs="frus:frus1905/pg70"/>

                <opener><seg rendition="#center">[Inclosure.]</seg></opener>
                <head><hi rendition="#italic">International Conference on Maritime Law.</hi></head>
                <p rendition="#center"><hi rendition="#small-caps">protocol.</hi></p>
                <p>The undersigned delegates, convinced of the great advantages which from every
                    point of view would result from a uniform law on maritime collisions and
                    assistance, and certifying to the favorable dispositions shown in the premises
                    by all the members of the conference during the course of its labors,
                    unanimously agree: <list>
                        <label>1.</label>
                        <item>To submit to their respective governments, with a view to examination,
                            the annexed projects<anchor n="a" xml:id="d107-f1"/> prepared by the
                            conference.</item>
                        <label>2.</label>
                        <item>To suspend the deliberations of the conference and to adjourn them to
                            a date to be proposed by the Belgian Government.</item>
                    </list>
                </p>
                <closer><dateline rendition="#float-left">Done at <placeName>Brussels</placeName>,
                            <date calendar="gregorian" when="1905-02-25">February 25,
                        1905</date>.</dateline>
                    <lb/>
                    <signed>(The signatures follow.)</signed></closer>
            </div>
        </body>
    </text>
