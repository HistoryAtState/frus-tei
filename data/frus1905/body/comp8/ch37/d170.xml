    <text>
        <body>
            <div xml:id="d170">

                <pb facs="0258" n="138" sameAs="frus:frus1905/pg138"/>

                <head><hi rendition="#italic">Chargé Coolidge to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Peking</hi></placeName>, <date calendar="gregorian" when="1905-03-09"
                                ><hi rendition="#italic">March 9,
                    1905</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of Department instruction of January 24<anchor n="b" xml:id="d170-f1"/>
                    inclosing copies of a print of a recent correspondence between the Russian
                    ambassador at Washington and the Secretary of State, as well as the instructions
                    sent to the American minister at Peking regarding the observance of neutrality
                    by China and the reply of the Chinese Government.</p>
                <p>In compliance, this correspondence has been communicated to the Government of
                    China, as shown by the inclosures herewith.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Gardner
                    Coolidge.</hi></signed></closer>




                <xi:include href="d170-a1.xml" xpointer="d170-a1"/>
                <xi:include href="d170-a2.xml" xpointer="d170-a2"/>
            </div>
        </body>
    </text>
