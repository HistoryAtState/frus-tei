    <text>
        <body>
            <div xml:id="d194">

                <pb facs="0284" n="164" sameAs="frus:frus1905/pg164"/>

                <head><hi rendition="#italic">Minister Rockhill to the Secretary of
                    State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Peking</hi></placeName>, <date calendar="gregorian" when="1905-11-10"
                                ><hi rendition="#italic">November 10, 1905</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 147.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit to you
                    herewith in translation copy of an imperial rescript sanctioning the opening of
                    Hai Chou in the Province of Kiang-su to international trade.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. W. Rockhill.</hi></signed></closer>


                <xi:include href="d194-a1.xml" xpointer="d194-a1"/>
            </div>
