    <text>
        <body>
            <div xml:id="d208">

                <pb facs="0298" n="178" sameAs="frus:frus1905/pg178"/>

                <head><hi rendition="#italic">Minister Rockhill to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Peking</hi></placeName>, <date calendar="gregorian" when="1905-07-19"
                                ><hi rendition="#italic">July 19, 1905</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 34.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith for
                    your information an imperial edict published in the Peking Gazette of July 16,
                    by which four high officials are directed to visit foreign countries to study
                    methods of government and report on the reforms needed in China.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. W. Rockhill.</hi></signed></closer>



                <xi:include href="d208-a1.xml" xpointer="d208-a1"/>
