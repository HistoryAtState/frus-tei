    <text>
        <body>
            <div xml:id="d185-a1">

                <pb facs="0274" n="154" sameAs="frus:frus1905/pg154"/>

                <opener><seg rendition="#center">[Inclosure 1.]</seg></opener>
                <head><hi rendition="#italic">Minister Rockhill to
                            Prince Ch’ing.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Peking</hi></placeName>, <date calendar="gregorian" when="1905-07-02"
                                ><hi rendition="#italic">July 2,
                    1905</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Your Imperial Highness</hi>: I have the honor to
                    acknowledge the receipt of your note of to-day, in which your imperial highness
                    presents a new.proposition for the settlement of the question of the indemnity
                    stipulated in the final protocol of September 7, 1901.</p>
                <pb facs="0275" n="155" xml:id="pg155"/>
                <p>In reply I have the honor to announce that I accept in the name of my government
                    the new form of settlement proposed by China and accepted by the other
                    governments concerned.</p>
                <p>I avail, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. W. Rockhill.</hi></signed></closer>
            </div>
        </body>
    </text>
