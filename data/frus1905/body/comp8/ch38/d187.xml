    <text>
        <body>
            <div xml:id="d187">

                <pb facs="0276" n="156" xml:id="pg156"/>

                <head><hi rendition="#italic">Minister Rockhill to the Secretary of
                    State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Peking</hi></placeName>, <date calendar="gregorian" when="1905-10-04"
                                ><hi rendition="#italic">October 4, 1905</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 113.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my dispatch, No. 35, of July
                    25, with regard to the new indemnity arrangement, I have now the honor to
                    inclose a more carefully prepared translation of the note to the Prince of
                    Ch’ing, by which, with our concurrence, the new system was established.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. W. Rockhill.</hi></signed></closer>


                <xi:include href="d187-a1.xml" xpointer="d187-a1"/>
            </div>
