    <text>
        <body>
            <div xml:id="d184">

                <pb facs="0273" n="153" sameAs="frus:frus1905/pg153"/>

                <head><hi rendition="#italic">The Acting Secretary of
                            State to Minister Rockhill.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1905-05-31"><hi rendition="#italic">May 31,
                        1905</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 8.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of Mr.
                    Coolidge’s telegram of the 22d of April last.</p>
                <p>In reply I inclose herewith for your information a copy of a letter from the
                    Secretary of the Treasury expressing his views in the matter.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Francis B.
                    Loomis.</hi></signed></closer>


                <xi:include href="d184-a1.xml" xpointer="d184-a1"/>
