    <text>
        <body>
            <div xml:id="d146">

                <pb facs="0242" n="122" sameAs="frus:frus1905/pg122"/>

                <head><hi rendition="#italic">Minister Rockhill to the Secretary of
                    State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Peking</hi></placeName>, <date calendar="gregorian" when="1905-10-12"
                                ><hi rendition="#italic">October 12, 1905</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 122.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith an
                    English translation of the new agreement entered into by the powers signatories
                    of the final protocol of September 7, 1901, with the Chinese Government for the
                    conservancy of the Whangpu River.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. W. Rockhill.</hi></signed></closer>


                <xi:include href="d146-a1.xml" xpointer="d146-a1"/>
            </div>
