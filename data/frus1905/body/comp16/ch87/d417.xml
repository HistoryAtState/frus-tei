    <text>
        <body>
            <div xml:id="d417">

                <pb facs="0607" n="487" sameAs="frus:frus1905/pg487"/>

                <head><hi rendition="#italic">Ambassador Reid to the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >London</hi></placeName>, <date calendar="gregorian" when="1905-09-28"
                                ><hi rendition="#italic">September 28, 1905</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 55.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a
                    Parliamentary publication, Japan No. 2, 1905, containing a dispatch to His
                    Majesty’s ambassador at St. Petersburg forwarding a copy of the agreement
                    between the United Kingdom and Japan, signed in London August 12, 1905.</p>
                <p>I have, etc.,</p>
                <p>For the ambassador.</p>
                <closer><signed><hi rendition="#small-caps">J. R. Carter.</hi></signed></closer>



                <xi:include href="d417-a1.xml" xpointer="d417-a1"/>
