    <text>
        <body>
            <div xml:id="d400">

                <pb facs="0593" n="473" sameAs="frus:frus1905/pg473"/>

                <head><hi rendition="#italic">Ambassador Choate to the Secretary of
                    State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >London</hi></placeName>, <date calendar="gregorian" when="1905-03-01"
                                ><hi rendition="#italic">March 1, 1905</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1539.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith as of
                    interest two copies of a parliamentary publication (Russia No. 3, 1905)
                    containing the dispatch from the British agent, forwarding the report of the
                    commissioners in the International Commission of Inquiry into the North Sea
                    Incident.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Joseph H. Choate.</hi></signed></closer>


                <xi:include href="d400-a1.xml" xpointer="d400-a1"/>
            </div>
