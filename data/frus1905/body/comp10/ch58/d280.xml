    <text>
        <body>
            <div xml:id="d280">

                <pb facs="0391" n="271" sameAs="frus:frus1905/pg271"/>

                <head><hi rendition="#italic">Minister Squiers to the Secretary of
                    State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">Habana,
                                Cuba</hi></placeName>, <date calendar="gregorian" when="1905-04-15"
                                ><hi rendition="#italic">April 15, 1905</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1228.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to Department instructions No.
                    481, of March 10, 1905, regarding contract for sewering and paving Habana, I
                    have the honor to say that in accordance with such instructions the matter was
                    immediately brought to the attention of the Cuban Government.</p>
                <p>Copy of my note and translation of Cuban Government’s reply are inclosed
                    herewith. * * *</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">H. G. Squiers.</hi></signed></closer>



                <xi:include href="d280-a1.xml" xpointer="d280-a1"/>
