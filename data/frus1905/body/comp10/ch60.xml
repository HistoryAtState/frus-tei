    <text>
        <body>
            <div xml:id="ch60">

                <pb facs="0400" n="280" sameAs="frus:frus1905/pg280"/>

                <head>Treaty between the United States and Cuba for the mutual extradition of
                    fugitives from justice</head>
                <p><hi rendition="#italic">Signed at Washington, April 6, 1904.</hi></p>
                <p><hi rendition="#italic">Ratification advised by the Senate, April 26,
                    1904.</hi></p>
                <p><hi rendition="#italic">Ratified by the President, January 24, 1905.</hi></p>
                <p><hi rendition="#italic">Ratified by Cuba, January 16, 1905.</hi></p>
                <p><hi rendition="#italic">Ratifications exchanged at Washington, January 31,
                        1905.</hi></p>
                <p><hi rendition="#italic">Proclaimed, February 8, 1905.</hi></p>

                <xi:include href="ch60/d295.xml" xpointer="d295"/>
