    <text>
        <body>
            <div xml:id="d969">

                <pb facs="0992" n="872" xml:id="pg872"/>

                <head><hi rendition="#italic">The Norwegian Chargé to the
                            Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of Norway</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1905-11-18"><hi rendition="#italic">November 18,
                        1905</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: At the request of my government I have the
                    honor to inform your excellency that to-day Prince Carl of Denmark was
                    unanimously elected King of Norway by the Storthing.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Ch. Hauge.</hi></signed></closer>
            </div>
        </body>
    </text>
