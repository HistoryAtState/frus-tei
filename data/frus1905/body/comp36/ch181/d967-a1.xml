    <text>
        <body>
            <div xml:id="d967-a1">

                <pb facs="0991" n="871" sameAs="frus:frus1905/pg871"/>

                <opener><seg rendition="#center">[Inclosure.]</seg></opener>
                <head><hi rendition="#italic">Minister Graves to
                        the Minister for Foreign Affairs of
                    Norway.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Stockholm</hi></placeName>, <date calendar="gregorian"
                            when="1905-11-14"><hi rendition="#italic">November 14,
                        1905</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I am directed by the President of
                    the United States to continue to exercise the functions of my office as envoy
                    extraordinary and minister plenipotentiary to the Government of Norway
                    separately, and have the honor to notify your excellency of my readiness to
                    transact with yourself any necessary diplomatic business. I respectfully request
                    the honor of calling upon you to pay my respects at such time as may be
                    convenient and agreeable to your excellency.</p>
                <p>I avail, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charles H.
                    Graves.</hi></signed></closer>
            </div>
        </body>
