    <text>
        <body>
            <div xml:id="d967">

                <pb facs="0991" n="871" sameAs="frus:frus1905/pg871"/>

                <head><hi rendition="#italic">Minister Graves to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Stockholm</hi></placeName>, <date calendar="gregorian"
                            when="1905-11-14"><hi rendition="#italic">November 14,
                        1905</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 35.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    this day of a cable telegram from yourself of the following wording:<anchor
                        n="a" xml:id="d967-f1"/></p>
                <p>I have the honor to report that I have this day addressed to the minister for
                    foreign affairs at Christiania, Norway, a note, of which the inclosed is a
                    copy.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charles H.
                    Graves.</hi></signed></closer>


                <xi:include href="d967-a1.xml" xpointer="d967-a1"/>
            </div>
        </body>
    </text>
