    <text>
        <body>
            <div xml:id="ch180">

                <pb facs="0972" n="852" sameAs="frus:frus1905/pg852"/>

                <head>Treaty between the United States and Norway amending the extradition treaty of
                    June 7, 1893, between the two countries</head>
                <p><hi rendition="#italic">Signed at Washington, December 10, 1904</hi>.</p>
                <p><hi rendition="#italic">Ratification advised by the Senate, January 6,
                    1905</hi>.</p>
                <p><hi rendition="#italic">Ratified by the President, April 1, 1905</hi>.</p>
                <p><hi rendition="#italic">Ratified by the King, February 3, 1905</hi>.</p>
                <p><hi rendition="#italic">Ratifications exchanged at Washington, April 4,
                    1905</hi>.</p>
                <p><hi rendition="#italic">Proclaimed April 6, 1905</hi>.</p>

                <xi:include href="ch180/d941.xml" xpointer="d941"/>
