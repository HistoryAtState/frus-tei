    <text>
        <body>
            <div xml:id="d776">

                <pb facs="0875" n="755" sameAs="frus:frus1905/pg755"/>

                <head><hi rendition="#italic">The Acting Secretary of State to the Russian
                        Ambassador.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1906-01-11"><hi rendition="#italic">January 11,
                        1906</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My dear Mr. Ambassador</hi>: In reply to the
                    memorandum which your excellency handed to me on the 28th ultimo, I beg to
                    inclose <pb facs="0876" n="756" xml:id="pg756"/> herewith a list of the laws of
                    the United States and the treaties concluded with foreign countries bearing upon
                    the following subjects: <list>
                        <label>1.</label>
                        <item>The rights of belligerents toward each other.</item>
                        <label>2.</label>
                        <item>The rights and duties of neutrals in time of maritime war.</item>
                    </list></p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alvey A. Adee.</hi></signed></closer>


                <xi:include href="d776-a1.xml" xpointer="d776-a1"/>
            </div>
        </body>
    </text>
