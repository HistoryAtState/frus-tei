    <text>
        <body>
            <div xml:id="d839">

                <pb facs="0912" n="792" xml:id="pg792"/>

                <head><hi rendition="#italic">The Acting Secretary of State to Ambassador
                        Meyer.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1905-07-25"><hi rendition="#italic">July 25,
                        1905</hi></date>.</dateline></opener>
                <p>Your telegram 18th instant. Berlinsky permitted to delay departure for America
                    thirty days, pending Japan’s acquiescence in his replacement by Captain
                    Ginter.</p>
                <closer><signed><hi rendition="#small-caps">Adee.</hi></signed></closer>
            </div>
        </body>
    </text>
