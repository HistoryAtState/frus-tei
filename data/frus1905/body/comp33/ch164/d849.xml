    <text>
        <body>
            <div xml:id="d849">

                <pb facs="0914" n="794" sameAs="frus:frus1905/pg794"/>

                <head><hi rendition="#italic">The Secretary of State to the Russian
                    Ambassador.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1905-10-30"><hi rendition="#italic">October 30,
                        1905</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Ambassador</hi>: I beg to inform you that
                    the Secretary of the Navy had advised me that on the 26th instant he received a
                    telegram from the commandant of the navy-yard at Mare Island, Cal., in which he
                    stated that the <hi rendition="#italic">Lena</hi> left the yard for San
                    Francisco on that date, and would sail thence on Sunday, October 29.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Elihu Root.</hi></signed></closer>
            </div>
        </body>
    </text>
