            <div xml:id="d771-a1">

                <pb facs="0873" n="753" sameAs="frus:frus1905/pg753"/>

                <opener><seg rendition="#center">[Inclosure 1.—Translation.]</seg></opener>
                <head><hi rendition="#italic">Decision of the admiralty court, November 20, 1904,
                        steamer Tea.</hi></head>
                <list>
                    <label>1.</label>
                    <item>The steamer <hi rendition="#italic">Tea</hi> was not subject to arrest and
                        confiscation.</item>
                    <label>2.</label>
                    <item>The decision of the Vladivostok court relating to the arrest and
                        confiscation of the steamer <hi rendition="#italic">Tea</hi> to be
                        reversed.</item>
                    <label>3.</label>
                    <item>The decision of the prize court as refers to the cargo to remain in force,
                        as appeal was not taken.</item>
                </list>
            </div>
        </body>
    </text>
