        <body>
            <div xml:id="d892">

                <pb facs="0935" n="815" sameAs="frus:frus1905/pg815"/>

                <head><hi rendition="#italic">Ambassador Meyer to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic">St.
                                Petersburg</hi></placeName>, <date calendar="gregorian"
                            when="1905-07-01"><hi rendition="#italic">July 1,
                        1905</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 99.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I beg leave to inclose a letter from the
                    ministry for foreign affairs dated June 30, with translation of the same. This
                    communication was received to-day. I immediately cabled the contents to the
                    Department and am now inclosing translation of the cable.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">G. v. L. Meyer.</hi></signed></closer>


                <xi:include href="d892-a1.xml" xpointer="d892-a1"/>
