    <text>
        <body>
            <div xml:id="d915">

                <pb facs="0944" n="824" sameAs="frus:frus1905/pg824"/>

                <head><hi rendition="#italic">Ambassador Meyer to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic">St
                                Petersburg</hi></placeName>, <date calendar="gregorian"
                            when="1905-12-13"><hi rendition="#italic">December 13,
                        1905</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 341.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In conformity with the Department’s cable
                    instructions of October 16 and 23, I have the honor to forward herewith twelve
                    copies of the treaty of peace, concluded between Russia and Japan on the 5th of
                    September, 1905, at Portsmouth.</p>
                <p>In this connection I cabled the Department to-day as follows: <quote
                        rend="blockquote">
                        <p>Am forwarding to-day to Department twelve copies Portsmouth Treaty.</p>
                    </quote></p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">G. v. L. Meyer.</hi></signed></closer>


                <xi:include href="d915-a1.xml" xpointer="d915-a1"/>
            </div>
