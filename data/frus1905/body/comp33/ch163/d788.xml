    <text>
        <body>
            <div xml:id="d788">

                <pb facs="0884" n="764" xml:id="pg764"/>

                <head><hi rendition="#italic">Ambassador McCormick to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic">St.
                                Petersburg</hi></placeName>, <date calendar="gregorian"
                            when="1905-03-04"><hi rendition="#italic">March 4,
                        1905</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith, for
                    the information of the Department, English translations of the manifesto and of
                    the rescript issued by His Majesty the Emperor on yesterday.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Robert S.
                    McCormick.</hi></signed></closer>




