    <text>
        <body>
            <div xml:id="d815">

                <pb facs="0902" n="782" sameAs="frus:frus1905/pg782"/>

                <head><hi rendition="#italic">Chargé Eddy to the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic">St.
                                Petersburg</hi></placeName>, <date calendar="gregorian"
                            when="1905-11-17"><hi rendition="#italic">November 17,
                        1905</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 277.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose to you herewith
                    a translation of an imperial manifesto, which appeared in to-day’s Official
                    Messenger, granting the peasants facilities for the payment of arrears due for
                    land and to purchase more land through the assistance of agrarian banks.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Spencer Eddy.</hi></signed></closer>


                <xi:include href="d815-a1.xml" xpointer="d815-a1"/>
