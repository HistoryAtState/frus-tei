    <text>
        <body>
            <div xml:id="d100">

                <pb facs="0174" n="54" sameAs="frus:frus1905/pg54"/>

                <head><hi rendition="#italic">Chargé Rives to the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Vienna</hi></placeName>, <date calendar="gregorian" when="1905-07-13"
                                ><hi rendition="#italic">July 13, 1905</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 253.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of the Department’s instruction No. 170, bearing date of June 28, 1905, with
                    inclosures, and to say that the Department’s intentions expressed therein, as
                    well as those of the instruction No. 165, of 23d of June, 1905, have been
                    carried out to the best of my judgment.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">George Barclay
                    Rives.</hi></signed></closer>
            </div>
        </body>
    </text>
