    <text>
        <body>
            <div xml:id="d935">

                <pb facs="0966" n="846" sameAs="frus:frus1905/pg846"/>

                <head><hi rendition="#italic">President Roosevelt to the King of Spain.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >The White House</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1905-06-01"><hi rendition="#italic">June 1,
                        1905</hi></date>.</dateline></opener>
                <p>I congratulate Your Majesty upon the providential escape from the wicked attempt
                    upon Your Majesty’s safety and life.</p>
                <closer><signed><hi rendition="#small-caps">Theodore
                    Roosevelt.</hi></signed></closer>
            </div>
        </body>
    </text>
