    <text>
        <body>
            <div xml:id="d1071">

                <pb facs="1099" n="979" sameAs="frus:frus1905/pg979"/>

                <head><hi rendition="#italic">The Secretary of State to
                        Minister Bowen.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1905-02-24"><hi rendition="#italic">February 24,
                        1905</hi></date>.</dateline></opener>
                <p>Would you like—— —? It is the best post now available. Or would you prefer to
                    remain where you are for the present?</p>
                <closer><signed><hi rendition="#small-caps">Hay.</hi></signed></closer>
            </div>
        </body>
    </text>
