    <text>
        <body>
            <div xml:id="d1073">

                <pb facs="1099" n="979" sameAs="frus:frus1905/pg979"/>

                <head><hi rendition="#italic">Acting Secretary of State Adee to Minister
                    Bowen.</hi></head>
                <opener><seg rendition="#center">[Telegram—Paraphrase.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1905-04-29"><hi rendition="#italic">April 29,
                        1905</hi></date>.</dateline></opener>
                <p>(In pursuance of the direction of the President and in accordance with the
                    cablegram of Secretary Taft,<anchor n="a" xml:id="d1073-f1"/> Mr. Adee instructs
                    Mr. Bowen to return to Washington for the purpose mentioned in Secretary Taft’s
                    cablegram.)</p>
            </div>
        </body>
    </text>
