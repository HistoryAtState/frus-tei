                <pb facs="1142" n="1022" xml:id="pg1022"/>

                <head><hi rendition="#italic">Acting Secretary of State Loomis to Minister
                        Bowen.</hi></head>
                <opener><seg rendition="#center">[Telegram.—Paraphrase.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1905-02-02"><hi rendition="#italic">February 2,
                        1905</hi></date>.</dateline></opener>
                <p>(States that the Department is unable to submit to arbitration the question
                    whether cases are or are not diplomatic, but Mr. Bowen may use his discretion
                    about communicating this government’s position to the Venezuelan
                    Government.)</p>
            </div>
        </body>
