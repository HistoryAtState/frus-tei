    <text>
        <body>
            <div xml:id="d1136">

                <pb facs="1157" n="1037" sameAs="frus:frus1905/pg1037"/>

                <head><hi rendition="#italic">Chargé Hutchinson to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Caracas</hi></placeName>, <date calendar="gregorian" when="1905-06-07"
                                ><hi rendition="#italic">June 7, 1905</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 423.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to report that I was
                    present with the ladies and gentlemen of the diplomatic corps at the reading of
                    the message to Congress by General Castro at 4 p.m. on the 1st instant. * *
                    *</p>
                <p>The message—copy and translation inclosed—contains several points of interest to
                    the United States. * * *</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Norman
                    Hutchinson.</hi></signed></closer>


                <xi:include href="d1136-a1.xml" xpointer="d1136-a1"/>
