    <text>
        <body>
            <div xml:id="d126">

                <pb facs="0222" n="102" sameAs="frus:frus1905/pg102"/>

                <head><hi rendition="#italic">Ambassador Thompson
                        to the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Petropolis</hi></placeName>, <date calendar="gregorian"
                            when="1905-05-19"><hi rendition="#italic">May 19,
                        1905</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 36.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: For the information of the Department of
                    State I inclose herewith the text of the boundary treaty between Brazil and
                    Ecuador, the exchange of ratifications of which took place in Petropolis on the
                    16th instant, together with translation of the same.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">D. E. Thompson.</hi></signed></closer>



                <xi:include href="d126-a1.xml" xpointer="d126-a1"/>
