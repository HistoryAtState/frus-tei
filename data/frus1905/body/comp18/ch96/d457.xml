                <pb facs="0639" n="519" sameAs="frus:frus1905/pg519"/>

                <head><hi rendition="#italic">Minister Combs to the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation,<lb/>Guatemala and Honduras</hi>,<lb/><hi
                                rendition="#italic">Guatemala</hi></placeName>, <date
                            calendar="gregorian" when="1905-02-15"><hi rendition="#italic">February
                                15, 1905</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 245.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to submit the remainder of
                    the correspondence between the American consul-general and myself regarding a
                    difference between him and a local judge as to the extent of the rights and
                    duties of his official position.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Leslie Combs.</hi></signed></closer>




