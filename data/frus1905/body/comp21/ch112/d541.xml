    <text>
        <body>
            <div xml:id="d541">

                <pb facs="0701" n="581" sameAs="frus:frus1905/pg581"/>

                <head><hi rendition="#italic">The Secretary of State to
                        the Japanese Minister.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1905-01-18"><hi rendition="#italic">January 18,
                        1905</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. Minister</hi>: Pursuant to my conversation
                    with you this morning, I take pleasure in inclosing a paraphrase of the
                    telegraphic instruction sent on the 17th instant to the American ambassadors at
                    London, Paris, and Berlin, informing them of the Russian protest alleging
                    Chinese violation of neutrality, and of the course pursued by the United
                    States.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>




                <xi:include href="d541-a1.xml" xpointer="d541-a1"/>
