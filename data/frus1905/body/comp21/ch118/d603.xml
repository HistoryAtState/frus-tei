    <text>
        <body>
            <div xml:id="d603">

                <pb facs="0736" n="616" sameAs="frus:frus1905/pg616"/>

                <head><hi rendition="#italic">The Japanese Chargé to the Secretary of
                    State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of Japan</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1905-12-12"><hi rendition="#italic">December 12,
                        1905</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Under instructions from His Majesty’s
                    minister for foreign affairs, I have the honor to announce hereby the withdrawal
                    of the Korean legation at Washington and the Korean consulates in this country,
                    the powers and functions of diplomatic and consular representatives of Korea
                    having already been transferred to the diplomatic and consular representatives
                    of Japan, respectively, accredited to this country in consequence of the
                    agreement concluded between Japan and Korea on November 17, 1905.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Eki Hioki.</hi></signed></closer>
            </div>
        </body>
    </text>
