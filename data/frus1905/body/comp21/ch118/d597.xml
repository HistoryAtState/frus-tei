    <text>
        <body>
            <div xml:id="d597">

                <pb facs="0732" n="612" sameAs="frus:frus1905/pg612"/>

                <head><hi rendition="#italic">The Japanese Minister to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of Japan</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1905-11-23"><hi rendition="#italic">November 23,
                        1905</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 79 B.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Under instructions of His Imperial
                    Majesty’s Government, I have the honor to announce to the United States
                    Government the conclusion of a new agreement between the Governments of Japan
                    and Korea, a copy of which I beg to herewith inclose, together with a copy of
                    the declaration of the Japanese Government regarding it.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">K. Takahira.</hi></signed></closer>



