    <text>
        <body>
            <div xml:id="d539-a2">

                <pb facs="0701" n="581" sameAs="frus:frus1905/pg581"/>

                <head>[Subinclosure.]</head>
                <p>I hereby declare, in view of our occupation of the whole of the Liaotung
                    Peninsula, that the blockade declared on the 1st day of the first month of the
                    thirty-eighth year of Meiji has been raised to-day.</p>
                <closer>
                    <dateline rendition="#float-left">Given <date calendar="japanese-nengō"
                            when="1905-01-07">this 7th day of the first month of the thirty-eighth
                            year of Meiji</date>.</dateline>
                    <lb/>
                    <signed>Admiral <hi rendition="#small-caps">Togo Heihachiro</hi>,<lb/><hi
                            rendition="#italic">Commander in Chief of His Imperial Japanese
                            Majesty’s Combined Fleet.</hi></signed></closer>
            </div>
        </body>
    </text>
