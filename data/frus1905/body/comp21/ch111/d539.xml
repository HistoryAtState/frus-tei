    <text>
        <body>
            <div xml:id="d539">

                <pb facs="0700" n="580" sameAs="frus:frus1905/pg580"/>

                <head><hi rendition="#italic">Minister Griscom to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Tokyo</hi></placeName>, <date calendar="gregorian" when="1905-01-09"
                                ><hi rendition="#italic">January 9, 1905</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 164.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to confirm my telegram of
                    the 7th instant, reporting the raising of the Liaotung Peninsula blockade. * *
                    *</p>
                <p>I have also the honor to inclose herewith a copy of Baron Komura’s note of the
                    7th informing me that the blockade is terminated and transmitting a copy of
                    Admiral Togo’s announcement of the fact.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Lloyd Griscom.</hi></signed></closer>




                <xi:include href="d539-a1.xml" xpointer="d539-a1"/>
