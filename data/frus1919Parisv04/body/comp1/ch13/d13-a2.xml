                    </row>
                    <row>
                        <cell>Rear-Admiral Grassi</cell>
                        <cell>Italy</cell>
                    </row>
                    <row>
                        <cell>Vice-Admiral Takeshita</cell>
                        <cell>Japan.</cell>
                    </row>
                </table>
