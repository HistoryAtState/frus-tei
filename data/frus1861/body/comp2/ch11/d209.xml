    <text>
        <body>
            <div xml:id="d209">

                <pb facs="0314" n="314" sameAs="frus:frus1861/pg314"/>

                <head><hi rendition="#italic">Mr. Seward to Mr. Wood</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 6.]</seg>
                    <dateline rendition="#float-right"><hi rendition="#small-caps">Department of
                            State</hi>,<lb/><placeName><hi rendition="#italic"
                            >Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1861-08-01"><hi rendition="#italic"
                                >August</hi> 1, 1861</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your despatch of the 11th of July last has
                    been received, and the President instructs me to say that the explanation of the
                    views of the Danish government given to you by Mr. Hall, the minister for
                    foreign affairs, is very satisfactory.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer><signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Bradford R. Wood</hi>, Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c., Copenhagen</hi>.</p>
                </postscript>
            </div>
        </body>
    </text>
