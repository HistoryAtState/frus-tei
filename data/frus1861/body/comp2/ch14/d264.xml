    <text>
        <body>
            <div xml:id="d264">

                <pb facs="0384" n="384" sameAs="frus:frus1861/pg384"/>

                <head><hi rendition="#italic">Mr. Seward to Mr.
                            Pike</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 28.]</seg>
                    <dateline rendition="#float-right"><hi rendition="#small-caps">Department of
                            State</hi>,<lb/><placeName><hi rendition="#italic"
                            >Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1861-10-30"><hi rendition="#italic"
                                >October</hi> 30, 1861</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your despatch of October 9 (No. 20) has
                    been received. We wait with much interest the result of your application to the
                    government of the Netherlands for explanations of the hospitalities extended by
                    its colonial authorities to privateers.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer><signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">James S. Pike</hi>, Esq., <hi rendition="#italic"
                            >&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
