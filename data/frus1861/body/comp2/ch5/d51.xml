    <text>
        <body>
            <div xml:id="d51">

                <pb facs="0099" n="99" sameAs="frus:frus1861/pg99"/>

                <head><hi rendition="#italic">Mr. Seward to Mr. Adams</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 16.]</seg>
                    <dateline rendition="#float-right"><hi rendition="#small-caps">Department of
                            State</hi>,<lb/><placeName><hi rendition="#italic"
                            >Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1861-06-08"><hi rendition="#italic"
                                >June</hi> 8, 1861</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I enclose a copy of a note of this date
                    addressed to Lord Lyons, which will dispel any uncertainty which the British
                    government may entertain in regard to our recognition of a rule of international
                    law which they may deem important.</p>
                <p>I am, sir, respectfully, your obedient servant,</p>
                <closer><signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams</hi>, Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d51-a1.xml" xpointer="d51-a1"/>
            </div>
