    <text>
        <body>
            <div xml:id="d174">

                <pb facs="0271" n="271" sameAs="frus:frus1861/pg271"/>

                <head><hi rendition="#italic">Mr. Seward to Mr. Schurz</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 18.]</seg>
                    <dateline rendition="#float-right"><hi rendition="#small-caps">Department of
                            State</hi>,<lb/><placeName><hi rendition="#italic"
                            >Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1861-08-08"><hi rendition="#italic"
                                >August</hi> 8, 1861</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your despatch of July 15 (No. 2) has been
                    received.</p>
                <p>Your conduct in regard to your presentation at court is approved.</p>
                <p>Your speech was discreet in its points and felicitous in expression. The Queen’s
                    reply is entirely satisfactory.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer><signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Carl Schurz</hi>, Esq., <hi rendition="#italic"
                            >&amp;c., &amp;c., &amp;c. Madrid</hi>.</p>
                </postscript>
            </div>
        </body>
