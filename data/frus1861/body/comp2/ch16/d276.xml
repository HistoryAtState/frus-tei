    <text>
        <body>
            <div xml:id="d276">

                <pb facs="0395" n="[395]" sameAs="frus:frus1861/pg395"/>

                <head><hi rendition="#italic">Mr. Angel to Mr. Seward</hi>.</head>
                <note rend="inline" type="source">[Extract.]</note>
                <opener>
                    <seg rendition="#float-left">No. 77.]</seg>
                    <dateline rendition="#float-right"><hi rendition="#small-caps">Legation of the
                            United States</hi>,<lb/><placeName><hi rendition="#italic"
                                >Stockholm</hi>,</placeName>
                        <date calendar="gregorian" when="1861-05-30"><hi rendition="#italic"
                                >May</hi> 30, 1861</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>:</p>
                <p rendition="#center">* * * * * * * * *</p>
                <p>Herewith I beg permission to enclose a copy of my note to Count Manderstrom,
                    minister of foreign affairs, transmitting copies of the President’s
                    proclamations establishing a blockade of the ports in the seceding States, which
                    I hope may meet your approbation.</p>
                <p>I have the honor to be, with great respect, your obedient servant,</p>
                <closer><signed>BENJ. F. ANGEL.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">Wm. H. Seward</hi>,<lb/><hi
                            rendition="#italic">Secretary of State, &amp;c., &amp;c.,
                        &amp;c.</hi></p>
                </postscript>


                <xi:include href="d276-a1.xml" xpointer="d276-a1"/>
            </div>
