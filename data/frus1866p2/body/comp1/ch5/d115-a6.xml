    <text>
        <body>
            <div xml:id="d115-a6">

                <pb facs="0197" n="123" sameAs="frus:frus1866p2/pg123"/>

                <head>[Enclosure F.]</head>
                <opener><dateline rendition="#float-right"><hi rendition="#small-caps">Legation of
                            the United States,</hi>
                        <lb/>
                        <placeName><hi rendition="#italic">Rome,</hi></placeName>
                        <date calendar="gregorian" when="1866-11-12"><hi rendition="#italic"
                                >November</hi> 12, 1866</date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear</hi> Mr. <hi rendition="#small-caps"
                        >Marsh</hi>: I send you one of the photographs of John Surratt, which I
                    received this day from the State Department, which may help to identify the
                    scoundrel if we should be fortunate enough to catch him.</p>
                <p>Very truly yours,</p>
                <closer>
                    <signed>RUFUS KING</signed></closer>
            </div>
        </body>
    </text>
