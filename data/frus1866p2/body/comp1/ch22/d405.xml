    <text>
        <body>
            <div xml:id="d405">

                <pb facs="0571" n="497" sameAs="frus:frus1866p2/pg497"/>

                <head>Mr. Odell to Mr. Seward.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Hawaiian Legation,</hi>
                            <hi rendition="#italic">New York,</hi></placeName>
                        <date calendar="gregorian" when="1866-06-07"><hi rendition="#italic"
                                >June</hi> 7, 1866</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to enclose you a copy of
                    the speech delivered on the 25th of April by his Majesty Kamehameha, at the
                    opening of the Hawaiian legislature.</p>
                <p>I avail myself of this opportunity to renew the assurance of my high
                    consideration.</p>
                <p>I am, sir, your most obedient servant,</p>
                <closer>
                    <signed>S. U. F. ODELL.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi> &amp;<hi
                            rendition="#italic">c</hi>., &amp;<hi rendition="#italic">c</hi>.,
                            &amp;<hi rendition="#italic">c</hi>.</p>
                </postscript>



                <xi:include href="d405-a1.xml" xpointer="d405-a1"/>
