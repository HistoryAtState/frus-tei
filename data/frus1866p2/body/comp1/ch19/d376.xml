    <text>
        <body>
            <div xml:id="d376">

                <pb facs="0546" n="472" sameAs="frus:frus1866p2/pg472"/>

                <head>Mr. Seward to Mr. Prevost.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1866-07-03"><hi rendition="#italic"
                                >July</hi> 3, 1866</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have to acknowledge the receipt of your
                    despatch No. 16, of June 10th last, communicating your action with regard to the
                    instalment due from the government of Ecuador, under the convention of November,
                    1862.</p>
                <p>Your proceedings in the premises are approved, and you will in future be guided
                    by the same instructions which moved your action in this matter.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">L. V. Prevost,</hi> Esq., &amp;<hi
                            rendition="#italic">c</hi>., &amp;<hi rendition="#italic">c</hi>.,
                            &amp;<hi rendition="#italic">c</hi>.</p>
                </postscript>
            </div>
        </body>
    </text>
