    <text>
        <body>
            <div xml:id="d374">

                <pb facs="0545" n="471" sameAs="frus:frus1866p2/pg471"/>

                <head>Mr. Prevost to Mr.
                        Seward.</head>
                <opener>
                    <seg rendition="#float-left">No. 16.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States of
                                America,</hi>
                            <hi rendition="#italic">Guayaquil,</hi></placeName>
                        <date calendar="gregorian" when="1866-06-10"><hi rendition="#italic"
                                >June</hi> 10, 1866</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge the receipt
                    of your excellency’s despatch, dated May 4th, directing me to make a peremptory
                    demand for the immediate payment of the instalment now over-due by the
                    government of Ecuador, under the convention of November, 1862.</p>
                <p>I enclose herewith copy of my note directed to Mr. Bustamente, the minister for
                    foreign affairs, making the demand, marked A.</p>
                <p>I remain, sir, your most obedient servant,</p>
                <closer>
                    <signed>L. V. PREVOST, <hi rendition="#italic">Acting Secretary of
                            Legation.</hi></signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State, Washington, D. C</hi>.</p>
                </postscript>


                <xi:include href="d374-a1.xml" xpointer="d374-a1"/>
            </div>
