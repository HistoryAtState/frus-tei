    <text>
        <body>
            <div xml:id="d382">

                <pb facs="0550" n="476" sameAs="frus:frus1866p2/pg476"/>

                <head>Mr. Coggeshall to Mr. Seward.</head>
                <opener>
                    <seg rendition="#float-left">No. 2.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">United States Legation,</hi>
                            <hi rendition="#italic">Quito</hi></placeName>, <date
                            calendar="gregorian" when="1866-09-18"><hi rendition="#italic"
                                >September</hi> 18, 1866</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to transmit copies of
                    correspondence with the department of exterior relations for the republic of
                    Ecuador, marked A, B, C, D, and E.</p>
                <p>Very respectfully, your obedient servant,</p>
                <closer>
                    <signed>W. T. COGGESHALL.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>








