    <text>
        <body>
            <div xml:id="d245">

                <pb facs="0350" n="276" sameAs="frus:frus1866p2/pg276"/>

                <opener><dateline rendition="#center">[Telegram received at War Department,
                            <placeName>Washington, D. C</placeName>, <date calendar="gregorian"
                            when="1866-12-02">December 2, 1866</date>, from cable, December 2,
                        1866—6.15 p.m.]</dateline></opener>
                <head>Mr. Hale to Mr.
                        Seward.</head>
                <opener>
                    <placeName><hi rendition="#small-caps">Office U. S. Military
                        Telegraph.</hi></placeName></opener>
                <p>To <hi rendition="#small-caps">Seward,</hi>
                    <hi rendition="#italic">Washington :</hi></p>
                <p>Have arrested John Surratt, one of President Lincoln’s assassins. No doubt of
                    identity.</p>
                <closer>
                    <signed>HALE, <hi rendition="#italic">Alexandria.</hi></signed></closer>
            </div>
        </body>
    </text>
