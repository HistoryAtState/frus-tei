    <text>
        <body>
            <div xml:id="d246">

                <pb facs="0350" n="276" sameAs="frus:frus1866p2/pg276"/>

                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <head>Mr. Seward to Mr.
                        Hale.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1866-12-03"><hi rendition="#italic"
                                >December</hi> 3, 1866</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your course in regard to Surratt is
                    approved. Measures will be taken for bringing him to the United States, of which
                    you will be advised.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Hale,</hi> Esq., &amp;<hi
                            rendition="#italic">c, &amp;c, &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
