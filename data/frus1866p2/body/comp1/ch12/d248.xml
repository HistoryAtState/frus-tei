    <text>
        <body>
            <div xml:id="d248">

                <pb facs="0351" n="277" xml:id="pg277"/>

                <head>Mr. Hale to Mr.
                        Seward.</head>
                <opener>
                    <seg rendition="#float-left">No. 68.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Agency and Consulate General of the
                                United States of America,</hi>
                            <hi rendition="#italic">Alexandria, Egypt,</hi></placeName>
                        <date calendar="gregorian" when="1866-12-04"><hi rendition="#italic"
                                >December</hi> 4, 1866</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: On the 29th ultimo John Harrison Surratt
                    was transferred, under a sufficient guard, from the quarantine grounds to the
                    government prison, where he remains in safe confinement.</p>
                <p>He maintains his demeanor of reticence.</p>
                <p>I have the honor to be, sir, very respectfully, your obedient servant,</p>
                <closer>
                    <signed>CHARLES HALE.</signed></closer>
                <postscript>
                    <p>Hon, <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State, Washington, D</hi>. <hi
                            rendition="#italic">C.</hi></p>
                </postscript>
            </div>
        </body>
