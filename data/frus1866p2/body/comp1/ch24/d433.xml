    <text>
        <body>
            <div xml:id="d433">

                <pb facs="0605" n="531" sameAs="frus:frus1866p2/pg531"/>

                <head>Mr. Clay to Mr. Seward.</head>
                <opener>
                    <seg rendition="#float-left">No. 64.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">Tegucigalpa,</hi></placeName>
                        <date calendar="gregorian" when="1866-06-09"><hi rendition="#italic"
                                >June</hi> 9, 1866</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to enclose to you two
                    translated copies of notes addressed by me to the minister of foreign affairs
                    for this republic at Gracias.</p>
                <p>Trusting they will meet your approval, I am, sir, your obedient servant,</p>
                <closer>
                    <signed>THOMAS H. CLAY.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State, Washington, D. C</hi>.</p>
                </postscript>



                <xi:include href="d433-a1.xml" xpointer="d433-a1"/>
