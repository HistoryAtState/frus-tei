    <text>
        <body>
            <div xml:id="d438">

                <pb facs="0611" n="537" sameAs="frus:frus1866p2/pg537"/>

                <head>Mr. Seward to Mr. Rousseau.</head>
                <opener>
                    <seg rendition="#float-left">No. 11.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1866-10-10"><hi rendition="#italic"
                                >October</hi> 10, 1866</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I transmit to you for your further
                    information a copy of a communication received at this department from George
                    Hunnewell, esq., of New Orleans, on the subject of the claim for the loss of the
                    sloop Muhlenberg.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">R. H. Rousseau,</hi> Esq., &amp;<hi
                            rendition="#italic">c</hi>., &amp;<hi rendition="#italic">c</hi>.,
                            &amp;<hi rendition="#italic">c</hi>.</p>
                </postscript>


                <xi:include href="d438-a1.xml" xpointer="d438-a1"/>
