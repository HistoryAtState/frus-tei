    <text>
        <body>
            <div xml:id="d426">

                <pb facs="0601" n="[527]" sameAs="frus:frus1866p2/pg527"/>

                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <head>Mr. Clay to Mr.
                        Seward.</head>
                <opener><seg rendition="#float-left">No. 52.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States at the
                                Republic of Honduras,</hi>
                            <hi rendition="#italic">Tegucigalpa,</hi></placeName>
                        <date calendar="gregorian" when="1865-10-25"><hi rendition="#italic"
                                >October</hi> 25, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> * * * * *</p>
                <p>Your instructions contained in despatch No. 37 shall be implicitly carried out
                    and obeyed, and I herewith enclose to you a note dated the 23d instant,
                    addressed to Don Francisco Cruz, minister of relations, &amp;c.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I have the honor to be, respectfully, your obedient servant,</p>
                <closer>
                    <signed>THOMAS H. CLAY.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State, Washington, D. C</hi>.</p>
                </postscript>


                <xi:include href="d426-a1.xml" xpointer="d426-a1"/>
            </div>
