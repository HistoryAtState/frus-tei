    <text>
        <body>
            <div xml:id="d427">

                <pb facs="0601" n="[527]" sameAs="frus:frus1866p2/pg527"/>

                <head>Mr. Clay to Mr. Seward.</head>
                <opener>
                    <seg rendition="#float-left">No. 54.].</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States at the
                                Republic of Honduras,</hi>
                            <hi rendition="#italic">Tegucigalpa,</hi></placeName>
                        <date calendar="gregorian" when="1865-11-26"><hi rendition="#italic"
                                >November</hi> 26, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I herewith enclose to you a copy of the
                    translation of a note addressed to me by the minister of state of this republic
                    and my answer thereto.</p>
                <p>You will perceive that he uses the words constitutional provisional president,
                    which appear to me to involve an inconsistency. Referring the matter, however,
                    to your better judgment,</p>
                <p>I have the honor to be, respectfully yours,</p>
                <closer>
                    <signed>THOMAS H. CLAY.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State, Washington, D. C</hi>.</p>
                </postscript>




                <xi:include href="d427-a1.xml" xpointer="d427-a1"/>
