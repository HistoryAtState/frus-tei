    <text>
        <body>
            <div xml:id="d430">

                <pb facs="0603" n="529" sameAs="frus:frus1866p2/pg529"/>

                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <head>Mr. Clay to Mr. Seward.</head>
                <opener><seg rendition="#float-left">No. 60.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States at the
                                Republic of Honduras,</hi>
                            <hi rendition="#italic">Tegucigalpa,</hi></placeName>
                        <date calendar="gregorian" when="1866-03-23"><hi rendition="#italic"
                                >March</hi> 23, 1866</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I herewith forward to you my answer to the
                    letter of his Excellency General Medina, sent by extra courier to La Union,
                    informing me of his election to the presidency of this republic, and of his
                    inauguration.</p>
                <p rendition="#center">* * * * * * * *</p>
                <p>I have the honor to be, your most obedient servant,</p>
                <closer>
                    <signed>THOMAS H. CLAY.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>



                <xi:include href="d430-a1.xml" xpointer="d430-a1"/>
            </div>
        </body>
    </text>
