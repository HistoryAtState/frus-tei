    <text>
        <body>
            <div xml:id="d131">

                <pb facs="0211" n="137" xml:id="pg137"/>

                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <head>Mr. Seward to Mr.
                        King.</head>
                <opener><seg rendition="#float-left">No. 40.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1866-07-16"><hi rendition="#italic"
                                >July</hi> 16, 1866</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In further acknowledgment of your despatch
                    of the 23d of June, I have to inform you that I have laid before the Secretary
                    of War the letter which accompanies it, and which was written by Henri de St.
                    Marie on the 21st of June last.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Rufus King,</hi> Esq., <hi rendition="#italic"
                            >&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
