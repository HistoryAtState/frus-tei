    <text>
        <body>
            <div xml:id="d140">

                <pb facs="0219" n="145" sameAs="frus:frus1866p2/pg145"/>

                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <head>Mr. King to Mr. Seward.</head>
                <opener><seg rendition="#float-left">No. 68.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">Rome,</hi></placeName>
                        <date calendar="gregorian" when="1866-11-20"><hi rendition="#italic"
                                >November</hi> 20, 1866</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: * * * * * * * *</p>
                <p>I have received a letter from our consul at Naples, of which I enclose a
                    copy.</p>
                <p>I have telegraphed the information to our consul at Alexandria.</p>
                <p>I am, very respectfully, your obedient servant,</p>
                <closer>
                    <signed>RUFUS KING.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>


                <xi:include href="d140-a1.xml" xpointer="d140-a1"/>
            </div>
