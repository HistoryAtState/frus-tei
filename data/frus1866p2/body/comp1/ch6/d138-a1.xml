    <text>
        <body>
            <div xml:id="d138-a1">

                <pb facs="0216" n="142" sameAs="frus:frus1866p2/pg142"/>

                <head>[Order.]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <date calendar="gregorian" when="1866-11-06"><hi rendition="#small-caps"
                                >November</hi> 6, 1866</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Colonel</hi>: Cause the arrest of the Zouave Watson,
                    and have him conducted, under secure escort, to the military prison at Rome. It
                    is of much importance that this order be executed with exactness.</p>
                <closer>
                    <signed>The general, pro-minister, KANZLER.</signed></closer>
                <postscript>
                    <p>Lieut. Colonel <hi rendition="#small-caps">Allet,</hi>
                        <hi rendition="#italic">Commanding Zouave Battalion, Velletri.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
