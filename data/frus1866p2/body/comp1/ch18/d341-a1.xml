    <text>
        <body>
            <div xml:id="d341-a1">

                <pb facs="0505" n="431" sameAs="frus:frus1866p2/pg431"/>

                <opener><seg rendition="#center">No. 1.</seg></opener>
                <head>[Translation.]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">San José, Costa
                            Rica,</hi></placeName>
                        <date calendar="gregorian" when="1865-11-27"><hi rendition="#italic"
                                >November</hi> 27, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Señor:</hi> The undersigned, North American citizens,
                    having to reside for sometime in this country, beg you to certify to the
                    authenticity of our naturalization papers, which we enclose, and to grant us
                    your protection as such.</p>
                <p>With every consideration,</p>
                <closer>
                    <signed>G. FRANCISCO QUEZADA.</signed>
                    <lb/>
                    <signed>G. JUAN QUEZADA.</signed></closer>
                <postscript>
                    <p>Hon. Señor Don <hi rendition="#small-caps">Carlos N. Riotte,</hi> &amp;<hi
                            rendition="#italic">c</hi>., &amp;<hi rendition="#italic">c</hi>.,
                            &amp;<hi rendition="#italic">c</hi>.</p>
                </postscript>
            </div>
        </body>
