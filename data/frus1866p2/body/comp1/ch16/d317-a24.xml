    <text>
        <body>
            <div xml:id="d317-a24">

                <pb facs="0480" n="406" sameAs="frus:frus1866p2/pg406"/>


                <head>Commodore Rodgers to Mr. Wheelwright.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">United States Ship Vanderbilt,</hi>
                            <hi rendition="#italic">Valparaiso,</hi></placeName>
                        <date calendar="gregorian" when="1866-04-01"><hi rendition="#italic"
                                >April</hi> 1, 1866</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In an official interview which I had this
                    morning with the Spanish admiral, on board the Numancia, he assured me that he
                    had no present intention of re-bombarding the city.</p>
                <p>Upon the strength of his assurance, I feel confident that the people can return
                    in safety to their homes.</p>
                <p>Very respectfully,</p>
                <closer>
                    <signed>JOHN RODGERS, <hi rendition="#italic">Commodore United States
                        Navy.</hi></signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">John Wheelwright,</hi> Esq., <hi
                            rendition="#italic">Valparaiso</hi>.</p>
                </postscript>
            </div>
        </body>
    </text>
