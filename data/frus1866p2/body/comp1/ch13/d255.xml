                <pb facs="0355" n="281" sameAs="frus:frus1866p2/pg281"/>

                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <head>Mr. Kirk to Mr. Seward.</head>
                <opener><seg rendition="#float-left">No. 159.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">Buenos Ayres,</hi></placeName>
                        <date calendar="gregorian" when="1866-05-05"><hi rendition="#italic"
                                >May</hi> 5, 1866</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> * * * * * Enclosed you will please find the
                    protest of the government on the bombardment of Valparaiso.</p>
                <p>I am, your obedient servant,</p>
                <closer>
                    <signed>ROBERT C. KIRK.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State, Washington. D. C.</hi></p>
                </postscript>



                <xi:include href="d255-a1.xml" xpointer="d255-a1"/>
