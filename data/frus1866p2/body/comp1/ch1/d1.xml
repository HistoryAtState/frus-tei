    <text>
        <body>
            <div xml:id="d1">

                <pb facs="0075" n="[1]" sameAs="frus:frus1866p2/pg1"/>

                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <head>Mr. Wright to Mr. Seward.</head>
                <opener>
                    <seg rendition="#float-left">No. 11.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">Berlin,</hi></placeName>
                        <date calendar="gregorian" when="1865-12-13"><hi rendition="#italic"
                                >December</hi> 13, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Enclosed you will find the second note of
                    Baron Thile, written under Count Bismarck’s direction, in reference to the
                    sending of two criminals from Erfurt to the United States. You will find it more
                    satisfactory than the first.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I have the honor to be, most respectfully, your obedient servant,</p>
                <closer>
                    <signed>JOSEPH A. WRIGHT.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>


                <xi:include href="d1-a1.xml" xpointer="d1-a1"/>
            </div>
        </body>
    </text>
