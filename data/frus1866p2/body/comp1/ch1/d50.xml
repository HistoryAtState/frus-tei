    <text>
        <body>
            <div xml:id="d50">

                <pb facs="0124" n="50" sameAs="frus:frus1866p2/pg50"/>

                <head>Mr. Kay to Mr. Seward.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Office of the Mayor of the City of
                                Philadelphia,</hi></placeName>
                        <date calendar="gregorian" when="1866-10-23"><hi rendition="#italic"
                                >October</hi> 23, 1866</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Sir</hi>: I am directed by the mayor to forward
                    the enclosed letter to you.</p>
                <p>Very respectfully,</p>
                <closer>
                    <signed>J. HUTCHINSON KAY, <hi rendition="#italic">Mayor’s
                    Clerk.</hi></signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State.</hi></p>
                </postscript>



                <xi:include href="d50-a1.xml" xpointer="d50-a1"/>
