    <text>
        <body>
            <div xml:id="d45">

                <pb facs="0119" n="45" sameAs="frus:frus1866p2/pg45"/>

                <head>Mr. F. W. Seward to Mr.
                        Wright.</head>
                <opener>
                    <seg rendition="#float-left">No. 45.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1866-09-22"><hi rendition="#italic"
                                >September</hi> 22, 1866</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Herewith I enclose a transcript of a letter
                    addressed to this department on the 12th ultimo by the Hon. James Speed,
                    transmitting, with a communication <pb facs="0120" n="46" xml:id="pg46"/> to
                    yourself, a copy of the naturalization papers of Mr. S. Phillips. You are
                    instructed to use your good offices towards procuring the release of Mr.
                    Phillips from the Prussian army, in which, it is stated, he is now compulsorily
                    serving.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>F. W. SEWARD, <hi rendition="#italic">Acting
                    Secretary.</hi></signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Joseph A. Wright,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>



                <xi:include href="d45-a1.xml" xpointer="d45-a1"/>
                <xi:include href="d45-a2.xml" xpointer="d45-a2"/>
            </div>
