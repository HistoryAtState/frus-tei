    <text>
        <body>
            <div xml:id="d443">

                <pb facs="0617" n="543" sameAs="frus:frus1866p2/pg543"/>

                <head>Mr. Dickinson to Mr.
                        Seward.</head>
                <opener>
                    <seg rendition="#float-left">No. 119.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">Leon,</hi></placeName>
                        <date calendar="gregorian" when="1866-08-09"><hi rendition="#italic"
                                >August</hi> 9, 1866</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to enclose to you a copy,
                    and a translation of the same, of a letter from Señor Don R. Cortes, minister of
                    foreign affairs of the Nicaraguan government, to this legation.</p>
                <p>I am, sir, very respectfully, your obedient servant,</p>
                <closer>
                    <signed>A. B. DICKINSON.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State, Washington, D. C</hi>.</p>
                </postscript>


                <xi:include href="d443-a1.xml" xpointer="d443-a1"/>
