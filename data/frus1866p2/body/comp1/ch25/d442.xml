    <text>
        <body>
            <div xml:id="d442">

                <pb facs="0615" n="[541]" sameAs="frus:frus1866p2/pg541"/>

                <head>Mr. Dickinson to Mr. Seward.</head>
                <opener>
                    <seg rendition="#float-left">No. 116.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">Leon,</hi></placeName>
                        <date calendar="gregorian" when="1866-06-24"><hi rendition="#italic"
                                >June</hi> 24, 1866</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor herewith to hand you a
                    copy of a despatch from the Costa Rican government to Mr. C. N. Riotte, as well
                    as my reply to the same.</p>
                <p>I am, sir, very respectfully, your obedient servant,</p>
                <closer>
                    <signed>A. B. DICKINSON.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State, Washington, D. C</hi>.</p>
                </postscript>



                <xi:include href="d442-a1.xml" xpointer="d442-a1"/>
