    <text>
        <body>
            <div xml:id="d446">

                <pb facs="0619" n="545" sameAs="frus:frus1866p2/pg545"/>

                <head>Mr. Dickinson to Mr.
                        Seward.</head>
                <opener>
                    <seg rendition="#float-left">No 121.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">Leon, Nicaragua,</hi></placeName>
                        <date calendar="gregorian" when="1866-11-23"><hi rendition="#italic"
                                >November</hi> 23, 1866</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have to acknowledge the receipt of your
                    despatch No. 81, of 3d ultimo, and enclose herewith a copy of my note to the
                    Nicaraguan government, declaring the reports of filibustering expeditions from
                    the United States against Central America, therein referred to, to be
                    groundless.</p>
                <p>I am, sir, very respectfully, your obedient servant,</p>
                <closer>
                    <signed>A. B. DICKINSON.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State, Washington, D. C</hi>.</p>
                </postscript>


                <xi:include href="d446-a1.xml" xpointer="d446-a1"/>
            </div>
