    <text>
        <body>
            <div xml:id="d212">

                <pb facs="0312" n="238" sameAs="frus:frus1866p2/pg238"/>

                <head>Mr. Morris to Mr.
                        Seward.</head>
                <opener>
                    <seg rendition="#float-left">No. 148.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States of
                                America,</hi>
                            <hi rendition="#italic">Constantinople,</hi></placeName>
                        <date calendar="gregorian" when="1866-03-09"><hi rendition="#italic"
                                >March</hi> 9, 1866</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit enclosed a
                    translation copy of the note of the minister of foreign affairs of the Sublime
                    Porte, in reply to my despatch relative to the proclamation of President Johnson
                    on the abolition of slavery in the United States.</p>
                <p>I am, sir, very respectfully, your obedient servant,</p>
                <closer>
                    <signed>E. JOY MORRIS.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>


                <xi:include href="d212-a1.xml" xpointer="d212-a1"/>
            </div>
