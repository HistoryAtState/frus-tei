    <text>
        <body>
            <div xml:id="d203">

                <pb facs="0302" n="[228]" sameAs="frus:frus1866p2/pg228"/>

                <head>Mr. Morris to Mr. Seward.</head>
                <opener>
                    <seg rendition="#float-left">No. 135.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States of
                                America,</hi>
                            <hi rendition="#italic">Constantinople,</hi></placeName>
                        <date calendar="gregorian" when="1865-12-15"><hi rendition="#italic"
                                >December</hi> 15, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of despatch No. 97, and to transmit herein enclosed translations and copies of
                    the new regulations relative to the sale, importation, and manufacture of
                    tobacco in the Ottoman empire.</p>
                <p>I am, sir, very respectfully, your obedient servant,</p>
                <closer>
                    <signed>E. JOY MORRIS.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>




