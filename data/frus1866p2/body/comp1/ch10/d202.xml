    <text>
        <body>
            <div xml:id="d202">

                <pb facs="0301" n="227" sameAs="frus:frus1866p2/pg227"/>

                <head>Mr. Van Valkenburgh to Mr. Seward.</head>
                <opener>
                    <seg rendition="#float-left">No. 56.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States in
                                Japan,</hi>
                            <hi rendition="#italic">Yedo,</hi></placeName>
                        <date calendar="gregorian" when="1866-11-10"><hi rendition="#italic"
                                >November</hi> 10, 1866</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith (No.
                    1) the translation of a communication received on the 7th instant from the
                    ministers for foreign affairs, together with the form of a passport adopted by
                    them under the proclamation of the Japanese government, dated May 23d, 1866, and
                    the tenth article of the convention of Yedo, dated June 25th, 1866.</p>
                <p>I have the honor to be, sir, very respectfully, your obedient servant,</p>
                <closer>
                    <signed>R. B. VAN VALKENBURGH</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>



                <xi:include href="d202-a1.xml" xpointer="d202-a1"/>
