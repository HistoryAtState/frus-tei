    <text>
        <body>
            <div xml:id="d196-a1">

                <pb facs="0294" n="220" sameAs="frus:frus1866p2/pg220"/>

                <head>[Translation.]</head>
                <p>His Excellency Hon. R. B. <hi rendition="#small-caps">Van Valkenburgh,</hi>
                    <hi rendition="#italic">Minister of the United States :</hi></p>
                <p>We wish to send to you, for your information, the enclosed document, which has
                    been issued in regard to the illness of his Majesty the Tycoon.</p>
                <closer><dateline rendition="#float-left">With respect and esteem, <date
                            calendar="gregorian" when="1866-09-16">the 8th day of the 8th month of
                            the 2d year of Kaiao, (September 16, 1866</date>.)</dateline>
                    <lb/>
                    <signed>INOWEYE KAWATSI NO KAMI.</signed>
                    <lb/>
                    <signed>MATSU DA IRA SUWO NO KAMI.</signed>
                    <lb/>
                    <signed>MATSU DA IRA NO ONE NO KAMI.</signed></closer>


                <xi:include href="d196-a1-a1.xml" xpointer="d196-a1-a1"/>
            </div>
        </body>
    </text>
