    <text>
        <body>
            <div xml:id="d198-a1">

                <pb facs="0296" n="222" sameAs="frus:frus1866p2/pg222"/>

                <head>[Translation.]</head>
                <p><hi rendition="#small-caps">Sir:</hi> We have to inform your excellency that it
                    has been published that his Majesty the Tycoon is dead, and herewith send you a
                    copy of that proclamation.</p>
                <closer>
                    <dateline rendition="#float-left">Which we state with respect and esteem, on
                            <date calendar="gregorian" when="1866-10">the 27th day of the eighth
                            month of the second year of Kaiao, (October, 1866.)</date></dateline>
                    <lb/>
                    <signed>INOWEYE KAWATSI NO KAMI.</signed>
                    <lb/>
                    <signed>MATSU DA IRA SUWO NO KAMI.</signed>
                    <lb/>
                    <signed>MATSU DA IRA NO-EO NO KAMI.</signed></closer>
                <postscript>
                    <p>His Excellency <hi rendition="#small-caps">R. B. Van Valkenburgh,</hi>
                        <hi rendition="#italic">Minister Resident of the United States of
                            America.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
