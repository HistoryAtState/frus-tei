    <text>
        <body>
            <div xml:id="d175">

                <pb facs="0267" n="193" sameAs="frus:frus1866p2/pg193"/>

                <head>Mr. Portman to Mr.
                        Seward.</head>
                <opener>
                    <seg rendition="#float-left">No. 68.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States in
                                Japan,</hi>
                            <hi rendition="#italic">Yedo,</hi></placeName>
                        <date calendar="gregorian" when="1865-12-06"><hi rendition="#italic"
                                >December</hi> 6, 1865</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith (No.
                    1) translation of a letter from the minister for foreign affairs, announcing
                    that the Mikado’s ratification of the treaties was promulgated in all parts of
                    this empire on the 1st instant.</p>
                <p>I have the honor to be, sir, very respectfully, your most obedient servant,</p>
                <closer>
                    <signed>A. L. C. PORTMAN, <hi rendition="#italic">Chargé d’Affaires ad interim
                            in Japan.</hi></signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>



                <xi:include href="d175-a1.xml" xpointer="d175-a1"/>
            </div>
        </body>
    </text>
