    <text>
        <body>
            <div xml:id="d544">

                <pb facs="0743" n="669" sameAs="frus:frus1866p2/pg669"/>

                <head>Mr. Seward to Mr.
                        Barreda.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1866-10-08"><hi rendition="#italic"
                                >October</hi> 8, 1866</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to transmit to you, for
                    your information, a copy of two circular letters addressed by this department,
                    one to the attorneys of the United States and the other to the respective
                    governors of the States of the United States formerly slave States, on the
                    subject of attempts being made to induce freedmen to move to foreign countries,
                    and especially to Peru.</p>
                <p>I avail myself, &amp;c.,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p>Señor Don <hi rendition="#small-caps">Frederico L. Barreda,</hi> &amp;<hi
                            rendition="#italic">c</hi>., &amp;<hi rendition="#italic">c</hi>.,
                            &amp;<hi rendition="#italic">c</hi>.</p>
                </postscript>




                <xi:include href="d544-a1.xml" xpointer="d544-a1"/>
