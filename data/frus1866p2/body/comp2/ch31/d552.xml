    <text>
        <body>
            <div xml:id="d552">

                <pb facs="0749" n="675" sameAs="frus:frus1866p2/pg675"/>

                <head>Mr. Seward to Mr. Pruyn.</head>
                <opener>
                    <seg rendition="#float-left">No. 85]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-12-06"><hi rendition="#italic"
                                >December</hi> 6, 1864</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Herewith I enclose for your information an
                    executive order relative to the war steamer Fusiyama Solace, built in this
                    country for the Japanese government</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Robert H. Pruyn,</hi> Esq., &amp;<hi
                            rendition="#italic">c</hi>., &amp;<hi rendition="#italic">c</hi>.,
                            &amp;<hi rendition="#italic">c</hi>.</p>
                </postscript>


                <xi:include href="d552-a1.xml" xpointer="d552-a1"/>
