    <text>
        <body>
            <div xml:id="d234">

                <pb facs="0801" n="772" sameAs="frus:frus1977-80v22/pg772"/>

                <head>234. Note From President Carter to
                    Secretary of State Vance<anchor n="1"
                        xml:id="d234-f1"/></head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            when="1977-06-14">June 14, 1977</date></dateline>
                    <salute>To Cy Vance</salute>
                </opener>
                <p>Please delay the visit to U.S. of Prime Minister of New Zealand.</p>
                <closer>
                    <signed><hi rendition="#bold">J.C.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d234-f1" n="1" type="source" xml:id="d234-f1-content">
                <p>Source: Carter Library, National Security Affairs, Staff Material, Far East,
                    Armacost Chron File, Box 3, 6/11–27/77. No classification marking. Carter handwrote the note.</p>
            </note>
        </listAnnotation>
    </standOff>
