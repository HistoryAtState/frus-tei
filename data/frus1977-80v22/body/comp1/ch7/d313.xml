    <standOff>
        <listAnnotation>
            <note corresp="#d313-f1" n="1" type="source" xml:id="d313-f1-content">
                <p>Source: Carter Library, National Security Council, Institutional Files,
                    1977–1981, Box 68, PRC 056: Philippines Base Issues, 2/28/78. Secret. The
                    meeting took place in the White House Situation Room. Carter initialed the top
                    of the first page. No minutes of the meeting have been found.</p>
            </note>
            <note corresp="#d313-f2" n="2" xml:id="d313-f2-content">
                <p>Mondale’s trip was postponed until May 2–4.</p>
            </note>
            <note corresp="#d313-f3" n="3" xml:id="d313-f3-content">
                <p>Brzezinski initialed “ZB” above his typed signature.</p>
            </note>
        </listAnnotation>
