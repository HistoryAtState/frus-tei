    <text>
        <body>
            <div xml:id="d727">

                <pb facs="2032" n="1857" xml:id="pg1857"/>

                <head>727. Memorandum from Read to McGeorge Bundy, December 12<anchor n="1"
                        xml:id="d727-f1"/></head>
                <opener><dateline rendition="#float-right">
                        <date ana="#date_undated-inferred-from-document-head" calendar="gregorian"
                            when="1963-12-12">December 12, 1963</date>
                    </dateline></opener>
                <pb facs="d727-1" n="1" type="facsimile" xml:id="d727-1"/>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>Transmittal of Documents for Discussion NSC Standing Group, December 13,
                        1963, 11:00 a.m.</item>
                </list>
                <p>Attached is a draft paper for discussion at the NSC Standing Group meeting to be
                    held Friday, December 13, 1963, at 11:00 a.m.</p>
                <closer>
                    <signed>Benjamin H. Read</signed>
                    <affiliation>Executive Secretary</affiliation>
                </closer>



                <xi:include href="d727-a1.xml" xpointer="d727-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d727-f1" n="1" type="source" xml:id="d727-f1-content">
                <p>Transmits paper entitled “Possible Further Unilateral and Bilateral Actions to
                    Increase Pressure on Cuba (Short of the Use of Force)” for discussion at the NSC
                    Standing Group meeting December 13. Top Secret. 11 pp. DOS, S/S Files: Lot 65 D
                    438, U–2 Flights—Contingency Plans.</p>
            </note>
        </listAnnotation>
    </standOff>
