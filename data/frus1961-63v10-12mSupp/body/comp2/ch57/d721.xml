            <div xml:id="d721">

                <pb facs="2016" n="1841" sameAs="frus:frus1961-63v10-12mSupp/pg1841"/>

                <head>721. Memorandum from Edwin M. Martin to Rusk, December 2<anchor n="1"
                        xml:id="d721-f1"/></head>
                <opener><dateline rendition="#float-right">
                        <date ana="#date_undated-inferred-from-document-head" calendar="gregorian"
                            when="1963-12-02">December 2, 1963</date>
                    </dateline></opener>
                <pb facs="d721-1" n="1" type="facsimile" xml:id="d721-1"/>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>Your Meeting with the President on Cuba</item>
                </list>
                <p>I am attaching a paper [illegible in the original] on which you may wish to
                    [illegible in the original] Cuba with the President [illegible in the original]
                    an expanded version of the paper [illegible in the original].</p>
                <p>I understand that, [illegible in the original] approved the paper, you wish it to
                    [illegible in the original] participants in the [illegible in the original]; Mr.
                    McCone; Mr. Wilson and Mr. Bundy.</p>



                <xi:include href="d721-a1.xml" xpointer="d721-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d721-f1" n="1" type="source" xml:id="d721-f1-content">
                <p>Transmits talking points for Rusk’s December 2 meeting with President Johnson on
                    Cuba. Top Secret. 9 pp. DOS, S/S Files; Lot 66 D 501, Cuba.</p>
            </note>
        </listAnnotation>
    </standOff>
