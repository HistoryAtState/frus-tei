    <text>
        <body>
            <div xml:id="d717">

                <pb facs="2006" n="1831" xml:id="pg1831"/>

                <head>717. Memorandum from J. Larocque to the Deputy Secretary of Defense, October
                        25<anchor n="1" xml:id="d717-f1"/></head>
                <opener><dateline rendition="#float-right">
                        <date ana="#date_undated-inferred-from-document-head" calendar="gregorian"
                            when="1963-10-25">October 25, 1963</date>
                    </dateline></opener>
                <pb facs="d717-1" n="1" type="facsimile" xml:id="d717-1"/>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>Information Report 00–B 3,279,645, Interview with Fidel Castro</item>
                </list>
                <p>The attached report is forwarded at the request of the Deputy Director
                    (Intelligence). It represents advanced dissemination of a report which will
                    receive normal USIB dissemination next
                    week.</p>
                <closer>
                    <signed>J. Larocque, Jr.</signed>
                    <affiliation>Assistant Director for Operations</affiliation>
                </closer>



                <xi:include href="d717-a1.xml" xpointer="d717-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d717-f1" n="1" type="source" xml:id="d717-f1-content">
                <p>Transmits information report on interview with Fidel
                        Castro. Secret. 3 pp. WNRC, RG 330, OASD (C) A Files; FRC 71 A 2896,
                    Cuba 381, May thru Dec. 1963.</p>
            </note>
        </listAnnotation>
