    <text>
        <body>
            <div xml:id="d612-a1-a2">

                <pb facs="d612-12" n="12" xml:id="d612-12"/>


                <p rendition="#center"><hi rendition="#italic">ESTIMATE AS OF DATE LISTED OF SOVIET
                        MILITARY PERSONNEL IN CUBA (EXCLUSIVE OF CIVILIANS)</hi></p>
                <table cols="2">
                    <row role="label">
                        <cell>1 July 1962</cell>
                        <cell>500</cell>
                    </row>
                    <row>
                        <cell>1 August 1962</cell>
                        <cell>at least 2,000<anchor n="2" xml:id="d612-f1"/></cell>
                    </row>
                    <row>
                        <cell>1 September 1962</cell>
                        <cell>at least 2,3002<note corresp="#d612fn2" n="2"/></cell>
                    </row>
                    <row>
                        <cell>19 September 1962</cell>
                        <cell>about 4,000<note corresp="#d612fn2" n="2"/></cell>
                    </row>
                    <row>
                        <cell>22 October 1962</cell>
                        <cell>8,000–10,000<anchor n="3" xml:id="d612-f2"/></cell>
                    </row>
                    <row>
                        <cell>1 December 1962</cell>
                        <cell>15,000–22,000 (present at height of buildup)</cell>
                    </row>
                    <row>
                        <cell>15 December 1962</cell>
                        <cell>17,000 (present after departure of missiles and bombers)</cell>
                    </row>
                    <row>
                        <cell>1 February 1963</cell>
                        <cell>17,000</cell>
                    </row>
                </table>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d612-f1" n="2" xml:id="d612-f1-content">
                <p>Agreed intelligence community estimates based on known normal passenger capacity
                    of ships.</p>
            </note>
            <note corresp="#d612-f2" n="3" xml:id="d612-f2-content">
                <p>Retrospective analysis shows 22,000 present at this time.</p>
            </note>
        </listAnnotation>
    </standOff>
