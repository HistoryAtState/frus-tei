            <div xml:id="d442">

                <pb facs="d441-3" n="3" sameAs="frus:frus1961-63v10-12mSupp/d441-3"/>

                <head>442. Memorandum from Brubeck to
                        McGeorge Bundy, October 28<anchor
                        n="1" xml:id="d442-f1"/></head>
                <opener>
                    <dateline rendition="#float-right">
                        <date calendar="gregorian" when="1962-10-28T10:40:00">October 28, 1962,
                            10:40 a.m.</date>
                    </dateline>
                </opener>
                <pb facs="d442-1" n="1" type="facsimile" xml:id="d442-1"/>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>October 27 Paper on Negotiations</item>
                </list>
                <p>Attached for the use of the Executive Committee are copies of an October 27 paper
                    on “Negotiations” done by the Rostow
                    Subcommittee.</p>
                <closer>
                    <signed corresp="#p_BWH_1">William H.
                            Brubeck</signed>
                    <affiliation>Executive Secretary</affiliation>
                </closer>
                <pb facs="1438" n="1263" type="typeset" xml:id="pg1263"/>



                <xi:include href="d442-a1.xml" xpointer="d442-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d442-f1" n="1" type="source" xml:id="d442-f1-content">
                <p>Transmits Rostow subcommittee October 27
                    paper on negotiations. Secret. 2 pp. Kennedy Library, NSF, Countries Series, Cuba, General, vol IV(B).</p>
            </note>
