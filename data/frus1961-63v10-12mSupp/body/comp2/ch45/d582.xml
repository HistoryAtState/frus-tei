    <text>
        <body>
            <div xml:id="d582">

                <pb facs="1711" n="1536" xml:id="pg1536"/>

                <head>582. Note from General Clifton to General McHugh, December 20<anchor n="1"
                        xml:id="d582-f1"/></head>
                <opener><dateline rendition="#float-right">
                        <date ana="#date_undated-inferred-from-document-head" calendar="gregorian"
                            when="1962-12-20">December 20, 1962</date>
                    </dateline></opener>
                <pb facs="d582-1" n="1" type="facsimile" xml:id="d582-1"/>
                <p>Mr. McCone asks that the President see these memos which were prepared in
                    response to questions put to him.</p>


                <xi:include href="d582-a1.xml" xpointer="d582-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d582-f1" n="1" type="source" xml:id="d582-f1-content">
                <p>Transmits McCone’s request that the President see the attached memorandum. Rising
                    world sugar prices and the effect on Cuba. Secret. 4 pp. Kennedy Library, NSF,
                    Countries Series, Cuba—Subjects, Intelligence Material, Vol. III.</p>
            </note>
        </listAnnotation>
    </standOff>
