    <text>
        <body>
            <div xml:id="d464">

                <pb facs="1468" n="1293" xml:id="pg1293"/>

                <head>464. List of Outstanding Issues prepared for the NSC Executive Committee,
                    October 30<anchor n="1" xml:id="d464-f1"/></head>
                <opener><dateline rendition="#float-right">
                        <date ana="#date_undated-inferred-from-document-head" calendar="gregorian"
                            when="1962-10-30">October 30, 1962</date>
                    </dateline></opener>
                <pb facs="d464-1" n="1" type="facsimile" xml:id="d464-1"/>
                <p>The attached is the approved list of outstanding issues prepared for the use of
                    the NSC Executive Committee at its meeting 6:00 p.m., October 30, 1962, in the
                    State Department.</p>



                <xi:include href="d464-a1.xml" xpointer="d464-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d464-f1" n="1" type="source" xml:id="d464-f1-content">
                <p>List covers: theory of operation; short-term verification requirements; long-term
                    verification requirements; political arrangements. Top Secret. 3 pp. Kennedy
                    Library, NSF, Countries Series, Cuba, General, Vol. IV(b).</p>
            </note>
        </listAnnotation>
    </standOff>
