        <body>
            <div xml:id="d275">

                <pb facs="0956" n="781" xml:id="pg781"/>

                <head>275. Memorandum to Park F. Wollam, October 6<anchor n="1" xml:id="d275-f1"
                    /></head>
                <opener>
                    <dateline rendition="#float-right">
                        <date ana="#date_undated-inferred-from-document-head" calendar="gregorian"
                            when="1961-10-06">October 6, 1961</date>
                    </dateline>
                </opener>
                <pb facs="d275-1" n="1" type="facsimile" xml:id="d275-1"/>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>What Would Happen If Castro Died?</item>
                </list>
                <p>The attached paper, subject as above, is forwarded in response to your request of
                    5 October 1961.</p>
                <closer><signed>[<hi rendition="#italic">name not
                            declassified</hi>]</signed><affiliation>[<hi rendition="#italic">text
                            not declassified</hi>]</affiliation></closer>



                <xi:include href="d275-a1.xml" xpointer="d275-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d275-f1" n="1" type="source" xml:id="d275-f1-content">
                <p>Transmits paper entitled “What Would Happen If Castro Died?” Secret. 8 pp. CIA,
                    DDO/DDP Files: Job 73–00853R, Box 1, WH Division Liaison with Department of
                    State.</p>
            </note>
