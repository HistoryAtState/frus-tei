    <text>
        <body>
            <div xml:id="d242">

                <pb facs="0772" n="597" sameAs="frus:frus1961-63v10-12mSupp/pg597"/>

                <head>242. Memorandum from Chester L. Cooper to the US. Intelligence Board, February
                        11<anchor n="1" xml:id="d242-f1"/></head>
                <opener>
                    <dateline rendition="#float-right">
                        <date ana="#date_undated-inferred-from-document-head" calendar="gregorian"
                            when="1961-02-11">February 11, 1961</date>
                    </dateline>
                </opener>
                <pb facs="d242-1" n="1" type="facsimile" xml:id="d242-1"/>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>Probable International Reactions to Certain Possible US Courses of Action
                        Against the Castro Regime</item>
                </list>
                <p>The attached Memorandum for the Director is forwarded for your information.</p>
                <closer>
                    <signed>Chester L. Cooper</signed>
                    <affiliation><hi rendition="#italic">Deputy Assistant Director</hi>
                        <hi rendition="#italic">National Estimates</hi></affiliation>
                </closer>



                <xi:include href="d242-a1.xml" xpointer="d242-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d242-f1" n="1" type="source" xml:id="d242-f1-content">
                <p>Transmits a memorandum from Abbot Smith to Allan
                        Dulles on probable international reactions to certain U.S.
                    courses of action against the Castro regime. Top Secret. 12 pp. CIA, DCI
                        (McCone) Files: Job 80–B01285A,
                    General Maxwell Taylor Committee on
                    Cuba, 28 Jan–21 May 1961.</p>
            </note>
        </listAnnotation>
    </standOff>
