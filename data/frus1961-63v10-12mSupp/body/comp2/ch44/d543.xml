    <text>
        <body>
            <div xml:id="d543">

                <pb facs="1633" n="1458" xml:id="pg1458"/>

                <head>543. Memorandum for members of the NSC
                    Executive Committee from Brubeck,
                    November 19<anchor n="1" xml:id="d543-f1"/></head>
                <opener><dateline rendition="#float-right">
                        <date ana="#date_undated-inferred-from-document-head" calendar="gregorian"
                            when="1962-11-19">November 19, 1962</date>
                    </dateline></opener>
                <pb facs="d543-1" n="1" type="facsimile" xml:id="d543-1"/>
                <p rendition="#center"><hi rendition="#italic">INR
                        Papers</hi></p>
                <p>Attached are three INR papers for your
                    information and use.</p>
                <closer><signed corresp="#p_BWH_1">William H.
                            Brubeck</signed><affiliation>Executive
                        Secretary</affiliation></closer>







                <xi:include href="d543-a1.xml" xpointer="d543-a1"/>
                <xi:include href="d543-a2.xml" xpointer="d543-a2"/>
                <xi:include href="d543-a3.xml" xpointer="d543-a3"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d543-f1" n="1" type="source" xml:id="d543-f1-content">
                <p>Transmits three INR papers entitled:
                    “Soviet-Cuban Reactions to U.S. Retaliation for Attack on U.S. Reconnaissance
                    Aircraft”; “Prospects for Overthrowing Castro From Within”; and “Negotiations on
                    Cuba: The Advantages of Stalemate.” Secret. 18 pp. WNRC, RG 330, OASD/ISA Files: FRC 69
                    A 0926 Cuba 1962 (Sensitive).</p>
            </note>
        </listAnnotation>
    </standOff>
