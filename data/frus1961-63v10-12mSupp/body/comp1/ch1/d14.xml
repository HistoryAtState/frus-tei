    <text>
        <body>
            <div xml:id="d14">

                <pb facs="d13-10" n="10" sameAs="frus:frus1961-63v10-12mSupp/d13-10"/>

                <head>14. Memorandum from Read (S/S) to McGeorge Bundy, July 20<anchor n="1"
                        xml:id="d14-f1"/></head>
                <opener>
                    <dateline rendition="#float-right">
                        <date ana="#date_undated-inferred-from-document-head" calendar="gregorian"
                            when="1963-07-20">July 20, 1963</date>
                    </dateline>
                </opener>
                <pb facs="d14-1" n="1" type="facsimile" xml:id="d14-1"/>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>The Situation in Bolivia</item>
                </list>
                <p>In reference to Mr. Bromley Smith’s oral request to Mr. Martin today, I am
                    forwarding herewith a memorandum on the situation in Bolivia.</p>
                <closer>
                    <signed>D. Rowe (for) <lb/> Benjamin Reed</signed>
                    <affiliation>Executive Secretary</affiliation>
                </closer>
                <pb facs="d14-2" n="2" type="facsimile" xml:id="d14-2"/>



                <xi:include href="d14-a1.xml" xpointer="d14-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d14-f1" n="1" type="source" xml:id="d14-f1-content">
                <p>Transmits memorandum on the situation in Bolivia. Confidential. 2 pp. Kennedy
                    Library, National Security Files, Countries Series, Bolivia, General 4–7/63.</p>
            </note>
        </listAnnotation>
