        <body>
            <div xml:id="d306-a3">

                <pb facs="0578" n="478" sameAs="frus:frus1880/pg478"/>

                <opener><seg rendition="#center">[Inclosure 3 in No. 180.]</seg></opener>
                <head><hi rendition="#italic">Copy of telegram sent April</hi> 21, 1880, <hi
                        rendition="#italic">at</hi> 5 <hi rendition="#italic">p.m.</hi></head>
                <p rendition="#flush">To Captain <hi rendition="#small-caps">Potter</hi>,<lb/><hi
                        rendition="#italic">U. S. S. Constellation, Queenstown, Ireland:</hi></p>
                <p>I have written to Lord Salisbury for order to remove customs officers from
                    frigate.</p>
                <closer><signed>HOPPIN.</signed></closer>
            </div>
        </body>
    </text>
