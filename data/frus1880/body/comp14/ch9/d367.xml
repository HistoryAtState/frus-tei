    <text>
        <body>
            <div xml:id="d367">

                <pb facs="0665" n="565" sameAs="frus:frus1880/pg565"/>

                <head>No. 367.<lb/><hi rendition="#italic">Mr. Evarts to Mr. Hoppin.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1880-02-05"><hi rendition="#italic">February</hi> 5,
                        1880</date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Hoppin</hi>, <hi
                        rendition="#italic">Chargé, London:</hi></p>
                <p>(Directing him to inquire at what time an answer in respect of the Fortune Bay
                    claims might be expected, and to express the great chagrin of this government
                    that no answer had already been made.)</p>
                <closer><signed>EVARTS,<lb/><hi rendition="#italic"
                    >Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
