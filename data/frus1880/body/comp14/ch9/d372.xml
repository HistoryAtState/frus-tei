                <pb facs="0668" n="568" sameAs="frus:frus1880/pg568"/>

                <head>No. 372.<lb/><hi rendition="#italic">Mr. Evarts to Mr. Hoppin.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1880-02-26"><hi rendition="#italic">February</hi> 26,
                        1880</date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Hoppin</hi>, <hi
                        rendition="#italic">Chargé, London:</hi></p>
                <p>(Stating the increased chagrin with which this government learns, from his No.
                    147, of there being even a possibility of an additional month’s delay, and
                    directing him to urge Her Majesty’s Government to avoid it if possible.)</p>
                <closer><signed>EVARTS.</signed></closer>
            </div>
        </body>
    </text>
