    <text>
        <body>
            <div xml:id="d307">

                <pb facs="0578" n="478" sameAs="frus:frus1880/pg478"/>

                <head>No. 307.<lb/><hi rendition="#italic">Mr. Hoppin to Mr. Evarts.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1880-05-01"><hi rendition="#italic">May</hi> 1, 1880</date>.
                        (Received May 13.)</dateline>
                    <seg rendition="#float-left">No. 184.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my dispatch. No. 180 of the
                    24th ultimo, I have the honor to inclose a copy of a letter received since the
                    date of that dispatch from Lord Tenterden, expressing the regret of Her
                    Majesty’s Government at the action of the officers of customs at Queenstown in
                    respect to the United States frigate Constellation.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>W. J. HOPPIN.</signed></closer>




                <xi:include href="d307-a1.xml" xpointer="d307-a1"/>
