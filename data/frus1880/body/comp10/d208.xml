    <text>
        <body>
            <div xml:id="d208">

                <pb facs="0426" n="326" sameAs="frus:frus1880/pg326"/>

                <head>No. 208.<lb/><hi rendition="#italic">Mr. Evarts to Mr. Dichman.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1880-08-07"><hi rendition="#italic">August</hi> 7,
                        1880</date>.</dateline>
                    <seg rendition="#float-left">No. 123.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit herewith, for your confidential
                    information, copies of correspondence had with the Costa Rican foreign minister
                    concerning the recent visit of the Adams to Golfo Dulce.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>WM. M. EYARTS.</signed></closer>



                <xi:include href="d208-a1.xml" xpointer="d208-a1"/>
