                <pb facs="0122" n="22" xml:id="pg22"/>

                <opener><seg rendition="#center">[Inclosure in No. 278.—Buenos Ayres Herald, May 11,
                        1880.]</seg></opener>
                <head><hi rendition="#italic">Letter of General Roca to Dr. Tejedor.</hi></head>
                <p>Mr. <hi rendition="#small-caps">Governor</hi>: I have the satisfaction of
                    informing your excellency that I have just arrived, and, according to what has
                    been agreed upon, I await your orders on hoard of the gunboat Pilcoraayo. Till I
                    see you, I am, very cordially and attentively, your humble servant,</p>
                <closer><signed>JULIO A. ROCA.</signed></closer>


                <xi:include href="d16-a1-a1.xml" xpointer="d16-a1-a1"/>
