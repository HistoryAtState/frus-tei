    <text>
        <body>
            <div xml:id="d9">

                <pb facs="0111" n="11" sameAs="frus:frus1880/pg11"/>

                <head>No. 9.<lb/><hi rendition="#italic">Mr. Osborn
                        to Mr. Evarts.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Buenos Ayres</hi></placeName>, <date calendar="gregorian"
                            when="1880-02-13"><hi rendition="#italic">February</hi> 13, 1880</date>.
                        (Received March 30.)</dateline>
                    <seg rendition="#float-left">No. 266.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a copy
                    of a note received at this date from the minister of foreign affairs in relation
                    to the South American Continental Exhibition which takes place in this city in
                    September next, accompanied by copies of the plans and regulations of the
                    same.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>THOS. O. OSBORN.</signed></closer>


                <xi:include href="d9-a1.xml" xpointer="d9-a1"/>
            </div>
