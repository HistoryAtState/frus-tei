        <body>
            <div xml:id="d292">

                <pb facs="0561" n="461" sameAs="frus:frus1880/pg461"/>

                <head>No. 292.<lb/><hi rendition="#italic">Mr. White to Mr. Evarts.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right">Received <date calendar="gregorian"
                            type="received-date" when="1880-11-29">November 29,
                        1880</date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Evarts</hi>,<lb/><hi
                        rendition="#italic">State Department, Washington:</hi></p>
                <p>Gehres’ Alsace case decided in our favor; all penalties and fines remitted both
                    for him and Weill.</p>
                <closer><signed>WHITE</signed>, <hi rendition="#italic">Paris.</hi></closer>
            </div>
        </body>
    </text>
