                <pb facs="0560" n="460" sameAs="frus:frus1880/pg460"/>

                <head>No. 290.<lb/><hi rendition="#italic">Mr. White to Mr. Evarts.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right">[<date
                            ana="#date_undated-inferred-from-document-content" calendar="gregorian"
                            notAfter="1880-11-05" notBefore="1880-11-03">undated</date>]. Received
                        November 5, 1880.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Evarts</hi>,<lb/><hi
                        rendition="#italic">Secretary, Washington:</hi></p>
                <p>Aaron Weill released third instant.</p>
                <closer><signed>WHITE</signed>, <hi rendition="#italic">Berlin.</hi></closer>
            </div>
        </body>
