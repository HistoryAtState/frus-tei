    <text>
        <body>
            <div xml:id="d380">

                <pb facs="0695" n="595" xml:id="pg595"/>

                <head>No. 380.<lb/><hi rendition="#italic">Mr. Comly to Mr. Evarts.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Honolulu</hi></placeName>, <date calendar="gregorian"
                            when="1879-12-22"><hi rendition="#italic">December</hi> 22, 1879</date>.
                        (Received January 23, 1880.)</dateline>
                    <seg rendition="#float-left">No. 88.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose sundry
                    clippings from the Pacific Commercial Advertiser, which may be of interest,
                    giving account of * * * immigration to these islands of cognate races from the
                    Pacific.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>JAMES M. COMLY.</signed></closer>




                <xi:include href="d380-a1.xml" xpointer="d380-a1"/>
