            <div xml:id="d420-a1">

                <pb facs="0753" n="653" sameAs="frus:frus1880/pg653"/>

                <opener><seg rendition="#center">[Inclosure in No. 996.]</seg></opener>
                <head><hi rendition="#small-caps">regulations for receiving bullion for coinage at
                        the branch office, tokio</hi>.</head>
                <p rendition="#center"><hi rendition="#small-caps">imperial mint, osaka.</hi></p>
                <p rendition="#center"><hi rendition="#italic">Notification A, No</hi>. 101 <hi
                        rendition="#italic">of the finance department.</hi></p>
                <p>It is hereby notified that gold or silver bullion imported by the public (both
                    Japanese and foreign) for the purpose of being coined will, for the sake of
                    convenience, be received at the branch office of the mint, established in the
                    premises of finance department, in accordance with the following
                    regulations.</p>
                <p><hi rendition="#small-caps">Note.</hi>—The date of commencing to receive bullion
                    will be notified hereafter.</p>
                <closer><signed>OKUMA SHIGENOBU,<lb/><hi rendition="#italic">Minister of
                            Finance.</hi></signed>
                    <lb/>
                    <dateline rendition="#float-left"><date calendar="gregorian" when="1879-10-10"
                                ><hi rendition="#small-caps">October</hi> 10,
                        1879</date>.</dateline></closer>


                <xi:include href="d420-a1-a1.xml" xpointer="d420-a1-a1"/>
            </div>
