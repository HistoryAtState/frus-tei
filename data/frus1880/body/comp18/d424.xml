    <text>
        <body>
            <div xml:id="d424">

                <pb facs="0769" n="669" xml:id="pg669"/>

                <head>No. 424.<lb/><hi rendition="#italic">Mr. Bingham to Mr. Evarts.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Legation, Japan</hi>,<lb/><hi rendition="#italic"
                                >Tokei</hi></placeName>, <date calendar="gregorian"
                            when="1879-11-11"><hi rendition="#italic">November</hi> 11, 1879</date>.
                        (Received December 16.)</dateline>
                    <seg rendition="#float-left">No. 1010.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: On the 27th ultimo this government
                    furnished me with a notification and a copy of the revised conscriptive act of
                    Japan, a translation of which notification and revised act I beg leave to
                    inclose for your information.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>JNO. A. BINGHAM.</signed></closer>


                <xi:include href="d424-a1.xml" xpointer="d424-a1"/>
            </div>
