    <text>
        <body>
            <div xml:id="d424-a1">

                <pb facs="0769" n="669" sameAs="frus:frus1880/pg669"/>

                <opener><seg rendition="#center">[Inclosure 1 in No. 1010.]</seg></opener>
                <p rendition="#center">(<hi rendition="#italic">Translated by D. Thompson,
                        interpreter to the United States Legation in Japan.</hi>)</p>
                <p rendition="#center">No. 46.</p>
                <p>Proclamation is hereby made that the conscription law has been revised as
                    follows, and that all previous proclamations, notifications, and instructions
                    relating thereto are repealed.</p>
                <closer><signed>SANJO SANEYOSHI,<lb/><hi rendition="#italic">Prime
                        Minister.</hi></signed>
                    <lb/>
                    <dateline rendition="#float-left"><date calendar="gregorian" when="1879-10-27"
                                ><hi rendition="#small-caps">October</hi> 27,
                        1879</date>.</dateline></closer>


                <xi:include href="d424-a1-a1.xml" xpointer="d424-a1-a1"/>
            </div>
        </body>
