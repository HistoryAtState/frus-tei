    <text>
        <body>
            <div xml:id="d45">

                <pb facs="0160" n="60" xml:id="pg60"/>

                <head>No. 45.<lb/><hi rendition="#italic">Mr. Kasson to Mr. Evarts.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Vienna</hi></placeName>, <date calendar="gregorian"
                            when="1880-07-26"><hi rendition="#italic">July</hi> 26, 1880</date>.
                        (Received August 12.)</dateline>
                    <seg rendition="#float-left">No. 343.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: The harvest this year in Hungary, according
                    to the statistics gathered at Pesth, promises to be sufficient for home
                    consumption, and further to yield for export a quantity not less than 20,000,000
                    metric quintals.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>JOHN A. KASSON.</signed></closer>
            </div>
        </body>
