    <text>
        <body>
            <div xml:id="d93">

                <pb facs="0204" n="104" sameAs="frus:frus1880/pg104"/>

                <head>No. 93.<lb/><hi rendition="#italic">Mr. Hay to Mr. Borges.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1880-06-17"><hi rendition="#italic">June</hi> 17,
                        1880</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With regard to your personal request of
                    yesterday, I have the honor to inclose herein a copy of the proclamation of
                    President Polk, referred to in the note addressed to you on the 15th
                    instant.</p>
                <p>Accept, sir, &amp;c.</p>
                <closer><signed>JOHN HAY,<lb/><hi rendition="#italic">Acting
                        Secretary</hi>.</signed></closer>
                <postscript>
                    <p>Councillor <hi rendition="#small-caps">A. P. de Carvalho Borges</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d93-a1.xml" xpointer="d93-a1"/>
            </div>
