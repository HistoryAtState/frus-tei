    <text>
        <body>
            <div xml:id="d187">

                <pb facs="0403" n="303" sameAs="frus:frus1880/pg303"/>

                <head>No. 187.<lb/><hi rendition="#italic">Chen Lan Pin and Mr. Yung Wing to Mr.
                        Evarts.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Chinese Legation</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1880-07-31"><hi rendition="#italic">July</hi> 31,
                        1880</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: We have the honor to inclose herewith
                    copies of a note dispatched some time since by the Tsung-li Yamên at Peking (the
                    foreign office) to the ministers of China in foreign countries.<anchor n="*"
                        xml:id="d187-f1"/> We were instructed by our government to communicate its
                    contents to your excellency, and we have caused an English translation of the
                    note to be printed, to facilitate its examination.</p>
                <p>Accept, &amp;c.,</p>
                <closer><signed><list>
                            <item>CHEN LAN PIN.</item>
                            <item>YUNG WING.</item>
                        </list></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d187-f1" n="*" xml:id="d187-f1-content">
                <p>See appendix 6 to Mr. Seward’s No. 510 of Nov. 21, 1879, <hi rendition="#italic"
                        >ante</hi>, <ref target="#pg177">page 177</ref>.</p>
            </note>
        </listAnnotation>
