    <text>
        <body>
            <div xml:id="d135-a4">

                <pb facs="0289" n="189" xml:id="pg189"/>

                <opener><seg rendition="#center">[Inclosure 2 in No. 512.]</seg></opener>
                <head><hi rendition="#small-caps">protocol.</hi></head>
                <p>The report of the committee upon official intercourse having been this day read
                    before a general meeting of the representatives of treaty powers assembled in
                    Peking, it was agreed that the attention of the Chinese Government should be
                    invited to the propositions therein contained; but verbally and not in
                    correspondence.</p>
                <closer>
                    <dateline rendition="#float-left"><date calendar="gregorian" when="1879-11-07"
                            >November 7, 1879</date>.</dateline>
                    <lb/><signed><list>
                            <item>THOMAS FRANCIS WADE.</item>
                            <item>M. <hi rendition="#small-caps">v.</hi> BRANDT.</item>
                            <item>GEORGE F. SEWARD.</item>
                            <item>J. H. FERGUSON.</item>
                            <item>J. F. ELMORE.</item>
                            <item>FERD. <hi rendition="#small-caps">de</hi> LUCA.</item>
                            <item>HOFFER <hi rendition="#small-caps">de</hi> HOFFENFELS.</item>
                            <item>A. KOYANDER.</item>
                            <item>R. G. <hi rendition="#small-caps">y</hi> OSSA.</item>
                            <item>PATENÔTRE.</item>
                            <item>HUB. SERRUYS.</item>
                        </list></signed></closer>
            </div>
        </body>
