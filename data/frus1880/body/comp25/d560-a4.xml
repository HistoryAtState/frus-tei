    <text>
        <body>
            <div xml:id="d560-a4">

                <pb facs="0975" n="875" sameAs="frus:frus1880/pg875"/>

                <p rendition="#flush"><hi rendition="#small-caps">Foster</hi>, <hi
                        rendition="#italic">Minister, St. Petersburg:</hi></p>
                <p rendition="#right"><hi rendition="#small-caps">Washington</hi>, <hi
                        rendition="#italic">June</hi> 4, 1880.</p>
                <p>The President deeply sympathizes with His Majesty in the great loss which he
                    sustains by the death of the Empress.</p>
                <closer><signed>EVARTS, <hi rendition="#italic">Secretary.</hi></signed></closer>
            </div>
        </body>
