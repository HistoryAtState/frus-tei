    <text>
        <body>
            <div xml:id="d570">

                <pb facs="0983" n="883" sameAs="frus:frus1880/pg883"/>

                <head>No. 570.<lb/><hi rendition="#italic">Mr. Hay
                        to Mr. Willamov.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1880-07-13"><hi rendition="#italic">July</hi> 13,
                        1880</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of May 31 ultimo, in which you inclosed a copy of the regulations
                    governing the Russian commission for the international exchange of books, and to
                    say in reply that a copy of your note and its inclosure having been transmitted
                    to the Secretary of the Smithsonian Institution, that officer has forwarded (in
                    his communication of the 3d instant) a letter on the subject, addressed to you,
                    which I have the pleasure to send to you herewith.</p>
                <p>Accept, sir, &amp;c.,</p>
                <closer><signed>JOHN HAY.</signed></closer>




                <xi:include href="d570-a1.xml" xpointer="d570-a1"/>
