    <text>
        <body>
            <div xml:id="d571">

                <pb facs="0985" n="885" sameAs="frus:frus1880/pg885"/>

                <head>No. 571.<lb/><hi rendition="#italic">Mr. Willamov to Mr. Evarts.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1880-07-09"><hi rendition="#italic">July</hi> 9–21,
                        1880</date>.</dateline></opener>
                <p>Mr. <hi rendition="#small-caps">Secretary of State</hi>: By order of my
                    government I have the honor herewith to transmit to you a copy of the
                    communications received by us from the government of France and that of England
                    relative to the appointment of a commission of liquidation for the regulation of
                    the finances of Egypt, together with a copy of the reply which the imperial
                    cabinet has just addressed to the ambassadors of those powers at St.
                    Petersburg.</p>
                <p>I avail myself, &amp;c.,</p>
                <closer><signed>G. WILLAMOV.</signed></closer>



                <xi:include href="d571-a1.xml" xpointer="d571-a1"/>
