    <text>
        <body>
            <div xml:id="d544-a3">

                <pb facs="0962" n="862" sameAs="frus:frus1880/pg862"/>

                <opener><seg rendition="#center">[Inclosure 4 in No. 308.—Telegram.]</seg></opener>
                <head><hi rendition="#italic">Mr. Moran to Mr. Evarts</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Lisbon</hi></placeName>, <date calendar="gregorian"
                            when="1880-02-26T19:30:00-00:36"><hi rendition="#italic">February</hi>
                            26, 1880—7½ p.m.</date></dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Evarts</hi>, <hi
                        rendition="#italic">Secretary, Washington:</hi></p>
                <p>United States admitted to benefits of Annex B, Portuguese-French treaty of
                    1866.</p>
                <closer><signed>MORAN.</signed></closer>
            </div>
        </body>
