    <text>
        <body>
            <div xml:id="d236">

                <pb facs="0465" n="365" xml:id="pg365"/>

                <head>No. 236.<lb/><hi rendition="#italic">Mr. Noyes to Mr. Evarts.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1880-06-18"><hi rendition="#italic">June</hi> 18, 1880</date>.
                        (Received June 30.)</dateline>
                    <seg rendition="#float-left">No. 359.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose for the
                    information of the Department, a slip from Galignani’s Messenger of this day,
                    June 18, referring to the action of the French Government with regard to the
                    Trans-Sahara Railway.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>EDWARD F. NOYES.</signed></closer>


                <xi:include href="d236-a1.xml" xpointer="d236-a1"/>
            </div>
