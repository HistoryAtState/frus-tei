    <text>
        <body>
            <div xml:id="d233-a2">

                <pb facs="0461" n="361" sameAs="frus:frus1880/pg361"/>

                <head><hi rendition="#italic">List of abbreviated metrical symbols</hi>.</head>
                <p rendition="#flush">A.—Measures of length:</p>
                <table cols="2" rows="7">
                    <row>
                        <cell/>
                        <cell>Abbrev-</cell>
                    </row>
                    <row>
                        <cell>Kilometer</cell>
                        <cell><hi rendition="#bold">km</hi></cell>
                    </row>
                    <row>
                        <cell>Meter</cell>
                        <cell><hi rendition="#bold">m</hi></cell>
                    </row>
                    <row>
                        <cell>Decimeter</cell>
                        <cell><hi rendition="#bold">dm</hi></cell>
                    </row>
                    <row>
                        <cell>Centimeter</cell>
                        <cell><hi rendition="#bold">cm</hi></cell>
                    </row>
                    <row>
                        <cell>Millimeter</cell>
                        <cell><hi rendition="#bold">mm</hi></cell>
                    </row>
                    <row>
                        <cell>Mikron</cell>
                        <cell><hi rendition="#bold">u</hi></cell>
                    </row>
                </table>
                <pb facs="0462" n="362" xml:id="pg362"/>
                <p rendition="#flush">B.—Superficial measures:</p>
                <table cols="2" rows="8">
                    <row>
                        <cell/>
                        <cell>Abbrev.</cell>
                    </row>
                    <row>
                        <cell>Square kilometer</cell>
                        <cell><hi rendition="#bold">km<hi rendition="#superscript"
                            >2</hi></hi></cell>
                    </row>
                    <row>
                        <cell>Hectare</cell>
                        <cell><hi rendition="#bold">ha</hi></cell>
                    </row>
                    <row>
                        <cell>Are</cell>
                        <cell><hi rendition="#bold">a</hi></cell>
                    </row>
                    <row>
                        <cell>Square meter</cell>
                        <cell><hi rendition="#bold">m<hi rendition="#superscript">2</hi></hi></cell>
                    </row>
                    <row>
                        <cell>Square decimeter</cell>
                        <cell><hi rendition="#bold">dm<hi rendition="#superscript"
                            >2</hi></hi></cell>
                    </row>
                    <row>
                        <cell>Square centimeter</cell>
                        <cell><hi rendition="#bold">cm<hi rendition="#superscript"
                            >2</hi></hi></cell>
                    </row>
                    <row>
                        <cell>Square millimeter</cell>
                        <cell><hi rendition="#bold">mm<hi rendition="#superscript"
                            >2</hi></hi></cell>
                    </row>
                </table>
                <p rendition="#flush">C.—Measures of bulk:</p>
                <table cols="2" rows="5">
                    <row role="label">
                        <cell>Cubic meter</cell>
                        <cell><hi rendition="#bold">m<hi rendition="#superscript">3</hi></hi></cell>
                    </row>
                    <row>
                        <cell>Stère</cell>
                        <cell><hi rendition="#bold">s</hi></cell>
                    </row>
                    <row>
                        <cell>Cubic decimeter</cell>
                        <cell><hi rendition="#bold">dm<hi rendition="#superscript"
                            >3</hi></hi></cell>
                    </row>
                    <row>
                        <cell>Cubic centimeter</cell>
                        <cell><hi rendition="#bold">cm<hi rendition="#superscript"
                            >3</hi></hi></cell>
                    </row>
                    <row>
                        <cell>Cubic millimeter</cell>
                        <cell><hi rendition="#bold">mm<hi rendition="#superscript"
                            >3</hi></hi></cell>
                    </row>
                </table>
                <p rendition="#flush">D.—Measures of capacity:</p>
                <table cols="2" rows="5">
                    <row role="label">
                        <cell>Hectoliter</cell>
                        <cell><hi rendition="#bold">hl</hi></cell>
                    </row>
                    <row>
                        <cell>Decaliter</cell>
                        <cell><hi rendition="#bold">dal</hi></cell>
                    </row>
                    <row>
                        <cell>Liter</cell>
                        <cell><hi rendition="#bold">l</hi></cell>
                    </row>
                    <row>
                        <cell>Deciliter</cell>
                        <cell><hi rendition="#bold">dl</hi></cell>
                    </row>
                    <row>
                        <cell>Centiliter</cell>
                        <cell><hi rendition="#bold">cl</hi></cell>
                    </row>
                </table>
                <p rendition="#flush">E.—Weights:</p>
                <table cols="2" rows="7">
                    <row role="label">
                        <cell>Ton</cell>
                        <cell><hi rendition="#bold">t</hi></cell>
                    </row>
                    <row>
                        <cell>Metric quintal</cell>
                        <cell><hi rendition="#bold">q</hi></cell>
                    </row>
                    <row>
                        <cell>Kilogram</cell>
                        <cell><hi rendition="#bold">kg</hi></cell>
                    </row>
                    <row>
                        <cell>Gram</cell>
                        <cell><hi rendition="#bold">g</hi></cell>
                    </row>
                    <row>
                        <cell>Decigram</cell>
                        <cell><hi rendition="#bold">dg</hi></cell>
                    </row>
                    <row>
                        <cell>Centigram</cell>
                        <cell><hi rendition="#bold">cg</hi></cell>
                    </row>
                    <row>
                        <cell>Milligram</cell>
                        <cell><hi rendition="#bold">mg</hi></cell>
                    </row>
                </table>
            </div>
        </body>
    </text>
