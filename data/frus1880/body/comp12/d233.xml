    <text>
        <body>
            <div xml:id="d233">

                <pb facs="0461" n="361" sameAs="frus:frus1880/pg361"/>

                <head>No. 233.<lb/><hi rendition="#italic">Mr. Noyes to Mr. Evarts.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1880-05-10"><hi rendition="#italic">May</hi> 10, 1880</date>.
                        (Received May 26.)</dateline>
                    <seg rendition="#float-left">No. 347.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: At the request of the International
                    Committee of Weights and Measures, I have the honor to forward herewith, for the
                    consideration of the proper authorities, a lithographed report in relation to
                    the new mode of figuring weights and measures in the metric system, adopted by
                    the committee.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>EDWARD F. NOYES.</signed></closer>



                <xi:include href="d233-a1.xml" xpointer="d233-a1"/>
