    <text>
        <body>
            <div xml:id="d117">

                <pb facs="0230" n="130" sameAs="frus:frus1880/pg130"/>

                <head>No. 117.<lb/><hi rendition="#italic">Mr. Evarts to Mr. Osborn.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1880-04-23"><hi rendition="#italic">April</hi> 23,
                        1880</date>.</dateline>
                    <seg rendition="#float-left">No. 89.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit herein for your information a
                    copy of a late instruction<anchor n="*" xml:id="d117-f1"/> sent to Mr. Adams,
                    the newly appointed minister of the United States to Bolivia, respecting a
                    proposition of Chili, touching an exchange between those countries of prisoners
                    of war.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>WM. M. EVARTS.</signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d117-f1" n="*" xml:id="d117-f1-content">
                <p>See Mr. Evarts’s instruction to Mr. Adams, <hi rendition="#italic">ante</hi>,
                        <ref target="#pg78">page 78</ref>.</p>
            </note>
        </listAnnotation>
