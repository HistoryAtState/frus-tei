    <text>
        <body>
            <div xml:id="d122">

                <pb facs="0234" n="134" sameAs="frus:frus1880/pg134"/>

                <head>No. 122.<lb/><hi rendition="#italic">Mr. Osborn to Mr. Evarts.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Santiago, Chili</hi></placeName>, <date calendar="gregorian"
                            when="1880-09-13"><hi rendition="#italic">September</hi> 13,
                        1880</date>. (Received November 4.)</dateline>
                    <seg rendition="#float-left">No. 165.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Responding to your instruction No. 100, I
                    have the honor herewith to inclose an English translation of the note received
                    by me in February last from the minister of foreign relations regarding an
                    exchange of prisoners with Bolivia, as also a copy of my reply thereto.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>THOMAS A. OSBOBN.</signed></closer>




                <xi:include href="d122-a1.xml" xpointer="d122-a1"/>
