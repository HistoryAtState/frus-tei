    <text>
        <body>
            <div xml:id="d486">

                <pb facs="0868" n="768" sameAs="frus:frus1880/pg768"/>

                <head>No. 486.<lb/><hi rendition="#italic">Mr. Morgan to Mr. Evarts.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1880-09-16"><hi rendition="#italic">September</hi> 16,
                        1880</date>.</dateline>
                    <seg rendition="#float-left">No. 101.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Copies of the President’s message to the
                    two houses of Congress to-day have just been sent to me. I have no time to have
                    it translated in time for the mail, which is about to close. I therefore inclose
                    a copy in the original, and will forward a translation of the same by the next
                    steamer.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>P. H. MORGAN.</signed></closer>


                <xi:include href="d486-a1.xml" xpointer="d486-a1"/>
            </div>
        </body>
