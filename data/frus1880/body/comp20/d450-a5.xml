    <text>
        <body>
            <div xml:id="d450-a5">

                <pb facs="0811" n="711" sameAs="frus:frus1880/pg711"/>

                <opener><seg rendition="#center">[Indorsement.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Headquarters Military Division, Missouri</hi>,<lb/><hi
                                rendition="#italic">Chicago</hi></placeName>, <date
                            calendar="gregorian" when="1879-09-08"><hi rendition="#italic"
                                >September</hi> 8, 1879</date>.</dateline></opener>
                <p>Respectfully forwarded to the adjutant-general of the army, inviting attention to
                    previous indorsements from these headquarters on papers relating to this
                    subject.</p>
                <closer><signed>P. H. SHERIDAN,<lb/><hi rendition="#italic">Lieut. General,
                            Commanding.</hi></signed></closer>
            </div>
        </body>
