    <text>
        <body>
            <div xml:id="d450-a4">

                <pb facs="0811" n="711" xml:id="pg711"/>

                <opener><seg rendition="#center">[Copy of telegram received.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Headquarters Department of Arizona</hi>,<lb/><hi
                                rendition="#italic">Prescott Barracks</hi></placeName>, <date
                            calendar="gregorian" when="1879-08-09"><hi rendition="#italic"
                                >August</hi> 9, 1879</date>.</dateline></opener>
                <p rendition="#center">(Received at Santa Fé August 12, 10.30 a.m.)</p>
                <p rendition="#flush">General <hi rendition="#small-caps">Hatch</hi>,<lb/><hi
                        rendition="#italic">Commanding Department of New Mexico, Santa Fé:</hi></p>
                <p>Following dispatch transmitted to you. General Willcox, now absent at San
                    Francisco, suggests that you make application direct through the United States
                    consul.</p>
                <closer><signed>MARTIN,<lb/><hi rendition="#italic">Assistant
                        Adjutant-General.</hi></signed></closer>


                <xi:include href="d450-a4-a1.xml" xpointer="d450-a4-a1"/>
            </div>
