                <pb facs="0858" n="758" sameAs="frus:frus1880/pg758"/>

                <opener><seg rendition="#center">[1st indorsement.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Headquarters Department of the Missouri</hi>,<lb/><hi
                                rendition="#italic">Fort Leaveworth, Kans.</hi></placeName>, <date
                            calendar="gregorian" when="1880-06-08"><hi rendition="#italic">June</hi>
                            8, 1880</date>.</dateline></opener>
                <p>Official copy respectfully forwarded to the assistant adjutant-general,
                    headquarters Military Division of the Missouri, for the information of the
                    Lieutenant-General.</p>
                <closer><signed>JNO. POPE,<lb/><hi rendition="#italic">Brevet Major-General,
                            Commanding.</hi></signed></closer>
            </div>
