    <text>
        <body>
            <div xml:id="d615">

                <pb facs="0733" n="723" sameAs="frus:frus1948v08/pg723"/>

                <note rend="inline" type="source">893.24 FLC/9–2848: Telegram</note>
                <head><hi rendition="#italic">The Consul General at Shanghai</hi> (<hi rendition="#italic">Cabot</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Shanghai</hi></placeName>, <date calendar="gregorian"
                            when="1948-09-28T20:00:00+09:00">September 28, 1948—8
                        p.m.</date><lb/>[Received September 28—5:49 a.m.]</dateline>
                </opener>
                <p>2097. [To Nanking:] Cite SFLC 3311, reur 848.<anchor n="39" xml:id="d615-f1"/>
                    Clark’s minutes accord my understanding tentative agreement. Fruitless delay to
                        <pb facs="0734" n="724" xml:id="pg724"/> argue minutes. Tung Ling version
                    unworkable and unacceptable. Request Foreign Office meeting soonest. Signed
                    Luboshez.</p>
                <p>Sent Nanking 1598, repeated Department 2097.</p>
                <closer><signed><hi rendition="#small-caps">Cabot</hi></signed></closer>
            </div>
        </body>
    </text>
