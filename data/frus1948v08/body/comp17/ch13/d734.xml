            <div xml:id="d734">

                <pb facs="0853" n="843" sameAs="frus:frus1948v08/pg843"/>

                <note rend="inline" type="source">393.1115/8–1348: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in China</hi> (<hi rendition="#italic">Stuart</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Nanking</hi></placeName>, <date calendar="gregorian"
                            when="1948-08-13T18:00:00+09:00">August 13, 1948—6
                        p.m.</date><lb/>[Received August 13—10:09 a.m.]</dateline>
                </opener>
                <p>1509. ReDeptel 101, January 22. Number Americans critical areas, China, as of
                    August is as follows: <list>
                        <item>Mukden 21</item>
                        <item>Tientsin 168</item>
                        <item>Chahar 2</item>
                        <item>Peiping 633</item>
                        <item>Hopei (outside Peiping and Tientsin) 18</item>
                        <item>Suiyuan 11</item>
                        <item>Shensi 4</item>
                        <item>Kansu 43</item>
                        <item>Hupeh 294</item>
                        <item>Shantung (outside Tsingtao) 9</item>
                        <item>Shensi 29</item>
                        <item>Honan 10.</item>
                    </list></p>
                <closer><signed><hi rendition="#small-caps">Stuart</hi></signed></closer>
            </div>
        </body>
    </text>
