                <pb facs="0843" n="833" sameAs="frus:frus1948v08/pg833"/>

                <note rend="inline" type="source">893.00/5–2748: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Ambassador in China</hi> (<hi
                            rendition="#italic">Stuart</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1948-05-28T11:00:00-04:00">May 28, 1948—11 a.m.</date></dateline>
                </opener>
                <p>799. In light of conditions reported Embtel 962 May 27 authorization hereby given
                    to issue warning to American residents Peiping–Tientsin area along lines
                    indicated.</p>
                <closer><signed><hi rendition="#small-caps">Lovett</hi></signed></closer>
            </div>
        </body>
    </text>
