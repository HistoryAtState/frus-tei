            <div xml:id="d811">

                <pb facs="0900" n="890" xml:id="pg890"/>

                <note rend="inline" type="source">393.1115/11–1848: Telegram</note>
                <head><hi rendition="#italic">The Consul General at Shanghai</hi> (<hi
                        rendition="#italic">Cabot</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Shanghai</hi></placeName>, <date calendar="gregorian"
                            when="1948-11-18T18:00:00+08:00">November 18, 1948—6
                        p.m.</date><lb/>[Received November 18—6 p.m.]</dateline>
                </opener>
                <p>2467. Civil Air Transport, CAT, has requested permission operate evacuation
                    shuttle Shanghai–Nanking–Hong Kong and has received verbal assurances permission
                    will be granted.</p>
                <p>Sent Department, pouched Nanking 1865.</p>
                <closer><signed><hi rendition="#small-caps">Cabot</hi></signed></closer>
            </div>
        </body>
