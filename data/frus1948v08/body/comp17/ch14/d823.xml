    <text>
        <body>
            <div xml:id="d823">

                <pb facs="0909" n="899" sameAs="frus:frus1948v08/pg899"/>

                <note rend="inline" type="source">125.0093/11–2848: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in China</hi> (<hi rendition="#italic"
                        >Stuart</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Nanking</hi></placeName>, <date calendar="gregorian"
                            when="1948-11-28">November 28, 1948</date>.<lb/>[Received November
                        28—11:16 p.m.]</dateline>
                </opener>
                <p>2348. For ComNavWesPac. Final arrangements completed Manila for accommodation
                    Embassy consular dependents. Please arrange airlift Nanking group beginning
                    Thursday, December 2 and Shanghai group soon as possible thereafter. Will notify
                    you November 29 exact number desiring airlift as number somewhat lower than that
                    given you previously.</p>
                <p>Sent Tsingtao 218; repeated Shanghai 1170, Manila 40, Hankow 64, Department 2348,
                    Peiping 248.</p>
                <p>Shanghai pass to CTF 78.<anchor n="80" xml:id="d823-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Stuart</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d823-f1" n="80" xml:id="d823-f1-content">
                <p>Commander Task Force 78.</p>
            </note>
        </listAnnotation>
    </standOff>
