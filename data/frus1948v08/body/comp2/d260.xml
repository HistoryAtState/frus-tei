    <text>
        <body>
            <div xml:id="d260">

                <pb facs="0321" n="311" sameAs="frus:frus1948v08/pg311"/>

                <note rend="inline" type="source">893.00/5–748: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in China</hi> (<hi rendition="#italic">Stuart</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Nanking</hi></placeName>, <date calendar="gregorian"
                            when="1948-05-07T09:00:00+09:00">May 7, 1948—9 a.m.</date><lb/>[Received
                        May 7—7:13 a.m.]</dateline>
                </opener>
                <p>822. For Butterworth from Clark.<anchor n="12" xml:id="d260-f1"/> You will be
                    interested ComNavWesPac despatch 030045, May 2 [<hi rendition="#italic">3</hi>],
                    to CNO regarding possibility Communist attack on Tsingtao. See also my letter to
                    you April 22.<anchor n="13" xml:id="d260-f2"/> [Clark.]</p>
                <closer><signed><hi rendition="#small-caps">Stuart</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d260-f1" n="12" xml:id="d260-f1-content">
                <p>Lewis Clark, Minister-Counselor of Embassy.</p>
            </note>
            <note corresp="#d260-f2" n="13" xml:id="d260-f2-content">
