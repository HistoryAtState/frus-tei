    <text>
        <body>
            <div xml:id="d261">

                <pb facs="0322" n="312" xml:id="pg312"/>

                <note rend="inline" type="source">893.00/5–2448: Telegram</note>
                <head><hi rendition="#italic">The Chief of Naval Operations</hi> (<hi rendition="#italic">Denfeld</hi>) <hi
                        rendition="#italic">to the Commander of the United States Naval Forces,
                        Western Pacific</hi> (<hi rendition="#italic"
                            >Badger</hi>)<anchor n="14" xml:id="d261-f1"/></head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1948-05-12">12 May 1948</date>.</dateline>
                </opener>
                <p>122227Z. Your 030045 and 100835.<anchor n="15" xml:id="d261-f2"/> Whole problem
                    of presence our forces in Tsingtao being forwarded to SecDefense<anchor n="16"
                        xml:id="d261-f3"/> recommending reference to SecState. Pending further
                    instructions JCS<anchor n="17" xml:id="d261-f4"/> approve your general course of
                    action <hi rendition="#italic">a</hi> if situation requires.</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d261-f1" n="14" type="source" xml:id="d261-f1-content">
                <p>Copy transmitted to the Department by the Navy Department on May 13.</p>
            </note>
            <note corresp="#d261-f2" n="15" xml:id="d261-f2-content">
                <p>Latter not printed.</p>
            </note>
            <note corresp="#d261-f3" n="16" xml:id="d261-f3-content">
                <p>James Forrestal.</p>
            </note>
            <note corresp="#d261-f4" n="17" xml:id="d261-f4-content">
                <p>Joint Chiefs of Staff.</p>
            </note>
        </listAnnotation>
    </standOff>
