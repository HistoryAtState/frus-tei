    <text>
        <body>
            <div xml:id="d566">

                <pb facs="0675" n="665" sameAs="frus:frus1948v08/pg665"/>

                <note rend="inline" type="source">893.50 Recovery/12–1748: Telegram</note>
                <head><hi rendition="#italic">The Deputy ECA Administrator</hi> (<hi
                        rendition="#italic">Bruce</hi>) <hi rendition="#italic">to the Chief of the
                        ECA China Mission</hi> (<hi rendition="#italic">Lapham</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1948-12-17T22:00:00-05:00">December 17, 1948—10
                        p.m.</date></dateline>
                </opener>
                <p><hi rendition="#small-caps">Ecato</hi> 768. Reur <hi rendition="#small-caps"
                        >Toeca</hi> 621, following based on discussion with Acting Sec of State.</p>
                <list>
                    <label>1.</label>
                    <item>Re para <hi rendition="#italic">c</hi>. Plans for continued shipment not
                        yet made here and will depend on general decisions highest levels
                        Washington.</item>
                    <label>2.</label>
                    <item>Re para <hi rendition="#italic">f</hi>. No personal views or assurances
                        should be given to any <hi rendition="#italic">de facto</hi> authorities.
                        Any discussions re distribution should be confined strictly to supplies
                        already on hand in China.</item>
                    <label>3.</label>
                    <item>Instructions paras <hi rendition="#italic">a</hi> and <hi
                            rendition="#italic">b</hi> okay.</item>
                </list>
                <closer><signed><hi rendition="#small-caps">Bruce</hi></signed></closer>
            </div>
        </body>
    </text>
