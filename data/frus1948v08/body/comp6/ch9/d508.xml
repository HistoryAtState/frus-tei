    <text>
        <body>
            <div xml:id="d508">

                <pb facs="0608" n="598" sameAs="frus:frus1948v08/pg598"/>

                <note rend="inline" type="source">893.50 Recovery/7–348: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in China</hi> (<hi rendition="#italic"
                        >Stuart</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Nanking</hi></placeName>, <date calendar="gregorian"
                            when="1948-07-03T16:00:00+09:00">July 3, 1948—4
                        p.m.</date><lb/>[Received July 3—4:09 a.m.]</dateline>
                </opener>
                <p>1223. For Department and ECA. I signed Bilateral Aid Agreement<anchor n="68"
                        xml:id="d508-f1"/> and MFN notes with Foreign Minister at 3:15 this
                    afternoon Nanking time (reference Embtel 1221 of July 3, 1 p.m.).</p>
                <closer><signed><hi rendition="#small-caps">Stuart</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
