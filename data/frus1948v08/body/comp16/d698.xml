                <pb facs="0818" n="808" sameAs="frus:frus1948v08/pg808"/>

                <note rend="inline" type="source">893.796A/6–1048: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in China</hi> (<hi rendition="#italic">Stuart</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Nanking</hi></placeName>, <date calendar="gregorian"
                            when="1948-06-10T10:00:00+09:00">June 10, 1948—10
                        a.m.</date><lb/>[Received June 10—4:45 a.m.]</dateline>
                </opener>
                <p>1049. Embassy perceives no objection to plan outlined Deptel sent Nanking 843,
                    repeated Shanghai 1027 June 4. Information contained therein will be conveyed
                    Tai, CCAA.</p>
                <closer><signed><hi rendition="#small-caps">Stuart</hi></signed></closer>
            </div>
        </body>
