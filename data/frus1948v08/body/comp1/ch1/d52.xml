    <text>
        <body>
            <div xml:id="d52">

                <pb facs="0063" n="53" sameAs="frus:frus1948v08/pg53"/>

                <note rend="inline" type="source">893.50 Recovery/4–948: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Acting Secretary of
                        State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Bogotá</hi></placeName>, <date calendar="gregorian"
                            when="1948-04-09T11:00:00-05:00">April 9, 1948—11
                        a.m.</date><lb/>[Received—12:48 p.m.]</dateline>
                </opener>
                <p><hi rendition="#small-caps">Martel</hi> 36. I assume passage of ERP<anchor n="89"
                        xml:id="d52-f1"/> with China assistance is the event which overtook the NSC
                    paper. This should not preclude consideration by defense establishment of views
                    contained in my <hi rendition="#small-caps">Martel</hi> 28.</p>
                <closer><signed><hi rendition="#small-caps">Marshall</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d52-f1" n="89" xml:id="d52-f1-content">
                <p>European Recovery Program.</p>
            </note>
        </listAnnotation>
    </standOff>
