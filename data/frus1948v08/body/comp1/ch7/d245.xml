    <text>
        <body>
            <div xml:id="d245">

                <pb facs="0306" n="296" sameAs="frus:frus1948v08/pg296"/>

                <note rend="inline" type="source">893.0011/11–2448: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Ambassador in China</hi>
                        (<hi rendition="#italic">Stuart</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1948-11-24T00:00:00-05:00">November 24,
                        1948—midnight</date>.</dateline>
                </opener>
                <p>1702. Personal for Stuart. Madame Chiang<anchor n="27" xml:id="d245-f1"/> has
                    just spoken to me by telephone. She plans immediate departure by air for
                    temporary visit Washington. Several others in party. Notify me soonest complete
                    info on party and itinerary so appropriate entrance arrangements can be
                    made.</p>
                <closer><signed><hi rendition="#small-caps">Marshall</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d245-f1" n="27" xml:id="d245-f1-content">
                <p>Wife of Generalissimo Chiang Kai-shek, President of the Republic of China.</p>
            </note>
        </listAnnotation>
    </standOff>
