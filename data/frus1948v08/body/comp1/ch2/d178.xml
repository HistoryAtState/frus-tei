    <text>
        <body>
            <div xml:id="d178">

                <pb facs="0240" n="230" sameAs="frus:frus1948v08/pg230"/>

                <note rend="inline" type="source">811.3393/12–1548: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in China</hi> (<hi rendition="#italic"
                        >Stuart</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Nanking</hi></placeName>, <date calendar="gregorian"
                            when="1948-12-15T11:00:00+08:00">December 15, 1948—11
                        a.m.</date><lb/>[Received December 15—9:45 a.m.]</dateline>
                </opener>
                <p>2517. Purpose surveillance your [<hi rendition="#italic">Taipei’s</hi>]
                        183<anchor n="5" xml:id="d178-f1"/> unclear. Please elucidate further. We do
                    not believe it advisable that US Navy should become involved in policing Taiwan
                    coast.</p>
                <p>Sent Taipei 96, repeated Department.</p>
                <closer><signed><hi rendition="#small-caps">Stuart</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d178-f1" n="5" xml:id="d178-f1-content">
                <p>Sent to the Department as telegram No. 93, December 8, midnight, <ref
                        target="#pg227">p. 227</ref>.</p>
            </note>
