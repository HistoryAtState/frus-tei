            <div xml:id="d105">

                <pb facs="0128" n="118" sameAs="frus:frus1948v08/pg118"/>

                <note rend="inline" type="source">Executive Secretariat Files: NSC 22</note>
                <head><hi rendition="#italic">Note by Rear Admiral Sidney W.
                            Souers, Executive Secretary to the National
                            Security Council</hi></head>
                <opener>
                    <seg rendition="#float-left">NSC 22</seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1948-07-26">July 26, 1948</date>.</dateline>
                </opener>
                <p rendition="#center"><hi rendition="#small-caps">Possible Courses of Action for
                        the</hi> U. S. <hi rendition="#small-caps">With Respect to the Critical
                        Situation in China</hi></p>
                <p>At the request of the Secretary of the Army the enclosed paper assessing the
                    current critical situation in China and outlining alternative courses of action
                    is circulated herewith to the National Security Council for discussion at its
                    next meeting.</p>
                <closer><signed><hi rendition="#small-caps">Sidney</hi> W. <hi
                            rendition="#small-caps">Souers</hi></signed></closer>



                <xi:include href="d105-a1.xml" xpointer="d105-a1"/>
