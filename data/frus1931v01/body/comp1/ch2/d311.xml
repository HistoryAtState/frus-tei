    <text>
        <body>
            <div xml:id="d311">

                <pb facs="0538" n="424" sameAs="frus:frus1931v01/pg424"/>

                <note rend="inline" type="source">500.A15a3/1631</note>
                <head><hi rendition="#italic">The Chargé in France</hi> (<hi
                            rendition="#italic">Marriner</hi>) <hi rendition="#italic">to
                        the Acting Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1931-08-27">August 27, 1931</date>.<lb/>[Received September
                        5.]</dateline>
                    <seg rendition="#float-left">No. 1763</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to enclose the full text
                    in French with translation of the Memorandum which was forwarded to the Italian
                    Government on Saturday, August 22nd, 1931. The Memorandum was handed to me in
                    confidence by M. René Massigli on the afternoon of August 26, 1931 (see my
                    telegram No. 540, August 26/8 p.m.).<anchor n="32" xml:id="d311-f1"/></p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">J. Theodore
                    Marriner</hi></signed></closer>


                <xi:include href="d311-a1.xml" xpointer="d311-a1"/>
            </div>
        </body>
    </text>
