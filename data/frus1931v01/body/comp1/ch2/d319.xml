    <text>
        <body>
            <div xml:id="d319">

                <pb facs="0551" n="437" sameAs="frus:frus1931v01/pg437"/>

                <note rend="inline" type="source">500.A15a3/1665</note>
                <head><hi rendition="#italic">Mr. Augusto Rosso to
                        Mr. J. Theodore Marriner</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1931-11-18">November 18, 1931</date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Marriner</hi>: With reference to the
                    conversation I had with you this morning I enclose herewith copy of the Revised
                    Draft of October 16th, as promised you.</p>
                <p>With kind regards [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Rosso</hi></signed></closer>


                <xi:include href="d319-a1.xml" xpointer="d319-a1"/>
            </div>
