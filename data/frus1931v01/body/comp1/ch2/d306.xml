    <text>
        <body>
            <div xml:id="d306">

                <pb facs="0533" n="419" sameAs="frus:frus1931v01/pg419"/>

                <note rend="inline" type="source">500.A15a3/1578: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Ambassador in Great Britain</hi> (<hi
                            rendition="#italic">Dawes</hi>)</head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1931-05-22T16:00:00-04:00">May 22, 1931—4
                    p.m.</date></dateline></opener>
                <p>141. Reference is to my No. 140 of May 21, 7 p.m., and to your No. 157, May 21, 9
                        p.m.<anchor n="27" xml:id="d306-f1"/> Please delay speaking to the Prime
                    Minister about the suggestions contained in my telegram. I think your discussion
                    with the Prime Minister might well be postponed until Marriner reviews the
                    situation with you as he will at the first convenient opportunity after his
                    arrival in Paris.</p>
                <closer><signed><hi rendition="#small-caps">Stimson</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d306-f1" n="27" xml:id="d306-f1-content">
