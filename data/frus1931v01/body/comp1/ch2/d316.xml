    <text>
        <body>
            <div xml:id="d316">

                <pb facs="0546" n="432" sameAs="frus:frus1931v01/pg432"/>

                <note rend="inline" type="source">500.A15a3/1652</note>
                <head><hi rendition="#italic">The Chargé in Italy</hi> (<hi
                            rendition="#italic">Kirk</hi>) <hi rendition="#italic">to the
                            Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Rome</hi></placeName>, <date calendar="gregorian" when="1931-10-09"
                            >October 9, 1931</date>.<lb/>[Received October 21.]</dateline>
                    <seg rendition="#float-left">No. 1080</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to my telegram No. 198 of
                    October 9, 11 a.m.<anchor n="35" xml:id="d316-f1"/> regarding the Franco-Italian
                    negotiations for a Naval Accord, I have the honor to transmit herewith a copy
                    and translation of the Italian memorandum submitted by Signor Rosso to M.
                    Massigli on September 26, 1931, which is referred to therein.</p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">Alexander Kirk</hi></signed></closer>


                <xi:include href="d316-a1.xml" xpointer="d316-a1"/>
            </div>
        </body>
    </text>
