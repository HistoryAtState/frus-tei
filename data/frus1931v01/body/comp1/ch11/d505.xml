                <pb facs="0753" n="639" sameAs="frus:frus1931v01/pg639"/>

                <note rend="inline" type="source">561.311D1/73</note>
                <head><hi rendition="#italic">The Chargé in Great Britain</hi> (<hi
                        rendition="#italic">Atherton</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1931-05-27">May 27, 1931</date>.<lb/>[Received June 5.]</dateline>
                    <seg rendition="#float-left">No. 1976</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to the Department’s cable No. 118
                    of May 6, 6 p.m., I have the honor to transmit five copies of a report dated May
                    26, 1931, prepared by Mr. Raymond E. Cox, First Secretary of this Embassy, on
                    the Conference of Wheat Exporting Countries held in London, May 18–23, 1931. Mr.
                    Cox was Secretary of the American Delegation to this Conference. The enclosures
                    to the report are being forwarded to the Department under separate cover with a
                    cross reference to this despatch.</p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">Ray Atherton</hi></signed></closer>


                <xi:include href="d505-a1.xml" xpointer="d505-a1"/>
            </div>
