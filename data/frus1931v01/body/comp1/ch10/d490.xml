                <pb facs="0743" n="629" sameAs="frus:frus1931v01/pg629"/>

                <note rend="inline" type="source">551.5F1/175: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Dawes</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1931-10-07T13:00:00+00:00">October 7, 1931—1
                        p.m.</date><lb/>[Received October 7—11:49 a.m.]</dateline></opener>
                <p>404. The British Government has postponed further consideration of the silver
                    conference to a date after the election on October 27. Subsequently, the
                    Secretary of State for the Dominions intends to discuss with me the possibility
                    of a conference under Canadian auspices.</p>
                <closer><signed><hi rendition="#small-caps">Dawes</hi></signed></closer>
            </div>
