            <div xml:id="d354">

                <pb facs="0582" n="468" sameAs="frus:frus1931v01/pg468"/>

                <note rend="inline" type="source">500.A15 Arms Truce/57: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Minister in Switzerland</hi> (<hi
                            rendition="#italic">Wilson</hi>)</head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1931-10-01T11:00:00-05:00">October 1, 1931—11
                        a.m.</date></dateline></opener>
                <p>133. Please telegraph full text urgently of statements made by any delegate
                    before the Third Committee or elsewhere stating as a definite opinion that the
                    proposed truce did not affect the completion of ships in the process of
                    construction. It is possible that the Department might want to utilize this
                    information to correct any misapprehensions expressed in the press.</p>
                <closer><signed><hi rendition="#small-caps">Stimson</hi></signed></closer>
            </div>
        </body>
    </text>
