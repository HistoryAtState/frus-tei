                <pb facs="0886" n="772" sameAs="frus:frus1931v01/pg772"/>

                <note rend="inline" type="source">738.3915/421: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Minister in
                        Haiti</hi> (<hi rendition="#italic">Munro</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1931-05-29T14:00:00-04:00">May 29, 1931—2
                    p.m.</date></dateline></opener>
                <p>33. The Department is addressing the following telegram to the American Legation
                    at Santo Domingo. Please take action in accordance with the last paragraph
                    thereof.</p>
                <p>[Here follows the text of telegram No. 20, May 29, 2 p.m., to the Minister in the
                    Dominican Republic, printed <hi rendition="#italic">supra.</hi>]</p>
                <closer><signed><hi rendition="#small-caps">Castle</hi></signed></closer>
            </div>
        </body>
