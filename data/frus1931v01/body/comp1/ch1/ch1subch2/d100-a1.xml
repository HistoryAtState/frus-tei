                    <item>P[<hi rendition="#small-caps">ierre</hi>] E[<hi rendition="#small-caps"
                            >tienne</hi>] F[<hi rendition="#small-caps">landin</hi>]</item>
                    <item>F[<hi rendition="#small-caps">rançois</hi>] P[<hi rendition="#small-caps"
