        <body>
            <div xml:id="d263-a1">

                <pb facs="0463" n="349" sameAs="frus:frus1931v01/pg349"/>

                <opener><seg rendition="#center">[Enclosure—Translation]</seg></opener>
                <head><hi rendition="#italic">The Finance Minister of the Reich</hi> (<hi rendition="#italic">Dietrich</hi>) <hi
                        rendition="#italic">to the President of the Bank for
                            International Settlements</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Berlin</hi></placeName>, <date calendar="gregorian"
                            when="1931-11-19">November 19, 1931</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Mr. President</hi>: In the name of the German
                    Government I have the honour to transmit to the Bank for International
                    Settlements in Basle a Memorandum, in which the German Government applies for
                    the convocation of the Special Advisory Committee for which provision is made in
                    the New Plan.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">H. Dietrich</hi></signed></closer>
            </div>
        </body>
    </text>
