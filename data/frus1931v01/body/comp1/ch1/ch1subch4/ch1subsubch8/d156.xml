                <pb facs="0318" n="204" sameAs="frus:frus1931v01/pg204"/>

                <note rend="inline" type="source">462.00R296/4325</note>
                <head><hi rendition="#italic">The British Ambassador</hi> (<hi rendition="#italic"
                        >Lindsay</hi>) <hi rendition="#italic">to the Under Secretary of State</hi>
                        (<hi rendition="#italic">Castle</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1931-06-24">June 24, 1931</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. Under-Secretary</hi>: In accordance with my
                    instructions, I communicate to you herewith a statement which will be made today
                    in the House of Commons by the Chancellor of the Exchequer.</p>
                <p>Believe me [etc.]</p>
                <closer><signed><hi rendition="#small-caps">R. C. Lindsay</hi></signed></closer>



                <xi:include href="d156-a1.xml" xpointer="d156-a1"/>
