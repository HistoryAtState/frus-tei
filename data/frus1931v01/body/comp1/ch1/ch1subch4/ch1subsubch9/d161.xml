    <text>
        <body>
            <div xml:id="d161">

                <pb facs="0324" n="210" xml:id="pg210"/>

                <note rend="inline" type="source">462.00R296/4214: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Minister in
                        Greece</hi> (<hi rendition="#italic">Skinner</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1931-07-01T16:00:00-04:00">July 1, 1931—4
                    p.m.</date></dateline></opener>
                <p>19. Your 25, July 1, 1 a.m. Questions raised by Greek Government are being
                    considered. However, it will not be possible to give answers regarding these
                    questions until the larger issues now under negotiation have been
                        settled.<anchor n="8" xml:id="d161-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Castle</hi></signed></closer>
            </div>
        </body>
    </text>
