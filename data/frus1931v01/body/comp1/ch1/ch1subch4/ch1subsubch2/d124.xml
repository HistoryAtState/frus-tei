    <text>
        <body>
            <div xml:id="d124">

                <pb facs="0293" n="179" sameAs="frus:frus1931v01/pg179"/>

                <note rend="inline" type="source">462.00R296/4320</note>
                <head><hi rendition="#italic">The Belgian Ambassador</hi> (<hi rendition="#italic"
                        >May</hi>) <hi rendition="#italic">to the Acting Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1931-06-30">June 30, 1931</date>.</dateline>
                    <seg rendition="#float-left">No. 1819</seg></opener>
                <p><hi rendition="#small-caps">Dear Mr. Castle</hi>: I hasten to forward the text of
                    the considerations which the Belgian Government instructed me to transmit to you
                    verbally in handing you the official text of its reply to President Hoover’s
                    proposition.</p>
                <p>Believe me [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Paul May</hi></signed></closer>


                <xi:include href="d124-a1.xml" xpointer="d124-a1"/>
            </div>
