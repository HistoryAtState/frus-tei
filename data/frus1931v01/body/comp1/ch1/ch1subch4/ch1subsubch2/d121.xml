    <text>
        <body>
            <div xml:id="d121">

                <pb facs="0291" n="177" sameAs="frus:frus1931v01/pg177"/>

                <note rend="inline" type="source">462.00R296/4223</note>
                <head><hi rendition="#italic">The Belgian Ambassador</hi> (<hi rendition="#italic"
                        >May</hi>) <hi rendition="#italic">to the Acting Secretary of
                    State</hi></head>
                <opener><seg rendition="#center">[Translation]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1931-06-30">June 30, 1931</date>.</dateline>
                    <seg rendition="#float-left">No. 1816</seg></opener>
                <p><hi rendition="#small-caps">Mr. Under Secretary of State</hi>: I have the honor
                    to send Your Excellency herewith the reply made by the King’s Government to the
                    proposal of the President of the United States which Mr. Stimson communicated to
                    me orally on the 20th of June, last.</p>
                <p>I avail myself [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Paul May</hi></signed></closer>


                <xi:include href="d121-a1.xml" xpointer="d121-a1"/>
            </div>
