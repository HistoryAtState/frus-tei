    <text>
        <body>
            <div xml:id="d117">

                <pb facs="0289" n="175" sameAs="frus:frus1931v01/pg175"/>

                <note rend="inline" type="source">462.00R296/4120</note>
                <head><hi rendition="#italic">The Austrian Minister</hi> (<hi rendition="#italic"
                        >Prochnik</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1931-06-25">June 25, 1931</date>.</dateline>
                    <seg rendition="#float-left">No. 120/R</seg></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: Confirming my oral statement made on
                    Monday, June 22nd to the Undersecretary, Mr. Castle,<anchor n="57"
                        xml:id="d117-f1"/> I have the honor to renew to Your Excellency the
                    assurance that the Federal Government of the Republic of Austria is greatly
                    pleased to unconditionally accept the proposal of the President of the United
                    States in regard to debts and reparations.<anchor n="58" xml:id="d117-f2"/></p>
                <p>Accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Edgar Prochnik</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d117-f1" n="57" xml:id="d117-f1-content">
                <p>Memorandum of conversation not printed.</p>
            </note>
            <note corresp="#d117-f2" n="58" xml:id="d117-f2-content">
                <p>For text of President Hoover’s proposal, see telegram No. 262, June 20, 8 p.m.,
                    to the Ambassador in France, <ref target="#pg33">p. 33</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
