            <div xml:id="d151">

                <pb facs="0316" n="202" sameAs="frus:frus1931v01/pg202"/>

                <note rend="inline" type="source">462.00R296/4607</note>
                <head><hi rendition="#italic">The Czechoslovak Minister</hi> (<hi rendition="#italic">Veverka</hi>) <hi
                        rendition="#italic">to the Acting Secretary of
                            State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1931-07-15">July 15, 1931</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honour to communicate herewith
                    that the Government of the Czechoslovak Republic accepts with great pleasure,
                    both as creditor and debtor, the principles of the moratorium proposed by His
                    Excellency, President Hoover.</p>
                <p>In accepting this proposal of the United States the Czechoslovak Government
                    expresses its firm hope that it will mark the beginning of the economic revival
                    of the world.</p>
                <p>Accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Ferdinand Veverka</hi></signed></closer>
            </div>
        </body>
    </text>
