            <div xml:id="d106">

                <pb facs="0281" n="167" sameAs="frus:frus1931v01/pg167"/>

                <note rend="inline" type="source">462.00R296/4404</note>
                <head><hi rendition="#italic">The British Ambassador</hi> (<hi
                            rendition="#italic">Lindsay</hi>) <hi rendition="#italic">to
                        the Acting Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1931-07-10">10 July, 1931</date>.</dateline>
                    <seg rendition="#float-left">No. 235</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honour under instructions from
                    His Majesty’s Principal Secretary of State for Foreign Affairs to inform you
                    that His Majesty’s Government are desirous of holding a meeting of financial
                    experts at the Treasury, London, Friday July 17th at eleven a.m. to consider and
                    recommend measures necessary to give effect to Mr. Hoover’s proposal for a one
                    year’s suspension of inter-governmental payments.</p>
                <p>I am instructed to invite the United States Government to be represented at this
                    meeting.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">R. C. Lindsay</hi></signed></closer>
            </div>
        </body>
    </text>
