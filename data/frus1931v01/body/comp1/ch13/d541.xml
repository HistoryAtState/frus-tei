            <div xml:id="d541">

                <pb facs="0816" n="702" xml:id="pg702"/>

                <note rend="inline" type="source">511.4R1/55: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Minister in Siam</hi> (<hi rendition="#italic"
                            >Kaufman</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1931-10-17T12:00:00-05:00">October 17,
                        1931—noon</date>.</dateline></opener>
                <p>27. Please inform Foreign Office that Colonel Lucien R. Sweet of the Philippine
                    Constabulary is being sent to Bangkok to assist Caldwell at Conference on Opium
                    Smoking.</p>
                <closer><signed><hi rendition="#small-caps">Stimson</hi></signed></closer>
            </div>
        </body>
    </text>
