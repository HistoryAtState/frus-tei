                <pb facs="0705" n="591" sameAs="frus:frus1931v01/pg591"/>

                <note rend="inline" type="source">662.6331/277: Telegram</note>
                <head><hi rendition="#italic">The Chargé in the Netherlands</hi> (<hi rendition="#italic">Johnson</hi>) <hi
                        rendition="#italic">to the Acting Secretary of
                            State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >The Hague</hi></placeName>, <date calendar="gregorian"
                            when="1931-09-05T11:00:00+01:19">September 5, 1931—11
                        a.m.</date><lb/>[Received September 5—6:38 a.m.]</dateline></opener>
                <p>29. My telegram No. 28, September 3, 10 a.m.<anchor n="24" xml:id="d446-f1"/>
                    Court decides by eight votes to seven Customs Union not compatible with Geneva
                    Protocol.</p>
                <closer><signed><hi rendition="#small-caps">Johnson</hi></signed></closer>
            </div>
        </body>
    </text>
