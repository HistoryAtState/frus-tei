                <pb facs="1051" n="937" sameAs="frus:frus1931v01/pg937"/>

                <note rend="inline" type="source">325.1121 Bethune, Larry K./26: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Chile</hi> (<hi rendition="#italic">Culbertson</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Santiago</hi></placeName>, <date calendar="gregorian"
                            when="1931-04-02T19:00:00-05:00">April 2, 1931—7
                        p.m.</date><lb/>[Received 8:25 p.m.]</dateline></opener>
                <p>35. Department’s telegram 18, April 2, 2 p.m. Bethune’s detention incommunicado
                    was by order of the judge.</p>
                <closer><signed><hi rendition="#small-caps">Culbertson</hi></signed></closer>
            </div>
        </body>
