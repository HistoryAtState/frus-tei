                <pb facs="1032" n="918" sameAs="frus:frus1931v01/pg918"/>

                <note rend="inline" type="source">825.001 Montero, Juan/7</note>
                <head><hi rendition="#italic">The Chargé in Chile</hi> (<hi rendition="#italic"
                        >Norweb</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Santiago</hi></placeName>, <date calendar="gregorian"
                            when="1931-11-05">November 5, 1931</date>.<lb/>[Received November
                        14.]</dateline>
                    <seg rendition="#float-left">No. 1013</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In the event that the Department desires to
                    transmit a message of congratulation for President-elect Montero, I have the
                    honor to report that the inauguration will take place on December 5th.</p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">R. Henry Norweb</hi></signed></closer>
            </div>
        </body>
    </text>
