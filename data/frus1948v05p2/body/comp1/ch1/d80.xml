    <text>
        <body>
            <div xml:id="d80">

                <pb facs="0187" n="697" xml:id="pg697"/>

                <note rend="inline" type="source">501.BB Palestine/3–848: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the United States
                        Representative at the United Nations</hi> (<hi rendition="#italic"
                        >Austin</hi>)</head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1948-03-08T12:00:00-05:00">March 8,
                            1948—noon</date>.</dateline>
                </opener>
                <p>116. The President has approved draft statement on situation in Palestine after
                    May 15, 1948, with concluding remarks as set forth in Deptel 107, March 5, for
                    use if and when necessary.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Marshall</hi>
                    </signed>
                </closer>
            </div>
        </body>
