                <pb facs="0609" n="1119" sameAs="frus:frus1948v05p2/pg1119"/>

                <note rend="inline" type="source">501.BB Palestine/6–1748: Telegram</note>
                <head>
                    <hi rendition="#italic">The Vice Consul at Jerusalem</hi> (<hi
                        rendition="#italic">Burdett</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Jerusalem</hi></placeName>, <date
                            calendar="gregorian" when="1948-06-17">June 17, 1948</date>.</dateline>
                </opener>
                <p>932. Demarcation of “no man’s land” to be observed in Jerusalem during truce
                    finished night June 15 and complete agreement reached. Maps showing respective
                    front lines and accompanying protocol signed afternoon June 16 by Arab and
                    Jewish Commanders in presence of Truce Commission and Colonel Brunsson.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Burdett</hi>
                    </signed>
                </closer>
            </div>
        </body>
