    <text>
        <body>
            <div xml:id="d621">

                <pb facs="0918" n="1426" xml:id="pg1426"/>

                <note rend="inline" type="source">501.BB Palestine/9–2248: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Consulate General
                        at Jerusalem</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1948-09-27T17:00:00-05:00">September 27,
                            1948—5 p. m.</date>
                    </dateline>
                </opener>
                <p>929. Dept has informally emphasized (urtel 1323 Sept 22<anchor n="1"
                        xml:id="d621-f1"/>) to Israeli rep here urgent necessity demilitarization
                        Jerusalem.<anchor n="2" xml:id="d621-f2"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lovett</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d621-f1" n="1" xml:id="d621-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d621-f2" n="2" xml:id="d621-f2-content">
                <p>Telegram 929 was repeated to Tel Aviv.</p>
            </note>
        </listAnnotation>
    </standOff>
