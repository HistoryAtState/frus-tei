    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d357-f1" n="1" xml:id="d357-f1-content">
                <p>Messrs. Butler, Gufler, and Villard were members of the Policy Planning Staff;
                    Mr. Savage, who drafted these minutes, was the Staff’s Executive Secretary.</p>
            </note>
        </listAnnotation>
    </standOff>
