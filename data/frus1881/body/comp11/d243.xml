    <text>
        <body>
            <div xml:id="d243">

                <pb facs="0540" n="416" xml:id="pg416"/>

                <head>No. 239.<lb/><hi rendition="#italic">Mr. Pomeroy to Mr. Blaine</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1881-07-07"><hi rendition="#italic">July</hi> 7, 1881</date>.
                        (Received July 22.)</dateline>
                    <seg rendition="#float-left">No. 486.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith a
                    communication accompanied by a translation received to-day at this legation from
                    Mr. Senator Edmond de La Fayette, grandson of general the Marquis de La
                    Fayette.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>G. P. POMEROY.</signed></closer>


                <xi:include href="d243-a1.xml" xpointer="d243-a1"/>
