    <text>
        <body>
            <div xml:id="d445">

                <pb facs="0871" n="747" sameAs="frus:frus1881/pg747"/>

                <head>No. 441.<lb/><hi rendition="#italic">Mr. Morgan to Mr. Evarts.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1880-11-03"><hi rendition="#italic">November</hi> 3, 1880</date>.
                        (Received November 15.)</dateline>
                    <seg rendition="#float-left">No. 127.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose translation of a note received by
                    me from the foreign <pb facs="0872" n="748" xml:id="pg748"/> office, on the 27th
                    ultimo, from which you will observe that Victoria and a number of his warriors
                    have been killed, and a number taken prisoners.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>P. H. MORGAN.</signed></closer>


                <xi:include href="d445-a1.xml" xpointer="d445-a1"/>
            </div>
        </body>
    </text>
