    <text>
        <body>
            <div xml:id="d464">

                <pb facs="0896" n="772" sameAs="frus:frus1881/pg772"/>

                <head>No. 460.<lb/><hi rendition="#italic">Mr. Blaine to Mr. Morgan.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1881-07-11"><hi rendition="#italic">July</hi> 11,
                        1881</date>.</dateline>
                    <seg rendition="#float-left">No. 152.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit herewith a copy of a letter from
                    the Secretary of War, of the 7th instant, relative to the death of General
                    Servando Canales, <pb facs="0897" n="773" xml:id="pg773"/> of the army of
                    Mexico, accompanied by a telegram addressed to the commanding officer at Fort
                    Brown, Texas, directing that appropriate arrangements be made for assisting at
                    the funeral ceremonies of General Canales, and expressing profound sentiments of
                    regret at the decease of so distinguished a soldier.</p>
                <p>You will suitably bring these facts to the knowledge of the proper authorities of
                    the Mexican Government for their information.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>JAMES G. BLAINE.</signed></closer>



                <xi:include href="d464-a1.xml" xpointer="d464-a1"/>
                <xi:include href="d464-a2.xml" xpointer="d464-a2"/>
