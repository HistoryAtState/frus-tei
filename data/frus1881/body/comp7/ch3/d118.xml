                <pb facs="0286" n="162" sameAs="frus:frus1881/pg162"/>

                <head>No. 118.<lb/><hi rendition="#italic">Mr. Martinez to Mr. Blaine</hi>.</head>
                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <p>The envoy extraordinary and minister plenipotentiary of Chili has the honor to
                    present his respects to his excellency the Secretary of State, and to inclose
                    herewith, pursuant to the request his excellency was pleased to make, a copy of
                    the confidential dispatch of the minister for foreign affairs of Chili, dated
                    the 12th of September last.</p>
                <closer><dateline rendition="#float-left"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1881-10-27"><hi rendition="#italic">October</hi> 27,
                        1881</date>.</dateline></closer>


                <xi:include href="d118-a1.xml" xpointer="d118-a1"/>
