    <text>
        <body>
            <div xml:id="d429">

                <pb facs="0850" n="726" sameAs="frus:frus1881/pg726"/>

                <head>No. 425.<lb/><hi rendition="#italic">Mr. Blaine to Mr. Bingham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1881-03-22"><hi rendition="#italic">March</hi> 22,
                        1881</date>.</dateline>
                    <seg rendition="#float-left">No. 576.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    dispatch No. 1250 of the 7th ultimo, and to approve your action reported
                    therein, in respect of the order amending the consular court regulations as to
                    the punishment for crimes and offenses against the laws of the United
                    States.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>JAMES G. BLAINE.</signed></closer>
            </div>
        </body>
    </text>
