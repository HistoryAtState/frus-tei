    <text>
        <body>
            <div xml:id="d430-a1">

                <pb facs="0851" n="727" sameAs="frus:frus1881/pg727"/>

                <opener><seg rendition="#center">[Inclosure with 1320.—Translation.]</seg></opener>
                <p>Proclamation is hereby made that the following rules for the government of
                    assemblies for investigating the subjects of agriculture, commerce, and
                    manufactures have been enacted with a view to the establishment and development
                    of said industries in the provinces of the Empire of Japan.</p>
                <closer><signed>SANJO SANEYOSHI,<lb/><hi rendition="#italic">Prime
                        Minister.</hi></signed>
                    <lb/>
                    <dateline rendition="#float-left"><date calendar="gregorian" when="1881-05-23"
                                ><hi rendition="#small-caps">May</hi> 23, 1881</date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
