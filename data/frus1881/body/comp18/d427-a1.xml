    <text>
        <body>
            <div xml:id="d427-a1">

                <pb facs="0816" n="692" sameAs="frus:frus1881/pg692"/>

                <opener><seg rendition="#center">[Inclosure in No.
                    1266.—Translation.]</seg></opener>
                <p rendition="#center">No. 37.</p>
                <p>Proclamation is hereby made that the following code of procedure has been drawn
                    up. The time when it will go into effect will be published by government
                    proclamation hereafter.</p>
                <closer><signed>TARU-HITO (ARISUGAWA),<lb/><hi rendition="#italic">Junior Prime
                            Minister.</hi></signed>
                    <lb/>
                    <dateline rendition="#float-left"><date calendar="gregorian" when="1880-07-17"
                                ><hi rendition="#small-caps">July</hi> 17, 1880</date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
