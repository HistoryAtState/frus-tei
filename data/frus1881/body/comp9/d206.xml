    <text>
        <body>
            <div xml:id="d206">

                <pb facs="0481" n="357" sameAs="frus:frus1881/pg357"/>

                <head>No. 206.<lb/><hi rendition="#italic">Mr. Blaine to Mr. Maney</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1881-07-25"><hi rendition="#italic">July</hi> 25,
                        1881</date>.</dateline>
                    <seg rendition="#float-left">No. 3.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I forward herewith, for your information, a
                    copy of my instruction<anchor n="*" xml:id="d206-f1"/> to Mr. James R. Lowell,
                    United States minister at London, of the 24th ultimo, relative to an
                    interoceanic canal across the Isthmus of Panama.</p>
                <p>A similar instruction was also addressed to the representatives of this
                    government accredited to the seveal European Governments.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>JAMES G. BLAINE.</signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d206-f1" n="*" xml:id="d206-f1-content">
                <p>For inclosure see under Great Britain.</p>
            </note>
        </listAnnotation>
    </standOff>
