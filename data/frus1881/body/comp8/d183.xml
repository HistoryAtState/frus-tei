                <pb facs="0440" n="316" sameAs="frus:frus1881/pg316"/>

                <head>No. 182.<lb/><hi rendition="#italic">Mr. Hunter to Mr. Angell</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1881-10-06"><hi rendition="#italic">October</hi> 6,
                        1881</date>.</dateline>
                    <seg rendition="#float-left">No. 126.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your dispatch No. 190, of July 28 last,
                    relative to the purchase of land by foreigners at Canton, has been received, and
                    your action, with respect to that subject, is approved.</p>
                <p>I am, sir, &amp;c.,</p>
                <closer><signed>W. HUNTER,<lb/><hi rendition="#italic">Acting
                        Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
