    <text>
        <body>
            <div xml:id="d185">

                <pb facs="0441" n="317" xml:id="pg317"/>

                <head>No. 184.<lb/><hi rendition="#italic">Mr. Blaine to Mr. Angell</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1881-11-17"><hi rendition="#italic">November</hi> 17,
                        1881</date>.</dateline>
                    <seg rendition="#float-left">No. 135.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your dispatches numbered 177 to 216, both
                    inclusive, have been received. Your action, reported in your No. 206, of August
                    30 last, respecting the service of summons on absent defendants in proceedings
                    before the United States consular courts in China, is approved,</p>
                <p>I am, sir. &amp;c.,</p>
                <closer><signed>JAMES G. BLAINE.</signed></closer>
            </div>
        </body>
    </text>
