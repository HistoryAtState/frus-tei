                <pb facs="1112" n="988" sameAs="frus:frus1881/pg988"/>

                <opener><seg rendition="#center">[Inclosure 2 in No. 69.]</seg></opener>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <head><hi rendition="#italic">Mr. Schuyler to Mr. Blaine.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Bucharest</hi></placeName>, <date calendar="gregorian"
                            when="1881-05-21T14:00:00+01:44">2 <hi rendition="#italic">p.m.,
                                May</hi> 21, 1881</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Blaine</hi>, <hi rendition="#italic">Secretary,
                        Washington, Columbia District:</hi></p>
                <p>Coronation to morrow, Sunday. President’s letter not arrived. Would suggest
                    direct telegram to the King.</p>
                <closer><signed>SCHUYLER.</signed></closer>
            </div>
        </body>
