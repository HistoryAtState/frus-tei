    <text>
        <body>
            <div xml:id="d601-a3">

                <pb facs="1106" n="982" sameAs="frus:frus1881/pg982"/>

                <opener><seg rendition="#center">[Inclosure 3 in No. 50.]</seg></opener>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <head><hi rendition="#italic">Mr. Schuyler to Mr. Blaine.</hi></head>
                <p rendition="#flush">Secretary <hi rendition="#small-caps">Blaine</hi>, <hi
                        rendition="#italic">Washington District of Columbia:</hi></p>
                <p>Prince Charles proclaimed King of Roumania. Please telegraph instructions for
                    recognition.</p>
                <closer><signed>SCHUYLER.</signed>
                    <lb/>
                    <dateline rendition="#float-left">(Sent <date calendar="gregorian"
                            when="1880-03-26">March 26, 3.30 p.m.</date>)</dateline>
                </closer>
            </div>
        </body>
    </text>
