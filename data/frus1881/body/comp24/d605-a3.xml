    <text>
        <body>
            <div xml:id="d605-a3">

                <pb facs="1112" n="988" sameAs="frus:frus1881/pg988"/>

                <opener><seg rendition="#center">[Inclosure 3 in No. 69.]</seg></opener>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <head><hi rendition="#italic">Mr. Blaine to Mr. Schuyler.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington.</hi></placeName> [<date
                            ana="#date_undated-inferred-from-document-content-and-sibling-dates"
                            calendar="gregorian" notAfter="1881-05-21T23:59:59+01:44"
                            notBefore="1881-05-21T14:00:00+01:44" when="1881-05-21"
                        >undated</date>].</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Schuyler</hi>, <hi
                        rendition="#italic">Chargé, Bucharest, Roumania:</hi></p>
                <p>Convey cordial congratulations of President on King Charles’s coronation
                    to-morrow, <pb facs="1113" n="989" xml:id="pg989"/> and sincere wish that it may
                    bring a new era of happiness to His Majesty and prosperity to the Roumanian
                    nation.</p>
                <closer><signed>BLAINE,<lb/><hi rendition="#italic"
                    >Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
