    <text>
        <body>
            <div xml:id="d28-a2">

                <pb facs="0163" n="39" sameAs="frus:frus1881/pg39"/>

                <opener><seg rendition="#center">[Inclosure 2 in No.
                    432.—Translation.]</seg></opener>
                <head><hi rendition="#italic">Mr. Kasson to Mr.
                            Erasmus</hi>.</head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Jacob Erasmus</hi>, <hi
                        rendition="#italic">Radomysl:</hi></p>
                <p>Your case is before ministry for foreign affairs. Immediate action requested in
                    your behalf.</p>
                <closer><signed>KASSON.</signed>
                    <lb/>
                    <dateline rendition="#float-left"><date calendar="gregorian" when="1881-02-17"
                                ><hi rendition="#small-caps">February</hi> 17,
                        1881</date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
