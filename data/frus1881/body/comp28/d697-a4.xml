    <text>
        <body>
            <div xml:id="d697-a4">

                <pb facs="1276" n="1152" sameAs="frus:frus1881/pg1152"/>

                <opener><seg rendition="#center">[Inclosure 11 in No.
                    398.—Translation.]</seg></opener>
                <head><hi rendition="#italic">Certificate of Jacob Baur, farmer, respecting Felix
                        Trachsler.</hi></head>
                <p rendition="#center"><hi rendition="#small-caps">certificate</hi>.</p>
                <p>The undersigned hereby certifies that Felix Trachsler was in his service for a
                    year and a half, viz, from July, 1879, to Christmas, 1880, and did his work
                    satisfactorily, receiving therefor, summer and winter, 4 francs (77.2 cents) per
                    week wages.</p>
                <closer><signed>JACOB BAUR, <hi rendition="#italic">Farmer.</hi></signed>
                    <lb/>
                    <dateline rendition="#float-left"><placeName><hi rendition="#small-caps"
                                >Birmensdorf</hi></placeName>, <date calendar="gregorian"
                            when="1881-04-21"><hi rendition="#italic">April</hi> 21,
                        1881</date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
