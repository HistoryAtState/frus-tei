    <text>
        <body>
            <div xml:id="d697-a2">

                <pb facs="1275" n="1151" sameAs="frus:frus1881/pg1151"/>

                <opener><seg rendition="#center">[Inclosure 7 in No. 398.]</seg></opener>
                <head><hi rendition="#italic">Mr. Syz to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Consulate</hi>,<lb/><hi rendition="#italic"
                                >Zurich</hi></placeName>, <date calendar="gregorian"
                            when="1881-04-25"><hi rendition="#italic">April</hi> 25,
                        1881</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: * * * The authorities of Birmensdorf, in
                    answer to my investigations of the Felix Trachsler emigration, send me the
                    inclosed letter.</p>
                <p>I hereby return the two newspaper clippings, of which a copy is filed at this
                    office.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>JOHN SYZ,<lb/><hi rendition="#italic">United States
                            Vice-Consul.</hi></signed></closer>
            </div>
        </body>
