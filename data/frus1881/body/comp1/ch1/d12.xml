                <pb facs="0140" n="16" sameAs="frus:frus1881/pg16"/>

                <head>No. 12.<lb/><hi rendition="#italic">Mr. Carrié to Mr. Blaine</hi>.</head>
                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Argentine Legation</hi>,<lb/><hi rendition="#italic">New
                            York</hi></placeName>, <date calendar="gregorian" when="1881-11-28"><hi
                                rendition="#italic">November</hi> 28, 1881</date>. (Received
                        November 29.)</dateline></opener>
                <p><hi rendition="#small-caps">Mr. Secretary of State</hi>: I have the honor
                    herewith to inclose a communication which this legation has just received from
                    the ministry of foreign relations of the Argentine Republic, addressed to your
                    excellency, and which my government instructs me to transmit to you.</p>
                <p>In so doing I take pleasure in reiterating to your excellency the assurance,
                    &amp;c.,</p>
                <closer><signed>JULIO CARRIÉ.</signed></closer>



                <xi:include href="d12-a1.xml" xpointer="d12-a1"/>
            </div>
        </body>
