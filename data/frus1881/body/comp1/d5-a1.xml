    <text>
        <body>
            <div xml:id="d5-a1">

                <pb facs="0133" n="9" sameAs="frus:frus1881/pg9"/>

                <opener><seg rendition="#center">[Inclosure 1 in No. 329.]</seg></opener>
                <head><hi rendition="#italic">Mr. Irigoyen to Mr.
                            Osborn</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Foreign Office</hi></placeName>, <date calendar="gregorian"
                            when="1881-07-20"><hi rendition="#italic">July</hi> 20,
                        1881</date>.</dateline>
                    <seg rendition="#float-left">Private.]</seg></opener>
                <p><hi rendition="#small-caps">My Esteemed Mr. Minister</hi>: I have the honor to
                    communicate to you that the Chilian Government has sent, by telegraph, powers to
                    Mr. Echevarria, its consul-general, for the signing of the arrangement which we
                    have arrived at through the cooperation of you and your honorable colleague in
                    Chili.</p>
                <p>Accept, &amp;c.,</p>
                <closer><signed>BERNARDO <hi rendition="#small-caps">de</hi>
                    IRIGOYEN.</signed></closer>
            </div>
        </body>
