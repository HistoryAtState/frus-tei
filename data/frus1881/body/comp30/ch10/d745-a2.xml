    <text>
        <body>
            <div xml:id="d745-a2">

                <pb facs="1340" n="1216" xml:id="pg1216"/>

                <opener><seg rendition="#center">[Inclosure 2 in No. 431.]</seg></opener>
                <head><hi rendition="#italic">Mr. Baker to Señor Seijas.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Caracas</hi></placeName>, <date calendar="gregorian"
                            when="1881-07-13"><hi rendition="#italic">July</hi> 13,
                        1881</date>.</dateline></opener>
                <p>Mr. <hi rendition="#small-caps">Minister</hi>: I have the honor to acknowledge
                    the receipt of your excellency’s note of this date, relative to the difficulties
                    between your excellency’s government and that of France, and to assure your
                    excellency that I shall, by the earliest opportunity, bring your excellency’s
                    said note to the knowledge of my government.</p>
                <p>I avail myself, &amp;c.,</p>
                <closer><signed>JEHU BAKER.</signed></closer>
            </div>
        </body>
