    <text>
        <body>
            <div xml:id="d660-a2">

                <pb facs="1189" n="1065" sameAs="frus:frus1881/pg1065"/>

                <opener><seg rendition="#center">[Appendix 1 to inclosure in 195.]</seg></opener>
                <head><hi rendition="#small-caps">Spanish Consulate-General</hi>.</head>
                <p>By orders received from Madrid, on and after October 31, vessels going to Cuba
                    and Porto Rico will pay in this office the same clearance fees as vessels bound
                    for Spain.</p>
                <closer>
                    <dateline rendition="#float-left"><placeName>New York</placeName>, <date
                            calendar="gregorian" when="1881-10-24">October 24,
                        1881</date>.</dateline>
                    <lb/>
                    <signed>HIPOLITO <hi rendition="#small-caps">de</hi> URIARTE,<lb/><hi
                            rendition="#italic">Consul-General</hi>.</signed></closer>
            </div>
        </body>
    </text>
