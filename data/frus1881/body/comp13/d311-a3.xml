    <text>
        <body>
            <div xml:id="d311-a3">

                <pb facs="0632" n="508" sameAs="frus:frus1881/pg508"/>

                <opener><seg rendition="#center">[Inclosure 3 in No. 138]</seg></opener>
                <head><hi rendition="#italic">Mr. Lowell to Lord
                            Granville.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation</hi>, &amp;c.</placeName>, <date calendar="gregorian"
                            when="1881-02-24"><hi rendition="#italic">February</hi> 24,
                        1881</date>.</dateline></opener>
                <p><hi rendition="#small-caps">. Dear Lord Granville</hi>: May I ask to see you a
                    moment at the foreign office this afternoon at three? I have an important
                    telegram the substance of which I should be glad to communicate. It may settle
                    the whole matter.</p>
                <p>Very sincerely, yours,</p>
                <closer><signed>J. R. LOWELL.</signed></closer>
            </div>
        </body>
