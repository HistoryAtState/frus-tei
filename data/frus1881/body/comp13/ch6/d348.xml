    <text>
        <body>
            <div xml:id="d348">

                <pb facs="0696" n="572" sameAs="frus:frus1881/pg572"/>

                <head>No. 344.<lb/><hi rendition="#italic">Sir Edward
                            Thornton to Mr. Evarts</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1880-11-26"><hi rendition="#italic">November</hi> 26, 1880</date>.
                        (Received November 27.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to previous correspondence,
                    I have the honor to transmit herewith copy of a report of the privy council of
                    Canada, concerning <pb facs="0697" n="573" xml:id="pg573"/> the system of
                    “wrecking on the great lakes,” which has been forwarded to this legation by the
                    governor-general of Canada.</p>
                <p>I have. &amp;c.,</p>
                <closer><signed>EDW’D THORNTON.</signed></closer>


                <xi:include href="d348-a1.xml" xpointer="d348-a1"/>
            </div>
