    <text>
        <body>
            <div xml:id="d323-a2">

                <pb facs="0648" n="524" sameAs="frus:frus1881/pg524"/>

                <opener><seg rendition="#center">[Inclosure 2 in No. 154.]</seg></opener>
                <head><hi rendition="#italic">Mr. Lowell to Mr. Boyton</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1881-04-02"><hi rendition="#italic">April</hi> 2,
                        1881</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: For reasons which sufficiently appear in
                    the correspondence which I have already had with you upon the subject, I beg to
                    inform you that I decline to accept the passport issued by Mr. Seward in
                    November, 1866, as evidence of your American citizenship.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer><signed>
                        <list>
                            <item>J. R. LOWELL.</item>
                            <item>Mr. <hi rendition="#small-caps">M. P. Boyton</hi>,<lb/><hi
                                    rendition="#italic">Kilmainham Prison, Dublin.</hi></item>
                        </list>
                    </signed></closer>
            </div>
        </body>
    </text>
