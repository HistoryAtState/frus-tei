    <text>
        <body>
            <div xml:id="d580">

                <pb facs="1069" n="945" sameAs="frus:frus1881/pg945"/>

                <head>No. 576.<lb/><hi rendition="#italic">Mr. Blaine to Mr. Hurlburt.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1881-10-31"><hi rendition="#italic">October</hi> 31,
                        1881</date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Hurlbut</hi>, <hi
                        rendition="#italic">Minister, Lima:</hi></p>
                <p>Continue to recognize Calderon government until otherwise specially
                    instructed.</p>
                <p>Acknowledge receipt.</p>
                <closer><signed>BLAINE.</signed></closer>
            </div>
        </body>
