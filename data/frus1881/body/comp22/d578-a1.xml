    <text>
        <body>
            <div xml:id="d578-a1">

                <pb facs="1066" n="942" sameAs="frus:frus1881/pg942"/>

                <opener><seg rendition="#center">[Inclosure in No. 21.]</seg></opener>
                <head><hi rendition="#italic">General Kilpatrick to Mr. Hurlbut</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Ville del Mar</hi></placeName>, <date calendar="gregorian"
                            when="1881-09-30"><hi rendition="#italic">September</hi> 30,
                        1881</date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear General</hi>: * * * I am very ill, and have
                    been for two months. I should not like to die here, and yet I may.</p>
                <p>Yours,</p>
                <closer><signed>KILPATRICK.</signed></closer>
            </div>
        </body>
    </text>
