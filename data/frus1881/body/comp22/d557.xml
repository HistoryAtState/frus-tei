    <text>
        <body>
            <div xml:id="d557">

                <pb facs="1033" n="909" sameAs="frus:frus1881/pg909"/>

                <head>No. 553.<lb/><hi rendition="#italic">Mr. Blaine to Mr. Christiancy.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1881-05-12"><hi rendition="#italic">May</hi> 12,
                        1881</date>.</dateline>
                    <seg rendition="#float-left">No. 144.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    No. 282, and to approve the tenor of your letter (a copy of which you inclose)
                    to Mr. Kauffmann, consular agent, &amp;c., on the question of the right of
                    Peruvian or Chilian authorities to levy forced or extraordinary contributions
                    upon American citizens in Peru.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>JAMES G. BLAINE.</signed></closer>
            </div>
        </body>
    </text>
