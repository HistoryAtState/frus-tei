                <pb facs="0197" n="73" sameAs="frus:frus1881/pg73"/>

                <head>No. 52.<lb/><hi rendition="#italic">Mr. Putnam to Mr. Blaine</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Brussels</hi></placeName>, <date calendar="gregorian"
                            when="1881-06-20"><hi rendition="#italic">June</hi> 20, 1881</date>.
                        (Received July 4.)</dateline>
                    <seg rendition="#float-left">No. 73.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to your dispatch No. 45, I have
                    the honor to send copy of my last note to the foreign office, and of its reply,
                    received today.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>JAMES O. PUTNAM.</signed></closer>



                <xi:include href="d52-a1.xml" xpointer="d52-a1"/>
