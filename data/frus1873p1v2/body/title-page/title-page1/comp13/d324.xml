    <text>
        <body>
            <div xml:id="d324">

                <pb facs="0811" n="[1441]" sameAs="frus:frus1873p1v2/pg1441"/>

                <head><hi rendition="#italic">Mr. <persName corresp="#p_AC1">Campbell</persName> to
                        Mr. <persName corresp="#p_HF1">Fish</persName></hi>.</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">United
                                States Northern Boundary Commission</hi>,<lb/><hi
                                rendition="#italic">Annandale, Dutchess County, N.
                            Y.</hi></placeName>, <date calendar="gregorian" when="1873-11-22"><hi
                                rendition="#italic">November</hi> 22, 1873</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: Incompliance with the request contained in
                    your letter of the 10th instant, I have the honor to transmit herewith the copy
                    of a report from Major <persName>Twining</persName>, the chief astronomer,
                    containing the information you desired me to communicate to the Department.</p>
                <p>I have, &amp;c.,</p>
                <closer>
                    <signed><persName corresp="#p_AC1">ABCHIBALD CAMPBELL</persName>.</signed>
                </closer>


                <xi:include href="d324-a1.xml" xpointer="d324-a1"/>
            </div>
