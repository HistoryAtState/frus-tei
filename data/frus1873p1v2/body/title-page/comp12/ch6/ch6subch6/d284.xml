    <text>
        <body>
            <div xml:id="d284">

                <pb facs="0750" n="1380" sameAs="frus:frus1873p1v2/pg1380"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Stuttgart</hi></placeName>, <date calendar="gregorian"
                            when="1868-07-14"><hi rendition="#italic">July</hi> 14,
                        1868</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">My Lord</hi>: In conformity with your lordship’s
                    instructions of the 12th June, I have the honor to inclose herewith translation
                    of a note addressed by Baron Freydorf to Mr.
                        Baillie, containing information with respect to the
                    position of aliens in the Grand Duchy of Baden, from which it will be perceived
                    that aliens are practically subject there to no disabilities whatever, except
                    exclusion from political and municipal rights.</p>
                <p>I have, &amp;c.,</p>
                <closer>
                    <signed>G. J. R. GORDON.</signed>
                </closer>
                <postscript>
                    <p>Lord <hi rendition="#small-caps">Stanley</hi>, M. P.,<lb/><hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c</hi>.</p>
                </postscript>


                <xi:include href="d284-a1.xml" xpointer="d284-a1"/>
