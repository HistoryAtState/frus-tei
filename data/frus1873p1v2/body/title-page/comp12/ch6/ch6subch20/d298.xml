    <text>
        <body>
            <div xml:id="d298">

                <pb facs="0782" n="1412" sameAs="frus:frus1873p1v2/pg1412"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Stockholm</hi></placeName>, <date calendar="gregorian"
                            when="1868-07-31"><hi rendition="#italic">July</hi> 31,
                        1868</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">My Lord</hi>: I have the honor to inclose copy of a
                    letter I have received from Count Wachtmeister, forwarding for the information
                    of Her Majesty’s government a memorandum of the disabilities to which foreigners
                    residing in Sweden are subjected by the Swedish laws.</p>
                <p>I have, &amp;c.,</p>
                <closer>
                    <signed>J. PAKENHAM.</signed>
                </closer>
                <postscript>
                    <p>The Lord <hi rendition="#small-caps">Stanley</hi>, M. P., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c</hi>.</p>
                </postscript>



                <xi:include href="d298-a1.xml" xpointer="d298-a1"/>
