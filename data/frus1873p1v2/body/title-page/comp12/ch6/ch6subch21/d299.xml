    <text>
        <body>
            <div xml:id="d299">

                <pb facs="0783" n="1413" sameAs="frus:frus1873p1v2/pg1413"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Berne</hi></placeName>, <date calendar="gregorian"
                            when="1868-07-04"><hi rendition="#italic">July</hi> 4,
                        1868</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">My Lord</hi>: In obedience to the instructions
                    contained in your lordship’s dispatch of the 16th ultimo, I have the honor to
                    inclose herewith copy of a note dated the 26th ultimo, from the federal council,
                    giving an account of the disabilities to which aliens residing in Switzerland
                    are subjected by law.</p>
                <p>I have, &amp;c.</p>
                <closer>
                    <signed>J. SAVILLE LUMLEY.</signed>
                </closer>
                <postscript>
                    <p>To the Right Hon. the Lord <hi rendition="#small-caps">Stanley</hi>, M. P.,
                            <hi rendition="#italic">&amp;c</hi>.</p>
                </postscript>


                <xi:include href="d299-a1.xml" xpointer="d299-a1"/>
