    <text>
        <body>
            <div xml:id="d297">

                <pb facs="0779" n="1409" sameAs="frus:frus1873p1v2/pg1409"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Dresden</hi></placeName>, <date calendar="gregorian"
                            when="1868-09-04"><hi rendition="#italic">September</hi> 4,
                        1868</date>.</dateline>
                    <seg rendition="#float-left">No. 39.]</seg>
                </opener>
                <p><hi rendition="#small-caps">My Lord</hi>: With reference to your lordship’s
                    circular dispatch of the 16th June last, directing me to report on the
                    disabilities to which aliens residing in Saxony are subjected by Saxon law, I
                    have the honor to inclose in a copy and translation the information which has
                    been kindly furnished me on the subject by the Saxon government.</p>
                <p>I have, &amp;c.,</p>
                <closer>
                    <signed>J. HUME BURNLEY.</signed>
                </closer>
                <postscript>
                    <p>The Lord <hi rendition="#small-caps">Stanley</hi>, M. P., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c</hi>.</p>
                </postscript>



                <xi:include href="d297-a1.xml" xpointer="d297-a1"/>
