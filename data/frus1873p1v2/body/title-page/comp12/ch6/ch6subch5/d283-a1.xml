    <text>
        <body>
            <div xml:id="d283-a1">

                <pb facs="0749" n="1379" sameAs="frus:frus1873p1v2/pg1379"/>

                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Vienna</hi></placeName>, <date calendar="gregorian"
                            when="1868-06-22"><hi rendition="#italic">June</hi> 22,
                        1868</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">M. Le <persName corresp="#p_BL1"
                        >Baron</persName></hi>: Her Majesty’s government being desirous to obtain
                    information for the use of the naturalization commission, now sitting in London,
                    respecting the disabilities, if any, to which aliens residing in Austria are
                    subjected by Austrian law, I have the honor to request your excellency’s good
                    offices in procuring the information required as soon as it can be conveniently
                    furnished by the imperial government.</p>
                <p>I avail, &amp;c.,</p>
                <closer>
                    <signed>BLOOMFIELD.</signed>
                </closer>
                <postscript>
                    <p>His Excellency the <hi rendition="#small-caps">Baron <persName>be
                                Beust</persName></hi>,<lb/><hi rendition="#italic">&amp;c., &amp;c.,
                            &amp;c</hi>.</p>
                </postscript>
            </div>
        </body>
    </text>
