    <text>
        <body>
            <div xml:id="d290">

                <pb facs="0758" n="1388" sameAs="frus:frus1873p1v2/pg1388"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Athens</hi></placeName>, <date calendar="gregorian"
                            when="1868-07-16"><hi rendition="#italic">July</hi> 16,
                        1868</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">My Lord</hi>: In compliance with the instructions
                    contained in your lordship’s dispatch of the 16th ultimo, I have the honor to
                    transmit herewith to your lordship a copy of a report drawn up by the lawyer
                    employed by this legation, on the subject of the disabilities to which aliens
                    residing in Greece are subjected by Greek law.</p>
                <p>I have, &amp;c.,</p>
                <closer>
                    <signed>E. M. ERSKINE.</signed>
                </closer>
                <postscript>
                    <p>The Rt. Hon. Lord <hi rendition="#small-caps">Stanley</hi>, M. P.,
                        &amp;c.</p>
                </postscript>


                <xi:include href="d290-a1.xml" xpointer="d290-a1"/>
