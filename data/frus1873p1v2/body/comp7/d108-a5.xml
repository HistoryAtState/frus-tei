    <text>
        <body>
            <div xml:id="d108-a5">

                <pb facs="0383" n="1013" sameAs="frus:frus1873p1v2/pg1013"/>

                <opener>
                    <seg rendition="#center">[Inclosure F.—Translation.]</seg>
                </opener>
                <head><hi rendition="#italic">General Contreras to
                        Mr. Cirilo Molina</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Federal Army, Canton of Murcia.</hi>
                        </placeName>
                    </dateline>
                </opener>
                <p rendition="#center">(<hi rendition="#italic">Appendix</hi> 1.—<hi
                        rendition="#italic">Mr. Molina’s letter.</hi>)</p>
                <p>I have the honor to transmit the accompanying note to you as the representative
                    in this port of the government of your nation, in order that you may be pleased
                    to give it due course, and requesting you to kindly acknowledge its receipt.</p>
                <p>Health and federation.</p>
                <closer>
                    <dateline rendition="#float-left"><placeName><hi rendition="#small-caps"
                                >Cartagena</hi></placeName>, <date calendar="gregorian"
                            when="1873-07-23"><hi rendition="#italic">July</hi> 23,
                        1873</date>.</dateline>
                    <lb/>
                    <signed><hi rendition="#italic">The General-in-chief</hi>,<lb/>JUAN
                            CONTRERAS.</signed>
                </closer>
                <postscript>
                    <p>To the <hi rendition="#small-caps">United States Consul.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
