    <text>
        <body>
            <div xml:id="d52-a1">

                <pb facs="0200" n="830" xml:id="pg830"/>

                <opener>
                    <seg rendition="#center">[Inclosure.—Translation.]</seg>
                </opener>
                <p rendition="#flush">(Received November 30, 1872, 11 p.m.)</p>
                <p rendition="#right"><hi rendition="#small-caps">Presidency of the Council of
                        Ministers</hi>.</p>
                <p><hi rendition="#small-caps">My Dear General</hi>: I beg that you will not go to
                    bed, but will await me to-night. I will go to see you, whatever may be the
                    hour.</p>
                <p>Your affectionate friend,</p>
                <closer>
                    <signed>C. MARTOS.</signed>
                </closer>
            </div>
        </body>
    </text>
