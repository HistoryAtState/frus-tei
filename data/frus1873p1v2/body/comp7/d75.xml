                <pb facs="0257" n="887" sameAs="frus:frus1873p1v2/pg887"/>

                <head>No. 381.<lb/><hi rendition="#italic">General <persName corresp="#p_DES1"
                            type="from">Sickles</persName> to Mr. <persName corresp="#p_HF1"
                            type="to">Fish</persName>.</hi></head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1873-02-11"><hi rendition="#italic">February</hi> 11,
                        1873</date>.</dateline>
                </opener>
                <p>Chamber of Deputies declares itself in permanent session on motion of Figueras,
                    republican deputy.</p>
                <closer>
                    <signed><persName corresp="#p_DES1">SICKLES</persName>.</signed>
                </closer>
            </div>
