    <text>
        <body>
            <div xml:id="d154">

                <pb facs="0482" n="1112" xml:id="pg1112"/>

                <head>No. 460.<lb/><hi rendition="#italic">Mr. <persName corresp="#p_GHB1"
                            type="from">Boker</persName> to Mr. <persName corresp="#p_HF1" type="to"
                            >Fish</persName>.</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1873-04-21"><hi rendition="#italic">April</hi> 21, 1873</date>.
                        (Received May 12.)</dateline>
                    <seg rendition="#float-left">No. 98.]</seg>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor herewith to transmit a
                    copy of the regulations for the organization of the new courts of law proposed
                    to be established in Egypt, as settled by the commission lately in session at
                    Constantinople, together with a translation of the same.</p>
                <p>I have, &amp;c.,</p>
                <closer>
                    <signed>
                        <persName corresp="#p_GHB1">GEORGE H. BOKER.</persName>
                    </signed>
                </closer>


                <xi:include href="d154-a1.xml" xpointer="d154-a1"/>
            </div>
        </body>
    </text>
