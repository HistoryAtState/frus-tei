    <text>
        <body>
            <div xml:id="d18">

                <pb facs="0116" n="746" sameAs="frus:frus1873p1v2/pg746"/>

                <head>No. 324.<lb/><hi rendition="#italic">Mr. <persName corresp="#p_FT1"
                            type="from">Thomas</persName> to Mr. <persName corresp="#p_HF1"
                            type="to">Fish</persName>.</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Lima, Peru</hi></placeName>, <date calendar="gregorian"
                            when="1872-10-21"><hi rendition="#italic">October</hi> 21, 1872</date>.
                        (Received November 18.)</dateline>
                    <seg rendition="#float-left">No. 12.]</seg>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith one
                    printed copy of President Pardo’s inaugural address, and one printed copy of his
                    special message to Congress, concerning the financial affairs of Peru; both of
                    which were delivered by him in person orally.</p>
                <p>I am, &amp;c.,</p>
                <closer>
                    <signed><persName corresp="#p_FT1">FRANCIS THOMAS</persName>.</signed>
                </closer>



                <xi:include href="d18-a1.xml" xpointer="d18-a1"/>
                <xi:include href="d18-a2.xml" xpointer="d18-a2"/>
