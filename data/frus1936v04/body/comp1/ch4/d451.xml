            <div xml:id="d451">

                <pb facs="0544" n="449" xml:id="pg449"/>

                <note rend="inline" type="source">893.00/13837: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        China</hi> (<hi rendition="#italic">Johnson</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1936-12-25T23:00:00-05:00">December 25, 1936—11
                        p.m.</date></dateline>
                </opener>
                <p>90. Your 380, December 25, 7 p.m. If news of Generalissimo Chiang Kai-shek’s
                    release is confirmed and his safety assured, please express appropriately to
                    Foreign Office this Government’s gratification.</p>
                <closer><signed><hi rendition="#small-caps">Moore</hi></signed></closer>
            </div>
        </body>
    </text>
