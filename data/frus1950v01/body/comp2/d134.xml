    <text>
        <body>
            <div xml:id="d134">

                <pb facs="0420" n="404" xml:id="pg404"/>

                <note rend="inline" type="source">Policy Planning Staff Files</note>
                <head>
                    <hi rendition="#italic">Memorandum by the Director of the Policy Planning
                        Staff</hi> (<hi rendition="#italic"
                        >Nitze</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1950-11-14">November 14, 1950</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Secretary</hi>: The Policy Planning Staff has
                    given a great deal of time and thought to the attached document. It would be
                    very helpful to us if, after you have had a chance to read it, you could find a
                    few minutes to give the Staff your reactions.<anchor n="1" xml:id="d134-f1"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Paul H. Nitze</hi>
                    </signed>
                </closer>


                <xi:include href="d134-a1.xml" xpointer="d134-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d134-f1" n="1" xml:id="d134-f1-content">
                <p>The source text bears the following marginal notation by Secretary of State
                    Acheson: “I have read all of this with great interest.”</p>
            </note>
        </listAnnotation>
    </standOff>
