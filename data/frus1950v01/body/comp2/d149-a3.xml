                <head>Enclosure “B”</head>
                <p rendition="#center">
                    <hi rendition="#small-caps">Estimate of U.S. Navy Forces Required for National
                        Security</hi> (NSC 68)</p>
                <table cols="3" rows="18">
                    <row role="label">
                        <cell>
                            <hi rendition="#italic">Type</hi>
                        </cell>
                        <cell>
                            <hi rendition="#italic">30 June 1951 Target As Approved 24 November
                                1950</hi>
                        </cell>
                        <cell>
                            <hi rendition="#italic">Recommended—as soon as practicable, and with a
                                Target Date no later than 30 June 1952</hi>
                        </cell>
                    </row>
                    <row>
                        <cell>CV/CVB</cell>
                        <cell role="num">9</cell>
                        <cell role="num">12</cell>
                    </row>
