    <text>
        <body>
            <div xml:id="d272-a3">

                <pb facs="0369" n="287" sameAs="frus:frus1865p3/pg287"/>

                <head>Mr. Morris to Mr. Washburn</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States of
                                America,</hi>
                            <hi rendition="#italic">Constantinople,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1865-04-05"><hi rendition="#italic"
                                >April</hi> 5, 1865. </date></dateline></opener>
                <p><hi rendition="#small-caps">Dear Sir:</hi> I have the honor to enclose to you
                    herewith a copy of a communication which I have received from the Sublime Porte
                    on the subject of foreign Protestant missionaries in general, and the American
                    in particular.</p>
                <p>With much respect, your obedient servant,</p>
                <closer>
                    <signed>E. JOY MORRIS.</signed></closer>
                <postscript>
                    <p>Rev. <hi rendition="#small-caps">George Washburn,</hi>
                        <hi rendition="#italic">Pera.</hi></p>
                </postscript>
            </div>
        </body>
