    <text>
        <body>
            <div xml:id="d304">

                <pb facs="0404" n="322" sameAs="frus:frus1865p3/pg322"/>

                <head>Mr. Hunter to Mr. Hale</head>
                <opener>
                    <seg rendition="#float-left">No. 9.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-06-29"><hi rendition="#italic"
                                >June</hi> 29, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge the receipt
                    of your despatches, from No 19 to No. 29, the latter dated May 27, and to thank
                    you for the interesting and valuable information which they communicate.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>W. HUNTER, <hi rendition="#italic">Acting
                    Secretary.</hi></signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Hale,</hi> Esq., <hi rendition="#italic"
                            >&amp;c., &amp;c., Alexandria.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
