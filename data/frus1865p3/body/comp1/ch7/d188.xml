    <text>
        <body>
            <div xml:id="d188">

                <pb facs="0262" n="180" sameAs="frus:frus1865p3/pg180"/>

                <head>Mr. Seward to Mr. Wood</head>
                <opener>
                    <seg rendition="#float-left">No. 115.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-11-04"><hi rendition="#italic"
                                >November</hi> 4, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have to acknowledge the receipt of your
                    despatch No. 205, of October 16th. Your announcement of the liberty which has
                    been granted to the <pb facs="0263" n="181" xml:id="pg181"/> American Methodist
                    Episcopal Church throughout the kingdom of Denmark is received with great
                    satisfaction.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Bradford R. Wood,</hi>
                        <hi rendition="#italic">Minister Resident.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
