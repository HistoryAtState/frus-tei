    <text>
        <body>
            <div xml:id="d184-a1">

                <pb facs="0261" n="179" sameAs="frus:frus1865p3/pg179"/>

                <head>Mr. Wood to Mr.
                        Blumhe</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United
                            States,</hi></placeName>
                        <date calendar="gregorian" when="1865-05-31"><hi rendition="#italic"
                                >May</hi> 31, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> The within proclamation of the President of
                    the United States I am instructed by the Acting Secretary of State to
                    communicate to his Majesty’s government.</p>
                <p>With renewed assurance of distinguished consideration, I have the honor to
                    remain, your excellency’s obedient servant,</p>
                <closer>
                    <signed>BRADFOED R. WOOD, <hi rendition="#italic">Minister Resident,
                            &amp;c.</hi></signed></closer>
                <postscript>
                    <p>His Excellency Mr. <hi rendition="#small-caps">Blumhe,</hi>
                        <hi rendition="#italic">Minister for Foreign Affairs.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
