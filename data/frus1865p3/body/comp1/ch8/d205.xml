    <text>
        <body>
            <div xml:id="d205">

                <pb facs="0275" n="193" sameAs="frus:frus1865p3/pg193"/>

                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <head>Mr. Hunter to Mr. Campbell</head>
                <opener><seg rendition="#float-left">No. 16.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-05-09"><hi rendition="#italic"
                                >May</hi> 9, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your despatch No. 15, of May 8, has been
                    received. The prompt measures adopted by you to thwart the supposed schemes of
                    rebel emissaries in Sweden, to which your attention had been called <hi
                        rendition="#italic">by</hi> Mr. Wood, are approved and commended.</p>
                <p rendition="#center">* * * * * *</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>W. HUNTER, <hi rendition="#italic">Acting
                    Secretary.</hi></signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">James H. Campbell,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., Stockholm.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
