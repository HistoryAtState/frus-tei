    <text>
        <body>
            <div xml:id="d209">

                <pb facs="0282" n="200" sameAs="frus:frus1865p3/pg200"/>

                <head>Mr. Campbell to Mr.
                        Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 18.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">Stockholm,</hi></placeName>
                        <date calendar="gregorian" when="1865-05-03"><hi rendition="#italic"
                                >May</hi> 3, 1865. </date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I thought proper to make a suitable
                    acknowledgment for the note of Count Manderstrom, minister of state and of
                    foreign affairs, of the 27th ultimo, enclosed in my despatch of the 30th ultimo,
                    No. 17, and therefore note a reply, of which the enclosed is a copy.</p>
                <p>I have the honor to be, your obedient servant,</p>
                <closer>
                    <signed>JAMES H. CAMPBELL.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State.</hi></p>
                </postscript>


                <xi:include href="d209-a1.xml" xpointer="d209-a1"/>
            </div>
