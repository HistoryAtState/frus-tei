    <text>
        <body>
            <div xml:id="d385-a1">

                <pb facs="0486" n="404" sameAs="frus:frus1865p3/pg404"/>

                <head>Mr. Eckert to Mr. Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">War Department</hi>, <hi
                                rendition="#italic">Washington City,</hi></placeName>
                        <date calendar="gregorian" when="1865-07-12"><hi rendition="#italic"
                                >July</hi> 12,<hi rendition="#italic">
                    1865.</hi></date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I am instructed by the Secretary of War to
                    transmit, for your information, copies of certain papers relative to the
                    condition of affairs on the Mexican frontier, forwarded to this department by
                    Major General P. H. Sheridan, commanding the military division of the
                    southwest.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>THOMAS F. ECKERT, <hi rendition="#italic">Acting Assistant Secretary of
                            War.</hi></signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
