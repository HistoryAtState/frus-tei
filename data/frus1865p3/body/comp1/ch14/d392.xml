    <text>
        <body>
            <div xml:id="d392">

                <pb facs="0491" n="409" sameAs="frus:frus1865p3/pg409"/>

                <head>Mr. Bigelow to Mr.
                        Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 154.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">Paris,</hi></placeName>
                        <date calendar="gregorian" when="1865-08-08"><hi rendition="#italic"
                                >August</hi> 5, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Referring to your despatch No. 192, I have
                    the honor to transmit herewith, in three enclosures, copies of a letter upon the
                    subject-matter of that despatch addressed by me to his excellency the minister
                    of foreign affairs on the 26th ultimo, and a copy and translation of his reply
                    received yesterday.</p>
                <p>I am, sir, with great respect, your very obedient servant,</p>
                <closer>
                    <signed>JOHN BIGELOW.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, &amp;c., &amp;c.,
                        &amp;c</hi>.</p>
                </postscript>




                <xi:include href="d392-a1.xml" xpointer="d392-a1"/>
