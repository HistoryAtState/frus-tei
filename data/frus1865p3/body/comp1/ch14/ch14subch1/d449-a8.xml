    <text>
        <body>
            <div xml:id="d449-a8">

                <pb facs="0530" n="448" sameAs="frus:frus1865p3/pg448"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <p><hi rendition="#small-caps">State of Louisiana,</hi>
                    <hi rendition="#italic">Parish and City of New Orleans:</hi></p>
                <p>I, Pierre Coudrain, a notary public duly qualified and sworn in and for the
                    parish and city of New Orleans, do hereby certify that the above and foregoing
                    is a true and correct copy of the original now produced and exhibited to me by
                    Mouler &amp; Co.; that I have signed said original “<hi rendition="#italic">ne
                        varietur,”</hi> at the date hereof, in order to identify it herewith, and
                    delivered the whole to Mouler &amp; Co.</p>
                <closer>
                    <dateline rendition="#float-left">In witness whereof, I have hereunto signed my
                        name and affixed the impress of my seal of office at <placeName>New
                            Orleans</placeName>, <date calendar="gregorian us-republic"
                            when="1865-09-29">this 29th day of September, 1865, and of the
                            independence of the United States of America the
                        ninetieth</date>.</dateline>
                    <lb/>
                    <signed><hi rendition="#small-caps">[seal.]</hi> P. COUDRAIN, <hi
                            rendition="#italic">Notary Public.</hi></signed></closer>
                <postscript>
                    <p>(Revenue stamp.)</p>
                </postscript>
            </div>
        </body>
    </text>
