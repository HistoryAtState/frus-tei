    <text>
        <body>
            <div xml:id="d543">

                <pb facs="0655" n="573" xml:id="pg573"/>

                <head>The Secretary of State to Clarence A. Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,
                            Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-11-01"><hi rendition="#italic"
                                >November</hi> 1, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit herewith, for your information,
                    a copy of a letter addressed by me, to-day, to Señor Matias Romero, the envoy
                    extraordinary and minister plenipotentiary of the Mexican republic, which
                    relates to the formation of the Mexican Express Company, recently organized in
                    the city of New York, and with which you appear to be connected.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Clarence</hi> A. <hi rendition="#small-caps"
                            >Seward,</hi> Esq., New York.</p>
                </postscript>
            </div>
        </body>
    </text>
