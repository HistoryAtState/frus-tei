            <div xml:id="d479-a2">

                <pb facs="0569" n="487" sameAs="frus:frus1865p3/pg487"/>

                <p>[Enclosure No. 2.—From the World, of July 29, 1865.]</p>
                <p rendition="#center"><hi rendition="#italic">Trade with Mexico.</hi>—<hi
                        rendition="#italic">Decree of Maximilian with regard to invoices and
                        manifests of merchandise forwarded to Mexican ports.</hi></p>
                <p rendition="#right">
                    <placeName><hi rendition="#small-caps">New York,</hi></placeName>
                    <date calendar="gregorian" when="1865-07-28"><hi rendition="#italic">July</hi>
                        28, 1865.</date></p>
                <p><hi rendition="#italic">To the Editor of the World:</hi></p>
                <p><hi rendition="#small-caps">Sir:</hi> Desiring that the commercial community may
                    come to the knowledge of the adjoining decrees, I request your kindness to order
                    its publication in the columns of your valuable journal, and oblige your most
                    obedient servant,</p>
                <closer>
                    <signed>LOUIS DE ARROYO, <hi rendition="#italic">No.</hi> 42 <hi
                            rendition="#italic">Broadway.</hi></signed></closer>


                <xi:include href="d479-a2-a1.xml" xpointer="d479-a2-a1"/>
