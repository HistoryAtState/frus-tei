    <text>
        <body>
            <div xml:id="d472">

                <pb facs="0564" n="482" xml:id="pg482"/>

                <head>Mr. Bigelow to Mr. Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 202.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,
                                Paris,</hi></placeName>
                        <date calendar="gregorian" when="1865-11-24"><hi rendition="#italic"
                                >November</hi> 24, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge the receipt
                    of your instruction No. 296, covering the opinion of Mr. Attorney General Speed
                    in reference to certain decrees relating to emigration which have recently been
                    promulgated from the city of Mexico, and to enclose a copy of a communication
                    addressed by me, in compliance therewith, to his excellency the minister for
                    foreign affairs, on the 22d instant.</p>
                <p>I am, sir, with great respect, your very obedient servant,</p>
                <closer>
                    <signed>JOHN BIGELOW.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>


                <xi:include href="d472-a1.xml" xpointer="d472-a1"/>
            </div>
