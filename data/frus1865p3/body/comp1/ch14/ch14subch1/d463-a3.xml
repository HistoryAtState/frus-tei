            <div xml:id="d463-a3">

                <pb facs="0554" n="472" xml:id="pg472"/>

                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <head>Headquarters of the Republican Army of the Centre.</head>
                <p>The citizen general, Santiago Tapia, presented himself at these headquarters on
                    the 30th day of the past month, and, in compliance with the obligation referred
                    to in the marginal note, returned to Mexico on the 4th day of the present
                    month.</p>
                <closer><signed>RIVA PALACIO.</signed>
                    <lb/>
                    <dateline rendition="#float-left"><placeName><hi rendition="#small-caps"
                                >Tacambaro de Codallos</hi></placeName>, <date calendar="gregorian"
                            when="1866-01-02"><hi rendition="#small-caps">January</hi> 2,
                            1866</date>.</dateline></closer>
            </div>
        </body>
    </text>
