    <text>
        <body>
            <div xml:id="d576">

                <pb facs="0771" n="689" sameAs="frus:frus1865p3/pg689"/>

                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <head>Mr. Romero to Mr. Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1866-02-26"><hi rendition="#italic"
                                >February</hi> 26, 1866.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Dear Sir: I</hi> have the honor to transmit to you
                    a translation into English of the official documents relating to the affairs of
                    Mexico, which were published by the French government on the opening of the
                    sessions of the legislative body thereof, in what is called, in Paris, the
                    “Yellow Book.”</p>
                <p>Desirous that this collection may be of some use to the department under your
                    worthy charge, I transmit it to you, and avail myself of the occasion to repeat
                    myself</p>
                <p>Your obedient servant,</p>
                <closer>
                    <signed>M.ROMERO.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d576-a1.xml" xpointer="d576-a1"/>
            </div>
        </body>
    </text>
