    <text>
        <body>
            <div xml:id="d535-a1">

                <pb facs="0642" n="560" xml:id="pg560"/>

                <head>[Enclosure No. 1.]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Liberal Union of the Civic Guard op
                                Liege, Liege,</hi></placeName>
                        <date calendar="gregorian" when="1865-08-11"><hi rendition="#italic"
                                >August</hi> 11, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> We have the honor of transmitting to you,
                    by another source, a copy of the deliberations of our association on the tenth
                    of this month, and we respectfully request you to have them sent to the
                    government of the Mexican republic Accept our distinguished regards.</p>
                <closer>
                    <signed>The President, L. J. J. LEFEVRE.</signed>
                    <lb/>
                    <signed>The Secretary, G. CLERMONT.</signed></closer>
                <postscript>
                    <p>The Secretary, <hi rendition="#small-caps">G. Clermont.</hi></p>
                </postscript>
                <postscript>
                    <p>Mr. <hi rendition="#small-caps">Matias Romero, Minister of the Mexican
                            Republic in Washington,</hi></p>
                </postscript>
            </div>
        </body>
