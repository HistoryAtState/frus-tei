    <text>
        <body>
            <div xml:id="d665">

                <pb facs="0845" n="763" sameAs="frus:frus1865p3/pg763"/>

                <head>Mr. Dayton to Mr. Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 489.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Paris</hi>,</placeName>
                        <date calendar="gregorian" when="1864-06-13"><hi rendition="#italic"
                                >June</hi> 13, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to enclose herewith an <hi
                        rendition="#italic">original letter</hi> received a few days since from
                    certain individuals, lately officers of the Mexican army, now prisoners of war
                    in Prance, together with a copy of the answer returned acknowledging its
                    receipt.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WM. L. DAYTON.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, &amp;c.</hi></p>
                </postscript>




                <xi:include href="d665-a1.xml" xpointer="d665-a1"/>
