    <text>
        <body>
            <div xml:id="d513">

                <pb facs="0617" n="535" sameAs="frus:frus1865p3/pg535"/>

                <head>Mr. Hunter to Mr. Romero</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,
                            Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-12-31"><hi rendition="#italic"
                                >December</hi> 31, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of this date, enclosing two documents, dated December 10 and
                    November 18, 1865, issued by M. F. Maury, on the subject of the colonization of
                    Mexico.</p>
                <p>I avail myself of this opportunity to renew to you, sir, the assurances of my
                    distinguished consideration.</p>
                <closer>
                    <signed>W. HUNTER, <hi rendition="#italic">Acting Secretary of
                        State.</hi></signed></closer>
                <postscript>
                    <p>Señor <hi rendition="#small-caps">Matias Romero, &amp;c., &amp;c., &amp;c.,
                            Washington, D. C.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
