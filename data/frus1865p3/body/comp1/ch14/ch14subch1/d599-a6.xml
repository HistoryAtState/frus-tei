    <text>
        <body>
            <div xml:id="d599-a6">

                <pb facs="0794" n="712" sameAs="frus:frus1865p3/pg712"/>

                <head>[Enclosure No. 6.]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Custom-house, San Francisco</hi>, <hi
                                rendition="#italic">Collector s Office</hi>,</placeName>
                        <date calendar="gregorian" when="1865-09-15"><hi rendition="#italic"
                                >September</hi> 15, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have information that a vessel will leave
                    this port to-night with arms and munitions of war, in violation of the act of
                    Congress of April 20, 1818. The vessel is described as a small coaster—name not
                    reported. You will take an advantageous position, and bring to and search any
                    suspected vessel, and if you find any arms and munitions of war on board detain
                    her and report.</p>
                <p>Respectfully,</p>
                <p rendition="#right">CHARLES JAMES, Collecor.</p>
                <p>Lieutenant <hi rendition="#small-caps">H. H. Andrews, Commanding Revenue Cutter
                        Shubrick.</hi></p>
                <p rendition="#right"><hi rendition="#small-caps">San Francisco, October 20,
                        1865.</hi></p>
                <p><hi rendition="#small-caps">A true copy:</hi></p>
                <closer>
                    <signed>JOSÉ A. GODOY.</signed></closer>
            </div>
        </body>
    </text>
