    <text>
        <body>
            <div xml:id="d627-a1">

                <pb facs="0816" n="734" sameAs="frus:frus1865p3/pg734"/>

                <head>Mr. Dana to Mr. Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington City</hi>,</placeName>
                        <date calendar="gregorian" when="1864-11-01"><hi rendition="#italic"
                                >November</hi> 1, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I transmit, herewith, by direction of the
                    Secretary of War, the enclosed copy of the latest report received by Major
                    General Canby, commanding the military division of the West Mississippi,
                    concerning affairs on the Rio Grande frontier, and by him furnished, at your
                    request, for your information.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>C. A. DANA, <hi rendition="#italic">Assistant Secretary of
                        War</hi>.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H Seward</hi>, <hi
                            rendition="#italic">Secretary of State.</hi></p>
                </postscript>



