    <text>
        <body>
            <div xml:id="d620">

                <pb facs="0811" n="729" sameAs="frus:frus1865p3/pg729"/>

                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <head>Mr. Geofroy to Mr.
                        Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of France to the United
                                States</hi>, <hi rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1864-07-08"><hi rendition="#italic"
                                >July</hi> 8, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to communicate to you the
                    extract from the despatch of his Majesty’s consul at San Francisco, which points
                    out to me shipments of powder and arms to Mexico, which would take place from
                    California, at the instigation of an agent of Juarez, named Vega, and I beg your
                    excellency will be so good as to address to the authorities of that State orders
                    analogous to those which stopped in Louisiana movements of the like nature.</p>
                <p>Accept, sir, the assurance of my high consideration.</p>
                <closer>
                    <signed>L. DE GEOFROY.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">&amp;c.</hi></p>
                </postscript>


                <xi:include href="d620-a1.xml" xpointer="d620-a1"/>
            </div>
