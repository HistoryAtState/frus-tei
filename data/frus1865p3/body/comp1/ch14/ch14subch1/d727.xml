    <text>
        <body>
            <div xml:id="d727">

                <pb facs="0904" n="822" sameAs="frus:frus1865p3/pg822"/>

                <head>Mr. Seward to Mr.
                        Bigelow</head>
                <opener>
                    <seg rendition="#float-left">No. 388.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1866-02-12"><hi rendition="#italic"
                                >February</hi> 12, 1866.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I enclose for your information a copy of a
                    note of this date, which I have addressed to the Marquis de Montholon, in reply
                    to Mr. Drouyn de Lhuys’ communication of the 9th of January, upon the subject of
                    the French intervention in Mexico.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">John Bigelow</hi>, Esq., <hi rendition="#italic"
                            >&amp;c., &amp;c., &amp;c</hi>.</p>
                </postscript>
            </div>
        </body>
    </text>
