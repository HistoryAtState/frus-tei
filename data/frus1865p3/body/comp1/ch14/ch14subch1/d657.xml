    <text>
        <body>
            <div xml:id="d657">

                <pb facs="0840" n="758" sameAs="frus:frus1865p3/pg758"/>

                <head>Mr. Seward to Mr.
                        Dayton</head>
                <opener>
                    <seg rendition="#float-left">No. <hi rendition="#small-caps">537.]</hi></seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1864-04-28"><hi rendition="#italic"
                                >April</hi> 28, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir: I</hi> have the honor to enclose for your
                    information a copy of a despatch of the 1st instant, No. 141 received at this
                    department from Charles A. Leas, esq., our commercial agent at Belize,
                    respecting the arrival at British Honduras of a number of southern refugees from
                    Texas.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">William L.Dayton</hi>, Esq., <hi
                            rendition="#italic">&amp;c.</hi></p>
                </postscript>


                <xi:include href="d657-a1.xml" xpointer="d657-a1"/>
            </div>
