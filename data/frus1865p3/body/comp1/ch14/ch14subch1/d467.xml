    <text>
        <body>
            <div xml:id="d467">

                <pb facs="0556" n="474" sameAs="frus:frus1865p3/pg474"/>

                <head>Mr. Otterbourg to Mr. Seward,</head>
                <opener>
                    <seg rendition="#float-left">No. 18.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">United States Consulate,
                            Mexico,</hi></placeName>
                        <date calendar="gregorian" when="1865-09-29"><hi rendition="#italic"
                                >September</hi> 29, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to inform the department
                    that, in conformity with instructions received from our chargé d’affaires
                    residing here, this consulate has been directed to issue passports when
                    required.</p>
                <p>Enclosed I have the honor to transmit the translations (No. 1) to which I
                    referred in despatch No. 17.</p>
                <p>I have the honor to be, sir, most respectfully, your obedient servant,</p>
                <closer>
                    <signed>MARCUS OTTERBOURG, <hi rendition="#italic">United States
                        Consul,</hi></signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State of the United States of America,
                            Washington,</hi></p>
                </postscript>






