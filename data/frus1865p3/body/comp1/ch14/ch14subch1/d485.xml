    <text>
        <body>
            <div xml:id="d485">

                <pb facs="0573" n="491" sameAs="frus:frus1865p3/pg491"/>

                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <head>The Marquis de Montholon to Mr. Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-11-29"><hi rendition="#italic"
                                >November</hi> 29, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Dear Sir:</hi> Conforming to the desire you
                    expressed to me, I send you, herewith, a copy and translation of Mr. Drouyn de
                    Lhuys’s despatch, the contents of which I have had the honor to read to you.</p>
                <p>With the highest regards, I remain, my dear sir, respectfully yours,</p>
                <closer>
                    <signed>MONTHOLON.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, &amp;c., &amp;c.,
                        &amp;c.</hi></p>
                </postscript>


                <xi:include href="d485-a1.xml" xpointer="d485-a1"/>
            </div>
