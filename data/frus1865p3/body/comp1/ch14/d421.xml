    <text>
        <body>
            <div xml:id="d421">

                <pb facs="0510" n="428" sameAs="frus:frus1865p3/pg428"/>

                <head>Mr. Seward to Mr. Bigelow</head>
                <opener>
                    <seg rendition="#float-left">No. 329.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-12-14"><hi rendition="#italic"
                                >December</hi> 14, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your despatch of the 24th of November, No.
                    202, with its accompaniment, has been received.</p>
                <p>The note you addressed to Mr. Drouyn de Lhuys on the subject of peon slavery in
                    Mexico is approved.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">John Bigelow,</hi> Esq., <hi rendition="#italic"
                            >&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
