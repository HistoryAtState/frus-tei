    <text>
        <body>
            <div xml:id="d391">

                <pb facs="0491" n="409" sameAs="frus:frus1865p3/pg409"/>

                <head>Mr. Seward to Mr.
                        Bigelow</head>
                <opener>
                    <seg rendition="#float-left">No. 216.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-07-04"><hi rendition="#italic"
                                >July</hi> 31, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your despatch of the 14th instant, No. 145,
                    and its enclosures, have been received. The information which you give of the
                    friendly change in the tone of the French journals is very satisfactory.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>W. HUNTER, <hi rendition="#italic">Acting
                    Secretary.</hi></signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">John Bigelow</hi>, Esq., <hi rendition="#italic"
                            >&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
