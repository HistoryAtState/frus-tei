    <text>
        <body>
            <div xml:id="d419">

                <pb facs="0510" n="428" xml:id="pg428"/>

                <head>Mr. Seward to Mr. Bigelow</head>
                <opener>
                    <seg rendition="#float-left">No. 327.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-12-12"><hi rendition="#italic"
                                >December</hi> 12, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I enclose for your information a
                    translation of a communication of the 29th ultimo<anchor n="*" xml:id="d419-f1"
                    /> from the Marquis de Montholon, proposing, upon conditions, to withdraw from
                    Mexico the French troops. A copy of my reply is also enclosed.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">John Bigelow,</hi> Esq., <hi rendition="#italic"
                            >&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d419-f1" n="*" xml:id="d419-f1-content">
                <p>See letter of 29th November, its enclosure, and reply of Secretary Seward,
                    December 6, 1865.</p>
            </note>
        </listAnnotation>
    </standOff>
