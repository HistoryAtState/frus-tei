    <text>
        <body>
            <div xml:id="d373">

                <pb facs="0478" n="396" sameAs="frus:frus1865p3/pg396"/>

                <head>Mr. Bigelow to Mr.
                        Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 120.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1865-06-03"><hi rendition="#italic">June</hi>
                            21, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit to you
                    enclosure No. 1, a copy, and in enclosure No. 2, a translation, of a despatch
                    received from his excellency M. Drouyn de Lhuys, in reply to my communication to
                    him of the 12th instant, a copy of which was communicated to you in my despatch
                    No. 117.</p>
                <p>I am, sir, with great respect, your obedient servant,</p>
                <closer>
                    <signed>JOHN BIGELOW.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Hon. William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State, &amp;c</hi>., <hi
                            rendition="#italic">&amp;c</hi>., <hi rendition="#italic"
                        >&amp;c</hi>.</p>
                </postscript>



                <xi:include href="d373-a1.xml" xpointer="d373-a1"/>
            </div>
        </body>
    </text>
