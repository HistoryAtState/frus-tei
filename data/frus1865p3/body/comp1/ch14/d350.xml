    <text>
        <body>
            <div xml:id="d350">

                <pb facs="0457" n="375" sameAs="frus:frus1865p3/pg375"/>

                <head>Mr. Seward to Mr. Bigelow</head>
                <opener>
                    <seg rendition="#float-left">No. 62.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-03-07"><hi rendition="#italic"
                                >March</hi> 7, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your despatch of the 9th ultimo, No. 25,
                    calling my attention to the official denial, in the Moniteur, of the truth of
                    the report in circulation concerning the cession of certain provinces in Mexico
                    to France, and to the communication of the Emperor to you upon the subject, has
                    been received with satisfaction.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">John Bigelow,</hi> Esq., <hi rendition="#italic"
                            >&amp;c., &amp;c., &amp;c., Paris.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
