    <text>
        <body>
            <div xml:id="d348">

                <pb facs="0453" n="371" sameAs="frus:frus1865p3/pg371"/>

                <head>Mr. Seward to Mr.
                        Bigelow</head>
                <opener>
                    <seg rendition="#float-left">No. 49.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-02-21"><hi rendition="#italic"
                                >February</hi> 21, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I transmit, for your information, a copy of
                    a letter of the 7th instant, and of the accompanying papers addressed to this
                    department by the Assistant Secretary of War, relative to the surrender by
                    General Mejia, at Matamoras, of refugees from Texas as deserters from the
                    insurgents. This was the subject of the instruction to you, No. 38, of the 7th
                    instant.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">John Bigelow,</hi> Esq., <hi rendition="#italic"
                            >&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d348-a1.xml" xpointer="d348-a1"/>
            </div>
