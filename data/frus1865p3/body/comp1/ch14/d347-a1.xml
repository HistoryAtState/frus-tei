    <text>
        <body>
            <div xml:id="d347-a1">

                <pb facs="0450" n="368" sameAs="frus:frus1865p3/pg368"/>

                <head>Mr. Stanton to Mr. Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">War Department,</hi>
                            <hi rendition="#italic">Washington City,</hi></placeName>
                        <date calendar="gregorian" when="1865-02-10"><hi rendition="#italic"
                                >February</hi> 10, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to transmit to you a
                    report of Major General Canby, commanding the military division of west
                    Mississippi, in relation to the seizure of a United States vessel at the mouth
                    of the Rio Grande, together with certain official papers connected therewith,
                    which accompany that report.</p>
                <p>Your obedient servant,</p>
                <closer>
                    <signed>EDWIN M. STANTON, <hi rendition="#italic">Secretary of
                        War.</hi></signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
