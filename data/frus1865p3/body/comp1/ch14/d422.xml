    <text>
        <body>
            <div xml:id="d422">

                <pb facs="0511" n="429" xml:id="pg429"/>

                <head>Mr. Seward to Mr.
                        Bigelow</head>
                <opener>
                    <seg rendition="#float-left">No. 330.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1865-12-14"><hi rendition="#italic"
                                >December</hi> 14, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your despatch of November 24, No. 201,
                    concerning the apprehended expedition of Nubian negroes against Mexico, has been
                    received.</p>
                <p>Instructions upon that subject will be given to you in another despatch.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">John Bigelow,</hi> Esq., <hi rendition="#italic"
                            >&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
