    <text>
        <body>
            <div xml:id="d743">

                <pb facs="0911" n="829" sameAs="frus:frus1865p3/pg829"/>

                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <head>Mr. Motley to Mr.
                        Seward</head>
                <opener><seg rendition="#float-left">No. 138.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">United States Legation</hi>, <hi
                                rendition="#italic">Vienna</hi></placeName>, <date
                            calendar="gregorian" when="1865-12-18"><hi rendition="#italic"
                                >December</hi> 18, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I think it proper to send you herewith
                    appended, marked A, a translation of a paragraph recently published in the
                    semi-official papers and in the official Gazette of Vienna in regard to the
                    enlistment in Austria for Mexico.</p>
                <p rendition="#center">* * * * * *</p>
                <p>I have the honor to remain your obedient servant,</p>
                <closer>
                    <signed>J. LOTHROP MOTLEY.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington.</hi></p>
                </postscript>



                <xi:include href="d743-a1.xml" xpointer="d743-a1"/>
            </div>
        </body>
    </text>
