    <text>
        <body>
            <div xml:id="d106-a3">

                <pb facs="0185" n="103" sameAs="frus:frus1865p3/pg103"/>

                <opener><dateline rendition="#center">[Telegram.—<placeName>Nantes</placeName>,
                            <date calendar="gregorian" when="1865-01-30">January 30,
                        1865</date>.]</dateline></opener>
                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <p><hi rendition="#italic">American Minister, Lisbon:</hi></p>
                <p>Ram Olinde, built at Bordeaux, and transferred by Danes to rebels at Houat
                    island, here; sailed for Lisbon on Saturday.</p>
                <closer>
                    <signed>MONTAGNIE, <hi rendition="#italic">Consul.</hi></signed></closer>
            </div>
        </body>
