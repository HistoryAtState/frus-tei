    <text>
        <body>
            <div xml:id="d117">

                <pb facs="0201" n="119" sameAs="frus:frus1865p3/pg119"/>

                <head>Mr. Seward to Mr.
                        Harvey</head>
                <opener>
                    <seg rendition="#float-left">No. 170.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1865-04-22"><hi rendition="#italic"
                                >April</hi> 22, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your despatches Nos. 325, 326, 327, and
                    328, dated respectively March 12, March 18, March 28, and March 31, have been
                    received. Nos. 326, 327, and 328 have been submitted for perusal to the
                    Secretary of the Navy. Your proceedings relative to the rebel ram Stonewall and
                    the firing upon the United States frigate Niagara from Castle Belem are
                    approved.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">James E. Harvey,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., Lisbon.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
