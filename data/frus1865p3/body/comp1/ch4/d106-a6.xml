                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener><dateline rendition="#center">[Telegram.—<placeName>Lisbon</placeName>,
                            <date calendar="gregorian" when="1865-02-02">February 2,
                        1865</date>.]</dateline></opener>
                <p><hi rendition="#italic">Captain Walke, war steamer Sacramento, Cadiz:</hi></p>
                <p>Your letter just received. Come here immediately.</p>
                <closer>
                    <signed>JAMES E. HARVEY.</signed></closer>
