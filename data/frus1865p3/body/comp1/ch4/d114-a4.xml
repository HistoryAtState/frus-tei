                <pb facs="0194" n="112" sameAs="frus:frus1865p3/pg112"/>


                <opener><dateline rendition="#center">[Telegram.—<placeName>Lisbon</placeName>,
                            <date calendar="gregorian" when="1865-03-28">March 28,
                        1865</date>.]</dateline></opener>
                <head>Mr. Harvey to Mr.
                        Adams</head>
                <p>Hon. <hi rendition="#small-caps">Charles Francis Adams,</hi>
                    <hi rendition="#italic">American Minister, London:</hi></p>
                <p>Please inform department immediately that cruise Stonewall arrived here Sunday
                    evening, and left this morning, ordered out by government on my application.
                    Niagara and Sacramento arrived last evening, and remain temporarily on special
                    and important service.</p>
                <closer>
                    <signed>JAMES E. HARVEY.</signed></closer>
            </div>
        </body>
