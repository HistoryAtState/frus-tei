    <text>
        <body>
            <div xml:id="d125">

                <pb facs="0211" n="129" sameAs="frus:frus1865p3/pg129"/>

                <head>Mr. Harvey to Mr. Hunter</head>
                <opener>
                    <seg rendition="#float-left">No. 342]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">Lisbon,</hi></placeName>
                        <date calendar="gregorian" when="1865-05-18"><hi rendition="#italic"
                                >May</hi> 18, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to communicate herewith
                    the copy of a note from the Count d’Avila, with the proceedings of the chamber
                    of deputies, in regard to the reply which I addressed to that distinguished body
                    on the 10th instant in answer to their expression of sympathy on the occasion of
                    President Lincoln’s death.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>JAMES E. HARVEY.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">Willaim Hunter,</hi>
                        <hi rendition="#italic">Acting Secretary of State.</hi></p>
                </postscript>



                <xi:include href="d125-a1.xml" xpointer="d125-a1"/>
