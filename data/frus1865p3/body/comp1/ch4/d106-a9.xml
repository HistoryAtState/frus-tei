                <pb facs="0186" n="104" sameAs="frus:frus1865p3/pg104"/>

                <opener><dateline rendition="#center">[Telegraph.—<placeName>Lisbon</placeName>,
                            <date calendar="gregorian" when="1865-02-05">February 5,
                        1865</date>.]</dateline></opener>
                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <p><hi rendition="#italic">E. S. Eggleston, Consul of the United States,
                    Cadiz:</hi></p>
                <p>Has Sacramento started? If not, tell Captain to come here immediately.</p>
                <closer>
                    <signed>JAMES E. Harvey.</signed></closer>
            </div>
