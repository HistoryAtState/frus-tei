    <text>
        <body>
            <div xml:id="d67">

                <pb facs="0155" n="73" sameAs="frus:frus1865p3/pg73"/>

                <head>Mr. Sanford to Mr. Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 241.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">Brussels,</hi></placeName>
                        <date calendar="gregorian" when="1865-02-20"><hi rendition="#italic"
                                >February</hi> 20, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have had the honor to receive your
                    despatch No. 159, and, in accordance with its instructions, have addressed a
                    letter to the Free Speech Society, in reply to its congratulatory letter to the
                    President upon his re-election, of which I enclose a copy herewith.</p>
                <p>I have the honor to be, very respectfully, your most obedient servant,</p>
                <closer>
                    <signed>H. S. SANFORD.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State, &amp;c., &amp;c.,
                        &amp;c.</hi></p>
                </postscript>



                <xi:include href="d67-a1.xml" xpointer="d67-a1"/>
            </div>
        </body>
    </text>
