    <text>
        <body>
            <div xml:id="d88">

                <pb facs="0171" n="89" xml:id="pg89"/>

                <head>Mr. Sanford to Mr.
                        Hunter</head>
                <opener>
                    <seg rendition="#float-left">No. 283.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">Brussels,</hi></placeName>
                        <date calendar="gregorian" when="1865-05-31"><hi rendition="#italic"
                                >May</hi> 31, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I enclose a copy of a letter of condolence
                    on the occasion of the assassination of President Lincoln from the Septentrion
                    Lodge of Masons, of Ghent, and translation of my reply.</p>
                <p>I have the honor to be, with great respect, your most obedient servant,</p>
                <closer>
                    <signed>H. S. SANFORD.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William</hi>
                        <hi rendition="#small-caps">Hunter,</hi>
                        <hi rendition="#italic">Acting Secretary of State, &amp;c., &amp;c.,
                            &amp;c.</hi></p>
                    <p>(For enclosure see Appendix, separate volume.)</p>
                </postscript>


                <xi:include href="d88-a1.xml" xpointer="d88-a1"/>
            </div>
        </body>
    </text>
