    <text>
        <body>
            <div xml:id="d264-a3">

                <pb facs="0350" n="268" xml:id="pg268"/>

                <opener><seg rendition="#center">No. 3.</seg></opener>
                <head>Mr. Portman to Mr. Fisher</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States in
                                Japan,</hi></placeName>
                        <date calendar="gregorian" when="1865-10-30"><hi rendition="#italic"
                                >October</hi> 30, 1865.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to inform you that in
                    concert with the representatives of Great Britain, France, and the Netherlands,
                    I have determined upon temporarily transferring the legation to Osacca, at
                    present the seat of the government of this country, with a view of bringing more
                    promptly to a successful termination important negotiations that have been in
                    progress for some time.</p>
                <p>I am, sir, respectfully, your obedient servant,</p>
                <closer>
                    <signed>A. L. C. PORTMAN, <hi rendition="#italic">Chargé d’ Affaires ad interim
                            in Japan.</hi></signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">George S. Fisher,</hi> Esq., <hi
                            rendition="#italic">United States Consul, Kanagawa.</hi></p>
                </postscript>
            </div>
        </body>
