    <text>
        <body>
            <div xml:id="d255-a2">

                <pb facs="0339" n="257" sameAs="frus:frus1865p3/pg257"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <p>You are hereby authorized to receive from the Japanese authorities the sum of two
                    hundred and fifty thousand (250,000) dollars, and to hold the same subject to
                    our conjoint order.</p>
                <p>As the delivery of this sum may extend over several days, you will give a receipt
                    at the close of each day for the amount received on that day, which will be
                    countersigned by Mr. Eusden, Japanese secretary to her Britannic Majesty’s
                    legation.</p>
                <closer>
                    <signed>H. S. P.</signed>
                    <lb/>
                    <signed>A. L. C. P.</signed>
                    <lb/>
                    <signed>D. DE GR. P.</signed>
                    <lb/>
                    <signed>P. C.R., (for M. Roches.)</signed>
                    <lb/>
                    <signed>C’T DE T.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">S. G. Richard,</hi> Esq., <hi rendition="#italic"
                            >Manager Chartered Oriental Bank.</hi></p>
                </postscript>
                <postscript>
                    <p><hi rendition="#small-caps">R. Brett,</hi> Esq., <hi rendition="#italic"
                            >Manager Chartered Mercantile Bank, Yokohama.</hi></p>
                </postscript>
            </div>
        </body>
