    <text>
        <body>
            <div xml:id="d651">

                <pb facs="0372" n="1428" sameAs="frus:frus1952-54v14p2/pg1428"/>

                <note rend="inline" type="source">PPS files, lot 64 D 563, “Japan”</note>
                <head>No. 651<lb/><hi rendition="#italic">Memorandum by the Executive Secretary
                        (Lay) to the National Security Council</hi><anchor n="1" xml:id="d651-f1"
                    /></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">top secret</hi></seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1953-06-15">June 15, 1953</date>.</dateline>
                </opener>
                <list subtype="subject" type="description">
                    <label>Subject:</label>
                    <item>The Japanese Treaty Islands</item>
                </list>
                <list type="references">
                    <head>References:</head>
                    <item>NSC 125/2 and NSC 125/5</item>
                </list>
                <p>The enclosed report by the NSC Planning Board on the subject is submitted
                    herewith for consideration by the National Security <pb facs="0373" n="1429"
                        xml:id="pg1429"/> Council of the Recommendations contained in pages 10–11
                    thereof at its meeting on Thursday, June 18. Also enclosed for Council
                    information as Annexes A and B<anchor n="2" xml:id="d651-f2"/> to the report are
                    statements of the respective positions of the Departments of Defense and State
                    on this subject.</p>
                <closer><signed><hi rendition="#small-caps">James S. Lay, Jr.</hi></signed></closer>


                <xi:include href="d651-a1.xml" xpointer="d651-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d651-f1" n="1" type="source" xml:id="d651-f1-content">
                <p>Filed as an attachment to the memorandum by Robertson, <hi rendition="#italic"
                            ><ref target="#d652">infra</ref></hi>. In addition to the members of the
                    National Security Council, this memorandum was circulated to the Secretary of
                    the Treasury, the Chairman of the Joint Chiefs of Staff, and the Director of
                    Central Intelligence.</p>
            </note>
            <note corresp="#d651-f2" n="2" xml:id="d651-f2-content">
                <p>Neither printed.</p>
            </note>
        </listAnnotation>
    </standOff>
