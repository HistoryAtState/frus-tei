    <text>
        <body>
            <div xml:id="d169-a2">

                <pb facs="0317" n="301" sameAs="frus:frus1950v02/pg301"/>

                <head>Annex B</head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">confidential</hi>
                    </seg>
                </opener>
                <p rendition="#center">
                    <hi rendition="#small-caps">Indian Draft Resolution</hi>
                </p>
                <p rendition="#flush">
                    <hi rendition="#italic">The General Assembly</hi>
                </p>
                <p>
                    <hi rendition="#italic">Noting</hi> that the Republic of China is a member of
                    the United Nations and of various organs thereof;</p>
                <p>
                    <hi rendition="#italic">Considering</hi> that the obligations of a member under
                    the Charter of the United Nations cannot be carried out except by a Government
                    which actually exercises control over the territory of that member and commands
                    the obedience of its people;</p>
                <p>
                    <hi rendition="#italic">Recognizing</hi> that the Central Government of the
                    Peoples’ Republic of China is the only such Government functioning in the
                    Republic of China as now constituted;</p>
                <p>
                    <hi rendition="#italic">Decides</hi> that the aforesaid Central Government
                    through its Head, or its Minister for Foreign Affairs, or its accredited
                    representatives, as the case may be, shall be entitled to represent the Republic
                    of China in the General Assembly; and</p>
                <p>
                    <hi rendition="#italic">Recommends</hi> that the other organs of the United
                    Nations adopt similar resolutions.</p>
            </div>
        </body>
