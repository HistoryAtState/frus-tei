            <div xml:id="d48-a1">

                <pb facs="0123" n="107" sameAs="frus:frus1950v02/pg107"/>

                <head>Annex</head>
                <p rendition="#center">
                    <hi rendition="#small-caps">Present Membership of the Economic and Social
                        Council</hi>
                </p>
                <p rendition="#flush">
                    <hi rendition="#italic">Term expires December 31, 1950:</hi>
                </p>
                <p>
                    <list>
                        <item>Australia</item>
                        <item>Brazil</item>
                        <item>Denmark</item>
                        <item>Poland</item>
                        <item>USSR</item>
                        <item>United Kingdom</item>
                    </list>
                </p>
                <p rendition="#flush">
                    <hi rendition="#italic">Term expires December 31, 1951:</hi>
                </p>
                <p>
                    <list>
                        <item>Belgium</item>
                        <item>Chile</item>
                        <item>China</item>
                        <item>France</item>
                        <item>India</item>
                        <item>Peru</item>
                    </list>
                </p>
                <pb facs="0124" n="108" xml:id="pg108"/>
                <p rendition="#flush">
                    <hi rendition="#italic">Term expires December 31, 1952:</hi>
                </p>
                <p>
                    <list>
                        <item>Canada</item>
                        <item>Czechoslovakia</item>
                        <item>Iran</item>
                        <item>Mexico</item>
                        <item>Pakistan</item>
                        <item>United States</item>
                    </list>
                </p>
            </div>
