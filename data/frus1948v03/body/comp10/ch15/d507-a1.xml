                <pb facs="0841" n="823" sameAs="frus:frus1948v03/pg823"/>

                <head>Enclosure 1</head>
                <p rendition="#center">
                    <hi rendition="#small-caps">List of Italian Dailies Printed in the United
                        States</hi>
                </p>
                <list>
                    <item>
                        <hi rendition="#italic">L’Italia-Voce</hi>—San Francisco, California,
                        L’Italia Press Co., Publishers; Ettore Patrizi, Editor; 1500 Stockton
                        Street.</item>
                    <item>
                        <hi rendition="#italic">La Notizia</hi>—Boston, Mass., G. N. Longarini,
                        Publishers; L. Z. Lo Presti, Editor; 34 Battery Street.</item>
                    <item>
                        <hi rendition="#italic">Il Progresso</hi>—New York City; Generoso Pope,
                        Publisher; I. C. Falbe, Editor; 42 Elk Street.</item>
                    <item>
                        <hi rendition="#italic">Il Popolo Italiano</hi>—Philadelphia, Pa.; Remo
                        Zuecca, Editor and Publisher; 1012 Catherine Street.</item>
                    <item>
                        <hi rendition="#italic">L’Opinione Progresso</hi>—Philadelphia, Pa.;
                        Constintino Costantini, Editor and Publisher; 8th and Christian
                        Streets.</item>
                </list>
            </div>
        </body>
