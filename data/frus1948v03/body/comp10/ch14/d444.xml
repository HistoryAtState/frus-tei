    <standOff>
        <listAnnotation>
            <note corresp="#d444-f1" n="1" xml:id="d444-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d444-f2" n="2" xml:id="d444-f2-content">
                <p>Howard Rex Cottam, first secretary in the Embassy at Rome since September 6.
                    Prior to that appointment he had served there as agricultural attaché since
                    April 1946.</p>
            </note>
