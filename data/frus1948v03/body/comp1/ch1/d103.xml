    <text>
        <body>
            <div xml:id="d103">

                <pb facs="0150" n="132" sameAs="frus:frus1948v03/pg132"/>

                <note rend="inline" type="source">840.20/5–1448</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the British Chargé</hi> (<hi rendition="#italic"
                            >Balfour</hi>)</head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1948-05-28">May 28, 1948</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Jock</hi>: In the absence of the Secretary of
                    State, I am transmitting herewith his comments regarding the message from Mr.
                    Bevin dated May 14. Will you be good enough to communicate them to Mr.
                    Bevin?</p>
                <p>Very sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert</hi> A. <hi rendition="#small-caps"
                            >Lovett</hi>
                    </signed>
                </closer>


                <xi:include href="d103-a1.xml" xpointer="d103-a1"/>
            </div>
