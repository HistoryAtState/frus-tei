    <text>
        <body>
            <div xml:id="d135-a5">

                <pb facs="0442" n="420" sameAs="frus:frus1872p2v2/pg420"/>

                <head><hi rendition="#italic">Lord Tenterden to Mr. Davis</hi>.</head>
                <opener>
                    <seg rendition="#center">[Inclosure No. 5.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Geneva</hi></placeName>, <date calendar="gregorian"
                            when="1872-04-15"><hi rendition="#italic">April</hi> 15,
                        1872</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit to you a copy
                    of a note, which, by direction Of Her Britannic Majesty’s Government, I have
                    addressed to each of the Arbitrators appoinr under the first Article of the
                    Treaty of Washington, and which will be delivered ton them together with the
                    Counter Case which I have presented.</p>
                <p>I have, &amp;c.,</p>
                <closer>
                    <signed>TENTERDEN.</signed>
                </closer>
            </div>
        </body>
    </text>
