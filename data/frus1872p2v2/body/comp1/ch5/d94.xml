    <text>
        <body>
            <div xml:id="d94">

                <pb facs="0181" n="161" sameAs="frus:frus1872p2v2/pg161"/>

                <head>
                    <hi rendition="#italic">Mr. Seward, Secretary
                        of State, to Mr. BicMnson, district
                        attorney.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1866-03-31"><hi rendition="#italic">March</hi> 31,
                        1866</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: Pursuant to the request contained in your
                    letter of yesterday’s date, I herewith transmit a certified copy of an official
                    paper on file in this Department, relative, to the existence of a state of war
                    between Spain and Chili.</p>
                <p>I am, sir, yours, &amp;c.,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed>
                </closer>
                <postscript>
                    <p><hi rendition="#small-caps">D. S. Dickinson</hi>, Esq.,<lb/><hi
                            rendition="#italic">United States District Attorney, New York.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
