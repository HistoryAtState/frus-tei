    <text>
        <body>
            <div xml:id="d15">

                <pb facs="0067" n="47" sameAs="frus:frus1872p2v2/pg47"/>

                <head>
                    <hi rendition="#italic">Mr. Seward, Secretary
                        of State, to Mr. Dayton, United States
                        minister.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Extract.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1864-05-20"><hi rendition="#italic">May</hi> 20,
                        1864</date>.</dateline>
                </opener>
                <p><seg type="margin">[325]</seg>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the
                    receipt *of your dispatch of the 2d of May, No. 460.</p>
                <p>You will please express to Mr. Drouyn de Lhuys a high satisfaction on the part of
                    this Government with the information he has given you, that the Rappahannock
                    will not be allowed to enter the piratical service of the enemies of the United
                    States. * * * * * *</p>
                <p>I am, sir, vour obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed>
                </closer>
                <postscript>
                    <p><hi rendition="#small-caps">William L. Dayton</hi>, Esq., <hi
                            rendition="#italic">&amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
