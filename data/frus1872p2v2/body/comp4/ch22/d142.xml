        <body>
            <div xml:id="d142">

                <pb facs="0451" n="429" sameAs="frus:frus1872p2v2/pg429"/>

                <head>No. 7.<lb/><hi rendition="#italic">Mr. Fish
                        to General Schenck</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1872-02-27"><hi rendition="#italic">February</hi> 27,
                        1872</date>.</dateline>
                </opener>
                <p>Reported rejection untrue. Entire unanimity. Answer now being copied. Granville’s
                    suggestion inadmissible.</p>
                <closer>
                    <signed>FISH.</signed>
                </closer>
            </div>
        </body>
    </text>
