    <text>
        <body>
            <div xml:id="d181-a3">

                <pb facs="0525" n="503" sameAs="frus:frus1872p2v2/pg503"/>

                <opener>
                    <seg rendition="#center">[Inclosure 3 in No. 46.]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">Earl Granville to General Schenck.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Foreign Office</hi></placeName>, <date calendar="gregorian"
                            when="1872-05-10"><hi rendition="#italic">May</hi> 10,
                        1872</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit to yon
                    herewith the draught<anchor n="1" xml:id="d181-f1"/> of an Article referred -to
                    in my preceding note of this day’s date.</p>
                <p>I have the honor to be, with the highest consideration, sir, your most obedient,
                    humble servant,</p>
                <closer>
                    <signed>GRANVILLE.</signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d181-f1" n="1" xml:id="d181-f1-content">
                <p>For draught of the Article see p. 500.</p>
            </note>
        </listAnnotation>
