    <text>
        <body>
            <div xml:id="d149">

                <pb facs="0482" n="460" xml:id="pg460"/>

                <head>No. 14.<lb/><hi rendition="#italic">General Schenck to Mr. Fish.</hi></head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1872-04-01">1<hi rendition="#italic">st April</hi>,
                        1872</date>.</dateline>
                </opener>
                <p>Have you any objection to British Government filing Counter Case, without
                    prejudice to their position in regard to consequential damages?</p>
                <p>Received at 9.40 a.m.</p>
                <closer>
                    <signed>SCHENCK.</signed>
                </closer>
            </div>
        </body>
