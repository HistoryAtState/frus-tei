    <text>
        <body>
            <div xml:id="d235">

                <pb facs="0590" n="568" xml:id="pg568"/>

                <head>No. 100.<lb/><hi rendition="#italic">Mr. Davis to Lord Tenterden.</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1872-06-10"><hi rendition="#italic">June</hi> 10, 1872</date>.
                        (Received June 11.)</dateline>
                </opener>
                <p><hi rendition="#small-caps">My Lord</hi>: I have the honor to transmit herewith,
                    for your Lordship’s information, a copy of a letter this day addressed by me to
                    each of the Arbitrators in the Tribunal of Arbitration constituted under the
                    provisions of the Treaty concluded at Washington, May 8, 1871, between the
                    United States and Her Britannic Majesty.</p>
                <p>I have, &amp;c.,</p>
                <closer>
                    <signed>J. C. BANCROFT DAVIS.</signed>
                </closer>


                <xi:include href="d235-a1.xml" xpointer="d235-a1"/>
            </div>
