    <text>
        <body>
            <div xml:id="d160">

                <pb facs="0506" n="484" xml:id="pg484"/>

                <head>No. 25.<lb/><hi rendition="#italic">Earl Granville to Mr.
                    Thornton.</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Foreign Office</hi></placeName>, <date calendar="gregorian"
                            when="1872-05-02"><hi rendition="#italic">May</hi> 2,
                        1872</date>.</dateline>
                </opener>
                <p rendition="#center">[From British Blue Book North America, No. 9, (1872,) p.
                    4.]</p>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to my dispatch of the 29th
                    ultimo, I transmit to you herewith copies of a further private letter to General
                    Schenck, and its inclosure.</p>
                <p>I am, &amp;c.,</p>
                <closer>
                    <signed>GRANVILLE.</signed>
                </closer>


                <xi:include href="d160-a1.xml" xpointer="d160-a1"/>
