            <div xml:id="d699">

                <pb facs="0611" n="599" sameAs="frus:frus1940v05/pg599"/>

                <note rend="inline" type="source">832.51/1795: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Brazil</hi> (<hi rendition="#italic">Caffery</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">Rio de
                                Janeiro</hi></placeName>, <date calendar="gregorian"
                            when="1940-03-25T12:00:00-03:00">March 25,
                        1940—noon</date>.<lb/>[Received 12:18 p.m.]</dateline>
                </opener>
                <p>123. My 119, March 19, 4 p.m., and 120, March 20, 1 p.m.<anchor n="26"
                        xml:id="d699-f1"/> The Director of Exchange informs me that acting upon
                    instructions of the Minister of Finance he is today arranging for the
                    distribution of foreign exchange to cover the April payments on the Brazilian
                    foreign debt.</p>
                <closer><signed><hi rendition="#small-caps">Caffery</hi></signed></closer>
            </div>
        </body>
    </text>
