    <text>
        <body>
            <div xml:id="d663">

                <pb facs="0586" n="574" xml:id="pg574"/>

                <note rend="inline" type="source">832.51/1722: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Ambassador in Brazil</hi> (<hi rendition="#italic"
                            >Caffery</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1940-02-20T17:00:00-05:00">February 20, 1940—5
                        p.m.</date></dateline>
                </opener>
                <p>34. Your 66, February 20, 1 p.m. White<anchor n="10" xml:id="d663-f1"/> will
                    discuss matter at Department Wednesday, having put it before his Executive
                    Committee today. Department will telegraph tomorrow afternoon.</p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d663-f1" n="10" xml:id="d663-f1-content">
                <p>Francis White, President of the Foreign Bondholders Protective Council.</p>
            </note>
        </listAnnotation>
