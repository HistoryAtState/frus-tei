    <text>
        <body>
            <div xml:id="d788">

                <pb facs="0673" n="661" sameAs="frus:frus1940v05/pg661"/>

                <note rend="inline" type="source">832.796/232: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Brazil</hi> (<hi rendition="#italic"
                        >Caffery</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">Rio de
                                Janeiro</hi></placeName>, <date calendar="gregorian"
                            when="1940-10-14T16:00:00-03:00">October 14, 1940—4
                        p.m.</date><lb/>[Received 5:12 p.m.]</dateline>
                </opener>
                <p>527. For Duggan.<anchor n="89" xml:id="d788-f1"/> Referring to your note of
                    October 1,<anchor n="90" xml:id="d788-f2"/> Aranha<anchor n="91"
                        xml:id="d788-f3"/> told me today that he personally would favor ousting the
                    German aviation element and would be glad to have a look at your formula.…</p>
                <closer><signed><hi rendition="#small-caps">Caffery</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d788-f1" n="89" xml:id="d788-f1-content">
                <p>Laurence Duggan, Chief of the Division of the American Republics.</p>
            </note>
            <note corresp="#d788-f2" n="90" xml:id="d788-f2-content">
                <p>Not found in Department files.</p>
            </note>
            <note corresp="#d788-f3" n="91" xml:id="d788-f3-content">
                <p>Oswaldo Aranha, Brazilian Minister for Foreign Affairs.</p>
            </note>
        </listAnnotation>
    </standOff>
