    <text>
        <body>
            <div xml:id="d602">

                <pb facs="0529" n="517" xml:id="pg517"/>

                <note rend="inline" type="source">824.6363 St 2/448a</note>
                <head><hi rendition="#italic">The Chief of the Division of the American
                        Republics</hi> (<hi rendition="#italic">Duggan</hi>) <hi rendition="#italic"
                        >to the Bolivian Minister</hi> (<hi rendition="#italic"
                    >Guachalla</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1940-02-29">February 29, 1940</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">My Dear Mr. Minister</hi>: With reference to our
                    recent conversation I enclose a revised draft of the proposed agreement for the
                    settlement of the Standard Oil Company controversy which may be substituted for
                    the draft enclosed in my letter of February 17, 1940.<anchor n="10"
                        xml:id="d602-f1"/></p>
                <p>With warm personal regards [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Laurence Duggan</hi></signed></closer>


                <xi:include href="d602-a1.xml" xpointer="d602-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d602-f1" n="10" xml:id="d602-f1-content">
                <p>Not printed. The draft of February 17 was submitted to the Bolivian Minister and
                    to Mr. E. Holman of the Standard Oil Company of New Jersey and revisions made in
                    consideration of their suggestions. A copy of this revised draft was sent to Mr.
                    Holman on March 8.</p>
            </note>
        </listAnnotation>
    </standOff>
