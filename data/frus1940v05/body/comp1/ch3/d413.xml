    <text>
        <body>
            <div xml:id="d413">

                <pb facs="0337" n="325" xml:id="pg325"/>

                <note rend="inline" type="source">740.00111A.R.–N.C./119</note>
                <head><hi rendition="#italic">The Director General of the Pan American Union</hi>
                        (<hi rendition="#italic">Rowe</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1940-07-08">July 8, 1940</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I have the honor of
                    sending to you the enclosed copies of the recommendation on
                        telecommunications,<anchor n="98" xml:id="d413-f1"/> formulated by the
                    Inter-American Neutrality Committee and transmitted by the Committee to the
                    Governments of the American Republics through the medium of the Pan American
                    Union.</p>
                <p>I beg to remain [etc.]</p>
                <closer><signed><hi rendition="#small-caps">L. S. Rowe</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
