    <text>
        <body>
            <div xml:id="d327">

                <pb facs="0275" n="263" sameAs="frus:frus1940v05/pg263"/>

                <note rend="inline" type="source">740.00111A.R.–N.C./5</note>
                <head><hi rendition="#italic">The Ambassador in Brazil</hi> (<hi rendition="#italic"
                        >Caffery</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 2373</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">Rio de
                                Janeiro</hi></placeName>, <date calendar="gregorian"
                            when="1940-01-12">January 12, 1940</date>.<lb/>[Received January
                        18.]</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inform the Department
                    that Dr. Charles G. Fenwick arrived in Rio de Janeiro at half past three
                    yesterday afternoon by Panair to take part in the Inter-American Neutrality
                    Conference. I am enclosing, as of possible interest to the Department, a copy of
                    a memorandum which Dr. Fenwick has prepared in connection with his ideas as to a
                    possible agenda for the Conference.</p>
                <p>Respectfully yours,</p>
                <closer>For the Ambassador:<lb/><signed><hi rendition="#small-caps">William C.
                            Burdett</hi></signed><lb/><hi rendition="#italic">Counselor of
                        Embassy</hi></closer>


                <xi:include href="d327-a1.xml" xpointer="d327-a1"/>
