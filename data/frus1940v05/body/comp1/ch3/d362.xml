                <pb facs="0297" n="285" sameAs="frus:frus1940v05/pg285"/>

                <note rend="inline" type="source">740.00111A.R.–N.C./40: Telegram</note>
                <head><hi rendition="#italic">The Minister in Haiti</hi> (<hi
                            rendition="#italic">Mayer</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">Port
                                au Prince</hi></placeName>, <date calendar="gregorian"
                            when="1940-02-07T13:00:00-05:00">February 7, 1940—1
                        p.m.</date><lb/>[Received 2:10 p.m.]</dateline>
                </opener>
                <p>17. Department’s circular January 27, 3 p.m. The Minister for Foreign
                        Affairs<anchor n="42" xml:id="d362-f1"/> strongly supports the Department’s
                    point of view.</p>
                <closer><signed><hi rendition="#small-caps">Mayer</hi></signed></closer>
            </div>
        </body>
    </text>
