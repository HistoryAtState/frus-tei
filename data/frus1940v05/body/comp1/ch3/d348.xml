    <text>
        <body>
            <div xml:id="d348">

                <pb facs="0287" n="275" sameAs="frus:frus1940v05/pg275"/>

                <note rend="inline" type="source">740.00111A.R.–N.C./23: Telegram</note>
                <head><hi rendition="#italic">The Minister in Bolivia</hi> (<hi rendition="#italic"
                        >Jenkins</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">La
                                Paz</hi></placeName>, <date calendar="gregorian"
                            when="1940-01-31T09:00:00-04:00">January 31, 1940—9
                        a.m.</date><lb/>[Received 10:30 a.m.]</dateline>
                </opener>
                <p>4. Department’s telegram of January 27, 3 p.m. Minister for Foreign
                        Affairs<anchor n="30" xml:id="d348-f1"/> states that he wholeheartedly
                    supports position of the Department.</p>
                <closer><signed><hi rendition="#small-caps">Jenkins</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
