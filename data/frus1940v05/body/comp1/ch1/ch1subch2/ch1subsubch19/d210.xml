    <text>
        <body>
            <div xml:id="d210">

                <pb facs="0174" n="162" sameAs="frus:frus1940v05/pg162"/>

                <note rend="inline" type="source">810.20 Defense/19<hi rendition="#superscript"
                        >6/14</hi>: Telegram</note>
                <head><hi rendition="#italic">The Minister in Uruguay</hi> (<hi rendition="#italic"
                        >Wilson</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Montevideo</hi></placeName>, <date calendar="gregorian"
                            when="1940-05-24T11:00:00-03:30">May 24, 1940—11
                        a.m.</date><lb/>[Received May 24—9:50 a.m.]</dateline>
                </opener>
                <p>78. Your 39, May 23.<anchor n="25" xml:id="d210-f1"/> I saw Guani<anchor n="26"
                        xml:id="d210-f2"/> last night about this. He said that personally he favored
                    the suggestion but of course, would have to consult the President.<anchor n="27"
                        xml:id="d210-f3"/> The President is dining with me tonight and I hope to
                    have an opportunity to discuss it with him.</p>
                <closer><signed><hi rendition="#small-caps">Wilson</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d210-f1" n="25" xml:id="d210-f1-content">
                <p>See footnote 29, <ref target="#pg16">p. 16</ref>.</p>
            </note>
            <note corresp="#d210-f2" n="26" xml:id="d210-f2-content">
                <p>Alberto Guani, Uruguayan Minister for Foreign Affairs.</p>
            </note>
            <note corresp="#d210-f3" n="27" xml:id="d210-f3-content">
                <p>Gen. Alfredo Baldomir.</p>
            </note>
        </listAnnotation>
