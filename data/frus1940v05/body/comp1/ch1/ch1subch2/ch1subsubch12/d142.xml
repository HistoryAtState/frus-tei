    <text>
        <body>
            <div xml:id="d142">

                <pb facs="0129" n="117" xml:id="pg117"/>

                <note rend="inline" type="source">810.20 Defense/52<hi rendition="#superscript"
                        >14/16</hi>: Telegram</note>
                <head><hi rendition="#italic">The Minister in Guatemala</hi> (<hi
                        rendition="#italic">Des Portes</hi>) <hi rendition="#italic">to the
                        Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Guatemala</hi></placeName>, <date calendar="gregorian"
                            when="1940-09-20T10:00:00-06:00">September 20, 1940—10
                        a.m.</date><lb/>[Received 12:55 p.m.]</dateline>
                </opener>
                <p>85. For General Strong. Permission granted by Guatemalan Government for
                    photographic air mission to operate this country based on Guatemala City. Depart
                    Friday. Delay one day Mexico. Signed Mathewson.</p>
                <closer><signed><hi rendition="#small-caps">Des Portes</hi></signed></closer>
            </div>
        </body>
