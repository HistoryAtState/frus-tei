                <pb facs="0138" n="126" sameAs="frus:frus1940v05/pg126"/>

                <note rend="inline" type="source">810.20 Defense/37<hi rendition="#superscript"
                        >6/17</hi>: Telegram</note>
                <head><hi rendition="#italic">The Minister in Haiti</hi> (<hi
                            rendition="#italic">Mayer</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Port-au-Prince</hi></placeName>, <date calendar="gregorian"
                            when="1940-06-13T14:00:00-05:00">June 13, 1940—2
                        p.m.</date><lb/>[Received 3:09 p.m.]</dateline>
                </opener>
                <p>92. For the Under Secretary and for transmission to Chief of Naval Operations and
                    Chief of War Plans Division from Colonels Del Valle and Randolph.</p>
                <quote rend="blockquote">
                    <p>“Mission successfully concluded. Proceeding next place Sunday. Full report
                        follows by air mail pouch. Pending departure propose discuss airport
                        preliminaries.”</p>
                </quote>
                <closer><signed><hi rendition="#small-caps">Mayer</hi></signed></closer>
            </div>
        </body>
