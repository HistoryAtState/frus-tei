    <text>
        <body>
            <div xml:id="d132">

                <pb facs="0121" n="109" sameAs="frus:frus1940v05/pg109"/>

                <note rend="inline" type="source">810.20 Defense/67<hi rendition="#superscript"
                        >3/24</hi>: Telegram</note>
                <head><hi rendition="#italic">The Minister in El Salvador</hi> (<hi rendition="#italic">Frazer</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">San
                                Salvador</hi></placeName>, <date calendar="gregorian"
                            when="1940-07-17T15:00:00-06:00">July 17, 1940—3
                        p.m.</date><lb/>[Received 5:05 p.m.]</dateline>
                </opener>
                <p>34. President of El Salvador today expressed complete accord with proposals
                    contained in Department’s circular telegram dated July 11, 4 p.m.<anchor n="54"
                        xml:id="d132-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Frazer</hi></signed></closer>
            </div>
        </body>
    </text>
