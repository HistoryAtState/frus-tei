    <text>
        <body>
            <div xml:id="d130">

                <pb facs="0120" n="108" sameAs="frus:frus1940v05/pg108"/>

                <note rend="inline" type="source">810.20 Defense/67<hi rendition="#superscript"
                        >1/24</hi>: Telegram</note>
                <head><hi rendition="#italic">The Minister in El Salvador</hi> (<hi
                        rendition="#italic">Frazer</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">San
                                Salvador</hi></placeName>, <date calendar="gregorian"
                            when="1940-06-04T02:00:00-06:00">June 4, 1940—2
                        a.m.</date><lb/>[Received 6:33 p.m.]</dateline>
                </opener>
                <p>24. I saw President of Salvador<anchor n="52" xml:id="d130-f1"/> today who
                    cordially concurs in all ideas set forth in the Department telegram 19 of June
                    3, 3 p.m.<anchor n="53" xml:id="d130-f2"/></p>
                <closer><signed><hi rendition="#small-caps">Frazer</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d130-f1" n="52" xml:id="d130-f1-content">
