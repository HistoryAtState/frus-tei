    <text>
        <body>
            <div xml:id="d910">

                <pb facs="0783" n="771" sameAs="frus:frus1940v05/pg771"/>

                <note rend="inline" type="source">837.011/431</note>
                <head><hi rendition="#italic">The Ambassador in Cuba</hi> (<hi rendition="#italic"
                        >Messersmith</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 389</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Habana</hi></placeName>, <date calendar="gregorian"
                            when="1940-06-08">June 8, 1940</date>.<lb/>[Received June
                        10.]</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: Supplementing my despatch No. 378, of June
                    6, 1940, I have the honor to report that the transitory provision covering the
                    moratoria <pb facs="0784" n="772" xml:id="pg772"/> was published in yesterday’s
                        <hi rendition="#italic">Official Gazette</hi>. A copy is enclosed.<anchor
                        n="57" xml:id="d910-f1"/></p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">George S.
                    Messersmith</hi></signed></closer>
            </div>
        </body>
    </text>
