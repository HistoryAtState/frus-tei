    <text>
        <body>
            <div xml:id="d262">

                <pb facs="0442" n="346" sameAs="frus:frus1898/pg346"/>

                <head>
                    <hi rendition="#italic">Mr. Sherman to Mr. White.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-03-25"><hi rendition="#italic">March 25,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 411.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: For use in connection with legislation
                    contemplated in Congress, you are requested to obtain and forward to the
                    Department copies of any German laws or regulations which may be in force to
                    prevent the use of the German flag for advertising purposes.</p>
                <p>Respectfully, yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">John Sherman.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
