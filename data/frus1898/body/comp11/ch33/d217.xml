    <text>
        <body>
            <div xml:id="d217">

                <pb facs="0413" n="317" sameAs="frus:frus1898/pg317"/>

                <head>
                    <hi rendition="#italic">Mr. White to Mr.
                            Sherman.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >Berlin</hi></placeName>, <date calendar="gregorian"
                            when="1898-02-03"><hi rendition="#italic">February 3,
                        1898</hi></date>.</dateline></opener>
                <p>Am informed order reads importation of American fruit and the products of the
                    American orchards is prohibited until further notice, and that both fresh and
                    dried fruits have actually been stopped at frontier.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">White.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
