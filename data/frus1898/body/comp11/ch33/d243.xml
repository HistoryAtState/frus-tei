    <text>
        <body>
            <div xml:id="d243">

                <pb facs="0428" n="332" xml:id="pg332"/>

                <head>
                    <hi rendition="#italic">Mr. Sherman to Mr.
                            White.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-04-20"><hi rendition="#italic">April 20,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 447.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose for your information copy of
                    correspondence, as indicated below, relative to certain microscopic specimens
                    prepared by the Imperial board of health of Berlin, taken from American fruit at
                    Hamburg, and said to be identical with the San Jose scale louse.</p>
                <p>Respectfully, yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">John Sherman.</hi>
                    </signed>
                </closer>


                <xi:include href="d243-a1.xml" xpointer="d243-a1"/>
