    <text>
        <body>
            <div xml:id="d232">

                <pb facs="0421" n="325" sameAs="frus:frus1898/pg325"/>

                <head>
                    <hi rendition="#italic">Mr. White to Mr.
                            Sherman.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >Berlin</hi></placeName>, <date calendar="gregorian"
                            when="1898-03-11"><hi rendition="#italic">March 11,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 327.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my dispatch No. 313 of the
                    26th ultimo, I have the honor to transmit herewith a copy of a note addressed by
                    me to Minister Von Bülow yesterday, in regard to the customs treatment of
                    American fruit waste imported into Germany, and to be, sir, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">And. D. White.</hi>
                    </signed>
                </closer>


                <xi:include href="d232-a1.xml" xpointer="d232-a1"/>
