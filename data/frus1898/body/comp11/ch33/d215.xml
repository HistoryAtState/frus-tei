    <text>
        <body>
            <div xml:id="d215">

                <pb facs="0413" n="317" sameAs="frus:frus1898/pg317"/>

                <head>
                    <hi rendition="#italic">Mr. White to Mr.
                            Sherman.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >Berlin</hi></placeName>, <date calendar="gregorian"
                            when="1898-02-01"><hi rendition="#italic">February 1,
                        1898</hi></date>.</dateline></opener>
                <p>Ministerial decree put in force yesterday prohibits further importation of
                    American fruit. Have communicated with foreign office, but no answer yet
                    received.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">White.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
