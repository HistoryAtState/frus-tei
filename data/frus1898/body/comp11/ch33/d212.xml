    <text>
        <body>
            <div xml:id="d212">

                <pb facs="0411" n="315" sameAs="frus:frus1898/pg315"/>

                <head>
                    <hi rendition="#italic">Mr. Robertson to Mr. Uhl.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Consulate of the United States</hi>,<lb/><hi rendition="#italic"
                                >Hamburg</hi></placeName>, <date calendar="gregorian"
                            when="1895-06-29"><hi rendition="#italic">June 29,
                        1895</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 230.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my dispatch No. 224, of May
                    18, 1895, I have the honor to inform you that I am now in receipt of a
                    communication from the chief of the Hamburg foreign office advising me that he
                    has instructed the police authorities to furnish me with samples and analyses of
                    any American dried apples which may in future be confiscated on the ground that
                    they are alleged to contain zinc.</p>
                <p>I am, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">Henry W. Robertson</hi>,<lb/><hi
                            rendition="#italic">Consul.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
