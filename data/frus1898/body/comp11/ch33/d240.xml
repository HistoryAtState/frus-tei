    <text>
        <body>
            <div xml:id="d240">

                <pb facs="0426" n="330" sameAs="frus:frus1898/pg330"/>

                <head>
                    <hi rendition="#italic">Mr. Sherman to
                            Herr von Holleben.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-04-11"><hi rendition="#italic">April 11,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 37.]</seg></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I have the honor to acknowledge the
                    receipt of your note of the 7th instant, transmitting certain microscopic
                    specimens prepared by the Imperial board of health at Berlin, and said to have
                    been found in American fruit imported at Hamburg, and to be identical with the
                    San Jose scale louse.</p>
                <p>The matter has been referred to the Secretary of Agriculture.</p>
                <p>Accept, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">John Sherman.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
