    <text>
        <body>
            <div xml:id="d424">

                <pb facs="0594" n="498" sameAs="frus:frus1898/pg498"/>

                <head>
                    <hi rendition="#italic">Mr. Olney to Señor Romero.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1896-07-09"><hi rendition="#italic">July 9,
                        1896</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 138.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of the 2d instant, and to inclose herewith, pursuant to existing
                    treaty stipulations between the United States and Mexico, a warrant of surrender
                    of Inez Ruiz, charged with the crimes of murder, arson, robbery, and kidnaping
                    in Mexico, and held for extradition by L. F. Price, United States commissioner
                    for the western district of Texas.</p>
                <p>Accept, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">Richard Olney</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
