    <text>
        <body>
            <div xml:id="d415">

                <pb facs="0588" n="492" sameAs="frus:frus1898/pg492"/>

                <head>
                    <hi rendition="#italic">Mr. Gresham to Señor
                            Romero.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1894-07-26"><hi rendition="#italic">July 26,
                        1894</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In connection with previous correspondence
                    upon the subject, I have the honor to inclose herewith copy of a letter of the
                    24th instant from the Attorney-General, and of its accompaniments, in relation
                    to the extradition cases of Inez Ruiz and Jesus Guerra.</p>
                <p>Accept, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. Q. Gresham.</hi>
                    </signed>
                </closer>



                <xi:include href="d415-a1.xml" xpointer="d415-a1"/>
            </div>
