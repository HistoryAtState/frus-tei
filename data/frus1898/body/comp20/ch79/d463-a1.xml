    <text>
        <body>
            <div xml:id="d463-a1">

                <pb facs="0633" n="537" sameAs="frus:frus1898/pg537"/>

                <opener><seg rendition="#center">[Inclosure 1 in No. 82—Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Moscow</hi></placeName>, <date calendar="gregorian"
                            when="1898-04-21"><hi rendition="#italic">April 21,
                        1898</hi></date>.</dateline></opener>
                <p rendition="#flush">Hon. <hi rendition="#small-caps">Ethan Hitchcock</hi>,<lb/><hi
                        rendition="#italic">United States Ambassador, St. Petersburg</hi>.</p>
                <p>Dr. Henry Michaels and wife urgently request to receive their passports; have to
                    leave for Paris; son dangerously sick.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Thomas Smith</hi>, <hi rendition="#italic"
                            >Consul.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
