    <text>
        <body>
            <div xml:id="d463-a6">

                <pb facs="0635" n="539" sameAs="frus:frus1898/pg539"/>

                <opener><seg rendition="#center">[Inclosure 4 in No. 82.]</seg></opener>
                <head>
                    <hi rendition="#italic">Mr. Smith to Mr.
                            Hitchcock.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Consulate of the United States</hi>,<lb/><hi rendition="#italic"
                                >Moscow, Russia</hi></placeName>, <date calendar="gregorian"
                            when="1898-04-04"><hi rendition="#italic">April 4,
                        1898</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your letter dated February 14, contents of which I have communicated to Mr.
                    G. L. Regner.</p>
                <p>I herewith beg to transmit to you a new certificate stating that he is engaged in
                    the sale of American goods.</p>
                <p>I also join the corrected applications.</p>
                <p>I am, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Thomas Smith.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
