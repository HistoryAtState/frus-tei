    <text>
        <body>
            <div xml:id="d465">

                <pb facs="0636" n="540" sameAs="frus:frus1898/pg540"/>

                <head>
                    <hi rendition="#italic">Mr. Day to Mr. Hitchcock.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi></placeName>, <date calendar="gregorian"
                            when="1898-06-23"><hi rendition="#italic">June 23,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 90.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    No. 82 of the 6th instant, and approve your determination to issue no further
                    passports to Dr. Henry Michaels and to Dr. George K. Regner, without conclusive
                    evidence shown of a real intent, supported by acts, to return to the United
                    States, there to reside and perform the duties of citizenship.</p>
                <p>Respectfully, yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">William R. Day.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
