    <text>
        <body>
            <div xml:id="d467">

                <pb facs="0638" n="542" sameAs="frus:frus1898/pg542"/>

                <head>
                    <hi rendition="#italic">Mr. Hitchcock to Mr.
                            Day.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic">St.
                                Petersburg</hi></placeName>, <date calendar="gregorian"
                            when="1898-08-26"><hi rendition="#italic">August 26,
                        1898</hi></date>.</dateline></opener>
                <p>Have forwarded to you to-day an invitation from the Czar of Russia to a proposed
                    conference of all nations to consider the problem of decreased armaments in
                    furtherance of more peaceful relations between all nations.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hitchcock.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
