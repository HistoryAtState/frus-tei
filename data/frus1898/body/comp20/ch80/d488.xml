                <pb facs="0652" n="556" sameAs="frus:frus1898/pg556"/>

                <head>
                    <hi rendition="#italic">Mr. Hay to Mr. Pierce.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1899-02-17"><hi rendition="#italic">February 17,
                        1899</hi></date>.</dateline></opener>
                <p>Inform Imperial Government President approves Count Mouravieff’s suggestions for
                    topics and place of conference.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hay.</hi>
                    </signed>
                </closer>
            </div>
