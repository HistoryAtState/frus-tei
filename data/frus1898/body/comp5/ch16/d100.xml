    <text>
        <body>
            <div xml:id="d100">

                <pb facs="0268" n="172" sameAs="frus:frus1898/pg172"/>

                <head>
                    <hi rendition="#italic">Mr. Merry to Mr. Hay.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic">San
                                Jose, Costa Rica</hi></placeName>, <date calendar="gregorian"
                            when="1898-12-01"><hi rendition="#italic">December 1,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 174.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith copy
                    and translation of official telegram received this a.m. by the Government of
                    Costa Rica announcing the final dissolution of the newly formed United States of
                    Central America by the executive council thereof.</p>
                <p>With assurances of my highest consideration, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">William Lawrence Merry</hi>,<lb/><hi
                            rendition="#italic">United States Minister.</hi></signed>
                </closer>


                <xi:include href="d100-a1.xml" xpointer="d100-a1"/>
