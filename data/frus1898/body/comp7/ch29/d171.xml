                <pb facs="0337" n="241" sameAs="frus:frus1898/pg241"/>

                <head>
                    <hi rendition="#italic">Mr. Conger to Mr. Hay.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1898-11-30"><hi rendition="#italic">November 30,
                        1898</hi></date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Hay</hi>, <hi rendition="#italic"
                        >Washington:</hi></p>
                <p>Quiet at present, but guards should remain all the winter.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Conger.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
