    <text>
        <body>
            <div xml:id="d155">

                <pb facs="0324" n="228" sameAs="frus:frus1898/pg228"/>

                <head>
                    <hi rendition="#italic">Mr. Hay to Mr.
                            Conger.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-10-03"><hi rendition="#italic">October 3,
                        1898</hi></date>.</dateline></opener>
                <p>Your course is approved. Act vigorously for the protection of Americans,
                    demanding redress as well as prevention.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hay.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
