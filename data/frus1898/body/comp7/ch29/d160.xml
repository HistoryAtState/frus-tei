    <text>
        <body>
            <div xml:id="d160">

                <pb facs="0326" n="230" sameAs="frus:frus1898/pg230"/>

                <head>
                    <hi rendition="#italic">Mr. Conger to Mr. Hay.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking, China</hi></placeName>, <date calendar="gregorian"
                            when="1898-10-12"><hi rendition="#italic">October 12,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 64.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose a translation
                    of a decree which appeared in the Peking Gazette of the 6th instant, in regard
                    to the treatment of foreigners, especially missionaries, living in China.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">E. H. Conger.</hi>
                    </signed>
                </closer>


                <xi:include href="d160-a1.xml" xpointer="d160-a1"/>
