    <text>
        <body>
            <div xml:id="d172">

                <pb facs="0337" n="241" sameAs="frus:frus1898/pg241"/>

                <head>
                    <hi rendition="#italic">Mr. Hay to Mr. Conger.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-12-02"><hi rendition="#italic">December 2,
                        1898</hi></date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Conger</hi>, <hi
                        rendition="#italic">Minister, Peking:</hi></p>
                <p><hi rendition="#italic">Boston</hi> sails soon. If marines do not return before
                    navigation closes they must remain at Peking indefinitely.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hay.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
