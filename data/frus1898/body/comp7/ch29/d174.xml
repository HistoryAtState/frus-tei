                <pb facs="0338" n="242" sameAs="frus:frus1898/pg242"/>

                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <head>
                    <hi rendition="#italic">Mr. Conger to Mr.
                            Hay.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1899-03-13"><hi rendition="#italic">March 13,
                        1899</hi></date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Hay</hi>, <hi rendition="#italic"
                        >Washington:</hi></p>
                <p>Our marines left Pekin to-day.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Conger.</hi>
                    </signed>
                </closer>
            </div>
