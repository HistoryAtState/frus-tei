    <text>
        <body>
            <div xml:id="d162">

                <pb facs="0328" n="232" xml:id="pg232"/>

                <head>
                    <hi rendition="#italic">Mr. Conger to Mr. Hay.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1898-11-01"><hi rendition="#italic">November 1,
                        1898</hi></date>.</dateline></opener>
                <p>Have requested <hi rendition="#italic">Boston</hi> to send 18 marines Peking and
                    30 Tientsin.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Conger.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
