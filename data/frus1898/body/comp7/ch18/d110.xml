    <text>
        <body>
            <div xml:id="d110">

                <pb facs="0279" n="183" xml:id="pg183"/>

                <head>
                    <hi rendition="#italic">Mr. Denby to Mr.
                            Sherman.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking, China</hi></placeName>, <date calendar="gregorian"
                            when="1898-04-15"><hi rendition="#italic">April 15,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 2913.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose a translation
                    of a proclamation issued by Russian admiral relating to the Liao Tung
                    Peninsula.</p>
                <p>By this proclamation the northern limit of Russian territory is about 30 miles
                    north of Kinchow, and the eastern limit is Pietze-woa.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Charles Denby.</hi>
                    </signed>
                </closer>


                <xi:include href="d110-a1.xml" xpointer="d110-a1"/>
