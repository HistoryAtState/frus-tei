    <text>
        <body>
            <div xml:id="d150">

                <pb facs="0318" n="222" sameAs="frus:frus1898/pg222"/>

                <head>
                    <hi rendition="#italic">Mr. Conger to Mr.
                            Hay.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking, China</hi></placeName>, <date calendar="gregorian"
                            when="1898-12-21"><hi rendition="#italic">December 21,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 120.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose to you a list
                    of the members of the grand council, the Tsung-li Yamên, and of the six boards,
                    which make up the central Government of China.</p>
                <p>The list has been prepared with considerable care, especially as to the spelling
                    of the Chinese names.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">E. H. Conger.</hi>
                    </signed>
                </closer>


                <xi:include href="d150-a1.xml" xpointer="d150-a1"/>
