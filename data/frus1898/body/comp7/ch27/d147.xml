    <text>
        <body>
            <div xml:id="d147">

                <pb facs="0314" n="218" sameAs="frus:frus1898/pg218"/>

                <head>
                    <hi rendition="#italic">Mr. Conger to Mr. Day.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Pelting, China</hi></placeName>, <date calendar="gregorian"
                            when="1898-09-24"><hi rendition="#italic">September 24,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 49.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to confirm, on the
                    overleaf, my telegram of yesterday, and to inclose a copy of the imperial decree
                    upon which it was based.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">E. H. Conger.</hi>
                    </signed>
                </closer>


                <xi:include href="d147-a1.xml" xpointer="d147-a1"/>
