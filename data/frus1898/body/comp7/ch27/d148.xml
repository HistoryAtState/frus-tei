                <pb facs="0315" n="219" sameAs="frus:frus1898/pg219"/>

                <head>
                    <hi rendition="#italic">Mr. Conger to Mr. Day.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking, China</hi></placeName>, <date calendar="gregorian"
                            when="1898-09-30"><hi rendition="#italic">September 30,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 54.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose copies of six
                    imperial decrees published since my dispatch of the’24th instant.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">E. H. Conger.</hi>
                    </signed>
                </closer>








