    <text>
        <body>
            <div xml:id="d434">

                <pb facs="0608" n="512" sameAs="frus:frus1898/pg512"/>

                <head>
                    <hi rendition="#italic">Mr. Newel to Mr. Day.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic">The
                                Hague</hi></placeName>, <date calendar="gregorian" when="1898-08-30"
                                ><hi rendition="#italic">August 30, 1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 151.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith in
                    duplicate, together with a translation of the same, a proclamation this day
                    issued by Her Majesty the Queen Regent resigning the Regency of the Kingdom.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stanford Newel.</hi>
                    </signed>
                </closer>


                <xi:include href="d434-a1.xml" xpointer="d434-a1"/>
