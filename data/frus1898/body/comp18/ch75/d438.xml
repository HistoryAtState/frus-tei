    <text>
        <body>
            <div xml:id="d438">

                <pb facs="0613" n="517" xml:id="pg517"/>

                <head>
                    <hi rendition="#italic">Mr. Hay to Mr.
                            Newel.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-10-05"><hi rendition="#italic">October 5,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 156.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith a letter from the
                    President in reply to one from Her Majesty, the Queen of the Netherlands,
                    announcing her assumption of the royal power on the attainment of her
                    majority.</p>
                <p>I also inclose an office copy of the President’s letter.</p>
                <p>You will transmit the copy to the foreign office and present the original in the
                    manner most agreeable to Her Majesty.</p>
                <p>I am, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">John Hay.</hi>
                    </signed>
                </closer>


                <xi:include href="d438-a1.xml" xpointer="d438-a1"/>
            </div>
        </body>
    </text>
