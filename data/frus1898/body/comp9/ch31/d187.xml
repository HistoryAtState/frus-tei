    <text>
        <body>
            <div xml:id="d187">

                <pb facs="0372" n="276" xml:id="pg276"/>

                <head>
                    <hi rendition="#italic">Mr. Powell to Mr. Sherman.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Santo Domingo</hi></placeName>, <date calendar="gregorian"
                            when="1898-03-07"><hi rendition="#italic">March 7,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 35.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I respectfully transmit to the Department
                    the correspondence regarding the “Ozama Bridge,” according to the instructions
                    by cable. I have thought it best to send the reply in the writing of the
                    minister of foreign affairs, retaining the copy here.</p>
                <p>I have, etc.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. F. Powell.</hi>
                    </signed>
                </closer>



                <xi:include href="d187-a1.xml" xpointer="d187-a1"/>
