    <text>
        <body>
            <div xml:id="d1139">

                <pb facs="1219" n="1123" sameAs="frus:frus1898/pg1123"/>

                <head>
                    <hi rendition="#italic">Mr. Finch to Mr.
                            Day.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Montevideo</hi></placeName>, <date calendar="gregorian"
                            when="1898-10-13"><hi rendition="#italic">October 13,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 85.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: On the 13th instant I received the inclosed
                    communications from the acting minister for foreign affairs, the Hon. Jacobo A.
                    Varela.</p>
                <p>No. 1 * * *</p>
                <p>No. 2 refers to my representations in behalf of the colored soldier, John Baker
                    Dick, a member of the Fifth Cavalry, Uruguay army, who claims to be a citizen of
                    the United States, and to have been pressed into the military service of this
                    Republic.</p>
                <p>Respectfully,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">William R. Finch.</hi>
                    </signed>
                </closer>


                <xi:include href="d1139-a1.xml" xpointer="d1139-a1"/>
