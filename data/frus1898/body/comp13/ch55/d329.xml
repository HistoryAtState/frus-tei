    <text>
        <body>
            <div xml:id="d329">

                <pb facs="0494" n="398" sameAs="frus:frus1898/pg398"/>

                <head>
                    <hi rendition="#italic">Mr. Powell to Mr. Day.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Port au Prince, Haiti</hi></placeName>, <date calendar="gregorian"
                            when="1898-06-13"><hi rendition="#italic">June 13,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 298.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I respectfully transmit draft in favor of
                    Secretary of State on Messrs. Lyon &amp; Co. for $4,950.50 received by me from
                    the Haitian Government as the first payment on the Campbell claim.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. F. Powell.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
