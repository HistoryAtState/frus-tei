    <text>
        <body>
            <div xml:id="d1190a-a10">

                <pb facs="1269" n="1173" sameAs="frus:frus1898/pg1173"/>

                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-05-05"><hi rendition="#italic">May 5,
                        1898</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose two copies of a general order of
                    the Navy Department in regard to the service assigned to the <hi
                        rendition="#italic">Solace</hi> as an ambulance ship.</p>
                <p>Respectfully,</p>
                <closer>
                    <signed><hi rendition="#small-caps">J. B. Moore</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed>
                </closer>
                <postscript>
                    <p>(To all United States legations abroad.)</p>
                </postscript>
            </div>
        </body>
    </text>
