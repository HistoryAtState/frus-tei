    <text>
        <body>
            <div xml:id="d1190a-a21">

                <pb facs="1272" n="1176" sameAs="frus:frus1898/pg1176"/>

                <opener><seg rendition="#center">[Circular.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-08-18"><hi rendition="#italic">August 18,
                        1898</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I append on the overleaf copy of the
                    Department’s telegram of the 12th instant, advising you of the signing of a
                    protocol concluding the preliminaries of peace with Spain, and inclose herewith
                    for your information, two copies of the President’s proclamation<anchor n="1"
                        xml:id="d1190a-f1"/> suspending hostilities thereunder.</p>
                <p>Respectfully, yours,</p>
                <closer>
                    <signed><hi rendition="#small-caps">J. B. Moore</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
