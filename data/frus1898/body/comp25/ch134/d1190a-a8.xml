    <text>
        <body>
            <div xml:id="d1190a-a8">

                <pb facs="1268" n="1172" sameAs="frus:frus1898/pg1172"/>

                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-05-05"><hi rendition="#italic">May 5,
                        1898</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose for your information two copies
                    of the instructions issued by the Treasury Department for the guidance of
                    collectors of customs and others in the clearance of vessels and shipments
                    therein during the war with Spain.</p>
                <p>Respectfully yours,</p>
                <closer>
                    <signed><hi rendition="#small-caps">J. B. Moore</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed>
                </closer>
                <postscript>
                    <p>(To all United States legations abroad.)</p>
                </postscript>
            </div>
        </body>
    </text>
