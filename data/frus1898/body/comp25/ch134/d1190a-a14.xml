    <text>
        <body>
            <div xml:id="d1190a-a14">

                <pb facs="1270" n="1174" sameAs="frus:frus1898/pg1174"/>

                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-05-31"><hi rendition="#italic">May 31,
                        1898</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith for your information a
                    copy of Advance Sheets of Consular Reports<anchor n="2" xml:id="d1190a-f1"/> for
                    May 16, 1898, containing translations of the war decrees of Spain.</p>
                <p>Respectfully, yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">William R. Day.</hi>
                    </signed>
                </closer>
                <postscript>
                    <p>(To all United States legations abroad.)</p>
                </postscript>
            </div>
        </body>
    </text>
