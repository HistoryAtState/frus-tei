    <text>
        <body>
            <div xml:id="d1167">

                <pb facs="1256" n="1160" sameAs="frus:frus1898/pg1160"/>

                <head>
                    <hi rendition="#italic">Mr. Hengelmüller to Mr.
                            Day.</hi>
                </head>
                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Imperial and Royal Austro-Hungarian Legation</hi>,<lb/><hi
                                rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1898-07-23"><hi rendition="#italic">July 23,
                                1898</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Mr. Secretary of State</hi>: I have the honor, Mr.
                    Secretary of State, to acknowledge, with thanks, the reception of the note of
                    July 15 instant, by which you make known to me the new regulations relative to
                    war vessels of neutral powers entering blockaded ports.</p>
                <p>Accept, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">Hengelmüller</hi>.</signed>
                </closer>
            </div>
        </body>
