    <text>
        <body>
            <div xml:id="d1183">

                <pb facs="1261" n="1165" sameAs="frus:frus1898/pg1165"/>

                <head>
                    <hi rendition="#italic">Mr. de Weckherlin to
                        Mr. Day.</hi>
                </head>
                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the Netherlands</hi>,<lb/><hi rendition="#italic">New
                                York</hi></placeName>, <date calendar="gregorian" when="1898-07-25"
                                ><hi rendition="#italic">July 25,
                    1898</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Mr. Secretary of State</hi>: I have the honor to
                    acknowledge reception of the communication which you have been pleased to
                    address to me the 15th instant on the subject of the blockade, by the United
                    States of America, of various ports of the island of Cuba, as also of other
                    blockades which have been or will be declared by the United States.</p>
                <p>Be pleased to accept, etc.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">G. de Weckherlin.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
