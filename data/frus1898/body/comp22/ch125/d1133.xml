    <text>
        <body>
            <div xml:id="d1133">

                <pb facs="1209" n="1113" sameAs="frus:frus1898/pg1113"/>

                <head>
                    <hi rendition="#italic">Mr. Straus to Mr.
                            Hay.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]<anchor n="1" xml:id="d1133-f1"
                    /></seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1898-11-07"><hi rendition="#italic">November 7,
                        1898</hi></date>.</dateline></opener>
                <p>* * * Obtained Sultan’s irade granting exequatur for consul Erzerum.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Straus.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
