    <text>
        <body>
            <div xml:id="d1113">

                <pb facs="1185" n="1089" sameAs="frus:frus1898/pg1089"/>

                <head>
                    <hi rendition="#italic">Mr. Hay to Mr. Straus.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-11-21"><hi rendition="#italic">November 21,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 21.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose for your information a copy of
                    correspondence between the Department and Mr. Ravndal, our consul at Beirut, in
                    relation to the refusal of the Turkish authorities at Beirut to allow Mr. Balzer
                    and his wife, American citizens, to land at that place, because of their Jewish
                    faith.</p>
                <p>I am, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">John Hay</hi>.</signed>
                </closer>





                <xi:include href="d1113-a1.xml" xpointer="d1113-a1"/>
