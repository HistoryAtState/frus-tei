    <text>
        <body>
            <div xml:id="d1107">

                <pb facs="1182" n="1086" sameAs="frus:frus1898/pg1086"/>

                <head>
                    <hi rendition="#italic">Mr. Riddle to Mr.
                            Day.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1898-09-03"><hi rendition="#italic">September 3,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 179.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith
                    translation of a note verbale from the Sublime Porte of August 27 last, on the
                    subject of the Ottoman regulations which prohibit the entrance of Jews into
                    Turkey.</p>
                <p>I also inclose a copy of my reply of the 2d instant.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">J. W. Riddle.</hi>
                    </signed>
                </closer>




                <xi:include href="d1107-a1.xml" xpointer="d1107-a1"/>
