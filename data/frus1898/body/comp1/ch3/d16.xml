    <text>
        <body>
            <div xml:id="d16">

                <pb facs="0105" n="9" xml:id="pg9"/>

                <head>
                    <hi rendition="#italic">Mr. Hay to Mr.
                            Buchanan.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1899-01-13"><hi rendition="#italic">January 13,
                        1899</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 436.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to your No. 582, of November 22
                    last, relative to the request for the entry and clearance of the Hawaiian
                    schooner <hi rendition="#italic">Americana</hi>, I inclose copy of a letter from
                    the Acting Secretary of the Treasury stating that such vessels can not be
                    considered vessels of the United States without additional legislation.</p>
                <p>I am, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">John Hay.</hi>
                    </signed>
                </closer>


                <xi:include href="d16-a1.xml" xpointer="d16-a1"/>
