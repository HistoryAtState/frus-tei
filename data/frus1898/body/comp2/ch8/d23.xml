    <text>
        <body>
            <div xml:id="d23">

                <pb facs="0126" n="30" sameAs="frus:frus1898/pg30"/>

                <head>
                    <hi rendition="#italic">Mr. Sherman to Mr. Tower.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi></placeName>,<lb/><date
                            calendar="gregorian" when="1898-03-25"><hi rendition="#italic">March 25,
                                1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 87.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: For use in connection with legislation
                    contemplated in Congress, you are requested to obtain and forward to the
                    Department copies of any Austro-Hungarian laws which may be in force to prevent
                    the use of the Imperial flag for advertising purposes.</p>
                <p>Respectfully, yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">John Sherman.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
