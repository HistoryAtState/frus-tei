    <text>
        <body>
            <div xml:id="d29">

                <pb facs="0131" n="35" sameAs="frus:frus1898/pg35"/>

                <head>
                    <hi rendition="#italic">The Emperor of Austria to the President.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Schoengrunn</hi></placeName>, <date calendar="gregorian"
                            when="1898-09-11"><hi rendition="#italic">September 11,
                        1898</hi></date>.</dateline></opener>
                <p>Sincerely touched by the expression of condolence and sympathy which you have
                    been pleased to forward to me in the name of the Government and of the people of
                    the United States, I beg you to accept my warmest thanks.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Francis Joseph.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
