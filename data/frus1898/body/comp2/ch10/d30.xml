    <text>
        <body>
            <div xml:id="d30">

                <pb facs="0131" n="35" sameAs="frus:frus1898/pg35"/>

                <head>
                    <hi rendition="#italic">Mr. Herdliska to Mr. Day.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Budisgdor</hi></placeName>, <date calendar="gregorian"
                            when="1898-09-11"><hi rendition="#italic">September 11,
                        1898</hi></date>.</dateline></opener>
                <p>The Empress of Austria was assassinated last evening at Territe, Switzerland, by
                    an Italian anarchist.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Herdliska</hi>, <hi rendition="#italic"
                            >Chargé.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
