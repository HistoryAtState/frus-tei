    <text>
        <body>
            <div xml:id="d39-a1">

                <pb facs="0144" n="48" xml:id="pg48"/>

                <p rendition="#center">
                    <hi rendition="#italic">List of names of the Austrian and Hungarian citizens
                        ascertained, up to September 23, to have been killed near Lattimer, Pa.</hi>
                </p>
                <table cols="7" rend="bordered" rows="11">
                    <row role="label">
                        <cell>No.</cell>
                        <cell>Family and given name.</cell>
                        <cell>Age.</cell>
                        <cell>Birthplace.</cell>
                        <cell>District to which they belonged.</cell>
                        <cell>Citizenship.</cell>
                        <cell>Surviving relatives of whom deceased was the supporter.</cell>
                    </row>
                    <row>
                        <cell>1</cell>
                        <cell>Michael Ceslak:</cell>
                        <cell role="num">40</cell>
                        <cell>Zamutov</cell>
                        <cell>County Zemplin</cell>
                        <cell>Hungarian</cell>
                        <cell>Wife and five children.</cell>
                    </row>
                    <row>
                        <cell>2</cell>
                        <cell>Stefan Roskonjansky, alias Jurek</cell>
                        <cell role="num">25</cell>
                        <cell>Siroka</cell>
                        <cell>County Saros</cell>
                        <cell>do</cell>
                        <cell>Pregnant wife and one child.</cell>
                    </row>
                    <row>
                        <cell>3</cell>
                        <cell>Jahn Fota</cell>
                        <cell role="num">24</cell>
                        <cell>Krisovjan</cell>
                        <cell>do</cell>
                        <cell>do</cell>
                        <cell>Not yet ascertained.</cell>
                    </row>
                    <row>
                        <cell>4</cell>
                        <cell>Andro Jurczest.</cell>
                        <cell role="num">25</cell>
                        <cell>Dubina</cell>
                        <cell>do</cell>
                        <cell>do</cell>
                        <cell>Father and mother.</cell>
                    </row>
                    <row>
                        <cell>5</cell>
                        <cell>Wojcich Brzostowsky.</cell>
                        <cell role="num">38</cell>
                        <cell>Bizesnica</cell>
                        <cell>Ropczyce district</cell>
                        <cell>do</cell>
                        <cell>Not yet ascertained.</cell>
                    </row>
                    <row>
                        <cell>6</cell>
                        <cell>Anton Adam Zeminiski.</cell>
                        <cell role="num">25</cell>
                        <cell>Wysniowa</cell>
                        <cell>Ropczyce</cell>
                        <cell>Austrian</cell>
                        <cell>Father and mother.</cell>
                    </row>
                    <row>
                        <cell>7</cell>
                        <cell>Zieba Wejcieh</cell>
                        <cell role="num">25</cell>
                        <cell>Wadowiece</cell>
                        <cell>Mielec district</cell>
                        <cell>do</cell>
                        <cell>Not yet ascertained.</cell>
                    </row>
                    <row>
                        <cell>8</cell>
                        <cell>Platek Clemens</cell>
                        <cell/>
                        <cell cols="2">It could only be ascertained that he was from Galicia.</cell>
                        <cell>do</cell>
                        <cell>Wife and three children.</cell>
                    </row>
                    <row>
                        <cell>9</cell>
                        <cell>Stanislaus Zagurski.</cell>
                        <cell role="num">38</cell>
                        <cell>Siedlitz</cell>
                        <cell>Pilsno district</cell>
                        <cell>do</cell>
                        <cell>Wife and two children.</cell>
                    </row>
                    <row>
                        <cell>10</cell>
                        <cell>Skreb Ivan</cell>
                        <cell role="num">28</cell>
                        <cell>Oslanicia</cell>
                        <cell>Lisko district</cell>
                        <cell>do</cell>
                        <cell>Do.</cell>
                    </row>
                </table>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">D. Thodorovich.</hi>
                    </signed>
                    <lb/>
                    <dateline rendition="#float-left"><placeName><hi rendition="#small-caps"
                                >Philadelphia</hi></placeName>, <date calendar="gregorian"
                            when="1897-09-25"><hi rendition="#italic">September 25,
                        1897</hi></date>.</dateline>
                </closer>
            </div>
        </body>
