    <text>
        <body>
            <div xml:id="d62">

                <pb facs="0164" n="68" sameAs="frus:frus1898/pg68"/>

                <head>
                    <hi rendition="#italic">The Governor of Pennsylvania
                        to Mr. Sherman.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Harrisburg, Pa.</hi></placeName>, <date calendar="gregorian"
                            when="1898-01-08"><hi rendition="#italic">January 8,
                        1898</hi></date>.</dateline></opener>
                <p>In accordance with your telegram of this date, the report of the Hazleton riots
                    will be forwarded to you on Monday next.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Daniel H. Hastings.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
