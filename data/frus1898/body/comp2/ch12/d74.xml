    <text>
        <body>
            <div xml:id="d74">

                <pb facs="0193" n="97" xml:id="pg97"/>

                <head>
                    <hi rendition="#italic">Mr. Day to Mr. Hengelmüller.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-04-16"><hi rendition="#italic">April 16,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 216.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith copy
                    of the report made to this Department by Hon. Henry M. Hoyt, Assistant
                    Attorney-General of the United States, of the trial of Sheriff Martin and his
                    deputies, at Wilkesbarre, Pa., on the charge of killing and wounding certain
                    Austrian subjects and others at Lattimer, Pa., on September 10, 1897.</p>
                <p>I avail myself, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">William R. Day.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
