    <text>
        <body>
            <div xml:id="d928">

                <pb facs="1085" n="989" sameAs="frus:frus1898/pg989"/>

                <head>
                    <hi rendition="#italic">Mr. Day to Mr. Hay.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-07-20"><hi rendition="#italic">July 20,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 759.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In connection with my No. 755 of the 19th
                    instant I append on the overleaf translation of the Department’s cipher telegram
                    of July 18 with further reference to the return by this Government of Spanish
                    troops to Spain.</p>
                <p>Respectfully, yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">William R. Day.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
