    <text>
        <body>
            <div xml:id="d935">

                <pb facs="1088" n="992" sameAs="frus:frus1898/pg992"/>

                <head>
                    <hi rendition="#italic">Mr. Moore to Mr.
                            Hay.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi></placeName>, <date calendar="gregorian"
                            when="1898-07-26"><hi rendition="#italic">July 26,
                        1898</hi></date>.</dateline></opener>
                <p>Consul at Martinique instructed to issue safe conduct to <hi rendition="#italic"
                        >San Augustin</hi>, and to allow surgeons and nurses to accompany ship.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Moore</hi>, <hi rendition="#italic"
                            >Assistant.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
