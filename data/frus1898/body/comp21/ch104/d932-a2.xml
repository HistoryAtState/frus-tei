                <pb facs="1087" n="991" sameAs="frus:frus1898/pg991"/>

                <opener><seg rendition="#center">[Subinclosure 1.]</seg></opener>
                <head>
                    <hi rendition="#italic">Mr. Wolff to the Marquis of Salisbury.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1898-07-23"><hi rendition="#italic">July 23,
                        1898</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Lord</hi>: With reference to my telegram No. 240
                    of last night, I have the honor to transmit herewith copy and translation of the
                    note verbale from the Spanish Government in reply to the terms proposed by the
                    United States to be observed in regard to the Spanish troops to be repatriated
                    from Santiago de Cuba.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">H. Wolff.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
