    <text>
        <body>
            <div xml:id="d936">

                <pb facs="1089" n="993" xml:id="pg993"/>

                <head>
                    <hi rendition="#italic">Mr. Hay to Mr. Day.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >London</hi></placeName>, <date calendar="gregorian" when="1898-07-28"
                                ><hi rendition="#italic">July 28, 1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 475.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith copies
                    of cablegrams exchanged between your Department and this embassy, and of notes
                    to the British Government relative to the return to Spain of the troops who
                    surrendered at Santiago.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">John Hay.</hi>
                    </signed>
                </closer>












