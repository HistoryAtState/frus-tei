    <text>
        <body>
            <div xml:id="d936-a10">

                <pb facs="1092" n="996" sameAs="frus:frus1898/pg996"/>

                <opener><seg rendition="#center">[Inclosure 8.]</seg></opener>
                <head>
                    <hi rendition="#italic">Mr. Hay to Lord Salisbury.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >London</hi></placeName>, <date calendar="gregorian" when="1898-07-28"
                                ><hi rendition="#italic">July 28,
                    1898</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Lord</hi>: I have the honor, in accordance with
                    instructions from my Government, to request your lordship to be so good as to
                    intimate <pb facs="1093" n="997" xml:id="pg997"/> to the Government of Spain,
                    through the medium of Her Majesty’s ambassador at Madrid, that about 1,600
                    Spanish sailors held at Portsmouth, N. H., as prisoners of war will be allowed
                    to return to Spain on parole if the Spanish Government will send a neutral ship
                    for them.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">John Hay.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
