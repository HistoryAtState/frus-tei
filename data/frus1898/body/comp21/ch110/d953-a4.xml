    <text>
        <body>
            <div xml:id="d953-a4">

                <pb facs="1101" n="1005" sameAs="frus:frus1898/pg1005"/>

                <opener><seg rendition="#center">[Inclosure 4—Telegram.]</seg></opener>
                <head>
                    <hi rendition="#italic">Mr. White to Mr.
                            Adee.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi></placeName>,<lb/><date calendar="gregorian"
                            when="1898-09-24"><hi rendition="#italic">September 24,
                        1898</hi></date>.</dateline></opener>
                <p>British Government will allow <hi rendition="#italic">Helena</hi> to coal at
                    Bermuda and Gibraltar on the understanding stated in your telegram of 21st.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">White.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
