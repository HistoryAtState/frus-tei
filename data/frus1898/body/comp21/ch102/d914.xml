    <text>
        <body>
            <div xml:id="d914">

                <pb facs="1081" n="985" sameAs="frus:frus1898/pg985"/>

                <head>
                    <hi rendition="#italic">Mr. Day to Mr. Hay.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-07-08"><hi rendition="#italic">July 8,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 734.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I append on the overleaf translation of my
                    cipher telegram<anchor n="1" xml:id="d914-f1"/> of the 6th instant, advising you
                    of the report of the United States consul at Vancouver that a Spanish privateer
                    is lying in the Gulf of Georgia, and directing you to inform the British
                    Government thereof.</p>
                <p>Respectfully, yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">William R. Day.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
