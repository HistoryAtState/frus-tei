    <text>
        <body>
            <div xml:id="d916">

                <pb facs="1081" n="985" sameAs="frus:frus1898/pg985"/>

                <head>
                    <hi rendition="#italic">Mr. Moore to Mr.
                            Hay.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-07-09"><hi rendition="#italic">July 9,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 737.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In connection with the Department’s No.
                    734, of the 7th instant, I append on the overleaf translation of my cipher
                        telegram<anchor n="1" xml:id="d916-f1"/> of July 8, in further relation to
                    the reported presence of a Spanish privateer in the waters of British
                    Columbia.</p>
                <p>Respectfully, yours,</p>
                <closer>
                    <signed><hi rendition="#small-caps">J. B. Moore</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
