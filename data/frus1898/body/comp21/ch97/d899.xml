    <text>
        <body>
            <div xml:id="d899">

                <pb facs="1075" n="979" xml:id="pg979"/>

                <head>
                    <hi rendition="#italic">Mr. Day to Mr. Hay.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-07-12"><hi rendition="#italic">July 12,
                        1898</hi></date>.</dateline></opener>
                <p>Thank Lord Tweeddale for kindly interest shown in Manila Hongkong cable matter,
                    but postpone consideration of submitted proposal for the present.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Day.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
