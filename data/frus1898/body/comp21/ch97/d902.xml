    <text>
        <body>
            <div xml:id="d902">

                <pb facs="1076" n="980" sameAs="frus:frus1898/pg980"/>

                <head>
                    <hi rendition="#italic">Mr. Moore to Mr. Hay.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-08-17"><hi rendition="#italic">August 17,
                        1898</hi></date>.</dateline></opener>
                <p>We do not object to the restoration of cable between Manila and Hongkong, and
                    have requested French ambassador here to express to Spanish Government the hope
                    that it will not object.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Moore</hi>, <hi rendition="#italic"
                            >Acting.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
