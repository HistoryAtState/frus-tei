    <text>
        <body>
            <div xml:id="d903">

                <pb facs="1076" n="980" sameAs="frus:frus1898/pg980"/>

                <head>
                    <hi rendition="#italic">Mr. Hay to Mr.
                            Day.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >London</hi></placeName>, <date calendar="gregorian" when="1898-08-22"
                                ><hi rendition="#italic">August 22,
                    1898</hi></date>.</dateline></opener>
                <p>Eastern Telegraph Company informs me Hongkong-Manila cable repaired and opened
                    for business.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hay.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
