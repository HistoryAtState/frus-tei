    <text>
        <body>
            <div xml:id="d1039">

                <pb facs="1142" n="1046" sameAs="frus:frus1898/pg1046"/>

                <head>
                    <hi rendition="#italic">Mr. Jones to Mr. Sherman.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Buenos Ayres</hi></placeName>, <date calendar="gregorian"
                            when="1898-04-05"><hi rendition="#italic">April 5,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 476.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your No. 318 of February 24 last and to transmit herewith copy of my note to
                    the <pb facs="1143" n="1047" xml:id="pg1047"/> minister of foreign relations
                    conveying to his excellency the grateful appreciation of the Government of the
                    United States for the tender of sympathy on behalf of the Government of the
                    Argentine Republic in the recent disaster to the U. S. S. <hi
                        rendition="#italic">Maine</hi>.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">François S. Jones</hi>,<lb/><hi
                            rendition="#italic">Chargé d’Affaires ad interim.</hi></signed>
                </closer>


                <xi:include href="d1039-a1.xml" xpointer="d1039-a1"/>
            </div>
        </body>
    </text>
