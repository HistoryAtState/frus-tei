                <pb facs="1156" n="1060" sameAs="frus:frus1898/pg1060"/>

                <opener><seg rendition="#center">[Inclosure 9 in No. 267.]</seg></opener>
                <p rendition="#flush"><hi rendition="#small-caps">White</hi>, <hi
                        rendition="#italic">American Embassy, London:</hi></p>
                <p>Secretary of the Navy joins me in returning heartfelt thanks for message of
                    sympathy from First Lord of Admiralty.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Day</hi>, <hi rendition="#italic"
                            >Acting.</hi></signed>
                </closer>
            </div>
