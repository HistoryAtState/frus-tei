    <text>
        <body>
            <div xml:id="d1093">

                <pb facs="1171" n="1075" sameAs="frus:frus1898/pg1075"/>

                <head>
                    <hi rendition="#italic">Mr. Townsend to Mr.
                            Sherman.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Lisbon</hi></placeName>, <date calendar="gregorian"
                            when="1898-02-25"><hi rendition="#italic">February 25,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 26.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith a
                    translation of a note just received from the Chamber of Commerce of Lisbon,
                    expressing the profound sorrow of that body on receiving the news of the loss of
                    the <hi rendition="#italic">Maine</hi> in the harbor of Habana.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lawrence Townsend.</hi>
                    </signed>
                </closer>



                <xi:include href="d1093-a1.xml" xpointer="d1093-a1"/>
            </div>
        </body>
    </text>
