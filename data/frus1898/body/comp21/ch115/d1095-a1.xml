    <text>
        <body>
            <div xml:id="d1095-a1">

                <pb facs="1173" n="1077" sameAs="frus:frus1898/pg1077"/>

                <opener><dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Imperial Legation of
                        Turkey</hi></placeName>.</dateline></opener>
                <p>The chargé d’affaires ad interim of Turkey has the honor to convey to his
                    excellency the Secretary of State the expression of the sincere regret of the
                    Ottoman Government on account of the deplorable accident which has befallen the
                        <hi rendition="#italic">Maine.</hi></p>
                <closer><dateline rendition="#float-left"><date calendar="gregorian"
                            when="1898-02-17">February 17, 1898</date>.</dateline>
                    <lb/>
                    <signed>His Excellency the <hi rendition="#small-caps">Secretary of
                            State</hi>,<lb/><hi rendition="#italic"
                    >Washington.</hi></signed></closer>
            </div>
        </body>
    </text>
