    <text>
        <body>
            <div xml:id="d1064-a8">

                <pb facs="1156" n="1060" xml:id="pg1060"/>

                <opener><seg rendition="#center">[Inclosure 8 in No. 267.]</seg><lb/><dateline
                        rendition="#center">[Copies of telegrams received at the embassy from the
                        Department of State <date calendar="gregorian" when="1898-02-17">February
                            17, 1898</date>.]</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">White</hi>, <hi
                        rendition="#italic">American Embassy, London:</hi></p>
                <p>President directs you to convey to His Royal Highness the Duke of Connaught deep
                    appreciation of his sympathy and condolence by reason of the appalling disaster
                    that has befallen this Government and people in the loss of the <hi
                        rendition="#italic">Maine</hi> and her crew.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Day</hi>, <hi rendition="#italic"
                            >Acting.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
