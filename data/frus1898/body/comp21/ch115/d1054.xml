    <text>
        <body>
            <div xml:id="d1054">

                <pb facs="1149" n="1053" sameAs="frus:frus1898/pg1053"/>

                <head>
                    <hi rendition="#italic">Mr. Powell to Mr.
                            Sherman.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Port au Prince, Haiti</hi></placeName>, <date calendar="gregorian"
                            when="1898-03-15"><hi rendition="#italic">March 15,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">Dominican Series, No. 43.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose copy of letter
                    sent to Mr. Frias, in answer acknowledging his cablegram to the President of the
                    United States, expressing sorrow at the loss of the U. S. S. <hi
                        rendition="#italic">Maine</hi>, according to instructions covered in
                    dispatch No. 117.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. F. Powell.</hi>
                    </signed>
                </closer>


                <xi:include href="d1054-a1.xml" xpointer="d1054-a1"/>
            </div>
