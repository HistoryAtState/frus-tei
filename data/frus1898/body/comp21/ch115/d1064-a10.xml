                <pb facs="1156" n="1060" sameAs="frus:frus1898/pg1060"/>

                <opener><seg rendition="#center">[Inclosure 10 in No. 267.]</seg><lb/><dateline
                        rendition="#center">[Copy of a telegram received from the Right Hon. The
                        Lord Mayor of <placeName>London</placeName>, at the Embassy, <date
                            calendar="gregorian" when="1898-02-17">February 17,
                        1898</date>.]</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">United States Ambassador</hi>, <hi
                        rendition="#italic">Victoria Street:</hi></p>
                <p>On the part of the citizens of London, and for myself personally, I beg to convey
                    to your excellency heartfelt sympathy in the terrible calamity which has
                    befallen the American people by the loss of so many of their gallantsailors.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Horatio David Davies</hi>,<lb/><hi
                            rendition="#italic">Lord Mayor, London.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
