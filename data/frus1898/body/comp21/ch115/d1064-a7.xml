    <text>
        <body>
            <div xml:id="d1064-a7">

                <pb facs="1155" n="1059" sameAs="frus:frus1898/pg1059"/>

                <opener><seg rendition="#center">[Inclosure 7 in No. 267.]</seg><lb/><dateline
                        rendition="#center">[Further telegraphic reply <date calendar="gregorian"
                            when="1898-02-18">February 18, 1898</date>.]</dateline></opener>
                <p rendition="#flush">His Royal Highness the <hi rendition="#small-caps">Duke of
                        Connaught, K. G.</hi>, <hi rendition="#italic">Bagshot:</hi></p>
                <p>The President of the United States directs me to convey to your royal highness
                    the expression of his deep appreciation of your sympathy and condolence, by
                    reason of the appalling disaster which has befallen our Government and people in
                    the loss of the <hi rendition="#italic">Maine</hi> and her crew.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Henry White.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
