    <text>
        <body>
            <div xml:id="d1079">

                <pb facs="1165" n="1069" sameAs="frus:frus1898/pg1069"/>

                <head>
                    <hi rendition="#italic">Mr. Chin Pom Ye to Mr. Sherman.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of Korea</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-02-18"><hi rendition="#italic">February 18,
                        1898</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I hereby desire to express on behalf of His
                    Majesty the Emperor and the Government of Korea sympathy with the United States
                    on the loss of the battle ship <hi rendition="#italic">Maine</hi> and so many
                    brave officers and men.</p>
                <p>Accept, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Chin Pom Ye.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
