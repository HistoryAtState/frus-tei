    <text>
        <body>
            <div xml:id="d1065">

                <pb facs="1157" n="1061" sameAs="frus:frus1898/pg1061"/>

                <head>
                    <hi rendition="#italic">Mr. White to Mr.
                            Sherman.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1898-02-19"><hi rendition="#italic">February 19,
                        1898</hi></date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Sherman</hi>, <hi
                        rendition="#italic">Secretary, Washington.</hi></p>
                <p>Have received expression profound sympathy with our Government and Navy from Duke
                    and Duchess of York. As a sailor the Duke deeply feels terrible catastrophe to
                        <hi rendition="#italic">Maine</hi>. Have carried out your recent telegraphic
                    instructions.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">White.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
