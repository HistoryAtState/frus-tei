    <text>
        <body>
            <div xml:id="d1086-a1">

                <pb facs="1168" n="1072" sameAs="frus:frus1898/pg1072"/>

                <opener><seg rendition="#center">[Cablegram received.]</seg></opener>
                <p><hi rendition="#small-caps">Newel</hi>, <hi rendition="#italic">Minister,
                        Hague:</hi></p>
                <p>Return grateful thanks to Admiral Roell and royal marine for sympathy shown to
                    American Navy and people in this hour of sore affliction.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Day</hi>, <hi rendition="#italic"
                            >Acting.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
