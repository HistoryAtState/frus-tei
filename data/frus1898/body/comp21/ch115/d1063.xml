    <text>
        <body>
            <div xml:id="d1063">

                <pb facs="1153" n="1057" sameAs="frus:frus1898/pg1057"/>

                <head>
                    <hi rendition="#italic">Sir Julian Pauncefote
                        to Mr. Sherman.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-02-21"><hi rendition="#italic">February 21,
                        1898</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: At the request of Sir Alfred Maloney,
                    governor of the Windward Islands, I have the honor to convey the heartfelt
                    sympathy of that colony with the Government and people of the United States in
                    the loss sustained through the explosion on board the <hi rendition="#italic"
                        >Maine</hi>.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Julian Pauncefote.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
