    <text>
        <body>
            <div xml:id="d1062">

                <pb facs="1153" n="1057" sameAs="frus:frus1898/pg1057"/>

                <head>
                    <hi rendition="#italic">Sir Julian Pauncefote
                        to Mr. Sherman.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-02-19"><hi rendition="#italic">February 19,
                        1898</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inform you that I am in
                    receipt of a telegram from the Earl of Aberdeen, Governor-General of Canada,
                    stating that the Dominion Government desire to offer to the President of the
                    United States the expression of their deep sympathy with the whole American
                    nation concerning the lamentable loss of the <hi rendition="#italic">Maine</hi>
                    and of so many of the officers and men of her brave crew.</p>
                <p>I request that you will be good enough to transmit the above message to its high
                    destination.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Julian Pauncefote.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
