    <text>
        <body>
            <div xml:id="d1073">

                <pb facs="1162" n="1066" sameAs="frus:frus1898/pg1066"/>

                <head>
                    <hi rendition="#italic">Mr. Hatch to Mr. Sherman.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Hawaiian Legation</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-03-03"><hi rendition="#italic">March 3,
                        1898</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: By personal direction of President Dole, I
                    beg to extend to you, and through you to the President, an expression of
                    President Dole’s sincere and heartfelt sympathy upon the loss of the battle ship
                        <hi rendition="#italic">Maine</hi> and so many of her gallant crew.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Francis M. Hatch.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
