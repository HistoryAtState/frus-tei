    <text>
        <body>
            <div xml:id="d1041">

                <pb facs="1144" n="1048" sameAs="frus:frus1898/pg1048"/>

                <head>
                    <hi rendition="#italic">Count de Lichtervelde
                        to Mr. Sherman.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of Belgium</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-02-18"><hi rendition="#italic">February 18,
                        1898</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Mr. Secretary of State</hi>: I have to-day received a
                    telegram charging me to express to your excellency the very sorrowful emotion
                    and the grievous sympathy of the King and of Belgium in connection with the
                    catastrophe to the <hi rendition="#italic">Maine.</hi></p>
                <p>Be pleased, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lichtervelde.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
