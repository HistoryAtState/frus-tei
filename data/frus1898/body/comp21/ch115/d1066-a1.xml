    <text>
        <body>
            <div xml:id="d1066-a1">

                <pb facs="1158" n="1062" xml:id="pg1062"/>

                <head>
                    <hi rendition="#italic">Copies of telegrams received from the Department at the
                        Embassy, February 18, 1898.</hi>
                </head>
                <p rendition="#flush"><hi rendition="#small-caps">White</hi>, <hi
                        rendition="#italic">American Embassy, London:</hi></p>
                <p>Please convey to the Lord Mayor of London the President’s deep appreciation of
                    his message expressing the sympathy of the citizens of London in the terrible
                    bereavement that has afflicted the American people. In their name the President
                    returns grateful thanks.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Day</hi>, <hi rendition="#italic"
                            >Acting.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
