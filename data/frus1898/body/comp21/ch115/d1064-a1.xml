    <text>
        <body>
            <div xml:id="d1064-a1">

                <pb facs="1154" n="1058" sameAs="frus:frus1898/pg1058"/>

                <opener><seg rendition="#center">[Inclosure 1 in No. 267.]</seg><lb/><dateline
                        rendition="#center">[Copy of telegram received at the embassy from the State
                        Department <date calendar="gregorian" when="1898-02-17">February 17,
                            1898</date>.]</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">White</hi>, <hi
                        rendition="#italic">American Embassy, London:</hi></p>
                <p>President deeply touched by Her Majesty’s sympathetic message, conveyed through
                    ambassador here, and charges you to express through appropriate channel grateful
                    appreciation in name of Government and people of the United States.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Day</hi>, <hi rendition="#italic"
                            >Acting.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
