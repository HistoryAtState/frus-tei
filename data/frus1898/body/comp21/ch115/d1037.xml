    <text>
        <body>
            <div xml:id="d1037">

                <pb facs="1142" n="1046" sameAs="frus:frus1898/pg1046"/>

                <head>
                    <hi rendition="#italic">Mr. Garcia Meron to Mr. Sherman.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the Argentine Republic</hi>,<lb/><hi
                                rendition="#italic">Southampton</hi></placeName>, <date
                            calendar="gregorian" when="1898-02-18"><hi rendition="#italic">February
                                18, 1898</hi></date>.</dateline></opener>
                <p rendition="#flush">Secretary <hi rendition="#small-caps">Sherman</hi>, <hi
                        rendition="#italic">Washington, D. C.:</hi></p>
                <p>I beg your excellency to accept the deepest expressions of my condolence for the
                    disaster which mourns the American nation.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Garcia Meron.</hi>
                    </signed>
                </closer>
            </div>
        </body>
