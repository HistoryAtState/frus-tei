    <text>
        <body>
            <div xml:id="d1086">

                <pb facs="1168" n="1072" sameAs="frus:frus1898/pg1072"/>

                <head>
                    <hi rendition="#italic">Mr. Newel to Mr. Sherman.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic">The
                                Hague</hi></placeName>, <date calendar="gregorian" when="1898-02-19"
                                ><hi rendition="#italic">February 19, 1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 79.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to append on the overleaf
                    a copy of Department’s cablegram relating to the Government’s thanks to Admiral
                    Roell and his royal marine, and to say that the instructions have been complied
                    with.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stanford Newel.</hi>
                    </signed>
                </closer>


                <xi:include href="d1086-a1.xml" xpointer="d1086-a1"/>
