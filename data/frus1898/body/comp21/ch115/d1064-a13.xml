    <text>
        <body>
            <div xml:id="d1064-a13">

                <pb facs="1156" n="1060" sameAs="frus:frus1898/pg1060"/>

                <opener><seg rendition="#center">[Inclosure 13 in No. 267.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1898-02-17"><hi rendition="#italic">February 17, 1898</hi></date>.
                        (Received 2.50 p.m.)</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Sherman</hi>, <hi
                        rendition="#italic">Secretary, Washington:</hi></p>
                <p>Prince and Princess of Wales request me to convey to the President and Secretary
                    of the Navy the expression of their horror at the terrible accident which has
                    happened to the <hi rendition="#italic">Maine</hi>, and their profound sympathy
                    with them and the whole American nation at the occurrence.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Henry White.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
