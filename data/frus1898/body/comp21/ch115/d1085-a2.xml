    <text>
        <body>
            <div xml:id="d1085-a2">

                <pb facs="1168" n="1072" sameAs="frus:frus1898/pg1072"/>

                <opener><dateline rendition="#center">[Copy of a telegram from the minister of
                        foreign affairs at <placeName>The Hague</placeName>, received <date
                            calendar="gregorian" type="received-date" when="1898-02-17">February 17,
                            1898</date>, by the minister of the Netherlands, at
                        Washington.]</dateline></opener>
                <p>Be pleased to convey the expression of the sincere sympathy of Admiral Roell and
                    of the royal marine of the Netherlands on the occasion of the disaster which has
                    befallen the valiant Navy of the United States. Government of the Netherlands
                    most heartily shares these sentiments.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Beaufort.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
