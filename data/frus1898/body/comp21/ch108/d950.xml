    <text>
        <body>
            <div xml:id="d950">

                <pb facs="1098" n="1002" sameAs="frus:frus1898/pg1002"/>

                <head>
                    <hi rendition="#italic">Mr. Day to Mr.
                            Hay.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-08-25"><hi rendition="#italic">August 25,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 816.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I append on the overleaf translation of the
                    Department’s cipher telegram of the 22d, and of yours in reply of the 23d
                    instant, regarding permission for Admiral Dewey to dock, clean, and paint the
                    bottoms of the vessels under his command at Hongkong.</p>
                <p>Respectfully, yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">William R. Day.</hi>
                    </signed>
                </closer>



                <xi:include href="d950-a1.xml" xpointer="d950-a1"/>
