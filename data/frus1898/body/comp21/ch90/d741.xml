    <text>
        <body>
            <div xml:id="d741">

                <pb facs="0968" n="872" sameAs="frus:frus1898/pg872"/>

                <head>
                    <hi rendition="#italic">Mr. Powell to Mr.
                            Day.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Port an Prince, Haiti</hi></placeName>, <date calendar="gregorian"
                            when="1898-05-18"><hi rendition="#italic">May 18,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 259.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I respectfully transmit to the Department a
                    copy of a letter of instructions forwarded by this Government to the several
                    ports of this Republic as a guide to their officers regarding neutrality.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. F. Powell.</hi>
                    </signed>
                </closer>


                <xi:include href="d741-a1.xml" xpointer="d741-a1"/>
