    <text>
        <body>
            <div xml:id="d737">

                <pb facs="0961" n="865" sameAs="frus:frus1898/pg865"/>

                <head>
                    <hi rendition="#italic">Mr. Hay to Mr. Sherman.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >London</hi></placeName>, <date calendar="gregorian" when="1898-04-26"
                                ><hi rendition="#italic">April 26, 1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 367.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith two
                    copies of the London Gazette Extraordinary of this date, containing Her
                    Britannic Majesty’s proclamation of neutrality in relation to the war between
                    the United States and Spain.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">John Hay.</hi>
                    </signed>
                </closer>





