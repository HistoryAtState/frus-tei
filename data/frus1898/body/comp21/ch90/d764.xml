    <text>
        <body>
            <div xml:id="d764">

                <pb facs="0993" n="897" sameAs="frus:frus1898/pg897"/>

                <head>
                    <hi rendition="#italic">Mr. Rockhill to Mr. Sherman.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Bucharest</hi></placeName>, <date calendar="gregorian"
                            when="1898-05-15"><hi rendition="#italic">May 15,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 9, Servian Series.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith copy
                    of a note, under date of May 12, from the minister of foreign affairs of Servia,
                    informing me that during the hostilities between the United States and Spain
                    Servia would observe the strictest neutrality.</p>
                <p>Very respectfully, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. W. Rockhill.</hi>
                    </signed>
                </closer>


                <xi:include href="d764-a1.xml" xpointer="d764-a1"/>
