    <text>
        <body>
            <div xml:id="d742">

                <pb facs="0969" n="873" sameAs="frus:frus1898/pg873"/>

                <head>
                    <hi rendition="#italic">Mr. Draper to Mr. Sherman.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >Rome, Italy</hi></placeName>, <date calendar="gregorian"
                            when="1898-04-26"><hi rendition="#italic">April 26,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 189.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Having sent you word to-day by cable that
                    the Italian Government has issued a proclamation of neutrality, I beg leave now
                    to inclose to you a clipping from the Gazette Ufficiale, of April 25, containing
                    the same. It is dated yesterday, but appeared this morning. To insure its speedy
                    receipt by you, I do not translate it.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">William F. Draper.</hi>
                    </signed>
                </closer>



                <xi:include href="d742-a1.xml" xpointer="d742-a1"/>
            </div>
        </body>
    </text>
