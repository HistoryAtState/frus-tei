    <text>
        <body>
            <div xml:id="d726">

                <pb facs="0951" n="855" sameAs="frus:frus1898/pg855"/>

                <head>
                    <hi rendition="#italic">Mr. Van Horne to Mr. Cridler.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Consulate of the United States</hi>,<lb/><hi rendition="#italic"
                                >St. Thomas, Danish West Indies</hi></placeName>, <date
                            calendar="gregorian" when="1898-06-02"><hi rendition="#italic">June 2,
                                1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 21.]</seg></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Sir</hi>:</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I send neutrality law as published and as it is understood here.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">Mahlon Van Horne</hi>,<lb/><hi
                            rendition="#italic">United States Consul.</hi></signed>
                </closer>



