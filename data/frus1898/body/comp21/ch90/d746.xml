    <text>
        <body>
            <div xml:id="d746">

                <pb facs="0977" n="881" sameAs="frus:frus1898/pg881"/>

                <head>
                    <hi rendition="#italic">Mr. Allen to Mr.
                            Sherman.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Seoul, Korea</hi></placeName>, <date calendar="gregorian"
                            when="1898-04-28"><hi rendition="#italic">April 28,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 102. Diplomatic]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to confirm my
                        telegram<anchor n="1" xml:id="d746-f1"/> of to-day’s date concerning the
                    neutrality of Korea, and to inclose copy of a note from the Korean foreign
                    office of the same date announcing that fact.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Horace N. Allen.</hi>
                    </signed>
                </closer>


                <xi:include href="d746-a1.xml" xpointer="d746-a1"/>
            </div>
        </body>
    </text>
