    <text>
        <body>
            <div xml:id="d721">

                <pb facs="0947" n="851" xml:id="pg851"/>

                <head>
                    <hi rendition="#italic">Mr. Morey to Mr. Day.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Consulate of the United States at Ceylon.</hi><lb/><hi
                                rendition="#italic">Colombo</hi></placeName>, <date
                            calendar="gregorian" when="1898-04-26"><hi rendition="#italic">April 26,
                                1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 567.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith in duplicate a
                    proclamation by the governor of Ceylon respecting local neutrality during the
                    present conflict between the United States and Spain.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I am, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">W. Morey</hi>,<lb/><hi rendition="#italic"
                            >United States Consul.</hi></signed>
                </closer>


                <xi:include href="d721-a1.xml" xpointer="d721-a1"/>
            </div>
