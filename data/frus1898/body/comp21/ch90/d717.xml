    <text>
        <body>
            <div xml:id="d717">

                <pb facs="0942" n="846" sameAs="frus:frus1898/pg846"/>

                <head>
                    <hi rendition="#italic">Mr. Bryan to Mr.
                            Sherman.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Petropolis</hi></placeName>, <date calendar="gregorian"
                            when="1898-05-05"><hi rendition="#italic">May 5,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 20.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>:</p>
                <p rendition="#center">* * * * * * *</p>
                <p>The neutrality proclamation, a copy of which I have the honor to inclose, permits
                    coaling for the continuance of the voyage by war ships of belligerents.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Charles Page Bryan.</hi>
                    </signed>
                </closer>


                <xi:include href="d717-a1.xml" xpointer="d717-a1"/>
