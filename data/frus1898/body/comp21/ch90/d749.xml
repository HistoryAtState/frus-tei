    <text>
        <body>
            <div xml:id="d749">

                <pb facs="0979" n="883" sameAs="frus:frus1898/pg883"/>

                <head>
                    <hi rendition="#italic">Mr. Grout to Mr.
                            Day.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Consulate of the United States</hi>,<lb/><hi rendition="#italic"
                                >Malta, Valetta</hi></placeName>, <date calendar="gregorian"
                            when="1898-04-25"><hi rendition="#italic">April 25,
                        1898</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to forward herewith a copy
                    of the proclamation<anchor n="1" xml:id="d749-f1"/> of neutrality as announced
                    by His Excellency the governor of Malta in to-day’s Official Gazette.</p>
                <p>I am, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">John H. Grout</hi>, Jr.,<lb/><hi
                            rendition="#italic">United States Consul.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d749-f1" n="1" xml:id="d749-f1-content">
                <p>Not printed. The proclamation, except as to preamble, in the same terms, mutatis
                    mutandis, as that of Great Britain, see <ref target="#pg865">page 865</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
