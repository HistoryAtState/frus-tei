    <text>
        <body>
            <div xml:id="d738">

                <pb facs="0966" n="870" sameAs="frus:frus1898/pg870"/>

                <head>
                    <hi rendition="#italic">Mr. Rockhill to Mr. Sherman.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Belgrade</hi></placeName>, <date calendar="gregorian"
                            when="1898-05-05"><hi rendition="#italic">May 5,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 56, Greek series.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith a
                    note from the minister of foreign affairs of Greece, dated the 28th of April,
                    informing me that the strictest neutrality will be observed by Greece during the
                    war between the United States and Spain.</p>
                <p>Very respectfully, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. W. Rockhill.</hi>
                    </signed>
                </closer>


                <xi:include href="d738-a1.xml" xpointer="d738-a1"/>
            </div>
