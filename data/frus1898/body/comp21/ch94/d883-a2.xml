                <pb facs="1068" n="972" sameAs="frus:frus1898/pg972"/>

                <opener><seg rendition="#center">[Inclosure No. 2.]</seg></opener>
                <head>
                    <hi rendition="#italic">Mr. Day to Mr. Hay.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-05-08"><hi rendition="#italic">May 8,
                        1898</hi></date>.</dateline></opener>
                <p>Department does not consider treaty provisions expressly applicable to war
                    between contracting parties as abrogated by war, and therefore can not propose
                    or make new agreement embodying the conditions of article 13, treaty 1795. So
                    inform British ambassador, Madrid.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Day.</hi>
                    </signed>
                </closer>
            </div>
        </body>
