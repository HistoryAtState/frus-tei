    <text>
        <body>
            <div xml:id="d883">

                <pb facs="1068" n="972" sameAs="frus:frus1898/pg972"/>

                <head>
                    <hi rendition="#italic">Mr. Day to Mr.
                            Hay.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-05-09"><hi rendition="#italic">May 9,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 612.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I append on the overleaf translation of
                    your cipher telegram of the 7th, and of my reply of the 8th instant, regarding
                    the treaty of 1795 between the United States and Spain.</p>
                <p>Respectfully, yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">William R. Day.</hi>
                    </signed>
                </closer>



                <xi:include href="d883-a1.xml" xpointer="d883-a1"/>
