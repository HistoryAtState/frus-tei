                <pb facs="1180" n="1084" xml:id="pg1084"/>

                <opener><seg rendition="#center">[Inclosure 7 in No. 4.]</seg></opener>
                <head><hi rendition="#italic">Mr. Adee to Mr. Bartleman</hi>.</head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-04-17"><hi rendition="#italic">April 17,
                        1898</hi></date>.</dateline></opener>
                <p>Prompt action Malaga authorities is highly appreciated.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Adee.</hi>
                    </signed>
                </closer>
            </div>
        </body>
