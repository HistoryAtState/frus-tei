    <text>
        <body>
            <div xml:id="d1104-a2">

                <pb facs="1178" n="1082" sameAs="frus:frus1898/pg1082"/>

                <opener><seg rendition="#center">[Inclosure 1 in No. 4.]</seg></opener>
                <head>
                    <hi rendition="#italic">Mr. Bartleman to Mr.
                            Sherman.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Consulate of the United States</hi>,<lb/><hi rendition="#italic"
                                >Malaga</hi></placeName>, <date calendar="gregorian"
                            when="1898-04-15"><hi rendition="#italic">April 15,
                        1898</hi></date>.</dateline></opener>
                <p>Demonstration, 8 evening, Friday. Windows consulate broken, shield destroyed.
                    Residence also stoned.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bartleman.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
