    <text>
        <body>
            <div xml:id="d1003">

                <pb facs="1124" n="1028" sameAs="frus:frus1898/pg1028"/>

                <head>
                    <hi rendition="#italic">Mr. Woodford to Mr. Sherman.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1898-01-27"><hi rendition="#italic">January 27,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 131.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to confirm my cipher
                    telegram of this date, as follows: <quote rend="blockquote">
                        <p rendition="#flush">Secretary <hi rendition="#small-caps">Sherman</hi>,
                                <hi rendition="#italic">Washington:</hi></p>
                        <p>Spanish Government appreciate friendly character of visit of the <hi
                                rendition="#italic">Maine</hi> to Habana and will return the
                            courtesy by sending Spanish ships to principal ports of the United
                            States.</p>
                        <p rendition="#right"><hi rendition="#small-caps">Woodford.</hi></p>
                    </quote></p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stewart L. Woodford.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
