    <text>
        <body>
            <div xml:id="d1032">

                <pb facs="1140" n="1044" sameAs="frus:frus1898/pg1044"/>

                <head>
                    <hi rendition="#italic">Señor Polo de Bernabé
                        to Mr. Sherman.</hi>
                </head>
                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of Spain in Washington</hi></placeName>,<lb/><date
                            calendar="gregorian" when="1898-03-28"><hi rendition="#italic">March 28,
                                1898</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Mr. Secretary</hi>: In the fulfillment of
                    instructions which I have received from my Government, I have the honor to
                    transmit to your excellency a copy of an extract from the report made by the
                    Spanish commission on the <hi rendition="#italic">Maine</hi> disaster, while
                    awaiting the transmission of the original report.</p>
                <p>I avail myself, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Luis Polo de Barnabé.</hi>
                    </signed>
                </closer>


                <xi:include href="d1032-a1.xml" xpointer="d1032-a1"/>
            </div>
        </body>
    </text>
