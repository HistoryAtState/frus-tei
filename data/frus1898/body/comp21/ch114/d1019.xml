    <text>
        <body>
            <div xml:id="d1019">

                <pb facs="1130" n="1034" sameAs="frus:frus1898/pg1034"/>

                <head>
                    <hi rendition="#italic">The President to Mr.
                            Woodford.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Executive Mansion</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-02-19T14:50:00-05:00"><hi rendition="#italic">February 19,
                                1898</hi>—2.50 p.m.</date></dateline></opener>
                <p>Convey in appropriate manner my sincere appreciation of Her Majesty’s message of
                    condolence and sympathy as conveyed in your telegram just received.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">William McKinley.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
