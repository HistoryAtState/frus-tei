    <text>
        <body>
            <div xml:id="d1021">

                <pb facs="1131" n="1035" sameAs="frus:frus1898/pg1035"/>

                <head>
                    <hi rendition="#italic">Mr. Sherman to Mr. Woodford.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-02-24"><hi rendition="#italic">February 24,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 139.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I am instructed by the Secretary of the
                    Navy to instruct you to express to the Spanish Government his high appreciation
                    of the services rendered and honors paid by the Cuban authorities to the
                    officers and men of the U. S. S. <hi rendition="#italic">Maine</hi> on the
                    occasion of the public funeral of the members of the crew lost in the
                    disaster.</p>
                <p>Respectfully, yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">John Sherman.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
