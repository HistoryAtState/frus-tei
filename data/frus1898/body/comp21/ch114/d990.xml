    <text>
        <body>
            <div xml:id="d990">

                <pb facs="1122" n="1026" sameAs="frus:frus1898/pg1026"/>

                <head>
                    <hi rendition="#italic">Mr. Day to Mr.
                            Lee.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-01-24"><hi rendition="#italic">January 24,
                        1898</hi></date>.</dateline></opener>
                <p><hi rendition="#italic">Maine</hi> has been ordered. Will probably arrive at
                    Havana some time to-morrow. Can not tell hour; possibly early. Cooperate with
                    authorities for her friendly visit. Keep us advised by frequent telegrams.</p>
            </div>
        </body>
    </text>
