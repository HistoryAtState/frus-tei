    <text>
        <body>
            <div xml:id="d508">

                <pb facs="0692" n="596" sameAs="frus:frus1898/pg596"/>

                <head>
                    <hi rendition="#italic">Mr. Sherman to Mr. Woodford.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1897-11-08"><hi rendition="#italic">November 8,
                        1897</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 61.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose for your information copy of the
                    Department’s note of the 6th instant to the Spanish minister at this capital,
                    calling attention to the suffering inflicted upon the rural population of Cuba
                    who have been forcibly concentrated in the towns; also copy of a dispatch from
                    our consul at Matanzas, relating to the same subject.</p>
                <p>Respectfully, yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">John Sherman.</hi>
                    </signed>
                </closer>



                <xi:include href="d508-a1.xml" xpointer="d508-a1"/>
