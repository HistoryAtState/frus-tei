    <text>
        <body>
            <div xml:id="d496">

                <pb facs="0669" n="573" sameAs="frus:frus1898/pg573"/>

                <head>
                    <hi rendition="#italic">Mr. Woodford to Mr. Sherman.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1897-10-02"><hi rendition="#italic">October 2,
                        1897</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 37.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: On Wednesday evening, September 29, ultimo,
                    the Spanish ministry tendered their resignations to the Queen Regent.</p>
                <p>I withhold comment until a new ministry shall have been announced.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stewart L. Woodford.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
