    <text>
        <body>
            <div xml:id="d520">

                <pb facs="0740" n="644" sameAs="frus:frus1898/pg644"/>

                <head>
                    <hi rendition="#italic">Mr. Woodford to Mr.
                            Sherman.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1897-11-28"><hi rendition="#italic">November 28,
                        1897</hi></date>.</dateline></opener>
                <p>Am just informed by Spanish cabinet that no American subject remains imprisoned
                    in Cuba.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Woodford.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
