    <text>
        <body>
            <div xml:id="d627">

                <pb facs="0860" n="764" sameAs="frus:frus1898/pg764"/>

                <head>
                    <hi rendition="#italic">Mr. Sherman to Señor
                            Polo de Bernabé.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-04-20"><hi rendition="#italic">April 20,
                        1898</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to communicate to you a
                    copy of an instruction sent this day to the United States minister at Madrid, by
                    telegraph, in obedience to a joint resolution of the Congress of the United
                    States of America in relation to the pacification of the island of Cuba,
                    approved this day, of which a copy is hereto annexed.</p>
                <p>I avail myself of this opportunity to repeat to you the assurances of my highest
                    consideration.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">John Sherman.</hi>
                    </signed>
                </closer>


                <xi:include href="d627-a1.xml" xpointer="d627-a1"/>
            </div>
        </body>
    </text>
