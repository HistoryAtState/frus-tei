    <text>
        <body>
            <div xml:id="d709">

                <pb facs="0921" n="825" sameAs="frus:frus1898/pg825"/>

                <head>
                    <hi rendition="#italic">The President to Mr. Day.</hi>
                </head>
                <p rendition="#flush"><hi rendition="#small-caps">William R. Day</hi>,<lb/><hi
                        rendition="#italic">Secretary of State:</hi></p>
                <p>You are hereby authorized to sign, on the part of the United States, the protocol
                    of this date embodying the terms on which the United States and Spain have
                    agreed to treat of peace.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">William McKinley.</hi>
                    </signed>
                    <lb/>
                    <dateline rendition="#float-left"><hi rendition="#small-caps">Executive
                            Mansion</hi>,<lb/><placeName><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-08-12"><hi rendition="#italic">August 12,
                        1898</hi></date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
