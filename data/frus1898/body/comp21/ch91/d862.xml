    <text>
        <body>
            <div xml:id="d862">

                <pb facs="1060" n="964" sameAs="frus:frus1898/pg964"/>

                <head>
                    <hi rendition="#italic">Mr. Hay to Mr. Day.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-12-08"><hi rendition="#italic">December 8,
                        1898</hi></date>.</dateline></opener>
                <p>Your No. 37 received. The President sends to all of you his most cordial thanks
                    and congratulations. Permit me to add my own.</p>
                <closer>
                    <signed><hi rendition="#small-caps">John Hay</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
