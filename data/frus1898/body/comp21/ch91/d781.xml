    <text>
        <body>
            <div xml:id="d781">

                <pb facs="1011" n="915" sameAs="frus:frus1898/pg915"/>

                <head>
                    <hi rendition="#italic">The President to Mr.
                            Day.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-09-29"><hi rendition="#italic">September 29,
                        1898</hi></date>.</dateline></opener>
                <p>Present my congratulations to the Commissioners upon their safe arrival in good
                    health and the auspicious beginning of their important work.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">William McKinley.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
