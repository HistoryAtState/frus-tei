                <pb facs="1047" n="951" sameAs="frus:frus1898/pg951"/>

                <head>
                    <hi rendition="#italic">Mr. Hay to Mr. Day.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-11-16"><hi rendition="#italic">November 16,
                        1898</hi></date>.</dateline></opener>
                <p>(Special.)</p>
                <p>Your No. 24 received. The course proposed is approved.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hay.</hi>
                    </signed>
                </closer>
            </div>
        </body>
