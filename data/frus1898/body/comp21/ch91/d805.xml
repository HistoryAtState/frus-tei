    <text>
        <body>
            <div xml:id="d805">

                <pb facs="1025" n="929" sameAs="frus:frus1898/pg929"/>

                <head>
                    <hi rendition="#italic">Mr. Day to Mr.
                            Hay.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1898-10-19"><hi rendition="#italic">October 19,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 12.]</seg></opener>
                <p>The conference which was to have taken place to-day postponed till Friday, on
                    request of Spanish Commissioners.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Day.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
