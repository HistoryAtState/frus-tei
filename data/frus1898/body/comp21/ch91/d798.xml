                <pb facs="1021" n="925" xml:id="pg925"/>

                <head>
                    <hi rendition="#italic">Mr. Hay to Mr.
                            Day.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-10-08"><hi rendition="#italic">October 8,
                        1898</hi></date>.</dateline></opener>
                <p>Your No. 7 received. Your answer to Spanish proposals as therein set forth is
                    approved by the President.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hay.</hi>
                    </signed>
                </closer>
            </div>
        </body>
