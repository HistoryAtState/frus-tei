    <text>
        <body>
            <div xml:id="d865">

                <pb facs="1062" n="966" xml:id="pg966"/>

                <head>
                    <hi rendition="#italic">Mr. Moore to Mr. Hay.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1898-12-16"><hi rendition="#italic">December 16,
                        1898</hi></date>.</dateline></opener>
                <p>Peace Commission sails by the <hi rendition="#italic">St. Louis</hi> from
                    Southampton Saturday and desires, on arrival at New York, to go immediately by
                    the Pennsylvania road, by special train if necessary, to Washington. The
                    Commission hopes to present the treaty to the President December 24.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Moore.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
