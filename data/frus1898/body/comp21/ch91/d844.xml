    <text>
        <body>
            <div xml:id="d844">

                <pb facs="1054" n="958" sameAs="frus:frus1898/pg958"/>

                <head>
                    <hi rendition="#italic">Mr. Day to Mr. Hay.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date
                            ana="#date_imprecise-inferred-from-document-content"
                            calendar="gregorian" when="1898-11-23T22:30:00+00:09"><hi
                                rendition="#italic">November 23, 1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 26 A.]</seg></opener>
                <p>Spanish Commissioners did not answer our proposal to-day. Sent note saying wanted
                    time to communicate with Madrid. Will give answer soon, certainly before
                    28th.</p>
                <closer>
                    <dateline rendition="#float-left"><date calendar="gregorian"
                            when="1898-11-23T22:30:00+00:09">Wednesday evening,
                        10.30</date>.</dateline>
                    <lb/>
                    <signed>
                        <hi rendition="#small-caps">Day.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
