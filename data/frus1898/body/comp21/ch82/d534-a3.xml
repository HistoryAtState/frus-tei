    <text>
        <body>
            <div xml:id="d534-a3">

                <pb facs="0766" n="670" sameAs="frus:frus1898/pg670"/>

                <opener><seg rendition="#center">[Inclosure 2 in No. 147.]</seg></opener>
                <head>
                    <hi rendition="#italic">The Secretary of the Navy to the Secretary of
                        State.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Navy Department</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-02-26"><hi rendition="#italic">February 26,
                        1898</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith, for
                    the information of the Department of State, a copy of a letter, dated the 8th
                    instant, received in this Department from the commanding officer of the <pb
                        facs="0767" n="671" xml:id="pg671"/> U. S. S. <hi rendition="#italic"
                        >Maine</hi>, at Habana, Cuba, in regard to the suffering among many of the
                    inhabitants of the island of Cuba, resulting from conditions of poverty and
                    destitution.</p>
                <p>Very respectfully,</p>
                <closer>
                    <signed><hi rendition="#small-caps">John D. Long</hi>, <hi rendition="#italic"
                            >Secretary.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
