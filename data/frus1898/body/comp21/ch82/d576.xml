    <text>
        <body>
            <div xml:id="d576">

                <pb facs="0817" n="721" sameAs="frus:frus1898/pg721"/>

                <head>
                    <hi rendition="#italic">Mr. Woodford to Mr. Day.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1898-03-30"><hi rendition="#italic">March 30,
                        1898</hi></date>.</dateline></opener>
                <p>There will be no delay beyond Thursday, March 31. If definite results are not
                    then reached, I shall close negotiations.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Woodford.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
