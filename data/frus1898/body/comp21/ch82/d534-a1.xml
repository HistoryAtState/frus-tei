    <text>
        <body>
            <div xml:id="d534-a1">

                <pb facs="0765" n="669" sameAs="frus:frus1898/pg669"/>

                <opener><seg rendition="#center">[Inclosure 1 in No. 147.]</seg></opener>
                <head>
                    <hi rendition="#italic">The Secretary of the Navy to the Secretary of
                        State.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Navy Department</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-02-24"><hi rendition="#italic">February 24,
                        1898</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit, for your
                    information, a copy of a report from the commanding officer of the U. S. S. <hi
                        rendition="#italic">Montgomery</hi>, from Matanzas, concerning the condition
                    of the population of that province.</p>
                <p>Very respectfully,</p>
                <closer>
                    <signed><hi rendition="#small-caps">John D. Long</hi>, <hi rendition="#italic"
                            >Secretary.</hi></signed>
                </closer>
            </div>
        </body>
