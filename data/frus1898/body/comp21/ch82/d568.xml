    <text>
        <body>
            <div xml:id="d568">

                <pb facs="0810" n="714" xml:id="pg714"/>

                <head>
                    <hi rendition="#italic">Señor Polo de Bernabé to Mr. Day.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of Spain</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-03-28"><hi rendition="#italic">March 28,
                        1898</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. Day</hi>: With reference to my letter of the
                    26th instant, I have the honor to inclose you some documents referring to the
                    reconcentrados.</p>
                <p>Very truly, yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Luis Polo de Bernabé.</hi>
                    </signed>
                </closer>






