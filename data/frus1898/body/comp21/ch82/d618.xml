    <text>
        <body>
            <div xml:id="d618">

                <pb facs="0846" n="750" sameAs="frus:frus1898/pg750"/>

                <head>
                    <hi rendition="#italic">Señor Polo de Bernabé
                        to Mr. Day.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Royal Spanish Legation</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-04-11"><hi rendition="#italic">April 11,
                        1898</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. Day</hi>: I inclose herewith the official
                    announcement of General Blanco’s proclamation that I have received this morning
                    and an English translation of said proclamation.</p>
                <p>Believe me, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Polo de Bernabé.</hi>
                    </signed>
                </closer>


                <xi:include href="d618-a1.xml" xpointer="d618-a1"/>
