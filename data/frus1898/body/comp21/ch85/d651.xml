    <text>
        <body>
            <div xml:id="d651">

                <pb facs="0887" n="791" xml:id="pg791"/>

                <head>
                    <hi rendition="#italic">Mr. Moore to Mr.
                            Cambon.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi></placeName>, <date calendar="gregorian"
                            when="1898-05-03"><hi rendition="#italic">May 3,
                        1898</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I have the honor to communicate to
                    you for your information copies of notes just exchanged with the Mexican
                    minister at this capital in relation to extending, at the request of the Spanish
                    minister in Mexico, friendly protection in case of need to Spanish interests at
                    Laredo, Tex., and Nogales, Ariz., through the Mexican consuls in those
                    cities.</p>
                <p>Be pleased to accept, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">J. B. Moore</hi>, <hi rendition="#italic"
                            >Acting Secretary.</hi></signed>
                </closer>



                <xi:include href="d651-a1.xml" xpointer="d651-a1"/>
