    <text>
        <body>
            <div xml:id="d654">

                <pb facs="0888" n="792" sameAs="frus:frus1898/pg792"/>

                <head>
                    <hi rendition="#italic">Mr. Day to Mr. Cambon.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi></placeName>, <date calendar="gregorian"
                            when="1898-05-07"><hi rendition="#italic">May 7,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 19.]</seg></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: Referring to the memorandum left at
                    this Department on the 29th ultimo by the secretary of the French embassy on
                    your behalf, inquiring whether the Spanish schooner <hi rendition="#italic"
                        >Sofia</hi> was among the number of the vessels captured by the Federal
                    fleet, I have the honor to inform you that I am advised by the Secretary of the
                    Navy that the <hi rendition="#italic">Sofia</hi> was captured by the United
                    States torpedo boat <hi rendition="#italic">Porter</hi> off the northern coast
                    of Cuba on the morning of April 24.</p>
                <p>Accept, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">William. R. Day.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
