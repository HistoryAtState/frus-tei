    <text>
        <body>
            <div xml:id="d650">

                <pb facs="0886" n="790" sameAs="frus:frus1898/pg790"/>

                <head>
                    <hi rendition="#italic">Mr. Moore to Mr. Cambon.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi></placeName>, <date calendar="gregorian"
                            when="1898-04-29"><hi rendition="#italic">April 29,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 15.]</seg></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I have the honor to acknowledge the
                    receipt of your note of the 26th instant, transmitting a list of the French
                    officers who have been intrusted with the protection of Spanish subjects and
                    interests in the United States, and to inclose herewith for your information and
                    use six printed copies of the correspondence which has passed between your
                    embassy, the Austro-Hungarian legation and this Department on this subject.</p>
                <p>Accept, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">J. B. Moore</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
