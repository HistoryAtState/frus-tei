    <text>
        <body>
            <div xml:id="d664">

                <pb facs="0892" n="796" sameAs="frus:frus1898/pg796"/>

                <head>
                    <hi rendition="#italic">Mr. Moore to Mr.
                            Cambon.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi></placeName>, <date calendar="gregorian"
                            when="1898-06-30"><hi rendition="#italic">June 30,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 42.]</seg></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: With reference to previous
                    correspondence as to the disposition of the crews of prizes at Key West, I now
                    have the honor to say that this Government will attend to their transportation
                    from Key West to New York, and that it is hoped that you may be able soon to
                    arrange for their transportation from the United States at that point.</p>
                <p>Accept, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">J. B. Moore.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
