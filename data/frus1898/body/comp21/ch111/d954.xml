    <text>
        <body>
            <div xml:id="d954">

                <pb facs="1102" n="1006" sameAs="frus:frus1898/pg1006"/>

                <head>
                    <hi rendition="#italic">Mr. Hay to Mr. White.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-11-19"><hi rendition="#italic">November 19,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 959.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In view of a letter from the Secretary of
                    the Navy, dated the 15th instant, you are instructed to make, if practicable,
                    arrangements with the British Government permitting the bringing to the United
                    States of the torpedo boat <hi rendition="#italic">Somers</hi>, now stored at
                    Falmouth, England, giving assurance that in case of the resumption of
                    hostilities with Spain this vessel will not be made use of.</p>
                <p>I am, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">John Hay.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
