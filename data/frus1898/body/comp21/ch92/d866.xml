    <text>
        <body>
            <div xml:id="d866">

                <pb facs="1062" n="966" sameAs="frus:frus1898/pg966"/>

                <head>
                    <hi rendition="#italic">Mr. Day to Sir
                            Julian Pauncefote.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-04-05"><hi rendition="#italic">April 5,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left"><hi rendition="#small-caps"
                        >Confidential</hi>,<lb/>No. 966.</seg></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I have the honor to request that, in
                    case of trouble between Spain and the United States, the British consul-general
                    at Habana may take charge of the American property and papers belonging to the
                    American, consulate there, which will be turned over by General Lee to him. I
                    have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">William R. Day.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
