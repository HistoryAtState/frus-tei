    <text>
        <body>
            <div xml:id="d1160">

                <pb facs="1240" n="1144" xml:id="pg1144"/>

                <head>
                    <hi rendition="#italic">Mr. Loomis to Mr. Day.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Caracas</hi></placeName>, <date calendar="gregorian"
                            when="1898-06-30"><hi rendition="#italic">June 30, 1898</hi></date>.
                        (Received 11.06 a.m.)</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Day</hi>, <hi rendition="#italic"
                        >Secretary, Washington:</hi></p>
                <p>President of Venezuela informally offers Scandella $1,600 cash, with full
                    reimbursement of property taken or destroyed by Government and liberty to
                    return. May I settle?</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Loomis.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
