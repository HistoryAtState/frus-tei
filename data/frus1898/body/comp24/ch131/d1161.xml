    <text>
        <body>
            <div xml:id="d1161">

                <pb facs="1240" n="1144" sameAs="frus:frus1898/pg1144"/>

                <head>
                    <hi rendition="#italic">Mr. Moore to Mr. Loomis.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-06-30"><hi rendition="#italic">June 30,
                        1898</hi></date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Loomis</hi>, <hi
                        rendition="#italic">Minister, Caracas:</hi></p>
                <p>Accept offer $1,600 cash and full reimbursement property taken or destroyed by
                    Government, with liberty Scandella’s formal concurrence in settlement.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Moore</hi>, <hi rendition="#italic"
                            >Acting.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
