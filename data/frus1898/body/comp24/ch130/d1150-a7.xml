        <body>
            <div xml:id="d1150-a7">

                <pb facs="1228" n="1132" sameAs="frus:frus1898/pg1132"/>

                <opener><seg rendition="#center">[Press telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Caracas</hi>, <hi rendition="#italic">via Haiti</hi></placeName>
                            (<date calendar="gregorian" when="1898-05-16"><hi rendition="#italic"
                                >May 16, 1898</hi></date>).</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Sherman</hi>,<lb/><hi
                        rendition="#italic">Secretary, Washington:</hi></p>
                <p>Fleet left Curacao Sunday evening 6, steering west.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Loomis.</hi>
                    </signed>
                </closer>
            </div>
        </body>
