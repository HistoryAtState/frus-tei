                <pb facs="1226" n="1130" sameAs="frus:frus1898/pg1130"/>

                <head>
                    <hi rendition="#italic">Mr. Loomis to Mr. Sherman.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Caracas</hi></placeName>, <date calendar="gregorian"
                            when="1898-04-29"><hi rendition="#italic">April 29, 1898</hi></date>.
                        (Received 2.16 p.m.)</dateline></opener>
                <p>Small Spanish war vessel cruising lower Caribbean Sea stopping ships off Little
                    Curaçao.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Loomis.</hi>
                    </signed>
                </closer>
            </div>
        </body>
