    <text>
        <body>
            <div xml:id="d1156">

                <pb facs="1233" n="1137" sameAs="frus:frus1898/pg1137"/>

                <head>
                    <hi rendition="#italic">Mr. Day to Mr.
                            Loomis.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-07-07"><hi rendition="#italic">July 7,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 153.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    No. 157, of the 19th ultimo, stating that you have been furnishing the
                    Venezuelan newspapers with matter showing the true attitude of the United States
                    in its relations with Spain, and that there has been a distinct improvement in
                    the views expressed by the press toward this country.</p>
                <p>The Department cordially approves your action and is much gratified at the
                    improved tone of sentiment resulting from it.</p>
                <p>Respectfully, yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">William R. Day.</hi>
                    </signed>
                </closer>


                <xi:include href="d1156-a1.xml" xpointer="d1156-a1"/>
            </div>
        </body>
    </text>
