    <text>
        <body>
            <div xml:id="d1150">

                <pb facs="1227" n="1131" xml:id="pg1131"/>

                <head>
                    <hi rendition="#italic">Mr. Loomis to Mr.
                            Sherman.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Caracas</hi></placeName>, <date calendar="gregorian"
                            when="1898-05-02"><hi rendition="#italic">May 2,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 128.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith the
                    answer of the Venezuelan Government to my note transmitting a copy of your
                    cablegram of April 26 in reference to the existence of a state of war between
                    the United States and Spain.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Francis B. Loomis.</hi>
                    </signed>
                </closer>









