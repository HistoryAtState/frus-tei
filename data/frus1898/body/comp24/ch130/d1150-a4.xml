    <text>
        <body>
            <div xml:id="d1150-a4">

                <pb facs="1228" n="1132" sameAs="frus:frus1898/pg1132"/>

                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-05-14"><hi rendition="#italic">May 14,
                        1898</hi></date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Loomis</hi>,<lb/><hi
                        rendition="#italic">Minister, Caracas:</hi></p>
                <p>Ascertain immediately from consul, Curacao, number of Spanish ships, how much
                    coal they took, and any other information.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Moore</hi>, <hi rendition="#italic"
                            >Assistant.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
