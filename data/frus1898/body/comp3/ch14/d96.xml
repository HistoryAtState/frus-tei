    <text>
        <body>
            <div xml:id="d96">

                <pb facs="0258" n="162" sameAs="frus:frus1898/pg162"/>

                <head>
                    <hi rendition="#italic">Mr. Sherman to Mr. Storer.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-01-14"><hi rendition="#italic">January 14,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 88.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose for your information copy of a
                    letter from the Secretary of Agriculture asking whether the Department has
                    knowledge of any proposed regulations respecting the importation of salted meats
                    into Belgium.</p>
                <p>You are requested to make inquiries in regard to the subject in the proper
                    quarter and to report the result to the Department.</p>
                <p>Respectfully, yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">John Sherman.</hi>
                    </signed>
                </closer>




                <xi:include href="d96-a1.xml" xpointer="d96-a1"/>
