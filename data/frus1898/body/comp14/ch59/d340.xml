    <text>
        <body>
            <div xml:id="d340">

                <pb facs="0505" n="409" xml:id="pg409"/>

                <head>
                    <hi rendition="#italic">Mr. Sherman to Count
                            Vinci.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-04-09"><hi rendition="#italic">April 9,
                        1898.</hi></date></dateline>
                    <seg rendition="#float-left">No. 319.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to the Department’s note of the
                    5th instant, I have the honor to inclose for your information copy of a letter
                    from the Secretary of the Treasury stating that his order abolishing the Italian
                    bureau at the immigration station at the port of New York has been temporarily
                    suspended.</p>
                <p>Accept, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">John Sherman.</hi>
                    </signed>
                </closer>


                <xi:include href="d340-a1.xml" xpointer="d340-a1"/>
