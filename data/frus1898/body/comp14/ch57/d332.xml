    <text>
        <body>
            <div xml:id="d332">

                <pb facs="0501" n="405" sameAs="frus:frus1898/pg405"/>

                <head>
                    <hi rendition="#italic">The ambassador of the United States of America in Rome
                        to the minister of foreign affairs of Italy.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Rome</hi></placeName>, <date calendar="gregorian" when="1895-03-30"
                                ><hi rendition="#italic">March 30,
                    1895</hi></date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Your Excellency</hi>:</p>
                <p>I have the honor to refer to my note of the 1st of March, addressed to your
                    excellency, and to enclose herewith, in confirmation of the information, which I
                    then had the pleasure of transmitting, a copy of the note which I have received
                    from the Department of State, announcing the acceptance by the President of the
                    United States of the joint invitation of the Governments of Italy and Colombia
                    to arbitrate between them in regard to the claims of one Ernest Cerruti.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wayne MacVeagh.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
