    <text>
        <body>
            <div xml:id="d379">

                <pb facs="0543" n="447" sameAs="frus:frus1898/pg447"/>

                <head>
                    <hi rendition="#italic">Mr. Buck to Mr.
                            Sherman.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Tokyo, Japan</hi></placeName>, <date calendar="gregorian"
                            when="1898-04-01"><hi rendition="#italic">April 1,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 114.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith
                    translation copy of an imperial ordinance bringing into operation the law
                    providing for a bounty to be paid to Japanese exporters of raw silk.</p>
                <p>I am informed by the foreign office that under the constitution the Government
                    has been obliged against its will to bring this law into operation, though steps
                    will be taken to secure its repeal upon the assembling of the Imperial Diet, on
                    or about the 15th of May next.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">A. E. Buck.</hi>
                    </signed>
                </closer>




                <xi:include href="d379-a1.xml" xpointer="d379-a1"/>
