    <text>
        <body>
            <div xml:id="d377">

                <pb facs="0541" n="445" sameAs="frus:frus1898/pg445"/>

                <head>
                    <hi rendition="#italic">Mr. Day to Mr.
                            Hoshi.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1897-06-10"><hi rendition="#italic">June 10,
                        1897</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 41.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Reserving consideration of the statements
                    and representations therein contained, I have the honor to acknowledge the
                    receipt of your note of the 4th instant, in reply to that of this Department of
                    the 2d instant, respecting the recent legislation of Japan granting a bounty for
                    the exportation of silk by Japanese subjects.</p>
                <p>Accept, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">William R. Day</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed>
                </closer>
            </div>
        </body>
