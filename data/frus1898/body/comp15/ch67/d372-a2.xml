    <text>
        <body>
            <div xml:id="d372-a2">

                <pb facs="0535" n="439" sameAs="frus:frus1898/pg439"/>

                <opener><seg rendition="#center">[Inclosure 2 in No. 488.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Yokohama General Chamber of Commerce</hi>,<lb/><hi
                                rendition="#italic">Yokohama</hi></placeName>, <date
                            calendar="gregorian" when="1897-04-08"><hi rendition="#italic">April 8,
                                1897</hi></date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Your Excellency</hi>:</p>
                <p>I have the honor to hand you herewith a letter addressed to you as “doyen” of the
                    diplomatic corps of Tokyo by the committee of this chamber, and to inform you
                    that printed copies of the same will be forwarded to all the foreign
                    representatives here.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">Akin</hi>, <hi rendition="#italic"
                            >Secretary.</hi></signed>
                </closer>
                <postscript>
                    <p>His Excellency <hi rendition="#small-caps">Edwin Dunn</hi>, etc.</p>
                </postscript>
            </div>
        </body>
    </text>
