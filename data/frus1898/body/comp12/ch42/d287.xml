    <text>
        <body>
            <div xml:id="d287">

                <pb facs="0464" n="368" sameAs="frus:frus1898/pg368"/>

                <head>
                    <hi rendition="#italic">Mr. Day to Mr. Hay.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-05-12"><hi rendition="#italic">May 12,
                        1898</hi></date>.</dateline></opener>
                <p>Telegram about missionaries received. Inquire as to the fate of Mr. and Mrs. L.
                    A. McGrew, stationed about 40 miles farther interior than Rotifunk.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Day.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
