    <text>
        <body>
            <div xml:id="d289-a2">

                <pb facs="0465" n="369" sameAs="frus:frus1898/pg369"/>

                <opener><seg rendition="#center">[Inclosure 2 in No. 400—Telegram.]</seg></opener>
                <head>
                    <hi rendition="#italic">Mr. Hay to Mr.
                            Day.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >London</hi></placeName>, <date calendar="gregorian" when="1898-05-18"
                                ><hi rendition="#italic">May 18,
                    1898</hi></date>.</dateline></opener>
                <p>Re McGrews. Further informed by colonial office, Taima, 10 miles interior from
                    Kwabu. Relief column from Freetown sent thither 12th instant.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hay.</hi>
                    </signed>
                </closer>
            </div>
        </body>
