    <text>
        <body>
            <div xml:id="d269">

                <pb facs="0451" n="355" sameAs="frus:frus1898/pg355"/>

                <head>
                    <hi rendition="#italic">Mr. Hay to Mr. Sherman.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >London</hi></placeName>, <date calendar="gregorian" when="1898-01-11"
                                ><hi rendition="#italic">January 11, 1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 208.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to your instruction No. 334, of
                    the 2d ultimo, I have the honor to inclose herewith copies of a note which I
                    addressed to the Marquis of Salisbury expressing thanks for the action of Sir
                    Philip Currie, the British ambassador at Constantinople, in authorizing the
                    vice-consul at Van to take charge of American interests there and of the reply
                    which I have received thereto.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">John Hay.</hi>
                    </signed>
                </closer>




                <xi:include href="d269-a1.xml" xpointer="d269-a1"/>
