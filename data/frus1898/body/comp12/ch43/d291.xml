    <text>
        <body>
            <div xml:id="d291">

                <pb facs="0466" n="370" sameAs="frus:frus1898/pg370"/>

                <head>
                    <hi rendition="#italic">Mr. Day to Mr. Hay.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-05-21"><hi rendition="#italic">May 21,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 643.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I append on the overleaf copy of my
                    telegram of the 19th instant, directing you to express to his family, through
                    the proper channel, the sympathy of the American people, in view of the death of
                    Mr. Gladstone.</p>
                <p>Respectfully, yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">William R. Day.</hi>
                    </signed>
                </closer>


                <xi:include href="d291-a1.xml" xpointer="d291-a1"/>
