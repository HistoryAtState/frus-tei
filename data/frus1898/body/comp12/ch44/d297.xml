    <text>
        <body>
            <div xml:id="d297">

                <pb facs="0469" n="373" sameAs="frus:frus1898/pg373"/>

                <head>
                    <hi rendition="#italic">Mr. Day to Sir
                            Julian Pauncefote.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-07-28"><hi rendition="#italic">July 28,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1108.]</seg></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I have the honor to acknowledge the
                    receipt of your note of the 25th instant, expressing the satisfaction felt by
                    the Government of Her Majesty at the action of the Congress of the United States
                    in making the necessary appropriation to enable this Government to discharge its
                    obligations under the treaty of February 8, 1896.</p>
                <p>I beg to assure you that this Government shares the sentiments of the Marquis of
                    Salisbury in regard to the final settlement of the claims in question.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">William R. Day.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
