    <text>
        <body>
            <div xml:id="d409">

                <pb facs="0586" n="490" sameAs="frus:frus1898/pg490"/>

                <head>
                    <hi rendition="#italic">Mr. Allen to Mr.
                            Day.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Seoul, Korea</hi></placeName>, <date calendar="gregorian"
                            when="1898-05-14"><hi rendition="#italic">May 14,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 106. Diplomatic]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inform you that, in
                    accordance with the Department’s instructions contained in your dispatch No. 63,
                    of March 29 last, I have conveyed to His Majesty the Emperor of Korea my
                    Government’s congratulations on the assumption of his new title.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Horace N. Allen.</hi>
                    </signed>
                </closer>
            </div>
        </body>
