    <text>
        <body>
            <div xml:id="d402-a1">

                <pb facs="0582" n="486" sameAs="frus:frus1898/pg486"/>

                <opener><seg rendition="#center">[Inclosure.]</seg></opener>
                <p rendition="#flush">His <hi rendition="#small-caps">Majesty the Emperor
                    Korea</hi>, <hi rendition="#italic">Seoul:</hi></p>
                <p>I express my deep thanks and sincere wishes that the cordial relations between
                    Russia and Korea be ever tighter and stronger.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Nicolai.</hi>
                    </signed>
                </closer>
            </div>
        </body>
