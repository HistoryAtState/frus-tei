    <text>
        <body>
            <div xml:id="d403">

                <pb facs="0582" n="486" sameAs="frus:frus1898/pg486"/>

                <head>
                    <hi rendition="#italic">Mr. Allen to Mr. Sherman.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Seoul, Korea</hi></placeName>, <date calendar="gregorian"
                            when="1898-01-01"><hi rendition="#italic">January 1,
                        1898</hi></date>.</dateline></opener>
                <p>The Government of Japan and the Government of Russia formally acknowledged
                    Imperial title of ruler of Korea.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Allen.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
