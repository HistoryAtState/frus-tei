    <text>
        <body>
            <div xml:id="d1089">

                <pb facs="0712" n="1762" sameAs="frus:frus1952-54v11p2/pg1762"/>

                <note rend="inline" type="source">891.2546/7–254</note>
                <head><hi rendition="#italic">The Director of the Foreign Operations
                        Administration</hi> (<hi rendition="#italic">Stassen</hi>) <hi
                        rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">secret</hi></seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1954-07-02">July 2, 1954</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Dear Mr. Secretary</hi>: There are transmitted
                    herewith, in accordance with the instructions of the President, a copy of his
                    Memorandum of Determination with respect to the purchase of thorium nitrate from
                    and related technical assistance to the Government of India, and a copy of my
                    memorandum upon which this action was based.</p>
                <p>Sincerely yours,</p>
                <closer><signed><hi rendition="#small-caps">Harold E. Stassen</hi></signed></closer>



