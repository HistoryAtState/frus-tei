    <text>
        <body>
            <div xml:id="d625">

                <pb facs="0070" n="1120" sameAs="frus:frus1952-54v11p2/pg1120"/>

                <note rend="inline" type="source">S/S–NSC files, lot 63 D 351, “NSC 5409—Memoranda”</note>
                <head><hi rendition="#italic">Memorandum by the Executive Secretary</hi> (<hi rendition="#italic">Lay</hi>)
                        <hi rendition="#italic">to the National Security
                            Council</hi><anchor n="1" xml:id="d625-f1"/></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">secret</hi></seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1954-03-02">March 2, 1954</date>.</dateline>
                </opener>
                <list subtype="subject" type="description">
                    <label>Subject:</label>
                    <item>U.S. Policy Toward South Asia</item>
                </list>
                <list type="references">
                    <head>References:</head>
                    <item>A. NSC 5409<anchor n="2" xml:id="d625-f2"
                        /></item>
                    <item>B. Memo for NSC from Executive Secretary,
                        same subject, dated February 23, 1954<anchor n="3" xml:id="d625-f3"/></item>
                </list>
                <p>The enclosed revised Financial Appendix for the reference report on the subject
                    is transmitted herewith for Council information in connection with its
                    consideration of NSC 5409 at its meeting on
                    March 4, 1954.<anchor n="4" xml:id="d625-f4"/> The enclosure supersedes the
                    Financial Appendix transmitted by the reference memorandum of February 23 which
                    should be destroyed by burning.</p>
                <closer><signed><hi rendition="#small-caps">James S.
                                Lay, Jr</hi>.</signed></closer>



                <xi:include href="d625-a1.xml" xpointer="d625-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d625-f1" n="1" type="source" xml:id="d625-f1-content">
                <p>Copies of this memorandum and the enclosure to it were furnished to the Secretary
                    of the Treasury, the Director of the Bureau of the Budget, the Chairman of the
                    Joint Chiefs of Staff, and the Director of Central Intelligence.</p>
            </note>
            <note corresp="#d625-f2" n="2" xml:id="d625-f2-content">
                <p>Dated Feb. 19, <ref target="#pg1089">p. 1089</ref>.</p>
            </note>
            <note corresp="#d625-f3" n="3" xml:id="d625-f3-content">
                <p>Not printed. (S/S–NSC files, lot 63 D 351, “NSC
                    5409—Memoranda”)</p>
            </note>
            <note corresp="#d625-f4" n="4" xml:id="d625-f4-content">
                <p>See the memorandum of discussion, <ref target="#d626"><hi rendition="#italic"
                            >infra</hi></ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
