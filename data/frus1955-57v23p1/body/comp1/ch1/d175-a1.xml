                <pb facs="0383" n="355" sameAs="frus:frus1955-57v23p1/pg355"/>


                <p>Japan’s force goals and actual strength may be summarized as follows:</p>
                <table cols="4" rows="15">
                    <row>
                        <cell/>
                        <cell><hi rendition="#italic">Army</hi></cell>
                        <cell><hi rendition="#italic">Navy</hi></cell>
                        <cell><hi rendition="#italic">Air Force</hi></cell>
                    </row>
                    <row>
                        <cell>Original J.C.S. Goal<anchor n="2" xml:id="d175-f1"/></cell>
                        <cell>15 divisions</cell>
                        <cell>300,000 tons</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell/>
                        <cell/>
                        <cell>10 squadrons</cell>
                        <cell>36 squadrons</cell>
                    </row>
                    <row>
                        <cell>Revised J.C.S. Goal<anchor n="3" xml:id="d175-f2"/></cell>
                        <cell>8 divisions</cell>
                        <cell>120,000 tons</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell/>
                        <cell>4 brigades</cell>
                        <cell>8 squadrons</cell>
                        <cell>30 squadrons</cell>
                    </row>
                    <row>
                        <cell>Japan Six-Year Plan</cell>
                        <cell>6 divisions</cell>
                        <cell>107,000 tons</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell/>
                        <cell>4 brigades</cell>
                        <cell>5.8 squadrons</cell>
                        <cell>33 squadrons</cell>
                    </row>
                    <row>
                        <cell>Planned by end of JFY 1960</cell>
                        <cell>180,000 soldiers</cell>
                        <cell>33,240 sailors</cell>
                        <cell>44,050 airmen</cell>
                    </row>
                    <row>
                        <cell>" " " " 1959</cell>
                        <cell>180,000 "</cell>
                        <cell>30,134 "</cell>
                        <cell>41,795 "</cell>
                    </row>
                    <row>
                        <cell>" " " " 1958</cell>
                        <cell>180,000 "</cell>
                        <cell>28,611 "</cell>
                        <cell>33,340 ”</cell>
                    </row>
                    <row>
                        <cell>" " " " 1957</cell>
                        <cell>170,000 "</cell>
                        <cell>27,761 "</cell>
                        <cell>25,600 "</cell>
                    </row>
                    <row>
                        <cell>" " " " 1956</cell>
                        <cell>160,000 "</cell>
                        <cell>26,000 "</cell>
                        <cell>22,600 "</cell>
                    </row>
                    <row>
                        <cell>Force now in being</cell>
