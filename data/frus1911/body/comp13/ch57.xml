    <text>
        <body>
            <div xml:id="ch57">

                <pb facs="0271" n="189" sameAs="frus:frus1911/pg189"/>

                <head>Extradition treaty between France and the United States</head>
                <p><hi rendition="#italic">Signed at Paris January 6, 1909.</hi></p>
                <p><hi rendition="#italic">Ratification advised by the Senate, with amendment, April
                        5, 1909</hi></p>
                <p><hi rendition="#italic">Ratified by the President May 25, 1911.</hi></p>
                <p><hi rendition="#italic">Ratified by France June 27, 1911.</hi></p>
                <p><hi rendition="#italic">Ratifications exchanged at Paris June 27, 1911.</hi></p>
                <p><hi rendition="#italic">Proclaimed July 26, 1911.</hi></p>

                <xi:include href="ch57/d239.xml" xpointer="d239"/>
