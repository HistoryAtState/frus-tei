                <pb facs="0389" n="307" sameAs="frus:frus1911/pg307"/>

                <note rend="inline" type="source">File No. 815.00/1326.</note>
                <head><hi rendition="#italic">The American Chargé d’Affaires to the Secretary of
                        State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                                >Tegucigalpa</hi></placeName>, <date calendar="gregorian"
                            when="1911-07-25"><hi rendition="#italic">July 25,
                        1911</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 211.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to report that the period
                    of martial law, extended by presidential decree on May 19, was to-day declared
                    terminated by public proclamation as of date of July 20.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">J. Butler Wright.</hi></signed></closer>
            </div>
        </body>
