                <pb facs="0776" n="694" xml:id="pg694"/>

                <note rend="inline" type="source">File No. 853.00/210.</note>
                <head><hi rendition="#italic">The Minister of Portugal to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of Portugal</hi>,<lb/><hi rendition="#italic">Deer
                                Park</hi></placeName>, <date calendar="gregorian" when="1911-07-06"
                                ><hi rendition="#italic">July 6,
                    1911</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose a copy of a
                    dispatch I have received from the minister for foreign affairs at Lisbon.</p>
                <p>I avail, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alte.</hi></signed></closer>


                <xi:include href="d1008-a1.xml" xpointer="d1008-a1"/>
