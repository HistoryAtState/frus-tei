                <pb facs="0237" n="155" xml:id="pg155"/>

                <note rend="inline" type="source">File No. 738.8915/39.</note>
                <head><hi rendition="#italic">The American Minister to Haiti to the Secretary of
                        State.</hi></head>
                <opener><seg rendition="#center">[Telegram—Paraphrase.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">Port au
                                Prince</hi></placeName>, <date calendar="gregorian"
                            when="1911-01-22"><hi rendition="#italic">January 22,
                        1911</hi></date>.</dateline></opener>
                <p>Conveys the great appreciation of the President of Haiti for the friendly proffer
                    of good offices extended by the Government of the United States.</p>
                <closer><signed><hi rendition="#small-caps">Furniss.</hi></signed></closer>
            </div>
        </body>
