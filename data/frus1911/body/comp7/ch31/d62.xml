                <note rend="inline" type="source">File No. 893.5211/3.</note>
                <head><hi rendition="#italic">The American Chargé
                            d’Affaires to the Secretary of
                        State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Peking</hi></placeName>, <date calendar="gregorian" when="1911-10-10"
                                ><hi rendition="#italic">October 10, 1911</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 346.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose [etc.] * * *.
                    The legation would be pleased to learn the views of the Department on the
                    subject discussed in the inclosure herein.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">E. T. Williams.</hi></signed></closer>


                <xi:include href="d62-a1.xml" xpointer="d62-a1"/>
