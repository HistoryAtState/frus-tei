                <pb facs="0168" n="86" sameAs="frus:frus1911/pg86"/>

                <note rend="inline" type="source">File No. 893.3311/23.</note>
                <head><hi rendition="#italic">The American Chargé d’Affaires at
                            Peking to the Secretary of
                    State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Peking</hi></placeName>, <date calendar="gregorian" when="1911-09-29"
                                ><hi rendition="#italic">September 29, 1911</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 342.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a copy
                    in translation of a note received from the Prince of Ch’ing conveying the thanks
                    of the Chinese Government for the reception accorded the Chinese cruiser <hi
                        rendition="#italic">Hai Ch’i</hi> on the 10th instant.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">E. T. Williams.</hi></signed></closer>


                <xi:include href="d70-a1.xml" xpointer="d70-a1"/>
