    <text>
        <body>
            <div xml:id="d23">

                <pb facs="0096" n="14" sameAs="frus:frus1911/pg14"/>

                <note rend="inline" type="source">File No. 585.7A2/262.</note>
                <head><hi rendition="#italic">The American Delegates to the Third
                            International Conference on Maritime Law to the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Richmond, Va.</hi></placeName>, <date calendar="gregorian"
                            when="1911-02-14"><hi rendition="#italic">February 14,
                        1911</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose the report of
                    the American delegates upon the convention relating to salvage adopted by the
                    Third International Conference on Maritime Law on September 23, 1910.<anchor
                        n="2" xml:id="d23-f1"/></p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">A. J. Montague.</hi></signed></closer>



                <xi:include href="d23-a1.xml" xpointer="d23-a1"/>
                <xi:include href="d23-a2.xml" xpointer="d23-a2"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d23-f1" n="2" xml:id="d23-f1-content">
                <p>For date of original report see, belpw, the letter of Charles C. Burhngham,
                    transmitting the Report on Collisions.</p>
            </note>
        </listAnnotation>
    </standOff>
