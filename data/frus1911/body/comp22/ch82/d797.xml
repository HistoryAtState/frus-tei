    <text>
        <body>
            <div xml:id="d797">

                <pb facs="0618" n="536" sameAs="frus:frus1911/pg536"/>

                <note rend="inline" type="source">File No. 3172/73–75.</note>
                <head><hi rendition="#italic">The American Ambassador to the Secretary of
                        State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Mexico</hi></placeName>, <date calendar="gregorian" when="1908-02-27"
                                ><hi rendition="#italic">February 27, 1908</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 925.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I acknowledge the receipt of the
                    Department’s No. 397, of the 29th ultimo (File No. 3172/71), m which I am
                    directed [etc.].</p>
                <p>Copies of my note of the 11th instant presenting this matter to the attention of
                    the minister for foreign affairs and his reply thereto of the 19th
                        instant,<anchor n="1" xml:id="d797-f1"/> with translation, are inclosed.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">D. E. Thompson.</hi></signed></closer>


                <xi:include href="d797-a1.xml" xpointer="d797-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d797-f1" n="1" xml:id="d797-f1-content">
                <p>Not printed; acknowledgment merely.</p>
            </note>
