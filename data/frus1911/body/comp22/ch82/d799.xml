                <pb facs="0620" n="538" sameAs="frus:frus1911/pg538"/>

                <note rend="inline" type="source">File No. 8172/83.</note>
                <head><hi rendition="#italic">The American Ambassador to the Secretary of
                        State.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Mexico</hi></placeName>, <date calendar="gregorian" when="1908-04-02"
                                ><hi rendition="#italic">April 2,
                    1908</hi></date>.</dateline></opener>
                <p>Your telegram March 4 and instruction 421, March 5. This Government concedes all
                    asked.</p>
                <closer><signed><hi rendition="#small-caps">Thompson.</hi></signed></closer>
            </div>
        </body>
    </text>
