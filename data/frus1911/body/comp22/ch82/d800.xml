            <div xml:id="d800">

                <pb facs="0620" n="538" sameAs="frus:frus1911/pg538"/>

                <note rend="inline" type="source">File No. 3172/85–86.</note>
                <head>[Extract.]</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Mexico</hi></placeName>, <date calendar="gregorian" when="1908-04-02"
                                ><hi rendition="#italic">April 2, 1908</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 984.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose a copy and translation of the
                    note from the foreign office, under date of the 31st ultimo, received to-day,
                    upon which my telegram of this date was based.</p>
                <p>I have [etc.],</p>
                <closer><signed><hi rendition="#small-caps">D. E. Thompson.</hi></signed></closer>


                <xi:include href="d800-a1.xml" xpointer="d800-a1"/>
