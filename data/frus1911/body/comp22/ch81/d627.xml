            <div xml:id="d627">

                <pb facs="0526" n="444" sameAs="frus:frus1911/pg444"/>

                <note rend="inline" type="source">File No. 812.032/3</note>
                <head><hi rendition="#italic">The American Ambassador to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Mexico</hi></placeName>, <date calendar="gregorian" when="1911-04-05"
                                ><hi rendition="#italic">April 5, 1911</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 434.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit to the
                    Department * * * herewith the Spanish and English text of the message of
                    President <pb facs="0527" n="445" xml:id="pg445"/> Diaz to Congress, delivered
                    on the occasion of the opening of Congress on the evening of the 1st
                    instant.</p>
                <p>I have, [etc.],</p>
                <closer><signed><hi rendition="#small-caps">Henry Lane
                    Wilson.</hi></signed></closer>


                <xi:include href="d627-a1.xml" xpointer="d627-a1"/>
