    <text>
        <body>
            <div xml:id="d681">

                <pb facs="0554" n="472" sameAs="frus:frus1911/pg472"/>

                <note rend="inline" type="source">File No. 812.00/1699.</note>
                <head><hi rendition="#italic">The American Ambassador to the Secretary of
                        State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Mexico</hi></placeName>, <date calendar="gregorian" when="1911-05-03"
                                ><hi rendition="#italic">May 3, 1911</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 518.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to the Department’s telegram of
                    April 28,<anchor n="1" xml:id="d681-f1"/> transmitting a telegram received from
                    the chargé d’affaires of the United <pb facs="0555" n="473" xml:id="pg473"/>
                    States at Buenos Aires, I have the honor to transmit to the Department herewith
                    copy of an informal note which I have just sent to Mr. de la Barra in the
                    matter.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Henry Lane
                    Wilson.</hi></signed></closer>


                <xi:include href="d681-a1.xml" xpointer="d681-a1"/>
            </div>
        </body>
    </text>
