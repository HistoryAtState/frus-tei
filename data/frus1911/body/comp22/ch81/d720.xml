    <text>
        <body>
            <div xml:id="d720">

                <pb facs="0570" n="488" sameAs="frus:frus1911/pg488"/>

                <note rend="inline" type="source">File No. 812.00/1879.</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Mexican Ambassador.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1911-05-20"><hi rendition="#italic">May 20,
                        1911</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Ambassador</hi>: Referring to your
                        request<anchor n="1" xml:id="d720-f1"/> of this morning I hasten to inform
                    you that the soldiers detained by our military authorities at San Diego are now
                    all to be released under orders already issued by the War Department.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">P. C. Knox.</hi></signed></closer>
            </div>
        </body>
    </text>
