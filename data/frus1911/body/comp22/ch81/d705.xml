    <text>
        <body>
            <div xml:id="d705">

                <pb facs="0564" n="482" sameAs="frus:frus1911/pg482"/>

                <note rend="inline" type="source">File No. 812.00/1808.</note>
                <head><hi rendition="#italic">The President to the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >The White House</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1911-05-12"><hi rendition="#italic">May 12,
                        1911</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I inclose herewith a copy
                    of a letter which I have written, after a consideration of the discussion
                    to-day, to the Secretary of the Treasury to guide him in the conduct of the
                    business of the customhouse at El Paso.</p>
                <p>I have sent a copy of this letter to the Attorney General and the Secretary of
                    War.</p>
                <p>Sincerely, yours,</p>
                <closer><signed><hi rendition="#small-caps">Wm. H. Taft.</hi></signed></closer>


                <xi:include href="d705-a1.xml" xpointer="d705-a1"/>
