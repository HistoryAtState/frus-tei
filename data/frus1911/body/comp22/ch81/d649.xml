    <text>
        <body>
            <div xml:id="d649">

                <pb facs="0537" n="455" sameAs="frus:frus1911/pg455"/>

                <note rend="inline" type="source">File No. 812.00/1205.</note>
                <head><hi rendition="#italic">The Secretary of State to the Mexican Chargé
                        d’Affaires.</hi></head>
                <p>Referring to the memorandum of the Embassy of Mexico, of the 18th ultimo, stating
                    that it is informed that the I. C. Hirsch Iron, Steel &amp; Rail Co. of
                    Cincinnati has received orders for the purchase of certain arms and ammunition,
                    the Department of State has the honor to inclose herewith, for the embassy’s
                    information, a copy of a letter from the Assistant Attorney General, stating
                    that the Department <pb facs="0538" n="456" xml:id="pg456"/> of Justice will
                    have an investigation made with a view to determining whether these articles are
                    likely to be used in military operations against Mexico.</p>
                <closer><dateline rendition="#float-left"><hi rendition="#small-caps">Department of
                            State</hi>,<lb/><placeName><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1911-04-13"><hi rendition="#italic">April 13,
                        1911</hi></date>.</dateline></closer>


                <xi:include href="d649-a1.xml" xpointer="d649-a1"/>
