                <pb facs="0518" n="436" sameAs="frus:frus1911/pg436"/>

                <note rend="inline" type="source">File No. 812.00/1194.</note>
                <head><hi rendition="#italic">The Confidential Agent of the
                            Provisional Government of Mexico to the Secretary of State.</hi></head>
                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Confidential Agency of the Mexican Provisional
                                Government</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1911-03-27"><hi rendition="#italic">March 27,
                        1911</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 3.]</seg></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I have the honor to transmit to your
                    excellency the notes which I have received from Francisco I. Madero, President
                    of the Provisional Government of Mexico and chief of the Mexican insurrection,
                    for delivery to the American Government.</p>
                <p>In thus obeying the instructions of the said Provisional Government, I have the
                    honor to express to your excellency the assurances of my highest and most
                    distinguished consideration.</p>
                <closer><signed><hi rendition="#small-caps">F. Vásquez y
                    Gómez.</hi></signed></closer>



                <xi:include href="d612-a1.xml" xpointer="d612-a1"/>
            </div>
