                <pb facs="0543" n="461" sameAs="frus:frus1911/pg461"/>

                <note rend="inline" type="source">File No. 812.00/1458.</note>
                <head><hi rendition="#italic">The American Ambassador to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1911-04-19"><hi rendition="#italic">April 19,
                        1911</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 479.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith to
                    the Department copy in original and translation of Mr. de la Barra’s note of the
                    17th instant in reply to my note of the 15th which was sent under instructions
                    from the Department.</p>
                <p>I have [etc.],</p>
                <closer><signed><hi rendition="#small-caps">Henry Lane
                    Wilson.</hi></signed></closer>



                <xi:include href="d661-a1.xml" xpointer="d661-a1"/>
