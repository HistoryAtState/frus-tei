    <text>
        <body>
            <div xml:id="d697-a1">

                <pb facs="0562" n="480" sameAs="frus:frus1911/pg480"/>

                <opener><seg rendition="#center">[Inclosure 1.]</seg></opener>
                <head><hi rendition="#italic">The Italian Minister to the
                            American Ambassador.</hi></head>
                <opener><dateline rendition="#float-right"><date calendar="gregorian"
                            when="1911-05-06"><hi rendition="#small-caps">May</hi> 6,
                        1911</date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Ambassador</hi>: May I suggest a friendly
                    gathering of our colleagues in order to exchange views on the situation? I think
                    that the safety of our colonies justifies the step.</p>
                <p>Yours [etc.],</p>
                <closer><signed><hi rendition="#small-caps">Massiglia.</hi></signed></closer>
            </div>
        </body>
