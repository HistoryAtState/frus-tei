            <div xml:id="d864">

                <pb facs="0691" n="609" xml:id="pg609"/>

                <note rend="inline" type="source">File No. 312.112 B61/32.</note>
                <head><hi rendition="#italic">The American Ambassador to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Mexico</hi></placeName>, <date calendar="gregorian" when="1911-04-01"
                                ><hi rendition="#italic">April 1, 1911</hi></date>,</dateline>
                    <seg rendition="#float-left">No. 419.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose to the
                    Department for its information in connection with the case of Converse and
                    Blatt, copy of a note from the Mexican consul at El Paso, Tex., which has been
                    furnished the embassy by the foreign office, reporting upon their condition in
                    the district jail at Ciudad Juárez.</p>
                <p>I have [etc.],</p>
                <closer><signed><hi rendition="#small-caps">Henry Lane
                    Wilson.</hi></signed></closer>


                <xi:include href="d864-a1.xml" xpointer="d864-a1"/>
