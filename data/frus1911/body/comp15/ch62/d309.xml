                <pb facs="0337" n="255" sameAs="frus:frus1911/pg255"/>

                <note rend="inline" type="source">File No. 841.001.G29/66.</note>
                <head><hi rendition="#italic">The British Ambassador to
                        the Secretary of State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >British Embassy</hi>,<lb/><hi rendition="#italic">Seal Harbor,
                                Me.</hi></placeName>, <date calendar="gregorian" when="1911-08-28"
                                ><hi rendition="#italic">August 28, 1911</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 168.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor, under instructions from
                    His Majesty’s principal secretary of state for foreign affairs, to transmit to
                    you herewith a letter addressed by His Majesty the King to the President of the
                    United States of America in answer to letters from the President delivered to
                    His Majesty by the Hon. John Hays Hammond on the occasion of his coronation.</p>
                <p>I venture to request you to be so good as to cause the letter to be delivered, to
                    its high destination.</p>
                <p>A copy of His Majesty’s letter is also inclosed.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">James Bryce.</hi></signed></closer>


                <xi:include href="d309-a1.xml" xpointer="d309-a1"/>
            </div>
