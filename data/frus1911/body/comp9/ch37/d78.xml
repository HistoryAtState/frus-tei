                <pb facs="0174" n="92" sameAs="frus:frus1911/pg92"/>

                <note rend="inline" type="source">File No. 713.001/29.</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the American Chargé d’Affaires.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1911-06-27"><hi rendition="#italic">June 27,
                        1911</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 890.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith a copy of a letter from
                    Mr. Andrew Carnegie, stating that he takes great pleasure in authorizing you to
                    draw on Mr. Franks under the conditions stated.</p>
                <p>You are accordingly instructed to take the action requested in Mr. Carnegie’s
                    letter of May 22.</p>
                <p>I am [etc.],</p>
                <closer><signed><hi rendition="#small-caps">P. C. Knox.</hi></signed></closer>


                <xi:include href="d78-a1.xml" xpointer="d78-a1"/>
