            <div xml:id="d914">

                <pb facs="0720" n="638" sameAs="frus:frus1911/pg638"/>

                <note rend="inline" type="source">File No. 417.00/65.</note>
                <head>[Untitled]</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Managua</hi></placeName>, <date calendar="gregorian" when="1911-08-07"
                                ><hi rendition="#italic">August 7, 1911</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 101.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a
                    confirmation copy of the mixed commission amendatory decree in the form in which
                    President Diaz is willing to approve it.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">F. M. Gunther.</hi></signed></closer>
            </div>
        </body>
