    <text>
        <body>
            <div xml:id="d941">

                <pb facs="0741" n="659" sameAs="frus:frus1911/pg659"/>

                <note rend="inline" type="source">File No. 817.00/1556.</note>
                <head>[Untitled]</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi></placeName>, <date calendar="gregorian"
                            when="1911-04-21"><hi rendition="#italic">April 21,
                        1911</hi>.</date></dateline>
                    <seg rendition="#float-left">No. 16.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: The Department has received and has read
                    with attention your No. 21 of the 27th ultimo in relation to political
                    conditions in Nicaragua. In this connection you are referred to the department’s
                    telegram of April 8 expressive of its views regarding the situation.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Huntington
                    Wilson.</hi></signed></closer>
            </div>
        </body>
