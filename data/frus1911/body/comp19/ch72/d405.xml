    <text>
        <body>
            <div xml:id="d405">

                <pb facs="0392" n="310" sameAs="frus:frus1911/pg310"/>

                <head><hi rendition="#italic">The Secretary of State to the American
                        Ambassador.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1911-02-28"><hi rendition="#italic">February 28,
                        1911</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 167.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose a copy of a letter from the
                    Treasury Department in which a suggestion is made, etc. [repeating the substance
                    of the foregoing letter].</p>
                <p>The Department will be gratified if you will take up the matter with the Italian
                    Government ind report its views regarding it.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">P. C. Knox.</hi></signed></closer>
            </div>
        </body>
