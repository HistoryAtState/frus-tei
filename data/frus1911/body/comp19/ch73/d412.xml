    <text>
        <body>
            <div xml:id="d412">

                <pb facs="0395" n="313" sameAs="frus:frus1911/pg313"/>

                <note rend="inline" type="source">File No. 11675/59a.</note>
                <head><hi rendition="#italic">The Secretary of State to the Italian
                    Ambassador.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1910-01-29"><hi rendition="#italic">January 29,
                        1910</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Ambassador</hi>: I beg to inclose for
                    your information and use three copies of Senate Document No. 321, Sixty-first
                    Congress, second session, containing the request made to Congress for provision
                    that will enable this Government to participate in the two international
                    expositions to be held at Rome and Turin next year.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">P. C. Knox.</hi></signed></closer>
            </div>
        </body>
    </text>
