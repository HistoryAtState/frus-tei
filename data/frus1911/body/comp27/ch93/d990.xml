                <pb facs="0765" n="683" xml:id="pg683"/>

                <note rend="inline" type="source">File No. 761.91/18.</note>
                <head><hi rendition="#italic">The Persian Chargé
                            d’Affaires to the Secretary of
                        State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Imperial Persian Legation</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1911-11-25"><hi rendition="#italic">November 25,
                        1911</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 64.]</seg></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I have the honor to inclose for your
                    excellency’s consideration the translation of a cipher cable received this
                    afternoon from the minister of foreign affairs at Teheran. As the inclosed cable
                    explains, I am advised to communicate with my Government by cable as soon as I
                    may have the pleasure of receiving a reply from your excellency.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Mirza Ali Kuli
                    Khan.</hi></signed></closer>


                <xi:include href="d990-a1.xml" xpointer="d990-a1"/>
