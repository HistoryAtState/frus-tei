            <div xml:id="d982">

                <pb facs="0761" n="679" sameAs="frus:frus1911/pg679"/>

                <note rend="inline" type="source">File No. 891.51/37.</note>
                <head><hi rendition="#italic">The Persian Chargé d’Affaires to the Secretary of
                        State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Imperial Legation of Persia</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1910-12-28"><hi rendition="#italic">December 28,
                        1910</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 21.]</seg></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I have the honor to transmit to your
                    excellency an exact copy of a cablegram which I have received from our minister
                    of foreign affairs, for your kind consideration and attention.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Mirza Ali Kuli
                    Khan.</hi></signed></closer>


                <xi:include href="d982-a1.xml" xpointer="d982-a1"/>
