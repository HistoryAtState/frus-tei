                <pb facs="0183" n="101" sameAs="frus:frus1911/pg101"/>

                <note rend="inline" type="source">File No. 611.3731/9.</note>
                <head><hi rendition="#italic">The American Minister to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Habana</hi></placeName>, <date calendar="gregorian" when="1911-01-06"
                                ><hi rendition="#italic">January 6, 1911</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 550.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith a
                    copy and translation of a note just received froni the Cuban Department of
                    State. * * *</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John B. Jackson.</hi></signed></closer>


                <xi:include href="d93-a1.xml" xpointer="d93-a1"/>
