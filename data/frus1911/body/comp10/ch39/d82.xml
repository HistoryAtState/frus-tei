    <text>
        <body>
            <div xml:id="d82">

                <pb facs="0177" n="95" sameAs="frus:frus1911/pg95"/>

                <note rend="inline" type="source">File No. 611.3731/28.</note>
                <head><hi rendition="#italic">The American Minister to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Habana</hi></placeName>, <date calendar="gregorian" when="1911-04-14"
                                ><hi rendition="#italic">April 14, 1911</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 748.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to report the
                    reintroduction in the Chamber of Representatives of the bill with regard to the
                    “amplification of the <pb facs="0178" n="96" xml:id="pg96"/> reciprocity treaty
                    between Cuba and the United States for the purpose of obtaining greater customs
                    advantages for Cuban manufactured tobacco.”<anchor n="1" xml:id="d82-f1"/></p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John B. Jackson.</hi></signed></closer>



                <xi:include href="d82-a1.xml" xpointer="d82-a1"/>
                <xi:include href="d82-a2.xml" xpointer="d82-a2"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d82-f1" n="1" xml:id="d82-f1-content">
                <p>For the previous history of the bill see Tobacco, preliminary statement, <ref
                        target="#pg108">p. 108</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
