                <pb facs="0179" n="97" sameAs="frus:frus1911/pg97"/>

                <note rend="inline" type="source">File No. 611.3731/40.</note>
                <head><hi rendition="#italic">The American Minister to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Habana</hi></placeName>, <date calendar="gregorian" when="1911-10-25"
                                ><hi rendition="#italic">October 25, 1911</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1150.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my dispatch No. 1134 of the
                    18th instant, I have the honor to transmit a copy and translation of a note
                    received this morning from the Cuban Secretary of State.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John B. Jackson.</hi></signed></closer>


                <xi:include href="d86-a1.xml" xpointer="d86-a1"/>
