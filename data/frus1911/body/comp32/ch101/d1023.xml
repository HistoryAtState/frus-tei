    <text>
        <body>
            <div xml:id="d1023">

                <pb facs="0790" n="708" sameAs="frus:frus1911/pg708"/>

                <head><hi rendition="#italic">The Secretary of State to
                        the American Minister to Siam.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1911-02-28"><hi rendition="#italic">February 28,
                        1911</hi></date>.</dateline></opener>
                <p>You will attend ceremonies connected with the cremation of late Chulalongkorn as
                    the special representative of the President. I have so cabled minister for
                    foreign affairs.</p>
                <closer><signed><hi rendition="#small-caps">Knox.</hi></signed></closer>
            </div>
        </body>
