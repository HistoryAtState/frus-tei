    <text>
        <body>
            <div xml:id="d177">

                <pb facs="0354" n="284" sameAs="frus:frus1867p2/pg284"/>

                <head>Mr. Coggeshall to Mr.
                        Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 27.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">United States Legation,</hi>
                            <hi rendition="#italic">Quito,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1867-03-02"><hi rendition="#italic"
                                >March</hi> 2, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir:</hi> I Lave to acknowledge your despatches Nos.
                    15 and 16, under date of January 2d.</p>
                <p>I have the honor to forward herewith copies of correspondence which declare that
                    Ecuador promptly met at maturity the second dividend of the debt due the United
                    States, and that the amount has been transmitted to the State Department in
                    London exchange.</p>
                <p>Your obedient servant,</p>
                <closer>
                    <signed>W. T. COGGESHALL.</signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>





