    <text>
        <body>
            <div xml:id="d180">

                <pb facs="0356" n="286" sameAs="frus:frus1867p2/pg286"/>

                <opener>
                    <seg rendition="#center">[Extract.]</seg>
                </opener>
                <head>Mr. Coggeshall to Mr.
                        Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 39.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">United States Legation,</hi>
                            <hi rendition="#italic">Quito,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1867-06-18"><hi rendition="#italic"
                                >June</hi> 18, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir:</hi> I herewith enclose a translation of a
                    despatch received yesterday from the government of Ecuador, respecting the
                    mediations of the United States, in the <pb facs="0357" n="287" xml:id="pg287"/>
                    war between the allied republics of South America and Spain. The mediation is
                    rejected in compliance with the dictates of Chili. * * *</p>
                <p>Very respectfully, your obedient servant,</p>
                <closer>
                    <signed>W. T. COGGESHALL.</signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>


                <xi:include href="d180-a1.xml" xpointer="d180-a1"/>
            </div>
