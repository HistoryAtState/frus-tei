    <text>
        <body>
            <div xml:id="d7">

                <pb facs="0079" n="9" sameAs="frus:frus1867p2/pg9"/>

                <head>Mr. F. W. Seward to Mr. Morris</head>
                <opener>
                    <seg rendition="#float-left">No. 144.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1867-06-29"><hi rendition="#italic"
                                >June</hi> 29, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I enclose herewith, for your information
                    and for such action as you may, in your opinion, deem expedient, a transcript of
                    a communication of the 14th instant, from M. S. Isaacs, esq., secretary of the
                    board of delegates of American Israelites, relative to the alleged ill-treatment
                    of the Jewish inhabitants of the Danubian principalities.</p>
                <p>I am, sir, you obedient servant,</p>
                <closer>
                    <signed>F. W. SEWARD, <hi rendition="#italic">Assistant Secretary.</hi></signed>
                </closer>
                <postscript>
                    <p><hi rendition="#small-caps">E. Joy Morris,</hi> Esq., <hi rendition="#italic"
                            >&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d7-a1.xml" xpointer="d7-a1"/>
            </div>
