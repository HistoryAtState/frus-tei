    <text>
        <body>
            <div xml:id="d111">

                <pb facs="0241" n="171" sameAs="frus:frus1867p2/pg171"/>

                <opener>
                    <seg rendition="#center">[Extract.]</seg>
                </opener>
                <head>Mr. Asboth to Mr.
                        Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 23.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">Buenos Ayres,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1867-05-09"><hi rendition="#italic"
                                >May</hi> 9, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir:</hi> * * * * * * * *</p>
                <p>In enclosure D you will moreover be pleased to find, for your information, my
                    daily memoranda of political events from 11th April to 8th May.</p>
                <p>I have the honor to be, sir, very respectfully, your obedient servant,</p>
                <closer>
                    <signed>A. ASBOTH.</signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>


                <xi:include href="d111-a1.xml" xpointer="d111-a1"/>
            </div>
