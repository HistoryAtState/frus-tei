            <div xml:id="d141-a1">

                <pb facs="0325" n="255" sameAs="frus:frus1867p2/pg255"/>

                <head>A RESOLUTION thanking the chambers of senators and deputies of Brazil for
                    their resolutions of sorrow and sympathy on the death of President
                    Lincoln.</head>
                <p><hi rendition="#italic">Resolved by the Senate and House of Representatives of
                        the United States of America in Congress assembled,</hi> That the Congress
                    of the United States has received with respect and gratitude the resolutions of
                    sorrow and sympathy which the chambers of senators and deputies of Brazil have
                    adopted on the death of President Lincoln, and hereby tenders to those chambers
                    the thanks of the people of the United States.</p>
                <p><hi rendition="#small-caps">Sec.</hi> 2. <hi rendition="#italic">And be it
                        further resolved,</hi> That it shall be the duty of the President of the
                    United States to forward a copy of this resolution to the Emperor of Brazil,
                    with a request that it be communicated to the two chambers.</p>
                <closer>
                    <dateline rendition="#float-left">Approved, <date calendar="gregorian"
                            when="1867-03-02">March 2, 1867</date>.</dateline>
                </closer>
            </div>
        </body>
