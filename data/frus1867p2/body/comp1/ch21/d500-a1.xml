                <pb facs="0878" n="808" sameAs="frus:frus1867p2/pg808"/>

                <opener>
                    <seg rendition="#center">[Translation.]</seg>
                </opener>

                <note rend="inline" type="source">[Circular.]</note>
                <head>Mr. Marmol to Mr.
                        Wilson</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Caracas,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1867-03-06"><hi rendition="#italic"
                                >March</hi> 6, 1867,</date>
                    </dateline>
                </opener>
                <p rendition="#right">3<hi rendition="#italic">d of the Law and</hi> 9<hi
                        rendition="#italic">th of the Federation.</hi></p>
                <p><hi rendition="#small-caps">Citizen:</hi> For your information I have the honor
                    to transmit to you in the annexed printed sheet the decree issued on the date of
                    yesterday by the great citizen marshal President organizing his cabinet.</p>
                <p>God and federation.</p>
                <closer>
                    <signed>FRANCISCO J. MARMOL</signed>
                </closer>
                <postscript>
                    <p>Mr. <hi rendition="#small-caps">James Wilson</hi>, <hi rendition="#italic"
                            >Minister Resident of the United States of America.</hi></p>
                </postscript>
            </div>
        </body>
