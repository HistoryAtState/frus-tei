    <text>
        <body>
            <div xml:id="d20-a1">

                <pb facs="0095" n="25" sameAs="frus:frus1867p2/pg25"/>

                <head>[Translation.]</head>
                <p><hi rendition="#small-caps">Ono Tomogoro</hi> and <hi rendition="#small-caps"
                        >Matsmoto Judayu</hi> :</p>
                <p>You are appointed to proceed to the United States, and invested with full powers
                    to negotiate with the same government.</p>
                <closer>
                    <seg rendition="#float-right">[SEAL OF THE TYCOON.]</seg>
                    <lb/>
                    <dateline rendition="#float-left">Dated <date
                            calendar="gregorian japanese-nengō" when="1867-02-16">this 12th day of
                            the 1st month of the 3d year of Kaion, (<hi rendition="#italic"
                                >February</hi> 16, 1867.)</date></dateline>
                </closer>
            </div>
        </body>
    </text>
