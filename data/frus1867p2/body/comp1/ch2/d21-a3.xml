    <text>
        <body>
            <div xml:id="d21-a3">

                <pb facs="0097" n="27" sameAs="frus:frus1867p2/pg27"/>

                <head>[Untitled]</head>
                <p>His Excellency <hi rendition="#small-caps">R. B. Van Valkenburgh,</hi>
                    <hi rendition="#italic">Minister Resident of the United States of America,
                        &amp;c., &amp;c., &amp;c.:</hi></p>
                <p>We regret to have to inform your excellency that our Emperor (the Mikado) died on
                    the 29th day of the 12th month of last year, (the 3d February, 1867.)</p>
                <p>With respect and esteem,</p>
                <closer>
                    <signed>INOMIGE KAWATSI NO KAMI.</signed>
                    <lb/>
                    <signed>INABA MUIO NO KAMI.</signed>
                    <lb/>
                    <signed>MATSDARIA SUWO NO KAMI.</signed>
                    <lb/>
                    <signed>OGASAWARA IKI NO KAMI.</signed>
                    <lb/>
                    <dateline rendition="#float-left">
                        <date calendar="japanese-nengō gregorian" when="1867-02-09">The 5th day of
                            the 1st month of the 3d year of his Majesty, (<hi rendition="#italic"
                                >February</hi> 9, 1867.)</date>
                    </dateline>
                </closer>
            </div>
        </body>
    </text>
