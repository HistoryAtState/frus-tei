    <text>
        <body>
            <div xml:id="d19-a2">

                <pb facs="0094" n="24" xml:id="pg24"/>

                <head> Mr. Von Polsbroeck to Mr. Van Valkenburgh. </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Yedo</hi>,</placeName>
                        <date calendar="gregorian" when="1867-01-01">12<hi rendition="#italic">th
                                January,</hi> 1867,</date>
                    </dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inform you that I
                    succeeded this day to conclude a treaty of friendship, commerce and navigation
                    between his Majesty the King of Denmark and his Majesty the Tycoon of Japan.</p>
                <p>I have the honor to be, sir, your most obedient servant.</p>
                <closer>
                    <signed>D. <hi rendition="#small-caps">De graeff von polsbroeck,</hi>
                        <hi rendition="#italic">His Netherlandish Majesty’s Political Agent and
                            Consul General in Japan.</hi></signed>
                </closer>
                <postscript>
                    <p>His Excellency <hi rendition="#small-caps">R. B. Van Valkenburgh,</hi>
                        <hi rendition="#italic">United States Minister Resident in Japan.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
