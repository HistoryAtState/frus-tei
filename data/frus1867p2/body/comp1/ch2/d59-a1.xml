    <text>
        <body>
            <div xml:id="d59-a1">

                <pb facs="0138" n="68" sameAs="frus:frus1867p2/pg68"/>

                <head>[Untitled]</head>
                <p>His Excellency <hi rendition="#small-caps">R. B. Van Valkenburgh,</hi>
                    <hi rendition="#italic">Minister Resident of the United States :</hi></p>
                <p>I have the honor to transmit herewith for your excellency’s information a copy of
                    a proclamation made known in every part of this empire relative to the title of
                    his Majesty the Tycoon.</p>
                <p>With respect and consideration,</p>
                <closer>
                    <signed>OGASAWARA IKI NO KAMI.</signed>
                    <lb/>
                    <dateline rendition="#float-left">
                        <date calendar="gregorian japanese-nengō" when="1867-10-28">The 2d day of
                            the 10th month of the 3d year of K. U, (<hi rendition="#italic"
                                >October</hi> 28, 1867.)</date>
                    </dateline>
                </closer>
            </div>
        </body>
    </text>
