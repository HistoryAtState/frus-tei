    <text>
        <body>
            <div xml:id="d32-a1">

                <pb facs="0109" n="39" sameAs="frus:frus1867p2/pg39"/>

                <head>[Untitled]</head>
                <p>His Excellency <hi rendition="#small-caps">R. B. Van Valkenburgh,</hi>
                    <hi rendition="#italic">Minister Resident of the United States of America,
                        &amp;c., &amp;c., &amp;c.:</hi></p>
                <p>We have the honor to hand you herewith a letter containing our proposition in
                    relation to the foreign settlements at Hiogo and Osacca.</p>
                <p>Please inform us if they are satisfactory.</p>
                <closer>
                    <dateline rendition="#float-left">With respect and esteem, <date
                            calendar="gregorian japanese-nengō" when="1867-05-16">the 13th day of
                            the 4th month of the 3d year of KeU, (May 16, 1867.)</date></dateline>
                    <lb/>
                    <signed>ITAKURA EGA NO KAMI.</signed>
                    <lb/>
                    <signed>IWABA MINO NO KAMI.</signed>
                    <lb/>
                    <signed>OGASAWARA IKI NO KAMI.</signed>
                </closer>


                <xi:include href="d32-a1-a1.xml" xpointer="d32-a1-a1"/>
            </div>
        </body>
    </text>
