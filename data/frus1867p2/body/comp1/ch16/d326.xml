    <text>
        <body>
            <div xml:id="d326">

                <pb facs="0526" n="456" xml:id="pg456"/>

                <head>Mr. Seward to Mr. Plumb</head>
                <opener>
                    <seg rendition="#float-left">No. 7.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1867-09-19"><hi rendition="#italic"
                                >September</hi> 19, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir:</hi> I transmit a copy of correspondence between
                    this department and Mr. Delfosse, the minister of Belgium, on the subject of
                    Belgians in Mexico. You will exercise your best discretion in extending to them
                    your good offices, so far as they may be necessary for their protection, and in
                    the case of Mr. Eloin, for the purpose of obtaining leave for him to quit that
                    country.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed>
                </closer>
                <postscript>
                    <p><hi rendition="#small-caps">Edward L. Plumb,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>



                <xi:include href="d326-a1.xml" xpointer="d326-a1"/>
