    <text>
        <body>
            <div xml:id="d302-a7">

                <pb facs="0498" n="428" sameAs="frus:frus1867p2/pg428"/>

                <head>Mr. Otterbourg to Señor Dano</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Consulate of the United States,</hi>
                            <hi rendition="#italic">Mexico,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1867-06-03"><hi rendition="#italic"
                                >June</hi> 3, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge the receipt
                    of your note of yesterday, and shall endeavor immediately to communicate with
                    General Porfirio Diaz for the purpose of obtaining the authorization that shall
                    open to your excellency a free passage through the lines of the besieging
                    army.</p>
                <p>I avail myself of this opportunity to express to your excellency the assurance of
                    my most distinguished consideration.</p>
                <closer>
                    <signed>MARCUS OTTERBOURG, <hi rendition="#italic">United States
                        Consul.</hi></signed>
                </closer>
                <postscript>
                    <p>His Excellency <hi rendition="#small-caps">A. Dano,</hi>
                        <hi rendition="#italic">Envoy Extraordinary and Minister Plenipotentiary of
                            his Majesty the Emperor of the French.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
