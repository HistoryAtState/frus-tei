    <text>
        <body>
            <div xml:id="d406-a1-a2-a4">

                <pb facs="0656" n="586" sameAs="frus:frus1867p2/pg586"/>

                <opener>
                    <dateline rendition="#center">[Enclosure No. 6.—No. 4. Sent from <placeName>San
                            Juan del Rio</placeName>, <date calendar="gregorian" when="1867-05-25"
                            >May 25, 1867</date>.—Received at Guadalupe Hidalgo at 4 minutes past 1
                        o’clock, afternoon.]</dateline>
                </opener>
                <p>General Don <hi rendition="#small-caps">Porfirio Diaz</hi> :</p>
                <p>I send you the following message:</p>
                <p><hi rendition="#small-caps">General Diaz</hi>: If there is no obstacle to Marquez
                    receiving the former message communicated from Maximilian, it is hoped you will
                    permit it.</p>
                <closer>
                    <signed>A. ALCERRECA.</signed>
                </closer>
            </div>
        </body>
    </text>
