    <text>
        <body>
            <div xml:id="d426-a1-a1-a11">

                <pb facs="0752" n="682" sameAs="frus:frus1867p2/pg682"/>

                <head>Department of Foreign Relations and Government–Section First.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Mexico,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1867-07-27"><hi rendition="#italic"
                                >July</hi> 27, 1867</date>.</dateline>
                </opener>
                <p>In view of your petition of yesterday for the mortal remains of the Archduke
                    Maximilian, to be carried to Europe, the citizen President of the republic has
                    determined for good and sufficient reasons not to grant the petition.</p>
                <p>Independence and liberty! Mexico, July 29, 1867.</p>
                <closer>
                    <signed>LERDO DE TEJADA.</signed>
                </closer>
                <postscript>
                    <p>Doctor <hi rendition="#small-caps">Samuel Basch.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
