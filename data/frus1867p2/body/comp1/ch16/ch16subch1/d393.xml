    <text>
        <body>
            <div xml:id="d393">

                <pb facs="0631" n="561" sameAs="frus:frus1867p2/pg561"/>

                <head>Mr. Romero to Mr. Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1867-06-19"><hi rendition="#italic"
                                >June</hi> 19, 1867</date>.</dateline>
                </opener>
                <p>M. Romero presents his compliments to Mr. Seward, and has the honor to enclose to
                    him translations of extracts from a letter dated at Casa Mata, on the 7th
                    instant, containing information about the trial of Maximilian.</p>


                <xi:include href="d393-a1.xml" xpointer="d393-a1"/>
