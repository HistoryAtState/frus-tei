    <text>
        <body>
            <div xml:id="d387">

                <pb facs="0625" n="555" sameAs="frus:frus1867p2/pg555"/>

                <opener>
                    <seg rendition="#center">[Unofficial.]</seg>
                </opener>
                <head>Mr. Romero to Mr.
                        Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1867-06-04"><hi rendition="#italic"
                                >June</hi> 4, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">My Dear Mr. Seward</hi>: In accordance with our
                    conversation of this morning, I enclose to you a copy, taken from my private
                    letter-book, of a letter addressed by me to Mr. Hiram Barney, on the 31st
                    ultimo, and which was published in yesterday’s New York Evening Post,</p>
                <p>I am, my dear sir, most truly yours,</p>
                <closer>
                    <signed>M. ROMERO.</signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">F. W. Seward,</hi>
                        <hi rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>

                <postscript>
                    <p>Hon. <hi rendition="#small-caps">Hiram Barney,</hi>
                        <hi rendition="#italic">&amp;c., New York City.</hi></p>
                </postscript>

                <xi:include href="d387-a1.xml" xpointer="d387-a1"/>
            </div>
        </body>
    </text>
