    <text>
        <body>
            <div xml:id="d406-a1-a2-a3">

                <pb facs="0656" n="586" xml:id="pg586"/>

                <opener>
                    <dateline rendition="#center">[Enclosure No. 5.—No. 3. Sent from <placeName>San
                            Juan del Rio</placeName>, <date calendar="gregorian" when="1867-05-25"
                            >May 25, 1867</date>.—Received at Guadalupe Hidalgo at 18 minutes past 9
                        in the morning.]</dateline>
                </opener>
                <p>General of Division Don <hi rendition="#small-caps">PorfirIo Diaz</hi> ;</p>
                <p>The general-in-chief charges me to say to you that you will please to communicate
                    to him seasonably whatever may occur, and principally respecting the message
                    from Maximilian.</p>
                <closer>
                    <signed>A. ALCERRECA.</signed>
                </closer>
            </div>
        </body>
    </text>
