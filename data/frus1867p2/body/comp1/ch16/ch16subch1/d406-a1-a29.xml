        <body>
            <div xml:id="d406-a1-a29">

                <pb facs="0662" n="592" sameAs="frus:frus1867p2/pg592"/>

                <head>[Enclosure No. 33. —Telegram for Queretaro.]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">San LuIs Potosi,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1867-06-19"><hi rendition="#italic"
                                >June</hi> 19, 1867</date>.</dateline>
                </opener>
                <p>General <hi rendition="#small-caps">Mariana Escobedo,</hi>
                    <hi rendition="#italic">Commanding the Army of the North:</hi></p>
                <p>I have received the message from you of this day, in which you tell me that at
                    seven this morning, Maximilian of Hapsburg, Miramon, and Mejia were put to
                    death.</p>
                <closer>
                    <signed>MEJIA.</signed>
                </closer>
            </div>
        </body>
    </text>
