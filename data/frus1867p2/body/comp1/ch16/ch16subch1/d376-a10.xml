                <pb facs="0605" n="535" sameAs="frus:frus1867p2/pg535"/>

                <opener>
                    <seg rendition="#center">No. 10.</seg>
                </opener>
                <head><hi rendition="#italic">Telegram communicated by Mr. Bigelow, minister of the
                        United States, December</hi> 3, 1866.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1866-12-01"><hi rendition="#italic"
                                >December</hi> 1, 1866</date>.</dateline>
                </opener>
                <p>The despatch of M. Moustier to M. de Montholon, of October 16th, will be used
                    properly and in a friendly manner.</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed>
                </closer>
                <postscript>
                    <p><hi rendition="#small-caps">John Bigelow,</hi> Esq., <hi rendition="#italic"
                            >&amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
