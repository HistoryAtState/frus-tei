    <text>
        <body>
            <div xml:id="d398">

                <pb facs="0633" n="563" xml:id="pg563"/>

                <head>Mr. F. W. Seward to Mr. Romero</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1867-06-24"><hi rendition="#italic"
                                >June</hi> 24, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to enclose, for your
                    information, copy of a communication received at this department from the Hon.
                    Hugh McCulloch, Secretary of the Treasury, in relation to furnishing passage on
                    board the revenue cutter Wilderness to the wife of President Juarez, of Mexico,
                    from New Orleans to Vera Cruz</p>
                <p>I avail myself of this opportunity to renew the assurances of my very
                    distinguished consideration.</p>
                <closer>
                    <signed>F. W. SEWARD, <hi rendition="#italic">Assistant Secretary.</hi></signed>
                </closer>
                <postscript>
                    <p>Señor Don <hi rendition="#small-caps">Matias Romero,</hi>
                        <hi rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d398-a1.xml" xpointer="d398-a1"/>
            </div>
