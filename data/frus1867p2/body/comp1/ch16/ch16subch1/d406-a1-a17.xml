    <text>
        <body>
            <div xml:id="d406-a1-a17">

                <pb facs="0659" n="589" sameAs="frus:frus1867p2/pg589"/>

                <opener>
                    <dateline rendition="#center">[Enclosure No. 21.—Telegram from
                            <placeName>Queretaro</placeName> to San Luis Potosi, <date
                            calendar="gregorian" when="1867-06-14">June 14, 1867</date>, at 10
                        minutes past 12 at night.]</dateline>
                </opener>
                <p>The <hi rendition="#small-caps">Minister of Relations:</hi></p>
                <p>The council has condemned to death, unanimously, the three persons under trial.
                    The cause is passed over to the assessor.</p>
                <closer>
                    <signed>ESCOBEDO.</signed>
                </closer>
            </div>
        </body>
    </text>
