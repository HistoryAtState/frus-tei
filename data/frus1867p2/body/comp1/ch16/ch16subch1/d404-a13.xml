    <text>
        <body>
            <div xml:id="d404-a13">

                <pb facs="0643" n="573" xml:id="pg573"/>

                <head>No. 13.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Queretaro,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1867-05-25"><hi rendition="#italic"
                                >May</hi> 25, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: Not knowing the Spani<hi
                        rendition="#superscript">s</hi>h language sufficiently in its legal sense, I
                    desire that in case my defenders should arrive a little too late, the time
                    necessary be conceded to me for my defence and the settlement of my private
                    affairs.</p>
                <closer>
                    <signed>MAXIMILIAN.</signed>
                </closer>
            </div>
        </body>
    </text>
