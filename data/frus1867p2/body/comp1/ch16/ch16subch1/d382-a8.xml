    <text>
        <body>
            <div xml:id="d382-a8">

                <pb facs="0620" n="550" sameAs="frus:frus1867p2/pg550"/>

                <head>Mr. Diaz to Mr.
                        Romero</head>

                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">New Orleans,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1867-04-30"><hi rendition="#italic"
                                >April</hi> 30, 1867</date>.</dateline>
                </opener>
                <p>Mr. <hi rendition="#small-caps">M. Romero,</hi>
                    <hi rendition="#italic">Mexican Minister, Washington, D. C.</hi></p>
                <p>Miramon dead; imperial forces disbanded; Marquez defeated; Queretaro taken;
                    Maximilian hidden.</p>
                <closer>
                    <signed>RAMON S.DIAZ, <hi rendition="#italic">Mexican Consul.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
