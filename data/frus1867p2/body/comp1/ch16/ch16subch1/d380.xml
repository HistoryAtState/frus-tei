    <text>
        <body>
            <div xml:id="d380">

                <pb facs="0615" n="545" sameAs="frus:frus1867p2/pg545"/>

                <head>Mr. Seward to Mr.
                        Romero</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1867-04-04"><hi rendition="#italic"
                                >April</hi> 4, 1867</date>.</dateline>
                </opener>
                <p>The Secretary of State has the honor to transmit for the information of Señor
                    Romero a copy of a despatch which has been received from the consul general of
                    the United States at Tampico, containing a letter addressed to him by General
                    Mannel M. Cuesta, of the liberal army of Mexico.</p>
                <postscript>
                    <p>Señor Don <hi rendition="#small-caps">Matias Romero,</hi>
                        <hi rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d380-a1.xml" xpointer="d380-a1"/>
