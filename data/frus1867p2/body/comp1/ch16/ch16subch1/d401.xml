    <text>
        <body>
            <div xml:id="d401">

                <pb facs="0636" n="566" sameAs="frus:frus1867p2/pg566"/>

                <opener>
                    <seg rendition="#center">[Translation.]</seg>
                </opener>
                <head>Mr. Romero to Mr. F. W. Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1867-06-26"><hi rendition="#italic"
                                >June</hi> 26, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">My Dear Mr. Seward</hi>: I have the honor to inform
                    you that Mrs. Juarez came back last night to this city with the rest of her
                    family, and wishes to leave for New Orleans to-morrow, going by way of the
                    Mississippi.</p>
                <p>I enclose to you a list of the persons who form the family and suite of Mrs.
                    Juarez.</p>
                <p>I am, very sincerely, your obedient servant,</p>
                <closer>
                    <signed>M. ROMERO.</signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">F. W. Seward,</hi>
                        <hi rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d401-a1.xml" xpointer="d401-a1"/>
