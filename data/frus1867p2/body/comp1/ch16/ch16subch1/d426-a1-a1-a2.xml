    <text>
        <body>
            <div xml:id="d426-a1-a1-a2">

                <pb facs="0750" n="680" sameAs="frus:frus1867p2/pg680"/>

                <head>[Telegram.]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Minister of War and Marine</hi>, <hi
                                rendition="#italic">Mexico</hi>,</placeName>
                        <date calendar="gregorian" when="1867-08-26"><hi rendition="#italic"
                                >August</hi> 26, 1867</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#italic">To the Military Commander in Vera Cruz:</hi>
                </p>
                <p>The citizen president of the republic learns that Admiral Tegethoff has arrrived
                    at your port, and that he wishes to come to this capital. You may let him pass
                    without hindrance.</p>
                <closer>
                    <signed>MEJIA.</signed>
                </closer>
            </div>
        </body>
    </text>
