    <text>
        <body>
            <div xml:id="d406-a1-a2-a2">

                <pb facs="0655" n="585" sameAs="frus:frus1867p2/pg585"/>

                <dateline rendition="#center">[Enclosure No. 4.—No. 2. Remitted from <placeName>San
                        Juan del Rio</placeName>, <date calendar="gregorian" when="1867-05-25">May
                        25, 1867</date>.—Received at Guadalupe Hidalgo at 12 minutes after 9 in the
                    morning. ]</dateline>
                <p>
                    <hi rendition="#italic">The Emperor Maximilian to Baron de Magnus, Minister of
                        Prussia in Mexico:</hi>
                </p>
                <p>Have the kindness to come and see me as soon as possible, with the advocates Don
                    Mariano Riva Palacio and Rafael Martinez de la Torre, or other you may think
                    well of, to defend my cause; but I desire that it be done immediately, for I
                    have no time to lose. Don’t forget,the necessary documents.</p>
                <closer>
                    <signed>MAXIMILIAN.</signed>
                </closer>
            </div>
        </body>
    </text>
