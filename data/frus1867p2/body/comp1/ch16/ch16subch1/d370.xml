    <text>
        <body>
            <div xml:id="d370">

                <pb facs="0593" n="523" sameAs="frus:frus1867p2/pg523"/>

                <opener>
                    <seg rendition="#center">[Unofficial.]</seg>
                </opener>
                <head>Mr. Romero to Mr. Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1867-02-01"><hi rendition="#italic"
                                >February</hi> 1, 1867</date>.</dateline>
                </opener>
                <p>MY <hi rendition="#small-caps">Dear Sir:</hi> Having sent yesterday a telegraphic
                    despatch to the Mexican consul at San Francisco, California, asking for reliable
                    information on the reported execution of Mr. Carman and bombardment of Mazatlan,
                    I have just received an answer denying those rumors. I enclose to you for your
                    information a copy of that answer.</p>
                <p>I am, sir, very truly, your obedient servant,</p>
                <closer>
                    <signed>M. ROMERO.</signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>



                <xi:include href="d370-a1.xml" xpointer="d370-a1"/>
