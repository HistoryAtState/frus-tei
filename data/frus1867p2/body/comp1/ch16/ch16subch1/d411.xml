    <text>
        <body>
            <div xml:id="d411">

                <pb facs="0691" n="621" sameAs="frus:frus1867p2/pg621"/>

                <opener>
                    <seg rendition="#center">[Translation.]</seg>
                </opener>
                <head>Mr. Romero to Mr. Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Mexican Legation in the United States of
                                America, Washington,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1867-07-15"><hi rendition="#italic"
                                >July</hi> 15, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">My Dear Sir</hi>: Referring to the conversation which
                    I had with you this morning at the Department of State, I enclose you a copy of
                    a letter which I have received from a friend of mine, dated the day before
                    yesterday, dated at New York, in which some details are given touching the
                    fillibuster movements which are being prepared with the view of invading
                    Mexico.</p>
                <p>I am, sir, your very obedient servant,</p>
                <closer>
                    <signed>M. ROMERO.</signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d411-a1.xml" xpointer="d411-a1"/>
            </div>
