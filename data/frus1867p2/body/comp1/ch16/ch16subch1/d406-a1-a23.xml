    <text>
        <body>
            <div xml:id="d406-a1-a23">

                <pb facs="0660" n="590" sameAs="frus:frus1867p2/pg590"/>

                <opener>
                    <dateline rendition="#center">[Enclosure No 27.—Telegram from
                            <placeName>Queretaro</placeName> to San Luis Potosi.—Received <date
                            calendar="gregorian" when="1867-06-16">June 16, 1867</date>, at 1 minute
                        past 4, afternoon.]</dateline>
                </opener>
                <p>To the <hi rendition="#small-caps">Minister of War:</hi></p>
                <p>I am informed that the President has directed that the execution of the guilty be
                    suspended until the morning of Wednesday, the 19th. I shall carry out this final
                    disposition.</p>
                <closer>
                    <signed>ESCOBEDO</signed>
                </closer>
            </div>
        </body>
    </text>
