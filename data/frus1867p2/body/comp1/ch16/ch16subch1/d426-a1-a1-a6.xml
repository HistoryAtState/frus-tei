    <text>
        <body>
            <div xml:id="d426-a1-a1-a6">

                <pb facs="0751" n="681" sameAs="frus:frus1867p2/pg681"/>

                <opener>
                    <dateline rendition="#center">[Telegram from Tacubaya to San Luis Potosi.
                        Deposited at <placeName>Tacubaya</placeName> on <date calendar="gregorian"
                            when="1867-06-19">the 19th of June, 1867</date>; received in Potosi at
                        25 minutes after 9 on the 20th of June.]</dateline>
                </opener>
                <head>[Untitled]</head>
                <p><hi rendition="#small-caps">Citizen President:</hi> I beg you to give me the body
                    of Maximilian, to be carried to Europe.</p>
                <closer>
                    <signed>BARON DE LAGO,</signed>
                </closer>
            </div>
        </body>
    </text>
