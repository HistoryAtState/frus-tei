    <text>
        <body>
            <div xml:id="d412">

                <pb facs="0692" n="622" sameAs="frus:frus1867p2/pg622"/>

                <opener>
                    <seg rendition="#center">[Translation.]</seg>
                </opener>
                <head>Mr. Romero to Mr. Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1867-07-24"><hi rendition="#italic"
                                >July</hi> 24, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Dear Sir</hi>: I have the honor to remit to you copy
                    of a letter from New York, dated the day before yesterday, in which various
                    details are given of filibustering movements which are in preparation in that
                    city for invading Mexico.</p>
                <p>I am, sir, very respectfully, your obedient servant,</p>
                <closer>
                    <signed>M. ROMERO.</signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d412-a1.xml" xpointer="d412-a1"/>
            </div>
