    <text>
        <body>
            <div xml:id="d302-a8">

                <pb facs="0498" n="428" sameAs="frus:frus1867p2/pg428"/>

                <head>Mr. Otterbourg to General Tabera</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Consulate of the United States,</hi>
                            <hi rendition="#italic">Mexico,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1867-06-05"><hi rendition="#italic"
                                >June</hi> 5, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Excellent Sir:</hi> I beg that you have the kindness
                    to remit me a safe conduct for Mr. Robert Beckman, whom I think of sending to
                    Tacubaya on a matter which has no connection with the political situation of
                    this capital—a favor for which I shall be obliged to your excellency.</p>
                <p>Your most attentive servant,</p>
                <closer>
                    <signed>MARCUS OTTERBOURG, <hi rendition="#italic">United States
                        Consul.</hi></signed>
                </closer>
                <postscript>
                    <p>His Excellency General <hi rendition="#small-caps">D. Ramon Tabera,</hi>
                        <hi rendition="#italic">Present.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
