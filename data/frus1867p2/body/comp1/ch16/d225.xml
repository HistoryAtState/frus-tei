    <text>
        <body>
            <div xml:id="d225">

                <pb facs="0410" n="340" xml:id="pg340"/>

                <head>Mr. Seward to Mr.
                        Campbell</head>
                <opener>
                    <seg rendition="#float-left">No. 12.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1866-12-29"><hi rendition="#italic"
                                >December</hi> 29, 1866</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your despatch No, 7, of the 24th instant,
                    has been received. The proceedings to which it refers are approved. We adhere to
                    the directions given you in the telegram of the 25th instant.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILIAM H. SEWARD.</signed>
                </closer>
                <postscript>
                    <p><hi rendition="#small-caps">Lewis D. Campbell</hi>, Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
