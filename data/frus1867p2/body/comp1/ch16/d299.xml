    <text>
        <body>
            <div xml:id="d299">

                <pb facs="0489" n="419" sameAs="frus:frus1867p2/pg419"/>

                <note rend="inline" type="source">[Telegram.—Extract. ]</note>
                <head>Mr. Campbell to Mr.
                        Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">New Orleans,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1867-06-15"><hi rendition="#italic"
                                >June</hi> 15, 1867</date>.</dateline>
                </opener>
                <p>Your telegram of this day received. I send formal resignation by mail and start
                    for Ohio Tuesday. * * *</p>
                <closer>
                    <signed>LEWIS D. CAMPBELL.</signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>
            </div>
        </body>
