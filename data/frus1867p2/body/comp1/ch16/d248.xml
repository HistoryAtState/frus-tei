    <text>
        <body>
            <div xml:id="d248">

                <pb facs="0433" n="363" sameAs="frus:frus1867p2/pg363"/>

                <head>Mr. Seward to Mr. Campbell</head>
                <opener>
                    <seg rendition="#float-left">No. 20.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1867-03-02"><hi rendition="#italic"
                                >March</hi> 2, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir:</hi> I transmit to you, for your information, a
                    copy of a letter which has been received from a Mr. J. A. Bennet, of New York,
                    dated the 21st ultimo, containing an article clipped from the New York Herald,
                    which purports to be a decree issued by the President of Mexico.</p>
                <p>I also send you a copy of a letter signed by a Mr. Thomas A. Dwyer, of San
                    Antonio, Texas, and dated the 12th ultimo.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed>
                </closer>
                <postscript>
                    <p><hi rendition="#small-caps">Lewis D. Campbell,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>





                <xi:include href="d248-a1.xml" xpointer="d248-a1"/>
