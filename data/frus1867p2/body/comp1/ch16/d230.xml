    <text>
        <body>
            <div xml:id="d230">

                <pb facs="0414" n="344" sameAs="frus:frus1867p2/pg344"/>

                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <head>Mr. Campbell to Mr. Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">New Orleans</hi>,</placeName>
                        <date calendar="gregorian" when="1867-01-07"><hi rendition="#italic"
                                >January</hi> 7, 1867</date>.</dateline>
                </opener>
                <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi rendition="#italic"
                        >Secretary of State, Washington, D. C.</hi></p>
                <p>If proper, please inform me about how long you will require me to remain
                    here.</p>
                <closer>
                    <signed>LEWIS D. CAMPBELL.</signed>
                </closer>
            </div>
        </body>
    </text>
