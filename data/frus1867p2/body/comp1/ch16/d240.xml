    <text>
        <body>
            <div xml:id="d240">

                <pb facs="0420" n="350" sameAs="frus:frus1867p2/pg350"/>

                <head>Mr. Seward to Mr. Campbell</head>
                <opener>
                    <seg rendition="#float-left">No. 16.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1867-01-28"><hi rendition="#italic"
                                >January</hi> 28, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir:</hi> I send you, for your information, a copy of
                    a despatch which has been received from Mr. Saulnier, our present consul at Vera
                    Cruz.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed>
                </closer>
                <postscript>
                    <p><hi rendition="#small-caps">Lewis D. Campbell</hi>, Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d240-a1.xml" xpointer="d240-a1"/>
