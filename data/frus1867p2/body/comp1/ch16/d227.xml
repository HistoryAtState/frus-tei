    <text>
        <body>
            <div xml:id="d227">

                <pb facs="0413" n="343" sameAs="frus:frus1867p2/pg343"/>

                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <head>Mr. Campbell to Mr. Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">New Orleans</hi>,</placeName>
                        <date calendar="gregorian" when="1867-01-02"><hi rendition="#italic"
                                >January</hi> 2, 1867</date>.</dateline>
                </opener>
                <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi rendition="#italic"
                        >Secretary of State, Washington, D. C.</hi></p>
                <p>Your communication of December 27th received. I now propose to visit my sick
                    family and there await further orders. Is this satisfactory? Please answer
                    immediately.</p>
                <closer>
                    <signed>LEWIS D. CAMPBELL.</signed>
                </closer>
            </div>
        </body>
    </text>
