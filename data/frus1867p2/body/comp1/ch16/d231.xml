    <text>
        <body>
            <div xml:id="d231">

                <pb facs="0414" n="344" sameAs="frus:frus1867p2/pg344"/>

                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <head>Mr. Seward to Mr.
                        Campbell</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1867-01-08"><hi rendition="#italic"
                                >January</hi> 8, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Lewis D. Campbell</hi>, Esq., <hi rendition="#italic"
                        >&amp;c., &amp;c., &amp;c., New Orleans:</hi></p>
                <p>We wish you to remain at New Orleans while events ripen in Mexico. It now seems
                    that it may be so long as March. But we cannot anticipate events. It may be much
                    shorter.</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed>
                </closer>
            </div>
        </body>
    </text>
