    <text>
        <body>
            <div xml:id="d295">

                <pb facs="0487" n="417" sameAs="frus:frus1867p2/pg417"/>

                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <head>Mr. Seward to Mr.
                        Campbell</head>
                <opener>
                    <seg rendition="#float-left">No. 36.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1867-06-11"><hi rendition="#italic"
                                >June</hi> 11, 1867</date>.</dateline>
                </opener>
                <p>Your despatch received. The President desires you to proceed to Mexico without
                    delay according to previous instructions.</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed>
                </closer>
                <postscript>
                    <p><hi rendition="#small-caps">Lewis D. Campbell,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c., New Orleans.</hi></p>
                </postscript>
            </div>
