    <text>
        <body>
            <div xml:id="d331-a1">

                <pb facs="0531" n="461" sameAs="frus:frus1867p2/pg461"/>

                <head>Mr. Plumb to Señor Lerdo
                        de Tejada</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">City of Mexico,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1867-10-07"><hi rendition="#italic"
                                >October</hi> 7, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to advise you of my
                    arrival at this capital, and to enclose to you herewith a copy of my letter of
                    credence as charge d’affaires <hi rendition="#italic">ad interim</hi> of the
                    United States near the government of the republic of Mexico; at the same time
                    requesting the honor of an interview, for the purpose of delivering the original
                    in person, at such time as you may be pleased to indicate.</p>
                <p>Very respectfully, your obedient servant,</p>
                <closer>
                    <signed>E. L. PLUMB,</signed>
                </closer>
                <postscript>
                    <p>His Excellency Señor Don <hi rendition="#small-caps">Sebastian Lerdo de
                            Tejada,</hi>
                        <hi rendition="#italic">Minister for Foreign Affairs of the United Mexican
                            States.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
