    <text>
        <body>
            <div xml:id="d469">

                <pb facs="0837" n="767" xml:id="pg767"/>

                <head>Mr. Hovey to Mr.
                        Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 67.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">Lima, Peru</hi>,</placeName>
                        <date calendar="gregorian" when="1867-05-21"><hi rendition="#italic"
                                >May</hi> 21, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir :</hi> I have the honor to transmit herewith a
                    translation of the latest intelligence received in Lima, in reference to the
                    revolutionary movements in the south.</p>
                <p>In my opinion, the particular outbreak to which the enclosed relates will not
                    meet with any degree of success.</p>
                <p>I have the honor to be, with great respect, your obedient servant,</p>
                <closer>
                    <signed>ALVIN P. HOVEY.</signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>


                <xi:include href="d469-a1.xml" xpointer="d469-a1"/>
            </div>
