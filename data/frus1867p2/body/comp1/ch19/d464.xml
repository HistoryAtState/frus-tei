    <text>
        <body>
            <div xml:id="d464">

                <pb facs="0834" n="764" sameAs="frus:frus1867p2/pg764"/>

                <opener>
                    <seg rendition="#center">[Extract.]</seg>
                </opener>
                <head>Mr. Seward to Mr. Hovey</head>
                <opener>
                    <seg rendition="#float-left">No. 43.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1867-02-28"><hi rendition="#italic"
                                >February</hi> 28, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir :</hi> Referring to your despatch No. 41, and the
                    reply of this department of the 26th of last December, I enclose for your
                    information a copy of a circular<anchor n="*" xml:id="d464-f1"/> letter which
                    has been addressed to some of the ministers and consuls of the United
                    States.</p>
                <p rendition="#center">* * * * * * * *</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed>
                </closer>
                <postscript>
                    <p><hi rendition="#small-caps">Alvin P. Hovey</hi>, Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d464-f1" n="*" xml:id="d464-f1-content">
                <p>For enclosure see circular from the department of January 17, 1867, page 451,
                    vol. I.</p>
            </note>
        </listAnnotation>
    </standOff>
