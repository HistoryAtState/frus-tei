    <text>
        <body>
            <div xml:id="d432">

                <pb facs="0756" n="[686]" sameAs="frus:frus1867p2/pg686"/>

                <head> Mr. Dickinson to Mr. Seward, </head>
                <opener>
                    <seg rendition="#float-left">No. 124.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">Leon, Nicaragua</hi>,</placeName>
                        <date calendar="gregorian" when="1867-01-08"><hi rendition="#italic"
                                >January</hi> 8, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit herewith a copy and translation
                    of a note which I have received from the Nicaraguan government, narrating a late
                    unsuccessful attempt to subvert this government, and a copy of my answer
                    thereto.</p>
                <p>I am, sir, very respectfully, your obedient servant,</p>
                <closer>
                    <signed>A. B. DICKINSON.</signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>




                <xi:include href="d432-a1.xml" xpointer="d432-a1"/>
