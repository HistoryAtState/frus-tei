    <text>
        <body>
            <div xml:id="d431">

                <pb facs="0756" n="[686]" sameAs="frus:frus1867p2/pg686"/>

                <head>Mr. Dickinson to Mr. Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 123.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">Leon, Nicaragua</hi>,</placeName>
                        <date calendar="gregorian" when="1866-12-20"><hi rendition="#italic"
                                >December</hi> 20, 1866</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit herewith a copy and translation
                    of a note received from the minister of foreign affairs of this government, in
                    answer to your despatch relative to filibustering expeditions against this
                    country.</p>
                <p>I am, sir, respectfully, your obedient servant,</p>
                <closer>
                    <signed>A. B. DICKINSON.</signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D, C.</hi></p>
                </postscript>


                <xi:include href="d431-a1.xml" xpointer="d431-a1"/>
            </div>
