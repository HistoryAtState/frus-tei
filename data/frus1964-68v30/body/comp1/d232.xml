    <text>
        <body>
            <div xml:id="d232">

                <pb facs="0537" n="503" xml:id="pg503"/>

                <head>232. Memorandum From the President’s Special Assistant (Rostow) to President
                        Johnson<anchor n="1" xml:id="d232-f1"/>
                </head>
                <opener><dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            when="1967-01-25">January 25, 1967</date>.</dateline></opener>
                <p rendition="#flush">Mr. President:</p>
                <p>This is the best single reconstruction I have read of the inner politics of
                    mainland China in this crisis.</p>
                <p>It is written by Bill Wells, an imaginative, scholarly, bold CIA man in Hong
                    Kong.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Walt</hi>
                    </signed>
                </closer>


                <xi:include href="d232-a1.xml" xpointer="d232-a1"/>
            </div>
        </body>
    </text>
    <standOff>
