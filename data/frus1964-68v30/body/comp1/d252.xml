    <text>
        <body>
            <div xml:id="d252">

                <pb facs="0579" n="545" sameAs="frus:frus1964-68v30/pg545"/>

                <head>252. Memorandum From the President’s Special Assistant (Rostow) to President
                        Johnson<anchor n="1" xml:id="d252-f1"/>
                </head>
                <opener><dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            when="1967-04-20T20:10:00-05:00">April 20, 1967, 8:10 p.m.</date>
                    </dateline></opener>
                <p rendition="#flush">Mr. President:</p>
                <p>A North African herewith reports, in a quite credible way, on a visit to
                    Communist China. We know so little about how they think that I thought you might
                    like to read it.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Walt</hi>
                    </signed>
                </closer>



                <xi:include href="d252-a1.xml" xpointer="d252-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d252-f1" n="1" type="source" xml:id="d252-f1-content">
                <p>Source: Johnson Library, National Security File, Agency File, United Nations,
                    Vol. 7. Secret; Exdis. A handwritten “L” on the source text indicates that it
                    was seen by the President.</p>
            </note>
        </listAnnotation>
    </standOff>
