            <div xml:id="errata">

                <pb facs="0808" n="774" xml:id="pg774"/>

                <head>Errata</head>
                <p>The following error has been identified in <hi rendition="#italic">Foreign
                        Relations</hi>, 1964–1968, Volume XXX, China. Please be aware that printed
                    volumes have not been revised.</p>
                <list type="simple">
                    <item>
                        <hi rendition="#bold">1. Document 135 (date of errata entry: January 3,
                            2013)</hi>
                    </item>
                    <item>The volume skips from Document 134 to 136.</item>
                </list>
            </div>
        </body>
    </text>
