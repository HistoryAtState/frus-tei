    <text>
        <body>
            <div xml:id="d303">

                <pb facs="0261" n="189" sameAs="frus:frus1865p4/pg189"/>

                <head>Municipal Council of Carnarvon</head>
                <dateline>
                    <date ana="#date_undated-inferred-from-volume-rules" calendar="gregorian"
                        notAfter="1865-07-31T23:59:59+00:00" notBefore="1865-04-15T00:00:00+00:00"
                        >undated</date>
                </dateline>
                <p>That the corporation of Carnarvon desires to record its detestation of the
                    atrocious crime perpetrated by the cruel murder of the President of America, and
                    to express its deep sympathy with the people who have been suddenly deprived of
                    their Chief Magistrate by the hand of a cowardly assassin.</p>
                <p>That copies of this resolution, signed by the mayor, be forwarded to his
                    excellency the American minister.</p>
                <closer>[<hi rendition="#small-caps">seal</hi>.] <signed>LLEWELYN TURNER, </signed>
                    <hi rendition="#italic">Mayor</hi>.</closer>
            </div>
        </body>
    </text>
