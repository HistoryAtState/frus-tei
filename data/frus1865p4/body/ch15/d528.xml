    <text>
        <body>
            <div xml:id="d528">

                <pb facs="0375" n="303" sameAs="frus:frus1865p4/pg303"/>

                <head>Municipal Council of Newport</head>
                <dateline>
                    <placeName>Newport</placeName>, <date
                        ana="#date_undated-inferred-from-document-content" calendar="gregorian"
                        when="1865-05-02">May 2, 1865</date>
                </dateline>
                <p rendition="#center">
                    <hi rendition="#small-caps">borough of newport, isle of wight</hi>.</p>
                <p>The following is a copy of a resolution passed at the quarterly meeting of the
                    council of this borough, held on 2d day of May, 1865, at the Guildhall.</p>
                <p>Proposed by Mr. Councillor Pinnock, seconded by Mr. Alderman Way, and carried
                    unanimously—</p>
                <p>That this council desire to record their abhorrence and detestation of the crime
                    which has deprived the American nation of the services of their President, and
                    respectfully offer to the government and to the people of the United States
                    their heartfelt sympathy.</p>
                <closer> [<hi rendition="#small-caps">seal</hi>.] <signed>HY. MEW, </signed>
                    <hi rendition="#italic">Mayor</hi>.</closer>
            </div>
        </body>
