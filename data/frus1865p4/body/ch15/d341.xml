    <text>
        <body>
            <div xml:id="d341">

                <pb facs="0277" n="205" xml:id="pg205"/>

                <head>Municipal Council of Dublin</head>
                <dateline>
                    <hi rendition="#small-caps">City Hall, Town Clerk’s Office</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Dublin</hi></placeName>, <date calendar="gregorian"
                        when="1865-05-13">
                        <hi rendition="#italic">May</hi> 13, 1865</date>.</dateline>
                <p>
                    <hi rendition="#small-caps">Madam</hi>: I have the honor to transmit to you
                    herewith a resolution unanimously adopted by the municipal council of the city
                    of Dublin, expressive of their condolence and sympathy in the sad bereavement
                    you have sustained in the loss of your lamented and esteemed husband, the late
                    President Lincoln. I have the honor to remain, madam, your obedient servant,</p>
                <closer>
                    <signed>W. J. HENRY, </signed>
                    <hi rendition="#italic">Town Clerk</hi>. </closer>
                <postscript>
                    <p>Mrs. <hi rendition="#small-caps">Lincoln</hi>, <hi rendition="#italic"
                            >Washington</hi>.</p>
                </postscript>


                <xi:include href="d341-a1.xml" xpointer="d341-a1"/>
