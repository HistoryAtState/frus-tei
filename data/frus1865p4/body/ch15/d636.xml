    <text>
        <body>
            <div xml:id="d636">

                <pb facs="0423" n="351" sameAs="frus:frus1865p4/pg351"/>

                <head>Legislative Assembly of Vancouver’s Island, Victoria</head>
                <dateline>
                    <placeName>
                        <hi rendition="#small-caps">Vancouver’s Island, Victoria</hi></placeName>,
                        <date calendar="gregorian" when="1865-04-22">
                        <hi rendition="#italic">April</hi> 22, 1865</date>.</dateline>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit the copy of a
                    resolution adopted by the legislative assembly of Vancouver’s Island, on the
                    28th instant, expressing their sympathy in the calamity which has befallen the
                    United States of America, in the death of their President, Abraham Lincoln, in
                    which expression of sympathy I fully join.</p>
                <p>I have the honor to be, sir, your most obedient servant,</p>
                <closer>
                    <signed>A. E. KENNEDY, </signed>
                    <hi rendition="#italic">Governor</hi> .</closer>
                <postscript>
                    <p>
                        <hi rendition="#small-caps">Allen Francis</hi>, Esq., <lb/>
                        <hi rendition="#italic">United States Consul, &amp;c.,&amp;c., &amp;c,
                            Victoria</hi>.</p>
                </postscript>


                <xi:include href="d636-a1.xml" xpointer="d636-a1"/>
            </div>
