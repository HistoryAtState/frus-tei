    <text>
        <body>
            <div xml:id="d325">

                <pb facs="0269" n="197" sameAs="frus:frus1865p4/pg197"/>

                <head>Inhabitantas of Cape Coast, Africa</head>
                <dateline>
                    <hi rendition="#small-caps">Cape Coast Castle</hi>
                    <lb/>
                    <placeName>
                        <hi rendition="#italic">Salt Pond Road No</hi>. 3</placeName>, <date
                        calendar="gregorian" when="1865-07-12">
                        <hi rendition="#italic">July</hi> 12, 1865</date>.</dateline>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I am convinced that you will not refuse to
                    accept the expression of African feeling to which the enclosed letter bears
                    witness, and which I am charged to convey to you in behalf of my countrymen.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>S. M. GOOD.</signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <lb/>
                        <hi rendition="#italic">Secretary of State</hi>.</p>
                </postscript>


                <xi:include href="d325-a1.xml" xpointer="d325-a1"/>
