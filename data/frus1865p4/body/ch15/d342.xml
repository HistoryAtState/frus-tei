    <text>
        <body>
            <div xml:id="d342">

                <pb facs="0277" n="205" sameAs="frus:frus1865p4/pg205"/>

                <head>Inhabitants of Dublin</head>
                <dateline>35 <hi rendition="#small-caps">Molesworth Street</hi>, <date
                        calendar="gregorian" when="1865-04-28">
                        <hi rendition="#italic">April</hi> 28, 1865</date>.</dateline>
                <p rendition="#flush">
                    <hi rendition="#italic">To the right honorable the Lord Mayor:</hi>
                </p>
                <p>We, the undersigned, citizens of Dublin, request your lordship to convene a
                    public meeting, at your very earliest convenience, to express our indignation
                    and sorrow at the assassination of President Lincoln, and our sympathy with the
                    people of the United States.</p>
                <p>The above was signed by Joseph Wilson, D. L., and 426 other names and firms.</p>
                <postscript>
                    <opener>
                        <dateline rendition="#float-right">
                            <hi rendition="#small-caps">Mansion House</hi>, <date
                                calendar="gregorian" when="1865-04-28">
                                <hi rendition="#italic">April</hi> 28, 1865</date>.</dateline>
                    </opener>
                    <p>In compliance with the above influentially-signed request, I hereby convene a
                        meeting of the citizens of Dublin, to be held in Oak Room Mansion House, on
                        to-morrow, Saturday, April 29, at 2 o’clock.</p>
                    <closer>
                        <signed>JOHN BARRINGTON, </signed>
                        <hi rendition="#italic">Lord Mayor</hi>.</closer>
                </postscript>
            </div>
        </body>
