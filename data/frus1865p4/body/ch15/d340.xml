    <text>
        <body>
            <div xml:id="d340">

                <pb facs="0276" n="204" sameAs="frus:frus1865p4/pg204"/>

                <head>Municipal Council of Dublin</head>
                <dateline>
                    <hi rendition="#small-caps">City Hall, Town Clerk’s Office</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Dublin</hi></placeName>, <date calendar="gregorian"
                        when="1865-05-13">
                        <hi rendition="#italic">May</hi> 13, 1865</date>.</dateline>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit to you the
                    accompanying resolutions unanimously adopted by the municipal council of this
                    city, and to request that you will submit the same to the President and Congress
                    of the United States at your earliest convenience.</p>
                <p>I have the honor to remain, sir, your obedient servant,</p>
                <closer>
                    <signed>W. J. HENRY, </signed>
                    <hi rendition="#italic">Town Clerk</hi>. </closer>
                <postscript>
                    <p>
                        <hi rendition="#small-caps">Secretary of State</hi>, <hi rendition="#italic"
                            >Washington</hi>.</p>
                </postscript>


                <xi:include href="d340-a1.xml" xpointer="d340-a1"/>
