    <text>
        <body>
            <div xml:id="d648">

                <pb facs="0428" n="356" sameAs="frus:frus1865p4/pg356"/>

                <head>Municipal Council of Warwick </head>
                <p rendition="#center">
                    <hi rendition="#italic">Resolution of the council of the borough of
                    Warwick</hi>.</p>
                <p>We, the mayor, aldermen, and burgesses of the borough of Warwick, in council
                    assembled, desire to give expression to the feelings of horror, indignation, and
                    regret with which we have heard of the assassination of President Lincoln, and
                    beg to convey to Mrs. Lincoln and the United States government and people an
                    expression of our sincere and deep sympathy and heartfelt condolence at the
                    melancholy event.</p>
                <closer>
                    <dateline rendition="#float-left">Given under our common seal the <date
                            calendar="gregorian" when="1865-05-09">ninth day of May, one thousand
                            eight hundred and sixty-five</date>.</dateline>
                    <lb/> [<hi rendition="#small-caps">seal</hi>.] <signed>THOMAS B. DALE, </signed>
                    <hi rendition="#italic">Mayor</hi>.</closer>
            </div>
        </body>
    </text>
