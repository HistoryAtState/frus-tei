    <text>
        <body>
            <div xml:id="d495">

                <pb facs="0359" n="287" sameAs="frus:frus1865p4/pg287"/>

                <head>Municipal Council of Morpeth</head>
                <dateline>
                    <placeName>Morpeth</placeName>, <date
                        ana="#date_undated-inferred-from-document-content" calendar="gregorian"
                        when="1865-05-04">May 4, 1865</date>
                </dateline>
                <p rendition="#center">
                    <hi rendition="#italic">Resolution of the council of the borough of
                    Morpeth</hi>.</p>
                <p>Resolution passed at a quarterly meeting of the council of this borough, on the
                    fourth day of May, one thousand eight hundred and sixty-five: <quote
                        rend="blockquote">“That the mayor, aldermen and councillors of Morpeth
                        desire to express their feelings of sorrow and indignation at the
                        assassination of the President of the United States of America, and at the
                        attempt to obtain the life of his chief Secretary, Mr. Seward.” </quote>
                </p>
            </div>
