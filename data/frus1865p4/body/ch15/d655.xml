    <text>
        <body>
            <div xml:id="d655">

                <pb facs="0432" n="360" xml:id="pg360"/>

                <head>Wednesbury Local Board of Health</head>
                <dateline>
                    <hi rendition="#small-caps">Wednesbury Local Board of Health</hi>, <date
                        calendar="gregorian" when="1865-05-05">
                        <hi rendition="#italic">May</hi> 5, 1865</date>.</dateline>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I am instructed by the above Board of
                    Health, as representing the inhabitants of the town of Wednesbury, containing
                    upwards of 23,000 population, to forward to you a copy of a resolution passed at
                    the last meeting of the board held on the 1st of this present month of May, as
                    follows:</p>
                <p>
                    <hi rendition="#italic">Resolved</hi>, That this board expresses its detestation
                    of the assassination of President Lincoln, and of the brutal attack upon
                    Secretary Seward, and also its sympathy with the people of the United States of
                    America upon the great and irreparable loss they have sustained thereby. I am,
                    sir, your most obedient servant,</p>
                <closer>
                    <signed>WILLIAM TANLY BAILEY,</signed>
                    <lb/>
                    <hi rendition="#italic">Clerk of the Board</hi>.</closer>
                <postscript>
                    <p>
                        <hi rendition="#small-caps">Charles F. Adams</hi>, Esq., <lb/>
                        <hi rendition="#italic">Ambassador of the United States, London</hi>.</p>
                </postscript>
            </div>
        </body>
