    <text>
        <body>
            <div xml:id="d395">

                <pb facs="0305" n="233" sameAs="frus:frus1865p4/pg233"/>

                <head>Inhabitants of Halstead</head>
                <dateline>
                    <hi rendition="#small-caps">Halstead</hi>, <date calendar="gregorian"
                        when="1865-04-25">
                        <hi rendition="#italic">April</hi> 29, 1865</date>.</dateline>
                <p>His Excellency C. F. <hi rendition="#small-caps">Adams</hi>, <hi
                        rendition="#italic">London:</hi>
                </p>
                <p>We, the undersigned, inhabitants of Halstead, Essex, England, desire to express
                    our deep horror and regret that the President of the United States has been
                    deprived of life by an act of violence, and our sympathy with the citizens of
                    the United States in the great loss they have sustained.</p>
                <closer>
                    <signed>(Signed by 67 names.)</signed>
                </closer>
                <postscript>
                    <p>Forwarded by R. L. Hughes, proprietor of the “Halstead Times.”</p>
                </postscript>
            </div>
        </body>
