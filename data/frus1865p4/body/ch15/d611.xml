    <text>
        <body>
            <div xml:id="d611">

                <pb facs="0412" n="340" sameAs="frus:frus1865p4/pg340"/>

                <head>Municipal Council of Selkirk</head>
                <p rendition="#center">
                    <hi rendition="#italic">Resolution of the provost, magistrates and town council
                        of the royal burgh of Selkirk</hi>.</p>
                <p rendition="#flush">
                    <hi rendition="#italic">To the President of the United States of America:</hi>
                </p>
                <p>We, the provost, magistrates and town council of the royal burgh of Selkirk, for
                    ourselves, and as representing the community of the said burgh, beg to express
                    our feelings of abhorrence in regard to the assassination of President Lincoln,
                    and our sympathy with the American people under the loss they have sustained by
                    the sudden and violent death of the head of their government.</p>
                <closer>
                    <dateline rendition="#float-left">Signed by the magistrates, by authority of the
                        town council, and the seal of the burgh affixed, this <date
                            calendar="gregorian" when="1865-05-11">11th day of May,
                        1865</date>.</dateline>
                    <lb/> [<hi rendition="#small-caps">seal</hi>.] <signed>
                        <list>
                            <item>JOHN JOHNSTON, <hi rendition="#italic">Provost</hi>.</item>
                            <item>THOMAS DALYLEISH, <hi rendition="#italic">Bailie</hi>.</item>
                            <item>GEORGE LEWIS, <hi rendition="#italic">Bailie</hi>.</item>
                            <item>JAMES MILLAR, <hi rendition="#italic">Dean of Guild</hi>.</item>
                            <item>BASIL HENDERSIN, <hi rendition="#italic">Treasurer</hi>.</item>
                        </list>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
