    <text>
        <body>
            <div xml:id="d289">

                <pb facs="0256" n="184" sameAs="frus:frus1865p4/pg184"/>

                <head>Government Secretary</head>
                <dateline>
                    <hi rendition="#small-caps">Government Secretary’s Office</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">British Guiana</hi></placeName>, <date
                        calendar="gregorian" when="1865-05-22">
                        <hi rendition="#italic">May</hi> 22, 1865</date>.</dateline>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The governor directs me to acknowledge the
                    receipt of your official communication of this day’s date, announcing the death
                    of his Excellency Abraham Lincoln, late President of the United States of
                    America, and I am to convey to you the expression of his very deep regret on the
                    occasion. </p>
                <p>I have the honor to be, sir, your obedient, humble servant,</p>
                <closer>
                    <signed>WALTER HOWARD WARE,</signed>
                    <lb/>
                    <hi rendition="#italic">Acting Government Secretary</hi>.</closer>
                <postscript>
                    <p>
                        <hi rendition="#small-caps">P. W. Figgelmesy</hi>, Esq., <lb/>
                        <hi rendition="#italic">United States Consul, Demerara</hi>.</p>
                </postscript>
            </div>
        </body>
    </text>
