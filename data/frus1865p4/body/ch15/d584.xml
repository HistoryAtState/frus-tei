    <text>
        <body>
            <div xml:id="d584">

                <pb facs="0400" n="328" sameAs="frus:frus1865p4/pg328"/>

                <head>Municipal Council of Scarborough</head>
                <dateline>
                    <placeName>Scarborough</placeName>, <date
                        ana="#date_undated-inferred-from-document-content" calendar="gregorian"
                        when="1865-05-08">May 8, 1865</date>
                </dateline>
                <p rendition="#center">
                    <hi rendition="#italic">Resolution passed at a meeting of the council of the
                        borough of Scarborough, in the county of York, held in the Town Hall, on
                        Monday, May</hi> 8, 1865.</p>
                <p>
                    <hi rendition="#italic">Resolved unanimously</hi>, That this council desires to
                    express its feelings of horror and indignation at the assassination of the
                    President of the United States, and the barbarous attempt on the lives of
                    Secretary Seward and his son; and also its deep sympathy with the people of the
                    United States, as well as with the widow and family of the President, at the
                    great loss they have sustained.</p>
                <closer>
                    <salute>Signed on behalf of the council:</salute>
                    <signed>AMBROSE GIBSON, </signed>
                    <hi rendition="#italic">Mayor</hi>.</closer>
            </div>
