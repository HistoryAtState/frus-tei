        <body>
            <div xml:id="d1137">

                <pb facs="0779" n="707" xml:id="pg707"/>

                <head>Baptist State Convention in Providence, Rhode Island</head>
                <dateline>
                    <placeName>
                        <hi rendition="#small-caps">Providence</hi>, R. I.</placeName>, <date
                        calendar="gregorian" when="1865-04-29">
                        <hi rendition="#italic">April</hi> 29, 1865</date>.</dateline>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: At a meeting of the Rhode Island Baptist
                    State Convention, held in the city of Providence, April 25, 1865, the following
                    resolutions, reported by Rev. Dr. Caswell, were uuanimously adopted, and the
                    Secretary was instructed to forward a copy, duly signed, to the President.</p>
                <closer>
                    <signed>A. J. PADELFORD, </signed>
                    <hi rendition="#italic">Secretary</hi>.</closer>


                <xi:include href="d1137-a1.xml" xpointer="d1137-a1"/>
