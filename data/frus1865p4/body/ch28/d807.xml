    <text>
        <body>
            <div xml:id="d807">

                <pb facs="0567" n="495" xml:id="pg495"/>

                <head>
                    <hi rendition="#italic">Mr. Judd to Mr. Seward</hi>.</head>
                <dateline>
                    <hi rendition="#small-caps">United States Legation</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Berlin</hi></placeName>, <date calendar="gregorian"
                        when="1865-05-01">
                        <hi rendition="#italic">May</hi> 1, 1865</date>.</dateline>
                <p rendition="#flush">No. 96.]</p>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: This forenoon Captain von Lucadou,
                    personal aide-de-camp of his Royal Highness the Crown Prince of Prussia,
                    presented himself at the legation and informed me that he was charged by their
                    Royal Highnesses the Prince and Princess Royal of Prussia to request me to
                    transmit on their behalf, to the government of the United States, their
                    condolence at the sad event that had transpired, and desiring me also to convey
                    to Mrs. Lincoln their kind sympathies in her affliction.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>N. B. JUDD.</signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <lb/>
                        <hi rendition="#italic">Secretary of State, Washington</hi>.</p>
                </postscript>
            </div>
        </body>
