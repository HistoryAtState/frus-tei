                <pb facs="0532" n="460" sameAs="frus:frus1865p4/pg460"/>

                <head>Montanelli Democratic Society</head>
                <note rend="inline" rendition="#center" type="source">[Translation.]</note>
                <dateline>
                    <hi rendition="#small-caps">Pisa</hi>, <date calendar="gregorian"
                        when="1865-05-12">
                        <hi rendition="#italic">May</hi> 12, 1865</date>.</dateline>
                <p rendition="#center">
                    <hi rendition="#italic">The Montanelli Association for Mutual Education and
                        Assistance, G. Garibaldi, honorary president, to Mr. Andrew J. Stevens,
                        United States consul in Leghorn</hi>.</p>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Have the kindness to send the enclosed
                    letter to your President. It was unanimously approved by the Montanelli Society
                    of Pisa, on the 10th instant, at 9 p.m.</p>
                <closer>
                    <signed>ALFONSO GIARRIZZO BUETTO.</signed>
                </closer>



