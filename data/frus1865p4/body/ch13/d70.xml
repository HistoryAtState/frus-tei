    <text>
        <body>
            <div xml:id="d70">

                <pb facs="0121" n="49" sameAs="frus:frus1865p4/pg49"/>

                <head>
                    <hi rendition="#italic">Mr. Hale to Mr.
                            Seward</hi>.</head>
                <dateline>
                    <hi rendition="#small-caps">Agency and Consulate General of the U. S. of
                        America</hi>, <lb/>
                    <placeName>
                        <hi rendition="#italic">Alexandria, Egypt</hi></placeName>, <date
                        calendar="gregorian" when="1865-05-05">
                        <hi rendition="#italic">May</hi> 5, 1865</date>.</dateline>
                <p rendition="#flush">No. 25.]</p>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to report that his
                    highness the Pacha of Egypt, has seized the earliest opportunity to express to
                    me the pain with which he has heard the sad tidings of the assassination of the
                    President of the United States, his detestation of the abominable crime, and his
                    sympathy for our country in the grievous loss we have sustained.</p>
                <p>I have the honor to be, sir, most respectfully, your obedient servant,</p>
                <closer>
                    <signed>CHARLES HALE.</signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <lb/>
                        <hi rendition="#italic">Secretary of State</hi>.</p>
                </postscript>
            </div>
        </body>
    </text>
