    <text>
        <body>
            <div xml:id="d937">

                <pb facs="0646" n="574" sameAs="frus:frus1865p4/pg574"/>

                <head>Thurgau Mutual Aid Society</head>
                <dateline>
                    <placeName>Thurgau</placeName>, <date
                        ana="#date_undated-inferred-from-document-content" calendar="gregorian"
                        when="1865-05-08">May 8, 1865</date>
                </dateline>
                <note rend="inline" rendition="#center" type="source">[Translation.]</note>
                <p rendition="#center">
                    <hi rendition="#italic">Telegram from Frauenfeld to Berne, (received May</hi> 8,
                    1865, <hi rendition="#italic">) to the editor of the Bund, in Berne</hi>.</p>
                <p>The Thurgau Mutual Aid Society, at a special meeting this day, has unanimously
                    declared its adhesion to the Swiss address of sympathy and condolence to the
                    people of the United States.</p>
                <closer>
                    <signed>
                        <list>
                            <item>MANN, <hi rendition="#italic">Actuary</hi>.</item>
                            <item>STRAHEN, <hi rendition="#italic">Telegraph Agent</hi>.</item>
                        </list>
                    </signed>
                </closer>
            </div>
        </body>
