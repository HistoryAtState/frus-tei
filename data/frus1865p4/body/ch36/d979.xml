    <text>
        <body>
            <div xml:id="d979">

                <pb facs="0665" n="593" xml:id="pg593"/>

                <head>Government of the Canton of Soleure</head>
                <note rend="inline" rendition="#center" type="source">[Translation.]</note>
                <dateline>
                    <placeName>
                        <hi rendition="#small-caps">Berne</hi></placeName>, <date
                        calendar="gregorian" when="1865-05-01">
                        <hi rendition="#italic">May</hi> 1, 1865</date>.</dateline>
                <p>By the authority of the government counsellor of Solothurn, I hereby sign the
                    enclosed address of sympathy and condolence to the President of the United
                    States of North America, in the name of the canton of Solothurn. (Soleure.)</p>
                <p>For the Swiss Union Chancery:</p>
                <closer>
                    <signed>SOHIESS,</signed>
                    <lb/>
                    <hi rendition="#italic">Chancellor of the Confederation</hi>. </closer>
                <postscript>
                    <p rendition="#flush">{Bundes-kanzlei Schweizeirsche Eidgenossenschaft.}</p>
                </postscript>
            </div>
        </body>
    </text>
