    <text>
        <body>
            <div xml:id="d1011">

                <pb facs="0675" n="603" sameAs="frus:frus1865p4/pg603"/>

                <head>Polytechnic Scholars from the Canton of Ticino</head>
                <note rend="inline" rendition="#center" type="source">[Translation.]</note>
                <dateline>
                    <placeName>
                        <hi rendition="#small-caps">Zurich</hi></placeName>, <date
                        calendar="gregorian" when="1865-05-05">
                        <hi rendition="#italic">May</hi> 5, 1865</date>.</dateline>
                <p>Signatures of the polytechnic scholars from the canton of Ticino, to the address
                    of sympathy and condolence to the American Union:</p>
                <closer>
                    <signed>
                        <list>
                            <item>LEONARDO ROSSI, <hi rendition="#italic">of
                                Castelrotto</hi>.</item>
                            <item>CARLO FONTANA, <hi rendition="#italic">of Tesserete</hi>.</item>
                            <item>OLINDO BOLETTI, <hi rendition="#italic">of Locarno</hi>.</item>
                            <item>IGNAZIO ZANATTA, <hi rendition="#italic">of Lugano</hi>.</item>
                            <item>GIOACHIMO TIODA, <hi rendition="#italic">of Locarno</hi>.</item>
                            <item>CAETANO FONTANA, <hi rendition="#italic">of Tesserete</hi>.</item>
                            <item>ACHILLE RUSCA, <hi rendition="#italic">of Locarno</hi>.</item>
                            <item>GIULIO GIANINI, <hi rendition="#italic">of Sobrio</hi>.</item>
                            <item>FEDERICO BEZZOLO, <hi rendition="#italic">of
                                Cornologno</hi>.</item>
                            <item>PLINIO DELLBARCHI, <hi rendition="#italic">of Astano</hi>.</item>
                            <item>GIACOMO LEPORI, <hi rendition="#italic">of Deno</hi>.</item>
                            <item>TEODORO ANASTASIA, <hi rendition="#italic">of Breno</hi>.</item>
                            <item>VESPASSIORNO PALEARI, <hi rendition="#italic">of
                                Mezcatte</hi>.</item>
                        </list>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
