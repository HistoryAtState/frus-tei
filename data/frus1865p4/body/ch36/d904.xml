    <text>
        <body>
            <div xml:id="d904">

                <pb facs="0634" n="562" sameAs="frus:frus1865p4/pg562"/>

                <head>Students of the Concordia Society</head>
                <note rend="inline" rendition="#center" type="source">[Translation.]</note>
                <dateline>
                    <placeName><hi rendition="#small-caps">Berne</hi></placeName>, <date
                        calendar="gregorian" when="1865-05-03">
                        <hi rendition="#italic">May</hi> 3, 1865</date>.</dateline>
                <p>The students of the Concordia Society, 19 members, have this day resolved to
                    unite in the address of sympathy and condolence to the American Union. In the
                    name of the Concordia:</p>
                <closer>
                    <signed>
                        <list>
                            <item>A. SCHEURER, <hi rendition="#italic">President, Law
                                Student</hi>.</item>
                            <item>BERGER, <hi rendition="#italic">Secretary</hi>.</item>
                        </list>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
