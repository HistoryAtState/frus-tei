    <text>
        <body>
            <div xml:id="d962">

                <pb facs="0658" n="586" xml:id="pg586"/>

                <head>German Harmony Society of Locle</head>
                <note rend="inline" rendition="#center" type="source">[Translation.]</note>
                <dateline>
                    <placeName>
                        <hi rendition="#small-caps">Locle</hi></placeName>, <date
                        calendar="gregorian" when="1865-05-19">
                        <hi rendition="#italic">May</hi> 19, 1865</date>.</dateline>
                <p rendition="#flush">
                    <hi rendition="#italic">To the Bund</hi>:</p>
                <p>
                    <hi rendition="#small-caps">Dear Sir</hi>: Excuse the liberty I take of
                    requesting you to have the kindness to hand the enclosed address to the American
                    people to the United States minister resident in Berne, and oblige your obedient
                    servant,</p>
                <closer>
                    <signed>SEBASTIAN GYGER, </signed>
                    <hi rendition="#italic">Secretary</hi>.</closer>


                <xi:include href="d962-a1.xml" xpointer="d962-a1"/>
            </div>
        </body>
    </text>
