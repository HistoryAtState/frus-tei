                <pb facs="0667" n="595" sameAs="frus:frus1865p4/pg595"/>

                <head>Riflemen’s and Private Club of Schöftland</head>
                <note rend="inline" rendition="#center" type="source">[Translation.]</note>
                <dateline>
                    <placeName>
                        <hi rendition="#small-caps">Schöftland, Canton of Aargau</hi></placeName>,
                        <date calendar="gregorian" when="1865-04-27">
                        <hi rendition="#italic">April</hi> 27, 1865</date>.</dateline>
                <p>The subscribers heartily join in the address of sympathy to the President and
                    Vice-President of the United States on account of their recent complete
                    victories over their enemies,</p>
                <p>The Feldschütien-gesellschaft of Schöftland:</p>
                <closer>
                    <signed>ADOLPH HÜTHY, </signed>
                    <hi rendition="#italic">President</hi>. <lb/>
                    <signed>T. GLOOR, </signed>
                    <hi rendition="#italic">Secretary</hi>. <lb/>
                    <signed>A. WIRTZ, </signed>
                    <hi rendition="#italic">Cashier</hi>. <lb/>
                    <signed>A. DIENER,</signed>
                    <lb/>
                    <signed>SAMUEL HAURI,</signed>
                    <lb/>
                    <hi rendition="#italic">Directors from Hirschthal</hi>. </closer>
                <postscript>
                    <p rendition="#center">
                        <hi rendition="#italic">Members of the Association</hi>.</p>
                    <table cols="2" rows="10">
                        <row role="label">
                            <cell>R. MULLER.</cell>
                            <cell>S. HAURI.</cell>
                        </row>
                        <row>
                            <cell>T. HUMM.</cell>
                            <cell>CHRISTIAN SCHELL.</cell>
                        </row>
                        <row>
                            <cell>F. LÜTNY.</cell>
                            <cell>JACOB MÜLLER.</cell>
                        </row>
                        <row>
                            <cell>FRIEDRICH GLOOR.</cell>
                            <cell>S. MÜLLER.</cell>
                        </row>
                        <row>
                            <cell>Z. FEHLMANN.</cell>
                            <cell>RUDOLPH HÜNZICKER.</cell>
                        </row>
                        <row>
                            <cell>T. SUTER.</cell>
                            <cell>RUDOLF WIRZ.</cell>
                        </row>
                        <row>
                            <cell>J. SÜTHI.</cell>
                            <cell>HÜTHY BASLER.</cell>
                        </row>
                        <row>
                            <cell>G. LANZ.</cell>
                            <cell>RUDOLF ZINNHARD.</cell>
                        </row>
                        <row>
                            <cell>G. WIRZ.</cell>
                            <cell>R. MATHYS.</cell>
                        </row>
                        <row>
                            <cell>HEINRICH FREY.</cell>
                            <cell>RUDOLF BOLLIGER.</cell>
                        </row>
                    </table>
                    <p rendition="#center">
                        <hi rendition="#italic">Members of the Leist-Gesellschqft of Schŏltland</hi>
                    </p>
                    <table cols="2" rows="6">
                        <row role="label">
                            <cell>F. R. WIRZ, <hi rendition="#italic">President</hi>.</cell>
                            <cell>CASPAR DIENER.</cell>
                        </row>
                        <row>
                            <cell>FRIEDRICH MÜLLER, <hi rendition="#italic">Sec’y</hi>.</cell>
                            <cell>S. GLOOR.</cell>
                        </row>
                        <row>
                            <cell>
                                <hi rendition="#small-caps">Rev</hi>. F ZIMMERLIN.</cell>
                            <cell>LUTHI FUSTER.</cell>
                        </row>
                        <row>
                            <cell>R. WIELAND.</cell>
                            <cell>SAMUEL SCHILLING.</cell>
                        </row>
                        <row>
                            <cell>DAVID STÜHSI, <lb/>
                                <hi rendition="#italic">Teacher in the District School</hi>.</cell>
                            <cell>S. MÜLLER.</cell>
                        </row>
                        <row>
                            <cell/>
                            <cell>H. LEIST.</cell>
                        </row>
                    </table>
                </postscript>
