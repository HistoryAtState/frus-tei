    <text>
        <body>
            <div xml:id="d993">

                <pb facs="0669" n="597" sameAs="frus:frus1865p4/pg597"/>

                <head>Government of the Canton of Valais</head>
                <note rend="inline" rendition="#center" type="source">[Translation.]</note>
                <p rendition="#center">
                    <hi rendition="#italic">The grand council of the canton of Valais to the
                        legation of the United States of America in Berne</hi>.</p>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The grand council joins in the addresses
                    of sympathy and condolence sent to the legation by the government of Valais, and
                    other states of the Swiss Confederation, on the subject of the assassination of
                    President Lincoln. The grand council is convinced that this is the expression of
                    the sentiments of the inhabitants of the canton.</p>
                <closer>
                    <dateline rendition="#float-left">Given at <placeName>Sion</placeName>, <date
                            calendar="gregorian" when="1865-05-17">May 17, 1865</date>, in the name
                        of the grand council.</dateline>
                    <signed>
                        <list>
                            <item>ZERMATTEN, <hi rendition="#italic">President</hi>.</item>
                            <item>Z. DURIER,</item>
                            <item>L. E. ROURY, <lb/>
                                <hi rendition="#italic">Secretaries</hi>.</item>
                        </list>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
