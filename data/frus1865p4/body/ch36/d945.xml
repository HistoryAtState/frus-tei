                <pb facs="0650" n="578" sameAs="frus:frus1865p4/pg578"/>

                <head>Inhabitants of Gruyere</head>
                <dateline>
                    <placeName>Gruyere</placeName>, <date
                        ana="#date_undated-inferred-from-volume-rules" calendar="gregorian"
                        notAfter="1865-07-31T23:59:59+00:34" notBefore="1865-04-15T00:00:00+00:34"
                        >undated</date>
                </dateline>
                <note rend="inline" rendition="#center" type="source">[Translation.]</note>
                <p>The undersigned, citizens of Gruyere, join their fellow-countrymen of Fribourg in
                    the address to the republicans of the United States.</p>
                <closer>
                    <signed>J. GIENOZ,</signed>
                    <lb/>
                    <signed>JULES GLASSON,</signed>
                    <lb/>
                    <signed>CHAS. BRASCHAUD,</signed>
                    <lb/>
                    <signed>F. DEIRONE,</signed>
                    <lb/>
                    <signed>TH. BAYS,</signed>
                    <lb/>
                    <signed>F. DEEROUX,</signed>
                    <lb/>
                    <signed>F. DALER,</signed>
                    <lb/>
                    <signed>GIETENHOFF TOBIE,</signed>
                    <lb/>
                    <signed>JOSEPH DUBOIS,</signed>
                    <lb/>
                    <signed>FREDERIC LAMDRY, </signed><lb/> And 96 other names. </closer>
            </div>
