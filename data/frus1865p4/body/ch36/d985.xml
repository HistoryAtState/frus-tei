    <text>
        <body>
            <div xml:id="d985">

                <pb facs="0666" n="594" sameAs="frus:frus1865p4/pg594"/>

                <head>Captain Gloor</head>
                <note rend="inline" rendition="#center" type="source">[Translation]</note>
                <dateline>
                    <placeName>
                        <hi rendition="#small-caps">Schöftland</hi></placeName>, <date
                        calendar="gregorian" when="1865-05-05">
                        <hi rendition="#italic">May</hi> 5, 1865</date>.</dateline>
                <p rendition="#flush">
                    <hi rendition="#italic">The Editor of the Bund, in Berne:</hi>
                </p>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit to you the
                    lists of the signatures of the Feldschützen and Leist-Gesellschaft of this place
                    to the general address of sympathy <pb facs="0667" n="595" xml:id="pg595"/> and
                    condolence to the North American Union, and its inhabitants, our brothers beyond
                    the ocean, on the occasion of the assassination of the martyr President, Abraham
                    Lincoln, and for their recent glorious victories over the southern rebels. You
                    will please have them sent to the proper address, and oblige the
                    undersigned.</p>
                <closer>
                    <signed>T. GLOOR, </signed>
                    <hi rendition="#italic">Secretary</hi>.</closer>
            </div>
        </body>
    </text>
