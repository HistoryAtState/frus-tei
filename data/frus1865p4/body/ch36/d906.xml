    <text>
        <body>
            <div xml:id="d906">

                <pb facs="0634" n="562" sameAs="frus:frus1865p4/pg562"/>

                <head>Frohsinn Singing Society</head>
                <dateline>
                    <placeName>Bern</placeName>, <date
                        ana="#date_undated-inferred-from-document-content" calendar="gregorian"
                        when="1865-05-06">May 6, 1865</date>
                </dateline>
                <note rend="inline" rendition="#center" type="source">[Translation.]</note>
                <p>The undersigned society, at a full meeting this day, unanimously passed the
                    following resolutions: <list>
                        <label>1.</label>
                        <item>We cordially approve of the address of sympathy and condolence to the
                            American Union now circulating in this city.</item>
                        <label>2.</label>
                        <item>We order that every member of the society sign his name to this paper,
                            and that it be properly executed. Berne, May 6, 1865. In the name of the
                            Frohsinn Männerchor, of Berne:</item>
                    </list>
                </p>
                <closer>
                    <signed>
                        <list>
                            <item>J. HUBER, <hi rendition="#italic">President</hi>.</item>
                            <item>T. BUCHERT, <hi rendition="#italic">Secretary</hi>.</item>
                        </list>
                    </signed>
                </closer>
                <postscript>
                    <p>(Eighty-four signatures follow.)</p>
                </postscript>
            </div>
        </body>
    </text>
