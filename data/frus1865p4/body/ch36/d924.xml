    <text>
        <body>
            <div xml:id="d924">

                <pb facs="0641" n="569" sameAs="frus:frus1865p4/pg569"/>

                <head>Dr. Carl Hilton</head>
                <note rend="inline" rendition="#center" type="source">[Translation.]</note>
                <dateline>
                    <placeName>
                        <hi rendition="#small-caps">Chur</hi></placeName>, <date
                        calendar="gregorian" when="1865-05-24">
                        <hi rendition="#italic">May</hi> 24, 1865</date>.</dateline>
                <p>The undersigned most cordially approves of the Swiss address of sympathy to the
                    United States, and requests to contribute his signature to its columns of
                    subscribers in our native land.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Dr</hi>. CARL HILTON,</signed>
                    <lb/>
                    <hi rendition="#italic">Lawyer in Chur</hi>.</closer>
            </div>
        </body>
    </text>
