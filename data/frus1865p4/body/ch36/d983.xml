    <text>
        <body>
            <div xml:id="d983">

                <pb facs="0666" n="594" sameAs="frus:frus1865p4/pg594"/>

                <head>Inhabitants of St. Gall</head>
                <note rend="inline" rendition="#center" type="source">[Translation.]</note>
                <dateline>
                    <placeName>
                        <hi rendition="#small-caps">St. Gall</hi></placeName>, <date
                        calendar="gregorian" when="1865-05-17">
                        <hi rendition="#italic">May</hi> 17, 1865</date>.</dateline>
                <p rendition="#center">
                    <hi rendition="#italic">Council of the canton of St. Gall to the honorable Swiss
                        Bundesrath in Berne</hi>.</p>
                <p>
                    <hi rendition="#small-caps">Gentlemen</hi>: In accordance with the wish of the
                    council of this district, we send you an abstract<anchor n="*" xml:id="d983-f1"
                    /> of the minutes of the popular meeting held on the 7th of this mouth to ratify
                    the address of sympathy and condolence to the American Union.</p>
                <p>Aceept the assurance of our distinguished consideration.</p>
                <closer>
                    <signed>
                        <list>
                            <item>SAILER, <hi rendition="#italic">President</hi>.</item>
                            <item>ZINGG, <hi rendition="#italic">Secretary</hi>.</item>
                        </list>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d983-f1" n="*" xml:id="d983-f1-content">
                <p>For abstract referred to, see Balgach.</p>
            </note>
        </listAnnotation>
