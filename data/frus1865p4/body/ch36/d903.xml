        <body>
            <div xml:id="d903">

                <pb facs="0634" n="562" sameAs="frus:frus1865p4/pg562"/>

                <head>Helvetia Students’ Union</head>
                <dateline>
                    <date ana="#date_undated-inferred-from-volume-rules" calendar="gregorian"
                        notAfter="1865-07-31T23:59:59-03:06" notBefore="1865-04-15T00:00:00-03:06"
                        >undated</date>
                </dateline>
                <note rend="inline" rendition="#center" type="source">[Translation.]</note>
                <p>Signatures of the members of the Helvetia Student’s Union to the address of
                    sympathy for the United States of America.</p>
                <closer>
                    <signed>
                        <list>
                            <item>GOTTFRIED FLENTISSEN, <hi rendition="#small-caps">Jr.</hi>, <hi
                                    rendition="#italic">President</hi>.</item>
                            <item>ADOLPHE FRENE, <hi rendition="#italic">Law Student</hi>.</item>
                            <item>JOHANN RITSCHARD, <hi rendition="#italic">Juris
                                Student</hi>.</item>
                            <item>FRIEDRICH MATHYS, <hi rendition="#italic">Theological
                                Student</hi>.</item>
                            <item>ALEX. IMMER, <hi rendition="#italic">Theological
                                Student</hi>.<lb/>And fifteen other names.</item>
                        </list>
                    </signed>
                </closer>
            </div>
        </body>
