    <text>
        <body>
            <div xml:id="d892">

                <pb facs="0628" n="556" sameAs="frus:frus1865p4/pg556"/>

                <head>Inhabitants of Aarmuhle</head>
                <note rend="inline" rendition="#center" type="source">[Translation.]</note>
                <dateline>
                    <hi rendition="#small-caps">Aarmuhle</hi>, <date calendar="gregorian"
                        when="1865-05-27">
                        <hi rendition="#italic">May</hi> 27, 1865</date>.</dateline>
                <p>Mr. <hi rendition="#small-caps">President</hi>: At a public meeting of the
                    citizens of Aarmuhle, district of Interlachen, it was unanimously resolved to
                    ratify the Swiss address of gratulation and sympathy to the people of the North
                    American Union.</p>
                <p>Respectfully,</p>
                <closer>
                    <signed>
                        <list>
                            <item>M. WYDER, <hi rendition="#italic">President</hi>.</item>
                            <item>P. VORTER, <hi rendition="#italic">Secretary</hi>.</item>
                        </list>
                    </signed>
                </closer>
                <postscript>
                    <p>The Hon. <hi rendition="#small-caps">Bundesrath</hi>
                        <lb/>
                        <hi rendition="#italic">of the Swiss Confederation in Berne</hi>.</p>
                </postscript>
            </div>
        </body>
    </text>
