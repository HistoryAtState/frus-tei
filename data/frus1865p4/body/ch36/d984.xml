    <text>
        <body>
            <div xml:id="d984">

                <pb facs="0666" n="594" sameAs="frus:frus1865p4/pg594"/>

                <head>Company of Free Hunters</head>
                <note rend="inline" rendition="#center" type="source">[Translation.]</note>
                <dateline>
                    <placeName>
                        <hi rendition="#small-caps">St. Gall</hi></placeName>, <date
                        calendar="gregorian" when="1865-05-12">
                        <hi rendition="#italic">May</hi> 12, 1865</date>.</dateline>
                <p rendition="#flush">
                    <hi rendition="#italic">To the Bund:</hi>
                </p>
                <p>The Company of Free Hunters of the city of St. Gall, numbering one hundred and
                    fifty members, at its last meeting, resolved to approve of the address of
                    sympathy to the American Union. We beg you to note this, and subscribe ourselves
                    your obedient servants,</p>
                <closer>
                    <signed>
                        <list>
                            <item>BURGE, <hi rendition="#italic">Captain</hi>.</item>
                            <item>J. HAEBERLIN, <hi rendition="#italic">Secretary</hi>.</item>
                        </list>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
