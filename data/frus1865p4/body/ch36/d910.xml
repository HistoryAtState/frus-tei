                <pb facs="0635" n="563" sameAs="frus:frus1865p4/pg563"/>

                <head>Bollingen Reading Society</head>
                <note rend="inline" rendition="#center" type="source">[Translation.]</note>
                <dateline>
                    <hi rendition="#small-caps">Bollingen</hi>, <date calendar="gregorian"
                        when="1865-05-07">
                        <hi rendition="#italic">May</hi> 7, 1865</date>.</dateline>
                <p>
                    <hi rendition="#small-caps">Mr. Editor</hi>: The Bollingen Reading Society,
                    consisting of twenty members, at an ordinary meeting last evening, resolved to
                    join in the address of sympathy and condolence to the United States of North
                    America on account of the assassination of their excellent President, Abraham
                    Lincoln, and to rejoice with them in their victories for the triumph of humanity
                    by the abolition of slavery.</p>
                <p>Respectfully, in the name of the Society,</p>
                <closer>
                    <signed>
                        <list>
                            <item>SOLOMON FLUKIGER, <lb/>
                                <hi rendition="#italic">President</hi>.</item>
                            <item>JOHN MUHLETHALER, <lb/>
                                <hi rendition="#italic">Actuary</hi>.</item>
                        </list>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
