    <text>
        <body>
            <div xml:id="d969">

                <pb facs="0661" n="589" sameAs="frus:frus1865p4/pg589"/>

                <head>Teachers of the District of Nidau</head>
                <note rend="inline" rendition="#center" type="source">[Translation.]</note>
                <dateline>
                    <placeName>
                        <hi rendition="#small-caps">Nidau</hi></placeName>, <date
                        calendar="gregorian" when="1865-05-06">
                        <hi rendition="#italic">May</hi> 6, 1865</date>.</dateline>
                <p rendition="#flush">
                    <hi rendition="#italic">To the Editor of the Bund, in Berne:</hi>
                </p>
                <p>The teachers in the district of Nidau, in the canton of Berne, hereby declare
                    their cordial approval of the vote of sympathy and condolence to the United
                    States of North America, and beg that their names be added to the address of the
                    Swiss Confederation.</p>
                <closer>
                    <salute>In the name of the synod of Nidau:</salute>
                    <signed>
                        <list>
                            <item>D. SCHMUTZ, <hi rendition="#italic">President</hi>.</item>
                            <item>J. A. KAUFMANN, <hi rendition="#italic">Secretary</hi>.</item>
                        </list>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
