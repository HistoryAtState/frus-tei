                <pb facs="0661" n="589" xml:id="pg589"/>

                <head>Mutual Aid Society of Neuveville</head>
                <note rend="inline" rendition="#center" type="source">[Translation.]</note>
                <dateline>
                    <placeName>
                        <hi rendition="#small-caps">Neuveville</hi></placeName>, <date
                        calendar="gregorian" when="1865-05-06">
                        <hi rendition="#italic">May</hi> 6, 1865</date>.</dateline>
                <p rendition="#center">
                    <hi rendition="#italic">Concurrence of the Mutual Aid Society of Neuveville,
                        canton of Berne, in the address of sympathy and condolence to the American
                        Union by the Swiss people</hi>.</p>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The Mutual Aid Society met to-day and
                    decided to join in the spontaneous manifestation of the Swiss people, and thank
                    the citizens who proposed it.</p>
                <p>It also requested its officers to sign the present resolution of concurrence and
                    send it to its address, in the name of the society.</p>
                <closer>
                    <signed>
                        <list>
                            <item>H. TSCHIFFE, <hi rendition="#italic">President</hi>.</item>
                            <item>FRED IMER, <hi rendition="#italic">Vice-President</hi>.</item>
                            <item>SCHEM KARLEN, <hi rendition="#italic">Cashier</hi>.</item>
                            <item>E. CIBOLLET, <hi rendition="#italic">Secretary</hi>.</item>
                        </list>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
