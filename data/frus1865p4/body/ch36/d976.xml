    <text>
        <body>
            <div xml:id="d976">

                <pb facs="0664" n="592" xml:id="pg592"/>

                <head>Inhabitants of Oftringen</head>
                <note rend="inline" rendition="#center" type="source">[Translation.]</note>
                <dateline>
                    <placeName>
                        <hi rendition="#small-caps">Oftringen</hi></placeName>, <date
                        calendar="gregorian" when="1865-05-30">
                        <hi rendition="#italic">May</hi> 30, 1865</date>.</dateline>
                <p rendition="#flush">
                    <hi rendition="#italic">To the Editor of the Bund, in Berne:</hi>
                </p>
                <p>We hereby respectfully request you to insert the enclosed communication in your
                    estimable paper. Hoping you will oblige us with such a slight favor, we remain,
                    yours, &amp;c.,</p>
                <closer>
                    <signed>LANG HUSSY, </signed>
                    <hi rendition="#italic">Councellor</hi>.</closer>


                <xi:include href="d976-a1.xml" xpointer="d976-a1"/>
            </div>
        </body>
