            <div xml:id="d951">

                <pb facs="0653" n="581" sameAs="frus:frus1865p4/pg581"/>

                <head>Kasimer Pfyffer</head>
                <dateline>
                    <date ana="#date_undated-inferred-from-volume-rules" calendar="gregorian"
                        notAfter="1865-07-31T23:59:59+00:34" notBefore="1865-04-15T00:00:00+00:34"
                        >undated</date>
                </dateline>
                <note rend="inline" rendition="#center" type="source">[Translation.]</note>
                <p rendition="#flush">
                    <hi rendition="#italic">To the Editor of the Bund, in Berne:</hi>
                </p>
                <p>
                    <hi rendition="#small-caps">Honored Sir</hi>: As the undersigned had not the
                    good fortune to see the address of sympathy and condolence to the American
                    Union, being absent from his place of residence while it was circulating,
                    respectfully requests you to add his name to the list of signers to that
                    patriotic document.</p>
                <p>I remain yours, with much esteem,</p>
                <closer>
                    <signed>KASIMIR PFYFFER.</signed>
                </closer>
            </div>
        </body>
    </text>
