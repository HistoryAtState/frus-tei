    <text>
        <body>
            <div xml:id="d988">

                <pb facs="0668" n="596" xml:id="pg596"/>

                <head>Factorymen’s Association of Schwanden</head>
                <note rend="inline" rendition="#center" type="source">[Translation.]</note>
                <dateline>
                    <placeName>
                        <hi rendition="#small-caps">Schwanden</hi></placeName>, <date
                        calendar="gregorian" when="1865-05-06">
                        <hi rendition="#italic">May</hi> 6, 1865</date>.</dateline>
                <p rendition="#flush">
                    <hi rendition="#italic">The Bund:</hi>
                </p>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: We are not men of many words, but our
                    feelings are not the less deep, and we now wish to express them, through you, to
                    the American people, as a free people and our fellow-laborers in freedom.</p>
                <p>In the name of the Factorymen of the Schwanden Verein:</p>
                <closer>
                    <signed>C. ZEHN, </signed>
                    <hi rendition="#italic">Chairman</hi>.</closer>
            </div>
        </body>
    </text>
