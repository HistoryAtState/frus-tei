    <text>
        <body>
            <div xml:id="d948">

                <pb facs="0651" n="579" sameAs="frus:frus1865p4/pg579"/>

                <head>Singing Society of Herzogenbuschsee</head>
                <note rend="inline" rendition="#center" type="source">[Translation.]</note>
                <dateline>
                    <placeName>
                        <hi rendition="#small-caps">Herzogenbuschsee</hi></placeName>, <date
                        calendar="gregorian" when="1865-05-20">
                        <hi rendition="#italic">May</hi> 20, 1865</date>.</dateline>
                <p rendition="#flush">
                    <hi rendition="#italic">To the Bund, Berne:</hi>
                </p>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I herewith enclose you the address of the
                    Mannerchor of this place, together with the declaration of assent of the Waugen
                    Trade Union, with many signatures.</p>
                <p>Circumstances prevented me from sending it sooner, but I hope it is not too late
                    to reach its destination through your kindness.</p>
                <p>Accept the assurance of my perfect esteem and devotion.</p>
                <p>By order:</p>
                <closer>
                    <signed>JOHN SPAHR.</signed>
                </closer>


                <xi:include href="d948-a1.xml" xpointer="d948-a1"/>
            </div>
        </body>
    </text>
