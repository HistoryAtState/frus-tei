    <text>
        <body>
            <div xml:id="d98">

                <pb facs="0137" n="65" sameAs="frus:frus1865p4/pg65"/>

                <head>Louis and Casimir Didett</head>
                <note rend="inline" rendition="#center" type="source">[Translation.]</note>
                <dateline>
                    <placeName>
                        <hi rendition="#small-caps">Nimes</hi></placeName>, <date
                        calendar="gregorian" when="1865-05-03">
                        <hi rendition="#italic">May</hi> 3, 1865</date>.</dateline>
                <p rendition="#flush">
                    <hi rendition="#italic">To the United States Minister in Paris:</hi>
                </p>
                <p>We have the honor of transmitting to you in this envelope the address of our
                    house, on the occasion of the death of the great American citizen, whom we and
                    the whole world lament.</p>
                <pb facs="0138" n="66" xml:id="pg66"/>
                <p>We join in this universal manifestation of sorrow, and ask you to send our homage
                    to its address.</p>
                <p>Receive the respectful greeting of your very humble servants,</p>
                <closer>
                    <signed>LOUIS &amp; CASIMIR DIDETT,</signed>
                    <lb/>
                    <hi rendition="#italic">Father and son, hat manufacturers in
                    Nimes</hi>.</closer>
            </div>
        </body>
    </text>
