    <text>
        <body>
            <div xml:id="d72">

                <pb facs="0122" n="50" sameAs="frus:frus1865p4/pg50"/>

                <head>
                    <hi rendition="#italic">Mr. Drouyn de Lhuys to Mr. Bigelow</hi>.</head>
                <note rend="inline" rendition="#center" type="source">[Translation]</note>
                <dateline>
                    <placeName>
                        <hi rendition="#small-caps">Paris</hi></placeName>, <date
                        calendar="gregorian" when="1865-04-26">
                        <hi rendition="#italic">April</hi> 26, 1865</date>.</dateline>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The telegrams published in the evening
                    papers inform me of the horrible crime of which Messieurs Lincoln and Seward
                    have been the victims. I would not delay a moment longer to express to you our
                    profound sympathy.</p>
                <p>Yours, very sincerely,</p>
                <closer>
                    <signed>DROUYN DE LHUYS.</signed>
                </closer>
                <postscript>
                    <p>
                        <hi rendition="#small-caps">John Bigelow</hi>, Esq., <lb/>
                        <hi rendition="#italic">United States Minister, Paris</hi>.</p>
                </postscript>
            </div>
        </body>
    </text>
