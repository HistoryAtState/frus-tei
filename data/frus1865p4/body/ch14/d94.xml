                                <cell>VICTOR JAMES, <hi rendition="#italic">G</hi>. 1 <hi
                                        rendition="#italic">Exp</hi>.</cell>
                                <cell>VICTOR, M.</cell>
                            </row>
                            <row>
                                <cell>LAMBERT.</cell>
                                <cell>JANVIER.</cell>
                            </row>
                            <row>
                                <cell>MAUDELEIN MOULET.</cell>
                                <cell>GAMBER.</cell>
                            </row>
                            <row>
                                <cell>LAURENT.</cell>
                                <cell>E. LOISOT, <hi rendition="#italic">Sergeant Major</hi>.</cell>
                            </row>
                            <row>
                                <cell>BREMONT.</cell>
                                <cell>G. BORGIA.</cell>
                            </row>
                        </table>
                    </p>
                </postscript>
            </div>
