    <text>
        <body>
            <div xml:id="d71">

                <pb facs="0078" n="70" xml:id="pg70"/>

                <note rend="inline" type="source">821.51/2632</note>
                <head><hi rendition="#italic">The Colombian Ambassador</hi> (<hi rendition="#italic">Turbay</hi>) <hi rendition="#italic"
                        >to the Adviser on Political Relations</hi> (<hi
                            rendition="#italic">Duggan</hi>)</head>
                <opener>
                    <seg rendition="#float-left">No. 1215</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1941-06-05">June 5, 1941</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Dear Mr. Duggan</hi>: I am pleased to send you
                    herewith, for your information, two copies of the announcement published in
                    today’s newspapers with regard to the Offer of the Republic of Colombia for the
                    exchange of the 1927 and 1928 6% External Gold Bonds and two copies of the Offer
                    and Letter of Transmittal to be sent directly to the bondholders.<anchor n="98"
                        xml:id="d71-f1"/></p>
                <p>With best regards, I am</p>
                <p>Yours very sincerely,</p>
                <closer><signed><hi rendition="#small-caps">Gabriel Turbay</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
