    <text>
        <body>
            <div xml:id="d90">

                <pb facs="0091" n="83" sameAs="frus:frus1941v07/pg83"/>

                <note rend="inline" type="source">800.8591/565</note>
                <head><hi rendition="#italic">The Minister in Costa Rica</hi> (<hi
                        rendition="#italic">Hornibrook</hi>) <hi rendition="#italic">to the
                        Secretary of State</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 2950</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">San
                                José</hi></placeName>, <date calendar="gregorian" when="1941-03-01"
                            >March 1, 1941</date>.<lb/>[Received March 10.]</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my despatches Nos. 2921 and
                    2937 of February 18 and 26, respectively, 1941,<anchor n="5" xml:id="d90-f1"/>
                    concerning the German and Italian merchant ships seeking refuge at Puntarenas, I
                    have the honor to enclose a memorandum containing the remarks made to me by
                    Foreign Minister Echandi on the subject.</p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">Wm. H. Hornibrook</hi></signed></closer>


                <xi:include href="d90-a1.xml" xpointer="d90-a1"/>
            </div>
        </body>
    </text>
