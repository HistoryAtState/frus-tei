            <div xml:id="d522">

                <pb facs="0621" n="613" xml:id="pg613"/>

                <note rend="inline" type="source">831.24/77: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Ambassador in
                        Venezuela</hi> (<hi rendition="#italic">Corrigan</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1941-12-26T20:00:00-05:00">December 26, 1941—8
                        p.m.</date></dateline>
                </opener>
                <p>294. Your 322, December 22, 7 p.m. Please inform President Medina that his
                    request is receiving the immediate attention of the appropriate authorities of
                    this Government and that everything possible will be done to supply the desired
                    equipment.</p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
    </text>
