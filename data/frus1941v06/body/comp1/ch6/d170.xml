    <text>
        <body>
            <div xml:id="d170">

                <pb facs="0140" n="130" sameAs="frus:frus1941v06/pg130"/>

                <note rend="inline" type="source">710 Consultation (3)/12–1841</note>
                <head><hi rendition="#italic">The Under Secretary of State</hi> (<hi rendition="#italic">Welles</hi>) <hi
                        rendition="#italic">to President Roosevelt</hi><anchor n="24" xml:id="d170-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1941-12-18">December 18, 1941</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">My Dear Mr. President</hi>: I am sending you for your
                    information a brief memorandum of a conversation I had this morning with the
                    Chargé d’Affaires of Canada concerning the suggested participation of Canada in
                    the consultative meeting to be held in Rio de Janeiro.</p>
                <p>Believe me,</p>
                <p>Faithfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Sumner Welles</hi>
                    </signed>
                </closer>


                <xi:include href="d170-a1.xml" xpointer="d170-a1"/>
            </div>
        </body>
    </text>
