    <text>
        <body>
            <div xml:id="d256">

                <pb facs="0230" n="220" sameAs="frus:frus1941v06/pg220"/>

                <note rend="inline" type="source">722.2315/1435</note>
                <head><hi rendition="#italic">The Peruvian Ambassador</hi> (<hi rendition="#italic">Freyre</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1941-04-10">April 10, 1941</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Your Excellency</hi>: In compliance with instructions
                    received from my Government, I have the honour to enclose for Your Excellency’s
                    information the Spanish text of a message addressed by cable yesterday to the
                    Minister of Foreign Affairs of Ecuador by the Peruvian Minister of Foreign
                    Affairs, in reply to the transcription received from the Ecuadorean Foreign
                    Minister of the Circular<anchor n="17" xml:id="d256-f1"/> delivered by him to
                    the Foreign Offices of America.</p>
                <p>Please accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">M. de Freyre y S.</hi>
                    </signed>
                </closer>


                <xi:include href="d256-a1.xml" xpointer="d256-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d256-f1" n="17" xml:id="d256-f1-content">
                <p>See telegram of April 6, from the Ecuadoran Minister for Foreign Affairs, <ref
                        target="#pg219">p. 219</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
