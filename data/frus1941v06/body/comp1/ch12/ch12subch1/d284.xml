                <pb facs="0253" n="243" sameAs="frus:frus1941v06/pg243"/>

                <note rend="inline" type="source">722.2315/2561: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Peru</hi> (<hi rendition="#italic"
                        >Norweb</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Lima</hi></placeName>, <date calendar="gregorian" when="1941-11-23"
                            >November 23, 1941</date>.<lb/>[Received 4:49 p.m.]</dateline>
                </opener>
                <p>628. Official communication announcing liberation of civilian and military
                    prisoners published in press this morning.</p>
                <p>Repeated to Quito.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Norweb</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
