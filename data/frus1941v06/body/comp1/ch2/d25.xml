                <pb facs="0036" n="26" sameAs="frus:frus1941v06/pg26"/>

                <note rend="inline" type="source">740.00111 A.R./1325: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Chargé in
                        Uruguay</hi> (<hi rendition="#italic">Chapin</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1941-06-24T23:00:00-04:00">June 24, 1941—11 p.m.</date></dateline>
                </opener>
                <p>131. Your 263, June 23, 7 p.m. Please inform Guani that his feeling regarding
                    special representations by our Minister in Paraguay has been conveyed to Mr.
                    Frost with the Department’s strong support.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Welles</hi>
                    </signed>
                </closer>
            </div>
        </body>
