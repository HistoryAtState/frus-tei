    <text>
        <body>
            <div xml:id="d13">

                <pb facs="0027" n="17" sameAs="frus:frus1941v06/pg17"/>

                <note rend="inline" type="source">740.00111 A.R.N.C./217a: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Ambassador in
                        Brazil</hi> (<hi rendition="#italic">Caffery</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1941-12-11T15:00:00-05:00">December 11, 1941—3
                        p.m.</date></dateline>
                </opener>
                <p>1340. Please deliver following message from Professor Fenwick to Dr. Mello
                        Franco:<anchor n="25" xml:id="d13-f1"/></p>
                <p>“Recommend Committee consider possible ways of extending functions to meet
                    present emergency.”</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d13-f1" n="25" xml:id="d13-f1-content">
                <p>Afranio de Mello Franco, Brazilian member of the Neutrality Committee.</p>
            </note>
        </listAnnotation>
    </standOff>
