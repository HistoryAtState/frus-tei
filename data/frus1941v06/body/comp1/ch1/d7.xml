    <text>
        <body>
            <div xml:id="d7">

                <pb facs="0015" n="5" sameAs="frus:frus1941v06/pg5"/>

                <note rend="inline" type="source">740.00111 A.R.N.C./182</note>
                <head><hi rendition="#italic">Memorandum by the Under Secretary of State</hi>
                        (<hi rendition="#italic">Welles</hi>) <hi
                        rendition="#italic">to the Legal Adviser</hi> (<hi
                            rendition="#italic">Hackworth</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1941-05-09">May 9, 1941</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Mr. Hackworth</hi>: Dr. Fenwick<anchor n="8"
                        xml:id="d7-f1"/> left with me this memorandum this morning.</p>
                <p>I think it is highly desirable that the Committee of which he is a member extend
                    the scope of its functions in every appropriate way during these critical times.
                    My judgment is that the points made in the memorandum are satisfactory. Will you
                    let me have your reaction?</p>
                <closer>
                    <signed>S[<hi rendition="#small-caps">umner</hi>] W[<hi rendition="#small-caps"
                            >elles</hi>]</signed>
                </closer>


                <xi:include href="d7-a1.xml" xpointer="d7-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d7-f1" n="8" xml:id="d7-f1-content">
                <p>Temporarily in the United States. He returned to Rio de Janeiro on May 20.</p>
            </note>
        </listAnnotation>
    </standOff>
