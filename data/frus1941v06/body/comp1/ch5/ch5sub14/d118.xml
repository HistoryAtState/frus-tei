    <text>
        <body>
            <div xml:id="d118">

                <pb facs="0111" n="101" xml:id="pg101"/>

                <note rend="inline" type="source">740.0011 Pacific War/937: Telegram</note>
                <head><hi rendition="#italic">The Mexican Minister for Foreign Affairs</hi>
                        (<hi rendition="#italic">Padilla</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <seg rendition="#center">[Translation]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName> [<date
                            ana="#date_undated-inferred-from-document-content-and-sibling-dates"
                            calendar="gregorian" notAfter="1941-12-10T08:25:00-06:00"
                            notBefore="1941-12-08T16:00:00-06:00">undated</date>].<lb/>[Received
                        December 10, 1941—8:25 a.m.]</dateline>
                </opener>
                <p>51921. In accordance with the spirit of the resolutions adopted at the Second
                    Consultative Meeting held at Habana in July 1940, I have the honor to inform
                    Your Excellency that the Government of Mexico yesterday broke its diplomatic and
                    consular relations with Japan, in view of the aggression committed by the latter
                    against the United States of America.</p>
                <p>I renew [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Ezequiel Padilla</hi>
                    </signed>
                </closer>
            </div>
        </body>
