                <pb facs="0563" n="553" sameAs="frus:frus1941v06/pg553"/>

                <note rend="inline" type="source">740.00118 European War 1939/95: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Ambassador in Chile</hi>
                        (<hi rendition="#italic">Bowers</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1941-02-08T18:00:00-05:00">February 8, 1941—6
                        p.m.</date></dateline>
                </opener>
                <p>26. Navy Department desires to open a Naval Observer’s Office at Punta Arenas,
                    Chile. Please inquire whether this contemplated action is acceptable to Chilean
                    Government. Cable reply.</p>
                <p>Name of observer will be sent for reference to Chilean Government upon receipt of
                    affirmative reply.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
