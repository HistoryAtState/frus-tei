    <text>
        <body>
            <div xml:id="d538">

                <pb facs="0536" n="526" sameAs="frus:frus1941v06/pg526"/>

                <note rend="inline" type="source">832.796/602: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Ambassador in
                        Brazil</hi> (<hi rendition="#italic">Caffery</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1941-11-05T00:00:00-05:00">November 5,
                        1941—midnight</date>.</dateline>
                </opener>
                <p>1096. Department’s 941, October 13, 10 p.m. and your 1556, October 22, 3
                        p.m.<anchor n="75" xml:id="d538-f1"/> Contract between Pan American Airways
                    and subsidiary of Reconstruction Finance Corporation to provide substitute
                    service for Lati has been signed.</p>
                <p>Copy is being sent you air mail. Please inform Harding.<anchor n="76"
                        xml:id="d538-f2"/></p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d538-f1" n="75" xml:id="d538-f1-content">
                <p>Latter not printed.</p>
            </note>
            <note corresp="#d538-f2" n="76" xml:id="d538-f2-content">
                <p>William Barclay Harding, vice president of the Defense Supplies Corporation.</p>
            </note>
        </listAnnotation>
    </standOff>
