            <div xml:id="d500">

                <pb facs="0504" n="494" sameAs="frus:frus1941v06/pg494"/>

                <note rend="inline" type="source">810.20 Defense/667<hi rendition="#superscript"
                        >2/6</hi>: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Brazil</hi> (<hi rendition="#italic"
                        >Caffery</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">Rio de
                                Janeiro</hi></placeName>, <date calendar="gregorian"
                            when="1941-04-18T22:00:00-03:00">April 18, 1941—10
                        p.m.</date><lb/>[Received April 19—10:46 a.m.]</dateline>
                </opener>
                <p>327. For the Under Secretary. Department’s 209, April 17, 8 p.m. Aranha says he
                    agrees.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Caffery</hi>
                    </signed>
                </closer>
            </div>
        </body>
