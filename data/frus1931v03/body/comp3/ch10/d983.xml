            <div xml:id="d983">

                <pb facs="1157" n="1047" sameAs="frus:frus1931v03/pg1047"/>

                <note rend="inline" type="source">800.79611 Pangborn-Herndon Flight/11:
                    Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Japan</hi> (<hi rendition="#italic">Forbes</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Tokyo</hi></placeName>, <date calendar="gregorian"
                            when="1931-04-13T13:00:00+09:00">April 13, 1931—1
                        p.m.</date><lb/>[Received April 13—5:17 a.m.]</dateline></opener>
                <p>51. Department’s 50, April 6 [<hi rendition="#italic">2</hi>], 7 p.m. Japanese
                    Government desires to know definitely route Pangborn plane will follow before
                    issuing permit.</p>
                <closer><signed><hi rendition="#small-caps">Forbes</hi></signed></closer>
            </div>
        </body>
    </text>
