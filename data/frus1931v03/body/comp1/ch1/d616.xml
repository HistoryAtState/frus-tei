                <pb facs="0784" n="674" xml:id="pg674"/>

                <note rend="inline" type="source">793.94/3157: Telegram</note>
                <head><hi rendition="#italic">The Chargé in France</hi> (<hi rendition="#italic"
                        >Shaw</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1931-12-11T01:00:00+00:00">December 11, 1931—1
                        a.m.</date><lb/>[Received December 10—9:52 p.m.]</dateline></opener>
                <p>876. From Ambassador Dawes: Resolution unanimously adopted at this afternoon’s
                    meeting of the Council.<anchor n="77" xml:id="d616-f1"/> [Dawes.]</p>
                <closer><signed><hi rendition="#small-caps">Shaw</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d616-f1" n="77" xml:id="d616-f1-content">
                <p>For text of the League Council’s resolution adopted December 10, see <ref
                        target="frus1931-41v01#pg_59"><hi rendition="#italic">Foreign
                        Relations</hi>, Japan, 1931–1941, vol. <hi rendition="#small-caps">i</hi>,
                        p. 59</ref>.</p>
