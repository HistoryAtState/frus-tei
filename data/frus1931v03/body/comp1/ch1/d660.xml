    <text>
        <body>
            <div xml:id="d660">

                <pb facs="0819" n="709" xml:id="pg709"/>

                <note rend="inline" type="source">793.94/3445</note>
                <head><hi rendition="#italic">The Chinese Chargé</hi> (<hi rendition="#italic"
                        >Yen</hi>) <hi rendition="#italic">to the Chief of the Division of Far
                        Eastern Affairs</hi> (<hi rendition="#italic">Hornbeck</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1931-12-29">December 29, 1931</date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Dr. Hornbeck</hi>: Dr. W. W. Yen wishes to
                    enclose to you for the information of the State Department three copies of a
                    cable which has just been received.</p>
                <p>Yours sincerely,</p>
                <closer><signed><hi rendition="#small-caps">Hawkling Yen</hi></signed></closer>


                <xi:include href="d660-a1.xml" xpointer="d660-a1"/>
