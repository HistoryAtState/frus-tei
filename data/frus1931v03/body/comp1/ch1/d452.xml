                <pb facs="0585" n="475" sameAs="frus:frus1931v03/pg475"/>

                <note rend="inline" type="source">793.94/2735: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">Johnson</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peiping</hi></placeName>, <date calendar="gregorian"
                            when="1931-11-18T18:00:00+08:00">November 18, 1931—6
                        p.m.</date><lb/>[Received November 18—9:10 a.m.]</dateline></opener>
                <p>959. Following from Mukden.</p>
                <quote rend="blockquote">
                    <p>“November 18, noon. Kwantung army headquarters announced that Japanese
                        offensive was launched on Nonni front at dawn today.”</p>
                </quote>
                <closer>For the Minister:<lb/><signed><hi rendition="#small-caps"
                        >Engert</hi></signed></closer>
            </div>
        </body>
