            <div xml:id="d666">

                <pb facs="0821" n="711" sameAs="frus:frus1931v03/pg711"/>

                <note rend="inline" type="source">793.94/3372</note>
                <head><hi rendition="#italic">The Appointed Chinese Minister</hi> (<hi rendition="#italic">W. W. Yen</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <p>The Chinese Minister presents his compliments to the Secretary of State and has
                    the honor to enclose herewith a copy of a telegram which has just been received,
                    for his information and consideration.</p>
                <closer><dateline rendition="#float-left"><placeName><hi rendition="#small-caps"
                                >Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1931-12-31">December 31,
                        1931</date>.</dateline></closer>



