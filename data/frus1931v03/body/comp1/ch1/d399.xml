                <pb facs="0541" n="431" sameAs="frus:frus1931v03/pg431"/>

                <note rend="inline" type="source">793.94/2711</note>
                <head><hi rendition="#italic">The Secretary to President Hoover</hi> (<hi rendition="#italic">Richey</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1931-11-12">November 12, 1931</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. Secretary</hi>: The President has directed
                    me to send you the enclosed copy of memorandum.</p>
                <p>Yours sincerely,</p>
                <closer><signed><hi rendition="#small-caps">Lawrence Richey</hi></signed></closer>


