                <pb facs="0758" n="648" sameAs="frus:frus1931v03/pg648"/>

                <note rend="inline" type="source">793.94/3133b: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Chargé in France</hi> (<hi rendition="#italic"
                            >Shaw</hi>)</head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1931-12-08T19:00:00-05:00">December 8, 1931—7
                        p.m.</date></dateline></opener>
                <p>636. For Ambassador Dawes: You will please keep in mind my suggestion for you to
                    endeavor to find out what possible action the Council members are contemplating
                    in the event of failure to obtain unanimous agreement on the resolution or if
                    Chinchow is attacked by the Japanese military.</p>
                <closer><signed><hi rendition="#small-caps">Stimson</hi></signed></closer>
            </div>
        </body>
    </text>
