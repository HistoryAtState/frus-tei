    <text>
        <body>
            <div xml:id="d361">

                <pb facs="0502" n="392" sameAs="frus:frus1931v03/pg392"/>

                <note rend="inline" type="source">793.94/2524: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >Johnson</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peiping</hi></placeName>, <date calendar="gregorian"
                            when="1931-11-07T18:00:00+08:00">November 7, 1931—6
                        p.m.</date><lb/>[Received November 7—10:45 a.m.]</dateline></opener>
                <p>885. Following from Mukden, November 7, 11 a.m.</p>
                <quote rend="blockquote">
                    <p>[“] Engagement on Nonni concluded by Japanese occupation of Chinese positions
                        and withdrawal of Chinese to the north. Japanese reported to be
                        strengthening position, forces consisting of 2,000.</p>
                    <p>Tenney<anchor n="72" xml:id="d361-f1"/> leaving for Harbin tonight.”</p>
                </quote>
                <p>Repeated to Shanghai.</p>
                <closer>For the Minister:<lb/><signed><hi rendition="#small-caps"
                        >Engert</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d361-f1" n="72" xml:id="d361-f1-content">
                <p>Capt. Parker G. Tenney, Assistant Military Attaché at Peiping.</p>
            </note>
        </listAnnotation>
    </standOff>
