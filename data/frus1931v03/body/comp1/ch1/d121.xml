                <pb facs="0222" n="112" sameAs="frus:frus1931v03/pg112"/>

                <note rend="inline" type="source">793.94/1979: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >Johnson</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peiping</hi></placeName>, <date calendar="gregorian"
                            when="1931-10-05T09:00:00+08:00">October 5, 1931—9
                        a.m.</date><lb/>[Received 11:50 a.m.]</dateline></opener>
                <p>702. Following from Mukden: <quote rend="blockquote">
                        <p>“October 3, 8 a.m. Japanese forces entered Chinese city of Newchwang at
                            2:15 this morning from Yingkou following bandit attack on the
                        city.”</p></quote></p>
                <closer><signed><hi rendition="#small-caps">Johnson</hi></signed></closer>
            </div>
        </body>
    </text>
