    <text>
        <body>
            <div xml:id="d214">

                <pb facs="0309" n="199" sameAs="frus:frus1931v03/pg199"/>

                <note rend="inline" type="source">793.94/2256</note>
                <head><hi rendition="#italic">The Chinese Ministry of Foreign
                            Affairs at Nanking to the Chinese
                            Legation</hi><anchor n="61" xml:id="d214-f1"/></head>
                <opener><dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Nanking</hi></placeName>,] <date calendar="gregorian"
                            when="1931-10-15">October 15, 1931</date>.</dateline></opener>
                <p>Please at once inform the State Department China welcomes most sincerely the
                    participation of an American representative in the deliberations of the Council
                    of the League concerning the Manchuria question.</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d214-f1" n="61" type="source" xml:id="d214-f1-content">
                <p>Copy of telegram handed by the Chinese Chargé to Mr. Ransford S. Miller of the
                    Division of Far Eastern Affairs on October 16, 1916.</p>
            </note>
        </listAnnotation>
    </standOff>
