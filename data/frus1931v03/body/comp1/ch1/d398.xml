    <text>
        <body>
            <div xml:id="d398">

                <pb facs="0541" n="431" sameAs="frus:frus1931v03/pg431"/>

                <note rend="inline" type="source">793.94/2624: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Ambassador in Japan</hi> (<hi rendition="#italic"
                            >Forbes</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1931-11-12T17:00:00-05:00">November 12, 1931—5
                        p.m.</date></dateline></opener>
                <p>224. Your 213, November 12, 10 a.m.<anchor n="10" xml:id="d398-f1"/> Provided
                    that invitation to visit Manchuria is accepted by Military Attachés of leading
                    powers, Department perceives no objection to our Military Attaché likewise
                    accepting.</p>
                <p>Inform Peiping of action taken.</p>
                <closer><signed><hi rendition="#small-caps">Stimson</hi></signed></closer>
            </div>
        </body>
    </text>
