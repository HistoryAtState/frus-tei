            <div xml:id="d43">

                <pb facs="0149" n="39" xml:id="pg39"/>

                <note rend="inline" type="source">793.94/1837: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >Johnson</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peiping</hi></placeName>, <date calendar="gregorian"
                            when="1931-09-23T13:00:00+08:00">September 23, 1931—1
                        p.m.</date><lb/>[Received September 23—9:05 a.m.]</dateline></opener>
                <p>631. Consul General, Harbin, telegraphs: <quote rend="blockquote">
                        <p>“September 22, 1 p.m. Chinese authorities have informed me that the
                            Chinese troops evacuated Kirin city night of September 21st and that
                            Japanese troops entered city this morning at 8 o’clock.”</p></quote></p>
                <closer><signed><hi rendition="#small-caps">Johnson</hi></signed></closer>
            </div>
        </body>
    </text>
