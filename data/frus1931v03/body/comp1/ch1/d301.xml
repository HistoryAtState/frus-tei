                <pb facs="0442" n="332" sameAs="frus:frus1931v03/pg332"/>

                <note rend="inline" type="source">793.94/2332: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Consul General at Nanking</hi> (<hi
                            rendition="#italic">Peck</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1931-10-27T18:00:00-05:00">October 27, 1931—6
                        p.m.</date></dateline></opener>
                <p>104. For the Minister: Your October 26, 10 a.m. Department approves your
                    proceeding to Shanghai as proposed.</p>
                <closer><signed><hi rendition="#small-caps">Stimson</hi></signed></closer>
            </div>
        </body>
    </text>
