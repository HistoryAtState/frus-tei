                <pb facs="0612" n="502" sameAs="frus:frus1931v03/pg502"/>

                <note rend="inline" type="source">793.94/2768: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">Johnson</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Nanking</hi></placeName>, <date calendar="gregorian"
                            when="1931-11-19T13:00:00+08:00">November 19, 1931—1
                        p.m.</date><lb/>[Received November 19—9 a.m.]</dateline></opener>
                <p>Your 113, November 17, 7 p.m., to Nanking. No further action at present appears
                    necessary in the matter of investigation into causes of trouble at Tientsin.</p>
                <closer><signed><hi rendition="#small-caps">Johnson</hi></signed></closer>
            </div>
        </body>
