    <text>
        <body>
            <div xml:id="d15">

                <pb facs="0124" n="14" sameAs="frus:frus1931v03/pg14"/>

                <note rend="inline" type="source">793.94/1799: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">Johnson</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peiping</hi></placeName>, <date calendar="gregorian"
                            when="1931-09-19T20:00:00+08:00">September 19, 1931—8
                        p.m.</date><lb/>[Received September 19—10:10 a.m.]</dateline></opener>
                <p>606. Following telegram has been received from Langdon<anchor n="22"
                        xml:id="d15-f1"/> at Dairen.</p>
                <quote rend="blockquote">
                    <p>“September 19, 2 p.m. Consul at Mukden telephones for repetition to you that
                        Japanese took over whole of Mukden at 1 a.m., this morning; they have also
                        occupied Changchun, Antung and Newchwang and are running public services at
                        all these places. Foreigners are all safe.”</p></quote>
                <closer><signed><hi rendition="#small-caps">Johnson</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d15-f1" n="22" xml:id="d15-f1-content">
                <p>William R. Langdon, Consul at Dairen.</p>
            </note>
        </listAnnotation>
    </standOff>
