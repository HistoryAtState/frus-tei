            <div xml:id="d88">

                <pb facs="0194" n="84" sameAs="frus:frus1931v03/pg84"/>

                <note rend="inline" type="source">793.94/1904: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Consul General at
                        Nanking</hi> (<hi rendition="#italic">Peck</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1931-09-28T18:00:00-05:00">September 28, 1931—6
                        p.m.</date></dateline></opener>
                <p>80. Please deliver to Minister for Foreign Affairs as from me the following
                    message: <quote rend="blockquote">
                        <p>“Reports of attack on you have shocked me and I hasten to express my
                            earnest hope for your speedy recovery.”</p></quote></p>
                <closer><signed><hi rendition="#small-caps">Stimson</hi></signed></closer>
            </div>
        </body>
    </text>
