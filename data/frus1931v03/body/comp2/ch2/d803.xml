    <text>
        <body>
            <div xml:id="d803">

                <pb facs="0992" n="882" sameAs="frus:frus1931v03/pg882"/>

                <note rend="inline" type="source">793.003/736: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Consul General at
                        Shanghai</hi> (<hi rendition="#italic">Cunningham</hi>)</head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1931-06-22T18:00:00-04:00">June 22, 1931—6
                    p.m.</date></dateline></opener>
                <p>For the Minister: Your June 20, 3 p.m., from Shanghai, paragraph (3) concerning
                    your plans.<anchor n="76" xml:id="d803-f1"/></p>
                <p>If C. T. Wang appears satisfied, the Department authorizes you to return to
                    Peiping on June 26, but prior to your departure your comments are desired as
                    requested in Department’s June 16, 5 p.m., to Shanghai, paragraph (5).</p>
                <closer><signed><hi rendition="#small-caps">Stimson</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d803-f1" n="76" xml:id="d803-f1-content">
                <p>Telegram not printed; par. 3 contained the Minister’s request for authorization
                    to leave for Peiping on June 26.</p>
            </note>
        </listAnnotation>
    </standOff>
