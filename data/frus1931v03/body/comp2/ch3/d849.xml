    <text>
        <body>
            <div xml:id="d849">

                <pb facs="1047" n="937" sameAs="frus:frus1931v03/pg937"/>

                <note rend="inline" type="source">893.00/11356: Telegram</note>
                <head><hi rendition="#italic">The Consul General at Hankow</hi> (<hi rendition="#italic">Lockhart</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Hankow</hi></placeName>, <date calendar="gregorian"
                            when="1931-02-02T16:00:00+08:00">February 2, 1931—4
                        p.m.</date><lb/>[Received February 2—9:25 a.m.]</dateline></opener>
                <p>8. The following telegram has been sent to the Legation: <quote rend="blockquote">
                        <p>“February 2, 3 p.m. <hi rendition="#italic">Panay</hi><anchor n="10"
                                xml:id="d849-f1"/> and S. S. <hi rendition="#italic">Ichang</hi>, of
                            Yangtze Rapid Company fired upon at Temple Hill January 30. <hi
                                rendition="#italic">Panay</hi> returned fire with 11 rounds 3-inch
                            shells. No casualties on <hi rendition="#italic">Panay</hi> or
                            steamship. Repeated to Department.”</p>
                    </quote></p>
                <closer><signed><hi rendition="#small-caps">Lockhart</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d849-f1" n="10" xml:id="d849-f1-content">
                <p>U. S. river gunboat of the Yangtze patrol.</p>
            </note>
        </listAnnotation>
    </standOff>
