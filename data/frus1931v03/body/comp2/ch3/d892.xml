    <text>
        <body>
            <div xml:id="d892">

                <pb facs="1081" n="971" sameAs="frus:frus1931v03/pg971"/>

                <note rend="inline" type="source">393.1163/520</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >Johnson</hi>) <hi rendition="#italic">to the Consul General at Nanking</hi>
                        (<hi rendition="#italic">Peck</hi>)<anchor n="67" xml:id="d892-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peiping</hi></placeName>, <date calendar="gregorian"
                            when="1931-07-31">July 31, 1931</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: You are requested to arrange for an
                    interview with the Minister for Foreign Affairs, or the official acting for him,
                    and to hand to <pb facs="1082" n="972" xml:id="pg972"/> him the enclosed <hi
                        rendition="#italic">Aide-Mémoire</hi>, bringing orally to his attention the
                    serious nature of the complaint and reserving all rights, on behalf of the
                    missions concerned, to present claims for damages suffered at the hands of
                    government troops.</p>
                <p>Very truly yours,</p>
                <closer>For the Minister:<lb/><signed>C. <hi rendition="#small-caps">Van H.
                            Engert</hi></signed><lb/><hi rendition="#italic">First Secretary of
                        Legation</hi></closer>


                <xi:include href="d892-a1.xml" xpointer="d892-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d892-f1" n="67" type="source" xml:id="d892-f1-content">
                <p>Copy transmitted to the Department by the Minister in his despatch No. 1106, July
                    31; received August 29.</p>
            </note>
        </listAnnotation>
    </standOff>
