                <pb facs="1085" n="975" sameAs="frus:frus1931v03/pg975"/>

                <note rend="inline" type="source">393.1111 Nelson, Bert N./130: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Consul General at
                        Nanking</hi> (<hi rendition="#italic">Peck</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1931-10-17T11:00:00-05:00">October 17, 1931—11
                        a.m.</date></dateline></opener>
                <p>94. For the Minister: Department suggests that you at your discretion upon some
                    appropriate occasion may find it convenient to mention to the Ministry of
                    Foreign Affairs the case of the long continued captivity of Bert N. Nelson.</p>
                <closer><signed><hi rendition="#small-caps">Stimson</hi></signed></closer>
            </div>
        </body>
