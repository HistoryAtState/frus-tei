                <head>No. 287.<lb/><hi rendition="#italic">Mr. Walker to Mr. Bayard.</hi></head>
                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Bogotá</hi></placeName>, <date calendar="gregorian"
                            when="1888-06-21"><hi rendition="#italic">June</hi> 21, 1888</date>.
                        (Received July 21.)</dateline>
                    <seg rendition="#float-left">No. 122.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit you the inclosed translation of
                    a law passed a few days ago by the national legislative council.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Jno. G.
                            Walker.</hi></signed></closer>


                <xi:include href="d287-a1.xml" xpointer="d287-a1"/>
