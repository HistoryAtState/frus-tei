                <pb facs="0384" n="250" sameAs="frus:frus1888p1/pg250"/>

                <head>No. 167.<lb/><hi rendition="#italic">Mr. Denby to Mr. Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1888-01-26"><hi rendition="#italic">January</hi> 26, 1888</date>.
                        (Received March 17.)</dateline>
                    <seg rendition="#float-left">No. 553.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a copy
                    of my communication to the Yamên on the subject of the obstruction in the Canton
                    River.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charles
                        Denby.</hi></signed></closer>


                <xi:include href="d167-a1.xml" xpointer="d167-a1"/>
