    <text>
        <body>
            <div xml:id="d193">

                <pb facs="0418" n="284" sameAs="frus:frus1888p1/pg284"/>

                <head>No. 193.<lb/><hi rendition="#italic">Mr. Denby to Mr. Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1888-03-28"><hi rendition="#italic">March</hi> 28, 1888</date>.
                        (Received May 5.)</dateline>
                    <seg rendition="#float-left">No. 605.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith a copy of a recent
                    decree issued by the Emperor.</p>
                <p>I send it as a specimen of elevated Chinese composition. It exhibits commendable
                    sentiments and is evidently intended to quiet the popular mind, which has been
                    growing restive over recent expenditures.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charles Denby.</hi></signed></closer>


                <xi:include href="d193-a1.xml" xpointer="d193-a1"/>
            </div>
