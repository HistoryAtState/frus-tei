                <pb facs="0447" n="313" sameAs="frus:frus1888p1/pg313"/>

                <head>No. 216.<lb/><hi rendition="#italic">Mr. Denby to Mr. Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Pekin</hi></placeName>, <date calendar="gregorian"
                            when="1888-06-25"><hi rendition="#italic">June</hi> 25, 1888</date>.
                        (Received August 20.)</dateline>
                    <seg rendition="#float-left">No. 651.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I now have the honor to transmit herewith
                    the English text of the treaty between Portugal and China and convention
                    appended thereto.</p>
                <p>I have the honor, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charles
                        Denby.</hi></signed></closer>



