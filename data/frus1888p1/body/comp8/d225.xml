            <div xml:id="d225">

                <pb facs="0474" n="340" sameAs="frus:frus1888p1/pg340"/>

                <head>No. 225.<lb/><hi rendition="#italic">Mr. Denby to Mr. Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1888-07-30"><hi rendition="#italic">July</hi> 30, 1888</date>.
                        (Received September 11.)</dateline>
                    <seg rendition="#float-left">No. 678.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose a translation
                    of an edict recently promulgated by the Empress Regent, having relation to her
                    retirement as director of the Government, after the marriage of the Emperor,
                    which will be celebrated some time during the month of February next.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charles
                        Denby.</hi></signed></closer>


                <xi:include href="d225-a1.xml" xpointer="d225-a1"/>
