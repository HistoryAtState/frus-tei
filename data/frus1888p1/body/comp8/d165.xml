                <pb facs="0380" n="246" sameAs="frus:frus1888p1/pg246"/>

                <head>No. 165.<lb/><hi rendition="#italic">Mr. Denby to Mr. Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1888-01-17"><hi rendition="#italic">January</hi> 17, 1888</date>.
                        (Received March 17.)</dateline>
                    <seg rendition="#float-left">No. 548.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to forward to you,
                    herewith, a clipping from the North China Daily News giving the provisional
                    regulations published by the Chinese maritime customs for the bonding of
                    goods.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charles Denby.</hi></signed></closer>


                <xi:include href="d165-a1.xml" xpointer="d165-a1"/>
            </div>
