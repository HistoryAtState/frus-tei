    <text>
        <body>
            <div xml:id="d185">

                <pb facs="0404" n="270" xml:id="pg270"/>

                <head>No. 185.<lb/><hi rendition="#italic">Mr. Denby to Mr. Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1888-03-19"><hi rendition="#italic">March</hi> 19, 1888</date>.
                        (Received May 5.)</dateline>
                    <seg rendition="#float-left">No. 593.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to report that the
                    Tsung-li Yamên has agreed to instruct the governor of Formosa to cease the
                    imposition of lekin on native produce, the property of foreigners, within any
                    open port or while in transit from such port to the place of shipment.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charles Denby.</hi></signed></closer>
            </div>
        </body>
