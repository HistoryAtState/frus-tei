    <text>
        <body>
            <div xml:id="d227">

                <pb facs="0476" n="342" sameAs="frus:frus1888p1/pg342"/>

                <head>No. 227.<lb/><hi rendition="#italic">Mr. Denby to Mr. Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1888-08-07"><hi rendition="#italic">August</hi> 7, 1888</date>.
                        (Received September 20.)</dateline>
                    <seg rendition="#float-left">No.682.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a
                    translation of a memorial from the governor of Shantung, covering a set of
                    regulations for the protection and salvage of vessels on the coast of that
                    province.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charles Denby.</hi></signed></closer>



                <xi:include href="d227-a1.xml" xpointer="d227-a1"/>
