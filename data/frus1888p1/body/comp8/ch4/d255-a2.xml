    <text>
        <body>
            <div xml:id="d255-a2">

                <pb facs="0526" n="392" sameAs="frus:frus1888p1/pg392"/>

                <opener><seg rendition="#center">[Inclosure 2.]</seg></opener>
                <head><hi rendition="#small-caps">statement as to claims for uncollected
                    debts</hi>.</head>
                <table cols="2" rows="11">
                    <row>
                        <cell>These only appear in the Seattle claims (see note February 19,
                            1887).</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell>The first on the list is the claim of Wa Chong &amp; Co. for
                            $67,042.10. In examining the detailed items on file in the Chinese
                            legation there appears of this sum for uncollected debts</cell>
                        <cell rendition="#bottom" role="num">$17,042.14</cell>
                    </row>
                    <row>
                        <cell>The others in the list as follows:</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell>Tong yu Chong</cell>
                        <cell rendition="#bottom" role="num">8,477.95</cell>
                    </row>
                    <row>
                        <cell>Kwong Chong</cell>
                        <cell rendition="#bottom" role="num">2,568.91</cell>
                    </row>
                    <row>
                        <cell>OnTai</cell>
                        <cell rendition="#bottom" role="num">2,797.25</cell>
                    </row>
                    <row>
                        <cell>Hong Fong Low</cell>
                        <cell rendition="#bottom" role="num">1,489.70</cell>
                    </row>
                    <row>
                        <cell>Yeong Kee</cell>
                        <cell rendition="#bottom" role="num">333.10</cell>
                    </row>
                    <row>
                        <cell>Kow Kee</cell>
                        <cell rendition="#bottom" role="num">428.55</cell>
                    </row>
                    <row>
                        <cell>Sory Woh (total of this claim is $5,321.35. Deduct losses in goods,
                            $3.121.35)</cell>
                        <cell rendition="#bottom #border-bottom" role="num">2,200.00</cell>
                    </row>
                    <row>
                        <cell>Total for uncollected debts</cell>
                        <cell rendition="#bottom" role="num">35,337.60</cell>
                    </row>
                </table>
            </div>
        </body>
