    <text>
        <body>
            <div xml:id="d198">

                <pb facs="0425" n="291" sameAs="frus:frus1888p1/pg291"/>

                <head>No. 198.<lb/><hi rendition="#italic">Mr. Bayard to Mr. Denby.</hi></head>
                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1888-04-10"><hi rendition="#italic">April</hi> 10,
                        1888</date>.</dateline>
                    <seg rendition="#float-left">No. 304.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I acknowledge the receipt of your No. 541,
                    of January 10, 1888, and inclose, for your information, a copy of a dispatch
                    from Mr. Adamson, consul-general of the United States at Panama (to whom a copy
                    of your dispatch was transmitted for report), No. 369, of the 21st ultimo, <pb
                        facs="0426" n="292" xml:id="pg292"/> saying that no Chinese laborers were
                    ever conveyed by a French Government transport from Hanoi, in Tonquin or China,
                    to Panama.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. F.
                        Bayard.</hi></signed></closer>


                <xi:include href="d198-a1.xml" xpointer="d198-a1"/>
            </div>
