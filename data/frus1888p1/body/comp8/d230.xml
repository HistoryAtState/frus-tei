    <text>
        <body>
            <div xml:id="d230">

                <pb facs="0481" n="347" sameAs="frus:frus1888p1/pg347"/>

                <head>No. 230.<lb/><hi rendition="#italic">Mr. Bayard to Mr. Denby.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1888-08-18"><hi rendition="#italic">August</hi> 18,
                        1888</date>.</dateline>
                    <seg rendition="#float-left">No. 343.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I herewith transmit, for your information,
                    a copy of my note<anchor n="*" xml:id="d230-f1"/> to the minister of Germany at
                    this capital, dated the 17th instant, accompanied <pb facs="0482" n="348"
                        xml:id="pg348"/> by a memorandum embodying the Department’s views touching
                    the validity of marriages in China between subjects of that Empire and
                    foreigners.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. F.
                        Bayard.</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d230-f1" n="*" xml:id="d230-f1-content">
                <p>Mr. Bayard to Count Arco Valley, August 17, 1888, with inclosures, printed as
