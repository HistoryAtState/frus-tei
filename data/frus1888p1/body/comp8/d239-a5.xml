    <text>
        <body>
            <div xml:id="d239-a5">

                <pb facs="0494" n="360" sameAs="frus:frus1888p1/pg360"/>

                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps">In
                                the Senate of the United States</hi></placeName>,<lb/><date
                            calendar="gregorian" when="1888-09-11"><hi rendition="#italic"
                                >September</hi> 11, 1888</date>.</dateline></opener>
                <p><hi rendition="#italic">Resolved</hi>, That the President be requested, if not
                    incompatible with the public interest, to transmit to the Senate as early as
                    convenient all correspondence or communications by and with the Government of
                    the United States concerning the treaty with China recently ratified by the
                    Senate, including all communications which have passed between the State
                    Department and our minister to China or any other representative or agent of the
                    United States in China or elsewhere with reference to said treaty.</p>
                <closer>Attest:<lb/><signed><hi rendition="#small-caps">Anson G.
                                McCook</hi>,<lb/><hi rendition="#italic"
                        >Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
