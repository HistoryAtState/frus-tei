    <text>
        <body>
            <div xml:id="d430-a4">

                <pb facs="0717" n="583" sameAs="frus:frus1888p1/pg583"/>

                <p rendition="#flush"><hi rendition="#small-caps">Office of the Clerk of the
                        Superior Court</hi>,<lb/><hi rendition="#italic">City and County of San
                        Francisco, State of California:</hi></p>
                <p>I, William J. Ruddick, county clerk and. <hi rendition="#italic">ex officio</hi>
                    clerk of the superior court in and for the city and county of San Francisco,
                    State of California, said court being a court of record having common law
                    jurisdiction and a clerk and seal, do certify that the above is a true copy of
                    the act of naturalization of Hans Jacobsen as the same appears upon the records
                    of said court now in my office.</p>
                <closer>
                    <dateline rendition="#float-left">In testimony whereof I have hereunto set my
                        hand and affixed the seal of said court <date calendar="gregorian"
                            when="1887-10-28">this 28th day of October, in the year of our Lord
                            1887, and in the year of our Independence the 112th</date>.</dateline>
                    <lb/> [<hi rendition="#small-caps">seal.</hi>] <signed><hi
                            rendition="#small-caps">William J. Ruddick</hi>,<lb/><hi
                            rendition="#italic">Clerk</hi></signed>,<lb/>By <signed><hi
                            rendition="#small-caps">J. D. Wiseman</hi>,<lb/><hi rendition="#italic"
                            >Deputy Clerk.</hi></signed></closer>
            </div>
        </body>
    </text>
