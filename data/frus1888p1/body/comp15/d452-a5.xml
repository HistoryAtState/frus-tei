    <text>
        <body>
            <div xml:id="d452-a5">

                <pb facs="0760" n="626" sameAs="frus:frus1888p1/pg626"/>

                <opener><seg rendition="#center">[Inclosure 12 in No. 595.]</seg></opener>
                <head><hi rendition="#italic">Mr. Honey to Mr.
                            Pendleton.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><date calendar="gregorian"
                            when="1888-02-01"><hi rendition="#small-caps">February</hi> 1,
                            1888</date>.</dateline></opener>
                <p>Frankfort officials seizing wife’s furniture for taxes. Please protect her
                    pending investigation.</p>
                <closer><signed><hi rendition="#small-caps">Honey</hi>,<lb/><hi
                                rendition="#italic"
                    >Lieutenant-Governor.</hi></signed></closer>
            </div>
        </body>
    </text>
