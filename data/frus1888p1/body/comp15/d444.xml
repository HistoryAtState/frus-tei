                <pb facs="0747" n="613" sameAs="frus:frus1888p1/pg613"/>

                <head>No. 444.<lb/><hi rendition="#italic">Mr. Pendleton to Mr. Bayard.</hi></head>
                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Berlin</hi></placeName>, <date calendar="gregorian"
                            when="1888-02-07"><hi rendition="#italic">February</hi> 7, 1888</date>.
                        (Received February 25.)</dateline>
                    <seg rendition="#float-left">No. 578.</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: This morning I handed to Count Bismarck,
                    the Imperial secretary of state for foreign affairs the copy of the instruction
                    in regard to Samoan affairs, No. 280, which you sent me under date of January
                    17, 1888.</p>
                <p>1 have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Geo. H.
                    Pendleton.</hi></signed></closer>
            </div>
        </body>
