    <text>
        <body>
            <div xml:id="d476">

                <pb facs="0794" n="660" xml:id="pg660"/>

                <head>No. 476.<lb/><hi rendition="#italic">Mr. Rives to Mr. Pendleton.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1888-10-20"><hi rendition="#italic">October</hi> 20,
                        1888</date>.</dateline>
                    <seg rendition="#float-left">No. 371.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your dispatch No. 675, of the 4th instant,
                    stating that the assessment of a communal income tax on Mr. S. K. Honey has been
                    discontinued and that the amounts already paid are to be refunded, has been
                    received and read with satisfaction.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">G. L. Rives</hi>,<lb/><hi
                                rendition="#italic">Acting
                    Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
