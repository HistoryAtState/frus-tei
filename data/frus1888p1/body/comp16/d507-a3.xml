                <pb facs="0832" n="698" sameAs="frus:frus1888p1/pg698"/>

                <opener><seg rendition="#center">[Inclosure 3 in No. 673.]</seg></opener>
                <head><hi rendition="#italic">Mr. Phelps to Lord
                            Salisbury.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1888-02-03"><hi rendition="#italic">February</hi> 3,
                        1888</date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Lord</hi>: I am instructed by my Government to
                    express to your lordship the satisfaction it has felt with the prompt and
                    effectual interposition of Her Majesty’s Government in the matter of certain
                    American fishing vessels at Halifax, mentioned in my note to your lordship of
                    February 1, and in Sir Julian Pauncefote’s note of the same date, in reply.</p>
                <p>And I have the honor to be, etc.,</p>
                <closer><signed><hi rendition="#small-caps">E. J.
                        Phelps.</hi></signed></closer>
            </div>
        </body>
    </text>
