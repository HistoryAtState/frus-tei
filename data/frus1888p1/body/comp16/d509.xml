    <text>
        <body>
            <div xml:id="d509">

                <pb facs="0838" n="702" sameAs="frus:frus1888p1/pg702"/>

                <head>No. 509.<lb/><hi rendition="#italic">Mr. Bayard to Mr. Phelps.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1888-02-21"><hi rendition="#italic">February</hi> 21,
                        1888</date>.</dateline>
                    <seg rendition="#float-left">No. 798]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to previous correspondence
                    concerning the boundary question pending between Great Britain and Venezuela, I
                    now inclose herewith for your confidential information a copy of my note of the
                    18th instant to Mr. Olavarria on the subject, and a translation of his reply
                    thereto of the 20th instant.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. F. Bayard.</hi></signed></closer>



                <xi:include href="d509-a1.xml" xpointer="d509-a1"/>
