    <text>
        <body>
            <div xml:id="d502">

                <pb facs="0822" n="688" sameAs="frus:frus1888p1/pg688"/>

                <head>No. 502.<lb/><hi rendition="#italic">Mr. Phelps to Mr. Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1888-01-04"><hi rendition="#italic">January</hi> 4, 1888</date>.
                        (Received January 17.)</dateline>
                    <seg rendition="#float-left">No. 651.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to your instructions numbered 730
                    of the 18th November, 1887,<anchor n="*" xml:id="d502-f1"/> I have the honor to
                    inclose herewith a copy of a note received from the foreign office in reply to
                    one which I addressed to Lord Salisbury in accordance with the instructions
                    above referred to.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">E. J. Phelps.</hi></signed></closer>


                <xi:include href="d502-a1.xml" xpointer="d502-a1"/>
            </div>
        </body>
    </text>
