    <text>
        <body>
            <div xml:id="d554">

                <pb facs="0922" n="786" sameAs="frus:frus1888p1/pg786"/>

                <head>No. 554.<lb/><hi rendition="#italic">Sir L. S. Sackville
                            West to Mr. Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1888-02-14"><hi rendition="#italic">February</hi> 14, 1888</date>.
                        (Received February 17.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose to you herewith
                    a statement of certain facts connected with the sale of a British vessel to
                    parties in the United States and in view thereof to inquire whether it would be
                        <pb facs="0923" n="787" xml:id="pg787"/> possible for the United States
                    Government to adopt any measures for preventing vessels apparently sold to and
                    owned by citizens of the United States from continuing to sail under the British
                    flag.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">L. S. Sackville
                            West.</hi></signed></closer>


                <xi:include href="d554-a1.xml" xpointer="d554-a1"/>
            </div>
        </body>
    </text>
