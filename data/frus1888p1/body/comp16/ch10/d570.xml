    <text>
        <body>
            <div xml:id="d570">

                <pb facs="0934" n="798" sameAs="frus:frus1888p1/pg798"/>

                <head>No. 570.<lb/><hi rendition="#italic">Sir L. S. Sackville West to Mr.
                        Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1888-04-12"><hi rendition="#italic">April</hi> 12, 1888</date>.
                        (Received April 13.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>; I have the honor to communicate to you
                    herewith the inclosed copy of a minute in council, which was passed on the 4th
                    instant by the privy council of Canada, authorizing the addition to the free
                    list of the articles therein specified.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">L. S. Sackville
                    West.</hi></signed></closer>


                <xi:include href="d570-a1.xml" xpointer="d570-a1"/>
            </div>
