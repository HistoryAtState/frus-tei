    <text>
        <body>
            <div xml:id="d594">

                <pb facs="0960" n="824" sameAs="frus:frus1888p1/pg824"/>

                <head>No. 594.<lb/><hi rendition="#italic">Sir L. S. Sackville
                            West to Mr. Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Beverly, Mass.</hi></placeName>, <date calendar="gregorian"
                            when="1888-08-13"><hi rendition="#italic">August</hi> 13, 1888</date>.
                        (Received August 16.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to communicate to you
                    herewith copy of an approved minute of the privy council of Canada relative to
                    the tolls <pb facs="0961" n="825" xml:id="pg825"/> levied by the Dominion
                    authorities on vessels passing through the Welland canal.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">L. S. Sackville
                            West.</hi></signed></closer>


                <xi:include href="d594-a1.xml" xpointer="d594-a1"/>
