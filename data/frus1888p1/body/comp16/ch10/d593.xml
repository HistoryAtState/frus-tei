    <text>
        <body>
            <div xml:id="d593">

                <pb facs="0960" n="824" sameAs="frus:frus1888p1/pg824"/>

                <head>No. 593.<lb/><hi rendition="#italic">Sir L. S. Sackville West to Mr.
                        Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Beverly, Mass.</hi></placeName>, <date calendar="gregorian"
                            when="1888-08-13"><hi rendition="#small-caps">August</hi> 13,
                            1888</date>. (Received August 15.)</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. Bayard</hi>: With reference to your private
                    communication on the question of rendering aid to vessels wrecked in the waters
                    lying between the United States and Canada, I inclose extract from a committee
                    of the privy council thereupon.</p>
                <p>Yours, etc.,</p>
                <closer><signed><hi rendition="#small-caps">L. S. Sackville
                    West.</hi></signed></closer>


                <xi:include href="d593-a1.xml" xpointer="d593-a1"/>
