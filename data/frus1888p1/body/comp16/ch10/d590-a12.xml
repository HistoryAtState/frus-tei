    <text>
        <body>
            <div xml:id="d590-a12">

                <pb facs="0959" n="823" xml:id="pg823"/>

                <opener><seg rendition="#center">[Inclosure 12.]</seg></opener>
                <head><hi rendition="#italic">The Marquis of Salisbury to
                        Mr. Edwardes.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Foreign Office</hi></placeName>, <date calendar="gregorian"
                            when="1888-06-22"><hi rendition="#italic">June</hi> 22,
                        1888</date>.</dateline>
                    <seg rendition="#float-left">No. 159.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I approve the note to the United States
                    Government respecting the alleged violation of the Newfoundland bait act by the
                    United States fishermen, of which a copy accompanied your dispatch No. 207, of
                    the 7th instant.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps"
                        >Salisbury.</hi></signed></closer>
            </div>
        </body>
    </text>
