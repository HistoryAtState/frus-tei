    <text>
        <body>
            <div xml:id="d579">

                <pb facs="0944" n="808" sameAs="frus:frus1888p1/pg808"/>

                <head>No. 579.<lb/><hi rendition="#italic">Sir L. S. Sackville West to Mr.
                        Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1888-05-30"><hi rendition="#italic">May</hi> 30, 1888</date>.
                        (Received May 31.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I am instructed by the Marquis of Salisbury
                    to communicate to you the inclosed form of license which the Dominion Government
                    proposes to issue for American fishing vessels under the <hi rendition="#italic"
                        >modus vivendi</hi>, which has been put in operation.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">L. S. Sackville
                    West.</hi></signed></closer>


                <xi:include href="d579-a1.xml" xpointer="d579-a1"/>
