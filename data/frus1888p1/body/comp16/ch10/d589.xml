    <text>
        <body>
            <div xml:id="d589">

                <pb facs="0950" n="814" sameAs="frus:frus1888p1/pg814"/>

                <head>No. 589.<lb/><hi rendition="#italic">Sir L. S. Sackville West to Mr.
                        Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1888-07-31"><hi rendition="#italic">July</hi> 31, 1888</date>.
                        (Received August 2.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of 23d instant, and to inform you that I have brought the alleged
                    discrimination against American vessels passing through the Welland Canal to the
                    notice of the Canadian Government.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">L. S. Sackville
                    West.</hi></signed></closer>
            </div>
        </body>
    </text>
