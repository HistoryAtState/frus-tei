    <text>
        <body>
            <div xml:id="d538-a7">

                <pb facs="0892" n="756" xml:id="pg756"/>

                <opener><seg rendition="#center">[Inclosure 7 in No.
                    973.—Translation.]</seg></opener>
                <head><hi rendition="#italic">Proclamation of Samoan Chiefs.</hi></head>
                <p rendition="#center"><hi rendition="#small-caps">attention, all men.</hi></p>
                <p>We have crowned this day, the 9th of September, 1888, at 10 o’clock in the
                    morning, Malietoa, To’oa Mataafa, as King of Samoa.</p>
                <p>There were present <hi rendition="#small-caps">Tumua</hi>, and <hi
                        rendition="#small-caps">Pule</hi>, and <hi rendition="#small-caps"
                    >Aiga</hi>.</p>
                <p>We are,</p>
                <closer><signed><hi rendition="#small-caps">Tumua</hi> and <hi
                            rendition="#small-caps">Pule</hi> and <hi rendition="#small-caps"
                            >Aiga.</hi></signed>
                    <lb/>
                    <dateline rendition="#float-left">Capital of Samoa at
                            <placeName>Faleula</placeName>, <date calendar="gregorian"
                            when="1888-09-09">September 9, 1888</date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
