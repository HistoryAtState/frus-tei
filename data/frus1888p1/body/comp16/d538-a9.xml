    <text>
        <body>
            <div xml:id="d538-a9">

                <pb facs="0892" n="756" sameAs="frus:frus1888p1/pg756"/>

                <opener><seg rendition="#center">[Inclosure 9 in No. 973.]</seg></opener>
                <head><hi rendition="#italic">Mr. Blacklock to Mr.
                            Becker.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Consulate-General of the United States</hi>,<lb/><hi
                                rendition="#italic">Apia, Samoa</hi></placeName>, <date
                            calendar="gregorian" when="1888-09-10"><hi rendition="#italic"
                                >September</hi> 10, 1888</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your notification of this morning’s date
                    with reference to armed mobs and the landing of troops from H. I. G. M.’s S. <hi
                        rendition="#italic">Adler</hi> received.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. Blacklock</hi>,<lb/><hi
                                rendition="#italic">U. S.
                        Vice-Consul-General.</hi></signed></closer>
            </div>
        </body>
