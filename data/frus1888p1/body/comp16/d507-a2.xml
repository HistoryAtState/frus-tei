    <text>
        <body>
            <div xml:id="d507-a2">

                <pb facs="0832" n="698" sameAs="frus:frus1888p1/pg698"/>

                <opener><seg rendition="#center">[Inclosure 2 in No. 673.]</seg></opener>
                <head><hi rendition="#italic">Sir J. Pauncefote to Mr. Phelps</hi>.</head>
                <opener><seg rendition="#center">[Immediate.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Foreign Office</hi></placeName>, <date calendar="gregorian"
                            when="1888-02-01"><hi rendition="#italic">February</hi> 1,
                        1888</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your letter this day, relating to the refusal by the Canadian authorities at
                    Halifax to permit two American vessels with fresh fish on board to land their
                    cargoes at that port.</p>
                <p>I beg leave to assure you, in reply, that this matter shall receive immediate
                    attention.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">J. Pauncefote</hi>.</signed><lb/>(For
                    the Marquis of Salisbury.)</closer>
            </div>
        </body>
    </text>
