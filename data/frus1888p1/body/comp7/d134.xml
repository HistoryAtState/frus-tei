                <pb facs="0315" n="181" sameAs="frus:frus1888p1/pg181"/>

                <head>No. 134.<lb/><hi rendition="#italic">Mr. Roberts to Mr. Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Santiago</hi></placeName>, <date calendar="gregorian"
                            when="1888-01-06"><hi rendition="#italic">January</hi> 6, 1888</date>.
                        (Received February 25.)</dateline>
                    <seg rendition="#float-left">No. 171.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose translation of
                    protocol for the settlement of French claims against Chili, amounting to about
                    $3,400,000.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">William R.
                    Roberts.</hi></signed></closer>


                <xi:include href="d134-a1.xml" xpointer="d134-a1"/>
