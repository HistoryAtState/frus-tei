    <text>
        <body>
            <div xml:id="d692">

                <pb facs="1120" n="984" xml:id="pg984"/>

                <head>No. 690.<lb/><hi rendition="#italic">Mr. Rives to Mr. Thompson.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1888-12-03"><hi rendition="#italic">December</hi> 3,
                        1888</date>.</dateline>
                    <seg rendition="#float-left">No. 57.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    dispatch of the 19th ultimo, No. 116, and to approve your action, reported
                    therein, in sending home the crew of the captured steamer <hi
                        rendition="#italic">Haytian Republic</hi>.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">G. L. Rives</hi>,<lb/><hi
                                rendition="#italic">Assistant
                    Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
