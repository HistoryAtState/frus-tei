                <pb facs="1078" n="942" sameAs="frus:frus1888p1/pg942"/>

                <head>No. 673.<lb/><hi rendition="#italic">Mr. Bayard to Mr. Thompson.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1888-11-10"><hi rendition="#italic">November</hi> 10,
                        1888</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Thompson</hi>, <hi rendition="#italic"
                    >Minister:</hi></p>
                <p>Your 217 received. Carefully avoid taking sides in domestic strifes in Hayti, and
                    consult freely with commander of the <hi rendition="#italic">Boston</hi> for
                    protection of American interests.</p>
                <closer><signed><hi rendition="#small-caps">Bayard.</hi></signed></closer>
            </div>
        </body>
