        <body>
            <div xml:id="d651">

                <pb facs="1040" n="904" sameAs="frus:frus1888p1/pg904"/>

                <head>No. 651.<lb/><hi rendition="#italic">Mr. Bayard to Mr. Thompson.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1888-08-16"><hi rendition="#italic">August</hi> 16,
                        1888</date>.</dateline>
                    <seg rendition="#float-left">No. 120.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your telegram of the 10th instant, having
                    been made known to the Naval Department, the Secretary of the Navy has ordered
                    the <hi rendition="#italic">Galena</hi> to Haytian waters. I transmit a copy of
                    his letter on the subject.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. F. Bayard.</hi></signed></closer>


                <xi:include href="d651-a1.xml" xpointer="d651-a1"/>
