                <pb facs="1038" n="902" sameAs="frus:frus1888p1/pg902"/>

                <head>No. 648.<lb/><hi rendition="#italic">Mr. Thompson to Mr. Bayard.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mole St. Nicholas</hi></placeName>, <date calendar="gregorian"
                            when="1888-08-10"><hi rendition="#italic">August</hi> 10,
                        1888</date>.</dateline></opener>
                <p>Your 114 urgent. Two immediately. One pass Cape Haytien. Reply. Details 18th
                    instant.</p>
                <closer><signed><hi rendition="#small-caps">Thompson.</hi></signed></closer>
            </div>
        </body>
