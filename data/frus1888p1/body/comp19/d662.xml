    <text>
        <body>
            <div xml:id="d662">

                <pb facs="1057" n="921" sameAs="frus:frus1888p1/pg921"/>

                <head>No. 662.<lb/><hi rendition="#italic">Mr. Bayard to Mr. Thompson.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1888-09-24"><hi rendition="#italic">September</hi> 24,
                        1888</date>.</dateline>
                    <seg rendition="#float-left">No. 126.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose for your information copy of a
                    letter from the Secretary of the Navy, inclosing a report made by Commander
                    Chester, of the <hi rendition="#italic">Galena</hi>, on Haytian matters; also a
                    copy of my reply to Secretary Whitney’s letter.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. F.
                        Bayard.</hi></signed></closer>





                <xi:include href="d662-a1.xml" xpointer="d662-a1"/>
