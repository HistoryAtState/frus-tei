                <pb facs="1020" n="884" sameAs="frus:frus1888p1/pg884"/>

                <head>No. 629.<lb/><hi rendition="#italic">Mr. Thompson to Mr. Bayard.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Santiago de Cuba</hi></placeName>, <date calendar="gregorian"
                            when="1888-05-26"><hi rendition="#italic">May</hi> 26,
                        1888</date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Secretary of State</hi>,<lb/><hi
                        rendition="#italic">Washington:</hi></p>
                <p>Thompson, minister resident Hayti, telegraphs here by French cable:</p>
                <p>“Advise Secretary State, Washington, send war vessel. Revolution imminent, Port
                    au Prince.”</p>
                <closer><signed><hi rendition="#small-caps"
                        >Reimer.</hi></signed></closer>
            </div>
        </body>
