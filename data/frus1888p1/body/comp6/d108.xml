    <text>
        <body>
            <div xml:id="d108">

                <pb facs="0282" n="148" sameAs="frus:frus1888p1/pg148"/>

                <head>No. 108.<lb/><hi rendition="#italic">Mr. Bayard to Mr. Hosmer.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1888-04-27"><hi rendition="#italic">April</hi> 27,
                        1888</date>.</dateline>
                    <seg rendition="#float-left">No. 571.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In connection with my No. 569, of the 18th
                    instant, I herewith transmit for your information and files a copy of a letter
                    from the Secretary of the Treasury, dated the 24th instant, and of my reply
                    thereto, dated the 27th, explaining that the withdrawal of the Marquis de Campo
                    steamers, as reported in Mr. Hall’s No. 793, of the 27th ultimo, related
                    exclusively to the Republic of Guatemala.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. F.
                        Bayard.</hi></signed></closer>



                <xi:include href="d108-a1.xml" xpointer="d108-a1"/>
                <xi:include href="d108-a2.xml" xpointer="d108-a2"/>
