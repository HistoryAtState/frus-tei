    <text>
        <body>
            <div xml:id="d87-a1">

                <pb facs="0243" n="109" sameAs="frus:frus1888p1/pg109"/>

                <opener><seg rendition="#center">[Inclosure No. 1 in No. 766.]</seg></opener>
                <head><hi rendition="#italic">Mr. Robinson to Mr.
                            Hall.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Guatemala</hi></placeName>, <date calendar="gregorian"
                            when="1887-11-15"><hi rendition="#italic">November</hi> 15,
                        1887</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to hand to you herewith a
                    correct copy of a communication and protest that I have this day personally
                    delivered at the office of the minister of fomento of Guatemala, addressed to
                    him, and to beg of you that you will place the said copy on file in the legation
                    of the United States for such future reference as may be necessary.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Sanford Robinson</hi>,<lb/><hi
                                rendition="#italic">Managing Directory
                    etc.</hi></signed></closer>
            </div>
        </body>
