    <text>
        <body>
            <div xml:id="d101">

                <pb facs="0267" n="133" sameAs="frus:frus1888p1/pg133"/>

                <head>No. 101.<lb/><hi rendition="#italic">Mr. Bayard to Mr. Hall</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1888-03-23"><hi rendition="#italic">March</hi> 23,
                        1888</date>.</dateline>
                    <seg rendition="#float-left">No. 560.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have pleasure in transmitting for your
                    information a copy of a note from the minister of Italy<anchor n="†"
                        xml:id="d101-f1"/> here, dated the 18th instant, conveying <pb facs="0268"
                        n="134" xml:id="pg134"/> an expression of his Government’s thanks for your
                    efforts in bringing to an equitable adjustment the claim of the Italian Sagrini
                    against Salvador.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. F. Bayard.</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d101-f1" n="†" xml:id="d101-f1-content">
                <p>For inclosure see Doc. No. 722, <hi rendition="#italic">post</hi>, p. 1050, under
                    “Italian correspondence.”</p>
            </note>
        </listAnnotation>
    </standOff>
