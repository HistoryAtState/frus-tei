    <text>
        <body>
            <div xml:id="d621">

                <pb facs="1004" n="868" xml:id="pg868"/>

                <head>No. 621.<lb/><hi rendition="#italic">Mr. Merrill to Mr. Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Honolulu</hi></placeName>, <date calendar="gregorian"
                            when="1888-07-24"><hi rendition="#italic">July</hi> 24, 1888</date>.
                        (Received August 15.)</dateline>
                    <seg rendition="#float-left">No. 197.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose copy of an act
                    passed by the Hawaiian Legislature and approved on the 4th instant, limiting the
                    time within which “permits for Chinese to enter the Kingdom may be used.”</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Geo. W. Merrill.</hi></signed></closer>


                <xi:include href="d621-a1.xml" xpointer="d621-a1"/>
            </div>
