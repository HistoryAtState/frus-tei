            <div xml:id="d623">

                <pb facs="1007" n="871" sameAs="frus:frus1888p1/pg871"/>

                <head>No. 623.<lb/><hi rendition="#italic">Mr. Merrill to Mr. Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Honolulu</hi></placeName>, <date calendar="gregorian"
                            when="1888-09-11"><hi rendition="#italic">September</hi> 11,
                        1888</date>. (Received October 9.)</dateline>
                    <seg rendition="#float-left">No. 204.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose a copy of an
                    act passed by the legislature of Hawaii and approved on the 10th instant,
                    amending the law of 1887 relating to the regulation of Chinese immigration.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Geo. W. Merrill</hi>,</signed></closer>



                <xi:include href="d623-a1.xml" xpointer="d623-a1"/>
