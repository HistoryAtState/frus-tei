                <pb facs="0618" n="484" sameAs="frus:frus1888p1/pg484"/>

                <head>No. 338.<lb/><hi rendition="#italic">Mr. Anderson to Mr. Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Copenhagan</hi></placeName>, <date calendar="gregorian"
                            when="1888-02-24"><hi rendition="#italic">February</hi> 24, 1888</date>.
                        (Received March 12.)</dateline>
                    <seg rendition="#float-left">No. 208.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to report that, acting
                    upon the instructions contained in your printed circular dated July 9, 1887, I
                    embodied are quest for the desired information in a note to the royal Danish
                    minister of foreign affairs, under date of August 11, 1887.</p>
                <p>Having just received a reply from his excellency, I have herewith the honor of
                    transmitting to you copies of both notes, together with a translation of the
                    latter.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">R. B. Anderson.</hi></signed></closer>




                <xi:include href="d338-a1.xml" xpointer="d338-a1"/>
