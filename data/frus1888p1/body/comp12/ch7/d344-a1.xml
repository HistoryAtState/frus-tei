                <pb facs="0622" n="488" sameAs="frus:frus1888p1/pg488"/>

                <opener><seg rendition="#center">[Inclosure 1.]</seg></opener>
                <head><hi rendition="#small-caps">petition of c. a. b. johnson to be released from
                        his american citizenship.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Copenhagen</hi></placeName>, <date calendar="gregorian"
                            when="1888-02-22"><hi rendition="#italic">February</hi> 22,
                        1888</date>.</dateline></opener>
                <p>I undersigned Charly A. B. Johnson, borned in Hartford, Conn., U. S. A., year
                    1855, solicits the Government of the United States of America to release me from
                    my duties as American subject, as the Royal Danish Government has granted me
                    protection as a Dane.</p>
                <closer><signed><hi rendition="#small-caps">Charly A. B.
                            Johnson.</hi></signed></closer>
                <postscript>
                    <p>The <hi rendition="#small-caps">Government of the United States of
                            America</hi>,<lb/><hi rendition="#italic">Washington.</hi></p>
                </postscript>
            </div>
        </body>
