    <text>
        <body>
            <div xml:id="d321">

                <pb facs="0607" n="473" sameAs="frus:frus1888p1/pg473"/>

                <head>No. 321.<lb/><hi rendition="#italic">Mr. Anderson to Mr. Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Copenhagen</hi></placeName>, <date calendar="gregorian"
                            when="1887-09-13"><hi rendition="#italic">September</hi> 13,
                        1887</date>. (Received September 28.)</dateline>
                    <seg rendition="#float-left">No. 152.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to send you herewith
                    inclosed a copy of the petroleum bill now pending in the Danish legislature,
                    together with the Government’s remarks thereon. I also inclose for your
                    information a complete translation of these documents. Awaiting your further
                    instructions,</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">R. B.
                            Anderson.</hi></signed></closer>


                <xi:include href="d321-a1.xml" xpointer="d321-a1"/>
            </div>
        </body>
    </text>
