                <pb facs="0628" n="494" sameAs="frus:frus1888p1/pg494"/>

                <head>No. 352.<lb/><hi rendition="#italic">Mr. Bayard to Mr. McLane.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1887-12-03"><hi rendition="#italic">December</hi> 3,
                        1887</date>.</dateline>
                    <seg rendition="#float-left">No. 278.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: The medal for the President, commemorative
                    of the inauguration of the Statue of Liberty at New York, which accompanied your
                    dispatch No. 505, of the 18th ultimo, has been received and conveyed to its
                    destination.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. F. Bayard</hi>.</signed></closer>
            </div>
        </body>
    </text>
