    <text>
        <body>
            <div xml:id="d147">

                <pb facs="d147-01" n="1" xml:id="d147-01"/>

                <head>147. Memorandum from Secretary of State Rogers to President Nixon<anchor n="1"
                        xml:id="d147-f1"/>
                    <anchor n="2" xml:id="d147-f2"/>
                </head>
                <dateline>
                    <placeName>Washington</placeName>, <date calendar="gregorian" when="1969-10-24"
                        >October 24, 1969</date>.</dateline>
                <p>
                    <hi rendition="#underline">MEMORANDUM FOR THE PRESIDENT</hi>-Evening Report</p>
                <p>
                    <hi rendition="#underline">Narcotics</hi>-As Alex Johnson reported to the
                    Inter-Agency Meeting held by Henry Kissinger at the White House this morning, I
                    have appointed Harry Schwartz, a senior officer in the Department, as my Special
                    Assistant for Narcotics Matters, in order to ensure that the Department acts
                    effectively in coordinating and carrying out your desire for a maximum effort to
                    get the matter of illegal narcotics imports under better control.</p>
                <closer>
                    <signed> William P. Rogers </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d147-f1" n="1" type="source" xml:id="d147-f1-content">
                <p>Source: National Archives, RG 59, President’s Evening Reading: Lot File 74 D 164.
                    Secret.</p>
            </note>
            <note corresp="#d147-f2" n="2" xml:id="d147-f2-content">
                <p> Rogers reported that he had appointed Harry Schwartz as his Special Assistant
                    for Narcotics Matters.</p>
            </note>
        </listAnnotation>
