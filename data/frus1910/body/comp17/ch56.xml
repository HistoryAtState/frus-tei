            <div xml:id="ch56">

                <pb facs="0644" n="532" sameAs="frus:frus1910/pg532"/>

                <head>Treaty between the United States and Great Britain relating to boundary waters
                    between the United States and Canada</head>
                <p><hi rendition="#italic">Signed at Washington, January 11, 1909.</hi></p>
                <p><hi rendition="#italic">Ratification advised by the Senate, March 3,
                    1909</hi>.</p>
                <p><hi rendition="#italic">Ratified by the President, April 1, 1910</hi>.</p>
                <p><hi rendition="#italic">Ratified by Great Britain, March 31, 1910</hi>.</p>
                <p><hi rendition="#italic">Ratifications exchanged at Washington, May 5,
                    1910</hi>.</p>
                <p><hi rendition="#italic">Proclaimed, May 13, 1910.</hi></p>

                <xi:include href="ch56/d621.xml" xpointer="d621"/>
