                <pb facs="0638" n="526" sameAs="frus:frus1910/pg526"/>

                <note rend="inline" type="source">File No. 24607/21.</note>
                <head><hi rendition="#italic">Ambassador Reid to the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#small-caps"
                            >London</hi></placeName>, <date calendar="gregorian" when="1910-05-08"
                                ><hi rendition="#italic">May 8, 1910</hi></date></dateline>
                    <seg rendition="#float-left">No. 1268.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a copy
                    of a foreign office note dated the 7th instant announcing the death of His
                    Majesty King Edward VII and informing me that the British ambassador at
                    Washington has been instructed by telegraph to convey the sad news to the
                    Government of the United States</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Whitelaw Reid</hi></signed></closer>


                <xi:include href="d609-a1.xml" xpointer="d609-a1"/>
            </div>
