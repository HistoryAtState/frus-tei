                <pb facs="0637" n="525" sameAs="frus:frus1910/pg525"/>

                <note rend="inline" type="source">File No. 24607.</note>
                <head><hi rendition="#italic">The Secretary of State to the British Minister for
                        Foreign Affairs.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1910-05-07"><hi rendition="#italic">May 7,
                        1910</hi></date>.</dateline></opener>
                <p>I offer to your excellency the expression of my personal sympathy and sorrow in
                    the great loss which has been sustained by the Government of Great Britain in
                    the death of His Majesty King Edward.</p>
                <closer><signed><hi rendition="#small-caps">P. C. Knox.</hi></signed></closer>
            </div>
        </body>
