    <text>
        <body>
            <div xml:id="d617-a1">

                <pb facs="0642" n="530" sameAs="frus:frus1910/pg530"/>

                <opener><seg rendition="#center">[Inclosure 1.]</seg></opener>
                <head><hi rendition="#italic">Ambassador Reid to the Minister for Foreign
                        Affairs.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >London</hi></placeName>, <date calendar="gregorian" when="1910-05-12"
                                ><hi rendition="#italic">May 12,
                    1910</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Under instructions from my Government I
                    have the honor to inform you that the following resolution was adopted by the
                    House of Representatives at Washington on the 7th instant.<anchor n="1"
                        xml:id="d617-f1"/></p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Whitelaw Reid.</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d617-f1" n="1" xml:id="d617-f1-content">
                <p>Resolution printed, supra.</p>
            </note>
        </listAnnotation>
