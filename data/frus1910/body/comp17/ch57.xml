            <div xml:id="ch57">

                <pb facs="0652" n="540" sameAs="frus:frus1910/pg540"/>

                <head>Treaty between the United States and Great Britain relating to the boundary
                    line in Passamaquoddy Bay</head>
                <p><hi rendition="#italic">Signed at Washington, May 21, 1910.</hi></p>
                <p><hi rendition="#italic">Ratification advised by the Senate, June 6,
                    1910.</hi></p>
                <p><hi rendition="#italic">Ratified by the President, July 13, 1910.</hi></p>
                <p><hi rendition="#italic">Ratified by Great Britain, June 23, 1910.</hi></p>
                <p><hi rendition="#italic">Ratifications exchanged at Washington, August 20,
                        1910.</hi></p>
                <p><hi rendition="#italic">Proclaimed, September 3, 1910.</hi></p>

                <xi:include href="ch57/d622.xml" xpointer="d622"/>
