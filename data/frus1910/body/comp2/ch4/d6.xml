            <div xml:id="d6">

                <pb facs="0117" n="5" xml:id="pg5"/>

                <note rend="inline" type="source">File No. 14503/8.</note>
                <head><hi rendition="#italic">The Argentine Minister to
                        the Secretary of State.</hi></head>
                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Argentine Legation</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1909-11-29"><hi rendition="#italic">November 29,
                        1909</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Mr. Secretary of State</hi>: By direction of my
                    Government I have the honor to communicate to your excellency the program of
                    ceremonies on the occasion of the centennial anniversary of our national
                    independence.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Epifanio Portela.</hi></signed></closer>


                <xi:include href="d6-a1.xml" xpointer="d6-a1"/>
