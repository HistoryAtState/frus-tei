    <text>
        <body>
            <div xml:id="d19">

                <pb facs="0123" n="11" sameAs="frus:frus1910/pg11"/>

                <note rend="inline" type="source">File No. 835.415A/97.</note>
                <head><hi rendition="#italic">The Argentine Chargé to the
                            Secretary of State.</hi></head>
                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Argentine Legation</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1910-11-22"><hi rendition="#italic">November 22,
                        1910</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Mr. Secretary of State</hi>: I have the honor to
                    inclose office copy and original of the autograph letter<anchor n="1"
                        xml:id="d19-f1"/> of the President of the Argentine <pb facs="0124" n="12"
                        xml:id="pg12"/> Republic acknowledging the letter sent by President Taft
                    upon the occasion of the centenary anniversity of Argentine independence.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Jacinto L.
                    Villegas.</hi></signed></closer>
            </div>
        </body>
    </text>
