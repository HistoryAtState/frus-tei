    <text>
        <body>
            <div xml:id="ch45">

                <pb facs="0536" n="424" sameAs="frus:frus1910/pg424"/>

                <head>Extradition treaty between the United States and the Dominican Republic</head>
                <p><hi rendition="#italic">Signed at Santo Domingo June 19, 1909.</hi></p>
                <p><hi rendition="#italic">Ratification advised by the Senate, with amendment, July
                        26, 1909</hi>.</p>
                <p><hi rendition="#italic">Ratified by the President April 29, 1910</hi>.</p>
                <p><hi rendition="#italic">Ratified by the Dominican Republic July 11,
                    1910</hi>.</p>
                <p><hi rendition="#italic">Ratifications exchanged at Santo Domingo August 2,
                        1910</hi>.</p>
                <p><hi rendition="#italic">Proclaimed August 26, 1910.</hi></p>

                <xi:include href="ch45/d435.xml" xpointer="d435"/>
