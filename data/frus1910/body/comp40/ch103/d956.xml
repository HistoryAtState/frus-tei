                <pb facs="0976" n="864" sameAs="frus:frus1910/pg864"/>

                <note rend="inline" type="source">File No. 23905–1.</note>
                <head><hi rendition="#italic">Chargé Whitehouse to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Caracas</hi></placeName>, <date calendar="gregorian" when="1910-03-31"
                                ><hi rendition="#italic">March 31, 1910</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 530.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose you herewith
                    copies and translations of the program of the ceremonies in connection with the
                    celebration of the centennial of the independence of Venezuela.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Sheldon
                    Whitehouse.</hi></signed></closer>


                <xi:include href="d956-a1.xml" xpointer="d956-a1"/>
