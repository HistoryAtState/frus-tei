                <pb facs="0980" n="868" sameAs="frus:frus1910/pg868"/>

                <note rend="inline" type="source">File No. 3136/296.</note>
                <head><hi rendition="#italic">Chargé Whitehouse to Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Caracas</hi></placeName>, <date calendar="gregorian" when="1910-04-28"
                                ><hi rendition="#italic">April 28, 1910</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 544.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit under separate
                    cover duplicate copies of the message of President Gomez delivered to Congress
                    on April 19, and to inclose herewith a translation of the portion dedicated to
                    the United States.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Sheldon
                    Whitehouse.</hi></signed></closer>


                <xi:include href="d960-a1.xml" xpointer="d960-a1"/>
