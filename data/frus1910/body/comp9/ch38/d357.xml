    <text>
        <body>
            <div xml:id="d357">

                <pb facs="0473" n="361" sameAs="frus:frus1910/pg361"/>

                <head><hi rendition="#italic">Minister Squiers to the Secretary of
                    State.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Panama</hi></placeName> (<date
                            ana="#date_undated-inferred-from-document-content" calendar="gregorian"
                            notAfter="1909-01-30T23:59:59-05:00"
                            notBefore="1909-01-29T00:00:00-05:00">undated</date>).<lb/>(Received
                        January 30, 1909.)</dateline></opener>
                <p>Recent treaty between Colombia and Panama ratified by national assembly this
                    afternoon without amendment or discussion.</p>
                <closer><signed><hi rendition="#small-caps">Squiers.</hi></signed></closer>
            </div>
        </body>
