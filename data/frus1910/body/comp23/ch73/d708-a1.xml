    <text>
        <body>
            <div xml:id="d708-a1">

                <pb facs="0796" n="684" sameAs="frus:frus1910/pg684"/>

                <head>[Inclosure—Translation.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Official Gazette</hi></placeName>, <date calendar="gregorian"
                            when="1910-08-29"><hi rendition="#italic">August 29,
                        1910</hi></date>.</dateline></opener>
                <p>We hereby sanction and cause to be promulgated the ordinance relating to the
                    alteration of the name “Kankoku” (Korea) to “Chosen.”</p>
                <closer><signed>
                        <list>
                            <item><hi rendition="#small-caps">Sign Manual.</hi></item>
                            <item><hi rendition="#small-caps">Privy Seal</hi>.</item>
                        </list></signed>
                    <lb/>
                    <dateline rendition="#float-left"><date calendar="gregorian" when="1910-08-29"
                                ><hi rendition="#small-caps">August</hi> 29,
                    1910</date>.</dateline></closer>
                <postscript>
                    <p>(Countersigned) <hi rendition="#small-caps">Marquis Taro Katsura</hi>, <hi
                            rendition="#italic">Prime Minister.</hi></p>
                    <p><hi rendition="#italic">Imperial ordinance No. 318.</hi>—The name “Kankoku”
                        is hereby changed, and the country shall henceforth be called “Chosen.”</p>
                    <p><hi rendition="#italic">Supplementary clause.</hi>—This ordinance shall take
                        effect on the day of promulgation.</p>
                </postscript>
            </div>
        </body>
    </text>
