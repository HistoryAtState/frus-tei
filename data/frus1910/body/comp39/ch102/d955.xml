    <text>
        <body>
            <div xml:id="d955">

                <pb facs="0974" n="862" sameAs="frus:frus1910/pg862"/>

                <head><hi rendition="#italic">Minister Morgan to the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Montevideo</hi></placeName>, <date calendar="gregorian"
                            when="1910-04-29"><hi rendition="#italic">April 29,
                        1910</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit the message
                    which the President of Paraguay recently sent to Congress, and which was printed
                    in <hi rendition="#italic">El Diario</hi>, of Asuncion, on April 1. A
                    translation in summary form of the message is also inclosed.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Edwin V. Morgan</hi>.</signed></closer>


                <xi:include href="d955-a1.xml" xpointer="d955-a1"/>
