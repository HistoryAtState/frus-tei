    <text>
        <body>
            <div xml:id="d954">

                <pb facs="0973" n="861" sameAs="frus:frus1910/pg861"/>

                <head><hi rendition="#italic">Chargé Magruder to the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Montevideo</hi></placeName>, <date calendar="gregorian"
                            when="1910-03-08"><hi rendition="#italic">March 8,
                        1910</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 556.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith the
                    message of President Williman, delivered at the opening of the third session of
                    the Twenty-third Congress.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alexander R.
                    Magruder.</hi></signed></closer>


                <xi:include href="d954-a1.xml" xpointer="d954-a1"/>
