                <pb facs="0754" n="642" sameAs="frus:frus1910/pg642"/>

                <note rend="inline" type="source">File No. 5316/157.</note>
                <head><hi rendition="#italic">Minister Sands to the
                            Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Guatemala</hi></placeName>, <date calendar="gregorian"
                            when="1910-04-14"><hi rendition="#italic">April 14,
                        1910</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 101.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose copy and
                    translation of the message of the President of Guatemala to the National
                    Assembly.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. F. Sands.</hi></signed></closer>


                <xi:include href="d673-a1.xml" xpointer="d673-a1"/>
