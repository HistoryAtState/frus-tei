                <pb facs="0216" n="104" sameAs="frus:frus1910/pg104"/>

                <note rend="inline" type="source">File No. 23700/39.</note>
                <head><hi rendition="#italic">Chargé Bailly-Blanchard to the Secretary of
                            State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Paris</hi></placeName>, <date calendar="gregorian" when="1910-07-30"
                                ><hi rendition="#italic">July 30,
                    1910</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In compliance with the department’s
                    instruction No. 122, I have the honor to send herewith a copy of the letter and
                    inclosure which I addressed to Minister Beaupré at the Hague, with reference to
                    the transit through France of a fugitive from the justice of the United States
                    whose extradition has been granted by the Government of Luxemburg.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">A.
                    Bailly-Blanchard.</hi></signed></closer>



                <xi:include href="d73-a1.xml" xpointer="d73-a1"/>
            </div>
