            <div xml:id="d674">

                <pb facs="0756" n="644" sameAs="frus:frus1910/pg644"/>

                <note rend="inline" type="source">File No. 838.032/2.</note>
                <head><hi rendition="#italic">Minister Furniss to the Secretary of
                    State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">Port au
                                Prince</hi></placeName>, <date calendar="gregorian"
                            when="1910-09-06"><hi rendition="#italic">September 6,
                        1910</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 721.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith copy
                    and translation of the message of President Simon read at the opening of the
                    extra session of the Haitian Congress on the 5th instant.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">H. W. Furniss.</hi></signed></closer>


                <xi:include href="d674-a1.xml" xpointer="d674-a1"/>
