                <pb facs="0828" n="716" sameAs="frus:frus1910/pg716"/>

                <note rend="inline" type="source">FileNo.812.415A/124.</note>
                <head><hi rendition="#italic">Ambassador Wilson to the Secretary of
                    State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Mexico</hi></placeName>, <date calendar="gregorian" when="1910-12-13"
                                ><hi rendition="#italic">December 13, 1910</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 297.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to advise the department
                    that I have just received from the Mexican Government a note stating that
                    President Diaz has appointed the honorable Joaquin D. Casasus an ambassador on
                    special mission, to express to the Government of the United States the gratitude
                    of the people and Government of Mexico for the participation of the United
                    States in the exercises celebrating the centennial of Mexican independence.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Henry Lane
                    Wilson</hi>.</signed></closer>
            </div>
        </body>
