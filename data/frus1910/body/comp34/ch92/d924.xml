    <text>
        <body>
            <div xml:id="d924">

                <pb facs="0948" n="836" sameAs="frus:frus1910/pg836"/>

                <head><hi rendition="#italic">Minister Calhoun to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Pekin</hi></placeName>, <date calendar="gregorian" when="1910-07-23"
                                ><hi rendition="#italic">July 23,
                    1910</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my telegram, No. 31, of
                    to-day’s date,<anchor n="3" xml:id="d924-f1"/> I have the honor to inclose
                    herewith a copy in translation of the Wai-wu-Pu’s circular note in the nature of
                    a reply by China to the Russo-Japanese agreement of July 4, 1910.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. J. Calhoun.</hi></signed></closer>


                <xi:include href="d924-a1.xml" xpointer="d924-a1"/>
            </div>
        </body>
    </text>
