    <text>
        <body>
            <div xml:id="d565">

                <pb facs="0614" n="502" sameAs="frus:frus1910/pg502"/>

                <head><hi rendition="#italic">The Acting Secretary of State to the Brazilian
                        Chargé.</hi><anchor n="1" xml:id="d565-f1"/></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1910-09-01"><hi rendition="#italic">September 1,
                        1910</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Chargé d’Affaires</hi>: Referring to
                    previous correspondence in regard to the tripartite mediation between Ecuador
                    and Peru, I beg to inclose herewith [see supra], for your confidential
                    information, a copy of a note received from the minister of Ecuador at this
                    capital, setting forth the views of his Government regarding the protocol
                    proposed by the representatives of the mediating powers.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Huntington
                    Wilson</hi>.</signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d565-f1" n="1" type="source" xml:id="d565-f1-content">
                <p>Same, mutatis mutandis, to the Argentine chargé.</p>
            </note>
        </listAnnotation>
    </standOff>
