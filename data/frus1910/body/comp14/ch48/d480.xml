    <text>
        <body>
            <div xml:id="d480">

                <pb facs="0569" n="457" sameAs="frus:frus1910/pg457"/>

                <head><hi rendition="#italic">Minister Combs to the
                            Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Lima</hi></placeName>, <date calendar="gregorian" when="1910-05-23"><hi
                                rendition="#italic">May 23, 1910</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 356.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to forward by this mail,
                    but too late for the pouch or translation, a copy of the formal note of
                    acceptance of the Peruvian Government of the proposal of mediation.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Leslie Combs.</hi></signed></closer>



                <xi:include href="d480-a1.xml" xpointer="d480-a1"/>
