    <text>
        <body>
            <div xml:id="d494">

                <pb facs="0576" n="464" sameAs="frus:frus1910/pg464"/>

                <head><hi rendition="#italic">The Secretary of State to Minister Fox.</hi><anchor
                        n="1" xml:id="d494-f1"/></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1910-06-01"><hi rendition="#italic">June 1,
                        1910</hi></date>.</dateline></opener>
                <p>Act on the department’s May 28.</p>
                <p>Immediately make strong representations to the Government to which you are
                    accredited in the sense of the following aide-mémoire to-day handed the
                    representatives of Ecuador and Peru at Washington.<anchor n="2" xml:id="d494-f2"
                    /></p>
                <closer><signed><hi rendition="#small-caps">Knox.</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d494-f1" n="1" type="source" xml:id="d494-f1-content">
                <p>Same to Lima.</p>
            </note>
            <note corresp="#d494-f2" n="2" xml:id="d494-f2-content">
