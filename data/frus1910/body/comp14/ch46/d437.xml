                <pb facs="0545" n="433" sameAs="frus:frus1910/pg433"/>

                <note rend="inline" type="source">File No. 822,032.</note>
                <head><hi rendition="#italic">Minister Fox to the
                            Secretary of State.</hi></head>
                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Quito</hi></placeName>, <date calendar="gregorian" when="1910-08-20"
                                ><hi rendition="#italic">August 20, 1910</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 726.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith
                    translations of the message of the President of Ecuador to the Congress of
                    1910.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Williams C. Fox.</hi></signed></closer>


                <xi:include href="d437-a1.xml" xpointer="d437-a1"/>
