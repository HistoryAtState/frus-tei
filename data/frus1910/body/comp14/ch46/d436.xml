            <div xml:id="d436">

                <pb facs="0542" n="430" sameAs="frus:frus1910/pg430"/>

                <note rend="inline" type="source">File 3010/91.</note>
                <head><hi rendition="#italic">Minister Fox to the
                            Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Quito</hi></placeName>, <date calendar="gregorian" when="1910-06-27"
                                ><hi rendition="#italic">June 27, 1910</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 669.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith
                    copies, with translation, of the message of the President of Ecuador submitted
                    to the extraordinary session of Congress, 1910. This document is important,
                    being an analysis of the position of Ecuador in the present conflict with
                    Peru.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">William C. Fox.</hi></signed></closer>


                <xi:include href="d436-a1.xml" xpointer="d436-a1"/>
            </div>
