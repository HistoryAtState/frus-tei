            <div xml:id="ch47">

                <pb facs="0548" n="436" sameAs="frus:frus1910/pg436"/>

                <head>Arbitration convention between the United States and Ecuador</head>
                <p><hi rendition="#italic">Signed at Washington, January 7, 1909.</hi></p>
                <p><hi rendition="#italic">Ratification advised by the Senate, January 13,
                    1909</hi>.</p>
                <p><hi rendition="#italic">Ratified by the President, March 1, 1909</hi>.</p>
                <p><hi rendition="#italic">Ratified by Ecuador, November 5, 1909</hi>.</p>
                <p><hi rendition="#italic">Ratifications exchanged at Washington, June 22,
                    1910</hi>.</p>
                <p><hi rendition="#italic">Proclaimed June 23, 1910.</hi></p>

                <xi:include href="ch47/d438.xml" xpointer="d438"/>
