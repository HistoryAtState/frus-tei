    <text>
        <body>
            <div xml:id="ch14">

                <pb facs="0225" n="113" sameAs="frus:frus1910/pg113"/>

                <head>Naturalization convention between the United States and Brazil</head>
                <p><hi rendition="#italic">Signed at Rio de Janeiro, April 27, 1908.</hi></p>
                <p><hi rendition="#italic">Ratification advised by the Senate, December 10,
                        1908.</hi></p>
                <p><hi rendition="#italic">Ratified by the President, December 26, 1908.</hi></p>
                <p><hi rendition="#italic">Ratified by Brazil, December 6, 1909.</hi></p>
                <p><hi rendition="#italic">Ratifications exchanged at Rio de Janeiro, February 28,
                        1910.</hi></p>
                <p><hi rendition="#italic">Proclaimed, April 2, 1910.</hi></p>

                <xi:include href="ch14/d86.xml" xpointer="d86"/>
