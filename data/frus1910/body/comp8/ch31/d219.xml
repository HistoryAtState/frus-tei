    <text>
        <body>
            <div xml:id="d219">

                <pb facs="0362" n="250" sameAs="frus:frus1910/pg250"/>

                <head><hi rendition="#italic">Ambassador O’Brien to the Secretary of
                    State.</hi></head>
                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Tokyo</hi></placeName>, <date calendar="gregorian" when="1910-01-24"
                                ><hi rendition="#italic">January 24, 1910</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 978.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a copy
                    of the note from Count Komura to me, dated the 22d instant, in relation to the
                    proposal to neutralize certain railways in Manchuria, etc.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. J. O’Brien.</hi></signed></closer>



                <xi:include href="d219-a1.xml" xpointer="d219-a1"/>
            </div>
