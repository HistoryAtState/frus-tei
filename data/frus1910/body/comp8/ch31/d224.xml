    <text>
        <body>
            <div xml:id="d224">

                <pb facs="0368" n="256" sameAs="frus:frus1910/pg256"/>

                <head><hi rendition="#italic">Ambassador Bacon to the Secretary of
                    State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Paris</hi></placeName>, <date calendar="gregorian" when="1910-02-04"
                                ><hi rendition="#italic">February 4, 1910</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 30.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to send herewith a copy
                    and translation of a memorandum, dated January 26 last, which has just been
                    received from the minister for foreign affairs in reply to the communication
                    which Mr. Bailly-Blanchard addressed to him in compliance with the department’s
                    cable.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Robert Bacon.</hi></signed></closer>


                <xi:include href="d224-a1.xml" xpointer="d224-a1"/>
            </div>
