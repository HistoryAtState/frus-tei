    <text>
        <body>
            <div xml:id="d191">

                <pb facs="0341" n="229" sameAs="frus:frus1910/pg229"/>

                <head><hi rendition="#italic">The Secretary of State to Ambassador
                    Rockhill.</hi></head>
                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1910-02-07"><hi rendition="#italic">February 7,
                        1910</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 42.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to inclose for your information a
                    copy of the department’s No. 31, to Harbin.</p>
                <p>The department hopes that the question of the municipal government of Harbin may
                    be satisfactorily settled by the proposed conference of the Russian and Chinese
                    representatives at Harbin.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">P. C. Knox.</hi></signed></closer>


                <xi:include href="d191-a1.xml" xpointer="d191-a1"/>
