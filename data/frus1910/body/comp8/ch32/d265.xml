    <text>
        <body>
            <div xml:id="d265">

                <pb facs="0401" n="289" sameAs="frus:frus1910/pg289"/>

                <note rend="inline" type="source">File No. 893.77/1072.</note>
                <head><hi rendition="#italic">Minister Calhoun to the Secretary of
                    State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Peking</hi></placeName>, <date calendar="gregorian" when="1910-08-13"
                                ><hi rendition="#italic">August 13,
                    1910</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With further reference to my telegraphic
                    dispatches, August 2<anchor n="1" xml:id="d265-f1"/> and August 9, I have the
                    honor to transmit to the department the translation of the note received from
                    the foreign office requesting the legation to instruct the representative of the
                    bank to negotiate with the board of communications for a satisfactory settlement
                    of the Hukuang loan and of my note to Mr. Menocal to that effect.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. J. Calhoun.</hi></signed></closer>




                <xi:include href="d265-a1.xml" xpointer="d265-a1"/>
                <xi:include href="d265-a2.xml" xpointer="d265-a2"/>
            </div>
        </body>
    </text>
