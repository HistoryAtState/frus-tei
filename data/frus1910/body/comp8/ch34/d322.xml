            <div xml:id="d322">

                <pb facs="0440" n="328" sameAs="frus:frus1910/pg328"/>

                <note rend="inline" type="source">File No. 1518/344.</note>
                <head><hi rendition="#italic">Chargé Fletcher to the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Peking</hi></placeName>, <date calendar="gregorian" when="1909-12-06"
                                ><hi rendition="#italic">December 6, 1909</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1317.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In continuation of the legation’s
                    dispatches on constitutional reform in China I have the honor to transmit
                    herewith translations of two imperial decrees, which are of more historical than
                    political interest.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Henry P.
                    Fletcher.</hi></signed></closer>


                <xi:include href="d322-a1.xml" xpointer="d322-a1"/>
