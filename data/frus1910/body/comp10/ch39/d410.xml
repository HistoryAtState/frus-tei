    <text>
        <body>
            <div xml:id="d410">

                <pb facs="0522" n="410" xml:id="pg410"/>

                <note rend="inline" type="source">File No. 24354/4.</note>
                <head><hi rendition="#italic">President Taft to the
                            President of Costa Rica.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >The White House</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1910-05-06"><hi rendition="#italic">May 6,
                        1910</hi></date>.</dateline></opener>
                <p>Accept the profound sympathy of the people and Government of the United States in
                    the calamity at Cartago, of which I learn with the deepest regret.</p>
                <closer><signed><hi rendition="#small-caps">Wm. H. Taft.</hi></signed></closer>
            </div>
        </body>
