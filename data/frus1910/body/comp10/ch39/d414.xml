                <pb facs="0523" n="411" sameAs="frus:frus1910/pg411"/>

                <note rend="inline" type="source">File No. 24354/6.</note>
                <head><hi rendition="#italic">The President of Costa Rica to President
                    Taft.</hi></head>
                <opener><seg rendition="#center">[Telegram.—Translation.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >San Jose</hi></placeName>, <date calendar="gregorian"
                            when="1910-05-07"><hi rendition="#italic">May 7–8,
                        1910</hi></date>.</dateline></opener>
                <p>In the name of the people and Government of Costa Rica I express to your
                    excellency our most profound gratitude.</p>
                <closer><signed><hi rendition="#small-caps">Cleto Gonzalez
                    Viquez.</hi></signed></closer>
            </div>
        </body>
    </text>
