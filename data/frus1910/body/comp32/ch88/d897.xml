    <text>
        <body>
            <div xml:id="d897">

                <pb facs="0935" n="823" sameAs="frus:frus1910/pg823"/>

                <note rend="inline" type="source">File No. 891.001.</note>
                <head><hi rendition="#italic">The Secretary of State to the Minister for Foreign
                        Affairs of Persia.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1910-09-23"><hi rendition="#italic">September 23,
                        1910</hi></date>.</dateline></opener>
                <p>Accept an expression of my sympathy and that of the Government and people of the
                    United States for the loss sustained by His Imperial Majesty and the Government
                    and people of Persia in the death of the Prince Regent.</p>
                <closer><signed><hi rendition="#small-caps">Knox.</hi></signed></closer>
            </div>
        </body>
