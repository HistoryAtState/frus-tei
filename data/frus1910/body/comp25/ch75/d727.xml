    <text>
        <body>
            <div xml:id="d727">

                <pb facs="0817" n="705" sameAs="frus:frus1910/pg705"/>

                <head><hi rendition="#italic">The Vice President of
                            Liberia to President Taft.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Monrovia, Liberia</hi></placeName>,<lb/><date calendar="gregorian"
                            when="1910-03-21"><hi rendition="#italic">March 21,
                        1910</hi></date>.</dateline></opener>
                <p>Liberian public boundlessly grateful for the magnanimous help of your great and
                    good nation.</p>
                <closer><signed><hi rendition="#small-caps">Vice President
                    Dossen.</hi></signed></closer>
            </div>
        </body>
    </text>
