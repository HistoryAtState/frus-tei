                <pb facs="0300" n="188" sameAs="frus:frus1910/pg188"/>

                <note rend="inline" type="source">File No. 1154/286.</note>
                <head><hi rendition="#italic">Chargé Phillips to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >London</hi></placeName>, <date calendar="gregorian" when="1910-01-25"
                                ><hi rendition="#italic">January 25, 1910</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1153.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a copy
                    of my note to the foreign office expressing the high appreciation of the
                    American Government for His Majesty’s gracious and friendly action in accepting
                    the office of mediator for the adjustment of the Alsop claim between the United
                    States and Chile.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">William Phillips.</hi></signed></closer>



                <xi:include href="d146-a1.xml" xpointer="d146-a1"/>
