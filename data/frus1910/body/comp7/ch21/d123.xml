    <text>
        <body>
            <div xml:id="d123">

                <pb facs="0248" n="136" sameAs="frus:frus1910/pg136"/>

                <note rend="inline" type="source">File No. 701.2511/56.</note>
                <head><hi rendition="#italic">The Secretary of State to the Chilean
                    Chargé.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1910-12-24"><hi rendition="#italic">December 24,
                        1910</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Chargé d’affaires</hi>: I beg to notify
                    you that the battleship <hi rendition="#italic">Delaware</hi> has been detailed
                    as the vessel of the United States to convey to Chile the remains of the late
                    Minister Anibal Cruz.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">P. C. Knox.</hi></signed></closer>
            </div>
        </body>
