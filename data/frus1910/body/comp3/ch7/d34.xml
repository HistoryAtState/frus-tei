    <text>
        <body>
            <div xml:id="d34">

                <pb facs="0179" n="67" sameAs="frus:frus1910/pg67"/>

                <note rend="inline" type="source">File No. 19375/9.</note>
                <head><hi rendition="#italic">Ambassador Kerens to the Secretary of
                    State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Vienna</hi></placeName>, <date calendar="gregorian" when="1910-04-20"
                                ><hi rendition="#italic">April 20, 1910</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 5.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to the department’s
                        instructions<anchor n="1" xml:id="d34-f1"/> of the 1st of November, 1909,
                    serial No. 373, I have the honor to transmit herewith a copy of a note received
                    from the foreign office (with translation) in answer to a note addressed by this
                    embassy to the minister for foreign affairs on the 8th of December, 1909.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">R. C. Kerens.</hi></signed></closer>


                <xi:include href="d34-a1.xml" xpointer="d34-a1"/>
            </div>
        </body>
    </text>
