    <text>
        <body>
            <div xml:id="d79">

                <pb facs="0224" n="128" sameAs="frus:frus1879/pg128"/>

                <head>No. 66.<lb/><hi rendition="#italic">Mr. Pettis to Mr. Evarts.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic">La
                                Paz, Bolivia</hi></placeName>, <date calendar="gregorian"
                            when="1879-08-25"><hi rendition="#italic">August</hi> 25, 1879</date>.
                        (Received October 16.)</dateline>
                    <seg rendition="#float-left">No. 24.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I am in receipt of your dispatch of June 25
                    (No. 13), and inclosures, and in answer thereto I have the honor to inform you
                    that I have transmitted one copy of the Treasury circular to the minister of
                    foreign relations of Bolivia, as will be seen by my letter addressed to him upon
                    the subject, a copy of which is herewith inclosed and marked inclosure 1.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>S. NEWTON PETTIS.</signed></closer>


                <xi:include href="d79-a1.xml" xpointer="d79-a1"/>
            </div>
