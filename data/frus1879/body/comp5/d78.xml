    <text>
        <body>
            <div xml:id="d78">

                <pb facs="0223" n="127" sameAs="frus:frus1879/pg127"/>

                <head>No. 65.<lb/><hi rendition="#italic">Mr. Pettis to Mr. Evarts.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic">La
                                Paz, Bolivia</hi></placeName>, <date calendar="gregorian"
                            when="1879-08-25"><hi rendition="#italic">August</hi> 25, 1879</date>.
                        (Received October 16.)</dateline>
                    <seg rendition="#float-left">No. 23]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your dispatch of the 23d June last (No. 12), and have, in compliance with
                    directions therein contained, called the attention of the minister for foreign
                    relations of Bolivia to the subject of your dispatch, as will appear from a copy
                    of my said letter herewith forwarded, marked inclosure 1.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>S. NEWTON PETTIS.</signed></closer>


                <xi:include href="d78-a1.xml" xpointer="d78-a1"/>
            </div>
