                <pb facs="0497" n="401" sameAs="frus:frus1879/pg401"/>

                <opener><seg rendition="#center">[Translation of A to inclosure 2 of No.
                    48.]</seg></opener>
                <p rendition="#center">A.</p>
                <p>The production in Germany, according to official statistical investigations,
                    amounted to:</p>
                <p rendition="#center"><hi rendition="#italic">A. in Gold</hi>.</p>
                <table cols="2" rows="30">
                    <row>
                        <cell/>
                        <cell>Kilos.</cell>
                    </row>
                    <row>
