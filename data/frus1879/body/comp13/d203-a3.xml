                        <cell role="num">3.8</cell>
                    </row>
                    <row>
                        <cell>In the year 1851</cell>
                        <cell role="num">9.4</cell>
                    </row>
                    <row>
                        <cell>In the year 1852</cell>
                        <cell role="num">13.6</cell>
                    </row>
