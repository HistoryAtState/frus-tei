    <text>
        <body>
            <div xml:id="d196">

                <pb facs="0477" n="381" sameAs="frus:frus1879/pg381"/>

                <head>No. 175.<lb/><hi rendition="#italic">Mr. Everett to Mr. Evarts.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Berlin</hi></placeName>, <date calendar="gregorian"
                            when="1879-05-19"><hi rendition="#italic">May</hi> 19, 1879</date>.
                        (Received June 11.)</dateline>
                    <seg rendition="#float-left">No. 111.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose a copy of the
                    treaty between Germany and the Samoan Islands, signed the 24th January, 1879. It
                    is, taken from the Norddeutche Allgemeine Zeitung, and may consequently be
                    assumed to be essentially correct, but, if possible, I will obtain an official
                    copy.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>H. SYDNEY EVERETT.</signed></closer>


                <xi:include href="d196-a1.xml" xpointer="d196-a1"/>
            </div>
