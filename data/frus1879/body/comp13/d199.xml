    <text>
        <body>
            <div xml:id="d199">

                <pb facs="0484" n="388" sameAs="frus:frus1879/pg388"/>

                <head>No. 178.<lb/><hi rendition="#italic">Mr. White to Mr. Evarts.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Berlin</hi></placeName>, <date calendar="gregorian"
                            when="1879-06-30"><hi rendition="#italic">June</hi> 30, 1879</date>.
                        (Received July 18.)</dateline>
                    <seg rendition="#float-left">No. 16.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to forward you, inclosed
                    herewith, translations of the most important parts of the debate in the
                    Reichstag on the 13th instant, upon the treaty of friendship between Germany and
                    the Samoan Islands, the articles of which the Reichstag approved.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>AND. D. WHITE.</signed></closer>


                <xi:include href="d199-a1.xml" xpointer="d199-a1"/>
            </div>
