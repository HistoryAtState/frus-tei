    <text>
        <body>
            <div xml:id="d422">

                <pb facs="0973" n="877" sameAs="frus:frus1879/pg877"/>

                <head>No. 393.<lb/><hi rendition="#italic">Mr. Christiancy to Mr.
                    Evarts.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Lima, Peru</hi></placeName>, <date calendar="gregorian"
                            when="1879-05-20"><hi rendition="#italic">May</hi> 20, 1879</date>.
                        (Received June 16.)</dateline>
                    <seg rendition="#float-left">No. 15.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose to you the
                    copies of two letters of Hon. Thomas A. Osborn, of the 2d and 26th April, in
                    reference to the use of the American flag by foreign-built ships, and a copy of
                    my answer to same of this date, so far as the case of the Itata is involved.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>I. P. CHEISTIANCY.</signed></closer>




                <xi:include href="d422-a1.xml" xpointer="d422-a1"/>
