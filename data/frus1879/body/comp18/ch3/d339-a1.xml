    <text>
        <body>
            <div xml:id="d339-a1">

                <pb facs="0789" n="693" sameAs="frus:frus1879/pg693"/>

                <head><hi rendition="#italic">Table showing the actual number of officers and
                        employés on the</hi> 30<hi rendition="#italic">th June</hi>, 1878.</head>
                <p rendition="#center"><hi rendition="#small-caps">administration.</hi></p>
                <table cols="2" rows="6">
                    <row role="label">
                        <cell>Japanese officers (Sonin rank)</cell>
                        <cell role="num">4</cell>
                    </row>
                    <row>
                        <cell>Japanese officers (Hannin rank)</cell>
                        <cell role="num">57</cell>
                    </row>
                    <row>
                        <cell>Japanese officers (Togai rank)</cell>
                        <cell role="num">58</cell>
                    </row>
                    <row>
                        <cell>European officers</cell>
                        <cell role="num">4</cell>
                    </row>
                    <row>
                        <cell>Other employés</cell>
                        <cell rendition="#border-bottom" role="num">23</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell role="num">146</cell>
                    </row>
                </table>
                <pb facs="0790" n="694" xml:id="pg694"/>
                <p rendition="#center"><hi rendition="#small-caps">commercial staff.</hi></p>
                <table cols="2" rows="6">
                    <row role="label">
                        <cell>Japanese officers (Hannin)</cell>
                        <cell role="num">161</cell>
                    </row>
                    <row>
                        <cell>Japanese officers (Togai)</cell>
                        <cell role="num">259</cell>
                    </row>
                    <row>
                        <cell>European officers</cell>
                        <cell role="num">8</cell>
                    </row>
                    <row>
                        <cell>Students</cell>
                        <cell role="num">192</cell>
                    </row>
                    <row>
                        <cell>Messengers</cell>
                        <cell rendition="#border-bottom" role="num">234</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell role="num">854</cell>
                    </row>
                </table>
                <p rendition="#center"><hi rendition="#small-caps">engineering staff.</hi></p>
                <table cols="2" rows="7">
                    <row role="label">
                        <cell>Japanese officers (Hannin)</cell>
                        <cell role="num">87</cell>
                    </row>
                    <row>
                        <cell>Japanese officers (Togai)</cell>
                        <cell role="num">25</cell>
                    </row>
                    <row>
                        <cell>European officers</cell>
                        <cell role="num">14</cell>
                    </row>
                    <row>
                        <cell>Students</cell>
                        <cell role="num">18</cell>
                    </row>
                    <row>
                        <cell>Lineman and workmen</cell>
                        <cell rendition="#border-bottom" role="num">266</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell rendition="#border-bottom" role="num">410</cell>
                    </row>
                    <row>
                        <cell>Total</cell>
                        <cell role="num">1,410</cell>
                    </row>
                </table>
            </div>
        </body>
    </text>
