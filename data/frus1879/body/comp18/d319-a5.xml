    <text>
        <body>
            <div xml:id="d319-a5">

                <pb facs="0747" n="651" xml:id="pg651"/>

                <opener><seg rendition="#center">[Inclosure 5 in No. 918.—Extract from the Japan
                        Daily Herald, July 11, 1879.</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Consulate-General</hi>,<lb/><hi rendition="#italic"
                                >Kanagawa</hi></placeName>, <date calendar="gregorian"
                            when="1879-07-11"><hi rendition="#italic">July</hi> 11,
                        1879</date>.</dateline></opener>
                <p rendition="#center"><hi rendition="#small-caps">quarantine regulations.</hi></p>
                <p>By instructions from the United States minister in Japan, I hereby make public
                    the quarantine regulations enacted by the Japanese Government, which are to be
                    observed by all American vessels.</p>
                <closer><signed>THOS. B. VAN BUREN,<lb/><hi rendition="#italic">United States
                            Consul-General.</hi></signed></closer>


                <xi:include href="d319-a5-a1.xml" xpointer="d319-a5-a1"/>
