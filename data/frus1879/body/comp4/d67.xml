    <text>
        <body>
            <div xml:id="d67">

                <pb facs="0212" n="116" xml:id="pg116"/>

                <head>No. 56.<lb/><hi rendition="#italic">Mr. Evarts to Mr. Van den
                    Bossche.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1879-01-31"><hi rendition="#italic">January</hi> 31,
                        1879</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of the 6th instant relating to the system of admeasurement of
                    vessels under Belgian laws, and in reply to transmit herewith a copy of a
                    communication from the Secretary of the Treasury presenting certain
                    considerations on the subject.</p>
                <p>Accept, sir, a renewed assurance of my high consideration.</p>
                <closer><signed>WM. M. EVARTS.</signed></closer>


                <xi:include href="d67-a1.xml" xpointer="d67-a1"/>
            </div>
