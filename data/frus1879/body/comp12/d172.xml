    <text>
        <body>
            <div xml:id="d172">

                <pb facs="0408" n="312" sameAs="frus:frus1879/pg312"/>

                <head>No. 150.<lb/><hi rendition="#italic">Mr. Noyes to Mr. Evarts.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1879-01-24"><hi rendition="#italic">January</hi> 24,
                        1879</date>.</dateline>
                    <seg rendition="#float-left">No. 188.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith four
                    copies of the second report of the Committee of Weights and Measures, for the
                    year 1878.</p>
                <p>I have the honor to be, your obedient servant,</p>
                <closer><signed>EDWARD F. NOYES.</signed></closer>


                <xi:include href="d172-a1.xml" xpointer="d172-a1"/>
