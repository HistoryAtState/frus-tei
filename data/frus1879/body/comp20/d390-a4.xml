    <text>
        <body>
            <div xml:id="d390-a4">

                <pb facs="0920" n="824" xml:id="pg824"/>

                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <head>No. 2.<lb/><hi rendition="#italic">A table showing the amount of silver and
                        gold, coined and in bullion, which has been exported from the Mexican
                        Republic during the fiscal years stated, as follows:</hi></head>
                <table cols="4" rows="6">
                    <row role="label">
                        <cell rendition="#border-bottom #border-top #border-right" rows="2">Fiscal
                            year—</cell>
                        <cell cols="3" rendition="#border-bottom #border-top">Silver.</cell>
                    </row>
                    <row>
                        <cell rendition="#border-bottom #border-top #border-right">Coined.</cell>
                        <cell rendition="#border-bottom #border-top #border-right">Worked.</cell>
                        <cell rendition="#border-bottom #border-top">Bullion.</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">1872–’73</cell>
                        <cell rendition="#border-right #nowrap" role="num">$22,626,064 57</cell>
                        <cell rendition="#border-right #nowrap" role="num">$8,715 61</cell>
                        <cell rendition="#nowrap" role="num">$1,459,426 38</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">1873–’74</cell>
                        <cell rendition="#border-right #nowrap" role="num">17,021,404 91</cell>
                        <cell rendition="#border-right #nowrap" role="num">1,359 31</cell>
                        <cell rendition="#nowrap" role="num">1,217,853 14</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">1874–’75</cell>
                        <cell rendition="#border-right #border-bottom #nowrap" role="num">14,190,771
                            85</cell>
                        <cell rendition="#border-right #border-bottom #nowrap" role="num">3,920
                            42</cell>
                        <cell rendition="#border-bottom #nowrap" role="num">1,843,522 95</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right #border-bottom">Totals</cell>
                        <cell rendition="#border-right #border-bottom #nowrap" role="num">53,838,241
                            33</cell>
                        <cell rendition="#border-right #border-bottom #nowrap" role="num">13,995
                            34</cell>
                        <cell rendition="#border-bottom #nowrap" role="num">4,520,802 37</cell>
                    </row>
                </table>
                <table cols="6" rows="6">
                    <row role="label">
                        <cell rendition="#border-bottom #border-top #border-right" rows="2">Fiscal
                            year—</cell>
                        <cell cols="2" rendition="#border-bottom #border-top #border-right"
                            >Gold.</cell>
                        <cell rendition="#border-bottom #border-top #border-right" rows="2">Total
                            silver.</cell>
                        <cell rendition="#border-bottom #border-top #border-right" rows="2">Total
                            gold.</cell>
                        <cell rendition="#border-bottom #border-top" rows="2">General total.</cell>
                    </row>
                    <row>
                        <cell rendition="#border-bottom #border-top #border-right">Coined.</cell>
                        <cell rendition="#border-bottom #border-top #border-right">Bullion.</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">1872–’73</cell>
                        <cell rendition="#border-right #nowrap" role="num">$636,737 96</cell>
                        <cell rendition="#border-right #nowrap" role="num">$286,791 50</cell>
                        <cell rendition="#border-right #nowrap" role="num">$24,094,206 46</cell>
                        <cell rendition="#border-right #nowrap" role="num">$923,529 46</cell>
                        <cell rendition="#nowrap" role="num">$25,017,735 92</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">1873–’74</cell>
                        <cell rendition="#border-right #nowrap" role="num">2,081,949 20</cell>
                        <cell rendition="#border-right #nowrap" role="num">487,192 19</cell>
                        <cell rendition="#border-right #nowrap" role="num">18,240,617 36</cell>
                        <cell rendition="#border-right #nowrap" role="num">2,569,141 39</cell>
                        <cell rendition="#nowrap" role="num">20,809,758 75</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">1874–’75</cell>
                        <cell rendition="#border-right #border-bottom #nowrap" role="num">2,701,478
                            00</cell>
                        <cell rendition="#border-right #border-bottom #nowrap" role="num">194,387
                            00</cell>
                        <cell rendition="#border-right #border-bottom #nowrap" role="num">16,038,215
                            22</cell>
                        <cell rendition="#border-right #border-bottom #nowrap" role="num">2,895,865
                            00</cell>
                        <cell rendition="#border-bottom #nowrap" role="num">18,934,080 22</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right #border-bottom">Totals</cell>
                        <cell rendition="#border-right #border-bottom #nowrap" role="num">5,420,165
                            16</cell>
                        <cell rendition="#border-right #border-bottom #nowrap" role="num">968,370
                            69</cell>
                        <cell rendition="#border-right #border-bottom #nowrap" role="num">58,373,039
                            04</cell>
                        <cell rendition="#border-right #border-bottom #nowrap" role="num">6,388,535
                            85</cell>
                        <cell rendition="#border-bottom #nowrap" role="num">64,761,574 89</cell>
                    </row>
                </table>
                <closer>
                    <dateline rendition="#float-left"><placeName>Mexico</placeName>, <date
                            calendar="gregorian" when="1879-07-26">July 26,
                    1879</date>.</dateline><lb/>For the chief of the section:<lb/><signed>M.
                            OROSCA,<lb/><hi rendition="#italic">First Clerk.</hi></signed></closer>
            </div>
        </body>
    </text>
</TEI>
