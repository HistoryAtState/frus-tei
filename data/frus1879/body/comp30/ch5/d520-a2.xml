    <text>
        <body>
            <div xml:id="d520-a2">

                <pb facs="1130" n="1034" sameAs="frus:frus1879/pg1034"/>

                <opener><seg rendition="#center">[Inclosure 2 in Mr. Van Dyck’s
                        dispatch.]</seg><lb/><dateline rendition="#center">[From the Phare
                            d’<placeName>Alexandria</placeName> of Thursday, <date
                            calendar="gregorian" when="1879-10-16">October 16,
                        1879</date>.]</dateline></opener>
                <p rendition="#center"><hi rendition="#italic">Number of vessels of each
                        nation.</hi></p>
                <table cols="3" rows="11">
                    <row role="label">
                        <cell rendition="#border-bottom #border-top #border-right"
                            >Nationality.</cell>
                        <cell rendition="#border-bottom #border-top #border-right">No. of
                            vessels.</cell>
                        <cell rendition="#border-bottom #border-top">Remarks.</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">English</cell>
                        <cell rendition="#border-right" role="num">8,007</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell rendition="#border-right">French</cell>
                        <cell rendition="#border-right" role="num">741</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell rendition="#border-right">Holland</cell>
                        <cell rendition="#border-right" role="num">363</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell rendition="#border-right">Austria-Hungary</cell>
                        <cell rendition="#border-right" role="num">482</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell rendition="#border-right">Italian</cell>
                        <cell rendition="#border-right" role="num">445</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell rendition="#border-right">Spanish</cell>
                        <cell rendition="#border-right" role="num">150</cell>
                        <cell rendition="#border-bottom" rows="5">If the British interest in the
                            canal of Suez be represented by the figure 8, the interest of all the
                            other nations together falls short of the figure 3.</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">German</cell>
                        <cell rendition="#border-right" role="num">208</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">Ottoman</cell>
                        <cell rendition="#border-right" role="num">146</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">Egyptian</cell>
                        <cell rendition="#border-right" role="num">148</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right #border-bottom">Divers nations</cell>
                        <cell rendition="#border-bottom" role="num">298</cell>
                    </row>
                </table>
            </div>
