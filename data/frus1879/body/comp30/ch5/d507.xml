                <pb facs="1089" n="993" sameAs="frus:frus1879/pg993"/>

                <head>No. 475.<lb/><hi rendition="#italic">Mr. Farman to Mr. Evarts.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Agency and Consulate-General of the United States in
                                Egypt</hi>,<lb/><hi rendition="#italic">Cairo</hi></placeName>,
                            <date calendar="gregorian" when="1879-02-03"><hi rendition="#italic"
                                >February</hi> 3, 1879</date>. (Received March 1.)</dateline>
                    <seg rendition="#float-left">No. 277.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith a
                    short article upon the Suez Canal, for such use as you may deem proper.</p>
                <p>I am, sir, &amp;c.,</p>
                <closer><signed>E. E. FARMAN.</signed></closer>
            </div>
        </body>
