    <text>
        <body>
            <div xml:id="d231">

                <pb facs="0564" n="468" xml:id="pg468"/>

                <head>No. 210.<lb/><hi rendition="#italic">Mr. Hoppin to Mr. Evarts.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1879-10-18"><hi rendition="#italic">October</hi> 18, 1879</date>.
                        (Received October 30.)</dateline>
                    <seg rendition="#float-left">No. 78.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith copies
                    of an extract from to-day’s Times, containing a report of the speeches delivered
                    by Lord Salisbury at Manchester yesterday in defense of the government.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>W. J. HOPPIN.</signed></closer>


                <xi:include href="d231-a1.xml" xpointer="d231-a1"/>
            </div>
        </body>
