    <text>
        <body>
            <div xml:id="d242-a3">

                <pb facs="0588" n="492" sameAs="frus:frus1879/pg492"/>

                <opener><seg rendition="#center">[First indorsement.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Headquarters Military Division of the Missouri</hi>,<lb/><hi
                                rendition="#italic">Chicago</hi></placeName>, <date
                            calendar="gregorian" when="1879-04-08"><hi rendition="#italic"
                                >April</hi> 8, 1879</date>.</dateline></opener>
                <p>Respectfully forwarded to the Adjutant-General of the Army.</p>
                <p>The firm named in this connection is engaged in the raw-hide business in this
                    city, and has a good standing in the mercantile community.</p>
                <closer><signed>P. H. SHERIDAN,<lb/><hi rendition="#italic"
                        >Lieutenant-General.</hi></signed></closer>
            </div>
        </body>
    </text>
