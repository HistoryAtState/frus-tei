    <text>
        <body>
            <div xml:id="d217">

                <pb facs="0525" n="429" xml:id="pg429"/>

                <head>No. 196.<lb/><hi rendition="#italic">Mr. Welsh to Mr. Evarts.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1879-04-15"><hi rendition="#italic">April</hi> 15, 1879</date>.
                        (Received April 26.)</dateline>
                    <seg rendition="#float-left">No. 261.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to your dispatch No. 233, of the
                    18th of February last, I have now the honor to inclose herewith a copy of a
                    report of the commissioners of inland revenue concerning taxation of railroads
                    in this country, which has just been received from Lord Salisbury.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>JOHN WELSH.</signed></closer>


                <xi:include href="d217-a1.xml" xpointer="d217-a1"/>
