    <text>
        <body>
            <div xml:id="d226">

                <pb facs="0547" n="451" sameAs="frus:frus1879/pg451"/>

                <head>No. 205.<lb/><hi rendition="#italic">Mr. Hoppin to Mr. Evarts.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1879-09-05"><hi rendition="#italic">September</hi> 5, 1879</date>.
                        (Received September 17.)</dateline>
                    <seg rendition="#float-left">No. 41.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith an
                    extract (in duplicate) from the Daily News of the 3d instant, in relation to our
                    claim for damages arising out of the transactions in Fortune Bay.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>W. J. HOPPIN.</signed></closer>



                <xi:include href="d226-a1.xml" xpointer="d226-a1"/>
            </div>
