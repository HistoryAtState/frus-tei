    <text>
        <body>
            <div xml:id="d227">

                <pb facs="0549" n="453" sameAs="frus:frus1879/pg453"/>

                <head>No. 206.<lb/><hi rendition="#italic">Mr. Hoppin to Mr. Evarts.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1879-09-19"><hi rendition="#italic">September</hi> 19,
                        1879</date>. (Received October 8.)</dateline>
                    <seg rendition="#float-left">No. 53.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith
                    reports (in duplicate) from the Daily News of this date, of speeches lately
                    delivered by the Earl of Beaconsfield, Earl Derby, and others, in relation to
                    the prevalent agricultural and commercial distress in Great Britain.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>W. J. HOPPIN.</signed></closer>



                <xi:include href="d227-a1.xml" xpointer="d227-a1"/>
