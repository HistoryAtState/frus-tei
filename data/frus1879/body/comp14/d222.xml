    <text>
        <body>
            <div xml:id="d222">

                <pb facs="0537" n="441" xml:id="pg441"/>

                <head>No. 201.<lb/><hi rendition="#italic">Mr. Welsh to Mr. Evarts.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1879-07-18"><hi rendition="#italic">July</hi> 18, 1879</date>.
                        (Received July 30.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I send you copies of two communications on
                    bi-metallism by George McHenry.</p>
                <p>I think you will find these papers interesting.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>JOHN WELSH.</signed></closer>



                <xi:include href="d222-a1.xml" xpointer="d222-a1"/>
