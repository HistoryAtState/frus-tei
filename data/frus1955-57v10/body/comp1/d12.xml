            <note corresp="#d12-f2" n="2" xml:id="d12-f2-content">
                <p>For example: <list>
                        <item>Korea</item>
                        <item>Iran</item>
                        <item>Cambodia</item>
                        <item>Formosa</item>
                        <item>Japan</item>
                        <item>Thailand</item>
                        <item>Turkey</item>
                        <item>Vietnam</item>
                        <item>Spain</item>
                        <item>Pakistan</item>
                        <item>Laos</item>
                        <item>Philippines</item>
                    </list> [Footnote in the source text.]</p>
            </note>
