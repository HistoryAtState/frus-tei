    <text>
        <body>
            <div xml:id="d279">

                <pb facs="0890" n="853" xml:id="pg853"/>

                <head>279. Memorandum From the Executive Secretary of the Department of State
                        (Tarnoff) to the President’s
                    Assistant for National Security Affairs (Brzezinski)<anchor n="1" xml:id="d279-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            when="1977-05-28">May 28, 1977</date>
                    </dateline>
                </opener>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>Sanders Associates of New Hampshire—Maritime Surveillance System Contract
                        with South African Government</item>
                </list>
                <p>Pursuant to the request the Department received from the National Security
                        Council,<anchor n="2" xml:id="d279-f2"/> attached is a paper setting forth
                    the position of the Department of State on this matter.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Peter
                            Tarnoff</hi>
                    </signed>
                </closer>


                <xi:include href="d279-a1.xml" xpointer="d279-a1"/>
            </div>
        </body>
    </text>
