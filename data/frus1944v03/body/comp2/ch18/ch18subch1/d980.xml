    <text>
        <body>
            <div xml:id="d980">

                <pb facs="1074" n="1062" sameAs="frus:frus1944v03/pg1062"/>

                <note rend="inline" type="source">865.01/2704</note>
                <head>
                    <hi rendition="#italic">The Ambassador of the Soviet Union</hi> (<hi rendition="#italic">Gromyko</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-03-19">March 19, 1944</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: On behalf of the Soviet
                    Government I am forwarding to you the enclosed memorandum.</p>
                <p>The first part of the memorandum is being transmitted for the information of the
                    Government of the United States in view of the importance of the questions
                    touched upon in this part.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>A. <hi rendition="#small-caps">Gromyko</hi>
                    </signed>
                </closer>


                <xi:include href="d980-a1.xml" xpointer="d980-a1"/>
