            </note>
            <note corresp="#d925-f2" n="23" xml:id="d925-f2-content">
                <p>Vyacheslav Mikhailovich Molotov, People’s Commissar for Foreign Affairs of the
                    Soviet Union.</p>
            </note>
            <note corresp="#d925-f3" n="24" xml:id="d925-f3-content">
                <p>Anthony Eden, British Secretary of State for Foreign Affairs.</p>
            </note>
        </listAnnotation>
