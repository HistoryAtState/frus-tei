    <text>
        <body>
            <div xml:id="d964">

                <pb facs="1057" n="1045" sameAs="frus:frus1944v03/pg1045"/>

                <note rend="inline" type="source">865.01/2701</note>
                <head>
                    <hi rendition="#italic">The First Secretary of the British Embassy</hi>
                        (<hi rendition="#italic">Hayter</hi>) <hi
                        rendition="#italic">to Mr. J. Wesley Jones of
                        the Division of Southern European Affairs</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-03-13">March 13, 1944</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Johnny</hi>: I send you for your information a
                    copy of a telegram sent on March 12th by the Foreign Office to the British
                    Ambassador in Moscow.</p>
                <p>Yours sincerely,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">William Hayter</hi>
                    </signed>
                </closer>



                <xi:include href="d964-a1.xml" xpointer="d964-a1"/>
