                <pb facs="0797" n="785" xml:id="pg785"/>

                <head>Germany:</head>
                <p>[For correspondence regarding consideration in the European Advisory Commission
                    of surrender terms and controls for Germany and for Austria, see <ref
                        target="frus:frus1944v01">volume I</ref>, section entitled “Participation by
                    the United States in the work of the European Advisory Commission”, parts V and
                    VI, respectively. See also <hi rendition="#italic">ibid</hi>., section entitled
                    “Consideration of the application of ‘unconditional surrender’ terms to Germany;
                    unofficial peace feelers from Germany.”]</p>


                <xi:include href="ch14/ch14subch1.xml" xpointer="ch14subch1"/>
