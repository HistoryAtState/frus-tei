    <text>
        <body>
            <div xml:id="d755">

                <pb facs="0837" n="825" sameAs="frus:frus1944v03/pg825"/>

                <note rend="inline" type="source">800.515/932: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the Soviet Union</hi> (<hi rendition="#italic">Harriman</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Moscow</hi></placeName>, <date
                            calendar="gregorian" when="1944-01-18T21:00:00+03:00">January 18, 1944—9
                            p.m.</date>
                        <lb/> [Received January 19—1:40 p.m.]</dateline>
                </opener>
                <p>165. I transmitted to Molotov<anchor n="69" xml:id="d755-f1"/> on January 17 the
                    information contained in the Department’s 85, January 14, 11 p.m., and requested
                    an urgent reply.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Harriman</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d755-f1" n="69" xml:id="d755-f1-content">
                <p>Vyacheslav Mikailovich Molotov, People’s Commissar for Foreign Affairs of the
                    Soviet Union.</p>
            </note>
        </listAnnotation>
    </standOff>
