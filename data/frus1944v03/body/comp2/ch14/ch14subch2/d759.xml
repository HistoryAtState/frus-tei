    <text>
        <body>
            <div xml:id="d759">

                <pb facs="0840" n="828" sameAs="frus:frus1944v03/pg828"/>

                <note rend="inline" type="source">800.515/944: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the United Kingdom</hi> (<hi
                        rendition="#italic">Winant</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1944-01-31T16:00:00+01:00">January 31, 1944—4
                            p.m.</date>
                        <lb/> [Received January 31—12:45 p.m.]</dateline>
                </opener>
                <p>846. Your 707 January 28 received this morning. I have already taken this matter
                    up with Mr. Eden<anchor n="74" xml:id="d759-f1"/> and he has promised to act on
                    it.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Winant</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d759-f1" n="74" xml:id="d759-f1-content">
                <p>Anthony Eden, British Secretary of State for Foreign Affairs.</p>
            </note>
        </listAnnotation>
    </standOff>
