    <text>
        <body>
            <div xml:id="d1303">

                <pb facs="1440" n="1428" sameAs="frus:frus1944v03/pg1428"/>

                <note rend="inline" type="source">860C.01/8–344: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the Soviet Union</hi> (<hi rendition="#italic">Harriman</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Extract]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Moscow</hi></placeName>, <date
                            calendar="gregorian" when="1944-08-03T20:00:00+03:00">August 3, 1944—8
                            p.m.</date>
                        <lb/> [Received August 4—8:55 a.m.]</dateline>
                </opener>
                <p>2856. Press for August 2 reported the appointment of Nikolai Aleksandrovich
                        Bulganin<anchor n="95" xml:id="d1303-f1"/> as representative of USSR Supreme
                    Soviet to Polish Committee of National Liberation.</p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Harriman</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1303-f1" n="95" xml:id="d1303-f1-content">
                <p>Nikolay Alexandrovich Bulganin (Lieutenant General; Colonel General, July 1944;
                    Army General, November 1944) acted as a chief political officer on several
                    fronts during the war.</p>
            </note>
        </listAnnotation>
    </standOff>
