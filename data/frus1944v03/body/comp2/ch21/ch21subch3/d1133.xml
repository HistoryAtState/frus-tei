    <text>
        <body>
            <div xml:id="d1133">

                <pb facs="1223" n="1211" sameAs="frus:frus1944v03/pg1211"/>

                <note rend="inline" type="source">841.79658/79: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the United Kingdom</hi> (<hi
                        rendition="#italic">Winant</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1944-03-09T19:00:00+01:00">March 9, 1944—7
                            p.m.</date>
                        <lb/> [Received March 9—4:20 p.m.]</dateline>
                </opener>
                <p>1921. For the Acting Secretary. Your 1764 of March 8. I have been promised an
                    answer by Eden<anchor n="31" xml:id="d1133-f1"/> within 48 hours. I hope it will
                    be favorable.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Winant</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1133-f1" n="31" xml:id="d1133-f1-content">
                <p>Anthony Eden, British Secretary of State for Foreign Affairs.</p>
            </note>
        </listAnnotation>
    </standOff>
