    <text>
        <body>
            <div xml:id="d607">

                <pb facs="0685" n="673" xml:id="pg673"/>

                <note rend="inline" type="source">851.01/3639: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Acting American Representative to the French Committee of National
                        Liberation at Algiers</hi> (<hi rendition="#italic"
                            >Chapin</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-04-07T22:00:00-04:00">April 7, 1944—10
                            p.m.</date>
                    </dateline>
                </opener>
                <p>1055. For Murphy. We are in full agreement with your conclusion in your 1149,
                    April 6, that we should interpose no objection to Giraud’s departure.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
