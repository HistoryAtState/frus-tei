    <text>
        <body>
            <div xml:id="d716">

                <pb facs="0790" n="778" sameAs="frus:frus1944v03/pg778"/>

                <note rend="inline" type="source">740.0011 P.W./11–244</note>
                <head>
                    <hi rendition="#italic">Memorandum by the Under Secretary of State</hi>
                        (<hi rendition="#italic">Stettinius</hi>)
                        <hi rendition="#italic">to President Roosevelt
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1944-11-02">November 2, 1944</date>.</dateline>
                </opener>
                <p rendition="#center">
                    <hi rendition="#small-caps">Indochina</hi>
                </p>
                <p>In order that you may be kept fully informed on developments in relation to
                    Indochina, there has been prepared the memorandum attached hereto.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Edward</hi> R. <hi rendition="#small-caps"
                            >Stettinius, Jr</hi>.</signed>
                </closer>


                <xi:include href="d716-a1.xml" xpointer="d716-a1"/>
