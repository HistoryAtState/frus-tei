                <pb facs="0231" n="219" sameAs="frus:frus1944v03/pg219"/>

                <note rend="inline" type="source">841D.01/236: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in Ireland</hi>
                        (<hi rendition="#italic">Gray</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-02-08T10:00:00-04:00">February 8,
                            1944—10 a.m.</date>
                    </dateline>
                </opener>
                <p>14. We fully approve the changes suggested in your No. 17, February 5 and are so
                    informing London.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
