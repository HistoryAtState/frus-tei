                <pb facs="0116" n="104" sameAs="frus:frus1944v03/pg104"/>

                <note rend="inline" type="source">800.6363/1515: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the United Kingdom</hi> (<hi rendition="#italic">Winant</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1944-03-06T18:00:00+01:00">March 6, 1944—6
                            p.m.</date>
                        <lb/> [Received March 6—12:35 p.m.]</dateline>
                </opener>
                <p>1822. Personal for the Acting Secretary of State. Your 1680, March 5. Please
                    postpone statement until tomorrow. Cabinet meeting for decision this
                    evening.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Winant</hi>
                    </signed>
                </closer>
            </div>
        </body>
