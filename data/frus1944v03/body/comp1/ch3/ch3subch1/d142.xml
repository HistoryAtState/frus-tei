    <text>
        <body>
            <div xml:id="d142">

                <pb facs="0224" n="212" sameAs="frus:frus1944v03/pg212"/>

                <note rend="inline" type="source">842.20 Defense/12–3044</note>
                <head>
                    <hi rendition="#italic">The American Ambassador in Canada</hi> (<hi rendition="#italic">Atherton</hi>) <hi
                        rendition="#italic">to the Canadian Secretary of State for External
                        Affairs</hi> (<hi rendition="#italic">Mackenzie
                            King</hi>)<anchor n="4" xml:id="d142-f1"/>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 262</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Ottawa</hi></placeName>, <date
                            calendar="gregorian" when="1944-12-30">December 30,
                        1944</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the
                    receipt of your note No. 141 of December 28, 1944, concerning the acquisition by
                    the Canadian <pb facs="0225" n="213" xml:id="pg213"/> Government of land
                    required by the United States for the purpose of carrying out defence projects
                    in Canada.</p>
                <p>In reply I am pleased to be able to inform you that the proposals for the purpose
                    of solving the problem of acquisition of land for United States defence
                    projects, which are set forth in the memorandum enclosed with your note, are
                    acceptable to my Government.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Ray Atherton</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d142-f1" n="4" type="source" xml:id="d142-f1-content">
                <p>Copy transmitted to the Department by the Ambassador in Canada in his letter of
                    December 30, 1944, not printed. The acceptance by the Embassy of the Canadian
                    proposals was made on basis of telephone instructions from the Department of
                    State.</p>
            </note>
        </listAnnotation>
    </standOff>
