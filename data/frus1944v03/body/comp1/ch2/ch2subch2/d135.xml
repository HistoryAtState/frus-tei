                <p>Dated December 23, not printed.</p>
            </note>
            <note corresp="#d135-f2" n="49" xml:id="d135-f2-content">
                <p>Herbert V. Evatt, Australian Minister for External Affairs.</p>
            </note>
        </listAnnotation>
