    <text>
        <body>
            <div xml:id="d44-a1">

                <pb facs="0190" n="166" sameAs="frus:frus1955-57v19/pg166"/>


                <head>FINANCIAL ANNEX</head>
                <p rendition="#center">Estimated Funds Required by Fiscal Year (millions)</p>
                <table cols="4" rows="3">
                    <row>
                        <cell/>
                        <cell>1955</cell>
                        <cell>1956</cell>
                        <cell>1957</cell>
                    </row>
                    <row>
                        <cell>ICBM</cell>
                        <cell role="num">$ 156</cell>
                        <cell role="num">$ 355</cell>
                        <cell role="num">$ 582(1)</cell>
                    </row>
                    <row>
                        <cell>IRBM</cell>
                        <cell/>
                        <cell role="num">89.0</cell>
                        <cell role="num">269 (2)</cell>
                    </row>
                </table>
                <list>
                    <label>(1)</label>
                    <item>Includes $30 millions for two U.S. launching bases to provide an emergency
                        operational capability; does not include a possible additional $25 million
                        which may be required primarily for range improvement purposes.</item>
                    <label>(2)</label>
                    <item>Does not include funding for advanced bases or ship modification that
                        would be required to provide an operational capability.</item>
                </list>
            </div>
        </body>
