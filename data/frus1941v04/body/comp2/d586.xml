    <text>
        <body>
            <div xml:id="d586">

                <pb facs="0767" n="759" sameAs="frus:frus1941v04/pg759"/>

                <note rend="inline" type="source">811B.20/39: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in China</hi> (<hi rendition="#italic"
                        >Gauss</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Chungking</hi></placeName>, <date
                            calendar="gregorian" when="1941-12-20T13:00:00+07:00">December 20,
                            1941—1 p.m.</date>
                        <lb/> [Received December 20—12:46 p.m.]</dateline>
                </opener>
                <p>For the United States High Commissioner:<anchor n="76" xml:id="d586-f1"/>
                    <quote rend="blockquote">
                        <p>“Chinese Foreign Office has informed Embassy of the Chinese Government’s
                            desire that the Philippine authorities permit the organization in the
                            Philippines of a Chinese volunteer corps to fight side by side with
                            Americans and Filipinos. Foreign Office stresses beneficial
                            psychological effect upon large population in the Islands and requests
                            that you approach the Philippine Government.”<anchor n="77"
                                xml:id="d586-f2"/>
                        </p>
                    </quote>
                </p>
                <p>Sent to Manila; repeated to Department.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Gauss</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d586-f1" n="76" xml:id="d586-f1-content">
                <p>Francis B. Sayre, at Manila.</p>
            </note>
            <note corresp="#d586-f2" n="77" xml:id="d586-f2-content">
                <p>Ambassador Gauss was instructed on December 27 to inform the Chinese Foreign
                    Office that the offer was greatly appreciated and was receiving active
                    consideration.</p>
            </note>
        </listAnnotation>
    </standOff>
