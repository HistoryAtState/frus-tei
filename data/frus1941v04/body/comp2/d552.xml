    <text>
        <body>
            <div xml:id="d552">

                <pb facs="0743" n="735" xml:id="pg735"/>

                <note rend="inline" type="source">740.0011 Pacific War/854e: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in the United Kingdom</hi> (<hi
                            rendition="#italic">Winant</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1941-12-08T15:00:00-05:00">December 8, 1941—3
                            p.m.</date>
                    </dateline>
                </opener>
                <p>5749. For the Former Naval Person<anchor n="16" xml:id="d552-f1"/> from the
                    President.</p>
                <quote rend="blockquote">
                    <p>“The Senate passed the all-out declaration of war 82 to nothing, and the
                        House has passed it 388 to 1. Today all of us are in the same boat with you
                        and the people of the Empire and it is a ship which will not and cannot be
                        sunk.”</p>
                </quote>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d552-f1" n="16" xml:id="d552-f1-content">
                <p>Code name for Winston Churchill.</p>
