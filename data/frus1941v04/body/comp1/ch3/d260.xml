    <text>
        <body>
            <div xml:id="d260">

                <pb facs="0373" n="365" sameAs="frus:frus1941v04/pg365"/>

                <note rend="inline" type="source">894.002/472: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Japan</hi> (<hi rendition="#italic"
                        >Grew</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Tokyo</hi></placeName>, <date
                            calendar="gregorian" when="1941-08-15T16:00:00+09:00">August 15, 1941—4
                            p.m.</date>
                        <lb/> [Received August 15—8:48 a.m.]</dateline>
                </opener>
                <p>1243. An official of the Foreign Office told a member of the Embassy staff that
                        Hiranuma’s<anchor n="89" xml:id="d260-f1"/> assailant was a member of a
                    “radical” organization entitled the Mitsubikai and that the motive for the
                    attack was undoubtedly resentment against Hiranuma’s efforts to bring about an
                    adjustment of Japanese-American relations.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Grew</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d260-f1" n="89" xml:id="d260-f1-content">
                <p>Baron Kiichiro Hiranuma, Japanese Vice Premier and Minister without
                    Portfolio.</p>
            </note>
        </listAnnotation>
    </standOff>
