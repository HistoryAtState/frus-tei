    <text>
        <body>
            <div xml:id="d515">

                <pb facs="0709" n="701" sameAs="frus:frus1941v04/pg701"/>

                <note rend="inline" type="source">740.0011 P. W./1245</note>
                <head>
                    <hi rendition="#italic">Memorandum by the Adviser on Political Relations</hi>
                        (<hi rendition="#italic">Hornbeck</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1941-12-01">December 1, 1941</date>.</dateline>
                </opener>
                <p>The Netherlands Minister informed me by telephone this morning that the
                    Government of the Netherlands East Indies had ordered a comprehensive
                    mobilization of its armed forces.</p>
                <closer>
                    <signed>S[<hi rendition="#small-caps">tanley</hi>] K. H[<hi
                            rendition="#small-caps">ornbeck</hi>]</signed>
                </closer>
            </div>
        </body>
