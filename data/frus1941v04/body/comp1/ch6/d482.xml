    <text>
        <body>
            <div xml:id="d482">

                <pb facs="0668" n="660" sameAs="frus:frus1941v04/pg660"/>

                <note rend="inline" type="source">793.94/17001⅘</note>
                <head>
                    <hi rendition="#italic">Dr. T. V. Soong, of
                        China Defense Supplies, Inc., to the Secretary of War</hi> (<hi rendition="#italic">Stimson</hi>)<anchor n="93"
                        xml:id="d482-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1941-11-25">November 25,
                        1941</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Secretary</hi>: I am in receipt of a
                    telegram from General Chiang Kai-shek, copy of which please find enclosed. I
                    shall be grateful if you could see me to discuss the message, or otherwise let
                    me know if you have any reply to give to General Chiang.</p>
                <p>With kind regards [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">T. V. Soong</hi>
                    </signed>
                </closer>


                <xi:include href="d482-a1.xml" xpointer="d482-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d482-f1" n="93" type="source" xml:id="d482-f1-content">
                <p>Copy transmitted to the Department by the War Department on December 2, pursuant
                    to a telephonic request made by the Assistant to the Secretary of State
                    (Gray).</p>
            </note>
