    <text>
        <body>
            <div xml:id="d540">

                <pb facs="0735" n="727" sameAs="frus:frus1941v04/pg727"/>

                <note rend="inline" type="source">711.94/254b: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Japan</hi>
                        (<hi rendition="#italic">Grew</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1941-12-06T20:00:00-05:00">December 6, 1941—8
                            p.m.</date>
                    </dateline>
                </opener>
                <p>817. An important telegram is now being encoded to you containing for
                    communication by you at earliest possible moment text of message from the
                    President to the Emperor.<anchor n="78" xml:id="d540-f1"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
