    <text>
        <body>
            <div xml:id="d70">

                <pb facs="0130" n="122" sameAs="frus:frus1941v04/pg122"/>

                <note rend="inline" type="source">894.00/995: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Japan</hi> (<hi rendition="#italic"
                            >Grew</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1941-04-05T14:00:00-05:00">April 5, 1941—2
                            p.m.</date>
                    </dateline>
                </opener>
                <p>217. The Department suggests that a conversation at this time with the principal
                        official<anchor n="77" xml:id="d70-f1"/> mentioned in your telegram 123,
                    January 27, 4 p.m., if feasible and in your discretion appropriate, might be
                    productive of helpful information.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d70-f1" n="77" xml:id="d70-f1-content">
                <p>Baron Hiranuma.</p>
            </note>
        </listAnnotation>
    </standOff>
