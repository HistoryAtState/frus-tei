            <div xml:id="d43">

                <pb facs="0069" n="61" xml:id="pg61"/>

                <note rend="inline" type="source">711.94/2005<hi rendition="#superscript">1/14</hi>
                </note>
                <head>
                    <hi rendition="#italic">The Postmaster General</hi> (<hi rendition="#italic"
                        >Walker</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1941-03-06">March 6, 1941</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Secretary</hi>: Attached you will find, for
                    your information, copy of memorandum presented to me last evening after my visit
                    with you.</p>
                <p>I am told that these are the matters they would discuss and reach agreement
                    upon.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Frank</hi>
                    </signed>
                </closer>


                <xi:include href="d43-a1.xml" xpointer="d43-a1"/>
