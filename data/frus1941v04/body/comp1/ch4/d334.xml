    <text>
        <body>
            <div xml:id="d334">

                <pb facs="0465" n="457" sameAs="frus:frus1941v04/pg457"/>

                <note rend="inline" type="source">793.94119/763: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Japan</hi> (<hi rendition="#italic"
                        >Grew</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Tokyo</hi></placeName>, <date
                            calendar="gregorian" when="1941-09-18T19:00:00+09:00">September 18,
                            1941—7 p.m.</date>
                        <lb/> [Received September 18—10:17 a.m.]</dateline>
                </opener>
                <p>1482. For the Secretary and the Under Secretary only. I have just received word
                    that the Prime Minister will communicate to me in the next day or two the peace
                    terms which Japan is prepared to present to China.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Grew</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
