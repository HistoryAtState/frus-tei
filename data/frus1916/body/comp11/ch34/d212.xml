    <text>
        <body>
            <div xml:id="d212">

                <pb facs="0299" n="223" sameAs="frus:frus1916/pg223"/>

                <note rend="inline" type="source">File No. 839.00/1810</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Minister Russell </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-05-02">
                            <hi rendition="#italic">May 2, 1916</hi></date>.</dateline>
                </opener>
                <p>Your May 1, 2 p.m., and April 27, 10 a.m. You will afford the President all
                    support and notify both factions by such means as you deem desirable of the
                    intention of this Government.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
