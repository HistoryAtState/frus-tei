    <text>
        <body>
            <div xml:id="d265-a1">

                <pb facs="0322" n="246" sameAs="frus:frus1916/pg246"/>

                <opener>
                    <seg rendition="#center">[Inclosure 1]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">Captain Knapp to Mr.
                            Brewer
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>U. S. S. <hi rendition="#italic">Olympia, <lb/> Santo
                                Domingo</hi></placeName>, <date calendar="gregorian"
                            when="1916-11-29">
                            <hi rendition="#italic">November 29, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I enclose copies of a Proclamation of
                    Occupation and Military Government in the Republic of Santo Domingo by the
                    forces under my command.</p>
                <p>I request that you will bring this proclamation to the notice of the proper
                    authorities of the Dominican Government.</p>
                <p>The hour set for making the proclamation effective is —.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">H. S. Knapp</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
