    <text>
        <body>
            <div xml:id="d530">

                <pb facs="0522" n="446" sameAs="frus:frus1916/pg446"/>

                <note rend="inline" type="source">File No. 761.94/125</note>
                <head>
                    <hi rendition="#italic">Ambassador Guthrie to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 613</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Tokyo</hi></placeName>, <date
                            calendar="gregorian" when="1916-09-13">
                            <hi rendition="#italic">September 13, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to my telegram of the 13th
                    instant, 6 p.m., upon the subject of the Russo-Japanese Convention, I have the
                    honor to transmit herewith, for the Department’s confidential information,
                    copies of the Foreign Office note<anchor n="6" xml:id="d530-f1"/> and memorandum
                    in question.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Geo. W. Guthrie</hi>
                    </signed>
                </closer>


                <xi:include href="d530-a1.xml" xpointer="d530-a1"/>
            </div>
        </body>
    </text>
