        <body>
            <div xml:id="d327">

                <pb facs="0369" n="293" xml:id="pg293"/>

                <note rend="inline" type="source">File No. 811.5241/83, 84</note>
                <head>
                    <hi rendition="#italic">Ambassador Page to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">London</hi></placeName>, <date
                            calendar="gregorian" when="1916-10-23">
                            <hi rendition="#italic">October 23, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith a
                    copy of the notice sent to the British Government, under date of September 13,
                    1916, that the Convention between the United States and Great Britain relative
                    to the tenure and disposition of real and personal property was extended and
                    applied to Island of Porto Rico.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Walter Hines Page</hi>
                    </signed>
                </closer>




                <xi:include href="d327-a1.xml" xpointer="d327-a1"/>
