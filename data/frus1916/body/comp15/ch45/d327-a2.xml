            <div xml:id="d327-a2">

                <pb facs="0369" n="293" sameAs="frus:frus1916/pg293"/>

                <opener>
                    <seg rendition="#center">[Subinclosure]</seg>
                </opener>
                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <p>By direction of the treaty-making power of the United States, the undersigned
                    Chargé d’Affaires of the United States of America has the honor, in conformity
                    with paragraph 3 of Article IV of the Convention between the United States and
                    Great Britain relating to the tenure and disposition of real and personal
                    property, signed at Washington on March 2, 1899, hereby to give formal notice to
                    His Britannic Majesty’s Government that the provisions of the said Convention
                    are from this date extended and applied to the Island of Porto Rico.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Irwin Laughlin</hi>
                    </signed><lb/>
                    <dateline rendition="#float-left">
                        <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                        <placeName>
                            <hi rendition="#italic">London</hi>
                        </placeName>, <date calendar="gregorian" when="1916-09-13"><hi
                                rendition="#italic">September 13, 1916</hi></date>.</dateline>
                </closer>
            </div>
