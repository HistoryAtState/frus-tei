    <text>
        <body>
            <div xml:id="d323-a2">

                <pb facs="0362" n="286" xml:id="pg286"/>

                <head>
                    <hi rendition="#italic">Message from the President to the Senate </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">The White House</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-04-12">
                            <hi rendition="#italic">April 12, 1916</hi></date>.</dateline>
                </opener>
                <p rendition="#flush">
                    <hi rendition="#small-caps">To the Senate</hi>:</p>
                <p>To the end that I may receive the necessary authority of the Senate to give, in
                    conformity with clause 3 of Article IV of the Convention relating to tenure and
                    disposition of real and personal property, concluded March 2, 1899, between the
                    United States and Great Britain, notice to the Government of Great Britain that
                    the provisions of the said Convention are extended and applied to the island of
                    Porto Rico, I herewith transmit a report by the Secretary of State, with
                    accompanying papers, on the subject.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Woodrow Wilson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
