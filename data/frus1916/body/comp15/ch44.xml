            <div xml:id="ch44">

                <pb facs="0355" n="279" sameAs="frus:frus1916/pg279"/>

                <head>Convention between the United States and Great Britain for the protection of
                    migratory birds</head>
                <p rendition="#flush">
                    <hi rendition="#italic">Signed at Washington, August 16, 1916; ratification
                        advised by the Senate, August 29, 1916; ratified by the President, September
                        1, 1916; ratified by Great Britain, October 20, 1916; ratifications
                        exchanged at Washington, December 7, 1916; proclaimed, December 8,
                        1916.</hi>
                </p>

