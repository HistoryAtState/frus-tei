            <div xml:id="d347">

                <pb facs="0381" n="305" xml:id="pg305"/>

                <note rend="inline" type="source">File No. 711.4216L/103</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            British Ambassador
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-07-05">
                            <hi rendition="#italic">July 5, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: I have the honor to acknowledge the
                    receipt of your note of June 27, 1916, in further relation to the rise in the
                    waters of the Lake of the Woods.</p>
                <p>In reply I have the honor to say that a copy of your note has been communicated
                    to the International Joint Commission for its information in connection with the
                    previous correspondence.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
