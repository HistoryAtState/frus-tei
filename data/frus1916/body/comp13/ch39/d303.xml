                <pb facs="0346" n="270" sameAs="frus:frus1916/pg270"/>

                <note rend="inline" type="source">File No. 351.117/57</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Ambassador Sharp </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-01-15">
                            <hi rendition="#italic">January 15, 1916</hi></date>.</dateline>
                </opener>
                <p>1317. Kirghis’s father naturalized October 22, 1894. Son highly respected citizen
                    of St. Cloud, Minnesota. Make strong representations for his release from
                    military service.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
