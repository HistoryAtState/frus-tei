    <text>
        <body>
            <div xml:id="d305">

                <pb facs="0347" n="271" sameAs="frus:frus1916/pg271"/>

                <note rend="inline" type="source">File No. 351.117/71</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Ambassador Sharp
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-03-04">
                            <hi rendition="#italic">March 4, 1916</hi></date>.</dateline>
                </opener>
                <p>1406. Louis Levy, born in New York City March 10, 1882, of French father, is
                    applying for removal his name from French military rolls. Extend good offices
                    his behalf.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
