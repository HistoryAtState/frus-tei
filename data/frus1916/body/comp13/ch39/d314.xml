            <div xml:id="d314">

                <pb facs="0350" n="274" sameAs="frus:frus1916/pg274"/>

                <note rend="inline" type="source">File No. 351.117/106</note>
                <head>
                    <hi rendition="#italic">Chargé Bliss to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 3882</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1916-11-04">
                            <hi rendition="#italic">November 4, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith a
                    copy and translation of a note received from the Foreign Office to the effect
                    that they have been notified by the Minister of War that Mr. Armand Robert
                    Garrot was discharged from the French Army as “Réformé No. 2” under date of
                    September 7 last.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Woods Bliss</hi>
                    </signed>
                </closer>


                <xi:include href="d314-a1.xml" xpointer="d314-a1"/>
            </div>
        </body>
    </text>
