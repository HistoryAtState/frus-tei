            <div xml:id="ch19">

                <pb facs="0122" n="46" sameAs="frus:frus1916/pg46"/>

                <head>Treaty for the advancement of general peace, concluded between the United
                    States and Chile</head>
                <p rendition="#flush">
                    <hi rendition="#italic">Signed at Washington, July 24, 1914; ratification
                        advised by the Senate, August 20, 1914; ratified by the President, November
                        11, 1915; ratified by Chile, November 9, 1915; ratifications exchanged at
                        Washington, January 19, 1916; proclaimed, January 22, 1916.</hi>
                </p>

