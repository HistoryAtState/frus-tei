    <text>
        <body>
            <div xml:id="d1166">

                <pb facs="0862" n="786" sameAs="frus:frus1916/pg786"/>

                <note rend="inline" type="source">File No. 312.115/274</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Vice Consul Blocker </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-09-11T16:00:00-05:00">
                            <hi rendition="#italic">September 11, 1916, 4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your telegram June 20, 10 a.m. Parker, Mexico City, telegraphs Foreign Office
                    denies confiscation property on American ranches along border.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
