                <pb facs="0860" n="784" sameAs="frus:frus1916/pg784"/>

                <note rend="inline" type="source">File No. 312.115B11/115</note>
                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-07-14T22:00:00-05:00">
                            <hi rendition="#italic">July 14, 1916, 10 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>209. Newspaper reports indicate <hi rendition="#italic">de facto</hi> Government
                    has taken possession of Babicora Ranch, Chihuahua, belonging Babicora
                    Development Company, American corporation.</p>
                <p>Request to be informed immediately whether report correct. If so immediately
                    lodge protest and ask for release of property.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Polk</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
