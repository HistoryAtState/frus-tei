    <text>
        <body>
            <div xml:id="d1055">

                <pb facs="0792" n="716" xml:id="pg716"/>

                <note rend="inline" type="source">File No. 812.512/1175</note>
                <head>
                    <hi rendition="#italic">Special Representative Rodgers to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Extract]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 25</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Mexico City</hi></placeName>, <date
                            calendar="gregorian" when="1916-04-20">
                            <hi rendition="#italic">April 20, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to forward herewith, in
                    duplicate, a translation of the proposed mining tax law which has been under
                    preparation by the Secretary of the Treasury of the Republic of Mexico. The
                    salient points of this law I transmitted to the Department by telegraph on the
                    19th.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">James L. Rodgers</hi>
                    </signed>
                </closer>


                <xi:include href="d1055-a1.xml" xpointer="d1055-a1"/>
            </div>
        </body>
    </text>
