    <text>
        <body>
            <div xml:id="d1051">

                <pb facs="0791" n="715" xml:id="pg715"/>

                <note rend="inline" type="source">File No. 812.512/1113</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Special Representative Rodgers
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegrams]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-03-31T16:00:00-05:00">
                            <hi rendition="#italic">March 31, 1916, 4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>19. Your 8, March 28, 1 a.m. It is suggested that you convey to <hi
                        rendition="#italic">de facto</hi> Government Department’s appreciation of
                    extension time-limit within which mining taxes may be paid.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
