            <div xml:id="d1100">

                <pb facs="0816" n="740" sameAs="frus:frus1916/pg740"/>

                <note rend="inline" type="source">File No. 812.512/1493</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Mr. Parker, representing
                        American interests</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-12-11T18:00:00-05:00">
                            <hi rendition="#italic">December 11, 1916, 6 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>582. Your 600, December 8. Make representations through Foreign Office, and
                    urgently request matter be brought to personal attention General Carranza, at
                    earliest possible moment.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
