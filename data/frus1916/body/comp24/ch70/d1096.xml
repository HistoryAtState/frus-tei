    <text>
        <body>
            <div xml:id="d1096">

                <pb facs="0814" n="738" sameAs="frus:frus1916/pg738"/>

                <note rend="inline" type="source">File No. 812.63/292</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Mr.
                            Parker, representing American
                        interests</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-11-18T17:00:00-05:00">
                            <hi rendition="#italic">November 18, 1916, 5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>560. American newspapers publish report that mining decree September 14 has been
                    extended until January 14 next. Ascertain and telegraph whether report
                    correct.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
