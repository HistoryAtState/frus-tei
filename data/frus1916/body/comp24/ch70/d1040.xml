    <text>
        <body>
            <div xml:id="d1040">

                <pb facs="0784" n="708" sameAs="frus:frus1916/pg708"/>

                <note rend="inline" type="source">File No. 812.512/1017</note>
                <head>
                    <hi rendition="#italic">Mr. Parker,
                        representing American interests, to the Secretary of
                            State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 273</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Mexico City</hi></placeName>, <date
                            calendar="gregorian" when="1916-01-26">
                            <hi rendition="#italic">January 26, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: For the information of the Department, I
                    have the honor to transmit herewith a translation of a circular, which has force
                    of law, promulgated by the Subsecretary of Finance of the <hi
                        rendition="#italic">de facto</hi> Government of Mexico with reference to the
                    payment of mining taxes.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Charles B. Parker</hi>
                    </signed>
                </closer>



                <xi:include href="d1040-a1.xml" xpointer="d1040-a1"/>
            </div>
        </body>
    </text>
