                <pb facs="0574" n="498" sameAs="frus:frus1916/pg498"/>

                <note rend="inline" type="source">File No. 812.00/17547</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of War to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">War Department</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-03-20">
                            <hi rendition="#italic">March 20, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I enclose for your information copy of a
                    telegram just received from General Funston.</p>
                <p>Very respectfully,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">H. L. Scott</hi>
                    </signed>
                </closer>



