                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Fort Sam Houston</hi></placeName>, <date
                            calendar="gregorian" when="1916-03-20">
                            <hi rendition="#italic">March 20, 1916</hi></date>.</dateline>
                </opener>
                <p>1099. Seven aeroplanes 1st aero squadron left Columbus for Casas Grandes
                    afternoon March 19. First squadron, 13th Cavalry, arrived Columbus March 19.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Funston</hi>
                    </signed>
                </closer>
