    <text>
        <body>
            <div xml:id="d594">

                <pb facs="0565" n="489" sameAs="frus:frus1916/pg489"/>

                <note rend="inline" type="source">File No. 812.00/17743</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Mr. Arredondo </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-03-13">
                            <hi rendition="#italic">March 13, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My dear Mr. Arredondo</hi>: I enclose for your
                    information and for that of the <hi rendition="#italic">de facto</hi> Government
                    of Mexico a statement which the President has authorized me to make public.</p>
                <p>With warm regards [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>


                <xi:include href="d594-a1.xml" xpointer="d594-a1"/>
