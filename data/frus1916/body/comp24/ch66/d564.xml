    <text>
        <body>
            <div xml:id="d564">

                <pb facs="0554" n="478" sameAs="frus:frus1916/pg478"/>

                <note rend="inline" type="source">File No. 123 R 61/167a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Consul General Rodgers </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-02-28">
                            <hi rendition="#italic">February 28, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: You are hereby instructed to proceed to
                    Mexico for duty as Special Representative of the Department of State near the
                        <hi rendition="#italic">de facto</hi> Government of Mexico, for the purpose
                    of carrying out the instructions which have been orally given to you at the
                    Department and such other instructions as may from time to time be issued to
                    you.</p>
                <p>You are authorized to travel to such points in Mexico as you may find necessary
                    in the carrying out of these instructions and your actual and necessary expenses
                    will be paid by the Department upon rendition by you of a separate account
                    supported by proper vouchers.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
