    <text>
        <body>
            <div xml:id="d647">

                <pb facs="0597" n="521" sameAs="frus:frus1916/pg521"/>

                <note rend="inline" type="source">File No. 812.00/17907</note>
                <head>
                    <hi rendition="#italic">General Funston to the
                            Adjutant General
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Extract]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Fort Sam Houston</hi></placeName>, <date
                            calendar="gregorian" when="1916-04-16">
                            <hi rendition="#italic">April 16, 1916</hi></date>.</dateline>
                </opener>
                <p>Following is from General Pershing: <quote rend="blockquote">
                        <p>Report Villa has gone southwest San Borja. No food, no forage of any
                            description vicinity Santa Cruz where troops now are. Shall withdraw
                            them by easy marches in direction of Satevo. Can not supply them from
                            San Antonio. I am <hi rendition="#italic">en route</hi> to
                            Namiquipa.</p>
                    </quote>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Funston</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
