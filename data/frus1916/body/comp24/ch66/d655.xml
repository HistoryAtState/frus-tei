            <div xml:id="d655">

                <pb facs="0600" n="524" sameAs="frus:frus1916/pg524"/>

                <note rend="inline" type="source">File No. 812.00/17894</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Consul Letcher </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-04-18T18:00:00-05:00">
                            <hi rendition="#italic">April 18, 1916, 6 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your April 17, 11 a.m. Rodgers has been instructed to make representations to the
                    end that local commanders be restrained from independent action.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
