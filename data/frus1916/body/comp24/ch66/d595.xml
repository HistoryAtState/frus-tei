    <text>
        <body>
            <div xml:id="d595">

                <pb facs="0565" n="489" sameAs="frus:frus1916/pg489"/>

                <note rend="inline" type="source">File No. 812.00/17468a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to certain American Consuls on
                        the Mexican Border </hi><anchor n="17" xml:id="d595-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Circular telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-03-13T18:00:00-05:00">
                            <hi rendition="#italic">March 13, 1916, 6 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Send daily telegraphic report of temper of populace on border, in your district,
                    and keep Department advised of name of Mexican commander where you are
                    stationed.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d595-f1" n="17" type="source" xml:id="d595-f1-content">
                <p>Sent to the Consuls at Brownsville, Laredo, Eagle Pass, El Paso and Nogales.</p>
            </note>
        </listAnnotation>
    </standOff>
