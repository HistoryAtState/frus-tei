                <pb facs="0643" n="567" sameAs="frus:frus1916/pg567"/>

                <note rend="inline" type="source">File No. 812.00/18324</note>
                <head>
                    <hi rendition="#italic">Special Representative Rodgers to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegrams]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Mexico City</hi></placeName>, <date
                            calendar="gregorian" when="1916-06-06T15:00:00-06:36">
                            <hi rendition="#italic">June 6, 1916, 3 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>117. In reply to Department’s 117 June 5, 4 p.m. Urgent representations made this
                    morning and immediate attention promised.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Rodgers</hi>
                    </signed>
                </closer>
            </div>
        </body>
