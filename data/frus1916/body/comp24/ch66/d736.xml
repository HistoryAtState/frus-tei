            <div xml:id="d736">

                <pb facs="0650" n="574" sameAs="frus:frus1916/pg574"/>

                <note rend="inline" type="source">File No. 812.00/18379</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Special Representative Rodgers
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-06-12T17:00:00-05:00">
                            <hi rendition="#italic">June 12, 1916, 5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>131. See Department’s 129. Bandits under de la Rosa invaded Texas forty-five
                    miles above Laredo Saturday night. Immediately inform appropriate
                    authorities.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
