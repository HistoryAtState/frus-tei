    <text>
        <body>
            <div xml:id="d722">

                <pb facs="0642" n="566" sameAs="frus:frus1916/pg566"/>

                <note rend="inline" type="source">File No. 812.00/18450</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to Special Representative
                        Rodgers </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-05-31T20:00:00-05:00">
                            <hi rendition="#italic">May 31, 1916, 8 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>111. Long note just delivered by Mexican Agent. Tone aggressive and
                    recriminatory. Will not be given out here at present. Secure copy if possible
                    for your own information and report whether in your opinion expresses attitude
                    of Government. Tone and style bound to create irritation here.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Polk</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
