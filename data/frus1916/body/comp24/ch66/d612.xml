            <div xml:id="d612">

                <pb facs="0576" n="500" sameAs="frus:frus1916/pg500"/>

                <note rend="inline" type="source">File No. 812.00/17593</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to Mr. Arredondo </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-03-21">
                            <hi rendition="#italic">March 21, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I beg to acknowledge the receipt of your
                    letter of March 19, 1916, relative to the occupation of Mexican towns by United
                    States military forces.</p>
                <p>In reply you are informed that General Funston was instructed by telegraph, on
                    March 18, 1916, to direct Brigadier General Pershing to avoid occupying any
                    Mexican town.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Frank L. Polk.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
