    <text>
        <body>
            <div xml:id="d659">

                <pb facs="0601" n="525" sameAs="frus:frus1916/pg525"/>

                <note rend="inline" type="source">File No. 812.00/17952</note>
                <head>
                    <hi rendition="#italic">The Secretary of War to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Extract]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">War Department</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-04-21">
                            <hi rendition="#italic">April 21, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to send you herewith
                    copies of General Funston’s telegrams 1253, 1254 and 1259, on the subject of the
                    Parral incident.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Newton D. Baker</hi>
                    </signed>
                </closer>





                <xi:include href="d659-a1.xml" xpointer="d659-a1"/>
