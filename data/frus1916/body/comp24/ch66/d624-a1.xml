    <text>
        <body>
            <div xml:id="d624-a1">

                <pb facs="0582" n="506" sameAs="frus:frus1916/pg506"/>

                <opener>
                    <seg rendition="#center">[Inclosure—Telegram]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">General Funston to the
                            Adjutant General
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">,<placeName>
                            <hi rendition="#small-caps">Fort Sam Houston</hi></placeName>, <date
                            calendar="gregorian" when="1916-03-30">
                            <hi rendition="#italic">March 30, 1916</hi></date>.</dateline>
                </opener>
                <p>1172. Following just received from General Bell: “I saw General Gavira at 10.30
                    this morning. He had not at that time received instructions from his Government
                    regarding shipment of supplies by Mexican Northwestern but at once sent a
                    telegram and stated he would let me know as soon as he heard.”</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Funston</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
