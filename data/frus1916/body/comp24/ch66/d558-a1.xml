    <text>
        <body>
            <div xml:id="d558-a1">

                <pb facs="0543" n="467" sameAs="frus:frus1916/pg467"/>

                <opener>
                    <seg rendition="#center">[Inclosure]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">The Adjutant General to
                        General Funston
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">The Adjutant General’s Office</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-01-20">
                            <hi rendition="#italic">January 20, 1916</hi></date>.</dateline>
                </opener>
                <p>Secretary War directs you to be advised of request of Secretary of State that no
                    members of band charged with murder of Americans at Santa Ysabel, Mexico, be
                    permitted to cross the border into United States and he desires your cooperation
                    in all ways that may be proper.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">McCain</hi>
                    </signed>
                </closer>
            </div>
        </body>
