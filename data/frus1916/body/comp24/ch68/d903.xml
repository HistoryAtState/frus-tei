    <text>
        <body>
            <div xml:id="d903">

                <pb facs="0738" n="662" sameAs="frus:frus1916/pg662"/>

                <note rend="inline" type="source">File No. 812.00/17158</note>
                <head>
                    <hi rendition="#italic">The Secretary of War to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">War Department</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-01-25">
                            <hi rendition="#italic">January 25, 1916</hi></date>.</dateline>
                </opener>
                <p>The Secretary of War presents his compliments to the Honorable the Secretary of
                    State and has the honor to inclose herewith for his information copy of a letter
                    from the commanding general, 8th Brigade, Fort Bliss, Texas, dated January 17,
                    1916, reporting on border conditions for the week ending January 15, 1916</p>


                <xi:include href="d903-a1.xml" xpointer="d903-a1"/>
