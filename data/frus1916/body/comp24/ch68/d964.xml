            <div xml:id="d964">

                <pb facs="0758" n="682" sameAs="frus:frus1916/pg682"/>

                <note rend="inline" type="source">File No. 312.11/8343</note>
                <head>
                    <hi rendition="#italic">Mr. Parker,
                        representing American interests, to the Secretary of
                            State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 642</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Mexico City</hi></placeName>, <date
                            calendar="gregorian" when="1910-12-27">
                            <hi rendition="#italic">December 27, 1910</hi>
                        </date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to refer to the
                    Department’s telegraphic instruction 550, of November 14, 1916, relative to the
                    protection of American property in the Yaqui Valley of the State of Sonora, and
                    to enclose herewith a copy of my note to the Foreign Office, dated November 15,
                    and translation of the two notes which I have received from the Foreign Office
                    in the matter, dated respectively December 8 and 13.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Charles B. Parker</hi>
                    </signed>
                </closer>





