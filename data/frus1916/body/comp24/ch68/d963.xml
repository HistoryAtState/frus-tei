    <text>
        <body>
            <div xml:id="d963">

                <pb facs="0757" n="681" sameAs="frus:frus1916/pg681"/>

                <note rend="inline" type="source">File No. 312.11/8313</note>
                <head>
                    <hi rendition="#italic">Vice Consul Dickinson
                        to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">San Luis Potosi</hi></placeName>, <date
                            calendar="gregorian" when="1916-12-25T13:00:00-06:36">
                            <hi rendition="#italic">December 25, 1916, 1 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>American citizens from Magistral, Durango, J. T. Critchett, W. H. Seamon, Arthur
                    Heuser, William Kirchner, Karl Kirchner, <pb facs="0758" n="682" xml:id="pg682"
                    /> Niebolar Kuig and wife, Charles Biekofsky, reported in Villista hands,
                    arrived here to-day.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Dickinson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
