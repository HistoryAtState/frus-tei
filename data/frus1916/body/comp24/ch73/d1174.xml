    <text>
        <body>
            <div xml:id="d1174">

                <pb facs="0864" n="788" sameAs="frus:frus1916/pg788"/>

                <note rend="inline" type="source">File No. 812.113/3883</note>
                <head>
                    <hi rendition="#italic">Consul Edwards to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/> [<hi
                                rendition="#italic">Ciudad Juarez</hi>] <hi rendition="#italic">El
                                Paso, Texas</hi></placeName>, <date calendar="gregorian"
                            when="1916-01-23T19:00:00-07:00">
                            <hi rendition="#italic">January 23, 1916, 7 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Department’s January 21, 6 p.m. It is not advisable to allow munitions of war
                    into this district. Conditions bordering on anarchy at this time.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Edwards</hi>
                    </signed>
                </closer>
            </div>
        </body>
