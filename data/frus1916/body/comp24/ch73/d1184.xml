    <text>
        <body>
            <div xml:id="d1184">

                <pb facs="0867" n="791" sameAs="frus:frus1916/pg791"/>

                <note rend="inline" type="source">File No. 812.113/4157</note>
                <head>
                    <hi rendition="#italic">Consul Simpich to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Nogales, Arizona</hi></placeName>, <date
                            calendar="gregorian" when="1916-05-15T17:00:00-07:23">
                            <hi rendition="#italic">May 15, 1916, 5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Recommend that for next week or ten days no more arms or ammunition be allowed
                    exported to Sonora and that explosives for American mines be reduced lowest
                    possible minimum.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Simpich</hi>
                    </signed>
                </closer>
            </div>
        </body>
