    <text>
        <body>
            <div xml:id="d1178">

                <pb facs="0865" n="789" sameAs="frus:frus1916/pg789"/>

                <note rend="inline" type="source">File No. 812.113/4115</note>
                <head>
                    <hi rendition="#italic">The Adjutant General to General Funston </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">War Department</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-05-01">
                            <hi rendition="#italic">May 1, 1916</hi></date>.</dateline>
                </opener>
                <p>Secretary of War directs until further orders have been issued stop all arms and
                    munitions of war from going into Mexico.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">McCain</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
