    <text>
        <body>
            <div xml:id="d1172">

                <pb facs="0863" n="787" sameAs="frus:frus1916/pg787"/>

                <note rend="inline" type="source">File No. 812.113/3884a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Consul Simpich </hi><anchor
                        n="2" xml:id="d1172-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-01-21">
                            <hi rendition="#italic">January 21, 1916</hi></date>.</dateline>
                </opener>
                <p>Advise Department by telegraph, briefly and confidentially, from time to time,
                    whether, in your judgment, permission for shipments <pb facs="0864" n="788"
                        xml:id="pg788"/> of munitions of war for industrial purposes to points in
                    your district should be withheld. Consideration should be given to the
                    possibility of such supplies falling into the hands of persons who might make
                    improper use of them.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1172-f1" n="2" type="source" xml:id="d1172-f1-content">
                <p>Same to American Consuls, Juarez, Hermosillo, Ensenada.</p>
            </note>
        </listAnnotation>
    </standOff>
