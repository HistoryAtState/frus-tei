    <text>
        <body>
            <div xml:id="d1202">

                <pb facs="0875" n="799" sameAs="frus:frus1916/pg799"/>

                <note rend="inline" type="source">File No. 312.67/69</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Consul Canada </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 891</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-04-24">
                            <hi rendition="#italic">April 24, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The Department encloses herewith a copy of
                    a letter dated April 21, 1916, from Mr. Cyrus Adler, of New York City, relative
                    to the reported persecution, at Vera Cruz, of Ottoman subjects of the Jewish
                    faith.</p>
                <p>The Department desires you to exercise your unofficial good offices in behalf of
                    Ottoman subjects in your district, in accordance with the instruction sent to
                    you under date of January 9, 1915.<anchor n="2" xml:id="d1202-f1"/>
                </p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Wilbur J. Carr</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
