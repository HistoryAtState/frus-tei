    <text>
        <body>
            <div xml:id="d1114">

                <pb facs="0835" n="759" xml:id="pg759"/>

                <note rend="inline" type="source">File No. 812.6363/220</note>
                <head>
                    <hi rendition="#italic">Special Agent Silliman
                        to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Querétaro</hi></placeName>, <date
                            calendar="gregorian" when="1916-02-02">
                            <hi rendition="#italic">February 2, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The Department’s telegram of February 1, 4
                    p.m., quoting Bevan’s summary of a decree issued by General Aguilar on February
                    15 and conveying the Department’s instruction to me, was received this
                    morning.</p>
                <p>I have the honor to transmit herewith carbon of my representation in this
                    case.</p>
                <p>I have [etc]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">John R. Silliman</hi>
                    </signed>
                </closer>


                <xi:include href="d1114-a1.xml" xpointer="d1114-a1"/>
            </div>
        </body>
    </text>
