            <div xml:id="d967">

                <pb facs="0759" n="683" sameAs="frus:frus1916/pg683"/>

                <note rend="inline" type="source">File No. 312.11/7388</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Collector Cobb </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-03-10T16:00:00-05:00">
                            <hi rendition="#italic">March 10, 1916, 4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your March 9, 2 p.m. Advise Mormons to take every possible precautionary measure
                    for their safety.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
