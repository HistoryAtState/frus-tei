    <text>
        <body>
            <div xml:id="d1014">

                <pb facs="0775" n="699" sameAs="frus:frus1916/pg699"/>

                <note rend="inline" type="source">File No. 312.11/7898a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Consul Avery </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-06-27">
                            <hi rendition="#italic">June 27, 1916</hi></date>.</dateline>
                </opener>
                <p>Advise all Americans in Quintana Roo to withdraw from Mexico immediately.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
