    <text>
        <body>
            <div xml:id="d1013">

                <pb facs="0775" n="699" xml:id="pg699"/>

                <note rend="inline" type="source">File No. 812.48/3225</note>
                <head>
                    <hi rendition="#italic">The Assistant Secretary of War to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">War Department</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-06-24">
                            <hi rendition="#italic">June 24, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to request information
                    whether there is any probability of the Army transport <hi rendition="#italic"
                        >Sumner</hi> being required for any additional trips to Mexico for refugees
                    in addition to the one upon which now engaged at the request of the Department
                    of State.</p>
                <p>This information is necessary in order to arrange for additional subsistence
                    supplies if further service is in prospect.</p>
                <p>Very respectfully,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wm. M. Ingraham</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
