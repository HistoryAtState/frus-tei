                <pb facs="0769" n="693" sameAs="frus:frus1916/pg693"/>

                <note rend="inline" type="source">File No. 312.11/7820a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the British Consul, Salina
                        Cruz </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-06-20T17:00:00-05:00">
                            <hi rendition="#italic">June 20, 1916, 5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Situation demands you advise all Americans in your district to withdraw from
                    Mexico. Please act accordingly.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
