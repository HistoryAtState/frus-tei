            <div xml:id="d983">

                <pb facs="0765" n="689" sameAs="frus:frus1916/pg689"/>

                <note rend="inline" type="source">File No. 312.11/7668b</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to all American Consular Officers
                        in Mexico, including Parker, Mexico City, excepting border Consuls </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-05-09T18:00:00-05:00">
                            <hi rendition="#italic">May 9, 1916, 6 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>In view possible eventualities, be prepared to act promptly, in accordance with
                    Department’s March 11, 11 p.m.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
