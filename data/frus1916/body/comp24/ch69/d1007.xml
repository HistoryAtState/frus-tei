    <text>
        <body>
            <div xml:id="d1007">

                <pb facs="0772" n="696" sameAs="frus:frus1916/pg696"/>

                <note rend="inline" type="source">File No. 812.48/3205</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Consul Guyant
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-06-23T13:00:00-05:00">
                            <hi rendition="#italic">June 23, 1916, 1 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>You are authorized to send Porto Ricans on freighter to New Orleans, at seventeen
                    dollars each. Department will make necessary arrangements, and take them to
                    Porto Rico on transport after their arrival New Orleans.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
