    <text>
        <body>
            <div xml:id="d1038">

                <pb facs="0784" n="708" sameAs="frus:frus1916/pg708"/>

                <note rend="inline" type="source">File No. 312.11/8308</note>
                <head>
                    <hi rendition="#italic">Consul General Hanna to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">San Antonio, Texas</hi></placeName>, <date
                            calendar="gregorian" when="1916-12-22T23:00:00-06:00">
                            <hi rendition="#italic">December 22, 1916, 11 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>British Consul Pat O’Hea arrived at San Luis Potosi this afternoon together with
                    24 Americans and families, also 7 Britishers and families.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hanna</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
