        <body>
            <div xml:id="d970">

                <pb facs="0760" n="684" sameAs="frus:frus1916/pg684"/>

                <note rend="inline" type="source">File No. 312.11/7393</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Consul Edwards </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-03-11T16:00:00-05:00">
                            <hi rendition="#italic">March 11, 1916, 4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Request appropriate authorities to furnish adequate escort for Mormons who may
                    wish to withdraw from Casas Grandes.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
