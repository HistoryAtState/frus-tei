                <pb facs="0774" n="698" sameAs="frus:frus1916/pg698"/>

                <note rend="inline" type="source">File No. 812.48/3218a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Consul Canada
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-06-24T17:00:00-05:00">
                            <hi rendition="#italic">June 24, 1916, 5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Ward Line has instructed its Vera Cruz agent regarding transportation of refugees
                    on <hi rendition="#italic">Monterey</hi>. Confer with agent.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
