    <text>
        <body>
            <div xml:id="d1011">

                <pb facs="0774" n="698" sameAs="frus:frus1916/pg698"/>

                <note rend="inline" type="source">File No. 812.48/3212</note>
                <head>
                    <hi rendition="#italic">Consul Simpich to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Nogales, Arizona</hi></placeName>, <date
                            calendar="gregorian" when="1916-06-24T14:00:00-07:23">
                            <hi rendition="#italic">June 24, 1916, 2 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Does Department authorize furnishing transportation to destitutes from border to
                    homes in States, very few cases.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Simpich</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
