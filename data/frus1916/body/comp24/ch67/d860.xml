            <div xml:id="d860">

                <pb facs="0717" n="641" sameAs="frus:frus1916/pg641"/>

                <note rend="inline" type="source">File No. 812.516/143</note>
                <head>
                    <hi rendition="#italic">Consul Canada to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">Vera Cruz</hi></placeName>, <date
                            calendar="gregorian" when="1916-09-20">
                            <hi rendition="#italic">September 20, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit enclosed
                    herewith Carranza’s bank decree referred to in my cablegram of September 20, 8
                    a.m.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wm. W. Canada</hi>
                    </signed>
                </closer>


                <xi:include href="d860-a1.xml" xpointer="d860-a1"/>
