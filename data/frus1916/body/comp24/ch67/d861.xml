            <div xml:id="d861">

                <pb facs="0719" n="643" sameAs="frus:frus1916/pg643"/>

                <note rend="inline" type="source">File No. 812.516/135</note>
                <head>
                    <hi rendition="#italic">Mr. Parker,
                        representing American interests, to the Secretary of
                            State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Mexico City</hi></placeName>, <date
                            calendar="gregorian" when="1916-09-20T19:00:00-06:36">
                            <hi rendition="#italic">September 20, 1916, 7 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>408. My 388, September 10, 10 p.m. The banks mentioned were forced to pay the
                    four hundred thousand pesos in specie.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Parker</hi>
                    </signed>
                </closer>
            </div>
        </body>
