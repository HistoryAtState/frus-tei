    <text>
        <body>
            <div xml:id="d837">

                <pb facs="0707" n="631" xml:id="pg631"/>

                <note rend="inline" type="source">File No. 812.516/112</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Mr. Arredondo, representing
                        American interests</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-12-30T20:00:00-05:00">
                            <hi rendition="#italic">December 30, 1915, 8 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>207. Your 198, December 22, 1915, 5 p.m.<anchor n="1" xml:id="d837-f1"/>
                    Department taking up with Carranza matter decree mentioned.</p>
                <p>Advise American citizens meanwhile not to voluntarily comply, and do not turn
                    over money of United States Government.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
