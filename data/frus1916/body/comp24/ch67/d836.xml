            <div xml:id="d836">

                <pb facs="0706" n="630" sameAs="frus:frus1916/pg630"/>

                <note rend="inline" type="source">File No. 812.516/113</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Special Agent Silliman
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Extract]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-12-29T17:00:00-05:00">
                            <hi rendition="#italic">December 29, 1915, 5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your suggestion regarding commission representing banking interests meeting
                    General Carranza has been communicated to Parker.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
