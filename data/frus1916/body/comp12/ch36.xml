            <div xml:id="ch36">

                <pb facs="0333" n="257" sameAs="frus:frus1916/pg257"/>

                <head>Treaty for the advancement of general peace concluded between the United
                    States and Ecuador</head>
                <p rendition="#flush">
                    <hi rendition="#italic">Signed at Washington, October 13, 1914; ratification
                        advised by the Senate, October 20, 1914; ratified by the President, January
                        4, 1916; ratified by Ecuador, November 10, 1915; ratifications exchanged at
                        Washington, January 22, 1916; proclaimed, January 24, 1916.</hi>
                </p>

