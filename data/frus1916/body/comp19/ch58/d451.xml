    <text>
        <body>
            <div xml:id="d451">

                <pb facs="0473" n="397" sameAs="frus:frus1916/pg397"/>

                <note rend="inline" type="source">File No. 315.112G75/6</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Minister Ewing
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 123</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-12-13">
                            <hi rendition="#italic">December 13, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to previous correspondence in
                    regard to the assault upon Mr. J. W. Grace by the military comandante at Tela,
                    Honduras, the Department encloses for your information a copy of a despatch from
                    the American Consul at Tela [Ceiba] reporting that Colonel Manuel Antonio López
                    has substituted the former incumbent as Comandante de Armas at that port.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Frank L. Polk</hi>
                    </signed>
                </closer>


                <xi:include href="d451-a1.xml" xpointer="d451-a1"/>
            </div>
        </body>
    </text>
