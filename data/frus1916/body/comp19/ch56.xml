            <div xml:id="ch56">

                <pb facs="0465" n="389" sameAs="frus:frus1916/pg389"/>

                <head>Treaty for the advancement of general peace concluded between the United
                    States and Honduras</head>
                <p rendition="#flush">
                    <hi rendition="#italic">Signed at Washington, November 3, 1913; ratification
                        advised by the Senate, with amendments, August 13, 1914; ratified by the
                        President, July 20, 1916; ratified by Honduras, May 29, 1916; ratifications
                        exchanged at Washington, July 27, 1916; proclaimed, July 28, 1916.</hi>
                </p>

                <xi:include href="ch56/d441.xml" xpointer="d441"/>
