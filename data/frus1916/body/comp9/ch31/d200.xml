    <text>
        <body>
            <div xml:id="d200">

                <pb facs="0293" n="217" sameAs="frus:frus1916/pg217"/>

                <note rend="inline" type="source">File No. 818.032/5</note>
                <head>
                    <hi rendition="#italic">Minister Hale to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 92</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">San José</hi></placeName>, <date
                            calendar="gregorian" when="1916-05-02">
                            <hi rendition="#italic">May 2, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose copies of the
                    official pamphlet containing the President’s Message sent to the new Congress at
                    its meeting on May 1.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">E. J. Hale</hi>
                    </signed>
                </closer>


                <xi:include href="d200-a1.xml" xpointer="d200-a1"/>
            </div>
