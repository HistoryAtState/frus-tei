    <text>
        <body>
            <div xml:id="d365">

                <pb facs="0414" n="338" sameAs="frus:frus1916/pg338"/>

                <note rend="inline" type="source">File No. 838.51/461</note>
                <head>
                    <hi rendition="#italic">Minister Blanchard to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>. <lb/>
                            <hi rendition="#italic">Port au Prince</hi></placeName>, <date
                            calendar="gregorian" when="1916-01-06T17:00:00-04:49">
                            <hi rendition="#italic">January 6, 1916, 5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your December 31, 1 p.m.<anchor n="2" xml:id="d365-f1"/> After conference with
                    Minister for Foreign Affairs and Minister of Finance reforms desired agreed to
                    by the Government and instructions now being carried out by the Admiral.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Blanchard</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
