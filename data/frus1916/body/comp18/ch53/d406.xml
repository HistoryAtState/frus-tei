    <text>
        <body>
            <div xml:id="d406">

                <pb facs="0434" n="358" xml:id="pg358"/>

                <note rend="inline" type="source">File No. 838.51/538</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Minister Blanchard
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-07-12">
                            <hi rendition="#italic">July 12, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: For your information and the files of your
                    Mission, there is herewith enclosed a copy of a note addressed, on July 10, to
                    the Minister of Haiti and <hi rendition="#italic">mutatis mutandis</hi> to
                    Monsieur Maurice Casenave, President of the National Bank of Haiti, on the
                    occasion of the signing of the agreement between the Haitian Commissioners and
                    the representatives of the National Bank of Haiti; a translation of which
                    agreement is likewise enclosed.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Alvey A. Adee</hi>
                    </signed>
                </closer>


                <xi:include href="d406-a1.xml" xpointer="d406-a1"/>
            </div>
