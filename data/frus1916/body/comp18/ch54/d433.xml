    <text>
        <body>
            <div xml:id="d433">

                <pb facs="0455" n="379" xml:id="pg379"/>

                <note rend="inline" type="source">File No. 838.77–143</note>
                <head>
                    <hi rendition="#italic">The Minister of Haiti to the
                            Chief of Division of Latin-American, Affairs
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Legation of Haiti</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-09-21">
                            <hi rendition="#italic">September 21, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith two
                    copies of the reply of the Haitian Government to the memorandum of the National
                    Railroad Company of Haiti which you sent to me June 15th last.</p>
                <p>Be kind enough to keep one copy for the Department of State and transmit the
                    other to the representative of the company at New</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Solon Ménos</hi>
                    </signed>
                </closer>


                <xi:include href="d433-a1.xml" xpointer="d433-a1"/>
            </div>
        </body>
    </text>
