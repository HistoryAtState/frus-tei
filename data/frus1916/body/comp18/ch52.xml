                <pb facs="0404" n="328" xml:id="pg328"/>

                <head>Treaty between the United States and Haiti Relating to the Finances, Economic
                    Development, and Tranquillity of Haiti</head>
                <p rendition="#flush">
                    <hi rendition="#italic">Signed at Port au Prince, September 16, 1915;
                        ratification advised by the Senate, February 28, 1916; ratified by the
                        President, March 20, 1916; ratified by Haiti, September 17, 1915;
                        ratifications exchanged at Washington, May 3, 1916; proclaimed, May 3,
                        1916.</hi>
                </p>



