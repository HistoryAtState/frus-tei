    <text>
        <body>
            <div xml:id="d1322">

                <pb facs="1051" n="975" sameAs="frus:frus1916/pg975"/>

                <note rend="inline" type="source">File No. 667.003/67</note>
                <head>
                    <hi rendition="#italic">The Chargé d’Affaires of Turkey to the Secretary of
                        State </hi>
                </head>
                <p>The Chargé d’Affaires of Turkey presents his compliments to the Secretary of
                    State and by order of his Government has the honor to inform him that the new
                    Ottoman Customs Tariff on the basis of specific duties shall be put into effect
                    on and after September 1/14, 1916, on all merchandise that has arrived before or
                    may arrive after that date.</p>
                <closer>
                    <dateline rendition="#float-left">
                        <hi rendition="#small-caps">Ottoman Embassy</hi>, <lb/>
                        <placeName>
                            <hi rendition="#italic">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1916-08-21"><hi
                                rendition="#italic">August 21, 1916</hi></date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
