    <text>
        <body>
            <div xml:id="d14">

                <pb facs="0092" n="16" sameAs="frus:frus1916/pg16"/>

                <note rend="inline" type="source">File No. 835.032/21</note>
                <head>
                    <hi rendition="#italic">Ambassador Stimson to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Extract]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 236</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Buenos Aires</hi></placeName>, <date
                            calendar="gregorian" when="1916-06-09">
                            <hi rendition="#italic">June 9, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose copy of the
                    official volume containing the President’s speech at the opening of
                    Congress.</p>
                <p>I enclose translation of that part of the President’s address which relates to
                    Mexico, Pan American affairs and the relations of the Argentine Government with
                    the United States.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">F. J. Stimson</hi>
                    </signed>
                </closer>


                <xi:include href="d14-a1.xml" xpointer="d14-a1"/>
            </div>
        </body>
    </text>
