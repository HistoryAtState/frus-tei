    <text>
        <body>
            <div xml:id="d27">

                <pb facs="0104" n="28" sameAs="frus:frus1916/pg28"/>

                <note rend="inline" type="source">File No. 810.51/706</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador of
                        Argentina </hi><anchor n="7" xml:id="d27-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-10-04">
                            <hi rendition="#italic">October 4, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith for
                    your information a copy; in English and one in Spanish of the First Edition of
                    the Committee Reports and Resolutions, adopted at the first meeting of the
                    International High Commission at Buenos Aires in April last.<anchor n="2"
                        xml:id="d27-f2"/>
                </p>
                <p>A number of these reports have been sent to the Minister of Finance of Argentina
                    for such use as he may deem proper to make of them and I shall be pleased to
                    furnish you with additional copies, should you desire them.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Frank L. Polk</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d27-f1" n="7" type="source" xml:id="d27-f1-content">
                <p>The same, <hi rendition="#italic">mutatis mutandis</hi>, to the other Latin
                    American missions at Washington.</p>
            </note>
            <note corresp="#d27-f2" n="2" xml:id="d27-f2-content">
                <p>Not printed.</p>
            </note>
        </listAnnotation>
    </standOff>
