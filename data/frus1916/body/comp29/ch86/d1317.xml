    <text>
        <body>
            <div xml:id="d1317">

                <pb facs="1037" n="961" sameAs="frus:frus1916/pg961"/>

                <note rend="inline" type="source">File No. 311.523/41</note>
                <head>
                    <hi rendition="#italic">The Secretary of the Navy to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Navy Department</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-04-19">
                            <hi rendition="#italic">April 19, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith, for
                    your information, certain correspondence received from the Commandant of the
                    Portsmouth Navy Yard relative to the transfer of the remains of Spanish sailors
                    on Wednesday April 12, 1916.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Josephus Daniels</hi>
                    </signed>
                </closer>


                <xi:include href="d1317-a1.xml" xpointer="d1317-a1"/>
