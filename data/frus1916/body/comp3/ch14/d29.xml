    <text>
        <body>
            <div xml:id="d29">

                <pb facs="0106" n="30" sameAs="frus:frus1916/pg30"/>

                <note rend="inline" type="source">File No. 863.001P85/8</note>
                <head>
                    <hi rendition="#italic">The Chargé d’Affaires of
                            Austria-Hungary to the Secretary of
                            State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Translation]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Austro-Hungarian Embassy</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-11-22">
                            <hi rendition="#italic">November 22, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: I have the sad duty of informing
                    your excellency that His Imperial and Royal Apostolic Majesty Franz Joseph I, my
                    most gracious master, died at 5 minutes after 9 o’clock in the evening of
                    November 21, after a short illness. I am instructed to request your excellency
                    to bring this sad news to the knowledge of His Excellency the President of the
                    United States.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">E. Zwiedinek</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
