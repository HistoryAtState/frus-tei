    <text>
        <body>
            <div xml:id="d34">

                <pb facs="0107" n="31" sameAs="frus:frus1916/pg31"/>

                <note rend="inline" type="source">File No. 863.001F85/7</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Ambassador Penfield </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-11-23">
                            <hi rendition="#italic">November 23, 1916</hi></date>.</dateline>
                </opener>
                <p>1428. The President, desiring to show the high respect due to the memory of the
                    late Emperor and King, has invested you with the <pb facs="0108" n="32"
                        xml:id="pg32"/> rank and character of a Special Ambassador to represent him
                    and the people of the United States at funeral obsequies. So notify Foreign
                    Office. Send appropriate wreath in President’s name.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
