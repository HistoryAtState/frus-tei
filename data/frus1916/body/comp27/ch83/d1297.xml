    <text>
        <body>
            <div xml:id="d1297">

                <pb facs="1016" n="940" sameAs="frus:frus1916/pg940"/>

                <note rend="inline" type="source">File No. 819.1052/81</note>
                <head>
                    <hi rendition="#italic">Minister Price to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Extract]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 931</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Panama</hi></placeName>, <date
                            calendar="gregorian" when="1916-05-12">
                            <hi rendition="#italic">May 12, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: There is enclosed herewith a copy of my
                    note to the Panaman Foreign Office framed in accordance with instruction No. 242
                    of April 15.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wm. Jennings Price</hi>
                    </signed>
                </closer>



                <xi:include href="d1297-a1.xml" xpointer="d1297-a1"/>
