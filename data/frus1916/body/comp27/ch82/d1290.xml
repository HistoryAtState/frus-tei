    <text>
        <body>
            <div xml:id="d1290">

                <pb facs="1010" n="934" sameAs="frus:frus1916/pg934"/>

                <note rend="inline" type="source">File No. 319.1123L25/42</note>
                <head>
                    <hi rendition="#italic">Minister Price to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 922</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Panama</hi></placeName>, <date
                            calendar="gregorian" when="1916-05-06">
                            <hi rendition="#italic">May 6, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to my despatch No. 907 of April
                    24 last, relating to the investigation of the Colon riot of April 2, 1915, I
                    have the honor to enclose a copy of another note to the Panaman Foreign Office.
                    I delivered same personally on yesterday and attempted again to impress upon
                    Secretary Lefevre the importance of his authorities complying more energetically
                    and earnestly with the expectations of our Government herein.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wm. Jennings Price</hi>
                    </signed>
                </closer>


                <xi:include href="d1290-a1.xml" xpointer="d1290-a1"/>
            </div>
        </body>
    </text>
