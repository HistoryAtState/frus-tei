    <text>
        <body>
            <div xml:id="d1279">

                <pb facs="0994" n="918" sameAs="frus:frus1916/pg918"/>

                <note rend="inline" type="source">File No. 419.11D29/146</note>
                <head>
                    <hi rendition="#italic">The Minister of the Netherlands to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Translation]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 4663</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Legation of the Netherlands</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-10-20">
                            <hi rendition="#italic">October 20, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to your note of September 25,
                        1916,<anchor n="2" xml:id="d1279-f1"/> the last on the subject, I have the
                    honor to forward herewith to your excellency my award determining the amount due
                    by the Panaman Government to the American victims of the riot, which took place
                    in the city of Panama on July 4, 1912.</p>
                <p>Be pleased [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. L. F. C. de Rappard</hi>
                    </signed>
                </closer>


                <xi:include href="d1279-a1.xml" xpointer="d1279-a1"/>
            </div>
        </body>
    </text>
