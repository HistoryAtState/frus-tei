    <text>
        <body>
            <div xml:id="d198">

                <pb facs="0291" n="215" sameAs="frus:frus1916/pg215"/>

                <note rend="inline" type="source">File No. 711.21/330</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Senate Committee on
                        Foreign Relations </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-02-14">
                            <hi rendition="#italic">February 14, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: By direction of the Secretary, I beg to
                    enclose herewith a paraphrase of a telegram<anchor n="2" xml:id="d198-f1"/>
                    received from the American Minister at Bogota, Colombia, relative to the
                    proposed amendments to the treaty with Colombia now pending ratification in the
                    United States Senate.</p>
                <p>Very truly yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Richard Crane</hi></signed>, <lb/>
                    <hi rendition="#italic">Private Secretary</hi>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
