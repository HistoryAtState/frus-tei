    <text>
        <body>
            <div xml:id="d194">

                <pb facs="0289" n="213" sameAs="frus:frus1916/pg213"/>

                <note rend="inline" type="source">File No. 711.21/336</note>
                <head>
                    <hi rendition="#italic">Minister Thomson to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 257</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Bogotá</hi></placeName>, <date
                            calendar="gregorian" when="1916-02-04">
                            <hi rendition="#italic">February 4, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith a
                    copy and translation (very hastily made) of a note which I have only just this
                    moment received from the Minister for Foreign Affairs with regard to the report
                    of the Senate Committee on Foreign Affairs to the Senate of the United States
                    concerning the Treaty of April 6, 1914. The mail leaves at once, so I am unable
                    to add any comment.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Thad. A. Thomson</hi>
                    </signed>
                </closer>



                <xi:include href="d194-a1.xml" xpointer="d194-a1"/>
            </div>
        </body>
    </text>
