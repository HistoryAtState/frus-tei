            <div xml:id="d316">

                <pb facs="0352" n="276" sameAs="frus:frus1916/pg276"/>

                <note rend="inline" type="source">File No. 811.542/39</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            German Ambassador
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 2226</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-12-06">
                            <hi rendition="#italic">December 6, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: I have the honor to acknowledge the
                    receipt, in due course, of your note of November 13, 1916, wherein [etc.].</p>
                <p>In reply I have the honor to say that a translation of your note has been sent to
                    the Secretary of the Interior, for the information and consideration of the
                    Commissioner of Patents, and that upon receipt of his reply you will be advised
                    thereof.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
