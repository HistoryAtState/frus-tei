            <div xml:id="d50">

                <pb facs="0116" n="40" sameAs="frus:frus1916/pg40"/>

                <note rend="inline" type="source">File No. 711.5121/1</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the French Ambassador </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1666</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-03-07">
                            <hi rendition="#italic">March 7, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: I have the honor to acknowledge the
                    receipt of your note of February 14, 1916, wherein [etc.]</p>
                <p>In reply I have the honor to say that your note is receiving the Department’s
                    attentive consideration.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
