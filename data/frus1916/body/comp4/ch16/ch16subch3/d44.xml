    <text>
        <body>
            <div xml:id="d44">

                <pb facs="0114" n="38" xml:id="pg38"/>

                <note rend="inline" type="source">File No. 711.9321/2</note>
                <head>
                    <hi rendition="#italic">Minister Reinsch to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Peking</hi></placeName>, <date
                            calendar="gregorian" when="1916-04-07">
                            <hi rendition="#italic">April 7, 1916</hi></date>.</dateline>
                </opener>
                <p>Referring to circular of 1st instant, I beg to request instructions in reply to
                    my telegram of July 11 last.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Reinsch</hi>
                    </signed>
                </closer>
            </div>
        </body>
