                <pb facs="0113" n="37" sameAs="frus:frus1916/pg37"/>

                <note rend="inline" type="source">File No. 711.9321/1</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Chargé MacMurray
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-07-15">
                            <hi rendition="#italic">July 15, 1915</hi></date>.</dateline>
                </opener>
                <p>Your July 11. Take no action on Department’s May 29 until further instructed.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
