    <text>
        <body>
            <div xml:id="d45">

                <pb facs="0114" n="38" sameAs="frus:frus1916/pg38"/>

                <note rend="inline" type="source">File No. 711.9321/2</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Minister Reinsch
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-04-21">
                            <hi rendition="#italic">April 21, 1916</hi></date>.</dateline>
                </opener>
                <p>Your April 7. Address appropriate communication to Chinese Government looking to
                    termination of only second sentence of Article 18, Treaty of 1858, relating to
                    arrest deserting seamen.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
