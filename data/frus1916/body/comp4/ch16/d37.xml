    <text>
        <body>
            <div xml:id="d37">

                <pb facs="0109" n="33" sameAs="frus:frus1916/pg33"/>

                <note rend="inline" type="source">File No. 711.0021/94a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            American Legation at Brussels
                    </hi><anchor n="2" xml:id="d37-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Circular telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-04-01">
                            <hi rendition="#italic">April 1, 1916</hi></date>.</dateline>
                </opener>
                <p>Endeavor obtain early reply to representations made in accordance with
                    Department’s instruction May 29, 1915, regarding Seamen’s Act, approved March 4,
                    1915.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d37-f1" n="2" type="source" xml:id="d37-f1-content">
                <p>Sent also to the Embassies at Rio de Janeiro, Vienna, and Madrid, and the
                    Legations at Peking, Copenhagen, Athens, The Hague, Christiania, and
                    Bucharest.</p>
            </note>
        </listAnnotation>
    </standOff>
