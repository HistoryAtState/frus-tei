    <text>
        <body>
            <div xml:id="d1258">

                <pb facs="0929" n="853" sameAs="frus:frus1916/pg853"/>

                <note rend="inline" type="source">File No. 817.812/248</note>
                <head>
                    <hi rendition="#italic">Minister Long to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">San Salvador</hi></placeName>, <date
                            calendar="gregorian" when="1916-09-28">
                            <hi rendition="#italic">September 28, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith the
                        <hi rendition="#italic">Diario Oficial</hi>, No. 196, of August 29, 1916,
                    containing the demand of the Salvadorian Government against Nicaragua with
                    regard to the Bryan-Chamorro Treaty.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Boaz W. Long</hi>
                    </signed>
                </closer>


                <xi:include href="d1258-a1.xml" xpointer="d1258-a1"/>
            </div>
        </body>
    </text>
