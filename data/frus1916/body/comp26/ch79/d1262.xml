    <text>
        <body>
            <div xml:id="d1262">

                <pb facs="0966" n="890" sameAs="frus:frus1916/pg890"/>

                <note rend="inline" type="source">File No. 817.812/283</note>
                <head>
                    <hi rendition="#italic">Minister Long to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Extract]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 124</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">San Salvador</hi></placeName>, <date
                            calendar="gregorian" when="1916-12-02">
                            <hi rendition="#italic">December 2, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose copies of the
                    originals and translations of the protest which Honduras forwarded to Salvador
                    under date of September 30, 1916, and of the Salvadorian reply dated October 7,
                    1916, which Mr. Manuel Delgado, special representative of President Melendez of
                    Salvador recently delivered to the former Government.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Boaz W. Long</hi>
                    </signed>
                </closer>




