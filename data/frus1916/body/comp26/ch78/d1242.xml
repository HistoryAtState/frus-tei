    <text>
        <body>
            <div xml:id="d1242">

                <pb facs="0910" n="834" sameAs="frus:frus1916/pg834"/>

                <note rend="inline" type="source">File No. 817.812/190</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Minister Jefferson
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Extract]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-04-14T13:00:00-05:00">
                            <hi rendition="#italic">April 14, 1916, 1 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your April 11, 1 p.m. Department gratified to learn of the ratification of Treaty
                    by Nicaraguan Congress.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
