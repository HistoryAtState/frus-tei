            <div xml:id="ch79">

                <pb facs="0925" n="849" sameAs="frus:frus1916/pg849"/>

                <head>Nicaraguan Canal Route—Convention between the United States and
                    Nicaragua</head>
                <p rendition="#flush">
                    <hi rendition="#italic">Signed at Washington, August 5, 1914; ratification
                        advised by the Senate, with amendments, February 18, 1916; ratified by the
                        President, June 19, 1916; ratified by Nicaragua, April IS, 1916;
                        ratifications exchanged at Washington June 22, 1916; proclaimed, June 24,
                        1916.</hi>
                </p>








