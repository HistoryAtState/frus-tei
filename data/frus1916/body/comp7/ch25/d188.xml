    <text>
        <body>
            <div xml:id="d188">

                <pb facs="0285" n="209" sameAs="frus:frus1916/pg209"/>

                <note rend="inline" type="source">File No. 893.77/1573</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Minister Reinsch
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 541</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-12-19">
                            <hi rendition="#italic">December 19, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The Department acknowledges the receipt of
                    your despatch No. 1266 of November 15, 1916, with enclosures, relative to the
                    position taken by you in respect to the protest made by the Russian Minister
                    against the construction of a railway from Fengchen to Ninghsia.</p>
                <p>The action taken by you in this matter is approved by the Department.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Frank L. Polk</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
