    <text>
        <body>
            <div xml:id="d158">

                <pb facs="0242" n="166" sameAs="frus:frus1916/pg166"/>

                <note rend="inline" type="source">File No. 893.77/1494</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Minister Reinsch
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-12-17T16:00:00-05:00">
                            <hi rendition="#italic">December 17, 1915, 4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your cipher telegram of November 26, 3 p.m. Use of template and spacing machines
                    makes all spans exact duplicates. This with inspection by consulting engineer
                    should be sufficient. Full reply by mail.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
