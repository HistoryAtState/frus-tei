            <div xml:id="d173">

                <pb facs="0265" n="189" sameAs="frus:frus1916/pg189"/>

                <note rend="inline" type="source">File No. 893.77/1552</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Minister Reinsch </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-08-12">
                            <hi rendition="#italic">August 12, 1916</hi></date>.</dateline>
                </opener>
                <p>Your telegram of August 10. Take measures to safeguard American interests
                    concerned. Endeavor to obtain text of agreements mentioned.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
