            <div xml:id="d133">

                <pb facs="0198" n="122" sameAs="frus:frus1916/pg122"/>

                <note rend="inline" type="source">File No. 893.811/230</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Minister Reinsch
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-07-03">
                            <hi rendition="#italic">July 3, 1916</hi></date>.</dateline>
                </opener>
                <p>Your June 26. See cable of International Corporation to Gatrell of June 29.
                    Cooperate with Gatrell along lines mentioned.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
