    <text>
        <body>
            <div xml:id="d125">

                <pb facs="0185" n="109" xml:id="pg109"/>

                <note rend="inline" type="source">File No. 893.811/217</note>
                <head>
                    <hi rendition="#italic">Minister Reinsch to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Peking</hi></placeName>, <date
                            calendar="gregorian" when="1916-05-15">
                            <hi rendition="#italic">May 15, 1916</hi></date>.</dateline>
                </opener>
                <p>Contract for improvement Grand Canal in Kiangsu providing for loan of $3,000,000
                    secured by canal tolls has been signed subject to the approval of directors
                    American International Corporation. Highly desirable that ratification should
                    not be delayed.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Reinsch.</hi>
                    </signed>
                </closer>
            </div>
        </body>
