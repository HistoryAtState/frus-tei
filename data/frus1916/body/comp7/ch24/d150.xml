    <text>
        <body>
            <div xml:id="d150">

                <pb facs="0225" n="149" sameAs="frus:frus1916/pg149"/>

                <note rend="inline" type="source">File No. 893.51/1722</note>
                <head>
                    <hi rendition="#italic">Minister Reinsch to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Peking</hi></placeName>, <date
                            calendar="gregorian" when="1916-12-23T11:00:00+08:00">
                            <hi rendition="#italic">December 23, 1916, 11 a.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your statement of the position of the American Government in the matter of loans
                    was received in a friendly manner by the representatives <pb facs="0226" n="150"
                        xml:id="pg150"/> concerned who stated no objection to Chicago loan, but all
                    expressed a desire for American cooperation in reorganization loan. Full report
                    by mail.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Reinsch</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
