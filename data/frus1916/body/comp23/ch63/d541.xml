    <text>
        <body>
            <div xml:id="d541">

                <pb facs="0531" n="455" sameAs="frus:frus1916/pg455"/>

                <note rend="inline" type="source">File No. 751.8215/83</note>
                <head>
                    <hi rendition="#italic">Minister Curtis to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Extract]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Monrovia</hi></placeName>, <date
                            calendar="gregorian" when="1916-03-17T11:00:00-00:43">
                            <hi rendition="#italic">March 17, 1916, 11 a.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#italic">Chester</hi> arrived yesterday with arms and ammunition,
                    delivered this morning Secretary of War, designated for such purpose by me.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Curtis</hi>
                    </signed>
                </closer>
            </div>
        </body>
