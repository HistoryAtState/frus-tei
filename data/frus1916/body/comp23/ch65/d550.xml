    <text>
        <body>
            <div xml:id="d550">

                <pb facs="0537" n="461" sameAs="frus:frus1916/pg461"/>

                <note rend="inline" type="source">File 882.032/18</note>
                <head>
                    <hi rendition="#italic">Minister Curtis to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 44</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Monrovia</hi></placeName>, <date
                            calendar="gregorian" when="1916-09-30">
                            <hi rendition="#italic">September 30, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit for the
                    information of the Department a copy of the annual message delivered by the
                    President to the Legislature of Liberia in joint session assembled on the 19th
                    day of September, 1916.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">James L. Curtis</hi>
                    </signed>
                </closer>


                <xi:include href="d550-a1.xml" xpointer="d550-a1"/>
            </div>
