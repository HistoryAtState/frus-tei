    <text>
        <body>
            <div xml:id="d548-a1">

                <pb facs="0536" n="460" xml:id="pg460"/>

                <opener>
                    <seg rendition="#center">[Inclosure]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">The Secretary of the Treasury
                        to Minister Curtis
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">The Treasury Department</hi>, <lb/>
                            <hi rendition="#italic">Monrovia</hi></placeName>, <date
                            calendar="gregorian" when="1916-06-08">
                            <hi rendition="#italic">June 8, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Minister</hi>: I enclose herein a
                    memorandum on the suspension of the payment of interest and sinking fund of the
                    Liberian Refunding Loan of 1912, which, it is hoped, will serve the desired
                    purpose.</p>
                <p>Placing myself always at your service for any other information you may
                    require,</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Jas. F. Cooper</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
