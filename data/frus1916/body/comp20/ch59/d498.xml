                <pb facs="0500" n="424" sameAs="frus:frus1916/pg424"/>

                <note rend="inline" type="source">File No. 365.117/418</note>
                <head>
                    <hi rendition="#italic">Ambassador Gerard to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Berlin</hi></placeName>, <date
                            calendar="gregorian" when="1916-09-02">
                            <hi rendition="#italic">September 2, 1916</hi></date>.</dateline>
                </opener>
                <p>4296. Foreign Office writes August 31 Ghiloni not permitted cross Germany. They
                    suggest application to Austrian authorities permission return via
                    Switzerland.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Gerard</hi>
                    </signed>
                </closer>
            </div>
        </body>
