    <text>
        <body>
            <div xml:id="d499">

                <pb facs="0501" n="425" xml:id="pg425"/>

                <note rend="inline" type="source">File No. 365.117/418</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Minister Stovall
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-09-06">
                            <hi rendition="#italic">September 6, 1916</hi></date>.</dateline>
                </opener>
                <p>298. Department requesting permission Austrian authorities allow Frank Ghiloni
                    now detained Austria to return United States via Switzerland. If permission
                    granted Ghiloni will surrender passport now held and apply your office for
                    emergency passport return United States via France. Issue. He will explain
                    case.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
