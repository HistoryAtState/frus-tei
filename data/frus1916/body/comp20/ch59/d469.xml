    <text>
        <body>
            <div xml:id="d469">

                <pb facs="0483" n="407" xml:id="pg407"/>

                <note rend="inline" type="source">File No. 365.117/301</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Ambassador Page
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-03-31">
                            <hi rendition="#italic">March 31, 1916</hi></date>.</dateline>
                </opener>
                <p>518. Department’s 481, February 17, concerning detention Enrico Ajello. Are you
                    sending written report? Please consider carefully application Article 7 Italian
                    law on citizenship promulgated June 80, 1912. Written instruction concerning
                    this point sent 23d.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
