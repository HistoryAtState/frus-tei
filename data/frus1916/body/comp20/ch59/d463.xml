                <pb facs="0480" n="404" sameAs="frus:frus1916/pg404"/>

                <note rend="inline" type="source">File No. 365.117/295</note>
                <head>
                    <hi rendition="#italic">Ambassador Penfield to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Vienna</hi></placeName>, <date
                            calendar="gregorian" when="1916-03-14">
                            <hi rendition="#italic">March 14, 1916</hi></date>.</dateline>
                </opener>
                <p>1185. My telegram March 3. Ministry ask what guaranty can be given that Frank
                    Ghiloni will not again bear arms against monarchy or allies during present war
                    case release.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Penfield</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
