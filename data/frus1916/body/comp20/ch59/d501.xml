    <text>
        <body>
            <div xml:id="d501">

                <pb facs="0503" n="427" xml:id="pg427"/>

                <note rend="inline" type="source">File No. 365.117/452</note>
                <head>
                    <hi rendition="#italic">Ambassador Page to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Extract]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 566</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Rome</hi></placeName>, <date
                            calendar="gregorian" when="1916-10-14">
                            <hi rendition="#italic">October 14, 1916</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: In reply to the Department’s instructions
                    No. 370 of July 25 last, relative to the release from the Italian army of
                    Hostilio Carlo Giomi, I have the honor to transmit herewith a translation of a
                    Foreign Office note received to-day containing the decision of the military
                    authorities, refusing to grant the release requested for the reasons set forth
                    in that note.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Thos. Nelson Page</hi>
                    </signed>
                </closer>


                <xi:include href="d501-a1.xml" xpointer="d501-a1"/>
            </div>
        </body>
    </text>
