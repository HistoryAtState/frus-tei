            <div xml:id="d504">

                <pb facs="0504" n="428" sameAs="frus:frus1916/pg428"/>

                <note rend="inline" type="source">File No. 365.117/469</note>
                <head>
                    <hi rendition="#italic">Ambassador Penfield to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Vienna</hi></placeName>, <date
                            calendar="gregorian" when="1916-12-02">
                            <hi rendition="#italic">December 2, 1916</hi></date>.</dateline>
                </opener>
                <p>1559. The Austro-Hungarian Government has consented to repatriation Frank Ghiloni
                    via Switzerland and France. War Office expresses the hope necessary arrangements
                    be made for his uninterrupted return.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Penfield</hi>
                    </signed>
                </closer>
            </div>
        </body>
