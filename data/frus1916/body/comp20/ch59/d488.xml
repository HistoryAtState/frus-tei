    <text>
        <body>
            <div xml:id="d488">

                <pb facs="0496" n="420" sameAs="frus:frus1916/pg420"/>

                <note rend="inline" type="source">File No. 365.117/362</note>
                <head>
                    <hi rendition="#italic">Ambassador Penfield to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Vienna</hi></placeName>, <date
                            calendar="gregorian" when="1916-06-19">
                            <hi rendition="#italic">June 19, 1916</hi></date>.</dateline>
                </opener>
                <p>1308. Your 1215, May 8. Frank Ghiloni released and delivered to Embassy. Returns
                    via Scandinavia. Name of steamer and date of sailing will be reported when
                    ascertained. Request telegraphic authority to draw hundred dollars necessary
                    expenses.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Penfield</hi>
                    </signed>
                </closer>
            </div>
        </body>
