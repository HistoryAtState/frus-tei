    <text>
        <body>
            <div xml:id="d14">

                <pb facs="0064" n="42" sameAs="frus:frus1951v02/pg42"/>

                <note rend="inline" type="source">320/10–1551</note>
                <head>
                    <hi rendition="#italic">Operational and Topical Assignments for the Advisory
                        Staff of the United States Delegation to the General Assembly, Paris,
                        November 6, 1951</hi><anchor n="1" xml:id="d14-f1"/>
                </head>
                <dateline>
                    <placeName>Paris</placeName>, <date
                        ana="#date_undated-inferred-from-document-head" calendar="gregorian"
                        when="1951-11-06">November 6, 1951</date>
                </dateline>
                <p rendition="#flush">
                    <hi rendition="#italic">Delegates</hi>:</p>
                <p>11 Representatives and Alternate Representatives<anchor n="*" xml:id="d14-f2"/>
                </p>
                <p rendition="#flush">
                    <hi rendition="#italic">Senior Advisers:</hi>
                </p>
                <p>John C. Ross</p>
                <p>Durward V. Sandifer</p>
                <p rendition="#flush">
                    <hi rendition="#italic">Economic Adviser:</hi>
                </p>
                <p>Isador Lubin</p>
                <p rendition="#flush">
                    <hi rendition="#italic">Legal Adviser:</hi>
                </p>
                <p>Adrian S. Fisher</p>
                <p rendition="#flush">
                    <hi rendition="#italic">Trusteeship Adviser:</hi>
                </p>
                <p>Francis B. Sayre</p>
                <p rendition="#flush">
                    <hi rendition="#italic">Principal Executive Officer:</hi>
                </p>
                <p>Paul B. Taylor</p>
                <p>Betty C. Gough, Special Assistant</p>
                <p rendition="#flush">
                    <hi rendition="#italic">Committee I</hi> (Political and Security):</p>
                <p>David W. Wainhouse, Executive Officer</p>
                <p rendition="#flush">
                    <hi rendition="#italic">Ad Hoc Political and Security Committee:</hi>
                </p>
                <p>Eric Stein, Executive Officer</p>
                <pb facs="0065" n="43" xml:id="pg43"/>
                <p>
                    <hi rendition="#italic">Advisers:</hi>
                </p>
                <p>Charles G. Bolté</p>
                <p>James N. Hyde</p>
                <p>Ambassador Alan G. Kirk</p>
                <p>Philip A. Mangano</p>
                <p>Leonard C. Meeker</p>
                <p>Howard Meyers</p>
                <p rendition="#flush">
                    <hi rendition="#italic">Ad Hoc Advisers:</hi>
                </p>
                <p>Harding F. Bancroft (Collective Measures)</p>
                <p>Jefferson Patterson (Balkan Commission)</p>
                <p>James W. Barco (Palestine Commission)</p>
                <p>Ely E. Palmer (Palestine Commission)</p>
                <p>Lewis Clark (Libyan Commission)</p>
                <p>Frank C. Nash (Armaments)</p>
                <p>R. Gordon Arneson (Armaments)</p>
                <p rendition="#flush">
                    <hi rendition="#italic">Committee II</hi> (Economic and Financial):</p>
                <p>Edmund H. Kellogg, Executive Officer</p>
                <p>William J. Stibravy</p>
                <p rendition="#flush">
                    <hi rendition="#italic">Committee III</hi> (Social, Humanitarian and
                    Cultural):</p>
                <p>James F. Green, Executive Officer</p>
                <p>James Simsarian</p>
                <p rendition="#flush">
                    <hi rendition="#italic">Committee IV</hi> (Trusteeship):</p>
                <p>Benjamin O. Gerig, Executive Officer</p>
                <p>Vernon D. McKay</p>
                <p rendition="#flush">
                    <hi rendition="#italic">Committee V</hi> (Administrative and Budgetary):</p>
                <p>William O. Hall, Executive Officer</p>
                <p>Carol C. Laise</p>
                <p rendition="#flush">
                    <hi rendition="#italic">Committee VI</hi> (Legal):</p>
                <p>John Maktos</p>
                <p rendition="#flush">
                    <hi rendition="#italic">Area Advisers:</hi>
                </p>
                <p>
                    <hi rendition="#italic">Europe:</hi>
                </p>
                <p>Frederick E. Nolting</p>
                <p>Ward P. Allen</p>
                <p>John E. Utter</p>
                <p>Thomas J. Cory</p>
                <p>
                    <hi rendition="#italic">Far East:</hi>
                </p>
                <p>Amb. David M. Key</p>
                <p>Ruth E. Bacon</p>
                <p>
                    <hi rendition="#italic">Near East:</hi>
                </p>
                <p>Edwin A. Plitt</p>
                <p>Joseph Palmer II</p>
                <pb facs="0066" n="44" xml:id="pg44"/>
                <p>
                    <hi rendition="#italic">Latin America:</hi>
                </p>
                <p>John C. Dreier</p>
                <p>Edward P. Maffitt</p>
                <p>Richard I. Phillips</p>
                <p rendition="#flush">
                    <hi rendition="#italic">Military Advisers:</hi>
                </p>
                <p>Vice Admiral O. C. Badger</p>
                <p>Lt. General Willis D. Crittenberger</p>
                <p>Lt. General Hubert R. Harmon</p>
                <p rendition="#flush">
                    <hi rendition="#italic">Congressional Staff Advisers:</hi>
                </p>
                <p>Francis O. Wilcox (subject to possible change)</p>
                <p>Boyd Crawford</p>
                <p rendition="#flush">
                    <hi rendition="#italic">Information Officers:</hi>
                </p>
                <p>Porter McKeever</p>
                <p>
                    <hi rendition="#italic">Assistants:</hi>
                </p>
                <p>John Mac Vane</p>
                <p>Chester Williams</p>
                <p>Jeanne Singer</p>
                <p>Charles Norberg or Lt. Col. Chester Hansen</p>
                <p>Lt. Col. Glenn Harland Wood</p>
                <p>Lt. Col. K. K. Hansen</p>
                <p>Edward V. Roberts</p>
                <p>Lowell Clucas</p>
                <p>Robert Haney</p>
                <p rendition="#flush">
                    <hi rendition="#italic">Assistants:</hi>
                </p>
                <table cols="2" rows="8">
                    <row role="label">
                        <cell>to the Secretary of State</cell>
                        <cell>to Ambassador Austin</cell>
                    </row>
                    <row>
                        <cell>Lucius D. Battle</cell>
                        <cell>William Mills</cell>
                    </row>
                    <row>
                        <cell>Marshall S. Shulman</cell>
                        <cell>Josephine Thompson</cell>
                    </row>
                    <row>
                        <cell>Barbara Evans</cell>
                        <cell>to Representative Mansfield</cell>
                    </row>
                    <row>
                        <cell>to Mrs. Roosevelt</cell>
                        <cell>____________(if named)</cell>
                    </row>
                    <row>
                        <cell>Malvina Thompson</cell>
                        <cell>to Representative Vorys</cell>
                    </row>
                    <row>
                        <cell>to Ambassador Jessup</cell>
                        <cell>________ (if named)</cell>
                    </row>
                    <row>
                        <cell>Louis H. Pollak</cell>
                        <cell/>
                    </row>
                </table>
                <p rendition="#flush">
                    <hi rendition="#italic">Supporting Staff:</hi>
                </p>
                <p>To be presented at a later date when nominations are complete.</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d14-f1" n="1" type="source" xml:id="d14-f1-content">
                <p>Source text was Tab C of memorandum of October 15 from Assistant Secretary
                    Hickerson to the Secretary of State, not printed (320/10–1551).</p>
            </note>
            <note corresp="#d14-f2" n="*" xml:id="d14-f2-content">
                <p>When the Secretary is present, one Representative will serve as Alternate and one
                    Alternate as Adviser. [Footnote in the source text.]</p>
            </note>
        </listAnnotation>
    </standOff>
