            </note>
            <note corresp="#d57-f2" n="2" xml:id="d57-f2-content">
                <p>Sir Pierson Dixon, British Deputy Under Secretary of State for Foreign
                    Affairs.</p>
            </note>
            <note corresp="#d57-f3" n="3" xml:id="d57-f3-content">
                <p>Philip W. Bonsal, Counselor of Embassy in France.</p>
            </note>
            <note corresp="#d57-f4" n="4" xml:id="d57-f4-content">
                <p>Guy de La Tournelle, Director-General of Political and Economic Affairs, French
                    Ministry for Foreign Affairs.</p>
            </note>
        </listAnnotation>
    </standOff>
