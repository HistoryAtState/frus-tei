    <text>
        <body>
            <div xml:id="d69">

                <pb facs="0241" n="157" sameAs="frus:frus1886/pg157"/>

                <head><hi rendition="#italic">Mr. Owyang Ming to Mr. Cheng.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >San Francisco</hi></placeName>,<lb/><date calendar="gregorian"
                            when="1886-02-16"><hi rendition="#italic">February</hi> 16, 1886</date>.
                        (Received February 19.)</dateline></opener>
                <p>Petition from Chinese merchants resident in Portland, Oreg., asking protection
                    against threatened outrages, forwarded to you to-day; immediate action
                    asked.</p>
                <closer><signed>OWYANG MING.</signed></closer>
            </div>
        </body>
    </text>
