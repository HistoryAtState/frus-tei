    <text>
        <body>
            <div xml:id="d3-a1-a2">

                <pb facs="0093" n="9" sameAs="frus:frus1886/pg9"/>

                <p rendition="#flush"><hi rendition="#small-caps">United States Consulate-General at
                        Vienna, Austria</hi>:</p>
                <p>Angelica de Bourry, being duly sworn, upon her oath saith that she is the mother
                    of Friedrich de Bourry, whose petition is hereunto annexed, and that she gave
                    birth to said Friedrich de Bourry in the city of New York, State of New York,
                    United States of America, on the 4th day of December, 1862, and that she has
                    heard read the petition of her said son, Friedrich de Bourry, and knows the
                    contents thereof, and that the same is true in substance and in fact.</p>
                <closer><signed>ANGELICA <hi rendition="#small-caps">de</hi>
                    BOURRY</signed>.</closer>
                <closer>
                    <dateline rendition="#float-left">Sworn to and subscribed before me <date
                            calendar="gregorian" when="1886-06-19">this 19th day of June, A. D.
                            1886</date>.</dateline>
                    <lb/><signed><table cols="1" rows="1">
                            <row>
                                <cell>[<hi rendition="#small-caps">seal.</hi>]</cell>
                                <cell>EDMUND JÜSSEN,<lb/><hi rendition="#italic">United States
                                        Consul-General.</hi></cell>
                            </row>
                        </table></signed>
                </closer>
            </div>
        </body>
    </text>
