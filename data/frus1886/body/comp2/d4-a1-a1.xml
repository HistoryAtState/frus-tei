    <text>
        <body>
            <div xml:id="d4-a1-a1">

                <pb facs="0095" n="11" sameAs="frus:frus1886/pg11"/>

                <p rendition="#flush"><hi rendition="#small-caps">United States Consulate-General at
                        Vienna, Austria</hi>, <hi rendition="#italic">ss.</hi></p>
                <p>Albert Landau, the above-named petitioner, being duly sworn, upon his oath saith
                    that he has read the foregoing petition and knows the contents thereof, and that
                    the same is true of his own knowledge in substance and in fact.</p>
                <closer><signed>ALBERT LANDAU</signed>.</closer>
                <closer>
                    <dateline rendition="#float-left">Sworn to and subscribed before me <date
                            calendar="gregorian" when="1886-06-25">this 25th day of June, A. D.
                            1886</date>.</dateline>
                    <lb/> [<hi rendition="#small-caps">seal.</hi>]<lb/><signed>EDMUND
                            JÜSSEN,<lb/><hi rendition="#italic">United States
                        Consul-General.</hi></signed></closer>
            </div>
        </body>
    </text>
