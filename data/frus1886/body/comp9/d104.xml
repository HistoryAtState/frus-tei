    <text>
        <body>
            <div xml:id="d104">

                <pb facs="0327" n="243" sameAs="frus:frus1886/pg243"/>

                <head>No. 100.<lb/><hi rendition="#italic">Mr. Reinberg to Mr. Porter.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Consulate-General</hi>,<lb/><hi rendition="#italic"
                                >Guayaquil, Ecuador</hi></placeName>, <date calendar="gregorian"
                            when="1885-04-17"><hi rendition="#italic">April</hi> 17, 1885</date>.
                        (Received May 5.)</dateline>
                    <seg rendition="#float-left">No. 118.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I beg to inclose you copies of declarations
                    made before me by Señor J. C. Zedeño and Señor B. Monje, affirming Mr. Santos’s
                    intention to return to the United States, both these gentlemen being merchants
                    of good character.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer><signed>MARTIN REINBERG,<lb/><hi rendition="#italic">United States
                            Vice-Consul-General.</hi></signed></closer>



                <xi:include href="d104-a1.xml" xpointer="d104-a1"/>
                <xi:include href="d104-a2.xml" xpointer="d104-a2"/>
