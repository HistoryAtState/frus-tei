                <pb facs="0366" n="282" sameAs="frus:frus1886/pg282"/>

                <head>No. 134.<lb/><hi rendition="#italic">Señor Flores to Mr. Bayard.</hi></head>
                <opener><seg rendition="#center">[Telegram.—Personal.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington, D. C.</hi></placeName>, <date calendar="gregorian"
                            when="1885-07-04"><hi rendition="#italic">July</hi> 4,
                        1885</date>.</dateline></opener>
                <p rendition="#flush">To Secretary <hi rendition="#small-caps">Bayard</hi>:</p>
                <p>With the announcement of amnesty I am directed to request that the Iroquois
                    should be altogether withdrawn even from the neighboring port of Payta, a
                    measure which I trust will prove of great mutual advantage. A prompt answer will
                    oblige.</p>
                <closer><signed>FLORES.</signed></closer>
            </div>
        </body>
