                <pb facs="0324" n="240" sameAs="frus:frus1886/pg240"/>

                <head>No. 99.<lb/><hi rendition="#italic">Mr. Reinberg to Mr. Porter.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Consulate-General</hi>,<lb/><hi rendition="#italic"
                                >Guayaquil, Ecuador</hi></placeName>, <date calendar="gregorian"
                            when="1885-04-16"><hi rendition="#italic">April</hi> 16, 1885</date>.
                        (Received May 5.)</dateline>
                    <seg rendition="#float-left">No. 117.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I herewith inclose you copies of Consular
                    Agent Goddard’s dispatches to this office, Nos. 26, 27, and 28, together with
                    four affidavits relative to the case of Julio Romano Santos.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>MARTIN REINBEEG,<lb/><hi rendition="#italic">United States
                            Vice-Consul-General.</hi></signed></closer>










