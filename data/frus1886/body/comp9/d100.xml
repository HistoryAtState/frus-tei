    <text>
        <body>
            <div xml:id="d100">

                <pb facs="0321" n="237" sameAs="frus:frus1886/pg237"/>

                <head>No. 96.<lb/><hi rendition="#italic">Mr. Reinberg to Mr. Hunter.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Consulate-General</hi>,<lb/><hi rendition="#italic"
                                >Guayaquil, Ecuador</hi></placeName>, <date calendar="gregorian"
                            when="1885-03-02"><hi rendition="#italic">March</hi> 2, 1885</date>.
                        (Received March 26.)</dateline>
                    <seg rendition="#float-left">No. 105.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose you herewith
                    copy of Consular Agent Goddard’s dispatch No. 23, dated February 20, 1885,
                    having reference to his interview with Mr. Santos; also, copy of declaration of
                    Mr. Gumercindo Villacis, former political chief (<hi rendition="#italic">jefe
                        politico</hi>) of the district where Mr. Santos resided, referring likewise
                    to the case of Mr. Santos.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>MARTIN REINBERG,<lb/><hi rendition="#italic">United States
                            Vice-Consul-General.</hi></signed></closer>



                <xi:include href="d100-a1.xml" xpointer="d100-a1"/>
