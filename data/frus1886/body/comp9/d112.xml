    <text>
        <body>
            <div xml:id="d112">

                <pb facs="0343" n="259" xml:id="pg259"/>

                <head>No. 108.<lb/><hi rendition="#italic">Mr. Reinberg to Mr. Porter.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Consulate-General</hi>,<lb/><hi rendition="#italic"
                                >Guayaquil, Ecuador</hi></placeName>, <date calendar="gregorian"
                            when="1885-05-20"><hi rendition="#italic">May</hi> 20, 1885</date>.
                        (Received June 16.)</dateline>
                    <seg rendition="#float-left">No. 122.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose you two copies
                    of affidavits relating to Mr. Santos’s case, forwarded to this office by
                    Consular Agent Goddard, of Bahia.</p>
                <p>I am, sir, &amp;c.,</p>
                <closer><signed>MARTIN REINBERG,<lb/><hi rendition="#italic">United States
                            Vice-Consul-General.</hi></signed></closer>



                <xi:include href="d112-a1.xml" xpointer="d112-a1"/>
