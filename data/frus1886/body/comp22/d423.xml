    <text>
        <body>
            <div xml:id="d423">

                <pb facs="0909" n="825" sameAs="frus:frus1886/pg825"/>

                <head>No. 417.<lb/><hi rendition="#italic">Mr. Porter to Mr. Curry.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1886-10-28"><hi rendition="#italic">October</hi> 28,
                        1886</date>.</dateline>
                    <seg rendition="#float-left">No. 133.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose, with reference to the telegram
                    sent you yesterday, copies of the proclamation of the President dated the 27th
                    instant, suspending the discriminating customs duties on the products of and
                    articles proceeding under the Spanish flag from Cuba and Porto Rico or any other
                    foreign country. Attached to the copies inclosed you will find a memorandum of
                    agreement on the subject, signed on the part of both Governments October 27,
                    1886.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>JAS. D. PORTER,<lb/><hi rendition="#italic">Acting
                        Secretary.</hi></signed></closer>




                <xi:include href="d423-a1.xml" xpointer="d423-a1"/>
