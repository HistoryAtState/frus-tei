        <body>
            <div xml:id="d382">

                <pb facs="0860" n="776" sameAs="frus:frus1886/pg776"/>

                <head>No. 378.<lb/><hi rendition="#italic">Mr. Curry to Mr. Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1886-02-04"><hi rendition="#italic">February</hi> 4, 1886</date>.
                        (Received February 23.)</dateline>
                    <seg rendition="#float-left">No. 26.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose the original
                    and translation of the papal decision of the question between Germany and Spain
                    in regard to the sovereignty of the Caroline Islands.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>J. L. M. CURRY.</signed></closer>



                <xi:include href="d382-a1.xml" xpointer="d382-a1"/>
