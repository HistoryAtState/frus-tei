        <body>
            <div xml:id="d387">

                <pb facs="0881" n="797" sameAs="frus:frus1886/pg797"/>

                <head>No. 383.<lb/><hi rendition="#italic">Mr. Curry to Mr. Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1886-05-29"><hi rendition="#italic">May</hi> 29, 1886</date>.
                        (Received June 14.)</dateline>
                    <seg rendition="#float-left">No. 62.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose the text in
                    English and Spanish of the commercial agreement between England and Spain lately
                    signed at this capital.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>J. L. M. CURRY.</signed></closer>


                <xi:include href="d387-a1.xml" xpointer="d387-a1"/>
            </div>
