    <text>
        <body>
            <div xml:id="d152">

                <pb facs="0392" n="308" sameAs="frus:frus1886/pg308"/>

                <head>No. 148.<lb/><hi rendition="#italic">Mr. Bayard to Mr. Roustan.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1886-05-10"><hi rendition="#italic">May</hi> 10,
                        1886</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of the 28th ultimo, inclosing a copy of a notice published by the
                    Government of France to the effect that persons having claims on account of
                    damages suffered during the recent conflict between the French Government and
                    the Hova Government should present the same with the documentary evidence in
                    support thereof.</p>
                <p>Accept, sir, &amp;c.,</p>
                <closer><signed>T. F. BAYARD.</signed></closer>
            </div>
        </body>
