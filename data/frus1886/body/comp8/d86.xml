                <pb facs="0307" n="223" sameAs="frus:frus1886/pg223"/>

                <head>No. 82.<lb/><hi rendition="#italic">Mr. Bayard to Mr. Parker.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1886-07-31"><hi rendition="#italic">July</hi> 31,
                        1886</date>.</dateline>
                    <seg rendition="#float-left">No. 25.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have received with pleasure and read with
                    keen interest Mr. George C. Foulk’s dispatch No. 308 of the third ultimo,
                    relative to the colony of American missionaries in Seôul, and the successful
                    prosecution of their good works.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>T. F. BAYARD.</signed></closer>
            </div>
        </body>
