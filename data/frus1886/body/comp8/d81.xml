    <text>
        <body>
            <div xml:id="d81">

                <pb facs="0298" n="214" sameAs="frus:frus1886/pg214"/>

                <head>No. 77.<lb/><hi rendition="#italic">Mr. Foulk to Mr. Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Seôul, Corea</hi></placeName>, <date calendar="gregorian"
                            when="1886-02-20"><hi rendition="#italic">February</hi> 20, 1886</date>.
                        (Received April 7.)</dateline>
                    <seg rendition="#float-left">No. 281.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: By this mail I send to the Department a
                    package containing specimens of the plain and cured cultivated ginseng of Corea,
                    that ordinarily used, the former in Corea and the latter in China, and inclose
                    herewith a note of information on ginseng.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>GEORGE C. FOULK,<lb/><hi rendition="#italic">Ensign U. S. Navy,
                            Chargé d’Affaires ad interim.</hi></signed></closer>


                <xi:include href="d81-a1.xml" xpointer="d81-a1"/>
            </div>
        </body>
    </text>
