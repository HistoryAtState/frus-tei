    <text>
        <body>
            <div xml:id="d311-a17">

                <pb facs="0689" n="605" sameAs="frus:frus1886/pg605"/>

                <head><hi rendition="#small-caps">decree.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Chihuahua</hi></placeName>, <date calendar="gregorian"
                            when="1886-02-17"><hi rendition="#italic">February</hi> 17,
                        1886</date>.</dateline></opener>
                <p>Referred to the district attorney (public prosecutor).</p>
                <p>So ordered and signed by the district judge in my presence. I so certify.</p>
                <closer><signed><list>
                            <item>REVILLA.</item>
                            <item>GUIROS, <hi rendition="#italic">Secretary.</hi></item>
                        </list></signed></closer>
            </div>
        </body>
