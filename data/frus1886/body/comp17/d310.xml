    <text>
        <body>
            <div xml:id="d310">

                <pb facs="0671" n="587" sameAs="frus:frus1886/pg587"/>

                <head>No. 306.<lb/><hi rendition="#italic">Mr. Bayard to Mr. Morgan.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1886-05-15"><hi rendition="#italic">May</hi> 15,
                        1886</date>.</dateline>
                    <seg rendition="#float-left">No. 183.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose for your information a copy of a
                        note<anchor n="*" xml:id="d310-f1"/> from the minister of Mexico here, dated
                    the 29th ultimo, and of my reply<anchor n="†" xml:id="d310-f2"/> of the 4th
                    instant, concerning the killing of Capt. Emmet Crawford in Mexico recently.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>T. F. BAYARD.</signed></closer>
            </div>
        </body>
    </text>
