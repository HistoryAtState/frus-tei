        <body>
            <div xml:id="d332">

                <pb facs="0792" n="708" sameAs="frus:frus1886/pg708"/>

                <head>No. 328.<lb/><hi rendition="#italic">Mr. Jackson to Mr. Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1886-07-30"><hi rendition="#italic">July</hi> 30, 1886</date>.
                        (Received August 7.)</dateline>
                    <seg rendition="#float-left">No. 280.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a copy
                    of note written by me to Mr. Mariscal, in the matter of the killing of Francisco
                    Arresures, under instruction brought by your telegram of 29th instant.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>HENRY R. JACKSON.</signed></closer>


                <xi:include href="d332-a1.xml" xpointer="d332-a1"/>
