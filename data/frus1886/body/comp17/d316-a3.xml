    <text>
        <body>
            <div xml:id="d316-a3">

                <pb facs="0778" n="694" xml:id="pg694"/>

                <opener><seg rendition="#center">[Inclosure 2 in No. 45.]</seg></opener>
                <head><hi rendition="#italic">Mr. Cutting to Mr. Brigham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paso Del Norte, Mexico</hi>,<lb/><hi rendition="#italic"
                                >Wednesday</hi></placeName>, <date calendar="gregorian"
                            when="1886-06-23"><hi rendition="#italic">June</hi> 23,
                        1886</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: For an alleged offense committed in Texas,
                    United States of America, I have been arrested and jailed in Paso del Norte,
                    Mexico, by a Mexican judge. Now, as an American citizen, I place myself under
                    the protection of yourself as United States consul.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>A. K. CUTTING.</signed></closer>
            </div>
        </body>
