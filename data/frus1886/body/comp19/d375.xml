    <text>
        <body>
            <div xml:id="d375">

                <pb facs="0854" n="770" sameAs="frus:frus1886/pg770"/>

                <head>No. 371.<lb/><hi rendition="#italic">Mr. Buck to Mr. Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Lima, Peru</hi></placeName>, <date calendar="gregorian"
                            when="1886-06-08"><hi rendition="#italic">June</hi> 8, 1886</date>.
                        (Received July 3.)</dateline>
                    <seg rendition="#float-left">No. 116.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: After closing the mail last Saturday in
                    which was forwarded my No. 114 of the 4th instant, I received the note of which
                    I inclose a copy and translation, officially announcing the organization of the
                    new Government.</p>
                <p>I inclose a copy of my reply delivered at the foreign office yesterday.</p>
                <p>Your obedient servant,</p>
                <closer><signed>CHARLES W. BUCK.</signed></closer>




                <xi:include href="d375-a1.xml" xpointer="d375-a1"/>
