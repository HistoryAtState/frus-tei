    <text>
        <body>
            <div xml:id="d176-a4">

                <pb facs="0434" n="350" sameAs="frus:frus1886/pg350"/>

                <head>No. 1.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps">In
                                the Senate of the United States</hi></placeName>,<lb/><date
                            calendar="gregorian" when="1886-05-10"><hi rendition="#italic">May</hi>
                            10, 1886</date>.</dateline></opener>
                <p><hi rendition="#italic">Resolved</hi>, That the President be requested to
                    communicate to the Senate, if in his opinion not incompatible with the public
                    interest, any information in the possession of the Government concerning the
                    alleged seizure of the United States fishing vessel David J. Adams while engaged
                    in lawful commerce in one of the ports in the Dominion of Canada, and what
                    measures, if any, have been taken to protect fishing vessels of the United
                    States while engaged in lawful commerce in the ports of the Dominion of
                    Canada.</p>
                <closer>Attest:<lb/><signed>ANSON G. McCOOK,<lb/><hi rendition="#italic"
                            >Secretary</hi>.</signed><lb/>By <signed>CHAS. W. JOHNSON,<lb/><hi
                            rendition="#italic">Chief Clerk.</hi></signed></closer>
            </div>
        </body>
    </text>
