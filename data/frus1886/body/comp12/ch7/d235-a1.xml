    <text>
        <body>
            <div xml:id="d235-a1">

                <pb facs="0510" n="426" sameAs="frus:frus1886/pg426"/>

                <opener><seg rendition="#center">[Inclosure 1 in note of November 11,
                    1886.]</seg></opener>
                <head><hi rendition="#italic">Mr. Presson to Mr.
                            Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Gloucester, Mass., Collector’s Office</hi></placeName>, <date
                            calendar="gregorian" when="1886-11-05"><hi rendition="#italic"
                                >November</hi> 5, 1886</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit herewith, by request, affidavits
                    of Capt. Medeo Rose, of schooner Laura Say ward, and Capt. Joseph Tupper, of
                    schooner Jeannie Seaverns, in relation to their treatment by Canadian
                    officials.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>D. S. PRESSON,<lb/><hi rendition="#italic"
                    >Collector.</hi></signed></closer>
            </div>
        </body>
