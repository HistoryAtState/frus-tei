    <text>
        <body>
            <div xml:id="d192">

                <pb facs="0465" n="381" sameAs="frus:frus1886/pg381"/>

                <head>No. 188.<lb/><hi rendition="#italic">Sir L. West to Mr. Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1886-06-02"><hi rendition="#italic">June</hi> 2, 1886</date>.
                        [Received June 3.]</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your notes of the 20th and 29th of May on the subject of the seizure of
                    American fishing vessels in Canadian waters.</p>
                <p>I have, &amp;c.</p>
                <closer><signed>L. S. SACKVILLE WEST.</signed></closer>
            </div>
        </body>
