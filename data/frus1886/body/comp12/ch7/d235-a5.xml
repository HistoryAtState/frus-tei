                <pb facs="0511" n="427" sameAs="frus:frus1886/pg427"/>

                <opener><dateline rendition="#float-right"><date calendar="gregorian"
                            when="1886-11-04"><hi rendition="#small-caps">November</hi> 4,
                            1886</date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Massachusetts</hi>, <hi
                        rendition="#italic">Essex, ss:</hi></p>
                <p>Personally appeared Joseph Tupper, and made oath to the truth of the above
                    statement.</p>
                <p>Before me.</p>
                <closer>[<hi rendition="#small-caps">seal.</hi>] <signed><hi rendition="#small-caps"
                            >aaron parsons</hi>, <hi rendition="#italic">N.
                    P.</hi></signed></closer>
