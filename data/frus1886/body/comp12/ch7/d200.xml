    <text>
        <body>
            <div xml:id="d200">

                <pb facs="0474" n="390" sameAs="frus:frus1886/pg390"/>

                <head>No. 196.<lb/><hi rendition="#italic">Sir L. West to Mr. Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1886-07-03"><hi rendition="#italic">July</hi> 3, 1886</date>.
                        [Received July 6.]</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of the 2d, reporting the detention of the American schooner City
                    Point, of Portland, Me., by the authorities of Shelburne, Nova Scotia.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>L. S. SACKVILLE WEST.</signed></closer>
            </div>
        </body>
    </text>
