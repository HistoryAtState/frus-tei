    <text>
        <body>
            <div xml:id="d222">

                <pb facs="0497" n="413" sameAs="frus:frus1886/pg413"/>

                <head>No. 218.<lb/><hi rendition="#italic">Sir L.
                            West to Mr. Bayard</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1886-09-11"><hi rendition="#italic">September</hi> 11,
                        1886</date>. (Received September 14.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of yesterday’s date calling attention to the case of the Mollie
                    Adams.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>L. S. SACKVILLE WEST.</signed></closer>
            </div>
        </body>
    </text>
