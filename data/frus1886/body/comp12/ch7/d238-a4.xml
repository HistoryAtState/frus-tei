    <text>
        <body>
            <div xml:id="d238-a4">

                <pb facs="0514" n="430" sameAs="frus:frus1886/pg430"/>

                <head><hi rendition="#italic">Dominion of Canada.—Harbor dues.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Port Mulgrave, N. S.</hi></placeName>, <date calendar="gregorian"
                            when="1886-08-30"><hi rendition="#italic">August 30,
                        1886</hi>.</date></dateline>
                    <seg rendition="#float-left">No. —.</seg></opener>
                <p>Received from Solomon Jacobs, master of the schooner Mollie Adams, from North
                    Bay, 117 tons register, the sum of $1.50, being harbor dues at this port.</p>
                <closer>[<hi rendition="#small-caps">seal.</hi>] <signed>DUNCAN C. GILLIES,<lb/><hi
                            rendition="#italic">Harbor Master.</hi></signed></closer>
            </div>
        </body>
