        <body>
            <div xml:id="d176">

                <pb facs="0433" n="349" sameAs="frus:frus1886/pg349"/>

                <head>No. 172.<lb/><hi rendition="#italic">Mr. Bayard to Mr. Phelps.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1886-07-29"><hi rendition="#italic">July</hi> 29,
                        1886</date>.</dateline>
                    <seg rendition="#float-left">No. 369.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit to you, herewith, copies of the
                    President’s message of the 24th instant, to the Senate relative to seizures and
                    detentions of American vessels in Canadian waters.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>T. F. BAYARD.</signed></closer>









