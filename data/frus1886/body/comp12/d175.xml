        <body>
            <div xml:id="d175">

                <pb facs="0431" n="347" sameAs="frus:frus1886/pg347"/>

                <head>No. 171.<lb/><hi rendition="#italic">Mr. Bayard to Mr. Phelps.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1886-06-18"><hi rendition="#italic">June</hi> 18,
                        1886</date>.</dateline>
                    <seg rendition="#float-left">No. 329.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to previous correspondence
                    concerning the fisheries question, I transmit to you herewith a copy of a
                    dispatch from our consul at Halifax, in relation to the recent instructions to
                    Canadian officials concerning American fishing vessels.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>T. F. BAYARD.</signed></closer>




                <xi:include href="d175-a1.xml" xpointer="d175-a1"/>
