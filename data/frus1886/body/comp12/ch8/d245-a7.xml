    <text>
        <body>
            <div xml:id="d245-a7">

                <pb facs="0581" n="497" sameAs="frus:frus1886/pg497"/>

                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Gloucester</hi></placeName>, <date calendar="gregorian"
                            when="1886-05-18"><hi rendition="#italic">May</hi> 18,
                        1886</date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Commonwealth of
                        Massachusetts</hi>,<lb/><hi rendition="#italic">Essex, ss:</hi></p>
                <p>Severally subscribed and sworn to before me.</p>
                <closer><signed>WILLIAM W. FRENCH</signed>,<lb/><hi rendition="#italic">Justice of
                        the Peace.</hi></closer>
                <postscript>
                    <p>I declare and say that I was born in Maine, and am a citizen of the United
                        States.</p>
                    <closer><signed>CALVIN COOK</signed>.</closer>
                </postscript>
            </div>
        </body>
    </text>
