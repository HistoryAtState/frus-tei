    <text>
        <body>
            <div xml:id="d269-a2">

                <pb facs="0602" n="518" sameAs="frus:frus1886/pg518"/>

                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Gloucester</hi></placeName>, <date calendar="gregorian"
                            when="1886-07-29"><hi rendition="#italic">July</hi> 29,
                        1886</date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Commonwealth of
                    Massachusetts</hi>, <hi rendition="#italic">Essex, ss:</hi></p>
                <p>Personally appeared the above-named Alexander McDonald, Angus McDonald, James
                    Langley, Peter McAlpin, Daniel Campbell, Eugene Nickerson, Milton Atkins,
                    William Atkinson, John McNeil, William De Corte, John McEachern, and Daniel
                    McCormick, and on oath declared the above statement by them subscribed to be
                    true.</p>
                <closer>[<hi rendition="#small-caps">l. s.</hi>] <signed>AARON PARSONS,<lb/><hi
                            rendition="#italic">Notary Public.</hi></signed></closer>
            </div>
        </body>
