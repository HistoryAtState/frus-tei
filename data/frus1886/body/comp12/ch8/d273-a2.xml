    <text>
        <body>
            <div xml:id="d273-a2">

                <pb facs="0605" n="521" sameAs="frus:frus1886/pg521"/>

                <p>We, the undersigned, a part of the crew of the schooner Golden Hind, do depose
                    and say that the above statement of Captain Cameron is true in every
                    particular.</p>
                <closer><signed><list>
                            <item>JAMES A. POWELL.</item>
                            <item>GILBERT SMITH.</item>
                        </list></signed>
                    <lb/>
                    <hi rendition="#small-caps">Massachusetts</hi>, <hi rendition="#italic">Essex,
                        ss:</hi></closer>
                <postscript>
                    <opener><dateline rendition="#float-right"><date calendar="gregorian"
                                when="1886-08-13"><hi rendition="#small-caps">August</hi> 13,
                                1886</date>.</dateline></opener>
                    <p>Personally appeared Reuben Cameron, James A. Powell, and Gilbert Smith, and
                        made oath to the above.</p>
                    <p>Before me.</p>
                    <closer>[<hi rendition="#small-caps">l. s.</hi>] <signed>AARON PARSONS, <hi
                                rendition="#italic">N. P.</hi></signed></closer>
                </postscript>
            </div>
        </body>
    </text>
