    <text>
        <body>
            <div xml:id="d247-a3">

                <pb facs="0583" n="499" sameAs="frus:frus1886/pg499"/>

                <p>I, George S. Farris, state that I am one of the crew of the schooner Jennie and
                    Julia, and was present during the conversation between the collector of the port
                    of Digby and the mate of the Jennie and Julia, and state that the foregoing
                    affidavit of the mate is correct.</p>
                <closer><signed>GEORGE S. FARRIS.</signed></closer>
                <closer>
                    <dateline rendition="#float-left">Subscribed and sworn to before me <date
                            calendar="gregorian" when="1886-05-20">this 20th day of May,
                        1886</date>.</dateline>
                    <lb/> [<hi rendition="#small-caps">l.s.</hi>] <signed>GEORGE H. HAYES,<lb/><hi
                            rendition="#italic">Notary Public.</hi></signed></closer>
            </div>
        </body>
    </text>
