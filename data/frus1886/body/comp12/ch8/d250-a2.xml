                <pb facs="0585" n="501" sameAs="frus:frus1886/pg501"/>

                <opener><dateline rendition="#float-right"><date calendar="gregorian"
                            when="1886-06-05"><hi rendition="#small-caps">June</hi> 5,
                        1886</date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Massachusetts</hi>, <hi
                        rendition="#italic">Essex, ss:</hi></p>
                <p>Personally appeared Alexander Hains, and made oath to the truth of the above
                    statement.</p>
                <p>Before me.</p>
                <closer>[<hi rendition="#small-caps">seal.</hi>] <signed>AARON PARSONS,<lb/><hi
                            rendition="#italic">Notary Public.</hi></signed></closer>
            </div>
