    <text>
        <body>
            <div xml:id="d180">

                <pb facs="0446" n="362" xml:id="pg362"/>

                <head>No. 176.<lb/><hi rendition="#italic">Mr. Phelps to Mr. Bayard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1886-10-12"><hi rendition="#italic">October</hi> 12, 1886</date>.
                        [Received October 26.]</dateline>
                    <seg rendition="#float-left">No. 372.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a copy
                    of a note received by me this day from Lord Iddesleigh in reference to the
                    Canadian fisheries.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>E. J. PHELPS.</signed></closer>


                <xi:include href="d180-a1.xml" xpointer="d180-a1"/>
            </div>
