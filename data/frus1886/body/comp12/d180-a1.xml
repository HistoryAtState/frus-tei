    <text>
        <body>
            <div xml:id="d180-a1">

                <pb facs="0446" n="362" sameAs="frus:frus1886/pg362"/>

                <opener><seg rendition="#center">[Inclosure in Mr. Phelps’s No. 372.]</seg></opener>
                <head><hi rendition="#italic">Lord Iddesleigh to Mr. Phelps.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Foreign Office</hi></placeName>, <date calendar="gregorian"
                            when="1886-10-11"><hi rendition="#italic">October</hi> 11,
                        1886</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of the 11th ultimo, on the subject of the Canadian fisheries, and I
                    beg leave to acquaint you that the note is under the careful consideration of
                    Her Majesty’s Government and that an answer will be returned as early as
                    possible.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>IDDESLEIGH.</signed></closer>
            </div>
        </body>
