            </note>
            <note corresp="#d721-f2" n="19" xml:id="d721-f2-content">
                <p>General Yeh Chien-ying, Chinese Communist Commissioner of Executive Headquarters
                    at Peiping.</p>
            </note>
        </listAnnotation>
