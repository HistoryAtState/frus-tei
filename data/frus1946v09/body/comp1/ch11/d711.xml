                <pb facs="1428" n="1416" sameAs="frus:frus1946v09/pg1416"/>

                <note rend="inline" type="source">123 Stuart, J. Leighton: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in China</hi> (<hi rendition="#italic">Stuart</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Nanking</hi></placeName>, <date calendar="gregorian"
                            when="1946-07-27T11:00:00+09:00">July 27, 1946—11
                        a.m.</date><lb/>[Received 4:01 p.m.]</dateline>
                </opener>
                <p>1215. After a long talk last evening with General Chou En-lai, I have decided to
                    leave today to join General Marshall in Kuling.</p>
                <closer><signed><hi rendition="#small-caps">Stuart</hi></signed></closer>
            </div>
        </body>
