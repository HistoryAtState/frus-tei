        <body>
            <div xml:id="d720">

                <pb facs="1438" n="1426" sameAs="frus:frus1946v09/pg1426"/>

                <note rend="inline" type="source">121.893/8–146: Telegram</note>
                <head><hi rendition="#italic">President Truman to General Marshall</hi></head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1946-08-01">August 1, 1946</date>.</dateline>
                </opener>
                <p>WH 489. Receipt of your message of July 30 is acknowledged.</p>
                <p>I appreciate your difficulties, approve of the method you are following, and hope
                    with you for success in accomplishing a peaceful solution of the Chinese
                    problem.</p>
                <closer><signed><hi rendition="#small-caps">Harry</hi> S. <hi
                            rendition="#small-caps">Truman</hi></signed></closer>
            </div>
        </body>
    </text>
