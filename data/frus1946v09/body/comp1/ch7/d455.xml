    <text>
        <body>
            <div xml:id="d455">

                <pb facs="0858" n="846" sameAs="frus:frus1946v09/pg846"/>

                <note rend="inline" type="source">Marshall Mission Files, Lot 54–D270:
                    Telegram</note>
                <head><hi rendition="#italic">President Truman to General Marshall</hi></head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1946-05-13">13 May 1946</date>.</dateline>
                </opener>
                <p>87818. I have read and discussed with the Acting Secretary of State<anchor n="65"
                        xml:id="d455-f1"/> your 681 of May 12. We approve your reply to
                    Generalissimo and concur in your statement regarding our objective in China and
                        <pb facs="0859" n="847" xml:id="pg847"/> in your opinion regarding utility
                    of proposed conference, it being understood by Chiang of course that final
                    decision rests with him only.</p>
                <p>Regards,</p>
                <closer><signed><hi rendition="#small-caps">Harry</hi> S. <hi
                            rendition="#small-caps">Truman</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d455-f1" n="65" xml:id="d455-f1-content">
                <p>Dean Acheson.</p>
            </note>
        </listAnnotation>
    </standOff>
