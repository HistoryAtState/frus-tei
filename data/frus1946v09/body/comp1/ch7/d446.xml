                <pb facs="0845" n="833" sameAs="frus:frus1946v09/pg833"/>

                <note rend="inline" type="source">Marshall Mission Files, Lot 54–D270:
                    Telegram</note>
                <head><hi rendition="#italic">General Marshall to
                        the Chief of Staff</hi> (<hi rendition="#italic"
                            >Eisenhower</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Nanking</hi></placeName>, <date calendar="gregorian"
                            when="1946-05-11">11 May 1946</date>.</dateline>
                </opener>
                <p>679. Please deliver following by hand of an officer to hand of Secretary of State
                    or Under Secretary. “Please delay until further receipt of notice from me
                    Wedemeyer’s nomination.”</p>
            </div>
