    <text>
        <body>
            <div xml:id="d467">

                <pb facs="0891" n="879" sameAs="frus:frus1946v09/pg879"/>

                <note rend="inline" type="source">Marshall Mission Files, Lot 54–D270</note>
                <head><hi rendition="#italic">Memorandum by General Chou En-lai to General
                        Marshall</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Nanking</hi></placeName>, <date calendar="gregorian"
                            when="1946-05-22">May 22, 1946</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">My Dear General Marshall</hi>: In connection with the
                    rediversion of the Yellow River, I have had a conference with Messrs. Ray and
                    Todd of UNRRA on May 18, 1946. At that conference we reached a six-point oral
                    agreement, which I now put in writing and present to you for your reference.</p>
                <p>Faithfully yours,</p>
                <closer>[Signature in Chinese]<lb/>(<signed><hi rendition="#small-caps">Chou
                            En-lai</hi></signed>)</closer>


                <xi:include href="d467-a1.xml" xpointer="d467-a1"/>
