    <text>
        <body>
            <div xml:id="d105">

                <pb facs="0341" n="329" sameAs="frus:frus1946v09/pg329"/>

                <note rend="inline" type="source">Marshall Mission Files, Lot 54–D270</note>
                <head><hi rendition="#italic">Memorandum by the Chinese Minister of War</hi> (<hi
                        rendition="#italic">Chen Cheng</hi>) <hi rendition="#italic">to General
                        Marshall</hi><anchor n="40" xml:id="d105-f1"/></head>
                <opener>
                    <seg rendition="#float-left">No. 1480</seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Chungking</hi></placeName>,] <date calendar="gregorian"
                            when="1946-03-26">March 26, 1946</date>.</dateline>
                </opener>
                <p>In accordance with the provisions under Section 1, Article 4 of the Basis for
                    Military Reorganization and for the Integration of the Communist Forces into the
                    National Army, we are forwarding to you a list<anchor n="41" xml:id="d105-f2"/>
                    of the 90 divisions to be retained by the National Government <pb facs="0342"
                        n="330" xml:id="pg330"/> and the order of demobilization of units during the
                    first two months.<anchor n="42" xml:id="d105-f3"/></p>
                <closer><signed><hi rendition="#small-caps">General Chen
                    Cheng</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d105-f1" n="40" type="source" xml:id="d105-f1-content">
                <p>For Lieutenant General Gillem in General Marshall’s absence.</p>
            </note>
            <note corresp="#d105-f2" n="41" xml:id="d105-f2-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d105-f3" n="42" xml:id="d105-f3-content">
                <p>On March 31 Lieutenant General Gillem replied approving the Chinese plan.</p>
            </note>
        </listAnnotation>
    </standOff>
