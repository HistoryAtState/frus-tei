    <text>
        <body>
            <div xml:id="d63">

                <pb facs="0200" n="188" sameAs="frus:frus1946v09/pg188"/>

                <note rend="inline" type="source">893.00/1–1746</note>
                <head><hi rendition="#italic">Memorandum by the Committee of Three to Generalissimo
                        Chiang Kai-shek</hi><anchor n="54" xml:id="d63-f1"/></head>
                <p>We, General Chang Chun, authorized representative of the National Government;
                    General Chou En-lai, authorized representative of the Chinese Communist Party[,]
                    and General George C. Marshall do urgently recommend that the Military
                    Sub-Committee, agreed to on 11 October 1945, be convened immediately to develop
                    a plan for the reorganization of the Armies of China at the earliest possible
                    date.</p>
                <pb facs="0201" n="189" xml:id="pg189"/>
                <p>A similar memorandum<anchor n="55" xml:id="d63-f2"/> is being forwarded to
                    Chairman Mao Tse-tung<anchor n="56" xml:id="d63-f3"/> through General Chou
                    En-lai.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Chang Chun</hi>
                        <lb/>
                        <hi rendition="#small-caps">Chou En-lai</hi>
                        <lb/> G. C. <hi rendition="#small-caps">Marshall</hi>
                    </signed>
                    <dateline rendition="#float-left">
                        <placeName><hi rendition="#small-caps">Chungking</hi></placeName>, <date
                            calendar="gregorian" when="1946-01-14">14 January
                        1946</date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d63-f1" n="54" type="source" xml:id="d63-f1-content">
                <p>Copy transmitted to the Secretary of State by General Marshall with his
                    memorandum of January 17; received January 31.</p>
            </note>
            <note corresp="#d63-f2" n="55" xml:id="d63-f2-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d63-f3" n="56" xml:id="d63-f3-content">
                <p>Chairman of the Central Committee of the Chinese Communist Party.</p>
            </note>
        </listAnnotation>
