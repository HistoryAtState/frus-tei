    <text>
        <body>
            <div xml:id="d224">

                <pb facs="0523" n="511" sameAs="frus:frus1946v09/pg511"/>

                <note rend="inline" type="source">121.893/3–746: Telegram</note>
                <head><hi rendition="#italic">President Truman to
                        General Marshall</hi></head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1946-03-07">7 March 1946</date>.</dateline>
                </opener>
                <p>WH 410. Replying to your message dated 6 March you are hereby directed to return
                    to Washington for consultation.</p>
                <p>In view of Mr. Churchill’s<anchor n="76" xml:id="d224-f1"/> desire to see you and
                    in view of his departure from Washington on March 12 it is desired that you
                    arrive prior to 12 March if practicable.</p>
                <closer><signed><hi rendition="#small-caps">Truman</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d224-f1" n="76" xml:id="d224-f1-content">
                <p>Winston S. Churchill, former British Prime Minister.</p>
            </note>
        </listAnnotation>
    </standOff>
