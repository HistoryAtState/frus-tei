    <text>
        <body>
            <div xml:id="d48">

                <pb facs="0171" n="159" xml:id="pg159"/>

                <note rend="inline" type="source">Marshall Mission Files, Lot 54–D270:
                    Telegram</note>
                <head><hi rendition="#italic">General Marshall to Lieutenant General Alvan C.
                        Gillem, Jr.</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1946-03-28">28 March 1946</date>.</dateline>
                </opener>
                <p>82420. Reference your 373<anchor n="23" xml:id="d48-f1"/> Chou En-lai. Please
                    advise me of your estimate of situation in Kuomintang Party regarding good faith
                    in carrying out recommendations of PPC [<hi rendition="#italic">PCC</hi>].</p>
            </div>
        </body>
    </text>
