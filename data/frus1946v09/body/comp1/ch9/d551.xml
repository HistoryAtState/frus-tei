    <text>
        <body>
            <div xml:id="d551">

                <pb facs="1070" n="1058" xml:id="pg1058"/>

                <note rend="inline" type="source">Marshall Mission Files, Lot 54–D270:
                    Telegram</note>
                <head><hi rendition="#italic">Colonel Marshall S.
                            Carter to General Marshall</hi></head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1946-06-14">14 June 1946</date>.</dateline>
                </opener>
                <p>91356. The following message is transmitted to you at the request of Acting
                    Secretary of State:<anchor n="93" xml:id="d551-f1"/>
                    <quote rend="blockquote">
                        <p>“We find very useful your messages, such as that of June 13, giving
                            authentic summary of current situation, particularly in view of
                            speculative press and radio reports. You will of course let us know when
                            there is anything we can do to be helpful.”</p>
                    </quote></p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d551-f1" n="93" xml:id="d551-f1-content">
                <p>Dean Acheson.</p>
            </note>
        </listAnnotation>
    </standOff>
