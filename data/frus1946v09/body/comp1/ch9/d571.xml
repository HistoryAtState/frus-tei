    <text>
        <body>
            <div xml:id="d571">

                <pb facs="1113" n="1101" sameAs="frus:frus1946v09/pg1101"/>

                <note rend="inline" type="source">Marshall Mission Files, Lot 54–D270</note>
                <head><hi rendition="#italic">Memorandum by General Chou En-lai to General
                        Marshall</hi></head>
                <opener>
                    <seg rendition="#float-left">MM 046</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Nanking</hi></placeName>, <date calendar="gregorian"
                            when="1946-06-19">19 June 1946</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Dear General Marshall</hi>: Enclosed and forwarded
                    for your reference is an appeal issued by the Communist representatives of 30
                    field teams asking for security and freedom of action.</p>
                <closer>[Signature in Chinese]<lb/>(<signed><hi rendition="#small-caps">Chou
                            En-lai</hi></signed>)</closer>



