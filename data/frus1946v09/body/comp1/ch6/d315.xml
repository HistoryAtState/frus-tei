    <text>
        <body>
            <div xml:id="d315">

                <pb facs="0665" n="653" sameAs="frus:frus1946v09/pg653"/>

                <note rend="inline" type="source">Marshall Mission Files, Lot 54–D270:
                    Telegram</note>
                <head><hi rendition="#italic">General Marshall to
                        Brigadier General Henry A. Byroade, at
                        Peiping</hi></head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Nanking</hi></placeName>,] <date calendar="gregorian"
                            when="1946-05-04">4 May 1946</date>.</dateline>
                </opener>
                <p>638. Want you to proceed urgently to Hankow on 5 May (tomorrow) to reach there by
                    about noon. Bring an extra field team. More follows in code.<anchor n="14"
                        xml:id="d315-f1"/></p>
            </div>
        </body>
    </text>
