    <text>
        <body>
            <div xml:id="d317">

                <pb facs="0665" n="653" sameAs="frus:frus1946v09/pg653"/>

                <note rend="inline" type="source">Marshall Mission Files, Lot 54–D270:
                    Telegram</note>
                <head><hi rendition="#italic">Brigadier General Henry A. Byroade to General
                        Marshall, at Nanking</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peiping</hi></placeName>, <date calendar="gregorian"
                            when="1946-05-04">4 May 1946</date>.</dateline>
                </opener>
                <p>2383. Have received your 638 and two subsequent messages<anchor n="16"
                        xml:id="d317-f1"/> reference Hankow situation. Will arrive Hankow with team
                    at 11:30 Sunday.</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d317-f1" n="16" xml:id="d317-f1-content">
                <p>Reference is to telegram No. 636, <hi rendition="#italic">supra</hi>, and to the
                    message which relayed General Chou’s report contained in telegram No. 1210, May
                    2, <ref target="#pg649">p. 649</ref> (see footnote 9, <ref target="#pg650">p.
                        650</ref>).</p>
            </note>
        </listAnnotation>
    </standOff>
