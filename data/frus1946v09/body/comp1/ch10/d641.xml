    <text>
        <body>
            <div xml:id="d641">

                <pb facs="1319" n="1307" sameAs="frus:frus1946v09/pg1307"/>

                <note rend="inline" type="source">Marshall Mission Files, Lot 54–D270:
                    Telegram</note>
                <head><hi rendition="#italic">Colonel Marshall S.
                            Carter to General Marshall</hi></head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1946-07-06">6 July 1946</date>.</dateline>
                </opener>
                <p>93593. Following message transmitted to you at request of Acting Secretary of
                    State Dean Acheson:</p>
                <quote rend="blockquote"><p>“Your 1053<anchor n="70" xml:id="d641-f1"/> has my
                        complete support. I understand that you are in process of determining
                        whether Doctor Stuart will be acceptable to Chinese Government. I stand
                        ready to take immediate action to <pb facs="1320" n="1308" xml:id="pg1308"/>
                        secure his appointment upon receiving your final clearance. Signed Acheson
                        Acting.”</p></quote>
            </div>
        </body>
    </text>
