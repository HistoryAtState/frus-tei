    <text>
        <body>
            <div xml:id="d939">

                <pb facs="0923" n="839" sameAs="frus:frus1918Supp02/pg839"/>

                <note rend="inline" type="source">File No. 800.74/9</note>
                <head>
                    <hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic"
                        >Sharp</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1918-01-18">
                            <hi rendition="#italic">January 18, 1918</hi></date>. <lb/> [<hi
                            rendition="#italic">Received February 5</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith, in
                    copy and translation:</p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>4. The protocol of a conference which took place on the 5th of January, 1918,
                    between the American and French members of such Commission.<anchor n="1"
                        xml:id="d939-f1"/>
                </p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wm. G. Sharp</hi>
                    </signed>
                </closer>


                <xi:include href="d939-a1.xml" xpointer="d939-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d939-f1" n="1" xml:id="d939-f1-content">
                <p>The Inter-Allied Radiotelegraphic Commission.</p>
            </note>
        </listAnnotation>
