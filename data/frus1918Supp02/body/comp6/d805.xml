    <text>
        <body>
            <div xml:id="d805">

                <pb facs="0734" n="650" sameAs="frus:frus1918Supp02/pg650"/>

                <note rend="inline" type="source">File No. 811.2222/1322a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Great Britain</hi> (<hi
                            rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-10-30T15:00:00-05:00">
                            <hi rendition="#italic">October 30, 1917, 3 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>5691. British Ambassador states Foreign Office has submitted to you counter-draft
                    of proposed convention respecting conscription of citizens and subjects of
                    contracting parties. If proposal has not been transmitted by mail so as to reach
                    here within three or four days, telegraph text immediately.</p>
                <closer>[<signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        </signed>]</closer>
            </div>
        </body>
    </text>
