    <text>
        <body>
            <div xml:id="d738">

                <pb facs="0677" n="593" sameAs="frus:frus1918Supp02/pg593"/>

                <note rend="inline" type="source">File No. 872.51/29</note>
                <head>
                    <hi rendition="#italic">The Assistant Secretary of the Treasury</hi> (<hi
                        rendition="#italic">Crosby</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-06-11">
                            <hi rendition="#italic">June 11, 1917</hi></date>. <lb/> [<hi
                            rendition="#italic">Received June 13.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: In the absence of
                    McAdoo, I have the honor to send to you, for your information, the inclosed
                    copies of correspondence between the Serbian Minister and this Department, on
                    the subject of a loan to the Serbian Government.</p>
                <pb facs="0678" n="594" xml:id="pg594"/>
                <p>Holding myself entirely at your convenience to furnish you any additional
                    information which you may desire on this matter, I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Oscar T. Crosby</hi>
                    </signed>
                </closer>



                <xi:include href="d738-a1.xml" xpointer="d738-a1"/>
