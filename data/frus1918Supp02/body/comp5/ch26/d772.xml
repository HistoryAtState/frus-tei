    <text>
        <body>
            <div xml:id="d772">

                <pb facs="0708" n="624" sameAs="frus:frus1918Supp02/pg624"/>

                <note rend="inline" type="source">File No. 763.72114/4139</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Special Agent in Corfu</hi> (<hi
                            rendition="#italic">Dodge</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-11-08T18:00:00-05:00">
                            <hi rendition="#italic">November 8, 1918, 6 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your October 31, 4 p.m.<anchor n="1" xml:id="d772-f1"/> Department assumes the
                    request for additional assistance for Serbian prisoners of war, referred to in
                    second paragraph of your October 5, 10 a.m., may be disregarded in view of
                    capitulation of Austria-Hungary and Bulgaria.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
