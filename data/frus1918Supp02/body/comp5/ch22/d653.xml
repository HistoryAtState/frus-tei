    <text>
        <body>
            <div xml:id="d653">

                <pb facs="0621" n="537" xml:id="pg537"/>

                <note rend="inline" type="source">File No. 860c.48/146</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in
                        Switzerland</hi> (<hi rendition="#italic">Stovall</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-10-22T19:00:00-04:00">
                            <hi rendition="#italic">October 22, 1918, 7 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>3181. Your 5036. Red Cross advises that milk could be forwarded in powdered form
                    in paper-lined wooden cases.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
