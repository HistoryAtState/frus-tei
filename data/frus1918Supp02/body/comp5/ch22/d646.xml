    <text>
        <body>
            <div xml:id="d646">

                <pb facs="0617" n="533" sameAs="frus:frus1918Supp02/pg533"/>

                <note rend="inline" type="source">File No. 860c.48/84f</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Minister in the
                        Netherlands</hi> (<hi rendition="#italic">Garrett</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-06-05T15:00:00-04:00">
                            <hi rendition="#italic">June 5, 1918, 3 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>1393. Inform authorities and Relief Committee all receipt forms for relief moneys
                    must bear indications that such moneys come from United States.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Polk</hi>
                    </signed>
                </closer>
            </div>
        </body>
