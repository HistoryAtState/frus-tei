    <text>
        <body>
            <div xml:id="d688">

                <pb facs="0641" n="557" sameAs="frus:frus1918Supp02/pg557"/>

                <note rend="inline" type="source">File No. 867.48/740</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Minister in Sweden</hi> (<hi
                            rendition="#italic">Morris</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-04-15T17:00:00-04:00">
                            <hi rendition="#italic">April 15, 1918, 5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>708. Your 1452<anchor n="1" xml:id="d688-f1"/> and 1635. Plan for forwarding gold
                    from Sweden to Constantinople definitely disapproved. Cancel check for
                    $50,000.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
