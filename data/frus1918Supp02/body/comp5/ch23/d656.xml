    <text>
        <body>
            <div xml:id="d656">

                <pb facs="0622" n="538" sameAs="frus:frus1918Supp02/pg538"/>

                <note rend="inline" type="source">File No. 867.48/517</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Turkey</hi> (<hi rendition="#italic"
                        >Elkus</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Constantinople</hi></placeName>, <date
                            calendar="gregorian" when="1917-01-08T12:00:00+02:00">
                            <hi rendition="#italic">January 8, 1917, noon</hi></date>. <lb/> [<hi
                            rendition="#italic">Received January 10, 8 a.m.</hi>]</dateline>
                </opener>
                <p>2387. Djemal Pasha<anchor n="1" xml:id="d656-f1"/> requests that three-fourths of
                        <hi rendition="#italic"> Caesar’s</hi> supplies be landed at Beirut for
                    distribution to Palestine poor and one-fourth at Jaffa.<anchor n="2"
                        xml:id="d656-f2"/> Does Department approve?</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Elkus</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d656-f1" n="1" xml:id="d656-f1-content">
                <p>Turkish Minister of Marine.</p>
            </note>
            <note corresp="#d656-f2" n="2" xml:id="d656-f2-content">
                <p>See Department’s circular telegram of Dec. 19, 1916, <ref
                        target="frus1916Supp#pg_940">
                        <hi rendition="#italic">Foreign Relations</hi>, 1916, Supplement, p.
                        940</ref>.</p>
            </note>
