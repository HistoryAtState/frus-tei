    <text>
        <body>
            <div xml:id="d705">

                <pb facs="0651" n="567" sameAs="frus:frus1918Supp02/pg567"/>

                <note rend="inline" type="source">File No. 891.48/60a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Minister in Persia</hi> (<hi
                            rendition="#italic">Caldwell</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-05-29">
                            <hi rendition="#italic">May 29, 1918</hi></date>.</dateline>
                </opener>
                <p>60. Draw on Secretary of State $15,000 deposited by Joint Distribution Committee
                    by method most advantageous to save exchange, consult Committee Bienfaisance
                    Israelite, Teheran, Alliance Israelite, Hamadan, and British Consul, Ispahan,
                    and other leaders, Jewish community especially, and distribute money relieving
                    Jewish <pb facs="0652" n="568" xml:id="pg568"/> distress. Send detailed reports
                    from local committees for Joint Distribution Committee at earliest
                    opportunity.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
