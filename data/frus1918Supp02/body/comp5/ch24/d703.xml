    <text>
        <body>
            <div xml:id="d703">

                <pb facs="0651" n="567" xml:id="pg567"/>

                <note rend="inline" type="source">File No. 891.48/48</note>
                <head>
                    <hi rendition="#italic">The Minister in Persia</hi> (<hi rendition="#italic">Caldwell</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Teheran</hi></placeName>, <date
                            calendar="gregorian" when="1918-05-13T11:00:00+03:25">
                            <hi rendition="#italic">May 13, 1918, 11 a.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received May 14, 9.44 a.m.</hi>]</dateline>
                </opener>
                <p>Your telegram 53, May 10, 6 p.m. Needy Jews in Persia estimated thirty to forty
                    thousand of which probably 25 per cent are starving and in dire need.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Caldwell</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
