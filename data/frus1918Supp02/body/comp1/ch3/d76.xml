    <text>
        <body>
            <div xml:id="d76">

                <pb facs="0129" n="45" sameAs="frus:frus1918Supp02/pg45"/>

                <note rend="inline" type="source">File No. 763.72114/3846</note>
                <head>
                    <hi rendition="#italic">The Chargé in Switzerland</hi> (<hi rendition="#italic"
                        >Wilson</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1707</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berne</hi></placeName>, <date
                            calendar="gregorian" when="1917-11-09">
                            <hi rendition="#italic">November 9, 1917</hi></date>. <lb/> [<hi
                            rendition="#italic">Received November 27.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to the Department’s cipher
                    telegram No. 1058 of October 26, concerning the proposal to be made to the
                    German <pb facs="0130" n="46" xml:id="pg46"/> Government with respect to
                    exchange of sanitary personnel, I have the honor to report that in accordance
                    with my telegram No. 2017 of today’s date<anchor n="1" xml:id="d76-f1"/> I am
                    transmitting herewith enclosed copies and translation of the reply of the German
                    Government, transmitted to me through the Royal Spanish Legation in this city
                    and received today.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hugh R. Wilson</hi>
                    </signed>
                </closer>


                <xi:include href="d76-a1.xml" xpointer="d76-a1"/>
            </div>
        </body>
    </text>
