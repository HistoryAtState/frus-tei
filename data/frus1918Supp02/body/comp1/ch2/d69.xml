    <text>
        <body>
            <div xml:id="d69">

                <pb facs="0124" n="40" sameAs="frus:frus1918Supp02/pg40"/>

                <note rend="inline" type="source">File No. 763.72114/3315</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Chargé in Switzerland</hi> (<hi
                            rendition="#italic">Wilson</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-02-23T17:00:00-05:00">
                            <hi rendition="#italic">February 23, 1918, 5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>1488. Your 2672, February 19, 10 a.m.<anchor n="2" xml:id="d69-f1"/> Swiss
                    Legation, Washington, has not received despatch of German Government regarding
                        <pb facs="0125" n="41" xml:id="pg41"/> pay of officers. Please telegraph
                    summary of important points of this despatch immediately.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
