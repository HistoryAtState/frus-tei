    <text>
        <body>
            <div xml:id="d133">

                <pb facs="0179" n="95" sameAs="frus:frus1918Supp02/pg95"/>

                <note rend="inline" type="source">File No. 763.72114A/208</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in
                        Switzerland</hi> (<hi rendition="#italic">Stovall</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-10-05T15:00:00-04:00">
                            <hi rendition="#italic">October 5, 1918, 3 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>3073. For Garrett:</p>
                <p>Your 13, October 1, 10 a.m. Views of commission approved. You may exercise free
                    hand in this matter of the employment of exchanged and repatriated war
                    prisoners.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
