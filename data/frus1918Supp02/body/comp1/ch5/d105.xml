    <text>
        <body>
            <div xml:id="d105">

                <pb facs="0164" n="80" sameAs="frus:frus1918Supp02/pg80"/>

                <note rend="inline" type="source">File No. 362.11/5374</note>
                <head>
                    <hi rendition="#italic">The Minister in Switzerland</hi> (<hi rendition="#italic"
                        >Stovall</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berne</hi></placeName>, <date
                            calendar="gregorian" when="1918-06-06T09:00:00+01:00">
                            <hi rendition="#italic">June 6, 1918, 9 a.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received June 8, 5.05 a.m.</hi>]</dateline>
                </opener>
                <p>3583. Department’s 2019, June 1, 6 p.m. Your inquiry is being transmitted to
                    Spanish Embassy at Berlin. I respectfully urge that definite proposals be
                    immediately submitted to the German Government regarding repatriation and
                    internment.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Stovall</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
