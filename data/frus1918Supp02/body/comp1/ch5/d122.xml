            <div xml:id="d122">

                <pb facs="0172" n="88" sameAs="frus:frus1918Supp02/pg88"/>

                <note rend="inline" type="source">File No. 763.72114A/168</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in France</hi>
                        (<hi rendition="#italic">Sharp</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-09-17">
                            <hi rendition="#italic">September 17, 1918</hi></date>.</dateline>
                </opener>
                <p>5642. For Garrett:</p>
                <p>Your 3, September 13. Your attitude is cordially approved.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
