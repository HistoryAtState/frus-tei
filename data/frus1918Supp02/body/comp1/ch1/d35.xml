    <text>
        <body>
            <div xml:id="d35">

                <pb facs="0106" n="22" sameAs="frus:frus1918Supp02/pg22"/>

                <note rend="inline" type="source">File No. 763.72114/3285</note>
                <head>
                    <hi rendition="#italic">The Chargé in Switzerland</hi> (<hi rendition="#italic"
                        >Wilson</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berne</hi></placeName>, <date
                            calendar="gregorian" when="1918-02-09T11:00:00+01:00">
                            <hi rendition="#italic">February 9, 1918, 11 a.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received February 11, 5.20
                        a.m.</hi>]</dateline>
                </opener>
                <p>2607. Department’s 1307, January 8.<anchor n="1" xml:id="d35-f1"/> Swiss
                    Government replies will gladly undertake free transmission for present of
                    letters, money orders, and packages under 5 kilograms directed to American
                    prisoners of war and interned civilians in Germany, Austria-Hungary, Bulgaria
                    and Turkey although United States not a signatory of Rome postal
                        convention.<anchor n="2" xml:id="d35-f2"/> Should number of packages
                    increase greatly, postage of 25 centimes per parcel may be asked as already
                    required from France, Great Britain, Italy, Germany and Austria-Hungary.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wilson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d35-f1" n="1" xml:id="d35-f1-content">
                <p>See footnote 1, <hi rendition="#italic">ante</hi>, <ref target="#pg18">p.
                        18</ref>.</p>
            </note>
            <note corresp="#d35-f2" n="2" xml:id="d35-f2-content">
                <p>Reference is apparently made to the Universal Postal Convention signed at Rome
                    May 26, 1906; but the United States <hi rendition="#italic">was</hi> a signatory
                    of this convention (35 Stat. 1639).</p>
            </note>
        </listAnnotation>
    </standOff>
