    <text>
        <body>
            <div xml:id="d48">

                <pb facs="0114" n="30" xml:id="pg30"/>

                <note rend="inline" type="source">File No. 763.72114/3593</note>
                <head>
                    <hi rendition="#italic">The Minister in Switzerland</hi> (<hi rendition="#italic"
                        >Stovall</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berne</hi></placeName>, <date
                            calendar="gregorian" when="1918-05-09T18:00:00+01:00">
                            <hi rendition="#italic">May 9, 1918, 6 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received May 10, 8.23 p.m.</hi>]</dateline>
                </opener>
                <p>3315. Spanish Embassy, Berlin, transmits from German Army administration
                    [communication] dated April 8, to the effect that [all privates] and
                    noncommissioned officers of American Army, after being disinfected at temporary
                    camp, will be concentrated at camp Tuchel and no change to occur except in case
                    of individuals assigned for work. American Navy men to be concentrated at
                    Brandenburg. Document follows.<anchor n="1" xml:id="d48-f1"/>
                </p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Stovall</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
