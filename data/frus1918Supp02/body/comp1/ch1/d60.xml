    <text>
        <body>
            <div xml:id="d60">

                <pb facs="0119" n="35" sameAs="frus:frus1918Supp02/pg35"/>

                <note rend="inline" type="source">File No. 763.72114/3999</note>
                <head>
                    <hi rendition="#italic">The Minister in Switzerland</hi> (<hi rendition="#italic"
                        >Stovall</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 4190</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berne</hi></placeName>, <date
                            calendar="gregorian" when="1918-08-16">
                            <hi rendition="#italic">August 16, 1918</hi></date>. <lb/> [<hi
                            rendition="#italic">Received September 10.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith copy
                    and translation of a <hi rendition="#italic">note verbale</hi> from the German
                    Foreign Office to the Swiss Legation in Berlin, transmitted by the Royal Spanish
                    Embassy, Berlin, relative to photographs and fingerprints being taken of German
                    officers who are prisoners of war.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Pleasant A. Stovall</hi>
                        
                    </signed>
                </closer>



                <xi:include href="d60-a1.xml" xpointer="d60-a1"/>
            </div>
