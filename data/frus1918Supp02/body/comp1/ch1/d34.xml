    <text>
        <body>
            <div xml:id="d34">

                <pb facs="0106" n="22" sameAs="frus:frus1918Supp02/pg22"/>

                <note rend="inline" type="source">File No. 763.72114/3269</note>
                <head>
                    <hi rendition="#italic">The Minister in the Netherlands</hi> (<hi
                        rendition="#italic">Garrett</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">The Hague</hi></placeName>, <date
                            ana="#date_undated-inferred-from-document-content-and-sibling-dates"
                            calendar="gregorian" notAfter="1918-02-05T19:00:00+00:19"
                            notBefore="1918-02-03T17:00:00+01:00"><hi rendition="#italic"
                                >undated</hi></date>. <lb/> [<hi rendition="#italic">Received
                            February 5, 1918, 7 p.m.</hi>]</dateline>
                </opener>
                <p>2004. Your January 8.<anchor n="1" xml:id="d34-f1"/> Foreign Office states that
                    Netherlands Government will pass free of postage letters and parcels to or from
                    military and civilian prisoners of war.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Garrett</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
