            <div xml:id="d61">

                <pb facs="0120" n="36" sameAs="frus:frus1918Supp02/pg36"/>

                <note rend="inline" type="source">File No. 763.72114A/200</note>
                <head>
                    <hi rendition="#italic">The Minister in Switzerland</hi> (<hi rendition="#italic"
                        >Stovall</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berne</hi></placeName>, <date
                            calendar="gregorian" when="1918-09-27T14:00:00+01:00">
                            <hi rendition="#italic">September 27, 1918, 2 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received September 28, 10.02
                        p.m.</hi>]</dateline>
                </opener>
                <p>4929. Legation’s 4330, August 15, 3 p.m. and Department’s 2431, August 1, 4 p.m.
                        [<hi rendition="#italic">August 12, 3 p.m.</hi>]. Spanish Embassy, Berlin,
                    states according to information received from the German military authorities
                    the American prisoners were transferred from Tuchel to Rastatt for agricultural
                    reasons and that there are at Rastatt three camps, one each for officers,
                    soldiers, and civilians.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Stovall</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
