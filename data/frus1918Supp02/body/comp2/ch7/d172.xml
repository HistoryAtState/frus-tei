    <text>
        <body>
            <div xml:id="d172">

                <pb facs="0261" n="177" sameAs="frus:frus1918Supp02/pg177"/>

                <note rend="inline" type="source">File No. 355.11/728</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Spain</hi> (<hi rendition="#italic"
                        >Willard</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Madrid</hi></placeName>, <date
                            calendar="gregorian" when="1917-09-06">
                            <hi rendition="#italic">September 6, 1917</hi></date>. <lb/> [<hi
                            rendition="#italic">Received 12 midnight.</hi>]</dateline>
                </opener>
                <p>774. Department’s 567, July 2.<anchor n="1" xml:id="d172-f1"/> German authorities
                    have decided to grant passports to Clayton and Whipple, who will receive them in
                    a few days.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Willard</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
