    <text>
        <body>
            <div xml:id="d163">

                <pb facs="0255" n="171" sameAs="frus:frus1918Supp02/pg171"/>

                <note rend="inline" type="source">File No. 711.622/12</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Attorney General</hi> (<hi
                        rendition="#italic">Gregory</hi>)<anchor n="1" xml:id="d163-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-05-09">
                            <hi rendition="#italic">May 9, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Attorney General</hi>: With reference to
                    the question of the interpretation of article 23 of the treaty of 1799 between
                    the United States and Prussia and whether or not the treaty is binding so far as
                    this Government is concerned, I enclose for your information copy of a letter
                    dated May 8 from the President<anchor n="2" xml:id="d163-f2"/> giving his views
                    in reply to my letter to him of the 21st ultimo.<anchor n="3" xml:id="d163-f3"/>
                    A copy of the treaty article referred to is also enclosed.<anchor n="4"
                        xml:id="d163-f4"/>
                </p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d163-f1" n="1" type="source" xml:id="d163-f1-content">
                <p>The same, on the same date, to the Secretary of Labor.</p>
            </note>
            <note corresp="#d163-f2" n="2" xml:id="d163-f2-content">
                <p>
                    <hi rendition="#italic">Supra.</hi>
                </p>
            </note>
            <note corresp="#d163-f3" n="3" xml:id="d163-f3-content">
                <p>For a further statement concerning the validity of the treaty of 1799 see
                    instructions to the chairman of the American Commission to the Prisoners of War
                    Conference, Aug. 22, 1918, <hi rendition="#italic">ante</hi>, <ref
                        target="#pg86">p. 86</ref>.</p>
            </note>
            <note corresp="#d163-f4" n="4" xml:id="d163-f4-content">
                <p>Enclosure not printed.</p>
            </note>
        </listAnnotation>
    </standOff>
