    <text>
        <body>
            <div xml:id="d191">

                <pb facs="0279" n="195" sameAs="frus:frus1918Supp02/pg195"/>

                <note rend="inline" type="source">File No. 763.72115/3363</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Swiss Chargé</hi> (<hi
                        rendition="#italic">Hübscher</hi>)</head>
                <p>The Secretary of State presents his compliments to the Chargé d’Affaires <hi
                        rendition="#italic">ad interim</hi> of Switzerland, in charge of German
                    interests in the United States and, with reference to the latter’s note of June
                    25, 1918,<anchor n="1" xml:id="d191-f1"/> in which inquiry was made whether
                    alien enemies interned in the United States are permitted to send money to
                    Germany, has the honor to state that it is not deemed advisable at the present
                    time to extend this privilege to the class of interned German nationals referred
                    to.</p>
                <closer>
                    <dateline rendition="#float-left">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1918-08-09"><hi
                                rendition="#italic">August 9, 1918</hi></date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
