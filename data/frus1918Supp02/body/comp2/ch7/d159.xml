    <text>
        <body>
            <div xml:id="d159">

                <pb facs="0253" n="169" xml:id="pg169"/>

                <note rend="inline" type="source">File No. 763.72115/3107</note>
                <head>
                    <hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >Reinsch</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Peking</hi></placeName>, <date
                            calendar="gregorian" when="1917-04-19T17:00:00+08:00">
                            <hi rendition="#italic">April 19, 1917, 5 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received April 19, 9.30 a.m.</hi>]</dateline>
                </opener>
                <p>Please inform me whether Germans not of military age or German women or children
                    may be permitted to enter the United States in case of pressing wants.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Reinsch</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
