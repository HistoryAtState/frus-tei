    <text>
        <body>
            <div xml:id="d215">

                <pb facs="0306" n="222" sameAs="frus:frus1918Supp02/pg222"/>

                <note rend="inline" type="source">File No. 763.72111/4757</note>
                <head>
                    <hi rendition="#italic">The Secretary of Labor</hi> (<hi rendition="#italic">Wilson</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-04-06">
                            <hi rendition="#italic">April 6, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: As an expeditious means
                    of furnishing you with information with respect to the manner in which this
                    Department has cared for the officers and crewmen of the German vessels lying in
                    American ports, I have the honor to hand you herewith a copy of a communication
                    which I am at this time sending to the President.</p>
                <p>Cordially yours,</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">W. B. Wilson</hi>
                        
                    </signed>
                </closer>


                <xi:include href="d215-a1.xml" xpointer="d215-a1"/>
            </div>
