    <text>
        <body>
            <div xml:id="d368">

                <pb facs="0423" n="339" xml:id="pg339"/>

                <note rend="inline" type="source">File No. No. 763.72113/596</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Alien Property
                        Custodian</hi> (<hi rendition="#italic">Palmer</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-07-27">
                            <hi rendition="#italic">July 27, 1918</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The Department has received your letter of
                    June 24, 1918, respecting certain funds held by Swedish consuls and Swiss
                    consuls, in charge of Austro-Hungarian and German interests in the United
                    States, respectively, in which you state that unless there is some diplomatic
                    reason to the contrary you propose to make formal demand, in the usual form,
                    upon the Swedish and Swiss consuls for the delivery to you of the enemy property
                    in question.</p>
                <p>In reply you are informed that this Department perceives of no reason why you
                    should not carry out the action proposed.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">William Phillips</hi>
                    </signed>
                    <lb/>
                    <hi rendition="#italic">Assistant Secretary</hi>
                </closer>
            </div>
        </body>
    </text>
