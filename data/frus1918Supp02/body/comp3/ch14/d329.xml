    <text>
        <body>
            <div xml:id="d329">

                <pb facs="0395" n="311" sameAs="frus:frus1918Supp02/pg311"/>

                <note rend="inline" type="source">File No. 763.72113/679</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Spain</hi> (<hi rendition="#italic"
                        >Willard</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1277</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">San Sebastian</hi></placeName>, <date
                            calendar="gregorian" when="1918-08-11">
                            <hi rendition="#italic">August 11, 1918</hi></date>. <lb/> [<hi
                            rendition="#italic">Received September 10.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to the Department’s instruction
                    No. 786, April 18, 1918,<anchor n="1" xml:id="d329-f1"/> directing the Embassy
                    to secure information in regard to property in Germany of American citizens,
                    etc., I have the honor to enclose herewith a copy of a <hi rendition="#italic"
                        >note verbale</hi> from the German Ministry of Foreign Affairs to the
                    Spanish Ambassador in Berlin in reply to the latter’s inquiry on this point.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Joseph E. Willard</hi>
                        
                    </signed>
                </closer>


                <xi:include href="d329-a1.xml" xpointer="d329-a1"/>
            </div>
        </body>
    </text>
