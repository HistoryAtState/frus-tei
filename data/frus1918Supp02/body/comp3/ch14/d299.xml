    <text>
        <body>
            <div xml:id="d299">

                <pb facs="0367" n="283" xml:id="pg283"/>

                <note rend="inline" type="source">File No. 763.72113/450</note>
                <head>
                    <hi rendition="#italic">The French Ambassador</hi> (<hi rendition="#italic"
                        >Jusserand</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Translation]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-01-30">
                            <hi rendition="#italic">January 30, 1918</hi></date>. <lb/> [<hi
                            rendition="#italic">Received February 1.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">The Secretary of State</hi>: My Government has just
                    forwarded to me the text of an order of the Imperial Chancellor published in the
                        <hi rendition="#italic">Reichsanzeiger</hi> of December 18 last, relative to
                    the custodianship of American interests in Germany.</p>
                <p>For all pertinent purposes I have the honor to transmit herewith to Your
                    Excellency a copy of a memorandum in which my Government condensed the
                    information it has received on the subject.</p>
                <p>Be pleased to accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Jusserand</hi>
                    </signed>
                </closer>


                <xi:include href="d299-a1.xml" xpointer="d299-a1"/>
            </div>
