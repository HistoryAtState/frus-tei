    <text>
        <body>
            <div xml:id="d281">

                <pb facs="0352" n="268" sameAs="frus:frus1918Supp02/pg268"/>

                <note rend="inline" type="source">File No. 763.72113/405</note>
                <head>
                    <hi rendition="#italic">The Minister in the Netherlands</hi> (<hi
                        rendition="#italic">Garrett</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">The Hague</hi></placeName>, <date
                            calendar="gregorian" when="1917-11-22">
                            <hi rendition="#italic">November 22, 1917</hi></date>. <lb/> [<hi
                            rendition="#italic">Received 7.37 p.m.</hi>]</dateline>
                </opener>
                <p>1672. <hi rendition="#italic">Reichsofnzeiger</hi> announces that provisions
                    relative to compulsory registration of enemy property in Germany have been made
                    applicable to United States commencing with November 30.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Garrett</hi>
                    </signed>
                </closer>
            </div>
        </body>
