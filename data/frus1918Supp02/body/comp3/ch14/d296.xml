    <text>
        <body>
            <div xml:id="d296">

                <pb facs="0363" n="279" sameAs="frus:frus1918Supp02/pg279"/>

                <note rend="inline" type="source">File No. 763.72113/446</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Spain</hi> (<hi rendition="#italic"
                        >Willard</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1005</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Madrid</hi></placeName>, <date
                            calendar="gregorian" when="1917-12-22">
                            <hi rendition="#italic">December 22, 1917</hi></date>. <lb/> [<hi
                            rendition="#italic">Received January 26, 1918.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The Minister of State informs the Embassy
                    that he has been notified by the Spanish Ambassador in Berlin that, in
                    compliance with the desires expressed by the American Legation in Berne,
                    information was requested of the German Government on November 6 in <pb
                        facs="0364" n="280" xml:id="pg280"/> regard to the regulations in force
                    concerning deposits, securities and current accounts in German banks belonging
                    to American citizens.<anchor n="1" xml:id="d296-f1"/> The German Government has
                    sent to the Spanish Ambassador a reply, copies of which are enclosed
                    herewith.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Joseph E. Willard</hi>
                        
                    </signed>
                </closer>


                <xi:include href="d296-a1.xml" xpointer="d296-a1"/>
            </div>
        </body>
    </text>
    <standOff>
