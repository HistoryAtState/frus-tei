    <text>
        <body>
            <div xml:id="d313">

                <pb facs="0379" n="295" sameAs="frus:frus1918Supp02/pg295"/>

                <note rend="inline" type="source">File No. 763.72113/530</note>
                <head>
                    <hi rendition="#italic">The Swiss Minister</hi> (<hi rendition="#italic">Sulzer</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">Department of German <lb/> Interests IV–14–B</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-04-15">
                            <hi rendition="#italic">April 15, 1918</hi></date>. <lb/> [<hi
                            rendition="#italic">Received April 22.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to Your Excellency’s note
                    dated April 9, 1918,<anchor n="3" xml:id="d313-f1"/> and in confirmation of my
                    note dated March 19, 1918,<anchor n="3" xml:id="d313-f2"/> wherewith I advised
                    Your Excellency of the contents of a cablegram received from the Swiss Foreign
                    Office, relative to the attitude of the German Government with respect to the
                    measures taken by the Government of the United States concerning private German
                    property.</p>
                <p>I now have the honor to enclose copy of a <hi rendition="#italic">note
                        verbale</hi> of the German Foreign Office, dated March 10, 1918, upon which
                    the above-mentioned cablegram was based.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Hans Sulzer</hi>
                        
                    </signed>
                </closer>



                <xi:include href="d313-a1.xml" xpointer="d313-a1"/>
            </div>
        </body>
    </text>
