    <text>
        <body>
            <div xml:id="d278">

                <pb facs="0350" n="266" sameAs="frus:frus1918Supp02/pg266"/>

                <note rend="inline" type="source">File No. 371.11/207</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Chargé in Switzerland</hi>
                        (<hi rendition="#italic">Wilson</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-10-31T18:00:00-05:00">
                            <hi rendition="#italic">October 31, 1917, 6 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>1076. For Berlin:</p>
                <p>It has been reported to this Government that the German Government intends
                    shortly to auction American oil properties in Roumania. Please use your utmost
                    endeavors to ascertain immediately if this report is correct, and reply by
                    telegraph.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
