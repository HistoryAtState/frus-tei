    <text>
        <body>
            <div xml:id="d417">

                <pb facs="0456" n="372" sameAs="frus:frus1918Supp02/pg372"/>

                <note rend="inline" type="source">File No. No. 763.72113/664</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in Guatemala</hi>
                        (<hi rendition="#italic">Leavell</hi>)<anchor n="2" xml:id="d417-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-10-22T16:00:00-04:00">
                            <hi rendition="#italic">October 22, 1918, 4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your August 2, 4 p.m.<anchor n="3" xml:id="d417-f2"/> Department at request of
                    War Trade Board has designated Edward to act as special agent for the Department
                    of State to give advice in connection with the management of alien property
                    administration in Guatemala, Honduras, and Nicaragua. Mr. Ames will leave for
                    Guatemala toward the end of the month.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d417-f1" n="2" type="source" xml:id="d417-f1-content">
                <p>The same, <hi rendition="#italic">mutatis mutandis</hi>, on the same date, to the
                    Minister in Honduras and the Minister in Nicaragua. (File Nos.
                    763.72113/684.704.)</p>
            </note>
            <note corresp="#d417-f2" n="3" xml:id="d417-f2-content">
                <p>Not printed.</p>
            </note>
        </listAnnotation>
