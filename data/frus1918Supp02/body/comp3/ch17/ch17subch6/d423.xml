    <text>
        <body>
            <div xml:id="d423">

                <pb facs="0459" n="375" sameAs="frus:frus1918Supp02/pg375"/>

                <note rend="inline" type="source">File No. No. 763.72112Aml/10</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in Honduras</hi>
                        (<hi rendition="#italic">Ewing</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-12-29T17:00:00-05:00">
                            <hi rendition="#italic">December 29, 1917, 5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Department informed that port of Amapala closed. Report immediately by cable and
                    give all details regard to excelling, of Kohncke as agents Pacific Mail referred
                    to in your December 28, noon.<anchor n="1" xml:id="d423-f1"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
