            </note>
            <note corresp="#d424-f2" n="1" xml:id="d424-f2-content">
                <p>Representative of Kohncke &amp; Co.</p>
            </note>
            <note corresp="#d424-f3" n="2" xml:id="d424-f3-content">
                <p> John W. Belt, Secretary of Legation at Tegucigalpa.</p>
            </note>
        </listAnnotation>
