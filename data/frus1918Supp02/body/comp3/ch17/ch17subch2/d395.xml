    <text>
        <body>
            <div xml:id="d395">

                <pb facs="0443" n="359" sameAs="frus:frus1918Supp02/pg359"/>

                <note rend="inline" type="source">File No. No. 763.72113/692</note>
                <head>
                    <hi rendition="#italic">The Minister in Cuba</hi> (<hi rendition="#italic"
                        >Gonzales</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Habana</hi></placeName>, <date
                            calendar="gregorian" when="1918-09-20T11:00:00-05:29">
                            <hi rendition="#italic">September 20, 1918, 11 a.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 2.45 p.m.</hi>]</dateline>
                </opener>
                <p>Doctor Sánchez de Bustamante, the eminent lawyer, has taken charge of office as
                    custodian of enemy property.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Gonzales</hi>
                    </signed>
                </closer>
            </div>
        </body>
