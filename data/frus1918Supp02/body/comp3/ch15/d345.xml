    <text>
        <body>
            <div xml:id="d345">

                <pb facs="0406" n="322" sameAs="frus:frus1918Supp02/pg322"/>

                <note rend="inline" type="source">File No. 811.54262/137</note>
                <head>
                    <hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic">Sharp</hi>)
                        <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1917-07-25T19:00:00+01:00">
                            <hi rendition="#italic">July 25, 1917, 7 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received July 27, 8.53 a.m.</hi>]</dateline>
                </opener>
                <p>2326. Your 2361, June 16.<anchor n="1" xml:id="d345-f1"/> Have today received
                    verbal assurances from Foreign Office that remittances for patent rights will be
                    permitted to pass without detention by the censors.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Sharp</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
