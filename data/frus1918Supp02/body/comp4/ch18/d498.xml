    <text>
        <body>
            <div xml:id="d498">

                <pb facs="0513" n="429" sameAs="frus:frus1918Supp02/pg429"/>

                <note rend="inline" type="source">File No. No. 763.72112/5846</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in Cuba</hi> (<hi
                        rendition="#italic">Gonzales</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-01-03T17:00:00-05:00">
                            <hi rendition="#italic">January 3, 1918, 5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your December 11, 1 p.m. War Trade Board advises Trading with Enemy Act does not
                    apply to American nationals resident in Cuba nor to partnerships composed of
                    American nationals resident in Cuba, but does apply to American corporations
                    having mere agencies in Cuba.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
