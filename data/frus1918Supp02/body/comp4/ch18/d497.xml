    <text>
        <body>
            <div xml:id="d497">

                <pb facs="0512" n="428" sameAs="frus:frus1918Supp02/pg428"/>

                <note rend="inline" type="source">File No. No. 763.72112/5970</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Chargé in Costa Rica</hi> (<hi
                            rendition="#italic">Johnson</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-12-31T15:00:00-05:00">
                            <hi rendition="#italic">December 31, 1917, 3 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your December 20, 2 p.m.<anchor n="1" xml:id="d497-f1"/> War Trade Board advises
                    German subjects in neutral countries not doing business in enemy territory <pb
                        facs="0513" n="429" xml:id="pg429"/> not enemies merely because of German
                    birth and trade with them not restricted unless they are on enemy trading list
                    or unless bankers there have reasonable cause to believe them enemies or acting
                    for enemies or allies of enemies.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
