    <text>
        <body>
            <div xml:id="d525">

                <pb facs="0530" n="446" sameAs="frus:frus1918Supp02/pg446"/>

                <note rend="inline" type="source">File No. 863.852/12</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Austria-Hungary</hi> (<hi rendition="#italic">Penfield</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-03-23T17:00:00-05:00">
                            <hi rendition="#italic">March 23, 1917, 5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>1617. Your March 20, 4 p.m. Inform steamship company that, Department’s
                    regulations being now more strictly adhered to than in 1915,<anchor n="1"
                        xml:id="d525-f1"/> message will not be forwarded.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
