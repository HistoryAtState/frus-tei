    <text>
        <body>
            <div xml:id="d504">

                <pb facs="0517" n="433" sameAs="frus:frus1918Supp02/pg433"/>

                <note rend="inline" type="source">File No. No. 763.72112/3494</note>
                <head>
                    <hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic">Reinsch</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Peking</hi></placeName>, <date
                            calendar="gregorian" when="1917-04-14T11:00:00+08:00">
                            <hi rendition="#italic">April 14, 1917, 11 a.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received April 6.30 a.m.</hi>]</dateline>
                </opener>
                <p>I beg to request instructions as to the permissibility of commercial relations
                    [between] Americans and Germans in China.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Reinsch</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
