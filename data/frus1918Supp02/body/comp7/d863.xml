    <text>
        <body>
            <div xml:id="d863">

                <pb facs="0829" n="745" sameAs="frus:frus1918Supp02/pg745"/>

                <note rend="inline" type="source">File No. 811.203/21</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Great Britain</hi> (<hi
                            rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-05-10T15:00:00-04:00">
                            <hi rendition="#italic">May 10, 1918, 3 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>7668. Your 9101, March 18, 11 p.m. You may inform British Government regulations
                    set forth in your telegram are acceptable to this Government.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
