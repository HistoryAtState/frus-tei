            <div xml:id="d735">

                <pb facs="0950" n="851" sameAs="frus:frus1936v05/pg851"/>

                <note rend="inline" type="source">817.001 Somoza, Anastasio/11: Telegram</note>
                <head><hi rendition="#italic">The Minister in Nicaragua</hi> (<hi
                        rendition="#italic">Long</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Managua</hi></placeName>, <date calendar="gregorian"
                            when="1937-01-01T12:00:00-06:00">January 1,
                        1937—noon</date>.<lb/>[Received 3:50 p.m.]</dateline>
                </opener>
                <p>1. Somoza and Navarro inaugurated this morning without incident as President and
                    Vice President respectively.</p>
                <closer><signed><hi rendition="#small-caps">Long</hi></signed></closer>
            </div>
        </body>
