    <text>
        <body>
            <div xml:id="d755">

                <pb facs="0963" n="864" sameAs="frus:frus1936v05/pg864"/>

                <note rend="inline" type="source">834. 01/6</note>
                <head><hi rendition="#italic">The Ambassador in Mexico</hi> (<hi rendition="#italic">Daniels</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 3308</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1936-02-21">February 21, 1936</date>.<lb/>[Received February
                        25.]</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to report the announcement
                    yesterday by <hi rendition="#italic">Excelsior</hi> of the transmission of
                    instructions by the Foreign Office to the Mexican Minister at Asunción that the
                    latter remain at his post and carry out his mission as usual, in accordance with
                    the “Estrada Doctrine,”<anchor n="10" xml:id="d755-f1"/> thus <hi
                        rendition="#italic">ipso facto</hi> recognizing the Government established
                    in Paraguay by the successful <hi rendition="#italic">coup d’etat</hi> of
                    Colonel Rafael Franco.</p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">Josephus Daniels</hi></signed></closer>
            </div>
        </body>
    </text>
