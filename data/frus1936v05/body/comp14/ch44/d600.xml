                <pb facs="0834" n="735" sameAs="frus:frus1936v05/pg735"/>

                <note rend="inline" type="source">411.12/2334</note>
                <head><hi rendition="#italic">The Chargé in Mexico</hi> (<hi rendition="#italic"
                        >Boal</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 3690</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1936-06-17">June 17, 1936</date>.<lb/>[Received June
                        18.]</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to refer to the
                    Department’s telegram number 97 of June 12, 5 p.m., 1936, and to my telegram
                    number 93 of June 16, 4 p.m., and to enclose a strictly confidential memorandum
                    of conversations I had yesterday at the Foreign Office with Ambassador Castillo
                    Nájera, who is here for consultation with his Government; General Hay, Minister
                    for Foreign Affairs; and Licenciado Beteta, Undersecretary for Foreign
                    Affairs.</p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">Pierre de L. Boal</hi></signed></closer>


                <xi:include href="d600-a1.xml" xpointer="d600-a1"/>
