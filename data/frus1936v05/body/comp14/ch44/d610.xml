                <pb facs="0847" n="748" sameAs="frus:frus1936v05/pg748"/>

                <note rend="inline" type="source">411.12/2847</note>
                <head><hi rendition="#italic">The Chargé in Mexico</hi> (<hi
                            rendition="#italic">Boal</hi>) <hi rendition="#italic">to the
                            Secretary of State</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 3726</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1936-06-27">June 27, 1936</date>.<lb/>[Received June
                        29.]</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to my telegram No. 115 of
                    today’s date,<anchor n="49" xml:id="d610-f1"/> I have the honor to transmit
                    herewith a copy and translation of the Foreign Office’s note.</p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">Pierre de L. Boal</hi></signed></closer>


                <xi:include href="d610-a1.xml" xpointer="d610-a1"/>
            </div>
        </body>
    </text>
