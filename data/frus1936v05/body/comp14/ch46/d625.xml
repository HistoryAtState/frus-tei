            <div xml:id="d625">

                <pb facs="0863" n="764" sameAs="frus:frus1936v05/pg764"/>

                <note rend="inline" type="source">812.0145/22</note>
                <head><hi rendition="#italic">The Ambassador in Mexico</hi> (<hi rendition="#italic"
                        >Daniels</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 3765</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1936-07-14">July 14, 1936</date>.<lb/>[Received July
                        20.]</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to my despatch No. 3646 of
                    June 3, 1936, and other correspondence on the above mentioned subject, I have
                    the honor to enclose herewith for the Department’s consideration a copy and
                    translation of the Foreign Office’s note number 5470 of July 8, 1936, which was
                    written in reply to the Embassy’s note No. 1635 of June 3, 1936.</p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">Josephus Daniels</hi></signed></closer>


                <xi:include href="d625-a1.xml" xpointer="d625-a1"/>
