                <pb facs="0868" n="769" sameAs="frus:frus1936v05/pg769"/>

                <note rend="inline" type="source">812.0145/25</note>
                <head><hi rendition="#italic">The Ambassador in Mexico</hi> (<hi rendition="#italic"
                        >Daniels</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 3869</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1936-08-25">August 25, 1936</date>.<lb/>[Received August
                        31.]</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of the Department’s instruction No. 1189 of August 19, 1936, and to enclose
                    herewith a copy of the note which I have addressed under even date at the
                    direction of the Department to the Foreign Office with respect to the extension
                    of the breadth of Mexican territorial waters.</p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">Josephus Daniels</hi></signed></closer>


                <xi:include href="d627-a1.xml" xpointer="d627-a1"/>
