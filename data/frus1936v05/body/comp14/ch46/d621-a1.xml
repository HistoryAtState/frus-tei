    <text>
        <body>
            <div xml:id="d621-a1">

                <pb facs="0858" n="759" sameAs="frus:frus1936v05/pg759"/>

                <opener>
                    <seg rendition="#center">[Enclosure]</seg>
                </opener>
                <head><hi rendition="#italic">The American Ambassador</hi> (<hi rendition="#italic"
                        >Daniels</hi>) <hi rendition="#italic">to the Mexican Minister for Foreign
                        Affairs</hi> (<hi rendition="#italic">Hay</hi>)</head>
                <opener>
                    <seg rendition="#float-left">No. 1438</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1936-03-07">March 7, 1936</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I have the honor, under instructions
                    from my Government, to refer to the Presidential Decree of August 29, 1935,
                    published in the <hi rendition="#italic">Diario Oficial</hi> of August 31, 1935,
                    which purports to amend existing laws so as to extend the territorial waters of
                    Mexico in breadth from three to nine nautical miles.</p>
                <p>It is the desire of my Government to inform the Government of Mexico that the
                    United States of America reserves all rights of whatever nature so far as
                    concerns any effects upon American commerce from enforcement of this
                    legislation.</p>
                <p>Please accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Josephus Daniels</hi></signed></closer>
            </div>
        </body>
    </text>
