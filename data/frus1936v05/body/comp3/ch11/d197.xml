                <pb facs="0332" n="233" sameAs="frus:frus1936v05/pg233"/>

                <note rend="inline" type="source">824.00/761: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Bolivia</hi> (<hi rendition="#italic"
                        >Muccio</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">La
                                Paz</hi></placeName>, <date calendar="gregorian"
                            when="1936-05-22T19:00:00-04:00">May 22, 1936—7
                        p.m.</date><lb/>[Received 8:43 p.m.]</dateline>
                </opener>
                <p>27. Composition of Junta settled this evening to consist of six military, two
                    Socialist, two Republican Socialists, one Labor, with Toro as President of
                    Junta.</p>
                <p>Repeated to Buenos Aires.</p>
                <closer><signed><hi rendition="#small-caps">Muccio</hi></signed></closer>
            </div>
        </body>
    </text>
