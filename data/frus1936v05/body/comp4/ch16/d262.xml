                <pb facs="0386" n="287" sameAs="frus:frus1936v05/pg287"/>

                <note rend="inline" type="source">832.5151/793a: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Ambassador in
                        Brazil</hi> (<hi rendition="#italic">Gibson</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1936-01-11T17:00:00-05:00">January 11, 1936—5
                        p.m.</date></dateline>
                </opener>
                <p>11. For the purpose of determining the maturities of the notes to be issued under
                    the American agreement please endeavor to obtain <pb facs="0387" n="288"
                        xml:id="pg288"/> as definite information as possible as to the maturities of
                    the British frozen credit obligations.</p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
    </text>
