            <div xml:id="d39">

                <pb facs="0140" n="41" sameAs="frus:frus1936v05/pg41"/>

                <note rend="inline" type="source">724.34119/373: Telegram</note>
                <head><hi rendition="#italic">The Minister in Paraguay</hi> (<hi rendition="#italic"
                        >Howard</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Asunción</hi></placeName>, <date calendar="gregorian"
                            when="1936-02-07T20:00:00-04:00">February 7, 1936—8
                        p.m.</date><lb/>[Received 10:25 p.m.]</dateline>
                </opener>
                <p>11. My 10, Feb. 6, 8 p.m.<anchor n="15" xml:id="d39-f1"/> The agreement was
                    approved by the Chamber of Deputies this evening. This constitutes final action
                    by the Paraguayan Congress.</p>
                <p>Repeated to Buenos Aires.</p>
                <closer><signed><hi rendition="#small-caps">Howard</hi></signed></closer>
            </div>
        </body>
    </text>
