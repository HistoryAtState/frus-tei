            <div xml:id="d113">

                <pb facs="0248" n="149" sameAs="frus:frus1936v05/pg149"/>

                <note rend="inline" type="source">825.51/861</note>
                <head><hi rendition="#italic">The Secretary of State to American Diplomatic and
                        Consular Officers in Latin America and Mexico</hi></head>
                <opener>
                    <seg rendition="#float-left">Diplomatic Serial No. 2661</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1936-05-11">May 11, 1936</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sirs</hi>: There is transmitted for your information
                    a copy of a typical letter setting forth the Department’s policy with respect to
                    defaulted foreign securities held by American citizens.</p>
                <p>Very truly yours,</p>
                <closer>For the Secretary of State:<lb/><signed><hi rendition="#small-caps">Sumner
                            Welles</hi></signed></closer>


                <xi:include href="d113-a1.xml" xpointer="d113-a1"/>
