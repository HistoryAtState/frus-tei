    <text>
        <body>
            <div xml:id="d1">

                <pb facs="0100" n="1" sameAs="frus:frus1936v05/pg1"/>

                <note rend="inline" type="source">710.H/3</note>
                <head><hi rendition="#italic">The Director General of the Pan American Union</hi>
                        (<hi rendition="#italic">Rowe</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1936-01-10">January 10, 1936</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I beg to send you
                    herewith a copy of the Report of the Subcommittee on Program of the Eighth
                    International Conference of American States, approved at the session of the
                    Governing Board held on January 8th.<anchor n="1" xml:id="d1-f1"/> Attached to
                    the report is a list of topics which may be considered for possible inclusion in
                    the program of the Eighth Conference.</p>
                <p>As you will observe, the report requests that the Governments send to the Pan
                    American Union an expression of their opinion on the program prior to June
                    first.</p>
                <p>I beg to remain [etc.]</p>
                <closer><signed>L. S. <hi rendition="#small-caps">Rowe</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1-f1" n="1" xml:id="d1-f1-content">
                <p>Eighth International Conference of American States, Lima, Peru, <hi
                        rendition="#italic">Report of the Subcommittee on Program with a list of
                        topics for possible inclusion in the Agenda, Approved by the Governing Board
                        of the Pan American Union at the Session of January 8, 1986</hi>
                    (Washington, Pan American Union [1936]).</p>
            </note>
