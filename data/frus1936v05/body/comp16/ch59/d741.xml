                <pb facs="0955" n="856" sameAs="frus:frus1936v05/pg856"/>

                <note rend="inline" type="source">711.1928/507a</note>
                <head><hi rendition="#italic">The Secretary of State to the Fiscal Agent of the
                        Republic of Panama</hi> (<hi rendition="#italic">Cromwell</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1936-02-26">February 26, 1936</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: The Department encloses herewith copy of
                    the Comptroller General’s settlement certificate No. 0391039 dated February 26,
                    1936, and check on the Treasurer of the United States, No. 48,769, dated
                    February 26, 1936, payable to your order as Fiscal Agent of the Republic of
                    Panama, for $250,000.00, in settlement of the annuity due the Republic of Panama
                    on February 26, 1936, under Treaty of November 18, 1903.</p>
                <p>Please sign the enclosed receipt and return it to the Department for its
                    files.</p>
                <p>Very truly yours,</p>
                <closer>For the Secretary of State:<lb/><signed><hi rendition="#small-caps">Wilbur
                            J. Carr</hi></signed><lb/><hi rendition="#italic">Assistant
                        Secretary</hi></closer>
            </div>
        </body>
