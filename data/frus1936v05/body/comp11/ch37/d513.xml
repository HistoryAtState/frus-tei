            <div xml:id="d513">

                <pb facs="0697" n="598" xml:id="pg598"/>

                <note rend="inline" type="source">611.1431/171: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Chargé in Guatemala</hi>
                        (<hi rendition="#italic">O’Donoghue</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1936-03-28T14:00:00-05:00">March 28, 1936—2 p.m.</date></dateline>
                </opener>
                <p>22. Your 28, March 27, noon. Spanish text of Article 13 apparently satisfactory.
                    English text after last comma will be changed to conform to literal translation
                    of Spanish text.</p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
    </text>
