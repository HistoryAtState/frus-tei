            <div xml:id="d508">

                <pb facs="0694" n="595" sameAs="frus:frus1936v05/pg595"/>

                <note rend="inline" type="source">611.1431/166: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Guatemala</hi> (<hi rendition="#italic">O’Donoghue</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Guatemala</hi></placeName>, <date calendar="gregorian"
                            when="1936-03-23T11:00:00-06:00">March 23, 1936—11
                        a.m.</date><lb/>[Received 1:40 p.m.]</dateline>
                </opener>
                <p>25. Department’s 16, March 21, 2 p.m.</p>
                <list>
                    <label>1.</label>
                    <item>Minister of Hacienda agrees to change wording quoted in Legation’s No. 24,
                        March 21, 10 a.m., to read “made in the country of export”. Also delete
                        “original”.</item>
                    <label>2.</label>
                    <item>Minister agrees to use of “other” in notes 1 and 2.</item>
                </list>
                <closer><signed><hi rendition="#small-caps">O’Donoghue</hi></signed></closer>
            </div>
        </body>
    </text>
