    <text>
        <body>
            <div xml:id="d128-a1">

                <pb facs="0212" n="108" sameAs="frus:frus1932v03/pg108"/>

                <head><hi rendition="#italic">The Assistant Military Attaché in China (Tenney) to the Adjutant General of the Army</hi><anchor n="79"
                        xml:id="d128-f1"/></head>
                <opener>
                    <seg rendition="#center">[Extract]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peiping</hi></placeName>, <date calendar="gregorian"
                            when="1932-01-29">January 29, 1932</date>.</dateline>
                </opener>
                <p>No. 323. Par. 4. Japanese General Staff is now war mad and it is <pb facs="0213"
                        n="109" xml:id="pg109"/> believed it should be realized and would not
                    hesitate at hostilities with United States if their course blocked.</p>
                <closer><signed><hi rendition="#small-caps"
                            >Tenney</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d128-f1" n="79" type="source" xml:id="d128-f1-content">
                <p>Copy of telegram transmitted to the Department by the War Department, January
                    29.</p>
            </note>
        </listAnnotation>
