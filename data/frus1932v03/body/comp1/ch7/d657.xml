            <div xml:id="d657">

                <pb facs="0720" n="616" sameAs="frus:frus1932v03/pg616"/>

                <note rend="inline" type="source">793.94/4844: Telegram</note>
                <head><hi rendition="#italic">The Minister in China (Johnson) to the Secretary of
                            State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Shanghai</hi></placeName>, <date calendar="gregorian"
                            when="1932-03-22T08:00:00+08:00">March 22, 1932—8
                        a.m.</date><lb/>[Received March 22—3:05 a.m.]</dateline>
                </opener>
                <p>Situation report No. 12, March 21st: <quote rend="blockquote">
                        <list>
                            <item>“1. Embarkation of 11th Division for Japan begins today. Movement
                                is expected to be completed by 22nd.</item>
                            <item>2. On completed departure of this Division there will still be
                                approximately 37, 000 Japanese troops remaining.”</item>
                        </list></quote></p>
                <closer><signed><hi rendition="#small-caps"
                            >Johnson</hi></signed></closer>
            </div>
