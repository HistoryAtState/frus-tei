    <text>
        <body>
            <div xml:id="d785">

                <pb facs="0841" n="737" sameAs="frus:frus1932v03/pg737"/>

                <note rend="inline" type="source">793.94 Commission/192: Telegram</note>
                <head><hi rendition="#italic">The Minister in China (Johnson) to the Acting
                        Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peiping</hi></placeName>, <date calendar="gregorian"
                            when="1932-04-30T19:00:00+08:00">April 30, 1932—7
                        p.m.</date><lb/>[Received April 30—7:55 a.m.]</dateline>
                </opener>
                <p>487. Following from American Consul General at Mukden: <quote rend="blockquote">
                        <p>“April 30, 10 a.m. League Commission of Inquiry will leave Mukden <pb
                                facs="0842" n="738" xml:id="pg738"/> Monday morning<anchor n="7"
                                xml:id="d785-f1"/> for Changchun and North Manchuria, accompanied by
                            Wellington Koo and the reduced Chinese staff.”</p></quote></p>
                <closer>For the Minister:<lb/><signed><hi rendition="#small-caps"
                        >Perkins</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d785-f1" n="7" xml:id="d785-f1-content">
