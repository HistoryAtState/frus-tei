            <div xml:id="d326">

                <pb facs="0410" n="306" sameAs="frus:frus1932v03/pg306"/>

                <note rend="inline" type="source">793.94/4178a:Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Consul General at Shanghai (Cunningham)</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1932-02-12T17:00:00-05:00">February 12, 1932—5
                        p.m.</date></dateline>
                </opener>
                <p>17. For the Minister. I desire that you keep in close touch with the British
                    Minister and that you keep me promptly and fully informed of your views in
                    reference to current developments and estimated possibilities.</p>
                <closer><signed><hi rendition="#small-caps"
                            >Stimson</hi></signed></closer>
            </div>
        </body>
