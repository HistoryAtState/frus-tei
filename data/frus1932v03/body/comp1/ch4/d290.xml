            <div xml:id="d290">

                <pb facs="0371" n="267" sameAs="frus:frus1932v03/pg267"/>

                <note rend="inline" type="source">793.94/4086: Telegram</note>
                <head><hi rendition="#italic">The Consul General at Nanking (Peck) to the Secretary of
                        State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Nanking</hi></placeName>, <date calendar="gregorian"
                            when="1932-02-10T15:00:00+08:00">February 10, 1932—3
                        p.m.</date><lb/>[Received February 10—9:20 a.m.]</dateline>
                </opener>
                <p>40. Your 26, February 9, 1 p.m.<anchor n="93" xml:id="d290-f1"/> Three Japanese
                    cruisers and three Japanese destroyers are now at Nanking.</p>
                <closer><signed><hi rendition="#small-caps"
                    >Peck</hi></signed></closer>
            </div>
        </body>
    </text>
