            <div xml:id="d86">

                <pb facs="0181" n="77" sameAs="frus:frus1932v03/pg77"/>

                <note rend="inline" type="source">893.00/11747: Telegram</note>
                <head><hi rendition="#italic">The Minister in China (Johnson) to the Secretary of
                            State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peiping</hi></placeName>, <date calendar="gregorian"
                            when="1932-01-27T17:00:00+08:00">January 27, 1932—5
                        p.m.</date><lb/>[Received January 27—8:45 a.m.]</dateline>
                </opener>
                <p>132. Following from Reuter, Nanking: <quote rend="blockquote">
                        <p>January 26. “General Chen Ming-shu
                            has been appointed Foreign Minister in succession to Mr. Eugene Chen, who resigned owing to the
                            Government not agreeing to his proposal to break off relations with
                            Japan.”</p></quote></p>
                <closer><signed><hi rendition="#small-caps"
                            >Johnson</hi></signed></closer>
            </div>
