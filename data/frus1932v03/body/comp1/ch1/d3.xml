    <text>
        <body>
            <div xml:id="d3">

                <pb facs="0107" n="3" sameAs="frus:frus1932v03/pg3"/>

                <note rend="inline" type="source">793.94/3387: Telegram</note>
                <head><hi rendition="#italic">The Minister in China (Johnson) to the Secretary of
                        State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peiping</hi></placeName>, <date calendar="gregorian"
                            when="1932-01-04T13:00:00+08:00">January 4, 1932—1
                        p.m.</date><lb/>[Received January 4—4 a.m.]</dateline>
                </opener>
                <p>10. Following from American Consul General at Mukden: <quote rend="blockquote">
                        <p>“January 3, noon. Headquarters has announced that Chinhsien was occupied
                            at 4:40 this morning by Muro brigade.”</p></quote></p>
                <p>Repeated to Tokyo.</p>
                <closer><signed><hi rendition="#small-caps">Johnson</hi></signed></closer>
            </div>
        </body>
    </text>
