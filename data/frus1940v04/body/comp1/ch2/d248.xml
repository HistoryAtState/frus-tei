    <text>
        <body>
            <div xml:id="d248">

                <pb facs="0212" n="204" sameAs="frus:frus1940v04/pg204"/>

                <note rend="inline" type="source">792.94/68½</note>
                <head><hi rendition="#italic">The British Embassy to the Department of
                    State</hi></head>
                <p rendition="#center"><hi rendition="#small-caps">Extract of Telegram Received From
                        London, Dated November</hi> 4th, 1940</p>
                <p>“According to His Majesty’s Minister at Bangkok present indications are that
                    unless reinforced by United States or ourselves with war material Thai
                    Government would not resist with arms a Japanese violation of Thai
                    territory.[”]</p>
                <closer>
                    <dateline rendition="#float-left">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1940-11-11">November 11,
                            1940</date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
