    <text>
        <body>
            <div xml:id="d972">

                <pb facs="0889" n="881" sameAs="frus:frus1940v04/pg881"/>

                <note rend="inline" type="source">393.11/2147a: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Ambassador in China</hi>
                        (<hi rendition="#italic">Johnson</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1940-06-17T18:00:00-04:00">June 17, 1940—6 p.m.</date></dateline>
                </opener>
                <p>96. Your 265, June 16, noon.<anchor n="78" xml:id="d972-f1"/> The Department
                    desires that you communicate to American citizens the information contained in
                    the Japanese notification under reference and that you advise the American <pb
                        facs="0890" n="882" xml:id="pg882"/> citizens concerned in accordance with
                    the penultimate sentence of paragraph numbered 1 of the Department’s 202, June
                    14, 7 p.m., to Tokyo (94, June 14, 7 p.m., to Chungking<anchor n="80"
                        xml:id="d972-f2"/>).</p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
    </text>
