    <standOff>
        <listAnnotation>
            <note corresp="#d16-f1" n="3" xml:id="d16-f1-content">
                <p>The draft memorandum to the Secretary of State, which was circulated as Appendix
                    “C” to this Report, is not printed. For the memorandum as actually sent to the
                    Secretary of State on September 16, see <ref target="#pg28">p. 28</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
