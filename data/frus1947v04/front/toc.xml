    <text>
        <body>
            <div xml:id="toc">

                <pb facs="0009" n="V" xml:id="V"/>

                <head>Contents</head>
                <list type="toc">
                    <item>
                        <ref target="#pgIII">
                            <hi rendition="#small-caps">Preface</hi>
                        </ref>
                    </item>
                    <item>
                        <ref target="#pgVII">
                            <hi rendition="#small-caps">List of Abbreviations and Symbols</hi>
                        </ref>
                    </item>
                    <item>
                        <hi rendition="#small-caps">Eastern Europe</hi> (<hi rendition="#small-caps"
                            >Regional</hi>): <list>
                            <item>
                                <ref target="#pg1">Efforts by the United States to secure the
                                    implementation of the Treaties of Peace with Bulgaria, Hungary,
                                    and Rumania</ref>
                            </item>
                            <item>
                                <ref target="#pg51">The United States and the establishment of the
                                    Free Territory of Trieste</ref>
                            </item>
                        </list>
                    </item>
                    <item>
                        <hi rendition="#small-caps">Bulgaria</hi>: <list>
                            <item>
                                <ref target="#pg136">The reestablishment of diplomatic relations
                                    with Bulgaria; efforts by the United States to assist in the
                                    preservation of democratic institutions in Bulgaria; termination
                                    of the Allied Control Commission for Bulgaria</ref>
                            </item>
                        </list>
                    </item>
                    <item>
                        <hi rendition="#small-caps">Czechoslovakia</hi>: <list>
                            <item>
                                <ref target="#pg196">Interest of the United States in the
                                    maintenance of democratic government in Czechoslovakia;
                                    consideration of the possibility of United States economic
                                    assistance to Czechoslovakia and efforts to resolve pending
                                    economic and commercial questions between the two
                                    governments</ref>
                            </item>
                        </list>
                    </item>
                    <item>
                        <hi rendition="#small-caps">Finland</hi>: <list>
                            <item>
                                <ref target="#pg256">Extension of additional Export-Import Bank
                                    credits to Finland</ref>
                            </item>
                        </list>
                    </item>
                    <item>
                        <hi rendition="#small-caps">Hungary</hi>: <list>
                            <item>
                                <ref target="#pg260">Efforts by the United States to assist in the
                                    maintenance of democratic government in Hungary and the
                                    rehabilitation of the Hungarian economy; participation by the
                                    United States in the Allied Control Commission for Hungary</ref>
                            </item>
                        </list>
                    </item>
                    <item>
                        <hi rendition="#small-caps">Poland</hi>: <list>
                            <item>
                                <ref target="#pg402">Efforts by the United States to assure
                                    fulfillment of wartime agreements on Poland; the problem of
                                    United States economic assistance</ref>
                            </item>
                        </list>
                    </item>
                    <item>
                        <hi rendition="#small-caps">Rumania</hi>: <list>
                            <item>
                                <ref target="#pg471">Efforts by the United States to assist in the
                                    establishment of a democratic and independent Rumania and to
                                    assure fulfillment of wartime and postwar agreements</ref>
                            </item>
                        </list>
                    </item>
                    <pb facs="0010" n="VI" xml:id="pgVI"/>
                    <item>
                        <hi rendition="#small-caps">Union of Soviet Socialist Republics</hi>: <list>
                            <item>
                                <ref target="#pg514">Reports on developments of significance within
                                    the Soviet Union of concern to relations with the United States
                                    and other countries</ref>
                            </item>
                            <item>
                                <ref target="#pg653">Unsuccessful efforts to negotiate a lend-lease
                                    settlement agreement with the Soviet Union</ref>
                            </item>
                            <item>
                                <ref target="#pg718">Difficulties in obtaining exit visas for Soviet
                                    spouses of American citizens and detained American citizens in
                                    the Soviet Union</ref>
                            </item>
                        </list>
                    </item>
                    <item>
                        <hi rendition="#small-caps">Yugoslavia</hi>: <list>
                            <item>
                                <ref target="#pg744">Efforts of the United States to maintain
                                    friendly relations with Yugoslavia; assertion of the rights and
                                    immunities of American diplomatic personnel and American
                                    citizens in Yugoslavia; negotiations for the mutual restoration
                                    of property and the settlement of claims; the question of the
                                    turning-over to Yugoslav authorities of Yugoslav citizens under
                                    American control outside Yugoslavia</ref>
                            </item>
                        </list>
                    </item>
                    <item>
                        <ref target="#pg861">
                            <hi rendition="#small-caps">Index</hi>
                        </ref>
                    </item>
                </list>
            </div>
        </body>
    </text>
