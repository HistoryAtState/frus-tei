                <pb facs="0517" n="509" sameAs="frus:frus1941v03/pg509"/>

                <note rend="inline" type="source">740.0011 European War 1939/11513: Telegram</note>
                <head><hi rendition="#italic">The Minister Resident in Iraq</hi> (<hi
                        rendition="#italic">Knabenshue</hi>) <hi rendition="#italic">to the
                        Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Baghdad</hi></placeName>, <date calendar="gregorian"
                            when="1941-05-31">May 31, 1941</date>.<lb/>[Received June 1—5:35
                        p.m.]</dateline>
                </opener>
                <p>127. Armistice signed this afternoon. Terms will be communicated to Embassy
                    London by Foreign Office. I have confidence that new Government arranged but not
                    yet announced will establish situation as it should be.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Knabenshue</hi>
                    </signed>
                </closer>
            </div>
        </body>
