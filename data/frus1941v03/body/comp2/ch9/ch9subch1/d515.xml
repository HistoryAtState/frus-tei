    <text>
        <body>
            <div xml:id="d515">

                <pb facs="0508" n="500" sameAs="frus:frus1941v03/pg500"/>

                <note rend="inline" type="source">890G.00/577</note>
                <head>
                    <hi rendition="#italic">Memorandum of Conversation, by the Secretary of
                        State</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1941-04-18">April 18, 1941</date>.</dateline>
                </opener>
                <p>The British Ambassador<anchor n="33" xml:id="d515-f1"/> called at his request and
                    handed me a copy of a telegram from his Foreign Office relative to developments
                    in <pb facs="0509" n="501" xml:id="pg501"/> Iraq. I thanked him and said that we
                    naturally are very much interested in the disquieting developments of the past
                    few days in Iraq.</p>
                <closer>
                    <signed>C[<hi rendition="#small-caps">ordell</hi>] H[<hi rendition="#small-caps"
                            >ull</hi>]</signed>
                </closer>


                <xi:include href="d515-a1.xml" xpointer="d515-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d515-f1" n="33" xml:id="d515-f1-content">
                <p>Viscount Halifax.</p>
            </note>
