            <div xml:id="d522">

                <pb facs="0512" n="504" sameAs="frus:frus1941v03/pg504"/>

                <note rend="inline" type="source">390G.1115/15: Telegram</note>
                <head><hi rendition="#italic">The Minister Resident in Iraq</hi> (<hi rendition="#italic">Knabenshue</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Baghdad</hi></placeName>, <date calendar="gregorian"
                            when="1941-04-29T23:00:00+03:00">April 29, 1941—11
                        p.m.</date><lb/>[Received 11:23 p.m.]</dateline>
                </opener>
                <p>109. Referring my 107 of even date.<anchor n="35" xml:id="d522-f1"/> All American
                    women and children left Baghdad this afternoon, with one exception, who refused
                    to leave.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Knabenshue</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
