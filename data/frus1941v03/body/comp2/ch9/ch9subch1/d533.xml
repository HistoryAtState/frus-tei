                <pb facs="0519" n="511" sameAs="frus:frus1941v03/pg511"/>

                <note rend="inline" type="source">890G.01/381: Telegram</note>
                <head><hi rendition="#italic">The Minister Resident in Iraq</hi> (<hi
                        rendition="#italic">Knabenshue</hi>) <hi rendition="#italic">to the
                        Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Baghdad</hi></placeName>, <date calendar="gregorian"
                            when="1941-06-03">June 3, 1941</date>.<lb/>[Received June 3—8:02
                        p.m.]</dateline>
                </opener>
                <p>133. New government formed by Jamil Madfai as Prime Minister and Interior with
                    Ali Jawdet [<hi rendition="#italic">Jawdat</hi>] Ayoubi, Minister Foreign
                    Affairs.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Knabenshue</hi>
                    </signed>
                </closer>
            </div>
        </body>
