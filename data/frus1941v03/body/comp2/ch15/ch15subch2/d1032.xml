    <text>
        <body>
            <div xml:id="d1032">

                <pb facs="0970" n="962" sameAs="frus:frus1941v03/pg962"/>

                <note rend="inline" type="source">662.6731/147: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Turkey</hi> (<hi rendition="#italic"
                        >MacMurray</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Ankara</hi></placeName>, <date calendar="gregorian"
                            when="1941-10-09T17:00:00+02:00">October 9, 1941—5
                        p.m.</date><lb/>[Received October 10—12:24 a.m.]</dateline>
                </opener>
                <p>377. The German-Turkish commercial agreement was signed about noon today.<anchor
                        n="46" xml:id="d1032-f1"/></p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">MacMurray</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
