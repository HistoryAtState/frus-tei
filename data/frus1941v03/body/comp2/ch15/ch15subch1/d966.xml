    <text>
        <body>
            <div xml:id="d966">

                <pb facs="0901" n="893" sameAs="frus:frus1941v03/pg893"/>

                <note rend="inline" type="source">740.0011 European War 1939/14100: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Germany</hi> (<hi
                            rendition="#italic">Morris</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Berlin</hi></placeName>, <date calendar="gregorian"
                            when="1941-08-19T12:00:00+02:00">August 19,
                        1941—noon</date>.<lb/>[Received August 19—10:40 a.m.]</dateline>
                </opener>
                <p>3218. The Turkish Ambasador to Germany has been summoned to a consultation
                    outside of Berlin with Hitler and Von Ribbentrop<anchor n="87" xml:id="d966-f1"
                    /> to take place today.</p>
                <p>Repeated to Ankara.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Morris</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d966-f1" n="87" xml:id="d966-f1-content">
                <p>Joachim von Ribbentrop, German Minister for Foreign Affairs.</p>
            </note>
        </listAnnotation>
    </standOff>
