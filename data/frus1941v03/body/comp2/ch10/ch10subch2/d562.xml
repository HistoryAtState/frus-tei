    <text>
        <body>
            <div xml:id="d562">

                <pb facs="0544" n="536" sameAs="frus:frus1941v03/pg536"/>

                <note rend="inline" type="source">811.79682/23a: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Minister in Liberia</hi> (<hi
                            rendition="#italic">Walton</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1941-07-09T19:00:00-04:00">July 9, 1941—7 p.m.</date></dateline>
                </opener>
                <p>42. Pan American Airways representative in Liberia is being instructed to proceed
                    immediately with the signing of its initialed contract for commercial
                        services.<anchor n="17" xml:id="d562-f1"/> You should offer your good
                    services in this connection if it should appear necessary.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Welles</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d562-f1" n="17" xml:id="d562-f1-content">
                <p>Contract signed on July 14, 1941.</p>
            </note>
        </listAnnotation>
    </standOff>
