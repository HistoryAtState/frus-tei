    <text>
        <body>
            <div xml:id="d218">

                <pb facs="0285" n="277" sameAs="frus:frus1941v03/pg277"/>

                <note rend="inline" type="source">841.24/560¾: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        The Chargé in the United Kingdom</hi> (<hi
                            rendition="#italic">Johnson</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1941-06-03T23:00:00-04:00">June 3, 1941—11 p.m.</date></dateline>
                </opener>
                <p>1937. For Johnson and Harriman from Hopkins.<anchor n="20" xml:id="d218-f1"/>
                    President approves your accompanying British group to the Middle-east. Good
                    luck. [Hopkins.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d218-f1" n="20" xml:id="d218-f1-content">
                <p>Harry L. Hopkins, Special Assistant to President Roosevelt, with primary
                    responsibility at this time for Lend-Lease affairs.</p>
            </note>
        </listAnnotation>
    </standOff>
