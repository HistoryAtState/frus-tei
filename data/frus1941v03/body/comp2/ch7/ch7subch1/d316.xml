                <pb facs="0358" n="350" sameAs="frus:frus1941v03/pg350"/>

                <note rend="inline" type="source">740.0011 European War 1939/11104: Telegram</note>
                <head><hi rendition="#italic">The Minister in Egypt</hi> (<hi
                            rendition="#italic">Kirk</hi>) <hi rendition="#italic">to the
                            Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Cairo</hi></placeName>, <date calendar="gregorian"
                            when="1941-05-18T13:00:00+03:00">May 18, 1941—1
                        p.m.</date><lb/>[Received May 20—3:44 a.m.]</dateline>
                </opener>
                <p>522. It is reported but not yet officially announced that the Duke of Aosta has
                    surrendered with 7,000 men.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Kirk</hi>
                    </signed>
                </closer>
            </div>
        </body>
