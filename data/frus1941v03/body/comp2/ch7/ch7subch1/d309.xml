            <div xml:id="d309">

                <pb facs="0354" n="346" sameAs="frus:frus1941v03/pg346"/>

                <note rend="inline" type="source">740.0011 European War 1939/9797: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Consul at Aden</hi> (<hi
                        rendition="#italic">Timberlake</hi>)</head>
                <opener>
                    <seg rendition="#center">[Extract]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1941-04-12T19:00:00-05:00">April 12, 1941—7 p.m.</date></dateline>
                </opener>
                <p>10. For Timberlake. You are instructed to proceed Addis Ababa, Berbera and
                    Djibouti for the purpose indicated in your 17, April 7, 2 p.m.…</p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
