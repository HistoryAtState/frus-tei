            <div xml:id="d367">

                <pb facs="0399" n="391" xml:id="pg391"/>

                <note rend="inline" type="source">740.0011 European War 1939/13821: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in the United Kingdom</hi> (<hi
                        rendition="#italic">Winant</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1941-08-09T17:00:00+02:00">August 9, 1941—5
                        p.m.</date><lb/>[Received August 9—11:10 a.m.]</dateline>
                </opener>
                <p>3532. For the Secretary and the Under Secretary. My 3511, August 8, 10 p.m. Mr.
                    Eden informs me that the date of August 16th mentioned in first paragraph has
                    been changed to August 14th.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Winant</hi>
                    </signed>
                </closer>
            </div>
        </body>
