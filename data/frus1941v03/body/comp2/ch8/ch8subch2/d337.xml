                <pb facs="0371" n="363" sameAs="frus:frus1941v03/pg363"/>

                <note rend="inline" type="source">811.20(D)Regulations/3305: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Minister in Iran</hi> (<hi
                            rendition="#italic">Dreyfus</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1941-07-24T20:00:00-04:00">July 24, 1941—8 p.m.</date></dateline>
                </opener>
                <p>59. Your 72, July 14, 10 a.m. Application of June 10 was rejected July 21 but
                    United States Steel Export Corporation has now been invited to submit new
                    application which will be considered in connection with Prime Minister’s
                    recommendation.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Welles</hi>
                    </signed>
                </closer>
            </div>
        </body>
