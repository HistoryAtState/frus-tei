                <pb facs="0631" n="623" sameAs="frus:frus1941v03/pg623"/>

                <note rend="inline" type="source">867N.01/1780</note>
                <head><hi rendition="#italic">The Under Secretary of State</hi> (<hi
                        rendition="#italic">Welles</hi>) <hi rendition="#italic">to Rabbi Stephen S.
                        Wise</hi></head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1941-10-08">October 8, 1941</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">My Dear Dr. Wise</hi>: I wish to acknowledge the
                    receipt of your letter of September 26, 1941. I have noted your remarks
                    regarding the possibility of political changes in the Near East, and I shall be
                    glad to send you information on the subject as soon as possible.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Sumner Welles</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
