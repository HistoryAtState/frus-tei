    <text>
        <body>
            <div xml:id="d132">

                <pb facs="0189" n="181" sameAs="frus:frus1941v03/pg181"/>

                <note rend="inline" type="source">845.01/114½</note>
                <head><hi rendition="#italic">Memorandum by the Under Secretary of State</hi> (<hi
                        rendition="#italic">Welles</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1941-08-06">August 6, 1941</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Mr. Secretary</hi>: I think you will wish to give
                    very careful consideration to this suggestion.<anchor n="12" xml:id="d132-f1"/>
                    In my own judgment this Government is not warranted in suggesting officially to
                    the British Government what the status of India should be, but were the
                    President disposed to take the matter up I should imagine that he would wish to
                    discuss it in a very personal and confidential way directly with Mr.
                        Churchill.<anchor n="13" xml:id="d132-f2"/></p>
                <closer>
                    <signed>S[<hi rendition="#small-caps">umner</hi>] W[<hi rendition="#small-caps"
                            >elles</hi>]</signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d132-f1" n="12" xml:id="d132-f1-content">
                <p>See memorandum by the Assistant Secretary of State, August 5, <ref
                        target="#pg179">p. 179</ref>.</p>
            </note>
            <note corresp="#d132-f2" n="13" xml:id="d132-f2-content">
                <p>Marginal notation: “I agree—CH”.</p>
            </note>
        </listAnnotation>
    </standOff>
