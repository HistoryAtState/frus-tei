                <pb facs="0182" n="62" sameAs="frus:frus1931v02/pg62"/>

                <note rend="inline" type="source">837.00/3085</note>
                <head><hi rendition="#italic">The Ambassador in Cuba</hi> (<hi
                            rendition="#italic">Guggenheim</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Habana</hi></placeName>, <date calendar="gregorian"
                            when="1931-06-08">June 8, 1931</date>.<lb/>[Received June
                        12.]</dateline>
                    <seg rendition="#float-left">No. 722</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Supplementing my despatch No. 712 of May
                    29, 1931, I have the honor to transmit herewith memorandum of my conversation
                    with President Machado of May 28.</p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">Harry F.
                    Guggenheim</hi></signed></closer>


                <xi:include href="d88-a1.xml" xpointer="d88-a1"/>
