                <pb facs="0138" n="18" sameAs="frus:frus1931v02/pg18"/>

                <note rend="inline" type="source">821.6363/1152: Telegram</note>
                <head><hi rendition="#italic">The Minister in Colombia</hi> (<hi rendition="#italic"
                        >Caffery</hi>) <hi rendition="#italic">to the Acting Secretary of
                    State</hi></head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Bogotá</hi></placeName>, <date calendar="gregorian"
                            when="1931-07-30T17:00:00-05:00">July 30, 1931—5
                        p.m.</date><lb/>[Received 7:10 p.m.]</dateline></opener>
                <p>103. My 102, July 29, 2 p.m. Petroleum regulating decree was published yesterday.
                    It is highly satisfactory. Please inform Mr. Rublee.</p>
                <closer><signed><hi rendition="#small-caps">Caffery</hi></signed></closer>
            </div>
        </body>
    </text>
