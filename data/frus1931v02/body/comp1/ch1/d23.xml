    <text>
        <body>
            <div xml:id="d23">

                <pb facs="0134" n="14" sameAs="frus:frus1931v02/pg14"/>

                <note rend="inline" type="source">821.6363/1067: Telegram</note>
                <head><hi rendition="#italic">The Minister in Colombia</hi> (<hi rendition="#italic">Caffery</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Bogotá</hi></placeName>, <date calendar="gregorian"
                            when="1931-02-26T10:00:00-05:00">February 26, 1931—10
                        a.m.</date><lb/>[Received 1:30 p.m.]</dateline></opener>
                <p>23. My 16, February 14, 11 a.m.<anchor n="18" xml:id="d23-f1"/> Upon the request
                    of President Olaya, Rublee has decided to remain in Colombia until March 26 in
                    order to assist in drawing up regulating decrees under the new petroleum
                    law.</p>
                <closer><signed><hi rendition="#small-caps">Caffery</hi></signed></closer>
            </div>
        </body>
    </text>
