    <text>
        <body>
            <div xml:id="d21">

                <pb facs="0133" n="13" sameAs="frus:frus1931v02/pg13"/>

                <note rend="inline" type="source">821.6363/1059: Telegram</note>
                <head><hi rendition="#italic">The Minister in Colombia</hi> (<hi rendition="#italic">Caffery</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Bogotá</hi></placeName>, <date calendar="gregorian"
                            when="1931-02-20T15:00:00-05:00">February 20, 1931—3
                        p.m.</date><lb/>[Received 5:25 p.m.]</dateline></opener>
                <p>18. My telegram number 12, February 11, 6 p.m.<anchor n="16" xml:id="d21-f1"/>
                    Olaya sent a message to the House Wednesday urging deputies to expedite
                    consideration of the oil bill. Up to last night House had approved 19
                    articles.</p>
                <closer><signed><hi rendition="#small-caps">Caffery</hi></signed></closer>
            </div>
        </body>
    </text>
