                <pb facs="0516" n="396" xml:id="pg396"/>

                <note rend="inline" type="source">814.01/27: Telegram</note>
                <head><hi rendition="#italic">The Minister in Guatemala</hi> (<hi
                        rendition="#italic">Whitehouse</hi>) <hi rendition="#italic">to the
                        Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Guatemala</hi></placeName>, <date calendar="gregorian"
                            when="1931-01-03T11:00:00-07:00">January 3, 1931—11
                        a.m.</date><lb/>[Received 2:55 p.m.]</dateline></opener>
                <p>5. German Minister authorized to recognize Reina Andrade but believe he will take
                    no action until I have received your instructions.</p>
                <closer><signed><hi rendition="#small-caps">Whitehouse</hi></signed></closer>
            </div>
        </body>
    </text>
