            <div xml:id="d259">

                <pb facs="0344" n="224" sameAs="frus:frus1931v02/pg224"/>

                <note rend="inline" type="source">684.003/15</note>
                <head><hi rendition="#italic">The Second Secretary of the French Embassy</hi> (<hi
                        rendition="#italic">Bousquet</hi>) <hi rendition="#italic">to the Acting
                        Chief of the Division of Near Eastern Affairs</hi> (<hi rendition="#italic"
                        >Alling</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1931-07-08">July 8, 1931</date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Alling</hi>: Pursuant to the conversation
                    we had today about the French viewpoint concerning the tentative new statute for
                    foreigners and the tariff modifications in Ethiopia, I take much pleasure in
                    enclosing herewith for your information a memorandum summing up the French
                    viewpoint in the matter.</p>
                <p>Believe me [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Raymond Bousquet</hi></signed></closer>


                <xi:include href="d259-a1.xml" xpointer="d259-a1"/>
