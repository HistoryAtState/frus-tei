    <text>
        <body>
            <div xml:id="d842">

                <pb facs="0907" n="787" sameAs="frus:frus1931v02/pg787"/>

                <note rend="inline" type="source">817.48 Earthquake of 1931/40</note>
                <head><hi rendition="#italic">The President of Nicaragua</hi> (<hi
                        rendition="#italic">Moncada</hi>) <hi rendition="#italic">to President
                        Hoover</hi></head>
                <opener><seg rendition="#center">[Translation]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Managua</hi></placeName>, <date calendar="gregorian"
                            when="1931-04-01">April 1, 1931</date>.<anchor n="8" xml:id="d842-f1"
                        /></dateline></opener>
                <p>I am profoundly thankful for the marks of the sympathy and the regret which Your
                    Excellency feels because of the Managua catastrophe, and in the name of the
                    Nicaraguan public and in that of my <pb facs="0908" n="788" xml:id="pg788"/>
                    Government I send to the people of the United States and to Your Excellency my
                    expressions of gratitude.</p>
                <closer><signed><hi rendition="#small-caps">J. M. Moncada</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d842-f1" n="8" xml:id="d842-f1-content">
                <p>Received in the Department from the White House on April 2.</p>
            </note>
        </listAnnotation>
    </standOff>
