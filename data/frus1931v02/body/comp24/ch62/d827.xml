            <div xml:id="d827">

                <pb facs="0901" n="781" sameAs="frus:frus1931v02/pg781"/>

                <note rend="inline" type="source">817.48 Earthquake of 1931/13: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Nicaraguan Minister for
                        Foreign Affairs</hi> (<hi rendition="#italic">Irias</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1931-03-31">March 31, 1931</date>.</dateline></opener>
                <p>Please accept the assurances of the deep sympathy of the Government and people of
                    the United States with the Government and people of Nicaragua in the disaster
                    which has befallen them.</p>
                <closer><signed><hi rendition="#small-caps">Henry L. Stimson</hi></signed></closer>
            </div>
        </body>
    </text>
