    <text>
        <body>
            <div xml:id="d825">

                <pb facs="0900" n="780" sameAs="frus:frus1931v02/pg780"/>

                <note rend="inline" type="source">817.48 Earthquake of 1931/14: Telegram</note>
                <head><hi rendition="#italic">President Hoover to the President of Nicaragua</hi>
                        (<hi rendition="#italic">Moncada</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1931-03-31">March 31, 1931</date>.</dateline></opener>
                <p>I am appalled at the catastrophe which has overwhelmed Managua and in my own name
                    and that of the American Government and people I extend heartfelt sympathy to
                    Your Excellency and the people of Nicaragua.</p>
                <closer><signed><hi rendition="#small-caps">Herbert Hoover</hi></signed></closer>
            </div>
        </body>
    </text>
