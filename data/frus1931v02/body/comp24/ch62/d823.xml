    <text>
        <body>
            <div xml:id="d823">

                <pb facs="0900" n="780" sameAs="frus:frus1931v02/pg780"/>

                <note rend="inline" type="source">817.48 Earthquake of 1931/10: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Chargé in Nicaragua</hi>
                        (<hi rendition="#italic">Beaulac</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1931-03-31T12:00:00-05:00">March 31,
                    1931—noon</date>.</dateline></opener>
                <p>24. Press reports announce serious earthquake.<anchor n="1" xml:id="d823-f1"/>
                    Please report.</p>
                <closer><signed><hi rendition="#small-caps">Stimson</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d823-f1" n="1" xml:id="d823-f1-content">
                <p>The earthquake occurred a few minutes after 10 o’clock on the morning of March
                    31. See The American National Red Cross, <hi rendition="#italic">Managua
                        Earthquake: Official Report of the Relief Work in Nicaragua after the
                        Earthquake of March 31, 1931</hi> (Washington, 1931), p. 5.</p>
            </note>
        </listAnnotation>
    </standOff>
