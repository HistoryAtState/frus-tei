    <text>
        <body>
            <div xml:id="d832">

                <pb facs="0903" n="783" xml:id="pg783"/>

                <note rend="inline" type="source">817.48 Earthquake of 1931/6: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Nicaragua</hi> (<hi rendition="#italic"
                        >Beaulac</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Managua</hi></placeName> [<date
                            ana="#date_undated-inferred-from-document-content-and-sibling-dates"
                            calendar="gregorian" notAfter="1931-04-01T01:40:00-05:00"
                            notBefore="1931-03-31T22:41:00-05:45">undated</date>].<lb/>[Received
                        April 1, 1931—1:40 a.m.]</dateline></opener>
                <p>Reference telegram from Red Cross.<anchor n="3" xml:id="d832-f1"/> Practically
                    all inhabitants of Managua are homeless. Ten thousand dollars will not begin to
                    give adequate relief.</p>
                <closer><signed><hi rendition="#small-caps">Beaulac</hi></signed></closer>
            </div>
        </body>
    </text>
