    <text>
        <body>
            <div xml:id="d384">

                <pb facs="0486" n="366" sameAs="frus:frus1931v02/pg366"/>

                <note rend="inline" type="source">711.90a2/16</note>
                <head><hi rendition="#italic">The Secretary of State to the British Ambassador</hi>
                        (<hi rendition="#italic">Lindsay</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1930-10-04">October 4, 1930</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I have the honor to acknowledge the
                    receipt of your note of August 18, 1930, referring to previous correspondence on
                    the subject of a treaty to be concluded between this Government and the Sultan
                    of Muscat for the purpose of modifying the provisions of Article III of the
                    treaty of 1833 between the two Parties, and asking to be furnished with a draft
                    of the proposed new treaty.</p>
                <p>In reply, I take pleasure in transmitting herewith the draft of a treaty, as
                    requested, which this Government is prepared to enter into with the Sultan of
                    Muscat.</p>
                <p>Accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps">H. L. Stimson</hi></signed></closer>



                <xi:include href="d384-a1.xml" xpointer="d384-a1"/>
