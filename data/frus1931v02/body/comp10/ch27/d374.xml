            <div xml:id="d374">

                <pb facs="0473" n="353" xml:id="pg353"/>

                <note rend="inline" type="source">211.41/159: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Dawes</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1931-12-22T12:00:00+00:00">December 22,
                        1931—noon</date>.<lb/>[Received December 22—8:35 a.m.]</dateline></opener>
                <p>468. Department’s instruction 949, October 1. Extradition treaty signed and notes
                    regarding its application to Palestine and Trans-Jordan exchanged today.
                    Documents in next pouch.</p>
                <closer><signed><hi rendition="#small-caps">Dawes</hi></signed></closer>
            </div>
        </body>
    </text>
