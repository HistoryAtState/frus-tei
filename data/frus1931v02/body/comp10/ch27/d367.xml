    <text>
        <body>
            <div xml:id="d367">

                <pb facs="0457" n="337" sameAs="frus:frus1931v02/pg337"/>

                <note rend="inline" type="source">211.41/137</note>
                <head><hi rendition="#italic">The Chargé in Great Britain</hi> (<hi
                        rendition="#italic">Atherton</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1928-11-19">November 19, 1928</date>.<lb/>[Received December
                        3.]</dateline>
                    <seg rendition="#float-left">No. 3182</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to refer to the Embassy’s
                    despatch No. 2199, October 3, 1927,<anchor n="1" xml:id="d367-f1"/> relating to
                    the conclusion of a supplementary extradition convention, and in this connection
                    to forward a copy, in triplicate, of a Foreign Office note, together with three
                    copies of a draft treaty<anchor n="2" xml:id="d367-f2"/> which it is proposed
                    might well replace the old treaty provision of 1842 and the various
                    supplementary conventions which have from time to time been added thereto.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Ray Atherton</hi></signed></closer>


                <xi:include href="d367-a1.xml" xpointer="d367-a1"/>
            </div>
        </body>
    </text>
