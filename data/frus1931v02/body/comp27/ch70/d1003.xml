    <text>
        <body>
            <div xml:id="d1003">

                <pb facs="1037" n="917" xml:id="pg917"/>

                <note rend="inline" type="source">823.00 Revolutions/202: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Peru</hi> (<hi
                            rendition="#italic">Dearing</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Lima</hi></placeName>, <date calendar="gregorian"
                            when="1931-03-24T08:00:00-05:00">March 24, 1931—8
                        a.m.</date><lb/>[Received 11:40 a.m.]</dateline></opener>
                <p>145. My 144, March 23 [<hi rendition="#italic">24</hi>], 1 a.m.<anchor n="17"
                        xml:id="d1003-f1"/> Government has dominated situation. City quiet, no
                    injury American or foreign life or property yet reported. Further report in few
                    hours.</p>
                <closer><signed><hi rendition="#small-caps">Dearing</hi></signed></closer>
            </div>
        </body>
    </text>
