                <pb facs="0309" n="189" sameAs="frus:frus1931v02/pg189"/>

                <note rend="inline" type="source">816.00 Revolutions/30: Telegram</note>
                <head><hi rendition="#italic">The Minister in El Salvador</hi> (<hi
                        rendition="#italic">Curtis</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >San Salvador</hi></placeName>, <date calendar="gregorian"
                            when="1931-12-07T18:00:00-06:00">December 7, 1931—6
                        p.m.</date><lb/>[Received 9:05 p.m.]</dateline></opener>
                <p>111. Everything quiet, conditions apparently becoming steadily more settled.</p>
                <closer><signed><hi rendition="#small-caps">Curtis</hi></signed></closer>
            </div>
        </body>
    </text>
