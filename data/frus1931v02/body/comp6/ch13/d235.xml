    <text>
        <body>
            <div xml:id="d235">

                <pb facs="0325" n="205" sameAs="frus:frus1931v02/pg205"/>

                <note rend="inline" type="source">816.01/29: Telegram</note>
                <head><hi rendition="#italic">The Minister in Guatemala</hi> (<hi
                        rendition="#italic">Whitehouse</hi>) <hi rendition="#italic">to the
                        Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Guatemala</hi></placeName>, <date calendar="gregorian"
                            when="1931-12-21T12:00:00-07:00">December 21,
                        1931—noon</date>.<lb/>[Received 2:30 p.m.]</dateline></opener>
                <p>73. Your 36, December 20, 1 p.m.<anchor n="32" xml:id="d235-f1"/> The Guatemalan
                    Government is entirely in agreement with the Department’s point of view and the
                    necessary instructions will be given at once to the Guatemalan Minister in
                    Salvador.</p>
                <p>Repeated to Salvador.</p>
                <closer><signed><hi rendition="#small-caps">Whitehouse</hi></signed></closer>
            </div>
        </body>
    </text>
