    <text>
        <body>
            <div xml:id="d1034">

                <pb facs="1082" n="962" sameAs="frus:frus1931v02/pg962"/>

                <note rend="inline" type="source">360c.1121 Fedoryszyn, Justyn/111</note>
                <head><hi rendition="#italic">The Polish Ambassador</hi> (<hi
                            rendition="#italic">Filipowicz</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1931-12-11">December 11, 1931</date>.</dateline>
                    <seg rendition="#float-left">No. 327/T/31</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In compliance with instructions received
                    from my Government, I have the honor to enclose herewith a check for $4000 (Four
                    thousand <pb facs="1083" n="963" xml:id="pg963"/> Dollars), this sum
                    constituting the indemnity with respect to the claim of Mr. Justyn Fedoryszyn,
                    paid on his behalf to the United States Government in full settlement of this
                    case.</p>
                <p>Accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps">T. Filipowicz</hi></signed></closer>
            </div>
        </body>
    </text>
