    <text>
        <body>
            <div xml:id="d1104">

                <pb facs="1163" n="1043" sameAs="frus:frus1931v02/pg1043"/>

                <note rend="inline" type="source">711.679 Residence and Establishment/76</note>
                <head><hi rendition="#italic">The Ambassador in Turkey</hi> (<hi rendition="#italic"
                        >Grew</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Ankara</hi></placeName>, <date calendar="gregorian"
                            when="1931-10-30">October 30, 1931</date>.<lb/>[Received November
                        17.]</dateline>
                    <seg rendition="#float-left">No. 1362</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to my telegram No. 49,
                    October 12, 1 P.M., and the Department’s mail instruction No. 320, February 26,
                        1931,<anchor n="18" xml:id="d1104-f1"/> I transmit herewith the Treaty of
                    Residence and Establishment signed at Ankara on October 28.<anchor n="19"
                        xml:id="d1104-f2"/> I also transmit a copy of my letter to the Minister of
                    Foreign Affairs as approved by the Department’s telegram No. 28, July 10 [<hi
                        rendition="#italic">27</hi>], 12 noon [<hi rendition="#italic">11
                    a.m.</hi>], and the original and English translation of the Minister’s
                    acknowledgment of the same.</p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">Joseph C. Grew</hi></signed></closer>




                <xi:include href="d1104-a1.xml" xpointer="d1104-a1"/>
                <xi:include href="d1104-a2.xml" xpointer="d1104-a2"/>
