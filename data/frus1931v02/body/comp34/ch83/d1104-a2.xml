    <text>
        <body>
            <div xml:id="d1104-a2">

                <pb facs="1164" n="1044" xml:id="pg1044"/>

                <opener><seg rendition="#center">[Enclosure 2—Translation]</seg></opener>
                <head><hi rendition="#italic">The Turkish Minister far Foreign Affairs</hi>
                        (<hi rendition="#italic">Tevfik Rüştü
                        Bey</hi>) <hi rendition="#italic">to the American Ambassador</hi>
                        (<hi rendition="#italic">Grew</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Ankara</hi></placeName>, <date calendar="gregorian"
                            when="1931-10-28">October 28, 1931</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Mr. Ambassador</hi>: I have the honor to acknowledge
                    the receipt of your letter of October 28, 1931, as follows:</p>
                <p>[Here follows text of the letter printed <hi rendition="#italic">supra.</hi>]</p>
                <p>I have noted its contents in my Government’s name and pray Your Excellency to
                    accept [etc.]</p>
                <closer>Dr. <signed>T. <hi rendition="#small-caps">Rüştü</hi></signed></closer>
            </div>
        </body>
    </text>
