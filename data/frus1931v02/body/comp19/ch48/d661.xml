            <div xml:id="d661">

                <pb facs="0760" n="640" sameAs="frus:frus1931v02/pg640"/>

                <note rend="inline" type="source">811.918/248</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Italian
                        Ambassador</hi> (<hi rendition="#italic">De Martino</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1931-07-02">July 2, 1931</date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Ambassador</hi>: I am in receipt of your
                    letter of June 16, 1931, in regard to <hi rendition="#italic">Il Martello</hi>.
                    As you are aware under our regime of freedom for the press, it is extremely
                    difficult to initiate judicial proceedings in respect to published utterances of
                    the nature of those which you quote in your letter.</p>
                <p>I am [etc.]</p>
                <closer><signed><hi rendition="#small-caps">W. R. Castle, Jr.</hi></signed></closer>
            </div>
        </body>
    </text>
