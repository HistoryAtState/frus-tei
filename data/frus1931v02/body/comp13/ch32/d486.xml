    <text>
        <body>
            <div xml:id="d486">

                <pb facs="0625" n="505" sameAs="frus:frus1931v02/pg505"/>

                <note rend="inline" type="source">838.00/3017</note>
                <head><hi rendition="#italic">The Minister in Haiti</hi> (<hi
                            rendition="#italic">Munro</hi>) <hi rendition="#italic">to
                        the Acting Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Port-au-Prince</hi></placeName>, <date calendar="gregorian"
                            when="1931-08-06">August 6, 1931</date>.<lb/>[Received August
                        10.]</dateline>
                    <seg rendition="#float-left">No. 187</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith the
                    original French and English text<anchor n="44" xml:id="d486-f1"/> of the
                    Haitianization Agreement of August 5, 1931.</p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">Dana G. Munro</hi></signed></closer>


                <xi:include href="d486-a1.xml" xpointer="d486-a1"/>
            </div>
        </body>
    </text>
