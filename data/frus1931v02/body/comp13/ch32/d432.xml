    <text>
        <body>
            <div xml:id="d432">

                <pb facs="0535" n="415" sameAs="frus:frus1931v02/pg415"/>

                <note rend="inline" type="source">838.105/365</note>
                <head><hi rendition="#italic">The Minister in Haiti</hi> (<hi
                            rendition="#italic">Munro</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Port-au-Prince</hi></placeName>, <date calendar="gregorian"
                            when="1931-02-07">February 7, 1931</date>.<lb/>[Received February
                        10.]</dateline>
                    <seg rendition="#float-left">No. 59</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith a
                    copy of a note which I addressed to the Minister for Foreign Affairs on February
                    6th, and also a copy of a note addressed to him on January 23rd, containing a
                    tentative schedule for the promotion of Haitian officers in the Garde.<anchor
                        n="17" xml:id="d432-f1"/></p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">Dana G. Munro</hi></signed></closer>


                <xi:include href="d432-a1.xml" xpointer="d432-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d432-f1" n="17" xml:id="d432-f1-content">
                <p>Note of January 23 and its enclosure not printed.</p>
