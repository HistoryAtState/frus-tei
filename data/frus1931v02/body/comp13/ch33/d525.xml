                <pb facs="0665" n="545" sameAs="frus:frus1931v02/pg545"/>

                <note rend="inline" type="source">838.51/2363: Telegram</note>
                <head><hi rendition="#italic">The Minister in Haiti</hi> (<hi
                            rendition="#italic">Munro</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Port-au-Prince</hi></placeName>, <date calendar="gregorian"
                            when="1931-11-27T13:00:00-05:00">November 27, 1931—1
                        p.m.</date><lb/>[Received 2:26 p.m.]</dateline></opener>
                <p>138. The Financial Adviser yesterday gave his accord to the budget and the latter
                    is now being published.</p>
                <closer><signed><hi rendition="#small-caps">Munro</hi></signed></closer>
            </div>
        </body>
