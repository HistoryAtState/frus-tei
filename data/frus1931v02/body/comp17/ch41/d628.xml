    <text>
        <body>
            <div xml:id="d628">

                <pb facs="0727" n="607" sameAs="frus:frus1931v02/pg607"/>

                <note rend="inline" type="source">890g.6363/306</note>
                <head><hi rendition="#italic">The Chargé in Great Britain</hi> (<hi rendition="#italic">Atherton</hi>) <hi
                        rendition="#italic">to the Acting Secretary of
                            State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1931-07-18">July 18, 1931</date>.<lb/>[Received July
                        30.]</dateline>
                    <seg rendition="#float-left">No. 2122</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to refer to the Embassy’s
                    cablegram No. 245 of July 18, 12 noon,<anchor n="20" xml:id="d628-f1"/> and to
                    previous correspondence regarding oil concessions in Iraq, and to transmit
                    herewith a copy of a communication from the Foreign Office under date of July
                    17, with enclosure, upon which the cablegram in question was based.</p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">Ray Atherton</hi></signed></closer>


                <xi:include href="d628-a1.xml" xpointer="d628-a1"/>
            </div>
        </body>
    </text>
