                <pb facs="0821" n="701" sameAs="frus:frus1931v02/pg701"/>

                <note rend="inline" type="source">812.48/3828: Telegram</note>
                <head><hi rendition="#italic">President Hoover to the President of Mexico</hi> (<hi
                        rendition="#italic">Ortiz Rubio</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1931-01-20">January 20, 1931</date>.</dateline></opener>
                <p>It is with the deepest regret that I learn of the recent earthquake in Mexico
                    which has wrought such destruction and loss of life. On behalf of the people of
                    the United States and in my own name, I wish to extend to Your Excellency and to
                    the people of Mexico an expression of sincere sympathy.</p>
                <closer><signed><hi rendition="#small-caps">Herbert Hoover</hi></signed></closer>
            </div>
        </body>
    </text>
