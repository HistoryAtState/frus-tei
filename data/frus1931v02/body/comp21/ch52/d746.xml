                <pb facs="0821" n="701" sameAs="frus:frus1931v02/pg701"/>

                <note rend="inline" type="source">812.48/3829: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Ambassador in
                        Mexico</hi> (<hi rendition="#italic">Clark</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1931-01-19T17:00:00-05:00">January 19, 1931—5
                        p.m.</date></dateline></opener>
                <p>21. Department has received from American Red Cross check for $5,000 for relief
                    of sufferers from recent earthquake in central and southern part of Mexico. Draw
                    on Department for that amount and deliver proceeds to appropriate officers of
                    the Mexican Red Cross for the purpose stated.</p>
                <p>Render separate account.</p>
                <closer><signed><hi rendition="#small-caps">Stimson</hi></signed></closer>
            </div>
        </body>
    </text>
