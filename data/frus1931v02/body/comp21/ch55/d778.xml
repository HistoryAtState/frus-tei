    <text>
        <body>
            <div xml:id="d778">

                <pb facs="0847" n="727" xml:id="pg727"/>

                <note rend="inline" type="source">702.1211/2128: Telegram</note>
                <head><hi rendition="#italic">The Governor of Illinois</hi> (<hi rendition="#italic"
                        >Emmerson</hi>) <hi rendition="#italic">to the Acting Secretary of
                        State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Springfield</hi></placeName>, <date calendar="gregorian"
                            when="1931-07-07">July 7, 1931</date>.<lb/>[Received 8:52
                        p.m.]</dateline></opener>
                <p>For Castle. Your telegram relative to arrest of Mexican Consul at Chicago on
                    chargé of contempt of court of Judge Thomas Green received. We are making an
                    immediate investigation to see what can be done and will advise you.</p>
                <closer><signed><hi rendition="#small-caps">Louis L. Emmerson</hi></signed></closer>
            </div>
        </body>
    </text>
