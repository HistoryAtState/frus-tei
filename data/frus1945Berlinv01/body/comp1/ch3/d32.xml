    <text>
        <body>
            <div xml:id="d32">

                <pb facs="0195" n="63" sameAs="frus:frus1945Berlinv01/pg63"/>

                <note rend="inline" type="source">
                    Leahy Papers: Telegram</note>
                <head>No. 32 <lb/>
                    <hi rendition="#italic">Prime Minister Churchill to President Truman
                    </hi><anchor n="1" xml:id="d32-f1"/>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1945-05-23">23 May 1945</date>.</dateline>
                </opener>
                <p>Prime Minister to President Truman,
                    personal and top secret, Number 54.</p>
                <p>Thank you for your Number 46.<anchor n="2" xml:id="d32-f2"/> I shall be delighted
                    to see Mr. Davies as soon as he
                    arrives.</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d32-f1" n="1" type="source" xml:id="d32-f1-content">
                <p>Sent by the United States Military Attaché, London, via Army channels.</p>
            </note>
            <note corresp="#d32-f2" n="2" xml:id="d32-f2-content">
