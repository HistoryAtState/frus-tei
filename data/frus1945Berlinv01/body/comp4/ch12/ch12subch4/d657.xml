    <text>
        <body>
            <div xml:id="d657">

                <pb facs="1121" n="987" sameAs="frus:frus1945Berlinv01/pg987"/>

                <note rend="inline" type="source">881.00/6–2545: Telegram</note>
                <head>No. 657 <lb/>
                    <hi rendition="#italic">The Ambassador in the United Kingdom</hi> (<hi rendition="#italic"
                    >Winant</hi>) <hi rendition="#italic">to the Acting
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                        <lb/>
                        <hi rendition="#small-caps">us urgent</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1945-06-25T20:00:00+02:00">June 25, 1945—8
                            p.m.</date>
                    </dateline>
                </opener>
                <p>6403. French Govt being informed by British Embassy Paris that British Govt
                    agreeable to Paris meeting re Tangier. Details of communication to USSR expected
                    to be concerted Paris at once and we will be promptly informed when
                    communications made.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Winant</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
