                <pb facs="0435" n="303" sameAs="frus:frus1945Berlinv01/pg303"/>

                <note rend="inline" type="source">740.0011 P. W./7–1545: Telegram</note>
                <head>No. 243<lb/><hi rendition="#italic">The Ambassador in the United Kingdom</hi>
                        (<hi rendition="#italic">Winant</hi>) <hi rendition="#italic">to the Acting
                        Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                        <lb/>
                        <hi rendition="#small-caps">us urgent</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1945-07-15T12:00:00+01:00">July 15,
                            1945—noon.</date>
                    </dateline>
                </opener>
                <p>7144. Foreign Office given substance of Department’s 5773, July 14<anchor n="1"
                        xml:id="d243-f1"/> this morning.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Winant</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
