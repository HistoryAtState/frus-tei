    <text>
        <body>
            <div xml:id="d270-a1">

                <pb facs="0469" n="337" sameAs="frus:frus1945Berlinv01/pg337"/>

                <opener>
                    <seg rendition="#center">[Enclosure]</seg>
                </opener>
                <head>
                    <hi rendition="#small-caps">Directive to Commander in Chief of U. S. Forces of
                        Occupation Regarding the Military Government of Austria</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1945-06-23">23 June 1945</date>.</dateline>
                </opener>
                <p rendition="#flush"> IPCOG 9/2</p>
                <p rendition="#flush">References: <hi rendition="#italic">a</hi>. IPCOG 9</p>
                <p>
                    <hi rendition="#italic">b</hi>. IPCOG 9/1</p>
                <p>1. The enclosure, a revision of IPCOG 9 to incorporate the amendment proposed by
                    the Joint Chiefs of Staff, as approved by the Informal <pb facs="0470" n="338"
                        xml:id="pg338"/> Policy Committee on Germany on 23 June 1945, is circulated
                    for information and guidance.</p>
                <p rendition="#center">. . . . . . .</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Charles W. McCarthy</hi>
                        <lb/>
                        <hi rendition="#small-caps">Alvin F. Richardson</hi>
                        <lb/>
                        <hi rendition="#small-caps">Raymond E. Cox</hi>
                    </signed>
                    <lb/>
                    <hi rendition="#italic">Secretariat</hi>
                </closer>
            </div>
        </body>
