    <text>
        <body>
            <div xml:id="d259">

                <pb facs="0453" n="321" sameAs="frus:frus1945Berlinv01/pg321"/>

                <note rend="inline" type="source">740.00119 (Potsdam)/5–2446</note>
                <head>No. 259<lb/><hi rendition="#italic">Briefing Book Paper</hi><anchor n="1"
                        xml:id="d259-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Extract]<anchor n="2" xml:id="d259-f2"/></seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                </opener>
                <p rendition="#center">
                    <hi rendition="#small-caps">European Territorial Settlements</hi>
                </p>
                <p rendition="#center">
                    <hi rendition="#small-caps">i. germany</hi>
                </p>
                <p rendition="#center">. . . . . . .</p>
                <p>… We are opposed to revision of the Danish-German frontier unless such action is
                    considered necessary in connection with a possible internationalization of the
                    Kiel Canal.</p>
                <p rendition="#center">. . . . . . .</p>
                <closer>
                    <dateline rendition="#float-left">[<placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>,] <date calendar="gregorian" when="1945-06-29">June 29,
                            1945</date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d259-f1" n="1" type="source" xml:id="d259-f1-content">
                <p>Annex 13 to the attachment to <ref target="#d177">document No. 177</ref>.</p>
            </note>
            <note corresp="#d259-f2" n="2" xml:id="d259-f2-content">
                <p>For other extracts from this paper, see documents Nos. 398 and 509.</p>
            </note>
        </listAnnotation>
