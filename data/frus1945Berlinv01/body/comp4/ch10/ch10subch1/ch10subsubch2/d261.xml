    <text>
        <body>
            <div xml:id="d261">

                <pb facs="0454" n="322" xml:id="pg322"/>

                <note rend="inline" type="source"> Truman Papers</note>
                <head>No. 261<lb/><hi rendition="#italic">Memorandum by the Assistant to the
                        President’s Naval Aide</hi> (<hi rendition="#italic">Elsey</hi>)<anchor
                        n="1" xml:id="d261-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<date
                            ana="#date_undated-inferred-from-document-content" calendar="gregorian"
                            when="1945-07-01">Undated</date>.]</dateline>
                </opener>
                <p rendition="#center">
                    <hi rendition="#small-caps">Free Use of Rhine and Danube Rivers</hi>
                </p>
                <p>There has been no reference to the free use of the Rhine and Danube Rivers in
                    President Roosevelt’s and President Truman’s messages and papers in the Map
                    Room.</p>
                <closer>
                    <signed> G. M. <hi rendition="#small-caps">Elsey</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d261-f1" n="1" type="source" xml:id="d261-f1-content">
                <p>Submitted to Leahy July 1 and subsequently forwarded to Truman.</p>
            </note>
        </listAnnotation>
    </standOff>
