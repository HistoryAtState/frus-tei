    <text>
        <body>
            <div xml:id="d503-a1">

                <pb facs="0869" n="737" sameAs="frus:frus1945Berlinv01/pg737"/>

                <opener>
                    <seg rendition="#center">[Enclosure]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">The Chargé Near the Polish Government-in-Exile</hi> (<hi
                        rendition="#italic">Schoenfeld</hi>) <hi rendition="#italic">to the Polish
                        Minister of Foreign Affairs</hi> (<hi rendition="#italic"
                    >Tarnowski</hi>)</head>
                <opener>
                    <seg rendition="#float-left">No. 266</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1945-07-05">July 5, 1945</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: Since the Government of the United
                    States of America has, in conformity with the decisions of the Crimea
                    Conference, decided to recognize effective at 7:00 p.m. Eastern War Time July 5,
                    1945 the new Polish Provisional Government of National Unity as the Government
                    of the Republic of Poland, I have the honor to inform Your Excellency that the
                    Mission of the American Embassy near the Polish Government in exile in London
                    will terminate as of that time.<anchor n="2" xml:id="d503-f1"/>
                </p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Rudolf</hi> E. <hi rendition="#small-caps"
                            >Schoenfeld</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d503-f1" n="2" xml:id="d503-f1-content">
                <p>Similar notice was given to the Polish Embassy at Washington and to the Embassy
                    of the Polish Provisional Government of National Unity at Moscow.</p>
            </note>
        </listAnnotation>
    </standOff>
