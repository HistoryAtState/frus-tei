    <text>
        <body>
            <div xml:id="d468-a1">

                <pb facs="0827" n="695" sameAs="frus:frus1945Berlinv01/pg695"/>

                <opener>
                    <seg rendition="#center">[Attachment 3]<anchor n="2" xml:id="d468-f1"/></seg>
                </opener>
                <head>
                    <hi rendition="#italic">The Italian Ambassador</hi> (<hi rendition="#italic">Tarchiani</hi>) <hi
                        rendition="#italic">to President Truman
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-07-06">July 6, 1945</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. President</hi>: On the eve of your eventful
                    voyage to Berlin, allow me to express to you the fervid wishes of the Italian
                    people, and to invite your attention to the enclosed memorandum in which the
                    present position of Italy and her vital
                    needs and aspirations are outlined.</p>
                <p>My country places its confidence in the human friendship of America and in the
                    clear sense of justice of her President.</p>
                <p>Faithfully yours,</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Alberto Tarchiani</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d468-f1" n="2" xml:id="d468-f1-content">
                <p>Printed from a carbon copy with a typed signature which appears to have
