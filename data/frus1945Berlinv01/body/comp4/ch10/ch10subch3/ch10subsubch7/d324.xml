    <text>
        <body>
            <div xml:id="d324">

                <pb facs="0558" n="426" sameAs="frus:frus1945Berlinv01/pg426"/>

                <note rend="inline" type="source">861.6363/7–1345</note>
                <head>No. 324<lb/><hi rendition="#italic">The Secretary of
                            State to the Ambassador in the Soviet Union</hi> (<hi rendition="#italic"
                        >Harriman</hi>)<anchor n="1" xml:id="d324-f1"/>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                        <lb/> No. 698</seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1945-07-06">July 6, 1945</date>.</dateline>
                </opener>
                <p>The Secretary of State transmits herewith, in duplicate, a policy document under
                    the subject “Use of American Property by Satellite Countries for
                    Reparation”.</p>
                <p>It is requested that the Mission be guided by this document in all matters
                    relating to the subject and that one copy thereof be transmitted <pb facs="0559"
                        n="427" xml:id="pg427"/> to the American representative on the Reparations
                    Commission for his information and guidance.</p>
                <closer>
                    <signed>
                        J[<hi rendition="#small-caps">ohn</hi>] A L[<hi
                                rendition="#small-caps">oftus</hi>]
                    </signed>
                </closer>


                <xi:include href="d324-a1.xml" xpointer="d324-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d324-f1" n="1" type="source" xml:id="d324-f1-content">
                <p>Similar instructions were dispatched on the same date to the American
                    Representatives in Bulgaria, Hungary, and
                        Rumania.</p>
            </note>
        </listAnnotation>
    </standOff>
