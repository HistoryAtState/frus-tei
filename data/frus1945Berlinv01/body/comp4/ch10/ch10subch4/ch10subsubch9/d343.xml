    <text>
        <body>
            <div xml:id="d343">

                <pb facs="0614" n="482" sameAs="frus:frus1945Berlinv01/pg482"/>

                <note rend="inline" type="source">740.00119 Control (Germany)/7–445</note>
                <head>No. 343<lb/><hi rendition="#italic">The Assistant Secretary of State</hi>
                        (<hi rendition="#italic"
                            >MacLeish</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1945-07-04">July 4, 1945</date>.</dateline>
                </opener>
                <p>You asked me at the Staff Committee meeting this morning to submit a paper on the
                    Department’s efforts to prepare a long-range policy for German reeducation. The
                    paper is attached.</p>
                <closer>
                    <signed>
                        A[<hi rendition="#small-caps">rchibald</hi>] <hi
                                rendition="#small-caps">MacL</hi>[<hi rendition="#small-caps"
                                >eish</hi>]
                    </signed>
                </closer>


                <xi:include href="d343-a1.xml" xpointer="d343-a1"/>
            </div>
