    <text>
        <body>
            <div xml:id="d362">

                <pb facs="0651" n="519" sameAs="frus:frus1945Berlinv01/pg519"/>

                <note rend="inline" type="source">740.00119 EW/6–2945: Telegram</note>
                <head>No. 362<lb/><hi rendition="#italic">The Representative on the Allied
                        Commission on Reparations</hi> (<hi
                            rendition="#italic">Pauley</hi>) <hi rendition="#italic">to
                        the President
                    </hi><anchor n="1" xml:id="d362-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Extract]<anchor n="2" xml:id="d362-f2"/></seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Moscow</hi></placeName>, <date
                            calendar="gregorian" when="1945-06-29T20:00:00+03:00">June 29, 1945—8
                            p.m.</date>
                    </dateline>
                </opener>
                <p>2325. Top sec from Pauley to the President.</p>
                <p>I am bending every effort to have a proposed reparation plan to submit to you and
                    the heads of Great Brit and Russia at your
                    forthcoming meeting. …</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d362-f1" n="1" type="source" xml:id="d362-f1-content">
                <p>Sent to the Secretary of State ad interim over the signature of Harriman.</p>
            </note>
            <note corresp="#d362-f2" n="2" xml:id="d362-f2-content">
                <p>For the full text of this message, see <ref target="#d110">document No.
                    110</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
