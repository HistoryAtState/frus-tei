    <text>
        <body>
            <div xml:id="d220">

                <pb facs="0375" n="243" sameAs="frus:frus1945Berlinv01/pg243"/>

                <note rend="inline" type="source">
                    J. C. S. Files</note>
                <head>No. 220 <lb/>
                    <hi rendition="#italic">Memorandum by the British Chiefs of Staff</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                        <lb/>
                        C. C. S. 880/9</seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Babelsberg</hi></placeName>,] <date calendar="gregorian"
                            when="1945-07-15">15 July 1945</date>.</dateline>
                </opener>
                <p rendition="#center">
                    <hi rendition="#small-caps">Program and Procedure for the Conference</hi>
                </p>
                <list>
                    <label>1.</label>
                    <item>We suggest that in accordance with the procedure we have adopted at
                        previous conferences, the United States and British Chiefs <pb facs="0376"
                            n="244" xml:id="pg244"/> of Staff should hold their domestic meetings in
                        the morning and the Combined Chiefs of Staff should meet in the afternoon at
                            1430.<anchor n="1" xml:id="d220-f1"/>
                    </item>
                    <label>2.</label>
                    <item>We suggest also that we should aim to work to the attached
                        programme.</item>
                </list>


                <xi:include href="d220-a1.xml" xpointer="d220-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d220-f1" n="1" xml:id="d220-f1-content">
                <p>i. e., at 2:30 p.m.</p>
