    <text>
        <body>
            <div xml:id="d142">

                <pb facs="0288" n="156" sameAs="frus:frus1945Berlinv01/pg156"/>

                <note rend="inline" type="source"> Leahy Papers: Telegram</note>
                <head>No. 142 <lb/>
                    <hi rendition="#italic">President Truman to Prime Minister Churchill
                        </hi><anchor n="1" xml:id="d142-f1"/>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1945-05-28">28 May 1945</date>.</dateline>
                </opener>
                <p>48. Your messages 55<anchor n="2" xml:id="d142-f2"/> and 56<anchor n="3"
                        xml:id="d142-f3"/> received.</p>
                <p>I am in general agreement with your reply to Stalin regarding surrendered German
                    naval and merchant ships and I will send him a similar message.<anchor n="4"
                        xml:id="d142-f4"/>
                </p>
                <p rendition="#center">. . . . . . .</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d142-f1" n="1" type="source" xml:id="d142-f1-content">
                <p>Presumably sent to the United States Naval Attaché London, via Navy channels.</p>
            </note>
            <note corresp="#d142-f2" n="2" xml:id="d142-f2-content">
                <p>Not printed herein.</p>
            </note>
            <note corresp="#d142-f3" n="3" xml:id="d142-f3-content">
                <p>
                    <ref target="#d141">Document No. 141</ref>.</p>
            </note>
            <note corresp="#d142-f4" n="4" xml:id="d142-f4-content">
                <p>See <ref target="#d143">document No. 143</ref>. For the final paragraph of this
                    message, omitted here, see <ref target="#d37">document No. 37</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
