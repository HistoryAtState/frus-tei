    <text>
        <body>
            <div xml:id="d148">

                <pb facs="0293" n="161" sameAs="frus:frus1945Berlinv01/pg161"/>

                <note rend="inline" type="source">740.0011 E. W./6–145</note>
                <head>No. 148 <lb/>
                    <hi rendition="#italic">The British Minister</hi> (<hi rendition="#italic"
                        >Balfour</hi>) <hi rendition="#italic">to the Acting Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                        <lb/>
                        <hi rendition="#small-caps">personal</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-06-01">1st June, 1945</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Under Secretary</hi>, With reference to
                    my letter of May 29th,<anchor n="1" xml:id="d148-f1"/> Mr. Eden has asked me to
                    tell you that in view of Marshal Stalin’s message about surrendered German naval
                    and merchant ships,<anchor n="2" xml:id="d148-f2"/> His Majesty’s Government
                    propose the addition of the following item to Section 2 of the Agenda for the
                    forthcoming meeting of Heads of Governments: <quote rend="blockquote">
                        <p>“Disposal of German Fleet and Merchant Ships”.<anchor n="3"
                                xml:id="d148-f3"/>
                        </p>
                    </quote>
                </p>
                <p>Yours very sincerely,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">John Balfour</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
