    <text>
        <body>
            <div xml:id="d215">

                <pb facs="0373" n="241" sameAs="frus:frus1945Berlinv01/pg241"/>

                <note rend="inline" type="source">Moscow Embassy Files—500 Berlin Conference</note>
                <head>No. 215 <lb/>
                    <hi rendition="#italic">Mr. V. N. Pavlov, of the Soviet Foreign Commissariat, to
                        the First Secretary of Embassy in the Soviet Union</hi> (<hi
                        rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Translation]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Moscow</hi></placeName>, <date
                            calendar="gregorian" when="1945-07-13">July 13, 1945</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Page</hi>: At the instruction of the
                    People’s Commissar I request you to inform Mr. W. A. Harriman that V. M. Molotov
                    has received his letter of July 12<anchor n="1" xml:id="d215-f1"/> regarding
                    consideration of the reparations problem at the forthcoming meeting of the heads
                    of the three governments.</p>
                <p>Respectfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Pavlov</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
