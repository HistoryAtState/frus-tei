    <text>
        <body>
            <div xml:id="d168">

                <pb facs="0325" n="193" sameAs="frus:frus1945Berlinv01/pg193"/>

                <note rend="inline" type="source">740.00119 Control (Italy)/6–2345: Telegram</note>
                <head>No. 168 <lb/>
                    <hi rendition="#italic">President Truman to Marshal Stalin </hi><anchor n="1"
                        xml:id="d168-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Extract]<anchor n="2" xml:id="d168-f2"/></seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Olympia, Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1945-06-25">25 June 1945</date>.</dateline>
                </opener>
                <p>304 …</p>
                <p rendition="#center">. . . . . . .</p>
                <p>Should there be any further aspect of the agreement<anchor n="3" xml:id="d168-f3"
                    /> which you feel should be considered, we shall have an opportunity to discuss
                    this at our early meeting.</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d168-f1" n="1" type="source" xml:id="d168-f1-content">
                <p>Presumably sent to the United States Naval Attaché, Moscow, via the White House
                    Map Room and Navy channels.</p>
            </note>
            <note corresp="#d168-f2" n="2" xml:id="d168-f2-content">
                <p>For the full text of this message, see <ref target="#d570">document No.
                    570</ref>.</p>
            </note>
            <note corresp="#d168-f3" n="3" xml:id="d168-f3-content">
                <p>i. e., the Anglo-American-Yugoslav agreement relating to Venezia Giulia, signed
                    at Belgrade, June 9, 1945 (Executive Agreement Series No. 501; 59 Stat. (2)
                    1855).</p>
            </note>
        </listAnnotation>
    </standOff>
