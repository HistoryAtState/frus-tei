    <text>
        <body>
            <div xml:id="d71">

                <pb facs="0236" n="104" xml:id="pg104"/>

                <note rend="inline" type="source">
                    Leahy Papers: Telegram</note>
                <head>No. 71 <lb/>
                    <hi rendition="#italic">President Truman to Prime Minister Churchill
                    </hi><anchor n="1" xml:id="d71-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Extract]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1945-06-16">16 June 1945</date>.</dateline>
                </opener>
                <p>76. Replying to your No. 92,<anchor n="2" xml:id="d71-f2"/> I will be very
                    pleased to agree to any arrangements you may make to accomplish His Majesty’s
                    desires during his projected visit in Berlin.</p>
                <p rendition="#center">. . . . . . .</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d71-f1" n="1" type="source" xml:id="d71-f1-content">
                <p>Presumably sent to the United States Naval Attaché, London, via Navy
                    channels.</p>
            </note>
            <note corresp="#d71-f2" n="2" xml:id="d71-f2-content">
                <p>
                    <ref target="#d64">document No. 64</ref>.</p>
