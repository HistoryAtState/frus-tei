    <text>
        <body>
            <div xml:id="d38">

                <pb facs="0219" n="87" xml:id="pg87"/>

                <note rend="inline" type="source">
                    Leahy Papers: Telegram</note>
                <head>No. 38 <lb/>
                    <hi rendition="#italic">The President to the
                        President’s Adviser and Assistant</hi> (<hi rendition="#italic">Hopkins</hi>)<anchor n="1"
                        xml:id="d38-f1"/>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1945-05-28">28 May 1945</date>.</dateline>
                </opener>
                <p>274. Your messages 262101<anchor n="2" xml:id="d38-f2"/> and 272211<anchor n="3"
                        xml:id="d38-f3"/> received.</p>
                <p>You may inform Stalin that I perceive no
                    objection to meeting in the Berlin area and that about the 15th of July appears
                    to be a practicable date for me.<anchor n="4" xml:id="d38-f4"/>
                </p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d38-f1" n="1" type="source" xml:id="d38-f1-content">
                <p>Presumably sent to the United States Naval Attaché, Moscow, via Navy
                    channels.</p>
            </note>
            <note corresp="#d38-f2" n="2" xml:id="d38-f2-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d38-f3" n="3" xml:id="d38-f3-content">
                <p>
                    <ref target="#d36">document No. 36</ref>.</p>
            </note>
            <note corresp="#d38-f4" n="4" xml:id="d38-f4-content">
                <p>See <hi rendition="#italic">ante</hi>, <ref target="#pg53">p. 53</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
