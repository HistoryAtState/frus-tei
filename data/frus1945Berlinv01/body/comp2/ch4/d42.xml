    <text>
        <body>
            <div xml:id="d42">

                <pb facs="0220" n="88" sameAs="frus:frus1945Berlinv01/pg88"/>

                <note rend="inline" type="source">
                    Truman Papers</note>
                <head>No. 42 <lb/>
                    <hi rendition="#italic">
                        Marshal Stalin to
                        President Truman
                    </hi><anchor n="1" xml:id="d42-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Translation]</seg>
                </opener>
                <p>Secret and personal from Premier J. V.
                        Stalin to President H. S.
                        Truman.</p>
                <p>Mr. Hopkins has transmitted [to] me today
                    your proposal regarding the meeting of the three.<anchor n="2" xml:id="d42-f2"/>
                    I have no objections against the proposed by you date—July 15th.</p>
                <closer>
                    <dateline rendition="#float-left">[<placeName>
                            <hi rendition="#small-caps">Moscow</hi>
                        </placeName>,] <date calendar="gregorian" when="1945-05-30">May 30,
                            1945</date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d42-f1" n="1" type="source" xml:id="d42-f1-content">
                <p>Russian original, accompanied by this translation, transmitted by the Soviet
                    Embassy, Washington.</p>
            </note>
            <note corresp="#d42-f2" n="2" xml:id="d42-f2-content">
                <p>See <ref target="#d38">document No. 38</ref>.</p>
            </note>
