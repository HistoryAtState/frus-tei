    <text>
        <body>
            <div xml:id="d68">

                <pb facs="0233" n="101" xml:id="pg101"/>

                <note rend="inline" type="source">740.0011 E. W./6–1545</note>
                <head>No. 68 <lb/>
                    <hi rendition="#italic">The Acting Secretary of State to the President’s Naval
                        Aide</hi> (<hi rendition="#italic">Vardaman</hi>)</head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">confidential</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1945-06-15">June 15, 1945</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Captain Vardaman</hi>: In accordance with your
                    request, I append hereto a memorandum for the President, together with a
                    tentative list of State Department personnel, whose presence at the forthcoming
                    meeting of heads of government will, we believe, be helpful to the
                    President.</p>
                <p>Faithfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Joseph C. Grew</hi>
                    </signed>
                </closer>



