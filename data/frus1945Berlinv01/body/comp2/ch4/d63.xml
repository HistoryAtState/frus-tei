    <text>
        <body>
            <div xml:id="d63">

                <pb facs="0230" n="98" sameAs="frus:frus1945Berlinv01/pg98"/>

                <note rend="inline" type="source"> Leahy Papers: Telegram</note>
                <head>No. 63 <lb/>
                    <hi rendition="#italic">President Truman to Prime Minister Churchill
                        </hi><anchor n="1" xml:id="d63-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1945-06-15">15 June 1945</date>.</dateline>
                </opener>
                <p>74. Your number 89<anchor n="2" xml:id="d63-f2"/> meets with my approval.<anchor
                        n="3" xml:id="d63-f3"/>
                </p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d63-f1" n="1" type="source" xml:id="d63-f1-content">
                <p>Presumably sent to the United States Naval Attaché, London, via Navy
                    channels.</p>
            </note>
            <note corresp="#d63-f2" n="2" xml:id="d63-f2-content">
                <p>
                    <ref target="#d62">document No. 62</ref>.</p>
            </note>
            <note corresp="#d63-f3" n="3" xml:id="d63-f3-content">
                <p> Leahy notified the Secretary of State on June 15 that the President had approved
                    the code word <hi rendition="#small-caps">Terminal</hi> for the forthcoming
                    tripartite conference (file No. 740.00119 (Potsdam)/6–1545).</p>
            </note>
        </listAnnotation>
    </standOff>
