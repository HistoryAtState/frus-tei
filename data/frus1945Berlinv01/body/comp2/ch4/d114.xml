    <text>
        <body>
            <div xml:id="d114">

                <pb facs="0269" n="137" sameAs="frus:frus1945Berlinv01/pg137"/>

                <note rend="inline" type="source">
                    Leahy Papers: Telegram</note>
                <head>No. 114 <lb/>
                    <hi rendition="#italic">The President to the
                        Ambassador in the Soviet Union</hi> (<hi rendition="#italic">Harriman</hi>)<anchor n="1"
                        xml:id="d114-f1"/>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1945-07-03">3 July 1945</date>.</dateline>
                </opener>
                <p>
                    Pauley, Dr. Lubin and four assistants are authorized to report to President
                    on proposed reparation plan during forthcoming meeting.</p>
                <p>Army has been notified.</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d114-f1" n="1" type="source" xml:id="d114-f1-content">
                <p>Presumably sent to the United States Naval Attaché Moscow, via Navy channels.</p>
            </note>
        </listAnnotation>
    </standOff>
