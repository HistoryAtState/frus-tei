    <text>
        <body>
            <div xml:id="d136">

                <pb facs="0285" n="153" sameAs="frus:frus1945Berlinv01/pg153"/>

                <note rend="inline" type="source">740.0011 EW/7–1145:
                    Telegram</note>
                <head>No. 136 <lb/>
                    <hi rendition="#italic">The Acting Director of the Office of European
                        Affairs</hi> (<hi
                            rendition="#italic">Hickerson</hi>) <hi rendition="#italic"
                        >to the Ambassador in France</hi> (<hi
                            rendition="#italic">Caffery</hi>)<anchor n="1"
                        xml:id="d136-f1"/>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">confidential</hi>
                        <lb/>
                        <hi rendition="#small-caps">u. s. urgent</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-07-11T19:00:00-04:00">July 11, 1945—7
                            p.m.</date>
                    </dateline>
                </opener>
                <p>3214. Personal for Caffery from Hickerson.</p>
                <p>Will you please give the following message to Jimmy
                        Dunn?</p>
                <quote rend="blockquote">
                    <p>“The British Embassy received a telegram this afternoon stating that
                            Cadogan would arrive at <hi
                            rendition="#small-caps">Terminal</hi> in the early afternoon of July 14
                        and that he hopes very much to be able to have an informal talk with you
                        that day.”</p>
                </quote>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d136-f1" n="1" type="source" xml:id="d136-f1-content">
                <p>Sent over the signature of Grew.</p>
            </note>
        </listAnnotation>
    </standOff>
