    <text>
        <body>
            <div xml:id="d126">

                <pb facs="0279" n="147" xml:id="pg147"/>

                <note rend="inline" type="source">740.0011 EW/7–645: Telegram</note>
                <head>No. 126 <lb/>
                    <hi rendition="#italic">The Secretary of State to the Political Adviser in
                        Germany</hi> (<hi rendition="#italic">Murphy</hi>)</head>
                <opener>
                    <seg rendition="#center">[Extract]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-07-06T19:00:00-04:00">July 6, 1945—7
                            p.m.</date>
                    </dateline>
                </opener>
                <p>72. …</p>
                <p>We have sent through the Joint Chiefs a description<anchor n="1" xml:id="d126-f1"
                    /> of the office and living quarters which will be required by the delegation.
                    We would appreciate your good offices in cooperating with the military
                    authorities to see to it that these accommodations are as satisfactory as
                    possible.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Byrnes</hi>
                        <lb/> C[harles] W Y[ost] </signed>
                </closer>
            </div>
        </body>
    </text>
