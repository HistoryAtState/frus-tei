    <text>
        <body>
            <div xml:id="d76">

                <pb facs="0239" n="107" sameAs="frus:frus1945Berlinv01/pg107"/>

                <note rend="inline" type="source">
                    Leahy Papers: Telegram</note>
                <head>No. 76 <lb/>
                    <hi rendition="#italic">President Truman to Prime Minister Churchill
                    </hi><anchor n="1" xml:id="d76-f1"/>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1945-06-18">18 June 1945</date>.</dateline>
                </opener>
                <p>78. The press reports referred to in your 93<anchor n="2" xml:id="d76-f2"/> are
                    not authentic.</p>
                <p>I shall keep the promise made to you by President Roosevelt if conditions at the time make it practicable.</p>
                <pb facs="0240" n="108" xml:id="pg108"/>
                <p>May I express a hope that the contents of this message will not get into the
                    papers.</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d76-f1" n="1" type="source" xml:id="d76-f1-content">
                <p>Presumably sent to the United States Naval Attaché, London, via Navy
                    channels.</p>
            </note>
            <note corresp="#d76-f2" n="2" xml:id="d76-f2-content">
