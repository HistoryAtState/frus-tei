    <text>
        <body>
            <div xml:id="d53">

                <pb facs="0225" n="93" sameAs="frus:frus1945Berlinv01/pg93"/>

                <note rend="inline" type="source">
                    Leahy Papers: Telegram</note>
                <head>No. 53 <lb/>
                    <hi rendition="#italic">Prime Minister Churchill to President Truman
                    </hi><anchor n="1" xml:id="d53-f1"/>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1945-06-06">6 June 1945</date>.</dateline>
                </opener>
                <p>Prime Minister to President Truman,
                    personal and top secret, Number 75.</p>
                <p>Your Number 61.<anchor n="2" xml:id="d53-f2"/> I accept July 15 and am telling
                        Stalin.<anchor n="3" xml:id="d53-f3"
                    />
                </p>
                <p rendition="#center">. . . . . . .</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d53-f1" n="1" type="source" xml:id="d53-f1-content">
                <p>Sent by the United States Military Attaché, London, via Army channels.</p>
            </note>
            <note corresp="#d53-f2" n="2" xml:id="d53-f2-content">
                <p>
                    <ref target="#d51">document No. 51</ref>.</p>
            </note>
            <note corresp="#d53-f3" n="3" xml:id="d53-f3-content">
                <p>See <hi rendition="#italic">
                        Stalin’s Correspondence</hi>, vol.
                        <hi rendition="#small-caps">i</hi>, p. 363.</p>
            </note>
        </listAnnotation>
    </standOff>
