    <text>
        <body>
            <div xml:id="d123">

                <pb facs="0277" n="145" sameAs="frus:frus1945Berlinv01/pg145"/>

                <note rend="inline" type="source">740.0011 EW/6–2945: Telegram</note>
                <head>No. 123 <lb/>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in the United
                        Kingdom</hi> (<hi rendition="#italic">Winant</hi>)</head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-07-05T10:00:00-04:00">July 5, 1945—10
                            a.m.</date>
                    </dateline>
                </opener>
                <p>5446. You may inform the Foreign Office (<hi rendition="#italic">your 6566, June
                        29</hi><anchor n="l" xml:id="d123-f1"/>) that the State Department
                    Delegation to the Big Three meeting will <pb facs="0278" n="146" xml:id="pg146"
                    /> include Secretary Byrnes, Assistant Secretaries Dunn and Clayton, Ambassadors
                    Murphy and Harriman, H. F. Matthews, Director of the Office of European Affairs,
                    and several specialists on European and Far Eastern political and economic
                    matters.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Byrnes</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
