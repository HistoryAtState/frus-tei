    <text>
        <body>
            <div xml:id="d1098">

                <pb facs="1354" n="1340" sameAs="frus:frus1945v09/pg1340"/>

                <note rend="inline" type="source">811.20 Defense (M) Peru/9–1445: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Perw</hi> (<hi
                            rendition="#italic">Pawley</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Lima</hi></placeName>, <date
                            calendar="gregorian" when="1945-09-14">September 14,
                        1945</date>.<lb/>[Received 3:45 p.m.]</dateline>
                </opener>
                <p>951. Reurtel 871, 12th.<anchor n="72" xml:id="d1098-f1"/> Suggested note to
                    Peruvian Government was delivered personally by me on August 20 to Ministry for
                    Foreign <pb facs="1355" n="1341" xml:id="pg1341"/> Affairs which to date has not
                    acknowledged same. Since note simply gave notice it is possible no reply will be
                    received.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Pawley</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1098-f1" n="72" xml:id="d1098-f1-content">
                <p>Not printed; it referred to draft note enclosed with instruction 25, August 7,
                        <hi rendition="#italic">supra</hi>.</p>
            </note>
        </listAnnotation>
    </standOff>
