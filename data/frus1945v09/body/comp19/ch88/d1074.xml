    <text>
        <body>
            <div xml:id="d1074">

                <pb facs="1331" n="1317" xml:id="pg1317"/>

                <note rend="inline" type="source">740.0011 EW/2–1245</note>
                <head>
                    <hi rendition="#italic">The Peruvian Embassy to the Department of State </hi>
                </head>
                <p rendition="#center">
                    <hi rendition="#small-caps">Memorandum</hi>
                </p>
                <p>In compliance with the request made in the Memorandum of the Department of State,
                    dated February 12th, 1945,<anchor n="20" xml:id="d1074-f1"/> the Peruvian
                    Embassy considers that the terms “state of effective belligerency” are
                    equivalent to the expression “at war” as contained in the Declaration by the
                    United Nations.</p>
                <closer>
                    <dateline rendition="#float-left">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1945-02-12">February 12,
                            1945</date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
