                <pb facs="1234" n="1220" sameAs="frus:frus1945v09/pg1220"/>

                <note rend="inline" type="source">817.001 Somoza, Anastacio/2945: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Nicaragua</hi> (<hi rendition="#italic"
                            >Warren</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-10-29">October 29,
                        1945</date>.</dateline>
                </opener>
                <p>408. Dept understands President Somoza’s natural desire to see his son graduate
                    West Point and assumes that his visit for that purpose would be unofficial since
                    no invitation has been issued by this Govt. Dept would consider an extended
                    visit inconvenient.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Byrnes</hi>
                    </signed>
                </closer>
            </div>
        </body>
