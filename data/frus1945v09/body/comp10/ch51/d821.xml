    <text>
        <body>
            <div xml:id="d821">

                <pb facs="1020" n="1006" sameAs="frus:frus1945v09/pg1006"/>

                <note rend="inline" type="source">740.0011 E.W/2–745: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Ecuador</hi> (<hi rendition="#italic">Scotten</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Quito</hi></placeName>, <date
                            calendar="gregorian" when="1945-02-07T11:00:00-05:00">February 7,
                            1945—11 a.m.</date>
                        <lb/> [Received 3:59 p.m.]</dateline>
                </opener>
                <p>109. Reference Department’s 102, February 5, 7 p.m.<anchor n="17"
                        xml:id="d821-f1"/> The Minister for Foreign Affairs informs me the Ecuadoran
                    Ambassador in Washington is being instructed to sign the United Nations
                    Declaration on February 14.<anchor n="18" xml:id="d821-f2"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Scotten</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d821-f1" n="17" xml:id="d821-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d821-f2" n="18" xml:id="d821-f2-content">
                <p>For an account of the ceremony of adherence to the United Nations Declaration an
                    February 14, 1945, see Department of State <hi rendition="#italic"
                    >Bulletin</hi>, February 18, 1945, pp. 231–237.</p>
            </note>
        </listAnnotation>
