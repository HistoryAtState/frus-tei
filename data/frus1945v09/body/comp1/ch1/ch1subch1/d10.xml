            </note>
            <note corresp="#d10-f3" n="12" xml:id="d10-f3-content">
                <p>Maj. Gualberto Villarroel.</p>
            </note>
            <note corresp="#d10-f4" n="13" xml:id="d10-f4-content">
                <p>Victor Andrade, Bolivian Ambassador in the United States.</p>
            </note>
            <note corresp="#d10-f5" n="14" xml:id="d10-f5-content">
                <p>Carlos Montenegro, Bolivian Ambassador in Mexico.</p>
            </note>
        </listAnnotation>
