            </note>
            <note corresp="#d173-f2" n="20" xml:id="d173-f2-content">
                <p>“Act to Promote the Defense of the United States” approved March 11, 1941; 55
                    Stat. 31.</p>
            </note>
        </listAnnotation>
    </standOff>
