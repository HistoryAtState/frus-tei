    <text>
        <body>
            <div xml:id="d1189">

                <pb facs="1434" n="1420" xml:id="pg1420"/>

                <note rend="inline" type="source">740.0011 EW/1–2345: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        Venezuela</hi> (<hi rendition="#italic">Corrigan</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-01-29T13:00:00-04:00">January 29, 1945—1
                            p.m.</date>
                    </dateline>
                </opener>
                <p>64. Reurtel 52, January 23. Please find an early opportunity to tell the Foreign
                    Minister that April may well be too late. Invitations will have to go out some
                    six weeks before conference<anchor n="38" xml:id="d1189-f1"/> convenes.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Grew</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1189-f1" n="38" xml:id="d1189-f1-content">
                <p>United Nations Conference on International Organization at San Francisco.</p>
            </note>
        </listAnnotation>
    </standOff>
