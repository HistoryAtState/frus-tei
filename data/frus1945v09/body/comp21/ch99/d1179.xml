    <text>
        <body>
            <div xml:id="d1179">

                <pb facs="1429" n="1415" sameAs="frus:frus1945v09/pg1415"/>

                <note rend="inline" type="source">831.01/10–2945: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Chargé in Argentina</hi> (<hi rendition="#italic"
                            >Cabot</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-10-29T13:00:00-05:00">October 29, 1945—1
                            p.m.</date>
                    </dateline>
                </opener>
                <p>1519. Argentine Chargé<anchor n="29" xml:id="d1179-f1"/> informed Braden<anchor
                        n="30" xml:id="d1179-f2"/> he had instructions to ascertain US attitude re
                    recognition of new Venezuelan regime since his Govt desired to follow same
                    course. Braden stated Dept was favorably disposed to accord recognition after
                    consultation with other American republics.</p>
                <pb facs="1430" n="1416" xml:id="pg1416"/>
                <p>In view of this consultation please inform FonMin immediately of substance of
                    first paragraph of Depts cirtel Oct 27, 8 a.m.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Byrnes</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1179-f1" n="29" xml:id="d1179-f1-content">
                <p>Luis S. Luti.</p>
            </note>
            <note corresp="#d1179-f2" n="30" xml:id="d1179-f2-content">
                <p>Spruille Braden, Assistant Secretary of State.</p>
            </note>
