    <text>
        <body>
            <div xml:id="d1176">

                <pb facs="1428" n="1414" xml:id="pg1414"/>

                <note rend="inline" type="source">831.01/10–2745: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Venezuela</hi> (<hi rendition="#italic"
                            >Corrigan</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-10-27T17:00:00-05:00">October 27, 1945—5
                            p.m.</date>
                    </dateline>
                </opener>
                <p>697. You are requested to address a note to the new Venezuelan FonMin for
                    presentation Tues, Oct 30 extending recognition of the new govt.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Byrnes</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
