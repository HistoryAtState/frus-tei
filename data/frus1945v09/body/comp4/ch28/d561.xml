    <text>
        <body>
            <div xml:id="d561">

                <pb facs="0726" n="712" sameAs="frus:frus1945v09/pg712"/>

                <note rend="inline" type="source">832.6176/11–1645: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Brazil</hi> (<hi
                            rendition="#italic">Berle</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Rio de Janeiro</hi></placeName>, <date
                            calendar="gregorian" when="1945-11-16T18:00:00-03:00">November 16,
                            1945—6 p.m.</date>
                        <lb/> [Received 11:29 p.m.]</dateline>
                </opener>
                <p>3437. Notes were exchanged November 14 between Embassy and FonOff terminating
                    tire and tube agreement and looking towards liquidation of other agreements in
                    conformity with arrangement <pb facs="0727" n="713" xml:id="pg713"/> reached
                    between RDC and Bouças. Copies of notes are going forward by pouch.<anchor
                        n="95" xml:id="d561-f1"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Berle</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
