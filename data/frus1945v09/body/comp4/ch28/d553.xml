    <text>
        <body>
            <div xml:id="d553">

                <pb facs="0721" n="707" sameAs="frus:frus1945v09/pg707"/>

                <note rend="inline" type="source">832.6176/8–1445: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Brazil</hi> (<hi rendition="#italic"
                            >Berle</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-08-14T15:00:00-04:00">August 14, 1945—3
                            p.m.</date>
                    </dateline>
                </opener>
                <p>1996. McLaughlin from Utz. Reourtel April 19, 1945.<anchor n="86"
                        xml:id="d553-f1"/> For obvious reasons,<anchor n="87" xml:id="d553-f2"/> you
                    are hereby instructed to inform appropriate Brazilian governmental authorities,
                    through the Embassy, that the offer heretofore made on behalf of Rubber
                    Development Corporation to extend <pb facs="0722" n="708" xml:id="pg708"/>
                    rubber agreement, price premium agreement, and other collateral agreements to
                    June 30, 1947, is withdrawn, effective immediately. [Utz.]</p>
                <p>For Emb from Dept. Dept concurs in foregoing. Emb is requested to assist RDC in
                    withdrawing offer to extend rubber agreements.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Byrnes</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d553-f1" n="86" xml:id="d553-f1-content">
                <p>Telegram 1000, <ref target="#pg704">p. 704</ref>.</p>
            </note>
            <note corresp="#d553-f2" n="87" xml:id="d553-f2-content">
                <p>Reference is presumably to fact that Japan had accepted surrender terms on August
                    14, thus terminating hostilities of World War II.</p>
            </note>
        </listAnnotation>
    </standOff>
