    <text>
        <body>
            <div xml:id="d502">

                <pb facs="0662" n="648" sameAs="frus:frus1945v09/pg648"/>

                <note rend="inline" type="source">832.24/11–545: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Brazil</hi> (<hi rendition="#italic"
                            >Berle</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-11-16">November 16,
                        1945</date>.</dateline>
                </opener>
                <p>2628. Reurtel 3348, Nov. 5.<anchor n="82" xml:id="d502-f1"/> Ahlers and
                        Kidd<anchor n="83" xml:id="d502-f2"/> are to report directly to Foreign
                    Liquidation Commissioner in Washington using same communications facilities as
                    Embassy in absence of War Dept. facilities. They are to look to Foreign
                    Liquidation Commissioner in Washington for directions with respect to their
                    function, but in all political matters will be guided by Embassy.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Byrnes</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d502-f1" n="82" xml:id="d502-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d502-f2" n="83" xml:id="d502-f2-content">
                <p>J. D. Ahlers and Philip C. Kidd, officials of the Office of the Foreign
                    Liquidation Commissioner.</p>
            </note>
        </listAnnotation>
    </standOff>
