    <text>
        <body>
            <div xml:id="d1063">

                <pb facs="1323" n="1309" xml:id="pg1309"/>

                <note rend="inline" type="source">834.51/9–1345: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        Paraguay</hi> (<hi rendition="#italic">Beaulac</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-09-13T19:00:00-04:00">September 13,
                            1945—7 p.m.</date>
                    </dateline>
                </opener>
                <p>302. Dept informed by Exim Bank that on Sept 10 Paraguay paid $37,850. The
                    account is now fully paid to Aug 31 with the exception of approximately $1700
                    representing interest on past due principal.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
