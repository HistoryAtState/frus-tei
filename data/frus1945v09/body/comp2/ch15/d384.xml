    <text>
        <body>
            <div xml:id="d384">

                <pb facs="0537" n="523" sameAs="frus:frus1945v09/pg523"/>

                <note rend="inline" type="source">835.918/10–2445: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in Argentina</hi> (<hi
                            rendition="#italic">Cabot</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Buenos Aires</hi></placeName>, <date
                            calendar="gregorian" when="1945-10-24">October 24,
                        1945</date>.<lb/>[Received 2:52 p.m.]</dateline>
                </opener>
                <p>2639. Yesterday <hi rendition="#italic">Time</hi> Magazine and <hi
                        rendition="#italic">La Vanguardia</hi> refused by Post Office. I complained
                    about former to Foreign Office.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Cabot</hi>
                    </signed>
                </closer>
            </div>
        </body>
