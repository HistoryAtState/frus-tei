    <text>
        <body>
            <div xml:id="d285">

                <pb facs="0426" n="412" sameAs="frus:frus1945v09/pg412"/>

                <note rend="inline" type="source">835.00/9–1545: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Ambassador in Argentina</hi> (<hi
                            rendition="#italic">Braden</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-09-19T20:00:00-04:00">September 19,
                            1945—8 p.m.</date>
                    </dateline>
                </opener>
                <p>1302. Following from Secretary in London: <quote rend="blockquote">
                        <p>“Delsec 30, Sept 18.<anchor n="23" xml:id="d285-f1"/> Advise Braden
                            Council instructed by heads of govts to consider certain matters
                            mentioned in protocol.<anchor n="24" xml:id="d285-f2"/> Argentine
                            problems not being included, will not be considered by council. I do
                            expect to discuss general subject with Bevin.”<anchor n="25"
                                xml:id="d285-f3"/>
                        </p>
                    </quote>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d285-f1" n="23" xml:id="d285-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d285-f2" n="24" xml:id="d285-f2-content">
                <p>For text, see <ref target="frus1945Berlinv02#pg_1477">
                        <hi rendition="#italic">Foreign Relations</hi>, The Conference of Berlin
                        (The Potsdam Conference), 1945, vol. <hi rendition="#small-caps">ii</hi>,
                        pp. 1477</ref> ff.</p>
            </note>
            <note corresp="#d285-f3" n="25" xml:id="d285-f3-content">
                <p>Ernest Bevin, British Secretary of State for Foreign Affairs.</p>
            </note>
        </listAnnotation>
    </standOff>
