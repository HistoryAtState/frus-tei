    <text>
        <body>
            <div xml:id="d405">

                <pb facs="0556" n="542" sameAs="frus:frus1945v09/pg542"/>

                <note rend="inline" type="source">811.20 Defense (M) Argentina/6–2145:
                    Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Argentina</hi> (<hi
                        rendition="#italic">Braden</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Buenos Aires</hi></placeName>, <date
                            calendar="gregorian" when="1945-06-21T20:00:00-03:00">June 21, 1945—8
                            p.m.</date>
                        <lb/> [Received 9:15 p.m.]</dateline>
                </opener>
                <p>1311. Ref Rio tel. June 21, 1 p.m.<anchor n="76" xml:id="d405-f1"/> Entire fats
                    and oil deal was clarified by recent public statement of Acting Secretary<anchor
                        n="77" xml:id="d405-f2"/> and as a matter of fact insufficient Argentine
                    tanker tonnage must be supplemented by us to carry out our part of the agreement
                    to supply fuel oil enabling Argentina to release vegetable oils urgently needed
                    by United Nations.</p>
                <p>Repeated to Rio.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Braden</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d405-f1" n="76" xml:id="d405-f1-content">
                <p>No. 1977, not printed.</p>
            </note>
            <note corresp="#d405-f2" n="77" xml:id="d405-f2-content">
                <p>Released to the press on June 15; for text, see Department of State <hi
                        rendition="#italic">Bulletin</hi> June 17, 1945, p. 1116.</p>
            </note>
        </listAnnotation>
