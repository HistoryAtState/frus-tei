    <text>
        <body>
            <div xml:id="d165-a1">

                <pb facs="0373" n="337" xml:id="pg337"/>

                <head>Enclosure</head>
                <list>
                    <label>a)</label>
                    <item>Immediate recognition of the right of the peoples of the territories under
                        its domination to self-determination and independence;</item>
                    <label>b)</label>
                    <item>Immediate cessation of all acts of repression and withdrawal of all the
                        military and other forces at present employed for the purpose;</item>
                    <label>c)</label>
                    <item>Promulgation of an unconditional political amnesty and establishment of
                        conditions which will permit the free functioning of political
                        parties;</item>
                    <label>d)</label>
                    <item>Negotiations on the basis of recognition of the right to
                        self-determination through the authentic representatives of the nationalist
                        fighting forces of the territories, in order to transfer power to freely
                        elected political institutions representative of the people of the
                        territories.</item>
                </list>
            </div>
        </body>
    </text>
