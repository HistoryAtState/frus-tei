            <div xml:id="errata">

                <pb facs="0802" n="766" xml:id="pg766"/>

                <head>Errata</head>
                <p>The following change has been made to <ref target="frus:frus1964-68v12">
                        <hi rendition="#italic">Foreign Relations</hi>, 1964–1968, Volume XII</ref>,
                    Western Europe. Please be aware that printed volumes have not been revised.
                    <!--Revised information is in italic.-->
                </p>
                <list type="simple">
                    <item>
                        <hi rendition="#bold">1. <ref target="#d215">Document 215</ref>, <ref
                                target="#pg426">Page 426</ref> (date of correction: January 21,
                            2022)</hi>
                    </item>
                    <item>The title for Paul Nitze in the heading of <ref target="#d215">Document
                            215</ref> has been corrected to “Deputy Secretary of Defense”.</item>
                </list>
            </div>
        </body>
    </text>
