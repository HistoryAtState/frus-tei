    <text>
        <body>
            <div xml:id="d76-a1">

                <pb facs="0216" n="158" sameAs="frus:frus1866p3/pg158"/>

                <opener><seg rendition="#center">No. 1.</seg></opener>
                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">War Department</hi>, <hi
                                rendition="#italic">Washington City</hi>,</placeName>
                        <date calendar="gregorian" when="1866-05-30"><hi rendition="#italic"
                                >May</hi> 30, 1866.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I am directed by the Secretary of War to
                    herewith transmit, agreeably to the request made in your communication of the
                    18th ultimo, a copy of the report of General Weitzel with reference to the
                    sequestration at Clarksville, Texas, of certain goods claimed by the Mexican
                    liberal government by the right of seizure, and confiscation.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>THOS. T. ECKERT, <hi rendition="#italic">Acting Assistant Secretary of
                            War.</hi></signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State</hi></p>
                </postscript>
            </div>
        </body>
    </text>
