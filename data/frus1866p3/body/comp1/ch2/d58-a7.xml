    <text>
        <body>
            <div xml:id="d58-a7">

                <pb facs="0196" n="138" xml:id="pg138"/>

                <opener><seg rendition="#center">No. 7.</seg></opener>
                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <p><hi rendition="#italic">To the military commander of Bagdad and its
                        dependencies:</hi></p>
                <p>Please let me know if you authorized any one to take private property in my
                    name.</p>
                <closer><dateline rendition="#float-left">Independence and liberty!
                            <placeName>Bagdad</placeName>, <date calendar="gregorian"
                            when="1866-01-16">January 16, 1866</date>.</dateline>
                    <lb/>
                    <signed>ENRIQUE A. MEJIA.</signed></closer>
                <postscript>
                    <p>Lieut. Col. <hi rendition="#small-caps">Eduardo Du May.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
