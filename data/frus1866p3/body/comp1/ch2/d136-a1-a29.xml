    <text>
        <body>
            <div xml:id="d136-a1-a29">

                <pb facs="0480" n="422" xml:id="pg422"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Parras</hi>,</placeName>
                        <date calendar="gregorian" when="1866-08-05"><hi rendition="#italic"
                                >August</hi> 5, 1866.</date></dateline></opener>
                <p>To Don <hi rendition="#small-caps">Julian Quiroga</hi>:</p>
                <p>Your commissioner, Don Ignacio Soto, has conferred with me on the subject of your
                    proposals to join me, under certain conditions, and I must say it is not in my
                    power to accept your offers.</p>
                <p rendition="#right">A. S. VIEZCA.</p>
                <p rendition="#right"><hi rendition="#small-caps">Parras, August</hi> 8, 1866.</p>
                <p>True copies:</p>
                <closer>
                    <signed>E. VIEZCA, <hi rendition="#italic">Chief Officer</hi>.</signed></closer>
            </div>
        </body>
    </text>
