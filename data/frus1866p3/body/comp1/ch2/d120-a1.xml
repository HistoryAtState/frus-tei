    <text>
        <body>
            <div xml:id="d120-a1">

                <pb facs="0366" n="308" sameAs="frus:frus1866p3/pg308"/>

                <opener><seg rendition="#center">No. 1.</seg></opener>
                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">War Department</hi>, <hi
                                rendition="#italic">Washington City</hi></placeName>, <date
                            calendar="gregorian" when="1866-09-14"><hi rendition="#italic"
                                >September</hi> 14, 1866.</date></dateline></opener>
                <p>S<hi rendition="#small-caps">ir:</hi> I have the honor to transmit herewith a
                    communication of August 24, 1866, to Major General Sheridan, commanding the
                    department of the Gulf, from John B. Gauche, a citizen of the United States,
                    complaining that he has been compelled to subscribe to the imperial forced loan
                    in Matamoras, Mexico, and applying for redress.</p>
                <p>You will please indicate to this department any action which you think proper to
                    be taken by the military authorities.</p>
                <p>I am, sir, very respectfully, your obedient servant,</p>
                <closer>
                    <signed>EDWIN M. STANTON, <hi rendition="#italic">Secretary of
                        War</hi>.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State</hi>.</p>
                </postscript>
            </div>
        </body>
    </text>
