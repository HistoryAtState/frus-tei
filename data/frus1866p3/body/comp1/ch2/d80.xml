    <text>
        <body>
            <div xml:id="d80">

                <pb facs="0228" n="170" sameAs="frus:frus1866p3/pg170"/>

                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <head>Señor Romero to Mr. Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1866-06-14"><hi rendition="#italic"
                                >June</hi> 14, 1866.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Dear Sir:</hi> I have the honor to transmit to you
                    the copy of a letter I received yesterday from a reliable person in Bordeaux,
                    dated the 31st of May last, giving me some important information relative to the
                    intentions and plans of the French government in regard to Mexico. You are a
                    better judge than I am of the importance to be attached to the information I
                    deem it my duty to communicate to your department.</p>
                <p>I am, sir, very respectfully, your most obedient servant,</p>
                <closer>
                    <signed>M. ROMERO.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d80-a1.xml" xpointer="d80-a1"/>
            </div>
