    <text>
        <body>
            <div xml:id="d92">

                <pb facs="0250" n="192" sameAs="frus:frus1866p3/pg192"/>

                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <head>Señor Romero to Mr. Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1866-07-31"><hi rendition="#italic"
                                >July</hi> 31, 1866.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Dear Sir:</hi> I have the honor to send you a
                    number of the Temps, of Paris, published the 17th of this month, in which you
                    will find a paragraph taken from the Memorial de la Loire, of the 14th, stating
                    that a new detachment of the so-called Foreign Legion, of Mexico, passed through
                    that city on the 13th, from Aix, going to embark at St. Nazaire for Vera
                    Cruz.</p>
                <p>Most respectfully, your very obedient servant,</p>
                <closer>
                    <signed>M. ROMERO.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d92-a1.xml" xpointer="d92-a1"/>
            </div>
        </body>
    </text>
