    <text>
        <body>
            <div xml:id="d107">

                <pb facs="0314" n="256" xml:id="pg256"/>

                <opener><seg rendition="#center">[Unofficial.]</seg></opener>
                <head>Mr. Frederick W. Seward to Señor Romero</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1866-09-21"><hi rendition="#italic"
                                >September</hi> 21, 1866.</date></dateline></opener>
                <p><hi rendition="#small-caps">Dear Sir:</hi> I have received your unofficial note
                    of yesterday, and thank you for your offer to write home for correct information
                    upon the subject to which it relates. That information would be very acceptable
                    to this department.</p>
                <p>I am, dear sir, very truly yours,</p>
                <closer>
                    <signed>F. W. SEWARD, <hi rendition="#italic">Acting
                    Secretary.</hi></signed></closer>
                <postscript>
                    <p>Señor Don M. <hi rendition="#small-caps">Romero</hi>, <hi rendition="#italic"
                            >&amp;c., &amp;c., &amp;c</hi>.</p>
                </postscript>
            </div>
        </body>
    </text>
