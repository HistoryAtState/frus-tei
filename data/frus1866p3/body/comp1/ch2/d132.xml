    <text>
        <body>
            <div xml:id="d132">

                <pb facs="0450" n="392" sameAs="frus:frus1866p3/pg392"/>

                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <head>Señor Romero to Mr.
                        Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1866-11-20"><hi rendition="#italic"
                                >November</hi> 20, 1866.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Dear Sir</hi>: I have the honor to send to you for
                    your information copy of a letter which I received to-day from Vera Cruz, dated
                    1st of this month, and written by a trustworthy person, containing various
                    important notices of the causes which have hindered the embarcation of
                    Maximilian at that port.</p>
                <p>I am, sir, very respectfully, your obedient servant,</p>
                <closer>
                    <signed>M. ROMERO.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">&amp;c., &amp; c., &amp; c</hi>.</p>
                </postscript>


                <xi:include href="d132-a1.xml" xpointer="d132-a1"/>
            </div>
