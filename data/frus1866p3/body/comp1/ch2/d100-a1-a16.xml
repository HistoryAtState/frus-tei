            <div xml:id="d100-a1-a16">

                <pb facs="0304" n="246" sameAs="frus:frus1866p3/pg246"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <p rendition="#center">MAXIMILIAN, EMPEROR OF MEXICO.</p>
                <p>In order to save expenses to the public treasury, we have been pleased to direct
                    that the department of fomento be temporarily annexed to that of
                    gobernacion.</p>
                <p>Our minister of the interior is charged with the execution of this decree.</p>
                <closer><dateline rendition="#float-left">Given in <placeName>Mexico</placeName>
                        <date calendar="gregorian" when="1866-07-26">the 26th July,
                        1866</date>.</dateline>
                    <lb/>
                    <signed>MAXIMILIAN.</signed></closer>
                <postscript>
                    <p>By the emperor.</p>
                    <p><hi rendition="#small-caps">José Salazar Ilarregui, <hi rendition="#italic"
                                >Minister of Government.</hi></hi></p>
                </postscript>
            </div>
        </body>
    </text>
