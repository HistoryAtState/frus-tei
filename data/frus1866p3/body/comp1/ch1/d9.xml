    <text>
        <body>
            <div xml:id="d9">

                <pb facs="0066" n="8" xml:id="pg8"/>

                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <head>Mr. Campbell to the President</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">United States Military Telegraph, War
                                Department. Hamilton, Ohio,</hi></placeName>
                        <date calendar="gregorian" when="1866-11-05"><hi rendition="#italic"
                                >November</hi> 5, 1866.</date></dateline></opener>
                <p><hi rendition="#italic">To the President of the United States and Secretary of
                        State:</hi></p>
                <p>I shall start for New York with General Sherman, unless directed to go by
                    Washington to-day.</p>
                <closer>
                    <signed>LEWIS D. CAMPBELL.</signed></closer>
            </div>
        </body>
    </text>
