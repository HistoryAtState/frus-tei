                <pb facs="0556" n="498" sameAs="frus:frus1866p3/pg498"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Government of the Province</hi>, <hi
                                rendition="#italic">Baranquilla</hi></placeName>, <date
                            calendar="gregorian" when="1865-12-14"><hi rendition="#italic"
                                >December</hi> 14, 1865.</date></dateline></opener>
                <p>I hereby certify that the signatures which appear in this document, which say
                    Eulalio Luna, Manuel M. Lascano, are, the former of the provincial judge, and
                    latter of his secretary, and the same as they are accustomed to use in all their
                    official acts.</p>
                <closer>
                    <signed>JUAN DE LA C. RUIZ.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Gregorio</hi> J. <hi rendition="#small-caps"
                            >Aragon, Secretary</hi>,</p>
                </postscript>
            </div>
        </body>
