                <pb facs="0635" n="577" sameAs="frus:frus1866p3/pg577"/>

                <opener><seg rendition="#center">C 1.</seg></opener>
                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Bogota</hi>,</placeName>
                        <date calendar="gregorian" when="1866-09-10"><hi rendition="#italic"
                                >September</hi> 10, 1866.</date></dateline></opener>
                <p>The minister resident of the United States has the honor to present his
                    respectful compliments to his excellency Señor José M. Rojas Garrido, secretary
                    of the interior and foreign relations of the Colombian Union, and will thank his
                    excellency for a conference concerning matters treated of in his communication
                    of the third instant, at such time as may be convenient.</p>
                <closer>
                    <signed>A. A. BURTON.</signed></closer>
            </div>
        </body>
