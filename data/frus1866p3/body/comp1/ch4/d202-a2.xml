    <text>
        <body>
            <div xml:id="d202-a2">

                <pb facs="0630" n="572" sameAs="frus:frus1866p3/pg572"/>

                <opener><seg rendition="#center">B.</seg></opener>
                <head>Mr. Burton to Mr. Little</head>
                <opener>
                    <seg rendition="#float-left">No. 7.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">Bogota</hi></placeName>, <date
                            calendar="gregorian" when="1866-09-04"><hi rendition="#italic"
                                >September</hi> 4, 1866.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I enclose for your information the
                    accompanying communication addressed me by his excellency the secretary of the
                    interior and foreign relations of Colombia, in relation to an apprehended
                    uprising on the isthmus against the national authority, and delivered this
                    morning at 11 o’clock.</p>
                <p>I am, sir, very respectfully, your obedient servant,</p>
                <closer>
                    <signed>ALLAN A. BURTON.</signed></closer>
                <postscript>
                    <p>W. B. <hi rendition="#small-caps">Little</hi>, Esq., <hi rendition="#italic"
                            >United States Consul, Panama</hi>.</p>
                </postscript>
            </div>
        </body>
