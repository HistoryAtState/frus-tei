                <pb facs="0765" n="720" sameAs="frus:frus1981-88v38/pg720"/>

                <head>290. Minutes of a Senior Interdepartmental Group–International Economic Policy
                        Meeting<anchor n="1" xml:id="d290-f1"/></head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            when="1983-02-03T15:00:00">February 3, 1983, 3 p.m.</date>
                    </dateline>
                </opener>
                <list subtype="participants" type="description">
                    <label>ATTENDEES</label>
                    <item><list>
                            <label>Treasury</label>
                            <item>Secretary Regan</item>
                            <item>Marc E. Leland</item>
                        </list></item>
                    <item><list>
                            <label>State</label>
                            <item>W. Allen Wallis</item>
                            <item>Richard McCormack</item>
                        </list></item>
                    <item><list>
                            <label>Defense</label>
                            <item>Fred C. Ikle</item>
                        </list></item>
                    <item><list>
                            <label>Agriculture</label>
                            <item>Seeley G. Lodwick</item>
                            <item>Alan Tracy</item>
                        </list></item>
                    <item><list>
                            <label>Commerce</label>
                            <item>Secretary Baldrige</item>
                            <item>Lionel H. Olmer</item>
                        </list></item>
                    <item><list>
