        <listAnnotation>
            <note corresp="#d362-f1" n="1" type="source" xml:id="d362-f1-content">
                <p>Source: Reagan Library, George Shultz Papers, Official Personal Notes of
                    Secretary Shultz (04/01/1986 – 05/27/1986); NLR–775–23–64–3–3. No classification
