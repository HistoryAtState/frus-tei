                <pb facs="0778" n="733" sameAs="frus:frus1981-88v38/pg733"/>

                <head>295. Minutes of a Senior Interdepartmental Group–International Economic Policy
                        Meeting<anchor n="1" xml:id="d295-f1"/></head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            when="1983-04-22T16:00:00+00:00">April 22, 1983, 4 p.m.</date>
                    </dateline>
                </opener>
