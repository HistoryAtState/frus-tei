                <pb facs="0337" n="292" xml:id="pg292"/>

                <head>112. Minutes of a Senior Interdepartmental Group–International Economic Policy
                        Meeting<anchor n="1" xml:id="d112-f1"/></head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            when="1983-05-13T15:00:00">May 13, 1983, 3 p.m.</date>
                    </dateline>
                </opener>
                <list subtype="participants" type="description">
                    <label>ATTENDEES: (U)</label>
                    <item><list>
                            <label>Treasury</label>
