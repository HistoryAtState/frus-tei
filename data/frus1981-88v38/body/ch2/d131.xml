                <head>131. Minutes of a Senior Interdepartmental Group–International Economic Policy
                        Meeting<anchor n="1" xml:id="d131-f1"/></head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            when="1983-03-10T10:30:00+00:00">March 10, 1983, 10:30 a.m.</date>
