                <head>129. Minutes of a Senior Interdepartmental Group–International Economic Policy
                        Meeting<anchor n="1" xml:id="d129-f1"/></head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            when="1983-02-22T15:00:00+00:00">February 22, 1983, 3 p.m.</date>
                    </dateline>
                </opener>
