                <pb facs="0441" n="396" sameAs="frus:frus1981-88v38/pg396"/>

                <head>154. Minutes of a Senior Interdepartmental Group–International Economic Policy
                        Meeting<anchor n="1" xml:id="d154-f1"/></head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            when="1983-12-14T14:00:00+00:00">December 14, 1983, 2 p.m.</date>
                    </dateline>
                </opener>
                <list subtype="participants" type="description">
                    <label>ATTENDEES</label>
                    <item><list>
                            <label>Treasury</label>
                            <item>Secretary Regan, Chairman</item>
                            <item>Beryl Sprinkel</item>
                            <item>Marc Leland</item>
                        </list></item>
                    <item><list>
