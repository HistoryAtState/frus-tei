                            <item>Martin Feldstein</item>
                            <item>Robert Thompson</item>
                        </list></item>
                    <item><list>
                            <label>Cabinet Affairs</label>
                            <item>Larry Herbolsheimer</item>
                        </list></item>
                    <item><list>
