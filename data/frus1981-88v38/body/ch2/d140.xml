                <head>140. Minutes of a Senior Interdepartmental Group–International Economic Policy
                        Meeting<anchor n="1" xml:id="d140-f1"/></head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            when="1983-04-28T16:30:00+00:00">April 28, 1983, 4:30 p.m.</date>
                    </dateline>
                </opener>
