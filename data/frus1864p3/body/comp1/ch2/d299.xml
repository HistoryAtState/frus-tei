    <text>
        <body>
            <div xml:id="d299">

                <pb facs="0268" n="248" xml:id="pg248"/>

                <head>Mr. Seward to Mr.
                        Geofroy</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-10-24"><hi rendition="#italic"
                                >October</hi> 24, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of the 17th instant, which relates to the proceedings of the
                    military authorities of the United States in the department of the Gulf, in
                    regard to the forces of Cortinas, and in reply to inform you that your comments
                    and suggestions on the subject will receive due attention.</p>
                <p>Accept, sir, a renewed assurance of my highest consideration.</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p>Mr. <hi rendition="#small-caps">L. de Geofroy,</hi>
                        <hi rendition="#italic">&amp;c., &amp;c., &amp;c</hi>.</p>
                </postscript>
            </div>
        </body>
    </text>
