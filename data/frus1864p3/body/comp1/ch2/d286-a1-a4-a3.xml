    <text>
        <body>
            <div xml:id="d286-a1-a4-a3">

                <pb facs="0256" n="236" sameAs="frus:frus1864p3/pg236"/>

                <head><hi rendition="#italic">Declaration of Substitute.</hi></head>
                <p>I, Emile Caulat, desiring to enlist in the army of the United States for three
                    years, do declare that I am twenty-five years and —— months of age; that I have
                    never been discharged from the United States service on account of disability or
                    by sentence of a court-martial, and I know of no impediment to my serving
                    honestly and faithfully as a soldier for three years.</p>
                <closer>
                    <dateline rendition="#float-left">Given at <placeName>West Lebanon</placeName>,
                            <date calendar="gregorian" when="1863-10-10">the 10th day of October,
                            1863</date>.</dateline>
                    <lb/>
                    <signed>EMILE CAULAT.</signed></closer>
                <postscript>
                    <p>Witness: <hi rendition="#small-caps">F. Conning.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
