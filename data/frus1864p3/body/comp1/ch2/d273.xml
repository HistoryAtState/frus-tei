    <text>
        <body>
            <div xml:id="d273">

                <pb facs="0240" n="220" sameAs="frus:frus1864p3/pg220"/>

                <head>Mr. Seward to Mr. Geofroy</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-06-08"><hi rendition="#italic"
                                >June</hi> 8, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to your communication of the
                    2d of March last, respecting the case of A. Cauvet, which was referred to the
                    Secretary of War for investigation, I have the honor to transmit for your
                    information a copy of a letter of the 28th ultimo from that officer relative to
                    the matter.</p>
                <p>Accept, sir, the renewed assurance of my high consideration.</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p>Mr. <hi rendition="#small-caps">L. de Geofroy,</hi>
                        <hi rendition="#italic">&amp;c., &amp;c. &amp;c.</hi></p>
                </postscript>


                <xi:include href="d273-a1.xml" xpointer="d273-a1"/>
