    <text>
        <body>
            <div xml:id="d280">

                <pb facs="0245" n="225" sameAs="frus:frus1864p3/pg225"/>

                <head>Mr. Seward to Mr.
                        Geofroy</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-07-14"><hi rendition="#italic"
                                >July</hi> 14, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your communication of the 8th instant, reporting contemplated shipments of
                    powder and arms from California to Mexico, and in reply to inform you that the
                    attention of the proper departments will be immediately called to the
                    matter.</p>
                <p>Accept, sir, a renewed assurance of my high consideration.</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p>Mr. <hi rendition="#small-caps">L. de Geofroy,</hi>
                        <hi rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
