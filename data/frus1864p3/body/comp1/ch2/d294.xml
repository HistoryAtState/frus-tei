    <text>
        <body>
            <div xml:id="d294">

                <pb facs="0263" n="243" xml:id="pg243"/>

                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <head>Mr. Geofroy to Mr.
                        Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of France to the United
                                States,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-10-02"><hi rendition="#italic"
                                >October</hi> 2, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to send to you the note,
                    in terms, upon which we agreed this morning, on the subject of Frenchmen who
                    emigrate from the southern States.</p>
                <p>I seize this occasion to offer to your excellency the fresh assurance of my high
                    consideration.</p>
                <closer>
                    <signed>L. DE GEOFROY.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d294-a1.xml" xpointer="d294-a1"/>
