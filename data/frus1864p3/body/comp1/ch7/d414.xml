    <text>
        <body>
            <div xml:id="d414">

                <pb facs="0401" n="381" sameAs="frus:frus1864p3/pg381"/>

                <head>Mr. Burlingame to Mr. Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 70.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">Peking,</hi></placeName>
                        <date calendar="gregorian" when="1864-05-21"><hi rendition="#italic"
                                >May</hi> 21, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to present the annexed
                    letter, (marked A,) from F. B. Forbes, esq., vice-consul in charge of the
                    consulate general of Sweden and Norway <pb facs="0402" n="382" xml:id="pg382"/>
                    at Shanghai, conveying to me the thanks of M. C. C. Manderström minister of
                    foreign affairs for Sweden and Norway, for assistance I was most happy to
                    tender.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>ANSON BURLINGAME.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State, &amp;c., &amp;c.,
                        &amp;c.</hi></p>
                </postscript>


                <xi:include href="d414-a1.xml" xpointer="d414-a1"/>
            </div>
