    <text>
        <body>
            <div xml:id="d418-a3-a3">

                <pb facs="0414" n="394" sameAs="frus:frus1864p3/pg394"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Shanghai,</hi></placeName>
                        <date calendar="gregorian" when="1864-03-01"><hi rendition="#italic"
                                >March</hi> 1, 1864.</date></dateline></opener>
                <p>I hereby certify that I have examined the corpse of D. Williams, who had been
                    sentenced to death, and pronounce that he committed suicide by cutting his
                    throat.</p>
                <closer>
                    <signed>W. G. HAY, <hi rendition="#italic">M. D</hi>.</signed></closer>
            </div>
        </body>
    </text>
