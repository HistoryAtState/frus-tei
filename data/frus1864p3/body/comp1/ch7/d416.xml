    <text>
        <body>
            <div xml:id="d416">

                <pb facs="0407" n="387" sameAs="frus:frus1864p3/pg387"/>

                <head>Mr. Burlingame to Mr.
                        Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 74.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">Peking,</hi></placeName>
                        <date calendar="gregorian" when="1864-05-26"><hi rendition="#italic"
                                >May</hi> 26, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith the
                    closing correspondence (marked A and B) in relation to the steamer Scotland.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>ANSON BURLINGAME.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State.</hi></p>
                </postscript>




