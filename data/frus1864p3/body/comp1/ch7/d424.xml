    <text>
        <body>
            <div xml:id="d424">

                <pb facs="0445" n="425" sameAs="frus:frus1864p3/pg425"/>

                <head>Mr. Seward to Mr.
                        Burlingame</head>
                <opener>
                    <seg rendition="#float-left">No. 60.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-06-04"><hi rendition="#italic"
                                >June</hi> 4, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    despatch of the 10th of March last, No. 64, and thank you for the interesting
                    letter from Mr. Walsh about Japan, which accompanied it.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Anson Burlingame,</hi> Esq.,<hi
                            rendition="#italic"> &amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
