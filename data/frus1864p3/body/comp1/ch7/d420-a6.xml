    <text>
        <body>
            <div xml:id="d420-a6">

                <pb facs="0435" n="415" xml:id="pg415"/>


                <head>Mr. G. F. Seward to Mr. Burlingame</head>
                <opener>
                    <seg rendition="#float-left">No. 17.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Shanghai,</hi></placeName>
                        <date calendar="gregorian" when="1864-02-13"><hi rendition="#italic"
                                >February</hi> 13, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit to you,
                    enclosed, the minutes of the consular court in the trial of John D. Buckley, for
                    the murder of John McKennon, together with the objections taken by the
                    prisoner’s counsel, and a memorandum of same by myself.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>GEORGE F. SEWARD.</signed></closer>
                <postscript>
                    <p>His Excellency Hon. <hi rendition="#small-caps">Anson Burlingame,</hi>
                        <hi rendition="#italic">&amp;c., &amp;., &amp;c., Peking.</hi></p>
                </postscript>
            </div>
        </body>
