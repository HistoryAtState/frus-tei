    <text>
        <body>
            <div xml:id="d445">

                <pb facs="0462" n="442" sameAs="frus:frus1864p3/pg442"/>

                <head>Mr. Seward to Mr. Burlingame</head>
                <opener>
                    <seg rendition="#float-left">No. 80.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1864-09-20"><hi rendition="#italic"
                                >September</hi> 20, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    despatch of the 26th of May last, No. 74, and the accompanying copy of the
                    correspondence with the Chinese government.</p>
                <p>Your course in regard to the subject of the correspondence is approved.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Anson Burlingame</hi>, Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
