    <text>
        <body>
            <div xml:id="d419-a4">

                <pb facs="0419" n="399" xml:id="pg399"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">United States
                            Consulate,</hi></placeName>
                        <date calendar="gregorian" when="1863-11-23"><hi rendition="#italic"
                                >November</hi> 23, 1863.</date></dateline></opener>
                <p>I hereby certify that the foregoing minutes on inquisition to inquire into the
                    death of one Samuel Webster, and of the trial of one James White, are true and
                    correct copies of the originals on file in this consulate.</p>
                <p>In witness whereof, I have hereunto set my hand and seal of this consulate on the
                    day and year last above mentioned.</p>
                <p>[<hi rendition="#small-caps">l. s</hi>]</p>
                <closer>
                    <signed>JOHN L. SEWARD, <hi rendition="#italic">Clerk of
                    Court.</hi></signed></closer>
            </div>
        </body>
