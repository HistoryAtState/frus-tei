                <pb facs="0439" n="419" sameAs="frus:frus1864p3/pg419"/>


                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Shanghai, China,</hi></placeName>
                        <date calendar="gregorian" when="1864-04-01"><hi rendition="#italic"
                                >April</hi> 1, 1864.</date></dateline></opener>
                <p>I hereby certify that I was present at the execution of “John Buckley,” examined
                    his body, and pronounced life extinct.</p>
                <closer>
                    <signed>W. G. HAY, <hi rendition="#italic">M. D</hi>.</signed></closer>
            </div>
