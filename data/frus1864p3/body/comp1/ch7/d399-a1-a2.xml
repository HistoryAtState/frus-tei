    <text>
        <body>
            <div xml:id="d399-a1-a2">

                <pb facs="0376" n="356" sameAs="frus:frus1864p3/pg356"/>

                <head>Mr. Perry to Mr.
                        Walsh</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Canton,</hi></placeName>
                        <date calendar="gregorian" when="1863-11-15"><hi rendition="#italic"
                                >November</hi> 15, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Walsh</hi>: The documents which you have
                    submitted to me, marked Nos. 1, 2, and 3, and herewith attached, I find to be
                    correct copies of the originals on my files.</p>
                <p>Yours truly,</p>
                <closer>
                    <signed>OLIVER H. PERRY.</signed></closer>




