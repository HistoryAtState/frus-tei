    <text>
        <body>
            <div xml:id="d401">

                <pb facs="0388" n="368" sameAs="frus:frus1864p3/pg368"/>

                <head>Mr. Burlingame to Mr.
                        Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 62.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">Peking,</hi></placeName>
                        <date calendar="gregorian" when="1864-01-05"><hi rendition="#italic"
                                >January</hi> 5, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inform you that I have
                    been so fortunate as to secure the recognition, by the Chinese government, of
                    the rights of Sweden under a treaty negotiated at Canton in 1847, and to forward
                    the kind letter of Mr. Cunningham, marked A, acknowledging that service.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>ANSON BURLINGAME.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State, &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d401-a1.xml" xpointer="d401-a1"/>
            </div>
