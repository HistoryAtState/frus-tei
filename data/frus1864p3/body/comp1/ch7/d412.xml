    <text>
        <body>
            <div xml:id="d412">

                <pb facs="0399" n="379" sameAs="frus:frus1864p3/pg379"/>

                <head>Mr. Seward to Mr. Burlingame</head>
                <opener>
                    <seg rendition="#float-left">No. 58.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-04-25"><hi rendition="#italic"
                                >April</hi> 25, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge, with much
                    gratification, your interesting despatch of the 4th of January, No. 61, which
                    gives the important results of Mr. Pumpelly’s examination of the coal districts
                    of Si-Sham.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Anson Burlingame,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
