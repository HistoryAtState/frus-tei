        <body>
            <div xml:id="d420-a3">

                <pb facs="0422" n="402" sameAs="frus:frus1864p3/pg402"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Court of the United States Consulate
                                General,</hi>
                            <hi rendition="#italic">Shanghai,</hi></placeName>
                        <date calendar="gregorian" when="1864-01-25"><hi rendition="#italic"
                                >January</hi> 25, 1864.</date></dateline></opener>
                <p>John D. Buckley stands committed for trial on the first day of February next, for
                    the crime of murder, as more particularly set forth in the attached report of
                    inquisition.</p>
                <closer>
                    <signed>GEORGE F. SEWARD, <hi rendition="#italic">Consul General, acting
                            judicially.</hi></signed></closer>
            </div>
        </body>
