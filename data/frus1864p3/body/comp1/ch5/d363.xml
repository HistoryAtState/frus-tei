    <text>
        <body>
            <div xml:id="d363">

                <pb facs="0336" n="316" sameAs="frus:frus1864p3/pg316"/>

                <head>Mr. Seward to Mr. Pike</head>
                <opener>
                    <seg rendition="#float-left">No. 156.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-05-20"><hi rendition="#italic"
                                >May</hi> 20, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your despatch of the 4th instant, No. 131,
                    has been received. The information therein contained in regard to the internal
                    affairs of the Netherlands is highly appreciated.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">James S. Pike,</hi> Esq., <hi rendition="#italic"
                            >&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
