    <text>
        <body>
            <div xml:id="d361">

                <pb facs="0335" n="315" xml:id="pg315"/>

                <head>Mr. Pike to Mr.
                        Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 132.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">United States Legation,</hi>
                            <hi rendition="#italic">The Hague,</hi></placeName>
                        <date calendar="gregorian" when="1864-05-11"><hi rendition="#italic"
                                >May</hi> 11, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: The United States government steamer
                    Kearsarge has made her appearance at Flushing, in the island of Walcheren, with
                    the object of making some repairs.</p>
                <p>At the instance of the commander, Captain Winslow, I have procured liberty from
                    the minister of marine for the ship to enter the government dock at that port
                    for this purpose.</p>
                <p>I have the honor to be, with great respect, your most obedient servant,</p>
                <closer>
                    <signed>JAMES S. PIKE,</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State, Washington.</hi></p>
                </postscript>
            </div>
        </body>
