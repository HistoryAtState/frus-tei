    <text>
        <body>
            <div xml:id="d380">

                <pb facs="0344" n="324" xml:id="pg324"/>

                <head>Mr. Pike to Mr. Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 150.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">United States Legation,</hi>
                            <hi rendition="#italic">The Hague,</hi></placeName>
                        <date calendar="gregorian" when="1864-09-28"><hi rendition="#italic"
                                >September</hi> 28, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to enclose you a copy of
                    the King’s speech, delivered on the opening of the legislative chambers here, on
                    the 19th instant, of which the following is a translation.</p>
                <p>I have the honor to be, with great respect, your most obedient servant,</p>
                <closer>
                    <signed>JAMES S. PIKE.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State, Washington.</hi></p>
                </postscript>


                <xi:include href="d380-a1.xml" xpointer="d380-a1"/>
