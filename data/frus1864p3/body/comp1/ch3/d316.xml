    <text>
        <body>
            <div xml:id="d316">

                <pb facs="0300" n="280" sameAs="frus:frus1864p3/pg280"/>

                <head>Mr. Seward to Mr.
                        Clay</head>
                <opener>
                    <seg rendition="#float-left">No. 56.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-01-06"><hi rendition="#italic"
                                >January</hi> 6, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your despatch of November 4, No. 33, has
                    been received, and it has been read with deep interest, as all of the papers are
                    in which you enlighten this government concerning the political, social, and
                    material conditions of Russia.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Cassius M. Clay</hi>, Esq.,<hi
                            rendition="#italic"> &amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
