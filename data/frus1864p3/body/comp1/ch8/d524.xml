    <text>
        <body>
            <div xml:id="d524">

                <pb facs="0615" n="595" sameAs="frus:frus1864p3/pg595"/>

                <head>Mr. Frederick W. Seward to Mr. Pruyn</head>
                <opener>
                    <seg rendition="#float-left">No. 75.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1864-09-24"><hi rendition="#italic"
                                >September</hi> 24, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your despatch of May 30, No. 39, has been
                    received, and your proceedings in regard to the opening of the inland sea are
                    approved.</p>
                <p>You are still at liberty to modify your action so far as your judgment may
                    dictate, concurrently with the representatives of the western powers.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>FREDERICK W. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Robert H. Pruyn</hi>, Esq., <hi
                            rendition="#italic">&amp;c., &amp;c.,&amp;c., Kanagawa.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
