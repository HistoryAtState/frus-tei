    <text>
        <body>
            <div xml:id="d527">

                <pb facs="0616" n="596" sameAs="frus:frus1864p3/pg596"/>

                <head>Mr. Seward to Mr.
                        Pruyn</head>
                <opener>
                    <seg rendition="#float-left">No. 82.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1864-10-17"><hi rendition="#italic"
                                >October</hi> 17, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your telegraphic despatch from San
                    Francisco, of the 14th instant, informing this department of the disgrace
                    attached to the ambassadors who made the French convention, has been
                    received.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Robert H. Pruyn</hi>, Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., Kanagawa.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
