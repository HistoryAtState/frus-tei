    <text>
        <body>
            <div xml:id="d480">

                <pb facs="0507" n="487" sameAs="frus:frus1864p3/pg487"/>

                <head>Mr. Pruyn to Mr.
                        Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 24.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States in
                                Japan</hi>, <hi rendition="#italic">Kanagawa</hi>,</placeName>
                        <date calendar="gregorian" when="1864-03-17"><hi rendition="#italic"
                                >March</hi> 17, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inform you of the
                    arrival of Sir Rutherford Alcock.</p>
                <p>I have had two very pleasant and satisfactory interviews with him, and find that
                    our views in relation to Japanese affairs are in entire accord.</p>
                <p>I have the honor to be, sir, very respectfully, your most obedient servant,</p>
                <closer>
                    <signed>ROBERT H. PRUYN, <hi rendition="#italic">Minister Resident in
                            Japan.</hi></signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
