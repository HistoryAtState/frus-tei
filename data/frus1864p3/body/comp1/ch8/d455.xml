    <text>
        <body>
            <div xml:id="d455">

                <pb facs="0476" n="456" sameAs="frus:frus1864p3/pg456"/>

                <opener><seg rendition="#center">[By telegraph.]</seg></opener>
                <head>Mr. Pruyn to Mr.
                        Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 71.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States in
                                Japan</hi>, <hi rendition="#italic">Kanagawa,
                            Yokohama</hi>,</placeName>
                        <date calendar="gregorian" when="1863-10-30"><hi rendition="#italic"
                                >October</hi> 30, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Government has asked the abandonment of
                    this port, promising trade and friendship at Nagasaki and Hakodadi, and
                    intimating that trade cannot continue at this port.</p>
                <p>My colleagues desire this to be communicated to ministers of treaty powers at
                    Washington.</p>
                <p>Very respectfully,</p>
                <closer>
                    <signed>ROBERT H. PRUYN, <hi rendition="#italic">Minister Resident in
                            Japan.</hi></signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
