    <text>
        <body>
            <div xml:id="d506">

                <pb facs="0607" n="587" sameAs="frus:frus1864p3/pg587"/>

                <head>Mr. Pruyn to Mr. Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 67.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States in
                                Japan</hi>, <hi rendition="#italic">Kanagawa</hi>,</placeName>
                        <date calendar="gregorian" when="1864-11-29"><hi rendition="#italic"
                                >November</hi> 29, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit enclosure No.
                    1, copy of the letter of the minister of foreign affairs ratifying the
                    convention recently entered into with this government.</p>
                <p>I remain, very respectfully, your most obedient servant,</p>
                <closer>
                    <signed>ROBT. H. PRUYN, <hi rendition="#italic">Minister Resident of the United
                            States in Japan.</hi></signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington.</hi></p>
                </postscript>



                <xi:include href="d506-a1.xml" xpointer="d506-a1"/>
            </div>
