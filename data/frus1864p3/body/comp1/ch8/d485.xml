    <text>
        <body>
            <div xml:id="d485">

                <pb facs="0512" n="492" sameAs="frus:frus1864p3/pg492"/>

                <head>Mr. Pruyn to Mr. Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 35.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">Kanagawa</hi>,</placeName>
                        <date calendar="gregorian" when="1864-05-16"><hi rendition="#italic"
                                >May</hi> 16, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your despatch No. 57, of the 13th of January last, and received with profound
                    satisfaction the information that my course in reference to the proposition to
                    close this port has been “unreservedly approved.”</p>
                <p>I enclose, No. 1, copy of a letter addressed by me to the Gorogio, pursuant to
                    your instructions.</p>
                <p>I have the honor to be, sir, very respectfully, your most obedient servant,</p>
                <closer>
                    <signed>ROBERT H. PRUYN, <hi rendition="#italic">Minister Resident in
                            Japan.</hi></signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, &amp;c., &amp;c.,
                        &amp;c.</hi></p>
                </postscript>


                <xi:include href="d485-a1.xml" xpointer="d485-a1"/>
            </div>
        </body>
    </text>
