    <text>
        <body>
            <div xml:id="d510">

                <pb facs="0609" n="589" sameAs="frus:frus1864p3/pg589"/>

                <head>Mr. Seward to Mr.
                        Pruyn</head>
                <opener>
                    <seg rendition="#float-left">No. 55.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1863-12-31"><hi rendition="#italic"
                                >December</hi> 31, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your despatches Nos. 64 and 65, dated the
                    1st and 14th of October, respectively, have been received. The former, the
                    contents of which are exceedingly interesting, has been submitted for perusal to
                    the Secretary of the Navy.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Robert H. Pruyn</hi>, Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c., Yedo.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
