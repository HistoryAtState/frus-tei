    <text>
        <body>
            <div xml:id="d525">

                <pb facs="0615" n="595" sameAs="frus:frus1864p3/pg595"/>

                <head>Mr. Seward to Mr.
                        Pruyn</head>
                <opener>
                    <seg rendition="#float-left">No. 87.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1864-10-10"><hi rendition="#italic"
                                >October</hi> 10, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In reference to your despatch No. 45,
                    informing me of your claim for indemnity for loss by fire of the United States
                    legation at Kanagawa, I have to state that your proceedings in the matter are
                    approved.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Robert H. Pruyn</hi>, Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c., Kanagawa.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
