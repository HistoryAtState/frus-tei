    <text>
        <body>
            <div xml:id="d187">

                <pb facs="0156" n="136" sameAs="frus:frus1864p3/pg136"/>

                <head>Mr. Seward to Mr. Dayton</head>
                <opener>
                    <seg rendition="#float-left">No. 635.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-08-18"><hi rendition="#italic"
                                >August</hi> 18, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I enclose for your information a copy of a
                    letter which I have received from his excellency Frederick F. Low, governor of
                    California, relative to the rumor there that Mr. William M. Gwin is to be
                    minister of finance under the new government of Mexico, and also concerning the
                    supposed policy of the Emperor of France in regard to indemnity for the expenses
                    of the war.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">William L. Dayton,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d187-a1.xml" xpointer="d187-a1"/>
            </div>
