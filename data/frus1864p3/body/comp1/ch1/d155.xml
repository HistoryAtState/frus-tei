    <text>
        <body>
            <div xml:id="d155">

                <pb facs="0138" n="118" sameAs="frus:frus1864p3/pg118"/>

                <head>Mr. Dayton to Mr.
                        Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 498.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Paris,</hi></placeName>
                        <date calendar="gregorian" when="1864-06-30"><hi rendition="#italic"
                                >June</hi> 30, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to send you herewith
                    translations of two communications received from the three Japanese ambassadors,
                    who have been residing in Paris for some time past, but who have now left on
                    their return to Japan.</p>
                <p>Accompanying these you will please find the original communication from the
                    Japanese ambassadors to your excellency, referred to in one of the translations
                    enclosed.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WM. L. DAYTON.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>
                        <hi rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>




                <xi:include href="d155-a1.xml" xpointer="d155-a1"/>
