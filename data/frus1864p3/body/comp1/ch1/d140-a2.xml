    <text>
        <body>
            <div xml:id="d140-a2">

                <pb facs="0123" n="103" sameAs="frus:frus1864p3/pg103"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Paris,</hi></placeName>
                        <date calendar="gregorian" when="1864-06-07"><hi rendition="#italic"
                                >June</hi> 7, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Gentlemen</hi>: As representative of the government
                    of the United States at Paris, it is my pleasing duty to acknowledge the receipt
                    of your letter of the 26th of May last, and to thank you for the kind sentiments
                    and encouraging sympathies therein expressed.</p>
                <p>It will give me much pleasure to forward your communication to the government at
                    Washington.</p>
                <p>Accept, gentlemen, the assurance of highest respect with which I have the honor
                    to be,</p>
                <p>Your very humble and very obedient servant,</p>
                <closer>
                    <signed>WM. L. DAYTON.</signed></closer>
                <postscript>
                    <p>Colonel <hi rendition="#small-caps">Jesus Gomes,</hi>
                        <hi rendition="#italic">Portugal.</hi></p>
                </postscript>
                <postscript>
                    <p>Colonel <hi rendition="#small-caps">José Montesenof,</hi></p>
                </postscript>
                <postscript>
                    <p>Colonel <hi rendition="#small-caps">Lewis Legoneta,</hi></p>
                </postscript>
                <postscript>
                    <p>Commandant <hi rendition="#small-caps">Juan Urbina,</hi></p>
                </postscript>
                <postscript>
                    <p>Commandant <hi rendition="#small-caps">Pablo Reutevia,</hi></p>
                </postscript>
                <postscript>
                    <p>Commandant <hi rendition="#small-caps">Franquintom Cortez,</hi>
                        <hi rendition="#italic">Tours,</hi> (<hi rendition="#italic">Indre
                            Loire</hi>,) <hi rendition="#italic">France.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
