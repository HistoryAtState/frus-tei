    <text>
        <body>
            <div xml:id="d74">

                <pb facs="0073" n="53" sameAs="frus:frus1864p3/pg53"/>

                <head>Mr. Dayton to Mr.
                        Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 437.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Paris,</hi></placeName>
                        <date calendar="gregorian" when="1864-03-19"><hi rendition="#italic"
                                >March</hi> 19, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor herewith to enclose to you
                    a translation of a communication just received from Mr. Drouyn de l’Huys, in
                    reference to the case of Mr. Mansfield, United States consul at Tabasco,
                    Mexico.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WM. L. DAYTON.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>
                        <hi rendition="#italic">Secretary of State, &amp;c., &amp;c.,
                        &amp;c.</hi></p>
                </postscript>



                <xi:include href="d74-a1.xml" xpointer="d74-a1"/>
            </div>
        </body>
    </text>
