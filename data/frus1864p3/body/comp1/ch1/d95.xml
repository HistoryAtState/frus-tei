    <text>
        <body>
            <div xml:id="d95">

                <pb facs="0094" n="74" xml:id="pg74"/>

                <head>Mr. Dayton to Mr. Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 452.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Paris,</hi></placeName>
                        <date calendar="gregorian" when="1864-04-18"><hi rendition="#italic"
                                >April</hi> 18, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I herewith send you a printed translation
                    of the “Convention concluded between France and Mexico, to regulate the
                    conditions of the stay of the French troops in this last-named country for the
                    purpose of establishing order and consolidating the new empire.”</p>
                <p>The convention explains itself.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WM. L. DAYTON.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>
                        <hi rendition="#italic">Secretary of State, &amp;c., &amp;c.,
                        &amp;c.</hi></p>
                </postscript>


                <xi:include href="d95-a1.xml" xpointer="d95-a1"/>
            </div>
