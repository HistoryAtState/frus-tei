                <pb facs="0067" n="47" sameAs="frus:frus1864p3/pg47"/>

                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <head>M. Drouyn de l’Huys to Mr. Dayton</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of Foreign Affairs,
                                Cabinet,</hi>
                            <hi rendition="#italic">Paris,</hi></placeName>
                        <date calendar="gregorian" when="1864-03-02"><hi rendition="#italic"
                                >March</hi> 2, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Dayton</hi>: Enclosed are the new
                    instructions of the minister of the marine.</p>
                <p>Yours, very sincerely,</p>
                <closer>
                    <signed>DROUYN DE L’HUYS.</signed></closer>




