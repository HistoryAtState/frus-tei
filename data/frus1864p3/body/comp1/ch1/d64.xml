    <text>
        <body>
            <div xml:id="d64">

                <pb facs="0067" n="47" sameAs="frus:frus1864p3/pg47"/>

                <head>Mr. Dayton to Mr. Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 427.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Paris,</hi></placeName>
                        <date calendar="gregorian" when="1864-03-03"><hi rendition="#italic"
                                >March</hi> 3, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I send you herewith the translation of a
                    short note received last evening from Mr. Drouyn de l’Huys, together with a
                    printed copy of the original instructions enclosed to me therewith. You will
                    observe that certain articles included in the “English Rules” are here
                    omitted.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WM. L. DAYTON.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>
                        <hi rendition="#italic">Secretary of State, &amp;c., &amp;c.,
                        &amp;c.</hi></p>
                </postscript>


                <xi:include href="d64-a1.xml" xpointer="d64-a1"/>
            </div>
