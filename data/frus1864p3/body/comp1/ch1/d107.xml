    <text>
        <body>
            <div xml:id="d107">

                <pb facs="0103" n="83" sameAs="frus:frus1864p3/pg83"/>

                <head>Mr. Seward to Mr. Dayton</head>
                <opener>
                    <seg rendition="#float-left">No. 540.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-05-04"><hi rendition="#italic"
                                >May</hi> 4, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your despatch of the 18th ultimo, No. 452,
                    enclosing a printed translation of a convention between France and the Archduke
                    Maximilian in regard to Mexico, has been received.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">William L. Dayton</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
