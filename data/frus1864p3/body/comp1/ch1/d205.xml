    <text>
        <body>
            <div xml:id="d205">

                <pb facs="0169" n="149" sameAs="frus:frus1864p3/pg149"/>

                <head>Mr. F. W. Seward to Mr.
                        Dayton</head>
                <opener>
                    <seg rendition="#float-left">No. 662.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-09-24"><hi rendition="#italic"
                                >September</hi> 24, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    despatch of the 9th of September, No. 533, in which you inform me that Mr.
                    Drouyn de l’Huys having returned to Paris, you made known to him the views of
                    this government respecting the action of Captain Winslow in releasing the
                    prisoners taken by the Kearsarge. Your proceedings therein indicated are
                    approved.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>F. W. SEWARD. <hi rendition="#italic">Acting
                    Secretary.</hi></signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">William L. Dayton,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
