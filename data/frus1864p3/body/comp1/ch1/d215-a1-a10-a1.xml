    <text>
        <body>
            <div xml:id="d215-a1-a10-a1">

                <pb facs="0183" n="163" xml:id="pg163"/>

                <head><hi rendition="#italic">Statement of the number of Mexican, refugees at Brazos
                        Santiago, Texas; the number and character of their arms, amount of
                        artillery, number of horses, &amp;c.</hi></head>
                <table cols="2">
                    <row role="label">
                        <cell>Number of officers</cell>
                        <cell role="num">13</cell>
                    </row>
                    <row>
                        <cell>Number of men</cell>
                        <cell role="num">290</cell>
                    </row>
                    <row>
                        <cell>Muskets, calibre .69</cell>
                        <cell role="num">27</cell>
                    </row>
                    <row>
                        <cell>Enfield rifles, calibre .58</cell>
                        <cell role="num">195</cell>
                    </row>
                    <row>
                        <cell>Whitney muskets, calibre .58</cell>
                        <cell role="num">24</cell>
                    </row>
                    <row>
                        <cell>Cavalry horses, with equipments</cell>
                        <cell role="num">22</cell>
                    </row>
                    <row>
                        <cell>Mules</cell>
                        <cell role="num">10</cell>
                    </row>
                    <row>
                        <cell>Six-pound rifled brass guns</cell>
                        <cell role="num">3</cell>
                    </row>
                    <row>
                        <cell>Bounds of cartridges, different calibre</cell>
                        <cell role="num">1,200</cell>
                    </row>
                    <row>
                        <cell>Rounds of assorted ammunition</cell>
                        <cell role="num">76</cell>
                    </row>
                </table>
                <p rendition="#right"><hi rendition="#small-caps">Brazos Santiago, Texas,</hi>
                    <hi rendition="#italic">September</hi> 14, 1864.</p>
                <p>I certify that the above statement is correct.</p>
                <closer>
                    <signed>H. M. DAY, <hi rendition="#italic">Colonel, Commanding U. S.
                            Forces.</hi></signed></closer>
                <postscript>
                    <p>Official:</p>
                    <p rendition="#right">GEORGE B. DRAKE, <hi rendition="#italic">A. A. G.</hi></p>
                </postscript>
            </div>
        </body>
