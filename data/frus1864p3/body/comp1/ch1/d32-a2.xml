        <body>
            <div xml:id="d32-a2">

                <pb facs="0048" n="28" xml:id="pg28"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Consulate of the United States of
                                America,</hi>
                            <hi rendition="#italic">Vera Cruz,</hi></placeName>
                        <date calendar="gregorian" when="1863-12-28"><hi rendition="#italic"
                                >December</hi> 28, 1863.</date></dateline></opener>
                <p>I, the undersigned, consul of the United States of America for, the port of Vera
                    Cruz and the dependencies thereof, hereby certify that the foregoing is a true
                    copy of the original protest entered of record in this consulate.</p>
                <p>Given under my hand and the seal of said consulate the day and year above
                    written.</p>
                <p>[<hi rendition="#small-caps">l. s.</hi>]</p>
                <closer>
                    <signed>M. D. L. LANE, <hi rendition="#italic">United States
                        Consul.</hi></signed></closer>
            </div>
