    <text>
        <body>
            <div xml:id="d84">

                <pb facs="0080" n="60" sameAs="frus:frus1864p3/pg60"/>

                <head>Mr. Seward to Mr. Dayton</head>
                <opener>
                    <seg rendition="#float-left">No. 519.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-04-04"><hi rendition="#italic"
                                >April</hi> 4, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit herewith for your information a
                    copy of a despatch of the 4th ultimo from the consul of the United States at
                    Monterey, relative to the present difficulties in Mexico.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">William L. Dayton</hi>
                        <hi rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d84-a1.xml" xpointer="d84-a1"/>
            </div>
