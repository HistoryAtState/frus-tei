    <text>
        <body>
            <div xml:id="d130">

                <pb facs="0113" n="93" sameAs="frus:frus1864p3/pg93"/>

                <head>Mr. Seward to Mr.
                        Dayton</head>
                <opener>
                    <seg rendition="#float-left">No. 571.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-06-01"><hi rendition="#italic"
                                >June</hi> 1, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have received your despatch of the 16th
                    ultimo, No. 468, and your proceeding relative to the Rappahannock is
                    approved.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">William L. Dayton</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
