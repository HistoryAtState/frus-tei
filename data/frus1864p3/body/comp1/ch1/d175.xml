    <text>
        <body>
            <div xml:id="d175">

                <pb facs="0151" n="131" xml:id="pg131"/>

                <head>Mr. Seward to Mr. Dayton</head>
                <opener>
                    <seg rendition="#float-left">No. 609.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-07-16"><hi rendition="#italic"
                                >July</hi> 16, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge with much
                    appreciation, the receipt of your despatch of the 29th of June, No. 497,
                    communicating a translation of a letter received by your son from M. Dufour,
                    surgeon-in-chief of the government hospital at Cherbourg.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">William L. Dayton</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
