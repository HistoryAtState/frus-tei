    <text>
        <body>
            <div xml:id="d120">

                <pb facs="0108" n="88" sameAs="frus:frus1864p3/pg88"/>

                <head>Mr. Seward to Mr.
                        Dayton</head>
                <opener>
                    <seg rendition="#float-left">No. 561.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-05-21"><hi rendition="#italic"
                                >May</hi> 21, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your despatch of May 2, No. 461, and to approve of your proceedings therein
                    mentioned. We learn that Mr. Corwin, our minister plenipotentiary to Mexico, is
                    at Havana, on his return to the United States, under leave of absence.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">William L. Dayton</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
