    <text>
        <body>
            <div xml:id="d154">

                <pb facs="0137" n="117" sameAs="frus:frus1864p3/pg117"/>

                <head>Mr. Dayton to Mr.
                        Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 497.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Paris,</hi></placeName>
                        <date calendar="gregorian" when="1864-06-29"><hi rendition="#italic"
                                >June</hi> 29, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to send you herewith a
                    translation of a letter received by my son from M. Dufour, surgeon-in-chief of
                    the government hospital at Cherbourg.</p>
                <p>A telegram received the night before last, from our vice-consul at Cherbourg,
                    states that Gowan, the seaman of the Kearsarge, most dangerously wounded, having
                    a compound fracture of the leg, is dead.</p>
                <p>I am, sir, your most obedient servant.</p>
                <closer>
                    <signed>WM. L. DAYTON.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>
                        <hi rendition="#italic">Secretary of State, &amp;c., &amp;c.,
                        &amp;c.</hi></p>
                </postscript>


                <xi:include href="d154-a1.xml" xpointer="d154-a1"/>
