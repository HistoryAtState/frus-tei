    <text>
        <body>
            <div xml:id="d210">

                <pb facs="0175" n="155" xml:id="pg155"/>

                <head>Mr. Seward to Mr. Dayton</head>
                <opener>
                    <seg rendition="#float-left">No. 669.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1864-10-03"><hi rendition="#italic"
                                >October</hi> 3, 1864.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit for your information a copy of a
                    private note of the 23d ultimo from M. de Geofroy, of my reply of the 30th
                        ultimo,<anchor n="*" xml:id="d210-f1"/> and of a letter addressed by me to
                    Major General Canby on the 30th ultimo, in regard to the alleged entrance of the
                    Mexican General Cortinas, with an armed force, into the territory of the United
                    States, with an assumption of military authority.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">William L. Dayton,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d210-a1.xml" xpointer="d210-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d210-f1" n="*" xml:id="d210-f1-content">
                <p>This note and the reply thereto will be found in the correspondence with the
                    French legation.</p>
            </note>
        </listAnnotation>
    </standOff>
