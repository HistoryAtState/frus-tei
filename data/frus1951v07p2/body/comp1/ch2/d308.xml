    <text>
        <body>
            <div xml:id="d308">

                <pb facs="0537" n="1995" xml:id="pg1995"/>

                <note rend="inline" type="source">493.006/6–2551</note>
                <head>
                    <hi rendition="#italic">Memorandum by the Director of Central Intelligence</hi>
                        (<hi rendition="#italic">Smith</hi>) <hi
                        rendition="#italic">to W. Park Armstrong,
                        Special Assistant for Intelligence to the Secretary of State</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1951-06-27">27 June 1951</date>.</dateline>
                </opener>
                <p>The attached memorandum was prepared by the Office of Estimates for internal use
                    in CIA.</p>
                <p>In view of the importance of the subject and its affect on U.S. policy, I am
                    forwarding two copies for your use.</p>
                <p>No dissemination is being made through regular channels.</p>
                <closer>
                    <signed>W. B. <hi rendition="#small-caps">Smith</hi>
                    </signed>
                </closer>



