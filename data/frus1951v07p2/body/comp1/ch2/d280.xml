            <div xml:id="d280">

                <pb facs="0495" n="1953" sameAs="frus:frus1951v07p2/pg1953"/>

                <note rend="inline" type="source">320.2–AC/4–1251</note>
                <head>
                    <hi rendition="#italic">Memorandum by the Acting Deputy Director of the Office
                        of United Nations Political and Security Affairs</hi> (<hi
                        rendition="#italic">Popper</hi>)</head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1951-04-12">April 12, 1951</date>.</dateline>
                </opener>
                <p rendition="#flush">Subject: Position Paper on Economic Measures Against Communist
                    China</p>
                <p>The attached paper is a revision of the draft dated March 26. No change has been
                    made in the recommendations, but the discussion section has been revised to take
                    into account observations made on the March 26 draft.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">David</hi> H. <hi rendition="#small-caps"
                            >Popper</hi>
                    </signed>
                </closer>


                <xi:include href="d280-a1.xml" xpointer="d280-a1"/>
            </div>
