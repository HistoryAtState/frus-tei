    <text>
        <body>
            <div xml:id="d575">

                <pb facs="0969" n="955" sameAs="frus:frus1949v05/pg955"/>

                <note rend="inline" type="source"> CFM Files, Lot M–88, Box 144, Memos Conv Formins
                    and Sec Sep 1940</note>
                <head>
                    <hi rendition="#italic">Memorandum of Conversation, by the Secretary of
                        State</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1949-09-14">September 14, 1949</date>.</dateline>
                </opener>
                <table>
