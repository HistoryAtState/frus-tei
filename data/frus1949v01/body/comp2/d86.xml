    <text>
        <body>
            <div xml:id="d86">

                <pb facs="0237" n="207" sameAs="frus:frus1949v01/pg207"/>

                <note rend="inline" type="source"> USUN Files</note>
                <head>
                    <hi rendition="#italic">The President of the General Assembly</hi> (<hi
                        rendition="#italic">Romulo</hi>) <hi rendition="#italic">to the United
                        States Representative at the United Nations</hi> (<hi rendition="#italic"
                        >Austin</hi>)</head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">confidential</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">New York</hi></placeName>, <date
                            calendar="gregorian" when="1949-11-03">3 November
                        1949</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Austin</hi>: I enclose for your
                    consideration an appeal on the question of atomic energy. This appeal, which
                    should at this stage be considered as strictly confidential, is addressed also
                    to the heads of the other delegations whose governments are represented on the
                    Atomic Energy Commission.</p>
                <p>Yours sincerely,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Carlos</hi> P. <hi rendition="#small-caps"
                            >Romulo</hi>
                    </signed>
                </closer>


                <xi:include href="d86-a1.xml" xpointer="d86-a1"/>
            </div>
        </body>
    </text>
