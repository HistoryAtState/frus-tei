    <text>
        <body>
            <div xml:id="d227">

                <pb facs="0650" n="620" sameAs="frus:frus1949v01/pg620"/>

                <note rend="inline" type="source">Department of State Atomic Energy Files</note>
                <head>
                    <hi rendition="#italic">The British Ambassador</hi> (<hi
                            rendition="#italic">Franks</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1949-12-29">29 December
                        1949</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Dean</hi>: Here is the British paper I promised
                    to send you when we talked on the telephone yesterday. It represents our attempt
                    to draw up draft proposals based on the last round of discussions.</p>
                <p>I have also sent a copy to Hume Wrong.</p>
                <p>Yours sincerely,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Oliver Franks</hi>
                    </signed>
                </closer>



                <xi:include href="d227-a1.xml" xpointer="d227-a1"/>
            </div>
