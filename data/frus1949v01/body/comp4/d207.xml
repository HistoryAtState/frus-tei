            <div xml:id="d207">

                <pb facs="0589" n="559" sameAs="frus:frus1949v01/pg559"/>

                <note rend="inline" type="source">SCI Files</note>
                <head>
                    <hi rendition="#italic">Memorandum by the Executive Secretary of the National
                        Security Council</hi> (<hi rendition="#italic">Souers</hi>)</head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1949-10-10">October 10,
                        1949</date>.</dateline>
                </opener>
                <p rendition="#flush">Memorandum for: The Secretary of State<lb/>The Secretary of
                    Defense<lb/>The Chairman, Atomic Energy Commission</p>
                <p rendition="#flush">Subject: The Proposed Acceleration of the Atomic Energy
                    Program</p>
                <p rendition="#flush">Reference: Letter from the President to the Executive
                    Secretary NSC, Same Subject Dated July 26,
                    1949</p>
                <p>The enclosed report to the President on the above subject in response to the
                    reference letter, in the form approved by you as the Special Committee of the
                    National Security Council, has been submitted on this date to the President for
                    his consideration.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Sidney</hi> W. <hi rendition="#small-caps"
                            >Souers</hi>
                    </signed>
                </closer>


                <xi:include href="d207-a1.xml" xpointer="d207-a1"/>
