    <text>
        <body>
            <div xml:id="d712">

                <pb facs="1079" n="1061" sameAs="frus:frus1947v03/pg1061"/>

                <note rend="inline" type="source">711.52/2–2847: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Embassy in Spain </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">confidential</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1947-03-03T20:00:00-05:00">March 3, 1947—8 p.
                            m.</date>
                    </dateline>
                </opener>
                <p>194. We are wholly in accord with prompt action you took Embtel 166 Feb 28. You
                    are authorized to take such further measures in this connection as you deem
                    appropriate, including request for public retraction of references to Asst Sec
                    Braden.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Marshall</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
