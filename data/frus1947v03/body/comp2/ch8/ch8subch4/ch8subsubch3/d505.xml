    <text>
        <body>
            <div xml:id="d505">

                <pb facs="0804" n="786" sameAs="frus:frus1947v03/pg786"/>

                <note rend="inline" type="source">851.51/10–2447</note>
                <head>
                    <hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic"
                        >Caffery</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">confidential</hi>
                        <lb/> No. 9801</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1947-10-24">October 24,
                        1947</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith a
                    summary of the conversation between Foreign Minister Bidault and members of the
                    Senate Appropriations Committee and of the Revercomb Sub-Committee, on October
                    17, 1947.<anchor n="1" xml:id="d505-f1"/>
                </p>
                <p>Respectfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Jefferson Caffery</hi>
                    </signed>
                </closer>


                <xi:include href="d505-a1.xml" xpointer="d505-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d505-f1" n="1" xml:id="d505-f1-content">
                <p>Chapman Revercomb, of West Virginia, was chairman of a subcommittee of the
                    Judiciary Committee, United States Senate, to study problems of immigration and
                    displaced persons.</p>
            </note>
        </listAnnotation>
    </standOff>
