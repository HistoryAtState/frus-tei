    <text>
        <body>
            <div xml:id="d295">

                <pb facs="0525" n="507" sameAs="frus:frus1947v03/pg507"/>

                <note rend="inline" type="source">840.6362/5–1647: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Embassy in the United
                        Kingdom </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                        <lb/>
                        <hi rendition="#small-caps">niact</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1947-05-16T19:00:00-04:00">May 16, 1947—7 p.
                            m.</date>
                    </dateline>
                </opener>
                <p>2143. For Douglas. Re Salco 490<anchor n="1" xml:id="d295-f1"/> and Lasco 319.
                    Please make no commitments on either French or Brit position re UK request for
                    US coal until arrival full details US position by separate tel. Jeffers<anchor
                        n="2" xml:id="d295-f2"/> arriving London Mon and fully acquainted our
                    position.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Marshall</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d295-f1" n="1" xml:id="d295-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d295-f2" n="2" xml:id="d295-f2-content">
                <p>Charles W. Jeffers, special assistant to the Chief of Mission for Economic
                    Affairs in the Embassy in the United Kingdom.</p>
            </note>
        </listAnnotation>
