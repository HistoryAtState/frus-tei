    <text>
        <body>
            <div xml:id="d345">

                <pb facs="0576" n="558" sameAs="frus:frus1947v03/pg558"/>

                <note rend="inline" type="source">740.0011 EW (Peace)/8–847: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in Hungary</hi> (<hi
                            rendition="#italic">Chapin</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">confidential</hi>
                        <lb/>
                        <hi rendition="#small-caps">priority</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Budapest</hi></placeName>, <date
                            calendar="gregorian" when="1947-08-08T16:00:00+02:00">August 8, 1947—4
                            p. m.</date>
                    </dateline>
                </opener>
                <p>1332. President Tildy signed legislation ratifying peace treaty August 7.</p>
                <p>Sent Department, repeated London 139, Moscow 131.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Chapin</hi>
                    </signed>
                </closer>
            </div>
        </body>
