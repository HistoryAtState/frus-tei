    <text>
        <body>
            <div xml:id="d352">

                <pb facs="0582" n="564" sameAs="frus:frus1947v03/pg564"/>

                <note rend="inline" type="source">740.0011 EW (Peace)/8–2647: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Yugoslavia</hi> (<hi
                        rendition="#italic">Cannon</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Belgrade</hi></placeName>, <date
                            calendar="gregorian" when="1947-08-26">August 26,
                        1947</date>.</dateline>
                </opener>
                <p>977. Tanjug officially announces ratification by praesidium of Peace Treaties
                    with Italy, Bulgaria and Hungary.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Cannon</hi>
                    </signed>
                </closer>
            </div>
        </body>
