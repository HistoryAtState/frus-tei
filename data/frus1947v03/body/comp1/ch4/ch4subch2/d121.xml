    <text>
        <body>
            <div xml:id="d121">

                <pb facs="0199" n="181" sameAs="frus:frus1947v03/pg181"/>

                <note rend="inline" type="source">501.BB/12–247: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Embassy in India
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">confidential</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi>
                        </placeName>] <date calendar="gregorian" when="1947-12-02">December 2,
                            1947</date>.</dateline>
                </opener>
                <p>55. The Acting Secretary of State transmits herewith for the information of the
                    Embassy a copy of the position paper on the India–Pakistan <pb facs="0200"
                        n="182" xml:id="pg182"/> dispute over Kashmir prepared for the United States
                    Delegation to the General Assembly of the United Nations.<anchor n="1"
                        xml:id="d121-f1"/>
                </p>
                <closer>[<signed>
                        <hi rendition="#small-caps">Lovett</hi>
                    </signed>]</closer>


                <xi:include href="d121-a1.xml" xpointer="d121-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d121-f1" n="1" xml:id="d121-f1-content">
                <p>Copy of position paper also sent to the Embassy in Pakistan in Department
                    instruction No. 12 to Karachi, December 2, 1947 (501.BB/12–247).</p>
            </note>
        </listAnnotation>
    </standOff>
