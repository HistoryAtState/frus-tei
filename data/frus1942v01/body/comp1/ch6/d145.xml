            </note>
            <note corresp="#d145-f4" n="24" xml:id="d145-f4-content">
                <p>Harry Dexter White, Special Assistant to the Secretary of the Treasury and
                    Director of Monetary Research.</p>
            </note>
        </listAnnotation>
