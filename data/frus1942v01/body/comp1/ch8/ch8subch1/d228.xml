                <pb facs="0309" n="297" sameAs="frus:frus1942v01/pg297"/>

                <note rend="inline" type="source">701.6211/1486a: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Chargé in Switzerland</hi> (<hi rendition="#italic"
                            >Huddle</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1941-12-30">December 30, 1941</date>.</dateline>
                </opener>
                <p>431. Department’s 338, 19th, paragraph 3. Please request Swiss Government to
                    inform the German, Italian, Rumanian and Hungarian Governments that Department
                    is prepared on the basis of reciprocity to extend exemption from search or
                    control of personal effects to consular and other official personnel and to
                    their accompanying dependents and staffs.</p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
    </text>
