                <pb facs="0381" n="369" sameAs="frus:frus1942v01/pg369"/>

                <note rend="inline" type="source">701.0090/162: Telegram</note>
                <head><hi rendition="#italic">The Consul at Göteborg</hi> (<hi rendition="#italic"
                        >Corcoran</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Göteborg</hi></placeName>, <date calendar="gregorian"
                            when="1942-05-28">May 28, 1942</date>.<lb/>[Received May 28—9:40
                        p.m.]</dateline>
                </opener>
                <p>83. S. S. <hi rendition="#italic">Gripsholm</hi> sailed noon today for New York
                    with 142 Americans, 52 aliens. Passenger list being telegraphed.</p>
                <closer><signed><hi rendition="#small-caps">Corcoran</hi></signed></closer>
            </div>
        </body>
    </text>
