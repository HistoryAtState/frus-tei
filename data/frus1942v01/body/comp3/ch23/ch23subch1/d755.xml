    <text>
        <body>
            <div xml:id="d755">

                <pb facs="0879" n="867" sameAs="frus:frus1942v01/pg867"/>

                <note rend="inline" type="source">895.01/96⅓</note>
                <head><hi rendition="#italic">President Roosevelt
                        to the Acting Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1942-04-08">April 8, 1942</date>.</dateline>
                </opener>
                <p>I enclose a memorandum handed me by Dr. Soong.<anchor n="24" xml:id="d755-f1"/>
                    Please speak to me about it before Tuesday the 14th.</p>
                <closer><signed>F[<hi rendition="#small-caps">ranklin</hi>] D. R[<hi
                            rendition="#small-caps">oosevelt</hi>]</signed></closer>



                <xi:include href="d755-a1.xml" xpointer="d755-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d755-f1" n="24" xml:id="d755-f1-content">
                <p>T. V. Soong, Chinese Minister for Foreign Affairs since December 1941; at this
                    time in the United States.</p>
            </note>
        </listAnnotation>
    </standOff>
