                <pb facs="0839" n="827" sameAs="frus:frus1942v01/pg827"/>

                <note rend="inline" type="source">740.00114A Pacific War/228: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Minister in
                        Switzerland</hi> (<hi rendition="#italic">Harrison</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1942-11-12">November 12, 1942</date>.</dateline>
                </opener>
                <p>2529. American interests—Japan, prisoners of war. Your 5010, November 5. Request
                    Swiss Government to endeavor to obtain names of aviators upon whom penalties
                    were imposed together with specification of charges and penalties in each
                    case.</p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
    </text>
