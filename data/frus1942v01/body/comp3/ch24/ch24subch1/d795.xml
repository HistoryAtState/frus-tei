    <text>
        <body>
            <div xml:id="d795">

                <pb facs="0919" n="907" sameAs="frus:frus1942v01/pg907"/>

                <note rend="inline" type="source">740.0011 European War 1939/22164b: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Ambassador in China</hi>
                        (<hi rendition="#italic">Gauss</hi>)<anchor n="64" xml:id="d795-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1942-06-10T13:00:00-04:00">June 10, 1942—1 p.m.</date></dateline>
                </opener>
                <p>506. Please inform the Foreign Office confidentially that the Commonwealth of the
                    Philippines has indicated a desire to adhere to Declaration by United Nations;
                    that we find no objection; that in the absence of any objection from the
                    Chinese, British, or Soviet Governments, such adherence will be formally
                    accepted at a White House ceremony on June 14.<anchor n="65" xml:id="d795-f2"
                    /></p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d795-f1" n="64" type="source" xml:id="d795-f1-content">
                <p>Repeated as No. 2631 to the Ambassador in the United Kingdom and as No. 287 to
                    the Ambassador in the Soviet Union; message was sent with the approval of
                    President Roosevelt.</p>
            </note>
            <note corresp="#d795-f2" n="65" xml:id="d795-f2-content">
                <p>No objection was made by the three Governments.</p>
            </note>
        </listAnnotation>
    </standOff>
