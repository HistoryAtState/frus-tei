            </note>
            <note corresp="#d793-f3" n="59" xml:id="d793-f3-content">
                <p>Chairman of the Senate Committee on Foreign Relations.</p>
            </note>
            <note corresp="#d793-f4" n="60" xml:id="d793-f4-content">
