            <div xml:id="d602">

                <pb facs="0726" n="714" sameAs="frus:frus1942v01/pg714"/>

                <note rend="inline" type="source">845.00/15423/5</note>
                <head><hi rendition="#italic">The Under Secretary of State</hi> (<hi
                        rendition="#italic">Welles</hi>) <hi rendition="#italic">to President
                        Roosevelt</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1942-08-11">August 11, 1942</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">My Dear Mr. President</hi>: I have just received from
                    Dr. T. V. Soong a further message from Generalissimo Chiang Kai-shek which I
                    enclose herewith.</p>
                <p>Believe me</p>
                <p>Faithfully yours,</p>
                <closer><signed><hi rendition="#small-caps">Sumner Welles</hi></signed></closer>


                <xi:include href="d602-a1.xml" xpointer="d602-a1"/>
