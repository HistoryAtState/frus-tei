                <pb facs="0666" n="654" sameAs="frus:frus1942v01/pg654"/>

                <note rend="inline" type="source">123 Johnson, Louis A./35: Telegram</note>
                <head><hi rendition="#italic">The Officer in Charge at New Delhi</hi> (<hi
                        rendition="#italic">Merrell</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">New
                                Delhi</hi></placeName>, <date calendar="gregorian"
                            when="1942-05-16T13:00:00+05:30">May 16, 1942—1
                        p.m.</date><lb/>[Received 1:23 p.m.]</dateline>
                </opener>
                <p>293. For the President and Secretary from Colonel Johnson: “Leaving Karachi for
                    Cairo today. Saw Foreign Secretary Thursday who assures my going will not be
                    misinterpreted and who recommends seek further medical treatment
                    immediately.”</p>
                <closer><signed><hi rendition="#small-caps">Merrell</hi></signed></closer>
            </div>
        </body>
    </text>
