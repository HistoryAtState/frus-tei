                <pb facs="0767" n="755" sameAs="frus:frus1942v01/pg755"/>

                <note rend="inline" type="source">740.0011 European War 1939/18977: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Minister in Ireland</hi> (<hi rendition="#italic"
                            >Gray</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1942-01-31T19:00:00-05:00">January 31, 1942—7
                        p.m.</date></dateline>
                </opener>
                <p>6. Your 7, January 27. Department agrees that it would not be wise to change our
                    policy under existing circumstances.</p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
