    <text>
        <body>
            <div xml:id="d639">

                <pb facs="0765" n="753" sameAs="frus:frus1942v01/pg753"/>

                <note rend="inline" type="source">740.0011 European War 1939/19018: Telegram</note>
                <head><hi rendition="#italic">The Minister in Ireland</hi> (<hi rendition="#italic"
                        >Gray</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Dublin</hi></placeName>, <date calendar="gregorian"
                            when="1942-01-28">January 28, 1942</date>.<lb/>[Received January 28—2:54
                        p.m.]</dateline>
                </opener>
                <p>8. Today’s news features Mr. de Valera’s statement regarding American troops in
                    Northern Ireland. Forwarding official text airmail.<anchor n="3"
                        xml:id="d639-f1"/> Government Party paper quotes the President’s alleged
                    comment on Irish protest.</p>
                <closer><signed><hi rendition="#small-caps">Gray</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d639-f1" n="3" xml:id="d639-f1-content">
                <p>For Mr. de Valera’s statement, see note from the Irish Minister, February 6, <ref
                        target="#pg756">p. 756</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
