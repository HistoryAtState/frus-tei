            <div xml:id="errata">

                <pb facs="0734" n="701" sameAs="frus:frus1969-76v12/pg701"/>

                <head>Errata</head>
                <p>The following changes have been made to the online version of <ref
                        target="frus:frus1969-76v12">
                        <hi rendition="#italic">Foreign Relations</hi>, 1969–1976, Volume XII,
                        Soviet Union, January 1969–October 1970</ref>. Please be aware that printed
                    volumes have not been revised. </p>
                <list type="simple">
                    <item>
                        <hi rendition="#bold">1. <ref target="#d72">Document 72</ref>. </hi>
                    </item>
                    <item>In paragraph 4, “Kissinger” was corrected to “Kiesenger.”</item>
                </list>
            </div>
        </body>
    </text>
