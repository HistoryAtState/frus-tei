            <div xml:id="d843">

                <pb facs="1137" n="1127" sameAs="frus:frus1945v03/pg1127"/>

                <note rend="inline" type="source">840.414/10–2545: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the United States Political
                        Adviser for Germany</hi> (<hi rendition="#italic">Murphy</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-10-31T16:00:00-05:00">October 31, 1945—4
                            p.m.</date>
                    </dateline>
                </opener>
                <p>774. Urtel 838, Oct 25. Proposed transfer of German FonOff documents to Brit zone
                    should not be effected pending discussion of policy here at high level. Please
                    inform U.S. military authorities accordingly.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Byrnes</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
