    <text>
        <body>
            <div xml:id="d765">

                <pb facs="1045" n="1035" sameAs="frus:frus1945v03/pg1035"/>

                <note rend="inline" type="source">862.01/5–645: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in France</hi> (<hi
                            rendition="#italic">Caffery</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1945-05-06T19:00:00+02:00">May 6, 1945—7
                            p.m.</date>
                        <lb/> [Received 8 p.m.]</dateline>
                </opener>
                <p>2419. The Embassy is informed by a source in close contact with CALPO (Free
                    Germany Committee of the West) that most of the Socialists therein have
                    renounced their membership owing to the too excessive Communist domination of
                    the Committee.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Caffery</hi>
                    </signed>
                </closer>
            </div>
        </body>
