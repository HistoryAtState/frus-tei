            <div xml:id="d511">

                <pb facs="0730" n="720" sameAs="frus:frus1945v03/pg720"/>

                <note rend="inline" type="source">740.0011 E.W./1–1445: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in the
                        United Kingdom</hi> (<hi rendition="#italic">Winant</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-01-16T22:00:00-04:00">January 16,
                            1945—10 p.m.</date>
                    </dateline>
                </opener>
                <p>371. For Murphy. We wholeheartedly support you in your position as set forth in
                    your 482, January 14, 4 p.m., and agree with you that every effort must be
                    exerted to prevent compromising the policy of unconditional surrender.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Grew</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
