    <text>
        <body>
            <div xml:id="d554">

                <pb facs="0780" n="770" xml:id="pg770"/>

                <note rend="inline" type="source">740.0011 EW/4–2745: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-04-27T10:15:00-04:00">April 27,
                            1945—10:15 a.m.</date>
                    </dateline>
                </opener>
                <p>2. Public announcement will be made at noon today by the President, the Prime
                    Minister, and Stalin that the Anglo-American and Soviet forces in Germany have
                    joined at Torgau.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Grew</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
