    <text>
        <body>
            <div xml:id="d605">

                <pb facs="0691" n="675" sameAs="frus:frus1947v08/pg675"/>

                <note rend="inline" type="source">822.01/9–1947: Circular telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Diplomatic
                        Representatives in the American Republics </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">restricted</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1947-09-19T02:00:00-04:00">September 19,
                            1947—2 a.m.</date>
                    </dateline>
                </opener>
                <p>Please inform Govt to which you are accredited that US Govt is instructing US Amb
                    at Quito to enter into normal relations with new Govt of Ecuador on Monday, Sept
                    22.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lovett</hi>
                    </signed>
                </closer>
            </div>
        </body>
