            </note>
            <note corresp="#d779-f2" n="47" xml:id="d779-f2-content">
                <p>Carlos Hall, First Secretary of Embassy in Panama.</p>
            </note>
            <note corresp="#d779-f3" n="48" xml:id="d779-f3-content">
                <p>Mario de Diego, First Secretary of the Panamanian Foreign Office.</p>
            </note>
            <note corresp="#d779-f4" n="50" xml:id="d779-f4-content">
                <p>Forwarded by the Ambassador in Panama in despatch 4299, September 18, 1947, not
                    printed.</p>
            </note>
        </listAnnotation>
    </standOff>
