            </note>
            <note corresp="#d478-f2" n="43" xml:id="d478-f2-content">
                <p>Maj. Gen. Ralph H. Wooten, Field Commissioner for Military Programs, Office of
                    the Foreign Liquidation Commissioner.</p>
            </note>
        </listAnnotation>
