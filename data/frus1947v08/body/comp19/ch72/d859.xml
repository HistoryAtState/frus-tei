    <text>
        <body>
            <div xml:id="d859">

                <pb facs="1020" n="1004" sameAs="frus:frus1947v08/pg1004"/>

                <note rend="inline" type="source">823.51/2–2547: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            Embassy in Peru
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                        <lb/>
                        <hi rendition="#small-caps">us urgent</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1947-02-26T12:00:00-05:00">February 26,
                            1947—noon</date>.</dateline>
                </opener>
                <p>95. Council rejects 2–½% top interest rate proposal ur 158 Feb 25.<anchor n="16" xml:id="d859-f1"/> Question thoroughly
                    canvassed recently. Rogers<anchor n="17" xml:id="d859-f2"/> sure Council members
                    if polled would vote unanimously against it.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Marshall</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d859-f1" n="16" xml:id="d859-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d859-f2" n="17" xml:id="d859-f2-content">
                <p>James Grafton Rogers, President of the Foreign Bondholders Protective
                    Council.</p>
            </note>
        </listAnnotation>
    </standOff>
