    <text>
        <body>
            <div xml:id="d672">

                <pb facs="0784" n="768" sameAs="frus:frus1947v08/pg768"/>

                <note rend="inline" type="source">811.516 Export-Import Bank/10–647: Airgram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Embassy in Mexico
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">restricted</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1947-10-06">October 6,
                        1947</date>.</dateline>
                </opener>
                <p>A–770. Credit application for $3.5 million behalf Nueva Compañía Electrica
                    Chapala, S.A., to finance purchases in U.S. of equipment and materials for
                    Colomilla Hydro-electric Power Plant, <pb facs="0785" n="769" xml:id="pg769"/>
                    two associated transmission lines, and the pumping station was approved by
                    Eximbank Board of Directors October 1. This is the first specific credit
                    approved under the $50 million commitment made to Mexico in April 1947.</p>
                <p rendition="#center">. . . . . . .</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lovett</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
