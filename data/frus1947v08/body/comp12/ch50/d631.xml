            </note>
            <note corresp="#d631-f2" n="19" xml:id="d631-f2-content">
                <p>Guatemalan note dated July 23, 1947, not printed.</p>
            </note>
            <note corresp="#d631-f3" n="20" xml:id="d631-f3-content">
                <p>No record found in Department files of an immediate reply from the Embassy on
                    these specific points.</p>
            </note>
        </listAnnotation>
    </standOff>
