    <text>
        <body>
            <div xml:id="d225">

                <pb facs="0284" n="268" sameAs="frus:frus1947v08/pg268"/>

                <note rend="inline" type="source">835.852/6–1747: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Embassy in Argentina </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">us urgent</hi>
                        <lb/>
                        <hi rendition="#small-caps">restricted</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1947-06-17T19:00:00-04:00">June 17, 1947—7
                            p.m.</date>
                    </dateline>
                </opener>
                <p>531. Deptel 322 Apr 19.<anchor n="83" xml:id="d225-f1"/> Marit Com June 13
                    approved application Newport News Shipbuilding Co to enter into contract with
                    Dodero to convert 2 CVEs–51 and 52 to commercial cargo vessels. Formal transfer
                    order to be issued when conversion completed.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Marshall</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
