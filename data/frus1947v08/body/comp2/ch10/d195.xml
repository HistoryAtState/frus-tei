    <text>
        <body>
            <div xml:id="d195">

                <pb facs="0249" n="233" sameAs="frus:frus1947v08/pg233"/>

                <note rend="inline" type="source">835.24/10–2447: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            Embassy in Belgium
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1947-11-07T19:00:00-05:00">November 7, 1947—7
                            p.m.</date>
                    </dateline>
                </opener>
                <p>1615. Reurtel 1659 Oct 24.<anchor n="21"
                        xml:id="d195-f1"/> For your confidential info current shipments tanks from Belg to Argentina are within
                    requirements, which Army expects to recognize for Argentina under Western
                    Hemisphere Defense Program. For this reason and because Belg’s urgent need gram
                    Dept does not wish raise any objection continued exchange tanks and cereals.
                    Please arrange however give us notice all tank shipments as far in advance as
                    possible.</p>
                <p>Sent Brussels, repeated Buenos Aires.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Marshall</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d195-f1" n="21" xml:id="d195-f1-content">
                <p>For text, see A–505, November 3, to Buenos Aires, <ref target="#pg232">p.
                        232</ref>.</p>
            </note>
