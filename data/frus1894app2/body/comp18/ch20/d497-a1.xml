    <text>
        <body>
            <div xml:id="d497-a1">

                <pb facs="1323" n="1317" sameAs="frus:frus1894app2/pg1317"/>

                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Executive Mansion</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1894-05-29"><hi rendition="#italic">May 29,
                        1894</hi></date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">The President</hi>:</p>
                <p>The Secretary of State has the honor to lay before the President a copy of a
                    dispatch from our minister at Honolulu, No. 55, of May 14, 1894, in regard to
                    the election of delegates to the constitutional convention on the 2d
                    instant.</p>
                <p>Respectfully submitted.</p>
                <closer><signed><hi rendition="#small-caps">W. Q. Gresham.</hi></signed>
                    <lb/>
                    <dateline rendition="#float-left"><hi rendition="#small-caps">Department of
                            State</hi>,<lb/><placeName><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1894-05-29"><hi rendition="#italic">May 29,
                        1894</hi></date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
