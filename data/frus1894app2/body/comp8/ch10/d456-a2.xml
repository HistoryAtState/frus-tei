    <text>
        <body>
            <div xml:id="d456-a2">

                <pb facs="1233" n="1227" sameAs="frus:frus1894app2/pg1227"/>

                <opener>
                    <seg rendition="#float-left">No. 35.]</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Honolulu, Hawaiian Islands</hi></placeName>, <date
                            calendar="gregorian" when="1894-02-10"><hi rendition="#italic">February
                                10, 1894</hi></date>.</dateline>
                </opener>
                <p rendition="#flush">Hon. <hi rendition="#small-caps">W. Q. Gresham</hi>,<lb/><hi
                        rendition="#italic">Secretary of State:</hi></p>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your dispatches numbered 8 and 9.</p>
                <p>Very respectfully,</p>
                <closer><signed><hi rendition="#small-caps">Albert S. Willis.</hi></signed></closer>
            </div>
        </body>
