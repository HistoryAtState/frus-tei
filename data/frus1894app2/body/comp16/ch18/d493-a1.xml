    <text>
        <body>
            <div xml:id="d493-a1">

                <pb facs="1319" n="1313" sameAs="frus:frus1894app2/pg1313"/>

                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1894-04-21"><hi rendition="#italic">April 21,
                        1894</hi></date>.</dateline></opener>
                <p rendition="#flush">The <hi rendition="#small-caps">President</hi>:</p>
                <p>The Secretary of State has the honor to lay before the President copies of
                    dispatch No. 47, under date of April 5, 1894, from our minister at Honolulu, and
                    reply thereto.</p>
                <p>Dispatch No. 46, received by the same mail, transmits the minister’s salary
                    account.</p>
                <p>Respectfully submitted.</p>
                <closer><signed><hi rendition="#small-caps">W. Q. Gresham.</hi></signed></closer>
            </div>
        </body>
    </text>
