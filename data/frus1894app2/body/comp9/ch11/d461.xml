    <text>
        <body>
            <div xml:id="d461">

                <pb facs="1250" n="1244" sameAs="frus:frus1894app2/pg1244"/>

                <head><hi rendition="#italic">Mr. Willis to Mr.
                            Gresham.</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 7]</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Honolulu</hi></placeName>, <date calendar="gregorian"
                            when="1893-12-01"><hi rendition="#italic">December 1,
                        1893</hi></date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a
                    printed statement presented by Hon. S. M. Damon, minister of finance, showing
                    the financial condition of the Provisional Government for week ending November
                    29, 1893.</p>
                <p>With high regard, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Albert S. Willis.</hi></signed></closer>


                <xi:include href="d461-a1.xml" xpointer="d461-a1"/>
