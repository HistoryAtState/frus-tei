                        <cell>Loan fund account balance</cell>
                        <cell rendition="#border-bottom" role="num">368.89</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell>Total treasury balance</cell>
                        <cell/>
                        <cell role="num">$136,850.73</cell>
                    </row>
                </table>
                <pb facs="1251" n="1245" xml:id="pg1245"/>
