    <text>
        <body>
            <div xml:id="d501">

                <pb facs="1326" n="1320" sameAs="frus:frus1894app2/pg1320"/>

                <head><hi rendition="#italic">Mr. Willis to Mr.
                            Gresham.</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 58.]</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Honolulu</hi></placeName>, <date calendar="gregorian"
                            when="1894-06-02"><hi rendition="#italic">June 2,
                        1894</hi></date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: For several weeks the executive council
                    have been engaged in preparing a new constitution to be submitted to the
                    convention. This was done yesterday, and on Monday, June 4, the debate upon it
                    Will begin. I inclose three copies of the proposed constitution.</p>
                <p>Very respectfully, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Albert S. Willis.</hi></signed></closer>


                <xi:include href="d501-a1.xml" xpointer="d501-a1"/>
