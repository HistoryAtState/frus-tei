    <text>
        <body>
            <div xml:id="d23-a1">

                <pb facs="0113" n="107" sameAs="frus:frus1894app2/pg107"/>

                <p rendition="#flush"><hi rendition="#small-caps">To the Senate of the United
                        States</hi>:</p>
                <p>I transmit to the Senate a report from the Secretary of State, with accompanying
                    papers, in answer to their resolution of the 2d instant.</p>
                <closer><signed><hi rendition="#small-caps">Franklin Pierce.</hi></signed>
                    <lb/>
                    <dateline rendition="#float-left"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1854-03-03"><hi rendition="#italic">March 3,
                        1854</hi></date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
