    <text>
        <body>
            <div xml:id="d6-a10">

                <pb facs="0056" n="50" sameAs="frus:frus1894app2/pg50"/>

                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Her Britannic Majesty’s Ship Carysfort</hi>,<lb/><hi
                                rendition="#italic">Woahoo</hi></placeName>, <date
                            calendar="gregorian" when="1843-02-17"><hi rendition="#italic">February
                                17, 1843</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to notify you that Her
                    Britannic Majesty’s ship <hi rendition="#italic">Carysfort</hi>, under my
                    command, will be prepared to make an immediate attack upon this town at 4 p.m.
                    to-morrow (Saturday) in the event of the demands now forwarded by me to the King
                    of these islands not being complied with by this time.</p>
                <p>I have the honor to be, etc.,</p>
                <closer><signed><hi rendition="#small-caps">George Paulet</hi>,<lb/><hi
                            rendition="#italic">Captain.</hi></signed></closer>
            </div>
        </body>
    </text>
