            <div xml:id="d7">

                <pb facs="0059" n="53" xml:id="pg53"/>

                <head>No. 23.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps">U.
                                S. Commercial Agency</hi>,<lb/><hi rendition="#italic">Oahu,
                                Sandwich Islands</hi></placeName>, <date calendar="gregorian"
                            when="1843-03-11"><hi rendition="#italic">March 11,
                        1843</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: The document herewith inclosed has been
                    received at this office from His Majesty the King of these islands, with a
                    request that it be forwarded to the President of the United States by the
                    earliest opportunity.</p>
                <p>I have the honor to remain, sir, etc.,</p>
                <closer><signed>
                        <list>
                            <item><hi rendition="#small-caps">Wm. Hooper</hi>,<lb/><hi
                                    rendition="#italic">Acting U. S. Commercial Agent.</hi></item>
                            <item>Hon. <hi rendition="#small-caps">Daniel Webster</hi>,<lb/><hi
                                    rendition="#italic">Secretary of State, Washington
                                City.</hi></item>
                        </list>
                    </signed></closer>
















