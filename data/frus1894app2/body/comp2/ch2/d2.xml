                <pb facs="0011" n="5" sameAs="frus:frus1894app2/pg5"/>

                <head>[Untitled]</head>
                <p rendition="#center"><hi rendition="#small-caps">February</hi> 17, 1893.—Read,
                    referred to the Committee on Foreign Relations, and ordered to be printed.</p>
                <p rendition="#flush"><hi rendition="#italic">To the Senate:</hi></p>
                <p>I transmit herewith a letter from the Secretary of State of the 15th instant,
                    covering a report with accompanying correspondence respecting relations between
                    the United States and the Hawaiian Islands from September, 1820, to January,
                    1803.</p>
                <closer><signed><hi rendition="#small-caps">Benj. Harrison.</hi></signed>
                    <lb/>
                    <dateline rendition="#float-left"><hi rendition="#small-caps">Executive
                            Mansion</hi>,<lb/><placeName><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1893-02-16"><hi rendition="#italic">February 16,
                        1893</hi></date>.</dateline>
                </closer>




                <xi:include href="d2-a1.xml" xpointer="d2-a1"/>
