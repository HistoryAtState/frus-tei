    <text>
        <body>
            <div xml:id="d434">

                <pb facs="1189" n="1183" sameAs="frus:frus1894app2/pg1183"/>

                <head><hi rendition="#italic">Mr. Foster to Mr.
                            Stevens.</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 73.]</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1893-02-16"><hi rendition="#italic">February 16,
                        1893</hi></date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I append on the overleaf a copy of a
                    telegram sent to you on the 14th instant relative to the Hawaiian
                    revolution.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John W. Foster.</hi></signed></closer>
            </div>
        </body>
    </text>
