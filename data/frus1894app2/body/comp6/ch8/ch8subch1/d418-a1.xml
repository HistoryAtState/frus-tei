    <text>
        <body>
            <div xml:id="d418-a1">

                <pb facs="1179" n="1173" sameAs="frus:frus1894app2/pg1173"/>

                <opener><seg rendition="#center">[Inclosure.]</seg></opener>
                <head><hi rendition="#italic">Mr. Soley to Mr. Blaine.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Navy Department</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1890-08-14"><hi rendition="#italic">August 14,
                        1890</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith, for
                    your information, a copy of a dispatch, dated the 29th ultimo, from the
                    commander-in-chief of the United States naval force on the Pacific station,
                    regarding political affairs in the Hawaiian Islands.</p>
                <p>Very respectfully,</p>
                <closer><signed><hi rendition="#small-caps">J. R. Soley</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary of the Navy.</hi></signed></closer>
            </div>
        </body>
