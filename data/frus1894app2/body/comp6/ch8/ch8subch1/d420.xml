    <text>
        <body>
            <div xml:id="d420">

                <pb facs="1182" n="1176" sameAs="frus:frus1894app2/pg1176"/>

                <head><hi rendition="#italic">Mr. Blaine to Mr.
                            Stevens.</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 9.]</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1890-11-12"><hi rendition="#italic">November 12,
                        1890</hi></date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir.</hi>: I have received your No. 7 of the 22d
                    October last, favoring the establishment of a coal depot at Honolulu, for the
                    use of our naval force.</p>
                <p>A copy has been sent to the Secretary of the Navy.</p>
                <p>I am, sir, etc.,</p>
                <closer><signed><hi rendition="#small-caps">James G. Blaine.</hi></signed></closer>
            </div>
        </body>
    </text>
