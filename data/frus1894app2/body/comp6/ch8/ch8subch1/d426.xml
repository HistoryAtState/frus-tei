    <text>
        <body>
            <div xml:id="d426">

                <pb facs="1184" n="1178" sameAs="frus:frus1894app2/pg1178"/>

                <head><hi rendition="#italic">Mr. Foster to Mr. Stevens.</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 57.]</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1892-09-29"><hi rendition="#italic">September 29,
                        1892</hi></date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have received your No. 65 (confidential)
                    of the 14th instant, describing the deadlock existing between the Hawaiian
                    legislature and the Queen over the constitution of a ministry, and have inclosed
                    a copy to the Secretary of the Navy for his confidential information.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John W. Foster.</hi></signed></closer>
            </div>
        </body>
