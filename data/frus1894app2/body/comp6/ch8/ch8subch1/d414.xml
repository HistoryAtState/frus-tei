    <text>
        <body>
            <div xml:id="d414">

                <pb facs="1177" n="1171" sameAs="frus:frus1894app2/pg1171"/>

                <head><hi rendition="#italic">Mr. Adee to Mr.
                            Stevens.</hi></head>
                <opener><seg rendition="#center">[Confidential.]</seg></opener>
                <opener>
                    <seg rendition="#float-left">No. 11.]</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1889-11-16"><hi rendition="#italic">November 16,
                        1889</hi></date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I herewith, inclose for your confidential
                    information a copy of the instructions addressed by the Secretary of the Navy
                    (and received with his letter of the 13th instant) to the commanding officer of
                    the United States naval force of the Pacific station, relative to the retention
                    of a sufficient number of vessels of his fleet in Hawaiian waters during the
                    approaching February elections for the prompt protection of American interests
                    should occasion arise.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alvey A. Adee</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>



                <xi:include href="d414-a1.xml" xpointer="d414-a1"/>
