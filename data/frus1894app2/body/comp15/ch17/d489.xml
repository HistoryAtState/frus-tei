                <head>[Untitled]</head>
                <p rendition="#center"><hi rendition="#small-caps">April</hi> 13, 1894.—Read,
                    referred to the Committee on Foreign Relations, and ordered to be printed.</p>
                <p rendition="#flush"><hi rendition="#italic">To the Congress:</hi></p>
                <p>I transmit herewith copies of certain dispatches from the United States minister
                    at Honolulu, received by the Secretary of State since my message of March 19,
                    1894.</p>
                <closer><signed><hi rendition="#small-caps">Grover Cleveland.</hi></signed>
                    <lb/>
                    <dateline rendition="#float-left"><hi rendition="#small-caps">Executive
                            Mansion</hi>,<lb/><date calendar="gregorian" when="1894-04-13"><hi
                                rendition="#italic">April 13, 1894</hi></date>.</dateline>
                </closer>


                <xi:include href="d489-a1.xml" xpointer="d489-a1"/>
