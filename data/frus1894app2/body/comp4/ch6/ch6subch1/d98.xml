                <pb facs="0278" n="272" sameAs="frus:frus1894app2/pg272"/>

                <head><hi rendition="#italic">Mr. Blaine to Mr. Merrill.</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 131.]</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1889-06-20"><hi rendition="#italic">June 20,
                        1889</hi></date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your dispatches numbered 239 to 242,
                    inclusive, have been received.</p>
                <p>I am, sir, etc.,</p>
                <closer><signed><hi rendition="#small-caps">James G. Blaine.</hi></signed></closer>
            </div>
        </body>
