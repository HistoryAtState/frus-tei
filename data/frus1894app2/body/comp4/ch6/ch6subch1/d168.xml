                <pb facs="0360" n="354" sameAs="frus:frus1894app2/pg354"/>

                <head><hi rendition="#italic">Mr. Wharton to Mr. Stevens.</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 39.]</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1892-03-03"><hi rendition="#italic">March 3,
                        1892</hi></date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have received your No. 46, of 8th ultimo,
                    in which you give a careful review of the political situation in Hawaii.</p>
                <p>I am, sir, etc.,</p>
                <closer><signed><hi rendition="#small-caps">William F. Wharton</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
