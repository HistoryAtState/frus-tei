    <text>
        <body>
            <div xml:id="d141">

                <pb facs="0340" n="334" sameAs="frus:frus1894app2/pg334"/>

                <head><hi rendition="#italic">Mr. Wharton to Mr. Stevens.</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 4.]</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1890-09-10"><hi rendition="#italic">September 10,
                        1890</hi></date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose copy of a letter of the Secretary
                    of the Navy and a copy of the report therewith on the serious political
                    situation in Hawaii, which as confirmatory of your No. 30 of the 19th ultimo
                    will doubtless be read with interest.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">William F.
                    Wharton.</hi></signed></closer>
            </div>
        </body>
