    <text>
        <body>
            <div xml:id="d119">

                <pb facs="0303" n="297" sameAs="frus:frus1894app2/pg297"/>

                <head><hi rendition="#italic">Mr. Blaine to Mr.
                            Stevens.</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 7.]</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1889-11-04"><hi rendition="#italic">November 4,
                        1889</hi></date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    interesting dispatch of the 17th ultimo, relating to the trial of the persons
                    concerned in the revolutionary movement of July 30 last, at Honolulu.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">James G. Blaine.</hi></signed></closer>
            </div>
        </body>
    </text>
