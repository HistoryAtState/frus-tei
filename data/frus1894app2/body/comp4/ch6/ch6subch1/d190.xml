                <pb facs="0391" n="385" sameAs="frus:frus1894app2/pg385"/>

                <head><hi rendition="#italic">Mr. Foster to Mr. Stevens.</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 68.]</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1892-12-23"><hi rendition="#italic">December 23,
                        1892</hi></date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    dispatch No. 75, of the 28th ultimo, regarding confidential dispatches.</p>
                <p>I am, sir,</p>
                <closer><signed><hi rendition="#small-caps">John W. Foster.</hi></signed></closer>
            </div>
        </body>
    </text>
