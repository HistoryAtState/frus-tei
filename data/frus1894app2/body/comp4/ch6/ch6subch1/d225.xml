    <text>
        <body>
            <div xml:id="d225">

                <pb facs="0426" n="420" sameAs="frus:frus1894app2/pg420"/>

                <head><hi rendition="#italic">Mr. Adee to Mr. Stevens.</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 82.]</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1893-04-27"><hi rendition="#italic">April 27,
                        1893</hi></date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have received your dispatches numbered 89
                    and 94, of 7th ultimo and 4th instant, and with reference thereto append a copy
                    of a telegram<anchor n="*" xml:id="d225-f1"/> of 25th instant accepting your
                    resignation.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alvey A. Adee</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d225-f1" n="*" xml:id="d225-f1-content">
                <p>See under date of April 25, 1893.</p>
            </note>
        </listAnnotation>
