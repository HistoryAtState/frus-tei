    <text>
        <body>
            <div xml:id="d121">

                <pb facs="0304" n="298" sameAs="frus:frus1894app2/pg298"/>

                <head><hi rendition="#italic">Mr. Blaine to Mr. Stevens.</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 8.]</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1889-11-06"><hi rendition="#italic">November 6,
                        1889</hi></date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit for your confidential
                    information a copy of a letter from the Secretary of the Navy, and its
                    inclosure, relating to the political situation in Hawaii; also, a copy of the
                    reply of this Department.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">James G. Blaine.</hi></signed></closer>





