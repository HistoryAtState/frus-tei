    <text>
        <body>
            <div xml:id="d189">

                <pb facs="0391" n="385" sameAs="frus:frus1894app2/pg385"/>

                <head><hi rendition="#italic">Mr. Foster to Mr.
                            Stevens.</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 67.]</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1892-12-23"><hi rendition="#italic">December 23,
                        1892</hi></date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    dispatch No. 74, of the 20th of November, marked “confidential,” relative to the
                    financial and political condition of Hawaii, which has been read with
                    interest.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John W. Foster.</hi></signed></closer>
            </div>
        </body>
    </text>
