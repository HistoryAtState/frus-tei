    <text>
        <body>
            <div xml:id="d155">

                <pb facs="0351" n="345" sameAs="frus:frus1894app2/pg345"/>

                <head><hi rendition="#italic">Mr. Blaine to Mr. Stevens.</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 16.]</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State,</hi><lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1891-03-02"><hi rendition="#italic">March 2,
                        1891</hi></date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have received your Nos. 21–30, and 21 <hi
                        rendition="#italic">bis</hi> of the old series, and Nos. 1–16 and No. 18 of
                    the new series.</p>
                <p>I am, sir, etc.,</p>
                <closer><signed><hi rendition="#small-caps">James G. Blaine.</hi></signed></closer>
            </div>
        </body>
    </text>
