                <pb facs="0381" n="375" sameAs="frus:frus1894app2/pg375"/>

                <head><hi rendition="#italic">Mr. Foster to Mr. Stevens.</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 61.]</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1892-11-05"><hi rendition="#italic">November 5,
                        1892</hi></date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have received and read with attention
                    your dispatch No. 71, of the 19th ultimo, in relation to the Hawaiian political
                    situation.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John W. Foster.</hi></signed></closer>
            </div>
        </body>
    </text>
