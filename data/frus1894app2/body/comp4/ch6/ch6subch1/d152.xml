    <text>
        <body>
            <div xml:id="d152">

                <pb facs="0348" n="342" sameAs="frus:frus1894app2/pg342"/>

                <head><hi rendition="#italic">Mr. Stevens to Mr. Blaine.</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 19.]</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">United
                                States Legation</hi>,<lb/><hi rendition="#italic"
                            >Honolulu</hi></placeName>, <date calendar="gregorian" when="1891-02-16"
                                ><hi rendition="#italic">February 16, 1891</hi></date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: The Chamber of Commerce of Honolulu, an
                    important commercial body, wishing to express thanks to the United States
                    Government and to the people of California for the honors and kindness shown to
                    the late King Kalakaua in his visit, illness, and death, has adopted
                    resolutions, an engrossed copy of which is here inclosed, which is forwarded to
                    the Department of State agreeably to request.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John L. Stevens.</hi></signed></closer>



                <xi:include href="d152-a1.xml" xpointer="d152-a1"/>
            </div>
