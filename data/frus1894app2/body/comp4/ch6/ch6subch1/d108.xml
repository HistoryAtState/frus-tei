                <pb facs="0295" n="289" xml:id="pg289"/>

                <head><hi rendition="#italic">Mr. Wharton to Mr.
                            Merrill.</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 137.]</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1889-08-22"><hi rendition="#italic">August 22,
                        1889</hi></date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    Nos. 243–256.</p>
                <p>I am etc.,</p>
                <closer><signed><hi rendition="#small-caps">William F. Wharton</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>
            </div>
