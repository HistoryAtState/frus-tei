    <text>
        <body>
            <div xml:id="d223">

                <pb facs="0426" n="420" xml:id="pg420"/>

                <head><hi rendition="#italic">Mr. Gresham to Mr.
                            Stevens.</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 81.]</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1893-04-18"><hi rendition="#italic">April 18,
                        1893</hi></date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have received your No. 92, of the 15th
                    ultimo, relative to the Provisional Government recently established in Hawaii,
                    and the attitude of the British and Japanese representatives with respect
                    thereto.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. Q. Gresham.</hi></signed></closer>
            </div>
        </body>
    </text>
