    <text>
        <body>
            <div xml:id="d209">

                <pb facs="0415" n="409" xml:id="pg409"/>

                <head><hi rendition="#italic">Mr. Wharton to Mr. Stevens.</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 75.]</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1893-02-23"><hi rendition="#italic">February 23,
                        1893</hi></date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I append a copy of your telegram<anchor
                        n="*" xml:id="d209-f1"/> of 8th instant on Hawaiian affairs.</p>
                <p>I am, sir, etc.,</p>
                <closer><signed><hi rendition="#small-caps">William F.
                    Wharton.</hi></signed></closer>
            </div>
        </body>
    </text>
