    <text>
        <body>
            <div xml:id="d375">

                <pb facs="1114" n="1108" xml:id="pg1108"/>

                <head>No. 28.<lb/><hi rendition="#italic">Mr. John H. Soper to Mr.
                    Blount.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Headquarters of the Volunteer Forges of the Provisional Government
                                of the Hawaiian Islands</hi>,<lb/><hi rendition="#italic"
                                >Honolulu</hi></placeName>, <date calendar="gregorian"
                            when="1893-06-20"><hi rendition="#italic">June 20,
                        1893</hi></date>.</dateline></opener>
                <p rendition="#flush">His Excellency; <hi rendition="#small-caps">James H.
                        Blount</hi>,<lb/><hi rendition="#italic">United States Minister:</hi></p>
                <p><hi rendition="#small-caps">Sir</hi>: I beg to transmit herewith memorandum of
                    arms and ammunition, as per your request.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer><signed><hi rendition="#small-caps">Jno. H. Soper</hi>,<lb/><hi
                            rendition="#italic">Colonel, Commanding National Guard of
                        Honolulu.</hi></signed></closer>


                <xi:include href="d375-a1.xml" xpointer="d375-a1"/>
            </div>
