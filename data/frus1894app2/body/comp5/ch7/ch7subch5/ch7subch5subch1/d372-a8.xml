    <text>
        <body>
            <div xml:id="d372-a8">

                <pb facs="1085" n="1079" sameAs="frus:frus1894app2/pg1079"/>

                <head><hi rendition="#italic">Application for naturalization.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Hawaiian Islands</hi></placeName>, <date
                            ana="#date_undated-inferred-from-document-content-and-sibling-dates"
                            calendar="gregorian" when="1893-06-20">—— ——,
                    18—</date>.</dateline></opener>
                <p rendition="#flush">To His Excellency—— ——,<lb/><hi rendition="#italic">Minister
                        of the Interior:</hi></p>
                <p>The undersigned, a native of the city of——, district or county of——, state of——,
                    country——, respectfully represents that he has resided in the Hawaiian Kingdom
                    for—— years next preceding this application; that his present place of <pb
                        facs="1086" n="1080" xml:id="pg1080"/> residence is ——; that it is his
                    intention to become a permanent resident of the Kingdom; that “he is not a
                    pauper nor a refugee from the justice of some other country,” and he prays that
                    he may be allowed to take the oath of naturalization as provided by law.</p>
                <p>We concur,</p>
                <closer>—— ——,<lb/><hi rendition="#italic">Minister of Foreign Affairs</hi>.<lb/>——
                        ——,<lb/><hi rendition="#italic">Minister of Finance</hi>.<lb/>—— ——,<lb/><hi
                        rendition="#italic">Attorney General</hi>.<lb/>—— ——,<lb/><hi
                        rendition="#italic">Minister of the Interior</hi>.</closer>
                <postscript>
                    <p>Approved————, 18—.</p>
                </postscript>
            </div>
        </body>
    </text>
