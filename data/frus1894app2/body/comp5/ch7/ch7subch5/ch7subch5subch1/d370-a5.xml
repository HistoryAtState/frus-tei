    <standOff>
        <listAnnotation>
            <note corresp="#d370-f1" n="*" type="source" xml:id="d370-f1-content">
                <p>Mr. Alexander now estimates the Bishop estate at 420,000 acres.— F. C. P.</p>
            </note>
        </listAnnotation>
