                <pb facs="1080" n="1074" xml:id="pg1074"/>

                <head>No. 5.—<hi rendition="#italic">Summary of the lands of the estate of Bernice
                        Pauahi Bishop.</hi><anchor n="*" xml:id="d370-f1"/></head>
                <table cols="3" rend="bordered" rows="15">
                    <row role="label">
                        <cell>Islands.</cell>
                        <cell>Districts.</cell>
                        <cell>Areas.</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell/>
                        <cell><hi rendition="#italic">Acres</hi>.</cell>
                    </row>
                    <row>
                        <cell>Hawaii</cell>
                        <cell>Hilo</cell>
                        <cell role="num">5,843</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell>Hamakua</cell>
                        <cell role="num">8,014</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell>Kohala</cell>
                        <cell role="num">3,000</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell>North Kona</cell>
                        <cell role="num">153,290</cell>
                    </row>
                    <row>
                        <cell/>
