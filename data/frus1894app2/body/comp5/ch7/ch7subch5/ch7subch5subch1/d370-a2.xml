    <text>
        <body>
            <div xml:id="d370-a2">

                <pb facs="1078" n="1072" xml:id="pg1072"/>

                <head>No. 2.—<hi rendition="#italic">Table showing the acreage on which taxes have
                        been paid by various nationalities in the Hawaiian Islands, compiled from
                        the reports of the tax assessors and collectors of the four divisions into
                        which the islands are divided, for the annual period of
                    1891–’92.</hi></head>
                <table cols="9" rend="bordered" rows="6">
                    <row role="label">
                        <cell>Taxation division.</cell>
                        <cell>Islands.</cell>
                        <cell>Americans and Europeans.</cell>
                        <cell>Natives.</cell>
                        <cell>Half-castes.</cell>
                        <cell>Chinese.</cell>
                        <cell>Japanese.</cell>
                        <cell>Other nationalities.</cell>
                        <cell>Total.</cell>
                    </row>
                    <row>
                        <cell>1</cell>
                        <cell>Oahu</cell>
                        <cell role="num">177,168</cell>
                        <cell role="num">38,123</cell>
                        <cell role="num">70.949</cell>
                        <cell role="num"><hi rendition="#superscript">*</hi>6,042</cell>
                        <cell role="num">200</cell>
                        <cell>None.</cell>
                        <cell role="num">292,482</cell>
                    </row>
                    <row>
                        <cell>2</cell>
                        <cell>Maui, Lanai, and Molokai.</cell>
                        <cell role="num">227,115</cell>
                        <cell role="num">29,410</cell>
                        <cell role="num">78,526</cell>
                        <cell role="num"><hi rendition="#superscript">*</hi>3,733</cell>
                        <cell>None.</cell>
                        <cell>None.</cell>
                        <cell role="num">338,784</cell>
                    </row>
                    <row>
                        <cell>3</cell>
                        <cell>Hawaii</cell>
                        <cell role="num">479,384</cell>
                        <cell role="num">159,733</cell>
                        <cell role="num">377,998</cell>
                        <cell role="num">2,541</cell>
                        <cell>None.</cell>
                        <cell>None.</cell>
                        <cell role="num">1,019.650</cell>
                    </row>
                    <row>
                        <cell>4</cell>
                        <cell>Kauai and Niihau.</cell>
                        <cell role="num">168,825</cell>
                        <cell role="num">30,191</cell>
                        <cell role="num">4,072</cell>
                        <cell role="num">8</cell>
                        <cell>None.</cell>
                        <cell>None.</cell>
                        <cell role="num">203,096</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell>Total</cell>
                        <cell role="num">1,052,492</cell>
                        <cell role="num">257,457</cell>
                        <cell role="num">531,545</cell>
                        <cell role="num">12,324</cell>
                        <cell role="num">200</cell>
                        <cell>None.</cell>
                        <cell role="num">1,854,018</cell>
                    </row>
                </table>
                <p><hi rendition="#superscript">*</hi>Mostly leased.</p>
                <p rendition="#center"><hi rendition="#italic">Percentages of acreage.</hi></p>
                <table cols="2" rows="6">
                    <row role="label">
                        <cell>Americans and Europeans</cell>
                        <cell role="num">56.77</cell>
                    </row>
                    <row>
                        <cell>Natives</cell>
                        <cell role="num">13.89</cell>
                    </row>
                    <row>
                        <cell>Half-castes</cell>
                        <cell role="num">28.67</cell>
                    </row>
                    <row>
                        <cell>Chinese</cell>
                        <cell role="num">.66</cell>
                    </row>
                    <row>
                        <cell>Japanese</cell>
                        <cell rendition="#border-bottom" role="num">.01</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell role="num">100.00</cell>
                    </row>
                </table>
                <closer><signed><hi rendition="#small-caps">Theo. C. Pouter</hi>,<lb/><hi
                            rendition="#italic">Minister of Finance.</hi></signed>
                    <lb/>
                    <dateline rendition="#float-left"><placeName><hi rendition="#small-caps"
                                >Honolula</hi></placeName>, <date calendar="gregorian"
                            when="1893-05-10"><hi rendition="#italic">May 10,
                        1893</hi></date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
