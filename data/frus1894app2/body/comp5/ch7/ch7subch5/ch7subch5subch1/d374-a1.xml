    <text>
        <body>
            <div xml:id="d374-a1">

                <pb facs="1112" n="1106" sameAs="frus:frus1894app2/pg1106"/>

                <head><hi rendition="#italic">Approximate division of the lands of the Hawaiian
                        Kingdom, 1848–1855.</hi></head>
                <table cols="2" rows="9">
                    <row>
                        <cell/>
                        <cell>Acres.</cell>
                    </row>
                    <row>
                        <cell>Crown lands (as in 1893)</cell>
                        <cell role="num">915,000</cell>
                    </row>
                    <row>
                        <cell>Government lands (as in 1848)</cell>
                        <cell role="num">1,495,000</cell>
                    </row>
                    <row>
                        <cell>Kuleanas</cell>
                        <cell role="num">28,658.5</cell>
                    </row>
                    <row>
                        <cell>Bishop estate for manual training schools (as in 1893)</cell>
                        <cell role="num">420,000</cell>
                    </row>
                    <row>
                        <cell>Other chiefs’ lands surveyed before 1855</cell>
                        <cell role="num">133,012.6</cell>
                    </row>
                    <row>
                        <cell>Other chiefs’ lands not surveyed before 1855</cell>
                        <cell rendition="#border-bottom" role="num">1,018,329</cell>
                    </row>
                    <row>
                        <cell>Grand total</cell>
                        <cell role="num">4,010,000.1</cell>
                    </row>
                    <row>
                        <cell>Total of chiefs’ lands, including Bishop estate</cell>
                        <cell role="num">1,571,341</cell>
                    </row>
                </table>
                <p>E. &amp; O. E.</p>
                <closer><signed><hi rendition="#small-caps">W. D. Alexander.</hi></signed></closer>
            </div>
