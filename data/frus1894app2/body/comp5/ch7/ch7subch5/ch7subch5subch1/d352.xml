                <pb facs="1063" n="1057" sameAs="frus:frus1894app2/pg1057"/>

                <head>No. 5.<lb/><hi rendition="#italic">Mr. Stevens to Mr. Walker.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Legation</hi>,<lb/><hi rendition="#italic"
                                >Honolulu</hi></placeName>, <date calendar="gregorian"
                            when="1893-01-16"><hi rendition="#italic">January 16,
                        1893</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Sir</hi>: Will you let Arion Hall for use for
                    the sleeping and lodgment of the soldiers and marines of Captain Wiltse, of the
                    U. S. <hi rendition="#italic">Boston</hi>, at a fair price! Let the bearer
                    know.</p>
                <p>Yours truly,</p>
                <closer><signed><hi rendition="#small-caps">John L. Stevens</hi>,<lb/><hi
                            rendition="#italic">United States Minister.</hi></signed></closer>
            </div>
        </body>
    </text>
