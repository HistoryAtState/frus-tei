    <text>
        <body>
            <div xml:id="d363">

                <pb facs="1069" n="1063" sameAs="frus:frus1894app2/pg1063"/>

                <head>No. 16.<lb/><hi rendition="#italic">Admiral Skerrett to Mr. Blount.</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 123.]</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">U. S.
                                S. Mohican,<lb/>Flagship of the Pacific Station</hi>,<lb/><hi
                                rendition="#italic">Honolulu, Hawaiian Islands</hi></placeName>,
                            <date calendar="gregorian" when="1893-04-08"><hi rendition="#italic"
                                >April 8, 1893.</hi></date></dateline>
                </opener>
                <p rendition="#flush">Col. J. H. <hi rendition="#small-caps">Blount</hi>,<lb/><hi
                        rendition="#italic">United States Special Commissioner</hi>.</p>
                <p><hi rendition="#small-caps">Dear Sir</hi>: I have learned that the <hi
                        rendition="#italic">Boston’s</hi> battalion consists of 153 men and that of
                    the <hi rendition="#italic">Mohican’s</hi> battalion is 118 men; making a total
                    of 271 men, who can be landed if required.</p>
                <p>Very respectfully, your obedient servant,</p>
                <closer><signed><hi rendition="#small-caps">J. S. Skerrett</hi>,<lb/><hi
                            rendition="#italic">Rear Admiral U. S. Navy,<lb/>Commanding U. S. Naval
                            Force, Pacific Station</hi>.</signed></closer>
            </div>
        </body>
    </text>
