        <body>
            <div xml:id="d351">

                <pb facs="1063" n="1057" xml:id="pg1057"/>

                <head>No. 4.<lb/><hi rendition="#italic">Mr. Stevens to Mr. Gifford.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Legation</hi>,<lb/><hi rendition="#italic"
                                >Honolulu</hi></placeName>, <date calendar="gregorian"
                            when="1893-01-16"><hi rendition="#italic">January 16,
                        1893</hi>.</date></dateline></opener>
                <p rendition="#flush">Mr. W.M. <hi rendition="#small-caps">Gifford</hi>:</p>
                <p><hi rendition="#small-caps">Sir</hi>: Please allow Capt. Wiltse and his men the
                    use of the opera house hall for a fair condensation for the same.</p>
                <p>Yours, truly,</p>
                <closer><signed><hi rendition="#small-caps">John L. Stevens.</hi></signed></closer>
            </div>
        </body>
