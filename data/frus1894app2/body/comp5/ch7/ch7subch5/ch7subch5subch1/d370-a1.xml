    <text>
        <body>
            <div xml:id="d370-a1">

                <pb facs="1077" n="1071" sameAs="frus:frus1894app2/pg1071"/>

                <head>No. 1.—<hi rendition="#italic">Table showing the amount of taxes paid by
                        various nationalities in the Hawaiian Islands, compiled from the reports of
                        the tax assessors and collectors of the four divisions into which the
                        islands are divided, for the annual period of 1891–’92.</hi></head>
                <table cols="9" rend="bordered" rows="6">
                    <row role="label">
                        <cell>Taxation division.</cell>
                        <cell>Islands.</cell>
                        <cell>Americans and Europeans.</cell>
                        <cell>Natives.</cell>
                        <cell>Half-castes.</cell>
                        <cell>Chinese.</cell>
                        <cell>Japanese.</cell>
                        <cell>Other nationalities.</cell>
                        <cell>Total.</cell>
                    </row>
                    <row>
                        <cell>1</cell>
                        <cell>Oahu</cell>
                        <cell role="num">$128,048.42</cell>
                        <cell role="num">$22,898.09</cell>
                        <cell role="num">$13,278.03</cell>
                        <cell role="num">$48,237.64</cell>
                        <cell role="num">$7,915.79</cell>
                        <cell>None.</cell>
                        <cell role="num">$220,377.97</cell>
                    </row>
                    <row>
                        <cell>2</cell>
                        <cell>Maui, Lanai and Molokai.</cell>
                        <cell role="num">42,940.87</cell>
                        <cell role="num">16,687.76</cell>
                        <cell role="num">3,640.79</cell>
                        <cell role="num">14,317.49</cell>
                        <cell role="num">13,556.67</cell>
                        <cell role="num">$370.10</cell>
                        <cell role="num">91,513.68</cell>
                    </row>
                    <row>
                        <cell>3</cell>
                        <cell>Hawaii</cell>
                        <cell role="num">64,252.19</cell>
                        <cell role="num">23,705.44</cell>
                        <cell role="num">9,275.48</cell>
                        <cell role="num">11,814.36</cell>
                        <cell role="num">29,838.61</cell>
                        <cell>None.</cell>
                        <cell role="num">138,886.08</cell>
                    </row>
                    <row>
                        <cell>4</cell>
                        <cell>Kauai and Niihau.</cell>
                        <cell role="num">39,275.26</cell>
                        <cell role="num">8,095.53</cell>
                        <cell role="num">674.38</cell>
                        <cell role="num">12,896.61</cell>
                        <cell role="num">16,015.00</cell>
                        <cell role="num">359.72</cell>
                        <cell role="num">77,316.50</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell>Total</cell>
                        <cell role="num">274,516.74</cell>
                        <cell role="num">71,386.82</cell>
                        <cell role="num">26,868.68</cell>
                        <cell role="num">87,266.10</cell>
                        <cell role="num">67,326.07</cell>
                        <cell role="num">729.82</cell>
                        <cell role="num">528,094.23</cell>
                    </row>
                </table>
                <p rendition="#center"><hi rendition="#italic">Percentages of taxes.</hi></p>
                <table cols="2" rows="7">
                    <row role="label">
                        <cell>Americans and Europeans</cell>
                        <cell role="num">51.98</cell>
                    </row>
                    <row>
                        <cell>Natives</cell>
                        <cell role="num">13.52</cell>
                    </row>
                    <row>
                        <cell>Half-castes</cell>
                        <cell role="num">5.10</cell>
                    </row>
                    <row>
                        <cell>Chinese</cell>
                        <cell role="num">16.53</cell>
                    </row>
                    <row>
                        <cell>Japanese</cell>
                        <cell role="num">12.75</cell>
                    </row>
                    <row>
                        <cell>Others</cell>
                        <cell rendition="#border-bottom" role="num">.12</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell role="num">100.00</cell>
                    </row>
                </table>
                <p>The above tax includes poll and school taxes.</p>
                <closer><signed><hi rendition="#small-caps">Theo. C. Porter</hi>,<lb/><hi
                            rendition="#italic">Minister of Finance.</hi></signed>
                    <lb/>
                    <dateline rendition="#float-left"><placeName><hi rendition="#small-caps"
                                >Honolula</hi></placeName>, <date calendar="gregorian"
                            when="1893-05-10"><hi rendition="#italic">May 10,
                        1893</hi></date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
