                <pb facs="1397" n="1391" sameAs="frus:frus1894app2/pg1391"/>

                <head>[Untitled]</head>
                <p rendition="#center"><hi rendition="#small-caps">February</hi> 4, 1895.—Referred
                    to the Committee on Foreign Affairs and ordered to be printed.</p>
                <p rendition="#flush"><hi rendition="#italic">To the House of
                    Representatives:</hi></p>
                <p>In response to the resolution of the House of Representatives of the 1st instant,
                    calling for certain information touching the recent insurrection in the Hawaiian
                    Islands, I transmit herewith a report of the Secretary of State, with
                    accompanying papers.</p>
                <closer><signed><hi rendition="#small-caps">Grover Cleveland.</hi></signed>
                    <lb/>
                    <dateline rendition="#float-left"><hi rendition="#small-caps">Executive
                            Mansion</hi>,<lb/><placeName><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-02-04"><hi rendition="#italic">February 4,
                        1895</hi></date>.</dateline>
                </closer>


                <xi:include href="d514-a1.xml" xpointer="d514-a1"/>
