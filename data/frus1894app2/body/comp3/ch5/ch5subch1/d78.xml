                <pb facs="0227" n="221" sameAs="frus:frus1894app2/pg221"/>

                <head>No. 7.<lb/><hi rendition="#italic">Mr. Tracy to Mr. Foster.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Navy Department</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1893-01-28"><hi rendition="#italic">January 28, 1893</hi></date>.
                        (Received January 28.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose for your
                    information a copy of a dispatch received this date from Capt. G. C. Wiltse,
                    commanding officer U. S. S. <hi rendition="#italic">Boston</hi>.</p>
                <p>I have, etc,</p>
                <closer><signed><hi rendition="#small-caps">B. F. Tracy</hi>,<lb/><hi
                            rendition="#italic">Secretary of the Navy.</hi></signed></closer>


                <xi:include href="d78-a1.xml" xpointer="d78-a1"/>
