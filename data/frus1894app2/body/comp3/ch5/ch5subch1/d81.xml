    <text>
        <body>
            <div xml:id="d81">

                <pb facs="0229" n="223" sameAs="frus:frus1894app2/pg223"/>

                <head>No. 10.<lb/><hi rendition="#italic">Mr. Tracy to Mr. Foster.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Navy Department</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1893-02-03"><hi rendition="#italic">February 3, 1893</hi></date>.
                        (Received February 3.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith a
                    copy of a communication received this day from Capt. G. C. Wiltse, U. S. Navy,
                    commanding the U. S. S. <hi rendition="#italic">Boston</hi>, relating to
                    Hawaiian affairs.</p>
                <p>I have the honor, etc.,</p>
                <closer><signed><hi rendition="#small-caps">B. F. Tracy</hi>,<lb/><hi
                            rendition="#italic">Secretary of the Navy.</hi></signed></closer>


                <xi:include href="d81-a1.xml" xpointer="d81-a1"/>
