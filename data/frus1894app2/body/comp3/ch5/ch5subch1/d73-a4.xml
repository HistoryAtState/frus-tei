    <text>
        <body>
            <div xml:id="d73-a4">

                <pb facs="0218" n="212" sameAs="frus:frus1894app2/pg212"/>

                <opener><seg rendition="#center">[Inclosure 4 in No. 79.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Honolulu, Hawaiian Islands</hi></placeName>, <date
                            calendar="gregorian" when="1893-01-17"><hi rendition="#italic">January
                                17, 1893</hi></date>. (Issued 6 p.m.)</dateline></opener>
                <p rendition="#center"><hi rendition="#small-caps">provisional government of the
                        hawaiian islands</hi>.</p>
                <p rendition="#center">[Order No. 2.]</p>
                <p>It is hereby ordered and decreed that until further ordered, the right of the
                    writ of habeas corpus is hereby suspended and martial law is hereby declared to
                    exist throughout the island of Oahu.</p>
                <closer><signed>
                        <list>
                            <item><hi rendition="#small-caps">Sanford B. Dole</hi>,<lb/><hi
                                    rendition="#italic">Minister of Foreign Affairs</hi>,</item>
                            <item><hi rendition="#small-caps">J. A. King</hi>,<lb/><hi
                                    rendition="#italic">Minister of the Interior</hi>,</item>
                            <item><hi rendition="#small-caps">P. C. Jones</hi>,<lb/><hi
                                    rendition="#italic">Minister of Finance</hi>,</item>
                            <item><hi rendition="#small-caps">William O. Smith</hi>,<lb/><hi
                                    rendition="#italic">Attorney-General,<lb/>Executive Council of
                                    the Provisional Government of the Hawaiian Islands.</hi></item>
                        </list>
                    </signed></closer>
            </div>
        </body>
    </text>
