    <text>
        <body>
            <div xml:id="d88">

                <pb facs="0246" n="240" xml:id="pg240"/>

                <head>No. 17.<lb/><hi rendition="#italic">Mr. Tracy
                        to Mr. Foster.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Navy Department</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1893-02-11"><hi rendition="#italic">February 11, 1893</hi>.</date>
                        (Received February 11.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit for your
                    information a copy of a translation of a cipher dispatch received this date from
                    the commanding officer of the U. S. S. <hi rendition="#italic">Boston</hi>, at
                    Honolulu, Hawaii.</p>
                <p>Very respectfully,</p>
                <closer><signed><hi rendition="#small-caps">B. F. Tracy</hi>,<lb/><hi
                            rendition="#italic">Secretary of the Navy.</hi></signed></closer>


                <xi:include href="d88-a1.xml" xpointer="d88-a1"/>
