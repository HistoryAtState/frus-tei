                <pb facs="1321" n="1315" sameAs="frus:frus1894app2/pg1315"/>

                <head>[Untitled]</head>
                <p rendition="#center"><hi rendition="#small-caps">May</hi> 9, 1894.—Referred to the
                    Committee on Foreign Relations and ordered to be printed.</p>
                <p rendition="#flush"><hi rendition="#italic">To the Congress:</hi></p>
                <p>I transmit herewith a communication from the Secretary of State in regard to
                    recent dispatches from the U. S. minister at Honolulu, received since my message
                    of April 21, 1894, and also a dispatch from the minister dated April 14,
                    1894.</p>
                <closer><signed><hi rendition="#small-caps">Grover Cleveland.</hi></signed>
                    <lb/>
                    <dateline rendition="#float-left"><hi rendition="#small-caps">Executive
                            Mansion</hi>,<lb/><placeName><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1894-05-19"><hi rendition="#italic">May 9,
                        1894</hi></date>.</dateline>
                </closer>


                <xi:include href="d495-a1.xml" xpointer="d495-a1"/>
