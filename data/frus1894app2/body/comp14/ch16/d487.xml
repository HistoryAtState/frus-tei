                <pb facs="1313" n="1307" sameAs="frus:frus1894app2/pg1307"/>

                <head>[Untitled]</head>
                <p rendition="#center"><hi rendition="#small-caps">March</hi> 20, 1894.—Read,
                    referred to the Committee on Foreign Relations, and ordered to he printed.</p>
                <p rendition="#flush"><hi rendition="#italic">To the Congress:</hi></p>
                <p>I transmit herewith a copy of a dispatch recently received from our minister at
                    Hawaii, together with copies of the inclosures which accompanied said
                    dispatch.</p>
                <closer><signed><hi rendition="#small-caps">Grover Cleveland.</hi></signed>
                    <lb/>
                    <dateline rendition="#float-left"><hi rendition="#small-caps">Executive
                            Mansion</hi>,<lb/><date calendar="gregorian" when="1894-03-19"><hi
                                rendition="#italic">March 19, 1894</hi></date>.</dateline>
                </closer>


                <xi:include href="d487-a1.xml" xpointer="d487-a1"/>
