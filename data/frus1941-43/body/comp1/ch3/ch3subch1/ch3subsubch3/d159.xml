    <text>
        <body>
            <div xml:id="d159">

                <pb facs="0360" n="286" sameAs="frus:frus1941-43/pg286"/>

                <note rend="inline" type="source">Defense Files</note>
                <head>
                    <hi rendition="#italic">The President’s Special Assistant</hi> (<hi rendition="#italic">Hopkins</hi>) <hi
                        rendition="#italic">to the Chief of Naval Operations</hi> (<hi rendition="#italic">Stark</hi>)<anchor n="1"
                        xml:id="d159-f1"/>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1941-12-30">December 30,
                        1941</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Dear Betty</hi>:<anchor n="2" xml:id="d159-f2"/> Here
                    is the redraft which the President did last night and which he would like to
                    have the Joint Staffs chew over.</p>
                <p>Cordially yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Harry</hi> L. <hi rendition="#small-caps"
                            >Hopkins</hi>
                    </signed>
                </closer>


                <xi:include href="d159-a1.xml" xpointer="d159-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d159-f1" n="1" type="source" xml:id="d159-f1-content">
