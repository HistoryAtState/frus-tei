    <text>
        <body>
            <div xml:id="d178">

                <pb facs="0384" n="310" sameAs="frus:frus1941-43/pg310"/>

                <note rend="inline" type="source">Hopkins Papers</note>
                <head>
                    <hi rendition="#italic">The Chief of Naval Operations</hi> (<hi
                        rendition="#italic">Stark</hi>) <hi rendition="#italic">to the President’s
                        Special Assistant</hi> (<hi rendition="#italic">Hopkins</hi>)</head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1942-01-06">January 6,
                        1942</date>.</dateline>
                </opener>
                <p rendition="#center"><hi rendition="#small-caps">Memorandum for Mr.
                    Hopkins</hi></p>
                <p>I am returning the papers you sent me last night.<anchor n="1" xml:id="d178-f1"
                    /></p>
                <p>Army and Navy accept the changes.</p>
                <p>Have drawn up a new paper, making it easy for the President to check:— the
                    changes are underlined and, in paragraph 4, the words which it was suggested be
                    deleted are crossed out.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Betty</hi>
                    </signed><anchor n="2" xml:id="d178-f2"/>
                </closer>



                <xi:include href="d178-a1.xml" xpointer="d178-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d178-f1" n="1" xml:id="d178-f1-content">
                <p>See Hopkins’ letter of January 5, 1942, <hi rendition="#italic">ante</hi>, <ref
                        target="#pg306">p. 306</ref>.</p>
            </note>
            <note corresp="#d178-f2" n="2" xml:id="d178-f2-content">
                <p>Nickname for Stark.</p>
            </note>
        </listAnnotation>
    </standOff>
