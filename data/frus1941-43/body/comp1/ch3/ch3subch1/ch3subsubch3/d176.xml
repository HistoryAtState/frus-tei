    <text>
        <body>
            <div xml:id="d176">

                <pb facs="0380" n="306" sameAs="frus:frus1941-43/pg306"/>

                <note rend="inline" type="source">Hopkins Papers</note>
                <head>
                    <hi rendition="#italic">The President’s Special Assistant</hi> (<hi rendition="#italic">Hopkins</hi>) <hi
                        rendition="#italic">to the Chief of Naval Operations</hi> (<hi rendition="#italic">Stark</hi>)</head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1942-01-05">January 5,
                        1942</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Dear Betty</hi>:<anchor n="1" xml:id="d176-f1"/> The
                    attached is a draft of a proposed cablegram which the Prime Minister sent to
                        me.<anchor n="2" xml:id="d176-f2"/> It relates to matters concerning the
                    Unity of Command and I am, therefore, sending it to you.</p>
                <p>Very cordially yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Harry</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d176-f1" n="1" xml:id="d176-f1-content">
                <p>Nickname for Stark.</p>
            </note>
            <note corresp="#d176-f2" n="2" xml:id="d176-f2-content">
                <p>The attachment was the draft telegram <hi rendition="#italic">supra</hi>.</p>
            </note>
        </listAnnotation>
    </standOff>
