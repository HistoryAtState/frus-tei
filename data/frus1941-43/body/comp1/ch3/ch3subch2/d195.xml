    <text>
        <body>
            <div xml:id="d195">

                <pb facs="0413" n="339" sameAs="frus:frus1941-43/pg339"/>

                <note rend="inline" type="source">W.P.B. Files</note>
                <head><hi rendition="#italic">The Executive Director of the Supply Priorities and
                        Allocations Board</hi> (<hi rendition="#italic">Nelson</hi>) <hi
                        rendition="#italic">to the President’s Special Assistant</hi> (<hi
                        rendition="#italic">Hopkins</hi>)</head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi></seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1942-01-01">January 1, 1942</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Dear Mr. Hopkins</hi>: Attached is a statement which
                    was asked for by the President and which was approved this morning by S. P. A.
                    B. </p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Donald M. Nelson</hi>
                    </signed>
                </closer>


                <xi:include href="d195-a1.xml" xpointer="d195-a1"/>
