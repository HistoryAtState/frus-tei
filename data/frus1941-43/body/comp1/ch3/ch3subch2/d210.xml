    <text>
        <body>
            <div xml:id="d210">

                <pb facs="0432" n="358" sameAs="frus:frus1941-43/pg358"/>

                <note rend="inline" type="source">Hopkins Papers</note>
                <head><hi rendition="#italic">The Legal Counsel, Office of Lend-Lease
                        Administration</hi> (<hi rendition="#italic"
                        >Cox</hi>) <hi rendition="#italic">to the Presidents Special
                        Assistant</hi> (<hi rendition="#italic"
                        >Hopkins</hi>)<anchor n="1" xml:id="d210-f1"/></head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1942-01-13">January 13,
                        1942</date>.</dateline>
                </opener>
                <p>H.L.H.: Here’s the redraft which Averell<anchor n="2" xml:id="d210-f2"/> asked me
                    to leave for you.</p>
                <p>This is the one that was worked out with and is agreeable to Sir Arthur Salter.
                    Brig[adier] Napier of General Dill’s staff also participated.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Oscar Cox</hi>
                    </signed>
                </closer>


                <xi:include href="d210-a1.xml" xpointer="d210-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d210-f1" n="1" type="source" xml:id="d210-f1-content">
                <p>The memorandum is written by hand on White House stationery.</p>
            </note>
            <note corresp="#d210-f2" n="2" xml:id="d210-f2-content">
                <p>W. Averell Harriman.</p>
            </note>
        </listAnnotation>
