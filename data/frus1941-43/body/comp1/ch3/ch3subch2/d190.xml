            <div xml:id="d190">

                <pb facs="0405" n="331" sameAs="frus:frus1941-43/pg331"/>

                <note rend="inline" type="source">Roosevelt Papers</note>
                <head><hi rendition="#italic">Mr. Marvin, of the Office of Production Management, to
                        the President </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1941-12-28">December 28,
                        1941</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Dear Mr. President</hi>, Thank you ever so much for
                    the Christmas present which you and Mrs. Roosevelt gave me. I am deeply
                    appreciative.</p>




