    <text>
        <body>
            <div xml:id="d226">

                <pb facs="0449" n="375" xml:id="pg375"/>

                <note rend="inline" type="source">Hull Papers</note>
                <head><hi rendition="#italic">The Presidents Secretary</hi> (<hi rendition="#italic"
                        >Tully</hi>) <hi rendition="#italic">to the Secretary of State </hi><anchor
                        n="1" xml:id="d226-f1"/></head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">The White House
                            Washington</hi></placeName>, <date calendar="gregorian"
                            when="1941-12-30">December 30, 1941</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Dear Mr. Secretary</hi>: The President asked me to
                    get these copies of the re-draft of the Joint Declaration to you at once.</p>
                <p>He asks that you make a copy available to the British Ambassador.</p>
                <p>Very sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Grace G. Tully</hi>
                    </signed>
                </closer>


                <xi:include href="d226-a1.xml" xpointer="d226-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d226-f1" n="1" type="source" xml:id="d226-f1-content">
                <p>The source text is a copy made in the Department of State. A copy in the Hopkins
                    Papers bears the initials of Hopkins as the drafter of the memorandum.</p>
