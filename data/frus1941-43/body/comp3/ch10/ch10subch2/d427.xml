    <text>
        <body>
            <div xml:id="d427">

                <pb facs="0896" n="810" sameAs="frus:frus1941-43/pg810"/>

                <note rend="inline" type="source">Roosevelt Papers</note>
                <head><hi rendition="#italic">The Assistant Secretary, War Department General
                        Staff</hi> (<hi rendition="#italic"
                        >McCarthy</hi>) <hi rendition="#italic">to the Presidents Special
                        Assistant</hi> (<hi rendition="#italic"
                        >Hopkins</hi>)<anchor n="1" xml:id="d427-f1"/></head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Casablanca</hi></placeName>,] <date calendar="gregorian"
                            when="1943-01-16">January 16, 1943</date>.</dateline>
                </opener>
                <p rendition="#flush"><hi rendition="#small-caps">Memorandum for Mr.
                    Hopkins</hi>:</p>
                <p>General Marshall has asked that the President be informed of the following
                    excerpt from a message received from Washington: <quote rend="blockquote">
                        <p>“State Department reports Le Brun, President of France, is now in
                            Switzerland, according to their information. They are confirming this in
                            message to Ambassador in Switzerland and will obtain further information
                            on Le Brun.”</p>
                    </quote></p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">McCarthy</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
