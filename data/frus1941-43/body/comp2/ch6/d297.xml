    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d297-f1" n="1" type="source" xml:id="d297-f1-content">
                <p>This memorandum came under discussion at the meeting of the Pacific War Council
                    on June 25, 1942; for the record of that meeting, see <hi rendition="#italic"
                        >ante</hi>, <ref target="#pg449">p. 449</ref>.</p>
            </note>
        </listAnnotation>
