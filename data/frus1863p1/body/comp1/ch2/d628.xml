    <text>
        <body>
            <div xml:id="d628">

                <pb facs="0740" n="698" sameAs="frus:frus1863p1/pg698"/>

                <head>Mr. Seward to Mr.
                        Stuart.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1863-09-30"><hi rendition="#italic"
                                >September</hi> 30, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Referring to your memorandum of the 10th
                    instant, relative to the case of Mr. J. M. Vernon, and to my reply, I have the
                    honor to enclose to you the accompanying copy of a communication of the 23d of
                    this month, addressed to this department by the Secretary of War.</p>
                <p>I have the honor to be, with high consideration, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William Stuart,</hi>
                        <hi rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d628-a1.xml" xpointer="d628-a1"/>
            </div>
