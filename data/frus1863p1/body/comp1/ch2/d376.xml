    <text>
        <body>
            <div xml:id="d376">

                <pb facs="0543" n="501" sameAs="frus:frus1863p1/pg501"/>

                <head>Mr. Seward to Lord
                        Lyons.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1863-01-29"><hi rendition="#italic"
                                >January</hi> 29, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Lord</hi>: I have the honor to acknowledge the
                    receipt of your note of the 26th instant, informing me of the letter which Earl
                    Russell caused to be addressed to the General Post Office, on receiving a copy
                    of my note to you of the 15th ultimo.</p>
                <p>I have the honor to be, with high consideration, your lordship’s obedient
                    servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p>Right Hon. <hi rendition="#small-caps">Lord Lyons</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
