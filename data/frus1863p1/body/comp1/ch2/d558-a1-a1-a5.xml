    <text>
        <body>
            <div xml:id="d558-a1-a1-a5">

                <pb facs="0676" n="634" xml:id="pg634"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">United States Gunboat Penobscot,</hi>
                            <hi rendition="#italic">Off Wilmington, N. C.,</hi></placeName>
                        <date calendar="gregorian" when="1863-05-04"><hi rendition="#italic"
                                >May</hi> 4, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I herewith enclose to the department a
                    communication, marked No. 1, from Acting Ensign S. K. Luce, referring to the
                    claim of the master of the prize schooner Golden Eagle.</p>
                <p>Very respectfully, your obedient servant,</p>
                <closer>
                    <signed><hi rendition="#small-caps">JOSEPH E. DeHAVEN,</hi>
                        <hi rendition="#italic">Lieutenant Commanding.</hi></signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">Gideon Welles,</hi>
                        <hi rendition="#italic">Secretary of the Navy, &amp;c., &amp;c.</hi></p>
                    <p>Respectfully forwarded.</p>
                    <closer>
                        <signed>H. LUDLOW CASE, <hi rendition="#italic">Captain and Senior Officer
                                present.</hi></signed></closer>
                </postscript>
                <closer>
                    <dateline rendition="#float-left">Forwarded in further explanation of the
                        complaints sent by the British minister to the Secretary of State, and
                        received by me in the department’s communication of <date
                            calendar="gregorian" when="1863-02-10">February 10,
                        1863</date>.</dateline><lb/><signed>ACTING REAR-ADMIRAL.</signed>
                </closer>


                <xi:include href="d558-a1-a1-a5-a1.xml" xpointer="d558-a1-a1-a5-a1"/>
            </div>
        </body>
    </text>
