    <text>
        <body>
            <div xml:id="d452-a3">

                <pb facs="0593" n="551" sameAs="frus:frus1863p1/pg551"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Her Britannic Majesty’s
                                Vice-Consulate</hi>, <hi rendition="#italic">Key
                            West</hi>,</placeName>
                        <date calendar="gregorian" when="1863-03-11"><hi rendition="#italic"
                                >March</hi> 11, 1863.</date></dateline></opener>
                <p>I, Aubrey George Butterfield, do hereby certify the foregoing to be a true and
                    correct copy of the original protest recorded in this office. In testimony
                    whereof, I do hereunto set my hand and seal of office, at the port of Key West,
                    this sixteenth day of March, in the year of our Lord one thousand eight hundred
                    and sixty-three.</p>
                <p><hi rendition="#small-caps">[l. s.]</hi></p>
                <closer>
                    <signed>AUBREY G. BUTTERFIELD, <hi rendition="#italic">H. B. M.
                            Vice-Consul.</hi></signed></closer>
            </div>
        </body>
