    <text>
        <body>
            <div xml:id="d353">

                <pb facs="0529" n="487" sameAs="frus:frus1863p1/pg487"/>

                <head>Mr. Seward to Lord
                        Lyons.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1863-01-07"><hi rendition="#italic"
                                >January</hi> 7, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Lord</hi>: I have the honor to acknowledge the
                    receipt of your note of the 3d instant, relative to the case of Mr. John J.
                    Shaver. In reply, I have the honor to acquaint you that a reconsideration of the
                    subject shall cheerfully be entered into.</p>
                <p>I have the honor to be, my lord, your very obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p>Right Hon. <hi rendition="#small-caps">Lord Lyons</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
