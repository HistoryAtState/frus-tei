    <text>
        <body>
            <div xml:id="d579-a1">

                <pb facs="0697" n="655" sameAs="frus:frus1863p1/pg655"/>

                <head>Mr. Stanton to Mr. Seward.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">War Department,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1863-06-27"><hi rendition="#italic"
                                >June</hi> 27, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to transmit herewith a
                    communication from the Provost Marshal General, in respect to aliens claiming
                    exemption from military <pb facs="0698" n="656" xml:id="pg656"/> service, in
                    answer to a memorandum of Lord Lyons transmitted by you to this department.</p>
                <p>I am, sir, very respectfully, your obedient servant,</p>
                <closer>
                    <signed>EDWIN M. STANTON, <hi rendition="#italic">Secretary of
                        War.</hi></signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, Secretary of
                        State.</p>
                </postscript>


                <xi:include href="d579-a1-a1.xml" xpointer="d579-a1-a1"/>
            </div>
        </body>
