    <text>
        <body>
            <div xml:id="d384">

                <pb facs="0547" n="505" xml:id="pg505"/>

                <head>Lord Lyons to Mr. Seward.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1863-02-07"><hi rendition="#italic"
                                >February</hi> 7, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Dear Sir</hi>: With reference to our official
                    correspondence relative to supplies of arms to the Indians on the frontier, I
                    send you an extract from a private letter from Lord Monck which will perhaps
                    interest you.</p>
                <p>Believe me to be, my dear sir, your faithful servant,</p>
                <closer>
                    <signed>LYONS.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">W. H. Seward</hi>, <hi rendition="#italic"
                            >Secretary of State.</hi></p>
                </postscript>


                <xi:include href="d384-a1.xml" xpointer="d384-a1"/>
            </div>
        </body>
    </text>
