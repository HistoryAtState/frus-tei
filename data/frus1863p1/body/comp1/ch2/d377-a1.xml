    <text>
        <body>
            <div xml:id="d377-a1">

                <pb facs="0543" n="501" sameAs="frus:frus1863p1/pg501"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">War Department</hi>
                            <hi rendition="#italic">Washington City</hi></placeName>, <date
                            calendar="gregorian" when="1863-01-28"><hi rendition="#italic"
                                >January</hi> 28, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge the receipt
                    of your letter of the 27th instant, and to inform you, in reply, that orders
                    have been issued for an immediate and thorough inspection into the condition of
                    the prisoners confined at Fort Delaware.</p>
                <p>Very respectfully, your obedient servant,</p>
                <closer>
                    <signed>EDWIN M. STANTON, <hi rendition="#italic">Secretary of
                        War</hi>.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
