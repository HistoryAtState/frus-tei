    <text>
        <body>
            <div xml:id="d613">

                <pb facs="0734" n="692" sameAs="frus:frus1863p1/pg692"/>

                <head>Mr. F. W. Seward to Lord Lyons.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1863-08-14"><hi rendition="#italic"
                                >August</hi> 14, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Lord:</hi> I have the honor to acknowledge the
                    receipt of your note of yesterday, in which, under the instructions of your
                    government, a representation is made to me concerning the unfortunate affair
                    which resulted in the death of Mr. Hardcastle, in the Old Capitol prison, and to
                    state that it will receive attention.</p>
                <p>I have the honor to be, with high consideration, your lordship’s obedient
                    servant,</p>
                <closer>
                    <signed>F. W. SEWARD, <hi rendition="#italic">Acting
                    Secretary.</hi></signed></closer>
                <postscript>
                    <p>Right Hon. <hi rendition="#small-caps">Lord Lyons.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
