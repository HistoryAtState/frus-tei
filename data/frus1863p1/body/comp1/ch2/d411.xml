    <text>
        <body>
            <div xml:id="d411">

                <pb facs="0561" n="519" sameAs="frus:frus1863p1/pg519"/>

                <head>Mr. Seward to Lord
                        Lyons.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1863-03-06"><hi rendition="#italic"
                                >March</hi> 6, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Dear Lord Lyons</hi>: I think it not unreasonable,
                    in view of the late transactions at Mobile, to ask that renewed instructions may
                    be given to British war vessels on the coast of the United States to avoid all
                    other than legitimate occupations in their visits to the ports held by the
                    insurgents. I am, with great respect, your humble servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p>Right. Hon. <hi rendition="#small-caps">Lord Lyons</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
