    <text>
        <body>
            <div xml:id="d468">

                <pb facs="0612" n="570" sameAs="frus:frus1863p1/pg570"/>

                <head>Mr. Seward to Lord Lyons,.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1863-04-17"><hi rendition="#italic"
                                >April</hi> 17, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Lord</hi>: I have the honor to acknowledge the
                    receipt of your communication of this date, relative to the alleged taking of
                    the British steamship Granite City, of London, while waiting the action of the
                    prize court, for the service of the United States government, and to inform you
                    that it has been referred to the Secretary of the Navy, with a view of my being
                    enabled to satisfy your inquiry on the subject.</p>
                <p>I have the honor to be, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p>Right Hon. <hi rendition="#small-caps">Lord Lyons</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
