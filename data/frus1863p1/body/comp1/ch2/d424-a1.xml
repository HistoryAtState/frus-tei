    <text>
        <body>
            <div xml:id="d424-a1">

                <pb facs="0570" n="528" xml:id="pg528"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Confederate States Steamer
                                Florida</hi>, <hi rendition="#italic">Nassau</hi></placeName>, <date
                            calendar="gregorian" when="1863-01-26"><hi rendition="#italic"
                                >January</hi> 26, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> As this vessel is in distress for the want
                    of coal, I very respectfully request permission to anchor in the harbor for the
                    purpose of obtaining the same.</p>
                <p>I am, &amp;c.,</p>
                <closer>
                    <signed>J. N. MAFFIT, <hi rendition="#italic">Confederate States Navy,
                            Commanding</hi>.</signed></closer>
                <postscript>
                    <p>His Excellency the <hi rendition="#small-caps">Governor</hi>, <hi
                            rendition="#italic">New Providence.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
