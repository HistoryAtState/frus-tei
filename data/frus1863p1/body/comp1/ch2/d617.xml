    <text>
        <body>
            <div xml:id="d617">

                <pb facs="0735" n="693" sameAs="frus:frus1863p1/pg693"/>

                <head>Mr. Seward to Mr.
                        Stuart.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1863-09-12"><hi rendition="#italic"
                                >September</hi> 12, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge the receipt
                    of your memorandum or the 10th instant, relative to the case of Mr. J. M.
                    Vernon, and to state that the attention of the Secretary of War has been invited
                    to it.</p>
                <p>I have the honor to be, with high consideration, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William Stuart,</hi>
                        <hi rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
