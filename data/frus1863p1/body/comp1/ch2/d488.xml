    <text>
        <body>
            <div xml:id="d488">

                <pb facs="0625" n="583" sameAs="frus:frus1863p1/pg583"/>

                <head>Mr. Seward to Lord
                        Lyons.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1863-05-02"><hi rendition="#italic"
                                >May</hi> 2, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Lord</hi>: I have the honor to acknowledge the
                    receipt of your note of the 27th ultimo, relative to the case of the captured
                    British steamship Granite City, and to inform you that it will receive careful
                    attention.</p>
                <p>I have the honor to be, with high consideration, your lordship’s obedient</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p>Right Hon. <hi rendition="#small-caps">Lord Lyons</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
