    <text>
        <body>
            <div xml:id="d548">

                <pb facs="0668" n="626" xml:id="pg626"/>

                <head>Mr. F. W. Seward to Lord Lyons.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1863-06-03"><hi rendition="#italic"
                                >June</hi> 3, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Lord</hi>: I have the honor to acknowledge the
                    receipt of your note of the 1st instant, and to thank you for the accompanying
                    copy of a letter which her Majesty’s secretary of state for the colonies caused
                    to be addressed to the under secretary of state for foreign affairs, on being
                    acquainted with the existence of the rumor that an attempt was being made to fit
                    out a privateer at Vancouver’s island.</p>
                <p>I have the honor to be, with high consideration, your lordship’s obedient
                    servant,</p>
                <closer>
                    <signed>F. W. SEWARD.</signed></closer>
                <postscript>
                    <p>Right Hon. <hi rendition="#small-caps">Lord Lyons,</hi>
                        <hi rendition="#italic">&amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
