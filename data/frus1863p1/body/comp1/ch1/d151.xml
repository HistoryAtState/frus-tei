    <text>
        <body>
            <div xml:id="d151">

                <pb facs="0284" n="242" xml:id="pg242"/>

                <head>Mr. Adams to Mr.
                        Seward.</head>
                <opener>
                    <seg rendition="#float-left">No. 370.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>L<hi rendition="#small-caps">egation of the United States</hi>,
                                <hi rendition="#italic">London,</hi></placeName>
                        <date calendar="gregorian" when="1863-04-09"><hi rendition="#italic"
                                >April</hi> 9, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to transmit copies of
                    three notes which passed between Lord Russell and myself, in continuation of the
                    correspondence referred to in my despatch No. 362, of the 3d instant.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>CHARLES FRANCIS ADAMS.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, &amp;c.</hi></p>
                </postscript>


                <xi:include href="d151-a1.xml" xpointer="d151-a1"/>
            </div>
