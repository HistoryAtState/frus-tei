    <text>
        <body>
            <div xml:id="d217">

                <pb facs="0358" n="316" sameAs="frus:frus1863p1/pg316"/>

                <head>Mr. Seward to Mr.
                        Adams.</head>
                <opener>
                    <seg rendition="#float-left">No. 632.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1862-06-18"><hi rendition="#italic"
                                >June</hi> 18, 1862.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your despatch of the 5th instant (No. 427)
                    has been received. The exposition of the character of the amended slave trade
                    treaty, given by Lord Palmerston in the House of Commons, has been read here
                    with much satisfaction.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams</hi>, Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
