            <div xml:id="d167">

                <pb facs="0299" n="257" sameAs="frus:frus1863p1/pg257"/>

                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <head>Mr. Adams to Mr. Seward.</head>
                <opener><seg rendition="#float-left">No. 389.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States.</hi>
                            <hi rendition="#italic">London,</hi></placeName>
                        <date calendar="gregorian" when="1863-04-24"><hi rendition="#italic"
                                >April</hi> 24, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Lord Russell has this week renewed the
                    correspondence in respect to the Sumter. I transmit a copy of his note of the
                    20th instant.</p>
                <p rendition="#center">* * * * * * * * *</p>
                <p>I append a copy of my reply.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>CHARLES FRANCIS ADAMS.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, &amp;c.</hi></p>
                </postscript>



                <xi:include href="d167-a1.xml" xpointer="d167-a1"/>
