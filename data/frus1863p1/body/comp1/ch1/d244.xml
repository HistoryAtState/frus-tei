    <text>
        <body>
            <div xml:id="d244">

                <pb facs="0408" n="366" sameAs="frus:frus1863p1/pg366"/>

                <head>Mr. Seward to Mr.
                        Adams.</head>
                <opener>
                    <seg rendition="#float-left">No. 661.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1863-07-23"><hi rendition="#italic"
                                >July</hi> 23, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge the receipt
                    of your interesting despatch of the 3d instant. In communications sent to you by
                    the last mail I have already anticipated the comment which the despatch would
                    otherwise elicit.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams</hi>, Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
