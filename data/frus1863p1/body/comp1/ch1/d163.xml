    <text>
        <body>
            <div xml:id="d163">

                <pb facs="0297" n="255" sameAs="frus:frus1863p1/pg255"/>

                <head>Mr. Seward to Mr. Adams.</head>
                <opener>
                    <seg rendition="#float-left">No. 562.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1863-04-22"><hi rendition="#italic"
                                >April</hi> 22, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have to acknowledge the receipt of your
                    despatch of the 7th instant, (No. 366,) and to express my satisfaction at the
                    proceedings of Earl Russell in regard to the Alexandra, and my approval of your
                    own course in the matter.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams</hi>, Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
