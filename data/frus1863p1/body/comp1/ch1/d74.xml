                <pb facs="0165" n="123" sameAs="frus:frus1863p1/pg123"/>

                <opener><seg rendition="#center">[Extracts.]</seg></opener>
                <head>Mr. Adams to Mr.
                        Seward.</head>
                <opener><seg rendition="#float-left">No. 316.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">London,</hi></placeName>
                        <date calendar="gregorian" when="1863-02-06"><hi rendition="#italic"
                                >February</hi> 6, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I transmit herewith a copy of the Queen’s
                    speech delivered through a commission to both houses of Parliament on the
                    opening yesterday.</p>
                <p rendition="#center">* * * * * * * * * *</p>
                <p>I have the honor to be, sir, your obedient servant.</p>




