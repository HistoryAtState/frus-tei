    <text>
        <body>
            <div xml:id="d156-a1-a1-a1">

                <pb facs="0289" n="247" sameAs="frus:frus1863p1/pg247"/>

                <head>Lord Russell to Mr.
                        Adams.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Foreign Office</hi></placeName>,
                            <date calendar="gregorian" when="1863-04-15"><hi rendition="#italic"
                                >April</hi> 15, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge the receipt
                    of your letter of yesterday’s date, enclosing copies of papers transmitted to
                    you from Washington, respecting the case of the Georgiana.</p>
                <p>I have the honor to be, with the highest consideration, sir, your most obedient,
                    humble servant,</p>
                <closer>
                    <signed>RUSSELL.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
