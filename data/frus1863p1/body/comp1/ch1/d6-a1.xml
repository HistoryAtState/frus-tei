    <text>
        <body>
            <div xml:id="d6-a1">

                <pb facs="0053" n="11" sameAs="frus:frus1863p1/pg11"/>

                <head>Earl Russell to Mr. Adams.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Foreign Office, </hi></placeName>
                        <date calendar="gregorian" when="1862-11-22"><hi rendition="#italic"
                                >November</hi> 22, 1862.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Dear Sir</hi>: I have received this day your
                    official letter of the 20th respecting the gunboat Alabama or 290.</p>
                <p>It shall receive the immediate attention of the government.</p>
                <p>I remain your faithful servant,</p>
                <closer>
                    <signed>RUSSELL.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">C. F. Adams</hi>, Esq.</p>
                </postscript>
            </div>
        </body>
    </text>
