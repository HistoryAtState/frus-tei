    <text>
        <body>
            <div xml:id="d60-a1-a4">

                <pb facs="0140" n="98" sameAs="frus:frus1863p1/pg98"/>

                <head>Earl Russell to Mr.
                        Adams.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Foreign Office</hi></placeName>,
                            <date calendar="gregorian" when="1863-01-19"><hi rendition="#italic"
                                >January</hi> 19, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> With reference to my letters of the 17th
                    and 18th instant, I have now the honor to transmit to you copies of reports
                    received at the treasury from the commissioners of customs respecting the
                    steamer Georgiana, assumed in your letter of the 16th instant to be fitting out
                    at Liverpool as a confederate privateer.</p>
                <p>I have the honor to be, with the highest consideration, sir, your most obedient,
                    humble servant,</p>
                <closer>
                    <signed>RUSSELL.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams</hi>, Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
