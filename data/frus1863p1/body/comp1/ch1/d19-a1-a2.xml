    <text>
        <body>
            <div xml:id="d19-a1-a2">

                <pb facs="0073" n="31" sameAs="frus:frus1863p1/pg31"/>

                <opener><seg rendition="#center">No. 2.</seg></opener>
                <head>[Telegram.]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <date calendar="gregorian" when="1862-12-08"><hi rendition="#small-caps"
                                >December</hi> 8, 1862.</date></dateline></opener>
                <p>Mr. <hi rendition="#small-caps">Adams</hi>, <hi rendition="#italic">American
                        Minister, London.</hi></p>
                <p>The private sale of Sumter is in suspense for want of written authority from
                    Commissioner Mason. The party has telegraphed for it.</p>
                <closer>
                    <signed>SPRAGUE, <hi rendition="#italic">Consulate.</hi></signed></closer>
            </div>
        </body>
    </text>
