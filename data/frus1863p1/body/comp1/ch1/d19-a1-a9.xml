    <text>
        <body>
            <div xml:id="d19-a1-a9">

                <pb facs="0076" n="34" sameAs="frus:frus1863p1/pg34"/>

                <opener><seg rendition="#center">No. 13.</seg></opener>
                <head>Captain Freeling to Mr.
                        Sprague.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Secretary’s Office</hi>, <hi
                                rendition="#italic">Gibraltar,</hi></placeName>
                        <date calendar="gregorian" when="1862-12-10"><hi rendition="#italic"
                                >December</hi> 10, 1862.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I am directed by the governor to
                    acknowledge the receipt of your letter dated 9th instant, on the subject of the
                    sale of the Sumter.</p>
                <p>His excellency desires me to inform you that you have not furnished any such
                    proof of the Sumter being a prize as to justify his interference with a
                    mercantile transaction.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>S. FREELING, <hi rendition="#italic">Colonial
                    Secretary.</hi></signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">H. J. Sprague</hi>, Esq., <hi rendition="#italic"
                            >United States Consul, &amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
