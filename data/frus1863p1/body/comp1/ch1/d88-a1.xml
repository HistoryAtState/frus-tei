    <text>
        <body>
            <div xml:id="d88-a1">

                <pb facs="0181" n="139" sameAs="frus:frus1863p1/pg139"/>

                <head>Mr. Adams to Lord Russell.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">London,</hi></placeName>
                        <date calendar="gregorian" when="1863-02-19"><hi rendition="#italic"
                                >February</hi> 19, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Lord</hi>: At the request of my government I have
                    the honor to submit to your lordship’s consideration a copy of a memorial
                    addressed to the Secretary of State by an association of underwriters in New
                    York.</p>
                <p>Renewing assurances, &amp;c.</p>
                <closer>
                    <signed>CHARLES FRANCIS ADAMS.</signed></closer>
                <postscript>
                    <p>Right Honorable <hi rendition="#small-caps">Earl Russell</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
