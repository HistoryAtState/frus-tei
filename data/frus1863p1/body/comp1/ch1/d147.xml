    <text>
        <body>
            <div xml:id="d147">

                <pb facs="0273" n="231" sameAs="frus:frus1863p1/pg231"/>

                <head>Mr. Adams to Mr.
                        Seward.</head>
                <opener>
                    <seg rendition="#float-left">No. 367.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">London,</hi></placeName>
                        <date calendar="gregorian" when="1863-04-08"><hi rendition="#italic"
                                >April</hi> 8, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I send by this steams copies of two notes
                    written to-day. I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>CHARLES FRANCIS ADAMS.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">Wm. H. Seward</hi>, <hi rendition="#italic"
                            >Secretary of State, Washington, D. C.</hi></p>
                </postscript>


                <xi:include href="d147-a1.xml" xpointer="d147-a1"/>
