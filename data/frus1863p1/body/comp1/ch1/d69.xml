    <text>
        <body>
            <div xml:id="d69">

                <pb facs="0156" n="114" xml:id="pg114"/>

                <head>Mr. Seward to Mr. Adams.</head>
                <opener>
                    <seg rendition="#float-left">No. 466.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1863-02-02"><hi rendition="#italic"
                                >February</hi> 2, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Herewith I enclose, for presentation to the
                    British government, a copy of a memorial just received at this department from
                    the New York Mutual Insurance Company, of the city of New York, relative to
                    losses sustained by it on account of the destruction of the ships Brilliant and
                    Manchester on the high seas by the piratical steamer Alabama.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams</hi>, Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
