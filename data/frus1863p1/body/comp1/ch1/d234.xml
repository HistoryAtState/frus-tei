    <text>
        <body>
            <div xml:id="d234">

                <pb facs="0400" n="358" sameAs="frus:frus1863p1/pg358"/>

                <head>Mr. Seward to Mr.
                        Adams.</head>
                <opener>
                    <seg rendition="#float-left">No. 653.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1863-07-13"><hi rendition="#italic"
                                >July</hi> 13, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your despatch of June 25 (No. 435) has been
                    received, and your several proceedings therein related are approved.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
