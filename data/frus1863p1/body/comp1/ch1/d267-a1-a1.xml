    <text>
        <body>
            <div xml:id="d267-a1-a1">

                <pb facs="0439" n="397" sameAs="frus:frus1863p1/pg397"/>

                <opener><seg rendition="#center">No. 1.</seg></opener>
                <head>Lord Russell to Mr. Adams.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Foreign Office, </hi></placeName>
                        <date calendar="gregorian" when="1863-07-29"><hi rendition="#italic"
                                >July</hi> 29, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge the receipt
                    of your letter of the 25th instant and to acquaint you that the information
                    therein contained, relative to the iron-clad vessels in course of construction
                    at Messrs. Lairds’ yard, at Birkenhead, has been communicated to the proper
                    department of her Majesty’s government.</p>
                <p>I have the honor to be, with the highest consideration, sir, your most obedient,
                    humble servant,</p>
                <closer>
                    <signed>RUSSELL.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams</hi>, Esq., <hi
                            rendition="#italic">&amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
