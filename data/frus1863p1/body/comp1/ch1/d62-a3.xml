    <text>
        <body>
            <div xml:id="d62-a3">

                <pb facs="0144" n="102" sameAs="frus:frus1863p1/pg102"/>

                <head>[Telegram.]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">San Roque</hi></placeName>, <date
                            calendar="gregorian" when="1863-01-21"><hi rendition="#italic"
                                >January</hi> 21, 1863—2.5 <hi rendition="#italic"
                        >p.m.</hi></date></dateline></opener>
                <p>Mr. <hi rendition="#small-caps">Adams</hi>, <hi rendition="#italic">American
                        Minister, London:</hi></p>
                <p>Your telegram communicated to our commanders. Sumter coaling again and
                    provisioning to-day.</p>
                <closer>
                    <signed>SPRAGUE.</signed></closer>
            </div>
        </body>
    </text>
