    <text>
        <body>
            <div xml:id="d209-a4">

                <pb facs="0343" n="301" xml:id="pg301"/>

                <head>Lord Russell to Mr.
                        Adams.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Foreign Office</hi></placeName>,
                            <date calendar="gregorian" when="1863-05-19"><hi rendition="#italic"
                                >May</hi> 19, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge the receipt
                    of your letter of to-day’s date, enclosing a further deposition to the case of
                    the Phantom, and I have to inform you that I have lost no time in referring the
                    same to the proper departments of her Majesty’s government.</p>
                <p>I have the honor to be, &amp;c.,</p>
                <closer>
                    <signed>RUSSELL.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams</hi>, Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
