    <text>
        <body>
            <div xml:id="d209-a3">

                <pb facs="0342" n="300" xml:id="pg300"/>

                <head>Mr. Adams to Lord
                        Russell.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">London,</hi></placeName>
                        <date calendar="gregorian" when="1863-05-19"><hi rendition="#italic"
                                >May</hi> 19, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Lord:</hi> I have the honor to transmit the copy
                    of another deposition, supplementary to that which I submitted to your
                    consideration with my note of the 16th instant) relating to the steamer
                    Phantom.</p>
                <p>I pray your lordship, &amp;c.,</p>
                <closer>
                    <signed>CHARLES FRANCIS ADAMS.</signed></closer>
                <postscript>
                    <p>Right Hon. <hi rendition="#small-caps">Earl Russell</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d209-a3-a1.xml" xpointer="d209-a3-a1"/>
            </div>
        </body>
