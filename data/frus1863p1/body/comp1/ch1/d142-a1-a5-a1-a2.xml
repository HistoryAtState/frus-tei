    <text>
        <body>
            <div xml:id="d142-a1-a5-a1-a2">

                <pb facs="0262" n="220" sameAs="frus:frus1863p1/pg220"/>

                <head>Lord Russell to Mr.
                        Adams.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Pembroke Lodge</hi></placeName>,
                            <date calendar="gregorian" when="1863-03-31"><hi rendition="#italic"
                                >March</hi> 31, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge the receipt
                    of your letter, with enclosures, dated March 30, 1863, and received at the
                    foreign office this morning.</p>
                <p>I shall take care to transmit immediately your letter, and the depositions and
                    letter of instructions, to the proper departments of the government.</p>
                <p>I beg you to accept the assurances of the highest consideration with which I have
                    the honor to be, sir, your faithful servant,</p>
                <closer>
                    <signed>RUSSELL.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
