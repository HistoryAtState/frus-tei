    <text>
        <body>
            <div xml:id="d19-a1-a17">

                <pb facs="0080" n="38" sameAs="frus:frus1863p1/pg38"/>

                <opener><seg rendition="#center">No. 18.</seg></opener>
                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <date calendar="gregorian" when="1862-12-19"><hi rendition="#small-caps"
                                >December</hi> 19, 1862.</date></dateline></opener>
                <p>Sumter sold this day by public auction for nineteen thousand five hundred
                    dollars. Purchaser, an English engineer, arrived yesterday from Southampton.</p>
                <closer>
                    <signed>SPRAGUE, <hi rendition="#italic">Gibraltar.</hi></signed></closer>
                <postscript>
                    <p>Mr. <hi rendition="#small-caps">Adams</hi>, <hi rendition="#italic">American
                            Minister, London.</hi></p>
                </postscript>
            </div>
        </body>
