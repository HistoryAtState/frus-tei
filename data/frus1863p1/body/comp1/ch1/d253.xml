    <text>
        <body>
            <div xml:id="d253">

                <pb facs="0413" n="371" sameAs="frus:frus1863p1/pg371"/>

                <head>Mr. Seward to Mr. Adams.</head>
                <opener>
                    <seg rendition="#float-left">No. 668.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1863-07-29"><hi rendition="#italic"
                                >July</hi> 29, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your despatch of the 16th of July (No. 454)
                    has been received, and your proceedings therein are approved. You will be
                    expected to communicate to this department the further decision which Earl
                    Russell has authorized you to look for, in regard to the Virginia, as soon as it
                    shall have been received.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams</hi>, Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
