    <text>
        <body>
            <div xml:id="d26-a1-a3">

                <pb facs="0098" n="56" sameAs="frus:frus1863p1/pg56"/>

                <head>Mr. Sprague’s reply to Mr. Adams.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">San Roque</hi></placeName>, <date
                            calendar="gregorian" when="1863-01-05"><hi rendition="#italic"
                                >January</hi> 5, 1863.</date></dateline></opener>
                <p>Telegraph Saturday received. Have notified governor sale Sumter will not be
                    recognized. Sumter quiet in port past week. Has ceased flying any flag.</p>
                <closer>
                    <signed>SPRAGUE.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Adams</hi>, <hi rendition="#italic">American
                            Minister, London.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
