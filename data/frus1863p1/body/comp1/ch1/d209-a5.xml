    <text>
        <body>
            <div xml:id="d209-a5">

                <pb facs="0343" n="301" sameAs="frus:frus1863p1/pg301"/>

                <head>Mr. Adams to Lord
                        Russell.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">London,</hi></placeName>
                        <date calendar="gregorian" when="1863-05-23"><hi rendition="#italic"
                                >May</hi> 23, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Lord</hi>: I have the honor to transmit the copy
                    of another deposition relating to the case of the steamer Phantom.</p>
                <p>At the same time, I seize the opportunity to mention that, from information
                    received by the consul of the United States at Liverpool, I am led to the belief
                    that preparations are actively in progress for the expediting of the Sumter from
                    that port.</p>
                <p>I pray your lordship, &amp;c.,</p>
                <closer>
                    <signed>CHARLES FRANCIS ADAMS.</signed></closer>
                <postscript>
                    <p>Right Hon. <hi rendition="#small-caps">Earl Russell</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d209-a5-a1.xml" xpointer="d209-a5-a1"/>
            </div>
