    <text>
        <body>
            <div xml:id="d19-a1-a4">

                <pb facs="0074" n="32" sameAs="frus:frus1863p1/pg32"/>

                <opener><seg rendition="#center">No. 4.</seg></opener>
                <head>[Telegram.]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Gibraltar</hi></placeName>, <date
                            calendar="gregorian" when="1862-12-09"><hi rendition="#italic"
                                >December</hi> 9, 1862.</date></dateline></opener>
                <p>Mr. <hi rendition="#small-caps">Adams</hi>, <hi rendition="#italic">American
                        Minister, London.</hi></p>
                <p>By instructions of our minister at Madrid, have protested to British governor
                    against Sumter being sold here.</p>
                <closer>
                    <signed>SPRAGUE, <hi rendition="#italic">Consul.</hi></signed></closer>
            </div>
        </body>
    </text>
