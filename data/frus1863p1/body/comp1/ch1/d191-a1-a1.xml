    <text>
        <body>
            <div xml:id="d191-a1-a1">

                <pb facs="0330" n="288" xml:id="pg288"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Foreign Office</hi></placeName>,
                            <date calendar="gregorian" when="1863-04-30"><hi rendition="#italic"
                                >April</hi> 30, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to. acknowledge the
                    receipt of your letter of the 29th instant, enclosing a memorial addressed to
                    the President of the United States by the directing authorities of the Panama
                    Railroad Company, respecting the destruction, by the Alabama, of the American
                    bark Golden Rule.</p>
                <p>I have the honor to be, with the highest consideration, sir, your most obedient,
                    humble servant,</p>
                <closer>
                    <signed>RUSSELL.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams</hi>, Esq., <hi
                            rendition="#italic">&amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
