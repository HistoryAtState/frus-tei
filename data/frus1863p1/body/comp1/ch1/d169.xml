    <text>
        <body>
            <div xml:id="d169">

                <pb facs="0301" n="259" sameAs="frus:frus1863p1/pg259"/>

                <head>Mr. Adams to Mr.
                        Seward.</head>
                <opener>
                    <seg rendition="#float-left">No. 392.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">London,</hi></placeName>
                        <date calendar="gregorian" when="1863-04-24"><hi rendition="#italic"
                                >April</hi> 24, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Her Majesty’s government does not seem yet
                    to be quite satisfied of the sincerity of my denials of the enlistment of men in
                    this kingdom under the <pb facs="0302" n="260" xml:id="pg260"/> authority of the
                    United States. I transmit a copy of two more notes which have passed on the
                    subject.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>CHARLES FRANCIS ADAMS.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>



                <xi:include href="d169-a1.xml" xpointer="d169-a1"/>
                <xi:include href="d169-a2.xml" xpointer="d169-a2"/>
