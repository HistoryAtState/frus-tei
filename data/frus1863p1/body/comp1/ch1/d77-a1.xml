                <head>[Enclosures.]</head>
                <table cols="2">
                    <row role="label">
                        <cell cols="2">Resolutions from Leeds, February 3, 1863.</cell>
                    </row>
                    <row>
                        <cell cols="2">Resolutions from Galashiels, February 5, 1863.</cell>
                    </row>
                    <row>
                        <cell cols="2">Resolutions from Bath, February 2, 1863.</cell>
                    </row>
                    <row>
                        <cell cols="2">Resolutions from Bromley, (printed,) February 2, 1863.</cell>
                    </row>
                    <row>
                        <cell cols="2">Resolutions from South London, February 3, 1863.</cell>
                    </row>
                    <row>
                        <cell>Edinburgh Weekly Herald, February 7, 1863.</cell>
                        <cell rows="2">
                            <table>
                                <row>
                                    <cell role="brace" rows="2">}</cell>
                                    <cell rendition="#middle" rows="2">Not received by clerk.</cell>
                                </row>
                            </table>
                        </cell>
                    </row>
                    <row>
                        <cell>Leeds Mercury, February 4, 1863.</cell>
                    </row>
                </table>




