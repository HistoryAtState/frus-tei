    <text>
        <body>
            <div xml:id="d281">

                <pb facs="0457" n="415" xml:id="pg415"/>

                <head>Mr. Adams to Mr. Seward.</head>
                <opener>
                    <seg rendition="#float-left">No. 491.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">London</hi>,</placeName>
                        <date calendar="gregorian" when="1863-09-05"><hi rendition="#italic"
                                >September</hi> 5, 1863—3 <hi rendition="#italic">o’clock p.
                            m</hi>.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have just received a note from Lord
                    Russell, and have only time to transmit a copy of it to you by the ordinary
                    mail.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed> CHARLES FRANCIS ADAMS.</signed></closer>
                <postscript>
                    <p> Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>


                <xi:include href="d281-a1.xml" xpointer="d281-a1"/>
