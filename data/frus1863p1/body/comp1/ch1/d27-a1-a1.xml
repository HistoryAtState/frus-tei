    <text>
        <body>
            <div xml:id="d27-a1-a1">

                <pb facs="0099" n="57" sameAs="frus:frus1863p1/pg57"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Pera</hi></placeName>, <date
                            calendar="gregorian" when="1863-01-07"><hi rendition="#italic"
                                >January</hi> 7, 1863—6.20 <hi rendition="#italic">p.
                        m.</hi></date></dateline></opener>
                <p>Inform Mr. Seward the three assassins of Merriam were this day hung at
                    Adrianople.</p>
                <closer>
                    <signed>MORRIS.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">B. Moran</hi>, <hi rendition="#italic">Secretary
                            of American Legation, London.</hi></p>
                </postscript>
            </div>
        </body>
