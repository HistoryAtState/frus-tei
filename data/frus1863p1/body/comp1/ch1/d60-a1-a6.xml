    <text>
        <body>
            <div xml:id="d60-a1-a6">

                <pb facs="0141" n="99" xml:id="pg99"/>

                <head>Earl Russell to Mr.
                        Adams.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Foreign Office</hi></placeName>,
                            <date calendar="gregorian" when="1863-01-18"><hi rendition="#italic"
                                >January</hi> 18, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to transmit to you
                    herewith, with reference to my letter to you of yesterday, a copy of a telegram
                    received to-day from the collector of customs at Liverpool, reporting the result
                    of the inquiry which he was instructed to make respecting the vessel Georgiana,
                    referred to in your letter of the 16th instant as being in course of fitting out
                    at Liverpool as a confederate privateer.</p>
                <p>I have the honor to be, with the highest consideration, sir, your most obedient,
                    humble servant,</p>
                <closer>
                    <signed>RUSSELL.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">C. F. Adams</hi>, Esq., <hi rendition="#italic"
                            >&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
