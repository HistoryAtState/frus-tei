    <text>
        <body>
            <div xml:id="d150">

                <pb facs="0279" n="237" sameAs="frus:frus1863p1/pg237"/>

                <opener><seg rendition="#center">[Extracts.]</seg></opener>
                <head>Mr. Adams to Mr.
                        Seward.</head>
                <opener><seg rendition="#float-left">No. 369.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">London,</hi></placeName>
                        <date calendar="gregorian" when="1863-04-09"><hi rendition="#italic"
                                >April</hi> 9, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Lord Russell has thought it expedient to
                    renew the correspondence about the intercepted despatches in a note of the 2d of
                    April, a copy of which I send herewith.</p>
                <pb facs="0280" n="238" xml:id="pg238"/>
                <p rendition="#center">* * * * * * * * * *</p>
                <p>A copy of my reply, dated the 6th instant, is appended.</p>
                <p rendition="#center">* * * * * * * * *</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>CHARLES FRANCIS ADAMS.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State.</hi></p>
                </postscript>


                <xi:include href="d150-a1.xml" xpointer="d150-a1"/>
            </div>
