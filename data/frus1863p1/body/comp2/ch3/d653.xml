    <text>
        <body>
            <div xml:id="d653">

                <pb facs="0780" n="XXXII" sameAs="frus:frus1863p1/pgXXXII"/>

                <head>Mr. F. W. Seward to Mr. Adams.</head>
                <opener>
                    <seg rendition="#float-left">No. 748.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1863-11-02"><hi rendition="#italic"
                                >November</hi> 2, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have to acknowledge the receipt of your
                    despatch of the 16th ultimo, (No. 518.) Your note of the 12th of October to Earl
                    Russell, as well as that of the 24th of September, is approved.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>F. W. SEWARD, <hi rendition="#italic">Acting
                    Secretary.</hi></signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles F. Adams,</hi> Esq., &amp;<hi
                            rendition="#italic">c, &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
