    <text>
        <body>
            <div xml:id="d668-a1-a7">

                <pb facs="0818" n="LXX" sameAs="frus:frus1863p1/pgLXX"/>

                <head>Earl Russell to Mr. Adams.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Foreign Office, </hi></placeName>
                        <date calendar="gregorian" when="1863-11-16"><hi rendition="#italic"
                                >November</hi> 16, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge the receipt
                    of your letter of the 14th instant, enclosing further papers respecting the
                    Canton, and I have to state to you that I have lost no time in forwarding copies
                    of the same to the proper department of her Majesty’s government.</p>
                <p>I have the honor to be, with the highest consideration, sir, your most obedient,
                    humble servant,</p>
                <closer>
                    <signed>RUSSELL.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
