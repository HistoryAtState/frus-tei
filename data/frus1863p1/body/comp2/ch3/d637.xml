    <text>
        <body>
            <div xml:id="d637">

                <pb facs="0751" n="III" sameAs="frus:frus1863p1/pgIII"/>

                <head>Mr. Adams to Mr. Seward.</head>
                <opener>
                    <seg rendition="#float-left">No. 516.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">London,</hi></placeName>
                        <date calendar="gregorian" when="1863-10-09"><hi rendition="#italic"
                                >October</hi> 9, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Referring to my No. 504, of the 1st
                    instant, I have the honor to forward herewith a copy of a note from Lord
                    Russell, under date of the 5th of October, acknowledging the reception of my
                    letter to him of the 29th ultimo.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>CHARLES FRANCIS ADAMS.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>


                <xi:include href="d637-a1.xml" xpointer="d637-a1"/>
            </div>
