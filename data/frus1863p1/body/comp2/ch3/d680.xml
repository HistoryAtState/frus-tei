    <text>
        <body>
            <div xml:id="d680">

                <pb facs="0874" n="CXXVI" sameAs="frus:frus1863p1/pgCXXVI"/>

                <head>Mr. Seward to Mr. Adams.</head>
                <opener>
                    <seg rendition="#float-left">No. 777.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1863-12-05"><hi rendition="#italic"
                                >December</hi> 5, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your very interesting despatch of the 19th
                    of November (No. 537) has been received, together with the pamphlet on the
                    foreign enlistment act of Great Britain by Mr. Gibbs, which is highly
                    appreciated.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c, &amp;c, &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
