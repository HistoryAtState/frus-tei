    <text>
        <body>
            <div xml:id="d669-a1-a1">

                <pb facs="0819" n="LXXI" sameAs="frus:frus1863p1/pgLXXI"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Foreign Office, </hi></placeName>
                        <date calendar="gregorian" when="1863-11-16"><hi rendition="#italic"
                                >November</hi> 16, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge the receipt
                    of your letter of the 14th instant, and its enclosure, respecting the
                    proceedings of the “Alabama.”</p>
                <p>I have the honor to be, with the highest consideration, sir, your most obedient,
                    humble servant,</p>
                <closer>
                    <signed>RUSSELL.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
