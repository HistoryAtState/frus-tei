    <text>
        <body>
            <div xml:id="d676">

                <pb facs="0872" n="CXXIV" sameAs="frus:frus1863p1/pgCXXIV"/>

                <head>Mr. Seward to Mr.
                        Adams.</head>
                <opener>
                    <seg rendition="#float-left">No. 768.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1863-11-24"><hi rendition="#italic"
                                >November</hi> 24, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your despatch No. 527, of the 30th ultimo,
                    which shows the manner in which you have carried into effect the instruction of
                    this department, (No. 730,) has been received, submitted to the President, and
                    is approved.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
