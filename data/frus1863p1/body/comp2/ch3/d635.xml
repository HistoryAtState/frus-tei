    <text>
        <body>
            <div xml:id="d635">

                <pb facs="0750" n="II" sameAs="frus:frus1863p1/pgII"/>

                <head>Mr. Adams to Mr. Seward.</head>
                <opener>
                    <seg rendition="#float-left">No. 512.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,</hi>
                            <hi rendition="#italic">London,</hi></placeName>
                        <date calendar="gregorian" when="1863-10-08"><hi rendition="#italic"
                                >October</hi> 8, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> A copy of Lord Russell’s acknowledgment,
                    dated the 2d instant, of my note to him of the 29th ultimo, transmitted with my
                    despatch (No. 505) of the 1st instant, is now forwarded.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>CHARLES FRANCIS ADAMS.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi>
                        <hi rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>


                <xi:include href="d635-a1.xml" xpointer="d635-a1"/>
            </div>
