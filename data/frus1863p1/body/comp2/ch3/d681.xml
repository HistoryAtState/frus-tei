    <text>
        <body>
            <div xml:id="d681">

                <pb facs="0875" n="CXXVII" xml:id="pgCXXVII"/>

                <head>Mr. Seward to Mr. Adams.</head>
                <opener>
                    <seg rendition="#float-left">No. 778.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1863-12-05"><hi rendition="#italic"
                                >December</hi> 5, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have to acknowledge the receipt of your
                    despatch Nos. 538 to 541 inclusive, and to express my approval of them.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq.,&amp;<hi
                            rendition="#italic">c, &amp;c, &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
