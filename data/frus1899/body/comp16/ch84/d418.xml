                <pb facs="0530" n="434" sameAs="frus:frus1899/pg434"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Draper.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1899-12-08"><hi rendition="#italic">December 8,
                        1899</hi></date>.</dateline></opener>
                <p>Your confidential dated yesterday received. Ellis Island bureau will be
                    discontinued January 1, for administrative reasons. This Government thinks it
                    not expedient to reconsider its action.</p>
                <closer><signed><hi rendition="#small-caps">Hay.</hi></signed></closer>
            </div>
        </body>
    </text>
