    <text>
        <body>
            <div xml:id="d425">

                <pb facs="0533" n="437" sameAs="frus:frus1899/pg437"/>

                <head><hi rendition="#italic">Mr. Hill to Baron de Fava.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1899-12-22"><hi rendition="#italic">December 22,
                        1899</hi></date>.</dateline></opener>
                <p>Your telegrams received. Have proposed to Treasury admission of Italian agent to
                    Barge Office as you desire, but reply has not yet been received. Will inform you
                    as soon as possible.</p>
                <closer><signed><hi rendition="#small-caps">David J. Hill.</hi></signed></closer>
            </div>
        </body>
    </text>
