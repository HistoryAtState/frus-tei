    <text>
        <body>
            <div xml:id="d432">

                <pb facs="0537" n="441" sameAs="frus:frus1899/pg441"/>

                <head><hi rendition="#italic">Governor Foster to
                        Mr. Hay.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Baton Rouge, La.</hi></placeName>, <date calendar="gregorian"
                            when="1899-07-22"><hi rendition="#italic">July 22,
                        1899</hi></date>.</dateline></opener>
                <p>Your telegram will receive my immediate attention and will further advise
                    you.</p>
                <closer><signed><hi rendition="#small-caps">Murphy J. Foster</hi>, <hi
                            rendition="#italic">Governor.</hi></signed></closer>
            </div>
        </body>
    </text>
