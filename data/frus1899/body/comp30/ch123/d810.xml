    <text>
        <body>
            <div xml:id="d810">

                <pb facs="0908" n="812" sameAs="frus:frus1899/pg812"/>

                <head><hi rendition="#italic">Mr. Hay to Mr. Loomis.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1899-12-04"><hi rendition="#italic">December 4,
                        1899</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 310.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    No. 352 of the 20th ultimo, reporting that you had on that date officially
                    recognized the government of General Castro.</p>
                <p>Your recognition of his government is approved.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
    </text>
