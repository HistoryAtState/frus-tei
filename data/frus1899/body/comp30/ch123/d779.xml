                <pb facs="0892" n="796" sameAs="frus:frus1899/pg796"/>

                <head><hi rendition="#italic">Mr. Adee to Mr. Russell.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1899-09-19"><hi rendition="#italic">September 19,
                        1899</hi></date>.</dateline></opener>
                <p>Flag should only be shown by citizens. You may notify authorities of any menaced
                    Cuban property and use good offices for them.</p>
                <closer><signed><hi rendition="#small-caps">Adee.</hi></signed></closer>
            </div>
        </body>
    </text>
