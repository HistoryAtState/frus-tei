    <text>
        <body>
            <div xml:id="d784">

                <pb facs="0895" n="799" xml:id="pg799"/>

                <head><hi rendition="#italic">Mr. Hill to Mr. Loomis.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1899-10-10"><hi rendition="#italic">October 10,
                        1899</hi></date>.</dateline></opener>
                <p>Secretary of the Navy authorizes commander of the <hi rendition="#italic"
                        >Detroit</hi> to permit suggested conference to take place on board if so
                    requested.</p>
                <closer><signed><hi rendition="#small-caps">Hill</hi>, <hi rendition="#italic"
                            >Acting.</hi></signed></closer>
            </div>
        </body>
    </text>
