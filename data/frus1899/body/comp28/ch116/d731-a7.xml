    <text>
        <body>
            <div xml:id="d731-a7">

                <pb facs="0856" n="760" sameAs="frus:frus1899/pg760"/>

                <opener><seg rendition="#center">[Inclosure No. 7.]</seg></opener>
                <head><hi rendition="#italic">Mr. Leishman to Mr.
                            Ridgely.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Legation</hi>,<lb/><hi rendition="#italic">Berne,
                                Switzerland</hi></placeName>, <date calendar="gregorian"
                            when="1899-06-13"><hi rendition="#italic">June 13,
                        1899</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I am in receipt of your favor of the 9th
                    instant, and in compliance with your request I will submit the application of
                    Jules Michot, together with the papers in connection with the case, to the
                    Department of State for decision.</p>
                <p>Yours, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John G. A.
                    Leishman.</hi></signed></closer>
            </div>
        </body>
