    <text>
        <body>
            <div xml:id="d490">

                <pb facs="0574" n="478" sameAs="frus:frus1899/pg478"/>

                <head><hi rendition="#italic">Mr. Adee to Mr.
                            Buck.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1899-08-03"><hi rendition="#italic">August 3,
                        1899</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 235.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I confirm on the overleaf of my
                        telegram<anchor n="1" xml:id="d490-f1"/> of the 2d instant in regard to
                    securing the permission of the Japanese Government to unload horses and mules
                    belonging to the United States Army at Nagasaki for rest.</p>
                <p>I inclose herewith for your further information copy of a letter from the Acting
                    Secretary of War on the subject.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alvey A. Adee</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>



                <xi:include href="d490-a1.xml" xpointer="d490-a1"/>
            </div>
        </body>
    </text>
