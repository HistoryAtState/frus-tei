    <text>
        <body>
            <div xml:id="d483-a1">

                <pb facs="0564" n="468" sameAs="frus:frus1899/pg468"/>

                <opener><seg rendition="#center">[Inclosure.]</seg></opener>
                <p>We hereby sanction the enforcement of the conventions of commerce and navigation
                    promulgated on August 27, 1894, and other conventions, and promulgate the
                    same.</p>
                <p>His Imperial Majesty’s sign and seal.</p>
                <closer><signed>
                        <list>
                            <item><hi rendition="#small-caps">Marquis Yamagata Aritomo</hi>,<lb/><hi
                                    rendition="#italic">Premier.</hi></item>
                            <item><hi rendition="#small-caps">Viscount Aoki Tinzo</hi>,<lb/><hi
                                    rendition="#italic">Minister for Foreign Affairs.</hi></item>
                        </list>
                    </signed>
                    <lb/>
                    <dateline rendition="#float-left"><date calendar="gregorian" when="1899-06-14"
                                ><hi rendition="#small-caps">June</hi> 14, 1899</date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
