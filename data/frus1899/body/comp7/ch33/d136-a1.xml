    <text>
        <body>
            <div xml:id="d136-a1">

                <pb facs="0269" n="177" sameAs="frus:frus1899/pg177"/>

                <opener><seg rendition="#center">[Inclosure in No. 215.]</seg></opener>
                <head><hi rendition="#italic">Mr. Fowler to Assistant Secretary of
                    State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Consulate of the United States</hi>,<lb/><hi rendition="#italic"
                                >Chefoo, China</hi></placeName>, <date calendar="gregorian"
                            when="1899-09-11"><hi rendition="#italic">September 11,
                        1899</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a
                    letter received from Ichowfu dated August 14, 1899, in regard to the payment of
                    indemnity for damage done during the recent anti-Christian disturbances in that
                    prefecture.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Fowler</hi>, <hi
                            rendition="#italic">Consul.</hi></signed></closer>
            </div>
        </body>
