    <text>
        <body>
            <div xml:id="d136">

                <pb facs="0269" n="177" sameAs="frus:frus1899/pg177"/>

                <head><hi rendition="#italic">Mr. Hay to Mr. Conger</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1899-10-27"><hi rendition="#italic">October 27,
                        1899</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 215.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose for your information a copy of a
                    dispatch from the United States consul at Chefoo inclosing a letter to him from
                    Charles F. Johnson and others in Ichoufu in relation to the payment of indemnity
                    for damage done during the recent anti-Christian disturbances in that
                    prefecture.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay</hi>.</signed></closer>



                <xi:include href="d136-a1.xml" xpointer="d136-a1"/>
