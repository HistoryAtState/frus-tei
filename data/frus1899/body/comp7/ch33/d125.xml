    <text>
        <body>
            <div xml:id="d125">

                <pb facs="0256" n="164" sameAs="frus:frus1899/pg164"/>

                <head><hi rendition="#italic">Mr. Conger to Mr.
                            Hay</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States of America</hi>,<lb/><hi
                                rendition="#italic">Pekin, China</hi></placeName>, <date
                            calendar="gregorian" when="1899-02-18"><hi rendition="#italic">February
                                18, 1899</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 148.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my dispatch No. 142, of
                    February 8 instant, in regard to the recent disturbances in the province of
                    Shangtung, I have the honor to inclose to you copies of further correspondence
                    had with the Chinese Government on the same subject.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">E. H. Conger</hi>.</signed></closer>



                <xi:include href="d125-a1.xml" xpointer="d125-a1"/>
