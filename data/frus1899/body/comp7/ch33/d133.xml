                <pb facs="0263" n="171" sameAs="frus:frus1899/pg171"/>

                <head><hi rendition="#italic">Mr. Conger to Mr. Hay</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States of America</hi>,<lb/><hi
                                rendition="#italic">Pekin, China</hi></placeName>, <date
                            calendar="gregorian" when="1899-07-12"><hi rendition="#italic">July 12,
                                1899</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 232.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In continuance of my dispatch No. 211, of
                    June 5 last, concerning the missionary troubles in the I-chou-fu prefecture,
                    province of Shantung, I inclose herewith copies of additional correspondence
                    upon the subject, and have the honor, etc.,</p>
                <closer><signed><hi rendition="#small-caps">E. H. Conger.</hi></signed></closer>










