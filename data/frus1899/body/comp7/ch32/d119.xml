    <text>
        <body>
            <div xml:id="d119">

                <pb facs="0243" n="151" sameAs="frus:frus1899/pg151"/>

                <head><hi rendition="#italic">Mr. Hay to Mr. Conger</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1899-03-13"><hi rendition="#italic">March 13,
                        1899</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 142.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    dispatch, No. 132, of January 20 last, stating that you have instructed our
                    consul at Amoy to telegraph to the Department for instructions respecting the
                    efforts of Japan to obtain concessions of foreshore and other lands at Amoy.</p>
                <p>In reply, I inclose herewith for your information a copy of the instruction sent
                    to him on the subject.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay</hi>.</signed></closer>


                <xi:include href="d119-a1.xml" xpointer="d119-a1"/>
            </div>
