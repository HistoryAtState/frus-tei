    <text>
        <body>
            <div xml:id="d153">

                <pb facs="0298" n="206" sameAs="frus:frus1899/pg206"/>

                <head><hi rendition="#italic">Mr. Hay to Mr. Wu</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1899-02-24"><hi rendition="#italic">February 24,
                        1899</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 88.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of the 18th instant, presenting additional observations on the
                    subject of the proposed extension of the present Chinese-exclusion laws of the
                    United States to the Hawaiian Islands.</p>
                <p>I have sent copies of your note to the Committee on Foreign Relations of the
                    Senate and to the Committee on Foreign Affairs of the House of Representatives,
                    for their information and consideration.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay</hi>.</signed></closer>
            </div>
        </body>
