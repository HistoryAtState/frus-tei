    <text>
        <body>
            <div xml:id="d88">

                <pb facs="0220" n="128" sameAs="frus:frus1899/pg128"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Vignaud</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1899-09-06"><hi rendition="#italic">September 6,
                        1899</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 664.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to inclose, for your confidential
                    information, copies of instructions I have sent under this date to the United
                    States ambassadors at London, Berlin, and St. Petersburg in reference to the
                    desire of this Government that the Governments of Great Britain, Germany, and
                    Russia make formal declaration of an “open-door” policy in the territories held
                    by them in China.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>


                <xi:include href="d88-a1.xml" xpointer="d88-a1"/>
            </div>
