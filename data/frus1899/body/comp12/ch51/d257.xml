    <text>
        <body>
            <div xml:id="d257">

                <pb facs="0386" n="294" xml:id="pg294"/>

                <head><hi rendition="#italic">Mr. Jackson to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >Berlin</hi></placeName>, <date calendar="gregorian"
                            when="1899-11-30"><hi rendition="#italic">November 30,
                        1899</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1092.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: While referring to my dispatch No. 1091,
                    mailed you yesterday afternoon, I have the honor to append hereto a copy of the
                    text of your telegram, received late last night, and of my reply thereto, just
                    sent you, in regard to the readmission of the Prussian fire insurance companies
                    to the State of New York, and to be, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John B. Jackson.</hi></signed></closer>



                <xi:include href="d257-a1.xml" xpointer="d257-a1"/>
