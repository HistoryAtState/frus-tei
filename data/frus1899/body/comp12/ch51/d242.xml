    <text>
        <body>
            <div xml:id="d242">

                <pb facs="0379" n="287" sameAs="frus:frus1899/pg287"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            von Holleben.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1899-02-27"><hi rendition="#italic">February 27,
                        1899</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 208.]</seg></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I beg to thank you for your kindness
                    and courtesy in communicating to me this morning, through Baron Sternburg,
                    information as to the intention of the Prussian Government in sending agents
                    here to settle questions of the management of insurance companies in
                    Prussia.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
    </text>
