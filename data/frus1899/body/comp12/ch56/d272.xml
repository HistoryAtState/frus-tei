    <text>
        <body>
            <div xml:id="d272">

                <pb facs="0397" n="305" xml:id="pg305"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            White.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1899-03-25"><hi rendition="#italic">March 25,
                        1899</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 814.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to the Department’s instruction
                    No. 787, of the 6th instant, in regard to a summons issued to Consul-General
                    Guenther to appear as a witness in a German court, I inclose for your
                    information copies of correspondence as indicated below in regard to the happy
                    termination of the incident.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>



                <xi:include href="d272-a1.xml" xpointer="d272-a1"/>
