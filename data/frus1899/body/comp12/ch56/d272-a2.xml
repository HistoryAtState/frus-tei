    <text>
        <body>
            <div xml:id="d272-a2">

                <pb facs="0397" n="305" sameAs="frus:frus1899/pg305"/>

                <opener><seg rendition="#center">[Inclosure 2 in No. 814.]</seg></opener>
                <head><hi rendition="#italic">Mr. Cridler to Mr. Guenther.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1899-03-16"><hi rendition="#italic">March 16,
                        1899</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 6.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your No. 8 of the 28th ultimo, relative to
                    a royal summons issued to you by the royal court of Frankfort, has been
                    received.</p>
                <p>The Department is gratified to learn of the satisfactory termination of the
                    incident.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Thos. W. Cridler</hi>,<lb/><hi
                            rendition="#italic">Third Assistant Secretary.</hi></signed></closer>
            </div>
        </body>
