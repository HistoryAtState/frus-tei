    <text>
        <body>
            <div xml:id="d183">

                <pb facs="0329" n="237" sameAs="frus:frus1899/pg237"/>

                <head><hi rendition="#italic">Mr. Hay to Mr. Hart</hi>.</head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-11-10"><hi rendition="#italic">November 10,
                        1898</hi></date>.</dateline></opener>
                <p>Will accept payment Star and Herald claim in installments, $10,000 each, at one,
                    two, and three months, American currency.</p>
                <closer><signed><hi rendition="#small-caps">Hay.</hi></signed></closer>
            </div>
