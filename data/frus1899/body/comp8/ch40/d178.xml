    <text>
        <body>
            <div xml:id="d178">

                <pb facs="0328" n="236" sameAs="frus:frus1899/pg236"/>

                <head><hi rendition="#italic">Mr. Hart to Mr.
                            Hay</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States of America</hi>,<lb/><hi
                                rendition="#italic">Bogota</hi></placeName>, <date
                            calendar="gregorian" when="1898-10-25"><hi rendition="#italic">October
                                25, 1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 115.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor herewith to inclose copy
                    of a note sent yesterday to the Colombian foreign office in the matter of the
                    Star and Herald.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Chas. Burdett
                    Hart.</hi></signed></closer>


                <xi:include href="d178-a1.xml" xpointer="d178-a1"/>
