                <pb facs="0329" n="237" xml:id="pg237"/>

                <head><hi rendition="#italic">Mr. Hill to Mr. Hart</hi>.</head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-11-01"><hi rendition="#italic">November 1,
                        1898</hi></date>.</dateline></opener>
                <p>Proceed with demand Star Herald claim. This Government imperatively insists on
                    prompt payment.</p>
                <closer><signed><hi rendition="#small-caps">Hill.</hi></signed></closer>
            </div>
        </body>
