    <text>
        <body>
            <div xml:id="d603">

                <pb facs="0705" n="609" xml:id="pg609"/>

                <head><hi rendition="#italic">Mr. Day to Sir
                            Julian Pauncefote.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-07-29"><hi rendition="#italic">July 29,
                        1898</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1110.]</seg></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I have the honor to acknowledge the
                    receipt of your note of the 26th instant in regard to the proposed measures for
                    the return to Samoa of Mataafa and the chiefs exiled with him, and to say, in
                    reply, that they are satisfactory to the Government of the United States.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">William R. Day.</hi></signed></closer>
            </div>
        </body>
    </text>
