    <text>
        <body>
            <div xml:id="d625">

                <pb facs="0761" n="665" sameAs="frus:frus1899/pg665"/>

                <head><hi rendition="#italic">Lord Pauncefote to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >British Embassy</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1899-11-27"><hi rendition="#italic">November 27,
                        1899</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor, by direction of the
                    Marquis of Salisbury, to transmit to you herewith a copy, in both English and
                    German texts, of the convention and declaration between Great Britain and
                    Germany, signed on the 14th instant, for the settlement of questions pending
                    between them in regard to Samoa and certain other matters.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Pauncefote.</hi></signed></closer>




                <xi:include href="d625-a1.xml" xpointer="d625-a1"/>
