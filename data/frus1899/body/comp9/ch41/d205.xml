                <pb facs="0343" n="251" sameAs="frus:frus1899/pg251"/>

                <head><hi rendition="#italic">Mr. Powell to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Port au Prince, Haiti</hi></placeName>, <date calendar="gregorian"
                            when="1899-12-09"><hi rendition="#italic">December 9,
                        1899</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 167.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose a copy of the
                    letter received this morning from the United States consul-general, Mr. Maxwell,
                    on affairs in Santo Domingo.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. F. Powell.</hi></signed></closer>


                <xi:include href="d205-a1.xml" xpointer="d205-a1"/>
