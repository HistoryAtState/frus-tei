    <text>
        <body>
            <div xml:id="d85">

                <pb facs="0215" n="123" xml:id="pg123"/>

                <head><hi rendition="#italic">Mr. Bryan to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Petropolis, Brazil</hi></placeName>, <date calendar="gregorian"
                            when="1899-07-12"><hi rendition="#italic">July 12,
                        1899</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 174.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to the subject of my 149, of
                    April 25, 1899, in order to complete the files of the Department on this
                    question I have the honor to transmit herewith a copy and translation of the
                    recently published report of the minister for foreign affairs, which refers to
                    the <hi rendition="#italic">Wilmington</hi> matter.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charles Page
                    Bryan.</hi></signed></closer>


                <xi:include href="d85-a1.xml" xpointer="d85-a1"/>
