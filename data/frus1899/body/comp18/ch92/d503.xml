    <text>
        <body>
            <div xml:id="d503">

                <pb facs="0587" n="491" sameAs="frus:frus1899/pg491"/>

                <head><hi rendition="#italic">Mr. Allen to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Seoul, Korea</hi></placeName>, <date calendar="gregorian"
                            when="1899-12-12"><hi rendition="#italic">December 12,
                        1899</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 215.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to hand you inclosed, a
                    copy of a translation of the new treaty between Korea and China, which has been
                    signed and now only awaits being exchanged.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Horace N. Allen.</hi></signed></closer>



                <xi:include href="d503-a1.xml" xpointer="d503-a1"/>
