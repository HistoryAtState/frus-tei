    <text>
        <body>
            <div xml:id="d386-a1">

                <pb facs="0495" n="399" xml:id="pg399"/>

                <opener><seg rendition="#center">[Inclosure.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States of America</hi>,<lb/><hi
                                rendition="#italic">Port au Prince, Haiti</hi></placeName>, <date
                            calendar="gregorian" when="1869-05-17"><hi rendition="#italic">May 17,
                                1869</hi></date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#italic">To whom these presents may come,
                        greeting:</hi></p>
                <p>This is to certify that from proof to me furnished Pierre Phelps is a citizen of
                    the United States and entitled to all the rights of American citizens residing
                    abroad.</p>
                <p>Given under my hand and official seal the day and date above written.</p>
                <closer>[<hi rendition="#small-caps">seal.</hi>] <signed><hi rendition="#small-caps"
                            >E. H. Hollister</hi>,<lb/><hi rendition="#italic">Minister Resident and
                            Consul-General of U. S. A. at Port au Prince,
                    Haiti.</hi></signed></closer>
                <postscript>
                    <p>Presented and viséed at this legation this 30th day of October, 1869.</p>
                    <closer><signed><hi rendition="#small-caps">Ebenezer D. Bassett</hi>,<lb/><hi
                                rendition="#italic">Minister Resident of the United States, near the
                                Government of Haiti.</hi></signed></closer>
                </postscript>
            </div>
        </body>
