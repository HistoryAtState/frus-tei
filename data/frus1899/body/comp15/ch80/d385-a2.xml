    <text>
        <body>
            <div xml:id="d385-a2">

                <pb facs="0493" n="397" sameAs="frus:frus1899/pg397"/>

                <opener><seg rendition="#center">[Subinclosure.]</seg></opener>
                <head><hi rendition="#italic">Mr. Miot to General
                            Prudo</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >St. Marc</hi></placeName>, <date calendar="gregorian"
                            when="1899-08-06"><hi rendition="#italic">August 6,
                        1899</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">General</hi>: I come by the present to beg you to
                    kindly set at liberty the sons of Ch. Black and that of J. Guillaury, both
                    American subjects, arrested this morning and committed to prison.</p>
                <p>With the hope that my request will find a good welcome, I beg you to accept,
                    etc.,</p>
                <closer><signed><hi rendition="#small-caps">Em. Miot</hi>,<lb/><hi
                            rendition="#italic">United States Consular Agent</hi> (<hi
                            rendition="#italic">ad interim</hi>).</signed></closer>
            </div>
        </body>
    </text>
