    <text>
        <body>
            <div xml:id="d372">

                <pb facs="0481" n="385" sameAs="frus:frus1899/pg385"/>

                <head><hi rendition="#italic">Mr. Powell to Mr. Hay.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Port au Prince</hi></placeName>, <date calendar="gregorian"
                            when="1899-08-16"><hi rendition="#italic">August 16,
                        1899</hi></date>.</dateline></opener>
                <p>Haytian minister for foreign affairs states that this Government has decreed all
                    refugees in legations to leave country by first steamer. Please send
                    instructions.</p>
                <closer><signed><hi rendition="#small-caps">Powell.</hi></signed></closer>
            </div>
        </body>
    </text>
