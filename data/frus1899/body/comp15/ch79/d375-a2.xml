    <text>
        <body>
            <div xml:id="d375-a2">

                <pb facs="0484" n="388" sameAs="frus:frus1899/pg388"/>

                <opener><seg rendition="#center">[Inclosure 2.]</seg></opener>
                <head><hi rendition="#italic">Mr. Powell to Mr. St.
                            Victor.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Port au Prince, Haiti</hi></placeName>, <date calendar="gregorian"
                            when="1899-08-18"><hi rendition="#italic">August 18,
                        1899</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 293.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have your favor dated August 16, in which
                    you inform me of a decree of your Government concerning certain gentlemen who
                    have requested the protection of our legation, that they should debark from the
                    city by the first occasion.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. F. Powell.</hi></signed></closer>
            </div>
        </body>
