    <text>
        <body>
            <div xml:id="d329">

                <pb facs="0445" n="349" sameAs="frus:frus1899/pg349"/>

                <head><hi rendition="#italic">Mr. Choate to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >London</hi></placeName>, <date calendar="gregorian" when="1899-07-12"
                                ><hi rendition="#italic">July 12, 1899</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 117.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of the Department’s No. 166, of the 27th ultimo, instructing me to convey to Her
                    Majesty’s Government the thanks of the President to Her Majesty’s diplomatic and
                    consular representatives in Spain for their friendly services rendered to the
                    United States during the suspension of diplomatic relations with that country,
                    and in obedience thereto I addressed a note to Lord Salisbury on the 11th
                    instant, of which I inclose a copy herewith.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Joseph H. Choate.</hi></signed></closer>


                <xi:include href="d329-a1.xml" xpointer="d329-a1"/>
