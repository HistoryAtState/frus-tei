    <text>
        <body>
            <div xml:id="d309">

                <pb facs="0434" n="338" sameAs="frus:frus1899/pg338"/>

                <head><hi rendition="#italic">Sir Julian Pauncefote
                        to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1899-01-19"><hi rendition="#italic">January 19,
                        1899</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: By direction of the Marquis of Salisbury, I
                    have the honor to inquire whether passengers leaving Spain for Cuba and Porto
                    Rico are required to provide themselves with passports.</p>
                <p>I shall be greatly obliged if you will kindly furnish me with this information in
                    order that I may reply to the telegraphic inquiry from Lord Salisbury.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Julian
                    Pauncefote.</hi></signed></closer>
            </div>
        </body>
    </text>
