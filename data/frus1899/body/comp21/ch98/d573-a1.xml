                <pb facs="0680" n="584" xml:id="pg584"/>

                <opener><seg rendition="#center">[Inclosure.]</seg></opener>
                <head><hi rendition="#italic">List of Americans and Europeans sent from Bluefields
                        to New Orleans and Mobile under arrangement made by General Reuling,
                        Nicaraguan army, and Commander Symonds, U. S. S. Marietta, and Commander
                        Burr, H. B. M. S. Intrepid, March, 1899.</hi></head>
                <list>
                    <item><hi rendition="#italic">American.</hi>—Edward Henrotin, Isaac H. Vincent,
                        Ogden S. Beale, Thos. D. Frey, John Hay, E. S. Newman, O. L. Simmons, C. G.
                        Ausburn, D. C. Laws, jr., Howard White, P. F. Connors, J. T. Teel, J. T.
                        Floyd, J. M. Beale, D. R. Lyons, J. M. Harpen, J. A. Harland, J. H. Cutting,
                        T. A. Wallace, B. D. Garrison, T. J. Whalen, A. L. Chapman, Alex. F. Tarin,
                        James C. Kennedy, J. H. Hosgard, Geo. H. Haymond, Geo. W. Winchester, W. E.
                        Payne, R. M. Hudson, J. C. Coultoen, M. J. O’Brien, Dan Crimins.</item>
                    <item><hi rendition="#italic">Norwegian.</hi>—Martin. Lorentzson, Moritz Tagon,
                        Henry Carlson, G. W. Henson, John Zeitz, Robert Roiley.</item>
                    <item><hi rendition="#italic">Russian.</hi>—J. Herling.</item>
                    <item><hi rendition="#italic">English.</hi>—F. W. Chapman, Dan’l Fisher, Edward
                        G. Sturidge, H. H. Vojs, Jno. Thompson, Chas. A. Campbell, Fred. H.
                        Cornell.</item>
                    <item><hi rendition="#italic">German.</hi>—Jack Martin.</item>
                    <item><hi rendition="#italic">Dane.</hi>—H. P. Hanson.</item>
                    <item><hi rendition="#italic">Cuban.</hi>—A. R. Silver.</item>
                    <item><hi rendition="#italic">Austrian.</hi>—H. Klien.</item>
                    <item><hi rendition="#italic">Creole.</hi>—Colored boy.</item>
                </list>
            </div>
        </body>
