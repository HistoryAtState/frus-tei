    <text>
        <body>
            <div xml:id="d540">

                <pb facs="0653" n="557" sameAs="frus:frus1899/pg557"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Merry.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1899-03-20"><hi rendition="#italic">March 20,
                        1899</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 204.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith for your information
                    copies of the letters listed below, in relation to the collection by the lawful
                    Government of Nicaragua of duties paid to the insurgent General Reyes at
                    Bluefields, under compulsion, by American merchants at that place on merchandise
                    imported by them.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>




