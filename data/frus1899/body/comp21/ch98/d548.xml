    <text>
        <body>
            <div xml:id="d548">

                <pb facs="0658" n="562" sameAs="frus:frus1899/pg562"/>

                <head><hi rendition="#italic">Mr. Merry to Mr. Hay.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >San Salvador</hi></placeName>, <date calendar="gregorian"
                            when="1899-04-07"><hi rendition="#italic">April 7,
                        1899</hi></date>.</dateline></opener>
                <p>Your two cables received; just leaving for Managua, whence will reply Monday.</p>
                <closer><signed><hi rendition="#small-caps">Merry.</hi></signed></closer>
            </div>
        </body>
