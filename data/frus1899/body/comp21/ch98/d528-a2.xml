    <text>
        <body>
            <div xml:id="d528-a2">

                <pb facs="0647" n="551" sameAs="frus:frus1899/pg551"/>

                <opener><seg rendition="#center">[Inclosure 2.]</seg></opener>
                <head><hi rendition="#italic">Proclamation of Mr. Clancy.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Consular Agency</hi>,<lb/><hi rendition="#italic"
                                >Bluefields, Nicaragua</hi></placeName>, <date calendar="gregorian"
                            when="1899-02-03"><hi rendition="#italic">February 3,
                        1899</hi></date>.</dateline></opener>
                <p>All citizens of the United States of America are hereby warned not to take any
                    part in the political trouble-existing here, and are to observe a strict
                    neutrality.</p>
                <closer><signed><hi rendition="#small-caps">M. J. Clancy</hi>,<lb/><hi
                            rendition="#italic">Consular Agent.</hi></signed></closer>
            </div>
        </body>
