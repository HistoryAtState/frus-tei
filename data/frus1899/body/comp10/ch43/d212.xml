    <text>
        <body>
            <div xml:id="d212">

                <pb facs="0348" n="256" sameAs="frus:frus1899/pg256"/>

                <head><hi rendition="#italic">Mr. Sampson to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Quito</hi></placeName>, <date calendar="gregorian"
                            when="1899-02-15"><hi rendition="#italic">February 15,
                        1899</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 96.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: The Government of Ecuador has made official
                    proclamation of the suppression of the rebellion.</p>
                <p>In the last battle over 600 were killed, several hundred mortally wounded, and
                    over 400 prisoners taken.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Archibald J.
                    Sampson.</hi></signed></closer>
            </div>
        </body>
    </text>
