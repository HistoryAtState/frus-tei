    <text>
        <body>
            <div xml:id="d592-a4">

                <pb facs="0698" n="602" sameAs="frus:frus1899/pg602"/>

                <opener><seg rendition="#center">[Inclosure 3.]</seg></opener>
                <head><hi rendition="#italic">Mr. Ek to Mr.
                            Tower.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Consulate of the United States</hi>,<lb/><hi rendition="#italic"
                                >Helsingfors</hi></placeName>, <date calendar="gregorian"
                            when="1899-04-10"><hi rendition="#italic">April 10,
                        1899</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I had the honor to receive your kind letter
                    of the 27th last, and allow me to inclose a letter of Mr. M. W. Pipping, by
                    which you will see the necessary.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Victor Ek</hi>,<lb/><hi
                            rendition="#italic">Vice and Acting Consul.</hi></signed></closer>
            </div>
        </body>
