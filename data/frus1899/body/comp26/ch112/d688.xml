    <text>
        <body>
            <div xml:id="d688">

                <pb facs="0809" n="713" sameAs="frus:frus1899/pg713"/>

                <head><hi rendition="#italic">Mr. Hay to Mr. Storer.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1899-12-20"><hi rendition="#italic">December 20,
                        1899</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 113.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    No. 135, of the 5th instant, inclosing a copy of a note from the Spanish foreign
                    office stating that arrangements have been made for the payment of the interest
                    due for the years 1898 and 1899 on the Spanish indemnity debt under the treaty
                    of 1834.</p>
                <p>The Government of the United States cordially appreciates the friendly and just
                    spirit shown by the Government of Spain in this arrangement of the matter.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
