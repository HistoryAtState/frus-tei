    <text>
        <body>
            <div xml:id="d661">

                <pb facs="0789" n="693" sameAs="frus:frus1899/pg693"/>

                <head><hi rendition="#italic">Mr. Hill to the Duke de Arcos.</hi></head>
                <opener><seg rendition="#center">[Personal.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1900-04-17"><hi rendition="#italic">April 17,
                        1900</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Minister</hi>: I quote for your
                    information the following cablegram received from the military governor of the
                    Philippine Islands, and dated the 10th instant: <quote rend="blockquote">
                        <p>Shipped for Spain to-day 13 officers, 258 men, Spanish army, released
                            from insurgents, 17 wives and children.</p>
                    </quote>
                </p>
                <p>Very truly, yours,</p>
                <closer><signed><hi rendition="#small-caps">David J. Hill</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
