    <text>
        <body>
            <div xml:id="d659">

                <pb facs="0788" n="692" sameAs="frus:frus1899/pg692"/>

                <head><hi rendition="#italic">Mr. Hay to the Duke de Arcos.</hi></head>
                <opener><seg rendition="#center">[Personal.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1900-03-13"><hi rendition="#italic">March 13,
                        1900</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Minister</hi>: I have received through
                    the Acting Secretary of War a telegram from Major-General Otis stating that an
                    officer, 60 enlisted men, and 2 civil officials, captured Spanish prisoners, had
                    been received on the 8th instant from Tayabas.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
    </text>
