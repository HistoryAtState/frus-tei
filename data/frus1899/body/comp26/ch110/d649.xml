    <text>
        <body>
            <div xml:id="d649">

                <pb facs="0785" n="689" sameAs="frus:frus1899/pg689"/>

                <head><hi rendition="#italic">Mr. Adee to the Duke de Arcos.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1899-09-18"><hi rendition="#italic">September 18,
                        1899</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. Minister</hi>: It gives me pleasure to take
                    this personal way of informing you that I am advised by the Secretary of War
                    that General Otis reports that there were shipped to Spain on December 13, on
                    the <hi rendition="#italic">Cachemire</hi>, 30 Spanish officers and 1,067
                    enlisted men; May 6, on the <hi rendition="#italic">Cataluna</hi>, 71 officers
                    and 30 men; May 30, on the <hi rendition="#italic">Leon XIII</hi>, 4 officers
                    and 6 men; June 3, on the <hi rendition="#italic">Satrustegui</hi>, 11 officers
                    and 79 men; July 1, on the <hi rendition="#italic">Isla de Luzon</hi>, 13
                    officers and 16 men.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alvey A. Adee</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
