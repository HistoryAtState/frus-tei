    <text>
        <body>
            <div xml:id="d643">

                <pb facs="0782" n="686" sameAs="frus:frus1899/pg686"/>

                <head><hi rendition="#italic">Mr. Hay to the
                            Duke de Arcos.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1899-07-28"><hi rendition="#italic">July 28,
                        1899</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Minister</hi>: A dispatch just received
                    from General Otis informs us that the Spanish agents in Manila have been given
                    full liberty to negotiate with the insurgents for the exchange of prisoners.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
    </text>
