    <text>
        <body>
            <div xml:id="d27-a1">

                <pb facs="0144" n="52" xml:id="pg52"/>

                <opener><seg rendition="#center">[Inclosure.]</seg></opener>
                <head><hi rendition="#italic">Mr. Allen to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Nayy Department</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1899-08-16"><hi rendition="#italic">August 16,
                        1899</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to forward herewith for
                    the information of the State Department a copy of a letter received from Admiral
                    George Dewey in regard to his visit with the flagship <hi rendition="#italic"
                        >Olympia</hi> at Trieste.</p>
                <p>Very respectfully,</p>
                <closer><signed><hi rendition="#small-caps">Chas. H. Allen</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
