            <div xml:id="d10-a2">

                <pb facs="0106" n="14" sameAs="frus:frus1899/pg14"/>

                <opener><seg rendition="#center">[Inclosure 2.—Telegram.]</seg></opener>
                <head><hi rendition="#italic">The Legation to Mr. Kenig.</hi></head>
                <p>Send passport, naturalization certificate, and write full particulars.</p>
                <closer><hi rendition="#small-caps">American Minister</hi>. <lb/>
                    <dateline rendition="#float-left">Sent <date calendar="gregorian"
                            when="1897-12-21T14:00:00+01:00">Tuesday, December 21, 1897, at 2
                            p.m.</date></dateline>
                </closer>
            </div>
        </body>
