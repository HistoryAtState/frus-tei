    <text>
        <body>
            <div xml:id="d20">

                <pb facs="0132" n="40" sameAs="frus:frus1899/pg40"/>

                <head><hi rendition="#italic">Mr. Hay to Mr. Tower.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1899-01-25"><hi rendition="#italic">January 25,
                        1899</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 199.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose for your information copy of a
                    letter from the Secretary of Agriculture relative to the complaint of the Cudahy
                    Packing Company, of South Omaha, Nebr., that the Austrian Government is
                    enforcing a new ministerial decree which exacts the payment of duty on the salt
                    in which meats are packed in addition to the duty collected on the meats
                    themselves.</p>
                <p>You are instructed to investigate the matter promptly and to report the result to
                    the Department.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>



                <xi:include href="d20-a1.xml" xpointer="d20-a1"/>
