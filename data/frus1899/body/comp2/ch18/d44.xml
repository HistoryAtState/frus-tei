    <text>
        <body>
            <div xml:id="d44">

                <pb facs="0171" n="79" sameAs="frus:frus1899/pg79"/>

                <head><hi rendition="#italic">Mr. Hay to Mr. Hengelmüller.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1899-11-09"><hi rendition="#italic">November 9,
                        1899</hi></date>.</dateline>
                    <seg rendition="#float-left">Personal.]</seg></opener>
                <p>My <hi rendition="#small-caps">Dear</hi> Mr. <hi rendition="#small-caps"
                        >Hengelmüller</hi>: I beg to send herewith a memorandum in reply to the
                    aide-mémoire touching the desire of the Austro-Hungarian Government to amend its
                    naturalization treaty to the United States.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>



                <xi:include href="d44-a1.xml" xpointer="d44-a1"/>
            </div>
