    <text>
        <body>
            <div xml:id="d6">

                <pb facs="0097" n="5" sameAs="frus:frus1899/pg5"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Buchanan.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1899-02-16"><hi rendition="#italic">February 16,
                        1899</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 454.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose copy of a letter from Messrs.
                    Briesen &amp; Knauth, of New York City, complaining that the trade-marks and
                    symbols of United States citizens are improperly appropriated in the Argentine
                    Republic.</p>
                <p>You will give the subject attention in the way of inquiry and, if convenient
                    occasion offers, of suggestion to the minister for foreign affairs in the
                    direction of an understanding which would remove or lessen the ground of
                    complaint.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>


                <xi:include href="d6-a1.xml" xpointer="d6-a1"/>
            </div>
        </body>
    </text>
