    <text>
        <body>
            <div xml:id="d343">

                <pb facs="0457" n="361" sameAs="frus:frus1899/pg361"/>

                <head><hi rendition="#italic">Mr. Hay to Mr. Hunter.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1899-01-31"><hi rendition="#italic">January 31,
                        1899</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 104.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge with gratification
                    the receipt of your dispatch No. 129, of the 6th instant, reporting the
                    courtesies shown Rear-Admiral Kautz and his officers of the flagship <hi
                        rendition="#italic">Philadelphia</hi>, during their recent visit to
                    Guatemala city.</p>
                <p>I am etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
    </text>
