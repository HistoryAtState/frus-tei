    <text>
        <body>
            <div xml:id="d338">

                <pb facs="0451" n="355" sameAs="frus:frus1899/pg355"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Hunter.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1898-12-06"><hi rendition="#italic">December 6,
                        1898</hi></date>.</dateline></opener>
                <p>The union having apparently broken up without restoration of the Diet, you will
                    address the Executive of Honduras, offering to present your original credentials
                    in order to continue close and friendly relations between your Government and
                    that Republic.</p>
                <closer><signed><hi rendition="#small-caps">Hay.</hi></signed></closer>
            </div>
        </body>
    </text>
