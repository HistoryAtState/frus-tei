    <text>
        <body>
            <div xml:id="d353-a1">

                <pb facs="0463" n="367" sameAs="frus:frus1899/pg367"/>

                <opener><seg rendition="#center">[Inclosure.]</seg></opener>
                <head><hi rendition="#italic">The Secretary of Treasury
                        to the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Treasury Department</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1899-03-03"><hi rendition="#italic">March 3,
                        1899</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith, for
                    your information, a copy of a telegram, dated the 2d instant, from the collector
                    of customs at New Orleans, relative to 116 alleged filibusters at that port.</p>
                <p>A similar letter has been addressed to the honorable the Secretary of the Navy
                    and Attorney-General.</p>
                <p>Respectfully, yours,</p>
                <closer><signed><hi rendition="#small-caps">L. J. Gage</hi>, <hi rendition="#italic"
                            >Secretary.</hi></signed></closer>
            </div>
        </body>
