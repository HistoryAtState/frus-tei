    <text>
        <body>
            <div xml:id="d356">

                <pb facs="0466" n="370" sameAs="frus:frus1899/pg370"/>

                <head><hi rendition="#italic">Mr. Beaupre to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States,<lb/>Guatemala and
                                Honduras</hi>,<lb/><hi rendition="#italic"
                            >Guatemala</hi></placeName>, <date calendar="gregorian"
                            when="1899-03-21"><hi rendition="#italic">March 21,
                        1899</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 158.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit inclosed a
                    translation of a note received by this legation from the Hon. Angel Ugarte,
                    chargé d’affaires of Honduras, concerning the recent filibustering expedition,
                    and a copy of my reply thereto.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">A. M. Beaupre</hi>,<lb/><hi
                            rendition="#italic">Chargé d’Affaires ad, etc.</hi></signed></closer>



                <xi:include href="d356-a1.xml" xpointer="d356-a1"/>
                <xi:include href="d356-a2.xml" xpointer="d356-a2"/>
