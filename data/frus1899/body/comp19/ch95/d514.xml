    <text>
        <body>
            <div xml:id="d514">

                <pb facs="0598" n="502" sameAs="frus:frus1899/pg502"/>

                <head><hi rendition="#italic">Mr. Clayton to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1899-05-23"><hi rendition="#italic">May 23,
                        1899</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 156.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith copy
                    and translation of the decree promulgating the treaty between Mexico and Germany
                    for the protection of trade-marks in the two countries.</p>
                <p>I have the honor to be, sir, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Powell Clayton.</hi></signed></closer>



                <xi:include href="d514-a1.xml" xpointer="d514-a1"/>
