    <text>
        <body>
            <div xml:id="d448">

                <pb facs="0594" n="580" sameAs="frus:frus1947v06/pg580"/>

                <note rend="inline" type="source">740.0011 PW (Peace)/11–2747</note>
                <head>
                    <hi rendition="#italic">The Soviet Chargé</hi> (<hi
                            rendition="#italic">Tarassenko</hi>) <hi rendition="#italic"
                        >to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Translation]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 233</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1947-11-27">November 27,
                        1947</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith the
                    reply of the Minister for Foreign Affairs of the USSR V. M. Molotov to the
                    Minister for Foreign Affairs of China Mr. Wang Shih-Chieh to his note of
                    November 17, 1947 concerning a peace settlement for Japan.<anchor n="92"
                        xml:id="d448-f1"/>
                </p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>V. <hi rendition="#small-caps">Tarassenko</hi>
                    </signed>
                </closer>


                <xi:include href="d448-a1.xml" xpointer="d448-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d448-f1" n="92" xml:id="d448-f1-content">
                <p>The texts of the Chinese and Soviet exchange of notes of November 17 and 27 were
                    published in Moscow on November 28.</p>
            </note>
        </listAnnotation>
    </standOff>
