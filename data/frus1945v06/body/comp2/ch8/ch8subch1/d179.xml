    <text>
        <body>
            <div xml:id="d179">

                <pb facs="0314" n="302" sameAs="frus:frus1945v06/pg302"/>

                <note rend="inline" type="source">740.0011 PW/3–2445: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Ambassador in France</hi> (<hi
                            rendition="#italic">Caffery</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-03-29T20:00:00-04:00">March 29, 1945—8
                            p.m.</date>
                    </dateline>
                </opener>
                <p>1242. Your 1425, March 24. The French are aware that by March 24 some help had
                    been dropped to their troops in Indo-China. We are trying to get more specific
                    information.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Grew</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
