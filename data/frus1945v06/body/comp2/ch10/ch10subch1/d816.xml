    <text>
        <body>
            <div xml:id="d816">

                <pb facs="1130" n="1118" sameAs="frus:frus1945v06/pg1118"/>

                <note rend="inline" type="source">895.6463/11–945: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the Soviet Union</hi> (<hi
                        rendition="#italic">Harriman</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Moscow</hi></placeName>, <date
                            calendar="gregorian" when="1945-11-09T16:00:00+03:00">November 9, 1945—4
                            p.m.</date>
                        <lb/> [Received November 9—11:52 a.m.]</dateline>
                </opener>
                <p>3809. Department’s 2304, November 7. Removal by Soviet authorities of equipment
                    from Yalu River power plants.</p>
                <p>I wrote to Vyshinski<anchor n="24" xml:id="d816-f1"/> on November 8 making
                    representations on this case.</p>
                <p>Department, please repeat to Tokyo and Seoul.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Harriman</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d816-f1" n="24" xml:id="d816-f1-content">
                <p>Audrey Yanuaryevich Vyshinsky, People’s Vice Commissar for Foreign Affairs of the
                    Soviet Union.</p>
            </note>
        </listAnnotation>
    </standOff>
