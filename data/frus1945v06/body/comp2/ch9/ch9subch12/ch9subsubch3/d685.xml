    <text>
        <body>
            <div xml:id="d685">

                <pb facs="0952" n="940" sameAs="frus:frus1945v06/pg940"/>

                <note rend="inline" type="source">740.00116 P.W./10–845: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Political Adviser in Japan</hi> (<hi
                        rendition="#italic">Atcheson</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Tokyo</hi></placeName>, <date
                            calendar="gregorian" when="1945-10-08">October 8,
                        1945</date>.<lb/>[Received October 11—12:23 p.m.]</dateline>
                </opener>
                <p>29. It would be helpful to this office if we could be furnished by telegraph with
                    a list, as so far compiled, of suspected Japanese war criminals.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Atcheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
