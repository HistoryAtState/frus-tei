    <text>
        <body>
            <div xml:id="d684">

                <pb facs="0952" n="940" sameAs="frus:frus1945v06/pg940"/>

                <note rend="inline" type="source">740.00116 PW/10–545</note>
                <head>
                    <hi rendition="#italic">The Acting Political Adviser in Japan</hi> (<hi
                        rendition="#italic">Atcheson</hi>)<anchor n="37" xml:id="d684-f1"/>
                    <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Tokyo</hi></placeName>, <date
                            calendar="gregorian" when="1945-10-05">October 5,
                        1945</date>.<lb/>[Received October 22.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose a copy of a
                    war criminals list and an amendment list dated September 28 and October 2
                        respectively.<anchor n="38" xml:id="d684-f2"/> These lists were furnished to
                    us by General MacArthur’s headquarters. Copies of further lists will be
                    forwarded as they become available.<anchor n="39" xml:id="d684-f3"/>
                </p>
                <p>Respectfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">George Atcheson, Jr.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d684-f1" n="37" type="source" xml:id="d684-f1-content">
                <p>Mr. Atcheson was Acting Political Adviser to the Supreme Commander, Allied
                    Powers, Japan, with personal rank of Minister.</p>
            </note>
            <note corresp="#d684-f2" n="38" xml:id="d684-f2-content">
                <p>Neither printed; the lists contained 56 persons of several nationalities.</p>
            </note>
            <note corresp="#d684-f3" n="39" xml:id="d684-f3-content">
                <p>A supplemental list containing 15 additional names was enclosed with despatch 12,
                    October 11, 1945 (740.00116 P.W./10–1145).</p>
            </note>
        </listAnnotation>
    </standOff>
