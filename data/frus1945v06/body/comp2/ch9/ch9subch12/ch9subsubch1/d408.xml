            </note>
            <note corresp="#d408-f2" n="48" xml:id="d408-f2-content">
                <p>Clement R. Attlee, British Prime Minister.</p>
            </note>
            <note corresp="#d408-f3" n="49" xml:id="d408-f3-content">
                <p>Ernest Bevin, British Foreign Secretary.</p>
            </note>
