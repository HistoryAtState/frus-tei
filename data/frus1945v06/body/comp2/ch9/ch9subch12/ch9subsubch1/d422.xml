    <text>
        <body>
            <div xml:id="d422">

                <pb facs="0653" n="641" xml:id="pg641"/>

                <note rend="inline" type="source">740.00119 P.W./8–1245: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the Soviet Union</hi> (<hi
                        rendition="#italic">Harriman</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Moscow</hi></placeName>, <date
                            calendar="gregorian" when="1945-08-12">August 12,
                        1945</date>.<lb/>[Received August 12—7:38 a.m.]</dateline>
                </opener>
                <p>M 25277. Reference White House message 324, August 11.<anchor n="65"
                        xml:id="d422-f1"/> Molotov has informed me that the Soviet Government agrees
                    to the changes made in the reply to the Japanese Government.</p>
                <closer>[<signed>
                        <hi rendition="#small-caps">Harriman</hi>
                    </signed>]</closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d422-f1" n="65" xml:id="d422-f1-content">
                <p>Not found in Department files; for British reply to similar message, see telegram
                    2263, August 11, from London, <ref target="#pg633">p. 633</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
