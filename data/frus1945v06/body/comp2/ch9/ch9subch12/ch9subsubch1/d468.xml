    <text>
        <body>
            <div xml:id="d468">

                <pb facs="0697" n="685" sameAs="frus:frus1945v06/pg685"/>

                <note rend="inline" type="source">740.00119 P.W./8–2145: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the Soviet Union</hi> (<hi rendition="#italic">Harriman</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Moscow</hi></placeName>, <date
                            calendar="gregorian" when="1945-08-21">August 21,
                        1945</date>.<lb/>[Received August 21—10:30 p.m.]</dateline>
                </opener>
                <p>2985. Press, August 21, announced appointment of Lt. Gen. Derevyanko<anchor
                        n="29a" xml:id="d468-f1"/> as representative of Soviet Forces to General
                    MacArthur.</p>
                <p>Sent Dept, repeated American Embassy, Chungking, 100.</p>
                <closer>[<signed>
                        <hi rendition="#small-caps">Harriman</hi>
                    </signed>]</closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d468-f1" n="29a" xml:id="d468-f1-content">
                <p>Lt. Gen. Kuzma Nikolayevich Derevyanko, field observer in the Pacific theater in
                    1945.</p>
            </note>
        </listAnnotation>
    </standOff>
