    <text>
        <body>
            <div xml:id="d486">

                <pb facs="0711" n="699" sameAs="frus:frus1945v06/pg699"/>

                <note rend="inline" type="source">740.00119 FEAC/8–3145: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in China</hi> (<hi rendition="#italic"
                        >Hurley</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Chungking</hi></placeName>, <date
                            calendar="gregorian" when="1945-08-31T14:00:00+07:00">August 31, 1945—2
                            p.m.</date>
                        <lb/> [Received August 31—11:11 a.m.]</dateline>
                </opener>
                <p>1486, bis. Dept’s 1296, August 21<anchor n="54" xml:id="d486-f1"/> and Embassy’s
                    1449, August 25.<anchor n="55" xml:id="d486-f2"/> By formal note dated August
                    30, Foreign Office informed Embassy that proposal for establishment of Far
                    Eastern Advisory Commission meets with approval of Chinese Government.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hurley</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
