    <text>
        <body>
            <div xml:id="d741">

                <pb facs="1014" n="1002" sameAs="frus:frus1945v06/pg1002"/>

                <note rend="inline" type="source">740.00119 Control (Japan)/11–1345</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Chinese Ambassador</hi>
                        (<hi rendition="#italic">Wei</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-11-23">November 23,
                        1945</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: I have the honor to acknowledge the
                    receipt of your note of November 13, 1945, in regard to the question of the
                    disposal of the Japanese naval fleet. Consideration will be given to the
                    request, contained in your note, in regard to the allotment to China of Japanese
                    vessels, after which I shall expect to send you a further reply.</p>
                <p>Accept [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Dean Acheson</hi>
                    </signed><anchor n="61" xml:id="d741-f1"/>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d741-f1" n="61" xml:id="d741-f1-content">
                <p>Under Secretary of State.</p>
