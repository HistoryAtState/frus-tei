    <text>
        <body>
            <div xml:id="d549">

                <pb facs="0774" n="762" sameAs="frus:frus1945v06/pg762"/>

                <note rend="inline" type="source">740.00119 PW/10–1945</note>
                <head>
                    <hi rendition="#italic">The Chief of Staff</hi> (<hi
                            rendition="#italic">Marshall</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-10-19">19 October,
                        1945</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Secretary</hi>: I am attaching a one page
                    summary of the present situation as known to the War Department concerning
                    Allied occupation forces for Japan. In addition to forces of the Allied Powers,
                    the War Department is considering the use of up to 50,000 Filipinos, U.S.
                    equipped and under U.S. command.</p>
                <p>Faithfully yours,</p>
                <closer>
                    <signed>G. C. <hi rendition="#small-caps">Marshall</hi>
                    </signed>
                </closer>


                <xi:include href="d549-a1.xml" xpointer="d549-a1"/>
            </div>
