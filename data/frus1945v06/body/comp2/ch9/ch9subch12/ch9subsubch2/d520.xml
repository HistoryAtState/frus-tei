    <text>
        <body>
            <div xml:id="d520">

                <pb facs="0749" n="737" sameAs="frus:frus1945v06/pg737"/>

                <note rend="inline" type="source">740.00119 Control (Japan)/10–545: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Political Adviser in Japan</hi> (<hi rendition="#italic">Atcheson</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Tokyo</hi></placeName>, <date
                            calendar="gregorian" when="1945-10-05">October 5,
                        1945</date>.<lb/>[Received October 9—12:05 p.m.]</dateline>
                </opener>
                <p>24. ReDeptel 13, undated.<anchor n="18" xml:id="d520-f1"/> General MacArthur
                    issued October 4 directive to Japanese Government ordering removal of
                    restrictions on political, civil and religious liberties and release of
                    political prisoners. Understand press has radioed details. Copy of directive
                    will go forward by mail.<anchor n="19" xml:id="d520-f2"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Atcheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d520-f1" n="18" xml:id="d520-f1-content">
                <p>October 3, 11 a.m., <ref target="#pg734">p. 734</ref>.</p>
            </note>
            <note corresp="#d520-f2" n="19" xml:id="d520-f2-content">
                <p>For text, see Department of State <hi rendition="#italic">Bulletin</hi>, November
                    4, 1945, p. 730; see also addendum, November 25, 1945, p. 874.</p>
            </note>
        </listAnnotation>
