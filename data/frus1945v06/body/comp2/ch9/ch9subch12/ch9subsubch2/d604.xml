    <text>
        <body>
            <div xml:id="d604">

                <pb facs="0856" n="844" sameAs="frus:frus1945v06/pg844"/>

                <note rend="inline" type="source">740.00119 Control (Japan)/11–945</note>
                <head>
                    <hi rendition="#italic">The Acting Political Adviser in Japan</hi> (<hi rendition="#italic">Atcheson</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 45</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Tokyo</hi></placeName>, <date
                            calendar="gregorian" when="1945-11-09">November 9,
                        1945</date>.<lb/>[Received November 19.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose a copy of a
                    brief self-explanatory memorandum of identic date to General MacArthur
                    recommending that action be taken, and suggesting the means by which it might be
                    taken, to prevent present reactionary Diet members from standing for re-election
                    and being returned to office.</p>
                <p>Respectfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">George Atcheson, Jr.</hi>
                    </signed>
                </closer>


                <xi:include href="d604-a1.xml" xpointer="d604-a1"/>
            </div>
