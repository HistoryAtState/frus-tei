    <text>
        <body>
            <div xml:id="d638-a1">

                <pb facs="0893" n="881" sameAs="frus:frus1945v06/pg881"/>

                <opener>
                    <seg rendition="#center">[Enclosure 1]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">Directive by the Supreme Commander, Allied Powers,
                        Japan</hi> (<hi rendition="#italic"
                        >MacArthur</hi>) <hi rendition="#italic">to the Japanese Government
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">AG 091.1 (10 Dec 45) GS</seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Tokyo</hi></placeName>,] <date calendar="gregorian"
                            when="1945-12-10">10 December, 1945</date>.</dateline>
                </opener>
                <p rendition="#flush">
                    <hi rendition="#small-caps">Memorandum for: Imperial Japanese Government</hi>
                </p>
                <list>
                    <label>1.</label>
                    <item>Except as authorized by this Headquarters, the Japanese Government will,
                        from the receipt of this Memorandum, discontinue all communication between
                        itself and former Japanese diplomatic and consular representatives abroad
                        for any purpose other than to effect compliance with the provisions of the
                        Memorandum dated 25 October 1945 from this Headquarters, subject “Transfer
                        of Custody of Diplomatic and Consular Archives and Property,” and for the
                        purpose of informing such representatives of the provisions of this
                        Memorandum.</item>
                    <label>2.</label>
                    <item>Receipt of this Directive will be acknowledged.</item>
                </list>
                <closer>For the Supreme Commander: <lb/>
                    <signed>H. W.<hi rendition="#small-caps">Allen</hi>
                    </signed>
                    <lb/>
                    <hi rendition="#italic">Colonel, A.G.D.<lb/>Asst. Adjutant General</hi>
                </closer>
            </div>
        </body>
    </text>
