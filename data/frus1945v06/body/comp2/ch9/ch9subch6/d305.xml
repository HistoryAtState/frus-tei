    <text>
        <body>
            <div xml:id="d305">

                <pb facs="0441" n="429" sameAs="frus:frus1945v06/pg429"/>

                <note rend="inline" type="source">740.00115 PW/1–2545</note>
                <head>
                    <hi rendition="#italic">The Swedish Minister</hi> (<hi rendition="#italic"
                        >Boström</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <p>The Minister of Sweden in charge of the Japanese interests in the Territory of
                    Hawaii presents his compliments to the Honorable, the Secretary of State and has
                    the honor to forward herewith, copy of a cablegram dated January 23, 1945,
                    containing a renewed protest from the Japanese Government in reply to the note
                    of the Department of State of March 25, 1944, No. 740.00115, Pacific
                        War/2257<anchor n="12" xml:id="d305-f1"/> concerning the treatment of
                    Japanese civilians, interned in the Territory of Hawaii after the outbreak of
                    the war in December 1941.</p>
                <closer>
                    <dateline rendition="#float-left">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1945-01-25">January 25,
                            1945</date>.</dateline>
                </closer>


                <xi:include href="d305-a1.xml" xpointer="d305-a1"/>
            </div>
        </body>
    </text>
