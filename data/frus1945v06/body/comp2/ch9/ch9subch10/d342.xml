    <text>
        <body>
            <div xml:id="d342">

                <pb facs="0488" n="476" sameAs="frus:frus1945v06/pg476"/>

                <note rend="inline" type="source">740.00119 PW/2–2345: Telegram</note>
                <head>
                    <hi rendition="#italic">The Personal Representative of President Roosevelt to Pope Pius XII
                    </hi> (<hi rendition="#italic">Taylor</hi>) <hi
                        rendition="#italic">to the Secretary of State</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Vatican City</hi></placeName>, <date
                            calendar="gregorian" when="1945-02-23T11:00:00+01:00">February 23,
                            1945—11 a.m.</date>
                        <lb/> [Received February 23—9:05 a.m.]</dateline>
                </opener>
                <p>45. Re Department’s 23, February 21, 1 p.m. We have not seen Ken Harada, much
                    less talked with him.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Taylor</hi>
                    </signed>
                </closer>
            </div>
        </body>
