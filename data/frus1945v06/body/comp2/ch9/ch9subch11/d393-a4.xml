                <head>
                    <hi rendition="#small-caps">Appendix</hi> “C”</head>
                <p rendition="#center">
                    <hi rendition="#small-caps">Proclamation No</hi>. 1</p>
                <p rendition="#flush">
                    <hi rendition="#small-caps">To the People of Japan</hi>:</p>
                <p>
