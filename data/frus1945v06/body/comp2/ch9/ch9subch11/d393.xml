            <div xml:id="d393">

                <pb facs="0604" n="592" sameAs="frus:frus1945v06/pg592"/>

                <note rend="inline" type="source">SWNCC 21 Series</note>
                <head>
                    <hi rendition="#italic">Note by the Secretariat of the State-War-Navy
                        Coordinating Committee</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">SWNCC 21/3</seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1945-08-10">10 August, 1945</date>.</dateline>
                </opener>
                <p rendition="#center">
                    <hi rendition="#small-caps">Legal Implications of Unconditional Surrender</hi>
                </p>
                <table rend="width: 50%" rendition="#center">
                    <row>
                        <cell>References:</cell>
                        <cell>
                            <hi rendition="#italic">a</hi>. SWNCC 21.<anchor n="4" xml:id="d393-f1"
                            />
                        </cell>
                    </row>
                    <row>
                        <cell/>
                        <cell>
                            <hi rendition="#italic">b</hi>. SWNCC 21/2<anchor n="5" xml:id="d393-f2"
                            />
                        </cell>
                    </row>
                </table>
                <list>
                    <label>1.</label>
                    <item>The enclosure, a report by the SWNCC <hi rendition="#italic">ad hoc</hi>
                        Committee on Legal Implications of Unconditional Surrender, is circulated
                        for consideration by the Committee as a matter of urgency.</item>
                    <label>2.</label>
                    <item>A copy of this paper has been forwarded to the Joint Chiefs of Staff for
                        comment from a military point of view, as a matter of urgency. The comments
                        of the Joint Chiefs of Staff will be circulated for consideration by the
                        Committee upon receipt thereof from the Secretary, Joint Chiefs of
                        Staff.</item>
                </list>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Charles</hi> W. <hi rendition="#small-caps"
                            >McCarthy</hi>
                        <lb/>
                        <hi rendition="#small-caps">Alvin</hi> F. <hi rendition="#small-caps"
                            >Richardson</hi>
                        <lb/>
                        <hi rendition="#small-caps">Raymond E. Cox</hi>
                    </signed>
                    <lb/>
                    <hi rendition="#italic">Secretariat</hi>
                </closer>









