    <text>
        <body>
            <div xml:id="d296">

                <pb facs="0432" n="420" sameAs="frus:frus1945v06/pg420"/>

                <note rend="inline" type="source">711.94115 Exchange/5–945: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in Switzerland</hi> (<hi
                        rendition="#italic">Harrison</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Bern</hi></placeName>, <date
                            calendar="gregorian" when="1945-05-09">May 9, 1945</date>.<lb/>[Received
                        May 9—8:35 p.m.]</dateline>
                </opener>
                <p>2671. American Interests, Japan. Legation’s 1795, March 26. Swiss note May 5
                    states that Gorgé during conversation with Minister Suzuki, Chief of Foreign
                    Interests Section, Japanese Foreign Office, was informed that he had hoped to
                    find practical solution for second British exchange and later for third American
                    exchange but that all <pb facs="0433" n="421" xml:id="pg421"/> plans for
                    effecting these exchanges have been made much more difficult as result <hi
                        rendition="#italic">Awa Maru</hi> sinking.<anchor n="89" xml:id="d296-f1"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Harrison</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d296-f1" n="89" xml:id="d296-f1-content">
                <p>For documentation on the sinking of this Japanese vessel by an American
                    submarine, see <ref target="#pg460">pp. 460</ref> ff.</p>
            </note>
        </listAnnotation>
    </standOff>
