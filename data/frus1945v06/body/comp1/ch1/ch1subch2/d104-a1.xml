    <standOff>
        <listAnnotation>
            <note corresp="#d104-f1" n="*" xml:id="d104-f1-content">
                <p>The long-term right for the United States to use as a military base jointly with
                    the government exercising sovereignty. [Footnote in the original.]</p>
            </note>
            <note corresp="#d104-f2" n="†" xml:id="d104-f2-content">
                <p>The long-term right for the United States to use as a military base under the
                    exclusive control of the United States. [Footnote in the original.]</p>
            </note>
        </listAnnotation>
