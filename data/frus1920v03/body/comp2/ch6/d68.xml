                <pb facs="0194" n="94" xml:id="pg94"/>

                <note rend="inline" type="source">882.00/664: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Ambassador in
                        France</hi> (<hi rendition="#italic">Wallace</hi>)</head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-08-25T16:00:00-04:00"><hi rendition="#italic">August 25,
                                1920—4 p.m.</hi></date></dateline></opener>
                <p>1398. Your 1557 [<hi rendition="#italic">1567</hi>], August 17, 7 p.m.</p>
                <p>Discover if possible from Foreign Office the precise orders its representative
                    received.</p>
                <closer><signed><hi rendition="#small-caps">Colby</hi></signed></closer>
            </div>
        </body>
