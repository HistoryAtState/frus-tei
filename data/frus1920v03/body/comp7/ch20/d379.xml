    <text>
        <body>
            <div xml:id="d379">

                <pb facs="0425" n="325" xml:id="pg325"/>

                <note rend="inline" type="source">834.156/16: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Minister in
                        Paraguay</hi> (<hi rendition="#italic">Mooney</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1918-06-12T17:00:00-04:00"><hi rendition="#italic">June 12, 1918—5
                                p.m.</hi></date></dateline></opener>
                <p>Your number 300, April 9.<anchor n="5" xml:id="d379-f1"/></p>
                <p>You are instructed only to assist representative of Port Works Company in
                    securing an opportunity to state its case to the appropriate Paraguayan
                    official.</p>
                <closer><signed><hi rendition="#small-caps">Lansing</hi></signed></closer>
            </div>
        </body>
    </text>
