                <pb facs="0250" n="150" sameAs="frus:frus1920v03/pg150"/>

                <note rend="inline" type="source">812.00/24098</note>
                <head><hi rendition="#italic">The Chargé in Mexico</hi> (<hi
                            rendition="#italic">Summerlin</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1920-05-13"><hi rendition="#italic">May 13,
                        1920</hi></date>.<lb/>[Received May 25.]</dateline>
                    <seg rendition="#float-left">No. 3149</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In view of the number of references to the
                    Plan of “Agua Prieta” in the Embassy’s telegrams to the Department, I have the
                    honor to send enclosed, even at this late date, copy and translation of that
                    document.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">George T.
                    Summerlin</hi></signed></closer>


                <xi:include href="d165-a1.xml" xpointer="d165-a1"/>
            </div>
