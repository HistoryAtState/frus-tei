    <text>
        <body>
            <div xml:id="d162">

                <pb facs="0249" n="149" sameAs="frus:frus1920v03/pg149"/>

                <note rend="inline" type="source">812.00/23846: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Consul at Torreon</hi>
                        (<hi rendition="#italic">Donaldson</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-05-07T17:00:00-04:00"><hi rendition="#italic">May 7, 1920—5
                                p.m.</hi></date></dateline></opener>
                <p>Your May 5, noon.</p>
                <p>You may, in cases of necessity, exercise your informal good offices with local
                    Mexican authorities in behalf Chinese citizens in your district seeking
                    protection. See Department’s circular telegram September 30 last, 5 P.M.<anchor
                        n="14" xml:id="d162-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Colby</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d162-f1" n="14" xml:id="d162-f1-content">
                <p>Not printed; see note of Oct. 1, 1919, to the Chinese Chargé, <ref
                        target="frus1919v02#pg_577"><hi rendition="#italic">Foreign Relations</hi>,
                        1919, vol. <hi rendition="#small-caps">ii</hi>, p. 577</ref>.</p>
            </note>
