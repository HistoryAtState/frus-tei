                <pb facs="0253" n="153" sameAs="frus:frus1920v03/pg153"/>

                <note rend="inline" type="source">$12.00/23987: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Consul at Frontera</hi>
                        (<hi rendition="#italic">Blohm</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-05-18T17:00:00-04:00"><hi rendition="#italic">May 18, 1920—5
                                p.m.</hi></date></dateline></opener>
                <p>Your May 12, 1 P.M.<anchor n="17" xml:id="d167-f1"/></p>
                <p>Navy Department has been requested to send light draft vessel to Frontera and
                    Carmen.</p>
                <closer><signed><hi rendition="#small-caps">Colby</hi></signed></closer>
            </div>
        </body>
    </text>
