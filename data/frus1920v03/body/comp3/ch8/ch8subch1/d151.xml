            <div xml:id="d151">

                <pb facs="0245" n="145" sameAs="frus:frus1920v03/pg145"/>

                <note rend="inline" type="source">812.00/23734: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Chargé in Mexico</hi>
                        (<hi rendition="#italic">Hanna</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-04-28T14:00:00-04:00"><hi rendition="#italic">April 28,
                                1920—2 p.m.</hi></date></dateline></opener>
                <p>126. Consul Acapulco reports<anchor n="9" xml:id="d151-f1"/> having received
                    information that Obregón has gone to Iguala, and is proceeding toward Mexico
                    City with force of nine to ten thousand men.</p>
                <closer><signed><hi rendition="#small-caps">Colby</hi></signed></closer>
            </div>
        </body>
    </text>
