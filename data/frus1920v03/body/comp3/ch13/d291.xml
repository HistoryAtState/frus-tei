        <body>
            <div xml:id="d291">

                <pb facs="0344" n="244" xml:id="pg244"/>

                <note rend="inline" type="source">612.119/2859: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Consul at Nogales</hi> (<hi
                            rendition="#italic">Dyer</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-05-14T13:00:00-04:00"><hi rendition="#italic">May 14, 1920—1
                                p.m.</hi></date></dateline></opener>
                <p>Department does not see its way clear at this time to permit exportation rifles,
                    pistols, and cartridges mentioned in your May 12, 11 A.M.</p>
                <closer><signed><hi rendition="#small-caps">Polk</hi></signed></closer>
            </div>
        </body>
    </text>
