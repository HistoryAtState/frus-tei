            <div xml:id="d295">

                <pb facs="0347" n="247" xml:id="pg247"/>

                <note rend="inline" type="source">312.119/2932: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Consul at Mexicali</hi> (<hi rendition="#italic"
                            >Boyle</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-08-02"><hi rendition="#italic">August 2,
                        1920</hi></date>.</dateline></opener>
                <p>Your July 31st.</p>
                <p>Pending settlement present controversy, no more shipments explosives to your
                    district will be licensed.</p>
                <closer><signed><hi rendition="#small-caps">Colby</hi></signed></closer>
            </div>
        </body>
    </text>
