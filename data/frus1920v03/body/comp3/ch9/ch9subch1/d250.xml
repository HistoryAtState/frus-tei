                <pb facs="0297" n="197" sameAs="frus:frus1920v03/pg197"/>

                <note rend="inline" type="source">312.00/24782: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Chargé in Mexico</hi>
                        (<hi rendition="#italic">Summerlin</hi>)</head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-11-29T18:00:00-05:00"><hi rendition="#italic">November 29,
                                1920—6 p.m.</hi></date></dateline></opener>
                <p>246. Your telegram no. 457, November 27. Department advises that Foreign Office
                    be informed in writing that although you are not authorized to be present
                    officially at Obregón inauguration, you will be pleased to attend in private
                    capacity.</p>
                <closer><signed><hi rendition="#small-caps">Colby</hi></signed></closer>
            </div>
        </body>
    </text>
