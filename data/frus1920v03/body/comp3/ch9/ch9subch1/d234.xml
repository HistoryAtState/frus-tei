            <div xml:id="d234">

                <pb facs="0288" n="188" xml:id="pg188"/>

                <note rend="inline" type="source">812.00/24687: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Mexico</hi> (<hi
                            rendition="#italic">Hanna</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1920-10-13T10:00:00-06:36"><hi rendition="#italic">October 13,
                                1920—10 a.m.</hi></date><lb/>[Received 9:45
                    p.m.]</dateline></opener>
                <p>416. The Liberal Party press to-day publishes the autograph letter of the
                    President of the Swiss Confederation dated the 6th, ultimo in reply to Mr. de la
                    Huerta’s letter announcing that he had been elected Substitute President of
                    Mexico.</p>
                <closer><signed><hi rendition="#small-caps">Hanna</hi></signed></closer>
            </div>
        </body>
