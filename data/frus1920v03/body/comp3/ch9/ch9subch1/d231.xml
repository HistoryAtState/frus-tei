                <pb facs="0287" n="187" sameAs="frus:frus1920v03/pg187"/>

                <note rend="inline" type="source">812.00/24673</note>
                <head><hi rendition="#italic">The Chargé in Meixco</hi> (<hi
                            rendition="#italic">Hanna</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1920-09-25"><hi rendition="#italic">September 25,
                        1920</hi></date>.<lb/>[Received October 7.]</dateline>
                    <seg rendition="#float-left">No. 3390</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to report that the local
                    press of today, states that the Foreign Office has received an autograph letter
                    from the President of the Republic of Costa Rica in reply to Mr. de la Huerta’s
                    letter stating that he had been elected Substitute President of Mexico.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Matthew E. Hanna</hi></signed></closer>
            </div>
        </body>
