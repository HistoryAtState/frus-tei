                <pb facs="0292" n="192" sameAs="frus:frus1920v03/pg192"/>

                <note rend="inline" type="source">812.00/24760</note>
                <head><hi rendition="#italic">The Chargé in Mexico</hi> (<hi
                            rendition="#italic">Hanna</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1920-10-27"><hi rendition="#italic">October 27,
                        1920</hi></date>.<lb/>[Received November 5.]</dateline>
                    <seg rendition="#float-left">No. 3442</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith a
                    translation of an autograph letter of the President of Guatemala<anchor n="32"
                        xml:id="d239-f1"/> in reply to the autograph letter of Mr. de la Huerta
                    announcing that he had been elected Substitute President of Mexico.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Matthew E. Hanna</hi></signed></closer>
            </div>
        </body>
    </text>
