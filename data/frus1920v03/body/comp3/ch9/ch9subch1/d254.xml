                <pb facs="0298" n="198" sameAs="frus:frus1920v03/pg198"/>

                <note rend="inline" type="source">812.00/24809: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Mexico</hi> (<hi
                            rendition="#italic">Summerlin</hi>) <hi rendition="#italic"
                        >to the Acting Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1920-12-11T12:00:00-06:36"><hi rendition="#italic">December 11,
                                1920—12 noon</hi></date>.<lb/>[Received 6:30
                    p.m.]</dateline></opener>
                <p>473. Foreign Office confirms press reports published here today that the
                    Netherlands Government has recognized the Mexican Government.</p>
                <closer><signed><hi rendition="#small-caps">Summerlin</hi></signed></closer>
            </div>
        </body>
