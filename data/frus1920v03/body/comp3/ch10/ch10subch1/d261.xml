            <div xml:id="d261">

                <pb facs="0310" n="210" sameAs="frus:frus1920v03/pg210"/>

                <note rend="inline" type="source">812.6363/679</note>
                <head><hi rendition="#italic">The Chargé in Mexico</hi> (<hi rendition="#italic"
                        >Summerlin</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1920-05-07"><hi rendition="#italic">May 7,
                        1920</hi></date>.<lb/>[Received May 25.]</dateline>
                    <seg rendition="#float-left">No. 3129</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to send enclosed,
                    translation of a circular dated April 21, 1920, issued by the Mexican Department
                    of Industry, <pb facs="0311" n="211" xml:id="pg211"/> Commerce and Labor,
                    embodying regulations for the exploitation of petroleum and other hydrocarbons
                    existing in the federal zones of Mexico.</p>
                <p>This translation was made from an article which appeared in <hi
                        rendition="#italic">El Universal</hi> of April 30, 1920.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">George T.
                    Summerlin</hi></signed></closer>


                <xi:include href="d261-a1.xml" xpointer="d261-a1"/>
            </div>
