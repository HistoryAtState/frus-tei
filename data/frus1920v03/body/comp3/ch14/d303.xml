    <text>
        <body>
            <div xml:id="d303">

                <pb facs="0351" n="251" sameAs="frus:frus1920v03/pg251"/>

                <note rend="inline" type="source">125.61383 J 41/49</note>
                <head><hi rendition="#italic">The Chargé in Mexico</hi> (<hi
                            rendition="#italic">Summerlin</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1920-02-02"><hi rendition="#italic">February 2,
                        1920</hi></date>.<lb/>[Received February 13.]</dateline>
                    <seg rendition="#float-left">No. 2836</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to the Embassy’s telegram
                    No. 21, of February 2, 4 p.m.,<anchor n="79" xml:id="d303-f1"/> I have the honor
                    to transmit, herewith, copy and translation of Foreign Office Note No. 50, of
                    January 30, 1920, received <pb facs="0352" n="252" xml:id="pg252"/> to-day,
                    stating that the Mexican Government declines to issue an exequatur in favor of
                    Mr. William O. Jenkins as American Consular Agent at Puebla, and that the
                    provisional authorization issued to him is no longer in effect.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">George T.
                    Summerlin</hi></signed></closer>


                <xi:include href="d303-a1.xml" xpointer="d303-a1"/>
            </div>
        </body>
    </text>
