                <pb facs="0762" n="662" sameAs="frus:frus1920v03/pg662"/>

                <note rend="inline" type="source">702.60i11/1: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Commissioner at
                        Riga</hi> (<hi rendition="#italic">Young</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-09-23T18:00:00-04:00"><hi rendition="#italic">September 23,
                                1920—6 p.m.</hi></date></dateline></opener>
                <p>57. Your 152, September 13, 4 p.m.</p>
                <p>You may inform the Esthonian authorities that the United States Government would
                    have no objection to their sending to this country an unofficial agent with the
                    same status as those of Latvia and Lithuania.</p>
                <closer><signed><hi rendition="#small-caps">Colbt</hi></signed></closer>
            </div>
        </body>
    </text>
