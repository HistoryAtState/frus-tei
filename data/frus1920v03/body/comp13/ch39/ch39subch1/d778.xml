                <pb facs="0757" n="657" sameAs="frus:frus1920v03/pg657"/>

                <note rend="inline" type="source">760p.61/5: Telegram</note>
                <head><hi rendition="#italic">The Commissioner at Riga</hi> (<hi rendition="#italic"
                        >Young</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Riga</hi></placeName>, <date calendar="gregorian"
                            when="1920-08-11T19:00:00+01:36"><hi rendition="#italic">August 11,
                                1920—7 p.m.</hi></date><lb/>[Received 8:27 p.m.]</dateline></opener>
                <p>104. Latvian-Bolshevik peace treaty signed to-day. Will telegraph summary and
                    mail copy.<anchor n="44" xml:id="d778-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Young</hi></signed></closer>
            </div>
        </body>
    </text>
