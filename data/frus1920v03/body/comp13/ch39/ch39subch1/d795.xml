            <div xml:id="d795">

                <pb facs="0764" n="664" sameAs="frus:frus1920v03/pg664"/>

                <note rend="inline" type="source">760c.61/415</note>
                <head><hi rendition="#italic">The Commissioner at Riga</hi> (<hi rendition="#italic"
                        >Young</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Riga</hi></placeName>, <date calendar="gregorian" when="1920-10-15"
                                ><hi rendition="#italic">October 15, 1920</hi></date>.<lb/>[Received
                        November 15.]</dateline>
                    <seg rendition="#float-left">No. 229</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Adverting to my confidential despatch No.
                    204 of September 30, 1920,<anchor n="51" xml:id="d795-f1"/> I have the honor to
                    transmit herewith copy of a note<anchor n="51" xml:id="d795-f2"/> with an exact
                    copy of the enclosure thereto, received from the Latvian Foreign Office.</p>
                <p>In acknowledging the receipt of the note, I am simply stating that a copy thereof
                    will be transmitted to the Department of State.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Evan E. Young</hi></signed></closer>


                <xi:include href="d795-a1.xml" xpointer="d795-a1"/>
            </div>
        </body>
    </text>
