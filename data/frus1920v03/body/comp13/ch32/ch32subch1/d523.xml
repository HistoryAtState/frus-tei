    <text>
        <body>
            <div xml:id="d523">

                <pb facs="0557" n="457" sameAs="frus:frus1920v03/pg457"/>

                <note rend="inline" type="source">701.6111/505</note>
                <head><hi rendition="#italic">The Secretary of State to the Attorney General</hi>
                        (<hi rendition="#italic">Palmer</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-04-08"><hi rendition="#italic">April 8,
                        1920</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to the informal request of Mr.
                    Hoover, that this Department prepare a statement regarding diplomatic immunity
                    as applied to the case of Mr. L. C. A. K. Martens, I have the honor to enclose,
                    herewith for your information, a copy of a memorandum upon the subject,
                    embodying the views of this Department regarding Mr. Marten’s diplomatic status,
                    and the diplomatic immunity to be accorded him.</p>
                <p>I have [etc.]</p>
                <closer>For the Secretary of State:<lb/><signed><hi rendition="#small-caps">Frank L.
                            Polk</hi></signed><lb/><hi rendition="#italic">Under
                    Secretary</hi></closer>


                <xi:include href="d523-a1.xml" xpointer="d523-a1"/>
