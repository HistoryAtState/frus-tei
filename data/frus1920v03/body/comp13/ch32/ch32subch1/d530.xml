            <div xml:id="d530">

                <pb facs="0571" n="471" sameAs="frus:frus1920v03/pg471"/>

                <note rend="inline" type="source">760C.61/282</note>
                <head><hi rendition="#italic">The Russian Ambassador</hi> (<hi rendition="#italic"
                        >Bakhmeteff</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-08-28"><hi rendition="#italic">August 28,
                        1920</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I take pleasure in
                    forwarding herewith copy of a cable which I have just received from Mr. Struve,
                    Minister of Foreign Affairs of the Wrangel Government.</p>
                <p>It is needless for me to express to you my gratification of the response which
                    your note received in loyal Russia.</p>
                <p>With best regards [etc.]</p>
                <closer><signed><hi rendition="#small-caps">B. Bakhmeteff</hi></signed></closer>



                <xi:include href="d530-a1.xml" xpointer="d530-a1"/>
            </div>
        </body>
