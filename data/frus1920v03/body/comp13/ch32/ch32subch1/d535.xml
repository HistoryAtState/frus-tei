    <text>
        <body>
            <div xml:id="d535">

                <pb facs="0580" n="480" xml:id="pg480"/>

                <note rend="inline" type="source">701.6111/509a: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        Great Britain</hi> (<hi rendition="#italic">Davis</hi>)</head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-12-16T18:00:00-05:00"><hi rendition="#italic">December 16,
                                1920—6 p.m.</hi></date></dateline></opener>
                <p>1232. Order was signed today for deportation of Martens.<anchor n="20"
                        xml:id="d535-f1"/> It will be made public tomorrow.</p>
                <closer><signed><hi rendition="#small-caps">Davis</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d535-f1" n="20" xml:id="d535-f1-content">
                <p>Ludwig C. A. K. Martens left the United States Jan. 22, 1921.</p>
            </note>
        </listAnnotation>
    </standOff>
