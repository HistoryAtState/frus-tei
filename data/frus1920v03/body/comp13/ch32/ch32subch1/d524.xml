            <div xml:id="d524">

                <pb facs="0561" n="461" sameAs="frus:frus1920v03/pg461"/>

                <note rend="inline" type="source">861.00/6876: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Davis</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1920-05-07T17:00:00+01:00"><hi rendition="#italic">May 7, 1920—5
                                p.m.</hi></date><lb/>[Received May 7—2:11 p.m.]</dateline></opener>
                <p>748. I have received information from an official source to the effect that on
                    behalf of Bolshevik Russia Tchitcherin seems to have decided now definitely to
                    refuse to admit the delegation which it is the intention of the League of
                    Nations to have investigate Russian conditions.</p>
                <closer><signed><hi rendition="#small-caps">Davis</hi></signed></closer>
            </div>
