    <text>
        <body>
            <div xml:id="d532">

                <pb facs="0574" n="474" xml:id="pg474"/>

                <note rend="inline" type="source">760c.61/403</note>
                <head><hi rendition="#italic">Mr. L. Martens to the
                            Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >New York</hi></placeName>, <date calendar="gregorian"
                            when="1920-10-04"><hi rendition="#italic">October 4,
                        1920</hi></date>.<lb/>[Received October 5.]</dateline>
                    <seg rendition="#float-left">No. A–15</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit to you
                    herewith copy of a statement which I am instructed by the People’s Commissary
                    for Foreign Affairs of my Government to address to the Ambassador of Italy in
                    answer to your note on the Polish situation, dated August 10, 1920.</p>
                <p>I am [etc.]</p>
                <closer><signed><hi rendition="#small-caps">L. Martens</hi></signed><lb/><hi
                        rendition="#italic">Representative in the United States of the Russian
                        Socialist Federal Soviet Republic</hi></closer>


                <xi:include href="d532-a1.xml" xpointer="d532-a1"/>
            </div>
        </body>
    </text>
