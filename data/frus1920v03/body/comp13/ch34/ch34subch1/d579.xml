            <div xml:id="d579">

                <pb facs="0616" n="516" sameAs="frus:frus1920v03/pg516"/>

                <note rend="inline" type="source">861.00/7119</note>
                <head><hi rendition="#italic">The Japanese Ambassador</hi> (<hi rendition="#italic"
                        >Shidehara</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-07-03"><hi rendition="#italic">July 3,
                        1920</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: Permit me to enclose
                    herewith, for the information of the American Government, a Memorandum dealing
                    with the recent situation in Siberia. The decision of the Japanese Government
                    contained in the Memorandum has just been telegraphed to me, and has at the same
                    time been announced in Japan.</p>
                <p>Believe me [etc.]</p>
                <closer><signed><hi rendition="#small-caps">K. Shidehara</hi></signed></closer>


                <xi:include href="d579-a1.xml" xpointer="d579-a1"/>
