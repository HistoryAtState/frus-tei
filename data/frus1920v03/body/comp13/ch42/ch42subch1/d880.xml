            <div xml:id="d880">

                <pb facs="0816" n="716" sameAs="frus:frus1920v03/pg716"/>

                <note rend="inline" type="source">661.1115/91: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Da/vis</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1920-07-01T17:00:00+01:00"><hi rendition="#italic">July 1, 1920—5
                                p.m.</hi></date><lb/>[Received July 1—1:07 p.m.]</dateline></opener>
                <p>1011. My 1007, June 30, 6 p.m.<anchor n="5" xml:id="d880-f1"/> Krassin returns to
                    Moscow today. It seems as though present trade negotiations would probably be
                    unsuccessful.</p>
                <closer><signed><hi rendition="#small-caps">Davis</hi></signed></closer>
            </div>
        </body>
    </text>
