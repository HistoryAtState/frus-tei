                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Consul General at London</hi> (<hi rendition="#italic">Skinner</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-06-25T14:00:00-04:00"><hi rendition="#italic">June 25, 1920—2
                                p.m.</hi></date></dateline></opener>
                <p>Your June 25, 9 a.m. Do not attend.</p>
                <closer><signed><hi rendition="#small-caps">Davis</hi></signed></closer>
            </div>
