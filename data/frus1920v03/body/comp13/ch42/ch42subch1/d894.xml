    <text>
        <body>
            <div xml:id="d894">

                <pb facs="0825" n="725" xml:id="pg725"/>

                <note rend="inline" type="source">861.51/918</note>
                <head><hi rendition="#italic">The Assistant Secretary of the Treasury</hi> (<hi
                        rendition="#italic">Gilbert</hi>) <hi rendition="#italic">to the Acting
                        Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-12-23"><hi rendition="#italic">December 23,
                        1920</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Davis</hi>: Referring to your letter of
                    December 16, 1920,<anchor n="21" xml:id="d894-f1"/> I enclose for your
                    information a copy of my letter of this date to the Director of the Mint,
                    supplementing previous instructions as to acceptance of gold by United States
                    Mints and Assay Offices.</p>
                <p>Sincerely yours,</p>
                <closer><signed><hi rendition="#small-caps">S. P. Gilbert</hi>,
                    Jr.</signed></closer>


                <xi:include href="d894-a1.xml" xpointer="d894-a1"/>
            </div>
        </body>
    </text>
