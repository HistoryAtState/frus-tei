                <pb facs="0816" n="716" sameAs="frus:frus1920v03/pg716"/>

                <note rend="inline" type="source">661.1115/85: Telegram</note>
                <head><hi rendition="#italic">The Consul General at London</hi> (<hi
                        rendition="#italic">Skinner</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1920-06-25T09:00:00+01:00"><hi rendition="#italic">June 25, 1920—9
                                a.m.</hi></date><lb/>[Received June 25—7:25
                    a.m.]</dateline></opener>
                <p>Invited to attend meeting of the Permanent Committee of Supreme Economic Council
                    at 11 o’clock tomorrow morning, Saturday.</p>
                <p>Krassin and other Russian delegates will be present. Unless I am instructed to
                    the contrary immediately I shall advise Committee that I cannot be present.
                    Embassy informed.</p>
                <closer><signed><hi rendition="#small-caps">Skinner</hi></signed></closer>
            </div>
        </body>
