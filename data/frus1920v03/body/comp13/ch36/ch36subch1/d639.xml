                <pb facs="0653" n="553" sameAs="frus:frus1920v03/pg553"/>

                <note rend="inline" type="source">861a.00/2: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">Crane</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1920-10-04T20:00:00+08:00"><hi rendition="#italic">October 4,
                                1920—8 p.m.</hi></date><lb/>[Received October 4—3:50
                        p.m.]</dateline></opener>
                <p>294. Yourin<anchor n="80" xml:id="d639-f1"/> announces declaration Far Eastern
                    Republic at joint meeting Amur, Vladivostok and Verkhneudinsk delegations,
                    declares the united government recently established enjoys support and
                    disinterested help of Mother Russia, declares for peoples constitutional
                    assembly, institution of private ownership, taxes modified and no concession of
                    territory [to] foreign powers. Government will call upon Russian and foreign
                    capitalists to develop country. Full report by mail.<anchor n="81"
                        xml:id="d639-f2"/></p>
                <closer><signed><hi rendition="#small-caps">Crane</hi></signed></closer>
            </div>
        </body>
    </text>
