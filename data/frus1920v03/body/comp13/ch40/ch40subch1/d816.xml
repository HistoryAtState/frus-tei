    <text>
        <body>
            <div xml:id="d816">

                <pb facs="0777" n="677" xml:id="pg677"/>

                <note rend="inline" type="source">763.72115/3758: Telegram</note>
                <head><hi rendition="#italic">The Commissioner at Vienna</hi> (<hi
                        rendition="#italic">Halstead</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi><anchor n="69" xml:id="d816-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Vienna</hi></placeName>, <date calendar="gregorian"
                            when="1920-07-16T16:00:00+01:00"><hi rendition="#italic">July 16, 1920—4
                                p.m.</hi></date><lb/>[Received July 17—7:14
                    a.m.]</dateline></opener>
                <p>259. My 255, July 15, 4 [<hi rendition="#italic">3</hi>] p.m. Bela Kun
                    accompanied by Doctor Warta was sent to Russia at 9 o’clock last night. Will
                    have communications from Foreign Office to telegraph tomorrow.</p>
                <closer><signed><hi rendition="#small-caps">Halstead</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d816-f1" n="69" type="source" xml:id="d816-f1-content">
                <p>Sent via the Ambassador in France.</p>
            </note>
        </listAnnotation>
