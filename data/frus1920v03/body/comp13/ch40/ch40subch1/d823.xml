                <pb facs="0782" n="682" sameAs="frus:frus1920v03/pg682"/>

                <note rend="inline" type="source">361.11/3508: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Great Britain</hi> (<hi
                        rendition="#italic">Wright</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1920-08-28T14:00:00+01:00"><hi rendition="#italic">August 28,
                                1920—2 p.m.</hi></date><lb/>[Received August 28—11:30
                        a.m.]</dateline></opener>
                <p>1310. Hansen has replied by telegraph to Moscow conveying substance of message
                    contained in your 894, August 21, 5 p.m. Nansen leaves for Christiania today and
                    can be reached care of American Legation there.</p>
                <closer><signed><hi rendition="#small-caps">Wright</hi></signed></closer>
            </div>
        </body>
