    <text>
        <body>
            <div xml:id="d828">

                <pb facs="0785" n="685" sameAs="frus:frus1920v03/pg685"/>

                <note rend="inline" type="source">361.11/3544: Telegram</note>
                <head><hi rendition="#italic">The Commissioner at Riga</hi> (<hi rendition="#italic">Young</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Riga</hi></placeName>, <date calendar="gregorian"
                            when="1920-10-14T16:00:00+01:36"><hi rendition="#italic">October 14,
                                1920—4 p.m.</hi></date><lb/>[Received 5:48 p.m.]</dateline></opener>
                <p>220. Have reason to believe that should Department so desire immediate release of
                    all Americans now in Soviet Russia can be obtained in exchange for the Russian
                    children who have been in care American Red Cross and who have recently arrived
                        Finland.<anchor n="76" xml:id="d828-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Young</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d828-f1" n="76" xml:id="d828-f1-content">
                <p>Transported from Vladivostok.</p>
            </note>
        </listAnnotation>
    </standOff>
