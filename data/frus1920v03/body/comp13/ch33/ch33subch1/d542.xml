    <text>
        <body>
            <div xml:id="d542">

                <pb facs="0587" n="487" sameAs="frus:frus1920v03/pg487"/>

                <note rend="inline" type="source">861.00/6109</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Japanese Ambassador</hi> (<hi rendition="#italic"
                            >Shidehara</hi>)</head>
                <p>The Secretary of State presents his compliments to His Excellency, the Japanese
                    Ambassador, and has the honor to transmit to him herewith a memorandum
                    representing the situation in Siberia.</p>
                <closer>
                    <dateline rendition="#float-left">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1920-01-05"><hi
                                rendition="#italic">January 5, 1920</hi></date>.</dateline>
                </closer>


                <xi:include href="d542-a1.xml" xpointer="d542-a1"/>
