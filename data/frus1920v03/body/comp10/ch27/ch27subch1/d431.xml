    <text>
        <body>
            <div xml:id="d431">

                <pb facs="0470" n="370" sameAs="frus:frus1920v03/pg370"/>

                <note rend="inline" type="source">861.00/6242</note>
                <head><hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Davis</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1920-01-08"><hi rendition="#italic">January 8,
                        1920</hi></date>.<lb/>[Received January 27.]</dateline>
                    <seg rendition="#float-left">No. 1933</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Adverting to my despatch No. 1282 of
                    September 9, 1919,<anchor n="1" xml:id="d431-f1"/> I have the honor to transmit
                    herewith, for the information of the Department, a further consignment of the
                    compilations of wireless news from December 20, 1919, to January 3, 1920
                    inclusive, with which I have been furnished by the Foreign Office.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">John W. Davis</hi></signed></closer>


                <xi:include href="d431-a1.xml" xpointer="d431-a1"/>
            </div>
        </body>
    </text>
