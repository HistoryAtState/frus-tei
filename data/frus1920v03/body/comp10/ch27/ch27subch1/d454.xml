    <text>
        <body>
            <div xml:id="d454">

                <pb facs="0489" n="389" sameAs="frus:frus1920v03/pg389"/>

                <note rend="inline" type="source">760c.61/208: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic">Wallace</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1920-08-18T20:00:00+01:00"><hi rendition="#italic">August 18,
                                1920—8 p.m.</hi></date><lb/>[Received August 18—7:23
                        p.m.]</dateline></opener>
                <p>1577. A telegram has been received by Logan<anchor n="13" xml:id="d454-f1"/> from
                    [apparent omission]. It is dated at Warsaw August 17 and states on the authority
                    of an official telegram which was received that day that Tower<anchor n="14"
                        xml:id="d454-f2"/> had notified Polish representative at Danzig that unless
                    instructions were received from London munition ships would not be permitted to
                    unload at the harbor of Danzig.</p>
                <closer><signed><hi rendition="#small-caps">Wallace</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d454-f1" n="13" xml:id="d454-f1-content">
                <p>James A. Logan, Jr., American assistant unofficial representative on the
                    Reparations Commission.</p>
            </note>
            <note corresp="#d454-f2" n="14" xml:id="d454-f2-content">
                <p>Sir Reginald Tower, High Commissioner of the League of Nations at Danzig.</p>
            </note>
        </listAnnotation>
    </standOff>
