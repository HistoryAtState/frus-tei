    <text>
        <body>
            <div xml:id="d442">

                <pb facs="0482" n="382" sameAs="frus:frus1920v03/pg382"/>

                <note rend="inline" type="source">760c.61/37: Telegram</note>
                <head><hi rendition="#italic">The Minister in Poland</hi> (<hi
                            rendition="#italic">Gibson</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Warsaw</hi></placeName>, <date calendar="gregorian"
                            when="1920-03-27T19:00:00+02:00"><hi rendition="#italic">March 27,
                                1920—7 p.m.</hi></date><lb/>[Received March 29—3:18
                    a.m.]</dateline></opener>
                <p>173. My No. 170.<anchor n="6" xml:id="d442-f1"/> Polish Government has sent the
                    representatives [<hi rendition="#italic">sent radio</hi>] to Moscow declaring
                    its readiness to enter upon peace negotiations beginning April 10. Place
                    indicated by Polish Government for these negotiations is Bobruisk [or]
                    Borysow.</p>
                <closer><signed><hi rendition="#small-caps">Gibson</hi></signed></closer>
            </div>
        </body>
    </text>
