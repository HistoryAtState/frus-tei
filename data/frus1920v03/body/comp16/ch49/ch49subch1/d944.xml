                <pb facs="0887" n="787" sameAs="frus:frus1920v03/pg787"/>

                <note rend="inline" type="source">760j.6715/40</note>
                <head><hi rendition="#italic">The British Ambassador</hi> (<hi rendition="#italic"
                        >Geddes</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-08-06"><hi rendition="#italic">August 6,
                        1920</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 491</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honour, on instructions from my
                    Government, to enquire whether the President’s decision as to the boundaries of
                    Armenia, may be expected in the near future.</p>
                <p>I understand that this question has become a matter of urgency owing to the
                    imminent signature to the Peace Treaty with Turkey, the execution of which in
                    part, at least, depends on the President’s decision.</p>
                <p>I have [etc.]</p>
                <closer>(For H. M. Ambassador)<lb/><signed><hi rendition="#small-caps">Maurice
                            Peterson</hi></signed></closer>
            </div>
        </body>
    </text>
