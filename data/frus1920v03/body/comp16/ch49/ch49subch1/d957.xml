                <pb facs="0908" n="808" sameAs="frus:frus1920v03/pg808"/>

                <note rend="inline" type="source">760j.6715/70: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        France</hi> (<hi rendition="#italic">Wallace</hi>)</head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-12-17T14:00:00-05:00"><hi rendition="#italic">December 17,
                                1920—2 p.m.</hi></date></dateline></opener>
                <p>1707. Referring to your 2015 of December 16. Complying with Foreign Office
                    request, Department will not for the present make public the President’s
                    decision.</p>
                <closer><signed><hi rendition="#small-caps">Davis</hi></signed></closer>
            </div>
        </body>
