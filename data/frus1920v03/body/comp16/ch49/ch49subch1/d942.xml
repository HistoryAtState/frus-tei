    <text>
        <body>
            <div xml:id="d942">

                <pb facs="0883" n="783" sameAs="frus:frus1920v03/pg783"/>

                <note rend="inline" type="source">860j.01/280</note>
                <head><hi rendition="#italic">The Secretary of War</hi> (<hi rendition="#italic"
                        >Baker</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-06-02"><hi rendition="#italic">June 2,
                        1920</hi></date></dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: In reply to your letter
                    of May 26, 1920,<anchor n="27" xml:id="d942-f1"/> requesting the views of the
                    War Department as to the strength of <pb facs="0884" n="784" xml:id="pg784"/>
                    the American forces of occupation that would be needed for the successful
                    carrying out of a mandate for Armenia, I beg to inclose herewith a memorandum
                    which embodies the views of the Department upon this subject.</p>
                <p>I am [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Newton D. Baker</hi></signed></closer>


                <xi:include href="d942-a1.xml" xpointer="d942-a1"/>
            </div>
        </body>
    </text>
