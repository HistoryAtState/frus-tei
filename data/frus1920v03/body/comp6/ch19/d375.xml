    <text>
        <body>
            <div xml:id="d375">

                <pb facs="0420" n="320" sameAs="frus:frus1920v03/pg320"/>

                <note rend="inline" type="source">819.52/145</note>
                <head><hi rendition="#italic">The Secretary of War</hi> (<hi
                            rendition="#italic">Baker</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><seg rendition="#center">[Extract]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-07-14"><hi rendition="#italic">July 14,
                        1920</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to previous correspondence
                    relative to the acquisition of land on Taboga Island, Republic of Panama, I have
                        <pb facs="0421" n="321" xml:id="pg321"/> the honor to invite your attention
                    to the enclosed copy of a letter from the Governor of the Panama Canal, dated
                    June 18, 1920,<anchor n="6" xml:id="d375-f1"/> and enclosures thereto.<anchor
                        n="7" xml:id="d375-f2"/></p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>Respectfully,</p>
                <closer><signed><hi rendition="#small-caps">Newton D. Baker</hi></signed></closer>


                <xi:include href="d375-a1.xml" xpointer="d375-a1"/>
            </div>
        </body>
    </text>
