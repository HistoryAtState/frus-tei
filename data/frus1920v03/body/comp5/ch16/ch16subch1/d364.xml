                <pb facs="0410" n="310" sameAs="frus:frus1920v03/pg310"/>

                <note rend="inline" type="source">817.00/2746: Telegram</note>
                <head><hi rendition="#italic">The Minister in Nicaragua</hi> (<hi rendition="#italic">Jefferson</hi>) <hi
                        rendition="#italic">to the Acting Secretary of
                            State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Managua</hi></placeName>, <date calendar="gregorian"
                            when="1920-12-16T12:00:00-05:45"><hi rendition="#italic">December 16,
                                1920—noon</hi></date>.<lb/>[Received 9:30 p.m.]</dateline></opener>
                <p>65. José Estéban González, Coalition presidential candidate, died suddenly early
                    this morning, apoplexy reported cause of death.</p>
                <closer><signed><hi rendition="#small-caps">Jefferson</hi></signed></closer>
            </div>
        </body>
