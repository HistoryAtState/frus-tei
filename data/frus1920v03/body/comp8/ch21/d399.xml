            <div xml:id="d399">

                <pb facs="0444" n="344" sameAs="frus:frus1920v03/pg344"/>

                <note rend="inline" type="source">741.91/45</note>
                <head><hi rendition="#italic">The Chargé in Great Britain</hi> (<hi rendition="#italic">Wright</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1920-07-02"><hi rendition="#italic">July 2,
                        1920</hi></date>.<lb/>[Received July 14.]</dateline>
                    <seg rendition="#float-left">No. 3113</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith, for
                    the information of the Department, the official report of Questions and Answers
                    in the House of Commons on Tuesday, June 22, 1920, in regard to the
                    Anglo-Persian Agreement.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">J. Butler Wright</hi></signed></closer>



                <xi:include href="d399-a1.xml" xpointer="d399-a1"/>
            </div>
