            <div xml:id="d313">

                <pb facs="0360" n="260" sameAs="frus:frus1920v03/pg260"/>

                <note rend="inline" type="source">856d.6363/l</note>
                <head><hi rendition="#italic">The Consul at Batavia</hi> (<hi rendition="#italic"
                        >Jewell</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Batavia</hi></placeName>, <date calendar="gregorian"
                            when="1920-01-27"><hi rendition="#italic">January 27,
                        1920</hi></date>.<lb/>[Received March 23.]</dateline>
                    <seg rendition="#float-left">No. 254</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith, in
                    quadruplicate, a report on “Mineral Oil Concessions and Rights in Netherlands
                    India,” which, it is believed, should have the Department’s most careful
                    consideration.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">J. F. Jewell</hi></signed></closer>


                <xi:include href="d313-a1.xml" xpointer="d313-a1"/>
            </div>
