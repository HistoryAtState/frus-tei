        <body>
            <div xml:id="d512">

                <pb facs="1578" n="1420" sameAs="frus:frus1906p2/pg1420"/>

                <head><hi rendition="#italic">Minister O’Brien to
                        the Secretary of State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">Montevideo,
                                Uruguay</hi></placeName>, <date calendar="gregorian"
                            when="1906-03-16"><hi rendition="#italic">March 16,
                        1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 99.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to advise you that I have
                    received a personal note from the minister of foreign affairs relating to your
                    acceptance of Uruguay’s invitation, a copy of which is herewith inclosed.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Edward C.
                    O’Brien.</hi></signed></closer>


                <xi:include href="d512-a1.xml" xpointer="d512-a1"/>
