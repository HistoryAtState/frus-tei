    <text>
        <body>
            <div xml:id="d346">

                <pb facs="1402" n="1244" sameAs="frus:frus1906p2/pg1244"/>

                <head><hi rendition="#italic">Chargé Fletcher to
                        the Secretary of State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">Lisbon,
                                Portugal</hi></placeName>, <date calendar="gregorian"
                            when="1906-07-16"><hi rendition="#italic">July 16,
                        1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 244.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to forward herewith a
                    translation of the regulations governing the entry, residence, etc., of
                    foreigners in the colonial possessions of Portugal, which were promulgated by
                    decree of July 4 last.</p>
                <p>And to be, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Henry P.
                    Fletcher.</hi></signed></closer>


                <xi:include href="d346-a1.xml" xpointer="d346-a1"/>
