    <text>
        <body>
            <div xml:id="d567">

                <pb facs="1652" n="1494" sameAs="frus:frus1906p2/pg1494"/>

                <head><hi rendition="#italic">Ambassador White to the Secretary of
                    State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Rome</hi></placeName>, <date calendar="gregorian" when="1906-04-26"><hi
                                rendition="#italic">April 26, 1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 178.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith the
                    copy, with translation, of a letter which I have received from the president and
                    secretary of the Alliance Israelite Universelle relative to the suggestion which
                    I made at the Algeciras conference with respect to the better treatment of the
                    Jews of Morocco.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Henry White.</hi></signed></closer>


                <xi:include href="d567-a1.xml" xpointer="d567-a1"/>
            </div>
