    <text>
        <body>
            <div xml:id="d350">

                <pb facs="1405" n="1247" sameAs="frus:frus1906p2/pg1247"/>

                <head><hi rendition="#italic">Minister Riddle to
                        the Secretary of State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Bucharest</hi></placeName>, <date calendar="gregorian"
                            when="1906-06-20"><hi rendition="#italic">June 20,
                        1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 24. Roumanian Series.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith the
                    official text,<anchor n="a" xml:id="d350-f1"/> in French and Roumanian, of a
                    treaty of commerce between Roumania and Russia, in effect April 4, 1906.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">J. W. Riddle.</hi></signed></closer>
            </div>
        </body>
    </text>
