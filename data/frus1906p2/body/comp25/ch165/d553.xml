    <text>
        <body>
            <div xml:id="d553">

                <pb facs="1614" n="1456" sameAs="frus:frus1906p2/pg1456"/>

                <head><hi rendition="#italic">The Acting Secretary of
                            State to Minister Russell</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1906-11-21"><hi rendition="#italic">November 21,
                        1906</hi>.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit under separate cover to-day, for
                    your use, six copies of an address delivered by the Secretary of State on
                    November 20, 1906, before the Trans-Mississippi Commercial Congress.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Robert Bacon.</hi></signed></closer>
                <postscript>
                    <p>Same mutatis mutandis to American diplomatic representatives in Mexico and
                        Central and South American countries.</p>
                </postscript>



                <xi:include href="d553-a1.xml" xpointer="d553-a1"/>
