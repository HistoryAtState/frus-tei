    <text>
        <body>
            <div xml:id="d531">

                <pb facs="1595" n="1437" sameAs="frus:frus1906p2/pg1437"/>

                <head><hi rendition="#italic">Minister Russell to the Secretary of
                    State</hi>.</head>
                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Caracas</hi></placeName>, <date calendar="gregorian" when="1906-04-29"
                                ><hi rendition="#italic">April 29, 1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 73.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my cable on the subject, sent
                    through Bogota and duplicated through Trinidad, I have the honor to inclose
                    herewith translation of the answer from the Venezuelan Government to my
                    communications in regard to French vessels sailing from French ports direct to
                    Venezuela.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">William W.
                    Russell.</hi></signed></closer>


                <xi:include href="d531-a1.xml" xpointer="d531-a1"/>
            </div>
