    <text>
        <body>
            <div xml:id="d522">

                <pb facs="1591" n="1433" sameAs="frus:frus1906p2/pg1433"/>

                <head><hi rendition="#italic">Minister Russell to the Secretary of
                    State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Caracas</hi></placeName>, <date calendar="gregorian" when="1906-02-04"
                                ><hi rendition="#italic">February 4, 1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 53.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose for the French
                    Government a translation of a note to me from the French vice-consul here in
                    regard to the retiring of the exequaturs of the French consular officers in
                    Venezuela.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. W. Russell.</hi></signed></closer>


                <xi:include href="d522-a1.xml" xpointer="d522-a1"/>
            </div>
