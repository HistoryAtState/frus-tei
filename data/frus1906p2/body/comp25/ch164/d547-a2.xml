    <text>
        <body>
            <div xml:id="d547-a2">

                <pb facs="1608" n="1450" xml:id="pg1450"/>

                <opener><seg rendition="#center">[Inclosure 2.—Translation.]</seg></opener>
                <head><hi rendition="#italic">The Minister for Foreign
                            Affairs to Minister Russell</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Caracas</hi></placeName>, <date calendar="gregorian"
                            when="1906-01-11"><hi rendition="#italic">January 11,
                        1906</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Mr. Minister</hi>: I have the honor to acknowledge
                    the receipt of your courteous note of the 10th instant, and the constitutional
                    President of the Republic has been informed of the contents thereof.</p>
                <p>I take, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alejandro Ybarra.</hi></signed></closer>
            </div>
        </body>
    </text>
