    <text>
        <body>
            <div xml:id="d548">

                <pb facs="1612" n="1454" sameAs="frus:frus1906p2/pg1454"/>

                <head><hi rendition="#italic">Minister Russell to the Secretary of
                    State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Caracas</hi></placeName>, <date calendar="gregorian" when="1906-02-04"
                                ><hi rendition="#italic">February 4, 1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 51.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a copy
                    and translation of the last note from the Venezuelan minister for foreign
                    affairs in answer to the last note from the dean of the diplomatic corps
                    regarding the detention of Mr. Taigny, chargé de affaires of France, aboard the
                    French steamer <hi rendition="#italic">Martinique</hi> in La Guaira.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. W. Russell.</hi></signed></closer>


                <xi:include href="d548-a1.xml" xpointer="d548-a1"/>
            </div>
        </body>
    </text>
