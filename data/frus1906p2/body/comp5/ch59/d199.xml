    <text>
        <body>
            <div xml:id="d199">

                <pb facs="1251" n="1093" sameAs="frus:frus1906p2/pg1093"/>

                <head><hi rendition="#italic">Minister Hill to the Secretary of State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">The Hague, The
                                Netherlands</hi></placeName>, <date calendar="gregorian"
                            when="1905-12-15"><hi rendition="#italic">December 15,
                        1905</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 6 (Luxemburg series).</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a
                        note<anchor n="a" xml:id="d199-f1"/> from His Royal Highness the Grand Duke
                    of Luxemburg, together with office copy of the same, to the President announcing
                    the death of His Royal Highness the Grand Duke Adolpho and the accession of the
                    Grand Duke William to the Throne of the Grand Duchy of Luxemburg.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">David J. Hill.</hi></signed></closer>
            </div>
        </body>
    </text>
