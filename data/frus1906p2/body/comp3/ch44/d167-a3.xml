    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d167-f1" n="a" xml:id="d167-f1-content">
                <p>Chokunin—appointed by the Emperor; sonin—appointed by the cabinet;
                    hannin—appointed by the head of the department.</p>
            </note>
        </listAnnotation>
    </standOff>
