    <text>
        <body>
            <div xml:id="d136">

                <pb facs="1158" n="1000" sameAs="frus:frus1906p2/pg1000"/>

                <head><hi rendition="#italic">The Acting Secretary of State to Chargé
                    Wilson</hi>.</head>
                <opener><seg rendition="#center">[Telegram.—Extract.—Paraphrase.]<anchor n="a"
                            xml:id="d136-f1"/></seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1906-02-15"><hi rendition="#italic">February 15,
                        1906</hi></date>.</dateline></opener>
                <p>(Mr. Bacon authorizes a draft on the Secretary of State for $10,000 and directs
                    that proceeds be paid to the minister for foreign affairs as having been
                    collected by Red Cross, through Christian Herald, for Japanese famine relief.
                    The wish is expressed that it may be expended for food.)</p>
            </div>
        </body>
    </text>
