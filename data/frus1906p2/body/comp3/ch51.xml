                <pb facs="1227" n="1069" sameAs="frus:frus1906p2/pg1069"/>

                <head>Supplementary Convention for the Extradition of Criminals.</head>
                <p><hi rendition="#italic">Signed at Tokyo, May 17, 1906.</hi></p>
                <p><hi rendition="#italic">Ratification advised by the Senate, June 22,
                    1906.</hi></p>
                <p><hi rendition="#italic">Ratified by the President, June 28, 1906.</hi></p>
                <p><hi rendition="#italic">Ratified by Japan, September 22, 1906.</hi></p>
                <p><hi rendition="#italic">Ratifications exchanged at Tokyo, September 25,
                        1906.</hi></p>
                <p><hi rendition="#italic">Proclaimed, September 26, 1906.</hi></p>

                <xi:include href="ch51/d181.xml" xpointer="d181"/>
