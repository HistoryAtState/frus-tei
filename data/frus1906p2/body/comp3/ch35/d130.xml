    <text>
        <body>
            <div xml:id="d130">

                <pb facs="1150" n="992" sameAs="frus:frus1906p2/pg992"/>

                <head><hi rendition="#italic">Ambassador Wright to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Tokyo</hi></placeName>, <date calendar="gregorian" when="1906-11-26"
                                ><hi rendition="#italic">November 26, 1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 106.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith
                    translation of order No. 49 of the department of communications, which was
                    promulgated in to-day’s Official Gazette, announcing that arrangements have been
                    made by the Governments of Japan and the United States for the mutual
                    recognition of shipping certificates issued by either Government.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Luke E. Wright.</hi></signed></closer>


                <xi:include href="d130-a1.xml" xpointer="d130-a1"/>
