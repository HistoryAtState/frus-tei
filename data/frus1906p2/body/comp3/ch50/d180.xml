    <text>
        <body>
            <div xml:id="d180">

                <pb facs="1226" n="1068" sameAs="frus:frus1906p2/pg1068"/>

                <head><hi rendition="#italic">Ambassador Wright to the Secretary of
                    State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Tokyo</hi></placeName>, <date calendar="gregorian" when="1906-09-22"
                                ><hi rendition="#italic">September 22, 1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 61.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith
                    translations of recent ordinances relating to licenses for the practice of
                    medicine and dentistry in Japan.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Luke E. Wright.</hi></signed></closer>




                <xi:include href="d180-a1.xml" xpointer="d180-a1"/>
