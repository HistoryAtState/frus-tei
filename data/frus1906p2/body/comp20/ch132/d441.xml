    <text>
        <body>
            <div xml:id="d441">

                <pb facs="1508" n="1350" sameAs="frus:frus1906p2/pg1350"/>

                <head><hi rendition="#italic">Minister Collier to
                        the Secretary of State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Madrid</hi></placeName>, <date calendar="gregorian" when="1906-06-11"
                                ><hi rendition="#italic">June 11, 1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 112.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a
                    copy, with translation, of Their Majesties’ thanks, conveyed through the
                    ministry of state, for the congratulations of the President and Government of
                    the United States on the occasion of the providential escape, unharmed, of Their
                    Majesties, the King and Queen.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Wm. Miller
                    Collier.</hi></signed></closer>


                <xi:include href="d441-a1.xml" xpointer="d441-a1"/>
