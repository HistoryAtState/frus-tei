    <text>
        <body>
            <div xml:id="d39">

                <pb facs="1067" n="909" sameAs="frus:frus1906p2/pg909"/>

                <head><hi rendition="#italic">The Italian Chargé to the Secretary of
                    State</hi>.</head>
                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Royal Embassy of Italy</hi>,<lb/><hi rendition="#italic"
                                >Washington, D. C.</hi></placeName>, <date calendar="gregorian"
                            when="1906-03-07"><hi rendition="#italic">March 7,
                        1906</hi></date>.</dateline></opener>
                <p>Mr. <hi rendition="#small-caps">Secretary of State</hi>: In continuation of my
                    note No. 378 of the 27th of February last, I have the honor to transmit herewith
                    to your excellency a copy of the essential part of a communication from the
                    royal ministry of foreign affairs relative to the new measures taken in the
                    Kingdom in regard to certificates of origin.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">G. C. Montagna.</hi></signed></closer>


                <xi:include href="d39-a1.xml" xpointer="d39-a1"/>
