    <text>
        <body>
            <div xml:id="d41">

                <pb facs="1068" n="910" sameAs="frus:frus1906p2/pg910"/>

                <head><hi rendition="#italic">The Acting Secretary of State to Chargé
                    Hitt</hi>.</head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1906-04-06"><hi rendition="#italic">April 6,
                        1906</hi></date>.</dateline></opener>
                <p>In response to invitation just received from Italian embassy you are authorized
                    to be present at royal function in honor of Prof. Guido Baccelli, Policlinico
                    Humberto I, April 8, to represent the department of education this
                    Government.</p>
                <closer><signed><hi rendition="#small-caps">Bacon.</hi></signed></closer>
            </div>
        </body>
    </text>
