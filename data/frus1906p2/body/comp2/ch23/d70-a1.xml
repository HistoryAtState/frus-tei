    <text>
        <body>
            <div xml:id="d70-a1">

                <pb facs="1093" n="935" xml:id="pg935"/>

                <opener><seg rendition="#center">[Inclosure 1.]</seg></opener>
                <head><hi rendition="#italic">Consul-General De
                            Castro to Ambassador White</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Consulate-General</hi>,<lb/><hi rendition="#italic"
                                >Rome</hi></placeName>, <date calendar="gregorian" when="1906-06-02"
                                ><hi rendition="#italic">June 2,
                    1906</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith for
                    your consideration copy of a letter received by this office from the consul at
                    Palermo in regard to the counterfeiting of the consular seal of that
                    consulate.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Hector de Castro.</hi></signed></closer>
            </div>
        </body>
    </text>
