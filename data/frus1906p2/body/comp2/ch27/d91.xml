    <text>
        <body>
            <div xml:id="d91">

                <pb facs="1115" n="957" sameAs="frus:frus1906p2/pg957"/>

                <head><hi rendition="#italic">Ambassador White to
                        the Secretary of State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Rome</hi></placeName>, <date calendar="gregorian" when="1906-08-30"><hi
                                rendition="#italic">August 30, 1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 253.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to your instruction numbered 121
                    of the 13th ultimo, I have the honor to inclose herewith the copy of a note
                    which I have addressed to the foreign office relative to the inauguration of the
                    inspection of meat products under the law of June 30, 1906.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Henry White.</hi></signed></closer>


                <xi:include href="d91-a1.xml" xpointer="d91-a1"/>
            </div>
