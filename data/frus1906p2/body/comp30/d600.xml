    <text>
        <body>
            <div xml:id="d600">

                <pb facs="1787" n="1629" sameAs="frus:frus1906p2/pg1629"/>

                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Argentine
                    Minister</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1906-04-07"><hi rendition="#italic">April 7,
                        1906</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I beg to inclose for your information a
                    copy of a correspondence<anchor n="a" xml:id="d600-f1"/> between the Russian
                    ambassador at Washington and the Secretary of State in regard to the proposed
                    convoking of the Second Conference at The Hague during the first half of the
                    month of July next.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Robert Bacon.</hi></signed></closer>
                <postscript>
                    <p>Same to all the diplomatic representatives of American Republics.</p>
                </postscript>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d600-f1" n="a" xml:id="d600-f1-content">
                <p>Notes of April 3 and 6 from and to the Russian Embassy, supra.</p>
            </note>
        </listAnnotation>
