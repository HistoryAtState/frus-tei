    <text>
        <body>
            <div xml:id="d233">

                <pb facs="1283" n="1125" sameAs="frus:frus1906p2/pg1125"/>

                <head><hi rendition="#italic">The Acting Secretary of State to Chargé
                    McCreery</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1906-02-06"><hi rendition="#italic">February 6,
                        1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 97.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith a copy of a
                        letter<anchor n="a" xml:id="d233-f1"/> from Mr. G. T. Moeskes, asking if two
                    bonds, of which he gives a description and which were issued by the Mexican
                    Empire in 1864, are redeemable by the Mexican treasury.</p>
                <p>You will make informal inquiry in regard to the matter and report to the
                    department.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Robert Bacon.</hi></signed></closer>
            </div>
        </body>
    </text>
