    <text>
        <body>
            <div xml:id="d250">

                <pb facs="1304" n="1146" sameAs="frus:frus1906p2/pg1146"/>

                <head><hi rendition="#italic">The Acting Secretary of State to Ambassador
                        Thompson</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1906-05-23"><hi rendition="#italic">May 23,
                        1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 36.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith for your information in
                    connection with previous correspondence on the subject, a copy of a letter from
                    Mr. C. W. Burket,<anchor n="a" xml:id="d250-f1"/> general manager of the Ures
                    Consolidated Mining Company, in relation to the depredations of the Yaqui
                    Indians in Mexico.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Robert Bacon.</hi></signed></closer>
            </div>
        </body>
    </text>
