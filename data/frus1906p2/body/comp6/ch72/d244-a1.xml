                <pb facs="1301" n="1143" sameAs="frus:frus1906p2/pg1143"/>

                <opener><seg rendition="#center">[Inclosure 1.—Translation.]</seg></opener>
                <head><hi rendition="#italic">Mr. Alclasoro to Mr.
                            Algara</hi>.</head>
                <p rendition="#center">(Private correspondence of the secretary of fomento.)</p>
                <p>Mr. Andres Aldasoro has the pleasure to pay his respects to his good friend
                    Licentiate José Algara, subsecretary for foreign affairs, and to inclose copy of
                    the decision he has requested, pronounced by the President of the Republic, with
                    respect to the acquisition of lands by foreigners in Sonora and Lower
                    California.</p>
                <closer><dateline rendition="#float-left"><placeName>Mexico</placeName>, <date
                            calendar="gregorian" when="1906-03-24">March 24,
                    1906</date>.</dateline></closer>
            </div>
        </body>
