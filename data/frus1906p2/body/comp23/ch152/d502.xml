    <text>
        <body>
            <div xml:id="d502">

                <pb facs="1567" n="1409" sameAs="frus:frus1906p2/pg1409"/>

                <head><hi rendition="#italic">Chargé Jay to the
                            Secretary of State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1906-04-19"><hi rendition="#italic">April 19,
                        1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1361.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Replying further to the department’s No.
                    1023, of February 27, 1906, on the subject of alleged taxation in Turkey of
                    property owned in the United States by the Garabedian brothers, of Worcester,
                    Mass., I have the honor to inclose a report upon this subject from the American
                    consul at Harput which clearly shows that such taxation on the part of the
                    Turkish Government does not exist.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Peter Augustus
                    Jay.</hi></signed></closer>


                <xi:include href="d502-a1.xml" xpointer="d502-a1"/>
