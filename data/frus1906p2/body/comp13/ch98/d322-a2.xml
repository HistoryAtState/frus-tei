    <text>
        <body>
            <div xml:id="d322-a2">

                <pb facs="1371" n="1213" xml:id="pg1213"/>

                <opener><seg rendition="#center">[Inclosure 2.]</seg></opener>
                <head><hi rendition="#italic">The Minister for Foreign Affairs to Minister
                        Pearson</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Ministry for Foreign Affairs</hi>,<lb/><hi rendition="#italic"
                                >Teheran</hi></placeName>, <date calendar="gregorian"
                            when="1906-02-13"><hi rendition="#italic">February 13,
                        1906</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Minister</hi>: Your excellency’s note is
                    being submitted to the Shah, and on receipt of His Imperial Majesty’s command a
                    reply will be sent in due course.</p>
                <p>I beg, etc.,</p>
                <closer>(Signed) <signed><hi rendition="#small-caps">Hussein
                    Viuli.</hi></signed></closer>
            </div>
        </body>
    </text>
