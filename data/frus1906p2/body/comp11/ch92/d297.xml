    <text>
        <body>
            <div xml:id="d297">

                <pb facs="1347" n="1189" sameAs="frus:frus1906p2/pg1189"/>

                <head><hi rendition="#italic">The Norwegian Minister to
                        the Secretary of State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of Norway</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1906-05-05"><hi rendition="#italic">May 5,
                        1906</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inform your excellency
                    that His Majesty King Haakon has decided that the coronation shall take place
                    June 22 next.</p>
                <p>Accept, sir, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Chr. Hauge.</hi></signed></closer>
            </div>
        </body>
    </text>
