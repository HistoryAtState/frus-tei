    <text>
        <body>
            <div xml:id="d26">

                <pb facs="1053" n="895" sameAs="frus:frus1906p2/pg895"/>

                <head><hi rendition="#italic">Minister Furniss to
                        the Secretary of State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">Port au
                                Prince</hi></placeName>, <date calendar="gregorian"
                            when="1906-11-01"><hi rendition="#italic">November 1,
                        1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 121.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Agreeable to my dispatch No. 111, of
                    October 18, 1906, to the department, I beg leave to inclose herewith copy of the
                    text of the Anglo-Haitian naturalization treaty, as published in Le Moniteur of
                    yesterday.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">H. W. Furniss.</hi></signed></closer>


                <xi:include href="d26-a1.xml" xpointer="d26-a1"/>
