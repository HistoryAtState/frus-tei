                <pb facs="1048" n="890" sameAs="frus:frus1906p2/pg890"/>

                <opener><seg rendition="#center">[Inclosure 2.]</seg></opener>
                <head><hi rendition="#italic">Minister Furniss to
                        the Secretary of Foreign Relations</hi>.</head>
                <opener><dateline rendition="#float-right"><date calendar="gregorian"
                            when="1906-10-20"><hi rendition="#italic">October</hi> 20,
                        1906</date>.</dateline>
                    <seg rendition="#float-left">No. 94.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I am in receipt of your note of yesterday’s
                    date and take this occasion to thank you for your efforts in bringing about an
                    amicable settlement of the Boutros case.</p>
                <p>Please accept, Mr. Secretary, the assurances of my distinguished
                    consideration.</p>
                <closer><signed><hi rendition="#small-caps">H. W. Furniss</hi>, <hi
                            rendition="#italic">American Minister.</hi></signed></closer>
            </div>
        </body>
    </text>
