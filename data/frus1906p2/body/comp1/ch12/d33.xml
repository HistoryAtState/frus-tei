    <text>
        <body>
            <div xml:id="d33">

                <pb facs="1060" n="902" sameAs="frus:frus1906p2/pg902"/>

                <head><hi rendition="#italic">Minister Furniss to
                        the Secretary of State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">Port au
                                Prince</hi></placeName>, <date calendar="gregorian"
                            when="1906-10-10"><hi rendition="#italic">October 10,
                        1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 109.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I beg leave to inclose herewith copy of a
                    protocol signed by the French minister and the Haitian secretary of foreign
                    relations, published in the official paper of to-day, by which the commercial
                    treaty existing between the Governments of France and Haiti, and which would
                    have expired October 31, 1906, will be extended until January 31, 1907.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">H. W. Furniss.</hi></signed></closer>


                <xi:include href="d33-a1.xml" xpointer="d33-a1"/>
            </div>
