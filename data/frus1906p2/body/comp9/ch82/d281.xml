    <text>
        <body>
            <div xml:id="d281">

                <pb facs="1336" n="1178" sameAs="frus:frus1906p2/pg1178"/>

                <head><hi rendition="#italic">Minister Hill to the
                            Secretary of State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">The Hague,
                                Netherlands</hi></placeName>, <date calendar="gregorian"
                            when="1906-07-24"><hi rendition="#italic">July 24,
                        1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 102.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to state that the
                    Netherlands Official Gazette of this date announces that the exchange of the
                    acts of ratification of the extradition treaty between the Netherlands and
                    Greece of the 26th of August, 1905, took place at Athens on the 20th of July,
                    1906.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">David J. Hill.</hi></signed></closer>
            </div>
        </body>
    </text>
