    <text>
        <body>
            <div xml:id="d282">

                <pb facs="1336" n="1178" sameAs="frus:frus1906p2/pg1178"/>

                <head><hi rendition="#italic">Minister Hill to the Secretary of State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">The Hague,
                                Netherlands</hi></placeName>, <date calendar="gregorian"
                            when="1906-03-10"><hi rendition="#italic">March 10,
                        1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 69]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my predecessor’s No.
                        900,<anchor n="a" xml:id="d282-f1"/> dated June 30, 1905, relating to a
                    Netherlands-Danish arbitration treaty, I have the honor to state that the
                    Netherlands Official Gazette of this date announces that the acts of
                    ratification of the same were exchanged at The Hague on the 8th of March,
                    1906.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">David J. Hill.</hi></signed></closer>
            </div>
        </body>
    </text>
