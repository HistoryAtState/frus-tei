    <text>
        <body>
            <div xml:id="d283">

                <pb facs="1336" n="1178" sameAs="frus:frus1906p2/pg1178"/>

                <head><hi rendition="#italic">Minister Hill to the Secretary of State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">The Hague,
                                Netherlands</hi></placeName>, <date calendar="gregorian"
                            when="1906-02-20"><hi rendition="#italic">February 20,
                        1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 66.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my predecessor’s No.
                        792,<anchor n="b" xml:id="d283-f1"/> dated October 4, 1904, announcing the
                    signing of a Netherlands-Portuguese arbitration treaty, I have the honor to
                    inclose herewith, in duplicate, a copy of the law of February 5, 1906, whereby
                    the said treaty is ratified by the Netherlands Government.</p>
                <p>I annex a translation of the Dutch law to which the treaty in French text is
                    attached.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">David J. Hill.</hi></signed></closer>


                <xi:include href="d283-a1.xml" xpointer="d283-a1"/>
            </div>
        </body>
    </text>
