    <text>
        <body>
            <div xml:id="d368">

                <pb facs="1426" n="1268" xml:id="pg1268"/>

                <head><hi rendition="#italic">Chargé Eddy to the Secretary of State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic">St.
                                Petersburg</hi></placeName>, <date calendar="gregorian"
                            when="1906-08-29"><hi rendition="#italic">August 29,
                        1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 638.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to confirm herewith my
                    cablegram of yesterday,<anchor n="a" xml:id="d368-f1"/> and inclose herewith the
                    text, in French, of the order in question.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Spencer Eddy</hi>,<lb/><hi
                            rendition="#italic">Chargé d’Affaires ad interim.</hi></signed></closer>


                <xi:include href="d368-a1.xml" xpointer="d368-a1"/>
            </div>
        </body>
    </text>
    <standOff>
