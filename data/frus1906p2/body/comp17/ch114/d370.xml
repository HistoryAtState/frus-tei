    <text>
        <body>
            <div xml:id="d370">

                <pb facs="1428" n="1270" sameAs="frus:frus1906p2/pg1270"/>

                <head><hi rendition="#italic">Ambassador Meyer to the Secretary of
                    State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic">St.
                                Petersburg</hi></placeName>, <date calendar="gregorian"
                            when="1906-12-15"><hi rendition="#italic">December 15,
                        1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 719.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to report that an Imperial
                    ukase, dated November 22, has lately been published, granting peasants the right
                    to withdraw from the communal land system and become personal owners of the land
                    they cultivate.</p>
                <p>A translation of this ukase is attached hereto.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">G. v. L. Meyer.</hi></signed></closer>



                <xi:include href="d370-a1.xml" xpointer="d370-a1"/>
            </div>
