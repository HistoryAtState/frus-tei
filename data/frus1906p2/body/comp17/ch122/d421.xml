    <text>
        <body>
            <div xml:id="d421">

                <pb facs="1476" n="1318" sameAs="frus:frus1906p2/pg1318"/>

                <head><hi rendition="#italic">Ambassador Meyer to
                        the Secretary of State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic">St.
                                Petersburg</hi></placeName>, <date calendar="gregorian"
                            when="1906-05-02"><hi rendition="#italic">May 2,
                        1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 503.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In compliance with the department’s
                    instructions cabled to me under date of April 18, I have the honor to inclose
                    herewith a copy in Russian of the proceedings and decision of the supreme court
                    in St. Petersburg in the case of the <hi rendition="#italic">Knight
                        Commander</hi>, as well as a copy in Russian of Mr. Berline’s protest as
                    regards neutral goods, together with the translation into English of both these
                    documents.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">G. von L. Meyer.</hi></signed></closer>



                <xi:include href="d421-a1.xml" xpointer="d421-a1"/>
