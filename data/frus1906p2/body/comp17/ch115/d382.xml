    <text>
        <body>
            <div xml:id="d382">

                <pb facs="1440" n="1282" sameAs="frus:frus1906p2/pg1282"/>

                <head><hi rendition="#italic">Chargé Eddy to the Secretary of State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic">St.
                                Petersburg</hi></placeName>, <date calendar="gregorian"
                            when="1906-08-23"><hi rendition="#italic">August 23,
                        1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 634.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I beg leave to confirm herewith my
                    cablegram of to-day sent en clair, as follows: <quote rend="blockquote">
                        <p>All strikes concluded, Reval; factories have resumed work.</p>
                    </quote></p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Spencer Eddy</hi>.</signed></closer>
            </div>
        </body>
    </text>
