    <text>
        <body>
            <div xml:id="d402">

                <pb facs="1453" n="1295" sameAs="frus:frus1906p2/pg1295"/>

                <head><hi rendition="#italic">The Acting Secretary of State to Ambassador
                    Meyer</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1906-06-13"><hi rendition="#italic">June 13,
                        1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 150.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    No. 519, of the 24th ultimo, inclosing copies of your note to the foreign office
                    and of your note to the British embassy at St. Petersburg, in regard to the
                    murder of Mr. Stuart, the American vice-consul at Batum. Your action is
                    approved.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Robert Bacon.</hi></signed></closer>
            </div>
        </body>
    </text>
