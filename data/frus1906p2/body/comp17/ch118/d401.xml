    <text>
        <body>
            <div xml:id="d401">

                <pb facs="1452" n="1294" sameAs="frus:frus1906p2/pg1294"/>

                <head><hi rendition="#italic">Ambassador Meyer to the Secretary of
                    State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic">St.
                                Petersburg</hi></placeName>, <date calendar="gregorian"
                            when="1906-06-05"><hi rendition="#italic">June 5,
                        1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 532.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In regard to the murder of the United
                    States vice-consul at Batoum, Mr. W. H. Stuart, I now beg leave to inclose for
                    the information of the department, a copy of a letter dated May 22, and its
                    inclosure, from the British consul at that place, reporting the circumstances of
                    the crime.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">G. von L. Meyer.</hi></signed></closer>



                <xi:include href="d401-a1.xml" xpointer="d401-a1"/>
