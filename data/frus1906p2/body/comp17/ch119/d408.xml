    <text>
        <body>
            <div xml:id="d408">

                <pb facs="1455" n="1297" sameAs="frus:frus1906p2/pg1297"/>

                <head><hi rendition="#italic">Ambassador Meyer to the Acting Secretary of
                    State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic">St.
                                Petersburg</hi></placeName>, <date calendar="gregorian"
                            when="1906-07-13"><hi rendition="#italic">July 13,
                        1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 574.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I beg leave to inclose herewith the
                    official communication on the disorders at Bielostock and a copy of a
                        letter<anchor n="a" xml:id="d408-f1"/> received from Mr. Stolypin, minister
                    of the interior.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">G. von L. Meyer.</hi></signed></closer>


                <xi:include href="d408-a1.xml" xpointer="d408-a1"/>
            </div>
        </body>
    </text>
