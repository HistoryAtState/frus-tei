    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d50-f1" n="1" type="source" xml:id="d50-f1-content">
                <p>Source: Johnson Library, Bromley Smith Papers, Organization of SIG. No
                    classification marking. The memorandum is marked with an indication that,
                    together with the attachments, it was included in the President’s Night Reading
                    and that the President saw it.</p>
            </note>
