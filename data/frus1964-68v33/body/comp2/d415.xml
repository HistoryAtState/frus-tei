    <text>
        <body>
            <div xml:id="d415">

                <pb facs="0932" n="898" xml:id="pg898"/>

                <head>415. Memorandum From the Executive Secretary of the National Security Council
                    (Smith) to President Johnson<anchor n="1" xml:id="d415-f1"/>
                </head>
                <opener><dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            when="1967-03-29T19:45:00-05:00">March 29, 1967, 7:45 p.m.</date>
                    </dateline></opener>
                <p rendition="#flush">Mr. President:</p>
                <p>Secretary Rusk’s report of Ambassador Goldberg’s conversation with Secretary
                    General U Thant was based on the attached summary of a telephone report from New
                    York. The full memorandum of the conversation is not yet ready but will be
                    available by morning.<anchor n="2" xml:id="d415-f2"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Bromley Smith</hi>
                    </signed>
                </closer>


                <xi:include href="d415-a1.xml" xpointer="d415-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d415-f1" n="1" type="source" xml:id="d415-f1-content">
                <p>Source: Johnson Library, National Security File, Agency File, United Nations,
                    Vol. 7. Secret. An annotation on the memorandum indicates President Johnson saw
                    it.</p>
            </note>
            <note corresp="#d415-f2" n="2" xml:id="d415-f2-content">
