            <div xml:id="errata">

                <pb facs="0029" n="[]" xml:id="pg-seq-29"/>

                <opener>
                    <seg rendition="#center">
                        <hi rendition="#italic">Foreign Relations of the United States, 1947, Volume
                            I</hi>
                    </seg>
                </opener>
                <head>Errata</head>
                <p>
                    <ref target="#pg119">Page 119</ref>, footnote 4. Final sentence should read:
                    “For text, see the <hi rendition="#italic">New York Times</hi>, September 15,
                    1947, p. 3, or Department of State <hi rendition="#italic">Bulletin</hi>,
                    September 21, 1947, p. 539.”</p>
                <p>
                    <ref target="#pg235">Page 235</ref>, line 13: “Lord Inverchapel”.</p>
                <p>
                    <ref target="#pg235">Page 235</ref>, footnote 2 in center of page, last line:
                    “see editorial note, <ref target="#pg228">p. 228</ref>”.</p>
            </div>
        </body>
    </text>
