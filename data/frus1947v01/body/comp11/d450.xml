    <text>
        <body>
            <div xml:id="d450">

                <pb facs="0933" n="903" sameAs="frus:frus1947v01/pg903"/>

                <note rend="inline" type="source">Department of State Atomic Energy Files</note>
                <head>
                    <hi rendition="#italic">Memorandum by the Director of Central Intelligence</hi>
                        (<hi rendition="#italic">Hillenkoetter</hi>)</head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1947-12-15">15 December 1947</date>.</dateline>
                </opener>
                <table>
                    <row role="label">
                        <cell>Memorandum to:</cell>
                        <cell>Senator B. B. Hickenlooper</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell>Mr. Robert A. Lovett</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell>Rear Admiral Thomas B. Inglis<anchor n="1" xml:id="d450-f1"/>
                        </cell>
                    </row>
                    <row>
                        <cell/>
                        <cell>Major General S. J. Chamberlin<anchor n="2" xml:id="d450-f2"/>
                        </cell>
                    </row>
                    <row>
                        <cell/>
                        <cell>Major General George C. McDonald<anchor n="3" xml:id="d450-f3"/>
                        </cell>
                    </row>
                    <row>
                        <cell/>
                        <cell>Major General L. R. Groves</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell>Dr. Vannevar Bush</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell>Admiral John Gingrich<anchor n="4" xml:id="d450-f4"/>
                        </cell>
                    </row>
                </table>
                <pb facs="0934" n="904" xml:id="pg904"/>
                <p rendition="#flush">Subject: Status of Russian Atomic Energy Project.</p>
                <list>
                    <label>1.</label>
                    <item>There is attached hereto the latest study on the Russian atomic energy
                        project prepared and coordinated with Scientific Branch—ONI, Scientific Branch—MID, and Director of Intelligence—AEC.</item>
                    <label>2.</label>
                    <item>The study contains many items of sensitive intelligence information and it
                        is strongly urged that its circulation be under appropriate
                        safeguards.</item>
                </list>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">R. H. Hillenkoetter</hi>
                    </signed>
                </closer>


                <xi:include href="d450-a1.xml" xpointer="d450-a1"/>
            </div>
        </body>
    </text>
