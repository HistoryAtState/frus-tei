                        <cell/>
                        <cell>Satterthwaite<anchor n="13" xml:id="d383-f13"/> (for
                                Timberlake,<anchor n="14" xml:id="d383-f14"/> NEA)</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell>
                            <hi rendition="#italic">Consultants:</hi> Messrs. Abbott,<anchor n="15"
