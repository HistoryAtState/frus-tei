                <head>
                    <hi rendition="#italic">Minutes of the Thirty-Seventh Meeting of the Policy
                        Committee on Arms and Armaments, Washington, March 7, 1947, 10:30
                        a.m.</hi><anchor n="2" xml:id="d383-f2"/>
                </head>
                <dateline>
                    <placeName>Washington</placeName>, <date
                        ana="#date_undated-inferred-from-document-head" calendar="gregorian"
                        when="1947-03-07T10:30:00-05:00">March 7, 1947, 10:30 a.m.</date>
                </dateline>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                    </seg>
                    <lb/>
                    <seg rendition="#float-left"> PCA M–37</seg>
                </opener>
