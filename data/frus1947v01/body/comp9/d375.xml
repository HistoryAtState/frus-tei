            <note corresp="#d375-f2" n="2" xml:id="d375-f2-content">
                <p>
                    <hi rendition="#italic">Ante</hi>, <ref target="#pg698">pp. 698</ref> and <ref
                        target="#pg699">699</ref>.</p>
            </note>
            <note corresp="#d375-f3" n="3" xml:id="d375-f3-content">
                <p>The Commission next convened on January 16, 1948.</p>
            </note>
            <note corresp="#d375-f4" n="4" xml:id="d375-f4-content">
                <p>December 9.</p>
            </note>
        </listAnnotation>
    </standOff>
