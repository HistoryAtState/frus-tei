    <text>
        <body>
            <div xml:id="d217">

                <pb facs="0406" n="376" sameAs="frus:frus1947v01/pg376"/>

                <note rend="inline" type="source">500.A/1–2747</note>
                <head>
                    <hi rendition="#italic">Memorandum of Conversation, by the Under Secretary of
                        State</hi> (<hi rendition="#italic">Acheson</hi>)</head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1947-01-27">January 27, 1947</date>.</dateline>
                </opener>
                <p rendition="#flush">Subject: Discussion of the Question of Disarmament by the
                    Security Council</p>
                <p>The British Ambassador<anchor n="1" xml:id="d217-f1"/> called on me at his
                    request. He handed me the attached <hi rendition="#italic">aide-mémoire</hi> and
                    read me the attached confidential explanation of Mr. Bevin’s attitude.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Dean Acheson</hi>
                    </signed>
                </closer>



                <xi:include href="d217-a1.xml" xpointer="d217-a1"/>
                <xi:include href="d217-a2.xml" xpointer="d217-a2"/>
