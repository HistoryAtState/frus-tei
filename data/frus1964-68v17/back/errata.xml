            <div xml:id="errata">

                <pb facs="0608" n="580" xml:id="pg580"/>

                <head>Errata</head>
                <p>The following changes have been made to the online version of <ref
                        target="frus:frus1964-68v17">
                        <hi rendition="#italic">Foreign Relations</hi>, 1964–1968, Volume
                    XVII</ref>, Eastern Europe. Please be aware that printed volumes have not been
                    revised. Revised information is in italic.</p>
                <list type="simple">
                    <item>
                        <hi rendition="#bold">1. Persons. Page XXV.</hi>
                    </item>
                    <item>The new entry reads: <hi rendition="#bold">Birladeanu, Alexandru,</hi>
                        Romanian Deputy Prime Minister</item>
                    <item>The entry originally read: <hi rendition="#bold">Birladeanu,
                            Alexandru,</hi> Bulgarian Deputy Prime Minister</item>
                </list>
            </div>
        </body>
    </text>
