    <text>
        <body>
            <div xml:id="d512-a1">

                <pb facs="0922" n="860" xml:id="pg860"/>

                <opener><seg rendition="#center">[Inclosure 1 in No. 229.—Telegram.]</seg></opener>
                <head><hi rendition="#italic">Mr. Maynard to Mr. Evarts.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1878-03-06"><hi rendition="#italic">March</hi> 6,
                        1878</date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Evarts</hi>, <hi
                        rendition="#italic">Washington:</hi></p>
                <p>Preliminaries of peace between Turkey and Russia signed at San Stefano Sunday
                    last.</p>
                <closer><signed>MAYNARD.</signed></closer>
            </div>
        </body>
