    <text>
        <body>
            <div xml:id="d246">

                <pb facs="0434" n="372" sameAs="frus:frus1878/pg372"/>

                <head>No. 241.<lb/><hi rendition="#italic">Mr. Read
                        to Mr. Evarts</hi>.</head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Athens</hi></placeName>, <date calendar="gregorian"
                            when="1878-04-12"><hi rendition="#italic">April</hi> 12,
                        1878</date>.</dateline></opener>
                <p rendition="#flush">To Secretary <hi rendition="#small-caps">Evarts</hi>,<lb/><hi
                        rendition="#italic">Washington:</hi></p>
                <p>Greece accepts our invitation, and will send representative to the bi-metallic
                    conference.</p>
                <closer><signed>READ.</signed></closer>
            </div>
        </body>
