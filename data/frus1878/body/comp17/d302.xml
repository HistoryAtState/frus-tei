    <text>
        <body>
            <div xml:id="d302">

                <pb facs="0540" n="478" sameAs="frus:frus1878/pg478"/>

                <head>No. 297.<lb/><hi rendition="#italic">Mr. Wurts to Mr. Evarts</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Rome</hi></placeName>, <date calendar="gregorian" when="1878-08-17"
                                ><hi rendition="#italic">August</hi> 17, 1878</date>. (Received
                        August 30.)</dateline>
                    <seg rendition="#float-left">No. 784.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose to you herewith
                    a copy of an unofficial communication from Mr. Huntington, vice-consul at
                    Florence, on the subject of a new and vexatious regulation of the Italian
                    custom-house, to be noticed as the Department deems advisable.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>GEORGE W. WURTS.</signed></closer>


                <xi:include href="d302-a1.xml" xpointer="d302-a1"/>
