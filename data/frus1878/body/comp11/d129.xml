                <pb facs="0241" n="179" sameAs="frus:frus1878/pg179"/>

                <head>No. 124.<lb/><hi rendition="#italic">Mr. Evarts to Mr. Hitt</hi>.</head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1878-07-19"><hi rendition="#italic">July</hi> 19,
                        1878</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Hitt</hi>, <hi rendition="#italic">Chargé
                    Paris:</hi></p>
                <p>Request French Government to issue invitations to powers accepting monetary
                    conference for meeting at Paris tenth August.</p>
                <p rendition="#center">* * * * * * *</p>
                <closer><signed>EVARTS, <hi rendition="#italic">Secretary.</hi></signed></closer>
            </div>
        </body>
