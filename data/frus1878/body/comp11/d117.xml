        <body>
            <div xml:id="d117">

                <pb facs="0231" n="169" sameAs="frus:frus1878/pg169"/>

                <head>No. 112.<lb/><hi rendition="#italic">Mr. Noyes to Mr. Evarts</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1877-12-28"><hi rendition="#italic">December</hi> 28, 1877</date>.
                        (Received January 10, 1878.)</dateline>
                    <seg rendition="#float-left">No. 45.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith copy
                    of a communication from the French minister of foreign affairs, relating to the
                    participation of the United States in the International Exhibition of Paris in
                    1878.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>EDWARD F. NOYES.</signed></closer>


                <xi:include href="d117-a1.xml" xpointer="d117-a1"/>
