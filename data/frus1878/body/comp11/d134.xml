    <text>
        <body>
            <div xml:id="d134">

                <pb facs="0244" n="182" xml:id="pg182"/>

                <head>No. 129.<lb/><hi rendition="#italic">Mr. Noyes to Mr. Evarts</hi>.</head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1878-09-24"><hi rendition="#italic">September</hi> 24,
                        1878</date>. (Received September 24.)</dateline></opener>
                <p><hi rendition="#small-caps">Evarts</hi>, <hi rendition="#italic"
                    >Washington:</hi></p>
                <p>Four thousand dollars more yellow fever fund sent your credit New York, including
                    five thousand francs from Marshal and Madame Mac-Mahon.</p>
                <closer><signed>NOYES.</signed></closer>
            </div>
        </body>
