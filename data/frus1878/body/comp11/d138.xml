    <text>
        <body>
            <div xml:id="d138">

                <pb facs="0252" n="190" sameAs="frus:frus1878/pg190"/>

                <head>No. 133.<lb/><hi rendition="#italic">Mr. Noyes to Mr. Evarts</hi>.</head>
                <opener><dateline rendition="#center">[Telegram.—Received <date calendar="gregorian"
                            type="received-date" when="1878-10-17">October 17,
                        1878</date>.]</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Evarts</hi>, <hi
                        rendition="#italic">Washington:</hi></p>
                <p>Four thousand dollars more with Munroe, your credit for yellow fever.</p>
                <closer><signed>NOYES</signed>,<lb/><hi rendition="#italic">Paris.</hi></closer>
            </div>
        </body>
