    <text>
        <body>
            <div xml:id="d408">

                <pb facs="0769" n="707" sameAs="frus:frus1878/pg707"/>

                <head>No. 403.<lb/><hi rendition="#italic">Mr. Burlage to Mr. Evarts.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Consulate General of the Netherlands</hi>,<lb/><hi
                                rendition="#italic">New York</hi></placeName>, <date
                            calendar="gregorian" when="1878-07-31"><hi rendition="#italic">July</hi>
                            31, 1878</date>. (Received August 1, 1878.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In pursuance of the instructions received
                    from the Netherlands Government, I have the honor to send you herewith two
                    copies of the royal decree of the 22d of June last (Official Gazette, No. 97),
                    concerning the exemption from measurements of United States vessels.</p>
                <p>Accept, &amp;c.,</p>
                <closer><signed>C. BURLAGE.</signed></closer>



                <xi:include href="d408-a1.xml" xpointer="d408-a1"/>
