    <text>
        <body>
            <div xml:id="d450">

                <pb facs="0824" n="762" sameAs="frus:frus1878/pg762"/>

                <head>No. 445.<lb/><hi rendition="#italic">Mr. Hoffman to Mr. Evarts.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic">St.
                                Petersburg</hi></placeName>, <date calendar="gregorian"
                            when="1878-06-04"><hi rendition="#italic">June</hi> 4, 1878</date>.
                        (Received June 20.)</dateline>
                    <seg rendition="#float-left">No. 42.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to Mr. Stoughton’s dispatch No.
                    19, in reference to discriminating duties imposed upon United States commerce in
                    Russia, I have the honor to inclose herewith a copy of a note this day received
                    from Mr. de Giers upon this subject, with a translation of the same.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>WICKHAM HOFFMAN.</signed></closer>


                <xi:include href="d450-a1.xml" xpointer="d450-a1"/>
