    <text>
        <body>
            <div xml:id="d448">

                <pb facs="0823" n="761" sameAs="frus:frus1878/pg761"/>

                <head>No. 443.<lb/><hi rendition="#italic">Mr. Hoffman to Mr. Evarts</hi>.</head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >St. Petersburg</hi></placeName>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Evarts</hi>, <hi
                        rendition="#italic">Washington, United States:</hi></p>
                <p>Russia accepts Congress condition, study question only. Reserves liberty of
                    action as regards further measures. Prefers European city.</p>
                <closer><signed>HOFFMAN.</signed>
                    <lb/>
                    <dateline rendition="#float-left">Received <date calendar="gregorian"
                            type="received-date" when="1878-06-03">June 3, 1878</date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
