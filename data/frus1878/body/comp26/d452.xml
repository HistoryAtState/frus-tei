        <body>
            <div xml:id="d452">

                <pb facs="0825" n="763" sameAs="frus:frus1878/pg763"/>

                <head>No. 447.<lb/><hi rendition="#italic">Mr. Stoughton to Mr. Evarts.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic">St.
                                Petersburg</hi></placeName>, <date calendar="gregorian"
                            when="1878-08-08"><hi rendition="#italic">August</hi> 8, 1878</date>.
                        (Received August 24.)</dateline>
                    <seg rendition="#float-left">No. 56.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to forward to you herewith
                    a translation of a note just received from Mr. de Giers, informing me that Mr.
                    de Thoerner, privy councilor, has been appointed delegate to the monetary
                    conference at Paris of August 10.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>E. W. STOUGHTON.</signed></closer>


                <xi:include href="d452-a1.xml" xpointer="d452-a1"/>
