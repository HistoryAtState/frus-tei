    <text>
        <body>
            <div xml:id="d442">

                <pb facs="0817" n="755" sameAs="frus:frus1878/pg755"/>

                <head>No. 437.<lb/><hi rendition="#italic">Mr. Stoughton to Mr. Evarts.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic">St.
                                Petersburg</hi></placeName>, <date calendar="gregorian"
                            when="1878-03-29"><hi rendition="#italic">March</hi> 29, 1878</date>.
                        (Received April 17.)</dateline>
                    <seg rendition="#float-left">No. 19.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to your dispatch No. 107,
                    addressed to my predecessor, I have the honor to forward to you herewith copies
                    of the correspondence which has passed between Mr. de Griers and myself upon the
                    subject of discriminating duties imposed in Russia upon the commerce of the
                    United States.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>E. W. STOUGHTON.</signed></closer>



                <xi:include href="d442-a1.xml" xpointer="d442-a1"/>
