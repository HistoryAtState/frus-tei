    <text>
        <body>
            <div xml:id="d443">

                <pb facs="0819" n="757" sameAs="frus:frus1878/pg757"/>

                <head>No. 438.<lb/><hi rendition="#italic">Mr. Hoffman to Mr. Evarts.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic">St.
                                Petersburg</hi></placeName>, <date calendar="gregorian"
                            when="1878-04-09"><hi rendition="#italic">April</hi> 9, 1878</date>.
                        (Received April 24.)</dateline>
                    <seg rendition="#float-left">No. 23.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to your No. 9, addressed to Mr.
                    Stoughton, I have the honor to forward to you herewith a copy of a note I have
                    to-day addressed to Prince Gortchakoff upon the subject of a bi-metallic
                    conference.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>WICKHAM HOFFMAN.</signed></closer>


                <xi:include href="d443-a1.xml" xpointer="d443-a1"/>
            </div>
