    <text>
        <body>
            <div xml:id="d273-a13">

                <pb facs="0503" n="441" sameAs="frus:frus1878/pg441"/>

                <opener><seg rendition="#center">[Inclosure 13 in No.
                    40.—Translation.]</seg></opener>
                <head><hi rendition="#italic">Mr. Carrié to Mr. Langston</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Office of the Secretary of State for the Department of Foreign
                                Relations</hi>,<lb/><hi rendition="#italic">Port au
                            Prince</hi></placeName>, <date calendar="gregorian" when="1878-03-15"
                                ><hi rendition="#italic">March</hi> 15,
                    1878</date>.</dateline></opener>
                <p>Mr. <hi rendition="#small-caps">Minister</hi>: I have the honor to request you to
                    make known to the government the names of persons who have sought refuge in your
                    legation, if in any case there happen to be any.</p>
                <p>Please accept, Mr. Minister, the assurance of my highest esteem.</p>
                <p>Secretary of state for foreign affairs,</p>
                <closer><signed><list>
                            <item>F. CARRIÉ.</item>
                            <item>Mr. <hi rendition="#small-caps">M Langston</hi>,<lb/><hi
                                    rendition="#italic">Minister Resident and Consul-General of the
                                    United States, Port au Prince.</hi></item>
                        </list></signed></closer>
            </div>
        </body>
    </text>
