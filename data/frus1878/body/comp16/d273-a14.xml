    <text>
        <body>
            <div xml:id="d273-a14">

                <pb facs="0504" n="442" xml:id="pg442"/>

                <opener><seg rendition="#center">[Inclosure 14 in No.
                    40.—Translation.]</seg></opener>
                <head><hi rendition="#italic">Mr. Langston to Mr.
                            Carrié</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Port au Prince</hi></placeName>, <date calendar="gregorian"
                            when="1878-03-16"><hi rendition="#italic">March</hi> 16,
                        1878</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your dispatch, dated March 15, 1878, and to state in reply thereto that there
                    are no refugees in my legation.</p>
                <p>I embrace this opportunity to express to you my very highest consideration.</p>
                <p>I am, very respectfully, your obedient servant,</p>
                <closer><signed><list>
                            <item>JOHN MERCER LANGSTON.</item>
                            <item>Hon. <hi rendition="#small-caps">F. Carrié</hi>,<lb/><hi
                                    rendition="#italic">Secretary of State for Foreign
                                Affairs.</hi></item>
                        </list></signed></closer>
            </div>
        </body>
    </text>
