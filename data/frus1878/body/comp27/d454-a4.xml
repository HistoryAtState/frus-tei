            <div xml:id="d454-a4">

                <pb facs="0830" n="768" xml:id="pg768"/>

                <p rendition="#center"><hi rendition="#italic">American schooner Alaska</hi>, 8<hi
                        rendition="#italic">th July</hi>, 1877, <hi rendition="#italic">to Spanish
                        consulate, Dr</hi>.</p>
                <table cols="2" rows="5">
                    <row role="label">
                        <cell>Per two certified manifest</cell>
                        <cell role="num">$15  </cell>
                    </row>
                    <row>
                        <cell>To one bill of health</cell>
                        <cell rendition="#border-bottom" role="num">4  </cell>
                    </row>
                    <row>
                        <cell/>
                        <cell role="num">19  </cell>
                    </row>
                    <row>
                        <cell>Premium on gold</cell>
                        <cell rendition="#border-bottom" role="num">2.8</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell role="num">21.8.</cell>
                    </row>
                </table>
                <p>Received payment.</p>
                <closer><signed>J. J. DE EMPERANZA,<lb/><hi rendition="#italic">Spanish
                        Consul</hi>.</signed></closer>


                <xi:include href="d454-a4-a1.xml" xpointer="d454-a4-a1"/>
