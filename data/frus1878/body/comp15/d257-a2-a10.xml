            <div xml:id="d257-a2-a10">

                <pb facs="0464" n="402" sameAs="frus:frus1878/pg402"/>

                <head><hi rendition="#small-caps">Table IV.</hi>—<hi rendition="#italic">Actual loss
                        and damage of the government treasury from the date of the final passage of
                        the reciprocity treaty up to the</hi> 31<hi rendition="#italic">st day of
                        March</hi>, 1878.</head>
                <table cols="2" rows="3">
                    <row role="label">
                        <cell>Amount of goods admitted into this country free of duty</cell>
                        <cell rendition="#nowrap #bottom" role="num">$1,731,468 73</cell>
                    </row>
                    <row>
                        <cell>Loss to the treasury on the above amount of goods, being admitted free
                            of duty at 10 per cent</cell>
                        <cell rendition="#nowrap #bottom" role="num">173,146 87</cell>
                    </row>
                    <row>
                        <cell>Owing to the same treaty, we have levied and collected on the same
                            sort of goods from Great Britain to the amount of $522,523.24, at the
                            rate of 10 per cent</cell>
                        <cell rendition="#nowrap #bottom" role="num">52,252 32</cell>
                    </row>
                </table>
            </div>
        </body>
