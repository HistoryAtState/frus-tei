                <pb facs="0326" n="264" sameAs="frus:frus1878/pg264"/>

                <head>No. 175.<lb/><hi rendition="#italic">Mr. Evarts to Mr. Welsh</hi>.</head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1878-04-16"><hi rendition="#italic">April</hi> 16,
                        1878</date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Welsh</hi>, <hi
                        rendition="#italic">Minister, London:</hi></p>
                <p>This government does not consider attendance upon the conference as committing
                    any nation beyond a consultation upon the subject, leaving each free in its
                    conclusions and further action.</p>
                <closer><signed>EVARTS, <hi rendition="#italic">Secretary</hi>.</signed></closer>
            </div>
        </body>
