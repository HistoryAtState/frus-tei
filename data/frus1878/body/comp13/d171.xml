    <text>
        <body>
            <div xml:id="d171">

                <pb facs="0301" n="239" sameAs="frus:frus1878/pg239"/>

                <head>No. 166.<lb/><hi rendition="#italic">Mr. Pierrepont to Mr. Evarts</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1877-12-05"><hi rendition="#italic">December</hi> 5, 1877</date>.
                        (Received December 21.)</dateline>
                    <seg rendition="#float-left">No. 264.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I send you, inclosed, the leading editorial
                    in the London Times of this date. It truly expresses a very large British
                    sentiment and opinion upon the Eastern question.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>EDWARDS PIERREPONT.</signed></closer>


                <xi:include href="d171-a1.xml" xpointer="d171-a1"/>
            </div>
