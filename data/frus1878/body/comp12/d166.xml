    <text>
        <body>
            <div xml:id="d166">

                <pb facs="0298" n="236" sameAs="frus:frus1878/pg236"/>

                <head>No. 161.<lb/><hi rendition="#italic">Mr. von
                            Schlözer to Mr. Evarts</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Imperial German Legation</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1878-10-18"><hi rendition="#italic">October</hi> 18, 1878</date>.
                        (Received October 19.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: His Majesty the Emperor of Germany has sent
                    to me 3,000 marks as relief for the suffering German people in the yellow-fever
                    districts. I therefore inclose herewith $705, and beg you, respectfully, to be
                    kind enough to cause the distribution of this money among such sufferers.</p>
                <p>Accept, &amp;c.,</p>
                <closer><signed>SCHLÖZER.</signed></closer>
            </div>
        </body>
