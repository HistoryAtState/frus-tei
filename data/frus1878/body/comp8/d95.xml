    <text>
        <body>
            <div xml:id="d95">

                <pb facs="0202" n="140" sameAs="frus:frus1878/pg140"/>

                <head>No. 90.<lb/><hi rendition="#italic">Mr. Holcombe to Mr. Evarts</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1878-06-26"><hi rendition="#italic">June</hi> 26, 1878</date>.
                        (Received August 6.)</dateline>
                    <seg rendition="#float-left">No. 15.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to hand to you herewith a
                    copy of a letter received from Dr. Elmore, the minister for Peru, extending the
                    thanks of the President of Peru to Mr. Seward for services rendered to the first
                    mission from that country to China.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>CHESTER HOLCOMBE.</signed></closer>


                <xi:include href="d95-a1.xml" xpointer="d95-a1"/>
            </div>
