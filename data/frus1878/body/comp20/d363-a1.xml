            <div xml:id="d363-a1">

                <pb facs="0651" n="589" sameAs="frus:frus1878/pg589"/>

                <opener><seg rendition="#center">[Inclosure 1 in No.
                    777.—Translation.]</seg></opener>
                <head><hi rendition="#italic">Question of pay</hi>,</head>
                <p rendition="#center">[From the Libertad of September 5, 1878.]</p>
                <p rendition="#center"><hi rendition="#small-caps">supreme court of justice of the
                        united mexican states, full tribunal.</hi></p>
                <p rendition="#flush">To the citizen editor of the Libertad, present:</p>
                <p>By agreement of this supreme court of justice, and for the proper ends, I
                    transmit to you a certified copy of the act of the session of to-day, to the end
                    that you may be pleased to publish it in your paper.</p>
                <p>Liberty in the constitution!</p>
                <closer>
                    <dateline rendition="#float-left"><placeName>Mexico</placeName>, <date
                            calendar="gregorian" when="1878-09-04">September 4,
                        1878</date>.</dateline>
                    <lb/>
                    <signed>ENRIQUE LANDA,<lb/><hi rendition="#italic"
                    >Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
