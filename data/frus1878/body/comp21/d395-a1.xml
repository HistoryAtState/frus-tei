    <text>
        <body>
            <div xml:id="d395-a1">

                <pb facs="0750" n="688" xml:id="pg688"/>

                <opener><seg rendition="#center">[Inclosure in No. 288.]</seg></opener>
                <head><hi rendition="#italic">Mr. Mathews to the foreign representatives at
                        Tangier.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Consulate of the United States of America</hi>,<lb/><hi
                                rendition="#italic">Tangier</hi></placeName>, <date
                            calendar="gregorian" when="1878-07-03"><hi rendition="#italic">July</hi>
                            3, 1878</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Gentlemen</hi>: To-morrow being the hundredth and
                    second anniversary of the Independence of the United States of America, the flag
                    of the republic will be hoisted at this consulate in honor of the glorious
                    event.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>FELIX A. MATHEWS.</signed></closer>


                <xi:include href="d395-a1-a1.xml" xpointer="d395-a1-a1"/>
