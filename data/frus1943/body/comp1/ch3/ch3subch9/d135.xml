    <text>
        <body>
            <div xml:id="d135">

                <pb facs="0435" n="333" xml:id="pg333"/>

                <note rend="inline" type="source">Hopkins Papers</note>
                <head>
                    <hi rendition="#italic">Prime Minister Churchill’s Assistant Private Secretary</hi> (<hi
                            rendition="#italic">Rowan</hi>) <hi rendition="#italic">to
                        the Presidents Special Assistant</hi> (<hi
                            rendition="#italic">Hopkins</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, [<date
                            calendar="gregorian" when="1943-05-14">May 14, 1943</date>.]</dateline>
                </opener>
                <p rendition="#flush">
                    <hi rendition="#small-caps">Mr. Hopkins.</hi>
                </p>
                <p>You asked me to remind you to speak to Mr. Mackenzie King about his visit to the
                        White House—see telegram attached.</p>
                <closer>
                    <signed>T. L. R[<hi rendition="#small-caps">owan</hi>]</signed>
                    <lb/> 14.5.43</closer>
            </div>
        </body>
