    <text>
        <body>
            <div xml:id="d98">

                <pb facs="0384" n="282" sameAs="frus:frus1943/pg282"/>

                <note rend="inline" type="source">Hopkins Papers</note>
                <head>
                    <hi rendition="#italic">Prime Minister Churchill’s Assistant Private Secretary</hi> (<hi
                            rendition="#italic">Rowan</hi>) <hi rendition="#italic">to
                        the Presidents Special Assistant</hi> (<hi
                            rendition="#italic">Hopkins</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, [<date
                            calendar="gregorian" when="1943-05-24">May 24, 1943</date>.]</dateline>
                </opener>
                <p rendition="#flush">
                    <hi rendition="#small-caps">Mr. Hopkins</hi>.</p>
                <p>The Prime Minister wishes you to see the attached minute.</p>
                <p>2(<hi rendition="#italic">a</hi>) of Flag ‘Z’ is set out in the attached
                        extract<anchor n="1" xml:id="d98-f1"/> from our papers. If this does not
                    make the matter clear, I can show you the file.</p>
                <closer>
                    <signed>T. L. <hi rendition="#small-caps">Rowan</hi>
                    </signed>
                    <lb/> 24.5.43</closer>





                <xi:include href="d98-a1.xml" xpointer="d98-a1"/>
                <xi:include href="d98-a2.xml" xpointer="d98-a2"/>
            </div>
        </body>
    </text>
