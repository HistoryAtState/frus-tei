    <text>
        <body>
            <div xml:id="d126">

                <pb facs="0426" n="324" sameAs="frus:frus1943/pg324"/>

                <note rend="inline" type="source">Hopkins Papers</note>
                <head>
                    <hi rendition="#italic">Prime Minister Churchill’s Assistant Private Secretary</hi> (<hi
                            rendition="#italic">Rowan</hi>) <hi rendition="#italic">to
                        the Presidents Special Assistant</hi> (<hi
                            rendition="#italic">Hopkins</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, [<date
                            calendar="gregorian" when="1943-05-22">May 22, 1943</date>.]</dateline>
                </opener>
                <p rendition="#flush">
                    <hi rendition="#small-caps">Mr. Hopkins.</hi>
                </p>
                <p>The Prime Minister has received a letter from Dr. Evatt about the representation
                    of Polish interests in the U.S.S.R., and would be glad if you would bring it to
                    the attention of the President.</p>
                <p>I accordingly enclose a copy.</p>
                <closer>
                    <signed>T L <hi rendition="#small-caps">Rowan</hi>
                    </signed>
                    <lb/> 22.5.43</closer>



                <xi:include href="d126-a1.xml" xpointer="d126-a1"/>
            </div>
        </body>
    </text>
