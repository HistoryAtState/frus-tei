    <text>
        <body>
            <div xml:id="d132">

                <pb facs="0432" n="330" sameAs="frus:frus1943/pg330"/>

                <note rend="inline" type="source"> J.C.S. Files</note>
                <head>
                    <hi rendition="#italic">Memorandum by the Secretaries of the Combined Chiefs of
                        Staff</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                        <lb/> C.C.S. 185/4</seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1943-05-22">22 May 1943</date>.</dateline>
                </opener>
                <p rendition="#center">
                    <hi rendition="#small-caps">Policy for Coming Operations Regarding Propaganda
                        and Subversive Activities</hi>
                </p>
                <p>The enclosure is a proposed reply to the request of General Eisenhower contained
                    in C.C.S. 185/3.<anchor n="1" xml:id="d132-f1"/> It has the approval of the U.
                    S. Chiefs of Staff and the President.</p>
                <closer>
                    <signed> H. <hi rendition="#small-caps">Redman</hi>
                        <lb/> J. R. <hi rendition="#small-caps">Deane</hi>
                    </signed>
                    <lb/>
                    <hi rendition="#italic">Combined Secretariat</hi>
                </closer>


                <xi:include href="d132-a1.xml" xpointer="d132-a1"/>
            </div>
        </body>
    </text>
