    <text>
        <body>
            <div xml:id="d518">

                <pb facs="1225" n="1111" sameAs="frus:frus1943/pg1111"/>

                <note rend="inline" type="source">863.01/8–2043</note>
                <head>
                    <hi rendition="#italic"> Archduke Otto of Austria to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Quebec</hi></placeName>, <date
                            calendar="gregorian" when="1943-08-20">August 20th,
                        1943</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Hull</hi>, Enclosed I am sending to you two
                    short <hi rendition="#italic">aide-mémoires</hi> on questions which I believe
                    are of a great importance for the cause of the United Nations in Central
                    Europe.</p>
                <p>I most sincerely hope that it will be possible for you to consider these
                    questions at the present conference and to bring to them an adequate
                    solution.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Otto</hi>
                    </signed>
                    <hi rendition="#small-caps">of Austria</hi>
                </closer>



                <xi:include href="d518-a1.xml" xpointer="d518-a1"/>
                <xi:include href="d518-a2.xml" xpointer="d518-a2"/>
