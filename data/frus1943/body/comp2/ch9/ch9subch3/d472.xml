                    <hi rendition="#italic">Ante</hi>, <ref target="#pg589">pp. 589</ref> ff.</p>
            </note>
            <note corresp="#d472-f2" n="2" xml:id="d472-f2-content">
                <p>Giuseppe Castellano.</p>
            </note>
        </listAnnotation>
