    <text>
        <body>
            <div xml:id="d482">

                <pb facs="1177" n="1063" sameAs="frus:frus1943/pg1063"/>

                <note rend="inline" type="source"> J.C.S. Files</note>
                <head>
                    <hi rendition="#italic">Note by the Secretaries of the Combined Chiefs of
                        Staff</hi><anchor n="1" xml:id="d482-f1"/>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Quebec</hi></placeName>,] <date calendar="gregorian"
                            when="1943-08-19">19 August 1943</date>.</dateline>
                </opener>
                <p>The following summary of recent correspondence with A.F.H.Q. North African
                    Theater relating to post-<hi rendition="#small-caps">Husky</hi> operations, has
                    been made for the convenience of the Combined Chiefs of Staff in connection with
                    the discussion on post-<hi rendition="#small-caps">Husky</hi> operations tabled
                    for the 113th Meeting of the Combined Chiefs of Staff, 20 August 1943.</p>
                <closer>
                    <signed> H. <hi rendition="#small-caps">Redman</hi>
                        <lb/> J. R. <hi rendition="#small-caps">Deane</hi>
                    </signed>
                    <lb/>
                    <hi rendition="#italic">Combined Secretariat</hi>
                </closer>



                <xi:include href="d482-a1.xml" xpointer="d482-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d482-f1" n="1" type="source" xml:id="d482-f1-content">
                <p>Memorandum for Information No. 132. For texts of the messages summarized in
                    paragraphs 1, 3, 6, 7, 8, and 12 of the enclosure, see <hi rendition="#italic"
                        >Eisenhower Papers</hi>, pp. 1224, 1261, 1296, 1305, 1327, and 1335,
                    respectively.</p>
            </note>
        </listAnnotation>
    </standOff>
