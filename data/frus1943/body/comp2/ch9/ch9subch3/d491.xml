    <text>
        <body>
            <div xml:id="d491">

                <pb facs="1195" n="1081" sameAs="frus:frus1943/pg1081"/>

                <note rend="inline" type="source">740.0011 European War 1939/31032</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the President
                    </hi><anchor n="1" xml:id="d491-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1943-08-21">August 21, 1943</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. President</hi>: I enclose for your
                    information a copy of a memorandum of conversation which I have just had with
                    the Apostolic Delegate.</p>
                <p>Believe me [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Sumner Welles</hi>
                    </signed>
                </closer>


                <xi:include href="d491-a1.xml" xpointer="d491-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d491-f1" n="1" type="source" xml:id="d491-f1-content">
                <p>Sent to Quebec by pouch. A copy of the enclosure was sent also to Hull.</p>
            </note>
        </listAnnotation>
    </standOff>
