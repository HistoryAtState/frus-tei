    <text>
        <body>
            <div xml:id="d191">

                <pb facs="0519" n="405" sameAs="frus:frus1943/pg405"/>

                <note rend="inline" type="source">Roosevelt Papers: Telegram</note>
                <head>
                    <hi rendition="#italic">President Roosevelt to
                        Prime Minister Churchill
                    </hi><anchor n="1" xml:id="d191-f1"/>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                        <lb/>
                        <hi rendition="#small-caps">priority</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1943-07-30">July 30, 1943</date>.</dateline>
                </opener>
                <p>For the Former Naval Person from the President
                    personal and secret Number 333.</p>
                <pb facs="0520" n="406" xml:id="pg406"/>
                <p>Your Number 385.<anchor n="2" xml:id="d191-f2"/>
                </p>
                <p>I have wired Harriman to come if possible.<anchor n="3" xml:id="d191-f3"/> Lew
                    Douglas will be with us.</p>
                <p>Delighted Leathers is coming.</p>
                <p>We will be waiting for you and personal staff at H.P.<anchor n="4"
                        xml:id="d191-f4"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Roosevelt</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d191-f1" n="1" type="source" xml:id="d191-f1-content">
                <p>Sent to the United States Naval Attaché, London, via Navy channels.</p>
            </note>
            <note corresp="#d191-f2" n="2" xml:id="d191-f2-content">
                <p>
                    <hi rendition="#italic">Ante</hi>, <ref target="#pg403">p. 403</ref>.</p>
            </note>
            <note corresp="#d191-f3" n="3" xml:id="d191-f3-content">
                <p>Roosevelt’s telegram to Harriman, July 30, 1943, and Harriman’s reply of August
                    2, 1943, stating that he was arranging to travel with the “Colonel”, are not
                    printed (Harriman Papers).</p>
            </note>
            <note corresp="#d191-f4" n="4" xml:id="d191-f4-content">
                <p>Hyde Park.</p>
            </note>
        </listAnnotation>
    </standOff>
