    <text>
        <body>
            <div xml:id="d202">

                <pb facs="0525" n="411" sameAs="frus:frus1943/pg411"/>

                <note rend="inline" type="source">Roosevelt Papers: Telegram</note>
                <head>
                    <hi rendition="#italic">President Roosevelt to
                        Prime Minister Churchill
                    </hi><anchor n="1" xml:id="d202-f1"/>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1943-08-11">11 August 1943</date>.</dateline>
                </opener>
                <p>344. Your number 407.<anchor n="2" xml:id="d202-f2"/>
                </p>
                <p>Regret delay in replying. Suggest thin clothes but be prepared for a variety of
                    weather. Delighted to see you in any costume.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Roosevelt</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d202-f1" n="1" type="source" xml:id="d202-f1-content">
                <p>Delivered to the British Joint Staff Mission at Washington for transmission to
                        Churchill at Quebec.</p>
            </note>
            <note corresp="#d202-f2" n="2" xml:id="d202-f2-content">
                <p>
                    <hi rendition="#italic">Supra.</hi>
                </p>
            </note>
        </listAnnotation>
    </standOff>
