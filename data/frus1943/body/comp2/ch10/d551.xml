    <text>
        <body>
            <div xml:id="d551">

                <pb facs="1303" n="1189" sameAs="frus:frus1943/pg1189"/>

                <note rend="inline" type="source">Roosevelt Papers: Telegram</note>
                <head>
                    <hi rendition="#italic">Prime Minister Churchill to President Roosevelt
                    </hi><anchor n="1" xml:id="d551-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <date calendar="gregorian" when="1943-08-30">
                            <hi rendition="#small-caps">August</hi> 30, 1943</date>.</dateline>
                </opener>
                <p>Message from Colonel Warden to the President.</p>
                <p>Clemmie<anchor n="2" xml:id="d551-f2"/> has benefited by her rest up here and
                    would very much like to come with us to Washington if you still have room. She
                    would not be able to undertake any public engagements.</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d551-f1" n="1" type="source" xml:id="d551-f1-content">
                <p>The message originated in Canada. Channel of transmission not indicated.</p>
            </note>
            <note corresp="#d551-f2" n="2" xml:id="d551-f2-content">
                <p>Mrs. Churchill.</p>
            </note>
        </listAnnotation>
    </standOff>
