    <text>
        <body>
            <div xml:id="d247">

                <pb facs="0640" n="526" sameAs="frus:frus1943/pg526"/>

                <note rend="inline" type="source">Roosevelt Papers: Telegram</note>
                <head>
                    <hi rendition="#italic">Prime Minister Churchill to President Roosevelt
                    </hi><anchor n="1" xml:id="d247-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1943-08-02">2 August 1943</date>.</dateline>
                </opener>
                <p>Number 397. Former Naval Person to President
                    personal. Your number 338.<anchor n="2" xml:id="d247-f2"/> Many thanks.</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d247-f1" n="1" type="source" xml:id="d247-f1-content">
                <p>Sent to Washington by the United States Military Attaché London, via Army
                    channels; forwarded by the White House Map Room to Roosevelt, who was then at
                    Birch Island.</p>
            </note>
            <note corresp="#d247-f2" n="2" xml:id="d247-f2-content">
                <p>
                    <hi rendition="#italic">Ante</hi>, <ref target="#pg525">p. 525</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
