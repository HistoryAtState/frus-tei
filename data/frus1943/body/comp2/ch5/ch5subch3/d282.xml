    <text>
        <body>
            <div xml:id="d282">

                <pb facs="0684" n="570" xml:id="pg570"/>

                <note rend="inline" type="source">740.0011 EW/8–843</note>
                <head>
                    <hi rendition="#italic">The British Ambassador</hi> (<hi
                            rendition="#italic">Halifax</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">most secret</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-08-08">August 8th,
                        1943</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Hull</hi>, I send you herewith a copy of a
                    telegram received from Mr. Eden on August 7th about the proposal to make Rome an
                    open city.</p>
                <p>Yours very sincerely,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Halifax</hi>
                    </signed>
                </closer>


                <xi:include href="d282-a1.xml" xpointer="d282-a1"/>
