    <text>
        <body>
            <div xml:id="d253">

                <pb facs="0644" n="530" sameAs="frus:frus1943/pg530"/>

                <note rend="inline" type="source">740.0011 EW/8–243</note>
                <head>
                    <hi rendition="#italic">The Chief of Staff, United States Army</hi> (<hi rendition="#italic">Marshall</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1943-08-02">August 2, 1943</date>.]</dateline>
                </opener>
                <p rendition="#center">
                    <hi rendition="#small-caps">Memorandum for Secretary Hull</hi>
                </p>
                <p>Attached hereto is a draft of the essential conditions which the War Department
                    believes should be imposed in order that Rome may be considered an open
                    city.</p>
                <p>I assume that you will take this matter up with the British.</p>
                <closer>
                    <signed>G C <hi rendition="#small-caps">Marshall</hi>
                    </signed>
                </closer>


                <xi:include href="d253-a1.xml" xpointer="d253-a1"/>
            </div>
