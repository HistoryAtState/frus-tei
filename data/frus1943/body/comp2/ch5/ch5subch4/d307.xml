    <text>
        <body>
            <div xml:id="d307">

                <pb facs="0723" n="609" sameAs="frus:frus1943/pg609"/>

                <note rend="inline" type="source">Roosevelt Papers: Telegram</note>
                <head>
                    <hi rendition="#italic">President Roosevelt to Prime Minister Churchill
                        </hi><anchor n="1" xml:id="d307-f1"/>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                        <lb/>
                        <hi rendition="#italic">priority</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1943-07-30">30 July 1943</date>.</dateline>
                </opener>
                <p>For the Former Naval Person from the President personal and secret. Number
                    335.</p>
                <p>Your number 390.<anchor n="2" xml:id="d307-f2"/>
                </p>
                <p>Grand hunting in the Bay of Biscay. We got one too off Recife, Brazil. We still
                    need <hi rendition="#small-caps">Lifebelt</hi> nevertheless.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Roosevelt</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d307-f1" n="1" type="source" xml:id="d307-f1-content">
                <p>Sent to the United States Naval Attaché, London, via Navy channels.</p>
            </note>
            <note corresp="#d307-f2" n="2" xml:id="d307-f2-content">
                <p>Not printed. In this message Churchill had informed Roosevelt of the sinking of
                    three enemy submarines in the Bay of Biscay.</p>
            </note>
        </listAnnotation>
    </standOff>
