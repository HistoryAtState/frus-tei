    <text>
        <body>
            <div xml:id="d342">

                <pb facs="0772" n="658" sameAs="frus:frus1943/pg658"/>

                <note rend="inline" type="source">Roosevelt Papers</note>
                <head>
                    <hi rendition="#italic">The Lend-Lease Administrator</hi> (<hi
                        rendition="#italic">Stettinius</hi>) <hi rendition="#italic">to the
                        Presidents Secretary</hi> (<hi rendition="#italic">Early</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-08-11">August 11,
                        1943</date>.</dateline>
                </opener>
                <p rendition="#center">
                    <hi rendition="#small-caps">Memorandum</hi>
                </p>
                <p rendition="#flush">Subject: Proposed Release on Creation of Joint War Aid
                    Committee, U.S.–Canada</p>
                <p>The proposed release contained in Lauchlin Currie’s memorandum to the President
                    of August 3<anchor n="1" xml:id="d342-f1"/> enclosed with your letter<anchor
                        n="2" xml:id="d342-f2"/> is entirely satisfactory to Lend-Lease.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Ed</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
