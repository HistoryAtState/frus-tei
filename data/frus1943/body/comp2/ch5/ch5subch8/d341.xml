    <text>
        <body>
            <div xml:id="d341">

                <pb facs="0771" n="657" sameAs="frus:frus1943/pg657"/>

                <note rend="inline" type="source">842.24/245</note>
                <head>
                    <hi rendition="#italic">The President’s Secretary</hi> (<hi rendition="#italic"
                        >Early</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-08-11">August 11,
                        1943</date>.</dateline>
                </opener>
                <p rendition="#center">
                    <hi rendition="#small-caps">Memorandum to the Secretary of State</hi>
                </p>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Secretary</hi>: Attached is a copy of a
                    memorandum the President has received from Mr. Lauchlin Currie.</p>
                <p>The President, as the memorandum states, has been asked to approve this
                    proposal.</p>
                <p>Before doing this, he has requested me to check the proposal with the Department
                    of State and the Office of the Lend-Lease Administrator.<anchor n="1"
                        xml:id="d341-f1"/>
                </p>
                <p>I will be grateful to you for any suggestions or comments you care to make.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stephen Early</hi>
                    </signed>
                </closer>


                <xi:include href="d341-a1.xml" xpointer="d341-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d341-f1" n="1" xml:id="d341-f1-content">
                <p>Early sent a parallel memorandum to Stettinius on the same date.</p>
            </note>
        </listAnnotation>
    </standOff>
