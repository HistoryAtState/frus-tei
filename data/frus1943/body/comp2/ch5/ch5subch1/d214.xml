            </note>
            <note corresp="#d214-f2" n="2" xml:id="d214-f2-content">
                <p>i.e., at 2:15 p.m.</p>
            </note>
            <note corresp="#d214-f3" n="3" xml:id="d214-f3-content">
                <p>Henry L. Stimson.</p>
            </note>
            <note corresp="#d214-f4" n="4" xml:id="d214-f4-content">
                <p>Cf. the memorandum by the Joint War Plans Committee, August 9, 1943, <hi
                        rendition="#italic">supra.</hi>
                </p>
            </note>
        </listAnnotation>
