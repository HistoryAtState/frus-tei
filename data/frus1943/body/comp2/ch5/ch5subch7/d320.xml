    <text>
        <body>
            <div xml:id="d320">

                <pb facs="0744" n="630" sameAs="frus:frus1943/pg630"/>

                <note rend="inline" type="source">Hopkins Papers: Telegram</note>
                <head>
                    <hi rendition="#italic">The President’s Special Assistant</hi> (<hi rendition="#italic">Hopkins</hi>) <hi
                        rendition="#italic">to Prime Minister Churchill
                    </hi><anchor n="1" xml:id="d320-f1"/>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1943-06-17">June 17, 1943</date>.</dateline>
                </opener>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>The matter of 
                        <hi rendition="#small-caps">Tube Alloys</hi>
                     is in hand and I think will be disposed of completely the first of the
                    week.</p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
            </div>
        </body>
    </text>
