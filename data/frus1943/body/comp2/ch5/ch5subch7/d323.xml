                <pb facs="0747" n="633" sameAs="frus:frus1943/pg633"/>

                <note rend="inline" type="source">Roosevelt Papers</note>
                <head>
                    <hi rendition="#italic">The President to the Presidents Special Assistant</hi>
                        (<hi rendition="#italic">Hopkins</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-07-14">July 14, 1943</date>.</dateline>
                </opener>
                <p rendition="#center">
                    <hi rendition="#small-caps">Memorandum for Hon. Harry Hopkins</hi>
                </p>
                <p>What should I do about this and the reply to Churchill’s wire?</p>
                <closer>
                    <signed>F[<hi rendition="#small-caps">ranklin</hi>] D. R[<hi
                            rendition="#small-caps">oosevelt</hi>]</signed>
                </closer>
            </div>
