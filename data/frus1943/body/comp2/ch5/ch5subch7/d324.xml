    <text>
        <body>
            <div xml:id="d324">

                <pb facs="0747" n="633" sameAs="frus:frus1943/pg633"/>

                <note rend="inline" type="source">Roosevelt Papers</note>
                <head>
                    <hi rendition="#italic">The Presidents Special Assistant</hi> (<hi rendition="#italic">Hopkins</hi>) <hi
                        rendition="#italic">to the President
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-07-20">July 20, 1943</date>.</dateline>
                </opener>
                <p rendition="#center">
                    <hi rendition="#small-caps">Memorandum for the President</hi>
                </p>
                <p>
                    <hi rendition="#small-caps">Dear Mr. President</hi>: I think you made a firm
                    commitment to Churchill in regard to this when he was here and there is nothing
                    to do but go through with it.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Harry</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
