    <text>
        <body>
            <div xml:id="d327">

                <pb facs="0750" n="636" sameAs="frus:frus1943/pg636"/>

                <note rend="inline" type="source">Roosevelt Papers: Telegram</note>
                <head>
                    <hi rendition="#italic">President Roosevelt to
                        Prime Minister Churchill
                    </hi><anchor n="1" xml:id="d327-f1"/>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1943-07-26">July 26, 1943</date>.</dateline>
                </opener>
                <p>326. Personal and secret to the Former Naval
                        Person from the President.</p>
                <p>In reply to your 354.<anchor n="2" xml:id="d327-f2"/> I have arranged
                    satisfactorily for the 
                        <hi rendition="#small-caps">Tube Alloys</hi>. Unless you have the
                    proper person in this country now, it might be well if your top man in this
                    enterprise comes over to get full understanding from our people.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Roosevelt</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
