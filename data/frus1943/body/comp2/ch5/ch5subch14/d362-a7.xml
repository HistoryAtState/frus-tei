    <text>
        <body>
            <div xml:id="d362-a7">

                <pb facs="0816" n="702" sameAs="frus:frus1943/pg702"/>

                <opener>
                    <seg rendition="#center">[Subenclosure 2]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">The British Ambassador</hi> (<hi
                            rendition="#italic">Halifax</hi>) <hi rendition="#italic">to
                        President Roosevelt
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">most secret</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-02-02">February 2nd,
                        1943</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. President</hi>, I enclose the further
                    message from the Prime Minister<anchor n="12" xml:id="d362-f1"/> which I
                    mentioned in my earlier letter today.</p>
                <p>I also enclose a copy of a personal message to you from Mr. Eden, which has just
                    come in.<anchor n="13" xml:id="d362-f2"/>
                </p>
                <p>Believe me [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Halifax</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d362-f1" n="12" xml:id="d362-f1-content">
                <p>Concerning the origin of this message, see <ref target="frus1943v01#pg_1051">
                        <hi rendition="#italic">ibid.</hi>, p. 1051</ref>.</p>
            </note>
            <note corresp="#d362-f2" n="13" xml:id="d362-f2-content">
                <p>Halifax’s “earlier letter” and Eden’s message were not included in the file of
                    papers enclosed with Welles’ memorandum to Roosevelt of August 11, 1943.</p>
            </note>
        </listAnnotation>
    </standOff>
