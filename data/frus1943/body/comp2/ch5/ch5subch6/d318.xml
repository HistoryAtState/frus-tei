    <text>
        <body>
            <div xml:id="d318">

                <pb facs="0741" n="627" sameAs="frus:frus1943/pg627"/>

                <note rend="inline" type="source">Hull Papers</note>
                <head>
                    <hi rendition="#italic">The Adviser on Political Relations</hi> (<hi rendition="#italic">Hornbeck</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1943-08-19">August 19, 1943</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Secretary</hi>: Herewith a memorandum prepared
                    by FE, in consultation with officers of Eu and of PA/H, in
                    response to a question which you put to me a few days ago and to which I made at
                    the moment a tentative oral reply: “What do the Russians want in the Far
                    East?”.</p>
                <closer>
                    <signed>S[<hi rendition="#small-caps">tanley</hi>] K H[<hi
                            rendition="#small-caps">ornbeck</hi>]</signed>
                </closer>


                <xi:include href="d318-a1.xml" xpointer="d318-a1"/>
