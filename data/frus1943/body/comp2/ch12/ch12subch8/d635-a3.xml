    <text>
        <body>
            <div xml:id="d635-a3">

                <pb facs="1427" n="1313" sameAs="frus:frus1943/pg1313"/>

                <opener>
                    <seg rendition="#center">[Attachment 3—Telegram]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">Prime Minister Churchill to the British Lord President
                        of the Council</hi> (<hi rendition="#italic">Anderson</hi>)</head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">most secret</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1943-09-02">September 2, 1943</date>.</dateline>
                </opener>
                <p>I am glad Appleton is coming.<anchor n="8" xml:id="d635-f1"/>
                </p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d635-f1" n="8" xml:id="d635-f1-content">
                <p>At the end of this file in the Hopkins Papers is a typed copy of the entry on
                    Appleton in <hi rendition="#italic">Who’s Who</hi>.</p>
