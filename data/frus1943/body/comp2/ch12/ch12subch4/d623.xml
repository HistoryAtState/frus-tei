    <text>
        <body>
            <div xml:id="d623">

                <pb facs="1404" n="1290" sameAs="frus:frus1943/pg1290"/>

                <note rend="inline" type="source">
                    J.C.S. Files</note>
                <head>
                    <hi rendition="#italic">Note by the Secretaries of the Combined Chiefs of
                        Staff</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                        <lb/>
                        C.C.S. 341</seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1943-09-09">9 September 1943</date>.</dateline>
                </opener>
                <p rendition="#center">
                    <hi rendition="#small-caps">Review of Strategic Situation in Light of Italian
                        Collapse</hi>
                </p>
                <p>The enclosure, a minute presented to the President by the Prime Minister,<anchor
                        n="1" xml:id="d623-f1"/> has been referred to the Combined Staff Planners
                    for study and for the submission of draft of conclusions which may be submitted
                    by the Combined Chiefs of Staff to the President and Prime Minister on Friday
                    afternoon, 10 September 1943.</p>
                <closer>
                    <signed> H. <hi rendition="#small-caps">Redman</hi>
                        <lb/> J. R. <hi rendition="#small-caps">Deane</hi>
                    </signed>
                    <lb/>
                    <hi rendition="#italic">Combined Secretariat</hi>
                </closer>
            </div>
        </body>
    </text>
