    <text>
        <body>
            <div xml:id="d644">

                <pb facs="1447" n="1333" sameAs="frus:frus1943/pg1333"/>

                <note rend="inline" type="source">Hull Papers</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the President </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1943-08-30">August 30, 1943</date>.</dateline>
                </opener>
                <p rendition="#center">
                    <hi rendition="#small-caps">Memorandum for the President</hi>
                </p>
                <p>In accordance with our conversation today, I am sending you herewith a draft of a
                    declaration by the United Nations on dependent peoples<anchor n="1"
                        xml:id="d644-f1"/> for use in connection with your conversations with Prime
                    Minister Churchill.</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d644-f1" n="1" xml:id="d644-f1-content">
                <p>No draft is attached to the source text in the Hull papers, and the original of
                    this memorandum has not been found in the Roosevelt Papers. The attachment was
                    probably the text of March 9, 1943, printed <hi rendition="#italic">ante</hi>,
                        <ref target="#pg717">p. 717</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
