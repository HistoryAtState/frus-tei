    <text>
        <body>
            <div xml:id="d594">

                <pb facs="1368" n="1254" sameAs="frus:frus1943/pg1254"/>

                <note rend="inline" type="source">Roosevelt Papers</note>
                <head>
                    <hi rendition="#italic">Prime Minister Churchill’s
                        Assistant Private Secretary</hi> (<hi
                            rendition="#italic">Rowan</hi>) <hi rendition="#italic">to
                        the President’s Naval Aide</hi> (<hi rendition="#italic"
                            >Brown</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, [<date
                            calendar="gregorian" when="1943-09-07">September 7,
                        1943</date>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Admiral Wilson Brown</hi>: Tonight, September 7, the
                    President and the Prime Minister together signed the draft declaration about the
                    use of poison gas against the Italians and the President asked that I should
                    send you the original of this for your records. This is attached.</p>
                <closer>
                    <signed>T L <hi rendition="#small-caps">Rowan</hi>
                    </signed>
                    <lb/> 7. 9. 43.</closer>


                <xi:include href="d594-a1.xml" xpointer="d594-a1"/>
            </div>
