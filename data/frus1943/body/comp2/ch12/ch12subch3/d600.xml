            <note corresp="#d600-f2" n="2" xml:id="d600-f2-content">
                <p>
                    <hi rendition="#italic">Ante</hi>, <ref target="#pg1259">p. 1259</ref>.</p>
            </note>
            <note corresp="#d600-f3" n="3" xml:id="d600-f3-content">
                <p>
                    <hi rendition="#italic">Supra</hi>.</p>
            </note>
            <note corresp="#d600-f4" n="4" xml:id="d600-f4-content">
                <p>A handwritten draft of this message, signed by Roosevelt and Churchill, is in the
                    Roosevelt Papers.</p>
            </note>
        </listAnnotation>
