            <div xml:id="photographs">

                <pb facs="0017" n="XIII" xml:id="pgXIII"/>

                <head>List of photographs</head>
                <p>(These photographs will be found in a group following <ref target="#pg387">page
                        387</ref>.)</p>
                <list type="toc">
                    <item>
                        <ref target="#pg1">President Roosevelt and Prime Minister Churchill,
                            Washington, May 14, 1943</ref>
                    </item>
                    <item>
                        <ref target="#pg2">Prime Minister Churchill and President Roosevelt at
                            Shangri La, weekend of May 14–17, 1943</ref>
                    </item>
                    <item>
                        <ref target="#pg3">Meeting of the Pacific War Council, Washington, May 20,
                            1943</ref>
                    </item>
                    <item>
                        <ref target="#pg4">Prime Minister Churchill and President Roosevelt,
                            Washington, May 24, 1943</ref>
                    </item>
                    <item>
                        <ref target="#pg5">Prime Minister Churchill and President Roosevelt with the
                            Combined Chiefs of Staff, Washington, May 24, 1943</ref>
                    </item>
                    <item>
                        <ref target="#pg6">Prime Ministers Mackenzie King and Churchill, President
                            Roosevelt, and the Earl of Athlone, Quebec, August 18, 1943</ref>
                    </item>
                    <item>
                        <ref target="#pg7">President Roosevelt, Prime Ministers Mackenzie King and
                            Churchill, the Earl and Countess of Athlone, and British advisers,
                            Quebec, August 18, 1943</ref>
                    </item>
                    <item>
                        <ref target="#pg8">Prime Minister Mackenzie King, President Roosevelt, Prime
                            Minister Churchill, and the Combined Chiefs of Staff, Quebec, August 18,
                            1943</ref>
                    </item>
                    <item>
                        <ref target="#pg9">Secretary of State Hull and Prime Minister Mackenzie
                            King, Quebec, August 20, 1943</ref>
                    </item>
                    <item>
                        <ref target="#pg10">Prime Minister Churchill, Minister of Information Bracken, and Mr. Harry Hopkins, Quebec,
                            August 22, 1943</ref>
                    </item>
                    <item>
                        <ref target="#pg11">The United States Joint Chiefs of Staff with their
                            aides, Quebec, August 23, 1943</ref>
                    </item>
                    <item>
                        <ref target="#pg12">The Combined Chiefs of Staff, Quebec, August 23,
                            1943</ref>
                    </item>
                </list>
