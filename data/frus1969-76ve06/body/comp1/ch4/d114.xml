    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d114-f1" n="1" type="source" xml:id="d114-f1-content">
                <p>Source: Ford Library, National Security
                    Adviser, Presidential Country Files for Africa, Box 2, Ethiopia. Secret; Noforn.
                    Sent for urgent information.</p>
            </note>
            <note corresp="#d114-f2" n="2" xml:id="d114-f2-content">
                <p>
                    Kennedy summarized and transmitted a
                        CIA assessment of the regime of the Armed
                    Forces Coordinating Committee in Ethiopia.</p>
            </note>
