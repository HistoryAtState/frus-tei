    <text>
        <body>
            <div xml:id="d205">

                <pb facs="0204" n="882" sameAs="frus:frus1863p2/pg882"/>

                <head>Mr. Seward to Mr. Pike.</head>
                <opener>
                    <seg rendition="#float-left">No. 86.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1863-01-14"><hi rendition="#italic"
                                >January</hi> 14, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have to acknowledge the receipt of your
                    despatch (No. 69) of the 24th ultimo, and to inform you that that part of it
                    relating to finance has been communicated to the Secretary of the Treasury.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">James</hi> S. <hi rendition="#small-caps"
                            >Pike</hi>, Esq., <hi rendition="#italic">&amp;c., &amp;c.,
                        &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
