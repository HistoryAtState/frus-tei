    <text>
        <body>
            <div xml:id="d219">

                <pb facs="0214" n="892" sameAs="frus:frus1863p2/pg892"/>

                <head>Mr. Seward to Mr.
                        Pike.</head>
                <opener>
                    <seg rendition="#float-left">No. 96.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1863-04-13"><hi rendition="#italic"
                                >April</hi> 13, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have received your despatch (No. 77) of
                    the 25th of February, and shall lay it before the Secretary of the Treasury.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">James</hi> S. <hi rendition="#small-caps"
                            >Pike</hi>, Esq., <hi rendition="#italic">&amp;c., &amp;c.,
                        &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
