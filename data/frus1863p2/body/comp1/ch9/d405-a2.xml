    <text>
        <body>
            <div xml:id="d405-a2">

                <pb facs="0460" n="1138" sameAs="frus:frus1863p2/pg1138"/>

                <head><hi rendition="#italic">Statement of loss suffered in consequence of a
                        murderous assault made upon the steamer Pembroke, in the inland sea, on
                        the</hi> 19<hi rendition="#italic">th June, by armed vessels flying the flag
                        of the government of Japan.</hi></head>
                <table cols="2">
                    <row role="label">
                        <cell>Loss of time by being obliged to go through an unknown and circuitous
                            passage to reach the open sea, five days, at $300.</cell>
                        <cell rendition="#nowrap #bottom" role="num">$1,500 00</cell>
                    </row>
                    <row>
                        <cell>Loss of freight and passengers, through not being able to visit
                            Nagasaki, whither she was bound, estimated at</cell>
                        <cell rendition="#nowrap #bottom" role="num">6,500 00</cell>
                    </row>
                    <row>
                        <cell>Consideration to be distributed among the officers and crew as
                            recompense for the deadly peril to which they were subjected</cell>
                        <cell rendition="#nowrap #bottom #border-bottom" role="num">2,000 00</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell rendition="#nowrap #bottom #border-bottom" role="num">10,000 00</cell>
                    </row>
                </table>
                <closer>
                    <signed>RUSSELL &amp; CO. </signed><lb/>
                    <dateline rendition="#float-left"><placeName><hi rendition="#small-caps"
                                >Shanghai</hi></placeName>, <date calendar="gregorian"
                            when="1863-07-04"><hi rendition="#small-caps">July</hi> 4,
                        1863</date>.</dateline></closer>
            </div>
        </body>
    </text>
