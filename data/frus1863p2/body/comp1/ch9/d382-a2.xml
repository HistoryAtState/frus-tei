    <text>
        <body>
            <div xml:id="d382-a2">

                <pb facs="0418" n="1096" sameAs="frus:frus1863p2/pg1096"/>

                <opener><seg rendition="#center">[Enclosure No. 2.]</seg></opener>
                <head><hi rendition="#italic">Mr. Pruyn</hi> to <hi rendition="#italic">Mr.
                        Bellecourt.</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 54.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States in
                                Japan</hi>, <hi rendition="#italic">Yedo</hi>,</placeName>
                        <date calendar="gregorian" when="1863-05-11"><hi rendition="#italic"
                                >May</hi> 11, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge the receipt
                    of your excellency’s letter of the 8th instant, of which, being supplementary to
                    your letter of the 5th instant therein referred to, I shall also transmit a copy
                    to my government.</p>
                <p>Be pleased to accept, sir, the assurance of the high consideration with which I
                    have the honor to be your excellency’s most obedient, humble servant,</p>
                <closer>
                    <signed>ROBERT H. PRUYN, <hi rendition="#italic">Minister Resident of the United
                            States in Japan.</hi></signed></closer>
            </div>
        </body>
    </text>
