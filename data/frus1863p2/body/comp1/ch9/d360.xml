    <text>
        <body>
            <div xml:id="d360">

                <pb facs="0375" n="1053" sameAs="frus:frus1863p2/pg1053"/>

                <head>Mr. Seward to Mr.
                        Pruyn</head>
                <opener>
                    <seg rendition="#float-left">No. 22.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1862-09-25"><hi rendition="#italic"
                                >September</hi> 25, 1862.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your despatch of July 2 (No. 35) has been
                    submitted to the President.</p>
                <p>It is sincerely hoped that the increasing intimacy between the Tycoon’s
                    government and our legation in Yedo may be productive of the benefits you so
                    properly desire.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Robert H. Pruyn</hi>, Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., Yedo.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
