    <text>
        <body>
            <div xml:id="d392">

                <pb facs="0429" n="1107" sameAs="frus:frus1863p2/pg1107"/>

                <opener><seg rendition="#center">[By Telegraph.]</seg></opener>
                <head>Mr. Seward to Mr. Pruyn</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1863-06-18"><hi rendition="#italic"
                                >June</hi> 18, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> You will co-operate with the
                    representatives of the other treaty powers in any difficulties which may arise
                    in Japan, and the Wyoming will obey your orders. You will keep this department
                    advised of all your proceedings.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Robert H. Pruyn</hi>, Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., Yedo.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
