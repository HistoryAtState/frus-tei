    <text>
        <body>
            <div xml:id="d184">

                <pb facs="0194" n="872" sameAs="frus:frus1863p2/pg872"/>

                <head>Mr. Seward to Mr.
                        Clay.</head>
                <opener>
                    <seg rendition="#float-left">No. 19.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1863-06-16"><hi rendition="#italic"
                                >June</hi> 16, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your despatch of the 19th ultimo (No. 5)
                    has been received. In reply, I have to inform you that the Russian and American
                    telegraph project of Mr. P. McD. Collins, to which it relates, is under
                    consideration.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Cassius</hi> M. <hi rendition="#small-caps"
                            >Clay</hi>, Esq., <hi rendition="#italic">&amp;c., &amp;c.,
                        &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
