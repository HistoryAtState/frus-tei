    <text>
        <body>
            <div xml:id="d537-a2">

                <pb facs="0617" n="1295" sameAs="frus:frus1863p2/pg1295"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">“Gibraltar</hi>,</placeName>
                        <date calendar="gregorian" when="1862-11-07"><hi rendition="#italic"
                                >November</hi> 7, 1862.</date></dateline></opener>
                <p>“Your telegram received. Chippewa left at once for Cadiz to communicate with
                    Kearsarge as to future movements. Release remains off Algeciras.</p>
                <closer>
                    <signed>“SPRAGUE, <hi rendition="#italic">Consul.</hi></signed></closer>
                <postscript>
                    <p>“Mr. <hi rendition="#small-caps">Harvey</hi>, <hi rendition="#italic"
                            >“American Minister, Lisbon.”</hi></p>
                </postscript>
            </div>
        </body>
    </text>
