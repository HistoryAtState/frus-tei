    <text>
        <body>
            <div xml:id="d481">

                <pb facs="0526" n="1204" sameAs="frus:frus1863p2/pg1204"/>

                <head>Mr. Seward to Mr.
                        Thayer</head>
                <opener>
                    <seg rendition="#float-left">No. 20.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1863-03-23"><hi rendition="#italic"
                                >March</hi> 23, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your very interesting despatch of the 17th
                    ultimo (No. 30) has been received.</p>
                <p>The reception by the Viceroy of a deputation of American clergymen and
                    missionaries, of which your despatch contains an account, has given much
                    satisfaction to the President, and you are instructed to make this known to his
                    Highness on some suitable occasion.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">William S. Thayer</hi>, Esq., <hi
                            rendition="#italic">&amp;c., &amp;c</hi>., <hi rendition="#italic"
                            >&amp;c., Alexandria.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
