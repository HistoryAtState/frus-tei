    <text>
        <body>
            <div xml:id="d531">

                <pb facs="0605" n="1283" sameAs="frus:frus1863p2/pg1283"/>

                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <head>Mr. Nelson to Mr. Seward.</head>
                <opener><seg rendition="#float-left">No. 51.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">Santiago de Chili</hi>,</placeName>
                        <date calendar="gregorian" when="1862-09-17"><hi rendition="#italic"
                                >September</hi> 17, 1862.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to enclose herein a copy
                    of a note addressed to me by the secretary of foreign relations of Chili on the
                    13th instant, in reply to the one transmitted by me to his excellency on the
                    30th ultimo.</p>
                <p rendition="#center">* * * * * * * *</p>
                <p>I have the honor to remain, very respectfully, your obedient servant,</p>
                <closer>
                    <signed>THOMAS H. NELSON.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William</hi> H. <hi rendition="#small-caps"
                            >Seward</hi>, <hi rendition="#italic">Secretary of State of the United
                            States.</hi></p>
                </postscript>


                <xi:include href="d531-a1.xml" xpointer="d531-a1"/>
            </div>
