    <text>
        <body>
            <div xml:id="d263">

                <pb facs="0263" n="941" sameAs="frus:frus1863p2/pg941"/>

                <head>Mr. Burlingame to Mr.
                        Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 43.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">Peking</hi>,</placeName>
                        <date calendar="gregorian" when="1863-06-21"><hi rendition="#italic"
                                >June</hi> 21, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to submit the
                    correspondence between Colonel Balluzeck, the Russian minister, and myself, on
                    the eve of his departure for St. Petersburgh. The cordiality of the relations,
                    it discloses will, I hope, not be distasteful to the government.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>ANSON BURLINGAME.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William</hi> H. <hi rendition="#small-caps"
                            >Seward</hi>, <hi rendition="#italic">Secretary of State.</hi></p>
                </postscript>



                <xi:include href="d263-a1.xml" xpointer="d263-a1"/>
