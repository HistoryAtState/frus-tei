    <text>
        <body>
            <div xml:id="d254">

                <pb facs="0248" n="926" sameAs="frus:frus1863p2/pg926"/>

                <head>Mr. Seward to Mr.
                        Burlingame</head>
                <opener>
                    <seg rendition="#float-left">No. 29.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1863-03-02"><hi rendition="#italic"
                                >March</hi> 2, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have to acknowledge the receipt of yours,
                    No. 30, of the 10th of December last, and to approve your proceedings in
                    relation to bark Agnes, therein set forth.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Anson Burlingame</hi>, Esq., <hi
                            rendition="#italic">&amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
