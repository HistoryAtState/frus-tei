    <text>
        <body>
            <div xml:id="d16">

                <pb facs="0039" n="717" xml:id="pg717"/>

                <head>Mr. Dayton to Mr. Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 282.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Paris</hi>,</placeName>
                        <date calendar="gregorian" when="1863-03-05"><hi rendition="#italic"
                                >March</hi> 5, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to enclose you herewith a
                    translation of a communication received from the foreign office, and which
                    relates to matter contained in your despatch No. 227, of September 30th
                    last.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM L. DAYTON.</signed></closer>
                <postscript>
                    <p>His Excellency <hi rendition="#small-caps">William</hi> H. <hi
                            rendition="#small-caps">Seward</hi>, <hi rendition="#italic">Secretary
                            of State, &amp;c.</hi></p>
                </postscript>


                <xi:include href="d16-a1.xml" xpointer="d16-a1"/>
