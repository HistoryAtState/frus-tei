    <text>
        <body>
            <div xml:id="d51">

                <pb facs="0065" n="743" sameAs="frus:frus1863p2/pg743"/>

                <head>Mr. Seward to Mr.
                        Dayton</head>
                <opener>
                    <seg rendition="#float-left">No. 355.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1863-06-12"><hi rendition="#italic"
                                >June</hi> 12, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your despatch of the 15th of May (No. 307)
                    relative to letters of marque, has been received, and is approved.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">William</hi> L. <hi rendition="#small-caps"
                            >Dayton</hi>, Esq.</p>
                </postscript>
            </div>
        </body>
