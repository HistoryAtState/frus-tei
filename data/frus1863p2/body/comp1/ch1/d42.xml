    <text>
        <body>
            <div xml:id="d42">

                <pb facs="0061" n="739" sameAs="frus:frus1863p2/pg739"/>

                <head>Mr. Seward to Mr.
                        Dayton</head>
                <opener>
                    <seg rendition="#float-left">No. 343.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1863-05-14"><hi rendition="#italic"
                                >May</hi> 14, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your despatch of the 20th ultimo (No. 300)
                    was duly received. The information which it contains as to the proceedings of
                    the French government in regard to the insurgent steamer Japan, or Virginia, is
                    satisfactory.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">William</hi> L. <hi rendition="#small-caps"
                            >Dayton</hi>, Esq., <hi rendition="#italic">&amp;c., &amp;c.,
                            &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
