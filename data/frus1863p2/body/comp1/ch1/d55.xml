    <text>
        <body>
            <div xml:id="d55">

                <pb facs="0067" n="745" sameAs="frus:frus1863p2/pg745"/>

                <head>Mr. Dayton to Mr. Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 316.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Paris</hi>,</placeName>
                        <date calendar="gregorian" when="1863-06-17"><hi rendition="#italic"
                                >June</hi> 17, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to enclose herewith a
                    printed copy of the letter addressed by the Emperor to General Forey upon
                    receipt of the news of the capture of Puebla.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM L. DAYTON.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William</hi> H. <hi rendition="#small-caps"
                            >Seward</hi>, <hi rendition="#italic">Secretary of State, &amp;c.,
                            &amp;., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d55-a1.xml" xpointer="d55-a1"/>
            </div>
        </body>
    </text>
