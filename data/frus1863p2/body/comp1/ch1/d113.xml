    <text>
        <body>
            <div xml:id="d113">

                <pb facs="0112" n="790" sameAs="frus:frus1863p2/pg790"/>

                <head>Mr. Seward to Mr. Dayton.</head>
                <opener>
                    <seg rendition="#float-left">No. 412.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1863-10-10"><hi rendition="#italic"
                                >October</hi> 10, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your despatch of the 25th of last month,
                    No. 352, describing your proceedings in relation to Mr. Partridge’s course
                    respecting French interests at Salvador, has been received and is approved.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD,</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">William</hi> L. <hi rendition="#small-caps"
                            >Dayton</hi>, Esq., <hi rendition="#italic">&amp;c., &amp;c.,
                            &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
