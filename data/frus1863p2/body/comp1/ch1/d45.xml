    <text>
        <body>
            <div xml:id="d45">

                <pb facs="0062" n="740" sameAs="frus:frus1863p2/pg740"/>

                <head>Mr. Seward to Mr. Dayton</head>
                <opener>
                    <seg rendition="#float-left">No. 346.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1863-05-18"><hi rendition="#italic"
                                >May</hi> 18, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your despatch No. 303, of the 1st instant,
                    has been received. The department is pleased to notice that you have anticipated
                    the instruction, No. 341, in regard to the transaction of Mr. Adams with Messrs.
                    Howell and Zirman.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">William</hi> L. <hi rendition="#small-caps"
                            >Dayton</hi>, Esq., <hi rendition="#italic">&amp;c., &amp;c</hi>., <hi
                            rendition="#italic">&amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
