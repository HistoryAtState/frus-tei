    <text>
        <body>
            <div xml:id="d75">

                <pb facs="0081" n="759" sameAs="frus:frus1863p2/pg759"/>

                <head>Mr. F. W. Seward to Mr. Dayton</head>
                <opener>
                    <seg rendition="#float-left">No. 386.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1863-08-18"><hi rendition="#italic"
                                >August</hi> 18, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your despatch of the 4th instant (No. 331)
                    has been received. Your prompt proceeding, therein reported, is approved. The
                    attention of the Secretary of the Navy has been drawn to the matter.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>F. W. SEWARD. <hi rendition="#italic">Acting
                    Secretary.</hi></signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">William</hi> L. <hi rendition="#small-caps"
                            >Dayton</hi>, Esq.</p>
                </postscript>
            </div>
        </body>
