    <text>
        <body>
            <div xml:id="d64">

                <pb facs="0075" n="753" sameAs="frus:frus1863p2/pg753"/>

                <head>Mr. Seward to Mr.
                        Dayton</head>
                <opener>
                    <seg rendition="#float-left">No. 371.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1863-07-11"><hi rendition="#italic"
                                >July</hi> 11, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have to acknowledge the receipt of your
                    despatch of the 26th ultimo (No. 320) relative to the quotation of stocks of the
                    United States on the French bourse, which is approved. I have also your No. 319
                    by the same mail.</p>
                <p>Your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">William</hi> L. <hi rendition="#small-caps"
                            >Dayton</hi>, Esq.</p>
                </postscript>
            </div>
        </body>
    </text>
