    <text>
        <body>
            <div xml:id="d8">

                <pb facs="0034" n="712" sameAs="frus:frus1863p2/pg712"/>

                <head>Mr. Seward to Mr. Dayton</head>
                <opener>
                    <seg rendition="#float-left">No. 300.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1863-02-14"><hi rendition="#italic"
                                >February</hi> 14, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your despatch of the 27th of January, No.
                    261, has been received. The assiduity and discretion which you have practiced in
                    giving us the tone of the Parisian press are very highly appreciated.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">William</hi> L. <hi rendition="#small-caps"
                            >Dayton</hi>, Esq., <hi rendition="#italic">&amp;c., &amp;c.,
                            &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
