    <text>
        <body>
            <div xml:id="d579">

                <pb facs="0650" n="1328" sameAs="frus:frus1863p2/pg1328"/>

                <head>Mr. Seward to Mr. Dayton.</head>
                <opener>
                    <seg rendition="#float-left">No. 437.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1863-11-28"><hi rendition="#italic"
                                >November</hi> 28, 1863.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I transmit for your information a copy of a
                    communication of the 23d instant, addressed by this department to Major General
                    Banks, and of an instruction of the same date (No. 88) to Mr. Corwin.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">William</hi> L. <hi rendition="#small-caps"
                            >Dayton</hi>, Esq., <hi rendition="#italic">&amp;c., &amp;c.,
                            &amp;c.</hi></p>
                </postscript>


                <xi:include href="d579-a1.xml" xpointer="d579-a1"/>
            </div>
