            <div xml:id="d35">

                <pb facs="0169" n="84" sameAs="frus:frus1919v02/pg84"/>

                <note rend="inline" type="source">837.00/1603</note>
                <head><hi rendition="#italic">The Minister in Cuba</hi> (<hi rendition="#italic"
                        >Gonzales</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Habana</hi></placeName>, <date calendar="gregorian"
                            when="1919-12-11"><hi rendition="#italic">December 11,
                            1919</hi></date>.<lb/>[<hi rendition="#italic">Received December
                            16.</hi>]</dateline>
                    <seg rendition="#float-left">No. 1129</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith copy
                    of a statement given to the press upon receipt of Department’s instruction No.
                    892, of December 1, 1919. This statement has not been published by the <hi
                        rendition="#italic">Heraldo de Cuba</hi>, which had been most active in the
                    publication of the matter denied.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">William E.
                    Gonzales</hi></signed></closer>


                <xi:include href="d35-a1.xml" xpointer="d35-a1"/>
            </div>
