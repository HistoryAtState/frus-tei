    <text>
        <body>
            <div xml:id="d25">

                <pb facs="0111" n="26" sameAs="frus:frus1919v02/pg26"/>

                <note rend="inline" type="source">837.00/1563</note>
                <head><hi rendition="#italic">The Minister in Cuba</hi> (<hi rendition="#italic"
                        >Gonzales</hi>) <hi rendition="#italic">to the Acting Secretary of
                        State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Habana</hi></placeName>, <date calendar="gregorian"
                            when="1919-07-01"><hi rendition="#italic">July 1,
                            1919</hi></date>.<lb/>[<hi rendition="#italic">Received July
                        19.</hi>]</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: For the Department’s information, in
                    accordance with circular instruction dated February 19, 1918,<anchor n="18"
                        xml:id="d25-f1"/> I have the honor to transmit, herewith, Quarterly Report
                    No. 2, giving a general outline of conditions here for the second quarter of the
                    current year. This report was prepared by Secretary Williamson.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">William E.
                    Gonzales</hi></signed></closer>



                <xi:include href="d25-a1.xml" xpointer="d25-a1"/>
            </div>
        </body>
    </text>
