    <text>
        <body>
            <div xml:id="d3">

                <pb facs="0088" n="3" sameAs="frus:frus1919v02/pg3"/>

                <note rend="inline" type="source">837.00/1510</note>
                <head><hi rendition="#italic">The Minister in Cuba</hi> (<hi
                            rendition="#italic">Gonzales</hi>) <hi rendition="#italic">to
                        the Acting Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Habana</hi></placeName>, <date calendar="gregorian"
                            when="1919-01-23"><hi rendition="#italic">January 23,
                            1919</hi></date>.<lb/>[<hi rendition="#italic">Received January
                        28.</hi>]</dateline>
                    <seg rendition="#float-left">No. 918</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Adverting to the Department’s telegraph
                    instruction dated January 15; 6 p.m. regarding the Reformation of the Present
                    Cuban Electoral Laws and the Legation’s despatch No. 912, dated January 18,
                    1919, I have the honor to enclose herewith, duplicate copies in translation, of
                    a note from the Cuban Minister of Foreign Affairs in the premises.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">William E.
                    Gonzales</hi></signed></closer>


                <xi:include href="d3-a1.xml" xpointer="d3-a1"/>
            </div>
