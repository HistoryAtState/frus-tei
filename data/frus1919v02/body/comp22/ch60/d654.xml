            </note>
            <note corresp="#d654-f2" n="9" xml:id="d654-f2-content">
                <p>Jeremiah W. Jenks.</p>
            </note>
            <note corresp="#d654-f3" n="10" xml:id="d654-f3-content">
                <p>Addison T. Ruan.</p>
            </note>
