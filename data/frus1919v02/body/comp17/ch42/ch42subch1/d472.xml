                <pb facs="0605" n="520" sameAs="frus:frus1919v02/pg520"/>

                <note rend="inline" type="source">882.73/14: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        Brazil</hi> (<hi rendition="#italic">Morgan</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1919-01-23T16:00:00-05:00"><hi rendition="#italic">January 23,
                                1919, 4 p.m.</hi></date></dateline></opener>
                <p>Please ascertain promptly who has the custody of the Pernambuco end of the former
                    German cable connecting Pernambuco with Monrovia, Liberia. Cable reply.</p>
                <closer><signed><hi rendition="#small-caps">Polk</hi></signed></closer>
            </div>
        </body>
    </text>
