            <div xml:id="d442">

                <pb facs="0569" n="484" sameAs="frus:frus1919v02/pg484"/>

                <note rend="inline" type="source">882.51/991</note>
                <head><hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Davis</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1919-09-15"><hi rendition="#italic">September 15</hi>(<hi
                                rendition="#italic">?</hi>), <hi rendition="#italic"
                            >1919</hi></date>.<lb/>[<hi rendition="#italic">Received September
                            29.</hi>]</dateline>
                    <seg rendition="#float-left">No. 1314</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Adverting to my telegram No. 3043 of
                    September 18, 1919,<anchor n="28" xml:id="d442-f1"/> relative to the present
                    negotiations for affording financial assistance to Liberia, and for the
                    establishment of an American customs receivership in that country, I have the
                    honor to transmit herewith, copies of a Note no. /24.A. of September 13, 1919,
                    which has been received from the Foreign Office.</p>
                <p>I have [etc.]</p>
                <closer>(For the Ambassador)<lb/><signed><hi rendition="#small-caps">J. Butler
                            Wright</hi></signed></closer>



                <xi:include href="d442-a1.xml" xpointer="d442-a1"/>
                <xi:include href="d442-a2.xml" xpointer="d442-a2"/>
            </div>
