                <head><hi rendition="#italic">The Chargé in Guatemala</hi> (<hi rendition="#italic">Thurston</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
