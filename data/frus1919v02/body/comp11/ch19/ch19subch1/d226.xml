    <text>
        <body>
            <div xml:id="d226">

                <pb facs="0357" n="272" sameAs="frus:frus1919v02/pg272"/>

                <note rend="inline" type="source">814.51/281: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Chargé in
                        Guatemala</hi> (<hi rendition="#italic">Thurston</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1919-04-07T14:00:00-04:00"><hi rendition="#italic">April 7, 1919,
                                2 p.m.</hi></date></dateline></opener>
                <p>Referring to your telegram of March 29, 6 P.M. and 9 P.M.<anchor n="7"
                        xml:id="d226-f1"/> Inform Catlin that in accordance with its usual policy
                    the Government of the United States would give all proper diplomatic support to
                    any legitimate enterprise of this character to which its citizens are parties if
                    beneficial to Guatemala and its citizens.</p>
                <closer><signed><hi rendition="#small-caps">Phillips</hi></signed></closer>
            </div>
        </body>
    </text>
