            <div xml:id="d393">

                <pb facs="0514" n="429" sameAs="frus:frus1919v02/pg429"/>

                <note rend="inline" type="source">893.00/3111: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        Japan</hi> (<hi rendition="#italic">Morris</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1919-05-26T18:00:00-04:00"><hi rendition="#italic">May 26, 1919, 6
                                p.m.</hi></date></dateline></opener>
                <p>Your May 23, 4 p.m., Tientsin affair.</p>
                <p>Department approves and trusts you will be able to obtain a definite reply before
                    leaving for Siberia.</p>
                <closer><signed><hi rendition="#small-caps">Polk</hi></signed></closer>
            </div>
        </body>
    </text>
