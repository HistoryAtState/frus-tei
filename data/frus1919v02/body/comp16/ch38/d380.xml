    <text>
        <body>
            <div xml:id="d380">

                <pb facs="0506" n="421" sameAs="frus:frus1919v02/pg421"/>

                <note rend="inline" type="source">893.00/2983: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >Reinsch</hi>) <hi rendition="#italic">to the Acting Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1919-03-15T00:00:00+08:00"><hi rendition="#italic">March 15, 1919,
                                midnight</hi></date>.<lb/>[<hi rendition="#italic">Received March
                            15, 1 p.m.</hi>]</dateline></opener>
                <p>My telegram March 13th, 8 p.m. Heintzleman<anchor n="16" xml:id="d380-f1"/>
                    reports situation well in hand. No further developments expected. Full report by
                    mail.</p>
                <closer><signed><hi rendition="#small-caps">Reinsch</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d380-f1" n="16" xml:id="d380-f1-content">
                <p>P. Stewart Heintzleman, Consul General at Tientsin.</p>
            </note>
        </listAnnotation>
