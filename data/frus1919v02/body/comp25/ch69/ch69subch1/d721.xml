    <text>
        <body>
            <div xml:id="d721">

                <pb facs="0820" n="735" xml:id="pg735"/>

                <note rend="inline" type="source">823.00/311a</note>
                <head><hi rendition="#italic">The Secretary of State to the Peruvian Chargé</hi>
                        (<hi rendition="#italic">Gibson</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1919-09-04"><hi rendition="#italic">September 4,
                        1919</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inform you that the
                    Government of the United States has recognized Señor Leguia as head of the <hi
                        rendition="#italic">de facto</hi> Government of Peru.</p>
                <p>Accept [etc.]</p>
                <closer>For the Secretary of State:<lb/><signed><hi rendition="#small-caps">Alvey A.
                            Adee</hi></signed></closer>
            </div>
        </body>
