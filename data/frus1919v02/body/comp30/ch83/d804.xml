    <text>
        <body>
            <div xml:id="d804">

                <pb facs="0909" n="824" xml:id="pg824"/>

                <note rend="inline" type="source">860j.48/5b: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Commission to Negotiate Peace</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1919-11-17T18:00:00-05:00"><hi rendition="#italic">November 17,
                                1919, 6 p.m.</hi></date></dateline></opener>
                <p>3796. For Polk and Haskell.</p>
                <p>President authorized Julius H. Barnes, United States Wheat Director and President
                    Grain Corporation to sell to the Armenian Government on credit or otherwise
                    35,000 tons of wheat and wheat flour. Haskell please inform Erivan.</p>
                <closer><signed><hi rendition="#small-caps">Lansing</hi></signed></closer>
            </div>
        </body>
    </text>
