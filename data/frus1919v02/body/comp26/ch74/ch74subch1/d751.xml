    <text>
        <body>
            <div xml:id="d751">

                <pb facs="0845" n="760" sameAs="frus:frus1919v02/pg760"/>

                <note rend="inline" type="source">860c.4016/59: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Minister in Poland</hi> (<hi
                            rendition="#italic">Gibson</hi>)<anchor n="16"
                        xml:id="d751-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1919-06-03T17:00:00-04:00"><hi rendition="#italic">June 3, 1919, 5
                                p.m.</hi></date></dateline></opener>
                <p>23. Your 36, May 30th. Department desires that you invite Doctor Bogen and Lt.
                    Col. Bailey to accompany you in a careful personal investigation and that you
                    cable the substance of your report in order that it may be received here if
                    possible within a week. Newspaper reports regarding alleged pogroms have laid
                    special stress on alleged occurrences at Pinsk, Vilna, and Lemberg and
                    elsewhere, Department is particularly interested in events which have occurred
                    since the establishment of responsible Polish Government.</p>
                <closer><signed><hi rendition="#small-caps">Phillips</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d751-f1" n="16" type="source" xml:id="d751-f1-content">
                <p>Sent via the Embassy in France.</p>
            </note>
        </listAnnotation>
    </standOff>
