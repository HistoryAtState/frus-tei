    <text>
        <body>
            <div xml:id="d770">

                <pb facs="0886" n="801" sameAs="frus:frus1919v02/pg801"/>

                <note rend="inline" type="source">816.48/76: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Salvador</hi> (<hi
                            rendition="#italic">Arnold</hi>) <hi rendition="#italic">to
                        the Acting Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >San Salvador</hi></placeName>, <date calendar="gregorian"
                            when="1919-04-29"><hi rendition="#italic">April 29,
                            1919</hi></date>.<lb/>[<hi rendition="#italic">Received 7.20
                        p.m.</hi>]</dateline></opener>
                <p>President of Salvador Red Cross requests aid of 100 tents from American Red Cross
                    to house the homeless.</p>
                <closer><signed><hi rendition="#small-caps">Arnold</hi></signed></closer>
            </div>
        </body>
    </text>
