            <div xml:id="d684">

                <pb facs="0796" n="711" sameAs="frus:frus1919v02/pg711"/>

                <note rend="inline" type="source">741.91/9</note>
                <head><hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Davis</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1919-09-16"><hi rendition="#italic">September 16,
                            1919</hi></date>.<lb/>[<hi rendition="#italic">Received October
                        6.</hi>]</dateline>
                    <seg rendition="#float-left">No. 1330</seg>
                    <lb/>
                    <seg rendition="#float-left">Confidential</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to the Department’s telegram
                    No. 5844 of August 20, 4 p.m., and my telegram No. 3039 of September 13, 2 p.m.,
                        <pb facs="0797" n="712" xml:id="pg712"/> regarding the Anglo–Persian
                    Agreement, I have the honor to transmit herewith enclosed, for the information
                    of the Department a copy of an informal communication I have received from Earl
                    Curzon on the subject of his interview with Colonel House.</p>
                <p>I have [etc.]</p>
                <closer>For the Ambassador,<lb/><signed><hi rendition="#small-caps">J. Butler
                            Wright</hi></signed></closer>


                <xi:include href="d684-a1.xml" xpointer="d684-a1"/>
            </div>
