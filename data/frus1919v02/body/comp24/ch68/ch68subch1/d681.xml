    <text>
        <body>
            <div xml:id="d681">

                <pb facs="0788" n="703" xml:id="pg703"/>

                <note rend="inline" type="source">741.91/3</note>
                <head><hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Davis</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1919-09-02"><hi rendition="#italic">September 2,
                            1919</hi></date>.<lb/>[<hi rendition="#italic">Received September
                            15.</hi>]</dateline>
                    <seg rendition="#float-left">No. 1245</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith, for
                    the information of the Department, copies, in duplicate, of the Agreement
                    between His Britannic Majesty’s Government and the Persian Government, (Persia
                    No. 1 (1919)).</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">John W. Davis</hi></signed></closer>




