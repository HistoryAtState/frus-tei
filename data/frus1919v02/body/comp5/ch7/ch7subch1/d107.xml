    <text>
        <body>
            <div xml:id="d107">

                <pb facs="0265" n="180" sameAs="frus:frus1919v02/pg180"/>

                <note rend="inline" type="source">422.11G93/979: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Chargé in
                        Ecuador</hi> (<hi rendition="#italic">Belt</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1919-04-02T17:00:00-04:00"><hi rendition="#italic">April 2, 1919,
                                5 p.m.</hi></date></dateline></opener>
                <p>Your October 25, 7 p.m.<anchor n="16" xml:id="d107-f1"/></p>
                <p>Cable Department whether daily deposits are still being paid and if not what
                    reason is alleged by Ecuadorian Government for discontinuance.</p>
                <closer><signed><hi rendition="#small-caps">Phillips</hi></signed></closer>
            </div>
        </body>
    </text>
