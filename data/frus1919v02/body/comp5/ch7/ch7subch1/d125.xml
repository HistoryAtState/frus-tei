    <text>
        <body>
            <div xml:id="d125">

                <pb facs="0283" n="198" sameAs="frus:frus1919v02/pg198"/>

                <note rend="inline" type="source">422.11G93/1057</note>
                <head><hi rendition="#italic">The Vice President of the Guayaquil &amp; Quito
                        Railway Co</hi>. (<hi rendition="#italic">Archer
                            Harman</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >New York</hi></placeName>, <date calendar="gregorian"
                            when="1919-10-06"><hi rendition="#italic">October 6,
                            1919</hi></date>.<lb/>[<hi rendition="#italic">Received October
                        11.</hi>]</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I beg to send you herewith copy of
                    Resolutions adopted by the Directors of this Company at their meeting held on
                    the 8th day of September, 1919.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Archer Harman</hi></signed></closer>


                <xi:include href="d125-a1.xml" xpointer="d125-a1"/>
