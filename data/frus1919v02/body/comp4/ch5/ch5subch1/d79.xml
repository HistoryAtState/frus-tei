            <div xml:id="d79">

                <pb facs="0233" n="148" sameAs="frus:frus1919v02/pg148"/>

                <note rend="inline" type="source">839.51/2024</note>
                <head><hi rendition="#italic">The Consul at Santo Domingo</hi> (<hi
                        rendition="#italic">Edwards</hi>), <hi rendition="#italic">Temporarily in
                        Charge of the Legation in the Dominican, Republic, to the Acting Secretary
                        of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Santo Domingo</hi></placeName>, <date calendar="gregorian"
                            when="1919-03-22"><hi rendition="#italic">March 22,
                            1919</hi></date>.<lb/>[<hi rendition="#italic">Received April
                        3.</hi>]</dateline>
                    <seg rendition="#float-left">No. 438</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: As of interest to the Department, and with
                    reference to your telegram of March 13—6 p.m., and my reply of March 18—3
                        p.m.,<anchor n="28" xml:id="d79-f1"/> I have the honor to enclose herewith
                    copies of Executive Order No. 272, issued by the Military Government of Santo
                    Domingo on March 13, 1919, providing for additional payments to be made to the
                    amortization fund for the redemption of the 1918 issue of bonds for the payment
                    of the awards of the Dominican Claims Commission of 1917.<anchor n="29"
                        xml:id="d79-f2"/></p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Clement S.
                    Edwards</hi></signed></closer>


                <xi:include href="d79-a1.xml" xpointer="d79-a1"/>
            </div>
        </body>
    </text>
