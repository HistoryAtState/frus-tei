    <text>
        <body>
            <div xml:id="d93">

                <pb facs="0255" n="170" sameAs="frus:frus1919v02/pg170"/>

                <note rend="inline" type="source">639.003/62</note>
                <head><hi rendition="#italic">The Minister in the Dominican Republic</hi> (<hi rendition="#italic">Russell</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Santo Domingo</hi></placeName>, <date calendar="gregorian"
                            when="1919-10-25"><hi rendition="#italic">October 25,
                            1919</hi></date>.<lb/>[<hi rendition="#italic">Received November
                            13.</hi>]</dateline>
                    <seg rendition="#float-left">No. 515</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to forward herewith three
                    copies of the new Dominican Tariff to be effective on January 1, 1920.<anchor
                        n="53" xml:id="d93-f1"/></p>
                <p>There is also enclosed a copy of the Final Report and Recommendations of the
                    Dominican Tariff Commission,<anchor n="53" xml:id="d93-f2"/> which explains the
                    changes in the new tariff rates.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">William W.
                    Russell</hi></signed></closer>
            </div>
        </body>
    </text>
