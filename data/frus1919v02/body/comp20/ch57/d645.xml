                <pb facs="0761" n="676" sameAs="frus:frus1919v02/pg676"/>

                <note rend="inline" type="source">817.00/2602: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Minister in
                        Nicaragua</hi> (<hi rendition="#italic">Jefferson</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1919-06-12T18:00:00-04:00"><hi rendition="#italic">June 12, 1919,
                                6 p.m.</hi></date></dateline></opener>
                <p>Your June 1 [<hi rendition="#italic">9</hi>], 11 a.m.</p>
                <p>Department pleased, good man to be Governor of Bluefields but believes fairness
                    demands that Government publicly assume a definite position with respect to
                    expulsion decree. Keep Department informed by cable.</p>
                <closer><signed><hi rendition="#small-caps">Polk</hi></signed></closer>
            </div>
        </body>
    </text>
