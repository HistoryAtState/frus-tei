    <text>
        <body>
            <div xml:id="d155">

                <pb facs="0303" n="218" xml:id="pg218"/>

                <note rend="inline" type="source">701.60d11/24</note>
                <head><hi rendition="#italic">The Finnish Delegate</hi> (<hi
                            rendition="#italic">Saastamoinen</hi>) <hi
                        rendition="#italic">to the Acting Secretary of
                            State</hi></head>
                <p><hi rendition="#small-caps">Sir</hi>: Having been appointed Delegate of the
                    Finnish Government to the United States of America, I take the liberty of
                    tendering you a copy of my letter of credence, sincerely hoping that you will
                    receive me personally so as to give me an opportunity to present you the
                    original thereof.</p>
                <p>I beg to remain [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">A. H. Saastamoinen</hi>
                    </signed>
                    <dateline rendition="#float-left">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1919-05-19">
                            <hi rendition="#italic">May 19, 1919</hi>
                        </date>.</dateline>
                </closer>


                <xi:include href="d155-a1.xml" xpointer="d155-a1"/>
            </div>
