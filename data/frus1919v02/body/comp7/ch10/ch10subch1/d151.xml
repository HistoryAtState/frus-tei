                <pb facs="0300" n="215" sameAs="frus:frus1919v02/pg215"/>

                <note rend="inline" type="source">860d.01/71</note>
                <head><hi rendition="#italic">The Secretary of State to the Finnish Minister of
                        Foreign Affairs</hi> (<hi rendition="#italic">Holsti</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1919-05-07"><hi rendition="#italic">May 7,
                        1919</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I have the honor to inform Your
                    Excellency that the United States has recognized the independence of Finland and
                    the Government, of which Your Excellency is a member, as the <hi
                        rendition="#italic">de facto</hi> Government of Finland.</p>
                <p>In assuring Your Excellency of the pleasure it gives me to make this
                    announcement, I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Robert Lansing</hi></signed></closer>
            </div>
        </body>
