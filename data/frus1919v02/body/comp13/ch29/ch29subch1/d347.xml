            <div xml:id="d347">

                <pb facs="0479" n="394" xml:id="pg394"/>

                <note rend="inline" type="source">701.1511/108: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Consul in Charge of the Legation in Honduras</hi> (<hi rendition="#italic">Lawton</hi>)</head>
                <opener><seg rendition="#center">[Extract]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1919-10-29T17:00:00-05:00"><hi rendition="#italic">October 29,
                                1919, 5 p.m.</hi></date></dateline></opener>
                <p>Your October 24, 10 a.m.</p>
                <p rendition="#center">. . . . . . .</p>
                <p>Department is pleased with the acts of Bogran which have come to its notice.</p>
                <p rendition="#center">. . . . . . .</p>
                <closer><signed><hi rendition="#small-caps">Lansing</hi></signed></closer>
            </div>
        </body>
