                <pb facs="0462" n="377" sameAs="frus:frus1919v02/pg377"/>

                <note rend="inline" type="source">815.00/1853: Telegram</note>
                <head><hi rendition="#italic">The Minister in Honduras</hi> (<hi rendition="#italic"
                        >Jones</hi>) <hi rendition="#italic">to the Acting Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Tegucigalpa</hi></placeName>, <date calendar="gregorian"
                            when="1919-05-12T23:00:00-05:48"><hi rendition="#italic">May 12, 1919,
                                11 p.m.</hi></date><lb/>[<hi rendition="#italic">Received May 13,
                            11.20 p.m.</hi>]</dateline></opener>
                <p>United States Ship <hi rendition="#italic">Machias</hi> arrived at Amapala this
                    afternoon. Recommend its presence until further developments warrant
                    withdrawal.</p>
                <closer><signed><hi rendition="#small-caps">Jones</hi></signed></closer>
            </div>
        </body>
