            <div xml:id="d343">

                <pb facs="0476" n="391" xml:id="pg391"/>

                <note rend="inline" type="source">815.00/2058: Telegram</note>
                <head><hi rendition="#italic">The Minister in Honduras</hi> (<hi rendition="#italic"
                        >Jones</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Tegucigalpa</hi></placeName>, <date calendar="gregorian"
                            when="1919-10-02T11:00:00-05:48"><hi rendition="#italic">October 2,
                                1919, 11 a.m.</hi></date><lb/>[<hi rendition="#italic">Received
                            October 4, 4.15 p.m.</hi>]</dateline></opener>
                <p>Your September 10, 6 p.m. Francisco Bogran arrived here September 29th and will
                    assume the Presidency on the 5th instant 3 p.m.</p>
                <closer><signed><hi rendition="#small-caps">Jones</hi></signed></closer>
            </div>
        </body>
    </text>
