                <pb facs="0468" n="383" sameAs="frus:frus1919v02/pg383"/>

                <note rend="inline" type="source">815.00/1958: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Minister in Honduras</hi> (<hi rendition="#italic"
                            >Jones</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1919-08-29T15:00:00-04:00"><hi rendition="#italic">August 29,
                                1919, 3 p.m.</hi></date></dateline></opener>
                <p>Should the occasion offer you may inform President Bertrand that the Government
                    of the United States could not view with indifference the violation of
                    Nicaraguan soil.</p>
                <closer><signed><hi rendition="#small-caps">Lansing</hi></signed></closer>
            </div>
        </body>
    </text>
