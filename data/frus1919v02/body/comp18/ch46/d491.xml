    <text>
        <body>
            <div xml:id="d491">

                <pb facs="0630" n="545" sameAs="frus:frus1919v02/pg545"/>

                <note rend="inline" type="source">710.11/405</note>
                <head><hi rendition="#italic">The Chargé in Mexico</hi> (<hi
                            rendition="#italic">Summerlin</hi>) <hi rendition="#italic"
                        >to the Acting Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1919-05-13"><hi rendition="#italic">May 13,
                            1919</hi></date>.<lb/>[<hi rendition="#italic">Received May
                        22.</hi>]</dateline>
                    <seg rendition="#float-left">No. 2010</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to the Embassy’s telegram
                    No. 2082, May 9, 3 P.M.,<anchor n="28" xml:id="d491-f1"/> and for the records of
                    the Department, I have the honor <pb facs="0631" n="546" xml:id="pg546"/> to
                    send enclosed copies of the telegram to the New York <hi rendition="#italic"
                        >World</hi> by its Mexico City correspondent, Mr. Robert H. Murray,
                    reporting an interview with President Carranza in explanation of his opposition
                    to the Monroe Doctrine.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">George T.
                    Summerlin</hi></signed></closer>


                <xi:include href="d491-a1.xml" xpointer="d491-a1"/>
            </div>
        </body>
    </text>
