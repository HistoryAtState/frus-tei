    <text>
        <body>
            <div xml:id="d495">

                <pb facs="0635" n="550" xml:id="pg550"/>

                <note rend="inline" type="source">812.113/9226</note>
                <head><hi rendition="#italic">The Mexican Ambassador</hi> (<hi
                            rendition="#italic">Bonillas</hi>) <hi rendition="#italic">to
                        the Acting Secretary of State</hi></head>
                <p rendition="#center"><hi rendition="#small-caps">Memorandum</hi></p>
                <p>The Mexican Government wishes to know if it is possible for the United States
                    Government to sell to the former, rifles which were used by the American Army
                    before the war.</p>
                <closer>
                    <dateline rendition="#float-left">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1919-03-18">
                            <hi rendition="#italic">March 18, 1919</hi></date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
