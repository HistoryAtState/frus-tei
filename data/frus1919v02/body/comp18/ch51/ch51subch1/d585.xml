            <div xml:id="d585">

                <pb facs="0700" n="615" sameAs="frus:frus1919v02/pg615"/>

                <note rend="inline" type="source">812.52/470</note>
                <head><hi rendition="#italic">The Consul at Guaymas</hi> (<hi rendition="#italic"
                        >Yost</hi>) <hi rendition="#italic">to the Acting Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Guaymas</hi></placeName>, <date calendar="gregorian"
                            when="1919-07-19"><hi rendition="#italic">July 19,
                            1919</hi></date>.<lb/>[<hi rendition="#italic">Received July
                        28.</hi>]</dateline>
                    <seg rendition="#float-left">No. 105</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith
                    copies of the <hi rendition="#italic">Boletin Oficial</hi> published on July 6,
                    1919, at Hermosillo, containing the Agrarian Law passed by the State Legislature
                    on June 23 and promulgated by the Governor on July 3, together with a
                    translation of said law into English. Owing to the extensive American land
                    interests in Sonora, a knowledge of this radical piece of legislation is thought
                    to be of the utmost importance to many Americans, and of interest to many
                    others.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">B. F. Yost</hi></signed></closer>



                <xi:include href="d585-a1.xml" xpointer="d585-a1"/>
            </div>
