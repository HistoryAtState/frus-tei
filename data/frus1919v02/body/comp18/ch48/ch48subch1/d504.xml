    <text>
        <body>
            <div xml:id="d504">

                <pb facs="0641" n="556" sameAs="frus:frus1919v02/pg556"/>

                <note rend="inline" type="source">812.00/22675</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Mexican Ambassador</hi> (<hi
                            rendition="#italic">Bonillas</hi>)</head>
                <p>Referring to the memorandum of His Excellency the Mexican Ambassador of March 20,
                    1919, in regard to violations of the neutrality laws of the United States by
                    Federico Cervantes and other <pb facs="0642" n="557" xml:id="pg557"/> Mexicans
                    in Texas, who attempted to join Francisco Villa’s forces in Mexico, the Acting
                    Secretary of State has the honor to state that he is advised by the Attorney
                    General that, on April 16, the trial of Cervantes and his associates terminated
                    in a verdict of guilty, rendered by the jury.</p>
                <closer>
                    <dateline rendition="#float-left">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1919-05-13">
                            <hi rendition="#italic">May 13, 1919</hi></date>.</dateline>
                </closer>
            </div>
        </body>
