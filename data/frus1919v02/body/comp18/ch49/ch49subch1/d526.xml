    <text>
        <body>
            <div xml:id="d526">

                <pb facs="0654" n="569" sameAs="frus:frus1919v02/pg569"/>

                <note rend="inline" type="source">812.00/22570</note>
                <head><hi rendition="#italic">The Chargé in Mexico</hi> (<hi rendition="#italic"
                        >Summerlin</hi>) <hi rendition="#italic">to the Acting Secretary of
                        State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1919-02-28"><hi rendition="#italic">February 28,
                            1919</hi></date>.<lb/>[<hi rendition="#italic">Received March
                        18.</hi>]</dateline>
                    <seg rendition="#float-left">No. 1850</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to the Department’s telegraphic
                    instruction No. 1876 of February 19, 3 P.M., I have the honor to enclose
                    herewith, copy and translation of a note,<anchor n="48" xml:id="d526-f1"/> dated
                    February 24, 1919, received from the Mexican Foreign Office, stating that just
                    as soon as the representations of the Embassy were received in regard to the
                    assassination <pb facs="0655" n="570" xml:id="pg570"/> of the two foreigners in
                    the vicinity of Tapachula, Chiapas, the matter was referred to the respective
                    authorities for appropriate action.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">George T.
                    Summerlin</hi></signed></closer>
            </div>
        </body>
    </text>
