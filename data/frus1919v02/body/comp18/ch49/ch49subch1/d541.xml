                <pb facs="0663" n="578" sameAs="frus:frus1919v02/pg578"/>

                <note rend="inline" type="source">125.61383/120: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Mexico</hi> (<hi
                            rendition="#italic">Summerlin</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1919-10-21T17:00:00-06:36"><hi rendition="#italic">October 21,
                                1919, 5 p.m.</hi></date><lb/>[<hi rendition="#italic">Received
                            October 22, 8.34 a.m.</hi>]</dateline></opener>
                <p>3230. The Acting Minister for Foreign Affairs informed me this morning that the
                    Government will take all possible measures to effect the release in safety of
                    Consular Agent Jenkins.</p>
                <closer><signed><hi rendition="#small-caps">Summerlin</hi></signed></closer>
            </div>
        </body>
