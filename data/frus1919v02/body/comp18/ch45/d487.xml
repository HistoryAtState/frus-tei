    <text>
        <body>
            <div xml:id="d487">

                <pb facs="0629" n="544" sameAs="frus:frus1919v02/pg544"/>

                <note rend="inline" type="source">211.12/31a: Circular telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Chargé in Mexico</hi> (<hi
                            rendition="#italic">Summerlin</hi>)<anchor n="25"
                        xml:id="d487-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1919-04-05T18:00:00-04:00"><hi rendition="#italic">April 5, 1919,
                                6 p.m.</hi></date>.</dateline></opener>
                <p>Report your opinion as to advisability of resuming extradition proceedings with
                    Mexican Government.</p>
                <closer><signed><hi rendition="#small-caps">Phillips</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d487-f1" n="25" type="source" xml:id="d487-f1-content">
                <p>Sent also to consular officers at Ciudad Juarez; Matamoros; Mazatlan; Monterey;
                    Mexico, D.F.; Piedras Negras; and Vera Cruz.</p>
            </note>
        </listAnnotation>
    </standOff>
