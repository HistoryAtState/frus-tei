    <text>
        <body>
            <div xml:id="d1365">

                <pb facs="0606" n="2308" sameAs="frus:frus1952-54v09p2/pg2308"/>

                <note rend="inline" type="source">874.10/10–2054: Despatch</note>
                <head>No. 1365<lb/><hi rendition="#italic">The Ambassador in Egypt (Caffery) to the
                        Department of State</hi><anchor n="1" xml:id="d1365-f1"/></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">limited official
                            use</hi><lb/>No. 752</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Cairo</hi></placeName>, <date calendar="gregorian"
                            type="conversation-or-meeting-date" when="1954-10-20">October 20,
                            1954</date>.</dateline>
                </opener>
                <list type="references">
                    <head>Ref:</head>
                    <item>CERP June 24, 1954; D–5.<anchor n="2" xml:id="d1365-f2"/></item>
                </list>
                <list subtype="subject" type="description">
                    <item>Subject:</item>
                    <item>Transmitting Copy of Memorandum of Conversations Between IBRD Officials
                        and Members of the Egyptian Economic and Financial Missions to the United
                        States.</item>
                </list>
                <p>There is enclosed a copy of the memorandum of conversations which were held on
                    September 25, 1954 in Washington between IBRD officials and members of the
                    Egyptian Economic and Financial Missions which have just visited the United
                    States.</p>
                <closer>For the Ambassador:<lb/><signed><hi rendition="#bold"><hi
                                rendition="#small-caps">Perry Ellis</hi></hi></signed>
                    <lb/>
                    <hi rendition="#italic">First Secretary of Embassy</hi></closer>


                <xi:include href="d1365-a1.xml" xpointer="d1365-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1365-f1" n="1" type="source" xml:id="d1365-f1-content">
                <p>A copy of the enclosed memorandum of conversations was sent to the U.S. Treasury
                    representative in Beirut.</p>
            </note>
            <note corresp="#d1365-f2" n="2" xml:id="d1365-f2-content">
                <p>Not printed.</p>
            </note>
