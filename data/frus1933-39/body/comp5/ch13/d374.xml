    <text>
        <body>
            <div xml:id="d374">

                <pb facs="0532" n="426" xml:id="pg426"/>

                <note rend="inline" type="source">611.6131/454: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the Soviet Union</hi> (<hi
                        rendition="#italic">Davies</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Moscow</hi></placeName>, <date
                            calendar="gregorian" when="1937-07-14T09:00:00+03:00">July 14, 1937—9
                            a.m.</date>
                        <lb/> [Received July 14—5:32 a.m.]</dateline>
                </opener>
                <p>171. Department’s No. 90, July 12, 7 p.m. Reference made to Department’s numbered
                    sections.</p>
                <list>
                    <label>1.</label>
                    <item>Text approved by Soviet officials.</item>
                    <label>2.</label>
                    <item>Changes acceptable to Soviet side.</item>
                    <label>3.</label>
                    <item>The word was telegraphed from Moscow.</item>
                    <label>4.</label>
                    <item>It was explained that agreement could enter into effect only on the date
                        of proclamation.</item>
                </list>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Davies</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
