    <text>
        <body>
            <div xml:id="d507">

                <pb facs="0761" n="655" xml:id="pg655"/>

                <note rend="inline" type="source">661.11241/15: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in the
                        Soviet Union</hi> (<hi rendition="#italic">Davies</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1938-04-29T20:00:00-04:00">April 29, 1938—8
                            p.m.</date>
                    </dateline>
                </opener>
                <p>63. Your despatch No. 1152, April 12, 1938.<anchor n="63" xml:id="d507-f1"/> The
                    Embassy may, in your discretion, participate in the contemplated protest
                    provided that the representatives of all the great powers join in it.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Welles</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d507-f1" n="63" xml:id="d507-f1-content">
                <p>Not printed, but see Embassy’s telegram No. 89, March 28, 1938, 9 p.m., <ref
                        target="#pg644">p. 644</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
