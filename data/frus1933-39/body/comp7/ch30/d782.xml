    <text>
        <body>
            <div xml:id="d782">

                <pb facs="1075" n="969" sameAs="frus:frus1933-39/pg969"/>

                <note rend="inline" type="source">760p.61/114: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in Latvia</hi> (<hi rendition="#italic">Wiley</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Riga</hi></placeName>, <date
                            calendar="gregorian" when="1939-10-14T10:00:00+02:00">October 14,
                            1939—10 a.m.</date>
                        <lb/> [Received October 14—8:22 a.m.]</dateline>
                </opener>
                <p>263. Sov[iet] military delegation arrived Riga yesterday ex Tallinn and Moscow
                    headed by Isakov, Assistant Commissar
                    Navy, and General Boldin, chief,
                        Kalinin Mil[itary] District.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Wiley</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
