            <div xml:id="d779">

                <pb facs="1072" n="966" sameAs="frus:frus1933-39/pg966"/>

                <note rend="inline" type="source">760p.6111/57: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in Latvia</hi> (<hi rendition="#italic"
                        >Wiley</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Riga</hi></placeName>, <date
                            calendar="gregorian" when="1939-10-12T12:00:00+02:00">October 12,
                            1939—noon</date>.<lb/>[Received October 12—7:52 a.m.]</dateline>
                </opener>
                <p>253. Ratifications Latvian-Soviet mutual assistance pact exchanged here
                    yesterday.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wiley</hi>
                    </signed>
                </closer>
            </div>
        </body>
