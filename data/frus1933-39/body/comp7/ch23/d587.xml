                            <hi rendition="#italic">1939</hi>
                        </cell>
                    </row>
                    <row>
                        <cell>1.</cell>
                        <cell>Moscow</cell>
                        <cell role="num">2,029,425</cell>
                        <cell role="num">4,137,018</cell>
                    </row>
                    <row>
                        <cell>2.</cell>
                        <cell>Leningrad</cell>
                        <cell role="num">1,690,065</cell>
                        <cell role="num">3,191,304</cell>
                    </row>
                    <row>
