                        <cell>White Russian S. S. R.</cell>
                        <cell role="num">4,983,240</cell>
                        <cell role="num">5,567,976</cell>
                    </row>
                    <row>
                        <cell>4.</cell>
                        <cell>Azerbaidzhan S. S. R.</cell>
                        <cell role="num">2,313,744</cell>
                        <cell role="num">3,209,727</cell>
                    </row>
                    <row>
                        <cell>5.</cell>
                        <cell>Georgian S. S. R.</cell>
                        <cell role="num">2,677,233</cell>
                        <cell role="num">3,542,289</cell>
                    </row>
                    <row>
                        <cell>6.</cell>
                        <cell>Armenian S. S. R.</cell>
                        <cell role="num">881,290</cell>
                        <cell role="num">1,281,599</cell>
                    </row>
                    <row>
                        <cell>7.</cell>
                        <cell>Turkmen S. S. R.</cell>
                        <cell role="num">998,154</cell>
                        <cell role="num">1,253,985</cell>
                    </row>
                    <row>
                        <cell>8.</cell>
                        <cell>Uzbek S. S. R</cell>
                        <cell role="num">4,565,432</cell>
                        <cell role="num">6,282,446</cell>
                    </row>
                    <row>
                        <cell>9.</cell>
                        <cell>Tadzhik S. S. R.</cell>
                        <cell role="num">1,032,216</cell>
                        <cell role="num">1,485,091</cell>
                    </row>
                    <row>
                        <cell>10.</cell>
                        <cell>Kazakh S. S. R.</cell>
                        <cell role="num">6,073,979</cell>
                        <cell role="num">6,145,937</cell>
                    </row>
                    <row>
                        <cell>11.</cell>
                        <cell>Kirgiz S. S. R.</cell>
                        <cell rendition="#border-bottom" role="num">1,001,697</cell>
                        <cell rendition="#border-bottom" role="num">1,459,301</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell>Total</cell>
                        <cell role="num">147,027,915</cell>
                        <cell role="num">170,467,186</cell>
                    </row>
                </table>
                <p rendition="#center">
                    <hi rendition="#small-caps">Population of the Ten Largest Cities of the</hi> U.
                    S. S. R.</p>
                <table cols="4" rows="11">
                    <row>
                        <cell>
                            <hi rendition="#italic">Name</hi>
                        </cell>
                        <cell/>
                        <cell role="num">
                            <hi rendition="#italic">1926</hi>
                        </cell>
