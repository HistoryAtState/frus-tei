                    </row>
                    <row>
                        <cell>4.</cell>
                        <cell>Kharkov</cell>
                        <cell role="num">417,342</cell>
                        <cell role="num">833,432</cell>
                    </row>
                    <row>
                        <cell>5.</cell>
                        <cell>Baku</cell>
                        <cell role="num">453,333</cell>
                        <cell role="num">809,347</cell>
                    </row>
                    <row>
                        <cell>6.</cell>
                        <cell>Gorki</cell>
                        <cell role="num">222,356</cell>
                        <cell role="num">644,116</cell>
                    </row>
                    <row>
                        <cell>7.</cell>
                        <cell>Odessa</cell>
                        <cell role="num">420,862</cell>
                        <cell role="num">604,223</cell>
                    </row>
                    <row>
                        <cell>8.</cell>
                        <cell>Tashkent</cell>
                        <cell role="num">323,613</cell>
                        <cell role="num">585,005</cell>
                    </row>
                    <row>
                        <cell>9.</cell>
                        <cell>Tbilisi</cell>
                        <cell role="num">294,044</cell>
                        <cell role="num">519,175</cell>
                    </row>
                    <row>
                        <cell>10.</cell>
                        <cell>Rostov-on-Don</cell>
                        <cell role="num">308,103</cell>
                        <cell role="num">510,253</cell>
                    </row>
                </table>
                <p>Respectfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stuart E. Grummon</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d587-f1" n="65" xml:id="d587-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d587-f2" n="66" xml:id="d587-f2-content">
                <p>The census was taken in cities between January 17 and 23, 1939, and in rural
                    districts between January 17 and 26. A previous census of January 6, 1937, had
                    been cancelled on September 26, 1937, because of disappointing results induced
                    by errors and culpable shortcomings of the enumerators.</p>
            </note>
            <note corresp="#d587-f3" n="*" xml:id="d587-f3-content">
                <p>Moscow <hi rendition="#italic">Pravda</hi>, June 2, 1939. [Footnote in the
                    original.]</p>
            </note>
        </listAnnotation>
    </standOff>
