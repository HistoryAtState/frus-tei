    <text>
        <body>
            <div xml:id="d190">

                <pb facs="0286" n="180" sameAs="frus:frus1933-39/pg180"/>

                <note rend="inline" type="source">125.631/23: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in the Soviet Union</hi> (<hi
                        rendition="#italic">Wiley</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Moscow</hi></placeName>, <date
                            calendar="gregorian" when="1935-02-07T17:00:00+03:00">February 7, 1935—5
                            p.m.</date>
                        <lb/> [Received February 7—11:30 a.m.]</dateline>
                </opener>
                <p>53. In compliance with your 27, February 6, 2 p.m., the Consulate General has
                    been abolished as of February 6, 1935, and Consular Section has been opened as
                    of February 7th, 1935.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wiley</hi>
                    </signed>
                </closer>
            </div>
