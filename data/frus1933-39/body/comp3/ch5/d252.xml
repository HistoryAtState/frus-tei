                <pb facs="0348" n="242" sameAs="frus:frus1933-39/pg242"/>

                <note rend="inline" type="source">801.00 Congress, Communist International, VII/53:
                    Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in the Soviet
                        Union</hi> (<hi rendition="#italic">Bullitt</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1935-08-19T18:00:00-04:00">August 19, 1935—6
                            p.m.</date>
                    </dateline>
                </opener>
                <p>188. Telegraph names and positions of officials of Soviet Government attending or
                    speaking at Congress of Communist International. Supplement by mail giving
                    published source in each instance.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
