            <div xml:id="d267">

                <pb facs="0361" n="255" sameAs="frus:frus1933-39/pg255"/>

                <note rend="inline" type="source">861.00 Congress, Communist International, VII/94:
                    Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in the Soviet Union</hi> (<hi rendition="#italic">Bullitt</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1935-08-29T18:00:00-04:00">August 29, 1935—6
                            p.m.</date>
                    </dateline>
                </opener>
                <p>207. Please keep Department informed of gist of Soviet press references to recent
                    exchange of notes. To what extent have texts of notes been published?</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Hull</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
