    <text>
        <body>
            <div xml:id="d191">

                <pb facs="0477" n="429" sameAs="frus:frus1868p1/pg429"/>

                <head>Mr. Seward to Mr.
                        Thornton</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1868-04-17"><hi rendition="#italic"
                                >April</hi> 17, 1868.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to transmit for your
                    information a copy of a dispatcht of the 28th ultimo, from the chargé d’affaires
                    of the United States at Mexico, respecting the arrest of foreigners in various
                    parts of that country.</p>
                <p>I have the honor to be, with the highest consideration, sir, your obedient
                    servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Edward Thornton,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.<anchor n="†"
                                xml:id="d191-f1"/></hi></p>
                </postscript>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d191-f1" n="†" xml:id="d191-f1-content">
                <p>For this inclosure see correspondence with the United States at Mexico.</p>
            </note>
        </listAnnotation>
    </standOff>
