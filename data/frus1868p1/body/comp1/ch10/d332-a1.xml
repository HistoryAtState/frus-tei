    <text>
        <body>
            <div xml:id="d332-a1">

                <pb facs="0779" n="731" sameAs="frus:frus1868p1/pg731"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Japanese Iron-clad Steamer
                                Stonewall</hi>, <hi rendition="#italic">Off
                            Yokohama,</hi></placeName>
                        <date calendar="gregorian" when="1868-04-23"><hi rendition="#italic"
                                >April</hi> 23, 1868.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> In compliance with instructions from the
                    honorable the Secretary of State, I have the honor to report the arrival of this
                    vessel at this port.</p>
                <p>I am the bearer of two packages from the State Department, which I am directed to
                    deliver to you, and will take pleasure in so doing at the earliest possible
                    moment. I am, sir, very respectfully, your obedient servant,</p>
                <closer>
                    <signed>GEORGE BROWN, <hi rendition="#italic">Commander, United States
                            Navy.</hi></signed></closer>
                <postscript>
                    <p>Gen. <hi rendition="#small-caps">R. B. Van Vankenburgh</hi>, <hi
                            rendition="#italic">United States Minister Resident, Tedo.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
