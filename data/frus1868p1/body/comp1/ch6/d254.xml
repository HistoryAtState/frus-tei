    <text>
        <body>
            <div xml:id="d254">

                <pb facs="0534" n="486" sameAs="frus:frus1868p1/pg486"/>

                <head>Mr. Hunter to Mr. de
                        Stoeckl</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1868-08-03"><hi rendition="#italic"
                                >August</hi> 3, 1868.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to transmit herewith for
                    your information, and that of the government which you represent, a copy of an
                    instruction <pb facs="0535" n="487" xml:id="pg487"/> which, on the 14th of July,
                    was addressed by this department to the United States minister at Yeddo.<anchor
                        n="*" xml:id="d254-f1"/></p>
                <p>Accept, sir, a renewed assurance of my very high consideration.</p>
                <closer>
                    <signed>W. HUNTER, <hi rendition="#italic">Acting
                    Secretary.</hi></signed></closer>
                <postscript>
                    <p>Mr. <hi rendition="#small-caps">Edward de Stoeckl</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c.</hi>, <hi rendition="#italic"
                            >&amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d254-f1" n="*" xml:id="d254-f1-content">
                <p>For this inclosure, see correspondence with Japan.</p>
            </note>
        </listAnnotation>
    </standOff>
