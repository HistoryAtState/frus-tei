    <text>
        <body>
            <div xml:id="d247">

                <pb facs="0527" n="479" xml:id="pg479"/>

                <head>Captain Peslchouroff to General Rousseau</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">New Archangel,
                            Sitka</hi>,</placeName>
                        <date calendar="julian gregorian" when="1867-10-26"><hi rendition="#italic"
                                >October</hi> 14–26, 1867.</date></dateline></opener>
                <p><hi rendition="#small-caps">General</hi>: Referring to remark 2, at the foot of
                    inventory A, attached to the protocol of transfer, I beg leave to state, for the
                    information of the government of the United States, that the Russian American
                    Company value the chains, anchors, buoys, &amp;c., laid across the harbor at
                    this port, in the sum of $10,000 in gold.</p>
                <p>I am, general, your obedient, humble servant,</p>
                <closer>
                    <signed>A. PESTCHOUROFF.</signed></closer>
                <postscript>
                    <p>General <hi rendition="#small-caps">Lovell</hi> H. R<hi
                            rendition="#small-caps">ousseau</hi>, <hi rendition="#italic">United
                            States Commissioner, &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
