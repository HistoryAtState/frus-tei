    <text>
        <body>
            <div xml:id="d252">

                <pb facs="0534" n="486" xml:id="pg486"/>

                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <head>Mr. Stoeckl to Mr.
                        Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1868-06-29"><hi rendition="#italic"
                                >May</hi> 29, <hi rendition="#italic">June</hi> 10,
                        1868.</date></dateline></opener>
                <p>Mr. <hi rendition="#small-caps">Secretary:</hi> I hasten to inclose to you, for
                    the information of the federal government, the copy of a regulation, sanctioned
                    by his Majesty the Emperor, which completes one of the articles of the Russian
                    Code of Commerce.</p>
                <p>Please accept, Mr. Secretary of State, the assurance of my very high
                    consideration.</p>
                <closer>
                    <signed>STOECKL.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d252-a1.xml" xpointer="d252-a1"/>
