    <text>
        <body>
            <div xml:id="d233">

                <pb facs="0510" n="462" sameAs="frus:frus1868p1/pg462"/>

                <head>Mr. Clay to Mr. Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 171.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States, St.
                                Petersburg,</hi></placeName>
                        <date calendar="gregorian" when="1868-01-03"><hi rendition="#italic"
                                >January</hi> 3, 1868.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your dispatch No. 270 is received. I
                    inclose you a statement of the minister of the interior, Mr. Valouïoff, in
                    reference to schools, &amp;c., in Russia. I was asked for the information, I
                    believe, by one of the departments at Washington, or by the Smithsonian
                    Institute. Please forward copy of it to the proper party.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>C. M. CLAY.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D</hi>. <hi
                            rendition="#italic">C.</hi></p>
                </postscript>



                <xi:include href="d233-a1.xml" xpointer="d233-a1"/>
            </div>
        </body>
    </text>
