    <text>
        <body>
            <div xml:id="d240">

                <pb facs="0518" n="470" sameAs="frus:frus1868p1/pg470"/>

                <head>Mr. Clay to Mr. Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 199.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States, St.
                                Petersburg,</hi></placeName>
                        <date calendar="gregorian" when="1868-08-14"><hi rendition="#italic"
                                >August</hi> 14, 1868.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I herein inclose you a translation of the
                    note, from the French of Mr. de Westmann, acting minister of foreign affairs,
                    &amp;c., and a copy of my response in reference to the affair in the Sea of
                    Okhotsk.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>C. M. CLAY.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>



                <xi:include href="d240-a1.xml" xpointer="d240-a1"/>
