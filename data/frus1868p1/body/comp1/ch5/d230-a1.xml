    <text>
        <body>
            <div xml:id="d230-a1">

                <pb facs="0509" n="461" sameAs="frus:frus1868p1/pg461"/>

                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <head>Mr. Burlingame to Mr.
                        Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">United States Legation</hi>, <hi
                                rendition="#italic">Peking</hi>,</placeName>
                        <date calendar="gregorian" when="1867-11-23"><hi rendition="#italic"
                                >November</hi> 23, 1867.</date></dateline></opener>
                <p>Chinese empire appointed me envoy to treaty powers. Accepted. Leave at once for
                    San Francisco.</p>
                <closer>
                    <signed>ANSON BURLINGAME.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D. C., care of
                            Cassius M. Clay, Esq., &amp;c., &amp;c.</hi>, &amp;<hi
                            rendition="#italic">c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
