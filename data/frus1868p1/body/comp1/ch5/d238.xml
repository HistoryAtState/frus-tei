    <text>
        <body>
            <div xml:id="d238">

                <pb facs="0517" n="469" sameAs="frus:frus1868p1/pg469"/>

                <head>Mr. Clay to Mr. Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 183.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States, St.
                                Petersburg,</hi></placeName>
                        <date calendar="gregorian" when="1868-03-20"><hi rendition="#italic"
                                >March</hi> 20, 1868.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> To-day I received from Prince Gortchacow a
                    note of this date, in reference to the affairs of the Java, in the Sea of
                    Okhotsk. I inclose you a translation of the same from the French.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>C. M. CLAY.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>


                <xi:include href="d238-a1.xml" xpointer="d238-a1"/>
