    <text>
        <body>
            <div xml:id="d234">

                <pb facs="0513" n="465" sameAs="frus:frus1868p1/pg465"/>

                <head>Mr. Clay to Mr.
                        Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 175.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">St. Petersburg</hi></placeName>
                        <date calendar="gregorian" when="1868-01-18"><hi rendition="#italic"
                                >January</hi> 18, 1868.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I now transmit to you a copy of my note to
                    Prince Gortchacow in reference to the Okhotsk’s affair, marked A, and also a
                    copy of his reply, through the adjunct of the minister of foreign affairs to his
                    imperial Majesty, M. de Westmann, marked A B.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>C. M. CLAY.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi>
                    </p>
                </postscript>




                <xi:include href="d234-a1.xml" xpointer="d234-a1"/>
