    <text>
        <body>
            <div xml:id="d226">

                <pb facs="0504" n="456" sameAs="frus:frus1868p1/pg456"/>

                <head>Mr. Seward to Mr. Berthemy</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1868-06-10"><hi rendition="#italic"
                                >June</hi> 10, 1868.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Herewith I have the honor to inclose for
                    your information, and that of the government which you represent, a transcript
                    of the correspondence<anchor n="*" xml:id="d226-f1"/> relative to the recent
                    reception of the Chinese embassy by this government.</p>
                <p>Accept, sir, a renewed assurance of my very high consideration.</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p>M. <hi rendition="#small-caps">Berthemy</hi>, <hi rendition="#italic"
                            >&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d226-f1" n="*" xml:id="d226-f1-content">
                <p>For inclosure see correspondence with the Chinese embassy.</p>
            </note>
        </listAnnotation>
    </standOff>
