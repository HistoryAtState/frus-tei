    <text>
        <body>
            <div xml:id="d274">

                <pb facs="0576" n="528" sameAs="frus:frus1868p1/pg528"/>

                <head>Mr. Browne to Mr.
                        Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">San Francisco,
                            California</hi>,</placeName>
                        <date calendar="gregorian" when="1868-07-24"><hi rendition="#italic"
                                >July</hi> 24, 1868.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to transmit herewith a
                    copy of a letter from Mr. George Wilkes, director of the Lower California
                    Company, in relation to the proposed colonization, by Chinese, of the company’s
                    grants in Sonora and Lower California.</p>
                <p>A copy of my reply is also inclosed.</p>
                <p>Very respectfully, your obedient servant,</p>
                <closer>
                    <signed>J. ROSS BROWNE.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>



                <xi:include href="d274-a1.xml" xpointer="d274-a1"/>
