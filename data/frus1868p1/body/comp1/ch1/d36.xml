    <text>
        <body>
            <div xml:id="d36">

                <pb facs="0202" n="154" sameAs="frus:frus1868p1/pg154"/>

                <opener><seg rendition="#center">[Telegram per cable.]</seg></opener>
                <head>Mr. Adams to Mr.
                        Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">London,</hi></placeName>
                        <date calendar="gregorian" when="1868-02-18"><hi rendition="#italic"
                                >February</hi> 18, 1868.</date></dateline></opener>
                <p>Usual counsel engaged. No reply yet to dispatch 14th December.</p>
                <closer>
                    <signed>CHARLES FRANCIS ADAMS.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>
            </div>
        </body>
