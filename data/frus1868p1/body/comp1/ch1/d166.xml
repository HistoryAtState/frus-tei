    <text>
        <body>
            <div xml:id="d166">

                <pb facs="0447" n="399" sameAs="frus:frus1868p1/pg399"/>

                <opener><seg rendition="#center">[Telegram per cable.]</seg></opener>
                <head>Mr. Seward to Mr. Johnson</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1869-01-14"><hi rendition="#italic"
                                >January</hi> 14, 1869.</date></dateline></opener>
                <p>Give us at once dates of both conventions signed, so that we may complete copies
                    for the Senate.</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p>R<hi rendition="#small-caps">everdy Johnson,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
