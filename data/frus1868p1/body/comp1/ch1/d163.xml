    <text>
        <body>
            <div xml:id="d163">

                <pb facs="0447" n="399" xml:id="pg399"/>

                <opener><seg rendition="#center">[Telegram per cable.—Extract.]</seg></opener>
                <head>Mr. Johnson to Mr. Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">London</hi></placeName>, <date
                            calendar="gregorian" when="1869-01-12"><hi rendition="#italic"
                                >January</hi> 12, 1869.</date></dateline></opener>
                <p>Telegram received. Have since intelligence from Clarendon, and think all will be
                    right. * * * *</p>
                <closer>
                    <signed>REVERDY JOHNSON.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>
            </div>
        </body>
