    <text>
        <body>
            <div xml:id="d115">

                <pb facs="0405" n="357" sameAs="frus:frus1868p1/pg357"/>

                <opener><seg rendition="#center">[Telegram per cable.]</seg></opener>
                <head>Mr. Seward to Mr. Johnson</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1868-10-07"><hi rendition="#italic"
                                >October</hi> 7, 1868.</date></dateline></opener>
                <p>Your 20 received. See and adhere to my 20. Send protocol by cable, in cipher.</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Revedy Johnson,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
