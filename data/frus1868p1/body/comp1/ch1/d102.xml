    <text>
        <body>
            <div xml:id="d102">

                <pb facs="0395" n="347" sameAs="frus:frus1868p1/pg347"/>

                <head>Mr. Seward to Mr.
                        Johnson</head>
                <opener>
                    <seg rendition="#float-left">No. 6.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1868-08-25"><hi rendition="#italic"
                                >August</hi> 25, 1868.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Mr. Moran’s dispatch of the 4th of August,
                    No. 88, concerning affairs in Brazil, is received, and his proceedings are
                    approved.</p>
                <p>I give you herewith a copy of an instruction for Mr. Webb, which goes by cable
                    to-day.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Reverdy Johnson,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d102-a1.xml" xpointer="d102-a1"/>
            </div>
