    <text>
        <body>
            <div xml:id="d84-a1">

                <pb facs="0367" n="319" sameAs="frus:frus1868p1/pg319"/>

                <head>Fortieth Congress, Second Session–Congress of the United States.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">In the House of
                            Representatives,</hi></placeName>
                        <date calendar="gregorian" when="1868-06-15"><hi rendition="#italic"
                                >June</hi> 15, 1868.</date></dateline></opener>
                <p>On motion of Mr. Robinson,</p>
                <p><hi rendition="#italic">Resolved,</hi> That the President of the United States is
                    hereby requested by this House to take such measures as shall appear proper to
                    secure the release from imprisonment of Messrs. Warren and Costello, convicted
                    and sentenced in Great Britain for words and acts spoken and done in this
                    country, by ignoring our naturalization laws, and to take such other measures as
                    will secure their return to our flag, with such ceremonies as are appropriate to
                    the occasion.</p>
                <p>Attest:</p>
                <closer>
                    <signed>EWD. McPHERSON, <hi rendition="#italic">clerk.</hi>
                    </signed></closer>
            </div>
        </body>
    </text>
