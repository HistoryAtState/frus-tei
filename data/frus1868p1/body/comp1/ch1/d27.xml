    <text>
        <body>
            <div xml:id="d27">

                <pb facs="0197" n="149" sameAs="frus:frus1868p1/pg149"/>

                <head>Mr. Seward to Mr. Adams</head>
                <opener>
                    <seg rendition="#float-left">No. 2123.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1868-01-20"><hi rendition="#italic"
                                >January</hi> 20, 1868.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir: R</hi>eferring to my No. 2097 in regard to the
                    question pending between the governments of Great Britain and Nicaragau,
                    concerning the Musquito territory, I now inclose for your information a copy of
                    a dispatch<anchor n="*" xml:id="d27-f1"/> from the United States minister to
                    Nicaragua, containing the correspondence between Mr. Dickinson and the minister
                    for foreign affairs regarding the action which this government has taken in the
                    matter.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d27-f1" n="*" xml:id="d27-f1-content">
                <p>For inclosure dispatch No. 144, December 23, 1867, from the United States
                    minister to Nicaragua.</p>
            </note>
        </listAnnotation>
    </standOff>
