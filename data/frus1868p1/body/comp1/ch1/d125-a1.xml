    <text>
        <body>
            <div xml:id="d125-a1">

                <pb facs="0413" n="365" xml:id="pg365"/>

                <opener><seg rendition="#center">[Telegram per cable.]</seg></opener>
                <head>Mr. Johnson to Mr. Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">London,</hi></placeName>
                        <date calendar="gregorian" when="1868-10-27"><hi rendition="#italic"
                                >October</hi> 27, 1868.</date></dateline></opener>
                <p>Dispatch received. Will try to hasten claims convention.</p>
                <closer>
                    <signed>REVERDY JOHNSON.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>
            </div>
        </body>
