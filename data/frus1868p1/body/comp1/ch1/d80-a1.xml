            <div xml:id="d80-a1">

                <pb facs="0361" n="313" sameAs="frus:frus1868p1/pg313"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <p><hi rendition="#italic">Resolved by the Senate and House of Representatives of
                        the United States of America in Congress assembled,</hi> That in addition to
                    the number of copies of papers relating to foreign affairs now authorized by
                    law, there shall be printed for distribution by the Department of State, on fine
                    paper, with wide margin, a sufficient number of copies of the appendix to the
                    diplomatic correspondence of 1865 to supply one copy to each senator and each
                    representative of the thirty-ninth Congress, and to each foreign government, and
                    one copy to each corporation, association, or public body, whose expressions of
                    condolence or sympathy are published in said volume. One hundred of these copies
                    to be bound in full Turkey morocco, full gilt, and the remaining copies to be
                    bound in half Turkey morocco, marble edged.</p>
                <closer><dateline rendition="#float-left">Approved <date calendar="gregorian"
                            when="1867-03-02">March 2, 1867</date>.</dateline></closer>
            </div>
