    <text>
        <body>
            <div xml:id="d121">

                <pb facs="0411" n="363" sameAs="frus:frus1868p1/pg363"/>

                <opener><seg rendition="#center">[Telegram per cable.]</seg></opener>
                <head>Mr. Johnson to Mr. Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States,
                                London</hi></placeName>, <date calendar="gregorian"
                            when="1868-10-20"><hi rendition="#italic">October</hi> 20,
                        1868.</date></dateline></opener>
                <p>Can I sign convention for claims on basis of treaty of February, ’53?</p>
                <closer>
                    <signed>REVERDY JOHNSON.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>
            </div>
        </body>
