    <text>
        <body>
            <div xml:id="d63">

                <pb facs="0236" n="188" sameAs="frus:frus1868p1/pg188"/>

                <head>Mr. Seward to Mr. Adams</head>
                <opener>
                    <seg rendition="#float-left">No. 2154.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1868-04-10"><hi rendition="#italic"
                                >April</hi> 10, 1868.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your dispatches numbered 1553 to 1560 have
                    been received and are approved.</p>
                <pb facs="0237" n="189" xml:id="pg189"/>
                <p>The delay of the British government on the naturalization question, to which
                    reference is made in your No. 1558, is regretted.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
