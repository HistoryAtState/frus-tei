    <text>
        <body>
            <div xml:id="d124">

                <pb facs="0412" n="364" sameAs="frus:frus1868p1/pg364"/>

                <opener><seg rendition="#center">[Telegram per cable.]</seg></opener>
                <head>Mr. Seward to Mr.
                        Johnson</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1868-10-25"><hi rendition="#italic"
                                >October</hi> 25, 1868.</date></dateline></opener>
                <p>Naturalization protocol approved. Can you hasten claims convention?</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Reverdy Johnson,</hi> Esq<hi rendition="#italic"
                            >., &amp;c</hi>., <hi rendition="#italic">&amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
