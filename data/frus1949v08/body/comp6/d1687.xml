                <note rend="inline" type="source">125.937D/10–349: Circular telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to Certain Diplomatic and Consular Offices
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1949-10-03T01:00:00-05:00">October 3, 1949—1
                            a. m.</date>
                    </dateline>
                </opener>
                <p>Consulate Tihwa closed. All Amer personnel departed.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Webb</hi>
                    </signed>
                </closer>
            </div>
