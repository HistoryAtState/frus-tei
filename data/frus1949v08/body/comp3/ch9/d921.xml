            <div xml:id="d921">

                <pb facs="0790" n="780" sameAs="frus:frus1949v08/pg780"/>

                <note rend="inline" type="source">123 Clark, Lewis: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in China</hi> (<hi
                            rendition="#italic">Stuart</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Nanking</hi></placeName>, <date
                            calendar="gregorian" when="1949-07-11T12:00:00+08:00">July 11,
                            1949—noon</date>.<lb/>[Received July 11—2:11 a. m.]</dateline>
                </opener>
                <p>1472 I would appreciate if Department would instruct Lewis Clark to meet me
                    Okinawa for consultation on or about July 18.</p>
                <p>Sent Department; repeated OffEmb Canton 617.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stuart</hi>
                    </signed>
                </closer>
            </div>
        </body>
