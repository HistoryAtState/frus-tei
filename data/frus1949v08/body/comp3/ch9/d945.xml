    <text>
        <body>
            <div xml:id="d945">

                <pb facs="0804" n="794" sameAs="frus:frus1949v08/pg794"/>

                <note rend="inline" type="source">123 Stuart, J. Leighton: Telegram</note>
                <head>
                    <hi rendition="#italic">The Consul General at Peiping</hi> (<hi
                        rendition="#italic">Clubb</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Peiping</hi></placeName>, <date
                            calendar="gregorian" when="1949-07-21T09:00:00+08:00">July 21, 1949—9 a.
                            m.</date>
                        <lb/> [Received July 21—5:42 a. m.]</dateline>
                </opener>
                <p>1204. [To Nanking:] July 20, 2 p.m. ReContel 843, July 18.<anchor n="25"
                        xml:id="d945-f1"/> Joseph Chang informed me by phone last night message
                    delivered July 18; action unknown.</p>
                <pb facs="0805" n="795" xml:id="pg795"/>
                <p>Sent Nanking 853; repeated Department, Shanghai 813.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Clubb</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d945-f1" n="25" xml:id="d945-f1-content">
