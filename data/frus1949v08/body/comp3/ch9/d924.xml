                <pb facs="0791" n="781" sameAs="frus:frus1949v08/pg781"/>

                <note rend="inline" type="source">123 Stuart, J. Leighton: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in China</hi>
                        (<hi rendition="#italic">Stuart</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1949-07-12T18:00:00-04:00">July 12, 1949—6 p.
                            m.</date>
                    </dateline>
                </opener>
                <p>819. In accordance urtel 1475 Jul 11, you are authorized depart from Nanking on
                    Jul 18.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
