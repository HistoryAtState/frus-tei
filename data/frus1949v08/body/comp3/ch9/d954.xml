                <pb facs="0811" n="801" sameAs="frus:frus1949v08/pg801"/>

                <note rend="inline" type="source">123 Stuart, J. Leighton: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in China</hi> (<hi rendition="#italic"
                            >Stuart</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1949-07-24T12:00:00-04:00">July 24,
                            1949—noon</date>.</dateline>
                </opener>
                <p>876. Dept studying subject urtel 1603 July 24, which requires most careful
                    consideration. As it doubtful you will receive further instructions in time your
                    Monday meeting Huang Hua you may wish so inform him.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
