            </note>
            <note corresp="#d865-f2" n="6" xml:id="d865-f2-content">
                <p>People’s Liberation Army (Communist).</p>
            </note>
            <note corresp="#d865-f3" n="7" xml:id="d865-f3-content">
                <p>Kuomintang (Nationalist Party).</p>
            </note>
