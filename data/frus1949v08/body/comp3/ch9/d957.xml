    <text>
        <body>
            <div xml:id="d957">

                <pb facs="0812" n="802" sameAs="frus:frus1949v08/pg802"/>

                <note rend="inline" type="source">123 Stuart, J. Leighton: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in China</hi> (<hi rendition="#italic"
                        >Stuart</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Nanking</hi></placeName>, <date
                            calendar="gregorian" when="1949-07-27T11:00:00+08:00">July 27, 1949—11
                            a. m.</date>
                        <lb/> [Received July 27—12:03 a. m.]</dateline>
                </opener>
                <p>1629. Unless Embassy has reply to its telegram 1603, July 24, within 24 hours, is
                    doubtful that it will be possible to complete all arrangements <pb facs="0813"
                        n="803" xml:id="pg803"/> for departure of Ambassador and party prior to
                    deadline established in Deptel 875, July 23, repeated Canton telCan 490.<anchor
                        n="36" xml:id="d957-f1"/>
                </p>
                <p>Sent Department; repeated OffEmb Canton 682.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stuart</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d957-f1" n="36" xml:id="d957-f1-content">
                <p>Not printed; the deadline was August 1.</p>
            </note>
        </listAnnotation>
    </standOff>
