            <div xml:id="d969">

                <pb facs="0819" n="809" sameAs="frus:frus1949v08/pg809"/>

                <note rend="inline" type="source">123 Stuart, J. Leighton: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in China</hi> (<hi
                            rendition="#italic">Stuart</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Nanking</hi></placeName>, <date
                            calendar="gregorian" when="1949-08-02">August 2,
                        1949</date>.<lb/>[Received August 2—3:20 a. m.]</dateline>
                </opener>
                <p>1679. Relinquished charge and departed Nanking August 2, 1949 via Air Attaché
                    plane due Okinawa same day.</p>
                <p>Sent Department 1679; repeated all China posts circular.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stuart</hi>
                    </signed>
                </closer>
            </div>
        </body>
