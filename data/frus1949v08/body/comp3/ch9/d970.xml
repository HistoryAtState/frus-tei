            <div xml:id="d970">

                <pb facs="0819" n="809" sameAs="frus:frus1949v08/pg809"/>

                <note rend="inline" type="source">123 Jones, J. Wesley: Telegram</note>
                <head>
                    <hi rendition="#italic">The Counselor of Embassy in China</hi> (<hi rendition="#italic">Jones</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Nanking</hi></placeName>, <date
                            calendar="gregorian" when="1949-08-02">August 2,
                        1949</date>.<lb/>[Received August 2—1:24 a. m.]</dateline>
                </opener>
                <p>1680. I have assumed charge of the office of the American Embassy at Nanking as
                    of today, August 2, 1949.</p>
                <p>Sent Department, repeated circular to all China posts.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Jones</hi>
                    </signed>
                </closer>
            </div>
        </body>
