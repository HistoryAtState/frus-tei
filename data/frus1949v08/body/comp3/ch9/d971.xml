    <text>
        <body>
            <div xml:id="d971">

                <pb facs="0820" n="810" xml:id="pg810"/>

                <note rend="inline" type="source">123 [Stuart, J. Leighton]: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Chargé in China</hi> (<hi
                        rendition="#italic">Clark</hi>), <hi rendition="#italic">at Canton</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1949-08-02T14:00:00-04:00">August 2, 1949—2
                            p. m.</date>
                    </dateline>
                </opener>
                <p>TelCan 525. Dept this morning released to press statement previously transmitted
                    you re departure Ambassador.<anchor n="46" xml:id="d971-f1"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
