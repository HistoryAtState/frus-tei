    <text>
        <body>
            <div xml:id="d916">

                <pb facs="0779" n="769" sameAs="frus:frus1949v08/pg769"/>

                <note rend="inline" type="source">123 Stuart, J. Leighton: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in China</hi> (<hi rendition="#italic"
                            >Stuart</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1949-07-01T18:00:00-04:00">July 1, 1949—6 p.
                            m.</date>
                    </dateline>
                </opener>
                <p>775. Following highest level consideration urtel 1410,<anchor n="76"
                        xml:id="d916-f1"/> you are instructed under no circumstances to make visit
                    Peiping. Principal reasons for negative decision are those contained urtel.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
