    <text>
        <body>
            <div xml:id="d964">

                <pb facs="0817" n="807" sameAs="frus:frus1949v08/pg807"/>

                <note rend="inline" type="source">123 Stuart, J. Leighton: Telegram</note>
                <head>
                    <hi rendition="#italic">The Consul General at Taipei</hi> (<hi
                        rendition="#italic">Macdonald</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Taipei</hi></placeName>, <date
                            calendar="gregorian" when="1949-07-30T09:00:00+09:00">July 30, 1949—9 a.
                            m.</date>
                        <lb/> [Received 10:31 a. m.]</dateline>
                </opener>
                <p>335. Information urtel 70, July 29<anchor n="44" xml:id="d964-f1"/> given
                    personally General Chou Chi-jou who is issuing orders.</p>
                <p>Sent Nanking 190, repeated Department 335, Canton 146.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Macdonald</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d964-f1" n="44" xml:id="d964-f1-content">
                <p>Same as telegram No. 1644 from Nanking, <ref target="#pg804">p. 804</ref>.</p>
            </note>
