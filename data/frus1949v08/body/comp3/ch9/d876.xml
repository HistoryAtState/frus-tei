            <div xml:id="d876">

                <pb facs="0747" n="737" sameAs="frus:frus1949v08/pg737"/>

                <note rend="inline" type="source">124.936/5–349: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in China</hi> (<hi
                            rendition="#italic">Stuart</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Nanking</hi></placeName>, <date
                            calendar="gregorian" when="1949-05-03T14:00:00+08:00">May 3, 1949—2 p.
                            m.</date>
                        <lb/> [Received May 3—4:13 a. m.]</dateline>
                </opener>
                <p>923. Canadian Ambassador has asked that our recent telegrams on situation
                    Nanking, particularly with respect restrictions, attitude toward Diplomatic
                    Corps by new authorities, be shown to Canadian Embassy, Washington, for info his
                    Government.</p>
                <p>Sent Department 923; repeated Ottawa 1.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stuart</hi>
                    </signed>
                </closer>
            </div>
        </body>
