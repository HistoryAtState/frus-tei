    <text>
        <body>
            <div xml:id="d1001">

                <pb facs="0844" n="834" sameAs="frus:frus1949v08/pg834"/>

                <note rend="inline" type="source">123 Jones, J. Wesley: Telegram</note>
                <head>
                    <hi rendition="#italic">The Counselor of Embassy in China</hi> (<hi
                        rendition="#italic">Jones</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Nanking</hi></placeName>, <date
                            calendar="gregorian" when="1949-09-25">September 25,
                        1949</date>.<lb/>[Received September 30—1:30 a. m.]</dateline>
                </opener>
                <p>2172. China Post Circular. Embassy cirtel September 20, repeated Department
                        2140.<anchor n="89" xml:id="d1001-f1"/> Relinquished charge office Embassy
                    Nanking to Bacon today September 25, and depart China.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Jones</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
