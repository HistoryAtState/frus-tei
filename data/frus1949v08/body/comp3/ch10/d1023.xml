    <text>
        <body>
            <div xml:id="d1023">

                <pb facs="0860" n="850" sameAs="frus:frus1949v08/pg850"/>

                <note rend="inline" type="source">121.5493/11–1449: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Consul General at
                        Peiping</hi> (<hi rendition="#italic">Clubb</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>Washington,</placeName>
                        <date calendar="gregorian" when="1949-11-15T12:00:00-05:00">November 15,
                            1949—noon</date>.</dateline>
                </opener>
                <p>793. Re Embtel 396, Nov 14.<anchor n="15" xml:id="d1023-f1"/> If you perceive no
                    objection Pls file supplementary protest suggested Embtel 395, Nov 14.<anchor
                        n="16" xml:id="d1023-f2"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Webb</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1023-f1" n="15" xml:id="d1023-f1-content">
                <p>Same as telegram No. 2413 from Nanking, <ref target="#pg849">p. 849</ref>.</p>
            </note>
            <note corresp="#d1023-f2" n="16" xml:id="d1023-f2-content">
                <p>Same as telegram No. 2412 from Nanking, <ref target="#pg848">p. 848</ref>.</p>
            </note>
