    <text>
        <body>
            <div xml:id="d1073">

                <pb facs="0892" n="882" sameAs="frus:frus1949v08/pg882"/>

                <note rend="inline" type="source">123 Gleysteen, Culver: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Consul at Dairen</hi> (<hi rendition="#italic"
                            >Paddock</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1949-05-31T19:00:00-04:00">May 31, 1949—7 p.
                            m.</date>
                    </dateline>
                </opener>
                <p>72. Ur 162 May 28. Dept desires most specific info possible re fol points for use
                    in replying Sov note Gleysteen detention: (1) time of arrest, (2) name Sov Col
                    referred to ur 117 April 23 who knew Gleysteen.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Webb</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
