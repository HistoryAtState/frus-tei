                <pb facs="0942" n="932" sameAs="frus:frus1949v08/pg932"/>

                <note rend="inline" type="source">125.351/10–2649: Circular telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                            Certain Diplomatic and Consular Offices in
                            China
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1949-10-26T17:00:00-05:00">October 26, 1949—5
                            p. m.</date>
                    </dateline>
                </opener>
                <p>Consulate Dairen closed Oct 21. All Amer personnel departed.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
