            <div xml:id="d1078">

                <pb facs="0895" n="885" sameAs="frus:frus1949v08/pg885"/>

                <note rend="inline" type="source">123 Gleysteen, Culver: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in the Soviet Union</hi> (<hi rendition="#italic">Kohler</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Moscow</hi></placeName>, <date
                            calendar="gregorian" when="1949-06-09T17:00:00+03:00">June 9, 1949—5 p.
                            m.</date>
                        <lb/> [Received June 9—11:28 a. m.]</dateline>
                </opener>
                <p>1490. Note sent Foreign Office today re Gleysteen arrest accordance Department
                    instructions Deptel 409, June 2.</p>
                <p>Sent Departzment 1490, repeated Dairen 26, Nanking 65, Canton 31.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Kohler</hi>
                    </signed>
                </closer>
            </div>
        </body>
