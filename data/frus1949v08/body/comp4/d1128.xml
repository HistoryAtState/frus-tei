                <pb facs="0936" n="926" sameAs="frus:frus1949v08/pg926"/>

                <note rend="inline" type="source">125.351/10–349: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Consul at
                        Dairen</hi> (<hi rendition="#italic">Paddock</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1949-10-03T18:00:00-05:00">October 3, 1949—6
                            p. m.</date>
                    </dateline>
                </opener>
                <p>164. Assume you answering Hong Kong’s 788 to Dept Oct 3 re assurances
                    requested.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Webb</hi>
                    </signed>
                </closer>
            </div>
        </body>
