            <div xml:id="d1479">

                <pb facs="1172" n="1162" sameAs="frus:frus1949v08/pg1162"/>

                <note rend="inline" type="source">102.22/6–1049: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Consul General at Shanghai</hi> (<hi
                            rendition="#italic">Cabot</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1949-06-10T23:00:00-04:00">June 10, 1949—11
                            p. m.</date>
                    </dateline>
                </opener>
                <p>1172. Urtels 2153 June 8, 2205 Jun 10 sent by Navy to ComNavWesPac for
                    action.</p>
                <p>Keep Dept informed.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Webb</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
