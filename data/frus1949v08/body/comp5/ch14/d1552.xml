    <text>
        <body>
            <div xml:id="d1552">

                <pb facs="1235" n="1225" sameAs="frus:frus1949v08/pg1225"/>

                <note rend="inline" type="source">123 Olive, William M.: Telegram</note>
                <head>
                    <hi rendition="#italic">The Consul General at Shanghai</hi> (<hi
                        rendition="#italic">Cabot</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Shanghai</hi></placeName>, <date
                            calendar="gregorian" when="1949-07-12T15:00:00+08:00">July 12, 1949—3 p.
                            m.</date>
                        <lb/> [Received July 12—4:53 a. m.]</dateline>
                </opener>
                <p>2715. Deptel 1382, July 11, 5 p. m., Olive case. Before lodging further protest,
                    would appreciate urgent reply mytel 2684, July 10, 4 p. m., suggesting
                    possibility joint protest by Consular body.</p>
                <p>Sent Department, repeated Nanking 1521, Peiping 201.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Cabot</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
