    <text>
        <body>
            <div xml:id="d1618">

                <pb facs="1277" n="1267" sameAs="frus:frus1949v08/pg1267"/>

                <note rend="inline" type="source">893.918/8–549: Telegram</note>
                <head>
                    <hi rendition="#italic">The Consul General at Peiping</hi> (<hi
                        rendition="#italic">Clubb</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Peiping</hi></placeName>, <date
                            calendar="gregorian" when="1949-08-05T17:00:00+08:00">August 5, 1949—5
                            p. m.</date>
                        <lb/> [Received August 17—11:09 a. m.]</dateline>
                </opener>
                <p>1307. ReDeptel 499, July 28. Appropriate letter sent headquarters PLA under date
                    August 4.</p>
                <p>Copy by post.<anchor n="45" xml:id="d1618-f1"/>
                </p>
                <p>Sent Department, repeated Nanking 933, Shanghai 859.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Clubb</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
