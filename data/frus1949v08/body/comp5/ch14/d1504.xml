    <text>
        <body>
            <div xml:id="d1504">

                <pb facs="1190" n="1180" xml:id="pg1180"/>

                <note rend="inline" type="source">123 Colling, Guy Thomas: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in China</hi> (<hi rendition="#italic"
                        >Stuart</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Nanking</hi></placeName>, <date
                            calendar="gregorian" when="1949-06-24T16:00:00+08:00">June 24, 1949—4 p.
                            m.</date>
                        <lb/> [Received June 24—8:02 a. m.]</dateline>
                </opener>
                <p>1368. ReEmbtel 750, June 24.<anchor n="66" xml:id="d1504-f1"/> Delivered memo
                    this morning to Aliens Affairs Office accordance Deptel 727, June 22.<anchor
                        n="67" xml:id="d1504-f2"/> However, it was returned on grounds matter
                    outside jurisdiction this office and could only be handled by Shanghai Aliens
                    Affairs Office. Repeated Shanghai 758, Peiping 239.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stuart</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1504-f1" n="66" xml:id="d1504-f1-content">
                <p>Same as telegram No. 1360 from Nanking, <ref target="#pg1178">p. 1178</ref>.</p>
            </note>
            <note corresp="#d1504-f2" n="67" xml:id="d1504-f2-content">
                <p>Same as telegram No. 1259 to Shanghai, <ref target="#pg1175">p. 1175</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
