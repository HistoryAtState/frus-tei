    <text>
        <body>
            <div xml:id="d1542">

                <pb facs="1222" n="1212" sameAs="frus:frus1949v08/pg1212"/>

                <note rend="inline" type="source">123 Cabot, John M.: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Consul General at
                        Shanghai</hi> (<hi rendition="#italic">Cabot</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1949-07-08T20:00:00-04:00">July 8, 1949—8 p.
                            m.</date>
                    </dateline>
                </opener>
                <p>1374. Fol consideration urtel 2660, July 8, Dept approves ur return Washington on
                    consultation returning US on Attaché plane with Amb. Authorization this travel
                    contained Deptel 1355, July 7.<anchor n="6" xml:id="d1542-f1"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
