    <text>
        <body>
            <div xml:id="d1211">

                <pb facs="0988" n="978" sameAs="frus:frus1949v08/pg978"/>

                <note rend="inline" type="source">125.633/9–1549: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Consul General at
                        Peiping</hi> (<hi rendition="#italic">Clubb</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1949-09-16T20:00:00-04:00">September 16,
                            1949—8 p. m.</date>
                    </dateline>
                </opener>
                <p>641. Reurtels 1542 and 1549 Sept 14 and 15.<anchor n="89" xml:id="d1211-f1"/>
                    Press release issued<anchor n="90" xml:id="d1211-f2"/> Deptel 634 rptd Nanking
                    1100 Sept 15.</p>
                <pb facs="0989" n="979" xml:id="pg979"/>
                <p>You are authorized send letter to Chu in ur discretion. Send Dept complete text
                    such letter if and when sent for Dept’s use in press release if deemed desirable
                    at time.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
