    <text>
        <body>
            <div xml:id="d1290">

                <pb facs="1051" n="1041" sameAs="frus:frus1949v08/pg1041"/>

                <note rend="inline" type="source">123 Ward, Angus I.: Telegram</note>
                <head>
                    <hi rendition="#italic">The Consul General at Peiping</hi> (<hi rendition="#italic">Clubb</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Peiping</hi></placeName>, <date
                            calendar="gregorian" when="1949-12-06">December 6,
                        1949</date>.<lb/>[Received December 5—10:03 p. m.]</dateline>
                </opener>
                <p>2208. Mukden informed by phone today Ward party scheduled leave Mukden 0345 hours
                    December 7.</p>
                <p>Sent Department 2208, repeated AmPolAd Tokyo, Shanghai 1271, Nanking 1218, Taipei
                    48, Tientsin by phone and mail.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Clubb</hi>
                    </signed>
                </closer>
            </div>
        </body>
