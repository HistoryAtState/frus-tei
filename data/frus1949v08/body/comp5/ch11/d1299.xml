                <pb facs="1060" n="1050" sameAs="frus:frus1949v08/pg1050"/>

                <note rend="inline" type="source">125.633/12–1349: Telegram</note>
                <head>
                    <hi rendition="#italic">The Consul at Tientsin</hi> (<hi rendition="#italic"
                        >Wellborn</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Tientsin</hi></placeName>, <date
                            calendar="gregorian" when="1949-12-13">December 13,
                        1949</date>.<lb/>[Received December 15—12:44 a. m.]</dateline>
                </opener>
                <p>1047. From Ward. “Consulate General Mukden declared closed on December 8 at 0800
                    hours upon my departure from Consular District through Shanhaikuan.”</p>
                <p>Sent Department 1047; repeated Peiping by mail 332. [Ward.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wellborn</hi>
                    </signed>
                </closer>
            </div>
        </body>
