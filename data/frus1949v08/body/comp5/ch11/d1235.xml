            </note>
            <note corresp="#d1235-f2" n="36a" xml:id="d1235-f2-content">
                <p>Not sent; for text, see <ref target="#pg981">p. 981</ref>.</p>
            </note>
            <note corresp="#d1235-f3" n="37" xml:id="d1235-f3-content">
                <p>Not transmitted to the Department.</p>
            </note>
            <note corresp="#d1235-f4" n="37" xml:id="d1235-f4-content">
