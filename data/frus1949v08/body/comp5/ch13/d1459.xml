    <text>
        <body>
            <div xml:id="d1459">

                <pb facs="1161" n="1151" xml:id="pg1151"/>

                <note rend="inline" type="source">125.953/11–749: Telegram</note>
                <head>
                    <hi rendition="#italic">The Consul at Tsingtao</hi> (<hi
                            rendition="#italic">Hawthorne</hi>) <hi rendition="#italic"
                        >to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Tsingtao</hi></placeName>, <date
                            calendar="gregorian" when="1949-11-07">November 7, 1949.</date>
                        <lb/> [Received November 7—3:12 a. m.]</dateline>
                </opener>
                <p>605. ReDeptel 333, November 4.<anchor n="21" xml:id="d1459-f1"/> Consulate
                    General officially closed and final accounts submitted as of October 15. Funds
                    may be remitted through New York office Hong Kong and Shanghai Banking
                    Corporation.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hawthorne</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
