                <pb facs="1156" n="1146" sameAs="frus:frus1949v08/pg1146"/>

                <note rend="inline" type="source">125.4556/9–3049: Telegram</note>
                <head>
                    <hi rendition="#italic">The Consul General at Hankow</hi> (<hi
                        rendition="#italic">Callanan</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Hankow</hi></placeName>, <date
                            calendar="gregorian" when="1949-09-30">September 30, 1949.</date>
                        <lb/> [Received September 30—8:39 a. m]</dateline>
                </opener>
                <p>363. This is last message, transmitter and receiver closing down today. ConGen
                    closing October 1. Department please inform all China posts.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Callanan</hi>
                    </signed>
                </closer>
            </div>
        </body>
