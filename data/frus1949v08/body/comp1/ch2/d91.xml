    <text>
        <body>
            <div xml:id="d91">

                <pb facs="0087" n="77" sameAs="frus:frus1949v08/pg77"/>

                <note rend="inline" type="source">893.00/1–2349: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in China</hi> (<hi
                            rendition="#italic">Stuart</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Nanking</hi></placeName>, <date
                            calendar="gregorian" when="1949-01-23">January 23,
                        1949</date>.<lb/>[Received January 23—5:10 a. m.]</dateline>
                </opener>
                <p>196. Following delegation selected to talk peace with Communists: Chang
                        Chih-chung,<anchor n="43" xml:id="d91-f1"/> Shao Li-tzu,<anchor n="44"
                        xml:id="d91-f2"/> Huang Shao-hsiung,<anchor n="45" xml:id="d91-f3"/> Chung
                        Tien-hsin,<anchor n="46" xml:id="d91-f4"/> Peng Chao-hsien.<anchor n="47"
                        xml:id="d91-f5"/> This group will broadcast their intentions to Communists
                    probably today, January 23, and ask where and when conference can be
                    arranged.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stuart</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d91-f1" n="43" xml:id="d91-f1-content">
                <p>Military and Political Affairs Director for Northwest China and Government
                    representative during 1946 negotiations with the Chinese Communist Party.</p>
            </note>
            <note corresp="#d91-f2" n="44" xml:id="d91-f2-content">
                <p>Member of the Kuomintang Central Executive Committee; Chinese Ambassador in the
                    Soviet Union, 1939–42.</p>
            </note>
            <note corresp="#d91-f3" n="45" xml:id="d91-f3-content">
                <p>Member of the Chinese Legislative Yuan.</p>
            </note>
            <note corresp="#d91-f4" n="46" xml:id="d91-f4-content">
                <p>Chinese Minister for Water Conservancy.</p>
            </note>
            <note corresp="#d91-f5" n="47" xml:id="d91-f5-content">
                <p>Chinese Minister of Interior.</p>
            </note>
        </listAnnotation>
    </standOff>
