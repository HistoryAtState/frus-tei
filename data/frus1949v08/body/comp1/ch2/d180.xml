            </note>
            <note corresp="#d180-f2" n="72" xml:id="d180-f2-content">
                <p>Representing various groups cooperating with the Communists.</p>
            </note>
            <note corresp="#d180-f3" n="73" xml:id="d180-f3-content">
                <p>Communist military or civilian officials.</p>
            </note>
        </listAnnotation>
