            <div xml:id="d58">

                <pb facs="0060" n="50" sameAs="frus:frus1949v08/pg50"/>

                <note rend="inline" type="source">893.00/1–1549: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in France</hi> (<hi
                            rendition="#italic">Caffery</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi></placeName>, [<date
                            ana="#date_undated-inferred-from-document-content-and-sibling-dates"
                            calendar="gregorian" when="1949-01-15">undated</date>].<lb/>[Received
                        January 15, 1949—3:33 a. m.]</dateline>
                </opener>
                <p>184. Chauvel tells me he has instructed French Ambassador in Nanking to give
                    orally negative reply to Chinese.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Caffery</hi>
                    </signed>
                </closer>
            </div>
        </body>
