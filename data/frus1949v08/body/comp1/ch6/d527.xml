    <text>
        <body>
            <div xml:id="d527">

                <pb facs="0472" n="462" sameAs="frus:frus1949v08/pg462"/>

                <note rend="inline" type="source">893.00/7–2749: Telegram</note>
                <head>
                    <hi rendition="#italic">The Consul General at Hong Kong</hi> (<hi
                        rendition="#italic">Hopper</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Hong Kong</hi></placeName>, <date
                            calendar="gregorian" when="1949-07-27T16:00:00+09:00">July 27, 1949—4 p.
                            m.</date>
                        <lb/> [Received July 27—9:38 a. m.]</dateline>
                </opener>
                <p>503. Appropriate parts Deptel 635<anchor n="49" xml:id="d527-f1"/> passed to
                    persons concerned who express agreement therewith, stressing their concern
                    Department aware their existence and plans. See further Hong Kong telegram July
                    27, pouched Canton EmbOff for relay Department.<anchor n="50" xml:id="d527-f2"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hopper</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
