    <text>
        <body>
            <div xml:id="d226">

                <pb facs="0200" n="190" xml:id="pg190"/>

                <note rend="inline" type="source">893.00/3–2249: Telegram</note>
                <head>
                    <hi rendition="#italic">The Consul General at Shanghai</hi> (<hi
                        rendition="#italic">Cabot</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Shanghai</hi></placeName>, <date
                            calendar="gregorian" when="1949-03-22">March 22,
                        1949</date>.<lb/>[Received March 22—3:37 a. m.]</dateline>
                </opener>
                <p>965. Local press 21 and 22 features story on bombing of <hi rendition="#italic"
                        >Chungking</hi><anchor n="31" xml:id="d226-f1"/> at Hulutao by Nationalist
                    planes [March] 18 and 19, publishing today’s issue official AF photo showing
                    ship, alleged to be <hi rendition="#italic">Chungking</hi>, lying on side.</p>
                <p>Sent Nanking 566; repeated Department 965, Canton 189.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Cabot</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d226-f1" n="31" xml:id="d226-f1-content">
                <p>Chinese cruiser which deserted to Communists.</p>
            </note>
        </listAnnotation>
    </standOff>
