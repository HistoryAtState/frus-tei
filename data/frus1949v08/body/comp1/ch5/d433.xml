    <text>
        <body>
            <div xml:id="d433">

                <pb facs="0377" n="367" xml:id="pg367"/>

                <note rend="inline" type="source">893.00/6–449: Telegram</note>
                <head>
                    <hi rendition="#italic">The Consul General at Hankow</hi> (<hi rendition="#italic">Callanan</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Hankow</hi></placeName>, <date
                            calendar="gregorian" when="1949-06-04T12:00:00+08:00">June 4,
                            1949—noon</date>.<lb/>[Received June 4—4:57 a. m.]</dateline>
                </opener>
                <p>171. Changsha reported evacuated by General Pai<anchor n="87" xml:id="d433-f1"/>
                    June 2.</p>
                <p>Sent Department, repeated Nanking 131, OffEmb Canton 78.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Callanan</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d433-f1" n="87" xml:id="d433-f1-content">
                <p>Pai Clung-hsi, Military and Political Affairs Director for Central China.</p>
            </note>
        </listAnnotation>
    </standOff>
