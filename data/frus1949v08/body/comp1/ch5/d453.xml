    <text>
        <body>
            <div xml:id="d453">

                <pb facs="0392" n="382" sameAs="frus:frus1949v08/pg382"/>

                <note rend="inline" type="source">893.002/6–1349: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister-Counselor of Embassy in China</hi>
                        (<hi rendition="#italic">Clark</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Canton</hi></placeName>, <date
                            calendar="gregorian" when="1949-06-13">June 13,
                        1949</date>.<lb/>[Received June 13—3:38 p. m.]</dateline>
                </opener>
                <p>Cantel 579. Following complete list Yen Hsi-shan Cabinet announced Saturday June
                    11.</p>
                <p rendition="#flush">Vice President Executive Yuan—Chu Chia-hua.<anchor n="15"
                        xml:id="d453-f1"/>
                </p>
                <p rendition="#flush">Secretary General Executive Yuan—Chia Ching-teh.<anchor n="16"
                        xml:id="d453-f2"/>
                </p>
                <p rendition="#flush">Ministers,</p>
                <list>
                    <item>National Defense—Yen Hsi-shan concurrently;</item>
                    <item>Foreign Affairs—Hu Shih;<anchor n="17" xml:id="d453-f3"/>
                    </item>
                    <item>Interior—Li Han-hun;<anchor n="18" xml:id="d453-f4"/>
                    </item>
                    <item>Finance—Hsu Kan;</item>
                    <item>Communications—Tuan Mu-chieh;<anchor n="19" xml:id="d453-f5"/>
                    </item>
                    <item>Economic Affairs—Liu Hang-shen;<anchor n="20" xml:id="d453-f6"/>
                    </item>
                    <item>Education—Han Li-wu;<anchor n="21" xml:id="d453-f7"/>
                    </item>
                    <item>Justice—Chang Shih-pen;<anchor n="22" xml:id="d453-f8"/>
                    </item>
                </list>
                <p rendition="#flush">Commissions—</p>
                <list>
                    <item>Mongolian-Tibetan Affairs—Kuan Chi-yu;<anchor n="23" xml:id="d453-f9"/>
                    </item>
                    <item>Overseas Chinese Affairs—Tai Kuei-sheng;<anchor n="24" xml:id="d453-f10"/>
                    </item>
                </list>
                <p rendition="#flush">Ministers without Portfolio: <list>
                        <item>Chen Li-fu,</item>
                        <item>Chang Chun<anchor n="25" xml:id="d453-f11"/> (resigned June 12)</item>
                        <item>Wu Tieh-cheng,<anchor n="26" xml:id="d453-f12"/>
                        </item>
                        <pb facs="0393" n="383" xml:id="pg383"/>
                        <item>Huang Shao-ku,<anchor n="27" xml:id="d453-f13"/>
                        </item>
                        <item>Hu Yung-chang,<anchor n="28" xml:id="d453-f14"/>
                        </item>
                        <item>Wang Shih-tien (Young China Party).</item>
                    </list>
                </p>
                <p>Dept pass VOANY.<anchor n="29" xml:id="d453-f15"/>
                </p>
                <p>Sent Dept Cantel 579, repeated Nanking 387, Shanghai 328.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Clark</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d453-f1" n="15" xml:id="d453-f1-content">
                <p>Chinese Minister of Education, 1944–48.</p>
            </note>
            <note corresp="#d453-f2" n="16" xml:id="d453-f2-content">
                <p>Vice President of the Chinese Examination Yuan, 1948–49.</p>
            </note>
            <note corresp="#d453-f3" n="17" xml:id="d453-f3-content">
                <p>Chinese Ambassador to the United States, 1938–42.</p>
            </note>
            <note corresp="#d453-f4" n="18" xml:id="d453-f4-content">
                <p>Governor of Kwangtung, 1938–45.</p>
            </note>
            <note corresp="#d453-f5" n="19" xml:id="d453-f5-content">
                <p>Secretary-general of the Chinese Judicial Yuan.</p>
            </note>
            <note corresp="#d453-f6" n="20" xml:id="d453-f6-content">
                <p>Former Chinese Vice Minister of Food.</p>
            </note>
            <note corresp="#d453-f7" n="21" xml:id="d453-f7-content">
                <p>Chinese Vice Minister of Education.</p>
            </note>
            <note corresp="#d453-f8" n="22" xml:id="d453-f8-content">
                <p>Grand Justice of the Chinese Judicial Yuan.</p>
            </note>
            <note corresp="#d453-f9" n="23" xml:id="d453-f9-content">
                <p>Chinese Minister of Food.</p>
            </note>
            <note corresp="#d453-f10" n="24" xml:id="d453-f10-content">
                <p>Chinese Vice Minister of the Kuomintang Board of Overseas Affairs.</p>
            </note>
            <note corresp="#d453-f11" n="25" xml:id="d453-f11-content">
                <p>President of the Chinese Executive Yuan, 1947–48; Military and Political Affairs
                    Director for Southwest China.</p>
            </note>
            <note corresp="#d453-f12" n="26" xml:id="d453-f12-content">
                <p>Vice President of the Chinese Executive Yuan, 1948–49.</p>
            </note>
            <note corresp="#d453-f13" n="27" xml:id="d453-f13-content">
                <p>Chinese Acting Minister of the Kuomintang Ministry of Information.</p>
            </note>
            <note corresp="#d453-f14" n="28" xml:id="d453-f14-content">
                <p>Chinese Minister of National Defense.</p>
            </note>
            <note corresp="#d453-f15" n="29" xml:id="d453-f15-content">
                <p>Voice of America, New York.</p>
            </note>
        </listAnnotation>
    </standOff>
