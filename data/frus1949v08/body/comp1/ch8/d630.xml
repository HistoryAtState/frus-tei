    <text>
        <body>
            <div xml:id="d630">

                <pb facs="0564" n="554" sameAs="frus:frus1949v08/pg554"/>

                <note rend="inline" type="source">893.20/10–1949: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in China</hi> (<hi rendition="#italic"
                        >Strong</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Chungking</hi></placeName>, <date
                            calendar="gregorian" when="1949-10-19T16:00:00+07:00">October 19, 1949—4
                            p. m.</date>
                        <lb/> [Received October 19—7:09 a. m.]</dateline>
                </opener>
                <p>Cantel 1213. At private dinner early October, Vice Admiral Kwei Yung-ching stated
                    intention strongly hold Chinmen Tao<anchor n="17" xml:id="d630-f1"/> off Amoy as
                    means interdicting activity there connection invasion of Taiwan.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Strong</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d630-f1" n="17" xml:id="d630-f1-content">
                <p>Quemoy Island.</p>
            </note>
        </listAnnotation>
    </standOff>
