            </note>
            <note corresp="#d623-f2" n="9" xml:id="d623-f2-content">
                <p>October 10, 1911, beginning of the Chinese Revolution.</p>
            </note>
            <note corresp="#d623-f3" n="10" xml:id="d623-f3-content">
                <p>George Kung-chao Yen.</p>
            </note>
