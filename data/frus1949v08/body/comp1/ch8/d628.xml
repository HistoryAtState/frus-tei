    <text>
        <body>
            <div xml:id="d628">

                <pb facs="0562" n="552" sameAs="frus:frus1949v08/pg552"/>

                <note rend="inline" type="source">893.00B/10–1749: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Consul General at Peiping</hi> (<hi rendition="#italic"
                            >Clubb</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1949-10-17T15:00:00-05:00">October 17, 1949—3
                            p. m.</date>
                    </dateline>
                </opener>
                <p>718. Dept desires clarification composition of CCP<anchor n="12" xml:id="d628-f1"
                    /> Politburo. Presently accepts fol[lowing] as correct: Mao Tse-tung, Chu Te,
                    Chou En-lai, Liu Shao-chi, Jen Pi-shih, Kao Kang, Peng Chen, Chen Yun, Peng
                    Te-huai, Lin Tsu-han, Tung Pi-wu, Kang Sheng. Various sources also list Wang
                    Chia-hsiang, Chen Shao-yu, Chang Wen-tien, Li Fu-chun, Li Wei-han, Wu
                    Liang-ping. Pls comment.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d628-f1" n="12" xml:id="d628-f1-content">
                <p>Chinese Communist Party.</p>
            </note>
        </listAnnotation>
    </standOff>
