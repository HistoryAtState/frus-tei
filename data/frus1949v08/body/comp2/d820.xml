    <text>
        <body>
            <div xml:id="d820">

                <pb facs="0715" n="705" sameAs="frus:frus1949v08/pg705"/>

                <note rend="inline" type="source">701.4193/7–2149: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister-Counselor of Embassy in China</hi> (<hi
                        rendition="#italic">Clark</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Canton</hi></placeName>, <date
                            calendar="gregorian" when="1949-07-21T20:00:00+08:00">July 21, 1949—8 p.
                            m.</date>
                        <lb/> [Received July 22—2:27 p. m.]</dateline>
                </opener>
                <p>Cantel 796. British here inform me decision definitely taken have diplomatic
                    representation Chungking through Consul General with full capacity First
                    Secretary.</p>
                <p>Sent Department Cantel 796, repeated Nanking 529.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Clark</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
