    <text>
        <body>
            <div xml:id="d842">

                <pb facs="0726" n="716" xml:id="pg716"/>

                <note rend="inline" type="source">123 Rinden, Robert W.: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in China</hi> (<hi
                            rendition="#italic">Strong</hi>) <hi rendition="#italic">to
                        the Secretary of state
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Chungking</hi></placeName>, <date
                            calendar="gregorian" when="1949-10-18">October 18,
                        1949</date>.<lb/>[Received October 18—3:45 a. m.]</dateline>
                </opener>
                <p>Cantel 1210. Rinden,<anchor n="83" xml:id="d842-f1"/> Norton<anchor n="84"
                        xml:id="d842-f2"/> and Strong arrived Chungking October 17, recommencing
                    office functions today.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Strong</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d842-f1" n="83" xml:id="d842-f1-content">
                <p>Robert W. Rinden, appointed Consul at Batavia, on temporary detail to
                    Chungking.</p>
            </note>
            <note corresp="#d842-f2" n="84" xml:id="d842-f2-content">
                <p>Lawrence H. Norton, communications supervisor of the Embassy Office in China.</p>
            </note>
        </listAnnotation>
    </standOff>
