    <text>
        <body>
            <div xml:id="d745">

                <pb facs="0666" n="656" sameAs="frus:frus1949v08/pg656"/>

                <note rend="inline" type="source">893.01/1–1949: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in China</hi> (<hi rendition="#italic"
                        >Stuart</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Nanking</hi></placeName>, <date
                            calendar="gregorian" when="1949-01-19T11:00:00+08:00">January 19,
                            1949—11 a. m.</date>
                        <lb/> [Received January 19—1:25 a. m.]</dateline>
                </opener>
                <p>143. Officially notified by Chief Protocol, Foreign Office, that National
                    Government is moving Canton beginning January 21 and have been officially
                    requested to follow Government Canton. Further details with our recommendations
                    will follow.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stuart</hi>
                    </signed>
                </closer>
            </div>
        </body>
