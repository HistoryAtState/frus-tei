            <div xml:id="d841">

                <pb facs="0725" n="715" sameAs="frus:frus1949v08/pg715"/>

                <note rend="inline" type="source">124.93/10–1249: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in China</hi> (<hi
                            rendition="#italic">Strong</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Hong Kong</hi></placeName>, <date
                            calendar="gregorian" when="1949-10-12">October 12,
                        1949</date>.<lb/>[Received October 12—6:03 a. m.]</dateline>
                </opener>
                <p>Cantel 1192. All Embassy staff safely out of Canton and now at Hong Kong.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Strong</hi>
                    </signed>
                </closer>
            </div>
        </body>
