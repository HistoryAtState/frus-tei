                <pb facs="1373" n="1359" xml:id="pg1359"/>

                <note rend="inline" type="source">694.001/12–850</note>
                <head>
                    <hi rendition="#italic">Memorandum by the Consultant to the Secretary</hi> (<hi
                        rendition="#italic">Dulles</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1950-12-08">December 8, 1950</date>.</dateline>
                </opener>
                <p>I am attaching a memorandum on Japan prepared with the concurrence of Mr. Allison
                    and Colonel Babcock.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">John Foster Dulles</hi>
                    </signed>
                </closer>


