    <text>
        <body>
            <div xml:id="d689">

                <pb facs="1131" n="1117" xml:id="pg1117"/>

                <note rend="inline" type="source">694.001/1–1850</note>
                <head>
                    <hi rendition="#italic">Memorandum by the Assistant Secretary of State for Far
                        Eastern Affairs</hi> (<hi rendition="#italic"
                            >Butterworth</hi>)<anchor n="1" xml:id="d689-f1"/>
                    <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1950-01-18">January 18, 1950</date>.</dateline>
                </opener>
                <p rendition="#flush">Subject: Japanese Peace Settlement</p>
                <p>Attached for your consideration are the following memoranda: <list>
                        <item>Tab A. Outline for Meeting with you on Japanese peace
                            settlement.</item>
                        <item>Tab B. Course of Action with Respect to Japanese Peace
                                Settlement.<anchor n="2" xml:id="d689-f2"/>
                        </item>
                        <item>Tab C. Procedure for Reaching Agreement within U.S. Government
                            Concerning Japanese Peace Settlement.<anchor n="3" xml:id="d689-f3"/>
                        </item>
                        <item>Tab D. Analysis of JCS decision that a
                            peace treaty is premature.<anchor n="4" xml:id="d689-f4"/>
                        </item>
                        <item>Tab E. Memorandum from Mr. Perkins to Mr. Butterworth on Soviet
                            Exclusion from Japanese Treaty.<anchor n="5" xml:id="d689-f5"/>
                        </item>
                    </list>
                </p>
                <p>Mr. Fisher<anchor n="6" xml:id="d689-f6"/> is submitting to you separately his
                    opinion on the legal aspects of the problems involved.<anchor n="7"
                        xml:id="d689-f7"/>
                </p>





                <xi:include href="d689-a1.xml" xpointer="d689-a1"/>
                <xi:include href="d689-a2.xml" xpointer="d689-a2"/>
                <xi:include href="d689-a3.xml" xpointer="d689-a3"/>
                <xi:include href="d689-a4.xml" xpointer="d689-a4"/>
            </div>
