    <text>
        <body>
            <div xml:id="d714">

                <pb facs="1208" n="1194" sameAs="frus:frus1950v06/pg1194"/>

                <note rend="inline" type="source">694.001/5–1250</note>
                <head>
                    <hi rendition="#italic">The Special Assistant to the Under Secretary of the
                        Army</hi> (<hi rendition="#italic">Reid</hi>) <hi rendition="#italic">to the
                        Assistant Secretary of State</hi> (<hi rendition="#italic"
                    >Butterworth</hi>)</head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1950-05-10">10 May 1950</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Butterworth</hi>: The attached summary of a
                    recent conversation with Mr. Ikeda Hayato<anchor n="1" xml:id="d714-f1"/> is
                    forwarded at the request of Mr. Joseph M. Dodge.<anchor n="2" xml:id="d714-f2"/>
                </p>
                <p>Sincerely,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Ralph</hi> W. E. <hi rendition="#small-caps"
                            >Reid</hi>
                    </signed>
                </closer>


                <xi:include href="d714-a1.xml" xpointer="d714-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d714-f1" n="1" xml:id="d714-f1-content">
                <p>Finance Minister of Japan.</p>
            </note>
            <note corresp="#d714-f2" n="2" xml:id="d714-f2-content">
                <p>Financial Adviser to the Supreme Commander and Fiscal Adviser to the Under
                    Secretary of the Army.</p>
            </note>
        </listAnnotation>
    </standOff>
