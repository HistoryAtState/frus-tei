    <text>
        <body>
            <div xml:id="d709">

                <pb facs="1196" n="1182" sameAs="frus:frus1950v06/pg1182"/>

                <note rend="inline" type="source">694.001/4–2650</note>
                <head>
                    <hi rendition="#italic">Memorandum by the Director of the Office of Northeast
                        Asian Affairs</hi> (<hi rendition="#italic">Allison</hi>) <hi
                        rendition="#italic">to the Consultant to the Secretary</hi> (<hi
                        rendition="#italic">Dulles</hi>)</head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1950-04-26">April 26, 1950</date>.</dateline>
                </opener>
                <p rendition="#flush">Subject: Background paper on Japan.</p>
                <p>There is attached the first of several background papers on various aspects of
                    United States policy toward Japan which this office has in preparation. It is
                    believed that this particular paper will be of special interest to you in
                    connection with your consideration of matters affecting a possible Japanese
                    peace treaty.</p>


                <xi:include href="d709-a1.xml" xpointer="d709-a1"/>
            </div>
