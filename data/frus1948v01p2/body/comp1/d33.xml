    <text>
        <body>
            <div xml:id="d33">

                <pb facs="0112" n="602" sameAs="frus:frus1948v01p2/pg602"/>

                <note rend="inline" type="source">811.24500/8–748</note>
                <head>
                    <hi rendition="#italic">The Secretary of Defense</hi> (<hi rendition="#italic"
                        >Forrestal</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1948-08-07">7 August 1948</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Secretary</hi>: In response to your
                    suggestion that a review of the negotiations for base rights at this time would
                    be appropriate,<anchor n="1" xml:id="d33-f1"/> I referred the matter to the
                    Joint Chiefs of Staff for comment and recommendation.</p>
                <p>The views of the Joint Chiefs of Staff are set forth in the enclosure which
                    incorporates the changes contained in recent planning.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Forrestal</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d33-f1" n="1" xml:id="d33-f1-content">
                <p>The suggestion under reference has not been further identified.</p>
            </note>
        </listAnnotation>
    </standOff>
