    <text>
        <body>
            <div xml:id="d9-a1">

                <pb facs="0053" n="543" sameAs="frus:frus1948v01p2/pg543"/>

                <opener>
                    <seg rendition="#center">[Annex]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">Mr. John Foster Dulles
                        to the Director of the Office of United Nations Affairs</hi> (<hi rendition="#italic">Rusk</hi>)</head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">confidential</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">New York</hi></placeName>, <date
                            calendar="gregorian" when="1948-03-24">March 24, 1948</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Dean</hi>: I enclose herewith two copies of a
                    memorandum on which I hope to speak to you on the telephone later this
                    evening.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">John Foster Dulles</hi>
                    </signed>
                </closer>
            </div>
        </body>
