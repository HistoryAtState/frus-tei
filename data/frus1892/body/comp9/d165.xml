                <pb facs="0310" n="222" xml:id="pg222"/>

                <head><hi rendition="#italic">Mr. Lincoln to Mr. Blaine.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1891-07-03"><hi rendition="#italic">July 3, 1891</hi></date>.
                        (Received July 14.)</dateline>
                    <seg rendition="#float-left">No. 488.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge receipt of
                    the Department’s cablegram of the 1st instant, as follows: “Copyright
                    proclamation today includes British subjects,” and to inclose the copy of a note
                    which I thereupon addressed to the Marquis of Salisbury on the subject.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Robert T.
                    Lincoln.</hi></signed></closer>


                <xi:include href="d165-a1.xml" xpointer="d165-a1"/>
