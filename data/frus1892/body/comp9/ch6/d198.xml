    <text>
        <body>
            <div xml:id="d198">

                <pb facs="0345" n="257" sameAs="frus:frus1892/pg257"/>

                <head><hi rendition="#italic">Mr. Blaine to Sir Julian Pauncefote.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1891-11-30"><hi rendition="#italic">November 30,
                        1891</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of the 25th instant, asking that the port authorities at Boston may
                    be instructed to take charge of immigrants who are not allowed to remain in this
                    country until the ship bringing them is ready for sea.</p>
                <p>I take pleasure in informing you in reply that your request has been submitted to
                    the Secretary of the Treasury for his consideration.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">James G. Blaine.</hi></signed></closer>
            </div>
        </body>
    </text>
