                <pb facs="0356" n="268" sameAs="frus:frus1892/pg268"/>

                <head><hi rendition="#italic">Sir Julian Pauncefote to Mr. Blaine.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >British Legation</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1892-01-14"><hi rendition="#italic">January 14, 1892</hi></date>.
                        (Received January 14.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: It is my sorrowful duty to announce to you
                    the lamentable intelligence, which I have just received from the Marquis of
                    Salisbury, of the death this morning, at Sandringham, of His Royal Highness the
                    Duke of Clarence and Avondale.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Julian
                    Pauncefote.</hi></signed></closer>
            </div>
        </body>
    </text>
