    <text>
        <body>
            <div xml:id="d253-a7">

                <pb facs="0403" n="315" sameAs="frus:frus1892/pg315"/>

                <head><hi rendition="#italic">Statement of Chinese passengers carried by Canadian
                        Pacific Railway steamships, 28th April</hi> (<hi rendition="#italic">first
                        steamer</hi>), <hi rendition="#italic">1891, to 25th August,
                    1892.</hi></head>
                <p rendition="#center"><hi rendition="#small-caps">inward.</hi></p>
                <table cols="2" rows="10">
                    <row>
                        <cell>To Canada:</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell>Pacific coast points</cell>
                        <cell role="num">4,268</cell>
                    </row>
                    <row>
                        <cell>Inland points</cell>
                        <cell rendition="#border-bottom" role="num">89</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell rendition="#border-bottom" role="num">4,357</cell>
                    </row>
                    <row>
                        <cell>To United States:</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell>Pacific coast points</cell>
                        <cell role="num">381½</cell>
                    </row>
                    <row>
                        <cell>Inland and eastern points</cell>
                        <cell rendition="#border-bottom" role="num">281</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell role="num">662½</cell>
                    </row>
                    <row>
                        <cell>To other countries</cell>
                        <cell rendition="#border-bottom" role="num">114</cell>
                    </row>
                    <row>
                        <cell>Total</cell>
                        <cell role="num">5,133½</cell>
                    </row>
                </table>
                <p rendition="#center"><hi rendition="#small-caps">outward.</hi></p>
                <table cols="2" rows="9">
                    <row>
                        <cell>From Canada:</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell>Pacific coast points</cell>
                        <cell role="num">595½</cell>
                    </row>
                    <row>
                        <cell>Inland points</cell>
                        <cell rendition="#border-bottom" role="num">82</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell rendition="#border-bottom" role="num">677½</cell>
                    </row>
                    <row>
                        <cell>From United States:</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell>Pacific coast points</cell>
                        <cell role="num">615½</cell>
                    </row>
                    <row>
                        <cell>Inland and eastern points</cell>
                        <cell rendition="#border-bottom" role="num">911</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell rendition="#border-bottom" role="num">1,526½</cell>
                    </row>
                    <row>
                        <cell>Total outward</cell>
                        <cell role="num">2,214</cell>
                    </row>
                </table>
            </div>
