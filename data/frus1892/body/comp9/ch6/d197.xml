    <text>
        <body>
            <div xml:id="d197">

                <pb facs="0345" n="257" xml:id="pg257"/>

                <head><hi rendition="#italic">Mr. Wharton to Sir Julian Pauncefote</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1891-11-28"><hi rendition="#italic">November 28,
                        1891</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of the 25th instant in relation to the crew of the British
                    steamship <hi rendition="#italic">Oxford</hi>, now in the port of Baltimore.</p>
                <p>Your note has been referred to the Secretary of the Treasury for such action, if
                    any, as the case may require, and upon receipt of his reply you will be further
                    communicated with upon the subject.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">William F. Wharton</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
