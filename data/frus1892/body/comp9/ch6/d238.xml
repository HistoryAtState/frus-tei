    <text>
        <body>
            <div xml:id="d238">

                <pb facs="0387" n="299" sameAs="frus:frus1892/pg299"/>

                <head><hi rendition="#italic">Mr. Herbert to Mr. Foster.</hi></head>
                <opener><seg rendition="#center">[Telegram].</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >British Legation</hi>,<lb/><hi rendition="#italic">Newport, R.
                                I.</hi></placeName>, <date calendar="gregorian" when="1892-08-19"
                                ><hi rendition="#italic">August 19,
                    1892</hi></date>.</dateline></opener>
                <p>Could I see you to-morrow morning early at Department? Kindly reply on receipt of
                    this in order to enable me to catch train.</p>
                <closer><signed><hi rendition="#small-caps">Herbert.</hi></signed></closer>
            </div>
        </body>
    </text>
