                <pb facs="0389" n="301" sameAs="frus:frus1892/pg301"/>

                <head><hi rendition="#italic">Mr. Herbert to Mr. Foster.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >British Legation</hi></placeName>,<lb/><hi rendition="#italic"
                            >Saturday</hi>, <date calendar="gregorian" when="1892-08-20"><hi
                                rendition="#italic">August 20, 1892</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Foster</hi>: According to a telegram
                    which I have just received from Canada I shall be able to make the communication
                    in regard to the canal tolls on Monday.</p>
                <p>Yours very truly,</p>
                <closer><signed><hi rendition="#small-caps">Michael H.
                    Herbert.</hi></signed></closer>
            </div>
        </body>
    </text>
