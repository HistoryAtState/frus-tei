                <pb facs="0314" n="226" xml:id="pg226"/>

                <head><hi rendition="#italic">Mr. Lincoln to Mr. Blaine.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1892-02-02"><hi rendition="#italic">February 2, 1892</hi></date>.
                        (Received February 12.)</dateline>
                    <seg rendition="#float-left">No. 604.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my dispatch numbered 597 of
                    the 23d ultimo, I have the honor to inclose herewith a note which I have
                    received from the Marquis of Salisbury requesting me, in behalf of the Queen, to
                    return Her Majesty’s warmest thanks to the President for his expressions of
                    sympathy on the occasion of the death of the Duke of Clarence and Avondale.</p>
                <p>I have, etc.</p>
                <closer><signed><hi rendition="#small-caps">Robert T.
                    Lincoln.</hi></signed></closer>


                <xi:include href="d172-a1.xml" xpointer="d172-a1"/>
