    <text>
        <body>
            <div xml:id="d413">

                <pb facs="0624" n="536" sameAs="frus:frus1892/pg536"/>

                <head><hi rendition="#italic">Mr. Blaine to Mr. Hirsch.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1892-03-02"><hi rendition="#italic">March 2,
                        1892</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 288.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit for your files a copy of a
                    letter of Mr. Smith, of the American Board of Commissioners for Foreign
                    Missions, commending your action on behalf of American missionaries, and a copy
                    of the pamphlet therewith.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">James G. Blaine.</hi></signed></closer>


                <xi:include href="d413-a1.xml" xpointer="d413-a1"/>
