    <text>
        <body>
            <div xml:id="d424">

                <pb facs="0642" n="554" xml:id="pg554"/>

                <head><hi rendition="#italic">Mr. Blaine to Mr.
                            Hirsch.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1892-04-06"><hi rendition="#italic">April 6,
                        1892</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 308.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    No. 409 of 21st ultimo, and to approve your note of 14th ultimo, objecting to
                    the proposed modification of the law regulating legal matters in which
                    foreigners are concerned.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">James G. Blaine.</hi></signed></closer>
            </div>
        </body>
    </text>
