    <text>
        <body>
            <div xml:id="d489">

                <pb facs="0696" n="608" sameAs="frus:frus1892/pg608"/>

                <head><hi rendition="#italic">Mr. Foster to Mr.
                            Newberry.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1892-11-16"><hi rendition="#italic">November 16,
                        1892</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 421.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit for your files a copy of a
                    letter of Mr. Gillespie, of the board of foreign missions of the Presbyterian
                    Church, New York, embodying resolutions appreciative of Mr. Hirsch, late
                    minister of the United States at Constantinople.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John W. Foster.</hi></signed></closer>



                <xi:include href="d489-a1.xml" xpointer="d489-a1"/>
            </div>
