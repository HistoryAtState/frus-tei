    <text>
        <body>
            <div xml:id="d485">

                <pb facs="0695" n="607" xml:id="pg607"/>

                <head><hi rendition="#italic">Mr. Newberry to Mr.
                            Foster.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1892-10-19"><hi rendition="#italic">October 19, 1892</hi></date>.
                        (Received November 10.)</dateline>
                    <seg rendition="#float-left">No. 580.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: For your information I have the honor to
                    inclose herewith copy of my note to the minister for foreign affairs, regarding
                    the closing in 1891 of the American mission school at Agantz.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">H. R. Newberry</hi>,<lb/><hi
                            rendition="#italic">Chargé d’Affaires ad interim.</hi></signed></closer>


                <xi:include href="d485-a1.xml" xpointer="d485-a1"/>
