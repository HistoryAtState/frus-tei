    <text>
        <body>
            <div xml:id="d459">

                <pb facs="0672" n="584" xml:id="pg584"/>

                <head><hi rendition="#italic">Mr. Newberry to Mr.
                            Foster.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1892-08-23"><hi rendition="#italic">August 23, 1892</hi></date>.
                        (Received September 5.)</dateline>
                    <seg rendition="#float-left">No. 520.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith, for
                    your information, a copy translation of a note received this morning from the
                    minister of foreign affairs in regard to the Bartlett case. I shall not allow
                    myself to be drawn into a diplomatic correspondence, but shall simply send my
                    note, with its demands, this evening.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">H. R. Newberry</hi>,<lb/><hi
                            rendition="#italic">Chargé d’Affaires ad interim.</hi></signed></closer>


                <xi:include href="d459-a1.xml" xpointer="d459-a1"/>
