                <pb facs="0688" n="600" xml:id="pg600"/>

                <head><hi rendition="#italic">Mr. Newberry to Mr. Foster.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1892-10-08"><hi rendition="#italic">October 8, 1892</hi></date>.
                        (Received October 27.)</dateline>
                    <seg rendition="#float-left">No. 565.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: For your information I beg to inclose
                    herewith copy of a note to the minister of foreign affairs requesting
                    information as to the punishment of the five men arrested in connection with the
                    burning of Mr. Bartlettf’s house at Bourdour, and also as to the reprimand, if
                    any, imposed upon Turkish officials at that place.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">H. R. Newberry</hi>,<lb/><hi
                            rendition="#italic">Chargé d’Affaires ad interim.</hi></signed></closer>


                <xi:include href="d479-a1.xml" xpointer="d479-a1"/>
