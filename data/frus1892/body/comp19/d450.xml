        <body>
            <div xml:id="d450">

                <pb facs="0666" n="578" sameAs="frus:frus1892/pg578"/>

                <head><hi rendition="#italic">Mr. Hirsch to Mr. Blaine.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1892-06-14"><hi rendition="#italic">June 14, 1892</hi></date>.
                        (Received June 27.)</dateline>
                    <seg rendition="#float-left">No. 470.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith copy
                    of a circular, issued and distributed among the American missionaries throughout
                    the Empire, in relation to the late arrangement of the school difficulties and
                    the present status of American schools.</p>
                <p>I have, etc.</p>
                <closer><signed><hi rendition="#small-caps">Solomon Hirsch.</hi></signed></closer>



                <xi:include href="d450-a1.xml" xpointer="d450-a1"/>
