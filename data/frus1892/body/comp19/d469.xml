    <text>
        <body>
            <div xml:id="d469">

                <pb facs="0681" n="593" sameAs="frus:frus1892/pg593"/>

                <head><hi rendition="#italic">Mr. Foster to Mr. Newberry.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1892-09-07"><hi rendition="#italic">September 7,
                        1892</hi></date>.</dateline></opener>
                <p>You are authorized to accept the proposition of Turkish Government to pay £350
                    for house and £250 indemnity.</p>
                <closer><signed><hi rendition="#small-caps">Foster.</hi></signed></closer>
            </div>
        </body>
    </text>
