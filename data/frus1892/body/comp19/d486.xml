                <pb facs="0695" n="607" sameAs="frus:frus1892/pg607"/>

                <head><hi rendition="#italic">Mr. Wharton to Mr. Newberry.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1892-10-20"><hi rendition="#italic">October 20,
                        1892</hi></date>.</dateline></opener>
                <p>Insist upon full protection for Bartlett and other persons complaining of
                    interference.</p>
                <closer><signed><hi rendition="#small-caps">Wharton.</hi></signed></closer>
            </div>
        </body>
    </text>
