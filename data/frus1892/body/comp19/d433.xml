    <text>
        <body>
            <div xml:id="d433">

                <pb facs="0650" n="562" sameAs="frus:frus1892/pg562"/>

                <head><hi rendition="#italic">Mr. Blaine to Mr. Hirsch.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1892-04-22"><hi rendition="#italic">April 22,
                        1892</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 316.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit a copy of a letter containing
                    further representations of the interference of Turkish officials with the labors
                    and school work of citizens of the United States in Syria.</p>
                <p>You will continue to act in the interest of our citizens with the energy that has
                    heretofore met the approval of the Department.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">James G. Blaine.</hi></signed></closer>





