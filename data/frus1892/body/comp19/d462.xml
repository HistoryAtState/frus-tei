                <pb facs="0676" n="588" xml:id="pg588"/>

                <head><hi rendition="#italic">Mr. Newberry to Mr. Foster.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1892-08-24"><hi rendition="#italic">August 24, 1892</hi></date>.
                        (Received September 12.)</dateline>
                    <seg rendition="#float-left">No. 523.</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: It is a relief to be able to send yon
                    something agreeable. I take pleasure in inclosing copy of a letter from the head
                    of the Eastern Turkey mission which explains itself.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">H. R. Newberry</hi>,<lb/><hi
                            rendition="#italic">Chargé d’Affaires ad interim.</hi></signed></closer>


                <xi:include href="d462-a1.xml" xpointer="d462-a1"/>
