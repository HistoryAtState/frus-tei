    <text>
        <body>
            <div xml:id="d435">

                <pb facs="0652" n="564" sameAs="frus:frus1892/pg564"/>

                <head><hi rendition="#italic">Mr. Blaine to Mr. Hirsch.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1892-04-28"><hi rendition="#italic">April 28,
                        1892</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 321.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: The Department fully approves the terms of
                    your note of the 12th instant, a copy of which accompanies your No. 427 of that
                    date, whereby you call for the protection of certain citizens of the United
                    States, engaged as teachers in the district of Gavour, who have been molested by
                    the authorities there.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">James G. Blaine.</hi></signed></closer>
            </div>
        </body>
    </text>
