    <text>
        <body>
            <div xml:id="d475">

                <pb facs="0684" n="596" sameAs="frus:frus1892/pg596"/>

                <head><hi rendition="#italic">Mr. Newberry to Mr. Foster.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1892-09-27"><hi rendition="#italic">September 27,
                        1892</hi></date>. (Received October 13.)</dateline>
                    <seg rendition="#float-left">No. 551.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose for your information copy of
                    extract from the private journal of Mr. Bartlett, the perusal of which may be of
                    interest as connected with the late outrage on that gentleman at Bourdour.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">H. R. Newberry</hi>,<lb/><hi
                            rendition="#italic">Chargé d’Affaires ad interim.</hi></signed></closer>


                <xi:include href="d475-a1.xml" xpointer="d475-a1"/>
