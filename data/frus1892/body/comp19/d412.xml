    <text>
        <body>
            <div xml:id="d412">

                <pb facs="0624" n="536" xml:id="pg536"/>

                <head><hi rendition="#italic">Mr. Blaine to Mr.
                            Hirsch.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1892-02-24"><hi rendition="#italic">February 24,
                        1892</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 285.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have received your No. 383 of 29th
                    ultimo, with which you inclose an extract from the Levant Herald of January 27,
                    1892, giving the text of the recent order of the Porte regarding authorization
                    of schools.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">James G. Blaine.</hi></signed></closer>
            </div>
        </body>
    </text>
