    <text>
        <body>
            <div xml:id="d444">

                <pb facs="0663" n="575" xml:id="pg575"/>

                <head><hi rendition="#italic">Mr. Blaine to Mr. Hirsch.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1892-05-23"><hi rendition="#italic">May 23,
                        1892</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 328.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit for your information a copy of a
                    letter, commending your services to certain representatives in Turkey, of the
                    Board of Foreign Missions of the Presbyterian Church in the United States.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">James G. Blaine.</hi></signed></closer>


                <xi:include href="d444-a1.xml" xpointer="d444-a1"/>
