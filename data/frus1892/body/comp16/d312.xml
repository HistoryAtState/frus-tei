                <pb facs="0460" n="372" xml:id="pg372"/>

                <head><hi rendition="#italic">Mr. Blaine to Mr.
                            Smith.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1892-03-04"><hi rendition="#italic">March 4,
                        1892</hi></date>.</dateline></opener>
                <p><hi rendition="#italic">Indiana</hi> consigned R. W. Sargent, her captain; cargo,
                    29,144 sacks flour, 383 packages provisions; total, 2,130 tons.</p>
                <closer><signed><hi rendition="#small-caps">Blaine.</hi></signed></closer>
            </div>
        </body>
