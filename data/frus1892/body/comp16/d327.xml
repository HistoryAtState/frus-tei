                <pb facs="0471" n="383" xml:id="pg383"/>

                <head><hi rendition="#italic">Mr. Blaine to Mr. Wurts.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1892-04-29"><hi rendition="#italic">April 29,
                        1892</hi></date>.</dateline></opener>
                <p><hi rendition="#italic">Conemaugh</hi>, Spencer, captain; sailed Philadelphia for
                    Riga; cargo over 5,000,000 pounds provisions, Russian sufferers.</p>
                <closer><signed><hi rendition="#small-caps">Blaine.</hi></signed></closer>
            </div>
        </body>
