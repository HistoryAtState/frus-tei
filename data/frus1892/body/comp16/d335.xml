    <text>
        <body>
            <div xml:id="d335">

                <pb facs="0475" n="387" xml:id="pg387"/>

                <head><hi rendition="#italic">Mr. Wurts to Mr. Wharton.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic">St.
                                Petersburg</hi></placeName>, <date calendar="gregorian"
                            when="1892-06-16"><hi rendition="#italic">June 16, 1892</hi></date>.
                        (Received June 30.)</dateline>
                    <seg rendition="#float-left">No. 201.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose to you herewith
                    a translation of the law adopted by the Imperial Government regarding the
                    emigration of Hebrews from Russia under the project of Baron Hirsch, which
                    received the supreme sanction of the Emperor on the 8–20th ultimo.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">George W. Wurts</hi>,<lb/><hi
                            rendition="#italic">Chargé Ad’ffaires ad interim.</hi></signed></closer>


                <xi:include href="d335-a1.xml" xpointer="d335-a1"/>
