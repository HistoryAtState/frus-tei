    <text>
        <body>
            <div xml:id="d334">

                <pb facs="0474" n="386" sameAs="frus:frus1892/pg386"/>

                <head><hi rendition="#italic">Mr. Blaine to Mr.
                            Wurts.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1892-05-31"><hi rendition="#italic">May 31,
                        1892</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 178.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: The Department is in receipt of a check for
                    $11.51 collected by the public schools of Florence. S. C., for the Russian
                    famine sufferers. You are instructed to draw on the Department for that amount
                    and to distribute it in the same manner as the previous contributions have been
                    distributed.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">James G. Blaine</hi>.</signed></closer>
            </div>
        </body>
    </text>
