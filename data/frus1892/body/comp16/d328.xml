    <text>
        <body>
            <div xml:id="d328">

                <pb facs="0471" n="383" sameAs="frus:frus1892/pg383"/>

                <head><hi rendition="#italic">Mr. Blaine to Mr.
                            Wurts.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1892-04-29"><hi rendition="#italic">April 29,
                        1892</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 163.]</seg></opener>
                <p>I inclose a copy of a letter from his honor, the mayor of Philadelphia, of the
                    26th instant, concerning this shipment by the <hi rendition="#italic"
                        >Conemaugh</hi>.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">James G. Blaine</hi>.</signed></closer>


                <xi:include href="d328-a1.xml" xpointer="d328-a1"/>
