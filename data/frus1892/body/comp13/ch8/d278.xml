    <text>
        <body>
            <div xml:id="d278">

                <pb facs="0437" n="349" sameAs="frus:frus1892/pg349"/>

                <head><hi rendition="#italic">Mr. Foster to Baron
                            Fava.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1892-07-18"><hi rendition="#italic">July 18,
                        1892</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Baron</hi>: As promised by me in our
                    interview this morning, I take pleasure in herewith inclosing a copy of the
                    letter from the Acting Secretary of the Navy, of the 18th instant, the original
                    of which you read.</p>
                <p>I desire to assure you of my cordial participation in the sentiments expressed by
                    Mr. Soley.</p>
                <p>Very truly yours,</p>
                <closer><signed><hi rendition="#small-caps">John W. Foster.</hi></signed></closer>


                <xi:include href="d278-a1.xml" xpointer="d278-a1"/>
            </div>
