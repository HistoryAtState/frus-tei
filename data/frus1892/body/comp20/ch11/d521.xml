                <pb facs="0728" n="640" xml:id="pg640"/>

                <head><hi rendition="#italic">Mr. Adee to Señor
                            Bolet Peraza.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1892-09-10"><hi rendition="#italic">September 10,
                        1892</hi></date>.</dateline></opener>
                <p><hi rendition="#italic">South Portland</hi> held for investigation. Your proofs
                    of violation of neutrality should he exhibited to collector without delay.</p>
                <closer><signed><hi rendition="#small-caps">Alvey A. Adee</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>
            </div>
        </body>
