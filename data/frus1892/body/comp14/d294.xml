    <text>
        <body>
            <div xml:id="d294">

                <pb facs="0443" n="355" sameAs="frus:frus1892/pg355"/>

                <head><hi rendition="#italic">Mr. Beale to Mr.
                            Blaine.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Teheran</hi></placeName>, <date calendar="gregorian"
                            when="1891-12-25"><hi rendition="#italic">December 25, 1891</hi></date>.
                        (Received February 5.)</dateline>
                    <seg rendition="#float-left">No. 28.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my No. 26 diplomatic series,
                    of December 5, I have the honor to inclose herewith copy of resolutions adopted
                    by the Presbyterian board of missions, thanking me for having obtained for
                    American missionaries the privilege of holding real estate in Persia.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Truxtun Beale.</hi></signed></closer>


                <xi:include href="d294-a1.xml" xpointer="d294-a1"/>
