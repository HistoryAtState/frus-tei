    <text>
        <body>
            <div xml:id="d362">

                <pb facs="0522" n="434" sameAs="frus:frus1892/pg434"/>

                <head><hi rendition="#italic">Mr. Blaine to Mr.
                            Newberry.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1890-10-20"><hi rendition="#italic">October 20,
                        1890</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 134.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose the commission of Herbert L.
                    Rand, a citizen of the State of Illinois, as consul of the United States at
                    Ponape, Caroline Islands.</p>
                <p>You are instructed to apply in the proper quarter for recognition of Mr. Rand in
                    his official capacity, and to inform him of the result in the usual manner.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">James G. Blaine.</hi></signed></closer>
                <postscript>
                    <p>Inclosure commission dated September 9, 1890.</p>
                </postscript>
            </div>
        </body>
