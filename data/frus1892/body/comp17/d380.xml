                <pb facs="0582" n="494" sameAs="frus:frus1892/pg494"/>

                <head><hi rendition="#italic">Mr. Grubb to Mr. Blaine.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1892-05-22"><hi rendition="#italic">May 22, 1892</hi></date>.
                        (Received June 2.)</dateline>
                    <seg rendition="#float-left">No. 254.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a
                    translation of the royal decree taking off the prohibition on the importation of
                    American pork in this country and its dependencies.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">E. B. Grubb.</hi></signed></closer>


                <xi:include href="d380-a1.xml" xpointer="d380-a1"/>
