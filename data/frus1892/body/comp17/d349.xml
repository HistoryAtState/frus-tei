    <text>
        <body>
            <div xml:id="d349">

                <pb facs="0502" n="414" sameAs="frus:frus1892/pg414"/>

                <head><hi rendition="#italic">Mr. Bayard to Mr. Curry.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1888-01-30"><hi rendition="#italic">January 30,
                        1888</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 263.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose for your information copy of a
                    letter from the captain of the <hi rendition="#italic">Morning Star</hi> to the
                    Rev. Judson Smith, concerning the condition of affairs at Ponape.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. F. Bayard.</hi></signed></closer>




                <xi:include href="d349-a1.xml" xpointer="d349-a1"/>
