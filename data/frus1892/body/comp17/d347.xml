    <text>
        <body>
            <div xml:id="d347">

                <pb facs="0499" n="411" sameAs="frus:frus1892/pg411"/>

                <head><hi rendition="#italic">Mr. Bayard to Mr. Curry.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1887-11-25"><hi rendition="#italic">November 25,
                        1887</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 238.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit for your information, in
                    connection with former correspondence, a copy of a dispatch from Manila,
                    containing references to the recent disturbances at Ponape, Caroline Islands,
                    and copy of a letter of Rev. Mr. Doane, the American missionary there.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. F. Bayard.</hi></signed></closer>




