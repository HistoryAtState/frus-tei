    <text>
        <body>
            <div xml:id="d104-a4">

                <pb facs="0229" n="141" sameAs="frus:frus1892/pg141"/>

                <head><hi rendition="#italic">Mr. Gillespie to Mr.
                            Munn.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Coupeville, Wash.</hi></placeName>, <date calendar="gregorian"
                            when="1891-11-19"><hi rendition="#italic">November 19,
                        1891</hi></date>.</dateline></opener>
                <p rendition="#center"><hi rendition="#small-caps">Exhibit B.</hi></p>
                <p><hi rendition="#small-caps">Sir</hi>: In relation to a petition to the honorable
                    Chinese minister, signed by me on August 25, 1891, I wish to say that I was
                    misinformed of the facts at the time of signing the same, and believe your
                    actions to have been honorable and just.</p>
                <closer><signed>
                        <list>
                            <item><hi rendition="#small-caps">James Gillespie.</hi></item>
                            <item><hi rendition="#small-caps">C. E. Munn</hi>,<lb/><hi
                                    rendition="#italic">Chinese Inspector.</hi></item>
                        </list></signed></closer>
            </div>
        </body>
    </text>
