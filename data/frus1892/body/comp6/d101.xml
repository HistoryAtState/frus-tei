    <text>
        <body>
            <div xml:id="d101">

                <pb facs="0226" n="138" sameAs="frus:frus1892/pg138"/>

                <head><hi rendition="#italic">Mr. Foster to Mr.
                            Denby.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1892-12-12"><hi rendition="#italic">December 12,
                        1892</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 765.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit for your information, a copy of
                    correspondence with the Minister of China here, relative to the recent
                    legislation of the United States in respect to Chinese subjects in this
                        country.<anchor n="*" xml:id="d101-f1"/></p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John W. Foster.</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d101-f1" n="*" xml:id="d101-f1-content">
                <p>The inclosures herein referred to are the notes of November 7 and 11 from and of
                    December 10 to the Minister of China.</p>
            </note>
        </listAnnotation>
    </standOff>
