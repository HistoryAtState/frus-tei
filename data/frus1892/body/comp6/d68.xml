    <text>
        <body>
            <div xml:id="d68">

                <pb facs="0175" n="87" sameAs="frus:frus1892/pg87"/>

                <head><hi rendition="#italic">Mr. Denby to Mr.
                            Blaine.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1892-02-01"><hi rendition="#italic">February 1, 1892</hi></date>.
                        (Received March 21.)</dateline>
                    <seg rendition="#float-left">No. 1470.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose, herewith, a
                    clipping from the North China News, which contains an account of the recent
                    Mongolian insurrection, written by a Chinese priest.</p>
                <p>I have the honor to be, sir, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charles Denby.</hi></signed></closer>


                <xi:include href="d68-a1.xml" xpointer="d68-a1"/>
