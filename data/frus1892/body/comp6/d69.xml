    <text>
        <body>
            <div xml:id="d69">

                <pb facs="0177" n="89" sameAs="frus:frus1892/pg89"/>

                <head><hi rendition="#italic">Mr. Blaine to Mr.
                            Denby.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1892-02-11"><hi rendition="#italic">February 11,
                        1892</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 701.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose for your information a copy of a
                    letter from the beard of foreign missions of the Presbyterian Church in the
                    United States and the resolution therewith, recognizing your services in aid of
                    the missionaries at Chinanfu.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">James G. Blaine</hi>.</signed></closer>




                <xi:include href="d69-a1.xml" xpointer="d69-a1"/>
