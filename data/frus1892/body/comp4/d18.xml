    <text>
        <body>
            <div xml:id="d18">

                <pb facs="0112" n="24" xml:id="pg24"/>

                <head><hi rendition="#italic">Mr. Wharton to Mr. Shannon.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1891-09-26"><hi rendition="#italic">September 26,
                        1891</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 11.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to instruction No. 2, of 9th
                    instant, I inclose copies of correspondence with the legation at Guatemala, on
                    the complaint of Mr. Myers, consul at San Salvador, against the authorities of
                    that Government, as set forth.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">William F. Wharton</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>


                <xi:include href="d18-a1.xml" xpointer="d18-a1"/>
