    <text>
        <body>
            <div xml:id="d20-a2">

                <pb facs="0117" n="29" sameAs="frus:frus1892/pg29"/>

                <head><hi rendition="#italic">Inventory of property belonging to the Government of
                        the United States destroyed at the United States consulate in San Salvador
                        by the Salvadorean troops July 30, 1890.</hi></head>
                <table cols="4" rows="6">
                    <row role="label">
                        <cell>5 office chairs at $5</cell>
                        <cell role="num">$25.00</cell>
                        <cell>Repairs to book case and writing desk</cell>
                        <cell role="num">$12.00</cell>
                    </row>
                    <row>
                        <cell>2 rocking chairs, at $7</cell>
                        <cell role="num">14.00</cell>
                        <cell>Books and archives</cell>
                        <cell role="num">19.00</cell>
                    </row>
                    <row>
                        <cell>1 table with drawers.</cell>
                        <cell role="num">12.50</cell>
                        <cell>Coat of arms (value estimated)</cell>
                        <cell role="num">25.00</cell>
                    </row>
                    <row>
                        <cell>Floor mats</cell>
                        <cell role="num">12.75</cell>
                        <cell/>
                        <cell/>
                    </row>
                    <row>
                        <cell>Stationery</cell>
                        <cell role="num">15.00</cell>
                        <cell/>
                        <cell rendition="#border-bottom"/>
                    </row>
                    <row>
                        <cell>Water pitcher</cell>
                        <cell role="num">2.00</cell>
                        <cell>Total</cell>
                        <cell role="num">137.25</cell>
                    </row>
                </table>
            </div>
        </body>
    </text>
