    <text>
        <body>
            <div xml:id="d291">

                <pb facs="0523" n="507" xml:id="pg507"/>

                <note rend="inline" type="source">891.032/4–2149: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Iran</hi> (<hi
                            rendition="#italic">Wiley</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <dateline>
                    <placeName>
                        <hi rendition="#small-caps">Tehran</hi></placeName>, <date
                        calendar="gregorian" when="1949-04-21">April 21, 1949</date>.</dateline>
                <p>539. Constituent Assembly was convened today by Shah with brief opening
                        address.<anchor n="1" xml:id="d291-f1"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wiley</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d291-f1" n="1" xml:id="d291-f1-content">
                <p>The Majlis passed legislation creating a Senate by a voice vote on May 4
                    (telegram 607, May 5, from Tehran, 891.032/5–549).</p>
            </note>
        </listAnnotation>
    </standOff>
