                    footnote 1, <ref target="frus1948v05p2#pg_1076">
                        <hi rendition="#italic">ibid</hi>., p. 1706</ref>.</p>
            </note>
            <note corresp="#d341-f3" n="4" xml:id="d341-f3-content">
