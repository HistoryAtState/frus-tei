            <div xml:id="d769">

                <pb facs="1160" n="1144" sameAs="frus:frus1949v06/pg1144"/>

                <note rend="inline" type="source">501.BB Palestine/6–1649</note>
                <head>
                    <hi rendition="#italic">Memorandum by the Acting Secretary of State</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1949-06-16">June 16, 1949</date>.</dateline>
                </opener>
                <p rendition="#center">
                    <hi rendition="#small-caps">Meeting With President, Thursday, June</hi> 16,
                    1949</p>
                <p rendition="#center">
                    <hi rendition="#small-caps">u.s. approach to transjordan</hi>
                </p>
                <p>I delivered to the President the original of the attached memorandum with respect
                    to the recent U.S. approach to Transjordan. The President read the pertinent
                    sections and kept it. He indicated approval of the action taken in the
                    Department.</p>
                <closer>
                    <signed>J[<hi rendition="#small-caps">ames</hi> E.] W[<hi
                            rendition="#small-caps">ebb</hi>]</signed>
                </closer>



                <xi:include href="d769-a1.xml" xpointer="d769-a1"/>
