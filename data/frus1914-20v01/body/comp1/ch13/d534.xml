    <text>
        <body>
            <div xml:id="d534">

                <pb facs="0634" n="566" sameAs="frus:frus1914-20v01/pg566"/>

                <note rend="inline" type="source">763.72/2662</note>
                <head>
                    <hi rendition="#italic">President Wilson to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-05-08">
                            <hi rendition="#italic">8 May, 1916</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: You are probably right
                    about cutting out all “satisfaction”, and I am quite content to have the note go
                    as you have amended it. I am returning it so that it may be sent at once.</p>
                <p>In haste,</p>
                <p>Faithfully Yours,</p>
                <closer>
                    <signed>W. W.</signed>
                </closer>
            </div>
        </body>
    </text>
