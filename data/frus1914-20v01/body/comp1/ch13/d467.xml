    <text>
        <body>
            <div xml:id="d467">

                <pb facs="0574" n="506" sameAs="frus:frus1914-20v01/pg506"/>

                <note rend="inline" type="source">865.857 An 2/96½</note>
                <head>
                    <hi rendition="#italic">President Wilson to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Hot Springs, Va.</hi></placeName>, <date
                            calendar="gregorian" when="1915-12-26">
                            <hi rendition="#italic">26 December, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: This is encouraging as
                    to the spirit of the Austro-Hungarian government, but I fear they are preparing
                    to contest the facts with us, and the inferences to be drawn from them.</p>
                <p>Faithfully Yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Woodrow Wilson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
