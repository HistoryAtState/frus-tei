    <text>
        <body>
            <div xml:id="d426">

                <pb facs="0544" n="476" xml:id="pg476"/>

                <note rend="inline" type="source">841.857/28</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        President Wilson
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-09-09">
                            <hi rendition="#italic">September 9, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. President</hi>: I enclose to you three
                    letters which I have received today from the German Ambassador, and to which I
                    have made no reply.<anchor n="51" xml:id="d426-f1"/> Please return them at your
                    earliest convenience.</p>
                <p>Faithfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>


                <xi:include href="d426-a1.xml" xpointer="d426-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d426-f1" n="51" xml:id="d426-f1-content">
                <p>Two of these letters are printed in <ref target="frus1915Supp#pg_538">
                        <hi rendition="#italic">Foreign Relations</hi>, 1915, supp., pp. 538</ref>,
                        <ref target="frus1915Supp#pg_540">540</ref>; the third is printed <hi
                        rendition="#italic">infra</hi>.</p>
            </note>
        </listAnnotation>
    </standOff>
