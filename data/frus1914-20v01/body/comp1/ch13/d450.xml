    <text>
        <body>
            <div xml:id="d450">

                <pb facs="0562" n="494" sameAs="frus:frus1914-20v01/pg494"/>

                <note rend="inline" type="source">763.72/2322½</note>
                <head>
                    <hi rendition="#italic">President Wilson to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-11-24">
                            <hi rendition="#italic">24 November, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: Here are two recent
                    letters from Mr. House which I am sure will interest you.<anchor n="72"
                        xml:id="d450-f1"/> Bernstorff evidently wants to use House as a channel of
                    unofficial communication with us.</p>
                <pb facs="0563" n="495" xml:id="pg495"/>
                <p>I would be very much obliged to you if you would return the letters with your
                    comments on them.</p>
                <p>Faithfully Yours,</p>
                <closer>
                    <signed>W. W.</signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d450-f1" n="72" xml:id="d450-f1-content">
                <p>Not enclosed with file copy of this letter.</p>
            </note>
        </listAnnotation>
    </standOff>
