    <text>
        <body>
            <div xml:id="d573-a1">

                <pb facs="0674" n="606" sameAs="frus:frus1914-20v01/pg606"/>

                <opener>
                    <seg rendition="#center">[Enclosure]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">The Chairman of the Senate Committee on Foreign
                        Relations</hi> (<hi rendition="#italic"
                        >Stone</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi><anchor n="7" xml:id="d573-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1917-02-13">
                            <hi rendition="#italic">February 13, 1917</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Secretary</hi>: At the request of Senator
                    Saulsbury, I have directed the Clerk of this Committee to forward you, for any
                    comment you might care to make thereon, his Resolution presented this morning;
                    copy of which is herewith enclosed.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wm. J. Stone</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
