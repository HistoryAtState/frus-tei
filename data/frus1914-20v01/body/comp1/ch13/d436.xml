    <text>
        <body>
            <div xml:id="d436">

                <pb facs="0552" n="484" xml:id="pg484"/>

                <note rend="inline" type="source">763.72/2236½</note>
                <head>
                    <hi rendition="#italic">The German Ambassador</hi> (<hi rendition="#italic"
                        >Bernstorff</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Cedarhurst N. Y.</hi></placeName>, <date
                            calendar="gregorian" when="1915-10-02">
                            <hi rendition="#italic">October 2, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: With regard to our
                    conversation about the <hi rendition="#italic">Arabic</hi> incident this morning
                    I beg to say that according to my instructions the report of Commander Schneider
                    of our submarine and the German affidavits have been sent to you through the
                    American Embassy in Berlin. If you should not have received them, I will be glad
                    to send you a copy.</p>
                <p>In this same envelope I have pleasure in sending you my tentative letter about
                    the <hi rendition="#italic">Lusitania</hi> incident.</p>
                <p>I remain [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">J. Bernstorff</hi>
                    </signed>
                </closer>


                <xi:include href="d436-a1.xml" xpointer="d436-a1"/>
            </div>
