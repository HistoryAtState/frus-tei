    <text>
        <body>
            <div xml:id="d496">

                <pb facs="0598" n="530" sameAs="frus:frus1914-20v01/pg530"/>

                <note rend="inline" type="source">763.72/2389½: Telegram</note>
                <head>
                    <hi rendition="#italic">President Wilson to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Kansas City, Mo.</hi></placeName>, <date
                            calendar="gregorian" when="1916-02-02T19:07:00-06:00">
                            <hi rendition="#italic">February 2, 1916—7:07 p. m.</hi>
                        </date>
                        <lb/> [Received 10:30 p. m.]</dateline>
                </opener>
                <p>Your letter of January 31st received. Please frame and send message you suggest
                    explaining the point at issue.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Woodrow Wilson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
