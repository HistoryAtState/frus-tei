    <text>
        <body>
            <div xml:id="d426-a1">

                <pb facs="0544" n="476" sameAs="frus:frus1914-20v01/pg476"/>

                <opener>
                    <seg rendition="#center">[Enclosure]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">The German Ambassador</hi> (<hi
                            rendition="#italic">Bernstorff</hi>) <hi rendition="#italic"
                        >to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Cedarhurst, N. Y.</hi></placeName>, <date
                            calendar="gregorian" when="1915-09-08">
                            <hi rendition="#italic">September 8, 1915</hi>.</date>
                        <lb/> [Received September 9.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I have just received the
                    following wireless message from Berlin:</p>
                <quote rend="blockquote">
                    <p>“According to information available here it seems highly improbable that <hi
                            rendition="#italic">Hesperian</hi> was torpedoed. Much more likely boat
                        ran on mine. Foreign Office.”</p>
                </quote>
                <p>I remain [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">J. Bernstorff</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
