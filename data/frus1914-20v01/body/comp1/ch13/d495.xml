            <div xml:id="d495">

                <pb facs="0598" n="530" sameAs="frus:frus1914-20v01/pg530"/>

                <note rend="inline" type="source">763.72/2364: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Germany</hi>
                        (<hi rendition="#italic">Gerard</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-01-31T10:00:00-05:00">
                            <hi rendition="#italic">January 31, 1916—10 a. m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>2661. Your 4008 [<hi rendition="#italic">3408</hi>].<anchor n="13"
                        xml:id="d495-f1"/> Offer no encouragement that the suggested statement would
                    be at all acceptable. It has already been several times submitted to this
                    Government. Will advise you later.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
