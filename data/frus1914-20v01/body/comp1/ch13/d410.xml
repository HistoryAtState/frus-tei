    <text>
        <body>
            <div xml:id="d410">

                <pb facs="0533" n="465" xml:id="pg465"/>

                <note rend="inline" type="source">763.72/1940: Telegram</note>
                <head>
                    <hi rendition="#italic">The Vice President</hi> (<hi
                            rendition="#italic">Marshall</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Indianapolis, Ind.</hi></placeName>, <date
                            calendar="gregorian" when="1915-07-24T10:28:00-06:00">
                            <hi rendition="#italic">July 24, 1915—10:28 a. m.</hi>
                        </date>
                        <lb/> [Received 11:41 a. m.]</dateline>
                </opener>
                <p>Congratulations.<anchor n="39" xml:id="d410-f1"/> You have said it. Follow with
                    note to England defining the American idea and we are impregnable.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Thos. R. Marshall</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d410-f1" n="39" xml:id="d410-f1-content">
                <p>i. e., on the note to Germany of July 21, 1915, printed in <ref
                        target="frus1915Supp#pg_480">
                        <hi rendition="#italic">Foreign Relations</hi>, 1915, supp., p.
                    480</ref>.</p>
            </note>
