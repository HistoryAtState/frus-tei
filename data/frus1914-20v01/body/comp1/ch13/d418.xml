    <text>
        <body>
            <div xml:id="d418">

                <pb facs="0539" n="471" sameAs="frus:frus1914-20v01/pg471"/>

                <note rend="inline" type="source">841.857 Ar 1/91½</note>
                <head>
                    <hi rendition="#italic">President Wilson to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-08-26">
                            <hi rendition="#italic">26 August, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I very much appreciated
                    your letter setting forth the pros and cons of the effect of hostilities with
                    Germany. I find that it runs along very much the same lines as my own
                    thought.</p>
                <p>Faithfully Yours,</p>
                <closer>
                    <signed>W. W.</signed>
                </closer>
            </div>
        </body>
    </text>
