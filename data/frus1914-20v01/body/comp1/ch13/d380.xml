    <text>
        <body>
            <div xml:id="d380">

                <pb facs="0489" n="421" sameAs="frus:frus1914-20v01/pg421"/>

                <note rend="inline" type="source">763.72/1847½</note>
                <head>
                    <hi rendition="#italic">President Wilson to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-06-02">
                            <hi rendition="#italic">2 June, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: It is interesting and
                    significant how often the German Foreign Office goes over the same ground in
                    different words, and always misses the essential point involved, that England’s
                    violation of neutral rights is different from Germany’s violation of the rights
                    of humanity.</p>
                <p>Faithfully yours,</p>
                <closer>
                    <signed>W. W.</signed>
                </closer>
            </div>
        </body>
    </text>
