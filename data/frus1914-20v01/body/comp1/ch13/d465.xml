    <text>
        <body>
            <div xml:id="d465">

                <pb facs="0573" n="505" sameAs="frus:frus1914-20v01/pg505"/>

                <note rend="inline" type="source">865.857 An 2/95½</note>
                <head>
                    <hi rendition="#italic">President Wilson to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Hot Springs, Va.</hi></placeName>, <date
                            calendar="gregorian" when="1915-12-24">
                            <hi rendition="#italic">24 December, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I am not sure whether I
                    am encouraged or not by this,<anchor n="81" xml:id="d465-f1"/> but I am clear
                    that you said the right things to the Baron and that it was very wise to make
                    him see the position of the United States without any penumbra about the edges
                    of the statement.</p>
                <p>Cordially and faithfully Yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Woodrow Wilson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
