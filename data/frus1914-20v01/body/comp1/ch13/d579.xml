    <text>
        <body>
            <div xml:id="d579">

                <pb facs="0677" n="609" sameAs="frus:frus1914-20v01/pg609"/>

                <note rend="inline" type="source">763.72/3354½</note>
                <head>
                    <hi rendition="#italic">President Wilson to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-02-19">
                            <hi rendition="#italic">19 February, 1917</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I have always had a good
                    opinion of Professor Kirchwey and have no reason to doubt that he did what he
                    did in this instance with the best intentions, but it was certainly a most
                    extraordinary performance, take it in all its aspects.</p>
                <p>Faithfully Yours,</p>
                <closer>
                    <signed>W. W.</signed>
                </closer>
            </div>
        </body>
    </text>
