    <text>
        <body>
            <div xml:id="d552">

                <pb facs="0648" n="580" sameAs="frus:frus1914-20v01/pg580"/>

                <note rend="inline" type="source">763.72111/4441</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to President Wilson </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-01-23">
                            <hi rendition="#italic">January 23, 1917</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. President</hi>: I call your special
                    attention to this telegram received this morning from Berlin,<anchor n="77"
                        xml:id="d552-f1"/> which appears to me to create a very serious situation,
                    if Mr. Gerard is accurate in his presumptions—which sound to me very
                    reasonable.</p>
                <p>Faithfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d552-f1" n="77" xml:id="d552-f1-content">
                <p>Telegram No. 4912, Jan. 21, 1917, from the Ambassador in Germany, <ref
                        target="frus1917Supp01v01#pg_91">
                        <hi rendition="#italic">ibid.</hi>, 1917, supp. 1, p. 91</ref>.</p>
            </note>
        </listAnnotation>
