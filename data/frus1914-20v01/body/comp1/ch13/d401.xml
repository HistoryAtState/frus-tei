    <text>
        <body>
            <div xml:id="d401">

                <pb facs="0522" n="454" sameAs="frus:frus1914-20v01/pg454"/>

                <note rend="inline" type="source">763.72/1965½: Telegram</note>
                <head>
                    <hi rendition="#italic">President Wilson to Mr.
                        J. P. Tumulty</hi> (<hi rendition="#italic">Secretary to
                            the President</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Windsor, Vt.</hi></placeName>, <date
                            calendar="gregorian" when="1915-07-11T21:00:00-05:00">
                            <hi rendition="#italic">July 11, 1915—9 p. m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>According to our telephone conversation shall not expect Secretary of State to
                    come here without previous consultation with me as to the best plan for
                    conference.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Woodrow Wilson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
