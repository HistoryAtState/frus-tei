    <text>
        <body>
            <div xml:id="d520">

                <pb facs="0619" n="551" xml:id="pg551"/>

                <note rend="inline" type="source">851.857 Su 8/81½</note>
                <head>
                    <hi rendition="#italic">President Wilson to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-04-17">
                            <hi rendition="#italic">17 April, 1916</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: Circumstances of this
                    sort are of course very disturbing;<anchor n="40" xml:id="d520-f1"/> but I did
                    not know that we had learned the name of the submarine which attacked the <hi
                        rendition="#italic">Sussex</hi>.</p>
                <p>Faithfully Yours,</p>
                <closer>
                    <signed>W. W.</signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d520-f1" n="40" xml:id="d520-f1-content">
                <p>See letter from The Secretary of State to President Wilson, Apr. 15, 1916, p.
                    548.</p>
            </note>
        </listAnnotation>
