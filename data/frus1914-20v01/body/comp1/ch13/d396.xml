    <text>
        <body>
            <div xml:id="d396">

                <pb facs="0520" n="452" sameAs="frus:frus1914-20v01/pg452"/>

                <note rend="inline" type="source">763.72/1868½</note>
                <head>
                    <hi rendition="#italic">President Wilson to the
                            Secretary of State ad interim
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-06-16">
                            <hi rendition="#italic">June 16, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I think that perhaps it
                    would not be wise to send the Collector’s report concerning the <hi
                        rendition="#italic">Lusitania</hi> to Great Britain for the use of the Court
                    of Inquiry, and that it would be better to ask the Treasury Department to supply
                    the British Ambassador with sworn statements of the customs officers covering
                    the particular points mentioned by him in his memorandum.</p>
                <p>In haste</p>
                <p>Cordially and sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Woodrow Wilson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
