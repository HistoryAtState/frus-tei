    <text>
        <body>
            <div xml:id="d415">

                <pb facs="0536" n="468" sameAs="frus:frus1914-20v01/pg468"/>

                <note rend="inline" type="source">841.857 Ar 1/90½</note>
                <head>
                    <hi rendition="#italic">Mr. Rudolph Forster</hi> (<hi rendition="#italic"
                        >Executive Clerk to the President</hi>) <hi rendition="#italic">to the
                        Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-08-21">
                            <hi rendition="#italic">August 21, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Lansing</hi>: Mr. Tumulty has asked me to
                    send you a copy of a note which he dictated over the telephone this morning.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Rudolph Forster</hi>
                    </signed>
                </closer>



                <xi:include href="d415-a1.xml" xpointer="d415-a1"/>
