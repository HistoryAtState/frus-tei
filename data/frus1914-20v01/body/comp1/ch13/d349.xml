    <text>
        <body>
            <div xml:id="d349">

                <pb facs="0462" n="394" sameAs="frus:frus1914-20v01/pg394"/>

                <note rend="inline" type="source">763.72/1773½</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Counselor for the Department of State</hi> (<hi
                            rendition="#italic">Lansing</hi>)<anchor n="47"
                        xml:id="d349-f1"/>
                </head>
                <dateline>
                    <date ana="#date_undated-inferred-from-document-content" calendar="gregorian"
                        when="1915-05-12">undated</date>
                </dateline>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Lansing</hi>: I enclose a draft of note
                    to Germany drawn by the President.<anchor n="48" xml:id="d349-f2"/> He asks for
                    our suggestions. I wish you would prepare <hi rendition="#underline">at
                        once</hi> a draft embodying yours—I will submit mine in a letter to
                    accompany the draft when sent back to the President. I shall be detained here
                    for a while but will be down before your draft is completed.</p>
                <p>Yours</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d349-f1" n="47" type="source" xml:id="d349-f1-content">
                <p>This paper is undated; it bears the following notation in Lansing’s hand: “May
                    12/15 RL.”</p>
            </note>
            <note corresp="#d349-f2" n="48" xml:id="d349-f2-content">
