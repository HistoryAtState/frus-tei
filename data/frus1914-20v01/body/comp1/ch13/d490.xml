    <text>
        <body>
            <div xml:id="d490">

                <pb facs="0591" n="523" sameAs="frus:frus1914-20v01/pg523"/>

                <note rend="inline" type="source">841.857 L 97/130½</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to President Wilson </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-01-25">
                            <hi rendition="#italic">January 25, 1916</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. President</hi>: I enclose a memorandum
                    of a conference with the German Ambassador, which took place this afternoon. In
                    accordance with our understanding this morning you will see that I have delayed
                    matters in a measure and, at the same time, have practically broken off our
                    informal conversations—though I am to see him tomorrow morning.</p>
                <p>Faithfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>


                <xi:include href="d490-a1.xml" xpointer="d490-a1"/>
            </div>
        </body>
