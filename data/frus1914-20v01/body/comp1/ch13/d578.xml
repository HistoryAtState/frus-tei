    <text>
        <body>
            <div xml:id="d578">

                <pb facs="0677" n="609" xml:id="pg609"/>

                <note rend="inline" type="source">763.72/3353½</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to President Wilson </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-02-17">
                            <hi rendition="#italic">February 17, 1917</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. President</hi>: I send you a letter
                    which I have received from Doctor Kirchwey,<anchor n="12" xml:id="d578-f1"/> and
                    which I thought you would find of interest in connection with the activities of
                    the pacifists. Will you please return it after you have read it?</p>
                <p>Faithfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
