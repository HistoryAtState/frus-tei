    <text>
        <body>
            <div xml:id="d548">

                <pb facs="0644" n="576" sameAs="frus:frus1914-20v01/pg576"/>

                <note rend="inline" type="source">763.72/3105a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to President Wilson </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-01-03">
                            <hi rendition="#italic">January 3, 1917</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. President</hi>: I am sending you a
                    statement made by Mr. Arthur Page to Mr. Harrison, of this Department, and also
                    confidential reports on the <hi rendition="#italic">U–53</hi> and the German
                    submarine activities, which are furnished by the office of Naval
                    Intelligence.</p>
                <p>It will oblige me if you will return these to me after you have read them.</p>
                <p>Faithfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>




                <xi:include href="d548-a1.xml" xpointer="d548-a1"/>
