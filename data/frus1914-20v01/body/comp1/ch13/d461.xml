    <text>
        <body>
            <div xml:id="d461">

                <pb facs="0570" n="502" sameAs="frus:frus1914-20v01/pg502"/>

                <note rend="inline" type="source">763.72/2328½</note>
                <head>
                    <hi rendition="#italic">The German Ambassador</hi> (<hi rendition="#italic"
                        >Bernstorff</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">J. No. A 8326</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-12-20">
                            <hi rendition="#italic">December 20, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: With reference to
                    previous correspondence I beg to inform you that according to a wireless message
                    I received today, my Government has mailed explicit instructions to me which it
                    hopes will lead to an amicable settlement of the <hi rendition="#italic"
                        >Lusitania</hi> case.</p>
                <p>I remain [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">J. Bernstorff</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
