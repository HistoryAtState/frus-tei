    <text>
        <body>
            <div xml:id="d557">

                <pb facs="0659" n="591" sameAs="frus:frus1914-20v01/pg591"/>

                <note rend="inline" type="source">763.72/3312a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        President Wilson
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-02-02">
                            <hi rendition="#italic">February 2, 1917</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. President</hi>: I send you some
                        thoughts<anchor n="90" xml:id="d557-f1"/> on Germany’s broken promise and
                    the crime of submarine warfare, which I put down in writing last evening. These
                    express my real views, which of course are given no publicity.</p>
                <p>Faithfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d557-f1" n="90" xml:id="d557-f1-content">
                <p>There are no enclosures with the file copy of this letter; the reference is
