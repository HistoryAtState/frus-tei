    <text>
        <body>
            <div xml:id="d325">

                <pb facs="0434" n="366" sameAs="frus:frus1914-20v01/pg366"/>

                <note rend="inline" type="source">462.11 T 41/12½</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to President Wilson </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-04-03">
                            <hi rendition="#italic">April 3, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. President</hi>: I am sending you a
                    memorandum made by Mr. Lansing sometime ago. We have been holding it but in view
                        <pb facs="0435" n="367" xml:id="pg367"/> of the complication that may arise
                    from the <hi rendition="#italic">Pisa</hi> case I bring his suggestions before
                    you.</p>
                <p>With assurances [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. J. Bryan</hi>
                    </signed>
                </closer>



                <xi:include href="d325-a1.xml" xpointer="d325-a1"/>
                <xi:include href="d325-a2.xml" xpointer="d325-a2"/>
            </div>
