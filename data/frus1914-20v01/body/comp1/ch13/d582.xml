    <text>
        <body>
            <div xml:id="d582">

                <pb facs="0684" n="616" sameAs="frus:frus1914-20v01/pg616"/>

                <note rend="inline" type="source">763.72/3469½</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        President Wilson
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-03-08">
                            <hi rendition="#italic">March 8, 1917</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. President</hi>: I enclose a telegram
                    which I have just received from Honorable Richard Olney,<anchor n="16"
                        xml:id="d582-f1"/> and which I thought you might like to see.</p>
                <p>Faithfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>


                <xi:include href="d582-a1.xml" xpointer="d582-a1"/>
            </div>
        </body>
    </text>
