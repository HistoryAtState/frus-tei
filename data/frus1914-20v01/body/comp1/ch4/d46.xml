    <text>
        <body>
            <div xml:id="d46">

                <pb facs="0114" n="46" sameAs="frus:frus1914-20v01/pg46"/>

                <note rend="inline" type="source">763.72115/2633½</note>
                <head>
                    <hi rendition="#italic">President Wilson to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-12-03">
                            <hi rendition="#italic">3 December, 1916</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I thank you very much
                    for this. Would you be kind enough to answer these gentlemen to the effect you
                    suggest, as by reference from me? I would be very much obliged to you indeed if
                    you would. I think that the wisest way to handle the case.</p>
                <p>Faithfully Yours,</p>
                <closer>
                    <signed>W. W.</signed>
                </closer>
            </div>
        </body>
    </text>
