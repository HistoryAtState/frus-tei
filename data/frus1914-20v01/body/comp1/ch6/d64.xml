        <body>
            <div xml:id="d64">

                <pb facs="0146" n="78" sameAs="frus:frus1914-20v01/pg78"/>

                <note rend="inline" type="source">701.6211/281½</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to President Wilson
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-09-30">
                            <hi rendition="#italic">September 30, 1914</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. President</hi>: In accordance with the
                    request of the German Ambassador, I send you a copy of a letter which I have
                    just received from him.</p>
                <p>Will you please indicate what other steps, if any, you desire to have taken in
                    the matter?</p>
                <p>Very sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>


                <xi:include href="d64-a1.xml" xpointer="d64-a1"/>
            </div>
