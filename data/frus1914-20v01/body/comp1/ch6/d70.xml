    <text>
        <body>
            <div xml:id="d70">

                <pb facs="0151" n="83" sameAs="frus:frus1914-20v01/pg83"/>

                <note rend="inline" type="source">701.6311/151½</note>
                <head>
                    <hi rendition="#italic">President Wilson to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-09-15">
                            <hi rendition="#italic">15 September, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: Thank you for letting me
                    see this letter.<anchor n="10" xml:id="d70-f1"/> I hope, with you, that the
                    withdrawal of Dumba takes away the king pin from this structure of intrigue.</p>
                <p>Faithfully Yours,</p>
                <closer>
                    <signed>W. W.</signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d70-f1" n="10" xml:id="d70-f1-content">
                <p>From a New York lady complaining of Ambassador Dumba’s conduct. Not printed.</p>
            </note>
        </listAnnotation>
    </standOff>
