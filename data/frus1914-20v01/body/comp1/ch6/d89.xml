    <text>
        <body>
            <div xml:id="d89">

                <pb facs="0167" n="99" sameAs="frus:frus1914-20v01/pg99"/>

                <note rend="inline" type="source">702.6211/267½</note>
                <head>
                    <hi rendition="#italic">President Wilson to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-01-24">
                            <hi rendition="#italic">24 January, 1917</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I hope I may say without
                    impropriety that I have signed the enclosed with real pleasure.<anchor n="35"
                        xml:id="d89-f1"/>
                </p>
                <p>Faithfully Yours,</p>
                <closer>
                    <signed>W. W.</signed>
                </closer>
            </div>
        </body>
    </text>
