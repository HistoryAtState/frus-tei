    <text>
        <body>
            <div xml:id="d88">

                <pb facs="0167" n="99" sameAs="frus:frus1914-20v01/pg99"/>

                <note rend="inline" type="source">702.6211/265c</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to President Wilson </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-01-22">
                            <hi rendition="#italic">January 22, 1917</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. President</hi>: I am sending you
                    herewith for your signature, the formal revocation and annulment of the
                    exequatur issued to Mr. Franz Bopp as Consul General of Germany at San
                        Francisco.<anchor n="34" xml:id="d88-f1"/>
                </p>
                <p>With assurances [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d88-f1" n="34" xml:id="d88-f1-content">
                <p>For correspondence previously printed concerning this case, see <ref
                        target="frus1916Supp#pg_597">
                        <hi rendition="#italic">ibid.</hi>, 1917, supp. 1, pp. 597 ff</ref>.</p>
            </note>
