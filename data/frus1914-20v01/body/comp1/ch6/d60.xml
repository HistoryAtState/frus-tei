    <text>
        <body>
            <div xml:id="d60">

                <pb facs="0142" n="74" sameAs="frus:frus1914-20v01/pg74"/>

                <note rend="inline" type="source">701.6711/95a</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to President Wilson
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-09-22">
                            <hi rendition="#italic">September 22, 1914</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. President</hi>: I enclose a draft telegram
                    to Mr. Morgenthau, which I propose to send if it meets with your approval. I
                    think in case you do approve, it should be sent immediately.<anchor n="2"
                        xml:id="d60-f1"/>
                </p>
                <p>Very sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>


                <xi:include href="d60-a1.xml" xpointer="d60-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d60-f1" n="2" xml:id="d60-f1-content">
                <p>This paper bears the notation: “Telegram approved by Prest and sent 9 [<hi
                        rendition="#italic">10</hi>] pm Sept 22/14 RL.”</p>
            </note>
        </listAnnotation>
