    <text>
        <body>
            <div xml:id="d5">

                <pb facs="0073" n="5" sameAs="frus:frus1914-20v01/pg5"/>

                <note rend="inline" type="source">763.72111/88½</note>
                <head>
                    <hi rendition="#italic">President Wilson to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-08-17">
                            <hi rendition="#italic">August 17, 1914</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I am returning the
                    enclosed papers<anchor n="10" xml:id="d5-f1"/> because it is evidently too late
                    to pursue the course suggested by them. Things have developed very fast in the
                    East since you were kind enough to submit them to me.</p>
                <p>Cordially and faithfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Woodrow Wilson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d5-f1" n="10" xml:id="d5-f1-content">
                <p>See Mr. Lansing’s memorandum of Aug. 7, 1914, <ref target="#pg1">p. 1</ref>, and
                    his letter of Aug. 14, 1914, to the Secretary of State, <ref target="#pg3">p.
                        3</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
