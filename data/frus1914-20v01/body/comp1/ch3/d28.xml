    <text>
        <body>
            <div xml:id="d28">

                <pb facs="0096" n="28" sameAs="frus:frus1914-20v01/pg28"/>

                <note rend="inline" type="source">763.72111/285½</note>
                <head>
                    <hi rendition="#italic">Mr. J. P. Tumulty</hi> (<hi rendition="#italic"
                        >Secretary to the President</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-09-30">
                            <hi rendition="#italic">September 30, 1914</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Secretary</hi>: I am herewith returning the
                    letter addressed to Mr. Lansing by Representative Flood, together with the copy
                    of H. Con. Res. 48.<anchor n="2" xml:id="d28-f1"/> The President does not think
                    it would be wise to report the resolution.<anchor n="3" xml:id="d28-f2"/>
                </p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">J. P. Tumulty</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d28-f1" n="2" xml:id="d28-f1-content">
                <p>
                    <hi rendition="#italic">Supra</hi>.</p>
            </note>
            <note corresp="#d28-f2" n="3" xml:id="d28-f2-content">
                <p>A memorandum attached to this paper reads: “10/3/14. Telephoned Mr. Flood Prest’s
                    view RL.”</p>
            </note>
        </listAnnotation>
    </standOff>
