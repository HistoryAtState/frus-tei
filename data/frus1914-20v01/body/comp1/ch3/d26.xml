    <text>
        <body>
            <div xml:id="d26">

                <pb facs="0095" n="27" sameAs="frus:frus1914-20v01/pg27"/>

                <note rend="inline" type="source">763.72111/82½</note>
                <head>
                    <hi rendition="#italic">President Wilson to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-08-27">
                            <hi rendition="#italic">August 27, 1914</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: Thank you sincerely for
                    having let me see the enclosed memorandum.<anchor n="1" xml:id="d26-f1"/> I
                    think that Mr. Lansing handled the matter in exactly the right way.</p>
                <p>Faithfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Woodrow Wilson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d26-f1" n="1" xml:id="d26-f1-content">
                <p>Memorandum by the Counselor for the Department of State, <hi rendition="#italic"
                        >supra</hi>.</p>
            </note>
