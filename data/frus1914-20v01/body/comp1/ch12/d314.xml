    <text>
        <body>
            <div xml:id="d314">

                <pb facs="0419" n="351" sameAs="frus:frus1914-20v01/pg351"/>

                <note rend="inline" type="source">763.72/2522</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        President Wilson
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-04-03">
                            <hi rendition="#italic">April 3, 1916</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. President</hi>: I enclose a proposed
                        letter<anchor n="42" xml:id="d314-f1"/> in reply to the rejection of our
                    proposal of January 18th, relative to the disarming of merchant vessels.</p>
                <p>I have already sent you a draft of a letter on this subject,<anchor n="43"
                        xml:id="d314-f2"/> and in the enclosed I have sought to meet your views on
                    the previous draft.</p>
                <p>Faithfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d314-f1" n="42" xml:id="d314-f1-content">
                <p>No copy of this draft found in Department files.</p>
            </note>
            <note corresp="#d314-f2" n="43" xml:id="d314-f2-content">
                <p>
                    <hi rendition="#italic">Ante</hi>, <ref target="#pg350">p. 350</ref>.</p>
