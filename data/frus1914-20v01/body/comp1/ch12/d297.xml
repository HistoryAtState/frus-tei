            <div xml:id="d297">

                <pb facs="0405" n="337" xml:id="pg337"/>

                <note rend="inline" type="source">763.72/2371½</note>
                <head>
                    <hi rendition="#italic">The German Embassy to the
                            Department of State
                    </hi>
                </head>
                <p rendition="#flush">J. Nr. A 627</p>
                <p>The Imperial German Embassy presents its compliments to the United States
                    Department of State and has the honor to enclose herewith one wireless cipher
                    message, in duplicate, to the Foreign Office in Berlin for kind transmission to
                    the Tuckerton Station.</p>
                <p>Duplicate copies of the message in plain English are likewise enclosed.</p>
                <dateline rendition="#flush">
                    <placeName>
                        <hi rendition="#small-caps">Washington</hi></placeName>, <date
                        calendar="gregorian" when="1916-01-26">
                        <hi rendition="#italic">January 26, 1916</hi>.</date>
                </dateline>


                <xi:include href="d297-a1.xml" xpointer="d297-a1"/>
