    <text>
        <body>
            <div xml:id="d302">

                <pb facs="0408" n="340" xml:id="pg340"/>

                <note rend="inline" type="source">763.72/2374½</note>
                <head>
                    <hi rendition="#italic">The German Embassy to the Department of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">A 936</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-02-09">
                            <hi rendition="#italic">February 9, 1916</hi>.</date>
                    </dateline>
                </opener>
                <p>The Imperial German Embassy presents its compliments to the United States
                    Department of State and has the honor to enclose herewith two wireless cipher
                    messages in duplicate, to the Foreign Office in Berlin for kind transmission to
                    the Tuckerton Radio Station.</p>
                <p>Duplicate copies of the text of the messages are likewise enclosed.</p>



                <xi:include href="d302-a1.xml" xpointer="d302-a1"/>
                <xi:include href="d302-a2.xml" xpointer="d302-a2"/>
