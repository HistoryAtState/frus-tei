    <text>
        <body>
            <div xml:id="d163">

                <pb facs="0227" n="159" sameAs="frus:frus1914-20v01/pg159"/>

                <note rend="inline" type="source">763.72112/287½</note>
                <head>
                    <hi rendition="#italic">President Wilson to the Acting Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-10-28">
                            <hi rendition="#italic">October 28, 1914</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Lansing</hi>: Thank you for having let
                    me see the enclosed campaign sheet.<anchor n="11" xml:id="d163-f1"/> It is not,
                    however worthy of attention.</p>
                <p>Cordially and faithfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Woodrow Wilson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
