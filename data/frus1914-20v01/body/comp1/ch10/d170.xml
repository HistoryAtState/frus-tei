    <text>
        <body>
            <div xml:id="d170">

                <pb facs="0250" n="182" xml:id="pg182"/>

                <note rend="inline" type="source">763.72111/1333½</note>
                <head>
                    <hi rendition="#italic">President Wilson to the Counselor for the Department of
                        State</hi> (<hi rendition="#italic">Lansing</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-12-14">
                            <hi rendition="#italic">December 14, 1914</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Lansing</hi>: Thank you very warmly for
                    the trouble you have taken in sending a full reply to my inquiry about the
                    telegram from Messrs. Fuller, Tracy, and Coudert. I now feel fully fortified in
                    the matter.</p>
                <p>Cordially and faithfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Woodrow Wilson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
