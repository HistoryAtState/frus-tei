    <text>
        <body>
            <div xml:id="d206">

                <pb facs="0291" n="223" xml:id="pg223"/>

                <note rend="inline" type="source">763.72111 Ap 4/48½</note>
                <head>
                    <hi rendition="#italic">President Wilson to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-03-01">
                            <hi rendition="#italic">1 March, 1916</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I have looked this paper
                    through very carefully, and do not see how we could have taken any other
                    position.</p>
                <p>I return the papers to you at once, as you requested.</p>
                <p>Faithfully Yours,</p>
                <closer>
                    <signed>W. W.</signed>
                </closer>
            </div>
        </body>
    </text>
