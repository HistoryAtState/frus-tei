    <text>
        <body>
            <div xml:id="d194">

                <pb facs="0283" n="215" sameAs="frus:frus1914-20v01/pg215"/>

                <note rend="inline" type="source">768.72111/1960</note>
                <head>
                    <hi rendition="#italic">President Wilson to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-04-03">
                            <hi rendition="#italic">3 April, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I think that Mr. Lansing
                    has stated the case truly and conclusively. It is my own judgment that we could
                    not have adopted any other course consistently with our obligations as
                    neutrals.</p>
                <p>Faithfully Yours,</p>
                <closer>
                    <signed>W. W.</signed>
                </closer>
            </div>
        </body>
    </text>
