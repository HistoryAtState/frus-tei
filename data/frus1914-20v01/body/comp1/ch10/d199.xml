    <text>
        <body>
            <div xml:id="d199">

                <pb facs="0285" n="217" sameAs="frus:frus1914-20v01/pg217"/>

                <note rend="inline" type="source">763.72111/3139</note>
                <head>
                    <hi rendition="#italic">President Wilson to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-11-17">
                            <hi rendition="#italic">17 November, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I think this reply to
                    the German Ambassador altogether the right one, and take pleasure in returning
                    it with my entire approval.</p>
                <p>Faithfully Yours,</p>
                <closer>
                    <signed>W. W.</signed>
                </closer>
            </div>
        </body>
    </text>
