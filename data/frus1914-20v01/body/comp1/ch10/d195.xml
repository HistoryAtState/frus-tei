    <text>
        <body>
            <div xml:id="d195">

                <pb facs="0283" n="215" sameAs="frus:frus1914-20v01/pg215"/>

                <note rend="inline" type="source">763.72111/2082</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to President Wilson
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-04-10">
                            <hi rendition="#italic">April 10, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. President</hi>: I enclose a reply to the
                    German Ambassador relative to the refusal to clear the German steamship <hi
                        rendition="#italic">Pisa</hi>.<anchor n="58" xml:id="d195-f1"/> If it meets
                    with your approval kindly return it to me for transmittal.</p>
                <p>Very sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d195-f1" n="58" xml:id="d195-f1-content">
                <p>For the reply as sent, see <ref target="frus1915Supp#pg_861">
                        <hi rendition="#italic">Foreign Relations</hi>, 1915, supp., p.
                    861</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
