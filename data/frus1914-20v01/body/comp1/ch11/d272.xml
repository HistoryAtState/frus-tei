            <div xml:id="d272">

                <pb facs="0377" n="309" sameAs="frus:frus1914-20v01/pg309"/>

                <note rend="inline" type="source">841.711/488½</note>
                <head>
                    <hi rendition="#italic">President Wilson to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-05-22">
                            <hi rendition="#italic">22 May, 1916</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I have just been able to
                    complete my careful reading of this note, and hasten to return it to you for
                    transmission. I have made a few alterations in the verbiage which seem to me to
                    make it clearer.</p>
                <p>I hope that you are feeling a great deal better. We missed you at the Cabinet
                    Friday very much.</p>
                <p>Faithfully Yours,</p>
                <closer>
                    <signed>W. W.</signed>
                </closer>
            </div>
        </body>
    </text>
