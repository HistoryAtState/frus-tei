    <text>
        <body>
            <div xml:id="d220">

                <pb facs="0317" n="249" sameAs="frus:frus1914-20v01/pg249"/>

                <note rend="inline" type="source">763.72112/181</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1914-09-29">
                            <hi rendition="#italic">September 29, 1914</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Secretary</hi>: I prepared this
                        instruction<anchor n="7" xml:id="d220-f1"/> with the idea that it be sent at
                    once so that it could be in Ambassador Page’s hands in case his informal
                    representations failed. My idea was to avoid any criticism of the Administration
                    for failure to protest promptly against infringement of American rights. The
                    President, however, thought it would be better to await the result of the
                    telegraphic instruction of last night<anchor n="8" xml:id="d220-f2"/> which was
                    based on the annexed.<anchor n="7" xml:id="d220-f3"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
