    <text>
        <body>
            <div xml:id="d227">

                <pb facs="0324" n="256" sameAs="frus:frus1914-20v01/pg256"/>

                <note rend="inline" type="source">763.72112/242½a</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to President Wilson </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-10-23">
                            <hi rendition="#italic">October 23, 1914</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. President</hi>: In view of the fact that we
                    have notified Great Britain that our suggestion as to the adoption of the
                    Declaration of London is withdrawn and that this Government will stand upon its
                    rights as defined by the existing rules of International Law, should we not give
                    a similar notice to the other belligerent governments stating as a reason for
                    the withdrawal of the suggestion the <pb facs="0325" n="257" xml:id="pg257"/>
                    unwillingness of some [of] the belligerents to accept the Declaration without
                        modification?<anchor n="22" xml:id="d227-f1"/>
                </p>
                <p>Very sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d227-f1" n="22" xml:id="d227-f1-content">
                <p>This paper bears the notation: “Yes; by all means. W. W.”</p>
            </note>
        </listAnnotation>
    </standOff>
