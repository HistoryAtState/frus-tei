    <text>
        <body>
            <div xml:id="d240">

                <pb facs="0347" n="279" sameAs="frus:frus1914-20v01/pg279"/>

                <note rend="inline" type="source">763.72112/979½</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to President Wilson </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-03-22">
                            <hi rendition="#italic">March 22, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. President</hi>: I am sending you a
                    memorandum on the Order in Council which Mr. Lansing prepared before he received
                    your memorandum covering the details of the reply. Mr. Lansing has carefully
                    examined the memorandum which you sent over and is preparing a suggestion which
                    I will send you this evening, but I thought you might be interested in reading
                    the enclosed.</p>
                <p>With assurances [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. J. Bryan</hi>
                    </signed>
                </closer>



                <xi:include href="d240-a1.xml" xpointer="d240-a1"/>
            </div>
        </body>
    </text>
