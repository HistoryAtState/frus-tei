    <text>
        <body>
            <div xml:id="d614">

                <pb facs="0726" n="658" sameAs="frus:frus1914-20v01/pg658"/>

                <note rend="inline" type="source">763.72/2804½</note>
                <head>
                    <hi rendition="#italic">President Wilson to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-06-21">
                            <hi rendition="#italic">21 June, 1916</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: Thank you very much for
                    having let me see the enclosed very interesting letter.<anchor n="3"
                        xml:id="d614-f1"/> I dare say that it is now very much out of date because
                    of the Russian successes and of the altered aspect of the fight in the North
                    Sea.</p>
                <p>Faithfully Yours,</p>
                <closer>
                    <signed>W. W.</signed>
                </closer>
            </div>
        </body>
    </text>
