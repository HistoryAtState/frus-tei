    <text>
        <body>
            <div xml:id="d616">

                <pb facs="0727" n="659" sameAs="frus:frus1914-20v01/pg659"/>

                <note rend="inline" type="source">763.72/2833½</note>
                <head>
                    <hi rendition="#italic">President Wilson to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-07-27">
                            <hi rendition="#italic">27 July, 1916</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: Thank you for letting me
                    see this letter from Penfield. He always says something that it is useful to
                    keep in mind.</p>
                <p>Faithfully yours,</p>
                <closer>
                    <signed>W. W.</signed>
                </closer>
            </div>
        </body>
    </text>
