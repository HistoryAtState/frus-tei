    <text>
        <body>
            <div xml:id="d689">

                <pb facs="0810" n="742" sameAs="frus:frus1914-20v01/pg742"/>

                <note rend="inline" type="source">811.00/19½</note>
                <head>
                    <hi rendition="#italic">President Wilson to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-12-26">
                            <hi rendition="#italic">26 December, 1916</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I have read this letter
                    with a great deal of interest. Mr. Page had written me one in which he said many
                    of the same things, but this letter is fuller and more definite and contains
                    some items that are quite significant.</p>
                <p>Faithfully Yours,</p>
                <closer>
                    <signed>W. W.</signed>
                </closer>
            </div>
        </body>
    </text>
