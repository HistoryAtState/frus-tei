    <text>
        <body>
            <div xml:id="d18">

                <pb facs="0083" n="15" sameAs="frus:frus1914-20v01/pg15"/>

                <note rend="inline" type="source">763.72/2691½</note>
                <head>
                    <hi rendition="#italic">President Wilson to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-05-15">
                            <hi rendition="#italic">15 May, 1916</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: This is the
                    communication from the Pope to which I referred the other day. I would value
                    your suggestion as to the manner and substance of my reply.</p>
                <p>Faithfully Yours,</p>
                <closer>
                    <signed>W. W.</signed>
                </closer>
                <postscript>
                    <p>It was brought to the Office by the Apostolic Delegate.</p>
                </postscript>


                <xi:include href="d18-a1.xml" xpointer="d18-a1"/>
            </div>
