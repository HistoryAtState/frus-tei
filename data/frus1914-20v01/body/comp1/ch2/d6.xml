    <text>
        <body>
            <div xml:id="d6">

                <pb facs="0074" n="6" sameAs="frus:frus1914-20v01/pg6"/>

                <note rend="inline" type="source">763.72119/36½</note>
                <head>
                    <hi rendition="#italic">President Wilson to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-08-21">
                            <hi rendition="#italic">August 21, 1914</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: Here is something which
                    looks to me very dangerous. I enclose a copy of the telegram which I sent in
                    reply and hand them both over for your thought pending an answer.</p>
                <p>Cordially and faithfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Woodrow Wilson</hi>
                    </signed>
                </closer>



                <xi:include href="d6-a1.xml" xpointer="d6-a1"/>
