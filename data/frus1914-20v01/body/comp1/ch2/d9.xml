    <text>
        <body>
            <div xml:id="d9">

                <pb facs="0076" n="8" sameAs="frus:frus1914-20v01/pg8"/>

                <note rend="inline" type="source">763.72119/35½</note>
                <head>
                    <hi rendition="#italic">President Wilson to the
                        Acting Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-09-17">
                            <hi rendition="#italic">September 17, 1914</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Lansing</hi>: I had a short interchange
                    of views with the Secretary of State last evening over the telephone about the
                    enclosed dispatch from the German Chancellor.<anchor n="3" xml:id="d9-f1"/> My
                    own judgment is that it needs for the time, at any rate, no reply from us. I
                    wonder if your judgment is the same?</p>
                <p>Cordially and sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Woodrow Wilson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d9-f1" n="3" xml:id="d9-f1-content">
                <p>See telegram No. 149, Sept. 14, 1914, from the Ambassador in Germany, <ref
                        target="frus1914Supp#pg_104">
                        <hi rendition="#italic">Foreign Relations</hi>, 1914, supp., p.
                    104</ref>.</p>
            </note>
