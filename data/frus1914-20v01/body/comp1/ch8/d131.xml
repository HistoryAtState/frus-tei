    <text>
        <body>
            <div xml:id="d131">

                <pb facs="0198" n="130" sameAs="frus:frus1914-20v01/pg130"/>

                <note rend="inline" type="source">763.72111 Em 1/34½</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Germany</hi> (<hi rendition="#italic">Gerard</hi>) <hi rendition="#italic"
                        >to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berlin</hi></placeName>, <date
                            calendar="gregorian" when="1915-09-14">
                            <hi rendition="#italic">September 14, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: Congratulations on your
                    Austrian arms note. It is a beautiful piece of work.</p>
                <p>Enclosed tribute to your policy in a German paper may interest you.<anchor n="40"
                        xml:id="d131-f1"/> It is written by a friend of mine. (Not a German Viereck
                    or Marcus Braun<anchor n="41" xml:id="d131-f2"/>).</p>
                <p>Yours ever,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">James W. Gerard</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
