    <text>
        <body>
            <div xml:id="d108">

                <pb facs="0184" n="116" sameAs="frus:frus1914-20v01/pg116"/>

                <note rend="inline" type="source">763.72111 Em 1/11½</note>
                <head>
                    <hi rendition="#italic">President Wilson to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-12-26">
                            <hi rendition="#italic">26 December, 1914</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I think the enclosed
                        reply<anchor n="11" xml:id="d108-f1"/> to the memorandum of the German
                    Government both sound and conclusive, and I sincerely hope that you will be
                    able, as you suggest, to obtain the consent of the German Government to the
                    publication of this correspondence.</p>
                <p>Cordially and faithfully Yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Woodrow Wilson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
