    <text>
        <body>
            <div xml:id="d130">

                <pb facs="0198" n="130" xml:id="pg130"/>

                <note rend="inline" type="source">812.00/15871½</note>
                <head>
                    <hi rendition="#italic">President Wilson to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-08-21">
                            <hi rendition="#italic">21 August, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: Thank you for having let
                    me see the enclosed letters.</p>
                <p>Mr. Bryan’s praise of the Austrian note takes me, I admit, a little by surprise.
                    I am sincerely glad he thinks as he does about it.</p>
                <p rendition="#center">. . . . . . . . . . . . . . . .</p>
                <p>Faithfully Yours,</p>
                <closer>
                    <signed>W. W.</signed>
                </closer>
            </div>
        </body>
    </text>
