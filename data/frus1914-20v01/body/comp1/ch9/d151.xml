    <text>
        <body>
            <div xml:id="d151">

                <pb facs="0216" n="148" sameAs="frus:frus1914-20v01/pg148"/>

                <note rend="inline" type="source">811.51/2624</note>
                <head>
                    <hi rendition="#italic">President Wilson to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-09-15">
                            <hi rendition="#italic">15 September, 1915</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: This is a most
                    extraordinary letter.<anchor n="21" xml:id="d151-f1"/> I am sure you know how to
                    handle it. I am much obliged to you for letting me see it.</p>
                <p>Faithfully Yours,</p>
                <closer>
                    <signed>W. W.</signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
