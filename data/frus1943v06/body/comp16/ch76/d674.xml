    <text>
        <body>
            <div xml:id="d674">

                <pb facs="0818" n="804" sameAs="frus:frus1943v06/pg804"/>

                <note rend="inline" type="source">811.20 Defense(M)/12671: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Venezuela</hi> (<hi rendition="#italic">Corrigan</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Caracas</hi></placeName>, <date calendar="gregorian"
                            when="1943-04-02T16:00:00-04:30">April 2, 1943—4
                        p.m.</date><lb/>[Received 10:20 p.m.]</dateline>
                </opener>
                <p>332. Department’s 126 [<hi rendition="#italic">176</hi>], March 12 [<hi
                        rendition="#italic">11</hi>], 10 p.m. Foreign Minister<anchor n="37"
                        xml:id="d674-f1"/> has just advised me in formal note that Venezuelan
                    Government will be very glad to have representative of Cinchona Unit of Board of
                    Economic Warfare come to Venezuela for purpose indicated and to accord him all
                    possible facilities.</p>
                <closer><signed><hi rendition="#small-caps">Corrigan</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d674-f1" n="37" xml:id="d674-f1-content">
                <p>Caracciolo Parra Pérez.</p>
            </note>
        </listAnnotation>
    </standOff>
