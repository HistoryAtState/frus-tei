            </note>
            <note corresp="#d132-f2" n="18" xml:id="d132-f2-content">
                <p>Ramón Zaydín.</p>
            </note>
            <note corresp="#d132-f3" n="19" xml:id="d132-f3-content">
                <p>Emeterio Santovenia replaced José A. Martínez-Viademonte as Foreign Minister on
                    March 6.</p>
            </note>
        </listAnnotation>
