            <div xml:id="d147">

                <pb facs="0169" n="155" sameAs="frus:frus1943v06/pg155"/>

                <note rend="inline" type="source">837.61351/3608</note>
                <head><hi rendition="#italic">The Under Secretary of State</hi> (<hi
                        rendition="#italic">Welles</hi>) <hi rendition="#italic">to the Ambassador
                        in Cuba</hi> (<hi rendition="#italic">Braden</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1943-01-27">January 27, 1943</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Dear Spruille</hi>: I enclose herewith a letter for
                    delivery to President Batista at the same time that you discuss with him our
                    final sugar proposal. I understand of course that this will not be done until we
                    are able to give you final clearance from here.</p>
                <p>Sincerely yours,</p>
                <closer>[<signed><hi rendition="#small-caps">Sumner Welles</hi></signed>]</closer>


                <xi:include href="d147-a1.xml" xpointer="d147-a1"/>
