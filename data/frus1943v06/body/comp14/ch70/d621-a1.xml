            <div xml:id="d621-a1">

                <pb facs="0765" n="751" sameAs="frus:frus1943v06/pg751"/>

                <opener>
                    <seg rendition="#center">[Enclosure]</seg>
                </opener>
                <head><hi rendition="#small-caps">Peruvian External Funded Debt December</hi> 31,
                    1942</head>
                <p rendition="#center"><hi rendition="#small-caps">DOLLAR DEBT</hi></p>
                <table cols="4" rows="6">
                    <row>
                        <cell/>
                        <cell cols="3" rendition="#float-right"><hi rendition="#italic">Amount
                                Outstanding</hi></cell>
                    </row>
                    <row>
                        <cell/>
                        <cell/>
                        <cell role="num"><hi rendition="#italic">Dollars</hi></cell>
                        <cell role="num"><hi rendition="#italic">Soles</hi></cell>
                    </row>
                    <row>
                        <cell rendition="#top" role="num">1.</cell>
                        <cell rendition="#hanging-indent">Tobacco loan, 7%, 1927–1959. (Republic of
                            Peru—Secured 7% Sinking Fund Gold Bonds of 1927) Amount issued
                            $15,000,000 in bearer bonds of $500 and $1000.</cell>
                        <cell rendition="#bottom" role="num">8,728,000</cell>
                        <cell rendition="#bottom" role="num">31,173,884.88</cell>
                    </row>
                    <pb facs="0766" n="752" xml:id="pg752"/>
                    <row>
                        <cell rendition="#top" role="num">2.</cell>
                        <cell rendition="#hanging-indent">National Loan First Series 6%, 1927–1960.
                            (Republic of Peru, 6% External Sinking Fund Gold Bonds.) Amount issued
                            $50,000,000, in bearer bonds of $500 and $1000.</cell>
                        <cell rendition="#bottom" role="num">48,367,000</cell>
                        <cell rendition="#bottom" role="num">172,752,897.57</cell>
                    </row>
                    <row>
                        <cell rendition="#top" role="num">3.</cell>
                        <cell rendition="#hanging-indent">National Loan, Second Series 6%,
                            1928–1961. (Peruvian National Loan 6% External Sinking Fund Bonds)
                            Amount issued $25,000,000 in bonds of $500 and $1000.</cell>
                        <cell rendition="#bottom #underline" role="num">24,452,500</cell>
                        <cell rendition="#bottom #underline" role="num">87,337,238.78</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell rendition="#center">Total dollar debt</cell>
                        <cell rendition="#bottom" role="num">81,547,500</cell>
                        <cell rendition="#bottom" role="num">291,264,021.23</cell>
                    </row>
                </table>
                <p rendition="#center">STERLING DEBT</p>
                <table cols="4" rows="9">
                    <row>
                        <cell/>
                        <cell/>
                        <cell role="num"><hi rendition="#italic">Sterling</hi></cell>
                        <cell role="num"><hi rendition="#italic">Soles</hi></cell>
                    </row>
                    <row>
                        <cell rendition="#top" role="num">4.</cell>
                        <cell rendition="#hanging-indent">Provincial Council of Lima loan of 1911,
                            5% First Mortgage Bonds. Amount issued £600,000 in bearer bonds of
                            £100.</cell>
                        <cell rendition="#bottom" role="num">483,900</cell>
                        <cell rendition="#bottom" role="num">8,411,115.93</cell>
                    </row>
                    <row>
                        <cell rendition="#top" role="num">5.</cell>
                        <cell rendition="#hanging-indent">Peruvian Government, 7–½% (reduced to 4%)
                            Guano Loan 1922–1948. Amount issued £1,250,000 in bearer bonds of
                            £100.</cell>
                        <cell rendition="#bottom" role="num">706,300</cell>
                        <cell rendition="#bottom" role="num">12,276,857.16</cell>
                    </row>
                    <row>
                        <cell rendition="#top" role="num">6.</cell>
                        <cell rendition="#hanging-indent">Peruvian National Loan 6% External Sinking
                            Fund Bond—Second Series. Amount issued £2,000,000 in bearer bonds of
                            £100, £500 and £1,000.</cell>
                        <cell rendition="#bottom #underline" role="num">1,958,200</cell>
                        <cell rendition="#bottom #underline" role="num">34,037,295.33</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell/>
                        <cell rendition="#bottom" role="num">3,148,400</cell>
                        <cell rendition="#bottom" role="num">54,725,268.42</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell rendition="#center">Plus dollar debt</cell>
                        <cell/>
                        <cell rendition="#bottom" role="num">291,264,021.23</cell>
                    </row>
                    <row>
                        <cell cols="2" rendition="#hanging-indent">Interest arrears on external
                            funded debt in dollars.</cell>
                        <cell rendition="#bottom" role="num">$57,270,129.88</cell>
                        <cell rendition="#bottom" role="num">204,552,295.59</cell>
                    </row>
                    <row>
                        <cell cols="2" rendition="#hanging-indent">Interest arrears on external
                            funded debt in sterling</cell>
                        <cell rendition="#bottom" role="num">£1,589,151.17.0</cell>
                        <cell rendition="#bottom #underline" role="num">27,662,526.22</cell>
                    </row>
                    <row>
                        <cell cols="3"/>
                        <cell rendition="#bottom" role="num">578,204,111.46</cell>
                    </row>
                </table>
            </div>
