    <text>
        <body>
            <div xml:id="d22">

                <pb facs="0029" n="15" xml:id="pg15"/>

                <note rend="inline" type="source">811.20 Defense(M)Colombia/455</note>
                <head><hi rendition="#italic">The Ambassador in Colombia</hi> (<hi
                        rendition="#italic">Lane</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 1368</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Bogotá</hi></placeName>, <date calendar="gregorian"
                            when="1943-01-09">January 9, 1943</date>.<lb/>[Received January
                        15.]</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to refer to my telegram
                    No. 44 of January 9, 4 p.m., 1943,<anchor n="28" xml:id="d22-f1"/> and to
                    enclose copies of the draft note covering the strategic materials program and
                    the proposed operating agreement covering the rubber program which were the
                    subjects of the discussions outlined in my telegram under reference.</p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">Arthur Bliss Lane</hi></signed></closer>



                <xi:include href="d22-a1.xml" xpointer="d22-a1"/>
                <xi:include href="d22-a2.xml" xpointer="d22-a2"/>
