    <text>
        <body>
            <div xml:id="d91">

                <pb facs="0930" n="918" sameAs="frus:frus1919Parisv06/pg918"/>

                <note rend="inline" type="source">Paris Peace Conf. 185.12/58</note>
                <head><hi rendition="#italic">The President of the German Delegation</hi> (<hi rendition="#italic">Brockdorff-Rantzau</hi>) <hi
                        rendition="#italic">to the President of the Peace Conference</hi> (<hi rendition="#italic">Clemenceau</hi>)</head>
                <opener><seg rendition="#center">[Translation]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Versailles</hi></placeName>, <date calendar="gregorian"
                            when="1919-05-29">May 29, 1919</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Enclosed I beg to transmit to Your
                    Excellency a few observations on articles 259 and 263 of the Draft of the Treaty
                    of Peace.</p>
                <p>Accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps"
                    >Brockdorff-Rantzau</hi></signed></closer>




