    <text>
        <body>
            <div xml:id="d90">

                <pb facs="0914" n="902" sameAs="frus:frus1919Parisv06/pg902"/>

                <note rend="inline" type="source">Paris Peace Conf. 185.12/59</note>
                <head><hi rendition="#italic">The President of the German Delegation</hi> (<hi
                        rendition="#italic">Brockdorff-Rantzau</hi>) <hi rendition="#italic">to the
                        President of the Peace Conference</hi> (<hi rendition="#italic"
                        >Clemenceau</hi>)</head>
                <opener><seg rendition="#center">[Translation]<anchor n="1" xml:id="d90-f1"
                    /></seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Versailles</hi></placeName>, <date calendar="gregorian"
                            when="1919-05-29">May 29, 1919</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Mr. President</hi>: I have the honour to enclose
                    herewith for Your Excellency a statement of the Financial Commission of the
                    German Peace Delegation with reference to Parts VIII and IX of the Draft
                    Conditions of Peace. The German Peace Delegation supports the point of view of
                    the Financial Commission and adopts it as its own.</p>
                <p>Accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps"
                    >Brockdorff-Rantzau</hi></signed></closer>


                <xi:include href="d90-a1.xml" xpointer="d90-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d90-f1" n="1" xml:id="d90-f1-content">
                <p>The file translation here printed is one prepared at the Peace Conference, with
                    some minor corrections.</p>
            </note>
        </listAnnotation>
    </standOff>
