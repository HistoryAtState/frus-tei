    <text>
        <body>
            <div xml:id="d85-a1">

                <pb facs="0768" n="756" sameAs="frus:frus1919Parisv06/pg756"/>

                <head>Appendix I to CF–99</head>

                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Hohenfinow</hi></placeName>, <date calendar="gregorian"
                            when="1919-06-25">25 June, 1919</date>.</dateline></opener>
                <p rendition="#center">[<hi rendition="#italic">Herr Bethmann-Hollweg to the
                        President of the Peace Conference</hi> (<hi rendition="#italic"
                        >Clemenceau</hi>)]</p>
                <p rendition="#center">Translation</p>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honour to request that Your
                    Excellency will be <pb facs="0769" n="757" xml:id="pg757"/> so good as to bring
                    the annexed letter to the notice of the Governments of the Allied and Associated
                    Powers.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Bethmann-Hollweg</hi></signed></closer>
            </div>
        </body>
    </text>
