                <pb facs="0419" n="407" sameAs="frus:frus1919Parisv06/pg407"/>

                <head>Appendix IV to CF–65</head>
                <p rendition="#center"><hi rendition="#small-caps">labour committee</hi></p>
                <p rendition="#center">(<hi rendition="#italic">Note by Mr. Barnes</hi>)</p>
                <p>Meetings of the above Committee were held on the 3rd, 4th and 6th June. At these
                    meetings the accompanying resolutions were passed and the attached letter signed
                    by me was sent to the General Secretary of the Peace Conference.</p>
                <closer>
                    <signed>G. N. B[<hi rendition="#small-caps">arnes</hi>]</signed>
                    <lb/>
                    <dateline rendition="#float-left">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi>
                        </placeName>, <date calendar="gregorian" when="1919-06-06">June 6,
                            1919</date>.</dateline>
                </closer>
            </div>
        </body>
