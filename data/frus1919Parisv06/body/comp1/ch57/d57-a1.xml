    <text>
        <body>
            <div xml:id="d57-a1">

                <pb facs="0573" n="561" sameAs="frus:frus1919Parisv06/pg561"/>

                <head>Appendix I [to CF–76]<anchor n="4" xml:id="d57-f1"/></head>

                <opener><dateline rendition="#float-right"><hi rendition="#small-caps">German Peace
                            Delegation</hi>,<lb/><placeName><hi rendition="#small-caps"
                                >Versailles</hi></placeName>, <date calendar="gregorian"
                            when="1919-06-20">20 June 1919</date>.</dateline></opener>
                <p rendition="#flush">To Monsieur Clemenceau.</p>
                <p><hi rendition="#small-caps">Sir</hi>: In the name of the German Delegation I have
                    the honour to submit to the Allied &amp; Associated Governments the Note
                    contained in the attached Annex.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Haniel</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d57-f1" n="4" type="source" xml:id="d57-f1-content">
                <p>The document is headed “Translation from the French.”</p>
            </note>
        </listAnnotation>
