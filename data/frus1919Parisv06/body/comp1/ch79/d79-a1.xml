            <div xml:id="d79-a1">

                <pb facs="0733" n="721" sameAs="frus:frus1919Parisv06/pg721"/>

                <head>Appendix I to CF–95</head>
                <p rendition="#center"><hi rendition="#small-caps">treaty with poland</hi></p>
                <p>Poland agrees to assume responsibility for such proportion of the Russian public
                    debt and other Russian public liabilities of any kind as may be assigned to her
                    under a special convention between the principal Allied and Associated Powers on
                    the one hand and Poland on <pb facs="0734" n="722" xml:id="pg722"/> the other,
                    to be prepared by a commission appointed by the above States. In the event of
                    the Commission not arriving at an agreement the point at issue shall be referred
                    for immediate arbitration to the League of Nations.</p>
                <closer><dateline rendition="#float-left"><date calendar="gregorian"
                            when="1919-06-26">26 <hi rendition="#small-caps">June</hi>,
                        1919</date>.</dateline></closer>
            </div>
