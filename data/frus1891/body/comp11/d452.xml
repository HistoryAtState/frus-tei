    <text>
        <body>
            <div xml:id="d452">

                <pb facs="0620" n="514" sameAs="frus:frus1891/pg514"/>

                <head><hi rendition="#italic">Mr. Phelps to Mr.
                            Blaine</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Berlin</hi></placeName>, <date calendar="gregorian"
                            when="1891-07-06"><hi rendition="#italic">July 6, 1891</hi>.</date>
                        (Received July 16.)</dateline>
                    <seg rendition="#float-left"><hi rendition="#italic">No.
                    292</hi>.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a copy
                    of my note addressed to-day to the foreign office referring to the removal of
                    the restrictions on the importation of American pork, and to he, sir, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Wm. Walter
                    Phelps</hi>.</signed></closer>


                <xi:include href="d452-a1.xml" xpointer="d452-a1"/>
