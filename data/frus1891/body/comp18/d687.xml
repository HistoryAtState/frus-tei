        <body>
            <div xml:id="d687">

                <pb facs="0874" n="762" sameAs="frus:frus1891/pg762"/>

                <head><hi rendition="#italic">Mr. MacNutt to Mr. Blaine</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Legation</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1891-10-28"><hi rendition="#italic">October 28, 1891</hi>.</date>
                        (Received November 18.)</dateline>
                    <seg rendition="#float-left">No. 356.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In the case of Mr. Richardson, of Erzerum,
                    I have been asked by Bible House to forward to the Department the statement of
                    that gentleman, which I now have the honor to inclose.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Francis MacNutt</hi>,<lb/><hi
                            rendition="#italic">Chargé d’ Affaires ad
                    interim</hi>.</signed></closer>


                <xi:include href="d687-a1.xml" xpointer="d687-a1"/>
