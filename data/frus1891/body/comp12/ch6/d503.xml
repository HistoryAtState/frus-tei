    <text>
        <body>
            <div xml:id="d503">

                <pb facs="0684" n="576" sameAs="frus:frus1891/pg576"/>

                <head><hi rendition="#italic">Sir Julian Pauncefote
                        to Mr. Wharton</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >British Legation</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1891-06-27"><hi rendition="#italic">June 27,
                        1891</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of the 25th instant in relation to the proposed Behring Sea
                    arbitration, and to inform you that I transmitted a copy of it to the Marquis of
                    Salisbury by the mail of the 26th.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Julian
                    Pauncefote</hi>.</signed></closer>
            </div>
        </body>
    </text>
