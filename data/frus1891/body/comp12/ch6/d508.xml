    <text>
        <body>
            <div xml:id="d508">

                <pb facs="0692" n="584" sameAs="frus:frus1891/pg584"/>

                <head><hi rendition="#italic">Mr. Adee to Sir
                            Julian Pauncefote</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1891-07-08"><hi rendition="#italic">July 8,
                        1891</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge, with
                    thanks, the receipt of the copies of an act of Parliament relating to the
                    catching of seals by British ships in Behring Sea, and also of the copies of an
                    order of Her Britannic Majesty in council on the same subject that accompanied
                    your note of the 6th instant.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alvey A. Adee</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary</hi>.</signed></closer>
            </div>
        </body>
    </text>
