    <text>
        <body>
            <div xml:id="d579">

                <pb facs="0750" n="642" sameAs="frus:frus1891/pg642"/>

                <head><hi rendition="#italic">Mr. Wharton to Sir Julian Pauncefote</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1891-06-06"><hi rendition="#italic">June 6,
                        1892</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of the 2d instant, inclosing a copy of the instructions that have
                    been issued to commanders of Her Majesty’s vessels in Behring Sea, under the <hi
                        rendition="#italic">modus vivendi</hi>, and to inform you that a copy of the
                    same has been communicated to the Secretary of the Navy.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">William F. Wharton</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary</hi>.</signed></closer>
            </div>
        </body>
    </text>
