    <text>
        <body>
            <div xml:id="d578">

                <pb facs="0749" n="641" sameAs="frus:frus1891/pg641"/>

                <head><hi rendition="#italic">Sir Julian Pauncefote
                        to Mr. Blaine</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >British Legation</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1892-06-02"><hi rendition="#italic">June 2,
                        1892</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to previous correspondence
                    in regard to the enforcement of the <hi rendition="#italic">modus vivendi</hi>
                    in Behring Sea, I have the honor, in accordance with directions which I have
                    received from the Marquis of Salisbury, to transmit to you herewith copy of the
                    instructions which have been issued to commanders of Her Majesty’s vessels in
                    Behring Sea.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Julian
                    Pauncefote</hi>.</signed></closer>


                <xi:include href="d578-a1.xml" xpointer="d578-a1"/>
