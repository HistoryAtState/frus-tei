    <text>
        <body>
            <div xml:id="d22-a9">

                <pb facs="0134" n="28" sameAs="frus:frus1891/pg28"/>

                <opener><seg rendition="#center">[Inclosure 9 in No. 184.]</seg></opener>
                <head><hi rendition="#italic">Mr. Kranz to Mr. Grant</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Wicliczka</hi></placeName>, <date calendar="gregorian"
                            when="1891-08-13"><hi rendition="#italic">August 13,
                        1891</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Sir</hi>: Your kind favor of the 12th instant
                    duly received, for which accept my sincere thanks for your immediate action in
                    my case.</p>
                <p>I remain, etc.,</p>
                <closer><signed><hi rendition="#small-caps">J. Kranz</hi>.</signed></closer>
            </div>
        </body>
    </text>
