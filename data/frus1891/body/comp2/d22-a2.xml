    <text>
        <body>
            <div xml:id="d22-a2">

                <pb facs="0133" n="27" xml:id="pg27"/>

                <opener><seg rendition="#center">[Inclosure 2 in No. 184.]</seg></opener>
                <head><hi rendition="#italic">Mr. Grant to Mr.
                            Kranz</hi>.</head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <p>Comply with order to appear before enrollment board. Will move in your interest
                    at once with Government. Send me written particulars of your case, with passport
                    and naturalization paper.</p>
                <closer><signed><hi rendition="#small-caps">Grant</hi>,<lb/><hi rendition="#italic"
                            >American Minister</hi>.</signed></closer>
            </div>
        </body>
    </text>
