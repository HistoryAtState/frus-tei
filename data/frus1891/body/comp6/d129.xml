    <text>
        <body>
            <div xml:id="d129">

                <pb facs="0237" n="131" sameAs="frus:frus1891/pg131"/>

                <head><hi rendition="#italic">Mr. Wharton to Mr. Egan</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1891-05-28"><hi rendition="#italic">May 28,
                        1891</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 106.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to inclose, for your information,
                    copy of a letter from Mr. D. H. B. Davis, of Lima, Peru, stating that it is
                    rumored that you have advised the Government of Chile to grant letters of marque
                    to privateers as a war measure.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">William F. Wharton</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary</hi>.</signed></closer>


                <xi:include href="d129-a1.xml" xpointer="d129-a1"/>
