    <text>
        <body>
            <div xml:id="d284">

                <pb facs="0395" n="289" xml:id="pg289"/>

                <head><hi rendition="#italic">Mr. Egan to Mr.
                            Blaine</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Santiago</hi></placeName>, <date calendar="gregorian"
                            when="1891-01-18"><hi rendition="#italic">January 18, 1892</hi>.</date>
                        (Received March 2.)</dateline>
                    <seg rendition="#float-left">No. 263.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to send herewith a
                    translation of a very excellent review of the judge’s report, which was
                    published in one of the papers recently started in opposition to the Government,
                    El Progreso (inclosure No. 1), together with a translation of the fiseal’s
                    report on the case, cut from an English paper in Valparaiso (inclosure No.
                    2).</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Patrick Egan</hi>.</signed></closer>



                <xi:include href="d284-a1.xml" xpointer="d284-a1"/>
                <xi:include href="d284-a2.xml" xpointer="d284-a2"/>
