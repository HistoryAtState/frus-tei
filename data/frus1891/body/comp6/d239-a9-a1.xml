    <text>
        <body>
            <div xml:id="d239-a9-a1">

                <pb facs="0349" n="243" sameAs="frus:frus1891/pg243"/>

                <opener><seg rendition="#center">[Inclosure A.]</seg></opener>
                <head><hi rendition="#italic">Mr. Shields to Mr. McCreery</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Consulate of the United States</hi>,<lb/><hi rendition="#italic"
                                >Valparaiso</hi></placeName>, <date calendar="gregorian"
                            when="1891-11-20"><hi rendition="#italic">November 20,
                        1891</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith my claim for $5,000,
                    United States currency, against the Republic of Chile, which I will thank you to
                    send to the American minister at Santiago, with the request that he present the
                    same to the proper department of the Government for payment.</p>
                <p>Very respectfully,</p>
                <closer><signed><hi rendition="#small-caps">Patrick</hi> (his x mark) <hi
                            rendition="#small-caps"
                            >Shields</hi></signed><lb/>Witness:<lb/><signed><hi
                            rendition="#small-caps">J. P. Dunning</hi>.</signed></closer>
                <postscript>
                    <opener><dateline rendition="#float-right"><hi rendition="#small-caps">Consulate
                                of the United States</hi>,<lb/><placeName><hi rendition="#italic"
                                    >Valparaiso</hi></placeName>, <date calendar="gregorian"
                                when="1891-11-20"><hi rendition="#italic">November 20,
                                1891</hi></date>.</dateline></opener>
                    <p>Indorsed on back:</p>
                    <p>Respectfully referred to Hon. Patrick Egan, envoy extraordinary and minister
                        plenipotentiary of the United States at Santiago.</p>
                    <closer>[<hi rendition="#small-caps">seal</hi>.] <signed><hi
                                rendition="#small-caps">Wm. B. McCreery</hi>,<lb/><hi
                                rendition="#italic">United States Consul</hi>.</signed></closer>
                </postscript>
            </div>
        </body>
    </text>
