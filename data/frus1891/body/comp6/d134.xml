                <pb facs="0238" n="132" sameAs="frus:frus1891/pg132"/>

                <head><hi rendition="#italic">Mr. Egan to Mr. Blaine</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Santiago</hi></placeName>, <date calendar="gregorian"
                            when="1891-06-03"><hi rendition="#italic">June 3, 1891</hi>.</date>
                        (Received July 16.)</dateline>
                    <seg rendition="#float-left">No. 170.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge receipt of
                    your telegram of June 1, respecting the <hi rendition="#italic">Itata</hi>, on
                    yesterday, and have communicated the contents to the minister of foreign
                    relations.</p>
                <p>I remain, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Patrick Egan</hi>.</signed></closer>
            </div>
        </body>
    </text>
