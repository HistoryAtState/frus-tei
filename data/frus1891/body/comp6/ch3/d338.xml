    <text>
        <body>
            <div xml:id="d338">

                <pb facs="0453" n="347" sameAs="frus:frus1891/pg347"/>

                <head><hi rendition="#italic">Mr. Blaine to Señor
                            Pedro Montt</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1891-01-22"><hi rendition="#italic">January 22,
                        1892</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I am instructed by the President of the
                    United States to inclose to you a copy of a dispatch<anchor n="*"
                        xml:id="d338-f1"/> sent to Mr. Egan, our minister to Chile, last night.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">James G. Blaine</hi>.</signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d338-f1" n="*" xml:id="d338-f1-content">
                <p>For this inclosure see telegram to Mr. Egan of January 21.</p>
            </note>
        </listAnnotation>
    </standOff>
