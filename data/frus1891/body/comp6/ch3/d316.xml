                <pb facs="0430" n="324" sameAs="frus:frus1891/pg324"/>

                <head><hi rendition="#italic">Left with Secretary December 3, 1891, by Señor
                        Montt</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Santiago</hi></placeName>, <date calendar="gregorian"
                            when="1891-12-01"><hi rendition="#italic">December 1,
                        1891</hi></date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Pedro Montt</hi>,<lb/><hi
                        rendition="#italic">1329 M street, Washington, D. C.:</hi></p>
                <p>Preliminary examination not yet finished on account of proceedings necessary to
                    secure the statements of experts. Egan’s testimony was asked for twenty days
                    ago.</p>
                <closer><signed><hi rendition="#small-caps">Matta</hi>.</signed></closer>
            </div>
