    <text>
        <body>
            <div xml:id="d225-a1">

                <pb facs="0327" n="221" sameAs="frus:frus1891/pg221"/>

                <opener><seg rendition="#center">[Inclosure 1 in No. 223.]</seg></opener>
                <head><hi rendition="#italic">Mr. McCreery to Mr.
                            Egan</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Consulate of the United States</hi>,<lb/><hi rendition="#italic"
                                >Valparaiso</hi></placeName>, <date calendar="gregorian"
                            when="1891-11-04"><hi rendition="#italic">November 4,
                        1891</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith for your information
                    copy of a communication this day sent by me to the intendente of this province,
                    and also copy of a letter written by Stephen S. White, M. D., to Capt. Schley of
                    the U. S. S. <hi rendition="#italic">Baltimore</hi> and by him referred to
                    me.</p>
                <p>Very respectfully, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Wm. B. McCreery</hi>,<lb/><hi
                            rendition="#italic">United States Consul</hi></signed></closer>



                <xi:include href="d225-a1-a1.xml" xpointer="d225-a1-a1"/>
            </div>
        </body>
