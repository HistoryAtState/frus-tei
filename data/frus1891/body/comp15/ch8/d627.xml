    <text>
        <body>
            <div xml:id="d627">

                <pb facs="0778" n="670" sameAs="frus:frus1891/pg670"/>

                <head><hi rendition="#italic">Marquis Imperiali to Mr. Blaine</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of Italy</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1891-03-19"><hi rendition="#italic">March 19,
                        1891</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. Blaine</hi>: In compliance with your kind
                    request, I am instructed by Baron Fava to forward herewith to your excellency a
                    translation of the cablegram the minister has just received from the Marquis di
                    Rudini.</p>
                <p>Believe me, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Imperiali</hi>.</signed></closer>


                <xi:include href="d627-a1.xml" xpointer="d627-a1"/>
            </div>
