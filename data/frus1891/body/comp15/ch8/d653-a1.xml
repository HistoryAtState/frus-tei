    <text>
        <body>
            <div xml:id="d653-a1">

                <pb facs="0815" n="705" sameAs="frus:frus1891/pg705"/>

                <opener><seg rendition="#center">[Indorsement.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Office Superintendent of Police</hi></placeName>,<lb/><date
                            calendar="gregorian" when="1891-04-14"><hi rendition="#italic">April 14,
                                1891</hi></date>.</dateline></opener>
                <p>Deposition of Dan. Douglass and Mike Early, relative to the citizenship of an
                    Italian, Rocco Gerrachi, alias Francisco Gerrachi.</p>
                <p>Respectfully forwarded to his honor the mayor.</p>
                <closer><signed><hi rendition="#small-caps">D. F. Gaster</hi>,<lb/><hi
                            rendition="#italic">Superintendent of Police</hi>.</signed></closer>
            </div>
        </body>
    </text>
