    <text>
        <body>
            <div xml:id="d607">

                <pb facs="0769" n="661" xml:id="pg661"/>

                <head><hi rendition="#italic">Baron Fava to Mr. Blaine</hi>.</head>
                <opener><seg rendition="#center">[Personal.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of Italy</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1890-11-29"><hi rendition="#italic">November 29,
                        1890</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Blaine</hi>: I have just received from my
                    Government the note of which I have the honor to hand you a copy herewith
                    inclosed, and upon the subject of which I beg to be allowed to call your
                    attention and ask your kindest consideration.</p>
                <p>Thanking you in advance, I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Fava</hi>.</signed></closer>


                <xi:include href="d607-a1.xml" xpointer="d607-a1"/>
            </div>
