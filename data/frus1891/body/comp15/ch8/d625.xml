    <text>
        <body>
            <div xml:id="d625">

                <pb facs="0776" n="668" sameAs="frus:frus1891/pg668"/>

                <head><hi rendition="#italic">Baron Fava to Mr. Blaine</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of Italy</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1891-03-16"><hi rendition="#italic">March 16,
                        1891</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Blaine</hi>: You will greatly oblige me
                    in giving me kindly the friendly assurance that, according to my private note of
                    yesterday evening, you have instructed the United States legation in Rome to
                    communicate to the royal minister of the foreign office the text of your
                    telegram to the governor of Louisiana.</p>
                <p>Many thanks for the answer.</p>
                <p>Believe me, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Fava</hi>.</signed></closer>
            </div>
        </body>
    </text>
