    <text>
        <body>
            <div xml:id="d658">

                <pb facs="0826" n="714" xml:id="pg714"/>

                <head><hi rendition="#italic">Mr. Miller to Mr. Adee</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of Justice</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1891-05-19"><hi rendition="#italic">May 19,
                        1891</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Inclosed I hand you copy of the report of
                    the grand jury at New Orleans, which was sent to me in this form by the United
                    States attorney. This in reponse to your note of May 18 requesting the same.</p>
                <closer><signed><hi rendition="#small-caps">W. H. H. Miller</hi>,<lb/><hi
                            rendition="#italic">Attorney-General</hi>.</signed></closer>


                <xi:include href="d658-a1.xml" xpointer="d658-a1"/>
