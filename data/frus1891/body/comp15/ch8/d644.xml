    <text>
        <body>
            <div xml:id="d644">

                <pb facs="0788" n="680" sameAs="frus:frus1891/pg680"/>

                <head><hi rendition="#italic">Governor Nicholls to
                        Mr. Blaine</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Executive Department, State of Louisiana</hi>,<lb/><hi
                                rendition="#italic">Baton Rouge</hi></placeName>, <date
                            calendar="gregorian" when="1891-04-03"><hi rendition="#italic">April 3,
                                1891</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit to you
                    herewith the certificate from the registrar of voters alluded to by me in my
                    dispatch of this morning.</p>
                <p>Very respectfully,</p>
                <closer><signed><hi rendition="#small-caps">Francis T.
                    Nicholls</hi>.</signed></closer>



