    <text>
        <body>
            <div xml:id="d647-a9">

                <pb facs="0805" n="695" xml:id="pg695"/>

                <opener><seg rendition="#center">[Exhibit 8.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Custom-House, Collector’s Office</hi>,<lb/><hi rendition="#italic"
                                >New Orleans, La.</hi></placeName>, <date calendar="gregorian"
                            when="1891-04-17"><hi rendition="#italic">April 17,
                        1891</hi></date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#italic">To whom it may concern:</hi></p>
                <p>This is to certify that Pietro Monastero, aged 41 years, a native of Italy,
                    shoemaker by occupation, arrived at the port of New Orleans as a steerage
                    passenger on the steamship <hi rendition="#italic">Plata</hi>, from Palermo,
                    January 7th, 1890.</p>
                <closer>[<hi rendition="#small-caps">Seal</hi>.] <signed><hi rendition="#small-caps"
                            >F. Z. Eushm</hi>, (?)<lb/><hi rendition="#italic">Special Deputy
                            Collector</hi>.</signed></closer>
            </div>
        </body>
