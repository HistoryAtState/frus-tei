        <body>
            <div xml:id="d396">

                <pb facs="0558" n="452" sameAs="frus:frus1891/pg452"/>

                <head><hi rendition="#italic">Mr. Denby to Mr.
                            Blaine</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1891-10-24"><hi rendition="#italic">October 24, 1891</hi>.</date>
                        (Received November 28.)</dateline>
                    <seg rendition="#float-left">No. 1410.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inform you that I have
                    received from the foreign office a communication relating to the recent riots,
                    of which a copy is inclosed.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charles Denby</hi>.</signed></closer>


                <xi:include href="d396-a1.xml" xpointer="d396-a1"/>
