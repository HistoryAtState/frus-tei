    <text>
        <body>
            <div xml:id="d66-a3">

                <pb facs="0180" n="74" xml:id="pg74"/>

                <opener><seg rendition="#center">[Inclosure B.—Translation.]</seg></opener>
                <head><hi rendition="#italic">Blanco &amp; Trigueros to the commandant of La
                        Libertad</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps">La
                                Libertad</hi></placeName>, <date calendar="gregorian"
                            when="1891-08-08"><hi rendition="#italic">August,
                        1891</hi></date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#italic">To the Commandant of this
                    Port:</hi></p>
                <p>As the North American steamer <hi rendition="#italic">City of Panama</hi>, Capt.
                    White, from Panama, is prepared to continue her voyage to Acapulco, we request
                    you to grant the permit required by law.</p>
                <closer><signed><hi rendition="#small-caps">Blanco &amp;
                    Trigueros</hi>.</signed></closer>
            </div>
        </body>
    </text>
