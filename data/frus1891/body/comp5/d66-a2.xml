    <text>
        <body>
            <div xml:id="d66-a2">

                <pb facs="0179" n="73" sameAs="frus:frus1891/pg73"/>

                <opener><seg rendition="#center">[Inclosure A.]</seg></opener>
                <head><hi rendition="#italic">Copy of letter from agents received at 1:80
                    p.m</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps">La
                                Libertad</hi></placeName>, <date calendar="gregorian"
                            when="1891-08-08"><hi rendition="#italic">Augusts 08,
                        1891</hi></date>.</dateline></opener>
                <p rendition="#flush">Mr. <hi rendition="#small-caps">F. P. White</hi>,<lb/><hi
                        rendition="#italic">Commander of the Steamship City of Panama:</hi></p>
                <p><hi rendition="#small-caps">Dear Sir</hi>: We have the pleasure to inform you
                    that we have just been notified that the Government has allowed the work of
                    embarking and disembarking passengers and freight with the <hi
                        rendition="#italic">City of Panama</hi>, and that we therefore have ordered
                    all our lighters to proceed to the work, so that it may be done in the shortest
                    time possible.</p>
                <p>We are, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Blanco &amp;
                    Trigueros</hi>.</signed></closer>
            </div>
        </body>
    </text>
