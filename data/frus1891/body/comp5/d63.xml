    <text>
        <body>
            <div xml:id="d63">

                <pb facs="0175" n="69" sameAs="frus:frus1891/pg69"/>

                <head><hi rendition="#italic">Mr. Wharton to Mr.
                            Pacheco</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1891-08-13"><hi rendition="#italic">August 13,
                        1891</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 13.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose copies of communications in
                    reference to the demands of Salvador on the Pacific Mail steamer <hi
                        rendition="#italic">City of Panama</hi>, named below.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">William F. Wharton</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary</hi>.</signed></closer>



                <xi:include href="d63-a1.xml" xpointer="d63-a1"/>
