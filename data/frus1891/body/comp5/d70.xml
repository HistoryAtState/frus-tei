    <text>
        <body>
            <div xml:id="d70">

                <pb facs="0185" n="79" sameAs="frus:frus1891/pg79"/>

                <head><hi rendition="#italic">Mr. Pacheco to Mr. Blaine</hi>.</head>
                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States in Guatemala and
                                Honduras</hi>,<lb/><hi rendition="#italic"
                            >Guatemala</hi></placeName>, <date calendar="gregorian"
                            when="1891-08-31"><hi rendition="#italic">August 31, 1891</hi>.</date>
                        (Received September 17.)</dateline>
                    <seg rendition="#float-left">No. 58.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your telegram of August 28, and to report that I immediately sent a dispatch,
                    a copy of which I transmit herewith,</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">R. Pacheco</hi>.</signed></closer>



                <xi:include href="d70-a1.xml" xpointer="d70-a1"/>
