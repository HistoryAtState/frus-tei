    <text>
        <body>
            <div xml:id="d65">

                <pb facs="0176" n="70" sameAs="frus:frus1891/pg70"/>

                <head><hi rendition="#italic">Mr. Pacheco to Mr.
                            Blaine</hi>.</head>
                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States in Guatemala and
                                Honduras</hi>,<lb/><hi rendition="#italic"
                            >Guatemala</hi></placeName>, <date calendar="gregorian"
                            when="1891-08-18"><hi rendition="#italic">August 18, 1891</hi>.</date>
                        (Received September 3.)</dateline>
                    <seg rendition="#float-left">No. 53.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In accordance with telegraphic instructions
                    of the 10th and 13th instants, I immediately addressed a telegram to the
                    minister of foreign affairs of Salvador, a copy of which I transmit
                    herewith.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">R. Pacheco</hi>.</signed></closer>


                <xi:include href="d65-a1.xml" xpointer="d65-a1"/>
            </div>
