    <text>
        <body>
            <div xml:id="d63-a1">

                <pb facs="0175" n="69" sameAs="frus:frus1891/pg69"/>

                <opener><seg rendition="#center">[Inclosure 3 in No. 13.—Telegram.]<anchor n="*"
                            xml:id="d63-f1"/></seg></opener>
                <head><hi rendition="#italic">Mr. Love to Mr. Blaine</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >San Salvador</hi></placeName>, <date calendar="gregorian"
                            when="1891-08-09"><hi rendition="#italic">August</hi>
                        9</date>.</dateline></opener>
                <p>Special police force ordered to take possession of ship <hi rendition="#italic"
                        >City of Panama</hi>, at Acajutla, to-morrow. I go there at once, at
                    request.</p>
                <closer><signed><hi rendition="#small-caps">Love</hi>, <hi rendition="#italic"
                            >Consul</hi>.</signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d63-f1" n="*" xml:id="d63-f1-content">
                <p>For inclosures 1 and 2 see correspondence with legation of Salvador at
                    Washington.</p>
            </note>
        </listAnnotation>
