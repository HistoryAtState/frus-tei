    <text>
        <body>
            <div xml:id="d7">

                <pb facs="0115" n="9" xml:id="pg9"/>

                <head><hi rendition="#italic">Mr. Blaine to Mr. Pitkin</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1891-03-30"><hi rendition="#italic">March 30,
                        1891</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 111.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have received your No. 94, of the 5th
                    ultimo, inclosing copy of your protest to the Argentine Government against the
                    law discriminating against foreign life-insurance companies in the Argentine
                    Republic.</p>
                <p>Your very thorough presentation of the case is approved by the Department.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">James G. Blaine</hi>.</signed></closer>
            </div>
        </body>
    </text>
