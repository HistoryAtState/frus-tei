    <text>
        <body>
            <div xml:id="d4">

                <pb facs="0110" n="4" sameAs="frus:frus1891/pg4"/>

                <head><hi rendition="#italic">Mr. Blaine to Mr.
                            Pitkin</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1891-02-13"><hi rendition="#italic">February 13,
                        1891</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 96.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose copy of a letter from the
                    Secretary of the National Board of Marine Underwriters of New York complaining
                    of the heavy charges imposed on vessels putting into the port of Buenos Ayres in
                    distress.</p>
                <p>You will investigate the complaint and, if you find it well grounded, endeavor to
                    induce the Argentine Government to remedy it.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">James G. Blaine</hi>.</signed></closer>


                <xi:include href="d4-a1.xml" xpointer="d4-a1"/>
