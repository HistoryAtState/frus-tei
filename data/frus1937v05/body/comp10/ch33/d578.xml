            </note>
            <note corresp="#d578-f2" n="86" xml:id="d578-f2-content">
                <p>Yvon Delbos, French Minister for Foreign Affairs.</p>
            </note>
            <note corresp="#d578-f3" n="87" xml:id="d578-f3-content">
                <p>Camille Chautemps, French Minister of State.</p>
            </note>
            <note corresp="#d578-f4" n="88" xml:id="d578-f4-content">
                <p>Leon Blum, French President of the Council of Ministers.</p>
            </note>
        </listAnnotation>
