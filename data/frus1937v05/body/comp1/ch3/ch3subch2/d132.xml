            <div xml:id="d132">

                <pb facs="0122" n="112" sameAs="frus:frus1937v05/pg112"/>

                <note rend="inline" type="source">715.1715/1045</note>
                <head><hi rendition="#italic">The Special Representative of the President</hi> (<hi
                        rendition="#italic">Corrigan</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 36</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">San
                                José</hi></placeName>, <date calendar="gregorian" when="1937-12-11"
                            >December 11, 1937</date>.<lb/>[Received December 15.]</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit in
                    quintuplicate copy with translation of the text of the Pact of Mutual Agreements
                    entered into between Honduras and Nicaragua, which was signed in the Reception
                    Hall of the Ministry for Foreign Affairs at San José at 5:30 P.M. on December
                    10, 1937.</p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">Frank P. Corrigan</hi></signed></closer>


                <xi:include href="d132-a1.xml" xpointer="d132-a1"/>
