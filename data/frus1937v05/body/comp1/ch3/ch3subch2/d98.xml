    <text>
        <body>
            <div xml:id="d98">

                <pb facs="0102" n="92" xml:id="pg92"/>

                <note rend="inline" type="source">715.1715/744: Telegram</note>
                <head><hi rendition="#italic">The Minister in Venezuela</hi> (<hi
                        rendition="#italic">Nicholson</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Caracas</hi></placeName>, <date calendar="gregorian"
                            when="1937-10-20T16:00:00-04:30">October 20, 1937—4
                        p.m.</date><lb/>[Received 8:56 p.m.]</dateline>
                </opener>
                <p>100. Department’s telegram No. 57, October 19, 8 p.m.<anchor n="45"
                        xml:id="d98-f1"/> The Minister for Foreign Affairs after consultation with
                    the President stated that the Venezuelan Government would be glad to tender its
                    good offices as suggested and expressed his cordial appreciation for this
                    opportunity to cooperate.</p>
                <closer><signed><hi rendition="#small-caps">Nicholson</hi></signed></closer>
            </div>
        </body>
    </text>
