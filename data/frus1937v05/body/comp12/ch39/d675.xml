                <pb facs="0703" n="693" sameAs="frus:frus1937v05/pg693"/>

                <note rend="inline" type="source">411.12/2471</note>
                <head><hi rendition="#italic">The Ambassador in Mexico</hi> (<hi rendition="#italic"
                        >Daniels</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 5811</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1937-12-11">December 11, 1937</date>.<lb/>[Received December
                        14.]</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to refer to the
                    Department’s telegram No. 234 of November 26, 1937, 6 p.m. and to other recent
                    correspondence. I enclose herewith a copy with translation of a memorandum dated
                    December 1, 1937, from the Foreign Office on this subject. The memorandum has
                    just been received under cover of a personal note from Mr. Beteta, dated
                    December 8, 1937.</p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">Josephus Daniels</hi></signed></closer>



                <xi:include href="d675-a1.xml" xpointer="d675-a1"/>
