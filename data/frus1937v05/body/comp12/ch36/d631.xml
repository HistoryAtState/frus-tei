            <div xml:id="d631">

                <pb facs="0652" n="642" sameAs="frus:frus1937v05/pg642"/>

                <note rend="inline" type="source">812.52/2520</note>
                <head><hi rendition="#italic">The Ambassador in Mexico</hi> (<hi rendition="#italic"
                        >Daniels</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 5883</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1937-12-23">December 23, 1937</date>.<lb/>[Received December
                        28.]</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith a copy
                    of the conversation on the Yaqui Valley situation between Licenciado Beteta and
                    Mr. Boal, which took place yesterday morning.</p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">Josephus Daniels</hi></signed></closer>


                <xi:include href="d631-a1.xml" xpointer="d631-a1"/>
