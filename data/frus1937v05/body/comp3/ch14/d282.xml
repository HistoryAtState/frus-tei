    <text>
        <body>
            <div xml:id="d282">

                <pb facs="0278" n="268" sameAs="frus:frus1937v05/pg268"/>

                <note rend="inline" type="source">824.01/63: Telegram</note>
                <head><hi rendition="#italic">The Minister in Uruguay</hi> (<hi rendition="#italic">Lay</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Montevideo</hi></placeName>, <date calendar="gregorian"
                            when="1937-07-20T21:00:00-03:30">July 20, 1937—9
                        p.m.</date><lb/>[Received 10:43 p.m.]</dateline>
                </opener>
                <p>26. Department’s 15, July 19, 7 p.m.<anchor n="23" xml:id="d282-f1"/> Reed<anchor
                        n="24" xml:id="d282-f2"/> saw Foreign Minister who stated that he is not
                    aware of the receipt by his Legation at La Paz of officer referred to, that as
                    to recognition of new Government he instructed Uruguayan Legation to associate
                    itself with other powers signatory to Chaco agreements and that he has no
                    information <pb facs="0279" n="269" xml:id="pg269"/> regarding stability,
                    composition, authority or popular support of the new Government.</p>
                <closer><signed><hi rendition="#small-caps">Lay</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
