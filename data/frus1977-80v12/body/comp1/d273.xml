            <div xml:id="d273">

                <pb facs="0776" n="731" xml:id="pg731"/>

                <head>273. Summary of Conclusions of a Special Coordination Committee Meeting<anchor
                        n="1" xml:id="d273-f1"/></head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            from="1980-05-20T09:00:00-05:00" to="1980-05-20T09:26:00-05:00">May 20,
                            1980, 9–9:26 a.m.</date></dateline>
                </opener>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>Iran and Afghanistan</item>
                </list>
                <list subtype="participants" type="description">
                    <label>PARTICIPANTS</label>
                    <item><list>
                            <label rendition="#italic">State</label>
                            <item>Warren Christopher</item>
                            <item>David Newsom</item>
                            <item>Peter Constable</item>
                        </list></item>
                    <item><list>
                            <label rendition="#italic">OSD</label>
                            <item>W. Graham Claytor, Jr.</item>
                            <item>Frank Kramer</item>
                        </list></item>
                    <item><list>
                            <label rendition="#italic">JCS</label>
                            <item>Lt. General John Pustay</item>
                        </list></item>
                    <item><list>
                            <label rendition="#italic">Justice</label>
                            <item>John Harmon</item>
                            <item>Judge Charles Renfrew</item>
                        </list></item>
                    <item><list>
                            <label rendition="#italic">Treasury</label>
                            <item>Robert Carswell</item>
                            <item>Robert Mundheim</item>
                        </list></item>
                    <item><list>
                            <label rendition="#italic">CIA</label>
                            <item>Admiral Stansfield
                                Turner</item>
                            <item>[<hi rendition="#italic">name not declassified</hi>]</item>
                            <item>Charles Cogan</item>
                        </list></item>
                    <item><list>
                            <label rendition="#italic">ICA</label>
                            <item>Robert T. Curran</item>
                        </list></item>
