    <standOff>
        <listAnnotation>
            <note corresp="#d103-f1" n="1" type="source" xml:id="d103-f1-content">
                <p>Source: Carter Library, National Security Affairs, Staff Material, North/South,
                        Thornton, Country File, Box 102,
                    Policy Review Committee (PRC): Afghanistan,
                    Iran, Pakistan, and Their Neighbors, 12/27/79: 11/79–1/80. Secret. The meeting
                    took place in the White House Situation Room. For the minutes of the meeting,
                    see <ref target="#d102">Document 102</ref>.</p>
            </note>
            <note corresp="#d103-f2" n="2" xml:id="d103-f2-content">
                <p>For Watson’s first démarche, see <ref
                        target="#d101">Document 101</ref>. No record of a second was found.</p>
            </note>
            <note corresp="#d103-f3" n="3" xml:id="d103-f3-content">
                <p>No record of a discussion between Byrd
                    and the Soviet Chargé was found. For the hotline message from Carter to Brezhnev, see <ref target="#d113">Document 113</ref>.</p>
            </note>
            <note corresp="#d103-f4" n="4" xml:id="d103-f4-content">
                <p>See <ref target="#d107">Document 107</ref>.</p>
            </note>
            <note corresp="#d103-f5" n="5" xml:id="d103-f5-content">
                <p>See <ref target="#d149">Documents 149</ref> and <ref target="#d150"
                    >150</ref>.</p>
            </note>
        </listAnnotation>
