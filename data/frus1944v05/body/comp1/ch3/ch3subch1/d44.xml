    <text>
        <body>
            <div xml:id="d44">

                <pb facs="0069" n="57" xml:id="pg57"/>

                <note rend="inline" type="source">883.7962/52: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in Egypt</hi> (<hi rendition="#italic"
                        >Jacobs</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Cairo</hi></placeName>, <date
                            calendar="gregorian" when="1944-06-13T16:00:00+03:00">June 13, 1944—4
                            p.m.</date>
                        <lb/> [Received 4:22 p.m.]</dateline>
                </opener>
                <p>1602. With reference to telegram 1551, June 8, 11 a.m., Legation is informed that
                    no decision on airport project was adopted by Council of Ministers but that it
                    will be discussed at another subsequent meeting. Contacted Commercial
                        Counselor<anchor n="2" xml:id="d44-f1"/> of the British Embassy who has
                    promised to furnish further information.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Jacobs</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d44-f1" n="2" xml:id="d44-f1-content">
                <p>Charles Empson.</p>
            </note>
