    <text>
        <body>
            <div xml:id="d599">

                <pb facs="0563" n="551" sameAs="frus:frus1944v05/pg551"/>

                <note rend="inline" type="source">862.20252/11–1744: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Ambassador in Spain</hi> (<hi rendition="#italic"
                            >Hayes</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-11-17T19:00:00-04:00">November 17,
                            1944—7 p.m.</date>
                    </dateline>
                </opener>
                <p>3052. Please furnish by cable a recapitulation of present status of situation
                    arising from our demands for expulsion or internment of Axis agents. Department
                    desires to know exactly to what extent our demands have been satisfied.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stettinius</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
