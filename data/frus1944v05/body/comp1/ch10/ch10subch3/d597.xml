            <div xml:id="d597">

                <pb facs="0563" n="551" sameAs="frus:frus1944v05/pg551"/>

                <note rend="inline" type="source">800.20281/55: Airgram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Chargé at Tangier</hi>
                        (<hi rendition="#italic">Childs</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-06-28T16:00:00-04:00">June 28, 1944—4
                            p.m.</date>
                    </dateline>
                </opener>
                <p>A–73. The Department concurs with the view expressed in you’re A–112, June 16,
                    1944, 6 p.m., that no action should be taken with regard to the expulsion of
                    Vichy representatives at this time.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
