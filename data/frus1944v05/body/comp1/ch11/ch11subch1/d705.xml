    <text>
        <body>
            <div xml:id="d705">

                <pb facs="0660" n="648" sameAs="frus:frus1944v05/pg648"/>

                <note rend="inline" type="source">867N.01/12–1344</note>
                <head>
                    <hi rendition="#italic">Memorandum by the Secretary of
                            State to President Roosevelt
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1944-12-13">December 13, 1944</date>.</dateline>
                </opener>
                <p>Attached is a brief summary statement of the effect on our position in the Near
                    East of recent developments on the Palestine question based on the best
                    information from the field available to the Department.</p>
                <p>I am sending this to you so that it will be readily available to you for
                    background purposes in the event that this issue continues extremely active.</p>
                <closer>
                    <signed>E. R. <hi rendition="#small-caps">Stettinius, Jr.</hi>
                    </signed>
                </closer>


                <xi:include href="d705-a1.xml" xpointer="d705-a1"/>
