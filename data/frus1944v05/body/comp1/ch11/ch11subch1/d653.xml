    <text>
        <body>
            <div xml:id="d653">

                <pb facs="0609" n="597" sameAs="frus:frus1944v05/pg597"/>

                <note rend="inline" type="source">867N.01/2209: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Chargé at Damascus</hi> (<hi rendition="#italic"
                            >Farrell</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-03-28T17:00:00-04:00">March 28, 1944—5
                            p.m.</date>
                    </dateline>
                </opener>
                <p>5. You are authorized to reply to Syrian Foreign Office (your telegram no. 3 and
                    your despatch no. 81 of February 24, 1944<anchor n="87" xml:id="d653-f1"/>) in
                    the same sense as the Department’s reply,<anchor n="88" xml:id="d653-f2"/> text
                    of which is being repeated telegraphically to you through Cairo,<anchor n="89"
                        xml:id="d653-f3"/> to the Egyptian Minister’s note regarding immigration
                    into Palestine.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d653-f1" n="87" xml:id="d653-f1-content">
