    <text>
        <body>
            <div xml:id="d498">

                <pb facs="0475" n="463" sameAs="frus:frus1944v05/pg463"/>

                <note rend="inline" type="source">891.6363/11–144: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in the Soviet Union</hi> (<hi rendition="#italic">Kennan</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Moscow</hi></placeName>, <date
                            calendar="gregorian" when="1944-11-01T13:00:00+03:00">November 1, 1944—1
                            p.m.</date>
                        <lb/> [Received November 1—11:08 a.m.]</dateline>
                </opener>
                <p>4190. I have sent a note to Molotov<anchor n="78" xml:id="d498-f1"/> this
                    afternoon following closely the line of the Department’s 2566, October 30, 10
                    p.m.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Kennan</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d498-f1" n="78" xml:id="d498-f1-content">
                <p>Vyacheslav Mikhailovich Molotov, People’s Commissar for Foreign Affairs of the
                    Soviet Union.</p>
            </note>
        </listAnnotation>
    </standOff>
