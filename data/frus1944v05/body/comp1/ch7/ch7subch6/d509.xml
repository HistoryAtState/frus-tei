            <div xml:id="d509">

                <pb facs="0484" n="472" sameAs="frus:frus1944v05/pg472"/>

                <note rend="inline" type="source">891.002/11–944: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Iran</hi> (<hi
                            rendition="#italic">Morris</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Tehran</hi></placeName>, <date
                            calendar="gregorian" when="1944-11-09T15:00:00+03:25">November 9, 1944—3
                            p.m.</date>
                        <lb/> [Received 4:05 p.m.]</dateline>
                </opener>
                <p>832. Saed Cabinet resigned this afternoon. Sent to Department repeated to
                    Moscow.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Morris</hi>
                    </signed>
                </closer>
            </div>
        </body>
