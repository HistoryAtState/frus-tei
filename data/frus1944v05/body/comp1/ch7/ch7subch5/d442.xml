    <text>
        <body>
            <div xml:id="d442">

                <pb facs="0435" n="423" sameAs="frus:frus1944v05/pg423"/>

                <note rend="inline" type="source">891.51A/8–144: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Chargé in Iran</hi>
                        (<hi rendition="#italic">Ford</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-08-01T19:00:00-04:00">August 1, 1944—7
                            p.m.</date>
                    </dateline>
                </opener>
                <p>464. Ambassador Morris<anchor n="26" xml:id="d442-f1"/> is requested to inform
                    the Department as soon as he feels in a position to do so, whether he would
                    consider it advisable for the Department to request Dr. Millspaugh to come to
                    Washington to give the Department the benefit of his views regarding the
                    American adviser program in Iran.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stettinius</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d442-f1" n="26" xml:id="d442-f1-content">
                <p>Leland B. Morris, Appointed Ambassador to Iran; Ambassador Morris presented his
                    credentials on August 21, 1944.</p>
            </note>
        </listAnnotation>
    </standOff>
