    <text>
        <body>
            <div xml:id="d78">

                <pb facs="0095" n="83" sameAs="frus:frus1944v05/pg83"/>

                <note rend="inline" type="source">884.77/10–1244: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Minister in Ethiopia</hi> (<hi rendition="#italic"
                            >Caldwell</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-12-27T20:00:00-04:00">December 27,
                            1944—8 p.m.</date>
                    </dateline>
                </opener>
                <p>197. Please advise whether new agreement contained provision anticipated in your
                    telegram 206, October 12,<anchor n="34" xml:id="d78-f1"/> that operation of
                    railway by Ethiopians requires clearance with French. If so please report what
                    if any steps the Ethiopian Government has taken to secure agreement with the
                    French.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stettinius</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d78-f1" n="34" xml:id="d78-f1-content">
                <p>Telegram not printed.</p>
            </note>
