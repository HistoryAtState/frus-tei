    <text>
        <body>
            <div xml:id="d304">

                <pb facs="0308" n="296" sameAs="frus:frus1944v05/pg296"/>

                <note rend="inline" type="source">811.7445/8–1544</note>
                <head>
                    <hi rendition="#italic">The Chairman of the Federal Communications
                        Commission</hi> (<hi rendition="#italic">Fly</hi>) <hi rendition="#italic"
                        >to the Chief of the Telecommunications Division</hi> (<hi
                        rendition="#italic">DeWolf</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-08-15">August 15,
                        1944</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. DeWolf</hi>: Here is a copy of the telegram
                    received from Sir Mohammed Usman today on the occasion of the opening of the
                    circuit between India and the United States.</p>
                <p>Sincerely yours</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">James Lawrence Fly</hi>
                    </signed>
                </closer>


                <xi:include href="d304-a1.xml" xpointer="d304-a1"/>
