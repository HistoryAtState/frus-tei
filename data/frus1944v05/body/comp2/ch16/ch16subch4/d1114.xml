                <pb facs="1100" n="1088" sameAs="frus:frus1944v05/pg1088"/>

                <note rend="inline" type="source">711.94115 Exchange/353: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in Switzerland</hi> (<hi rendition="#italic">Harrison</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Bern</hi></placeName>, <date
                            calendar="gregorian" when="1944-05-02T17:00:00+01:00">May 2, 1944—5
                            p.m.</date>
                        <lb/> [Received May 2—3:05 p.m.]</dateline>
                </opener>
                <p>2773. American Interests—Japan. Legation’s 2641, April 25. Foreign Office note
                    April 27 states Japanese Foreign Office notified Swiss Legation, Tokyo, April
                    22, that study of Department’s proposals regarding third exchange will require
                    some time.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Harrison</hi>
                    </signed>
                </closer>
            </div>
        </body>
