            <div xml:id="d1037">

                <pb facs="1033" n="1021" sameAs="frus:frus1944v05/pg1021"/>

                <note rend="inline" type="source">740.00115A Pacific War/512: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Minister in
                        Switzerland</hi> (<hi rendition="#italic">Harrison</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-03-07T21:00:00-04:00">March 7, 1944—9
                            p.m.</date>
                    </dateline>
                </opener>
                <p>769. American Interests—Philippines. Effective March 1, 1944, the sum authorized
                    by Department’s 1979 of August 18, 1913,<anchor n="20" xml:id="d1037-f1"/> for
                    financial assistance in the Philippines is hereby increased in compliance <pb
                        facs="1034" n="1022" xml:id="pg1022"/> with the request in your 983 of
                    February 17<anchor n="21" xml:id="d1037-f2"/> to an amount not exceeding $37,500
                    monthly.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stettinius</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
