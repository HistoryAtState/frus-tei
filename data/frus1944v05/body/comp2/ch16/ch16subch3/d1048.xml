    <text>
        <body>
            <div xml:id="d1048">

                <pb facs="1042" n="1030" sameAs="frus:frus1944v05/pg1030"/>

                <note rend="inline" type="source">711.93114A/69: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in Switzerland</hi> (<hi
                        rendition="#italic">Harrison</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Bern</hi></placeName>, <date
                            calendar="gregorian" when="1944-04-20T23:00:00+01:00">April 20, 1944—11
                            p.m.</date>
                        <lb/> [Received April 20—8:35 p.m.]</dateline>
                </opener>
                <p>2533. American Interests—China. Department’s 1099, April l.<anchor n="48"
                        xml:id="d1048-f1"/> Foreign Office note April 17 states Swiss Consulate,
                    Shanghai, reports <pb facs="1043" n="1031" xml:id="pg1031"/> Japanese refusal
                    permit expedition concerns only packages and other shipments from Intercross or
                    Swiss Consulate for latter not permitted accord relief in kind using official
                    funds which have not been acquired at official rate. Transmission by Intercross
                    of packages from private persons still authorized as well as transmission by
                    mail but latter incurs great risk of theft.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Harrison</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
