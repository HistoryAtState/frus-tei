    <text>
        <body>
            <div xml:id="d1103">

                <pb facs="1090" n="1078" sameAs="frus:frus1944v05/pg1078"/>

                <note rend="inline" type="source">711.94114A/12–2344: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in Switzerland</hi> (<hi rendition="#italic"
                        >Huddle</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Bern</hi></placeName>, <date
                            calendar="gregorian" when="1944-12-23">December 23,
                        1944</date>.<lb/>[Received December 24—6:25 p.m.]</dateline>
                </opener>
                <p>8303. Am[erican] Interests—Far East. Foreign Office note December 22 states Swiss
                    Legation, Tokyo, informed by Japanese Foreign Office that American POWs and
                    civilian internees are authorized since November 15 send and receive telegrams
                    to and from families.</p>
                <p>Legation inquiring whether foregoing applies POW and internees detained
                    throughout Far East by Japanese or only those held Japan.<anchor n="44"
                        xml:id="d1103-f1"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Huddle</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1103-f1" n="44" xml:id="d1103-f1-content">
                <p>Telegram 296, January 15, 1945, from Bern, reported the authorization applied to
                    persons detained in Japan and Japanese-administered territory
                    (711.94114A/1–1545).</p>
            </note>
        </listAnnotation>
    </standOff>
