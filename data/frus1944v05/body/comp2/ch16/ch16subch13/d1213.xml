    <text>
        <body>
            <div xml:id="d1213">

                <pb facs="1273" n="1261" xml:id="pg1261"/>

                <note rend="inline" type="source">890.0146/14</note>
                <head>
                    <hi rendition="#italic">The Joint Chiefs of Staff to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-05-14">14 May, 1944</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: A copy of the
                    “Assumptions for Planning for Civil Affairs for the Period of Military
                    Occupation,” as prepared by the Civil Affairs Division of the War Department and
                    concurred in by the Department of State, and as amended and approved by the
                    Joint Chiefs of Staff, is enclosed for information.</p>
                <p>Sincerely yours,</p>
                <closer>For the Joint Chiefs of Staff: <lb/>
                    <signed>A. J. <hi rendition="#small-caps">McFarland</hi>
                    </signed>
                    <lb/>
                    <hi rendition="#italic">Colonel, U.S.A. Secretary</hi>
                </closer>


                <xi:include href="d1213-a1.xml" xpointer="d1213-a1"/>
            </div>
