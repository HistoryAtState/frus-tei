                <pb facs="0126" n="110" sameAs="frus:frus1948v09/pg110"/>

                <note rend="inline" type="source">834.00/6–548: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            Embassy in Paraguay
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">confidential</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1948-06-08">June 8, 1948</date>.</dateline>
                </opener>
                <p>99. This Govt (urtel 275 June 5<anchor n="1"
                        xml:id="d85-f1"/> and related messages) does not contemplate any
                    interruption in our diplomatic relations with Paraguay. You may inform
                    colleagues and local officials.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Marshall</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
