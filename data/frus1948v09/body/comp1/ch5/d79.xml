    <text>
        <body>
            <div xml:id="d79">

                <pb facs="0123" n="107" sameAs="frus:frus1948v09/pg107"/>

                <note rend="inline" type="source">710.J/3–948: Circular telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                            Diplomatic Representatives in the American
                            Republics
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">restricted</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1948-03-09T07:00:00-05:00">March 9, 1948—7 a.
                            m.</date>
                    </dateline>
                </opener>
                <p>2037. Gov Bd March 8 approved by vote 14 to 5
                    Committee report on Nicaraguan participation in Bog
                        Conf summarized Depcirtel Feb
                    27, 3 p. m.<anchor n="1" xml:id="d79-f1"/> US voted in favor stating this action
                    implied no change in relations between US and <hi rendition="#italic">de
                        facto</hi> govt Nicaragua.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Marshall</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
