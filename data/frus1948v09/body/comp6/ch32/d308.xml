    <text>
        <body>
            <div xml:id="d308">

                <pb facs="0445" n="429" sameAs="frus:frus1948v09/pg429"/>

                <note rend="inline" type="source">825.51 Bondholders/7–948: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Chile</hi> (<hi
                            rendition="#italic">Bowers</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Santiago</hi></placeName>, <date
                            calendar="gregorian" when="1948-07-09">July 9, 1948</date>.</dateline>
                </opener>
                <p>473. Chamber of Deputies last night approved law for resumption of service on
                    foreign debt by vote 44 to 11. Law was previously approved by Senate on May 18
                    (reEmbgam A–241, May 20, 1948).<anchor n="1" xml:id="d308-f1"/> It is now ready
                    for Presidential signature.<anchor n="2" xml:id="d308-f2"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bowers</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d308-f1" n="1" xml:id="d308-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d308-f2" n="2" xml:id="d308-f2-content">
                <p>Ambassador Bowers in telegram 501, July 21, not printed, indicated that the
                    President had signed the law (825.51 Bondholders/7–2148).</p>
            </note>
        </listAnnotation>
    </standOff>
