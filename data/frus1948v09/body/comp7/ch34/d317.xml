    <text>
        <body>
            <div xml:id="d317">

                <pb facs="0462" n="446" sameAs="frus:frus1948v09/pg446"/>

                <note rend="inline" type="source">811.516 Export-Import Bank/8–2448</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            Embassy in Colombia
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">confidential</hi>
                        <lb/> No. 152</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1948-08-24">August 24,
                        1948</date>.</dateline>
                </opener>
                <p>The Secretary of State transmits herewith for the information of the Officer in
                    Chargé a copy of the agreement, signed on August 12, 1948,<anchor n="1"
                        xml:id="d317-f1"/> between the Republic of Colombia and the Export-Import
                    Bank of Washington establishing a line of credit of $10 million to finance the
                    acquisition in the United States of supplies, materials, equipment and services
                    required for replacement, reconstruction or repair and development of properties
                    destroyed or damaged during the recent disturbances in Colombia.</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d317-f1" n="1" xml:id="d317-f1-content">
                <p>Not printed; for additional information on this credit (No. 442), authorized
                    April 13, 1948, see <hi rendition="#italic">Export-Import Bank of Washington:
                        Sixth Semiannual Report to Congress for the Period January–June 1948</hi>,
                    pp. 6 and 18.</p>
            </note>
        </listAnnotation>
    </standOff>
