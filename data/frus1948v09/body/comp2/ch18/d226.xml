            </note>
            <note corresp="#d226-f3" n="3" xml:id="d226-f3-content">
                <p>The Argentine President Juan Domingo Perón.</p>
            </note>
            <note corresp="#d226-f4" n="4" xml:id="d226-f4-content">
                <p>Lt. Gen. Willis D. Crittenberger, Commanding General, Caribbean Defense
                    Command.</p>
            </note>
        </listAnnotation>
