                <pb facs="0070" n="50" sameAs="frus:frus1961-63v02/pg50"/>

                <head>Annex To National Security Action Memorandum No. 124</head>
                <p>I hereby assign to the cognizance of the Special Group (Counter-Insurgency) the
                    following countries: <list>
                        <item>Laos</item>
                        <item>South Viet-Nam</item>
                        <item>Thailand</item>
                    </list></p>
                <closer><signed><hi rendition="#bold"
                            >JFK</hi></signed></closer>
            </div>
        </body>
