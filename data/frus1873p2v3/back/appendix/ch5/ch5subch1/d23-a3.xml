    <text>
        <body>
            <div xml:id="d23-a3">

                <pb facs="0328" n="272" sameAs="frus:frus1873p2v3/pg272"/>

                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1871-03-04"><hi rendition="#italic">March</hi> 4,
                        1871</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    from you of a commission from the President as one of the commissioners in a
                    joint high commission between the United States and Great Britain, and accept
                    the appointment. I am a native of the State of New York.</p>
                <p>Yours, very truly,</p>
                <closer>
                    <signed>GEO. H. WILLIAMS.</signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">Hamilton Fish</hi>,<lb/><hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
