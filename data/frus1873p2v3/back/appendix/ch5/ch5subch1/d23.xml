    <text>
        <body>
            <div xml:id="d23">

                <pb facs="0328" n="272" xml:id="pg272"/>

                <head>Acceptances of appointments.</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1871-02-25"><hi rendition="#italic">February</hi> 25,
                        1871</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have received the commission as
                    commissioner of the joint high commission between the United States and Great
                    Britain, and hereby accept the same. I was born in the county of Washington,
                    State of New York.</p>
                <p>I herewith inclose the oath of office for your Department.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>SAMUEL NELSON.</signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">Hamilton Fish</hi>,<lb/><hi
                            rendition="#italic">Secretary of State.</hi></p>
                </postscript>




