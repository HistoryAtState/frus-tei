    <text>
        <body>
            <div xml:id="d22">

                <pb facs="0327" n="[271]" sameAs="frus:frus1873p2v3/pg271"/>

                <head>Appointment of secretary.</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Executive Mansion</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1871-02-14"><hi rendition="#italic">February</hi> 14,
                        1871</date>.</dateline>
                </opener>
                <p rendition="#flush">To <hi rendition="#small-caps">J. C. Bancroft Davis</hi>,
                        Esq.,<lb/><hi rendition="#italic">Assistant Secretary of State:</hi></p>
                <p>You are hereby designated and directed to perform the duties of secretary of the
                    commissioners on behalf of the United States in the joint high commission, to
                    meet in Washington for the consideration of the questions pending between the
                    United States and Great Britain.</p>
                <closer>
                    <signed>U. S. GRANT.</signed>
                </closer>
            </div>
        </body>
