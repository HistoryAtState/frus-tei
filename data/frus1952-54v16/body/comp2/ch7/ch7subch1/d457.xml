    <text>
        <body>
            <div xml:id="d457">

                <pb facs="0755" n="729" sameAs="frus:frus1952-54v16/pg729"/>

                <note rend="inline" type="source">Conference files, lot 60 D 627, CF 311</note>
                <head><hi rendition="#italic">Memorandum by Richard V. Hennes to the Head of the
                        United States Delegation</hi> (<hi rendition="#italic">Smith</hi>)</head>
                <opener><dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Geneva</hi></placeName>,] <date calendar="gregorian"
                            when="1954-05-08">May 8, 1954</date>.</dateline></opener>
                <p>Attached is a statement prepared by Ambassador Heath for your use in the event
                    the Communists raise the question of the presence at the Conference of the
                    “ghost regimes” in Cambodia and Laos. Ambassador Heath has the original, which
                    he will bring to the session.</p>
                <closer><signed>RVH</signed></closer>


                <xi:include href="d457-a1.xml" xpointer="d457-a1"/>
