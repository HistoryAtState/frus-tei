                <note rend="inline" type="source">396.1 GE/7–2254: Telegram</note>
                <head><hi rendition="#italic">The Consul at Geneva</hi> (<hi rendition="#italic">Gowen</hi>) <hi
                        rendition="#italic">to the Department of
                    State</hi></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">priority</hi></seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Geneva</hi></placeName>, <date calendar="gregorian"
                            when="1954-07-22">July 22, 1954</date>.</dateline>
                </opener>
                <p>129. Mytel 127.<anchor n="1" xml:id="d1048-f1"
                    /> Under Secretary and party left for London 1530 hours Geneva time.</p>
                <closer><signed><hi rendition="#small-caps"
                            >Gowen</hi></signed></closer>
            </div>
        </body>
    </text>
