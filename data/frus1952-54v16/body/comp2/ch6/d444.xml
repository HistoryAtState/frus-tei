            </note>
            <note corresp="#d444-f2" n="2" xml:id="d444-f2-content">
                <p>May 8.</p>
            </note>
            <note corresp="#d444-f3" n="3" xml:id="d444-f3-content">
                <p>May 10.</p>
            </note>
            <note corresp="#d444-f4" n="4" xml:id="d444-f4-content">
                <p>Reference is to a plan for elections in Korea prior to unification of the
                    country.</p>
            </note>
        </listAnnotation>
    </standOff>
