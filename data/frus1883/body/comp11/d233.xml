    <text>
        <body>
            <div xml:id="d233">

                <pb facs="0506" n="436" sameAs="frus:frus1883/pg436"/>

                <head>No. 233.<lb/><hi rendition="#italic">Mr. Davis to Mr. Lowell.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1883-06-26"><hi rendition="#italic">June</hi> 26,
                        1883</date>.</dateline>
                    <seg rendition="#float-left">No. 617.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to previous correspondence
                    on the subject, I inclose herewith for your information a copy of a dispatch
                    from Mr. Wallace, the American minister at Constantinople,<anchor n="*"
                        xml:id="d233-f1"/> reporting the action taken by the Italian, French and
                    Austrian Governments with reference to religious intolerance in Bulgaria.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>JOHN DAVIS,<lb/><hi rendition="#italic">Acting
                        Sscretary.</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d233-f1" n="*" xml:id="d233-f1-content">
                <p>See Mr. Wallace to Mr. Frelinghuysen, No. 226, June 4, 1883, <hi
                        rendition="#italic">post.</hi></p>
            </note>
        </listAnnotation>
