    <text>
        <body>
            <div xml:id="d224-a5">

                <pb facs="0487" n="417" sameAs="frus:frus1883/pg417"/>

                <opener><seg rendition="#center">[Inclosure 5 in No. 531.]</seg></opener>
                <head><hi rendition="#italic">Mr. Lowell to Thomas Gallagher.</hi></head>
                <opener><dateline rendition="#float-right"><date calendar="gregorian"
                            when="1883-04-07"><hi rendition="#small-caps">April</hi> 7,
                        1883</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have received your letter of the 6th,
                    written in the Bow street police station, and desire to say, in reply, that upon
                    being satisfied of your American citizenship, I shall give proper attention to
                    your case.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>J. R. LOWELL.</signed></closer>
            </div>
        </body>
    </text>
