    <text>
        <body>
            <div xml:id="d288">

                <pb facs="0565" n="495" sameAs="frus:frus1883/pg495"/>

                <head>No. 288.<lb/><hi rendition="#italic">Mr. West
                        to Mr. Frelinghuysen.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1883-03-15"><hi rendition="#italic">March</hi> 15, 1883</date>.
                        (Received March 16)</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to your note of the 26th of
                    January last, I have the honor to inclose copy of an approved report of a
                    committee of the privy council of Canada, to which is appended an article from
                    the Benton Record on the subject of the alleged incursions of British Indians
                    into Montana Territory.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>L. S. SACKVILLE WEST.</signed></closer>



                <xi:include href="d288-a1.xml" xpointer="d288-a1"/>
