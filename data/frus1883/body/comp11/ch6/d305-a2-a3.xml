    <text>
        <body>
            <div xml:id="d305-a2-a3">

                <pb facs="0586" n="516" sameAs="frus:frus1883/pg516"/>

                <head>[Third indorsement.]</head>
                <opener><hi rendition="#small-caps">Headquarters Military Division of Missouri</hi>, <lb/><placeName>
                        <hi rendition="#italic">Chicago</hi></placeName>, <date calendar="gregorian"
                        when="1883-06-16"><hi rendition="#italic">June</hi> 16,
                    1883</date>.</opener>
                <p>Respectfully forwarded to the Adjutant-General of the Army for the information of
                    the Secretary of War.</p>
                <closer><signed>P. H. SHERIDAN,<lb/><hi rendition="#italic">Lieutenant-General,
                            Commanding.</hi></signed></closer>
            </div>
        </body>
    </text>
