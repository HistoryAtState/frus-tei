    <text>
        <body>
            <div xml:id="d292-a2">

                <pb facs="0570" n="500" sameAs="frus:frus1883/pg500"/>

                <head>[Indorsement.]</head>
                <opener><dateline rendition="#float-right"><hi rendition="#small-caps">Headquarters
                            Military Division Missouri</hi>,<lb/><placeName><hi rendition="#italic"
                                >Chicago</hi></placeName>, <date calendar="gregorian"
                            when="1883-04-24"><hi rendition="#italic">April</hi> 24,
                        1883</date>.</dateline></opener>
                <p>Respectfully forwarded to the Adjutant-General for the information of the General
                    of the Army.</p>
                <closer><signed>P. H. SHERIDAN,<lb/><hi rendition="#italic">Lieutenant-General,
                            Commanding.</hi></signed></closer>
            </div>
        </body>
    </text>
