    <text>
        <body>
            <div xml:id="d274-a2">

                <pb facs="0552" n="482" sameAs="frus:frus1883/pg482"/>

                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Headquarters Department of Dakota</hi>,<lb/><hi rendition="#italic"
                                >Fort Snelling, Minn.</hi></placeName>, <date calendar="gregorian"
                            when="1882-12-08"><hi rendition="#italic">December</hi> 8,
                        1882</date>.</dateline></opener>
                <p rendition="#flush">Captain <hi rendition="#small-caps">Read</hi>, <hi
                        rendition="#italic">Camp Poplar River, Montana:</hi></p>
                <p>Dispatch to Breck received. Your orders to destroy property are approved. I shall
                    be glad if the weather permits you to make the trip which you propose, and shall
                    defer action till I hear further from you.</p>
                <closer>
                    <signed>ALFRED H. TERRY</signed>,<lb/><hi rendition="#italic"
                        >Brigadier-General.</hi></closer>
                <postscript>
                    <p>Official copies respectfully forwarded to the headquarters Military Division
                        of the Missouri.</p>
                    <closer><signed>ALFRED H. TERRY</signed>,<lb/><hi rendition="#italic"
                            >Brigadier-General U. S. A., Commanding.</hi>
                        <lb/>
                        <dateline rendition="#float-left"><hi rendition="#small-caps">Department
                                Dakota</hi>, <date calendar="gregorian" when="1882-12-08"><hi
                                    rendition="#italic">December</hi> 8,
                        1882</date>.</dateline></closer>
                </postscript>
                <postscript>
                    <head>[Indorsement.]</head>
                    <opener><dateline rendition="#float-right"><hi rendition="#small-caps"
                                >Headquarters Military Division of the
                                    Missouri</hi>,<lb/><placeName><hi rendition="#italic"
                                    >Chicago</hi></placeName>, <date calendar="gregorian"
                                when="1882-12-12"><hi rendition="#italic">December</hi> 12,
                                1882</date>.</dateline></opener>
                    <p>Respectfully forwarded to the Adjutant-General of the Army, for the
                        information of the General of the Army.</p>
                    <closer><signed>P. H. SHERIDAN,<lb/><hi rendition="#italic">Lieutenant-General,
                                Commanding.</hi></signed></closer>
                </postscript>
            </div>
