    <text>
        <body>
            <div xml:id="d314-a2">

                <pb facs="0605" n="535" sameAs="frus:frus1883/pg535"/>

                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Headquarters Department Dakota</hi>,<lb/><hi rendition="#italic"
                                >Fort Snelling, Minn.</hi></placeName>, <date calendar="gregorian"
                            when="1883-11-12"><hi rendition="#italic">November</hi> 12,
                        1883</date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Commanding Officer</hi>, <hi
                        rendition="#italic">Fort Buford, Dak.:</hi></p>
                <p>Telegram of yesterday received. Send the Canadian Indians and half-breeds across
                    the line, and let them take such of their property as may be necessary to keep
                    them from suffering.</p>
                <p>By command General Terry.</p>
                <closer><signed>BRECK,<lb/><hi rendition="#italic">Assistant
                        Adjutant-General.</hi></signed></closer>
            </div>
        </body>
    </text>
