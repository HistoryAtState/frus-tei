    <text>
        <body>
            <div xml:id="d341">

                <pb facs="0634" n="564" sameAs="frus:frus1883/pg564"/>

                <head>No. 340.<lb/><hi rendition="#italic">Mr. Daggett to Mr.
                    Frelinghuysen.</hi></head>
                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Honolulu</hi></placeName>, <date calendar="gregorian"
                            when="1883-10-13"><hi rendition="#italic">October</hi> 13, 1883</date>.
                        (Received October 29.)</dateline>
                    <seg rendition="#float-left">No. 94.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I beg to inclose herewith a printed copy of
                    the protest<anchor n="*" xml:id="d341-f1"/> of the Hawaiian Government against
                    the further extinguishment of the nationalities of the Polynesian Islands
                    through the annexation by foreign states. * * *</p>
                <p>Very respectfully, &amp;c.,</p>
                <closer><signed>ROLLIN M. DAGGETT.</signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d341-f1" n="*" xml:id="d341-f1-content">
                <p>For inclosure, see inclosure to note from Mr. Carter to Mr. Frelinghuysen,
                    October 18, 1883, <ref target="#pg575">page 575</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
