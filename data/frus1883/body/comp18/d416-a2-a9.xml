                <pb facs="0740" n="670" sameAs="frus:frus1883/pg670"/>

                <opener><placeName><hi rendition="#small-caps">La Paz, Mexico</hi></placeName>,
                        <date calendar="gregorian" when="1883-07-18"><hi rendition="#italic"
                            >July</hi> 18, 1883</date>.</opener>
                <p>This is to certify that I have read the foregoing copy of evidence taken in the
                    case of Capt. George Caleb that in the main it is literally correct, and in all
                    respects gives a clear understanding of the evidence.</p>
                <closer><signed>CARLOS F. GALAN</signed>,<lb/><hi rendition="#italic">Attorney for C
                        Caleb.</hi></closer>
            </div>
