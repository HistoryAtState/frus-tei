    <text>
        <body>
            <div xml:id="d398-a1">

                <pb facs="0722" n="652" xml:id="pg652"/>

                <opener><seg rendition="#center">[Inclosure 1 in No. 625.]</seg></opener>
                <head><hi rendition="#italic">Mr. Morgan to Señor Mariscal.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1883-03-15"><hi rendition="#italic">March</hi> 15,
                        1883</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith the passport issued by
                    this legation to William Lewis Zuber, a citizen of the United States, with the
                    request that your excellency will cause to be issued thereon the usual
                    certificate of matriculation.</p>
                <p>I renew, &amp;c.,</p>
                <closer><signed>P. H. MORGAN.</signed></closer>
            </div>
        </body>
    </text>
