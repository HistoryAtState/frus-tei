                <pb facs="0722" n="652" sameAs="frus:frus1883/pg652"/>

                <head>No. 399.<lb/><hi rendition="#italic">Mr. Davis to Mr. Morgan.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1883-05-28"><hi rendition="#italic">May</hi> 28,
                        1883</date>.</dateline>
                    <seg rendition="#float-left">No. 406.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your dispatch No. 614, of the 9th instant,
                    inclosing a copy and translation of the treaty recently signed between Mexico
                    and Guatemala adjusting their boundary differences, has been received.</p>
                <p>Expressing the Department’s pleasure at this pacific settlement of their
                    dispute,</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>JOHN DAVIS,<lb/><hi rendition="#italic">Acting
                        Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
