    <text>
        <body>
            <div xml:id="d585">

                <pb facs="0974" n="904" sameAs="frus:frus1883/pg904"/>

                <head>No. 586.<lb/><hi rendition="#italic">Mr. Frelinghuysen to Mr.
                    Baker.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1883-03-23"><hi rendition="#italic">March</hi> 23,
                        1883</date>.</dateline>
                    <seg rendition="#float-left">No. 216.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I forward herewith, for your information,
                    the inclosed copy of a note<anchor n="*" xml:id="d585-f1"/> of the 10th instant
                    from the British minister at this capital, in relation to the co-operation of
                    Her Majesty’s representative at Caracas with you, in addressing the Government
                    of Venezuela upon the subject of the custody of ships’ papers.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>FRED’K T. FRELINGHUYSEN.</signed></closer>
            </div>
        </body>
    </text>
