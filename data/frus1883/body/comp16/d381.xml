    <text>
        <body>
            <div xml:id="d381">

                <pb facs="0679" n="609" xml:id="pg609"/>

                <head>No. 380.<lb/><hi rendition="#italic">Mr. Bingham to Mr. Frelinghuysen.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Tokio</hi></placeName>, <date calendar="gregorian"
                            when="1883-10-18"><hi rendition="#italic">October</hi> 18, 1883</date>.
                        (Received November 16)</dateline>
                    <seg rendition="#float-left">No. 1763.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Herewith I beg leave to inclose for your
                    information a translation (as published in the Japan Herald Mail Summary of the
                    5th instant) of the imperial notification and agreement regarding the treaty
                    limits in Corea, of Japanese visiting or residing in that country.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>JNO. A. BINGHAM.</signed></closer>


                <xi:include href="d381-a1.xml" xpointer="d381-a1"/>
            </div>
