    <text>
        <body>
            <div xml:id="d381-a1">

                <pb facs="0679" n="609" sameAs="frus:frus1883/pg609"/>

                <opener><seg rendition="#center">[Inclosure to No. 1763.]</seg></opener>
                <head><hi rendition="#italic">Japan Herald Mail Summary, October</hi> 5, 1883.—<hi
                        rendition="#italic">Notification No</hi>. 32 <hi rendition="#italic">of the
                        Daijo-kwan.</hi></head>
                <p>Notice is hereby given that the written agreement respecting the extent of the
                    treaty limits in Korea has been altered to the one here annexed.</p>
                <closer><signed>SANJO SANEYOSHI,<lb/><hi rendition="#italic">Prime
                        Minister</hi>.</signed>
                    <lb/>
                    <signed>INOUYE KAORU,<lb/><hi rendition="#italic">Minister for Foreign
                            Affairs.</hi></signed>
                    <lb/>
                    <dateline rendition="#float-left"><date calendar="gregorian" when="1882-10-03"
                                ><hi rendition="#small-caps">October</hi> 3,
                    1882</date>.</dateline></closer>


                <xi:include href="d381-a1-a1.xml" xpointer="d381-a1-a1"/>
