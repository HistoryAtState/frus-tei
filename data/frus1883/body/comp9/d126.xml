    <text>
        <body>
            <div xml:id="d126">

                <pb facs="0334" n="264" xml:id="pg264"/>

                <head>No. 126.<lb/><hi rendition="#italic">Mr. Frelinghuysen to Mr.
                    Morton.</hi></head>
                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1883-04-04"><hi rendition="#italic">April</hi> 4,
                        1883</date>.</dateline>
                    <seg rendition="#float-left">No. 247.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith for your information a
                    copy of an instruction concerning the foreign debt of Venezuela, which has been
                    addressed, <hi rendition="#italic">mutatis mutandis</hi>, to our legations at
                    London, the Hague, Copenhagen, Madrid, and Berlin.<anchor n="*" xml:id="d126-f1"
                    /></p>
                <p rendition="#center">* * * * * * *</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>FRED’K T. FRELINGHUYSEN.</signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d126-f1" n="*" xml:id="d126-f1-content">
                <p>See correspondence with the United States minister at Berlin, <hi
                        rendition="#italic">post</hi>.</p>
            </note>
        </listAnnotation>
    </standOff>
