    <text>
        <body>
            <div xml:id="d99">

                <pb facs="0301" n="231" sameAs="frus:frus1883/pg231"/>

                <head>No. 99.<lb/><hi rendition="#italic">Mr. Davis
                        to Mr. Scruggs.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1883-01-22"><hi rendition="#italic">January</hi> 22,
                        1883</date>.</dateline>
                    <seg rendition="#float-left">No. 40.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit herewith for your information,
                    and in order that you may be prepared for any conference with your British
                    colleague upon the subject, copy of a note from the British minister at this
                    capital, of the 15th instant<anchor n="*" xml:id="d99-f1"/> concerning the
                    custody of ships’ papers when in the ports of Colombia.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>JOHN DAVIS,<lb/><hi rendition="#italic">Acting
                        Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d99-f1" n="*" xml:id="d99-f1-content">
                <p>See correspondence with British Minister at Washington.</p>
            </note>
        </listAnnotation>
