    <text>
        <body>
            <div xml:id="d365">

                <pb facs="0663" n="593" xml:id="pg593"/>

                <head>No. 364.<lb/><hi rendition="#italic">Mr. Langston to Mr.
                    Frelinghuysen.</hi></head>
                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Port-au-Prince</hi></placeName>, <date calendar="gregorian"
                            when="1883-08-04"><hi rendition="#italic">August</hi> 4, 1883</date>.
                        (Received Aug. 22.)</dateline>
                    <seg rendition="#float-left">No. 577.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit, as herewith
                    inclosed, a copy of a dispatch, with translation, dated the 25th ultimo, in
                    which this legation is advised by Mr. Damier that by order of the President of
                    Hayti of the 24th of last month the port of Jacmel has been put in a state of
                    blockade.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>JOHN MERCER LANGSTON.</signed></closer>


                <xi:include href="d365-a1.xml" xpointer="d365-a1"/>
            </div>
        </body>
    </text>
