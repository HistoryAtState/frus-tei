    <text>
        <body>
            <div xml:id="d570-a2">

                <pb facs="0953" n="883" sameAs="frus:frus1883/pg883"/>

                <opener><seg rendition="#center">[Inclosure 2 in No. 274.]</seg></opener>
                <head><hi rendition="#italic">Mr. Eyres to Mr. Wyndham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Van</hi></placeName>, <date calendar="gregorian" when="1883-08-18"
                                ><hi rendition="#italic">August</hi> 18,
                    1883</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith, for
                    your information, two copies of a dispatch addressed by me to Colonel
                    Everett.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>H. C. A. EYRES.</signed></closer>
            </div>
        </body>
