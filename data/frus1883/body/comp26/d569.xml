    <text>
        <body>
            <div xml:id="d569">

                <pb facs="0951" n="881" sameAs="frus:frus1883/pg881"/>

                <head>No. 570.<lb/><hi rendition="#italic">Mr. Wallace to Mr. Frelinghuysen.</hi></head>
                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1883-09-07"><hi rendition="#italic">September</hi> 7, 1883</date>.
                        (Received September 24.)</dateline>
                    <seg rendition="#float-left">No. 272.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Upon the strength of a letter from Rev. Mr.
                    Knapp, of which a copy is inclosed, I have addressed a note to the Sublime Porte
                    which is herewith submitted by copy.</p>
                <p>The statements of Mr. Knapp are in point of veracity sufficient of themselves,
                    but they have corroboration in the reports come to me through the British
                    embassy.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>Very respectfully, &amp;c.,</p>
                <closer><signed>LEW. WALLACE.</signed></closer>



                <xi:include href="d569-a1.xml" xpointer="d569-a1"/>
                <xi:include href="d569-a2.xml" xpointer="d569-a2"/>
