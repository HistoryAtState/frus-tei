    <text>
        <body>
            <div xml:id="d553-a4">

                <pb facs="0925" n="855" sameAs="frus:frus1883/pg855"/>

                <opener><seg rendition="#center">[Inclosure 3.—Telegram.]</seg></opener>
                <head><hi rendition="#italic">The Hellenic consular agent to Mr.
                    Stevens.</hi></head>
                <p>Mr. <hi rendition="#small-caps">Consul</hi>: The American Dr. Maurice is in
                    prison, very sick. We tried to obtain deliverance, but could not do anything.
                    Please send your dragoman.</p>
                <closer>
                    <dateline rendition="#float-left"><date calendar="gregorian" when="1883-04-28"
                                ><hi rendition="#small-caps">April</hi> 28, 1883</date>.</dateline>
                    <lb/>
                    <signed>MAVROIDHI,<lb/><hi rendition="#italic">Hellenic Consular Agent,
                            Axar.</hi></signed></closer>
            </div>
        </body>
    </text>
