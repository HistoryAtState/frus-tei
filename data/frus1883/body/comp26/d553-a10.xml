    <text>
        <body>
            <div xml:id="d553-a10">

                <pb facs="0927" n="857" sameAs="frus:frus1883/pg857"/>

                <opener><seg rendition="#center">[Inclosure 9.—Telegram.]</seg></opener>
                <head><hi rendition="#italic">Dr. Pflaum to Mr. Stevens.</hi></head>
                <p>Mr. <hi rendition="#small-caps">Consul</hi>: I received your letter. I am still
                    sick in prison; very sick. No order yet arrived from the governor-general.
                    Without sending quickly as possible an order to the kaimakam he will not allow
                    me to go out of the prison.</p>
                <closer><signed>DR. MAURICE.</signed>
                    <lb/>
                    <dateline rendition="#float-left"><placeName><hi rendition="#small-caps"
                                >Axar</hi></placeName>, <date calendar="gregorian" when="1883-05-04"
                                ><hi rendition="#italic">May</hi> 4, 1883</date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
