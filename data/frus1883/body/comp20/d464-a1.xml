                    </row>
                    <row>
                        <cell>External dept</cell>
                        <cell rendition="#border-bottom" role="num">5,837,574$251</cell>
                    </row>
                    <row>
                        <cell>On titles to consolidated debt held by treasury (961. 018$589)</cell>
                        <cell role="num">13,058,326$955</cell>
                    </row>
                    <row>
                        <cell>Ministry of foreign affairs</cell>
                        <cell role="num">312,294$859</cell>
                    </row>
                    <row>
                        <cell>Ministry of Interior</cell>
                        <cell role="num">2,169,602$572</cell>
                    </row>
                    <row>
                        <cell>Ministry of justice</cell>
                        <cell role="num">683,716$537</cell>
