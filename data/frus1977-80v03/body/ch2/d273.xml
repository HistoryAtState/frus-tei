                <pb facs="0872" n="837" xml:id="pg837"/>

                <head>273. Summary of Discussion and Conclusions of a Policy Review Committee
                        Meeting<anchor n="1" xml:id="d273-f1"/>
                </head>
                <opener><dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            from="1977-07-27T15:30:00-04:00" to="1977-07-27T17:00:00-04:00">July 27,
                            1977, 3:30–5 p.m.</date>
                    </dateline></opener>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>North-South Strategy</item>
                </list>
