                <pb facs="0934" n="899" xml:id="pg899"/>

                <head>286. Summary of Conclusions of a Policy Review Committee Meeting<anchor n="1"
                        xml:id="d286-f1"/>
                </head>
                <opener><dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            from="1977-11-11T14:00:00-05:00" to="1977-11-11T15:30:00-05:00">November
                            11, 1977, 2–3:30 p.m.</date>
                    </dateline></opener>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>Negotiations on a Common Fund</item>
                </list>
                <list subtype="participants" type="description">
                    <label>PARTICIPANTS</label>
