            <div xml:id="d538">

                <pb facs="0651" n="641" sameAs="frus:frus1947v07/pg641"/>

                <note rend="inline" type="source">121.893/7–1247: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in China</hi> (<hi rendition="#italic"
                        >Stuart</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Nanking</hi></placeName>, <date
                            calendar="gregorian" when="1947-07-12T16:00:00+09:00">July 12, 1947—4
                            p.m.</date>
                        <lb/> [Received July 12—8:20 a.m.]</dateline>
                </opener>
                <p>1520. Message contained in Deptel 857, July 11, was conveyed afternoon July 12 to
                    Generalissimo who indicated his approval.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stuart</hi>
                    </signed>
                </closer>
            </div>
        </body>
