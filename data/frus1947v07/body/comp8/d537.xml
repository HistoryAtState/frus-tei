    <text>
        <body>
            <div xml:id="d537">

                <pb facs="0651" n="641" sameAs="frus:frus1947v07/pg641"/>

                <note rend="inline" type="source">121.893/7–1147: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in China</hi> (<hi rendition="#italic"
                            >Stuart</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1947-07-11T17:00:00-04:00">July 11, 1947—5
                            p.m.</date>
                    </dateline>
                </opener>
                <p>857. The President of the United States desires to send General Wedemeyer and a
                    small group of assistants to make a fact-findinsr appraisal of the current and
                    projected situation in China and Korea. General Wedemeyer will leave almost
                    immediately and the duration of his mission is estimated at 1 month to 6
                    weeks.</p>
                <p>Please see the Generalissimo<anchor n="12a" xml:id="d537-f1"/> as soon as
                    practical and deliver the above message.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Marshall</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d537-f1" n="12a" xml:id="d537-f1-content">
                <p>Chiang Kai-shek, President of the Nationalist Government of the Republic of
                    China.</p>
            </note>
        </listAnnotation>
    </standOff>
