    <text>
        <body>
            <div xml:id="d1079">

                <pb facs="1364" n="1354" sameAs="frus:frus1947v07/pg1354"/>

                <note rend="inline" type="source">800.48 FRP/10–1747: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Ambassador in China</hi> (<hi rendition="#italic"
                            >Stuart</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1947-10-17T15:00:00-05:00">October 17, 1947—3
                            p.m.</date>
                    </dateline>
                </opener>
                <p>1275. <hi rendition="#small-caps">Rap</hi> 176. Dept agrees with assumptions re
                    relief agreement set forth in Shanghai’s 2420 Oct 14 (<hi
                        rendition="#small-caps">Par</hi> 32). Sent Nanking as Depts 1275 repeated to
                    Shanghai as Depts 1778. Dept does not desire approve text of proposed answer to
                    request for interpretation provided the sentences set forth in Deptel 1247 Oct 8
                    are included and no other matters of policy are added.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lovett</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
