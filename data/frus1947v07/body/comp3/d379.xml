                <pb facs="0491" n="481" sameAs="frus:frus1947v07/pg481"/>

                <note rend="inline" type="source">693.0023/1–247: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in the Soviet Union</hi> (<hi
                            rendition="#italic">Smith</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1947-01-02T19:00:00-05:00">January 2, 1947—7
                            p.m.</date>
                    </dateline>
                </opener>
                <p>7. Concur (urtel 3 Jan 2) your proposal re Dairen note. Nanking informed.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Byrnes</hi>
                    </signed>
                </closer>
            </div>
        </body>
