    <text>
        <body>
            <div xml:id="d381">

                <pb facs="0492" n="482" sameAs="frus:frus1947v07/pg482"/>

                <note rend="inline" type="source">693.0023/1–347: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the Soviet Union</hi> (<hi rendition="#italic">Smith</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Moscow</hi></placeName>, <date
                            calendar="gregorian" when="1947-01-03T18:00:00+03:00">January 3, 1947—6
                            p.m.</date>
                        <lb/> [Received January 3—12:01 p.m.]</dateline>
                </opener>
                <p>18. Status of Dairen (Deptels 2208, December 31<anchor n="4" xml:id="d381-f1"/>
                    and 7, January 2). Third person note containing substance of Dept’s 2208 sent to
                    FonOff today.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Smith</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
