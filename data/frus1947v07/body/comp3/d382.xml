    <text>
        <body>
            <div xml:id="d382">

                <pb facs="0492" n="482" sameAs="frus:frus1947v07/pg482"/>

                <note rend="inline" type="source">693.0023/1–647: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in China</hi> (<hi
                            rendition="#italic">Stuart</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Nanking</hi></placeName>, <date
                            calendar="gregorian" when="1947-01-06T17:00:00+08:00">January 6, 1947—5
                            p.m.</date>
                        <lb/> [Received January 6—6 a.m.]</dateline>
                </opener>
                <p>28. Note delivered Foreign Minister<anchor n="5" xml:id="d382-f1"/> (reference
                    Department’s telegram 1252, December 31<anchor n="6" xml:id="d382-f2"/>) 5 p.m.,
                    Nanking time January 6 with alteration suggested Department’s telegram 9,
                    January 2.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stuart</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
