    <text>
        <body>
            <div xml:id="d36">

                <pb facs="0051" n="41" sameAs="frus:frus1947v07/pg41"/>

                <note rend="inline" type="source">893.00/2–2247: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in China</hi> (<hi rendition="#italic"
                        >Stuart</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Nanking</hi></placeName>, <date
                            calendar="gregorian" when="1947-02-22T10:00:00+08:00">February 22,
                            1947—10 a.m.</date>
                        <lb/> [Received February 22—5:40 a.m.]</dateline>
                </opener>
                <p>339. Generalissimo informed me yesterday that reorganization of Govt would be
                    undertaken in closing days of this month.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stuart</hi>
                    </signed>
                </closer>
            </div>
        </body>
