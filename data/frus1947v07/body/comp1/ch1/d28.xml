    <text>
        <body>
            <div xml:id="d28">

                <pb facs="0045" n="35" sameAs="frus:frus1947v07/pg35"/>

                <note rend="inline" type="source">893.00/2–1147: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in China</hi> (<hi rendition="#italic"
                        >Stuart</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Nanking</hi></placeName>, <date
                            calendar="gregorian" when="1947-02-11T19:00:00+08:00">February 11,
                            1947—7 p.m.</date>
                        <lb/> [Received—9:20 p.m.]</dateline>
                </opener>
                <p>250. The Government this afternoon notified Communist delegation in Nanking that
                    its presence is no longer desired here.<anchor n="61" xml:id="d28-f1"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stuart</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d28-f1" n="61" xml:id="d28-f1-content">
                <p>For documentation on withdrawal of Chinese Communist representatives, see <ref
                        target="frus1946v10#pg_705">
                        <hi rendition="#italic">Foreign Relations</hi>, 1946, vol. <hi
                            rendition="#small-caps">x</hi>, p. 705</ref> ff.</p>
            </note>
        </listAnnotation>
    </standOff>
