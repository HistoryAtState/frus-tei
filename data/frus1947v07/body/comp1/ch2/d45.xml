    <text>
        <body>
            <div xml:id="d45">

                <pb facs="0057" n="47" sameAs="frus:frus1947v07/pg47"/>

                <note rend="inline" type="source">893.00/3–147: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister-Counselor of Embassy in China</hi> (<hi
                        rendition="#italic">Butterworth</hi>) <hi rendition="#italic">to the
                        Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Nanking</hi></placeName>, <date
                            calendar="gregorian" when="1947-03-01T09:00:00+08:00">March 1, 1947—9
                            a.m.</date>
                        <lb/> [Received February 28—9:45 p.m.]</dateline>
                </opener>
                <p>403. I am confidentially and reliably informed that T. V. Soong<anchor n="83"
                        xml:id="d45-f1"/> offered his resignation to the Generalissimo<anchor n="84"
                        xml:id="d45-f2"/> last evening and the latter accepted.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Butterworth</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d45-f1" n="83" xml:id="d45-f1-content">
                <p>President of the Chinese Executive Yuan.</p>
            </note>
            <note corresp="#d45-f2" n="84" xml:id="d45-f2-content">
                <p>Chiang Kai-shek, President of the National Government of the Republic of
                    China.</p>
            </note>
        </listAnnotation>
    </standOff>
