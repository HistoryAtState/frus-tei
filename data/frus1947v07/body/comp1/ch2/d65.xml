                <pb facs="0079" n="69" sameAs="frus:frus1947v07/pg69"/>

                <note rend="inline" type="source">893.00/3–1747: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        China</hi> (<hi rendition="#italic">Stuart</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1947-03-18T19:00:00-05:00">March 18, 1947—7
                            p.m.</date>
                    </dateline>
                </opener>
                <p>321. Before repeating Shanghai’s 659 Mar 17, 2 p.m. to Secretary Marshall Dept
                    would appreciate receiving your comments thereon.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
