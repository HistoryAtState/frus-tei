    <text>
        <body>
            <div xml:id="d88">

                <pb facs="0114" n="104" sameAs="frus:frus1947v07/pg104"/>

                <note rend="inline" type="source">893.00/4–2247: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in China</hi> (<hi
                            rendition="#italic">Stuart</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Nanking</hi></placeName>, <date
                            calendar="gregorian" when="1947-04-22T19:00:00+09:00">April 22, 1947—7
                            p.m.</date>
                        <lb/> [Received April 23—4:15 a.m.]</dateline>
                </opener>
                <p>874. RefEmbtel 861, April 21, 4 p.m.<anchor n="67" xml:id="d88-f1"/> Official
                    Central News Agency has announced that on April 21 the Central Executive
                    Committee of the Kuomintang decided to abrogate that provision in article 15 of
                    the organic law of the National Govt providing for presidential responsibility
                    to the Kuomintang.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stuart</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
