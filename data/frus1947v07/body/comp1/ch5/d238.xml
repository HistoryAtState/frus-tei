    <text>
        <body>
            <div xml:id="d238">

                <pb facs="0307" n="297" sameAs="frus:frus1947v07/pg297"/>

                <note rend="inline" type="source">893.91/9–3047: Telegram</note>
                <head>
                    <hi rendition="#italic">The Consul General at Shanghai</hi> (<hi
                        rendition="#italic">Davis</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Shanghai</hi></placeName>, <date
                            calendar="gregorian" when="1947-09-30T13:00:00+09:00">September 30,
                            1947—1 p.m.</date>
                        <lb/> [Received September 29—11:46 p.m.]</dateline>
                </opener>
                <p>2316. USIS<anchor n="76" xml:id="d238-f1"/> Chinese news editor states that Tso
                    Shi-sen, Vice Minister of Information for the Kuomintang, instructed
                    Kuomintang-controlled <pb facs="0308" n="298" xml:id="pg298"/> newspapers in
                    Shanghai not to publish any criticism which American officials or the American
                    press levelled against Soviet Union unless absolutely necessary, in which case
                    news should be played down using only short items under inconspicuous headlines.
                    Instruction was sent to all Kuomintang publishers and editors.</p>
                <p>Sent Nanking 1624; repeated Department 2316.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Davis</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d238-f1" n="76" xml:id="d238-f1-content">
