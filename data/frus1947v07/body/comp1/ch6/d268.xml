    <text>
        <body>
            <div xml:id="d268">

                <pb facs="0353" n="343" sameAs="frus:frus1947v07/pg343"/>

                <note rend="inline" type="source">893.00/10–2847: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in China</hi> (<hi
                            rendition="#italic">Stuart</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Nanking</hi></placeName>, <date
                            calendar="gregorian" when="1947-10-28">October 28,
                        1947</date>.<lb/>[Received October 28—8:12 a.m.]</dateline>
                </opener>
                <p>2157. Reference Embtel 2149, October 28. Shanghai afternoon papers report Lo
                    Lung-chi, Democratic League leader, hiding in American Embassy. These reports
                    have no foundation in fact.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stuart</hi>
                    </signed>
                </closer>
            </div>
        </body>
