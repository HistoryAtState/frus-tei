    <text>
        <body>
            <div xml:id="d710">

                <pb facs="0926" n="916" sameAs="frus:frus1947v07/pg916"/>

                <note rend="inline" type="source">893.24/11–847</note>
                <head>
                    <hi rendition="#italic">The Chinese Minister</hi> (<hi
                            rendition="#italic">Tan</hi>) <hi rendition="#italic">to the
                        Director of the Office of Far Eastern Affairs</hi> (<hi
                            rendition="#italic">Butterworth</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1947-11-08">November 8,
                        1947</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Minister</hi>: Enclosed please find a
                    Memorandum in regard to the request of my government for a certain quantity of M
                    .50 cartridges, the contents of which had been communicated to you by me
                    verbally on the 5th instant.</p>
                <p>With personal regards,</p>
                <p>Yours sincerely,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Shao-Hwa Tan</hi>
                    </signed>
                </closer>


                <xi:include href="d710-a1.xml" xpointer="d710-a1"/>
            </div>
