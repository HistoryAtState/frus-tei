            <div xml:id="d525">

                <pb facs="0637" n="627" sameAs="frus:frus1947v07/pg627"/>

                <note rend="inline" type="source">740.00119 Council/4–1447: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the Soviet Union</hi> (<hi rendition="#italic">Smith</hi>) <hi
                        rendition="#italic">to the Acting Secretary of
                            State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Moscow</hi></placeName>, <date
                            calendar="gregorian" when="1947-04-14T17:00:00+03:00">April 14, 1947—5
                            p.m.</date>
                        <lb/> [Received April 14—10:41 a.m.]</dateline>
                </opener>
                <p>1344. Delsec 1420 for Acheson from Marshall. Your Secdel 1453 refers. I have
                    reconsidered the matter in the light of your suggestions and do not wish to make
                    a reply to Molotov’s letter. [Marshall.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Smith</hi>
                    </signed>
                </closer>
            </div>
        </body>
