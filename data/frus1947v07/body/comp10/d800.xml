            <div xml:id="d800">

                <pb facs="0996" n="986" sameAs="frus:frus1947v07/pg986"/>

                <note rend="inline" type="source">893.34/12–547: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in China</hi> (<hi
                            rendition="#italic">Stuart</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Nanking</hi></placeName>, <date
                            calendar="gregorian" when="1947-12-05T16:00:00+08:00">December 5, 1947—4
                            p.m.</date>
                        <lb/> [Received December 5—2:24 p.m.]</dateline>
                </opener>
                <p>2340. Re agreement for transfer naval vessels, Chinese concur in modifications
                    outlined paragraph 2 Deptel 1459, December 3.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stuart</hi>
                    </signed>
                </closer>
            </div>
        </body>
