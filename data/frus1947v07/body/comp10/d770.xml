    <text>
        <body>
            <div xml:id="d770">

                <pb facs="0971" n="961" sameAs="frus:frus1947v07/pg961"/>

                <note rend="inline" type="source">893.20 Missions/4–2447</note>
                <head>
                    <hi rendition="#italic">The Secretary of War</hi> (<hi
                            rendition="#italic">Patterson</hi>) <hi rendition="#italic"
                        >to the Acting Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1947-04-24">24 April 1947</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Secretary</hi>: There is enclosed a copy of
                    the letter which I have this date sent to the Secretary of the Navy. I propose
                    for your consideration that the best action we can take at the present time in
                    connection with formalizing our missions to China is to set up the joint mission
                    approved by the President.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert</hi> P. <hi rendition="#small-caps"
                            >Patterson</hi>
                    </signed>
                </closer>


                <xi:include href="d770-a1.xml" xpointer="d770-a1"/>
            </div>
        </body>
    </text>
