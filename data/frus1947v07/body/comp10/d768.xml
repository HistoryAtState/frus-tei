    <text>
        <body>
            <div xml:id="d768">

                <pb facs="0970" n="960" sameAs="frus:frus1947v07/pg960"/>

                <note rend="inline" type="source">893.00/4–1647: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in the
                        Soviet Union</hi> (<hi rendition="#italic">Smith</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1947-04-17T13:00:00-05:00">April 17, 1947—1
                            p.m.</date>
                    </dateline>
                </opener>
                <p>959. <hi rendition="#small-caps">Moskco</hi> 65 For the Secretary. We will be
                    guided by <hi rendition="#small-caps">Kosmos</hi> 43 as amended by <hi
                        rendition="#small-caps">Kosmos</hi> 47<anchor n="47" xml:id="d768-f1"/>
                    substance of which is being repeated to Nanking.<anchor n="48" xml:id="d768-f2"
                    />
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d768-f1" n="47" xml:id="d768-f1-content">
                <p>
                    <hi rendition="#italic">Supra</hi>.</p>
            </note>
            <note corresp="#d768-f2" n="48" xml:id="d768-f2-content">
                <p>Substance repeated in Department’s telegram No. 441, April 17, 1 p.m.</p>
            </note>
        </listAnnotation>
    </standOff>
