    <text>
        <body>
            <div xml:id="d786">

                <pb facs="0986" n="976" sameAs="frus:frus1947v07/pg976"/>

                <note rend="inline" type="source">123 Service, Richard M.: Telegram</note>
                <head>
                    <hi rendition="#italic">The Consul General at Tsingtao</hi> (<hi rendition="#italic">Spiker</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Tsingtao</hi></placeName>, <date
                            calendar="gregorian" when="1947-09-05T10:00:00+09:00">September 5,
                            1947—10 a.m.</date>
                        <lb/> [Received September 5—1:28 a.m.]</dateline>
                </opener>
                <p>76. Service returned yesterday evening reporting continuing negotiations by Navy
                    at Goose Point. Details will be sent later message following receipt today’s
                    report from negotiators.</p>
                <pb facs="0987" n="977" xml:id="pg977"/>
                <p>Sent Embassy 101; repeated Department 76.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Spiker</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
