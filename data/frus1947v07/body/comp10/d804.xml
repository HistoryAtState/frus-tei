            <div xml:id="d804">

                <pb facs="0998" n="988" xml:id="pg988"/>

                <note rend="inline" type="source">893.34/12–847: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in China</hi> (<hi
                            rendition="#italic">Stuart</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Nanking</hi></placeName>, <date
                            calendar="gregorian" when="1947-12-08">December 8,
                        1947</date>.<lb/>[Received December 8—7:32 p.m.]</dateline>
                </opener>
                <p>2350. Agreement concerning transfer naval vessels signed today, 4 p.m.<anchor
                        n="79" xml:id="d804-f1"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stuart</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
