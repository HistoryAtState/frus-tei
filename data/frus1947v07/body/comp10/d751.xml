            <div xml:id="d751">

                <pb facs="0961" n="951" sameAs="frus:frus1947v07/pg951"/>

                <note rend="inline" type="source">893.00/3–947: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        China</hi> (<hi rendition="#italic">Stuart</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1947-03-13T12:00:00-05:00">March 13,
                            1947—noon</date>.</dateline>
                </opener>
                <p>300. In order to correct possible ambiguity in Deptel 292 Mar 10, executive order
                    mentioned paragraph 3 does not touch upon activities of NAG but deals solely
                    with transfer of ships.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
