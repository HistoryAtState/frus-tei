    <text>
        <body>
            <div xml:id="d1037">

                <pb facs="1302" n="1292" sameAs="frus:frus1947v07/pg1292"/>

                <note rend="inline" type="source">811.42793 SE/11–1047: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in China</hi> (<hi
                            rendition="#italic">Stuart</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Nanking</hi></placeName>, <date
                            calendar="gregorian" when="1947-11-10">November 10,
                        1947</date>.<lb/>[Received November 10—3:39 p.m.]</dateline>
                </opener>
                <p>2225. Reference Embtel 2205, November 6.<anchor n="29" xml:id="d1037-f1"/>
                    Fulbright Bill Agreement signed 4:30 p.m., November 10.<anchor n="30"
                        xml:id="d1037-f2"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stuart</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1037-f1" n="29" xml:id="d1037-f1-content">
                <p>Not printed (811.42793SE/11–647); it gave the text of a proposed Embassy press
                    release which was worded similarly to the one issued by the Department on
                    November 10, printed in Department of State <hi rendition="#italic"
                        >Bulletin</hi>, November 23, 1947, p. 1005.</p>
            </note>
            <note corresp="#d1037-f2" n="30" xml:id="d1037-f2-content">
                <p>For text, see Department of State Treaties and Other International Acts Series
                    No. 1687, or 61 Stat. (pt. 4) 3582.</p>
            </note>
        </listAnnotation>
    </standOff>
