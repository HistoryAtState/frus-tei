    <text>
        <body>
            <div xml:id="d1137">

                <pb facs="1435" n="1425" sameAs="frus:frus1947v07/pg1425"/>

                <note rend="inline" type="source">711.9327/11–2047: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Ambassador in China</hi> (<hi rendition="#italic"
                            >Stuart</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1947-12-02T18:00:00-05:00">December 2, 1947—6
                            p.m.</date>
                    </dateline>
                </opener>
                <p>1454. Dept will comment at length points Urtel 2261, Nov 20 in few days. Desire
                    confirmation last date consultation may begin under terms Art 11, and comments
                    re advisability holding consultation Nanking with Jarvis assisting Emb.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lovett</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
