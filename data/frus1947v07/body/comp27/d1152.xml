    <text>
        <body>
            <div xml:id="d1152">

                <pb facs="1449" n="1439" sameAs="frus:frus1947v07/pg1439"/>

                <note rend="inline" type="source">121.5493/3–147: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister-Counselor of Embassy in China</hi> (<hi
                        rendition="#italic">Butterivorth</hi>) <hi rendition="#italic">to the
                        Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Nanking</hi></placeName>, <date
                            calendar="gregorian" when="1947-03-01T21:00:00+08:00">March 1, 1947—9
                            p.m.</date>
                        <lb/> [Received March 1—12:52 p.m.]</dateline>
                </opener>
                <p>408. This for Military Attaché.<anchor n="1" xml:id="d1152-f1"/> Following from
                        Changchun:<anchor n="2" xml:id="d1152-f2"/>
                </p>
                <quote rend="blockquote"><p>“78, March 1, 3 p.m. Major Rigg and Capt. Collins
                        (Assistant Military Attachés) were captured this morning by Communists about
                        4 a.m., east of Chialun. Am contacting our military and will report details
                        later.”</p></quote>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Butterworth</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1152-f1" n="1" xml:id="d1152-f1-content">
                <p>Brig. Gen. Robert H. Soule.</p>
            </note>
            <note corresp="#d1152-f2" n="2" xml:id="d1152-f2-content">
                <p>O. Edmund Clubb was Consul General at Changchun.</p>
            </note>
        </listAnnotation>
    </standOff>
