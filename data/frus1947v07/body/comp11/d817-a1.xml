                        <cell/>
                    </row>
                    <row>
                        <cell rend="padding-left: 2em">National Government Area (3)</cell>
                        <cell role="num">18,000</cell>
                    </row>
                    <row>
                        <cell rend="padding-left: 2em">Communist Area</cell>
                        <cell role="num">50,000</cell>
                    </row>
                </table>
                <p rendition="#flush">
                    <hi rendition="#small-caps">Notes</hi>:</p>
                <list>
                    <label>(1)</label>
                    <item>1,000 scheduled for movement 5 October 1947.</item>
                    <label>(2)</label>
                    <item>Data on Manchuria is highly questionable. These figures are purely
                        estimates based upon such miscellaneous information as was available.</item>
                    <label>(3)</label>
                    <item>10,000 scheduled for movement 27–30 September 1947.</item>
