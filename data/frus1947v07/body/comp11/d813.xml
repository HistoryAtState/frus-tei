                <pb facs="1004" n="994" sameAs="frus:frus1947v07/pg994"/>

                <note rend="inline" type="source">740.00119 Control (Korea)/4–1047: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        China</hi> (<hi rendition="#italic">Stuart</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1947-04-24T20:00:00-05:00">April 24, 1947—8
                            p.m.</date>
                    </dateline>
                </opener>
                <p>480. Following tel received from Tokyo. Dept suggests that in your discretion you
                    approach Chinese Govt as indicated in final paragraph.</p>
                <p>[Here follows text of telegram No. 78, April 10, printed <hi rendition="#italic"
                        >supra</hi>.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
