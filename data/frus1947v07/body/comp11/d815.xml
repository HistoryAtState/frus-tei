            </note>
            <note corresp="#d815-f2" n="13" xml:id="d815-f2-content">
                <p>Generalissimo Chiang Kai-shek, President of the National Government of the
                    Republic of China.</p>
            </note>
        </listAnnotation>
    </standOff>
