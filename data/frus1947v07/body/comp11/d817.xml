    <text>
        <body>
            <div xml:id="d817">

                <pb facs="1006" n="996" sameAs="frus:frus1947v07/pg996"/>

                <note rend="inline" type="source">740.00115 PW/9–2347</note>
                <head>
                    <hi rendition="#italic">The Ambassador in China</hi> (<hi rendition="#italic"
                        >Stuart</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1017</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Nanking</hi></placeName>, <date
                            calendar="gregorian" when="1947-09-23">September 23,
                        1947</date>.<lb/>[Received October 3.]</dateline>
                </opener>
                <p>The Ambassador has the honor to enclose for the information of the Department a
                    copy of a self-explanatory tabulation prepared by the Army Advisory Group which
                    shows the number of Japanese and certain miscellaneous persons repatriated from
                    China since V–J Day.</p>


                <xi:include href="d817-a1.xml" xpointer="d817-a1"/>
