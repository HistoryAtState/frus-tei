                <pb facs="0103" n="9" sameAs="frus:frus1930v03/pg9"/>

                <note rend="inline" type="source">811.512351Double/19: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic"
                        >Edge</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1930-05-06T12:00:00+01:00">May 6, 1930—noon</date>.<lb/>[Received
                        May 6—9 a.m.]</dateline></opener>
                <p>130. Your 86, April 24, 5 p.m.<anchor n="9" xml:id="d6-f1"/> Messrs. Adams,
                    Carroll and Alvord have arrived and are now having conferences which will last
                    for several days with all the representatives of American interests concerned.
                    Informal negotiations with the appropriate French authorities will probably
                    begin on Thursday.</p>
                <closer><signed><hi rendition="#small-caps">Edge</hi></signed></closer>
            </div>
        </body>
    </text>
