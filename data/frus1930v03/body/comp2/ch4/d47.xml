    <text>
        <body>
            <div xml:id="d47">

                <pb facs="0166" n="72" sameAs="frus:frus1930v03/pg72"/>

                <note rend="inline" type="source">810.79611 Pan American Airways/922:
                    Telegram</note>
                <head><hi rendition="#italic">The Chargé in France</hi> (<hi
                            rendition="#italic">Armour</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1930-11-17T11:00:00+00:00">November 17, 1930—11
                        a.m.</date><lb/>[Received November 17—9:25 a.m.]</dateline></opener>
                <p>375. With further reference to Department’s telegram 292, November 11, 7
                        p.m.<anchor n="62" xml:id="d47-f1"/> I am today orally informed that
                    permission has been extended for another 3 months.</p>
                <closer><signed><hi rendition="#small-caps">Armour</hi></signed></closer>
            </div>
        </body>
    </text>
