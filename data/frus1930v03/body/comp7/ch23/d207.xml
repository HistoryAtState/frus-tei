                <pb facs="0344" n="250" sameAs="frus:frus1930v03/pg250"/>

                <note rend="inline" type="source">838.001B64/16</note>
                <head><hi rendition="#italic">The High Commissioner in Haiti</hi> (<hi rendition="#italic">Russell</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Port-au-Prince</hi></placeName>, <date calendar="gregorian"
                            when="1930-05-07">May 7, 1930</date>.<lb/>[Received May 20.]</dateline>
                    <seg rendition="#float-left">No. 1702</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to forward herewith for
                    the Department’s information a translation of a letter this date received from
                    His Excellency Louis Borno, President of Haiti.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">John H. Russell</hi></signed></closer>


                <xi:include href="d207-a1.xml" xpointer="d207-a1"/>
