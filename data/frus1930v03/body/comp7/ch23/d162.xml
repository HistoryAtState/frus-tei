    <text>
        <body>
            <div xml:id="d162">

                <pb facs="0292" n="198" sameAs="frus:frus1930v03/pg198"/>

                <note rend="inline" type="source">838.00 Commission of
                    Investigation/63:Telegram</note>
                <head><hi rendition="#italic">The High Commissioner in Haiti</hi> (<hi rendition="#italic">Russell</hi>) <hi
                        rendition="#italic">to the Acting Secretary of
                            State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Port-au-Prince</hi></placeName>, <date calendar="gregorian"
                            when="1930-02-28T18:00:00-05:00">February 28, 1930—6
                        p.m.</date><lb/>[Received 8:03 p.m.]</dateline></opener>
                <p>27. Commissioners<anchor n="2" xml:id="d162-f1"/> arrived this afternoon and were
                    presented by me to the President.</p>
                <closer><signed><hi rendition="#small-caps">Russell</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d162-f1" n="2" xml:id="d162-f1-content">
                <p>The Commissioners were W. Cameron Forbes, Chairman, Henry P. Fletcher, Elie
                    Vezina, James Kerney, and William Allen White; see report of the President’s
                    Commission for the Study and Review of Conditions in the Republic of Haiti, <ref
                        target="#pg217">p. 217</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
