                <pb facs="0436" n="342" sameAs="frus:frus1930v03/pg342"/>

                <note rend="inline" type="source">882.5048/242: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Liberia</hi> (<hi
                            rendition="#italic">Carter</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Monrovia</hi></placeName>, <date calendar="gregorian"
                            when="1930-02-20T14:00:00-00:44">February 20, 1930—2
                        p.m.</date><lb/>[Received 2:10 p.m.]</dateline></opener>
                <p>25. Am confidentially informed that the Liberian Government has accepted
                    Christy.</p>
                <closer><signed><hi rendition="#small-caps">Carter</hi></signed></closer>
            </div>
        </body>
