    <text>
        <body>
            <div xml:id="d292">

                <pb facs="0435" n="341" sameAs="frus:frus1930v03/pg341"/>

                <note rend="inline" type="source">882.5048/233: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Chargé in
                        Switzerland</hi> (<hi rendition="#italic">Moffat</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1930-02-14T18:00:00-05:00">February 14, 1930—6
                        p.m.</date></dateline></opener>
                <p>14. Your Numbers 19 and 20, February 12.<anchor n="20" xml:id="d292-f1"/> Please
                    inform Drummond the Department is gratified to learn of Dr. Christy’s
                    appointment and that he will proceed to Liberia at time stated.</p>
                <closer><signed><hi rendition="#small-caps">Cotton</hi></signed></closer>
            </div>
        </body>
    </text>
