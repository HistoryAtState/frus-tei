                <pb facs="0428" n="334" sameAs="frus:frus1930v03/pg334"/>

                <note rend="inline" type="source">882.00/833: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Liberia</hi> (<hi
                            rendition="#italic">Hall</hi>) <hi rendition="#italic">to the
                            Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Monrovia</hi></placeName>, <date calendar="gregorian"
                            when="1930-07-01T16:00:00-00:44">July 1, 1930—4
                        p.m.</date><lb/>[Received 9:41 p.m.]</dateline></opener>
                <p>91. My 89, June 27, 11 p.m. [<hi rendition="#italic">a.m.</hi>] Barclay has
                    requested consent of the Legation to make public the contents of my note
                    declaring documents forgeries. Please instruct.</p>
                <closer><signed><hi rendition="#small-caps">Hall</hi></signed></closer>
            </div>
        </body>
    </text>
