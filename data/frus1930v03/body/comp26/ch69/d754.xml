    <text>
        <body>
            <div xml:id="d754">

                <pb facs="0899" n="805" sameAs="frus:frus1930v03/pg805"/>

                <note rend="inline" type="source">871.014 Bessarabia/128</note>
                <head><hi rendition="#italic">The Rumanian Minister</hi> (<hi
                            rendition="#italic">Davila</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <p>The Roumanian Minister presents his compliments to the Secretary of State, and
                    has the honour to request him to be good enough to let him have a reply to his
                        <hi rendition="#italic">aide-mémoire</hi> of February 18th, concerning the
                    status of Roumanian citizens born in Bessarabia.</p>
                <closer>
                    <dateline rendition="#float-left">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1930-08-22">August 22,
                            1930</date>.</dateline>
                </closer>
                <postscript>
                    <p>No. 3650/P–8</p>
                </postscript>
            </div>
        </body>
    </text>
