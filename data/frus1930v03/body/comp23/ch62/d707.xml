    <text>
        <body>
            <div xml:id="d707">

                <pb facs="0853" n="759" sameAs="frus:frus1930v03/pg759"/>

                <note rend="inline" type="source">823.01/39: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Brazil</hi> (<hi rendition="#italic"
                        >Washington</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Rio de Janeiro</hi></placeName>, <date calendar="gregorian"
                            when="1930-09-20T14:00:00-03:00">September 20, 1930—2
                        p.m.</date><lb/>[Received 2:40 p.m.]</dateline></opener>
                <p>58. Embassy’s 57, September 20, noon.<anchor n="14" xml:id="d707-f1"/> Just been
                    informed that Brazil will recognize the Government of Peru today.</p>
                <closer><signed><hi rendition="#small-caps">Washington</hi></signed></closer>
            </div>
        </body>
    </text>
