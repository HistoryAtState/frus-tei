                <pb facs="0851" n="757" sameAs="frus:frus1930v03/pg757"/>

                <note rend="inline" type="source">823.01/56</note>
                <head><hi rendition="#italic">The Secretary of State to the Ambassador in Peru</hi>
                        (<hi rendition="#italic">Dearing</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1930-09-17">September 17, 1930</date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Dearing</hi>: Your telegram No. 207 of
                    September thirteenth has been of real assistance to me in the last few days.</p>
                <p>Sincerely yours,</p>
                <closer><signed><hi rendition="#small-caps">Henry L. Stimson</hi></signed></closer>
            </div>
        </body>
