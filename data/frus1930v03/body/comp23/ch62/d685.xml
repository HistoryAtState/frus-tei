                <pb facs="0842" n="748" sameAs="frus:frus1930v03/pg748"/>

                <note rend="inline" type="source">823.01/9: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Peru</hi> (<hi
                            rendition="#italic">Dearing</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Lima</hi></placeName>, <date calendar="gregorian"
                            when="1930-09-09T12:00:00-05:00">September 9,
                        1930—noon</date>.<lb/>[Received 4:42 p.m.]</dateline></opener>
                <p>193. Italian and Ecuadorian Governments yesterday recognized the junta as the
                    government of Peru.</p>
                <closer><signed><hi rendition="#small-caps">Dearing</hi></signed></closer>
            </div>
        </body>
