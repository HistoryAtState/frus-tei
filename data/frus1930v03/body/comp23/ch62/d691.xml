                <pb facs="0843" n="749" sameAs="frus:frus1930v03/pg749"/>

                <note rend="inline" type="source">823.01/25</note>
                <head><hi rendition="#italic">The Minister in Guatemala</hi> (<hi
                        rendition="#italic">Whitehouse</hi>) <hi rendition="#italic">to the
                        Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Guatemala</hi></placeName>, <date calendar="gregorian"
                            when="1930-09-12">September 12, 1930</date>.<lb/>[Received September
                        16.]</dateline>
                    <seg rendition="#float-left">No. 159</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to report that the
                    Minister for Foreign Affairs has asked me to let him know as soon as any
                    decision is taken by our Government in regard to the recognition of the new
                    Peruvian Government as he intends to postpone his decision until after ours.</p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">Sheldon
                    Whitehouse</hi></signed></closer>
            </div>
        </body>
