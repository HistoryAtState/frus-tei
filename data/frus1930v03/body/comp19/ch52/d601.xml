                <pb facs="0748" n="654" sameAs="frus:frus1930v03/pg654"/>

                <note rend="inline" type="source">817.00/6841: Telegram</note>
                <head><hi rendition="#italic">The Minister in Nicaragua</hi> (<hi
                        rendition="#italic">Hanna</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Managua</hi></placeName>, <date calendar="gregorian"
                            when="1930-11-03T11:00:00-05:45">November 3, 1930—11
                        a.m.</date><lb/>[Received 12:30 p.m.]</dateline></opener>
                <p>139. Congressional elections were held throughout Nicaragua yesterday without
                    disorder. Returns indicate important gains by the Liberals in both branches of
                    Congress.</p>
                <closer><signed><hi rendition="#small-caps">Hanna</hi></signed></closer>
            </div>
        </body>
