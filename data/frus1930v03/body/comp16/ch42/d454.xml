                <pb facs="0571" n="477" sameAs="frus:frus1930v03/pg477"/>

                <note rend="inline" type="source">812.51/1619</note>
                <head><hi rendition="#italic">The Ambassador in Mexico</hi> (<hi rendition="#italic"
                        >Morrow</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1930-08-22">August 22, 1930</date>.<lb/>[Received August
                        27.]</dateline>
                    <seg rendition="#float-left">No. 2710</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to my telegram No. 187 of
                    August 21, 1930, 4 p.m., and to the memorandum of the Undersecretary of State
                    dated August 3, 1930,<anchor n="16" xml:id="d454-f1"/> in regard to the
                    agreement recently signed in New <pb facs="0572" n="478" xml:id="pg478"/> York
                    by Mr. Montes de Oca, on behalf of the Mexican Government, and Mr. T. W. Lamont,
                    on behalf of the International Committee of Bankers, I have the honor to enclose
                    herewith, for the information and records of the Department, a copy of my answer
                    of August 18th to Mr. Lamont’s letter of July 24th, which Mr. Cotton, in his
                    memorandum of August 3rd, states he has read. I enclose a copy of Mr. Lamont’s
                    letter to me, as a matter of official record.</p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">Dwight W. Morrow</hi></signed></closer>



                <xi:include href="d454-a1.xml" xpointer="d454-a1"/>
                <xi:include href="d454-a2.xml" xpointer="d454-a2"/>
