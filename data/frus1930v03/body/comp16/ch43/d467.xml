            <div xml:id="d467">

                <pb facs="0595" n="501" sameAs="frus:frus1930v03/pg501"/>

                <note rend="inline" type="source">411.12/1148</note>
                <head><hi rendition="#italic">The Ambassador in Mexico</hi> (<hi rendition="#italic">Clark</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1930-12-10">December 10, 1930</date>.<lb/>[Received December
                        17.]</dateline>
                    <seg rendition="#float-left">No. 38</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to my telegram number 345 of
                    December 9, 1930, 6 p.m.,<anchor n="32" xml:id="d467-f1"/> summarizing my
                    interview with the Minister for Foreign Affairs yesterday with respect to the
                    meetings of the General and Special Claims Commissions, United States and
                    Mexico, I have the honor to transmit herewith a memorandum describing the
                    interview in detail.</p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">J. Reuben Clark,
                    Jr.</hi></signed></closer>

                <postscript>
                    <p><hi rendition="#small-caps">Mexico</hi>, December 9, 1930.</p>
                </postscript>

                <xi:include href="d467-a1.xml" xpointer="d467-a1"/>
            </div>
