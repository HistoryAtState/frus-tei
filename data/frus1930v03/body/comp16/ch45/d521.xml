    <text>
        <body>
            <div xml:id="d521">

                <pb facs="0634" n="540" sameAs="frus:frus1930v03/pg540"/>

                <note rend="inline" type="source">711.12155/430</note>
                <head><hi rendition="#italic">The Chargé in Mexico</hi> (<hi rendition="#italic"
                        >Lowry</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1930-05-29">May 29, 1930</date>.<lb/>[Received June 3.]</dateline>
                    <seg rendition="#float-left">No. 2495</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to refer to the
                    Department’s telegram No. 134 dated May 21 [<hi rendition="#italic">20</hi>],
                    1930, 9 a.m. [<hi rendition="#italic">6 p.m.</hi>] and to my reply thereto No.
                    104, dated May 28, 1930, 4 p.m.<anchor n="53" xml:id="d521-f1"/> and to enclose
                    a copy and translation of Foreign Office note No. 7890, dated May 27, 1930, in
                    reply to my note, a copy of which was included with my despatch No. 2478 of May
                    23, 1930.<anchor n="54" xml:id="d521-f2"/></p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Edward P. Lowry</hi></signed></closer>


                <xi:include href="d521-a1.xml" xpointer="d521-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d521-f1" n="53" xml:id="d521-f1-content">
                <p>Telegram No. 104 not printed; it transmitted a portion of note No. 7890, May 27,
                    1930, from the Mexican Minister for Foreign Affairs, <hi rendition="#italic"
                        >infra.</hi></p>
            </note>
            <note corresp="#d521-f2" n="54" xml:id="d521-f2-content">
                <p>Despatch No. 2478 and its enclosure not printed.</p>
            </note>
        </listAnnotation>
    </standOff>
