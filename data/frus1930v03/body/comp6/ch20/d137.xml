    <text>
        <body>
            <div xml:id="d137">

                <pb facs="0275" n="181" sameAs="frus:frus1930v03/pg181"/>

                <note rend="inline" type="source">814.001 Orellana, Manuel/2</note>
                <head><hi rendition="#italic">The Guatemalan Minister</hi> (<hi rendition="#italic">Recinos</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><seg rendition="#center">[Translation<anchor n="4" xml:id="d137-f1"
                    />]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1930-12-18">December 18, 1930</date>.</dateline>
                    <seg rendition="#float-left">No. 103</seg></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: Under instructions from the Minister
                    for Foreign Affairs of Guatemala, I have the honor to inform Your Excellency
                    that, by virtue of the resignation of Licentiate don Baudilio Palma, the
                    Legislative Assembly in yesterday’s session named General Manuel Orellana as
                    Acting President of the Republic during the illness of General Lázaro
                    Chacón.</p>
                <p>Please accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Adrián Recinos</hi></signed></closer>
            </div>
        </body>
    </text>
