    <text>
        <body>
            <div xml:id="d126">

                <pb facs="0269" n="175" xml:id="pg175"/>

                <note rend="inline" type="source">814.001 Palma, Baudilio/3</note>
                <head><hi rendition="#italic">The Secretary to the President</hi> (<hi rendition="#italic">Richey</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1930-12-13">December 13, 1930</date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: By direction of the
                    President I am sending you for the appropriate attention of the Department the
                    enclosed message from Baudilio Palma, Guatemala.</p>
                <p>Sincerely yours,</p>
                <closer><signed><hi rendition="#small-caps">Lawrence Richey</hi></signed></closer>


                <xi:include href="d126-a1.xml" xpointer="d126-a1"/>
