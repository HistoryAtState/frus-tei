    <text>
        <body>
            <div xml:id="d383">

                <pb facs="0615" n="513" xml:id="pg513"/>

                <note rend="inline" type="source">550.S1 Washington/605</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        British Ambassador</hi> (<hi rendition="#italic"
                            >Lindsay</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1933-05-24">May 24, 1933</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Ambassador</hi>: I take pleasure in
                    communicating to you the acknowledging reply of this Government to the
                    memorandum presented by you in behalf of His Majesty’s Government in the
                    Commonwealth of Australia.</p>
                <p>I should be greatly obliged if you will transmit this memorandum to that
                    Government.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Cordell Hull</hi>
                    </signed>
                </closer>


                <xi:include href="d383-a1.xml" xpointer="d383-a1"/>
