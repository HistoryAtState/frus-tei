                <pb facs="0704" n="602" sameAs="frus:frus1933v01/pg602"/>

                <note rend="inline" type="source">550.S1/770: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Chargé in Great Britain</hi> (<hi rendition="#italic"
                            >Atherton</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1933-05-12T20:00:00-04:00">May 12, 1933—8
                            p.m.</date>
                    </dateline>
                </opener>
                <p>108. For Norman Davis. Your 121, May 12, 9 p.m. This is a splendid job. You have
                    my best congratulations.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
