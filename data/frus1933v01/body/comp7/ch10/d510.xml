    <text>
        <body>
            <div xml:id="d510">

                <pb facs="0781" n="679" sameAs="frus:frus1933v01/pg679"/>

                <note rend="inline" type="source">550.S1/1115: Telegram</note>
                <head>
                    <hi rendition="#italic">President Roosevelt to the Acting Secretary of State
                        </hi><anchor n="15" xml:id="d510-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>U. S. S. “<hi rendition="#small-caps"
                            >Indianapolis</hi>,”</placeName>
                        <date calendar="gregorian" when="1933-07-03T23:00:00-06:00">July 3, 1933—11
                            p.m.</date>
                        <lb/> [Received July 4—1:18 a.m.]</dateline>
                </opener>
                <p>22. Your 93.<anchor n="15a" xml:id="d510-f2"/> In discussing effect of recovery
                    legislation on instructions with Cabinet it would be helpful to us if you could
                    suggest <pb facs="0782" n="680" xml:id="pg680"/> to us more particularly in what
                    way and where you fear possible conflict between instructions and general
                    policy.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Roosevelt</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d510-f1" n="15" type="source" xml:id="d510-f1-content">
                <p>Transmitted to the Chairman of the American delegation as telegram No. 99, July
                    4, 10 a.m.</p>
            </note>
            <note corresp="#d510-f2" n="15a" xml:id="d510-f2-content">
                <p>July 3, noon; not printed.</p>
            </note>
        </listAnnotation>
    </standOff>
