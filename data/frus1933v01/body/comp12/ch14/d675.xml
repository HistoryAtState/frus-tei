    <text>
        <body>
            <div xml:id="d675">

                <pb facs="0951" n="849" xml:id="pg849"/>

                <note rend="inline" type="source">800.51W89 Belgium/229</note>
                <head>
                    <hi rendition="#italic">The Belgian Ambassador</hi> (<hi
                            rendition="#italic">May</hi>) <hi rendition="#italic">to the
                            Acting Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Translation]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 1893</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1933-06-14">June 14, 1933</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Secretary of State</hi>: In reply to the letter
                    which Your Excellency addressed to me on the 9th of this month, I have the honor
                    to advise you that the Belgian Government is not in a position to modify, for
                    the due date of June 15, the attitude which circumstances constrained it to
                    adopt on the 15th of December last.<anchor n="44" xml:id="d675-f1"/> It desires
                    to renew the assurance of its entire good will in seeking a satisfactory
                    settlement.</p>
                <p>I take this opportunity [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Paul May</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
