    <text>
        <body>
            <div xml:id="d144">

                <pb facs="0274" n="172" sameAs="frus:frus1933v01/pg172"/>

                <note rend="inline" type="source">500.A15A4/2015: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Chairman of the American
                        Delegation</hi> (<hi rendition="#italic">Davis</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1933-05-29T17:00:00-04:00">May 29, 1933—5
                            p.m.</date>
                    </dateline>
                </opener>
                <p>345. Your 666, May 27, 11 a.m. No reply received from Japanese.<anchor n="41"
                        xml:id="d144-f1"/> In my conversations with Ishii, I have had no discussion
                    of political matters.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d144-f1" n="41" xml:id="d144-f1-content">
                <p>Received June 6; see telegram No. 351, June 6, 6 p.m., to the Chairman of the
                    American delegation, <ref target="#pg184">p. 184</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
