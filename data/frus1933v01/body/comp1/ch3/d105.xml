    <text>
        <body>
            <div xml:id="d105">

                <pb facs="0234" n="132" sameAs="frus:frus1933v01/pg132"/>

                <note rend="inline" type="source">500.A15A4/1851: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        American Delegate</hi> (<hi rendition="#italic"
                            >Wilson</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1933-05-09T17:00:00-04:00">May 9, 1933—5
                            p.m.</date>
                    </dateline>
                </opener>
                <p>330. Your 630, May 6, 11 a.m. Your suggested reply to Saavedra approved,
                    particularly your emphasis on the importance of introducing the figures for
                    Latin American countries prior to signature of convention.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
