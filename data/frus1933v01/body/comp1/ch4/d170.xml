    <text>
        <body>
            <div xml:id="d170">

                <pb facs="0305" n="203" sameAs="frus:frus1933v01/pg203"/>

                <note rend="inline" type="source">500.A15A4/2182</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Italy</hi> (<hi rendition="#italic"
                        >Long</hi>) <hi rendition="#italic">to the Acting Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 98</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Rome</hi></placeName>, <date
                            calendar="gregorian" when="1933-07-24">July 24,
                        1933</date>.<lb/>[Received August 8.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith for
                    your information a copy of a memorandum of a conversation which I had with Baron
                    Aloisi, Chief of Cabinet of the Ministry of Foreign Affairs, regarding <pb
                        facs="0306" n="204" xml:id="pg204"/> the Disarmament and Economic
                        Conferences,<anchor n="97" xml:id="d170-f1"/> with special relation to
                    Italian policy in Europe based on the Four Power Pact.<anchor n="97a"
                        xml:id="d170-f2"/>
                </p>
                <p>Respectfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Breckinridge Long</hi>
                    </signed>
                </closer>


                <xi:include href="d170-a1.xml" xpointer="d170-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d170-f1" n="97" xml:id="d170-f1-content">
                <p>For correspondence on the Economic Conference, see <ref target="#pg452">pp.
                        452</ref> ff.</p>
            </note>
            <note corresp="#d170-f2" n="97a" xml:id="d170-f2-content">
                <p>For correspondence concerning the Four Power Pact, see <ref target="#pg396">pp.
                        396</ref> ff.</p>
            </note>
        </listAnnotation>
    </standOff>
