            <div xml:id="d37">

                <pb facs="0141" n="39" sameAs="frus:frus1933v01/pg39"/>

                <note rend="inline" type="source">500.A15A4 Personnel/955: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Acting Chairman of the
                        American Delegation</hi> (<hi rendition="#italic">Gibson</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1933-03-14T18:00:00-05:00">March 14, 1933—6
                            p.m.</date>
                    </dateline>
                </opener>
                <p>304. Personal for Gibson. The President has appointed Mr. Norman Davis Chairman
                    of the Delegation to the Disarmament Conference. He is planning to sail for
                    Europe within 10 days and is being given the personal rank of Ambassador.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
