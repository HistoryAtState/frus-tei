    <text>
        <body>
            <div xml:id="d261">

                <pb facs="0447" n="345" sameAs="frus:frus1933v01/pg345"/>

                <note rend="inline" type="source">500.A15A4 General Committee/726</note>
                <head>
                    <hi rendition="#italic">The Chargé in Great Britain</hi> (<hi
                        rendition="#italic">Atherton</hi>) <hi rendition="#italic">to the Acting
                        Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 388</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1933-12-18">December 18,
                        1933</date>.<lb/>[Received December 29.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to refer to my strictly
                    confidential telegram No. 341, December 18, 7 p.m.,<anchor n="72"
                        xml:id="d261-f1"/> and to enclose a copy of a memorandum of a conversation I
                    had with the Prime Minister this afternoon.</p>
                <p>Respectfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Ray Atherton</hi>
                    </signed>
                </closer>


                <xi:include href="d261-a1.xml" xpointer="d261-a1"/>
            </div>
        </body>
    </text>
