    <text>
        <body>
            <div xml:id="d205">

                <pb facs="0367" n="265" sameAs="frus:frus1933v01/pg265"/>

                <note rend="inline" type="source">500.C001/821a: Circular telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Great
                        Britain</hi> (<hi rendition="#italic">Bingham</hi>)<anchor n="72"
                        xml:id="d205-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1933-10-14T10:00:00-05:00">October 14,
                            1933—10 a.m.</date>
                    </dateline>
                </opener>
                <p>As soon as you are able to determine the attitude of the British Government
                    toward the reported German withdrawal from the League of Nations and the
                    Disarmament Conference and its implications, please telegraph a full
                    analysis.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d205-f1" n="72" type="source" xml:id="d205-f1-content">
                <p>The same, <hi rendition="#italic">mutatis mutandis</hi>, October 14, to the
                    American diplomatic missions in France, Italy, Czechoslovakia, and Poland.</p>
            </note>
        </listAnnotation>
    </standOff>
