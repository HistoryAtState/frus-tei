    <text>
        <body>
            <div xml:id="d305">

                <pb facs="0517" n="415" sameAs="frus:frus1933v01/pg415"/>

                <note rend="inline" type="source">740.0011 Four Power Pact/92: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Italy</hi> (<hi rendition="#italic"
                        >Long</hi>) <hi rendition="#italic">to the Acting Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Rome</hi>
                        </placeName> [<date ana="#date_undated-inferred-from-outside-research"
                            calendar="gregorian" when="1933-06-07">undated</date>].<lb/>[Received
                        June 7—3:48 p.m.]</dateline>
                </opener>
                <p>60. Four Power Pact<anchor n="41" xml:id="d305-f1"/> is being initialed in Rome
                    at 7:30 p.m.</p>
                <p>Repeated to Geneva, London, Paris, Berlin.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Long</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
