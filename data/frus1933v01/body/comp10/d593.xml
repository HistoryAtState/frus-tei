                <pb facs="0888" n="786" sameAs="frus:frus1933v01/pg786"/>

                <note rend="inline" type="source">560.M2/359: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Minister in
                        Switzerland</hi> (<hi rendition="#italic">Wilson</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1933-07-07T17:00:00-04:00">July 7, 1933—5
                            p.m.</date>
                    </dateline>
                </opener>
                <p>34. Your 22, July 3, noon. Advise League that American Government’s withdrawal
                    applies also to supplementary agreement to convention and protocol signed July
                    11, 1928.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Phillips</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
