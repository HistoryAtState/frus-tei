                <pb facs="1063" n="961" sameAs="frus:frus1933v01/pg961"/>

                <note rend="inline" type="source">579.6L3/61: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Italy</hi>
                        (<hi rendition="#italic">Garrett</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1933-05-22T19:00:00-04:00">May 22, 1933—7
                            p.m.</date>
                    </dateline>
                </opener>
                <p>27. Your 38, May 20, 1 p.m. For Cooper. American delegates are authorized to sign
                    convention with declaration that it applies only to continental United
                    States.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
