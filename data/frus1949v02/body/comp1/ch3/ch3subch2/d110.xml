            <div xml:id="d110">

                <pb facs="0206" n="190" sameAs="frus:frus1949v02/pg190"/>

                <note rend="inline" type="source">501.BB/9–2349: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            Acting Secretary of State
                    </hi>
                </head>
                <opener><seg rendition="#center">[Extract]</seg></opener>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">New York</hi></placeName>, <date
                            calendar="gregorian" when="1949-09-23T16:51:00-04:00">September 23,
                            1949—4:51 p. m.</date>
                    </dateline>
                </opener>
                <p>
                    Delga 15. Following decisions taken at GADel meeting September 23:</p>
                <p>. . . . . . .</p>
                <p>2. China. Effort will be made to elicit reaction of other delegates, especially
                    of Asiatic delegates, to Tsiang’s speech.</p>
                <p>. . . . . . .</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
