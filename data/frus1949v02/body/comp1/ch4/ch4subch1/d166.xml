            </note>
            <note corresp="#d166-f4" n="4" xml:id="d166-f4-content">
                <p>Ernest Bevin, British Secretary of State for Foreign Affairs and Head of the
                    British Delegation to the General Assembly.</p>
            </note>
        </listAnnotation>
