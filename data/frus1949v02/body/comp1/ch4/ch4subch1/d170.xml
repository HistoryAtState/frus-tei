    <text>
        <body>
            <div xml:id="d170">

                <pb facs="0268" n="252" sameAs="frus:frus1949v02/pg252"/>

                <note rend="inline" type="source">IO Files: US/A/1778</note>
                <head>
                    <hi rendition="#italic">United States Delegation Working Paper</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">confidential</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps">New
                                York</hi></placeName>,] <date calendar="gregorian" when="1949-09-27"
                            >September 27, 1949</date>.</dateline>
                </opener>
                <p rendition="#center">
                    <hi rendition="#small-caps">Status of Council Slates</hi>
                </p>
                <p>1. <hi rendition="#italic">Security Council</hi>
                </p>
                <table cols="2" rows="4">
                    <row role="label">
                        <cell>
                            <hi rendition="#italic">Retiring Members</hi>
                        </cell>
                        <cell>
                            <hi rendition="#italic">Recommended Slate</hi>
                        </cell>
                    </row>
                    <row>
                        <cell>Canada</cell>
                        <cell>India</cell>
                    </row>
                    <row>
                        <cell>Argentina</cell>
                        <cell>Ecuador</cell>
                    </row>
                    <row>
                        <cell>Ukrainian SSR</cell>
                        <cell>Yugoslavia</cell>
                    </row>
                </table>
                <p>2. <hi rendition="#italic">Economic and Social Council</hi>
                </p>
                <table cols="2" rows="7">
                    <row>
                        <cell>
                            <hi rendition="#italic">Retiring Members</hi>
                        </cell>
                        <cell/>
                    </row>
                    <row>
                        <cell>Byelorussian SSR</cell>
                        <cell>undecided (no announced Soviet candidate; preference for a constituent
                            republic)</cell>
                    </row>
                    <row>
                        <cell>Lebanon</cell>
                        <cell>Pakistan</cell>
                    </row>
                    <row>
                        <cell>New Zealand</cell>
                        <cell>Canada</cell>
                    </row>
                    <row>
                        <cell>Turkey</cell>
                        <cell>Iran</cell>
                    </row>
                    <row>
                        <cell>United States</cell>
                        <cell>United States</cell>
                    </row>
                    <row>
                        <cell>Venezuela</cell>
                        <cell>Mexico (if it is the preferred Latin American candidate)</cell>
                    </row>
                </table>
                <p>3. <hi rendition="#italic">Trusteeship Council</hi>
                </p>
                <table cols="2" rows="4">
                    <row>
                        <cell>
                            <hi rendition="#italic">Retiring Members</hi>
                        </cell>
                        <cell/>
                    </row>
                    <row>
                        <cell>Iraq</cell>
                        <cell>Lebanon or Greece (Lebanon, Syria and Iraq all appear to be
                            candidates)</cell>
                    </row>
                    <row>
                        <cell>Mexico</cell>
                        <cell>Dominican Republic</cell>
                    </row>
                    <row>
                        <cell>Costa Rica (resigned; election to fill unexpired one-year term)</cell>
                        <cell>Mexico or Argentina</cell>
                    </row>
                </table>
            </div>
        </body>
    </text>
