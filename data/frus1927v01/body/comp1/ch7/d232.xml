    <text>
        <body>
            <div xml:id="d232">

                <pb facs="0372" n="286" sameAs="frus:frus1927v01/pg286"/>

                <note rend="inline" type="source">551.2 A 2/–: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Switzerland</hi> (<hi rendition="#italic">Marriner</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Berne</hi></placeName>, <date calendar="gregorian"
                            when="1927-01-13T12:00:00+01:00"><hi rendition="#italic">January 13,
                                1927—noon</hi></date>.<lb/>[Received 2:30 p.m.]</dateline></opener>
                <p>7. My 138, December 28, 3 p.m.<anchor n="30" xml:id="d232-f1"/> Letter from
                    League Secretariat states that on January 12th experts on double taxation
                    decided to hold next meeting in London on April 4th, 1927, and have expressed
                    the hope that an expert from the United States will take part in that
                        meeting.<anchor n="31" xml:id="d232-f2"/></p>
                <p>Secretariat requests to be informed as soon as possible of name of American
                    expert so that formal invitation may be sent him.</p>
                <closer><signed><hi rendition="#small-caps">Marriner</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d232-f1" n="30" xml:id="d232-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d232-f2" n="31" xml:id="d232-f2-content">
                <p>The United States had not been represented at the meeting of the Committee of
                    Experts on Double Taxation and Tax Evasion at Geneva on Jan. 5, 1927.</p>
            </note>
        </listAnnotation>
    </standOff>
