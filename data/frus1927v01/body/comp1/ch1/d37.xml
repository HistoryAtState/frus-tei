                <pb facs="0124" n="38" sameAs="frus:frus1927v01/pg38"/>

                <note rend="inline" type="source">500.A15 a 1/213a: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Ambassador in Great Britain</hi> (<hi
                            rendition="#italic">Houghton</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1927-05-05T12:00:00-04:00"><hi rendition="#italic">May 5,
                                1927—noon</hi></date>.</dateline></opener>
                <p>93. Please bring following to the attention of Chamberlain: This Government
                    assumes that the British Delegation at the forthcoming Three Power Conference
                    will either include fully empowered Dominion representatives as at the
                    Washington Conference or will itself be empowered by Dominion Governments.</p>
                <closer><signed><hi rendition="#small-caps">Kellogg</hi></signed></closer>
            </div>
        </body>
