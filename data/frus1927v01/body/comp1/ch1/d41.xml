    <text>
        <body>
            <div xml:id="d41">

                <pb facs="0126" n="40" xml:id="pg40"/>

                <note rend="inline" type="source">500.A15 a 1/244a</note>
                <head><hi rendition="#italic">The Secretary of State to the British Ambassador</hi>
                        (<hi rendition="#italic">Howard</hi>)<anchor n="37" xml:id="d41-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1927-05-23"><hi rendition="#italic">May 23,
                        1927</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: In accordance with informal
                    conversations on this subject, I now have the honor to confirm the arrangement
                    that the Three Power Naval Conference at Geneva will open at four o’clock on
                    Monday, June 20, 1927.</p>
                <p>Accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Frank B. Kellogg</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d41-f1" n="37" type="source" xml:id="d41-f1-content">
                <p>An identic note was sent on the same date to the Japanese Ambassador.</p>
            </note>
        </listAnnotation>
    </standOff>
