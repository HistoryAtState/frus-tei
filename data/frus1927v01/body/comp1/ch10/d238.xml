                        </row>
                        <row>
                            <cell>Dr. Alfredo Sordelli</cell>
                        </row>
                        <row>
                            <cell rows="2">Bolivia:</cell>
                            <cell>Dr. Adolfo Flores</cell>
                        </row>
                        <row>
                            <cell>Dr. Adolfo Durán</cell>
                        </row>
                        <row>
                            <cell rows="2">United States of Brazil:</cell>
                            <cell>Dr. João Pedro de Albuquerque</cell>
                        </row>
                        <row>
                            <cell>Dr. Bento Oswaldo Cruz</cell>
                        </row>
                        <row>
                            <cell>Colombia:</cell>
                            <cell>Dr. Julio Aparicio</cell>
                        </row>
                        <row>
