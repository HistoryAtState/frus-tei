                            <cell>Dr. Luis M. Cueva</cell>
                        </row>
                        <row>
                            <cell rows="3">United States of America:</cell>
                            <cell>Dr. Huph S. Cumming</cell>
                        </row>
                        <row>
                            <cell>Dr. Bolivar J. Lloyd</cell>
                        </row>
                        <row>
                            <cell>Dr. John D. Long</cell>
                        </row>
                        <row>
                            <cell>Guatemala:</cell>
                            <cell>Mr. Pablo Emilio Guedes</cell>
                        </row>
                        <row>
                            <cell rows="2">Haiti:</cell>
                            <cell>Mr. Víctor Kieffer Marchand</cell>
                        </row>
                        <row>
                            <cell>Dr. Guillermo Angulo P. A.</cell>
                        </row>
