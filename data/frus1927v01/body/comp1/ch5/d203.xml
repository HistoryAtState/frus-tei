                <pb facs="0326" n="240" sameAs="frus:frus1927v01/pg240"/>

                <note rend="inline" type="source">550.M1/319</note>
                <head><hi rendition="#italic">The Chairman of the American Delegation to the
                        International Economic Conference</hi> (<hi
                            rendition="#italic">Robinson</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1927-06-10"><hi rendition="#italic">June 10,
                        1927</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I have the honor to lay
                    before you, for presentation to the President, my report as Chairman of the
                    American Delegation to the International Economic Conference held in Geneva.</p>
                <p>I wish in particular to express my deep appreciation of the unfailing courtesy
                    and support extended to the Delegation by the representatives of the State
                    Department in Geneva.</p>
                <p>I am [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Henry M. Robinson</hi></signed></closer>



                <xi:include href="d203-a1.xml" xpointer="d203-a1"/>
