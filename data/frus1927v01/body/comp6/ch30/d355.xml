    <text>
        <body>
            <div xml:id="d355">

                <pb facs="0575" n="489" sameAs="frus:frus1927v01/pg489"/>

                <note rend="inline" type="source">711.42157 Sa 29/317</note>
                <head><hi rendition="#italic">The Minister in Canada</hi> (<hi rendition="#italic"
                        >Phillips</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Ottawa</hi></placeName>, <date calendar="gregorian"
                            when="1927-07-13"><hi rendition="#italic">July 13,
                        1927</hi></date>.<lb/>[Received July 19.]</dateline>
                    <seg rendition="#float-left">No. 15</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Confirming my telegram No. 9, of July 12,
                    10 p.m.,<anchor n="20" xml:id="d355-f1"/> I have the honor to transmit herewith
                    as a matter of record a copy of Mr. Mackenzie King’s note on the St. Lawrence
                    waterway, dated July 12, 1927, in reply to your note to the Canadian Minister at
                    Washington of April 13, 1927. There is likewise enclosed a copy of a personal
                    letter from Mr. Mackenzie King<anchor n="20" xml:id="d355-f2"/> on the subject
                    of the publication of the two notes.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">William Phillips</hi></signed></closer>


                <xi:include href="d355-a1.xml" xpointer="d355-a1"/>
            </div>
        </body>
    </text>
