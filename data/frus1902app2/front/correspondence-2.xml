    <text>
        <body>
            <div xml:id="correspondence-2">

                <pb facs="0011" n="3" sameAs="frus:frus1902app2/pg3"/>

                <head>[Untitled]</head>
                <p rendition="#flush">The <hi rendition="#small-caps">President</hi>:</p>
                <p>The Secretary of State, to whom was referred the resolution of the Senate of
                    December 4, 1902, requesting the President, if not incompatible with the public
                    interest, to send to the Senate the report and accompanying papers of the agent
                    of the United States in the case of the United States <hi rendition="#italic"
                        >v</hi>. Mexico before the Permanent Court of Arbitration under The Hague
                    Convention,” has the honor to lay before the President a copy of the agent’s
                    report with pleadings, appendix, exhibits, briefs, and record of the entire
                    proceedings.</p>
                <p>Respectfully submitted.</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed>
                    <lb/>
                    <dateline rendition="#float-left"><hi rendition="#small-caps">Department of
                            State</hi>,<lb/><placeName><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1902-12-06"><hi rendition="#italic">December 6,
                        1902</hi></date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
