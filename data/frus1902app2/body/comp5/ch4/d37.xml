    <text>
        <body>
            <div xml:id="d37">

                <pb facs="0382" n="374" sameAs="frus:frus1902app2/pg374"/>

                <head ana="#head_untitled-inferred-from-chapter-head"><hi rendition="#small-caps"
                        >Powers of attorney from the bishops of Sacramento and Monterey to the
                        archbishop of San Francisco</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Sacramento, Cal.</hi></placeName>, <date calendar="gregorian"
                            when="1902-07-30"><hi rendition="#italic">July 30,
                        1902</hi></date>.</dateline></opener>
                <p rendition="#flush">Most Rev. <hi rendition="#small-caps">P. W. Riordan</hi>, <hi
                        rendition="#italic">Archbishop of San Francisco.</hi></p>
                <p><hi rendition="#small-caps">Most Reverend Dear Archbishop</hi>: I enclose
                    herewith my general power of attorney. You may need it before the arbitral court
                    of the Pious Fund claim at The Hague. By this I appoint you to act in my stead
                    for the collection of said moneys of the Pious Fund.</p>
                <p>Yours truly in Christ,</p>
                <closer>[<hi rendition="#small-caps">corporate seal.</hi>] <signed><hi
                            rendition="#small-caps">Thomas Grace</hi>,<lb/><hi rendition="#italic"
                            >Reman Catholic Bishop of Sacramento.</hi></signed></closer>



                <xi:include href="d37-a1.xml" xpointer="d37-a1"/>
                <xi:include href="d37-a2.xml" xpointer="d37-a2"/>
            </div>
