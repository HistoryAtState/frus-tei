    <text>
        <body>
            <div xml:id="d38-a1">

                <pb facs="0387" n="379" sameAs="frus:frus1902app2/pg379"/>

                <p>I, Albert B. Mahony, county clerk of the city and county of San Francisco, State
                    of California, and ex-officio clerk of the superior court in and for said city
                    and county, hereby certify the foregoing to be a full, true, and correct copy of
                    the original declaration and notice of corporate succession in the
                    above-entitled cause, filed in my office on the 25th day of March, A. D.
                    1885.</p>
                <closer>
                    <dateline rendition="#float-left">Attest my hand and seal of said court <date
                            calendar="gregorian" when="1902-06-13">this 13th day of June,
                            1902</date>.</dateline>
                    <lb/> [<hi rendition="#small-caps">seal.</hi>] <signed><hi
                            rendition="#small-caps">Albert B. Mahony</hi>, <hi rendition="#italic"
                            >Clerk</hi></signed>,<lb/>By <signed><hi rendition="#small-caps">Joseph
                            Riordan</hi>, <hi rendition="#italic">Deputy
                    Clerk.</hi></signed></closer>
                <postscript>
                    <p>(Endorsed:) 9639. In the matter of “The Roman Catholic Archbishop of San
                        Francisco,” a religious corporation sole. Declaration and notice of
                        corporate succession. Filed March 25, 1885. Jas. J. Flynn, clerk. By Jno. J.
                        Mott, deputy clerk.</p>
                </postscript>
            </div>
        </body>
    </text>
