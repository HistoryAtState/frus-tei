    <text>
        <body>
            <div xml:id="d570">

                <pb facs="0786" n="704" sameAs="frus:frus1925v02/pg704"/>

                <note rend="inline" type="source">701.60 a 11/1a</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Secretary of State for Foreign Affairs of San Marino</hi> (<hi rendition="#italic">Gozi</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1924-03-08"><hi rendition="#italic">March 8,
                        1924</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I have the honor to acknowledge the
                    receipt of Your Excellency’s letter of February 2d informing me of the
                    appointment of Commander Ignazio Pollak as Envoy Extraordinary to the United
                    States to deliver the greetings of the Government and people of San Marino.</p>
                <p>In reply I beg to inform Your Excellency of the high appreciation of the
                    Government of the United States of the friendly motive prompting the appointment
                    of Commander Pollak for this mission and that <pb facs="0787" n="705"
                        xml:id="pg705"/> I shall be most pleased to receive him for the purpose
                    stated on his coming to Washington.<anchor n="2" xml:id="d570-f1"/></p>
                <p>Accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Charles E. Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d570-f1" n="2" xml:id="d570-f1-content">
                <p>Commander Pollak was received by the Secretary of State on Apr. 17, 1924.</p>
            </note>
        </listAnnotation>
    </standOff>
