                <pb facs="0527" n="445" sameAs="frus:frus1925v02/pg445"/>

                <note rend="inline" type="source">882.6176 F 51/40: Telegram</note>
                <head><hi rendition="#italic">The Minister in Liberia</hi> (<hi rendition="#italic">Hood</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Monrovia</hi></placeName>, <date calendar="gregorian"
                            when="1925-06-19T17:00:00-00:44"><hi rendition="#italic">June 19, 1925—5
                                p.m.</hi></date><lb/>[Received, June 20—4:25
                    p.m.]</dateline></opener>
                <p>24. Referring to the Department’s number 13, June 12. The Government of Liberia
                    accept and appreciate invitation and assistance generously offered and will
                    dispatch officials to arrange bankers’ loan.</p>
                <closer><signed><hi rendition="#small-caps">Hood</hi></signed></closer>
            </div>
        </body>
