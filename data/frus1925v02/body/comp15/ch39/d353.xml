    <text>
        <body>
            <div xml:id="d353">

                <pb facs="0508" n="426" sameAs="frus:frus1925v02/pg426"/>

                <note rend="inline" type="source">882.6176 F 51/93</note>
                <head><hi rendition="#italic">The Secretary to the President</hi> (<hi rendition="#italic">Sanders</hi>) <hi
                        rendition="#italic">to the Chief of the Division of Western European
                        Affairs</hi> (<hi rendition="#italic"
                        >Castle</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1925-04-30"><hi rendition="#italic">April 30,
                        1925</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Castle</hi>: The President directs me to
                    send you the accompanying telegram from Mr. Harvey S. Firestone, Akron, Ohio, in
                    the matter of securing the signature of the Liberian Government to the rubber
                    planting agreements which were approved by the State Department.</p>
                <p>Sincerely yours,</p>
                <closer><signed><hi rendition="#small-caps">Everett Sanders</hi></signed></closer>


                <xi:include href="d353-a1.xml" xpointer="d353-a1"/>
