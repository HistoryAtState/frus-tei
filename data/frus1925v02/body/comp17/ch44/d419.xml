    <text>
        <body>
            <div xml:id="d419">

                <pb facs="0613" n="531" sameAs="frus:frus1925v02/pg531"/>

                <note rend="inline" type="source">812.6363/1590</note>
                <head><hi rendition="#italic">The Ambassador in Mexico</hi> (<hi rendition="#italic">Sheffield</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1925-11-27"><hi rendition="#italic">November 27,
                        1925</hi></date>.<lb/>[Received December 3.]</dateline>
                    <seg rendition="#float-left">No. 1415</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Confirming my telegram No. 252 of today’s
                    date, twelve noon [<hi rendition="#italic">11 a.m.</hi>],<anchor n="31"
                        xml:id="d419-f1"/> I have the honor to enclose herewith for the Department’s
                    information the text of a bill regulating the petroleum industry in Mexico,
                    which was passed by the Chamber of Deputies yesterday, as published in today’s
                        <hi rendition="#italic">El Universal.</hi></p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">James R.
                    Sheffield</hi></signed></closer>


                <xi:include href="d419-a1.xml" xpointer="d419-a1"/>
            </div>
        </body>
    </text>
