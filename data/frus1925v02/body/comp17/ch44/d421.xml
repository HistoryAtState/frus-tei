                <pb facs="0622" n="540" sameAs="frus:frus1925v02/pg540"/>

                <note rend="inline" type="source">812.5200/121</note>
                <head><hi rendition="#italic">The Ambassador in Mexico</hi> (<hi rendition="#italic"
                        >Sheffield</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1925-12-08"><hi rendition="#italic">December 8,
                        1925</hi></date>.<lb/>[Received December 15.]</dateline>
                    <seg rendition="#float-left">No. 1473</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Confirming my telegram No. 269 of today’s
                    date, ten A.M.,<anchor n="38" xml:id="d421-f1"/> transmitting translation of the
                    memorandum dated December 5, which I received last night from the Mexican
                    Secretary of Foreign Relations, in reply to my <hi rendition="#italic">aide
                        memoire</hi> of November 27, last, on the subject of the bill regulating
                    fraction 1 of article 27 of the Mexican Constitution, I have the honor herewith
                    to enclose copy with translation of the said memorandum.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">James R.
                    Sheffield</hi></signed></closer>


                <xi:include href="d421-a1.xml" xpointer="d421-a1"/>
            </div>
        </body>
    </text>
