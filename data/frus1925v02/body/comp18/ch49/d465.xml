                <pb facs="0694" n="612" sameAs="frus:frus1925v02/pg612"/>

                <note rend="inline" type="source">881.00/1181</note>
                <head><hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic">Herrick</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1925-11-14"><hi rendition="#italic">November 14,
                        1925</hi></date>.<lb/>[Received November 27.]</dateline>
                    <seg rendition="#float-left">No. 5720</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to my despatch No. 5701 of
                    November 10, 1925, I have the honor to transmit herewith the original and
                    translation of an article which appeared in <hi rendition="#italic">Le
                        Temps</hi> of today’s issue.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Myron T. Herrick</hi></signed></closer>


                <xi:include href="d465-a1.xml" xpointer="d465-a1"/>
