    <text>
        <body>
            <div xml:id="d456">

                <pb facs="0686" n="604" sameAs="frus:frus1925v02/pg604"/>

                <note rend="inline" type="source">881.00/1096</note>
                <head><hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic">Herrick</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1925-07-03"><hi rendition="#italic">July 3,
                        1925</hi></date>.<lb/>[Received July 13.]</dateline>
                    <seg rendition="#float-left">No. 5361</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to my telegram No. 364, July
                    3, 5 p.m.,<anchor n="16" xml:id="d456-f1"/> I have the honor to transmit
                    herewith copy and translation of two notes from the Ministry for Foreign Affairs
                    regarding the surveillance of the Moroccan coast by French and Spanish
                        warships.<anchor n="17" xml:id="d456-f2"/></p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Myron T. Herrick</hi></signed></closer>



                <xi:include href="d456-a1.xml" xpointer="d456-a1"/>
                <xi:include href="d456-a2.xml" xpointer="d456-a2"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d456-f1" n="16" xml:id="d456-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d456-f2" n="17" xml:id="d456-f2-content">
                <p>Similar notes from the Spanish Foreign Office, dated June 26 (<hi
                        rendition="#italic">supra</hi>) and July 2 (not printed), were received by
                    the Embassy at Madrid and forwarded to the Department in despatches of June 29
                    and July 3 (file Nos. 881.00/1098, 1110).</p>
            </note>
        </listAnnotation>
    </standOff>
