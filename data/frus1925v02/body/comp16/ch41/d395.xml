    <text>
        <body>
            <div xml:id="d395">

                <pb facs="0585" n="503" sameAs="frus:frus1925v02/pg503"/>

                <note rend="inline" type="source">611.60 m 31/18</note>
                <head><hi rendition="#italic">The Lithuanian Minister</hi> (<hi rendition="#italic">Bizauskas</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1926-07-09"><hi rendition="#italic">July 9,
                        1926</hi></date>.<lb/>[Received July 10.]</dateline>
                    <seg rendition="#float-left">No. 2334</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inform you that the <hi
                        rendition="#italic">modus vivendi</hi> concluded between the Government of
                    Lithuania and the Government of the United States by the exchange of notes on
                    December 23, 1925, was ratified by the Lithuanian Seimas on March 24, 1926.</p>
                <p>Accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps">K. Bizauskas</hi></signed></closer>
            </div>
        </body>
