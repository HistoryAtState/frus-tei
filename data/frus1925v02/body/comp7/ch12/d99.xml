                <pb facs="0201" n="119" sameAs="frus:frus1925v02/pg119"/>

                <note rend="inline" type="source">890d.01/226: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic">Herrick</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1925-11-09T12:00:00+00:00"><hi rendition="#italic">November 9,
                                1925—noon</hi></date>.<lb/>[Received November 9—8:53
                        a.m.]</dateline></opener>
                <p>554. Senator Henry de Jouvenel, the editor of <hi rendition="#italic">Le
                        Matin</hi>, has been appointed High Commissioner in Syria and will leave
                    this week for his post.</p>
                <closer><signed><hi rendition="#small-caps">Herrick</hi></signed></closer>
            </div>
        </body>
