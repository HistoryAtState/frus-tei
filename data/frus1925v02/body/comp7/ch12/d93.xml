    <text>
        <body>
            <div xml:id="d93">

                <pb facs="0198" n="116" xml:id="pg116"/>

                <note rend="inline" type="source">890d.01/225: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic"
                        >Herrick</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1925-10-31T13:00:00+00:00"><hi rendition="#italic">October 31,
                                1925—1 p.m.</hi></date><lb/>[Received October 31—9:55
                        a.m.]</dateline></opener>
                <p>532. My 530, October 30, 3 p.m.<anchor n="12" xml:id="d93-f1"/> Sarrail has been
                    officially recalled and General Duport will take over temporarily pending
                    appointment of civilian commissioner.</p>
                <closer><signed><hi rendition="#small-caps">Herrick</hi></signed></closer>
            </div>
        </body>
    </text>
