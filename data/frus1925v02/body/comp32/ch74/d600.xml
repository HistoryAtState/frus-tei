            <div xml:id="d600">

                <pb facs="0816" n="734" sameAs="frus:frus1925v02/pg734"/>

                <note rend="inline" type="source">467.00 R 29/57</note>
                <head><hi rendition="#italic">The Chairman of the Senate Committee on Foreign
                        Relations</hi> (<hi rendition="#italic"
                        >Borah</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1925-02-05"><hi rendition="#italic">February 5,
                        1925</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: Enclosed please find a
                    resolution introduced by Senator King and referred to the Committee on Foreign
                    Relations.</p>
                <p>I am directed by the Committee to transmit it to you with a view that you may
                    give us such facts or make such suggestions relative thereto as you deem proper.
                    The Committee is not informed with reference to the facts with which the
                    resolution seems to deal.</p>
                <p>Very respectfully,</p>
                <closer><signed><hi rendition="#small-caps">Wm. E. Borah</hi></signed></closer>


                <xi:include href="d600-a1.xml" xpointer="d600-a1"/>
            </div>
