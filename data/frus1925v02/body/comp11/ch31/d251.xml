                <pb facs="0382" n="300" sameAs="frus:frus1925v02/pg300"/>

                <note rend="inline" type="source">838.00Electoral Law/5</note>
                <head><hi rendition="#italic">The Chargé in Haiti</hi> (<hi rendition="#italic"
                        >Merrell</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><seg rendition="#center">[Extract]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Port au Prince</hi></placeName>, <date calendar="gregorian"
                            when="1925-07-18"><hi rendition="#italic">July 18,
                        1925</hi></date>.<lb/>[Received July 24.]</dateline>
                    <seg rendition="#float-left">No. 803</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to the Department’s telegram
                    No. 27 of July 8, 7 p.m. relative to the project of a Communal Election Law
                    which was submitted by the American High Commissioner for the Department’s
                    consideration, I have the honor to transmit herewith a copy of a memorandum
                    prepared by the Legal Adviser to the High Commissioner explaining the
                    deficiencies of the Electoral Laws now in force in Haiti.</p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">George R. Merrell</hi>,
                    Jr.</signed></closer>


                <xi:include href="d251-a1.xml" xpointer="d251-a1"/>
            </div>
