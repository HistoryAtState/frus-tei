    <text>
        <body>
            <div xml:id="d199">

                <pb facs="0336" n="254" sameAs="frus:frus1925v02/pg254"/>

                <note rend="inline" type="source">841.6176/14</note>
                <head><hi rendition="#italic">The Ambassador in Cheat Britain</hi> (<hi
                        rendition="#italic">Houghton</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1925-07-23"><hi rendition="#italic">July 23,
                        1925</hi></date>.<lb/>[Received August 4.]</dateline>
                    <seg rendition="#float-left">No. 213</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my telegram No. 224 of July
                    23, 5 p.m., 1925,<anchor n="84" xml:id="d199-f1"/> I have the honor to enclose a
                    copy, in triplicate, of the <hi rendition="#italic">Aide-Memoire</hi> which I
                    left with Mr. Chamberlain<anchor n="85" xml:id="d199-f2"/> with regard to the
                    situation in the United States in the rubber industry.</p>
                <p>I have [etc.]</p>
                <closer>For the Ambassador:<lb/><signed><hi rendition="#small-caps">F. A.
                            Sterling</hi></signed><lb/><hi rendition="#italic">Counselor of
                        Embassy</hi></closer>


                <xi:include href="d199-a1.xml" xpointer="d199-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
