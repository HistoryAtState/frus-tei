    <text>
        <body>
            <div xml:id="d211">

                <pb facs="0352" n="270" xml:id="pg270"/>

                <note rend="inline" type="source">811.512341Shipping/33</note>
                <head><hi rendition="#italic">The British Ambassador</hi> (<hi
                            rendition="#italic">Howard</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1924-11-26"><hi rendition="#italic">November 26,
                        1924</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1148</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to my Note of November 18th,
                    I now have the honour to transmit herewith for your information copy of an Order
                    of His Majesty the King in Council, dated November 7th, 1924, and taking effect
                    from that date, regarding the arrangement with your government for the
                    reciprocal exemption of shipping profits from income tax.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Esme Howard</hi></signed></closer>


                <xi:include href="d211-a1.xml" xpointer="d211-a1"/>
            </div>
