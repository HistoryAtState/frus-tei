    <text>
        <body>
            <div xml:id="d196">

                <pb facs="0327" n="245" xml:id="pg245"/>

                <note rend="inline" type="source">890g.6363 T 84/231: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Ambassador in Great
                        Britain</hi> (<hi rendition="#italic">Houghton</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1925-12-31T21:00:00-05:00"><hi rendition="#italic">December 31,
                                1925—9 p.m.</hi></date></dateline></opener>
                <p>372. Your 383, December 21, 5 p.m. Please expedite supplementary reply; also
                    endeavor to discuss matter with Chamberlain<anchor n="77" xml:id="d196-f1"/>
                    earliest possible opportunity.</p>
                <closer><signed><hi rendition="#small-caps">Kellogg</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d196-f1" n="77" xml:id="d196-f1-content">
                <p>Sir Austen Chamberlain, British Secretary of State for Foreign Affairs.</p>
            </note>
        </listAnnotation>
    </standOff>
