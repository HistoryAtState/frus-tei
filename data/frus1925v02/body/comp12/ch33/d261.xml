                <pb facs="0399" n="317" sameAs="frus:frus1925v02/pg317"/>

                <note rend="inline" type="source">815.00/3535: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Honduras</hi> (<hi rendition="#italic"
                        >Dennis</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Tegucigalpa</hi></placeName>, <date calendar="gregorian"
                            when="1925-01-24T20:00:00-06:00"><hi rendition="#italic">January 24,
                                1925—8 p.m.</hi></date><lb/>[Received January 25—12:36
                        a.m.]</dateline></opener>
                <p>13. Please instruct with regard to my participation in the inaugural ceremonies
                    February 1st and as to form of extending recognition to the new constitutional
                    government.</p>
                <closer><signed><hi rendition="#small-caps">Dennis</hi></signed></closer>
            </div>
        </body>
