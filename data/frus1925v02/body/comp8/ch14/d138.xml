    <text>
        <body>
            <div xml:id="d138">

                <pb facs="0244" n="162" sameAs="frus:frus1925v02/pg162"/>

                <note rend="inline" type="source">462.00 R 294/428a: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Ambassador in
                        France</hi> (<hi rendition="#italic">Herrick</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1925-01-15T17:00:00-05:00"><hi rendition="#italic">January 15,
                                1925—5 p.m.</hi></date></dateline></opener>
                <p>47. L–204 for Logan. Please have National Bank of Belgium wire Federal Reserve
                    Bank New York to “Release blocked account to order of Treasury of the United
                        States”.<anchor n="37" xml:id="d138-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Hughes</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d138-f1" n="37" xml:id="d138-f1-content">
                <p>See sec. B, art. 3, agreement of Jan. 14, 1925, <hi rendition="#italic"
                        >supra.</hi></p>
            </note>
        </listAnnotation>
    </standOff>
