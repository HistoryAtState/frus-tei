            <div xml:id="d155">

                <pb facs="0263" n="181" xml:id="pg181"/>

                <note rend="inline" type="source">862.51/2089: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Ambassador in Germany</hi> (<hi rendition="#italic"
                            >Schurman</hi>)</head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1925-11-06T13:00:00-05:00"><hi rendition="#italic">November 6,
                                1925—1 p.m.</hi></date></dateline></opener>
                <p>195. Fourth paragraph, Department’s telegram No. 193, October 31, 5 p.m. The
                    Department does not wish to have you make any specific inquiries but would like
                    to receive such information as you may be able to obtain discreetly as to the
                    instituting by the German Government of a stricter control over loans from
                    abroad.</p>
                <closer><signed><hi rendition="#small-caps">Kellogg</hi></signed></closer>
            </div>
        </body>
    </text>
