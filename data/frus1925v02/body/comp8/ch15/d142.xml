                <pb facs="0248" n="166" sameAs="frus:frus1925v02/pg166"/>

                <note rend="inline" type="source">362.115 St 21/362½</note>
                <head><hi rendition="#italic">The Chargé in Great Britain</hi> (<hi rendition="#italic">Sterling</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1925-02-26"><hi rendition="#italic">February 26,
                        1925</hi></date>.<lb/>[Received March 13.]</dateline>
                    <seg rendition="#float-left">No. 1084</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In accordance with the Embassy’s telegram
                    No. 83 February 26, 5 p.m., 1925,<anchor n="42" xml:id="d142-f1"/> I have the
                    honor to enclose a copy, in triplicate, of the note mentioned therein from Mr.
                    Chamberlain, dated February 25, 1925, concerning the Tanker case.</p>
                <p>A copy of this note has been forwarded to Mr. Logan, and the solicitor of the
                    Standard Oil Company in London, Mr. Piesse, has been informed of its
                    contents.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">F. A. Sterling</hi></signed></closer>


                <xi:include href="d142-a1.xml" xpointer="d142-a1"/>
            </div>
        </body>
    </text>
