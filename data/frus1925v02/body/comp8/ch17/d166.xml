    <text>
        <body>
            <div xml:id="d166">

                <pb facs="0272" n="190" sameAs="frus:frus1925v02/pg190"/>

                <note rend="inline" type="source">811.512362 Shipping/8</note>
                <head><hi rendition="#italic">The Ambassador in Germany</hi> (<hi rendition="#italic">Houghton</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Berlin</hi></placeName>, <date calendar="gregorian"
                            when="1924-01-22"><hi rendition="#italic">January 22,
                        1924</hi></date>.<lb/>[Received February 12.]</dateline>
                    <seg rendition="#float-left">No. 526</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my telegram No. 21 of January
                    21st last,<anchor n="84" xml:id="d166-f1"/> with regard to exemption from
                    taxation of individual Americans engaged in shipping, who are non-resident in
                    Germany, and of American shipping companies, I have the honor to transmit
                    herewith a copy and translation of the note from the German Foreign Office, to
                    which my telegram referred.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">A. B. Houghton</hi></signed></closer>


                <xi:include href="d166-a1.xml" xpointer="d166-a1"/>
            </div>
        </body>
    </text>
