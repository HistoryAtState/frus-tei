    <text>
        <body>
            <div xml:id="d164">

                <pb facs="0270" n="188" sameAs="frus:frus1925v02/pg188"/>

                <note rend="inline" type="source">811.512362 Shipping/–</note>
                <head><hi rendition="#italic">The German Embassy to the
                            Department of State</hi></head>
                <opener><seg rendition="#center">[Translation<anchor n="81" xml:id="d164-f1"
                        />]</seg></opener>
                <p>The German Embassy has the honor to forward herewith to the Department of State
                    an ordinance of the German Minister of Finance, III C 7412 of August 10 of this
                    year, together with an English <pb facs="0271" n="189" xml:id="pg189"/>
                    translation, concerning the exemption of North American Steamship Companies from
                    the payment of the German corporation tax.</p>
                <closer><dateline rendition="#float-left"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1923-09-13"><hi rendition="#italic">September 13,
                        1923</hi></date>.</dateline></closer>


                <xi:include href="d164-a1.xml" xpointer="d164-a1"/>
            </div>
        </body>
    </text>
