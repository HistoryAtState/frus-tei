                <pb facs="0723" n="641" sameAs="frus:frus1925v02/pg641"/>

                <note rend="inline" type="source">817.00/3343: Telegram</note>
                <head><hi rendition="#italic">The Minister in Nicaragua</hi> (<hi rendition="#italic">Eberhardt</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Managua</hi></placeName>, <date calendar="gregorian"
                            when="1925-11-09T18:00:00-05:45"><hi rendition="#italic">November 9,
                                1925—6 p.m.</hi></date><lb/>[Received 8:47 p.m.]</dateline></opener>
                <p>165. Minister of Honduras advises me that Vice President Sacasa fleeing from Leon
                    has arrived at La Union, Honduras.</p>
                <closer><signed><hi rendition="#small-caps">Eberhardt</hi></signed></closer>
            </div>
        </body>
