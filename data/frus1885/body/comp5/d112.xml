                <pb facs="0290" n="162" sameAs="frus:frus1885/pg162"/>

                <opener><seg rendition="#center">No. 112.</seg></opener>
                <head><hi rendition="#italic">Mr. Young to Mr. Bayard</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1885-03-29"><hi rendition="#italic">March</hi> 29, 1885</date>.
                        (Received May 13.)</dateline>
                    <seg rendition="#float-left">No. 693.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit for the
                    information of the Department a correspondence between the legation and the Rev.
                    Dr. Blodget, the chairman of the China Branch of the Evangelical Alliance.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>JOHN RUSSELL YOUNG.</signed></closer>





