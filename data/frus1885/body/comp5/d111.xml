    <text>
        <body>
            <div xml:id="d111">

                <pb facs="0290" n="162" sameAs="frus:frus1885/pg162"/>

                <opener><seg rendition="#center">No. 111.</seg></opener>
                <head><hi rendition="#italic">Mr. Young to Mr.
                            Bayard</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1885-03-24"><hi rendition="#italic">March</hi> 24, 1885</date>.
                        (Received May 13.)</dateline>
                    <seg rendition="#float-left">No. 687.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to forward herewith for
                    your information a copy and translation of a notification issued by the
                    consul-general of France at Shanghai enumerating the articles held by the French
                    as contraband of war.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>JOHN RUSSELL YOUNG.</signed></closer>


                <xi:include href="d111-a1.xml" xpointer="d111-a1"/>
