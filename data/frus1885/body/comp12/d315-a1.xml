    <text>
        <body>
            <div xml:id="d315-a1">

                <pb facs="0573" n="445" sameAs="frus:frus1885/pg445"/>

                <opener><seg rendition="#center">[Inclosure.]</seg></opener>
                <head><hi rendition="#italic">Lord Granville to Mr. Lowell</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Foreign Office</hi></placeName>, <date calendar="gregorian"
                            when="1885-01-27"><hi rendition="#italic">January</hi> 27,
                        1885</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your letter of the 20th instant, in regard to pauper immigration to the
                    United States, and to state to you that the proper steps will be taken to give
                    effect to the wishes expressed therein.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>GRANVILLE.</signed></closer>
            </div>
        </body>
    </text>
