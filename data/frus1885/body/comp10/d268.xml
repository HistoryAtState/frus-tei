                <pb facs="0502" n="374" sameAs="frus:frus1885/pg374"/>

                <opener><seg rendition="#center">No. 268.</seg></opener>
                <head><hi rendition="#italic">Mr. Porter to Mr. McLane</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1885-07-10"><hi rendition="#italic">July</hi> 10,
                        1885</date>.</dateline>
                    <seg rendition="#float-left">No. 21.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to inform you that copies of your
                    dispatch No. 28 of the 23d ultimo, containing a copy of a note addressed to you
                    by Mr. de Freycinet, with reference to the way in which the gift of France was
                    received upon its arrival at New York, have been communicated to the Secretary
                    of the Navy and the mayor of New York.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>JAS. D. PORTER,<lb/><hi rendition="#italic">Acting
                        Secretary.</hi></signed></closer>
            </div>
        </body>
