    <text>
        <body>
            <div xml:id="d296">

                <pb facs="0542" n="414" xml:id="pg414"/>

                <opener><seg rendition="#center">No. 206.</seg></opener>
                <head><hi rendition="#italic">Mr. Bayard to Mr. Kasson</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1885-04-23"><hi rendition="#italic">April</hi> 23,
                        1885</date>.</dateline>
                    <seg rendition="#float-left">No. 137.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Acknowledging the receipt of your dispatch
                    No. 223, of the 4th instant, in relation to the arrest and imprisonment of Mr.
                    Ernest F. Heitmüller, a naturalized American citizen, by the German authorities
                    for the non-performance of military service, I have to inform you that your
                    course in asking for an investigation of the facts in relation to the young
                    man’s imprisonment is approved.</p>
                <p>Further instructions are deferred until the promised reply from the foreign
                    office has been received.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>T. F. BAYARD.</signed></closer>
            </div>
        </body>
