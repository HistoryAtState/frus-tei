    <text>
        <body>
            <div xml:id="d284-a3">

                <pb facs="0519" n="391" sameAs="frus:frus1885/pg391"/>

                <opener><seg rendition="#center">[Inclosure 3 in No.
                    94.—Translation.]</seg></opener>
                <head><hi rendition="#small-caps">certificate</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Grand Duchy of Hessen</hi>,<lb/><hi rendition="#small-caps">Office
                                of Grand Ducal Burgomaster</hi>,<lb/><hi rendition="#italic"
                                >Worms</hi></placeName>, <date calendar="gregorian"
                            when="1884-11-18"><hi rendition="#italic">November</hi> 18,
                        1884</date>.</dateline></opener>
                <p>It is hereby certified for Karl Klingenmeyer, born at Heidenheim, Kingdom of
                    Wurtemberg, on February 14, 1862, that pursuant to a decision of the Kreisamt of
                    Worms of September 30 last, the German treaties with the United States and in
                    particular Article IV of the treaty of February 22, 1868, can have no
                    application to him, and that he rather is to be simply treated as an American
                    citizen, because he was born as an American citizen.</p>
                <p>Office of Grand Ducal Burgomaster.</p>
                <closer><signed>KÜSTER.</signed></closer>
            </div>
