                <pb facs="0640" n="512" sameAs="frus:frus1885/pg512"/>

                <opener><seg rendition="#center">No. 362.</seg></opener>
                <head><hi rendition="#italic">Mr. Bayard to Mr.
                            Langston</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1885-05-06"><hi rendition="#italic">May</hi> 6,
                        1885</date>.</dateline>
                    <seg rendition="#float-left">No. 352.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit, for your information, the
                    inclosed copy of a letter of the 29th ultimo from Mr. W. K. Van Bokkelen in
                    regard to his son who is still in confinement at Port-au-Prince.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>T. F. BAYARD.</signed></closer>




                <xi:include href="d362-a1.xml" xpointer="d362-a1"/>
