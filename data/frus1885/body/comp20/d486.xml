                <pb facs="0775" n="647" sameAs="frus:frus1885/pg647"/>

                <opener><seg rendition="#center">No. 486.</seg></opener>
                <head><hi rendition="#italic">Mr. Porter to Mr. Lewis</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1885-08-12"><hi rendition="#italic">August</hi> 12,
                        1885</date>.</dateline>
                    <seg rendition="#float-left">No. 11.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    No. 11, and to express satisfaction with the tenor of the note from the foreign
                    office, a copy of which you inclose, promising measures of redress in the case
                    of the missionaries, American citizens, lately expelled from Bihé and Bailunda,
                    West Africa. It is hoped that their property will be recovered and that their
                    future immunity from molestation is secured.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>JAS. D. PORTER,<lb/><hi rendition="#italic">Acting
                        Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
