    <text>
        <body>
            <div xml:id="d480">

                <pb facs="0766" n="638" sameAs="frus:frus1885/pg638"/>

                <opener><seg rendition="#center">No. 480.</seg></opener>
                <head><hi rendition="#italic">Mr. Richmond to Mr.
                            Frelinghuysen</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Lisbon</hi></placeName>, <date calendar="gregorian"
                            when="1885-02-16"><hi rendition="#italic">February</hi> 16, 1885</date>.
                        (Received March 3.)</dateline>
                    <seg rendition="#float-left">No. 18.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of instruction No. 17, dated January 27, 1885, relating to the restrictions
                    placed upon missionary work in East Africa, and beg to report that I have
                    addressed a note on the subject to the minister of foreign affairs. I inclose a
                    copy of the note for the information of Mr. Judson Smith, should the Department
                    think it worth while to furnish it.</p>
                <p>In addition to the note I propose having a personal interview with the minister
                    of foreign affairs on the 18th instant, in order to furnish him with any
                    information he may desire concerning the missionaries.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>LEWIS RICHMOND.</signed></closer>



                <xi:include href="d480-a1.xml" xpointer="d480-a1"/>
