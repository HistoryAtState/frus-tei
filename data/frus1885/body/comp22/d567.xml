            <div xml:id="d567">

                <pb facs="0889" n="761" sameAs="frus:frus1885/pg761"/>

                <opener><seg rendition="#center">No. 567.</seg></opener>
                <head><hi rendition="#italic">Mr. Bayard to Mr.
                            Strobel</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1885-11-17"><hi rendition="#italic">November</hi> 17,
                        1885</date>.</dateline>
                    <seg rendition="#float-left">No. 412.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to the instruction (No. 409) sent
                    to your legation on the 4th instant, respecting the duty collected at Barcelona
                    on a cargo of old metal shipped from Cuba by Mr. F. B. Hamel, an American
                    citizen, I inclose, for your further information in the case, a copy of a letter
                    from Mr. J. B. Hamel, of Philadelphia.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>T. F. BAYARD.</signed></closer>



                <xi:include href="d567-a1.xml" xpointer="d567-a1"/>
            </div>
        </body>
    </text>
