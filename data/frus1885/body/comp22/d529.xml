        <body>
            <div xml:id="d529">

                <pb facs="0831" n="703" xml:id="pg703"/>

                <opener><seg rendition="#center">No. 529.</seg></opener>
                <head><hi rendition="#italic">Mr. Bayard to Mr.
                            Reed</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1885-03-23"><hi rendition="#italic">March</hi> 23,
                        1885</date>.</dateline>
                    <seg rendition="#float-left">No. 322.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to instruction No. 312 of the
                    27th ultimo, I inclose in the case of the Ocean Pearl, fined at Stanzas, a copy
                    of a dispatch from our consul there and also a certificate which he transmitted
                    touching the ten empty hogsheads mentioned in the above instructions.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>T. F. BAYARD.</signed></closer>



                <xi:include href="d529-a1.xml" xpointer="d529-a1"/>
