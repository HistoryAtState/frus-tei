    <text>
        <body>
            <div xml:id="d529-a1">

                <pb facs="0831" n="703" sameAs="frus:frus1885/pg703"/>

                <opener><seg rendition="#center">[Inclosure 1 in No. 322.]</seg></opener>
                <head><hi rendition="#italic">Mr. Vickers to Mr.
                            Davis</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Consulate</hi>,<lb/><hi rendition="#italic"
                                >Stanzas</hi></placeName>, <date calendar="gregorian"
                            when="1885-02-20"><hi rendition="#italic">February</hi> 20,
                        1885</date>.</dateline>
                    <seg rendition="#float-left">No. 116.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I herewith inclose certificate of Edward K.
                    Sparks, esq., of the firm of Isaac Hough &amp; Co., of Philadelphia, relating to
                    the shipment of 235 empty molasses hogsheads in place of 245 as manifested, the
                    absence of which caused the fine to be imposed on the American barkentine Ocean
                    Pearl.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>DAVID BICKERS,<lb/><hi rendition="#italic"
                    >Consul.</hi></signed></closer>
            </div>
        </body>
    </text>
