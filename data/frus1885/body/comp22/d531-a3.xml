    <text>
        <body>
            <div xml:id="d531-a3">

                <pb facs="0836" n="708" sameAs="frus:frus1885/pg708"/>

                <opener><seg rendition="#center">[Inclosure 3 in No.
                    327.—Translation.]</seg></opener>
                <p>Personal cedula for domiciled foreigners; folio, 75; year, 1884–’85; No. 774;
                    province, Havana; district, Havana; Dragones ward. In favor of Don Fernando B.
                    Hamel y Nathan, native of United States; married; occupation, commerce; and
                    resides, Reina street, No. 118.</p>
                <p rendition="#right"><hi rendition="#small-caps">Havana</hi>, <hi
                        rendition="#italic">October</hi> 14, 1884.</p>
                <p>The alcalde,</p>
                <closer><signed>FLORENCIO GARCIA.</signed></closer>
                <postscript>
                    <p>Description—age, forty-five years; stature, tall; complexion, good; beard,
                        close; particular marks, 1884, No. 1193.</p>
                </postscript>
            </div>
        </body>
