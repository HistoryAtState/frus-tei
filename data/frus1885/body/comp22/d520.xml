    <text>
        <body>
            <div xml:id="d520">

                <pb facs="0811" n="683" sameAs="frus:frus1885/pg683"/>

                <opener><seg rendition="#center">No. 520.</seg></opener>
                <head><hi rendition="#italic">Mr. Frelinghuysen to Mr. Reed</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1885-01-28"><hi rendition="#italic">January</hi> 28,
                        1885</date>.</dateline>
                    <seg rendition="#float-left">No. 305.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose a copy of a letter from the
                    Spanish consul at Key West addressed to Mr. James McKay, containing the
                    information that the report asked of him by the Spanish Government as to the
                    excessive cattle fees (the subject of previous correspondence) has been
                    forwarded. If, within a reasonable time, you do not receive a note from the
                    minister of state on the subject, you will exercise your discretion in again
                    pressing upon his attention the matter of the return of this illegally-collected
                    tax.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>FRED’K T. FRELINGHUYSEN.</signed></closer>


                <xi:include href="d520-a1.xml" xpointer="d520-a1"/>
            </div>
        </body>
    </text>
