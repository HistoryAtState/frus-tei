                <opener><seg rendition="#center">No. 568.</seg></opener>
                <head><hi rendition="#italic">Mr. Bayard to Mr.
                            Strobel</hi>.</head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1885-11-27"><hi rendition="#italic">November</hi> 27,
                        1885</date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Strobel</hi>,<lb/><hi
                        rendition="#italic">Chargé, Madrid:</hi></p>
                <p>Tender to Queen regent sincere condolence of President and people of the United
                    States.</p>
                <closer><signed>BAYARD.</signed></closer>
            </div>
        </body>
