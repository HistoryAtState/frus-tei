    <text>
        <body>
            <div xml:id="d529-a2">

                <pb facs="0831" n="703" sameAs="frus:frus1885/pg703"/>

                <opener><seg rendition="#center">[Inclosure 2 in No. 322.]</seg></opener>
                <head><hi rendition="#italic">Affidavit of Edward K. Sparks</hi>.</head>
                <p>Personally appeared before me Edward K. Sparks, of the firm of Isaac Hough &amp;,
                    Co., shipping and commission merchants doing business in Philadelphia, who
                    deposes and says that his firm shipped on the Ocean Pearl, bound for Stanzas, on
                    or about December 7, 1884, 235 empty molasses hogsheads, not 245 as manifested,
                    10 of them having been left on the wharf.</p>
                <closer><signed>EDM. K. SPARKS.</signed>
                    <lb/>
                    <dateline rendition="#float-left"><placeName>Philadelphia</placeName>, <date
                            calendar="gregorian" when="1885-02-13">this 13th day of February,
                            1885</date>.</dateline></closer>
                <closer>
                    <dateline rendition="#float-left">Sworn and subscribed before me <date
                            calendar="gregorian" when="1885-02-13">this 13th day of February,
                            1885</date>.</dateline>
                    <lb/> [<hi rendition="#small-caps">seal.</hi>]<lb/><signed>THOMAS M.
                            CRANE,<lb/><hi rendition="#italic">Notary Public.</hi></signed></closer>
            </div>
        </body>
