    <text>
        <body>
            <div xml:id="d406-a1">

                <pb facs="0691" n="563" sameAs="frus:frus1885/pg563"/>

                <opener><seg rendition="#center">[Inclosure 1 in No. 2058.]</seg></opener>
                <head><hi rendition="#italic">The Japanese-Chinese convention</hi>.</head>
                <p rendition="#center"><hi rendition="#small-caps">notification no</hi>. 3 <hi
                        rendition="#small-caps">of the department for foreign affairs.</hi></p>
                <p>It is hereby notified that, with reference to the complication between Japan and
                    China, which occurred in connection with the disturbance at Seoul in December,
                    last year, [we] have carried out negotiations with the Chinese Government, and
                    have brought the question to settlement by concluding the following convention
                    and receiving a communication.</p>
                <closer><signed><hi rendition="#small-caps">Prince</hi> SANJO SANEYOSHI,<lb/><hi
                            rendition="#italic">Prime Minister</hi>.</signed>
                    <lb/>
                    <signed><hi rendition="#small-caps">Count</hi> INOUYE KAORU,<lb/><hi
                            rendition="#italic">Minister for Foreign Affairs</hi>,</signed>
                    <lb/>
                    <dateline rendition="#float-left"><date calendar="gregorian" when="1885-05-27"
                                ><hi rendition="#small-caps">May</hi> 27,
                    1885</date>.</dateline></closer>



                <xi:include href="d406-a1-a1.xml" xpointer="d406-a1-a1"/>
            </div>
