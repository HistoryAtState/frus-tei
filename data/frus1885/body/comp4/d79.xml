    <text>
        <body>
            <div xml:id="d79">

                <pb facs="0242" n="114" sameAs="frus:frus1885/pg114"/>

                <opener><seg rendition="#center">No. 79.</seg></opener>
                <head><hi rendition="#italic">Mr. Whitehouse to Mr. Bayard</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States in Central America</hi>,<lb/><hi
                                rendition="#italic">La Libertad</hi></placeName>, <date
                            calendar="gregorian" when="1885-04-18"><hi rendition="#italic"
                                >April</hi> 18, 1885</date>. (Received May 16.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring you to my dispatch of the 14th in
                    regard to the proclamation of peace between Salvador and Honduras, I have now
                    the honor to inclose a copy and translation of the treaty.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>H. REMSEN WHITEHOUSE.</signed></closer>


                <xi:include href="d79-a1.xml" xpointer="d79-a1"/>
