        <body>
            <div xml:id="d77">

                <pb facs="0237" n="109" xml:id="pg109"/>

                <opener><seg rendition="#center">No. 77.</seg></opener>
                <head><hi rendition="#italic">Mr. Bayard to Mr.
                            Hall</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1885-04-16"><hi rendition="#italic">April</hi> 16,
                        1885</date>.</dateline>
                    <seg rendition="#float-left">No. 239.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I herewith transmit, for your information,
                    having regard to previous correspondence, the inclosed copy of a letter from the
                    Acting Secretary of the Navy, of the 20th ultimo, in regard to the destitute
                    Americans in Guatemala.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>T. F. BAYARD.</signed></closer>








