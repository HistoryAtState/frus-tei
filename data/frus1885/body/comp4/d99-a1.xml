    <text>
        <body>
            <div xml:id="d99-a1">

                <pb facs="0271" n="143" sameAs="frus:frus1885/pg143"/>

                <opener><seg rendition="#center">[Inclosure 1 in No.
                        429.—Telegram.—Translation.]</seg></opener>
                <head><hi rendition="#italic">Mr. Hall to Señor Zelaya</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Guatemala</hi></placeName>, <date calendar="gregorian"
                            when="1885-10-08"><hi rendition="#italic">October</hi> 8,
                        1885</date>.</dateline></opener>
                <p rendition="#flush">To the <hi rendition="#small-caps">Minister for Foreign
                        Affairs</hi>,<lb/><hi rendition="#italic">Tegucigalpa, Honduras:</hi></p>
                <p>The honorable the Secretary of State instructs me to make known to your
                    Government that steps have been taken to prevent the departure of any expedition
                    against Honduras in violation of the laws of neutrality of the United
                    States.</p>
                <closer><signed>HENRY C. HALL.</signed></closer>
            </div>
        </body>
