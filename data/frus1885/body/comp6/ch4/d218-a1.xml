    <text>
        <body>
            <div xml:id="d218-a1">

                <pb facs="0407" n="279" xml:id="pg279"/>

                <opener><seg rendition="#center">[Inclosure.]</seg></opener>
                <head><hi rendition="#italic">Mr. Garland to Mr.
                            Bayard</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of Justice</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1885-06-25"><hi rendition="#italic">June</hi> 25,
                        1885</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to send you the
                    accompanying copy of a report of the 23d instant, from Mr. Root, attorney of the
                    United States for the southern district of New York, of his action in the matter
                    of the brig Ambrose Light.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>A. H. GARLAND,<lb/><hi rendition="#italic"
                        >Attorney-General.</hi></signed></closer>
            </div>
        </body>
