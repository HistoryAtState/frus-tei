                <pb facs="0360" n="232" sameAs="frus:frus1885/pg232"/>

                <opener><seg rendition="#center">No. 176.</seg></opener>
                <head><hi rendition="#italic">Mr. Bayard to Mr.
                            Becerra</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1885-03-10"><hi rendition="#italic">March</hi> 10,
                        1885</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    note of the 2d instant respecting the movement of certain parties in the United
                    States, who, it is alleged, are engaged in fitting out warlike expeditions
                    against the Government of Colombia, and to inform you that the attention of the
                    proper authorities was promptly invited to the subject.</p>
                <p>Accept, &amp;c.,</p>
                <closer><signed>T. E. BAYARD.</signed></closer>
            </div>
        </body>
