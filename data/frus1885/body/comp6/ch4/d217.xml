    <text>
        <body>
            <div xml:id="d217">

                <pb facs="0405" n="277" sameAs="frus:frus1885/pg277"/>

                <opener><seg rendition="#center">No. 217.</seg></opener>
                <head><hi rendition="#italic">Mr. Bayard to Mr. Becerra</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1885-06-22"><hi rendition="#italic">June</hi> 22,
                        1885</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose a copy of a
                    letter from the Attorney-General, calling attention to discrepancies in the
                    statements received by the United States attorney, southern district of New
                    York, in the matter of the brig Ambrose Light.</p>
                <p>Accept, &amp;c.,</p>
                <closer><signed>T. F. BAYARD.</signed></closer>



                <xi:include href="d217-a1.xml" xpointer="d217-a1"/>
