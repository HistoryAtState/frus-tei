    <text>
        <body>
            <div xml:id="d219">

                <pb facs="0407" n="279" sameAs="frus:frus1885/pg279"/>

                <opener><seg rendition="#center">No. 219.</seg></opener>
                <head><hi rendition="#italic">Mr. Holguin and Mr.
                            Becerra to Mr. Bayard</hi>.</head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >New York</hi></placeName>, <date calendar="gregorian"
                            when="1885-07-31"><hi rendition="#italic">July</hi> 31,
                        1885</date>.</dateline></opener>
                <p>Barranquilla occupied by the Government forces. The port will be opened at once.
                    Prestan taken and tried.</p>
                <closer><signed><list>
                            <item>HOLGUIN.</item>
                            <item>BECERRA.</item>
                        </list></signed></closer>
            </div>
        </body>
    </text>
