    <text>
        <body>
            <div xml:id="d217-a1">

                <pb facs="0405" n="277" sameAs="frus:frus1885/pg277"/>

                <opener><seg rendition="#center">[Inclosure.]</seg></opener>
                <head><hi rendition="#italic">Mr. Garland to Mr.
                            Bayard</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of Justice</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1885-06-19"><hi rendition="#italic">June</hi> 19,
                        1885</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to send you for your
                    information a copy of a letter of the 18th instant from Mr. Root, by his
                    assistant, attorney of the United States for the <pb facs="0406" n="278"
                        xml:id="pg278"/> southern district of New York, calling attention to
                    discrepancies in the official information given the attorney by the Colombian
                    minister at Washington and the Colombian consul at New York.</p>
                <p>Very respectfully,</p>
                <closer><signed>A. H. GARLAND,<lb/><hi rendition="#italic"
                        >Attorney-General.</hi></signed></closer>
            </div>
        </body>
    </text>
