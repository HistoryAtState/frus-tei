                <pb facs="0471" n="343" sameAs="frus:frus1885/pg343"/>

                <opener><seg rendition="#center">No. 232.</seg></opener>
                <head><hi rendition="#italic">Mr. Foote to Mr.
                            Frelinghuysen</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Seoul, Corea</hi></placeName>, <date calendar="gregorian"
                            when="1885-01-09"><hi rendition="#italic">January</hi> 9, 1885</date>.
                        (Received March 16.)</dateline>
                    <seg rendition="#float-left">No. 140.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inform you that a
                    convention has been concluded between the Corean and Japanese plenipotentiaries,
                    a copy of which is herewith transmitted, whereby all differences growing out of
                    the late troubles are amicably adjusted.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>LUCIUS H. FOOTE.</signed></closer>


                <xi:include href="d232-a1.xml" xpointer="d232-a1"/>
