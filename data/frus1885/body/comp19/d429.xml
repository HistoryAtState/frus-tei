    <text>
        <body>
            <div xml:id="d429">

                <pb facs="0716" n="588" sameAs="frus:frus1885/pg588"/>

                <opener><seg rendition="#center">No. 429.</seg></opener>
                <head><hi rendition="#italic">Mr. S. L. Phelps to
                        Mr. Frelinghuysen</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Lima, Peru</hi></placeName>, <date calendar="gregorian"
                            when="1884-12-20"><hi rendition="#italic">December</hi> 20, 1884</date>.
                        (Received Jan. 16, 1885.)</dateline>
                    <seg rendition="#float-left">No. 191.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have received another communication from
                    the minister of foreign relations regarding proceedings in the courts in the
                    judicial district of Libertad in respect to the murder of Owen Young, a copy of
                    which, with translation, is inclosed herewith.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>S. L. PHELPS.</signed></closer>


                <xi:include href="d429-a1.xml" xpointer="d429-a1"/>
            </div>
