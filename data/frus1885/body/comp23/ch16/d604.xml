                <pb facs="0917" n="789" sameAs="frus:frus1885/pg789"/>

                <opener><seg rendition="#center">No. 604.</seg></opener>
                <head><hi rendition="#italic">Mr. Reuterskiöld to Mr. Bayard</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of Sweden and Norway</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1885-06-17"><hi rendition="#italic">June</hi> 17, 1885</date>.
                        (Received June 18.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to our conversation this
                    morning I beg to inclose a short memorandum concerning the tonnage-tax question
                    I spoke to you about.</p>
                <p>Accept, &amp;c.,</p>
                <closer><signed>L. REUTERSKIÖLD.</signed></closer>


                <xi:include href="d604-a1.xml" xpointer="d604-a1"/>
