    <text>
        <body>
            <div xml:id="d692-a1">

                <pb facs="1043" n="915" sameAs="frus:frus1885/pg915"/>

                <opener><seg rendition="#center">[Inclosure 1 in No. 88.]</seg></opener>
                <head><hi rendition="#italic">Mr. Bird to Mr. Baker</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Consulate</hi>,<lb/><hi rendition="#italic">La
                                Guayra</hi></placeName>, <date calendar="gregorian"
                            when="1885-04-25"><hi rendition="#italic">April</hi> 25,
                        1885</date>.</dateline>
                    <seg rendition="#float-left">No. 43.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your dispatch No. 35, of date 22d instant, and, in compliance with the terms
                    of the same, to submit herewith all the official information relative to the
                    injury done to the American schoonor Lanie Cobb by the Venezuelan schooner Ana
                    Eulogia.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>WINFIELD S. BIRD,<lb/><hi rendition="#italic">United States
                            Consul.</hi></signed></closer>
            </div>
        </body>
    </text>
