                <pb facs="0392" n="264" sameAs="frus:frus1928v01/pg264"/>

                <note rend="inline" type="source">500.A15/834: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Minister in Switzerland</hi> (<hi
                            rendition="#italic">Wilson</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1928-12-17T19:00:00-05:00"><hi rendition="#italic">December 17,
                                1928—7 p.m.</hi></date></dateline></opener>
                <p>109. Your 123, December 17, noon. You can tell Drummond that this Government is
                    prepared to send delegates at any time. The dates mentioned are satisfactory but
                    we should also be satisfied with an earlier date.</p>
                <closer><signed><hi rendition="#small-caps">Kellogg</hi></signed></closer>
            </div>
        </body>
    </text>
