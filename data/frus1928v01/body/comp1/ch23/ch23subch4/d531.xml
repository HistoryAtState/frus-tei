                <pb facs="0858" n="730" sameAs="frus:frus1928v01/pg730"/>

                <note rend="inline" type="source">714.1515/695: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Minister in
                        Guatemala</hi> (<hi rendition="#italic">Geissler</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1928-03-28T18:00:00-05:00"><hi rendition="#italic">March 28,
                                1928—6 p.m.</hi></date></dateline></opener>
                <p>28. Please communicate reply of Honduran Government, as transmitted in telegram
                    of March 27, 10 a.m. from Tegucigalpa, to the Guatemalan Government.</p>
                <closer><signed><hi rendition="#small-caps">Olds</hi></signed></closer>
            </div>
        </body>
