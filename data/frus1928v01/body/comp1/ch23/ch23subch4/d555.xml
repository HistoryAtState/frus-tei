                <pb facs="0873" n="745" sameAs="frus:frus1928v01/pg745"/>

                <note rend="inline" type="source">714.1515/685: Telegram</note>
                <head><hi rendition="#italic">The Minister in Guatemala</hi> (<hi
                        rendition="#italic">Geissler</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Guatemala</hi></placeName>, <date calendar="gregorian"
                            when="1928-05-23T20:00:00-06:00"><hi rendition="#italic">May 23, 1928—8
                                p.m.</hi></date><lb/>[Received May 24—2:15 p.m.]</dateline></opener>
                <p>70. The President has remarked to me that he believes that Washington would be a
                    suitable place for the next boundary conference but that San José de Costa Rica
                    would also be acceptable.</p>
                <closer><signed><hi rendition="#small-caps">Geissler</hi></signed></closer>
            </div>
        </body>
    </text>
