                <pb facs="0882" n="754" sameAs="frus:frus1928v01/pg754"/>

                <note rend="inline" type="source">714.1515/763: Telegram</note>
                <head><hi rendition="#italic">The Minister in Duatemala</hi> (<hi
                        rendition="#italic">Geissler</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Guatemala</hi></placeName>, <date calendar="gregorian"
                            when="1928-07-17T18:00:00-06:00"><hi rendition="#italic">July 17, 1928—6
                                p.m.</hi></date><lb/>[Received July 18—12:10
                    a.m.]</dateline></opener>
                <p>95. The Legislative Assembly has passed the bill authorizing the Executive to
                    submit the boundary question to the International Central American Tribunal
                    without discussion and by unanimous vote. Repeated to Honduras.</p>
                <closer><signed><hi rendition="#small-caps">Geissler</hi></signed></closer>
            </div>
        </body>
    </text>
