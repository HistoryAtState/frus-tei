    <text>
        <body>
            <div xml:id="d494">

                <pb facs="0834" n="706" sameAs="frus:frus1928v01/pg706"/>

                <note rend="inline" type="source">738.3915/335</note>
                <head><hi rendition="#italic">The Minister in the Dominican Republic</hi> (<hi
                        rendition="#italic">Young</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Santo Domingo</hi></placeName>, <date calendar="gregorian"
                            when="1928-02-20"><hi rendition="#italic">February 20,
                        1928</hi></date>.<lb/>[Received February 28.]</dateline>
                    <seg rendition="#float-left">No. 790</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Adverting to the Legation’s telegram No. 15
                    of February 15, 1928,<anchor n="82" xml:id="d494-f1"/> I have the honor to
                    forward herewith translations of the notes exchanged by Minister of Foreign
                    Affairs Sanchez and the Haitian Minister expressing the desire of both
                    Governments to undertake a <pb facs="0835" n="707" xml:id="pg707"/> settlement
                    of the boundary question. The notes are dated January 20 and 21, respectively,
                    but they were in fact exchanged on February 13th.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Evan E. Young</hi></signed></closer>



                <xi:include href="d494-a1.xml" xpointer="d494-a1"/>
                <xi:include href="d494-a2.xml" xpointer="d494-a2"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d494-f1" n="82" xml:id="d494-f1-content">
                <p>Not printed; it informed the Department that an exchange of notes had been
                    effected.</p>
            </note>
        </listAnnotation>
