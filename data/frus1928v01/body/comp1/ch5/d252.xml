                <pb facs="0420" n="292" sameAs="frus:frus1928v01/pg292"/>

                <note rend="inline" type="source">500.A16/36: Telegram</note>
                <head><hi rendition="#italic">The Minister in Switzerland</hi> (<hi rendition="#italic">Wilson</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Berne</hi></placeName>, <date calendar="gregorian"
                            when="1928-07-17T12:00:00+01:00"><hi rendition="#italic">July 17,
                                1928—noon</hi>.</date><lb/>[Received 3:19 p.m.]</dateline></opener>
                <p>72. Circular C. F. A. 15, dated July 15, relating to private manufacture just
                    received.</p>
                <quote rend="blockquote">
                    <p>“The Chairman of the Special Committee has the honor to inform the members of
                        the Committee that its second session will open at Geneva on Monday, August
                        27, 1928, at 11 a.m. Provisional agenda: Drafting of a single text for draft
                        convention.”</p>
                </quote>
                <closer><signed><hi rendition="#small-caps">Wilson</hi></signed></closer>
            </div>
        </body>
