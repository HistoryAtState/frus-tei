                <pb facs="0395" n="267" sameAs="frus:frus1928v01/pg267"/>

                <note rend="inline" type="source">500.A15Franco–British/4½: Telegram</note>
                <head><hi rendition="#italic">President Coolidge to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Superior, Wis.</hi></placeName>, <date calendar="gregorian"
                            when="1928-08-02"><hi rendition="#italic">August 2,
                        1928</hi>.</date><lb/>[Received August 2.]</dateline></opener>
                <p>Please make no commitments concerning limitation of armaments.</p>
                <closer><signed><hi rendition="#small-caps">Calvin Coolidge</hi></signed></closer>
            </div>
        </body>
