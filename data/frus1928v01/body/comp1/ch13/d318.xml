    <text>
        <body>
            <div xml:id="d318">

                <pb facs="0580" n="452" sameAs="frus:frus1928v01/pg452"/>

                <note rend="inline" type="source">511.4 A 2a/23: Telegram</note>
                <head><hi rendition="#italic">The Consul at Geneva</hi> (<hi
                            rendition="#italic">Band</hi>) <hi rendition="#italic">to the
                            Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Geneva</hi></placeName>, <date calendar="gregorian"
                            when="1928-12-15T11:00:00+01:00"><hi rendition="#italic">December 15,
                                1928—11 a.m.</hi></date><lb/>[Received December 15—10:15
                        a.m.]</dateline></opener>
                <p>The Council of the League has appointed May<anchor n="83" xml:id="d318-f1"/>
                    (American) a member of the Central Board provided for by the Geneva Opium
                    Convention of 1925. Full report by mail.<anchor n="81" xml:id="d318-f2"/></p>
                <closer><signed><hi rendition="#small-caps">Rand</hi></signed></closer>
            </div>
        </body>
    </text>
