                <pb facs="0784" n="656" sameAs="frus:frus1928v01/pg656"/>

                <note rend="inline" type="source">701.2325/43</note>
                <head><hi rendition="#italic">The Peruvian Ambassador</hi> (<hi rendition="#italic">Velarde</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><seg rendition="#center">[Translation]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1928-08-07"><hi rendition="#italic">August 7,
                        1928</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I have the honor to inform Your
                    Excellency that the Peruvian Congress has approved the Bill which was introduced
                    by the Executive Power creating an Embassy of Peru in Chile.</p>
                <p>I avail myself [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Hernan Velarde</hi></signed></closer>
            </div>
        </body>
    </text>
