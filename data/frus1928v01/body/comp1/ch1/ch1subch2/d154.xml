    <text>
        <body>
            <div xml:id="d154">

                <pb facs="0307" n="179" xml:id="pg179"/>

                <note rend="inline" type="source">711.50 a 12Anti-War/4</note>
                <head><hi rendition="#italic">The Ambassador in Belgium</hi> (<hi
                        rendition="#italic">Gibson</hi>)<anchor n="42" xml:id="d154-f1"/>
                    <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Brussels</hi></placeName>, <date calendar="gregorian"
                            when="1928-09-04"><hi rendition="#italic">September 4,
                        1928</hi></date>.<lb/>[Received September 17.]</dateline>
                    <seg rendition="#float-left">No. 11</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Confirming my telegram No. 56, September 1,
                    1 p.m.,<anchor n="43" xml:id="d154-f2"/> reporting the Luxemburg Government’s
                    decision to adhere to the General Pact for the Renunciation of War, I have the
                    honor to enclose a copy and translation of a note from the Minister of State,
                    dated August 29, 1928, informing me of this decision.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Hugh Gibson</hi></signed></closer>


                <xi:include href="d154-a1.xml" xpointer="d154-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d154-f1" n="42" type="source" xml:id="d154-f1-content">
                <p>Also accredited as Minister to Luxemburg.</p>
            </note>
