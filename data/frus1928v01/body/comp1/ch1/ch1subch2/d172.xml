    <text>
        <body>
            <div xml:id="d172">

                <pb facs="0330" n="202" sameAs="frus:frus1928v01/pg202"/>

                <note rend="inline" type="source">711.1212Anti-War/5</note>
                <head><hi rendition="#italic">The Ambassador in Mexico</hi> (<hi rendition="#italic">Morrow</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1928-09-14"><hi rendition="#italic">September 14,
                        1928</hi></date>.<lb/>[Received September 20.]</dateline>
                    <seg rendition="#float-left">No. 970</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Confirming my telegram No. 256, 3 p.m., of
                    today’s date,<anchor n="70" xml:id="d172-f1"/> reporting the receipt of a note
                    from the Acting Minister of Foreign Affairs in answer to Ambassador Morrow’s
                    note of August 27th, 1928, inviting the adherence of the Mexican Government to
                    the Multilateral Treaty for the Renunciation of War as an Instrument of National
                    Policy, I have the honor to enclose a copy and translation of the Mexican note
                    accepting this invitation.</p>
                <p>I have [etc.]</p>
                <closer>For the Ambassador:<lb/><signed><hi rendition="#small-caps">H. F. Arthur
                            Schoenfeld</hi></signed></closer>


                <xi:include href="d172-a1.xml" xpointer="d172-a1"/>
            </div>
        </body>
    </text>
