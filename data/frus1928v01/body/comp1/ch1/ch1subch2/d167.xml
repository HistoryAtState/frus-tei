                <pb facs="0323" n="195" sameAs="frus:frus1928v01/pg195"/>

                <note rend="inline" type="source">711.6712Anti-War/14</note>
                <head><hi rendition="#italic">The Ambassador in Turkey</hi> (<hi rendition="#italic"
                        >Grew</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1928-09-07"><hi rendition="#italic">September 7,
                        1928</hi></date>.<lb/>[Received September 26.]</dateline>
                    <seg rendition="#float-left">No. 474</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to my telegram No. 106 of
                    September 7, 1:00 P.M. [<hi rendition="#italic">12:00 M</hi>]<anchor n="65"
                        xml:id="d167-f1"/> transmitting translation of a note from the Minister for
                    Foreign Affairs announcing Turkey’s adherence to the Multilateral Pact for the
                    Renunciation of War, without reservation, I have the honor to transmit herewith
                    copy with translation of Foreign Office Note 47668–26, dated Angora September 6,
                    1928, on which my telegram was based.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Joseph C. Grew</hi></signed></closer>


                <xi:include href="d167-a1.xml" xpointer="d167-a1"/>
            </div>
        </body>
    </text>
