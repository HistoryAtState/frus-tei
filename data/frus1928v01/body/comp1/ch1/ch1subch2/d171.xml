    <text>
        <body>
            <div xml:id="d171">

                <pb facs="0329" n="201" sameAs="frus:frus1928v01/pg201"/>

                <note rend="inline" type="source">711.7512Anti-War/4</note>
                <head><hi rendition="#italic">The Minister in Albania</hi> (<hi rendition="#italic"
                        >Hart</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Tirana</hi></placeName>, <date calendar="gregorian"
                            when="1928-09-13"><hi rendition="#italic">September 13,
                        1928</hi></date>.<lb/>[Received September 26.]</dateline>
                    <seg rendition="#float-left">No. 520</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my telegram No. 58 of
                    September 8 [<hi rendition="#italic">6</hi>], 1928,<anchor n="69"
                        xml:id="d171-f1"/> I have the honor to enclose herewith copies of the Note
                    of the Albanian Minister for Foreign Affairs expressing the desire of the Royal
                    Government of Albania to adhere to the multilateral treaty against war.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Charles C. Hart</hi></signed></closer>


                <xi:include href="d171-a1.xml" xpointer="d171-a1"/>
            </div>
        </body>
    </text>
