    <text>
        <body>
            <div xml:id="d142">

                <pb facs="0292" n="164" sameAs="frus:frus1928v01/pg164"/>

                <note rend="inline" type="source">711.1812Anti-War/3</note>
                <head><hi rendition="#italic">The Costa Rican Chargé</hi> (<hi
                            rendition="#italic">González</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><seg rendition="#center">[Translation]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1928-08-30"><hi rendition="#italic">August 30,
                        1928</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Mr. Secretary</hi>: I have the honor to inform Your
                    Excellency that I have been informed by my Government that, in response to the
                    kind invitation received through the Chargé d’Affaires ad interim of the United
                    States of America at San José, the Government has declared that it adheres to
                    the Kellogg pact which will, in due course, be referred to the Congress for its
                    ratification.</p>
                <p>I am [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Guillermo E.
                    González</hi></signed></closer>
            </div>
        </body>
    </text>
