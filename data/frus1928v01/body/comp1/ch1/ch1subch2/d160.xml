    <text>
        <body>
            <div xml:id="d160">

                <pb facs="0315" n="187" xml:id="pg187"/>

                <note rend="inline" type="source">711.7412Anti-War/8</note>
                <head><hi rendition="#italic">The Minister in Bulgaria</hi> (<hi rendition="#italic"
                        >Wilson</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Sofia</hi></placeName>, <date calendar="gregorian"
                            when="1928-09-05"><hi rendition="#italic">September 5,
                        1928</hi></date>.<lb/>[Received September 26.]</dateline>
                    <seg rendition="#float-left">No. 1320</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to the Legation’s Despatch No.
                    1315 of the third instant and confirming the Legation’s telegram No. 21 of
                    to-day’s date,<anchor n="54" xml:id="d160-f1"/> I have the honor to enclose,
                    herewith, a translation of the note from the Minister for Foreign Affairs
                    accepting the invitation extended to Bulgaria to become a signatory of the
                    Anti-War Pact signed at Paris on August 27, 1928.</p>
                <p>I also have the honor to enclose, herewith, a number of translations from the
                    newspapers commenting upon the adhesion of Bulgaria to the pact.<anchor n="55"
                        xml:id="d160-f2"/></p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Charles S. Wilson</hi></signed></closer>


                <xi:include href="d160-a1.xml" xpointer="d160-a1"/>
            </div>
        </body>
    </text>
