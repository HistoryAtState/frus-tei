    <text>
        <body>
            <div xml:id="d43">

                <pb facs="0183" n="55" sameAs="frus:frus1928v01/pg55"/>

                <note rend="inline" type="source">711.6512Anti-War/41</note>
                <head><hi rendition="#italic">The Ambassador in Italy</hi> (<hi rendition="#italic">Fletcher</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Rome</hi></placeName>, <date calendar="gregorian" when="1928-05-05"
                                ><hi rendition="#italic">May 5, 1928</hi></date>.<lb/>[Received May
                        23.]</dateline>
                    <seg rendition="#float-left">No. 1682</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Confirming my telegram No. 47 of May 5, 12
                        noon,<anchor n="56" xml:id="d43-f1"/> I have the honor to forward herewith a
                    copy and translation of the reply of the Italian Government regarding the
                    proposed multilateral antiwar treaty.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Henry P. Fletcher</hi></signed></closer>


                <xi:include href="d43-a1.xml" xpointer="d43-a1"/>
            </div>
        </body>
    </text>
