    <text>
        <body>
            <div xml:id="d85">

                <pb facs="0234" n="106" sameAs="frus:frus1928v01/pg106"/>

                <note rend="inline" type="source">711.6212Anti-War/64</note>
                <head><hi rendition="#italic">The Ambassador in Germany</hi> (<hi rendition="#italic">Schurman</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Berlin</hi></placeName>, <date calendar="gregorian"
                            when="1928-07-11"><hi rendition="#italic">July 11,
                        1928</hi></date>.<lb/>[Received July 23.]</dateline>
                    <seg rendition="#float-left">No. 3706</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Confirming my telegram No. 149 of July 11,
                        1928,<anchor n="91" xml:id="d85-f1"/> I have the honor to transmit herewith,
                    in copy and translation, text of the reply of the German Government, received
                    under even date, to the note of June 23, 1928, transmitting the revised draft of
                    the proposed antiwar treaty.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Jacob Gould
                    Schurman</hi></signed></closer>


                <xi:include href="d85-a1.xml" xpointer="d85-a1"/>
            </div>
        </body>
    </text>
