    <text>
        <body>
            <div xml:id="d91-a1">

                <pb facs="0239" n="111" sameAs="frus:frus1928v01/pg111"/>

                <opener><seg rendition="#center">[Enclosure]</seg></opener>
                <head><hi rendition="#italic">The Canadian Secretary of State for External
                        Affairs</hi> (<hi rendition="#italic">Mackenzie
                            King</hi>) <hi rendition="#italic">to the American
                        Minister</hi> (<hi rendition="#italic"
                        >Phillips</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Ottawa</hi></placeName>, <date calendar="gregorian"
                            when="1928-07-16"><hi rendition="#italic">16 July,
                        1928</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I desire to acknowledge your note of June
                    23rd and the revised draft which it contained of the Treaty for the Renunciation
                    of War, and to state that His Majesty’s Government in Canada cordially accepts
                    the Treaty as revised and is prepared to participate in its signature.</p>
                <p>Accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps">W. L. Mackenzie
                    King</hi></signed></closer>
            </div>
        </body>
    </text>
