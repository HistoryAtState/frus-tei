                <pb facs="0509" n="381" sameAs="frus:frus1928v01/pg381"/>

                <note rend="inline" type="source">560.M3/23: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Minister in Switzerland</hi> (<hi
                            rendition="#italic">Wilson</hi>)</head>
                <opener><seg rendition="#center">[Paraphrase—Extract]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1928-06-21T18:00:00-04:00"><hi rendition="#italic">June 21, 1928—6
                                p.m.</hi></date></dateline></opener>
                <p>63. …</p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>Department has received since June 15 insistent requests from film interests
                    which urge a very strong stand. A subsequent telegram may take up this
                    subject.</p>
                <closer><signed><hi rendition="#small-caps">Kellogg</hi></signed></closer>
            </div>
        </body>
