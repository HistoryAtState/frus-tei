                <pb facs="0926" n="798" sameAs="frus:frus1928v01/pg798"/>

                <note rend="inline" type="source">810.79611 Pan American Airways, Inc./172:
                    Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Ambassador in Chile</hi> (<hi rendition="#italic"
                            >Culbertson</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1928-12-11T14:00:00-05:00"><hi rendition="#italic">December 11,
                                1928—2 p.m.</hi></date></dateline></opener>
                <p>89. The Department is informed that Pan American Airways, Inc. and W. R. Grace
                    &amp; Company are asking the Chilean Government for a concession for commercial
                    air mail service from Arica south in the name of the Chilean Airways
                    Corporation, an American company, and are submitting definite written
                    proposition.</p>
                <closer><signed><hi rendition="#small-caps">Kellogg</hi></signed></closer>
            </div>
        </body>
    </text>
