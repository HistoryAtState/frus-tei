            <div xml:id="d816">

                <pb facs="1141" n="1013" sameAs="frus:frus1928v01/pg1013"/>

                <note rend="inline" type="source">711.639 Legal Protection/2</note>
                <head><hi rendition="#italic">The Austrian Minister</hi> (<hi rendition="#italic"
                        >Prochnik</hi>) <hi rendition="#italic">to the Under Secretary of State</hi>
                        (<hi rendition="#italic">Olds</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1927-07-21"><hi rendition="#italic">July 21,
                        1927</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Under Secretary of State</hi>: Reverting
                    to our conversation of today, I take the liberty of outlining in the enclosed
                    memorandum the subject which the Austrian Government is anxious to regulate by
                    convention to be negotiated and concluded with the Government of the United
                    States.</p>
                <p>You would do me a great favor by having me advised in due course of the attitude
                    of your Government in regard to this question.</p>
                <p>Kindly accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Edgar Prochnik</hi></signed></closer>


                <xi:include href="d816-a1.xml" xpointer="d816-a1"/>
            </div>
        </body>
    </text>
