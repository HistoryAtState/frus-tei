            <div xml:id="d743">

                <pb facs="1016" n="888" sameAs="frus:frus1928v01/pg888"/>

                <note rend="inline" type="source">863.51 Relief Credits/52: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Minister in Austria</hi> (<hi rendition="#italic"
                            >Washburn</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1928-03-10T16:00:00-05:00"><hi rendition="#italic">March 10,
                                1928—4 p.m.</hi></date></dateline></opener>
                <p>17. Department’s 16, your 12.<anchor n="36" xml:id="d743-f1"/> Please informally
                    mention to appropriate official [the] general nature of report contained in
                    London Embassy’s telegram 46, March 9, 4 p.m., repeated to Vienna, and telegraph
                    further comment as soon as possible.</p>
                <closer><signed><hi rendition="#small-caps">Kellogg</hi></signed></closer>
            </div>
        </body>
    </text>
