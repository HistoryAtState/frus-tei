    <text>
        <body>
            <div xml:id="d738">

                <pb facs="1012" n="884" sameAs="frus:frus1928v01/pg884"/>

                <note rend="inline" type="source">863.51 Relief Credits/41</note>
                <head><hi rendition="#italic">The Austrian Minister</hi> (<hi
                            rendition="#italic">Prochnik</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1928-03-07"><hi rendition="#italic">March 7,
                        1928</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary of State</hi>: I have the honor
                    to enclose herewith a Memorandum concerning the present status of deferment of a
                    lien held against Austria by European countries.</p>
                <p>Accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Edgar Prochnik</hi></signed></closer>


                <xi:include href="d738-a1.xml" xpointer="d738-a1"/>
            </div>
