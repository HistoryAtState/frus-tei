                <pb facs="1146" n="1018" sameAs="frus:frus1928v01/pg1018"/>

                <note rend="inline" type="source">824.74 Standard Oil Co./4: Telegram</note>
                <head><hi rendition="#italic">The Minister in Bolivia</hi> (<hi rendition="#italic"
                        >Kaufman</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps">La
                                Paz</hi></placeName>, <date calendar="gregorian"
                            when="1928-08-24T12:00:00-04:32"><hi rendition="#italic">August 24,
                                1928—noon</hi></date>.<lb/>[Received 12:10 p.m.]</dateline></opener>
                <p>38. Department’s telegram No. 12, June 13th [<hi rendition="#italic">12th</hi>].
                    Executive decree authorizing Standard Oil Company of Bolivia to construct
                    wireless telegraph station at Yacuiba signed on August 23rd.</p>
                <closer><signed><hi rendition="#small-caps">Kaufman</hi></signed></closer>
            </div>
        </body>
