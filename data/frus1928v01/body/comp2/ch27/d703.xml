    <text>
        <body>
            <div xml:id="d703">

                <pb facs="0973" n="845" sameAs="frus:frus1928v01/pg845"/>

                <note rend="inline" type="source">875.001Zog/7: Telegram</note>
                <head><hi rendition="#italic">The Minister in Albania</hi> (<hi rendition="#italic"
                        >Hart</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Tirana</hi></placeName>, <date calendar="gregorian"
                            when="1928-08-04T10:00:00+01:00"><hi rendition="#italic">August 4,
                                1928—10 a.m.</hi></date><lb/>[Received 8:10
                    p.m.]</dateline></opener>
                <p>48. Zogu<anchor n="2" xml:id="d703-f1"/> to proclaim himself King within 30 days,
                    officially disclosed.</p>
                <closer><signed><hi rendition="#small-caps">Hart</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d703-f1" n="2" xml:id="d703-f1-content">
                <p>Ahmet Zogu, President of Albania.</p>
            </note>
        </listAnnotation>
