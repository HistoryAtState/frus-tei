                <pb facs="0973" n="845" sameAs="frus:frus1928v01/pg845"/>

                <note rend="inline" type="source">875.001Zog/12: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Minister in
                        Albania</hi> (<hi rendition="#italic">Hart</hi>)</head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1928-08-28T18:00:00-04:00"><hi rendition="#italic">August 28,
                                1928—6 p.m.</hi></date></dateline></opener>
                <p>28. Your 48, August 4, 10 a.m. The Department presumes you will continue to keep
                    it advised by cable regarding the proposed change of regime in Albania. The
                    Department also wishes information at the appropriate moment regarding the
                    action your colleagues will take concerning recognition and presence at the
                    coronation.</p>
                <closer><signed><hi rendition="#small-caps">Castle</hi></signed></closer>
            </div>
        </body>
