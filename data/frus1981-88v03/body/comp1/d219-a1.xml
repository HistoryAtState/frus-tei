                <pb facs="0766" n="735" xml:id="pg735"/>


                <head>
                    <hi rendition="#bold">Paper Prepared in the Department of State</hi><anchor
                        n="4" xml:id="d219-f1"/>
                </head>
                <opener><dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date
                            ana="#date_undated-inferred-from-document-content-and-sibling-dates"
                            calendar="gregorian" notAfter="1982-09-30T23:59:59-04:00"
                            notBefore="1982-09-28T18:30:00-04:00">undated</date>
                    </dateline></opener>
                <table cols="4">
                    <row role="label">
                        <cell>
                            <hi rendition="#italic">General Areas for Progress</hi>
                        </cell>
                        <cell>
                            <hi rendition="#italic">Specific Steps</hi>
                        </cell>
                        <cell>
                            <hi rendition="#italic">US Response</hi>
                        </cell>
                        <cell>
                            <hi rendition="#italic">Practical Next Steps</hi>
                        </cell>
                    </row>
                    <row>
                        <cell>Avoiding <hi rendition="#italic">new</hi> unhelpful actions.</cell>
                        <cell>No MiGs to Nicaragua</cell>
                        <cell>No crowing</cell>
                        <cell>None</cell>
                    </row>
                    <row>
                        <cell>Easing existing trouble spots</cell>
                        <cell>Acceptance of Cuban withdrawal from Angola</cell>
                        <cell>Credit USSR for contributing to
                            solution</cell>
                        <cell>
                            Hartman/Crocker-Kornyenko/Ilychev</cell>
                    </row>
                    <row>
                        <cell>Responding to our human rights concerns</cell>
                        <cell>Releasing dissidents</cell>
                        <cell>Credit USSR for steps in the right
                            direction; possible CSCE
                            movement</cell>
                        <cell>Kampelman-Kovalev</cell>
                    </row>
                    <row>
                        <cell>More forthcoming positions in arms control</cell>
                        <cell>Movement toward US reductions proposals in START and INF</cell>
                        <cell>Will address Soviet concerns about US systems</cell>
                        <cell>Geneva negotiations</cell>
                    </row>
                    <row>
                        <cell>Willingness to discuss common concerns</cell>
                        <cell>Non-proliferation technical talks</cell>
                        <cell>Serious exchanges</cell>
                        <cell>
                            Kennedy-Counterpart</cell>
                    </row>
                </table>
            </div>
