            <div xml:id="d432">

                <pb facs="0433" n="424" sameAs="frus:frus1938v05/pg424"/>

                <note rend="inline" type="source">611.2531/249</note>
                <head><hi rendition="#italic">The Chargé in Chile</hi> (<hi rendition="#italic"
                        >Frost</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 825</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Santiago</hi></placeName>, <date calendar="gregorian"
                            when="1938-01-12">January 12, 1938</date>.<lb/>[Received January
                        18.]</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my telegram No. 12 of January
                    12, 6:00 p.m., I have the honor to transmit herewith a copy and a translation of
                    a memorandum received today from the Foreign Office relative to the question as
                    to when the <hi rendition="#italic">modus vivendi</hi> signed on January 6, 1938
                    will enter in effect.</p>
                <p>Respectfully,</p>
                <closer><signed><hi rendition="#small-caps">Wesley Frost</hi></signed></closer>


                <xi:include href="d432-a1.xml" xpointer="d432-a1"/>
