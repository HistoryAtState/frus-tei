            <div xml:id="d574">

                <pb facs="0579" n="570" xml:id="pg570"/>

                <note rend="inline" type="source">816.51C39/547</note>
                <head><hi rendition="#italic">The Minister in El Salvador</hi> (<hi
                        rendition="#italic">Frazer</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 203</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">San
                                Salvador</hi></placeName>, <date calendar="gregorian"
                            when="1938-06-23">June 23, 1938</date>.<lb/>[Received June
                        29.]</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: Pursuant to my telegram No. 19 of June 21,
                    6 p.m., I have the honor to enclose the English and Spanish versions of a
                    self-explanatory communication dated June 22, which I sent to President Martinez
                    in the latter language this morning.</p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">Robert Frazer</hi></signed></closer>


                <xi:include href="d574-a1.xml" xpointer="d574-a1"/>
