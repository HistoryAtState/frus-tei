                <pb facs="0324" n="315" sameAs="frus:frus1938v05/pg315"/>

                <note rend="inline" type="source">835.248/88: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Argentina</hi> (<hi
                        rendition="#italic">Weddell</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">Buenos
                                Aires</hi></placeName>, <date calendar="gregorian"
                            when="1938-04-04T18:00:00-04:00">April 4, 1938—6
                        p.m.</date><lb/>[Received April 4—5:50 p.m.]</dateline>
                </opener>
                <p>84. For Secretary and Under Secretary. My 78, March 30, 10 p.m. Following request
                    for appointment through Ministry for Foreign Affairs, Minister of War today
                    called on me, emphasizing the urgency and importance of request contained in my
                    telegram and asking my assistance. Despatch by air mail.<anchor n="33"
                        xml:id="d301-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Weddell</hi></signed></closer>
            </div>
        </body>
    </text>
