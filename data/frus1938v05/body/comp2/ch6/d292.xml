    <text>
        <body>
            <div xml:id="d292">

                <pb facs="0314" n="305" sameAs="frus:frus1938v05/pg305"/>

                <note rend="inline" type="source">611.3531/664</note>
                <head><hi rendition="#italic">The Ambassador in Argentina</hi> (<hi rendition="#italic">Weddell</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 2155</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">Buenos
                                Aires</hi></placeName>, <date calendar="gregorian" when="1938-08-17"
                            >August 17, 1938</date>.<lb/>[Received August 26.]</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to enclose as of possible
                    interest to the Department a memorandum prepared by the Consul General relating
                    to the proposed United States-Argentine Commercial Agreement and which is based
                    on conversations with Dr. Alfredo Louro and others in the recent past.</p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">Alexander W.
                    Weddell</hi></signed></closer>



                <xi:include href="d292-a1.xml" xpointer="d292-a1"/>
