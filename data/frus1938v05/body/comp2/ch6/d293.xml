    <text>
        <body>
            <div xml:id="d293">

                <pb facs="0316" n="307" sameAs="frus:frus1938v05/pg307"/>

                <note rend="inline" type="source">835.5151/942</note>
                <head><hi rendition="#italic">The Ambassador in Argentina</hi> (<hi
                        rendition="#italic">Weddell</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 2239</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">Buenos
                                Aires</hi></placeName>, <date calendar="gregorian" when="1938-10-04"
                            >October 4, 1938</date>.<lb/>[Received October 11.]</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit a confidential
                    communication addressed to me under date of October 4 by Consul General Davis,
                    setting forth a conversation held by him with the Chief of the Argentine
                    Exchange Control Office in which a possible trade agreement with the United
                    States, and also the possibility of a dollar loan to be floated in New York,
                    were discussed.</p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">Alexander W.
                    Weddell</hi></signed></closer>



                <xi:include href="d293-a1.xml" xpointer="d293-a1"/>
