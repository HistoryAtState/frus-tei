    <text>
        <body>
            <div xml:id="d153">

                <pb facs="0177" n="168" xml:id="pg168"/>

                <note rend="inline" type="source">724.34119/1478</note>
                <head><hi rendition="#italic">The American Delegate to the Chaco Peace
                        Conference</hi> (<hi rendition="#italic"
                        >Braden</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 706</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">Buenos
                                Aires</hi></placeName>, <date calendar="gregorian" when="1938-07-11"
                            >July 11, 1938</date>.<lb/>[Received July 19.]</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit in Spanish and
                    English translation the draft Treaty of Peace, Friendship and Limits initialed
                    and the supplementary annex to the Treaty signed in the early morning of July 9,
                    1938.</p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">Spruille Braden</hi></signed></closer>


                <xi:include href="d153-a1.xml" xpointer="d153-a1"/>
