    <text>
        <body>
            <div xml:id="d85">

                <pb facs="0115" n="106" xml:id="pg106"/>

                <note rend="inline" type="source">724.34119/1284: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Argentina</hi> (<hi rendition="#italic">Weddell</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">Buenos
                                Aires</hi></placeName>, <date calendar="gregorian"
                            when="1938-04-07T11:00:00-04:00">April 7, 1938—11
                        a.m.</date><lb/>[Received April 7—10:50 a.m.]</dateline>
                </opener>
                <p>85. Braden left for La Paz yesterday by train accompanied by Uruguayan and
                    Brazilian representatives. They expect to arrive there on Saturday.</p>
                <closer><signed><hi rendition="#small-caps">Weddell</hi></signed></closer>
            </div>
        </body>
