                <pb facs="0255" n="246" sameAs="frus:frus1938v05/pg246"/>

                <note rend="inline" type="source">715.1715/1141</note>
                <head><hi rendition="#italic">The Special Representative of the President</hi> (<hi
                        rendition="#italic">Corrigan</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 58</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">San
                                José</hi></placeName>, <date calendar="gregorian" when="1938-03-01"
                            >March 1, 1938</date>.<lb/>[Received March 5.]</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit copy with
                    translation of the text of identical notes, Nos. 50 and 51, sent by the
                    Commission to the Delegations of Honduras and Nicaragua on February 26, 1938.
                    The notes, replies to which are expected sometime next week, were not released
                    to the press.</p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">Frank P. Corrigan</hi></signed></closer>


                <xi:include href="d228-a1.xml" xpointer="d228-a1"/>
