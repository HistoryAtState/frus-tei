    <text>
        <body>
            <div xml:id="d419">

                <pb facs="0423" n="414" sameAs="frus:frus1938v05/pg414"/>

                <note rend="inline" type="source">832.00 Revolutions/599a: Telegram</note>
                <head><hi rendition="#italic">President Roosevelt
                        to President Vargas</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1938-05-12">May 12, 1938</date>.</dateline>
                </opener>
                <p>Please accept my sincere congratulations upon your fortunate escape from the
                    attempt made upon your life. I send you my most cordial greetings and the
                    assurances of my high personal regard.</p>
                <closer><signed><hi rendition="#small-caps">Franklin D.
                    Roosevelt</hi></signed></closer>
            </div>
        </body>
    </text>
