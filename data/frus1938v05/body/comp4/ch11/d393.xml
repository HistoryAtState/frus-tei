            <div xml:id="d393">

                <pb facs="0399" n="390" sameAs="frus:frus1938v05/pg390"/>

                <note rend="inline" type="source">632.6231/294</note>
                <head><hi rendition="#italic">The Ambassador in Brazil</hi> (<hi rendition="#italic"
                        >Caffery</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 350</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">Rio de
                                Janeiro</hi></placeName>, <date calendar="gregorian"
                            when="1938-02-23">February 23, 1938</date>.<lb/>[Received March
                        4.]</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit, for the
                    information of the Department, a memorandum of a conversation between the
                    Counselor of the Embassy and Senhor Barbosa Carneiro, the Chief of the
                    Commercial Section of the Foreign Office on the compensation mark situation.</p>
                <p>Respectfully yours,</p>
                <closer>For the Ambassador:<lb/><signed>R. M. <hi rendition="#small-caps"
                            >Scotten</hi></signed><lb/><hi rendition="#italic">Counselor of
                        Embassy</hi></closer>


                <xi:include href="d393-a1.xml" xpointer="d393-a1"/>
            </div>
