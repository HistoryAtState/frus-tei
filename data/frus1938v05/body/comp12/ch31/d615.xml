            <div xml:id="d615">

                <pb facs="0633" n="624" sameAs="frus:frus1938v05/pg624"/>

                <note rend="inline" type="source">638.5131/212</note>
                <head><hi rendition="#italic">The Chargé in Haiti</hi> (<hi
                            rendition="#italic">Finley</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 259</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Port-au-Prince</hi></placeName>, <date calendar="gregorian"
                            when="1938-07-30">July 30, 1938</date>.<lb/>[Received August
                        2.]</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to enclose a copy of a
                    memorandum which has been given me by Mr. Sidney de la Rue, the Fiscal
                    Representative, <pb facs="0634" n="625" xml:id="pg625"/> concerning a
                    conversation which he had with Secretary of Foreign Affairs Georges Léger on
                    July 29, 1938.</p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">Harold D. Finley</hi></signed></closer>


                <xi:include href="d615-a1.xml" xpointer="d615-a1"/>
