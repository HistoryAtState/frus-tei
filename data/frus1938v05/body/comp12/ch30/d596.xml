            <div xml:id="d596">

                <pb facs="0605" n="596" sameAs="frus:frus1938v05/pg596"/>

                <note rend="inline" type="source">838.51/3634</note>
                <head><hi rendition="#italic">The Minister in Haiti</hi> (<hi rendition="#italic"
                        >Mayer</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 199</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Port-au-Prince</hi></placeName>, <date calendar="gregorian"
                            when="1938-06-17">June 17, 1938</date>.<lb/>[Received June
                        18.]</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to refer to my telegram
                    No. 65, June 15, 12 noon, 1938, and to transmit herewith a copy and translation
                    of Haitian Foreign Office note dated June 14, 1938, and its enclosures
                    requesting the extension for another year of the moratorium which resulted from
                    the Accord of January 13, 1938.</p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">Ferdinand L.
                    Mayer</hi></signed></closer>


                <xi:include href="d596-a1.xml" xpointer="d596-a1"/>
