    <text>
        <body>
            <div xml:id="d19-a3">

                <pb facs="0058" n="792" sameAs="frus:frus1895p2/pg792"/>

                <head><hi rendition="#small-caps">Exhibit</hi> 2.</head>
                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName>
                            <placeName type="venue"><hi rendition="#small-caps">Palace of the
                                    Government</hi></placeName>, <lb/>
                            <placeName type="city"><hi rendition="#italic"
                                >Guatemala</hi></placeName></placeName>, <date
                            ana="#date_apparent-typo-based-on-sibling-dates" calendar="gregorian"
                            when="1888-05-24"><hi rendition="#italic">May 24,
                        1388</hi>.</date></dateline></opener>
                <p rendition="#center">
                    <hi rendition="#italic">Mr. Anguiana to Mr. Hollander.</hi>
                </p>
                <p rendition="#flush">[Imprint of the Secretary of the Interior.]</p>
                <p rendition="#flush">Sr. Don <hi rendition="#small-caps">J. H. Hollander</hi>, <hi
                        rendition="#italic">Present:</hi></p>
                <p>You will please deliver to Sr. Don Juan Padilla M. the press, with its
                    corresponding accessories, belonging to the Government, and which from the
                    National Institute was delivered to you for the printing of the newspaper El
                    Dia.</p>
                <p>I am, your obedient servant,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Anguiana.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
