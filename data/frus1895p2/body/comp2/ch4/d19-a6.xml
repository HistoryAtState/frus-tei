    <text>
        <body>
            <div xml:id="d19-a6">

                <pb facs="0059" n="793" sameAs="frus:frus1895p2/pg793"/>

                <head><hi rendition="#small-caps">Exhibit</hi> 5.</head>
                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Guatemala</hi></placeName>, <date calendar="gregorian"
                            when="1888-04-07"><hi rendition="#italic">April 7,
                        1888</hi>.</date></dateline></opener>
                <p rendition="#flush">
                    <hi rendition="#italic">Sr. Director de la Imprenta de Estrella:</hi>
                </p>
                <p>There have been received in this office of the minister 1,100 copies of the
                    Eclectic Sillabary, by Don Juan Ma. Vela, by which is completed the quantity of
                    20,000.</p>
                <closer><signed><hi rendition="#small-caps">S. Sta. Cruz.</hi></signed><lb/>[Seal of
                    the minister of public instruction.]</closer>
            </div>
        </body>
