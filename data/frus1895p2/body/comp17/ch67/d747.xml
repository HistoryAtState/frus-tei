    <text>
        <body>
            <div xml:id="d747">

                <pb facs="0740" n="1474" sameAs="frus:frus1895p2/pg1474"/>

                <head>
                    <hi rendition="#italic">Mr. Andrade to Mr.
                            Gresham.</hi>
                </head>
                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of Venezuela</hi>,<lb/><hi rendition="#italic">Washington,
                                D. C.</hi></placeName>, <date calendar="gregorian" when="1895-03-12"
                                ><hi rendition="#italic">March 12,
                    1895</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to request, in the name of
                    my Government and under the head of friendly service, that your excellency may
                    be pleased to authorize by cable the ambassador of the United States at Paris to
                    assume charge of the protection of Venezuelan interests in France in the event
                    of the minister of Venezuela making such a proposition by reason of his having
                    to leave that country.</p>
                <p>I avail myself, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">José Andrade.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
