    <text>
        <body>
            <div xml:id="d760">

                <pb facs="0751" n="1485" sameAs="frus:frus1895p2/pg1485"/>

                <head>
                    <hi rendition="#italic">Mr. Uhl to Mr.
                            Andrade.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-04-26"><hi rendition="#italic">April 26,
                        1895</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 6.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of the 22d instant, in which you advise the Department that you
                    have been informed by the minister of foreign relations at Caracas that the
                    report of the hostile attitude of England, because of the Cuyuni incident,
                    appears to be without foundation.</p>
                <p>Accept, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">Edwin F. Uhl</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
