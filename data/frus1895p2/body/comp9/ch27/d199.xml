    <text>
        <body>
            <div xml:id="d199">

                <pb facs="0277" n="1011" sameAs="frus:frus1895p2/pg1011"/>

                <head>
                    <hi rendition="#italic">Mr. Ransom to Mr. Olney.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1895-11-09"><hi rendition="#italic">November 9, 1895</hi></date>.
                        (Received Nov. 16.)</dateline>
                    <seg rendition="#float-left">No. 82.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith, in
                    original and translation, the laws of Mexico concerning naturalization and the
                    law relative to the acquisition of real estate in Mexico by foreigners.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Matt W. Ransom.</hi>
                    </signed>
                </closer>




                <xi:include href="d199-a1.xml" xpointer="d199-a1"/>
