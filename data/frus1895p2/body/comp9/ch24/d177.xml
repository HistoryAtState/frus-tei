    <text>
        <body>
            <div xml:id="d177">

                <pb facs="0259" n="993" sameAs="frus:frus1895p2/pg993"/>

                <head>
                    <hi rendition="#italic">Mr. Olney to Mr. Ransom.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-10-04"><hi rendition="#italic">October 4,
                        1895</hi>.</date></dateline></opener>
                <p>Department sees no objection your acting as arbitrator as desired by Mexico and
                    Guatemala.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Olney.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
