    <text>
        <body>
            <div xml:id="d178">

                <pb facs="0259" n="993" sameAs="frus:frus1895p2/pg993"/>

                <head>
                    <hi rendition="#italic">Mr. Ransom to Mr.
                            Olney.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1895-10-08"><hi rendition="#italic">October 8, 1895</hi></date>.
                        (Received Oct. 15.)</dateline>
                    <seg rendition="#float-left">No. 75.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inform you that I have
                    accepted the position of arbitrator between Mexico and Guatemala. The choice
                    comes at the same time from both Governments, and though the work will be
                    arduous and the result possibly not entirely satisfactory, I thought it my duty
                    to undertake the office.</p>
                <p>With very high regard,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">M. W. Ransom.</hi>
                    </signed>
                </closer>



                <xi:include href="d178-a1.xml" xpointer="d178-a1"/>
