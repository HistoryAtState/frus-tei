    <text>
        <body>
            <div xml:id="d174">

                <pb facs="0255" n="989" sameAs="frus:frus1895p2/pg989"/>

                <head>
                    <hi rendition="#italic">Mr. Butler to Mr.
                            Gresham.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1895-04-10"><hi rendition="#italic">April 10, 1895</hi></date>.
                        (Received April 17.)</dateline>
                    <seg rendition="#float-left">No. 476.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to submit, in text and
                    translation, the agreement between Mexico and Guatemala, signed on the 1st and
                    published on the 8th instant in the Diario Oficial.</p>
                <p>I am, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">E. C. Butler.</hi>
                    </signed>
                </closer>


                <xi:include href="d174-a1.xml" xpointer="d174-a1"/>
