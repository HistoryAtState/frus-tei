    <text>
        <body>
            <div xml:id="d185">

                <pb facs="0262" n="996" sameAs="frus:frus1895p2/pg996"/>

                <head>
                    <hi rendition="#italic">Mr. Uhl to Mr. Butler.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-02-28"><hi rendition="#italic">February 28,
                        1895</hi>.</date></dateline>
                    <seg rendition="#float-left">No. 357.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith copy of the concurrent
                    resolution adopted by the Senate on the 21st instant, and agreed to by the House
                    of Representatives on the following day, expressing the gratification of the
                    Congress at the honors paid to the memory of Mr. Isaac P. Gray by the Mexican
                    Government.</p>
                <p>The engrossed copy is now being prepared and will be sent to you, when completed,
                    for delivery to the Government of Mexico.</p>
                <p>I am, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">Edwin F. Uhl</hi>, <hi rendition="#italic"
                            >Acting Secretary.</hi></signed>
                </closer>


                <xi:include href="d185-a1.xml" xpointer="d185-a1"/>
            </div>
        </body>
    </text>
