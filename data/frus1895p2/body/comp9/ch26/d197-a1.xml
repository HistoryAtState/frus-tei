    <text>
        <body>
            <div xml:id="d197-a1">

                <pb facs="0276" n="1010" sameAs="frus:frus1895p2/pg1010"/>

                <opener><seg rendition="#center">[Inclosure in No. 103.]</seg></opener>
                <head>
                    <hi rendition="#italic">Mr. Butler to Mr. Mariscal.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1895-12-31"><hi rendition="#italic">December 31,
                        1895</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Sir</hi>: I have the honor to submit copy of a
                    dispatch just received by this legation from the Department of State, in regard
                    to the case of Chester W. Rowe.</p>
                <p>Bespeaking your excellency’s careful consideration of the views and of the
                    request of my Government, as contained therein, it honors me to reiterate,
                    etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">E. C. Butler.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
