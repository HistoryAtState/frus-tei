    <text>
        <body>
            <div xml:id="d197">

                <pb facs="0276" n="1010" sameAs="frus:frus1895p2/pg1010"/>

                <head>
                    <hi rendition="#italic">Mr. Butler to Mr. Olney.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1896-01-02"><hi rendition="#italic">January 2, 1896</hi></date>.
                        (Received January 8.)</dateline>
                    <seg rendition="#float-left">No. 103.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Upon receipt of your dispatch No. 131, of
                    December 13, 1895, regarding the extradition of Chester W. Rowe, I submitted a
                    copy of same, as also a copy of Mr. Lacey’s memorandum, to Minister Mariscal,
                    bespeaking his careful consideration of the views and of the request of our
                    Government therein contained.</p>
                <p>Inclosing copy of this legation’s note to Mr. Mariscal, I am, sir, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">E. C. Butler.</hi>
                    </signed>
                </closer>


                <xi:include href="d197-a1.xml" xpointer="d197-a1"/>
            </div>
