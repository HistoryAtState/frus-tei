    <text>
        <body>
            <div xml:id="d198">

                <pb facs="0276" n="1010" sameAs="frus:frus1895p2/pg1010"/>

                <head>
                    <hi rendition="#italic">Mr. Butler to Mr.
                            Olney.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1896-01-25"><hi rendition="#italic">January 25, 1896</hi></date>.
                        (Received Jan. 31.)</dateline>
                    <seg rendition="#float-left">No. 115.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In continuation to my No. 112, of the 23d
                    instant, I beg to inclose, in copy and translation, another note received from
                    Minister Mariscal in regard to the case of Chester W. Rowe.</p>
                <p>I am, sir, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">E. C. Butler.</hi>
                    </signed>
                </closer>


                <xi:include href="d198-a1.xml" xpointer="d198-a1"/>
