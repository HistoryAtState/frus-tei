                <pb facs="0267" n="1001" sameAs="frus:frus1895p2/pg1001"/>

                <head>
                    <hi rendition="#italic">Mr. Adee to Mr.
                            Butler.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-07-27"><hi rendition="#italic">July 27,
                        1895</hi></date>.</dateline></opener>
                <p>Take no further action at present concerning extradition Chester Rowe.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Adee</hi>, <hi rendition="#italic"
                            >Acting.</hi></signed>
                </closer>
            </div>
        </body>
