    <text>
        <body>
            <div xml:id="d195-a6">

                <pb facs="0273" n="1007" sameAs="frus:frus1895p2/pg1007"/>

                <opener><seg rendition="#center">[Inclosure 6 in No. 40.]</seg></opener>
                <head>
                    <hi rendition="#italic">Mr. Butler to Mr.
                            Mariscal.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1895-07-29"><hi rendition="#italic">July 29,
                        1895</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Sir</hi>: I have the honor to acknowledge the
                    receipt of your excellency’s note of to-day in relation to the extradition of
                    Chester W. and Richard Rowe.</p>
                <p>With assurances, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">E. C. Butler.</hi>
                    </signed>
                </closer>
            </div>
        </body>
