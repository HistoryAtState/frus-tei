    <text>
        <body>
            <div xml:id="d379">

                <pb facs="0437" n="1171" sameAs="frus:frus1895p2/pg1171"/>

                <head>
                    <hi rendition="#italic">Mr. Adee to Mr.
                            Taylor.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-08-12"><hi rendition="#italic">August 12,
                        1895</hi></date>.</dateline></opener>
                <p>Mora claim definitely settled here by signed agreement to pay one and half
                    million Spanish dollars in gold by 15th proximo in full discharge. This is for
                    your information, not for use with Spanish Government or for other official or
                    public purposes.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Adee</hi>, <hi rendition="#italic"
                            >Acting.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
