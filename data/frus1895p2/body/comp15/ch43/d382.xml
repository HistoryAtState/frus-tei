    <text>
        <body>
            <div xml:id="d382">

                <pb facs="0438" n="1172" sameAs="frus:frus1895p2/pg1172"/>

                <head>
                    <hi rendition="#italic">Mr. Olney to Mr.
                            Dupuy de Lôme.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Falmouth</hi></placeName>, <date calendar="gregorian"
                            when="1895-08-24"><hi rendition="#italic">August 24,
                        1895</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Minister</hi>: In accordance with your
                    suggestion, our minister at Madrid will be cabled this afternoon to make formal
                    acceptance of the offer by Spain to settle the Mora claim on the terms of a
                    memorandum executed by yourself, myself, and the agent and counsel for the
                    private parties interested.</p>
                <p>Very truly, yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Richard Olney.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
