    <text>
        <body>
            <div xml:id="d376">

                <pb facs="0436" n="1170" sameAs="frus:frus1895p2/pg1170"/>

                <head>
                    <hi rendition="#italic">Mr. Taylor to Mr.
                            Olney.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1895-07-17"><hi rendition="#italic">July 17,
                        1895</hi></date>.</dateline></opener>
                <p>Council, Queen presiding, authorized immediate settlement Mora matter as
                    liquidated yesterday.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Taylor.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
