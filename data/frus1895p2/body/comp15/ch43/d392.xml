    <text>
        <body>
            <div xml:id="d392">

                <pb facs="0443" n="1177" sameAs="frus:frus1895p2/pg1177"/>

                <head>
                    <hi rendition="#italic">Mr. Armstrong to Mr.
                            Olney.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1895-09-20"><hi rendition="#italic">September 20,
                            1895</hi>.</date></dateline></opener>
                <p>Just received the following response to inquiry as to money being already
                    deposited: “The drafts will be honored the moment presented to delegate of
                    Spanish treasury in London.”</p>
                <closer>
                    <signed><hi rendition="#small-caps">Armstrong</hi>, <hi rendition="#italic"
                            >Chargé.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
