    <text>
        <body>
            <div xml:id="d378">

                <pb facs="0437" n="1171" sameAs="frus:frus1895p2/pg1171"/>

                <head>
                    <hi rendition="#italic">Mr. Adee to Mr.
                            Taylor.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State.</hi><lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-07-20"><hi rendition="#italic">July 20,
                        1895</hi></date>.</dateline></opener>
                <p>Questions as to times of payment, currency, and interest are under consideration
                    with Spanish minister here. You will not raise or discuss these points unless
                    expressly instructed.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Adee</hi>, <hi rendition="#italic"
                            >Acting.</hi></signed>
                </closer>


                <xi:include href="d378-a1.xml" xpointer="d378-a1"/>
