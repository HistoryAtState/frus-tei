    <text>
        <body>
            <div xml:id="d468">

                <pb facs="0485" n="1219" sameAs="frus:frus1895p2/pg1219"/>

                <head>
                    <hi rendition="#italic">Mr. Olney to Mr. Dupuy de Lôme.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1896-01-02"><hi rendition="#italic">January 2,
                        1896</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 63.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I beg to hand you herewith, for your
                    information and such immediate action as you may deem advisable, copy of a
                    letter just received from E. Atkins &amp; Co., Boston, Mass.</p>
                <p>Accept, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Richard Olney.</hi>
                    </signed>
                </closer>


                <xi:include href="d468-a1.xml" xpointer="d468-a1"/>
