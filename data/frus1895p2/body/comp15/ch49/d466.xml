    <text>
        <body>
            <div xml:id="d466">

                <pb facs="0484" n="1218" sameAs="frus:frus1895p2/pg1218"/>

                <head>
                    <hi rendition="#italic">Mr. Olney to Mr. Dupuy de Lôme.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-12-28"><hi rendition="#italic">December 28,
                        1895</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose for your
                    information copy of a letter just received from Messrs. E. Atkins &amp; Co.</p>
                <p>Accept, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Richard Olney.</hi>
                    </signed>
                </closer>


