    <text>
        <body>
            <div xml:id="d465">

                <pb facs="0482" n="1216" sameAs="frus:frus1895p2/pg1216"/>

                <head>
                    <hi rendition="#italic">Mr. Olney to Mr.
                            Dupuy de Lôme.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-12-12"><hi rendition="#italic">December 12,
                        1895</hi>.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a copy
                    of a letter just received at this Department from the firm of Atkins &amp; Co.,
                    of Boston, Mass.</p>
                <p>I send it for your information, as well as for any suggestions and
                    recommendations you may see fit to make either to the Spanish Government or to
                    the local authorities in Cuba for the protection of American properties in Cuba
                    from destruction by the Cuban insurgents.</p>
                <p>Accept, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Richard Olney.</hi>
                    </signed>
                </closer>



                <xi:include href="d465-a1.xml" xpointer="d465-a1"/>
            </div>
        </body>
    </text>
