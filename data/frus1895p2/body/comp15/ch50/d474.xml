    <text>
        <body>
            <div xml:id="d474">

                <pb facs="0487" n="1221" sameAs="frus:frus1895p2/pg1221"/>

                <head>
                    <hi rendition="#italic">Mr. Taylor to Mr. Uhl.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Legation</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1895-05-31"><hi rendition="#italic">May 31,
                        1895</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 363.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Inclosed please find copy, with
                    translation, of a note from the minister of state informing me of the release of
                    Francisco Carrillo, in response to the demand contained in your telegram of the
                    17th instant.</p>
                <p>I have just sent you the following telegram: <quote rend="blockquote">
                        <p>Minister for foreign affairs informs me that Governor-General of Cuba has
                            ordered the release of Carrillo.</p>
                    </quote></p>
                <p>I am, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hannis Taylor.</hi>
                    </signed>
                </closer>


                <xi:include href="d474-a1.xml" xpointer="d474-a1"/>
            </div>
        </body>
    </text>
