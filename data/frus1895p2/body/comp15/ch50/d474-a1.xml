    <text>
        <body>
            <div xml:id="d474-a1">

                <pb facs="0487" n="1221" sameAs="frus:frus1895p2/pg1221"/>

                <opener><seg rendition="#center">[Inclosure in No. 363.—Translation.]</seg></opener>
                <head>
                    <hi rendition="#italic">The Duke of Tetuan to Mr.
                            Taylor.</hi>
                </head>
                <opener><dateline rendition="#float-right"><hi rendition="#small-caps">Ministry of
                            State</hi>, <lb/>
                        <placeName type="venue"><hi rendition="#italic">Palace</hi></placeName>,
                            <date calendar="gregorian" when="1895-05-29"><hi rendition="#italic">May
                                29, 1895</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Sir</hi>: I have the honor to inform you, in
                    reply to your polite note of the 18th instant, that I have just received a
                    telegram from the Governor-General of the Island of Cuba reporting that he has
                    ordered that the prisoner Francisco Carrillo be released.</p>
                <p>I seize, etc.,</p>
                <closer>
                    <hi rendition="#small-caps">The Duke of Tetuan.</hi>
                </closer>
            </div>
        </body>
