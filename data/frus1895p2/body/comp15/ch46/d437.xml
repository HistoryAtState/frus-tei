    <text>
        <body>
            <div xml:id="d437">

                <pb facs="0465" n="1199" sameAs="frus:frus1895p2/pg1199"/>

                <head>
                    <hi rendition="#italic">Mr. Olney to Mr. Dupuy de Lôme.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-09-18"><hi rendition="#italic">September 18,
                        1895</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 31.</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your telegram of this date [17], and to say in reply that I have communicated
                    with the Attorney-General, the Secretary of the Treasury, and the Secretary of
                        <pb facs="0466" n="1200" xml:id="pg1200"/> the Navy, and asked their earnest
                    cooperation in the most diligent efforts to prevent any violations of the
                    neutrality laws of the United States, and for the arrest and punishment of any
                    persons found to he engaged therein.</p>
                <p>Faithfully, yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Richard Olney</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
