    <text>
        <body>
            <div xml:id="d419">

                <pb facs="0458" n="1192" sameAs="frus:frus1895p2/pg1192"/>

                <head>
                    <hi rendition="#italic">Mr. Gresham to Mr.
                            Muruaga.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-04-01"><hi rendition="#italic">April 1,
                        1895</hi>.</date></dateline>
                    <seg rendition="#float-left">No. 11.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge receipt of
                    your note of the 30th ultimo, in which you state that you are in possession of
                    official information to the effect that volunteers for the Island of Cuba are
                        <pb facs="0459" n="1193" xml:id="pg1193"/> being publicly recruited at New
                    Orleans in violation of the neutrality laws.</p>
                <p>A copy of your note has been sent to the Attorney-General.</p>
                <p>Accept, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. Q. Gresham.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
