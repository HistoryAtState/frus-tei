    <text>
        <body>
            <div xml:id="d448">

                <pb facs="0470" n="1204" xml:id="pg1204"/>

                <head>
                    <hi rendition="#italic">Mr. Olney to Mr. Dupuy de Lôme.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-10-08"><hi rendition="#italic">October 8,
                        1895</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 43.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your telegram of the 7th instant, and to say that I have transmitted a copy
                    of the same to the Attorney-General, that through him the district attorney at
                    Wilmington, N. C., may be put in possession of the significant facts stated in
                    your dispatch.</p>
                <p>Accept, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Richard Olney.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
