    <text>
        <body>
            <div xml:id="d451">

                <pb facs="0471" n="1205" sameAs="frus:frus1895p2/pg1205"/>

                <head>
                    <hi rendition="#italic">Mr. Olney to Mr.
                            Dupuy de Lôme.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-10-12"><hi rendition="#italic">October 12,
                        1895</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 47.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I am requested by the honorable Secretary
                    of the Treasury to suggest the advisability of your requesting the Spanish
                    consul at Tampa to make applications or to give information relative to alleged
                    infractions of the neutrality laws of the United States to the collector of
                    customs at the port at which the revenue cutter may be stationed, in all cases
                    where the services of such vessel are required.</p>
                <p>Accept, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">Richard Olney</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
