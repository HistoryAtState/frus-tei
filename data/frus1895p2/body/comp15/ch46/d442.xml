    <text>
        <body>
            <div xml:id="d442">

                <pb facs="0467" n="1201" sameAs="frus:frus1895p2/pg1201"/>

                <head>
                    <hi rendition="#italic">Mr. Olney to Mr. Dupuy de Lôme.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-09-21"><hi rendition="#italic">September 21,
                        1895</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 34.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Inclosed please find copy of telegram
                    received at the Department of Justice yesterday afternoon.</p>
                <p>Please furnish the United States district attorney at Wilmington, N. C., directly
                    or through this Department, with all the evidence at your command in support of
                    the proceedings which have been instituted, and oblige,</p>
                <p>Respectfully, yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Richard Olney.</hi>
                    </signed>
                </closer>



                <xi:include href="d442-a1.xml" xpointer="d442-a1"/>
