    <text>
        <body>
            <div xml:id="d441">

                <pb facs="0467" n="1201" sameAs="frus:frus1895p2/pg1201"/>

                <head>
                    <hi rendition="#italic">Mr. Olney to Mr.
                            Dupuy de Lôme.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-09-20"><hi rendition="#italic">September 20,
                        1895</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 33.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge your
                    telegram of the 19th instant, and to say that copies of the same have been
                    communicated to the Departments of Justice and of the Treasury with the request
                    for such immediate official action as will tend to prevent any violation of the
                    neutrality laws of the United States or to punish any such violations as
                    actually occur.</p>
                <p>Accept, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Richard Olney.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
