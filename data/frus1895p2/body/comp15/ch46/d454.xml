    <text>
        <body>
            <div xml:id="d454">

                <pb facs="0472" n="1206" sameAs="frus:frus1895p2/pg1206"/>

                <head>
                    <hi rendition="#italic">Mr. Dupuy de Lôme to Mr. Olney.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Royal Spanish Legation</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-11-28"><hi rendition="#italic">November 28,
                        1895</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Permit me to send you a copy of a letter
                    just received from the Spanish consul in Philadelphia in re James W. Foster.</p>
                <p>You will see by it that the report I have received gave me sufficient ground to
                    apply to you as I have done.</p>
                <p>Please accept, etc.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">E. Dupuy de Lôme.</hi>
                    </signed>
                </closer>


                <xi:include href="d454-a1.xml" xpointer="d454-a1"/>
