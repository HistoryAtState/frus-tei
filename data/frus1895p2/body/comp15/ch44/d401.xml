    <text>
        <body>
            <div xml:id="d401">

                <pb facs="0447" n="1181" sameAs="frus:frus1895p2/pg1181"/>

                <head>
                    <hi rendition="#italic">Mr. Taylor to Mr.
                            Gresham.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1895-04-13"><hi rendition="#italic">April 13, 1895</hi></date>.
                        (Received April 29.)</dateline>
                    <seg rendition="#float-left">No. 336.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to report the receipt of a
                    note from the minister of state touching the <hi rendition="#italic"
                        >Alliança</hi> incident, a copy of which is inclosed herein, with
                    translation. I deemed it proper to transmit to you the substantial part of the
                    note by telegraph.</p>
                <p>I am, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hannis Taylor.</hi>
                    </signed>
                </closer>


                <xi:include href="d401-a1.xml" xpointer="d401-a1"/>
            </div>
