    <text>
        <body>
            <div xml:id="d396">

                <pb facs="0445" n="1179" sameAs="frus:frus1895p2/pg1179"/>

                <head>
                    <hi rendition="#italic">Mr. Muruaga to Mr.
                            Uhl.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of Spain</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-03-19"><hi rendition="#italic">March 19,
                        1895</hi></date>.</dateline></opener>
                <p>The Spanish minister presents his compliments to the Hon. E. F. Uhl, Acting
                    Secretary of State, and has the honor to forward herewith the official report
                    wired by the Captain-General of Cuba, referring to the alleged firing on the <hi
                        rendition="#italic">Alliança.</hi></p>


                <xi:include href="d396-a1.xml" xpointer="d396-a1"/>
