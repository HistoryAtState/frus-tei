    <text>
        <body>
            <div xml:id="d409">

                <pb facs="0451" n="1185" sameAs="frus:frus1895p2/pg1185"/>

                <head>
                    <hi rendition="#italic">Mr. Taylor to Mr. Olney.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Legation</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1895-06-24"><hi rendition="#italic">June 24, 1895</hi></date>.
                        (Received July 6.)</dateline>
                    <seg rendition="#float-left">No. 378.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to report, in reply to
                    your No. 338, of the 5th instant, touching the <hi rendition="#italic"
                        >Alliança</hi> incident, that I have duly communicated your acceptance of
                    the explanation made by the minister of state, as nearly as possible in your own
                    language.</p>
                <p>I am, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hannis Taylor.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
