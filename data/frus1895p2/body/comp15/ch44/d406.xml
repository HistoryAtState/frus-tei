    <text>
        <body>
            <div xml:id="d406">

                <pb facs="0450" n="1184" xml:id="pg1184"/>

                <head>
                    <hi rendition="#italic">Mr. Uhl to Mr. Taylor.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-05-18"><hi rendition="#italic">May 18,
                        1895</hi></date>.</dateline></opener>
                <p>Postpone formal acknowledgment of Spain’s last reply in <hi rendition="#italic"
                        >Alliança</hi> affair until instructed by the Department after
                    examination.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Uhl</hi>, <hi rendition="#italic"
                            >Acting.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
