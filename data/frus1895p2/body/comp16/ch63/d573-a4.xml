    <text>
        <body>
            <div xml:id="d573-a4">

                <pb facs="0573" n="1307" sameAs="frus:frus1895p2/pg1307"/>

                <opener><seg rendition="#center">[Inclosure 4 in No. 630.—Telegram.]</seg></opener>
                <head>
                    <hi rendition="#italic">Mr. Terrell to Mr.
                            Poche.</hi>
                </head>
                <opener><dateline rendition="#float-right"><date calendar="gregorian"
                            when="1895-09-24"><hi rendition="#small-caps">September</hi> 24,
                            1895</date>.</dateline></opener>
                <p>Porte has sent instructions vali demanding again inspection passport and
                    permission to have an interview with Guedjian.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Terrell.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
