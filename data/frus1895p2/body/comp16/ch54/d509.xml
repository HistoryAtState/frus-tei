    <text>
        <body>
            <div xml:id="d509">

                <pb facs="0511" n="1245" sameAs="frus:frus1895p2/pg1245"/>

                <head>
                    <hi rendition="#italic">Mr. Uhl to Mr. Terrell.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-05-18"><hi rendition="#italic">May 18,
                        1895</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 476.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In connection with previous correspondence
                    upon the subject, I herewith inclose for your information a copy of a letter
                    from the Secretary of the Navy of the 15th instant, covering a report from the
                    commander in chief of the United States naval force on the European station,
                    touching the recent visit of the United States ships <hi rendition="#italic">San
                        Francisco</hi> and <hi rendition="#italic">Marblehead</hi> to Turkish
                    waters.</p>
                <p>I am, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">Edwin F. Uhl</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed>
                </closer>






