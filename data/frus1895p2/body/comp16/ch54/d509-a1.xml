    <text>
        <body>
            <div xml:id="d509-a1">

                <pb facs="0511" n="1245" sameAs="frus:frus1895p2/pg1245"/>

                <opener><seg rendition="#center">[Inclosure in No. 476.]</seg></opener>
                <head>
                    <hi rendition="#italic">Mr. Herbert to Mr. Gresham.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Navy Department</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-05-15"><hi rendition="#italic">May 15, 1895</hi></date>.
                        (Received May 16.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith
                    copies of communications from the commander in chief of the United States naval
                    force on the European station, dated April 17, 21, and 30, 1895, in regard to
                    visits of the United States ships <hi rendition="#italic">San Francisco</hi> and
                        <hi rendition="#italic">Marblehead</hi> to certain ports in the Levant for
                    the purpose of ascertaining the grounds existing for the circulation of reports
                    regarding the massacre of Christians in that portion of Asia Minor.</p>
                <p>Very respectfully, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">H. A. Herbert.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
