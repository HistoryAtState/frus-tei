    <text>
        <body>
            <div xml:id="d502">

                <pb facs="0508" n="1242" sameAs="frus:frus1895p2/pg1242"/>

                <head>
                    <hi rendition="#italic">Mr. Uhl to Mr. Terrell.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-04-08"><hi rendition="#italic">April 8,
                        1895</hi></date>.</dateline></opener>
                <p>The United States vessels <hi rendition="#italic">San Francisco</hi> and <hi
                        rendition="#italic">Marblehead</hi> ordered to visit Beirut, Smyrna, and
                    other points, with proper instructions to commanders.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Uhl</hi>,<lb/><hi rendition="#italic"
                            >Acting.</hi></signed>
                </closer>
            </div>
        </body>
