    <text>
        <body>
            <div xml:id="d489">

                <pb facs="0502" n="1236" sameAs="frus:frus1895p2/pg1236"/>

                <head>
                    <hi rendition="#italic">Mr. Gresham to Mr.
                            Terrell.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-04-02"><hi rendition="#italic">April 2,
                        1895</hi></date>.</dateline></opener>
                <p>Your 461<anchor n="2" xml:id="d489-f1"/> received. Instruction last August
                    authorized you to demand irade for Marsovan College, and you are now instructed
                    to demand such authority and inform Turkish Government President will regard
                    further delay in fulfillment of its promise as unfriendly.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Gresham.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
