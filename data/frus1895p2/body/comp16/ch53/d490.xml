    <text>
        <body>
            <div xml:id="d490">

                <pb facs="0502" n="1236" sameAs="frus:frus1895p2/pg1236"/>

                <head>
                    <hi rendition="#italic">Mr. Terrell to Mr. Gresham.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1895-04-04"><hi rendition="#italic">April 4,
                        1895</hi></date>.</dateline></opener>
                <p>Irade for Marsovan demanded; expect answer in a fortnight.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Terrell.</hi>
                    </signed>
                </closer>
            </div>
        </body>
