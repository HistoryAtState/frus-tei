    <text>
        <body>
            <div xml:id="d479">

                <pb facs="0498" n="1232" sameAs="frus:frus1895p2/pg1232"/>

                <head><hi rendition="#italic">Mr. Uhl to Mr. Terrell</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1894-12-29"><hi rendition="#italic">December 29,
                        1894</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 296.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith, for report and such
                    action as may be proper, copy of a letter<anchor n="1" xml:id="d479-f1"/> from
                    the foreign secretary of the American Board of Commissioners for Foreign
                    Missions requesting your aid to secure an Imperial firman for the American
                    College for Girls at Constantinople.</p>
                <p>I am, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">Edwin F. Uhl</hi>, <hi rendition="#italic"
                            >Acting Secretary.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
