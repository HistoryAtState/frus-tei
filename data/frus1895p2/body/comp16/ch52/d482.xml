    <text>
        <body>
            <div xml:id="d482">

                <pb facs="0499" n="1233" sameAs="frus:frus1895p2/pg1233"/>

                <head>
                    <hi rendition="#italic">Mr. Terrell to Mr. Gresham.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States.</hi><lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1895-04-27"><hi rendition="#italic">April 27, 1895</hi></date>.
                        (Received May 13.)</dateline>
                    <seg rendition="#float-left">No. 526.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith the
                    copy of a resolution of thanks passed by the faculty of the American College for
                    Girls in Constantinople on the 5th instant.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">A. W. Terrell.</hi>
                    </signed>
                </closer>


                <xi:include href="d482-a1.xml" xpointer="d482-a1"/>
