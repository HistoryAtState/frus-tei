    <text>
        <body>
            <div xml:id="d481">

                <pb facs="0498" n="1232" sameAs="frus:frus1895p2/pg1232"/>

                <head>
                    <hi rendition="#italic">Mr. Uhl to Mr.
                            Terrell.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-01-22"><hi rendition="#italic">January 22,
                        1895</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 319.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to the Department’s No. 296, of
                    the 29th ultimo, I inclose herewith copy of a letter from the Rev. Judson Smith,
                    foreign secretary of the American Board of Commissioners for Foreign Missions,
                    expressing his gratification at the successful result of your efforts to secure
                    an irade for the American College for Girls at Constantinople.</p>
                <p>I am, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">Edwin F. Uhl</hi>, <hi rendition="#italic"
                            >Acting Secretary.</hi></signed>
                </closer>



                <xi:include href="d481-a1.xml" xpointer="d481-a1"/>
            </div>
