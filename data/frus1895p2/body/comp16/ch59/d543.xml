    <text>
        <body>
            <div xml:id="d543">

                <pb facs="0549" n="1283" sameAs="frus:frus1895p2/pg1283"/>

                <head>
                    <hi rendition="#italic">Mr. Terrell to Mr. Olney.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Pera</hi></placeName>, <date calendar="gregorian" when="1895-09-19"
                                ><hi rendition="#italic">September 19,
                    1895</hi></date>.</dateline></opener>
                <p>Have secured imprisonment of 11 Mohammedan rioters at Christie’s house in Tarsus.
                    No further trouble there apprehended by me.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Terrell.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
