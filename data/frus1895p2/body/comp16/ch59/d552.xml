    <text>
        <body>
            <div xml:id="d552">

                <pb facs="0556" n="1290" sameAs="frus:frus1895p2/pg1290"/>

                <head>
                    <hi rendition="#italic">Mr. Olney to Mr.
                            Terrell.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-12-04"><hi rendition="#italic">December 4,
                        1895</hi>.</date></dateline>
                    <seg rendition="#float-left">No. 698.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose for the completion of your files
                    copy of a letter from the Secretary of the Navy, transmitting one from the
                    commanding officer of the U. S. S. <hi rendition="#italic">Marblehead</hi>,
                    reporting further particulars concerning the attack on Dr. Christie and the
                    conviction of the offenders.</p>
                <p>I am, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Richard Olney.</hi>
                    </signed>
                </closer>





