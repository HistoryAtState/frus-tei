    <text>
        <body>
            <div xml:id="d594">

                <pb facs="0589" n="1323" sameAs="frus:frus1895p2/pg1323"/>

                <head>
                    <hi rendition="#italic">Mr. Olney to Mr.
                            Terrell.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-10-09"><hi rendition="#italic">October 9,
                        1895</hi></date>.</dateline></opener>
                <p>* * * What advice, if any, is given to British missionaries, or missionaries of
                    other nations, as to leaving their posts?</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Olney.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
