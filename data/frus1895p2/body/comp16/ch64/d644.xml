    <text>
        <body>
            <div xml:id="d644">

                <pb facs="0615" n="1349" sameAs="frus:frus1895p2/pg1349"/>

                <head>
                    <hi rendition="#italic">Mr. Olney to Mr.
                            Terrell.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-11-25"><hi rendition="#italic">November 25,
                        1895</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 677.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith for your information and
                    flies a copy of a letter from the foreign secretary of the American Board of
                    Commissioners for Foreign Missions, dated Boston, the 19th instant, and of my
                    reply of the 21st concerning the massacre and destruction of mission property at
                    Harpoot.</p>
                <p>I am, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Richard Olney.</hi>
                    </signed>
                </closer>



                <xi:include href="d644-a1.xml" xpointer="d644-a1"/>
