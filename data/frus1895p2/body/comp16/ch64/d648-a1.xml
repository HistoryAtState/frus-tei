    <text>
        <body>
            <div xml:id="d648-a1">

                <pb facs="0618" n="1352" sameAs="frus:frus1895p2/pg1352"/>

                <opener><seg rendition="#center">[Inclosure in No. 684.]</seg></opener>
                <head>
                    <hi rendition="#italic">Mr. Herbert to Mr. Olney.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Navy Department</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-11-25"><hi rendition="#italic">November 25,
                        1895</hi>.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith for
                    your information a copy of a letter from Rear-Admiral Thomas O. Selfridge,
                    commanding United States naval force on European station, dated the 13th
                    instant, forwarding copies of reports on the situation in Asia Minor made by the
                    commanding officer of the U. S. S. <hi rendition="#italic">Marblehead</hi>.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">H. A. Herbert</hi>, <hi rendition="#italic"
                            >Secretary.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
