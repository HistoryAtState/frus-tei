    <text>
        <body>
            <div xml:id="d641">

                <pb facs="0614" n="1348" sameAs="frus:frus1895p2/pg1348"/>

                <head>
                    <hi rendition="#italic">Mr. Terrell to Mr.
                            Olney.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Pera</hi></placeName>, <date calendar="gregorian" when="1895-11-23"
                                ><hi rendition="#italic">November 23,
                    1895</hi></date>.</dateline></opener>
                <p>Referring telegram 15, officially assured of protection of three ladies at
                    Hadjin. Quiet in provinces for last three days. Outlook better.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Terrell.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
