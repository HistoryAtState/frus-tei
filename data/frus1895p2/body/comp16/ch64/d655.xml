    <text>
        <body>
            <div xml:id="d655">

                <pb facs="0626" n="1360" sameAs="frus:frus1895p2/pg1360"/>

                <head>
                    <hi rendition="#italic">Mr. Olney to Mavroyeni Bey.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-12-03"><hi rendition="#italic">December 3,
                        1895</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 55.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of the 2d instant, in which you cite a telegram from your
                    Government stating that the American missionaries in Turkey are receiving proper
                    protection.</p>
                <p>Accept, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Richard Olney.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
