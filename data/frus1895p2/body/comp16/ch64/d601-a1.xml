    <text>
        <body>
            <div xml:id="d601-a1">

                <pb facs="0591" n="1325" sameAs="frus:frus1895p2/pg1325"/>

                <opener><seg rendition="#center">[Inclosure in No. 650.]</seg></opener>
                <head>
                    <hi rendition="#italic">Mr. Terrell to
                            Said Pasha.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Legation</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1895-10-21"><hi rendition="#italic">October 21,
                        1895</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 90.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inform your excellency
                    that I learn from a reliable source that a disturbance has taken place at
                    Hendek, in the district of Adabazar. As there are three American ladies residing
                    in the town of Adabazar, in the same district, I request that your excellency
                    will send telegraphic orders at once to the competent authorities in order to
                    insure the safety of these ladies.</p>
                <p>Receive, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">A. W. Terrell.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
