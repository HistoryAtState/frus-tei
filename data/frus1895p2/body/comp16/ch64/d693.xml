    <text>
        <body>
            <div xml:id="d693">

                <pb facs="0674" n="1408" sameAs="frus:frus1895p2/pg1408"/>

                <head>
                    <hi rendition="#italic">Mr. Terrell to Mr.
                            Olney.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1895-12-19"><hi rendition="#italic">December 19, 1895</hi></date>.
                        (Received Jan. 4, 1896.)</dateline>
                    <seg rendition="#float-left">No. 732.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith for
                    your information copy of a letter received from Mardin, of date of November 25,
                    1895.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">A. W. Terrell.</hi>
                    </signed>
                </closer>


                <xi:include href="d693-a1.xml" xpointer="d693-a1"/>
