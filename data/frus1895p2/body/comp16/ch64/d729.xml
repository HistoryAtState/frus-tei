    <text>
        <body>
            <div xml:id="d729">

                <pb facs="0725" n="1459" xml:id="pg1459"/>

                <head>
                    <hi rendition="#italic">Mr. Herbert to Mr. Olney.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Navy Department</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1896-01-14"><hi rendition="#italic">January 14,
                        1896</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of the Department of State’s communication of the 2d instant, and to advise you
                    that a copy thereof has been transmitted to the commander-in-chief of the United
                    States naval force on the European station for his guidance.</p>
                <p>I am, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">H. A. Herbert</hi>,<lb/><hi
                            rendition="#italic">Secretary.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
