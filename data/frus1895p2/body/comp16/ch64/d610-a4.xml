                <pb facs="0599" n="1333" sameAs="frus:frus1895p2/pg1333"/>

                <opener><seg rendition="#center">[Inclosure 4 in No. 659.—Telegram.]</seg></opener>
                <head>
                    <hi rendition="#italic">Mr. Terrell to missionaries.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1895-10-31"><hi rendition="#italic">October 31,
                        1895</hi></date>.</dateline></opener>
                <p>Have demanded protection. Decide for yourselves about remaining.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Terrell.</hi>
                    </signed>
                </closer>
            </div>
        </body>
