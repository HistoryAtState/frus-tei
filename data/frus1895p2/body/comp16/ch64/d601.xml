    <text>
        <body>
            <div xml:id="d601">

                <pb facs="0591" n="1325" sameAs="frus:frus1895p2/pg1325"/>

                <head>
                    <hi rendition="#italic">Mr. Terrell to Mr.
                            Olney.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1895-10-22"><hi rendition="#italic">October 22, 1895</hi></date>.
                        (Received Nov. 7.)</dateline>
                    <seg rendition="#float-left">No. 650.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose copy of my note
                    sent last night to the minister of foreign affairs requesting prompt orders for
                    the security of three American missionary ladies at Adabazar. I learned
                    yesterday of their danger on account of a disturbance among the Moslems at
                    Hendek, which is near Adabazar.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">A. W. Terrell.</hi>
                    </signed>
                </closer>


                <xi:include href="d601-a1.xml" xpointer="d601-a1"/>
