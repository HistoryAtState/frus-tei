    <text>
        <body>
            <div xml:id="d623">

                <pb facs="0605" n="1339" sameAs="frus:frus1895p2/pg1339"/>

                <head>
                    <hi rendition="#italic">Mr. Terrell to Mr.
                            Olney.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Pera</hi></placeName>, <date calendar="gregorian" when="1895-11-13"
                                ><hi rendition="#italic">November 13,
                    1895</hi></date>.</dateline></opener>
                <p>There has been a great massacre at Sivas. Order partially restored to-day.
                    Foreigners carefully guarded.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Terrell.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
