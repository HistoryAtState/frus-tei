    <text>
        <body>
            <div xml:id="d687">

                <pb facs="0669" n="1403" sameAs="frus:frus1895p2/pg1403"/>

                <head>
                    <hi rendition="#italic">Mr. Terrell to Mr.
                            Olney.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1895-12-17"><hi rendition="#italic">December 17, 1895</hi></date>.
                        (Received Jan. 4, 1896.)</dateline>
                    <seg rendition="#float-left">No. 728.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose for your
                    information the translation of the only note from the Sublime Porte ever written
                    in response to my repeated demands for the protection of Americans.</p>
                <p>Telegraphic orders were usually directed in my presence, after the verbal demand
                    with which my notes were accompanied.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">A. W. Terrell.</hi>
                    </signed>
                </closer>


                <xi:include href="d687-a1.xml" xpointer="d687-a1"/>
