    <text>
        <body>
            <div xml:id="d730">

                <pb facs="0725" n="1459" sameAs="frus:frus1895p2/pg1459"/>

                <head>
                    <hi rendition="#italic">Mr. Olney to Mr.
                            Terrell.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1896-01-15"><hi rendition="#italic">January 15,
                        1896</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 790.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    No. 740, of the 29th ultimo, reporting apprehensions of further disorders at
                    Marsovan, Marash, and Sivas, and to approve your urgent representations at the
                    palace.</p>
                <p>I am, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Richard Olney.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
