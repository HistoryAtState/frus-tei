    <text>
        <body>
            <div xml:id="d630">

                <pb facs="0607" n="1341" sameAs="frus:frus1895p2/pg1341"/>

                <head>
                    <hi rendition="#italic">Mavroyeni Bey to Mr.
                            Olney.</hi>
                </head>
                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Imperial Legation of Turkey</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-11-17"><hi rendition="#italic">November 17,
                        1895</hi></date>.</dateline></opener>
                <p>Mr. <hi rendition="#small-caps">Secretary of State</hi>: I hasten to send to your
                    excellency the following copy of a telegram which I have received this very
                    instant from the Sublime Porte.</p>
                <quote rend="blockquote">
                    <p>Security missionaries completely assured. Please deny contrary
                        publications.</p>
                </quote>
                <p>Be pleased to accept, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Mavroyeni.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
