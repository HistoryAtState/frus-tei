    <text>
        <body>
            <div xml:id="d605">

                <pb facs="0596" n="1330" xml:id="pg1330"/>

                <head>
                    <hi rendition="#italic">Mr. Terrell to Mr. Olney.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1895-10-29"><hi rendition="#italic">October 29, 1895</hi></date>.
                        (Received Nov. 18.)</dateline>
                    <seg rendition="#float-left">No. 655.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose for your
                    information extracts from two letters just received, which show increased
                    apprehension and disturbances in the interior of Asiatic Turkey.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">A. W. Terrell.</hi>
                    </signed>
                </closer>



                <xi:include href="d605-a1.xml" xpointer="d605-a1"/>
