    <text>
        <body>
            <div xml:id="d694">

                <pb facs="0676" n="1410" sameAs="frus:frus1895p2/pg1410"/>

                <head>
                    <hi rendition="#italic">Mr. Terrell to Mr. Olney.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1895-12-19"><hi rendition="#italic">December 19, 1895</hi></date>.
                        (Received Jan. 13, 1896.)</dateline>
                    <seg rendition="#float-left">No. 733.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith copy
                    of a letter from Rev. Theo. A. Baldwin, dated Brusa, December 16, which
                    indicates that but little apprehension exists among missionaries there.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">A. W. Terrell.</hi>
                    </signed>
                </closer>


                <xi:include href="d694-a1.xml" xpointer="d694-a1"/>
