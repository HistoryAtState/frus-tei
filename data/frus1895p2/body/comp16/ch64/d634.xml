    <text>
        <body>
            <div xml:id="d634">

                <pb facs="0609" n="1343" sameAs="frus:frus1895p2/pg1343"/>

                <head>
                    <hi rendition="#italic">Mr. Olney to Mr.
                            Terrell.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-11-19"><hi rendition="#italic">November 19,
                        1895</hi>.</date></dateline>
                    <seg rendition="#float-left">No. 667.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I append on the overleaf a copy of your
                    telegram of the 18th instant, and of mine of the same date, in regard to the
                    destruction of American property at Harpoot.</p>
                <pb facs="0610" n="1344" xml:id="pg1344"/>
                <p>I approve your notification to the Porte that your Government would expect prompt
                    payment for all ascertained damages.</p>
                <p>I am, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Richard Olney.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
