    <text>
        <body>
            <div xml:id="d744">

                <pb facs="0735" n="1469" sameAs="frus:frus1895p2/pg1469"/>

                <head>
                    <hi rendition="#italic">Mr. Terrell to Mr. Olney.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1896-01-29"><hi rendition="#italic">January 29, 1896</hi></date>.
                        (Received Feb. 15.)</dateline>
                    <seg rendition="#float-left">No. 790.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to call your attention to
                    the copy of a letter from Rev. P. McNaughton, dated Manisa, January 22. His
                    views of missionary duty in this crisis, it must be presumed, have reference to
                    adult people and not to their children, who are equally exposed.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">A. W. Terrell.</hi>
                    </signed>
                </closer>


                <xi:include href="d744-a1.xml" xpointer="d744-a1"/>
            </div>
