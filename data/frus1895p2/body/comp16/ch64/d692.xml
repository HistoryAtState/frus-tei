    <text>
        <body>
            <div xml:id="d692">

                <pb facs="0674" n="1408" xml:id="pg1408"/>

                <head>
                    <hi rendition="#italic">Mr. Terrell to Mr.
                            Olney.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1895-12-19"><hi rendition="#italic">December 19, 1895</hi></date>.
                        (Received Jan. 4.)</dateline>
                    <seg rendition="#float-left">No. 731.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a
                    letter recently received from Rev. C. C. Tracy, president of Marsovan
                    College.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">A. W. Terrell.</hi>
                    </signed>
                </closer>


                <xi:include href="d692-a1.xml" xpointer="d692-a1"/>
