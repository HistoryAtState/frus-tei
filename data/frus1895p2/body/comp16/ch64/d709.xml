    <text>
        <body>
            <div xml:id="d709">

                <pb facs="0704" n="1438" sameAs="frus:frus1895p2/pg1438"/>

                <head>
                    <hi rendition="#italic">Mr. Olney to Mr.
                            Terrell.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-12-30"><hi rendition="#italic">December 30,
                        1895</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 749.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    No. 719, of the 12th instant, and to approve your course in addressing to the
                    minister for foreign affairs your appreciation of the gratifying conduct of the
                    Turkish officers and soldiers in protecting American citizens and their property
                    during the disturbances at Aintab on the 16th ultimo.</p>
                <p>I am, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Richard Olney.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
