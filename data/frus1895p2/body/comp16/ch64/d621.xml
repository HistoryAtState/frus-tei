    <text>
        <body>
            <div xml:id="d621">

                <pb facs="0603" n="1337" sameAs="frus:frus1895p2/pg1337"/>

                <head>
                    <hi rendition="#italic">Mr. Terrell to Mr. Olney.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1895-11-12"><hi rendition="#italic">November 12, 1895</hi></date>.
                        (Received Nov. 27.)</dateline>
                    <seg rendition="#float-left">No. 670.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose copy of a
                    letter from Rev. George P. Knapp, dated October 29, just received, written after
                    massacre there. All that I could do for the security of our people there has
                    been done.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">A. W. Terrell.</hi>
                    </signed>
                </closer>



                <xi:include href="d621-a1.xml" xpointer="d621-a1"/>
            </div>
