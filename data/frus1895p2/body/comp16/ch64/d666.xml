    <text>
        <body>
            <div xml:id="d666">

                <pb facs="0646" n="1380" sameAs="frus:frus1895p2/pg1380"/>

                <head>
                    <hi rendition="#italic">Mr. Terrell to Mr. Olney.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1895-12-05"><hi rendition="#italic">December 5, 1895</hi></date>.
                        (Received Dec. 23.)</dateline>
                    <seg rendition="#float-left">No. 709.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose, for your
                    further information in regard to the burning of American property at Harpoot,
                    the copy of a letter received from Bev. Mr. Barnum, dated the 21st ultimo.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">A. W. Terrell.</hi>
                    </signed>
                </closer>


                <xi:include href="d666-a1.xml" xpointer="d666-a1"/>
            </div>
