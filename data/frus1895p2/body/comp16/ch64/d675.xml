    <text>
        <body>
            <div xml:id="d675">

                <pb facs="0656" n="1390" sameAs="frus:frus1895p2/pg1390"/>

                <head>
                    <hi rendition="#italic">Mr. Terrell to Mr.
                            Olney.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1895-12-12"><hi rendition="#italic">December 12, 1895</hi></date>.
                        (Received Dec. 28.)</dateline>
                    <seg rendition="#float-left">No. 720.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith, for
                    your further information, an account of the massacre which took place last month
                    at Sivas.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">A. W. Terrell.</hi>
                    </signed>
                </closer>



                <xi:include href="d675-a1.xml" xpointer="d675-a1"/>
