    <text>
        <body>
            <div xml:id="d618">

                <pb facs="0602" n="1336" sameAs="frus:frus1895p2/pg1336"/>

                <head>
                    <hi rendition="#italic">Mr. Olney to Mr. Terrell.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-11-11"><hi rendition="#italic">November 11,
                        1895</hi></date>.</dateline></opener>
                <p><hi rendition="#italic">San Francisco</hi> ordered to Alexandretta. Chilton and
                    Hunter report that they are returning to Constantinople. Cable what you have
                    done relative to the issuing of their exequaturs—why they have not been
                    issued.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Olney.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
