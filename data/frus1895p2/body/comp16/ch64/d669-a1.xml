    <text>
        <body>
            <div xml:id="d669-a1">

                <pb facs="0649" n="1383" sameAs="frus:frus1895p2/pg1383"/>

                <opener><seg rendition="#center">[Inclosure 1 in No. 711.]</seg></opener>
                <head>
                    <hi rendition="#italic">Admiral Selfridge to
                        Mr. Terrell.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps">U.
                                S. S. San Francisco</hi>,<lb/><hi rendition="#italic">Marseilles
                                France</hi></placeName>, <date calendar="gregorian"
                            when="1895-11-15"><hi rendition="#italic">November 15,
                        1895</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Considering it very desirable that I should
                    confer with you relating to the disturbances in the East, I have the honor to
                    request that you will procure a firman from the Porte for me to visit
                    Constantinople in the <hi rendition="#italic">Marblehead</hi>, the smallest
                    vessel of our squadron.</p>
                <p>The <hi rendition="#italic">Marblehead</hi> has a displacement of 2,000 tons.</p>
                <p>Very respectfully,</p>
                <closer>
                    <signed><hi rendition="#small-caps">Thos. O. Selfridge</hi>,<lb/><hi
                            rendition="#italic">Rear-Admiral, U. S. N.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
