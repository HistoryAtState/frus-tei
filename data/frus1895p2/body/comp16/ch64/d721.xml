    <text>
        <body>
            <div xml:id="d721">

                <pb facs="0711" n="1445" sameAs="frus:frus1895p2/pg1445"/>

                <head>
                    <hi rendition="#italic">Mr. Terrell to Mr.
                            Olney.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1896-01-06"><hi rendition="#italic">January 6, 1896</hi></date>.
                        (Received Jan. 20.)</dateline>
                    <seg rendition="#float-left">No. 758.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In connection with my No. 703, of December
                    3, I have the honor to transmit herewith for your further information copy of a
                    dispatch <pb facs="0712" n="1446" xml:id="pg1446"/> from the British consul at
                    Erzeroum to the British ambassador, relating to the position of the American
                    missionaries at Bitlis.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">A. W. Terrell.</hi>
                    </signed>
                </closer>


                <xi:include href="d721-a1.xml" xpointer="d721-a1"/>
            </div>
        </body>
    </text>
