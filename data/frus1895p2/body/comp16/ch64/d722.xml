    <text>
        <body>
            <div xml:id="d722">

                <pb facs="0712" n="1446" sameAs="frus:frus1895p2/pg1446"/>

                <head>
                    <hi rendition="#italic">Mr. Terrell to Mr. Olney.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1896-01-06"><hi rendition="#italic">January 6,
                        1896</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 757.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my No. 756, of January 4,
                    which inclosed the copy of a letter from the vali of Aleppo, who denied all
                    connection of the Turks with the burning at Marash, I now inclose the copy of a
                    letter just received from Rev. L. O. Lee, with his estimate of loss. * * *</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">A. W. Terrell.</hi>
                    </signed>
                </closer>



                <xi:include href="d722-a1.xml" xpointer="d722-a1"/>
