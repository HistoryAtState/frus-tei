    <text>
        <body>
            <div xml:id="d685">

                <pb facs="0668" n="1402" sameAs="frus:frus1895p2/pg1402"/>

                <head>
                    <hi rendition="#italic">Mr. Olney to Mr.
                            Terrell.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-12-17"><hi rendition="#italic">December 17,
                        1895</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 721.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have received your No. 695, of the 28th
                    ultimo, in regard to the protection of American missionaries in Turkey, and
                    cordially approve <pb facs="0669" n="1403" xml:id="pg1403"/> your note of
                    November 27 to the minister of foreign affairs on the subject.</p>
                <p>I am, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Richard Olney.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
