    <text>
        <body>
            <div xml:id="d296-a3">

                <pb facs="0351" n="1085" sameAs="frus:frus1895p2/pg1085"/>

                <opener><seg rendition="#center">[Inclosure 2 in No. 74.]</seg></opener>
                <head>
                    <hi rendition="#italic">Mr. Breckinridge to Mr. De Giers.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic">St.
                                Petersburg</hi></placeName>, <date calendar="gregorian"
                            when="1894-12-02"><hi rendition="#italic">December 2/14,
                            1894</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Your Excellency</hi>: A naturalized American citizen
                    named John Ginzberg, having a passport issued by the State Department at
                    Washington, is reported to be under arrest at Loquishin in the government of
                    Minsk, and the intervention of this legation is requested in his behalf.</p>
                <p>I do not know the nature of the charge against this man, and I request your
                    excellency to have the facts and nature of the case reported to me as soon as
                    practicable.</p>
                <p>I avail, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Clifton R. Breckinridge.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
