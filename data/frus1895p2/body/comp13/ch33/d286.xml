    <text>
        <body>
            <div xml:id="d286">

                <pb facs="0340" n="1074" sameAs="frus:frus1895p2/pg1074"/>

                <head>
                    <hi rendition="#italic">Mr. Olney to Mr.
                            Breckinridge.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-12-27"><hi rendition="#italic">December 27,
                        1895</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 156.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have received your No. 181, of the 6th
                    instant, and have to approve your note to Prince Lobanow of that date, in regard
                    to the visé of American passports.</p>
                <p>I am, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Richard Olney.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
