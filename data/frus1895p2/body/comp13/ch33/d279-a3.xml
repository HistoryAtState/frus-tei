    <text>
        <body>
            <div xml:id="d279-a3">

                <pb facs="0327" n="1061" sameAs="frus:frus1895p2/pg1061"/>

                <opener><seg rendition="#center">[Subinclosure 2.]</seg></opener>
                <head>
                    <hi rendition="#italic">Mr. Olarowsky to Mr.
                            Waix.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Imperial Russian Consulate-General</hi>,<lb/><hi
                                rendition="#italic">New York</hi></placeName>, <date
                            calendar="gregorian" when="1895-07-01"><hi rendition="#italic">July 1,
                                1895</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Sir</hi>: I have the honor to acknowledge
                    receipt of your letter of 28th ultimo, and desire to inform you that I can not
                    visé your passport, You must get permission from the ministry of the interior at
                    St. Petersburg to visit Russia before I can visé your passport.</p>
                <p>Herewith passport and postal note.</p>
                <p>Respectfully,</p>
                <closer>
                    <signed><hi rendition="#small-caps">A. E. Olarowsky</hi>,<lb/><hi
                            rendition="#italic">Consul-General.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
