                <head>
                    <hi rendition="#italic">Mr. Breckinridge to Mr.
                            Olney.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >St. Petersburg</hi></placeName>, <date calendar="gregorian"
                            when="1895-09-17"><hi rendition="#italic">September 17,
                        1895</hi></date>.</dateline></opener>
                <p>Missionaries enter Siberia without previous condition.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Breckinridge.</hi>
                    </signed>
                </closer>
            </div>
