    <text>
        <body>
            <div xml:id="d303-a13">

                <pb facs="0368" n="1102" sameAs="frus:frus1895p2/pg1102"/>

                <opener><seg rendition="#center">[Inclosure 12 in No. 151.]</seg></opener>
                <head>
                    <hi rendition="#italic">Mr. Rawicz to Mr. Peirce.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Consulate of the United States</hi>,<lb/><hi rendition="#italic"
                                >Warsaw</hi></placeName>, <date calendar="gregorian"
                            when="1895-10-09"><hi rendition="#italic">October 9,
                        1895</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1542.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Just after mailing my to-day’s
                    correspondence to you in re Yablkowski, I received a telegram from Meszawa:
                    (Translated) “Viséed at Danzig, January 7.” Accordingly I have wired to you:
                    “Yablkowski’s passport viséed Danzig, January 7.”</p>
                <p>I am, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">Joseph Rawicz</hi>,<lb/><hi
                            rendition="#italic">United States Consul.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
