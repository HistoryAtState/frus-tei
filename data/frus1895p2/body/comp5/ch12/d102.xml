    <text>
        <body>
            <div xml:id="d102">

                <pb facs="0186" n="920" sameAs="frus:frus1895p2/pg920"/>

                <head>
                    <hi rendition="#italic">Mr. Pringle to Mr. Olney.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Guatemala</hi></placeName>, <date calendar="gregorian"
                            when="1895-09-26"><hi rendition="#italic">September 26,
                        1895</hi></date>. (Received Oct. 10.)</dateline>
                    <seg rendition="#float-left">No. 220.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit a copy of
                    summary of testimony in the Renton case. I regret that the translation should be
                    so poor, but have not had time to go over it for revision and do not wish to
                    delay sending it.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">D. Lynch Pringle</hi>,<lb/><hi
                            rendition="#italic">Chargé d’Affaires ad interim.</hi></signed>
                </closer>




                <xi:include href="d102-a1.xml" xpointer="d102-a1"/>
                <xi:include href="d102-a2.xml" xpointer="d102-a2"/>
