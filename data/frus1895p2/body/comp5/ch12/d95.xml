                <pb facs="0149" n="883" xml:id="pg883"/>

                <head><hi rendition="#italic">Mr. Pringle to Mr.
                            Uhl</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States,<lb/>Gautemala and
                                Honduras,</hi><lb/><hi rendition="#italic"
                            >Guatemala</hi></placeName>, <date calendar="gregorian"
                            when="1895-06-15"><hi rendition="#italic">June 15, 1895</hi></date>.
                        (Received July 5.)</dateline>
                    <seg rendition="#float-left">No. 187.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I beg leave to inclose copies of documents,
                    with translations, relating to the Renton case, which were received two days
                    ago.</p>
                <p>I am, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">D. Lynch Pringle</hi>,<lb/><hi
                            rendition="#italic">Charge d’Affaires ad interim.</hi></signed>
                </closer>




