    <text>
        <body>
            <div xml:id="d94">

                <pb facs="0148" n="882" sameAs="frus:frus1895p2/pg882"/>

                <head>
                    <hi rendition="#italic">Mr. Young to Mr.
                            Gresham.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Guatemala</hi></placeName>, <date calendar="gregorian"
                            when="1895-05-26"><hi rendition="#italic">May 26,
                        1895</hi></date>.</dateline></opener>
                <p>Have again impressed upon Honduras necessity of vigorous action and speedy report
                    upon Renton case. Have received assurance from that Government that they are
                    prosecuting investigation with utmost diligence and vigor, and hope soon to
                    report satisfactory results. Will embark for United States 29th unless otherwise
                    directed.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Young.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
