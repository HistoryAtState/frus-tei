    <text>
        <body>
            <div xml:id="d99">

                <pb facs="0185" n="919" sameAs="frus:frus1895p2/pg919"/>

                <head>
                    <hi rendition="#italic">Mr. Pringle to Mr. Olney.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States,<lb/>Guatemala and
                                Honduras</hi>,<lb/><hi rendition="#italic"
                            >Guatemala</hi></placeName>, <date calendar="gregorian"
                            when="1895-07-02"><hi rendition="#italic">July 2, 1895</hi></date>.
                        (Received July 18.)</dateline>
                    <seg rendition="#float-left">No. 191.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my No. 189, of June 25, I now
                    inclose copy of telegram, with translation, received from the minister of
                    foreign affairs of Honduras.</p>
                <p>I am, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">D. Lynch Pringle</hi>,<lb/><hi
                            rendition="#italic">Chargé d’Affaires ad interim.</hi></signed>
                </closer>


                <xi:include href="d99-a1.xml" xpointer="d99-a1"/>
