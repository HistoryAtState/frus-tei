    <text>
        <body>
            <div xml:id="d225">

                <pb facs="0299" n="1033" sameAs="frus:frus1895p2/pg1033"/>

                <head>
                    <hi rendition="#italic">Mr. Baker to Mr.
                            Gresham.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Cuesta Mara</hi></placeName> [, <date
                            ana="#date_undated-inferred-from-document-content" calendar="gregorian"
                            type="received-date" when="1895-05-06">undated</date>.] (Received <hi
                            rendition="#italic">May 6, 1895</hi>).</dateline></opener>
                <p>English Nicaraguan differences adjusted. British vessels will leave Corinto May
                    5.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Baker.</hi>
                    </signed>
                </closer>
            </div>
        </body>
