    <text>
        <body>
            <div xml:id="d217">

                <pb facs="0295" n="1029" sameAs="frus:frus1895p2/pg1029"/>

                <head>
                    <hi rendition="#italic">Mr. Baker to Mr. Gresham.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic">San
                                Jose</hi></placeName>, <date calendar="gregorian" when="1895-04-15"
                                ><hi rendition="#italic">April 15, 1895</hi></date>. (Received April
                        25.)</dateline>
                    <seg rendition="#float-left">No. 503.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Herewith I have the honor of inclosing
                    copies and translations of correspondence with the Government of Nicaragua in
                    regard to the demand of Great Britain for the payment of £15,500 by that
                    Republic for the expulsion of various English subjects from Nicaragua charged
                    with complicity in the disturbances at Bluefields in July, 1894.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lewis Baker.</hi>
                    </signed>
                </closer>


                <xi:include href="d217-a1.xml" xpointer="d217-a1"/>
            </div>
