    <text>
        <body>
            <div xml:id="d204">

                <pb facs="0287" n="1021" sameAs="frus:frus1895p2/pg1021"/>

                <head>
                    <hi rendition="#italic">Mr. Gresham to Mr.
                            Planten.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1894-09-18"><hi rendition="#italic">September 18,
                        1894</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of the 14th instant, stating that the duty on salt has been
                    abolished in all the West India islands under the dominion of the Netherlands,
                    and to state that a copy of your communication has been sent to the Secretary of
                    the Treasury for his information and consideration.</p>
                <p>Accept, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. Q. Gresham.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
