    <text>
        <body>
            <div xml:id="d206">

                <pb facs="0287" n="1021" sameAs="frus:frus1895p2/pg1021"/>

                <head>
                    <hi rendition="#italic">Mr. Gresham to Mr. Planten.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1894-09-27"><hi rendition="#italic">September 27,
                        1894</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of the 25th instant, relative to the question as to whether the
                    Dutch colony of Curaçao imposes an import duty on salt, and to inform you that a
                    copy of your communication has been sent to the Secretary of the Treasury for
                    his information and consideration.</p>
                <p>Accept, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. Q. Gresham.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
