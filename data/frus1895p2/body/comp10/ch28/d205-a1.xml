        <body>
            <div xml:id="d205-a1">

                <pb facs="0287" n="1021" sameAs="frus:frus1895p2/pg1021"/>

                <opener><seg rendition="#center">[Inclosure—Translation.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >The Hague</hi></placeName>, <date calendar="gregorian"
                            when="1894-09-24"><hi rendition="#italic">September 24,
                            1894</hi>.</date></dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Tuneless</hi>, <hi
                        rendition="#italic">New York:</hi></p>
                <p>Import duty salt not reestablished by decree December, 1892. See letter.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Roell.</hi>
                    </signed>
                </closer>
            </div>
