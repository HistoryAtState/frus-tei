    <text>
        <body>
            <div xml:id="d207">

                <pb facs="0288" n="1022" xml:id="pg1022"/>

                <head>
                    <hi rendition="#italic">Mr. Planten to Mr. Gresham.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >New York</hi></placeName>, <date calendar="gregorian"
                            when="1894-09-27"><hi rendition="#italic">September 27,
                        1894</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In connection with my letter of September
                    25, last, I have the honor to inclose translation of a letter of the governor of
                    Curaçao in regard to the laws on the importation of salt in the Netherlands West
                    Indian Islands, addressed to me.</p>
                <p>Accept, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">J. E. Planten.</hi>
                    </signed>
                </closer>


                <xi:include href="d207-a1.xml" xpointer="d207-a1"/>
            </div>
        </body>
