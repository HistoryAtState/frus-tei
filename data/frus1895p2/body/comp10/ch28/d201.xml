    <text>
        <body>
            <div xml:id="d201">

                <pb facs="0285" n="1019" sameAs="frus:frus1895p2/pg1019"/>

                <head>
                    <hi rendition="#italic">Mr. Uhl to Mr.
                            Planten.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1894-09-01"><hi rendition="#italic">September 1,
                        1894</hi>.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Replying to yours of the 31st ultimo, I
                    have the honor to inform you that the Secretary of the Treasury has been
                    notified as to your request, that the colonies of Curaçao, Buen Ayre, Oruba, St.
                    Martin, St. Eustatius, and Saba do not impose duties on salt, those duties
                    having been abolished six years ago.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">Edwin F. Uhl</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
