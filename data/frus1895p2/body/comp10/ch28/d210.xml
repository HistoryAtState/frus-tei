    <text>
        <body>
            <div xml:id="d210">

                <pb facs="0289" n="1023" sameAs="frus:frus1895p2/pg1023"/>

                <head>
                    <hi rendition="#italic">Mr. Uhl to Mr. Planten.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1894-10-05"><hi rendition="#italic">October 5,
                        1894</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to previous correspondence
                    relative to the question as to whether a duty is imposed upon salt imported into
                    certain West Indian possessions of the Netherlands, I have the honor to
                    acknowledge the receipt of your note of the 27th ultimo on the subject, and to
                    inform you that a copy of your note has been sent to the Secretary of the
                    Treasury for his information.</p>
                <p>Accept, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">Edwin F. Uhl</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
