    <text>
        <body>
            <div xml:id="d269">

                <pb facs="0319" n="1053" sameAs="frus:frus1895p2/pg1053"/>

                <head>
                    <hi rendition="#italic">Mr. McKenzie to Mr. Olney.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Legation</hi>,<lb/><hi rendition="#italic">Lima,
                                Peru</hi></placeName>, <date calendar="gregorian" when="1895-07-15"
                                ><hi rendition="#italic">July 15, 1895</hi></date>. (Received August
                        31.)</dateline>
                    <seg rendition="#float-left">No. 223.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to Department’s No. 115, of June
                    7, 1895, inclosing a letter of Mr. William Shaud’s, etc., in relation to the
                    claim of the Hydrographic Commission of the Amazon against Peru, etc., I have
                    the honor to notify you that I have this day sent the inclosed communication to
                    the Peruvian foreign office, and will do what I can to secure the payment of
                    this just and long-deferred claim.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">J. A. McKenzie.</hi>
                    </signed>
                </closer>


                <xi:include href="d269-a1.xml" xpointer="d269-a1"/>
