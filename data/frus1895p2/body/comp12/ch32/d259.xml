    <text>
        <body>
            <div xml:id="d259">

                <pb facs="0315" n="1049" sameAs="frus:frus1895p2/pg1049"/>

                <head>
                    <hi rendition="#italic">Mr. Blaine to Mr.
                            Hicks.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1891-11-17"><hi rendition="#italic">November 17,
                        1891</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 182.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have received your No. 318 of the 26th
                    ultimo, reporting the adjournment of the Congress of Peru without taking action
                    upon the claim of the Hydrographic Commission.</p>
                <p>You may express the regret of the Department that payment of this admittedly just
                    obligation of Peru should be so indefinitely postponed.</p>
                <p>I am, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">James G. Blaine.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
