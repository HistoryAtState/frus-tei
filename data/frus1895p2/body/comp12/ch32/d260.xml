    <text>
        <body>
            <div xml:id="d260">

                <pb facs="0315" n="1049" sameAs="frus:frus1895p2/pg1049"/>

                <head>
                    <hi rendition="#italic">Mr. Hicks to Mr. Blaine.</hi>
                </head>
                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Lima, Peru</hi></placeName>, <date calendar="gregorian"
                            when="1892-04-01"><hi rendition="#italic">April 1, 1892</hi></date>.
                        (Received April 22.)</dateline>
                    <seg rendition="#float-left">No. 355.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>:</p>
                <p>* * * * * * * *</p>
                <p>Subsequently I addressed a note to the minister of foreign affairs in regard to
                    the claim known as that of the Hydrographic Commission and I append a copy of
                    the same herewith.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">John Hicks.</hi>
                    </signed>
                </closer>


                <xi:include href="d260-a1.xml" xpointer="d260-a1"/>
            </div>
