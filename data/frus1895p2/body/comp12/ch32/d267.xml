    <text>
        <body>
            <div xml:id="d267">

                <pb facs="0318" n="1052" sameAs="frus:frus1895p2/pg1052"/>

                <head>
                    <hi rendition="#italic">Mr. Wharton to Mr.
                            Hicks.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1892-10-27"><hi rendition="#italic">October 27,
                        1892</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 235.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have been gratified to receive your No.
                    425 of the 16th ultimo, informing me that you are advised by the Peruvian
                    foreign office that the claim of the Hydrographic Commission of the Amazon will
                    be presented to Congress.</p>
                <p>I am, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">William F. Wharton</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
