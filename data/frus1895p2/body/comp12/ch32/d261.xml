    <text>
        <body>
            <div xml:id="d261">

                <pb facs="0316" n="1050" sameAs="frus:frus1895p2/pg1050"/>

                <head>
                    <hi rendition="#italic">Mr. Hicks to Mr. Blaine.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Lima, Peru</hi></placeName>, <date calendar="gregorian"
                            when="1892-04-08"><hi rendition="#italic">April 8, 1892</hi></date>.
                        (Received May 2.)</dateline>
                    <seg rendition="#float-left">No. 357.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my No. 355, of April 1, 1892,
                    I transmit herewith a copy of the reply of Dr. Elmore, the minister of foreign
                    affairs, and a translation of the same.</p>
                <p>I can only add that I have but little confidence that the claim will be settled
                    at present.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">John Hicks.</hi>
                    </signed>
                </closer>


                <xi:include href="d261-a1.xml" xpointer="d261-a1"/>
