    <text>
        <body>
            <div xml:id="d247">

                <pb facs="0310" n="1044" sameAs="frus:frus1895p2/pg1044"/>

                <head>
                    <hi rendition="#italic">Mr. Blaine to Mr. Hicks.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1890-01-15"><hi rendition="#italic">January 15,
                        1890</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 28.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your dispatch No. 56, of December 20, 1889,
                    in relation to the claim of the Hydrographic Commission of the Amazon, has been
                    received.</p>
                <p>The situation has been made known to Mr. Shands, who represents the
                    claimants.</p>
                <p>I am, etc,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">James G. Blaine.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
