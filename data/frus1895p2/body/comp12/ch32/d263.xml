    <text>
        <body>
            <div xml:id="d263">

                <pb facs="0317" n="1051" sameAs="frus:frus1895p2/pg1051"/>

                <head>
                    <hi rendition="#italic">Mr. Neill to Mr.
                            Foster.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Lima, Peru</hi></placeName>, <date calendar="gregorian"
                            when="1892-08-03"><hi rendition="#italic">August 3, 1892</hi></date>.
                        (Received August 31.)</dateline>
                    <seg rendition="#float-left">No. 411.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my No. 407, of July 27, 1892,
                    in relation to the claim of the Hydrographic Commission of the Amazon, I have
                    the honor to transmit for your information a reply to my note (accompanied with
                    a translation) from the Peruvian foreign office.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Richard R. Neill.</hi>
                    </signed>
                </closer>


                <xi:include href="d263-a1.xml" xpointer="d263-a1"/>
