    <text>
        <body>
            <div xml:id="d256">

                <pb facs="0313" n="1047" sameAs="frus:frus1895p2/pg1047"/>

                <head>
                    <hi rendition="#italic">Mr. Neill to Mr.
                            Blaine.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Lima, Peru</hi></placeName>, <date calendar="gregorian"
                            when="1891-08-22"><hi rendition="#italic">August 22, 1891</hi></date>.
                        (Received September 14.)</dateline>
                    <seg rendition="#float-left">No. 293.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit for your
                    information a copy of a note I have addressed to the Peruvian foreign office,
                    accompanied with <pb facs="0314" n="1048" xml:id="pg1048"/> a copy and a
                    translation of Minister Elmore’s reply on the next day, relative to the
                    long-pending claim of the Hydrographic Commission of the Amazon.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Richard R. Neill.</hi>
                    </signed>
                </closer>



                <xi:include href="d256-a1.xml" xpointer="d256-a1"/>
