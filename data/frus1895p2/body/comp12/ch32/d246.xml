    <text>
        <body>
            <div xml:id="d246">

                <pb facs="0310" n="1044" sameAs="frus:frus1895p2/pg1044"/>

                <head>
                    <hi rendition="#italic">Mr. Hicks to Mr. Blaine.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Lima, Peru</hi></placeName>, <date calendar="gregorian"
                            when="1889-12-20"><hi rendition="#italic">December 20, 1889</hi></date>.
                        (Received January 14, 1890.)</dateline>
                    <seg rendition="#float-left">No. 56.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my dispatch, No. 49, of
                    November 14, 1889, regarding the claim of the Hydrographic Commission, I have
                    the honor here with to transmit the reply of the Peruvian foreign office to my
                    note of November 5, and a translation of the same.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">John Hicks.</hi>
                    </signed>
                </closer>


                <xi:include href="d246-a1.xml" xpointer="d246-a1"/>
