    <text>
        <body>
            <div xml:id="d245">

                <pb facs="0310" n="1044" xml:id="pg1044"/>

                <head>
                    <hi rendition="#italic">Mr. Blaine to Mr. Hicks.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1889-12-05"><hi rendition="#italic">December 5,
                        1889</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 22.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have received your No. 49, of the 14th
                    ultimo, in which you inclose copy of your note urging upon the Peruvian
                    Government the payment of the claim of certain American citizens who had served
                    that Government as members of the Hydrographic Commission in the survey of the
                    Amazon and its tributaries.</p>
                <p>Your action is approved.</p>
                <p>I am, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">James G. Blaine.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
