    <text>
        <body>
            <div xml:id="d233">

                <pb facs="0304" n="1038" sameAs="frus:frus1895p2/pg1038"/>

                <head>
                    <hi rendition="#italic">Mr. Seward to Mr.
                            Gibbs.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1878-05-31"><hi rendition="#italic">May 31,
                        1878</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 108.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to your dispatch No. 245, of the
                    27th ultimo, I transmit herewith a copy of a letter<anchor n="1"
                        xml:id="d233-f1"/> addressed to the Hon. Eppa Hunton, Member of Congress, in
                    relation to the Noland claim on Peru.</p>
                <p>I am, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">F. W. Sewärd</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
