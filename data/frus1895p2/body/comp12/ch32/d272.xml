    <text>
        <body>
            <div xml:id="d272">

                <pb facs="0320" n="1054" sameAs="frus:frus1895p2/pg1054"/>

                <head>
                    <hi rendition="#italic">Mr. Olney to Mr. Neill.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-09-26"><hi rendition="#italic">September 26,
                        1895</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 131.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have received your No. 237, of August 29,
                    1895, inclosing copy of your note to the Peruvian foreign office urging that the
                    claim of the <pb facs="0321" n="1055" xml:id="pg1055"/> Hydrographic Commission
                    of the Amazon should be brought before the Peruvian Congress at its present
                    session.</p>
                <p>I am, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Richard Olney.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
