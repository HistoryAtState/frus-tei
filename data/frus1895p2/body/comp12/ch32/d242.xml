    <text>
        <body>
            <div xml:id="d242">

                <pb facs="0308" n="1042" sameAs="frus:frus1895p2/pg1042"/>

                <head>
                    <hi rendition="#italic">Mr. Bayard to Mr. Buck.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1885-10-19"><hi rendition="#italic">October 19,
                        1885</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 30.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to approve the tenor of your note in
                    the matter of the claim of members of the Hydrographic Commission of the River
                    Amazon, a copy of which you forwarded with your No. 31.</p>
                <p>I am, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">T. F. Bayard.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
