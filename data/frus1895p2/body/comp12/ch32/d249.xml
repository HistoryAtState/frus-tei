    <text>
        <body>
            <div xml:id="d249">

                <pb facs="0311" n="1045" sameAs="frus:frus1895p2/pg1045"/>

                <head>
                    <hi rendition="#italic">Mr. Blaine to Mr. Hicks.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1890-03-27"><hi rendition="#italic">March 27,
                        1890</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 43.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have received your No. 91, of the 21st
                    ultimo, relating to the claim of the Hydrographic Commission of the Amazon
                    against the Government of Peru. The claimants have been informed of your action
                    and have been told that you will continue to press their claim.</p>
                <p>I am, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">James G. Blaine.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
