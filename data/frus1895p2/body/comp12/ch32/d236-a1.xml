    <text>
        <body>
            <div xml:id="d236-a1">

                <pb facs="0305" n="1039" sameAs="frus:frus1895p2/pg1039"/>

                <opener><seg rendition="#center">[Inclosure in No. 300.]</seg></opener>
                <head>
                    <hi rendition="#italic">Mr. Yrigoyen to Mr. Gibbs.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Bureau of Foreign Affairs</hi>,<lb/><hi rendition="#italic"
                                >Lima</hi></placeName>, <date calendar="gregorian" when="1879-01-11"
                                ><hi rendition="#italic">January 11, 1879</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 3.]</seg></opener>
                <p><hi rendition="#small-caps">Señor Minister</hi>: With satisfaction I inform your
                    excellency that through the minister of war His Excellency the President has
                    ordered the consignees of guano in the United States to pay the members of the
                    late Hydrographic Commission of the Amazon the sum of $11,447.63 due to them, in
                    equal monthly payments, and the minister of the treasury has given orders for
                    its fulfillment.</p>
                <p>I improve this opportunity to repeat to your excellency the, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">M. Yrigoyen.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
