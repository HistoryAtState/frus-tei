    <text>
        <body>
            <div xml:id="d239">

                <pb facs="0306" n="1040" sameAs="frus:frus1895p2/pg1040"/>

                <head>
                    <hi rendition="#italic">Mr. Christiancy to Mr. Evarts.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Lima, Peru</hi></placeName>, <date calendar="gregorian"
                            when="1879-07-23"><hi rendition="#italic">July 23,
                        1879</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 40.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose copies of my
                    official notes<anchor n="1" xml:id="d239-f1"/> to the minister of foreign
                    affairs of Peru.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">J. P. Christiancy.</hi>
                    </signed>
                </closer>


                <xi:include href="d239-a1.xml" xpointer="d239-a1"/>
            </div>
        </body>
    </text>
