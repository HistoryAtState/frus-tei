    <text>
        <body>
            <div xml:id="d246-a1">

                <pb facs="0310" n="1044" sameAs="frus:frus1895p2/pg1044"/>

                <opener><seg rendition="#center">[Inclosure in No. 56—Translation.]</seg></opener>
                <head>
                    <hi rendition="#italic">Mr. Yrigoyen to Mr. Ricks.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Lima</hi></placeName>, <date calendar="gregorian" when="1889-11-23"
                                ><hi rendition="#italic">November 23, 1889</hi>.</date></dateline>
                    <seg rendition="#float-left">No. 20.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In reply to the attentive note of your
                    excellency of the 5th instant, I have the honor to state that I have asked for
                    the necessary information from the ministry of finance, and that as soon as
                    received it will be transmitted to your excellency.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">M. Yrigoyen.</hi>
                    </signed>
                </closer>
            </div>
        </body>
