    <text>
        <body>
            <div xml:id="d115">

                <pb facs="0207" n="941" sameAs="frus:frus1895p2/pg941"/>

                <head>
                    <hi rendition="#italic">Mr. Uhl to Baron
                            Fava.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-03-16"><hi rendition="#italic">March 16,
                        1895</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Baron</hi>: I hasten to inclose for your
                    information a copy of a telegram which I have this day addressed to his
                    excellency the governor of Colorado, touching the recent occurrences at
                    Walsenburg, in that State.</p>
                <p>Very truly, yours,</p>
                <closer>
                    <signed><hi rendition="#small-caps">Edwin F. Uhl</hi>, <hi rendition="#italic"
                            >Acting Secretary.</hi></signed>
                </closer>


                <xi:include href="d115-a1.xml" xpointer="d115-a1"/>
            </div>
