    <text>
        <body>
            <div xml:id="d124">

                <pb facs="0213" n="947" sameAs="frus:frus1895p2/pg947"/>

                <head>
                    <hi rendition="#italic">Mr. Uhl to Baron
                            Fava.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-04-06"><hi rendition="#italic">April 6,
                        1895</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 11.]</seg></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I have the honor to acknowledge the
                    receipt of your note of the 27th ultimo, in regard to the Walsenburg, Colo.,
                    incident, and to inform you that a copy of your note and of its inclosure has
                    been furnished his excellency the governor of Colorado.</p>
                <p>Accept, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">Edwin F. Uhl</hi>, <hi rendition="#italic"
                            >Acting Secretary.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
