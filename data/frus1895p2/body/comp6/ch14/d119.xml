    <text>
        <body>
            <div xml:id="d119">

                <pb facs="0208" n="942" sameAs="frus:frus1895p2/pg942"/>

                <head>
                    <hi rendition="#italic">Mr. Uhl to Baron
                            Fava.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-03-18"><hi rendition="#italic">March 18,
                        1895</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Baron</hi>: I inclose herewith for your
                    further information in regard to the Colorado incident copy of a telegram
                    received from <pb facs="0209" n="943" xml:id="pg943"/> Governor McIntire, dated
                    the 17th instant, stating that he has issued a proclamation offering a reward of
                    $1,000 for the apprehension and conviction of the guilty parties.</p>
                <p>Very truly, yours,</p>
                <closer>
                    <signed><hi rendition="#small-caps">Edwin F. Uhl</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed>
                </closer>


                <xi:include href="d119-a1.xml" xpointer="d119-a1"/>
            </div>
        </body>
    </text>
