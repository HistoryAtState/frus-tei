    <text>
        <body>
            <div xml:id="d114">

                <pb facs="0206" n="940" sameAs="frus:frus1895p2/pg940"/>

                <head>
                    <hi rendition="#italic">Mr. Uhl to Baron Fava.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-03-15"><hi rendition="#italic">March 15,
                        1895</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Baron</hi>: I herewith inclose a copy of a
                    further telegram from his excellency the governor of Colorado, of the 15th
                    instant, touching the reported killing of Italian subjects at Walsenburg, in
                    that State.</p>
                <p>Very truly, yours,</p>
                <closer>
                    <signed><hi rendition="#small-caps">Edwin F. Uhl</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed>
                </closer>



                <xi:include href="d114-a1.xml" xpointer="d114-a1"/>
            </div>
        </body>
    </text>
