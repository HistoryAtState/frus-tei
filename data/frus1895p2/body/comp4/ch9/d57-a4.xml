    <text>
        <body>
            <div xml:id="d57-a4">

                <pb facs="0116" n="850" sameAs="frus:frus1895p2/pg850"/>

                <opener><seg rendition="#center">[Inclosure 4 in No. 93.]</seg></opener>
                <head>
                    <hi rendition="#italic">Mr. Rives to Mr. Putnam.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1888-01-05"><hi rendition="#italic">January 5,
                        1888</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 71.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In answer to the question propounded in
                    your dispatch No. 133, I have to inform you that citizens of the United States
                    do not lose their nationality by enlisting in foreign armies.</p>
                <p>I am, sir, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">G. L. Rives</hi>,<lb/><hi
                            rendition="#italic">Assistant Secretary.</hi></signed>
                </closer>
            </div>
        </body>
