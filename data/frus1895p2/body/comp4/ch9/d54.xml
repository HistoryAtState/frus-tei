    <text>
        <body>
            <div xml:id="d54">

                <pb facs="0110" n="844" xml:id="pg844"/>

                <head>
                    <hi rendition="#italic">Mr. Peterson to Mr.
                            Uhl.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Commercial Agency of the United States</hi>,<lb/><hi
                                rendition="#italic">Vancouver British Columbia</hi></placeName>,
                            <date calendar="gregorian" when="1895-02-26"><hi rendition="#italic"
                                >Feb. 26, 1895</hi></date>. (Rec’d Mar. 7.)</dateline>
                    <seg rendition="#float-left">No. 12.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Pursuant to telegram sent on the 25th
                    instant by the honorable Secretary of State, and received by me to-day, I have
                    taken, and herewith transmit to the Department, the deposition of J. Cranstoun,
                    and you will find attached to the same an affidavit, marked Exhibit A, of A. B.
                    Z. Dawson.</p>
                <p>I have, etc.,</p>
                <closer>
                    <signed><hi rendition="#small-caps">W. F. Peterson</hi>,<lb/><hi
                            rendition="#italic">Commercial Agent.</hi></signed>
                </closer>



                <xi:include href="d54-a1.xml" xpointer="d54-a1"/>
