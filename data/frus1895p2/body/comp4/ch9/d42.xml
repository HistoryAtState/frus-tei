    <text>
        <body>
            <div xml:id="d42">

                <pb facs="0092" n="826" xml:id="pg826"/>

                <head>
                    <hi rendition="#italic">Mr. Peterson to Mr.
                            Uhl.</hi>
                </head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Vancouver, British Columbia</hi></placeName>,<lb/><date
                            calendar="gregorian" when="1895-02-10"><hi rendition="#italic">February
                                10, 1895</hi></date>.</dateline></opener>
                <p>British steamship <hi rendition="#italic">Warrimoo</hi> arrived to-day, having on
                    board J. Cranstoun, destitute citizen of the United States, banished from
                    Honolulu without trial. Will take and forward deposition.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. F. Peterson.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
