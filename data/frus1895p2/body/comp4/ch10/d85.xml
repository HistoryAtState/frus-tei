    <text>
        <body>
            <div xml:id="d85">

                <pb facs="0141" n="875" sameAs="frus:frus1895p2/pg875"/>

                <head>
                    <hi rendition="#italic">Mr. Olney to Mr. Hatch.</hi>
                </head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-12-11"><hi rendition="#italic">December 11,
                        1895</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to the case of the <hi
                        rendition="#italic">Wahlberg</hi>, about which I had some correspondence
                    with your immediate predecessor, whose letter on the subject was transmitted to
                    the honorable Attorney-General, I have the honor to inclose herewith copy of a
                    letter from the Attorney-General dated December 9, and also copy of the
                    inclosure referred to in said letter, to wit, a copy of a letter of the United
                    States attorney for the southern district of California, dated December 3.</p>
                <p>Accept, etc.,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Richard Olney.</hi>
                    </signed>
                </closer>



                <xi:include href="d85-a1.xml" xpointer="d85-a1"/>
