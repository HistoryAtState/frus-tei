    <text>
        <body>
            <div xml:id="d169-a1">

                <pb facs="0345" n="245" sameAs="frus:frus1884/pg245"/>

                <opener><seg rendition="#center">[Inclosure.]</seg></opener>
                <head><hi rendition="#italic">Mr. Teller to Mr. Frelinghuysen.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of the Interior</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1884-06-02"><hi rendition="#italic">June</hi> 2, 1884.</date>
                        (Received June 3.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to your communication of the 8th
                    ultimo, transmitting a copy of a note from the British minister at this capital
                    in relation to a case of lynching in British <pb facs="0346" n="246"
                        xml:id="pg246"/> Columbia alleged to have been committed by American
                    citizens from Washington Territory, I have the honor to inclose herewith a copy
                    of a report from the governor of Washington Territory relative to the
                    subject.</p>
                <p>Very respectfully, &amp;c.,</p>
                <closer><signed>H. M. TELLER.</signed></closer>
            </div>
        </body>
    </text>
