    <text>
        <body>
            <div xml:id="d166">

                <pb facs="0343" n="243" sameAs="frus:frus1884/pg243"/>

                <head>No. 166.<lb/><hi rendition="#italic">Mr. Frelinghuysen to Mr.
                    West.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1884-05-08"><hi rendition="#italic">May</hi> 8,
                        1884</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Acknowledging the receipt of your note of
                    the 1st instant, in relation to a case of lynching in British Columbia alleged
                    to have been committed by American citizens from Washington Territory, I have
                    the honor to inform you that the matter is receiving the attention of the
                    Government.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>FRED’K T. FRELINGHUYSEN</signed></closer>
            </div>
        </body>
    </text>
