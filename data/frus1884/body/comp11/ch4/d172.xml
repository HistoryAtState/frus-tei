    <text>
        <body>
            <div xml:id="d172">

                <pb facs="0350" n="250" sameAs="frus:frus1884/pg250"/>

                <head>No. 172.<lb/><hi rendition="#italic">Mr. Frelinghuysen to Mr.
                    West.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1884-07-08"><hi rendition="#italic">July</hi> 8,
                        1884</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to my note to you of the
                    21st of May last, in relation to certain ferry privileges granted by the
                    municipal authorities to Mr. James Lockhead, I now have the honor to inclose
                    herewith a copy of, a letter to this Department from Mr. Henry McMorran on the
                    subject.</p>
                <p>In recalling your attention to the subject,</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>FRED’K T, FRELINGHUYSEN.</signed></closer>




                <xi:include href="d172-a1.xml" xpointer="d172-a1"/>
                <xi:include href="d172-a2.xml" xpointer="d172-a2"/>
