        <body>
            <div xml:id="d189">

                <pb facs="0360" n="260" sameAs="frus:frus1884/pg260"/>

                <head>No. 189.<lb/><hi rendition="#italic">Mr. Frelinghuysen to Mr. Schuyler.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1884-03-19"><hi rendition="#italic">March</hi> 19,
                        1884</date>.</dateline>
                    <seg rendition="#float-left">No. 57.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose, for your information, a copy of
                    a letter from the consul-general of Greece at New York, apprising the Department
                    of the removal by Greece of restrictions on the import of American pork.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>FRED’K T. FRELINGHUYSEN.</signed></closer>


                <xi:include href="d189-a1.xml" xpointer="d189-a1"/>
