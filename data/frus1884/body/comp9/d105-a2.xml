                <pb facs="0260" n="160" sameAs="frus:frus1884/pg160"/>

                <opener><seg rendition="#center">[Inclosure 2 in No. 582.—Telegram]</seg></opener>
                <head><hi rendition="#italic">From Messrs. Evarts and Spaulding.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >New York</hi></placeName>, <date calendar="gregorian"
                            when="1884-06-26"><hi rendition="#italic">June</hi> 26,
                        1884</date>.</dateline></opener>
                <p rendition="#flush">Hon. <hi rendition="#small-caps">L. P. Morton</hi>,<lb/><hi
                        rendition="#italic">American Legation, Paris:</hi></p>
                <p>Kindly represent and speak for American Committee Statue Liberty ceremonies, July
                    4. Concrete base completed, 52 feet high. Granite begun.</p>
                <closer><signed>
                        <list>
                            <item>EVARTS.</item>
                            <item>SPAULDING.</item>
                        </list></signed></closer>
            </div>
        </body>
