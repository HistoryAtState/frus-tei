        <body>
            <div xml:id="d305">

                <pb facs="0534" n="434" sameAs="frus:frus1884/pg434"/>

                <head>No. 305.<lb/><hi rendition="#italic">Mr. Phelps to Mr. Frelinghuysen.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Lima, Peru</hi></placeName>, <date calendar="gregorian"
                            when="1884-10-29"><hi rendition="#italic">October</hi> 29, 1884</date>.
                        (Received November 25.)</dateline>
                    <seg rendition="#float-left">No. 165.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Inclosed is a copy and translation of the
                    affidavits of the persons who witnessed the murder of Owen Young.</p>
                <p>The minister of foreign affairs has assured me that the matter will receive
                    prompt attention by the official near the scene of the act.</p>
                <p>I have, &amp;c.</p>
                <closer><signed>S. L. PHELPS.</signed></closer>


                <xi:include href="d305-a1.xml" xpointer="d305-a1"/>
