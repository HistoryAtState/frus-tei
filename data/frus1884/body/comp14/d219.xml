    <text>
        <body>
            <div xml:id="d219">

                <pb facs="0406" n="306" xml:id="pg306"/>

                <head>No. 219.<lb/><hi rendition="#italic">Mr. Frelinghuysen to Mr. Langston.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1884-04-21"><hi rendition="#italic">April</hi> 21,
                        1884</date>.</dateline>
                    <seg rendition="#float-left">No. 272.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I forward herewith a copy of a letter of
                    the 12th instant from Mr. W. K. Yan Bokkelen, of New York&gt; coverings one of
                    the 19th ultimo, wherein Mr. C. A. Van Bokkelen recites the circumstances of his
                    recent arrest and imprisonment at Port au Prince, in regard to which I desire
                    you to furnish the Department with a detailed report.</p>
                <p>I am. &amp;c.,</p>
                <closer><signed>FRED’K T. FRELINGHUYSEN.</signed></closer>



                <xi:include href="d219-a1.xml" xpointer="d219-a1"/>
