    <text>
        <body>
            <div xml:id="d220">

                <pb facs="0407" n="307" sameAs="frus:frus1884/pg307"/>

                <head>No. 220.<lb/><hi rendition="#italic">Mr. Frelinghuysen to Mr.
                    Langston.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1884-07-01"><hi rendition="#italic">July</hi> 1,
                        1884</date>.</dateline>
                    <seg rendition="#float-left">No. 283.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I forward herewith, in connection with
                    previous correspondence, the inclosed copy of a letter from Mr. W. K. Yan
                    Bokkelen of the 27th ultimo, relative to the imprisonment of his son at Port au
                    Prince.</p>
                <p>I am. &amp;c.,</p>
                <closer><signed>FRED’K T. FRELINGHUYSEN.</signed></closer>


                <xi:include href="d220-a1.xml" xpointer="d220-a1"/>
            </div>
