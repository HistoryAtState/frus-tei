    <text>
        <body>
            <div xml:id="d219-a1">

                <pb facs="0406" n="306" sameAs="frus:frus1884/pg306"/>

                <opener><seg rendition="#center">[Inclosure in No. 272.]</seg></opener>
                <head><hi rendition="#italic">Mr. W. K. Van Bokkelen to Mr.
                    Frelinghuysen.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Law Office</hi>, 155 <hi rendition="#small-caps"
                                >Broadway</hi>,<lb/><hi rendition="#italic">New
                            York</hi></placeName>, <date calendar="gregorian" when="1884-04-12"><hi
                                rendition="#italic">April</hi> 12, 1884</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Mr. Secretary</hi>: In forwarding the inclosed I
                    would respectfully inform yon that any information required as to facts can be
                    furnished by me.</p>
                <p>Yours truly,</p>
                <closer><signed>W. K. VAN BOKKELEN,</signed><lb/>Per <signed>W. B.</signed></closer>
            </div>
        </body>
    </text>
