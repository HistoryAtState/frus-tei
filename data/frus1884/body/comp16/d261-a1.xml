    <text>
        <body>
            <div xml:id="d261-a1">

                <pb facs="0478" n="378" sameAs="frus:frus1884/pg378"/>

                <opener><seg rendition="#center">[Inclosure 1 in No. 896.]</seg></opener>
                <head><hi rendition="#italic">Mr. Morgan to Mr.
                            Hoff.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1884-07-19"><hi rendition="#italic">July</hi> 19,
                        1884</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to request that you inform me of the
                    present condition of the case of Howard C. Walker, imprisoned at Minatitlan
                    charged with having stolen wood.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>P. H. MORGAN.</signed></closer>
            </div>
        </body>
