    <text>
        <body>
            <div xml:id="d241">

                <pb facs="0444" n="344" sameAs="frus:frus1884/pg344"/>

                <head>No. 241.<lb/><hi rendition="#italic">Mr. Frelinghuysen to Mr.
                    Morgan.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1883-12-12"><hi rendition="#italic">December</hi> 12,
                        1883</date>.</dateline>
                    <seg rendition="#float-left">No. 477.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit herewith a copy of a letter of
                    the 7th instant from the Hon. John F. Miller, a Senator of the United States
                    from California, relative to the case of George Caleb, also a letter from
                    Captain Caleb to Senator Miller concerning his present condition.</p>
                <p>Inviting your careful attention to this correspondence, and requesting that you
                    will render Captain Caleb every possible assistance,</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>FRED’K T. FRELINGHUYSEN.</signed></closer>




                <xi:include href="d241-a1.xml" xpointer="d241-a1"/>
