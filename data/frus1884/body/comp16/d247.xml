    <text>
        <body>
            <div xml:id="d247">

                <pb facs="0456" n="356" sameAs="frus:frus1884/pg356"/>

                <head>No. 246.<lb/><hi rendition="#italic">Mr. Frelinghuysen to Mr.
                    Morgan.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1884-02-23"><hi rendition="#italic">February</hi> 23,
                        1884</date>.</dateline>
                    <seg rendition="#float-left">No. 511.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit herewith, for your information,
                    the inclosed copy of a letter of the 30th ultimo, addressed by Mr. Frederick R.
                    Maytorena, of La Paz, to Capt. George Caleb, respecting the latter’s
                    imprisonment and the seizure of his vessel by the Mexican authorities at that
                    port.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>FRED’K T. FRELINGHUYSEN.</signed></closer>



                <xi:include href="d247-a1.xml" xpointer="d247-a1"/>
            </div>
        </body>
    </text>
