    <text>
        <body>
            <div xml:id="d350-a1">

                <pb facs="0584" n="484" sameAs="frus:frus1884/pg484"/>

                <opener><seg rendition="#center">[Inclosure in No. 144.]</seg></opener>
                <head>Circular.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Treasury Department</hi>,<lb/><hi rendition="#italic">Washington,
                                D. C.</hi></placeName>, <date calendar="gregorian" when="1884-02-28"
                                ><hi rendition="#italic">February</hi> 28,
                    1884</date>.</dateline></opener>
                <p rendition="#center"><hi rendition="#small-caps">no discriminating duties on
                        importations in spanish vessels from cuba and porto rico.</hi></p>
                <p rendition="#flush"><hi rendition="#italic">To collectors of customs and
                        others:</hi></p>
                <p>The attention of collectors of customs and other officers concerned in the
                    collection of the revenue from customs is invited to the provisions of the
                    following proclamation by the President, whereby goods, wares, and merchandise
                    imported into the United States in Spanish vessels from the islands of Cuba and
                    Porto Rico are relieved from the discriminating duty of 10 per cent, ad valorem
                    heretofore collected under section 2502 Revised Statutes. The collection of such
                    discriminating duties is therefore suspended until otherwise ordered.</p>
                <closer><signed>CHAS. J. FOLGER</signed>,<lb/><hi rendition="#italic"
                        >Secretary.</hi></closer>


                <xi:include href="d350-a1-a1.xml" xpointer="d350-a1-a1"/>
