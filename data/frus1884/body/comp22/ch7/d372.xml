                <pb facs="0606" n="506" sameAs="frus:frus1884/pg506"/>

                <head>No. 372.<lb/><hi rendition="#italic">Mr. Valera to Mr. Frelinghuysen.</hi></head>
                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of Spain</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1884-04-12"><hi rendition="#italic">April</hi> 12,
                        1884</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Highly esteemed Sir and Dear Friend</hi>: I tender to
                    you my sin-merest thanks for the prompt and effective orders you gave for the
                    protection of the Spanish consul at Key West, and also for the reassuring news
                    you sent me in your letter of yesterday.</p>
                <p>Believe me, &amp;c.,</p>
                <closer><signed>JUAN VALERA.</signed></closer>
            </div>
        </body>
