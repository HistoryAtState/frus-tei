        <body>
            <div xml:id="d317">

                <pb facs="0551" n="451" sameAs="frus:frus1884/pg451"/>

                <head>No. 317.<lb/><hi rendition="#italic">Mr. Halderman to Mr.
                    Frelinghuysen.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Bangkok, Siam</hi></placeName>, <date calendar="gregorian"
                            when="1883-12-11"><hi rendition="#italic">December</hi> 11, 1883</date>.
                        (Received Feb. 2, 1884.)</dateline>
                    <seg rendition="#float-left">71.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith
                    copies of correspondence with the Foreign Office relating to the Siamese embassy
                    now <hi rendition="#italic">en route</hi> to Washington.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>JOHN A. HALDERMAN.</signed></closer>




                <xi:include href="d317-a1.xml" xpointer="d317-a1"/>
