        <body>
            <div xml:id="d319">

                <pb facs="0553" n="453" sameAs="frus:frus1884/pg453"/>

                <head>No. 319.<lb/><hi rendition="#italic">Mr. Halderman to Mr. Frelinghuysen.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Bangkok, Siam</hi></placeName>, <date calendar="gregorian"
                            when="1884-02-23"><hi rendition="#italic">February</hi> 23, 1884</date>.
                        (Received April 10.)</dateline>
                    <seg rendition="#float-left">No. 84]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith copy
                    of a note addressed by me to His Majesty the King of Siam, asking, at the
                    request of missionaries of the American Presbyterian Church, permission to
                    advance their lines.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>JOHN A. HALDERMAN.</signed></closer>


                <xi:include href="d319-a1.xml" xpointer="d319-a1"/>
