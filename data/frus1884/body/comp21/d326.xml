    <text>
        <body>
            <div xml:id="d326">

                <pb facs="0559" n="459" sameAs="frus:frus1884/pg459"/>

                <head>No. 326.<lb/><hi rendition="#italic">Mr. Halderman to Mr. Frelinghuysen.</hi></head>
                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Bangkok, Siam</hi></placeName>, <date calendar="gregorian"
                            when="1884-08-09"><hi rendition="#italic">August</hi> 9, 1884</date>.
                        (Received Sept. 22.)</dateline>
                    <seg rendition="#float-left">No. 110.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: * * * I transmit herewith a note addressed
                    to the President of the United States, acquainting him of the presentation
                    herein referred to, which, I beg you to read and cause to be delivered.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>JOHN A. HALDERMAN.</signed></closer>


                <xi:include href="d326-a1.xml" xpointer="d326-a1"/>
            </div>
