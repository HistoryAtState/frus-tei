    <text>
        <body>
            <div xml:id="d769">

                <pb facs="1044" n="1030" xml:id="pg1030"/>

                <note rend="inline" type="source">711.9321/9–2044: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in China</hi> (<hi
                            rendition="#italic">Gauss</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Chungking</hi></placeName>, <date
                            calendar="gregorian" when="1944-09-20T06:00:00+07:00">September 20,
                            1944—6 a.m.</date>
                        <lb/> [Received 10:15 a.m.]</dateline>
                </opener>
                <p>1588. We have given draft further study but have no additional comments (your
                    1173, September 5) and propose to present it to Foreign Office week hence,
                    September 26.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Gauss</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
