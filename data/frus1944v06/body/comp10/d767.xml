                <pb facs="1043" n="1029" sameAs="frus:frus1944v06/pg1029"/>

                <note rend="inline" type="source">711.9321/8–2444: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in China</hi>
                        (<hi rendition="#italic">Gauss</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-08-29T12:00:00-04:00">August 29,
                            1944—noon</date>.</dateline>
                </opener>
                <p>1142. Department is giving consideration to points raised in your 1453, August
                    24, 4 p.m. Please defer presentation of draft Consular Convention to Foreign
                    Office.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
