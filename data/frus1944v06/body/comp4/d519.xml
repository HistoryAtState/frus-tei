                <head>
                    <hi rendition="#italic">The Chargé in China</hi> (<hi rendition="#italic"
                        >Atcheson</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Chungking</hi></placeName>, <date
                            calendar="gregorian" when="1944-12-05">December 5,
                        1944</date>.<lb/>[Received 8:41 a.m.]</dateline>
                </opener>
                <p>1954. T. V. Soong appointed<anchor n="89" xml:id="d519-f1"/> concurrently Acting
                    President of Executive Yuan.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Atcheson</hi>
                    </signed>
                </closer>
            </div>
