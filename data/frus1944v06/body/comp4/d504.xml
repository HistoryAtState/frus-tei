    <text>
        <body>
            <div xml:id="d504">

                <pb facs="0714" n="700" sameAs="frus:frus1944v06/pg700"/>

                <note rend="inline" type="source">893.00/1–1049: Telegram</note>
                <head>
                    <hi rendition="#italic">Major General Patrick J. Hurley to President Roosevelt
                        </hi><anchor n="77" xml:id="d504-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Chungking</hi></placeName>,] <date calendar="gregorian"
                            when="1944-11-17">17 November, 1944</date>.</dateline>
                </opener>
                <p>Replying to your Number 121. I am grateful to you for your offer to appoint me
                    Ambassador to China. I accept the appointment with a full realization of its
                    significance in the present critical situation.</p>
                <closer>[<signed>
                        <hi rendition="#small-caps">Hurley</hi>
                    </signed>]</closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d504-f1" n="77" type="source" xml:id="d504-f1-content">
                <p>Transmitted through military channels.</p>
            </note>
