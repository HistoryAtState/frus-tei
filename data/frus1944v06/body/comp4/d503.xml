    <text>
        <body>
            <div xml:id="d503">

                <pb facs="0714" n="700" sameAs="frus:frus1944v06/pg700"/>

                <note rend="inline" type="source">893.00/1–1049: Telegram</note>
                <head>
                    <hi rendition="#italic">President Roosevelt to Major General Patrick J. Hurley
                        </hi><anchor n="77" xml:id="d503-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1944-11-17">November 17, 1944</date>.]</dateline>
                </opener>
                <p>Number 121. If agreeable, would like to appoint you as Ambassador to China. Your
                    intimate knowledge of the situation there, both from the military and diplomatic
                    standpoints, I feel eminently qualifies you for this important post during the
                    present critical times.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Roosevelt</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d503-f1" n="77" type="source" xml:id="d503-f1-content">
                <p>Transmitted through military channels.</p>
            </note>
        </listAnnotation>
    </standOff>
