                <pb facs="0495" n="481" sameAs="frus:frus1944v06/pg481"/>

                <note rend="inline" type="source">893.00/7–2244: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in China</hi> (<hi rendition="#italic"
                        >Gauss</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Chungking</hi></placeName>, <date
                            calendar="gregorian" when="1944-07-22T12:00:00+07:00">July 22,
                            1944—noon</date>.<lb/>[Received July 22—9:53 a.m.]</dateline>
                </opener>
                <p>1273. Rice reports from Sian [that] Yenan press party has divided, Father
                    Shanahan and Chinese newspapermen being en route from Sian to Chungking, other
                    foreign correspondents visiting Northwest Shansi to return via Ninghsia.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Gauss</hi>
                    </signed>
                </closer>
            </div>
        </body>
