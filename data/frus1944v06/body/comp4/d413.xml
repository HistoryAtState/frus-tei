    <text>
        <body>
            <div xml:id="d413">

                <pb facs="0525" n="511" sameAs="frus:frus1944v06/pg511"/>

                <note rend="inline" type="source">893.00/8–2144</note>
                <head>
                    <hi rendition="#italic">The Ambassador in China</hi> (<hi
                            rendition="#italic">Gauss</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 2890</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Chungking</hi></placeName>, <date
                            calendar="gregorian" when="1944-08-21">August 21,
                        1944</date>.<lb/>[Received September 7.]</dateline>
                </opener>
                <p>The Ambassador has the honor to enclose a memorandum prepared by Second Secretary
                    Robert S. Ward containing a statement of the projects and aims of certain
                    members of the Northeastern groups who formerly controlled Manchuria as related
                    by a member of one of those groups to Mr. Ward.</p>


                <xi:include href="d413-a1.xml" xpointer="d413-a1"/>
