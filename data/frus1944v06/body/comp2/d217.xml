    <text>
        <body>
            <div xml:id="d217">

                <pb facs="0246" n="232" sameAs="frus:frus1944v06/pg232"/>

                <note rend="inline" type="source">811.003 Wallace, Henry A./78: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the Soviet Union</hi> (<hi
                        rendition="#italic">Harriman</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Moscow</hi></placeName>, <date
                            calendar="gregorian" when="1944-06-26">June 26,
                        1944</date>.<lb/>[Received June 27—12:51 a.m.]</dateline>
                </opener>
                <p>2283. <hi rendition="#italic">Free Press</hi> for June 25 published a despatch
                    dated London, June 24 regarding joint Wallace–Chiang Kai-shek declaration<anchor
                        n="46" xml:id="d217-f1"/> reading in translation as follows: <quote
                        rend="blockquote">
                        <p>“According to a Reuter’s report from Chungking as a result of the visit
                            of the Vice President of the United States, Wallace, to Chungking a
                            joint declaration has been published in which it is stated that Wallace
                            and Chiang Kai-shek have considered problems of mutual interest and have
                            come to an agreement regarding fundamental principles and purposes. It
                            is emphasized in the declaration that mutual aid in the war against
                            Japan is the basic factor in Chinese-American relations.”</p>
                    </quote>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Harriman</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d217-f1" n="46" xml:id="d217-f1-content">
                <p>Not found in Department files; for text, see press release issued by the Chinese
                    News Service in Chungking, <hi rendition="#italic">New York Times</hi>, June 25,
                    1944, p. 19, col. 1.</p>
            </note>
        </listAnnotation>
    </standOff>
