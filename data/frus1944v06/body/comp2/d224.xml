    <text>
        <body>
            <div xml:id="d224">

                <pb facs="0254" n="240" sameAs="frus:frus1944v06/pg240"/>

                <head>
                    <hi rendition="#italic">Vice President Wallace to President Roosevelt
                        </hi><anchor n="63" xml:id="d224-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-07-10">July 10, 1944</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. President</hi>: I am handing you herewith a
                    report on my trip to the Far East.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>H. A. <hi rendition="#small-caps">Wallace</hi>
                    </signed>
                </closer>


                <xi:include href="d224-a1.xml" xpointer="d224-a1"/>
            </div>
        </body>
    </text>
