    <text>
        <body>
            <div xml:id="d631">

                <pb facs="0872" n="858" sameAs="frus:frus1944v06/pg858"/>

                <note rend="inline" type="source">893.51/7698: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in China</hi>
                        (<hi rendition="#italic">Gauss</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-01-20T20:00:00-04:00">January 20, 1944—8
                            p.m.</date>
                    </dateline>
                </opener>
                <p>107. From the Secretary of the Treasury for Adler.</p>
                <list>
                    <label>1.</label>
                    <item>The United States Treasury is prepared to accept the proposal submitted by
                        Dr. Kung (your 1200, July 16, 1943<anchor n="55" xml:id="d631-f1"/>)
                        concerning remittances to Occupied China.</item>
                    <pb facs="0873" n="859" xml:id="pg859"/>
                    <label>2.</label>
                    <item>If you perceive no objection to the adoption of Dr. Kung’s proposal, you
                        may inform him that his proposal is accepted by the United States Treasury.
                        [Morgenthau.]</item>
                </list>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
