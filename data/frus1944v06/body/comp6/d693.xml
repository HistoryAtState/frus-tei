            <div xml:id="d693">

                <pb facs="0954" n="940" sameAs="frus:frus1944v06/pg940"/>

                <note rend="inline" type="source">102.1/10–1044: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in China</hi>
                        (<hi rendition="#italic">Gauss</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-10-10T17:00:00-04:00">October 10, 1944—5
                            p.m.</date>
                    </dateline>
                </opener>
                <p>1316. For Friedman from Treasury.</p>
                <list>
                    <label>1.</label>
                    <item>Treasury would appreciate (reference your 1383, August 10, 1944<anchor
                            n="16" xml:id="d693-f1"/>) <list>
                            <label>(<hi rendition="#italic">a</hi>)</label>
                            <item>Details on any recent criticisms of the Central Bank’s gold
                                selling policy in the press and at the last People’s Political
                                Council meeting.</item>
                            <label>(<hi rendition="#italic">b</hi>)</label>
                            <item>Details on the spread between forward and spot and who
                                specifically benefitted from it.</item>
                        </list>
                    </item>
                    <label>2.</label>
                    <item>A speedy reply is desired. [Morgenthau.]</item>
                </list>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
