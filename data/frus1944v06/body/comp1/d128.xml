            <div xml:id="d128">

                <pb facs="0152" n="138" sameAs="frus:frus1944v06/pg138"/>

                <note rend="inline" type="source">103.918/8–344: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in China</hi> (<hi
                            rendition="#italic">Gauss</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Chungking</hi></placeName>, <date
                            calendar="gregorian" when="1944-08-03T16:00:00+07:00">August 3, 1944—4
                            p.m.</date>
                        <lb/> [Received August 3—10:30 a.m.]</dateline>
                </opener>
                <p>1334. I perceive no objection to proposal made in your 1023, July 31, 7 p.m.,
                    regarding IDC.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Gauss</hi>
                    </signed>
                </closer>
            </div>
        </body>
