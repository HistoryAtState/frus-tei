                <pb facs="0921" n="831" sameAs="frus:frus1918Russiav02/pg831"/>

                <note rend="inline" type="source">File No. 811.111/9784g</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Minister in
                        Sweden</hi> (<hi rendition="#italic">Morris</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1918-07-24T16:00:00-04:00"><hi rendition="#italic">July 24, 1918,
                                4 p.m.</hi></date></dateline>
                </opener>
                <p>972. Your 2527.<anchor n="1" xml:id="d996-f1"/> Disregard Department’s former
                    instructions and refuse visa Kull.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Polk</hi></signed>
                </closer>
            </div>
        </body>
    </text>
