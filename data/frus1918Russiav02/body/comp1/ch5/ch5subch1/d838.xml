                <pb facs="0802" n="712" sameAs="frus:frus1918Russiav02/pg712"/>

                <note rend="inline" type="source">File No. 871.51/111</note>
                <head><hi rendition="#italic">The Ambassador in Russia</hi> (<hi rendition="#italic"
                        >Francis</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Petrograd</hi></placeName>, <date calendar="gregorian"
                            when="1918-02-07T19:00:00+02:31"><hi rendition="#italic">February 7,
                                1918, 7 p.m.</hi></date>
                        <lb/> [<hi rendition="#italic">Received February 9, 4.33
                        a.m.</hi>]</dateline>
                </opener>
                <p>2345. British, French colleagues asking whether received reply to my inquiry in
                    my 2323. Shall I direct Consul, Moscow, to join protest?</p>
                <closer>
                    <signed><hi rendition="#small-caps">Francis</hi></signed>
                </closer>
            </div>
