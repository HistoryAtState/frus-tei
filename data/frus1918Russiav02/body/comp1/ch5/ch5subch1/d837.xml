                <pb facs="0802" n="712" sameAs="frus:frus1918Russiav02/pg712"/>

                <note rend="inline" type="source">File No. 763.72/9269</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Rumanian
                        Minister</hi> (<hi rendition="#italic">Angelesco</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1918-02-05"><hi rendition="#italic">February 5,
                        1918</hi></date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your letter of February 2, 1918, and to assure you that this Government does
                    not fail to appreciate the difficult situation created by Rumania’s resistance
                    to the Bolshevik authorities and the consequent declaration of hostility by the
                    Bolshevik government.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed><hi rendition="#small-caps">Frank L. Polk</hi></signed>
                </closer>
            </div>
        </body>
