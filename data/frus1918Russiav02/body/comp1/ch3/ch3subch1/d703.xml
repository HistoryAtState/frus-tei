    <text>
        <body>
            <div xml:id="d703">

                <pb facs="0673" n="583" sameAs="frus:frus1918Russiav02/pg583"/>

                <note rend="inline" type="source">File No. 861.00/719</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Ambassador in France</hi> (<hi
                            rendition="#italic">Sharp</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1917-11-28T16:00:00-05:00"><hi rendition="#italic">November 28,
                                1917, 4 p.m.</hi></date></dateline>
                </opener>
                <p>2870. For Colonel House:</p>
                <p>Department would be glad to have a report from you on the general attitude of
                    your colleagues in the matter of the recognition of the <hi rendition="#italic"
                        >de facto</hi> government of the Trans-Caucasus.</p>
                <closer>
                    <signed><hi rendition="#small-caps"
                            >Lansing</hi></signed>
                </closer>
            </div>
        </body>
