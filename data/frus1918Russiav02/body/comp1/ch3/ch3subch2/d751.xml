    <text>
        <body>
            <div xml:id="d751">

                <pb facs="0721" n="631" xml:id="pg631"/>

                <note rend="inline" type="source">File No. 861.00/1856</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Consul at Moscow</hi> (<hi
                            rendition="#italic">Poole</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1918-05-28T17:00:00-04:00"><hi rendition="#italic">May 28, 1918, 5
                                p.m.</hi></date></dateline>
                </opener>
                <p>52. Your 529, May 17, 3 p.m. Department will be pleased to learn plans for
                    defense of Trans-Caucasus furnished by Smith.</p>
                <closer>
                    <signed><hi rendition="#small-caps"
                            >Lansing</hi></signed>
                </closer>
            </div>
