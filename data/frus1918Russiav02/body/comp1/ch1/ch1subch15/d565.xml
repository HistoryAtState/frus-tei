    <text>
        <body>
            <div xml:id="d565">

                <pb facs="0554" n="464" sameAs="frus:frus1918Russiav02/pg464"/>

                <note rend="inline" type="source">File No. 861.00/3538</note>
                <head><hi rendition="#italic">The Consul General at Irkutsk</hi> (<hi rendition="#italic"
                    >Harris</hi>) <hi rendition="#italic">to the Secretary of State</hi><anchor n="1" xml:id="d565-f1"/></head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Omsk</hi></placeName>, <date calendar="gregorian" when="1918-12-26"
                                ><hi rendition="#italic">December 26, 1918</hi></date>. <lb/> [<hi
                            rendition="#italic">Received December 27, 7 p.m.</hi>]</dateline>
                </opener>
                <p>259. It is officially announced that Perm has been captured by Siberian
                    troops.</p>
                <closer>
                    <signed><hi rendition="#small-caps"
                            >Harris</hi></signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d565-f1" n="1" type="source" xml:id="d565-f1-content">
                <p>Sent via the Legation in China.</p>
            </note>
        </listAnnotation>
