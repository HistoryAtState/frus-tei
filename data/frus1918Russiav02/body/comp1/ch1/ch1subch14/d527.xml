    <text>
        <body>
            <div xml:id="d527">

                <pb facs="0525" n="435" sameAs="frus:frus1918Russiav02/pg435"/>

                <note rend="inline" type="source">File No. 861.00/3242</note>
                <head><hi rendition="#italic">The Consul General at Irkutsk</hi> (<hi
                        rendition="#italic">Harris</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi><anchor n="1" xml:id="d527-f1"/></head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Omsk</hi></placeName>, <date calendar="gregorian" when="1918-11-18"
                                ><hi rendition="#italic">November 18, 1918</hi></date>. <lb/> [<hi
                            rendition="#italic">Received November 19, 2.30 p.m.</hi>]</dateline>
                </opener>
                <p>193. Early this morning three Social Revolutionary members of the all-Russian
                    Directory were arrested by Cossacks supposedly of monarchical tendencies. No
                    bloodshed. Omsk quiet to-day. Siberian soldiers are going front in large
                    numbers.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Harris</hi></signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d527-f1" n="1" type="source" xml:id="d527-f1-content">
                <p>Sent via the Legation in China.</p>
            </note>
        </listAnnotation>
    </standOff>
