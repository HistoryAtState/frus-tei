    <text>
        <body>
            <div xml:id="d533">

                <pb facs="0530" n="440" sameAs="frus:frus1918Russiav02/pg440"/>

                <note rend="inline" type="source">File No. 861.00/3260</note>
                <head><hi rendition="#italic">The Consul General at Irkutsk</hi> (<hi rendition="#italic"
                    >Harris</hi>) <hi rendition="#italic">to the Secretary of State</hi><anchor n="2" xml:id="d533-f1"/></head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Omsk</hi></placeName>, <date calendar="gregorian" when="1918-11-22"
                                ><hi rendition="#italic">November 22, 1918</hi></date>. <lb/> [<hi
                            rendition="#italic">Received November 23, 7.28 a.m.</hi>]</dateline>
                </opener>
                <p>198. Avksentiev and other three Social
                    Revolutionary leaders now released from prison and being sent out of Siberia in
                    direction Irkutsk.</p>
                <closer>
                    <signed><hi rendition="#small-caps"
                            >Harris</hi></signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d533-f1" n="2" type="source" xml:id="d533-f1-content">
                <p>Sent via the Legation In China.</p>
            </note>
        </listAnnotation>
