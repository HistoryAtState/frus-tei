    <text>
        <body>
            <div xml:id="d276">

                <pb facs="0302" n="212" sameAs="frus:frus1918Russiav02/pg212"/>

                <note rend="inline" type="source">File No. 861.00/2199</note>
                <head><hi rendition="#italic">The Consul General at Irkutsk</hi> (<hi rendition="#italic"
                    >Harris</hi>) <hi rendition="#italic">to the Secretary of State</hi><anchor n="1" xml:id="d276-f1"/></head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Irkutsk</hi></placeName>, <date calendar="gregorian"
                            when="1918-06-15"><hi rendition="#italic">June 15, 1918</hi></date>.
                        <lb/> [<hi rendition="#italic">Received July 5, 11.58 a.m.</hi>]</dateline>
                </opener>
                <p>Irkutsk to-day is in the hands of 3,000 armed Austrian and German prisoners
                    commanded by prisoner officers. No Czech trains present Irkutsk.</p>
                <closer>[<signed><hi rendition="#small-caps"
                            >Harris</hi></signed>]</closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d276-f1" n="1" type="source" xml:id="d276-f1-content">
                <p>Sent via the Consulate at Vladivostok (No. 23).</p>
            </note>
        </listAnnotation>
    </standOff>
