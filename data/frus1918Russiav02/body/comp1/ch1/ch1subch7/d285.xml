    <text>
        <body>
            <div xml:id="d285">

                <pb facs="0308" n="218" sameAs="frus:frus1918Russiav02/pg218"/>

                <note rend="inline" type="source">File No. 861.00/1957</note>
                <head><hi rendition="#italic">The Secretary of State to the Consul General at
                        Irkutsk</hi> (<hi rendition="#italic">Harris</hi>)<anchor n="1"
                        xml:id="d285-f1"/></head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1918-06-20T15:00:00-04:00"><hi rendition="#italic">June 20, 1918,
                                3 p.m.</hi></date></dateline>
                </opener>
                <p>Your May 31 much garbled.<anchor n="2" xml:id="d285-f2"/> No plans yet formulated
                    to bring Czecho-Slovaks from Vladivostok.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Lansing</hi></signed>
                </closer>
            </div>
        </body>
    </text>
