    <text>
        <body>
            <div xml:id="d262">

                <pb facs="0291" n="201" sameAs="frus:frus1918Russiav02/pg201"/>

                <note rend="inline" type="source">File No. 861.00/1965</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Ambassador in Russia</hi> (<hi rendition="#italic"
                    >Francis</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1918-06-10T14:00:00-04:00"><hi rendition="#italic">June 10, 1918,
                                2 p.m.</hi></date></dateline>
                </opener>
                <p>170. Your 241, June 3, 7 p.m.<anchor n="1" xml:id="d262-f1"/> Department believes
                    instructions to Consul Moscow to communicate with Soviet should, so far as
                    practicable, be limited to matters affecting American interests.</p>
                <closer>
                    <signed><hi rendition="#small-caps"
                            >Polk</hi></signed>
                </closer>
            </div>
        </body>
    </text>
