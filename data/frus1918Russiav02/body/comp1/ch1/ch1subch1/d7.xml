    <text>
        <body>
            <div xml:id="d7">

                <pb facs="0096" n="6" sameAs="frus:frus1918Russiav02/pg6"/>

                <note rend="inline" type="source">File No. 861.00/804b</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Ambassador in Japan</hi> (<hi
                            rendition="#italic">Morris</hi>)<anchor n="1" xml:id="d7-f1"
                    /></head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1917-12-11T16:00:00-05:00"><hi rendition="#italic">December 11,
                                1917, 4 p.m.</hi></date></dateline>
                </opener>
                <p>It is reported in the press that an announcement has been made by the Japanese
                    Government that Japanese forces are protecting Vladivostok. Please make discreet
                    but extensive inquiry and report by cable.</p>
                <closer>
                    <signed><hi rendition="#small-caps"
                            >Lansing</hi></signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d7-f1" n="1" type="source" xml:id="d7-f1-content">
                <p>The same, on the same date, to the Minister in China.</p>
            </note>
        </listAnnotation>
    </standOff>
