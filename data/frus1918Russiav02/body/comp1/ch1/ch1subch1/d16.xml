    <text>
        <body>
            <div xml:id="d16">

                <pb facs="0099" n="9" sameAs="frus:frus1918Russiav02/pg9"/>

                <note rend="inline" type="source">File No. 861.00/822</note>
                <head><hi rendition="#italic">The Secretary of State to the Minister in China</hi>
                        (<hi rendition="#italic">Reinsch</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1917-12-18T17:00:00-05:00"><hi rendition="#italic">December 18,
                                1917, 5 p.m.</hi></date></dateline>
                </opener>
                <p>Your telegram December 15, 8 p.m. Ambassador and Consuls in Russia advised that
                    President desires all American representatives to withhold direct communication
                    with Bolshevik government.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Lansing</hi></signed>
                </closer>
            </div>
        </body>
