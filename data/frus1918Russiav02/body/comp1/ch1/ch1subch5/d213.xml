    <text>
        <body>
            <div xml:id="d213">

                <pb facs="0252" n="162" sameAs="frus:frus1918Russiav02/pg162"/>

                <note rend="inline" type="source">File No. 861.00/1839</note>
                <head><hi rendition="#italic">The Consul at Moscow</hi> (<hi rendition="#italic">Poole</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Moscow</hi></placeName>, <date calendar="gregorian"
                            when="1918-05-16T17:00:00+02:31"><hi rendition="#italic">May 16, 1918, 5
                                p.m.</hi></date>
                        <lb/> [<hi rendition="#italic">Received May 23, 12.01 p.m.</hi>]</dateline>
                </opener>
                <p>524. Jenkins<anchor n="1" xml:id="d213-f1"
                    /> telegraphs, 14th, advance of Semenov
                    has apparently been checked for the present. He is evidently trying to
                    strengthen his positions. Bolsheviks have been considerably reenforced,
                    principally by prisoners.</p>
                <closer>
                    <signed><hi rendition="#small-caps"
                            >Poole</hi></signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d213-f1" n="1" xml:id="d213-f1-content">
                <p>Douglas Jenkins, Consul at Riga, on detail
                    in Siberia.</p>
            </note>
