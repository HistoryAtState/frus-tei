    <text>
        <body>
            <div xml:id="d519">

                <pb facs="0518" n="428" sameAs="frus:frus1918Russiav02/pg428"/>

                <note rend="inline" type="source">File No. 861.01/17</note>
                <head><hi rendition="#italic">The Russian Ambassador</hi> (<hi rendition="#italic"
                        >Bakhmeteff</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1918-11-11"><hi rendition="#italic">November 11, 1918</hi></date>.
                        <lb/> [<hi rendition="#italic">Received November 12.</hi>]</dateline>
                </opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: Supplementary to my
                    letter of November 9,<anchor n="1" xml:id="d519-f1"/> I have the honor to
                    transmit to you paraphrase of cable received from Omsk, concerning the formation
                    of the all-Russian government.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed><hi rendition="#small-caps">B. Bakhmeteff</hi></signed>
                </closer>



                <xi:include href="d519-a1.xml" xpointer="d519-a1"/>
            </div>
        </body>
    </text>
