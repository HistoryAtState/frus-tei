    <text>
        <body>
            <div xml:id="d494">

                <pb facs="0495" n="405" sameAs="frus:frus1918Russiav02/pg405"/>

                <note rend="inline" type="source">File No. 861.00/2899</note>
                <head><hi rendition="#italic">The Consul at Irkutsk</hi> (<hi rendition="#italic"
                        >Thomson</hi>) <hi rendition="#italic">to the Secretary of State</hi><anchor n="1" xml:id="d494-f1"/></head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Irkutsk</hi></placeName>, <date calendar="gregorian"
                            when="1918-10-06"><hi rendition="#italic">October 6, 1918</hi></date>.
                        <lb/> [<hi rendition="#italic">Received October 7, 10.30
                        p.m.</hi>]</dateline>
                </opener>
                <p>Frantic appeals coming from all Siberian and Czecho-Slovak associations to send
                    at least 100 American soldiers by special train to Ekaterinburg and Chelyabinsk
                    to encourage Slovaks who are losing their morale because expected aid of Allies
                    is not arriving.</p>
                <closer>[<signed><hi rendition="#small-caps"
                                >Thomson</hi></signed>]</closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d494-f1" n="1" type="source" xml:id="d494-f1-content">
                <p>Sent via the Consulate at Vladivostok (No. 188).</p>
            </note>
        </listAnnotation>
    </standOff>
