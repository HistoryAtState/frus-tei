    <text>
        <body>
            <div xml:id="d511">

                <pb facs="0511" n="421" sameAs="frus:frus1918Russiav02/pg421"/>

                <note rend="inline" type="source">File No. 861.00/3147</note>
                <head><hi rendition="#italic">The Russian Ambassador</hi> (<hi rendition="#italic"
                        >Bakhmeteff</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1918-11-02"><hi rendition="#italic">November 2, 1918</hi></date>.
                        <lb/> [<hi rendition="#italic">Received November 4.</hi>]</dateline>
                </opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I have the honor to
                    transmit to you a copy of the original cable received October 31 by the Russian
                    Embassy from Omsk, signed by Mr. Avksentiev and Mr. Vologodski, as well as the English paraphrase of this cable.</p>
                <p>Believe me [etc.]</p>
                <closer>
                    <signed><hi rendition="#small-caps">B.
                                Bakhmeteff</hi></signed>
                </closer>



                <xi:include href="d511-a1.xml" xpointer="d511-a1"/>
            </div>
        </body>
    </text>
