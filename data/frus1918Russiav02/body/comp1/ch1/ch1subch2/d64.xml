    <text>
        <body>
            <div xml:id="d64">

                <pb facs="0134" n="44" sameAs="frus:frus1918Russiav02/pg44"/>

                <note rend="inline" type="source">File No. 811.20293/15a</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Minister in China</hi> (<hi
                            rendition="#italic">Reinsch</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1918-02-09T18:00:00-05:00"><hi rendition="#italic">February 9,
                                1918, 6 p.m.</hi></date></dateline>
                </opener>
                <p>There are conflicting reports received here as to conditions in eastern Siberia.
                    Please have …, if possible, visit various places and report to you.</p>
                <closer>
                    <signed><hi rendition="#small-caps"
                            >Lansing</hi></signed>
                </closer>
            </div>
        </body>
