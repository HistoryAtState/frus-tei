    <text>
        <body>
            <div xml:id="d350">

                <pb facs="0383" n="293" sameAs="frus:frus1918Russiav02/pg293"/>

                <note rend="inline" type="source">File No. 861.00/2634</note>
                <head><hi rendition="#italic">The Consul at Vladivostok</hi> (<hi rendition="#italic"
                        >Caldwell</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 262</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Vladivostok</hi></placeName>, <date calendar="gregorian"
                            when="1918-07-19"><hi rendition="#italic">July 19, 1918</hi></date>.
                        <lb/> [<hi rendition="#italic">Received September 4.</hi>]</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith copy
                    of a letter<anchor n="1" xml:id="d350-f1"/> from the provisional government of
                    autonomous Siberia in which is enclosed a declaration of that government in
                    regard to its establishment and its rights in Siberian territory.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed><hi rendition="#small-caps">John K.
                                Caldwell</hi></signed>
                </closer>


                <xi:include href="d350-a1.xml" xpointer="d350-a1"/>
            </div>
        </body>
    </text>
    <standOff>
