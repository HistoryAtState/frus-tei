    <text>
        <body>
            <div xml:id="d374">

                <pb facs="0407" n="317" sameAs="frus:frus1918Russiav02/pg317"/>

                <note rend="inline" type="source">File No. 861.00/2357</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Chargé in
                        China</hi> (<hi rendition="#italic">MacMurray</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1918-07-30T18:00:00-04:00"><hi rendition="#italic">July 30, 1918,
                                6 p.m.</hi></date></dateline>
                </opener>
                <p>Your cipher telegram of July 27, 5 p.m. Your understanding of your instructions
                    is correct. Department does not desire to modify its attitude.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Polk</hi></signed>
                </closer>
            </div>
        </body>
