    <text>
        <body>
            <div xml:id="d404">

                <pb facs="0427" n="337" sameAs="frus:frus1918Russiav02/pg337"/>

                <note rend="inline" type="source">File No. 861.00/2430</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        Japan</hi> (<hi rendition="#italic">Morris</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1918-08-09T12:00:00-04:00"><hi rendition="#italic">August 9, 1918,
                                noon</hi></date>.</dateline>
                </opener>
                <p>You may officially deny rumor.<anchor n="1" xml:id="d404-f1"/> There is no
                    foundation for it whatsoever.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Polk</hi></signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d404-f1" n="1" xml:id="d404-f1-content">
                <p>See the Ambassador’s telegram, Aug. 7, 6 p.m., <hi rendition="#italic">ante</hi>,
                        <ref target="#pg333">p. 333</ref>.</p>
            </note>
        </listAnnotation>
