    <text>
        <body>
            <div xml:id="d149">

                <pb facs="0198" n="108" sameAs="frus:frus1918Russiav02/pg108"/>

                <note rend="inline" type="source">File No. 861.00/1448</note>
                <head><hi rendition="#italic">The British Ambassador</hi> (<hi rendition="#italic"
                        >Reading</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 371</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1918-04-08"><hi rendition="#italic">April 8,
                        1918</hi></date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I beg to enclose,
                    herewith, paraphrases of the four telegrams relative to the conditions in
                    Siberia and at Vladivostok, which I mentioned to you during our conversation
                    this morning.</p>
                <p>Believe me [etc.]</p>
                <closer>
                    <signed><hi rendition="#small-caps"
                            >Reading</hi></signed>
                </closer>






