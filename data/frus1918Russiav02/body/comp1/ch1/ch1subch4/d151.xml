            <div xml:id="d151">

                <pb facs="0203" n="113" xml:id="pg113"/>

                <note rend="inline" type="source">File No. 861.00/1445</note>
                <head><hi rendition="#italic">The Secretary of State to the Ambassador in
                        Russia</hi> (<hi rendition="#italic">Francis</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1918-04-08T18:00:00-04:00"><hi rendition="#italic">April 8, 1918,
                                6 p.m.</hi></date></dateline>
                </opener>
                <p>53. Your 67, April 4, 4 p.m.<anchor n="1" xml:id="d151-f1"/> Referring
                    Department’s 15, March 20, 7 p.m.<anchor n="2" xml:id="d151-f2"/> Department
                    desires full details Webster’s reports.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Lansing</hi></signed>
                </closer>
            </div>
        </body>
