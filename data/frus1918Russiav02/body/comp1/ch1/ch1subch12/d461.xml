    <text>
        <body>
            <div xml:id="d461">

                <pb facs="0468" n="378" xml:id="pg378"/>

                <note rend="inline" type="source">File No. 861.00/2882</note>
                <head><hi rendition="#italic">The Chinese Minister</hi> (<hi rendition="#italic"
                        >Koo</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1918-09-13"><hi rendition="#italic">September 13,
                        1918</hi></date></dateline>
                </opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I beg to enclose herewith
                    the memorandum which I spoke to you yesterday about for your personal
                    information.</p>
                <p>Very sincerely yours,</p>
                <closer>
                    <signed><hi rendition="#small-caps">V. K. Wellington Koo</hi></signed>
                </closer>


                <xi:include href="d461-a1.xml" xpointer="d461-a1"/>
