    <text>
        <body>
            <div xml:id="d599">

                <pb facs="0585" n="495" sameAs="frus:frus1918Russiav02/pg495"/>

                <note rend="inline" type="source">File No. 861.00/2104</note>
                <head><hi rendition="#italic">The Secretary of State to the Ambassador in
                        Russia</hi> (<hi rendition="#italic">Francis</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1918-07-06T19:00:00-04:00"><hi rendition="#italic">July 6, 1918, 7
                                p.m.</hi></date></dateline>
                </opener>
                <p>212. Your 289, June 20, 10 p.m.<anchor n="2" xml:id="d599-f1"/> Department
                    understands you will make no reply and take no other action regarding request
                    for American ships to leave Russian ports.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Lansing</hi></signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
