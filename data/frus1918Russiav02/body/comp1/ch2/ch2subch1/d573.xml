    <text>
        <body>
            <div xml:id="d573">

                <pb facs="0559" n="469" sameAs="frus:frus1918Russiav02/pg469"/>

                <note rend="inline" type="source">File No. 861.00/1401a</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Ambassador in Russia</hi> (<hi rendition="#italic"
                    >Francis</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1918-03-09T15:00:00-05:00"><hi rendition="#italic">March 9, 1918,
                                3 p.m.</hi></date></dateline>
                </opener>
                <p>2107. Request Norwegian Consul, Petrograd, deliver following message for
                        Robins, head of American Red Cross
                    Commission: <quote rend="blockquote">
                        <p>Please telegraph full statement of conditions at Murmansk as reported by
                                Wardwell when he arrives,
                            covering political situation, accumulation of supplies if any and
                            condition of railroad transportation.</p></quote></p>
                <closer>
                    <signed><hi rendition="#small-caps"
                            >Polk</hi></signed>
                </closer>
            </div>
        </body>
    </text>
