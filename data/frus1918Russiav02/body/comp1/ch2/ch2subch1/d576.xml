            <div xml:id="d576">

                <pb facs="0560" n="470" sameAs="frus:frus1918Russiav02/pg470"/>

                <note rend="inline" type="source">File No. 861.00/1461</note>
                <head><hi rendition="#italic">The First Secretary of the British Embassy</hi>
                        (<hi rendition="#italic">Robertson</hi>)
                        <hi rendition="#italic">to the Counselor for the Department of State</hi>
                        (<hi rendition="#italic"
                        >Polk</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1918-03-14"><hi rendition="#italic">March 14,
                        1918</hi></date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Dear Mr. Polk</hi>: The Ambassador has asked me to send to you the
                    enclosed paraphrase of the telegram which he read to you this afternoon.</p>
                <p>Yours [etc.]</p>
                <closer>
                    <signed><hi rendition="#small-caps">Arnold
                        Robertson</hi></signed>
                </closer>



