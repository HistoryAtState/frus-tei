    <text>
        <body>
            <div xml:id="d789">

                <pb facs="0766" n="676" sameAs="frus:frus1918Russiav02/pg676"/>

                <note rend="inline" type="source">File No. 861.00/1313</note>
                <head><hi rendition="#italic">The Consul General at Moscow</hi> (<hi
                        rendition="#italic">Summers</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi><anchor n="1" xml:id="d789-f1"/></head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Moscow</hi></placeName>, <date calendar="gregorian"
                            when="1918-03-13T12:00:00+02:31"><hi rendition="#italic">March 13, 1918,
                                noon</hi></date>. <lb/> [<hi rendition="#italic">Received March 17,
                            1.45 p.m.</hi>]</dateline>
                </opener>
                <p>260. Odessa occupied Austro-German troops. No news consul who was instructed go
                    Rostov.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Summers</hi></signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d789-f1" n="1" type="source" xml:id="d789-f1-content">
                <p>Sent via the Consulate at Vladivostok.</p>
            </note>
        </listAnnotation>
    </standOff>
