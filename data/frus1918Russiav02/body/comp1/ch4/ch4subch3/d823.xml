    <text>
        <body>
            <div xml:id="d823">

                <pb facs="0793" n="703" sameAs="frus:frus1918Russiav02/pg703"/>

                <note rend="inline" type="source">File No. 861.00/3347</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Consul General at
                        Irkutsk</hi> (<hi rendition="#italic">Harris</hi>)<anchor n="1"
                        xml:id="d823-f1"/></head>
                <opener>
                    <seg rendition="#center">[Telegram—Extract]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1918-12-12T18:00:00-05:00"><hi rendition="#italic">December 12,
                                1918, 6 p.m.</hi></date></dateline>
                </opener>
                <p>… For your information. Allied powers other than the United States have issued
                    statement that they propose to restore order in the Ukraine by lending friendly
                    support and assistance to the authorities established there. It is understood
                    that British and French troops are already arriving at Sevastopol and Odessa for
                    this purpose. …</p>
                <closer>
                    <signed><hi rendition="#small-caps">Polk</hi></signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d823-f1" n="1" type="source" xml:id="d823-f1-content">
                <p>Sent via the Legation in China.</p>
            </note>
        </listAnnotation>
    </standOff>
