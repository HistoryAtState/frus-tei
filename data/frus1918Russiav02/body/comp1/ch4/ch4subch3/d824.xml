                <pb facs="0793" n="703" sameAs="frus:frus1918Russiav02/pg703"/>

                <note rend="inline" type="source">File No. 861.00/3448</note>
                <head><hi rendition="#italic">The Minister in Sweden</hi> (<hi rendition="#italic"
                    >Morris</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <seg rendition="#center">[Telegram—Extract]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Stockholm</hi></placeName>, <date calendar="gregorian"
                            when="1918-12-16"><hi rendition="#italic">December 16, 1918</hi></date>.
                        <lb/> [<hi rendition="#italic">Received December 17, 6.40
                        a.m.</hi>]</dateline>
                </opener>
                <p>3347. … Reports from Berlin: Kiev besieged by troops of Ukrainian National League
                    which captured all Ukraine. Political situation very favorable to this league.
                    …</p>
                <closer>
                    <signed><hi rendition="#small-caps"
                            >Morris</hi></signed>
                </closer>
            </div>
        </body>
