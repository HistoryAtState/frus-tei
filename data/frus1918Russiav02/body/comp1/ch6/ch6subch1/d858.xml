                <pb facs="0818" n="728" sameAs="frus:frus1918Russiav02/pg728"/>

                <note rend="inline" type="source">File No. 861.007724</note>
                <head><hi rendition="#italic">The Ambassador in Russia</hi> (<hi rendition="#italic"
                        >Francis</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Petrograd</hi></placeName>, <date calendar="gregorian"
                            when="1917-10-23"><hi rendition="#italic">October 23, 1917</hi></date>.
                        <lb/> [<hi rendition="#italic">Received November 27.</hi>]</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith, as
                    of valuable interest to the Department, copies of three recent communications
                    from Mr. Douglas Jenkins, American Consul temporarily detailed to Helsingfors,
                        <pb facs="0819" n="729" xml:id="pg729"/> Finland, relative to the political
                    and financial situation in that province. The communications are dated October
                    5, 11,<anchor n="1" xml:id="d858-f1"/> and 12 respectively.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed><hi rendition="#small-caps">David R. Francis</hi></signed>
                </closer>



                <xi:include href="d858-a1.xml" xpointer="d858-a1"/>
                <xi:include href="d858-a2.xml" xpointer="d858-a2"/>
