    <text>
        <body>
            <div xml:id="d879">

                <pb facs="0831" n="741" sameAs="frus:frus1918Russiav02/pg741"/>

                <note rend="inline" type="source">File No. 861.00/941</note>
                <head><hi rendition="#italic">The Chargé in Denmark</hi> (<hi
                            rendition="#italic">Grant-Smith</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi><anchor n="1"
                        xml:id="d879-f1"/></head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Copenhagen</hi></placeName>, <date calendar="gregorian"
                            when="1918-01-11T12:00:00+01:00"><hi rendition="#italic">January 11,
                                1918, noon</hi></date>. <lb/> [<hi rendition="#italic">Received
                            January 12, 3.32 p.m.</hi>]</dateline>
                </opener>
                <p>1809. Danish Government officially recognized the independence of Finland
                    yesterday.</p>
                <closer>[<signed><hi rendition="#small-caps"
                        >Grant-Smith</hi></signed>]</closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d879-f1" n="1" type="source" xml:id="d879-f1-content">
                <p>Sent via the Embassy in Great Britain.</p>
            </note>
        </listAnnotation>
