    <text>
        <body>
            <div xml:id="d889">

                <pb facs="0835" n="745" sameAs="frus:frus1918Russiav02/pg745"/>

                <note rend="inline" type="source">File No. 861.00/1008</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Consul at Helsingfors</hi> (<hi
                            rendition="#italic">Haynes</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1918-01-29T16:00:00-05:00"><hi rendition="#italic">January 29,
                                1918, 4 p.m.</hi></date></dateline>
                </opener>
                <p>Swedish press reports conditions Helsingfors dangerous. Department relies on your
                    judgment as to leaving your post but hopes situation may develop so you can
                    remain. Please acknowledge this.</p>
                <closer>
                    <signed><hi rendition="#small-caps"
                            >Lansing</hi></signed>
                </closer>
            </div>
        </body>
