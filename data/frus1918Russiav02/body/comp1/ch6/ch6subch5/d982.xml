    <text>
        <body>
            <div xml:id="d982">

                <pb facs="0904" n="814" sameAs="frus:frus1918Russiav02/pg814"/>

                <note rend="inline" type="source">File No. 860d.00/343</note>
                <head><hi rendition="#italic">The British Chargé</hi> (<hi
                            rendition="#italic">Chilton</hi>) <hi rendition="#italic">to
                        the Acting Secretary of State</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 1410</seg>
                </opener>
                <p rendition="#center"><hi rendition="#small-caps">Memorandum</hi></p>
                <p>His Majesty’s Chargé d’Affaires presents his compliments to the Acting Secretary
                    of State and has the honour to inform him that the Finnish representative in
                    London states that the remaining German officers, troops, and munitions of war
                    were finally withdrawn from Finland on December 16.</p>
                <closer>
                    <dateline rendition="#float-left">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1918-12-24"><hi
                                rendition="#italic">December 24, 1918</hi></date>. <lb/> [<hi
                            rendition="#italic">Received December 27.</hi>]</dateline>
                </closer>
            </div>
        </body>
    </text>
