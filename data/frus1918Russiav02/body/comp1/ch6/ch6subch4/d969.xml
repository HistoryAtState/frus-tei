                <pb facs="0897" n="807" sameAs="frus:frus1918Russiav02/pg807"/>

                <note rend="inline" type="source">File No. 860d.00/267</note>
                <head><hi rendition="#italic">The Chargé in Sweden</hi> (<hi rendition="#italic">Whitehouse</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <seg rendition="#center">[Telegram—Extract]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Stockholm</hi></placeName>, <date calendar="gregorian"
                            when="1918-08-27"><hi rendition="#italic">August 27, 1918</hi></date>.
                        <lb/> [<hi rendition="#italic">Received August 28, 5.25
                        a.m.</hi>]</dateline>
                </opener>
                <p>2726. Swedish press reports … Finnish-Russian peace negotiations broken off
                    indefinitely. …</p>
                <closer>
                    <signed><hi rendition="#small-caps"
                            >Whitehouse</hi></signed>
                </closer>
            </div>
