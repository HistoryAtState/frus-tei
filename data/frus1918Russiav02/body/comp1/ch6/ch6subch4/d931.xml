            <div xml:id="d931">

                <pb facs="0872" n="782" sameAs="frus:frus1918Russiav02/pg782"/>

                <note rend="inline" type="source">File No. 860d.00/102</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Minister in Sweden</hi> (<hi
                            rendition="#italic">Morris</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1918-04-22T18:00:00-04:00"><hi rendition="#italic">April 22, 1918,
                                6 p.m.</hi></date></dateline>
                </opener>
                <p>726. Your 1916, April 19, 6 p.m. You may inform your British colleague that
                    Department not prepared at present to take any action looking to recognizing
                    Finnish independence.</p>
                <closer>
                    <signed><hi rendition="#small-caps"
                            >Lansing</hi></signed>
                </closer>
            </div>
