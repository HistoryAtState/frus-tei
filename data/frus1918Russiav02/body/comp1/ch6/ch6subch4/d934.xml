            <div xml:id="d934">

                <pb facs="0873" n="783" sameAs="frus:frus1918Russiav02/pg783"/>

                <note rend="inline" type="source">File No. 860d.00/112</note>
                <head><hi rendition="#italic">The Minister in Sweden</hi> (<hi rendition="#italic"
                        >Morris</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Stockholm</hi></placeName>, <date calendar="gregorian"
                            when="1918-04-27T17:00:00+01:00"><hi rendition="#italic">April 27, 1918,
                                5 p.m.</hi></date>
                        <lb/> [<hi rendition="#italic">Received April 28, 3.34 a.m.</hi>]</dateline>
                </opener>
                <p>1959. Your 733, April 25, 7 p.m. Have every reason to believe statement therein
                    quoted was made by Mannerheim as it appeared in all Swedish papers.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Morris</hi></signed>
                </closer>
            </div>
        </body>
