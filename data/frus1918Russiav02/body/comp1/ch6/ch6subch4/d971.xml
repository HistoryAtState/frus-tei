    <text>
        <body>
            <div xml:id="d971">

                <pb facs="0898" n="808" sameAs="frus:frus1918Russiav02/pg808"/>

                <note rend="inline" type="source">File No. 860d.00/261</note>
                <head><hi rendition="#italic">The Secretary of State to the Consul at
                        Helsingfors</hi> (<hi rendition="#italic">Haynes</hi>)<anchor n="1"
                        xml:id="d971-f1"/></head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1918-08-28T15:00:00-04:00"><hi rendition="#italic">August 28,
                                1918, 3 p.m.</hi></date></dateline>
                </opener>
                <p>Your 74. The Department believes that such declaration may well await a more
                    opportune moment for expression than the present.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Lansing</hi></signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d971-f1" n="1" type="source" xml:id="d971-f1-content">
                <p>Sent via the Legation in Sweden (No. 1054).</p>
            </note>
        </listAnnotation>
