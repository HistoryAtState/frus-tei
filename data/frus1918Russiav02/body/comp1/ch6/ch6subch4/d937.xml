    <text>
        <body>
            <div xml:id="d937">

                <pb facs="0875" n="785" sameAs="frus:frus1918Russiav02/pg785"/>

                <note rend="inline" type="source">File No. 860d.00/123</note>
                <head><hi rendition="#italic">The Secretary of State to the British Ambassador</hi>
                        (<hi rendition="#italic">Reading</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1918-05-09"><hi rendition="#italic">May 9,
                        1918</hi></date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">My Dear Mr. Ambassador</hi>: I have received your
                    letter of May 4, 1918, informing me of the action of your Government in regard
                    to the provisional recognition of the <hi rendition="#italic">de facto</hi>
                    Finnish government, and shall be very glad to know of the final decision reached
                    and how far the conditions laid down by your Government have been accepted and
                    fulfilled.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed><hi rendition="#small-caps">Robert Lansing</hi></signed>
                </closer>
            </div>
        </body>
    </text>
