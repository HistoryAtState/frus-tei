                <pb facs="0867" n="777" sameAs="frus:frus1918Russiav02/pg777"/>

                <note rend="inline" type="source">File No. 860d.00/42</note>
                <head><hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic">Page</hi>)
                        <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1918-03-08T23:00:00+00:00"><hi rendition="#italic">March 8, 1918,
                                11 p.m.</hi></date>
                        <lb/> [<hi rendition="#italic">Received March 8, 5.11 p.m.</hi>]</dateline>
                </opener>
                <p>8966. Your 6559, February 13, 6 p.m.<anchor n="1" xml:id="d920-f1"/> Naval
                    Attaché informed by British authorities that shipments of grain from America to
                    north Finland have been stopped in view of the recent changes in the political
                    situation there, which would make it probable that these supplies would fall
                    into enemy hands. Please advise what policy has been adopted. British
                    information is to effect that Germans have penetrated into northern Finland.</p>
                <closer>
                    <signed><hi rendition="#small-caps"
                            >Page</hi></signed>
                </closer>
            </div>
        </body>
    </text>
