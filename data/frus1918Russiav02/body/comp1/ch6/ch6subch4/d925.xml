                <pb facs="0870" n="780" sameAs="frus:frus1918Russiav02/pg780"/>

                <note rend="inline" type="source">File No. 860d.00/90</note>
                <head><hi rendition="#italic">The Vice Consul at Petrograd</hi> (<hi
                        rendition="#italic">Imbrie</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Petrograd</hi></placeName>, <date calendar="gregorian"
                            when="1918-04-14"><hi rendition="#italic">April 14, 1918</hi></date>.
                        <lb/> [<hi rendition="#italic">Received 11.05 a.m.</hi>]</dateline>
                </opener>
                <p>10. Haynes, Helsingfors, requests Department informed he can no longer
                    communicate. Expects occupation of city but has been assured immunity.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Imbrie</hi></signed>
                </closer>
            </div>
