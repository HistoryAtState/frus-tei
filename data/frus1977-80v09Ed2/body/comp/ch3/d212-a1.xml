    <text>
        <body>
            <div xml:id="d212-a1">

                <pb facs="0778" n="743" sameAs="frus:frus1977-80v09Ed2/pg743"/>


                <head><hi rendition="#bold">List Prepared in the Department of Defense</hi><anchor
                        n="3" xml:id="d212-f1"/></head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date
                            ana="#date_undated-inferred-from-sibling-dates" calendar="gregorian"
                            when="1979-03-14">undated</date>
                    </dateline>
                </opener>
                <p rendition="#center"><hi rendition="#italic">EGYPT: EQUIPMENT</hi></p>
                <table cols="2">
                    <row>
                        <cell/>
                        <cell>$ Million</cell>
                    </row>
                    <row>
                        <cell>INDICATED AS LIKELY TO BE AVAILABLE (but requiring choices among them
                            by the Egyptians to stay within 1.5B$) </cell>
                        <cell/>
                    </row>
                    <row>
                        <cell>One cruiser (the ALBANY)</cell>
                        <cell role="num">34.5</cell>
                    </row>
                    <row>
                        <cell>Up to four Gearing Class Destroyers (two for active service; two for
                            cannibalization if necessary).</cell>
                        <cell role="num">34.7</cell>
                    </row>
                    <row>
                        <cell>Reasonable quantities of Armored Personnel Carriers (e.g.,
                            1000)</cell>
                        <cell role="num">125.0</cell>
                    </row>
                    <row>
                        <cell>Twelve I-Hawk missile batteries</cell>
                        <cell role="num">500.0</cell>
                    </row>
                    <row>
                        <cell>Additional F–5 aircraft (50)</cell>
                        <cell role="num">500.0</cell>
                    </row>
                    <row>
                        <cell>Additional C–130 aircraft (20)</cell>
                        <cell role="num">230.0</cell>
                    </row>
                    <row>
                        <cell>CH–47 “Chinook” helicopters (40)</cell>
                        <cell role="num">350.0</cell>
                    </row>
                    <row>
                        <cell>Pressure test of Egyptian Soviet-built submarine hulls</cell>
                        <cell role="num">12.0</cell>
                    </row>
                    <row>
                        <cell>Technical Data Package for retrofitting current Egyptian tanks</cell>
                        <cell role="num">300.0</cell>
                    </row>
                    <row>
                        <cell>TO BE CONSIDERED:</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell>F–4 aircraft in moderate numbers (35)</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell>One or two diesel submarines (Guppy type or Tang class)</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell>TURNED DOWN:</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell>F–15 or F–16 aircraft</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell>Attack helicopters</cell>
                        <cell/>
                    </row>
                    <row>
                        <cell>M60 tanks</cell>
                        <cell/>
                    </row>
                </table>
            </div>
        </body>
    </text>
