    <standOff>
        <listAnnotation>
            <note corresp="#d202-f1" n="1" type="source" xml:id="d202-f1-content">
                <p>Source: Reagan Library, Robert H. Lilac Files, Arms Transfer: Country File, AT:
                    Yugoslavia [11/17/1982] (2). Confidential. The memorandum was sent to Donald
                    Gregg (OVP), Michael Wheeler (NSC), Raymond Lett (Agriculture), Thomas Cormack
                    (CIA), Helen Robbins (Commerce), John Stanford (Defense), William H. Draper
                    (EXIM Bank), Charles Siegman (Federal Reserve), Alton Keel (OMB), David Pickford
                    (Treasury), and Dennis Whitfield (USTR).</p>
            </note>
            <note corresp="#d202-f2" n="2" xml:id="d202-f2-content">
                <p>The undated discussion paper is ibid.</p>
            </note>
            <note corresp="#d202-f3" n="3" xml:id="d202-f3-content">
