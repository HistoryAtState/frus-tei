    <text>
        <body>
            <div xml:id="d790">

                <pb facs="0793" n="695" sameAs="frus:frus1930v02/pg695"/>

                <note rend="inline" type="source">837.154/121</note>
                <head><hi rendition="#italic">The Ambassador in Cuba</hi> (<hi
                            rendition="#italic">Guggenheim</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Habana</hi></placeName>, <date calendar="gregorian"
                            when="1930-11-06">November 6, 1930</date>.<lb/>[Received November
                        10.]</dateline>
                    <seg rendition="#float-left">No. 418</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Supplementing my despatch No. 416 of
                    October 31, 1930, relative to the financing by the Warren Bros. Company and the
                        <pb facs="0794" n="696" xml:id="pg696"/> Compañía Cubana de Contratistas of
                    the work that is being done by them on the Central Highway, I have the honor to
                    report that I have received a letter, dated November 4, 1930, from President
                    Machado acknowledging receipt of my letter of October 29, 1930, and stating his
                    conformity therewith.</p>
                <p>Copies of President Machado’s letter and of a translation of the same are
                    transmitted herewith to the Department.</p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">Harry F.
                    Guggenheim</hi></signed></closer>


                <xi:include href="d790-a1.xml" xpointer="d790-a1"/>
