    <text>
        <body>
            <div xml:id="d769">

                <pb facs="0776" n="678" xml:id="pg678"/>

                <note rend="inline" type="source">837.00/2920: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Cuba</hi> (<hi
                            rendition="#italic">Guggenheim</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Habana</hi></placeName>, <date calendar="gregorian"
                            when="1930-12-11T14:00:00-05:00">December 11, 1930—2
                        p.m.</date><lb/>[Received 3 p.m.]</dateline></opener>
                <p>162. Student demonstrations are taking place in various cities of the Island and
                    are openly supported by Opposition. Great pressure is being brought to bear on
                    President Machado to resign.</p>
                <closer><signed><hi rendition="#small-caps">Guggenheim</hi></signed></closer>
            </div>
        </body>
    </text>
