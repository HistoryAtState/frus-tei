    <text>
        <body>
            <div xml:id="d876-a2">

                <pb facs="0853" n="755" sameAs="frus:frus1930v02/pg755"/>

                <opener><seg rendition="#center">[Enclosure 2]</seg></opener>
                <head><hi rendition="#italic">The American Minister</hi> (<hi rendition="#italic"
                        >Gunther</hi>) <hi rendition="#italic">to the Egyptian Minister for Foreign
                        Affairs</hi> (<hi rendition="#italic">Boutros Pasha</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Cairo</hi></placeName>, <date calendar="gregorian"
                            when="1930-05-24">May 24, 1930</date>.</dateline>
                    <seg rendition="#float-left">No. 230</seg></opener>
                <p><hi rendition="#small-caps">Mr. Minister</hi>: I have the honor to acknowledge
                    the receipt of Your Excellency’s Note No. 1.7/3 (32), of May 24, 1930, the
                    agreed English text of which is as follows:</p>
                <p>[Here follows the text of note printed <hi rendition="#italic">supra.</hi>]</p>
                <p>In reply I have the honor to inform Your Excellency of my Government’s
                    acquiescence in the terms of the above mentioned Note thus establishing a
                    Provisional Commercial Accord, and avail myself [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Franklin Mott
                    Gunther</hi></signed></closer>
            </div>
        </body>
    </text>
