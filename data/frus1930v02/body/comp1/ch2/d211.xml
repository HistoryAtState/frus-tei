    <text>
        <body>
            <div xml:id="d211">

                <pb facs="0285" n="187" sameAs="frus:frus1930v02/pg187"/>

                <note rend="inline" type="source">393.11/1296</note>
                <head><hi rendition="#italic">The Consul General at Hankow</hi> (<hi
                        rendition="#italic">Lockhart</hi>) <hi rendition="#italic">to the Minister
                        in China</hi> (<hi rendition="#italic">Johnson</hi>)<anchor n="94"
                        xml:id="d211-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Hankow</hi></placeName>, <date calendar="gregorian"
                            when="1930-09-10">September 10, 1930</date>.</dateline>
                    <seg rendition="#float-left">L. No. 1055</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith, as of
                    possible interest, a copy of a letter addressed by me under date of September
                    10, 1930, to Mr. W. Russell Brown,<anchor n="93" xml:id="d211-f2"/> Acting
                    British Consul General at Hankow, by way of an expression of appreciation for
                    the service rendered to several American citizens who evacuated from Changsha
                    during the recent trouble there and who were brought to Hankow on board H. M. S.
                        <hi rendition="#italic">Aphis</hi>. The letter explains itself.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">F. P. Lockhart</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d211-f1" n="94" type="source" xml:id="d211-f1-content">
                <p>Copy transmitted to the Department by the Consul General in his despatch No.
                    1560, September 10, 1930; received October 8.</p>
            </note>
            <note corresp="#d211-f2" n="93" xml:id="d211-f2-content">
