                <pb facs="0308" n="210" sameAs="frus:frus1930v02/pg210"/>

                <note rend="inline" type="source">195.95/86a: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Minister in China</hi>
                        (<hi rendition="#italic">Johnson</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1930-11-04T16:00:00-05:00">November 4, 1930—4
                        p.m.</date></dateline></opener>
                <p>379. Press correspondence dated Shanghai, October 4, states that vessels of the
                    Yangtze Rapids Steamship Company are now carrying on upper Yangtze above Hankow
                    Chinese guards furnished by Chinese gunboats. Please investigate and report by
                    telegraph.</p>
                <closer><signed><hi rendition="#small-caps">Stimson</hi></signed></closer>
            </div>
        </body>
    </text>
