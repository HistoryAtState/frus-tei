            <div xml:id="d166">

                <pb facs="0257" n="159" sameAs="frus:frus1930v02/pg159"/>

                <note rend="inline" type="source">893.00/11032: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Minister in
                        China</hi> (<hi rendition="#italic">Johnson</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1930-08-02T13:00:00-04:00">August 2, 1930—1
                    p.m.</date></dateline></opener>
                <p>259. Your 640 of July 31, 4 p.m.</p>
                <list>
                    <label>1.</label>
                    <item>Department approves action taken.</item>
                    <label>2.</label>
                    <item>Japanese Embassy has inquired regarding action taken by this Government,
                        and Department has read to Counselor most of text, <pb facs="0258" n="160"
                            xml:id="pg160"/> with explanation that Department has issued no special
                        instruction and action so far taken is under authority of general
                        instructions.</item>
                </list>
                <closer><signed><hi rendition="#small-caps">Carr</hi></signed></closer>
            </div>
        </body>
    </text>
