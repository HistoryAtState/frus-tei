                <pb facs="0420" n="322" sameAs="frus:frus1930v02/pg322"/>

                <note rend="inline" type="source">893.05/237: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Chargé in
                        China</hi> (<hi rendition="#italic">Perkins</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1930-01-17T19:00:00-05:00">January 17, 1930—7
                        p.m.</date></dateline></opener>
                <p>19. Your 47, January 15, 3 p.m., 48, January 16, 11 a.m., and 52, January 16, 3
                    p.m.</p>
                <list>
                    <label>1.</label>
                    <item>The Department has studied these telegrams and is satisfied with the
                        general position taken by the American delegates and the Legation as
                        described therein.</item>
                    <label>2.</label>
                    <item>The Department desires, as soon as the situation is sufficiently
                        clarified, a statement of the points in regard to which the foreign
                        delegates and the Chinese representatives remain in disagreement.</item>
                </list>
                <closer><signed><hi rendition="#small-caps">Cotton</hi></signed></closer>
            </div>
        </body>
    </text>
