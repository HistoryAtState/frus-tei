    <text>
        <body>
            <div xml:id="d519">

                <pb facs="0566" n="468" xml:id="pg468"/>

                <note rend="inline" type="source">793.003/418: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >Johnson</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peiping</hi></placeName>, <date calendar="gregorian"
                            when="1930-09-15T12:00:00+08:00">September 15,
                        1930—noon</date>.<lb/>[Received September 15—9:35 a.m.]</dateline></opener>
                <p>813. May I inform the Japanese and other interested Legations of the substance of
                    the Department’s 317, September 12, 8 p.m.?<anchor n="66" xml:id="d519-f1"/></p>
                <closer>For the Minister:<lb/><signed><hi rendition="#small-caps"
                        >Perkins</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d519-f1" n="66" xml:id="d519-f1-content">
                <p>Not printed; it quoted the text of the memorandum of September 12, 1930, to the
                    Chinese Legation, <ref target="#pg467">p. 467</ref>.</p>
            </note>
        </listAnnotation>
