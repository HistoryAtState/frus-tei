            <div xml:id="d531">

                <pb facs="0580" n="482" xml:id="pg482"/>

                <note rend="inline" type="source">793.003/451: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">Johnson</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><seg rendition="#center">[Extract]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peiping</hi></placeName>, <date calendar="gregorian"
                            when="1930-11-09T11:00:00+08:00">November 9, 1930—11
                        a.m.</date><lb/>[Received November 9—1:52 a.m.]</dateline></opener>
                <p>972. Following from Minister Johnson, Shanghai: <quote rend="blockquote">
                        <p>“November 8, 5 p.m. Arrived 7th, gave Japanese Chargé d’Affaires copy
                            October 28th proposals this morning and will give copy to Wang either
                            here Sunday or in Nanking on Monday.…”</p>
                    </quote></p>
                <closer>For the Minister:<lb/><signed><hi rendition="#small-caps"
                        >Perkins</hi></signed></closer>
            </div>
        </body>
