    <text>
        <body>
            <div xml:id="d506">

                <pb facs="0555" n="457" xml:id="pg457"/>

                <note rend="inline" type="source">793.003/391: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >Johnson</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><seg rendition="#center">[Extract]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peiping</hi></placeName>, <date calendar="gregorian"
                            when="1930-08-14T17:00:00+08:00">August 14, 1930—5
                        p.m.</date><lb/>[Received August 15—4:30 a.m.<anchor n="53" xml:id="d506-f1"
                        />]</dateline></opener>
                <p>698. [Paraphrase.] Your 269, August 9, 2 p.m., last paragraph. I approve the
                    Department’s proposal to postpone the formal initiating of negotiations
                    respecting extraterritoriality. [End paraphrase.]</p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <closer><signed><hi rendition="#small-caps">Johnson</hi></signed></closer>
            </div>
        </body>
    </text>
