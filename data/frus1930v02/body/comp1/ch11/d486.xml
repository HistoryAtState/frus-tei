    <text>
        <body>
            <div xml:id="d486">

                <pb facs="0535" n="437" sameAs="frus:frus1930v02/pg437"/>

                <note rend="inline" type="source">793.003/347: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Minister in China</hi>
                        (<hi rendition="#italic">Johnson</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1930-05-02T16:00:00-04:00">May 2, 1930—4
                    p.m.</date></dateline></opener>
                <p>151. Your 297, May 1, 6 p.m.<anchor n="24" xml:id="d486-f1"/> For your
                    information and discreet use if inquiries are made, it is true that Washington
                    and London have been conferring, but it is not true that resumption of
                    negotiations is in any way contingent upon previous reaching of an
                    agreement.</p>
                <closer><signed><hi rendition="#small-caps">Stimson</hi></signed></closer>
            </div>
        </body>
    </text>
