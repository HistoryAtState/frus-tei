            <div xml:id="d553">

                <pb facs="0601" n="503" sameAs="frus:frus1930v02/pg503"/>

                <note rend="inline" type="source">793.003/481: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Minister in China</hi> (<hi rendition="#italic"
                            >Johnson</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1930-12-29T18:00:00-05:00">December 29, 1930—6
                        p.m.</date></dateline></opener>
                <p>450. For the Minister: Department’s 448, December 27, 6 p.m.</p>
                <p>Chinese Minister expressly requests this morning that Department ask American
                    Minister to give to the Minister of Foreign Affairs a full text copy of
                    Department’s memorandum to the Legation.</p>
                <closer><signed><hi rendition="#small-caps">Stimson</hi></signed></closer>
            </div>
        </body>
    </text>
