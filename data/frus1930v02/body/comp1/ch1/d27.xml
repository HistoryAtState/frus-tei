    <text>
        <body>
            <div xml:id="d27">

                <pb facs="0156" n="58" sameAs="frus:frus1930v02/pg58"/>

                <note rend="inline" type="source">893.00 P.R./40</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >Johnson</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peiping</hi></placeName>, <date calendar="gregorian"
                            when="1930-12-18">December 18, 1930</date>.<lb/>[Received January 28,
                        1931.]</dateline>
                    <seg rendition="#float-left">No. 680</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In compliance with the Department’s
                    standing instructions, and in continuation of the Legation’s despatch No. 600 of
                    November 17, 1930, I have the honor to transmit herewith a Report on the
                    Political and Military Situation in China for the month of November, 1930.</p>
                <pb facs="0157" n="59" xml:id="pg59"/>
                <p>The foreign relations of China will form the subject of a separate report.</p>
                <p>Respectfully yours,</p>
                <closer>For the Minister:<lb/><signed><hi rendition="#small-caps">Mahlon F.
                            Perkins</hi></signed><lb/><hi rendition="#italic">Counselor of
                        Legation</hi></closer>


                <xi:include href="d27-a1.xml" xpointer="d27-a1"/>
            </div>
