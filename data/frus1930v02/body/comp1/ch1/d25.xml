            <div xml:id="d25">

                <pb facs="0136" n="38" sameAs="frus:frus1930v02/pg38"/>

                <note rend="inline" type="source">893.00 P.R./38</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >Johnson</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peiping</hi></placeName>, <date calendar="gregorian"
                            when="1930-10-12">October 12, 1930</date>.<lb/>[Received November
                        19.]</dateline>
                    <seg rendition="#float-left">No. 521</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In compliance with the Department’s
                    standing instructions, I have the honor to transmit herewith a Report on the
                    Political and Military Situation in China for the month of September 1930.</p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">Nelson Trusler
                    Johnson</hi></signed></closer>


                <xi:include href="d25-a1.xml" xpointer="d25-a1"/>
