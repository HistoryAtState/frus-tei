                <pb facs="0135" n="37" sameAs="frus:frus1930v02/pg37"/>

                <note rend="inline" type="source">893.00/11195: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Minister in China</hi> (<hi rendition="#italic"
                            >Johnson</hi>)</head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1930-09-17T12:00:00-04:00">September 17,
                        1930—noon</date>.</dateline></opener>
                <p>323. Your 818, September 16, 10 p.m. The Department does not desire the Consul
                    General at Shanghai to transmit the suggested message if it is of a political
                    character.</p>
                <closer><signed><hi rendition="#small-caps">Stimson</hi></signed></closer>
            </div>
        </body>
