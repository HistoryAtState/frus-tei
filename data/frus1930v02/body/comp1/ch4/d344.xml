    <text>
        <body>
            <div xml:id="d344">

                <pb facs="0376" n="278" sameAs="frus:frus1930v02/pg278"/>

                <note rend="inline" type="source">693.9431/42: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Minister in
                        China</hi> (<hi rendition="#italic">Johnson</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1930-04-26T18:00:00-05:00">April 26, 1930—6
                    p.m.</date></dateline></opener>
                <p>146. Your 265, April 12, 4 p.m.<anchor n="4" xml:id="d344-f1"/> In the opinion of
                    this Department and of the Department of Commerce, the favored nation provisions
                    of our tariff agreement with China entitle our trade to the benefit of any
                    reduction in rates which may be made in treaties with or which may be accorded
                    to any other country.</p>
                <closer><signed><hi rendition="#small-caps">Cotton</hi></signed></closer>
            </div>
        </body>
    </text>
