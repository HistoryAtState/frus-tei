                <pb facs="0450" n="352" sameAs="frus:frus1930v02/pg352"/>

                <note rend="inline" type="source">893.102S/215: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Minister in China</hi> (<hi rendition="#italic"
                            >Johnson</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1930-12-27T16:00:00-05:00">December 27, 1930—4
                        p.m.</date></dateline></opener>
                <p>447. Department’s instruction No. 1454 of January 18, 1930. Please inform the
                    Minister that the Department would welcome an expression of his views with
                    regard to the question of extra-settlement roads at Shanghai.</p>
                <closer><signed><hi rendition="#small-caps">Stimson</hi></signed></closer>
            </div>
        </body>
    </text>
