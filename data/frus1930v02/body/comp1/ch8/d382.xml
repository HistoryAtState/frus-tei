    <text>
        <body>
            <div xml:id="d382">

                <pb facs="0407" n="309" sameAs="frus:frus1930v02/pg309"/>

                <note rend="inline" type="source">711.9312A/6</note>
                <head><hi rendition="#italic">The Chinese Minister</hi> (<hi
                            rendition="#italic">C. C. Wu</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1929-05-28">May 28, 1929</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to your Department’s note of
                    December 21, 1928,<anchor n="72" xml:id="d382-f1"/> transmitting for the
                    consideration of my Government and as a basis for negotiation the draft of a
                    Treaty of Arbitration between China and the United States, I have the honor to
                    return herewith in pursuance of instructions from my Government the draft as
                    amended by my Government,<anchor n="73" xml:id="d382-f2"/> together with an
                    explanatory note showing the reasons for the verbal changes suggested, for your
                    consideration.</p>
                <p>I take this opportunity to add that I have been designated as Delegate
                    Plenipotentiary on the part of China with full power to sign this Treaty.</p>
                <p>Accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Chao-Chu Wu</hi></signed></closer>


                <xi:include href="d382-a1.xml" xpointer="d382-a1"/>
            </div>
        </body>
    </text>
