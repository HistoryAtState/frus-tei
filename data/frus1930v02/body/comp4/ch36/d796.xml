                <pb facs="0798" n="700" sameAs="frus:frus1930v02/pg700"/>

                <note rend="inline" type="source">839.00 Revolutions/7: Telegram</note>
                <head><hi rendition="#italic">The Minister in the Dominican Republic</hi> (<hi rendition="#italic">Curtis</hi>) <hi
                        rendition="#italic">to the Acting Secretary of
                            State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Santo Domingo</hi></placeName>, <date calendar="gregorian"
                            when="1930-02-24T23:00:00-04:40">February 24, 1930—11
                        p.m.</date><lb/>[Received 11:44 p.m.]</dateline></opener>
                <p>14. Revolutionists are advancing upon the city. A naval vessel should be sent
                    here without delay. Cabot has had to proceed to Santiago and has not yet
                    returned.</p>
                <closer><signed><hi rendition="#small-caps">Curtis</hi></signed></closer>
            </div>
        </body>
