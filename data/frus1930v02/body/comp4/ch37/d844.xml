    <text>
        <body>
            <div xml:id="d844">

                <pb facs="0830" n="732" xml:id="pg732"/>

                <note rend="inline" type="source">836.48 1930 Hurricane/19: Telegram</note>
                <head><hi rendition="#italic">The Minister in the Dominican Republic</hi> (<hi
                        rendition="#italic">Curtis</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Santo Domingo</hi></placeName>, <date calendar="gregorian"
                            when="1930-09-07T19:00:00-04:40">September 7, 1930—7
                        p.m.</date><lb/>[Received 10:20 p.m.]</dateline></opener>
                <p>101. Please inform Red Cross immediately needs are too great to be supplied from
                    adjacent countries. Surgical supplies needed in great quantities. Thousands of
                    large necrotic wounds. Please expedite shipment dressings, antiseptics, etc.,
                    from New York.</p>
                <closer><signed><hi rendition="#small-caps">Curtis</hi></signed></closer>
            </div>
        </body>
    </text>
