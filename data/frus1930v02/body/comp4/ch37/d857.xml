    <text>
        <body>
            <div xml:id="d857">

                <pb facs="0836" n="738" xml:id="pg738"/>

                <note rend="inline" type="source">836.48 1930 Hurricane/61: Telegram</note>
                <head><hi rendition="#italic">President Trujillo to
                        President Hoover</hi><anchor n="22"
                        xml:id="d857-f1"/></head>
                <opener><seg rendition="#center">[Translation]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Santo Domingo</hi></placeName>, <date calendar="gregorian"
                            when="1930-09-26">September 26, 1930</date>.</dateline></opener>
                <p>I am very grateful to Your Excellency for the encouraging message of sympathy
                    which you sent me on the occasion of the terrible hurricane that scourged this
                    city the third day of this month.</p>
                <closer><signed><hi rendition="#small-caps">Rafael L.
                    Trujillo</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d857-f1" n="22" type="source" xml:id="d857-f1-content">
                <p>Received in the Department of State September 29, 1930.</p>
            </note>
        </listAnnotation>
