    <text>
        <body>
            <div xml:id="d96">

                <pb facs="0428" n="323" sameAs="frus:frus1958-60v03mSupp/pg323"/>

                <head>96. Memorandum for the Record<anchor n="1" xml:id="d96-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1958-09-22">September 22,
                        1958</date></dateline>
                </opener>
                <pb facs="d96-1" n="1" type="facsimile" xml:id="d96-1"/>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>Revision of NSC 5410/1</item>
                </list>
                <p>Mr. Smith discussed with the Secretary this afternoon the subject of the attached
                    memorandum.</p>
                <p>The Secretary authorized Mr. Smith to take the position indicated during Planning
                    Board discussions on this subject.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Howard Furnas</hi>
                    </signed>
                </closer>
                <postscript>
                    <p>cc: Mr. Mathews</p>
                </postscript>


                <xi:include href="d96-a1.xml" xpointer="d96-a1"/>
            </div>
        </body>
