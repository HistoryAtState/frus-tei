    <text>
        <body>
            <div xml:id="d117">

                <pb facs="d116-5" n="5" sameAs="frus:frus1958-60v03mSupp/d116-5"/>

                <head>117. Memorandum From Gray to Morse (AEC)<anchor n="1" xml:id="d117-f1"
                    /></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1958-12-11">December 11,
                        1958</date></dateline>
                </opener>
                <pb facs="d117-1" n="1" type="facsimile" xml:id="d117-1"/>
                <p>Many thanks for your memorandum of December 5, which unfortunately did not reach
                    me until after the NSC meeting. I shall be glad to discuss this with you at our
                    convenience.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Gordon Gray</hi>
                        <lb/>
                        <hi rendition="#italic">Special Assistant to the President</hi>
                    </signed>
                </closer>


                <xi:include href="d117-a1.xml" xpointer="d117-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d117-f1" n="1" type="source" xml:id="d117-f1-content">
                <p>Source: Returns Morse’s preview of December 6 NSC meeting on defense budget. Top
                    Secret. 3 pp. Eisenhower Library, White House Office Files, Projects Clean
                    Up.</p>
            </note>
        </listAnnotation>
    </standOff>
