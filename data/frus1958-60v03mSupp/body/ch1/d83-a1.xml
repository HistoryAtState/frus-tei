    <text>
        <body>
            <div xml:id="d83-a1">

                <pb facs="d83-3" n="3" xml:id="d83-3"/>


                <p rendition="#center">ADVANCED RECONNAISSANCE SATELLITE PROGRAM SCHEDULE THROUGH CY
                    1960</p>
                <table xml:id="tab010">
                    <row role="label">
                        <cell><hi rendition="#italic">Number and Type of Vehicle</hi></cell>
                        <cell><hi rendition="#italic">Some Recon. Equipment Aboard</hi></cell>
                        <cell><hi rendition="#italic">Launching Location</hi></cell>
                        <cell><hi rendition="#italic">Orbit over USSR</hi></cell>
                        <cell><hi rendition="#italic">Schedule</hi></cell>
                    </row>
                    <row>
                        <cell cols="5"><hi rendition="#italic">Initial tests</hi></cell>
                    </row>
                    <row>
                        <cell>10–19 Thor</cell>
                        <cell>No</cell>
                        <cell>South Camp Cooke, Calif.</cell>
                        <cell>Yes</cell>
                        <cell>Begin November 1958</cell>
                    </row>
                    <row>
                        <cell>5 Atlas</cell>
                        <cell>Yes</cell>
                        <cell>Cape Canaveral, Florida</cell>
                        <cell>No</cell>
                        <cell>Begin about July 1959, one every other month</cell>
                    </row>
                    <row>
                        <cell><anchor n="2" xml:id="d83-f1"/>1 Atlas</cell>
                        <cell>Yes</cell>
                        <cell>South Camp Cooke, Calif.</cell>
                        <cell>Yes</cell>
                        <cell>March 1960</cell>
                    </row>
                    <row>
                        <cell cols="5"><hi rendition="#italic">Pioneer Visual Recon.</hi></cell>
                    </row>
                    <row>
                        <cell><anchor n="3" xml:id="d83-f2"/>4 Atlas</cell>
                        <cell>Yes</cell>
                        <cell>South Camp Cooke, Calif.</cell>
                        <cell>Yes</cell>
                        <cell>Begin May 1960, one every other month</cell>
                    </row>
                    <row>
                        <cell cols="5"><hi rendition="#italic">Pioneer Ferret (Electronic)
                                Reconnaissance</hi></cell>
                    </row>
                    <row>
                        <cell>3 Atlas</cell>
                        <cell>Yes</cell>
                        <cell>South Camp Cooke, Calif.</cell>
                        <cell>Yes</cell>
                        <cell>Begin August 1960, one every other month</cell>
                    </row>
                </table>
                <p>As of June 30, 1958</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d83-f1" n="2" xml:id="d83-f1-content">
                <p>Visual components test. [Footnote is in the original.]</p>
            </note>
            <note corresp="#d83-f2" n="3" xml:id="d83-f2-content">
                <p>First satellite with reconnaissance equipment that will orbit over USSR. [Footnote is in the original.]</p>
            </note>
        </listAnnotation>
    </standOff>
