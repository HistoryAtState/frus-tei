    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d170-f1" n="1" type="source" xml:id="d170-f1-content">
                <p>Source: Transmits NSC 5908, a directive on
                    establishing the Comparative Evaluations Group. Top Secret; Special Limited
                    Distribution. 3 pp. NARA, RG 59, S/S–NSC Files: Lot
                    63 D 351.</p>
            </note>
        </listAnnotation>
