    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d173-f1" n="1" type="source" xml:id="d173-f1-content">
                <p>Source: Transmits summary of NASC discussion of paragraph 62 of NSC 5906 on
                    military exploitation of space programs. Confidential. 3 pp. NARA, RG 59,
                    S/P–NSC Files: Lot 62 D 1, NSC 5906 Series.</p>
            </note>
        </listAnnotation>
    </standOff>
