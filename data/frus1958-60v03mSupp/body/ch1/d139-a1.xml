        <body>
            <div xml:id="d139-a1">

                <pb facs="0763" n="658" sameAs="frus:frus1958-60v03mSupp/pg658"/>


                <head>Letter From Rogers to Gray</head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1959-02-25">February 25,
                        1959</date></dateline>
                    <salute>Dear Mr. Gray:</salute>
                </opener>
                <pb facs="d139-5" n="5" type="facsimile" xml:id="d139-5"/>
                <p>I am enclosing, for your information, a copy of a letter which I have addressed
                    to the Director of the Bureau of the Budget, following the discussions of the
                    Port Security Screening Program in Secretary Anderson’s Office.</p>
                <p>Sincerely,</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">/s/ William P. Rogers</hi>
                        <lb/>
                        <hi rendition="#italic">Attorney General</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
