    <text>
        <body>
            <div xml:id="d522-a2">

                <pb facs="2028" n="1923" sameAs="frus:frus1958-60v03mSupp/pg1923"/>


                <head>Memorandum of Conversation Between Eisenhower and Herter</head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" type="conversation-or-meeting-date"
                            when="1960-01-23T08:30:00-05:00">January 23, 1960, 8:30
                        a.m.</date></dateline>
                </opener>
                <pb facs="d522-3" n="3" type="facsimile" xml:id="d522-3"/>
                <p>In a conversation with the President this morning, he approved the draft of the
                    letter to Selwyn Lloyd on the Nuclear
                    Test negotiations with the inclusion of the sentence which stated that he had
                    been consulted and approved of the policy outlined.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Christian A.
                            Herter</hi>
                    </signed>
                </closer>
            </div>
        </body>
