    <text>
        <body>
            <div xml:id="d439">

                <pb facs="1701" n="1596" xml:id="pg1596"/>

                <head>439. Note From Caccia to Herter<anchor n="1" xml:id="d439-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1959-03-13">March 13, 1959</date></dateline>
                    <salute>Dear Chris,</salute>
                </opener>
                <pb facs="d439-1" n="1" type="facsimile" xml:id="d439-1"/>
                <p>I enclose for your personal information a copy of a letter from the Prime
                    Minister which I have delivered to the President.</p>
                <p>Your sincerely</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Harold Caccia</hi>
                    </signed>
                </closer>



                <xi:include href="d439-a1.xml" xpointer="d439-a1"/>
                <xi:include href="d439-a2.xml" xpointer="d439-a2"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d439-f1" n="1" type="source" xml:id="d439-f1-content">
                <p>Source: Transmits a copy of a letter from Macmillan to Eisenhower agreeing to a
                    recess of nuclear testing suspension talks. Secret. 6 pp. NARA, RG 59,
                    Presidential Correspondence: Lot 66 D 204, Macmillan to Eisenhower.</p>
            </note>
        </listAnnotation>
    </standOff>
