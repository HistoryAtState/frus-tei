    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d597-f1" n="1" type="source" xml:id="d597-f1-content">
                <p>Source: Approves Gray’s proposed amendments to statement of functions for the new
                    U.S. Disarmament Administration. No classification marking. 6 pp. Eisenhower
                    Library, White House Office Files, Project Clean Up, State Department.</p>
            </note>
        </listAnnotation>
