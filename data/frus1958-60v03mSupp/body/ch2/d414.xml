        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d414-f1" n="1" type="source" xml:id="d414-f1-content">
                <p>Source: Transmits papers for meeting on seismic improvement. Confidential. 8 pp.
                    Eisenhower Library, White House Office Files, Project Clean Up, Suspension of
                    Nuclear Testing.</p>
            </note>
        </listAnnotation>
    </standOff>
