                <head>Memorandum From Gray to Dillon, Gates,
                        McCone, Allen Dulles, and Kistiakowsky</head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1959-09-16">September 16,
                        1959</date></dateline>
                </opener>
                <pb facs="d497-4" n="4" type="facsimile" xml:id="d497-4"/>
                <p>Please note the attached documents which should be considered in the next meeting
                    of the principals.</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Gordon
                            Gray</hi>
                        <lb/>
                        <hi rendition="#italic">Special Assistant to the President</hi>
                    </signed>
                </closer>
