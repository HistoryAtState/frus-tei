        <body>
            <div xml:id="d564-a1">

                <pb facs="2163" n="2058" sameAs="frus:frus1958-60v03mSupp/pg2058"/>


                <head>List of Participants</head>
                <pb facs="d564-6" n="6" type="facsimile" xml:id="d564-6"/>
                <p rendition="#center"><hi rendition="#italic">Participants of Meeting of Principals
                        on Nuclear Test Negotiations on May 10, 1960</hi></p>
                <list subtype="participants" type="description">
                    <item><list>
                            <item><hi rendition="#italic">Department of State:</hi></item>
                            <item>Secretary Herter</item>
                            <item>Under Secretary Dillon</item>
                            <item>S/AE—Mr. Farley, Mr. Sullivan, Mr.
                                    Spiers, Mr. Baker, Mr.
                                Gotzlinger</item>
                            <item>S/S—Mr. Lau</item>
                            <item>SOV—Mr. Dubs</item>
                        </list></item>
                    <item><list>
                            <item><hi rendition="#italic">White House:</hi></item>
                            <item>Dr. Kistiakowsky, Mr.
                                Gray, Mr. Sochler</item>
                        </list></item>
                    <item><list>
                            <item><hi rendition="#italic">AEC:</hi></item>
                            <item>Mr. McCone, Dr. English</item>
                        </list></item>
                    <item><list>
                            <item><hi rendition="#italic">CIA:</hi></item>
                            <item>Mr. Dulles, Dr. Scoville</item>
                        </list></item>
                    <item><list>
                            <item><hi rendition="#italic">DOD:</hi></item>
                            <item>Secretary Gates</item>
                            <item>Mr. Irwin, Gen. Dabnoy, Gen. Potts, Gen. Roderhauser, Dr.
                                Northrup, Mr. Ranier, Col. Brundage, Dr. Latter, Dr. Karzac, Lcdr.
                                Chandler</item>
                        </list></item>
                </list>
            </div>
        </body>
