    <text>
        <body>
            <div xml:id="d537">

                <pb facs="2066" n="1961" xml:id="pg1961"/>

                <head>537. Note From Caccia to Herter<anchor n="1" xml:id="d537-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1960-03-07">March 7, 1960</date></dateline>
                    <salute>Dear Chris,</salute>
                </opener>
                <pb facs="d537-1" n="1" type="facsimile" xml:id="d537-1"/>
                <p>I have been asked to pass to you the attached personal message from the Foreign
                    Secretary.</p>
                <p>Yours sincerely</p>
                <closer>
                    <signed>
                        <hi rendition="#bold">Harold Caccia</hi>
                    </signed>
                </closer>


                <xi:include href="d537-a1.xml" xpointer="d537-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d537-f1" n="1" type="source" xml:id="d537-f1-content">
                <p>Source: Transmits letter from Lloyd to Herter: applauds compromise on nuclear
                    testing talks position. Secret. 3 pp. NARA, RG 59, Presidential Correspondence:
                    Lot 66 D 204, U.K. Officials Correspondence with Secretary Herter.</p>
            </note>
        </listAnnotation>
    </standOff>
