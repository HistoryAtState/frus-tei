    <text>
        <body>
            <div xml:id="d585">

                <pb facs="0891" n="873" xml:id="pg873"/>

                <note rend="inline" type="source">740.00119 Control (Italy)/1–247: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in the Soviet Union</hi> (<hi rendition="#italic">Smith</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">secret</hi></seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Moscow</hi></placeName>, <date calendar="gregorian"
                            when="1947-01-02T18:00:00+03:00">January 2, 1947—6
                        p.m.</date><lb/>[Received January 2—3:20 p.m.]</dateline>
                </opener>
                <p>10. Embtel 3906, October 19, 1 p.m.<anchor n="68" xml:id="d585-f1"/> In recent
                    conversation Molotov told British Ambassador<anchor n="69" xml:id="d585-f2"/>
                    that Soviet Govt had no objection to abolition of Alcorn Italy and that written
                    communication to this effect would be forthcoming shortly.</p>
                <closer><signed><hi rendition="#small-caps">Smith</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
