            </note>
            <note corresp="#d563-f3" n="25" xml:id="d563-f3-content">
                <p>Douglas MacArthur II, Second Secretary of Embassy in France.</p>
            </note>
            <note corresp="#d563-f4" n="26" xml:id="d563-f4-content">
                <p>Georges Bidault, French Minister for Foreign Affairs.</p>
            </note>
        </listAnnotation>
