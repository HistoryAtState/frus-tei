    <text>
        <body>
            <div xml:id="d295">

                <pb facs="0453" n="435" sameAs="frus:frus1946v05/pg435"/>

                <note rend="inline" type="source">851.00/5–346</note>
                <head><hi rendition="#italic">Memorandum by the Secretary of War</hi> (<hi
                        rendition="#italic">Patterson</hi>) <hi rendition="#italic">to the Acting
                        Secretary of State</hi></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">top secret</hi></seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1946-05-03">3 May 1946</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Mr. Acheson</hi>: For your information the attached
                    message, having been cleared by the President, is being dispatched to General
                        McNarney.<anchor n="52" xml:id="d295-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Robert</hi> P. <hi
                            rendition="#small-caps">Patterson</hi></signed></closer>


                <xi:include href="d295-a1.xml" xpointer="d295-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d295-f1" n="52" xml:id="d295-f1-content">
                <p>Gen. Joseph T. McNarney, Commanding General, U.S. Forces, European Theater.</p>
            </note>
        </listAnnotation>
