            <div xml:id="d315">

                <pb facs="0489" n="471" sameAs="frus:frus1946v05/pg471"/>

                <note rend="inline" type="source">851.00B/12–2046</note>
                <head><hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic">Caffery</hi>) <hi
                        rendition="#italic">to the Director of the Office of European Affairs</hi>
                        (<hi rendition="#italic"
                    >Matthews</hi>)</head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">top secret</hi></seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1946-11-26">November 26, 1946</date>.<lb/>[Received December
                        2.]</dateline>
                </opener>
                <p><hi rendition="#small-caps">Dear Doc</hi>: I suggest that you have a look at
                    Norris Chipman’s memorandum no. 345, dated November 23, 1946.</p>
                <p>Very sincerely yours,</p>
                <closer><signed><hi rendition="#small-caps">Jefferson Caffery</hi></signed></closer>


                <xi:include href="d315-a1.xml" xpointer="d315-a1"/>
