    <text>
        <body>
            <div xml:id="d717">

                <pb facs="1069" n="1051" sameAs="frus:frus1946v05/pg1051"/>

                <note rend="inline" type="source">852.00/3–746</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Soviet Chargé</hi> (<hi rendition="#italic"
                            >Novikov</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1946-03-12">March 12, 1946</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: Acknowledgment is made of the receipt of
                    your Note dated March 7, 1946, informing me that the Soviet Government shared
                    the opinion of the French Government, that the question of the situation in
                    Spain should be submitted to the Security Council.</p>
                <p>There is enclosed a statement of the views of the Government of the United States
                    on this question, as they were communicated to the French Government in
                        Paris.<anchor n="43" xml:id="d717-f1"/></p>
                <p>Accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps">James F. Byrnes</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d717-f1" n="43" xml:id="d717-f1-content">
                <p>See telegram 1096, March 8, <hi rendition="#italic">supra</hi>.</p>
