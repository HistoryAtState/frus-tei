                <pb facs="0877" n="765" sameAs="frus:frus1919Russia/pg765"/>

                <note rend="inline" type="source">Paris Peace Conference 861 K.00/85</note>
                <head><hi rendition="#italic">The Secretariat-General of the
                            Paris Peace Conference to the Secretariat of
                            the Commission to Negotiate Peace</hi></head>
                <opener><seg rendition="#center">[Translation]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1919-07-12"><hi rendition="#italic">July 12,
                        1919</hi></date>.</dateline></opener>
                <p>The Secretariat-General of the Peace Conference has the honor to transmit
                    herewith to the Secretariat of the Delegation of the <pb facs="0878" n="766"
                        xml:id="pg766"/> United States of America a copy of a note dated June 26
                        [<hi rendition="#italic">28</hi>] signed by a certain number of Russian
                    Delegations.</p>


                <xi:include href="d891-a1.xml" xpointer="d891-a1"/>
