    <text>
        <body>
            <div xml:id="d869">

                <pb facs="0862" n="750" sameAs="frus:frus1919Russia/pg750"/>

                <note rend="inline" type="source">125.677/5a: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Chargé in
                        Russia</hi> (<hi rendition="#italic">Poole</hi>)<anchor n="1"
                        xml:id="d869-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1919-01-25T18:00:00-05:00"><hi rendition="#italic">January 25,
                                1919—6 p.m.</hi></date></dateline></opener>
                <p>461. Your 762, January 20.<anchor n="2" xml:id="d869-f2"/> Consul William Jenkins
                    with Randolph, Doolittle, Lehrs and Burri, is proceeding Odessa to open office
                    and keep in touch matters South Russia. Smith to Tiflis. For your confidential
                    information Smith intends resign after arrival Tiflis.</p>
                <closer><signed><hi rendition="#small-caps">Polk</hi></signed></closer>
            </div>
        </body>
    </text>
