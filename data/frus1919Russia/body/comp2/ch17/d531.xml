    <text>
        <body>
            <div xml:id="d531">

                <pb facs="0611" n="499" sameAs="frus:frus1919Russia/pg499"/>

                <note rend="inline" type="source">Paris Peace Conference 861.00/666</note>
                <head><hi rendition="#italic">Mr. George T. Clerk to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >London</hi></placeName>], <date calendar="gregorian"
                            when="1919-05-19"><hi rendition="#italic">May 19,
                        1919</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. Lansing</hi>: Lord Curzon desires me to
                    express his great regret that you did not get the promised note upon Siberia,
                    which I now enclose, before you left London.</p>
                <p>Believe me [etc.]</p>
                <closer><signed><hi rendition="#small-caps">George T. Clerk</hi></signed></closer>


                <xi:include href="d531-a1.xml" xpointer="d531-a1"/>
            </div>
