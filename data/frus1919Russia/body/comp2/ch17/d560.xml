                <pb facs="0631" n="519" sameAs="frus:frus1919Russia/pg519"/>

                <note rend="inline" type="source">861.00/5273: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Consul General at Irkutsk</hi> (<hi rendition="#italic">Harris</hi>),
                        <hi rendition="#italic">temporarily at Omsk</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1919-09-26T18:00:00-04:00"><hi rendition="#italic">September 26,
                                1919, 6 p.m.</hi></date></dateline></opener>
                <p>Your 398, September 24, noon. General
                        Graves has been instructed to deliver rifles immediately in
                    fulfilment of contract.</p>
                <closer><signed><hi rendition="#small-caps"
                            >Phillips</hi></signed></closer>
            </div>
        </body>
