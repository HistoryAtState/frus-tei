                <pb facs="0577" n="465" sameAs="frus:frus1919Russia/pg465"/>

                <note rend="inline" type="source">861.00/3829</note>
                <head><hi rendition="#italic">The Secretary of War</hi> (<hi rendition="#italic">Baker</hi>) <hi
                        rendition="#italic">to the Acting Secretary of
                            State</hi></head>
                <opener>
                    <seg rendition="#float-left">O.C.S.</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1919-01-30"><hi rendition="#italic">January 30,
                        1919</hi></date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith for
                    your information copies of a letter<anchor n="18" xml:id="d497-f1"/> signed by
                    the representatives of the Ail-Russian Government, arrested in Omsk on November
                    18, 1918;<anchor n="19" xml:id="d497-f2"/> of a translation of the same,<anchor
                        n="18" xml:id="d497-f3"/> and of a letter of transmittal from
                        Major-General Wm. S. Graves, the
                    Commanding General, American Expeditionary Force, Siberia. Your attention is
                    invited especially to the views of General
                        Graves as expressed in his letter.</p>
                <p>Respectfully,</p>
                <closer><signed><hi rendition="#small-caps">Newton D.
                                Baker</hi></signed></closer>



                <xi:include href="d497-a1.xml" xpointer="d497-a1"/>
            </div>
        </body>
    </text>
