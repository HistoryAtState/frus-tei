    <text>
        <body>
            <div xml:id="d273">

                <pb facs="0367" n="255" sameAs="frus:frus1919Russia/pg255"/>

                <note rend="inline" type="source">861.77/690: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Consul at Vladivostok</hi> (<hi rendition="#italic"
                    >Caldwell</hi>)</head>
                <opener><seg rendition="#center">[Extract]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1919-02-27T16:00:00-05:00"><hi rendition="#italic">February 27,
                                1919, 4 p.m.</hi></date></dateline></opener>
                <p>For Morris.</p>
                <p>Your February 24, 10 a.m. Please transmit following message to Smith<anchor n="58" xml:id="d273-f1"/> from
                    Department: <quote rend="blockquote">
                        <p>“You are hereby appointed American representative on the Inter-Allied
                            Committee organized to undertake the supervision of the Siberian
                            Railways …”</p>
                    </quote></p>
                <p rendition="#center">. . . . . . .</p>
                <closer><signed><hi rendition="#small-caps"
                            >Polk</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d273-f1" n="58" xml:id="d273-f1-content">
                <p>See telegram from the Ambassador in Japan, Feb. 6, 1919, 4 p.m., <ref
                        target="#pg249">p. 249</ref>.</p>
            </note>
