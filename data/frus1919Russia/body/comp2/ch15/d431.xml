    <text>
        <body>
            <div xml:id="d431">

                <pb facs="0524" n="412" sameAs="frus:frus1919Russia/pg412"/>

                <note rend="inline" type="source">861.00/4954: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Consul General at Irkutsk</hi> (<hi rendition="#italic">Harris</hi>), <hi
                        rendition="#italic">temporarily at Omsk</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1919-08-12T17:00:00-04:00"><hi rendition="#italic">August 12,
                                1919, 5 p.m.</hi></date></dateline></opener>
                <p>For Morris.</p>
                <p>Referring to your July 30, 5 p.m.<anchor n="44" xml:id="d431-f1"/> President
                    informed Mission at Paris August 8, 5 p.m.,<anchor n="45" xml:id="d431-f2"/> in
                    response to direct inquiry from Mr. Clemenceau that United States with utmost regret will be unable
                    to <pb facs="0525" n="413" xml:id="pg413"/> furnish additional troops in Siberia
                    to replace Czechs in guarding the railways.</p>
                <closer><signed><hi rendition="#small-caps"
                            >Lansing</hi></signed></closer>
            </div>
        </body>
    </text>
