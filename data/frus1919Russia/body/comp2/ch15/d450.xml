    <text>
        <body>
            <div xml:id="d450">

                <pb facs="0538" n="426" xml:id="pg426"/>

                <note rend="inline" type="source">861.00/5245: Telegram</note>
                <head><hi rendition="#italic">President Wilson to the Acting Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Los Angeles</hi></placeName>, <date calendar="gregorian"
                            when="1919-09-20"><hi rendition="#italic">September 20,
                        1919</hi></date>.<lb/>[Received September 21, 12:44
                    a.m.]</dateline></opener>
                <p>I fully approve of your proposals with regard to the Czechoslovak forces in
                    Siberia and with regard to furnishing such supplies as are available to the
                    forces under Kolchak, and authorize you to show this telegram to the Secretary
                    of the Treasury, the Secretary of War and the Chairman of the Shipping
                    Board.</p>
                <closer><signed><hi rendition="#small-caps">Woodrow Wilson</hi></signed></closer>
            </div>
        </body>
