                <pb facs="0559" n="447" sameAs="frus:frus1919Russia/pg447"/>

                <note rend="inline" type="source">861.00/5869</note>
                <head><hi rendition="#italic">The Russian Chargé</hi> (<hi
                            rendition="#italic">De Bach</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1919-11-18"><hi rendition="#italic">November 18,
                        1919</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: In the absence of the
                    Ambassador, I have the honor to submit to you the translation of a note which
                    the Russian Embassy is instructed to transmit to the United States
                    Government.</p>
                <p>I avail [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Henry de
                        Bach</hi></signed></closer>



                <xi:include href="d477-a1.xml" xpointer="d477-a1"/>
