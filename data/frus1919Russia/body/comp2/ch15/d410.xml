    <text>
        <body>
            <div xml:id="d410">

                <pb facs="0499" n="387" sameAs="frus:frus1919Russia/pg387"/>

                <note rend="inline" type="source">861.51/621: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >Reinsch</hi>) <hi rendition="#italic">to the Acting Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date
                            ana="#date_undated-inferred-from-document-content" calendar="gregorian"
                            notAfter="1919-06-28T14:15:00-05:00"
                            notBefore="1919-06-27T16:00:00+04:53"><hi rendition="#italic"
                                >undated</hi></date>.<lb/>[Received June 28, 1919, 2:15
                        p.m.]</dateline></opener>
                <p>Following from [Harris at] Omsk.</p>
                <p>“288. June 27, 4 p.m. Referring to Department’s June 23, 2 p.m.<anchor n="13"
                        xml:id="d410-f1"/> For financial and political reasons Omsk Government
                    desires American Government loan: $325,000,000 desired, $125,000,000 to cancel
                    earlier loans made in United States and $200,000,000 for establishing credit
                    wherewith to facilitate purchase of commercial commodities in the United States.
                        Harris.”<anchor n="14" xml:id="d410-f2"/></p>
                <closer><signed><hi rendition="#small-caps">Reinsch</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d410-f1" n="13" xml:id="d410-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d410-f2" n="14" xml:id="d410-f2-content">
                <p>Notation on telegram: “Conferred with Ughet and explained no loans to
                    unrecognized government. 7/14 B[reckinridge] L[ong].”</p>
            </note>
        </listAnnotation>
    </standOff>
