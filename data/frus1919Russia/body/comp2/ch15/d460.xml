    <text>
        <body>
            <div xml:id="d460">

                <pb facs="0548" n="436" sameAs="frus:frus1919Russia/pg436"/>

                <note rend="inline" type="source">861.51/675: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Consul General at Irkutsk</hi> (<hi rendition="#italic">Harris</hi>), <hi
                        rendition="#italic">temporarily at Omsk</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1919-09-30T17:00:00-04:00"><hi rendition="#italic">September 30,
                                1919, 5 p.m.</hi></date></dateline></opener>
                <p>Your September 20, 10 a.m.<anchor n="76" xml:id="d460-f1"/> Loan has since gone
                    through in regular course.</p>
                <p>Department did everything possible in circumstances and told bankers we were
                    committed to support Kolchak.</p>
                <closer><signed><hi rendition="#small-caps"
                            >Lansing</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d460-f1" n="76" xml:id="d460-f1-content">
                <p>Transmitted in telegram from the Chargé in China, Sept. 22, <ref target="#pg430"
                        >p. 430</ref>.</p>
            </note>
