    <text>
        <body>
            <div xml:id="d441">

                <pb facs="0532" n="420" xml:id="pg420"/>

                <note rend="inline" type="source">123M832/34: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >Reinsch</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1919-08-24"><hi rendition="#italic">August 24,
                        1919</hi></date>.<lb/>[Received 8:22 a.m.]</dateline></opener>
                <p>From [Harris at] Omsk.</p>
                <p>“356, August 23, 1 p.m. Morris and Graves leave for Vladivostok today. I am
                    remaining Omsk for the purpose of evacuating Red Cross and other American
                    interests if necessary. Harris.[”]</p>
                <closer><signed><hi rendition="#small-caps">Reinsch</hi></signed></closer>
            </div>
        </body>
