    <text>
        <body>
            <div xml:id="d638">

                <pb facs="0691" n="579" sameAs="frus:frus1919Russia/pg579"/>

                <note rend="inline" type="source">861.77/1056: Telegram</note>
                <head><hi rendition="#italic">The President of the Technical Board</hi> (<hi
                        rendition="#italic">Stevens</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Harbin</hi></placeName>, <date calendar="gregorian"
                            when="1919-09-04T16:00:00+08:26"><hi rendition="#italic">September 4,
                                1919, 4 p.m.</hi></date><lb/>[Received 12:30
                    p.m.]</dateline></opener>
                <p>Your cable August 21st, 5 p.m.<anchor n="33" xml:id="d638-f1"/> Allied inspectors
                    have not been withdrawn from Semenoff territory.</p>
                <closer><signed><hi rendition="#small-caps">Stevens</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d638-f1" n="33" xml:id="d638-f1-content">
                <p>Not printed; see telegram to the Consul at Vlaidvostok, Aug. 21, 4 p.m., <ref
                        target="#pg572">p. 572</ref>.</p>
            </note>
        </listAnnotation>
