        <body>
            <div xml:id="d745">

                <pb facs="0774" n="662" xml:id="pg662"/>

                <note rend="inline" type="source">123 C 673/38: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Russia</hi> (<hi rendition="#italic">Cole</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Archangel</hi></placeName>, <date calendar="gregorian"
                            when="1919-09-14T09:00:00+03:00"><hi rendition="#italic">September 14,
                                1919, 9 a.m.</hi></date><lb/>[Received 11:55
                    p.m.]</dateline></opener>
                <p>1417. Leaving this morning to London with Flack and Strother. Please inform
                    families.</p>
                <closer><signed><hi rendition="#small-caps"
                            >Cole</hi></signed></closer>
            </div>
        </body>
