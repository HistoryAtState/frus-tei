    <text>
        <body>
            <div xml:id="d740">

                <pb facs="0771" n="659" sameAs="frus:frus1919Russia/pg659"/>

                <note rend="inline" type="source">861.00/5145: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Russia</hi> (<hi rendition="#italic"
                        >Cole</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Archangel</hi></placeName>, <date calendar="gregorian"
                            when="1919-09-03T13:00:00+03:00"><hi rendition="#italic">September 3,
                                1919, 1 p.m.</hi></date><lb/>[Received September 4, 7:34
                        a.m.]</dateline></opener>
                <p>1403. All American private individuals have now left Archangel except several
                    officers detailed for special work in Archangel by General Richardson.</p>
                <closer><signed><hi rendition="#small-caps">Cole</hi></signed></closer>
            </div>
        </body>
