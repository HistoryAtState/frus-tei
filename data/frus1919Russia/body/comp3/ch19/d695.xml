    <text>
        <body>
            <div xml:id="d695">

                <pb facs="0741" n="629" sameAs="frus:frus1919Russia/pg629"/>

                <note rend="inline" type="source">861.00/4318: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Russia</hi> (<hi rendition="#italic">Poole</hi>) <hi
                        rendition="#italic">to the Acting Secretary of
                            State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Archangel</hi></placeName>, <date calendar="gregorian"
                            when="1919-04-18T17:00:00+03:31"><hi rendition="#italic">April 18, 1919,
                                5 p.m.</hi></date><lb/>[Received April 19, 5:49
                    a.m.]</dateline></opener>
                <p>1091. General Richardson<anchor n="32"
                        xml:id="d695-f1"/> arrived yesterday. I had a very satisfactory talk with
                    him this morning. There is every reason to anticipate hearty co-operation.</p>
                <closer><signed><hi rendition="#small-caps"
                            >Poole</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d695-f1" n="32" xml:id="d695-f1-content">
                <p>Brig. Gen. Wilds P. Richardson, U.S.A.,
                    commanding American troops in northern Russia.</p>
            </note>
        </listAnnotation>
    </standOff>
