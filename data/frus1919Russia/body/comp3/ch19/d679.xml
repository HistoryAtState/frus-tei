    <text>
        <body>
            <div xml:id="d679">

                <pb facs="0730" n="618" sameAs="frus:frus1919Russia/pg618"/>

                <note rend="inline" type="source">861.00/3848: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Chargé in Russia</hi> (<hi rendition="#italic">Poole</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1919-02-26T17:00:00-05:00"><hi rendition="#italic">February 26,
                                1919, 5 p.m.</hi></date></dateline></opener>
                <p>514. Your 958 [<hi rendition="#italic">858</hi>], February 13, 5 p.m.</p>
                <p>Secretary of War believes that notice through press, and letter of Secretary to
                    Senate and House Military Committees<anchor n="17" xml:id="d679-f1"/> make
                    unnecessary statement you propose.</p>
                <closer><signed><hi rendition="#small-caps"
                            >Polk</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d679-f1" n="17" xml:id="d679-f1-content">
                <p>See telegram to the Chargé in Russia, no. 507, Feb. 24, <hi rendition="#italic"
                        >ante</hi>, <ref target="#pg617">p. 617</ref>.</p>
            </note>
