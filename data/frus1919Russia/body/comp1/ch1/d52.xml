    <text>
        <body>
            <div xml:id="d52">

                <pb facs="0186" n="74" xml:id="pg74"/>

                <note rend="inline" type="source">Paris Peace Conference 184.00101/25</note>
                <head><hi rendition="#italic">Minutes of the Meetings of the American Commissioners
                        Plenipotentiary, March 1, 1919</hi></head>
                <dateline>
                    <date ana="#date_undated-inferred-from-document-head" calendar="gregorian"
                        when="1919-03-01">March 1, 1919</date>
                </dateline>
                <opener><seg rendition="#center">[Extracts]</seg></opener>
                <list subtype="participants" type="description">
                    <item><hi rendition="#small-caps">Present</hi>: Mr. Lansing, Mr. White,
                            General Bliss, Mr. H. R. Wilson.</item>
                </list>
                <p rendition="#center">. . . . . . .</p>
                <p rendition="#center">11</p>
                <p>Mr. Wilson introduced Memorandum No
                        121<anchor n="64" xml:id="d52-f1"/> concerning Prof. Herron and Mr.
                        White.<anchor n="65" xml:id="d52-f2"/>
                    The Commissioners decided that Prof Herron and Mr. White should not remain attached to the Commission in view of
                    the present situation concerning Prinkipo, nor should they proceed with the
                    organization of their delegation.</p>
                <p rendition="#center">. . . . . . .</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d52-f1" n="64" xml:id="d52-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d52-f2" n="65" xml:id="d52-f2-content">
                <p>George D. Herron and William Allen
                        White had been selected to represent the United States at the
                    Prinkipo Conference.</p>
            </note>
        </listAnnotation>
    </standOff>
