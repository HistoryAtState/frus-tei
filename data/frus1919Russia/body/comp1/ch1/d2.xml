    <text>
        <body>
            <div xml:id="d2">

                <pb facs="0114" n="2" sameAs="frus:frus1919Russia/pg2"/>

                <note rend="inline" type="source">861.00/3526: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Commission to
                        Negotiate Peace</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1918-12-27T20:00:00-05:00"><hi rendition="#italic">December 27,
                                1918, 8 p.m.</hi></date></dateline></opener>
                <p>14. For Secretary Lansing. Referring telegram 24th from Legation Stockholm
                    regarding peace proposal of the Russian Federative Republic of Soviets. The
                    Department believes it to be a matter for consideration by the Associated
                    Governments and therefore, requests instructions as to what action, if any,
                    should be taken by the Department here.</p>
                <closer><signed><hi rendition="#small-caps">Polk</hi></signed></closer>
            </div>
        </body>
