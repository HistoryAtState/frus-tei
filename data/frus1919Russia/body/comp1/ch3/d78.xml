    <text>
        <body>
            <div xml:id="d78">

                <pb facs="0221" n="109" sameAs="frus:frus1919Russia/pg109"/>

                <note rend="inline" type="source">Paris Peace Conference 861.48/42</note>
                <head><hi rendition="#italic">The Russian Ambassador to the United States</hi> (<hi
                        rendition="#italic">Bakhmeteff</hi>) <hi rendition="#italic">to the
                        Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1919-05-07"><hi rendition="#italic">May 7,
                        1919</hi></date>.<lb/>[Received in Paris May 8.]</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I have the honor of
                    transmitting to you herewith a statement signed by the representatives of the
                    unified <pb facs="0222" n="110" xml:id="pg110"/> National Governments of Russia,
                    with regard to the proposal made by Dr. Nansen to relieve famine stricken
                    districts of Russia.</p>
                <p>Accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps">B. Bakhmeteff</hi></signed></closer>


                <xi:include href="d78-a1.xml" xpointer="d78-a1"/>
            </div>
        </body>
    </text>
