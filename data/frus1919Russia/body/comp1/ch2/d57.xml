                <pb facs="0187" n="75" sameAs="frus:frus1919Russia/pg75"/>

                <note rend="inline" type="source">861.00/4039: Telegram</note>
                <head><hi rendition="#italic">The Vice Consul at Viborg</hi> (<hi
                        rendition="#italic">Imbrie</hi>) <hi rendition="#italic">to the Acting
                        Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Viborg</hi></placeName>, <date calendar="gregorian"
                            when="1919-03-08"><hi rendition="#italic">March 8,
                        1919</hi></date>.<lb/>[Received March 9, 2:45 p.m.]</dateline></opener>
                <p>6. William Bullitt and party from American Mission Paris crossed border into
                    Russia today at 1 p.m.</p>
                <closer><signed><hi rendition="#small-caps">Imbrie</hi></signed></closer>
            </div>
