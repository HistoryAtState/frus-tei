                <pb facs="0826" n="714" sameAs="frus:frus1919Russia/pg714"/>

                <note rend="inline" type="source">Paris Peace Conference 861 E.00/180</note>
                <head><hi rendition="#italic">The Secretariat-General of the
                            Paris Peace Conference to the Secretariat of
                            the Commission to Negotiate Peace</hi></head>
                <opener><seg rendition="#center">[Translation]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1919-09-30"><hi rendition="#italic">September 30,
                        1919</hi></date>.</dateline></opener>
                <p>The Secretariat-General of the Peace Conference has the honor to transmit
                    herewith to the Secretariat of the Delegation of the United States of America a
                    copy of a letter addressed by the President of the Esthonian Delegation to the
                    President of the Peace Conference relative to the negotiations of the Baltic
                    States with the Soviet Republic.</p>



                <xi:include href="d817-a1.xml" xpointer="d817-a1"/>
