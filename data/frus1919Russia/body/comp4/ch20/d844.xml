                <pb facs="0848" n="736" sameAs="frus:frus1919Russia/pg736"/>

                <note rend="inline" type="source">861.00/5561: Telegram</note>
                <head><hi rendition="#italic">The Commissioner at Helsingfors</hi> (<hi rendition="#italic">Haynes</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Helsingfors</hi></placeName>, <date calendar="gregorian"
                            when="1919-11-03T19:00:00+01:39"><hi rendition="#italic">November 3,
                                1919—7 p.m.</hi></date><lb/>[Received 9:27 p.m.]</dateline></opener>
                <p>489. Officially reported Yudenitch has
                    retreated from Gatchina and Luga and both places taken by Bolsheviki.</p>
                <closer><signed><hi rendition="#small-caps"
                        >Haynes</hi></signed></closer>
            </div>
        </body>
