                <pb facs="0838" n="726" sameAs="frus:frus1919Russia/pg726"/>

                <note rend="inline" type="source">861.00/5452: Telegram</note>
                <head><hi rendition="#italic">The Vice Consul at Viborg</hi> (<hi rendition="#italic">Imbrie</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Viborg</hi></placeName>, <date calendar="gregorian"
                            when="1919-10-22"><hi rendition="#italic">October 22,
                        1919</hi></date>.<lb/>[Received October 23, 5:33 a.m.]</dateline></opener>
                <p>124. Fighting continues outskirts of Petrograd. Whites unable to advance.
                    Bolsheviks bringing up reinforcements.</p>
                <closer><signed><hi rendition="#small-caps"
                        >Imbrie</hi></signed></closer>
            </div>
        </body>
