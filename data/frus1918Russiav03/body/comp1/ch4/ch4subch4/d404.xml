    <text>
        <body>
            <div xml:id="d404">

                <pb facs="0306" n="256" sameAs="frus:frus1918Russiav03/pg256"/>

                <note rend="inline" type="source">File No. 861.77/480</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Chargé in China</hi> (<hi
                            rendition="#italic">MacMurray</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1918-09-17T19:00:00-04:00"><hi rendition="#italic">September 17,
                                1918, 7 p.m.</hi></date></dateline>
                </opener>
                <p>Your September 16, 5 p.m. This Government does not insist upon the present
                    elimination of Horvat as an official of
                    the railway.</p>
                <closer>
                    <signed><hi rendition="#small-caps"
                            >Lansing</hi></signed>
                </closer>
            </div>
