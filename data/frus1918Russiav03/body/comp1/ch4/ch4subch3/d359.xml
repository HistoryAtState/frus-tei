    <text>
        <body>
            <div xml:id="d359">

                <pb facs="0279" n="229" sameAs="frus:frus1918Russiav03/pg229"/>

                <note rend="inline" type="source">File No. 861.77/359</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Consul at Harbin</hi> (<hi
                            rendition="#italic">Moser</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1918-04-10T17:00:00-04:00"><hi rendition="#italic">April 10, 1918,
                                5 p.m.</hi></date></dateline>
                </opener>
                <p>For Stevens from Felton:<anchor n="1" xml:id="d359-f1"/></p>
                <p>Your April 10, 11 a.m., just received. Russian Embassy and Department gratified.
                    Your work regarded as of prime importance and once abandoned very difficult to
                    resume. Keep us advised your progress.</p>
                <closer>
                    <signed><hi rendition="#small-caps"
                            >Lansing</hi></signed>
                </closer>
            </div>
        </body>
    </text>
