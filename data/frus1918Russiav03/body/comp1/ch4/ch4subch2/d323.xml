    <text>
        <body>
            <div xml:id="d323">

                <pb facs="0263" n="213" sameAs="frus:frus1918Russiav03/pg213"/>

                <note rend="inline" type="source">File No. 861.77/341</note>
                <head><hi rendition="#italic">The Russian Ambassador</hi> (<hi rendition="#italic"
                        >Bakhmeteff</hi>) <hi rendition="#italic">to the Counselor for
                        the Department of State</hi> (<hi
                            rendition="#italic">Polk</hi>)</head>
                <opener>
                    <seg rendition="#float-left">No. 1233</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1917-12-20"><hi rendition="#italic">December 20, 1917</hi></date>.
                        <lb/> [<hi rendition="#italic">Received December 21.</hi>]</dateline>
                </opener>
                <p><hi rendition="#small-caps">My Dear Mr. Polk</hi>: Acknowledging the receipt of your letter of
                    December 18,<anchor n="1" xml:id="d323-f1"/> I beg to thank you for the
                    information you give concerning the Russian Railway Service Corps.</p>
                <p>I wish hereby to confirm to you that I am absolutely in sympathy with the plan of
                    keeping the corps in Japan for a reasonable time and consider that the expenses
                    which this will incur should be charged against the credits of the Russian
                    Government.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed><hi rendition="#small-caps">B.
                                Bakhmeteff</hi></signed>
                </closer>
            </div>
        </body>
    </text>
