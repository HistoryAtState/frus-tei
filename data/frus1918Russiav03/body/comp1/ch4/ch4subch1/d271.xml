                <pb facs="0238" n="188" sameAs="frus:frus1918Russiav03/pg188"/>

                <note rend="inline" type="source">File No. 861.77/59</note>
                <head><hi rendition="#italic">The Ambassador in Russia</hi> (<hi rendition="#italic"
                        >Francis</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Petrograd</hi></placeName>, <date calendar="gregorian"
                            when="1917-04-24T18:00:00+02:31"><hi rendition="#italic">April 24, 1917,
                                6 p.m.</hi></date>
                        <lb/> [<hi rendition="#italic">Received April 25, 10 a.m.</hi>]</dateline>
                </opener>
                <p>1218. Your 1345. Urgently recommend commission of railroad experts be sent
                    Vladivostok immediately. …</p>
                <closer>
                    <signed><hi rendition="#small-caps"
                            >Francis</hi></signed>
                </closer>
            </div>
