    <text>
        <body>
            <div xml:id="d278">

                <pb facs="0242" n="192" xml:id="pg192"/>

                <note rend="inline" type="source">File No. 861.77/99</note>
                <head><hi rendition="#italic">The Chairman of the Advisory Commission of Railway
                        Experts to Russia</hi> (<hi rendition="#italic">Stevens</hi>) <hi
                        rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Petrograd</hi></placeName>, <date calendar="gregorian"
                            when="1917-06-13"><hi rendition="#italic">June 13, 1917</hi></date>.
                        <lb/> [<hi rendition="#italic">Received June 16, 12.50 p.m.</hi>]</dateline>
                </opener>
                <p>1388.<anchor n="1" xml:id="d278-f1"/> Railway commission arrived here 12th. All
                    very well. Please publish benefit of friends.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Stevens</hi></signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d278-f1" n="1" xml:id="d278-f1-content">
                <p>The Embassy’s number.</p>
