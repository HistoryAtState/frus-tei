            <div xml:id="d86">

                <pb facs="0117" n="67" xml:id="pg67"/>

                <note rend="inline" type="source">File No. 861.00/2504</note>
                <head><hi rendition="#italic">The Secretary of State to the Ambassador in
                        Russia</hi> (<hi rendition="#italic">Francis</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1918-09-12T17:00:00-04:00"><hi rendition="#italic">September 12,
                                1918, 5 p.m.</hi></date></dateline>
                </opener>
                <p>256. Department considering your 364, August 13, 8 p.m.<anchor n="1"
                        xml:id="d86-f1"/> Has received communication from British Government same
                    subject of currency.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Lansing</hi></signed>
                </closer>
            </div>
        </body>
    </text>
