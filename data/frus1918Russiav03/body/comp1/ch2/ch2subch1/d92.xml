    <text>
        <body>
            <div xml:id="d92">

                <pb facs="0121" n="71" sameAs="frus:frus1918Russiav03/pg71"/>

                <note rend="inline" type="source">File No. 861.00/2798</note>
                <head><hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Page</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1918-09-26T16:00:00+01:00"><hi rendition="#italic">September 26,
                                1918, 4 p.m.</hi></date>
                        <lb/> [<hi rendition="#italic">Received September 26, 1.50
                        p.m.</hi>]</dateline>
                </opener>
                <p>2228. Rathbone from Crosby:</p>
                <p>570. Referring to my No. 535.<anchor n="1" xml:id="d92-f1"/> British Treasury has
                    arranged for the issue of ruble notes in northern Russia independently of the
                    plan proposed by the French. Full details going to you by mail to-morrow.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Page</hi></signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
