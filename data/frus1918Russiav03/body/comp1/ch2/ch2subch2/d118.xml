    <text>
        <body>
            <div xml:id="d118">

                <pb facs="0145" n="95" sameAs="frus:frus1918Russiav03/pg95"/>

                <note rend="inline" type="source">File No. 861.51/379</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Consul at Vladivostok</hi> (<hi rendition="#italic"
                    >Caldwell</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1918-12-23T13:00:00-05:00"><hi rendition="#italic">December 23,
                                1918, 1 p.m.</hi></date></dateline>
                </opener>
                <p>Your 221, October 23, 8 p.m.<anchor n="1" xml:id="d118-f1"/> War Department
                    willing to assume expense of printing such notes as may be required for use of
                    American military expeditionary forces in Siberia. Please inform General Graves<anchor n="2" xml:id="d118-f2"/>
                    and Heid<anchor n="3" xml:id="d118-f3"/>
                    and report what further action, if any, required on part of this Department. No
                    objection to attending conferences informally.</p>
                <closer>
                    <signed><hi rendition="#small-caps"
                            >Polk</hi></signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d118-f1" n="1" xml:id="d118-f1-content">
                <p><hi rendition="#italic">Ante</hi>, <ref target="#pg78">p. 78</ref>.</p>
            </note>
            <note corresp="#d118-f2" n="2" xml:id="d118-f2-content">
                <p>Maj. Gen. William S. Graves, commanding
                    the American forces in Siberia.</p>
            </note>
            <note corresp="#d118-f3" n="3" xml:id="d118-f3-content">
                <p>August Heid, representative at Vladivostok
                    of the War Trade Board.</p>
            </note>
        </listAnnotation>
    </standOff>
