    <text>
        <body>
            <div xml:id="d123">

                <pb facs="0150" n="100" sameAs="frus:frus1918Russiav03/pg100"/>

                <note rend="inline" type="source">File No. 861.51/437</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Ambassador in Great Britain</hi> (<hi rendition="#italic">Davis</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1918-12-31T17:00:00-05:00"><hi rendition="#italic">December 31,
                                1918, 5 p.m.</hi></date></dateline>
                </opener>
                <p>3741. [From War Trade Board] for Sheldon:<anchor n="1" xml:id="d123-f1"/></p>
                <p>1961. Referring Embassy’s 4877, December 24; your 2180. Copy of our
                    recommendations to Paris<anchor n="2" xml:id="d123-f2"/> has been forwarded to
                    you and pending action by that conference nothing further will be done with
                    currency matter.</p>
                <closer>
                    <signed><hi rendition="#small-caps"
                            >Polk</hi></signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
