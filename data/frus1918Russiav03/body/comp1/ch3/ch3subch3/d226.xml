                <pb facs="0215" n="165" sameAs="frus:frus1918Russiav03/pg165"/>

                <note rend="inline" type="source">File No. 103.96/1479b</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Minister in Norway</hi> (<hi rendition="#italic"
                            >Schmedeman</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1918-11-05T17:00:00-05:00"><hi rendition="#italic">November 5,
                                1918, 5 p.m.</hi></date></dateline>
                </opener>
                <p>551. For Owen from War Trade Board:</p>
                <p>In view of rapidly changing situation, we do not desire you to proceed to
                    Archangel at least for the present. Please proceed to Stockholm with a view to
                    studying the Russian situation from there.</p>
                <closer>
                    <signed><hi rendition="#small-caps"
                            >Lansing</hi></signed>
                </closer>
            </div>
