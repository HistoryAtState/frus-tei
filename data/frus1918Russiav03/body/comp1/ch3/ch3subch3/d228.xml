    <text>
        <body>
            <div xml:id="d228">

                <pb facs="0216" n="166" xml:id="pg166"/>

                <note rend="inline" type="source">File No. 861.24/105a</note>
                <head><hi rendition="#italic">The Secretary of State to the Chargé in Sweden</hi>
                        (<hi rendition="#italic">Whitehouse</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1918-11-09T17:00:00-05:00"><hi rendition="#italic">November 9,
                                1918, 5 p.m.</hi></date></dateline>
                </opener>
                <p>1276. Please telegraph a soon as possible text of Huntington’s<anchor n="1"
                        xml:id="d228-f1"/> letter to Ambassador giving <hi rendition="#italic"
                        >résume</hi> of expenditures and materials purchased by Goods Exchange; also
                    mail copy by pouch. Huntington expresses thanks for official accounts duly
                    received.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Lansing</hi></signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d228-f1" n="1" xml:id="d228-f1-content">
                <p>William C. Huntington, Commercial Attaché.</p>
            </note>
        </listAnnotation>
    </standOff>
