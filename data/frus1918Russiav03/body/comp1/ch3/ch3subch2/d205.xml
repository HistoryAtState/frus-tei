    <text>
        <body>
            <div xml:id="d205">

                <pb facs="0196" n="146" sameAs="frus:frus1918Russiav03/pg146"/>

                <note rend="inline" type="source">File No. 861.00/2776</note>
                <head><hi rendition="#italic">The Secretary of State to the Ambassador in
                        Russia</hi> (<hi rendition="#italic">Francis</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1918-09-27T14:00:00-04:00"><hi rendition="#italic">September 27,
                                1918, 2 p.m.</hi></date></dateline>
                </opener>
                <p>275. Your 416, September 21, 5 p.m. Four steamers cleared this month for
                    Archangel with supplies. This includes Red Cross ship reported already arrived
                    Murmansk.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Lansing</hi></signed>
                </closer>
            </div>
