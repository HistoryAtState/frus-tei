            <div xml:id="d131">

                <pb facs="0155" n="105" sameAs="frus:frus1918Russiav03/pg105"/>

                <note rend="inline" type="source">File No. 861.48/417</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Ambassador in Russia</hi> (<hi
                            rendition="#italic">Francis</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1917-12-05T15:00:00-05:00"><hi rendition="#italic">December 5,
                                1917, 3 p.m.</hi></date></dateline>
                </opener>
                <p>1884. Your 2022, November 24, and 2039, November 26. Department approves
                    recommendations and will endeavor secure delivery boots for supply committee
                    northern railways. Will advise further.</p>
                <closer>
                    <signed><hi rendition="#small-caps"
                            >Lansing</hi></signed>
                </closer>
            </div>
