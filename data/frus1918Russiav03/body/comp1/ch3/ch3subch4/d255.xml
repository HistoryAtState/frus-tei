                <pb facs="0231" n="181" sameAs="frus:frus1918Russiav03/pg181"/>

                <note rend="inline" type="source">File No. 661.939/16</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >Reinsch</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1918-06-24T16:00:00+08:00"><hi rendition="#italic">June 24, 1918,
                                4 p.m.</hi></date>
                        <lb/> [<hi rendition="#italic">Received June 24, 11.22 a.m.</hi>]</dateline>
                </opener>
                <p>The Chinese Government has canceled embargo on exports to Siberia.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Reinsch</hi></signed>
                </closer>
            </div>
