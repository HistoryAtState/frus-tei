    <text>
        <body>
            <div xml:id="d259">

                <pb facs="0232" n="182" sameAs="frus:frus1918Russiav03/pg182"/>

                <note rend="inline" type="source">File No. 661.939/21</note>
                <head><hi rendition="#italic">The Secretary of State to the Chargé in China</hi>
                        (<hi rendition="#italic">MacMurray</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1918-08-21T18:00:00-04:00"><hi rendition="#italic">August 21,
                                1918, 6 p.m.</hi></date></dateline>
                </opener>
                <p>Your August 17, 8 p.m. You are authorized as you request to support the British
                    Legation in urging the Chinese Government to prohibit passage of supplies to
                    enemy forces.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Lansing</hi></signed>
                </closer>
            </div>
        </body>
