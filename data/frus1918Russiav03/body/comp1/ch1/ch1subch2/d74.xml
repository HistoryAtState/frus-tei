    <text>
        <body>
            <div xml:id="d74">

                <pb facs="0103" n="53" sameAs="frus:frus1918Russiav03/pg53"/>

                <note rend="inline" type="source">File No. 861.51/491a</note>
                <head><hi rendition="#italic">The Counselor for the Department of State</hi>
                        (<hi rendition="#italic"
                        >Polk</hi>) <hi rendition="#italic">to the Russian Financial
                        Attaché</hi> (<hi rendition="#italic"
                            >Ughet</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1918-12-03"><hi rendition="#italic">December 3,
                        1918</hi></date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I beg to inform you that this Department,
                    after conference with the Treasury Department, sees no objection to the payment
                    of interest due to-day on $25,000,000 of Russian bonds held in this country by
                    banks and private individuals.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed><hi rendition="#small-caps">Frank L.
                                Polk</hi></signed>
                </closer>
            </div>
        </body>
