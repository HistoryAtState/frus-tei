    <text>
        <body>
            <div xml:id="d42">

                <pb facs="0078" n="28" sameAs="frus:frus1918Russiav03/pg28"/>

                <note rend="inline" type="source">File No. 861.51/277</note>
                <head><hi rendition="#italic">The Special Representative</hi> (<hi
                        rendition="#italic">House</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener>
                    <seg rendition="#center">[Telegram—Extract]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1917-11-24T13:00:00+00:00"><hi rendition="#italic">November 24,
                                1917, 1 p.m.</hi></date>
                        <lb/> [<hi rendition="#italic">Received November 25, 1.40
                        a.m.</hi>]</dateline>
                </opener>
                <p>Your 5860<anchor n="2" xml:id="d42-f1"/> and 2841. In Great Britain the Russian
                    situation is considered at the moment hopeless. There is no responsible
                    government within sight. I would advise making no more advances at present or
                    permitting any further contracts for purchases. …</p>
                <closer>
                    <signed><hi rendition="#small-caps">Edward House</hi></signed>
                </closer>
            </div>
        </body>
    </text>
