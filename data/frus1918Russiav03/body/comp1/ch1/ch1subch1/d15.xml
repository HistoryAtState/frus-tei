    <text>
        <body>
            <div xml:id="d15">

                <pb facs="0061" n="11" sameAs="frus:frus1918Russiav03/pg11"/>

                <note rend="inline" type="source">File No. 861.51/157</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        Russia</hi> (<hi rendition="#italic">Francis</hi>)<anchor n="1"
                        xml:id="d15-f1"/></head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1917-07-09T17:00:00-05:00"><hi rendition="#italic">July 9, 1917, 5
                                p.m.</hi></date></dateline>
                </opener>
                <p>1552. Please advise Minister for Foreign Affairs that $75,000,000 additional
                    credit will be made available immediately for Russia as requested Root’s
                    telegram July 8.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Polk</hi></signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d15-f1" n="1" type="source" xml:id="d15-f1-content">
                <p>Sent at the request of the Secretary of the Treasury.</p>
            </note>
        </listAnnotation>
    </standOff>
