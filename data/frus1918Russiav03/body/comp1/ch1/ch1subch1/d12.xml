    <text>
        <body>
            <div xml:id="d12">

                <pb facs="0059" n="9" sameAs="frus:frus1918Russiav03/pg9"/>

                <note rend="inline" type="source">File No. 861.51/146</note>
                <head><hi rendition="#italic">The Ambassador in Russia</hi> (<hi rendition="#italic"
                        >Francis</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Petrograd</hi></placeName>, <date calendar="gregorian"
                            when="1917-05-15T20:00:00+02:31"><hi rendition="#italic">May 15, 1917, 8
                                p.m.</hi></date>
                        <lb/> [<hi rendition="#italic">Received May 17, 7.45 a.m.</hi>]</dateline>
                </opener>
                <p>1291. Your 1359.<anchor n="2" xml:id="d12-f1"/> Foreign Office now formally
                    advises me at the request of Russian Chargé d’Affaires at Washington that Mr.
                    Onou is designated by the Russian Government to sign in the name of his
                    Government the obligations and make declarations in connection with the bill for
                    credits to the Allies pending the arrival in America of Mr. Bakhmeteff.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Francis</hi></signed>
                </closer>
            </div>
        </body>
    </text>
