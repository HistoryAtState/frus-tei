    <text>
        <body>
            <div xml:id="d17">

                <pb facs="0062" n="12" sameAs="frus:frus1918Russiav03/pg12"/>

                <note rend="inline" type="source">File No. 861.51/159a</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        Russia</hi> (<hi rendition="#italic">Francis</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1917-07-12T15:00:00-05:00"><hi rendition="#italic">July 12, 1917,
                                3 p.m.</hi></date></dateline>
                </opener>
                <p>1560. Please continue to keep Department as fully advised as possible with regard
                    to political situation and your suggestions as to the extent to which our
                    Government should go in the way of financial assistance to Russia.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Polk</hi></signed>
                </closer>
            </div>
