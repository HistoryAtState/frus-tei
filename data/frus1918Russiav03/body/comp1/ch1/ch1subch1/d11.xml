    <text>
        <body>
            <div xml:id="d11">

                <pb facs="0058" n="8" sameAs="frus:frus1918Russiav03/pg8"/>

                <note rend="inline" type="source">File No. 861.51/145</note>
                <head><hi rendition="#italic">The Ambassador in Russia</hi> (<hi rendition="#italic"
                        >Francis</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Petrograd</hi></placeName>, <date calendar="gregorian"
                            when="1917-05-11T00:00:00+02:31"><hi rendition="#italic">May 11, 1917,
                                midnight</hi></date>. <lb/> [<hi rendition="#italic">Received May
                            13, 7 a.m.</hi>]</dateline>
                </opener>
                <p>1275. For Secretary of the Treasury:</p>
                <pb facs="0059" n="9" xml:id="pg9"/>
                <p>Your 1386 received to-day. May [they?] accept it and Minister for Foreign Affairs
                    says plan entirely satisfactory. Minister of Finance authorized Russian Chargé
                    d’Affaires, Washington, act for Russia until Bakhmeteff<anchor n="1"
                        xml:id="d11-f1"/> arrives about June 15.</p>
                <closer>
                    <signed><hi rendition="#small-caps">Francis</hi></signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d11-f1" n="1" xml:id="d11-f1-content">
                <p>Boris A. Bakhmeteff, head of the Russian mission to the United States, and later,
                    July 5, 1917, Ambassador at Washington.</p>
            </note>
        </listAnnotation>
    </standOff>
