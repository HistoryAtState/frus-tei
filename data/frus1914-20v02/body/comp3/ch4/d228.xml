            <div xml:id="d228">

                <pb facs="0448" n="402" sameAs="frus:frus1914-20v02/pg402"/>

                <note rend="inline" type="source">711.94/259½</note>
                <head>
                    <hi rendition="#italic"> Colonel E. M. House to the Secretary of State </hi>
                </head>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Secretary</hi>: This is the correspondence
                    about which Frank Polk spoke to you and which I am enclosing for your
                    information and files.</p>
                <p>I think of you every day, but do not try to reach you directly as I know the
                    burden you are carrying.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">E. M. House</hi>
                    </signed>
                    <lb/>
                    <dateline rendition="#float-left">
                        <placeName>
                            <hi rendition="#small-caps">New York</hi>
                        </placeName>, <date calendar="gregorian" when="1917-05-16">
                            <hi rendition="#italic">May 16, 1917</hi>
                        </date>.<lb/>[Received May 17.] </dateline>
                </closer>





