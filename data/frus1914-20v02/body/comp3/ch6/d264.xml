    <text>
        <body>
            <div xml:id="d264">

                <pb facs="0484" n="438" xml:id="pg438"/>

                <note rend="inline" type="source">793.94/583½</note>
                <head>
                    <hi rendition="#italic">President Wilson to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date
                            ana="#date_undated-inferred-from-sibling-dates" calendar="gregorian"
                            notAfter="1917-09-26T23:00:00-05:00"
                            notBefore="1917-09-25T00:00:00-05:00"><hi rendition="#italic"
                                >undated</hi></date>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Secretary</hi>: Thank you for letting me
                    have these. I spent half an hour with Viscount Ishii. I did most of the talking
                    (to let him see my <hi rendition="#underline">full</hi> thought) and he seemed
                    to agree throughout in <hi rendition="#underline">principle.</hi>
                </p>
                <closer>
                    <signed>W. W.</signed>
                </closer>
            </div>
        </body>
