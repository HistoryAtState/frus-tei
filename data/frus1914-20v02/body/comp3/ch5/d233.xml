    <text>
        <body>
            <div xml:id="d233">

                <pb facs="0455" n="409" sameAs="frus:frus1914-20v02/pg409"/>

                <note rend="inline" type="source">793.94/240</note>
                <head>
                    <hi rendition="#italic">President Wilson to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-03-12">
                            <hi rendition="#italic">12 March, 1915</hi>
                        </date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: This note seems to me
                    thorough and satisfactory,<anchor n="6" xml:id="d233-f1"/> and I hope that it
                    may be possible to despatch it promptly.</p>
                <p>I have suggested a few verbal changes.</p>
                <p>Faithfully Yours,</p>
                <closer>
                    <signed>W. W.</signed>
                </closer>
            </div>
        </body>
    </text>
