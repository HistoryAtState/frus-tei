    <text>
        <body>
            <div xml:id="d196">

                <pb facs="0409" n="363" sameAs="frus:frus1914-20v02/pg363"/>

                <note rend="inline" type="source">861.00/2145½</note>
                <head>
                    <hi rendition="#italic">President Wilson to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-06-17">
                            <hi rendition="#italic">17 June, 1918</hi>
                        </date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: There seems to me to
                    emerge from this suggestion<anchor n="51" xml:id="d196-f1"/> the shadow of a
                    plan that might be worked, with Japanese and other assistance. These
                        people<anchor n="52" xml:id="d196-f2"/> are the cousins of the Russians.</p>
                <p>Faithfully Yours,</p>
                <closer>
                    <signed>W. W.</signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d196-f1" n="51" xml:id="d196-f1-content">
                <p>See telegram of June 13, 1918, from the Minister in China, <ref
                        target="frus1918Russiav02#pg_206">
                        <hi rendition="#italic">Foreign Relations</hi>, 1918, Russia, vol. <hi
                            rendition="#small-caps">ii</hi>, p. 206</ref>.</p>
            </note>
            <note corresp="#d196-f2" n="52" xml:id="d196-f2-content">
                <p>The Czecho-Slovaks.</p>
            </note>
        </listAnnotation>
    </standOff>
