    <text>
        <body>
            <div xml:id="d200">

                <pb facs="0411" n="365" xml:id="pg365"/>

                <note rend="inline" type="source">861.00/2215½</note>
                <head>
                    <hi rendition="#italic">The Japanese Ambassador</hi> (<hi rendition="#italic"
                        >Ishii</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-06-26">
                            <hi rendition="#italic">June 26, 1918</hi>
                        </date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Secretary</hi>: As you desired me, I have
                    put into writing the substance of the confidential information which I
                    communicated to you this afternoon under order of my government.</p>
                <p>I now beg to enclose it herewith.</p>
                <p>Yours sincerely,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">K. Ishii</hi>
                    </signed>
                </closer>


                <xi:include href="d200-a1.xml" xpointer="d200-a1"/>
            </div>
