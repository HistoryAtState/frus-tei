            <div xml:id="d175">

                <pb facs="0388" n="342" sameAs="frus:frus1914-20v02/pg342"/>

                <note rend="inline" type="source">763.72119/855½a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        President Wilson
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-09-10">
                            <hi rendition="#italic">September 10, 1917</hi>
                        </date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. President</hi>: I beg to send you enclosed
                    a copy of a telegram from the Minister of Foreign Affairs of Russia to the
                    Russian Ambassador in Washington, which was handed to the Department by the
                    Ambassador a few days ago.</p>
                <p>With assurances [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>


                <xi:include href="d175-a1.xml" xpointer="d175-a1"/>
