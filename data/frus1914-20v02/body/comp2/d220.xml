    <text>
        <body>
            <div xml:id="d220">

                <pb facs="0434" n="388" sameAs="frus:frus1914-20v02/pg388"/>

                <note rend="inline" type="source">861.00/2900½</note>
                <head>
                    <hi rendition="#italic">The President of the Czecho-Slovak National Council</hi>
                        (<hi rendition="#italic">Masaryk</hi>) <hi rendition="#italic">to the
                        Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1918-09-30">
                            <hi rendition="#italic">September 30, 1918</hi>
                        </date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Secretary</hi>: I beg to submit these Notes on
                    the Memorandum of September 27th.<anchor n="71" xml:id="d220-f1"/>
                </p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">T. G. Masaryk</hi>
                    </signed>
                </closer>


                <xi:include href="d220-a1.xml" xpointer="d220-a1"/>
            </div>
        </body>
    </text>
