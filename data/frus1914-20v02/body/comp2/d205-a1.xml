    <text>
        <body>
            <div xml:id="d205-a1">

                <pb facs="0422" n="376" xml:id="pg376"/>

                <opener>
                    <seg rendition="#center">[Enclosure 1]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">The Japanese Ambassador</hi> (<hi rendition="#italic"
                        >Ishii</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-08-17">
                            <hi rendition="#italic">August 17, 1918</hi>
                        </date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Secretary</hi>: As I promised you yesterday
                    I beg to send you herewith enclosed a short sketch of what I explained to you
                    verbally about the situation in the border town of Manchuli.</p>
                <p>Yours sincerely,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">K. Ishii</hi>
                    </signed>
                </closer>
            </div>
        </body>
