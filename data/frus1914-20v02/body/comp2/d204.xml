    <text>
        <body>
            <div xml:id="d204">

                <pb facs="0419" n="373" sameAs="frus:frus1914-20v02/pg373"/>

                <note rend="inline" type="source">861.00/2599½</note>
                <head>
                    <hi rendition="#italic">The British Chargé</hi> (<hi
                            rendition="#italic">Barclay</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 913</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-08-16">
                            <hi rendition="#italic">August 16, 1918</hi>
                        </date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I have the honour to
                    inform you that, in reply to a note from the Japanese Ambassador, His Majesty’s
                    Government have accepted the view of the Japanese Government—so far as British
                    troops are concerned—that the Supreme Command of the Allied forces operating in
                    Siberia and based on the Pacific should be Japanese.</p>
                <p>The Japanese Ambassador has been further informed that General Knox will be head
                    of the British Military Mission attached to the staff of the Japanese
                    Commander-in-Chief.</p>
                <p>Believe me [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Colville Barclay</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
