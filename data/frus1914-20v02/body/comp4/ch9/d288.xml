    <text>
        <body>
            <div xml:id="d288">

                <pb facs="0519" n="473" sameAs="frus:frus1914-20v02/pg473"/>

                <note rend="inline" type="source">710.11/198½</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Chilean Ambassador</hi>
                        (<hi rendition="#italic">Suárez-Mujica</hi>)<anchor n="2" xml:id="d288-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-02-01">
                            <hi rendition="#italic">February 1, 1915</hi>
                        </date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Ambassador</hi>: I am enclosing, for
                    your confidential examination, the draft of a proposed convention,<anchor n="3"
                        xml:id="d288-f2"/> copies of which are being sent also to the Ambassadors of
                    Argentine and Brazil.</p>
                <p>I would appreciate it very much if you would call at my house at six o’clock this
                    evening so that we may go over the language together before the proposed
                    convention is forwarded to your respective countries. I am requesting you to
                    call at the house instead of the Department in order to avoid publicity, if
                    possible.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. J. Bryan</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d288-f1" n="2" type="source" xml:id="d288-f1-content">
                <p>The same, <hi rendition="#italic">mutatis mutandis</hi>, to the Argentine and
                    Brazilian Ambassadors.</p>
            </note>
            <note corresp="#d288-f2" n="3" xml:id="d288-f2-content">
                <p>Enclosure as in President Wilson’s letter of Jan. 29, 1915, <hi
                        rendition="#italic">supra</hi>.</p>
            </note>
        </listAnnotation>
    </standOff>
