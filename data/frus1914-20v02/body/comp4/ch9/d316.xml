            <div xml:id="d316">

                <pb facs="0541" n="495" sameAs="frus:frus1914-20v02/pg495"/>

                <note rend="inline" type="source">710.11/225½b</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Argentine Ambassador</hi>
                        (<hi rendition="#italic">Naón</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1916-04-13">
                            <hi rendition="#italic">April 13, 1916</hi>
                        </date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Ambassador</hi>: In accordance with my
                    promise, I beg to enclose for your information a copy of the proposed Pan
                    American Treaty.</p>
                <p>I am [etc.]</p>
                <closer>[File copy not signed]</closer>


                <xi:include href="d316-a1.xml" xpointer="d316-a1"/>
