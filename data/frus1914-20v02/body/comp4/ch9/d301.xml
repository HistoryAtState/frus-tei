                <pb facs="0531" n="485" sameAs="frus:frus1914-20v02/pg485"/>

                <note rend="inline" type="source">710.11/202</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        President Wilson
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-09-10">
                            <hi rendition="#italic">September 10, 1915</hi>
                        </date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. President</hi>: The enclosed telegram
                    has been received from Ambassador Fletcher. Will you kindly indicate to me what
                    are your wishes in the matter?</p>
                <p>Faithfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>



                <xi:include href="d301-a1.xml" xpointer="d301-a1"/>
