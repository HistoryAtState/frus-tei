    <text>
        <body>
            <div xml:id="d287">

                <pb facs="0518" n="472" xml:id="pg472"/>

                <note rend="inline" type="source">710.11/198½</note>
                <head>
                    <hi rendition="#italic">President Wilson to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <date calendar="gregorian" when="1915-01-29">29 <hi rendition="#small-caps"
                                >January</hi>, 1915</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Secretary</hi>: Here are the four articles
                    of agreement complete. I am sorry not to have had time to send them before.</p>
                <p>Faithfully Yours,</p>
                <closer>
                    <signed>W. W.</signed>
                </closer>


                <xi:include href="d287-a1.xml" xpointer="d287-a1"/>
