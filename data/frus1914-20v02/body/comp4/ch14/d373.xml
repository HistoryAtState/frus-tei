            </note>
            <note corresp="#d373-f3" n="12" xml:id="d373-f3-content">
                <p>Uruguayan Minister.</p>
            </note>
            <note corresp="#d373-f4" n="12a" xml:id="d373-f4-content">
                <p>Joaquin Méndez, the Guatemalan Minister.</p>
            </note>
        </listAnnotation>
