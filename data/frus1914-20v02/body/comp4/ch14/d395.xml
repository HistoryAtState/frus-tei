    <text>
        <body>
            <div xml:id="d395">

                <pb facs="0596" n="550" sameAs="frus:frus1914-20v02/pg550"/>

                <note rend="inline" type="source">812.113/3692½</note>
                <head>
                    <hi rendition="#italic">President Wilson to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-08-16">
                            <hi rendition="#italic">16 August, 1915</hi>
                        </date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: These figures are indeed
                        extraordinary.<anchor n="21" xml:id="d395-f1"/> Evidently a renewal of the
                    embargo might be a very important weapon in our hands.</p>
                <p>Faithfully Yours,</p>
                <closer>
                    <signed>W. W.</signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d395-f1" n="21" xml:id="d395-f1-content">
                <p>See Secretary Lansing’s letter of Aug. 14, 1915, <ref target="#pg549">p.
                        549</ref>.</p>
            </note>
        </listAnnotation>
