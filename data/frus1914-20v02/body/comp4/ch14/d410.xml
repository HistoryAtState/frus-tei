            <div xml:id="d410">

                <pb facs="0610" n="564" sameAs="frus:frus1914-20v02/pg564"/>

                <note rend="inline" type="source">812.00/19710½</note>
                <head>
                    <hi rendition="#italic">President Wilson to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">En Route</hi></placeName>, <date
                            calendar="gregorian" when="1916-10-26">
                            <hi rendition="#italic">October 26, 1916</hi>
                        </date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I am taking the liberty
                    of sending you a copy of a letter I have just sent to the Secretary of War. I do
                    this for your information in order that we may all take counsel together and
                    omit no precaution.</p>
                <p>Cordially and faithfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Woodrow Wilson</hi>
                    </signed>
                </closer>


                <xi:include href="d410-a1.xml" xpointer="d410-a1"/>
