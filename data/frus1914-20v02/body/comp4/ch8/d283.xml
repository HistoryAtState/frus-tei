    <text>
        <body>
            <div xml:id="d283">

                <pb facs="0512" n="466" sameAs="frus:frus1914-20v02/pg466"/>

                <note rend="inline" type="source">838.51/385½</note>
                <head>
                    <hi rendition="#italic">President Wilson to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-02-26">
                            <hi rendition="#italic">26 February, 1915</hi>
                        </date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: My own judgment follows
                    and agrees with your reasoning in this letter altogether. I do not see what
                    other course we can follow in the circumstances.</p>
                <p>Faithfully Yours,</p>
                <closer>
                    <signed>W. W.</signed>
                </closer>
            </div>
        </body>
    </text>
