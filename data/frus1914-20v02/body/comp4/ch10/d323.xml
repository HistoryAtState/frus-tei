    <text>
        <body>
            <div xml:id="d323">

                <pb facs="0547" n="501" sameAs="frus:frus1914-20v02/pg501"/>

                <note rend="inline" type="source">711.5914/46½</note>
                <head>
                    <hi rendition="#italic">President Wilson to the
                        Acting Secretary of State</hi> (<hi rendition="#italic"
                            >Polk</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-09-30">
                            <hi rendition="#italic">30 September, 1915</hi>
                        </date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Polk</hi>: Thank you for sending me the
                        enclosed.<anchor n="2" xml:id="d323-f1"/> This is a matter I am keenly
                    interested in and hope we can follow up in the right way and at the right moment
                    to a consummation. Faithfully Yours,</p>
                <closer>
                    <signed>W. W.</signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d323-f1" n="2" xml:id="d323-f1-content">
                <p>Telegram No. 173, Sept. 16, 1915, from the minister in Denmark, <ref
