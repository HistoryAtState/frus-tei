    <text>
        <body>
            <div xml:id="d329">

                <pb facs="0552" n="506" sameAs="frus:frus1914-20v02/pg506"/>

                <note rend="inline" type="source">711.5914/54½</note>
                <head>
                    <hi rendition="#italic">President Wilson to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Hot Springs, Va.</hi></placeName>, <date
                            calendar="gregorian" when="1915-12-29">
                            <hi rendition="#italic">29 December, 1915</hi>
                        </date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: Thank you very much for
                    these memoranda. I think the tack you took with the Danish Minister a very
                    serviceable one, and feel that, on the whole, the negotiations look quite
                    promising.</p>
                <p>Cordially and faithfully Yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Woodrow Wilson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
