    <text>
        <body>
            <div xml:id="d47-a1">

                <pb facs="0103" n="57" sameAs="frus:frus1914-20v02/pg57"/>

                <opener>
                    <seg rendition="#center">[Enclosure]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">Letter of Designation for Mr. Edward M. House</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-10-25">
                            <hi rendition="#italic">October 25, 1917</hi>
                        </date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: You are hereby designated to represent the
                    Government of the United States at the Conference to be held by representatives
                    of the Allied Governments in the early part of the month of November, 1917.</p>
                <p>I am, Sir,</p>
                <p>Your obedient servant</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Woodrow Wilson</hi>
                    </signed>
                </closer>
                <postscript>
                    <p>By the President: <lb/>
                        <hi rendition="#small-caps">Robert Lansing</hi>, [<hi
                            rendition="#small-caps">seal</hi>] <lb/>
                        <hi rendition="#italic">Secretary of State</hi>.</p>
                </postscript>
            </div>
        </body>
    </text>
