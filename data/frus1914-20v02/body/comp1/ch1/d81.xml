            <div xml:id="d81">

                <pb facs="0159" n="113" sameAs="frus:frus1914-20v02/pg113"/>

                <note rend="inline" type="source">711.00/19½</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        President Wilson
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-03-23">
                            <hi rendition="#italic">March 23, 1918</hi>
                        </date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. President</hi>: In response to your
                    letter of March 12th I herewith enclose a memorandum of objections to the public
                    discussion of treaties in the Senate.</p>
                <p>Faithfully yours,</p>
                <closer>[File copy not signed]</closer>


                <xi:include href="d81-a1.xml" xpointer="d81-a1"/>
