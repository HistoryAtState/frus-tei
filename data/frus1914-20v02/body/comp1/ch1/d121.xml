    <text>
        <body>
            <div xml:id="d121">

                <pb facs="0213" n="167" sameAs="frus:frus1914-20v02/pg167"/>

                <note rend="inline" type="source">763.72119/2368½</note>
                <head>
                    <hi rendition="#italic">President Wilson to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-10-23">
                            <hi rendition="#italic">23 October, 1918</hi>
                        </date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: Here is my idea of the
                    form in which we should submit our correspondence with Germany to the
                    governments with which we are associated as belligerents. What do you think of
                    it? I dare say we should send the correspondence to each of them as promptly as
                        possible.<anchor n="20" xml:id="d121-f1"/>
                </p>
                <p>Faithfully Yours,</p>
                <closer>
                    <signed>W. W.</signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d121-f1" n="20" xml:id="d121-f1-content">
                <p>For text of these notes as sent, see <ref target="frus1918Supp01v01#pg_383">
                        <hi rendition="#italic">Foreign Relations</hi>, 1918, supp. 1, vol I, p.
                        383</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
