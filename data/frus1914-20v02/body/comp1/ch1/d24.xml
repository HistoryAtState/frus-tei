    <text>
        <body>
            <div xml:id="d24">

                <pb facs="0080" n="34" xml:id="pg34"/>

                <note rend="inline" type="source">811.751/1</note>
                <head>
                    <hi rendition="#italic">The Governor of New York</hi> (<hi rendition="#italic"
                        >Whitman</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Albany, N. Y.</hi></placeName>, <date
                            calendar="gregorian" when="1917-05-24">
                            <hi rendition="#italic">May 24, 1917</hi>
                        </date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: Answering yours of May
                    19th, the measure with regard to which you write, was vetoed yesterday, in
                    conformity with what seems to me your very wise attitude in the matter.</p>
                <p>With kindest personal regards [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Charles S. Whitman</hi>
                    </signed>
                </closer>
            </div>
        </body>
