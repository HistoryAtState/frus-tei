            <div xml:id="d48">

                <pb facs="0103" n="57" sameAs="frus:frus1914-20v02/pg57"/>

                <note rend="inline" type="source">763.72Su/11½</note>
                <head>
                    <hi rendition="#italic">President Wilson to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-10-25">
                            <hi rendition="#italic">25 October, 1917</hi>
                        </date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I am very glad to comply
                    with your suggestion about this letter to House and I would be obliged if you
                    would be kind enough to countersign it and see that it is promptly forwarded to
                    him. I believe he leaves New York on Sunday.</p>
                <p>Faithfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Woodrow Wilson</hi>
                    </signed>
                </closer>
            </div>
        </body>
