    <text>
        <body>
            <div xml:id="d14">

                <pb facs="0059" n="13" sameAs="frus:frus1914-20v02/pg13"/>

                <note rend="inline" type="source">763.72/4528½</note>
                <head>
                    <hi rendition="#italic">The Chief of the British Special Mission</hi> (<hi rendition="#italic">Balfour</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-05-04">
                            <hi rendition="#italic">4 May, 1917</hi>
                        </date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Secretary</hi>: I have just received a
                    telegram from the Foreign Office asking me to express the warm appreciation of
                    His Majesty’s Government for the important force of Destroyers already sent by
                    the United States Government to assist in our Naval operations and for their
                    generous intention to largely augment this force. This very timely and prompt
                    assistance will be invaluable.</p>
                <p>May I add a personal expression of my own thanks?</p>
                <p>Yours very sincerely,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Arthur James Balfour</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
