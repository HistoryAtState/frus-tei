    <text>
        <body>
            <div xml:id="d104">

                <pb facs="0189" n="143" sameAs="frus:frus1914-20v02/pg143"/>

                <note rend="inline" type="source">763.72/13369</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to President Wilson </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-08-31">
                            <hi rendition="#italic">August 31, 1918</hi>
                        </date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. President</hi>: I have just received the
                    enclosed telegram<anchor n="3" xml:id="d104-f1"/> which appears to me to be
                    extremely important on account of the necessity of action here in case the
                    policy is adopted. I would be glad if you would tell me your views Tuesday after
                    Cabinet meeting.</p>
                <p>Faithfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d104-f1" n="3" xml:id="d104-f1-content">
                <p>Telegram No. 129, Aug. 30, 1918, from the Diplomatic Liaison Officer with the
                    Supreme War Council, <ref target="frus1918Supp01v01#pg_301">
                        <hi rendition="#italic">Foreign Relations</hi>, 1918, supp. 1, vol. <hi
                            rendition="#small-caps">i</hi>, p. 301</ref>.</p>
            </note>
