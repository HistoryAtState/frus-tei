    <text>
        <body>
            <div xml:id="d125">

                <pb facs="0217" n="171" sameAs="frus:frus1914-20v02/pg171"/>

                <note rend="inline" type="source">763.72119/9048: Telegram</note>
                <head>
                    <hi rendition="#italic">The Special Representative</hi> (<hi rendition="#italic"
                        >House</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1918-11-02T22:00:00+00:00">
                            <hi rendition="#italic">November 2, 1918—10 p. m.</hi>
                        </date>
                        <lb/> [Received 6:15 p. m.]</dateline>
                </opener>
                <p>36. For the President:</p>
                <p>Please advise the President that the matter mentioned in my telegram number 14 to
                    the President<anchor n="25" xml:id="d125-f1"/> has been adjusted in a manner
                    entirely satisfactory and I consider that no further action is advisable.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Edward House</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d125-f1" n="25" xml:id="d125-f1-content">
                <p>i.e., the telegram addressed to the Secretary of State, <hi rendition="#italic"
                        >supra</hi>.</p>
            </note>
        </listAnnotation>
    </standOff>
