    <text>
        <body>
            <div xml:id="d70">

                <pb facs="0141" n="95" sameAs="frus:frus1914-20v02/pg95"/>

                <note rend="inline" type="source">763.72/8706½</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to President Wilson </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-02-18">
                            <hi rendition="#italic">February 18, 1918</hi>
                        </date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. President</hi>: I send you a letter
                    which I have just received from Ambassador Page at Rome which voices a fear
                    which <pb facs="0142" n="96" xml:id="pg96"/> I have had in regard to Italy. I
                    wonder how soon Secretary Baker intends to have the Military Commission in
                    Italy? It seems to me that that is the next best move we can make.</p>
                <p>Faithfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>


                <xi:include href="d70-a1.xml" xpointer="d70-a1"/>
            </div>
        </body>
    </text>
