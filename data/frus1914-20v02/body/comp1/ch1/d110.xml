    <text>
        <body>
            <div xml:id="d110">

                <pb facs="0192" n="146" sameAs="frus:frus1914-20v02/pg146"/>

                <note rend="inline" type="source">763.72 Su/138½</note>
                <head>
                    <hi rendition="#italic">The Military Representative on the Supreme War
                        Council</hi> (<hi rendition="#italic"
                        >Bliss</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Versailles</hi></placeName>, <date
                            calendar="gregorian" when="1918-09-14">
                            <hi rendition="#italic">September 14, 1918</hi>
                        </date>.</dateline>
                </opener>
                <list>
                    <label>1.</label>
                    <item>I have the honor to forward, herewith, copy of Joint Note No. 37 adopted
                        by the Military Representatives at their meetings held at Versailles the
                        5th, 7th and 10th of September.</item>
                </list>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Tasker H. Bliss</hi>
                    </signed>
                </closer>


                <xi:include href="d110-a1.xml" xpointer="d110-a1"/>
            </div>
