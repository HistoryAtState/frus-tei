            <div xml:id="d147">

                <pb facs="0245" n="199" sameAs="frus:frus1914-20v02/pg199"/>

                <note rend="inline" type="source">763.72 Su/99</note>
                <head>
                    <hi rendition="#italic">The Military Representative on the Supreme War
                        Council</hi> (<hi rendition="#italic"
                        >Bliss</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1920-02-19">
                            <hi rendition="#italic">February 19, 1920</hi>
                        </date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to submit, herewith, my
                    report on the Supreme War Council.</p>
                <p>A duplicate copy has been handed to the Secretary of War.</p>
                <p>Very respectfully,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Tasker H. Bliss</hi>
                    </signed>
                </closer>



