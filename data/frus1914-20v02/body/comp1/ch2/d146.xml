    <text>
        <body>
            <div xml:id="d146">

                <pb facs="0244" n="198" sameAs="frus:frus1914-20v02/pg198"/>

                <note rend="inline" type="source">811.2222/14008</note>
                <head>
                    <hi rendition="#italic">President Wilson to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-10-17">
                            <hi rendition="#italic">17 October, 1918</hi>
                        </date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I know you will be
                    pleased to read the enclosed. I suggest that you make immediate arrangements
                    with the War Department for the action suggested.</p>
                <p>Cordially and sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Woodrow Wilson</hi>
                    </signed>
                </closer>


                <xi:include href="d146-a1.xml" xpointer="d146-a1"/>
