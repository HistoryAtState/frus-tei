                <pb facs="0752" n="745" sameAs="frus:frus1937v03/pg745"/>

                <note rend="inline" type="source">793.94/11409: Telegram</note>
                <head><hi rendition="#italic">The Second Secretary of Embassy in China</hi> (<hi
                        rendition="#italic">Atcheson</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Nanking</hi></placeName>, <date calendar="gregorian"
                            when="1937-12-02T12:00:00+08:00">December 2,
                        1937—noon</date>.<lb/>[Received December 2—7:20 a.m.]</dateline>
                </opener>
                <p>982. Our 978, December 1, 3 p.m.</p>
                <list>
                    <label>1.</label>
                    <item>German Ambassador arrived here on Chinese customs cruiser. We are reliably
                        informed that Chiang will inform him that China, cannot consider any peace
                        proposals which do not give recognition to her full sovereignty.</item>
                    <label>2.</label>
                    <item>Repeated to Hankow, Peiping. Peiping please repeat to Tokyo.</item>
                </list>
                <closer><signed><hi rendition="#small-caps">Atcheson</hi></signed></closer>
            </div>
        </body>
    </text>
