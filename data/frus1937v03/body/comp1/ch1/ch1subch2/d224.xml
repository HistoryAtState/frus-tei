    <text>
        <body>
            <div xml:id="d224">

                <pb facs="0234" n="227" sameAs="frus:frus1937v03/pg227"/>

                <note rend="inline" type="source">793.94/9068</note>
                <head><hi rendition="#italic">The Department of State to
                        the British Embassy</hi><anchor n="45"
                        xml:id="d224-f1"/></head>
                <dateline>
                    <date ana="#date_undated-inferred-from-document-content" calendar="gregorian"
                        type="received-date" when="1937-07-20">undated</date>
                </dateline>
                <p>The Secretary of State expects to speak again tomorrow with the Japanese and the
                    Chinese Ambassadors and urge upon them the view of this Government that it is
                    most important that hostilities be avoided.</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d224-f1" n="45" type="source" xml:id="d224-f1-content">
                <p>Handed to the British Ambassador by the Chief of the Division of Far Eastern
                    Affairs, July 20.</p>
            </note>
        </listAnnotation>
    </standOff>
