                <pb facs="0143" n="136" sameAs="frus:frus1937v03/pg136"/>

                <note rend="inline" type="source">793.94/8698: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in China</hi> (<hi rendition="#italic"
                        >Johnson</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peiping</hi></placeName>, <date calendar="gregorian"
                            when="1937-07-11T22:00:00+08:00">July 11, 1937—10
                        p.m.</date><lb/>[Received July 11—11:20 a.m.]</dateline>
                </opener>
                <p>218. Following from Mukden: <quote rend="blockquote">
                        <p>“July 11, 4 p.m. I have just learned from Japanese military here that
                            traffic between Mukden-Tientsin has been suspended, I assume in order to
                            clear line for military use.</p>
                        <p>Repeated to Tokyo.”</p>
                    </quote></p>
                <closer><signed><hi rendition="#small-caps">Johnson</hi></signed></closer>
            </div>
