    <text>
        <body>
            <div xml:id="d559">

                <pb facs="0505" n="498" sameAs="frus:frus1937v03/pg498"/>

                <note rend="inline" type="source">793.94/9788: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Ambassador in China</hi> (<hi rendition="#italic"
                            >Johnson</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1937-08-30T19:00:00-04:00">August 30, 1937—7
                        p.m.</date></dateline>
                </opener>
                <p>195. Your 561, August 30, 2 p.m., has been repeated to Tokyo for communication by
                    the Ambassador to his interested colleagues. The Ambassador has been authorized
                    to associate himself with them in appropriate representations to the Japanese
                        Government.<anchor n="85" xml:id="d559-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
    </text>
