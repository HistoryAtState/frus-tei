    <text>
        <body>
            <div xml:id="d892">

                <pb facs="0809" n="802" sameAs="frus:frus1937v03/pg802"/>

                <note rend="inline" type="source">793.94/11589: Telegram</note>
                <head><hi rendition="#italic">The Commander in Chief, United States Asiatic
                        Fleet</hi> (<hi rendition="#italic"
                        >Yarnell</hi>) <hi rendition="#italic">to the Chief of Naval
                        Operations</hi> (<hi rendition="#italic"
                        >Leahy</hi>)<anchor n="19" xml:id="d892-f1"/></head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Shanghai</hi></placeName>,] <date calendar="gregorian"
                            when="1937-12-13T21:40:00+08:00">December 13, 1937—9:40
                        p.m.</date><lb/>[Received December 13—9:10 a.m.]</dateline>
                </opener>
                <p>0013. General Matsui’s headquarters announced capture Nanking, Chinese troops
                    surrendering unconditionally.</p>
            </div>
        </body>
    </text>
