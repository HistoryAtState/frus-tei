    <text>
        <body>
            <div xml:id="d546">

                <pb facs="0563" n="557" sameAs="frus:frus1942v02/pg557"/>

                <note rend="inline" type="source">125.226/1a: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Consul at
                        Leopoldville (Mallon)</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1942-04-02T21:00:00-04:00">April 2, 1942—9
                            p.m.</date>
                    </dateline>
                </opener>
                <p>39. Please ascertain immediately from High Commissioner<anchor n="89"
                        xml:id="d546-f1"/> at Brazzaville if he is agreeable to establishment of
                    Consulate at Brazzaville and if assignment of Laurence W. Taylor as Consul is
                    acceptable. Mr. Taylor will be furnished with a commission but no exequatur will
                    be requested for him.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Welles</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d546-f1" n="89" xml:id="d546-f1-content">
                <p>Gen. Marie Eugène Adolphe Sicé.</p>
            </note>
        </listAnnotation>
    </standOff>
