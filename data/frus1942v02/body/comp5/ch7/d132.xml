            </note>
            <note corresp="#d132-f3" n="4" xml:id="d132-f3-content">
                <p>Adm. William D. Leahy, American Ambassador in France.</p>
            </note>
            <note corresp="#d132-f4" n="5" xml:id="d132-f4-content">
                <p>Jean François Darlan.</p>
            </note>
        </listAnnotation>
