            <div xml:id="d583">

                <pb facs="0604" n="598" xml:id="pg598"/>

                <note rend="inline" type="source">123 Timberlake, Clare H./284: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Consul at Aden
                        (Timberlake)</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1942-12-09T14:00:00-04:00">December 9, 1942—2
                            p.m.</date>
                    </dateline>
                </opener>
                <p>40. Department’s telegram December 3 [<hi rendition="#italic">4</hi>], 10 p.m.
                    You are to interpret the instructions sent you as being solely in order that the
                    Department may receive your views and recommendations on the subject mentioned.
                    The Department does not desire you to have any conversations about suggested
                    cooperation with French authorities or any British officials who may at present
                    be in Djibouti. You should return to Aden at the earliest moment possible after
                    obtaining the information necessary upon which to base your recommendations.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
