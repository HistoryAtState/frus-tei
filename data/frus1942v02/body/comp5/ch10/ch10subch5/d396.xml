                <pb facs="0403" n="397" sameAs="frus:frus1942v02/pg397"/>

                <note rend="inline" type="source">740.0011 European War 1939/25114: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Chargé in France (Tuck)</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1942-10-17">October 17,
                        1942</date>.</dateline>
                </opener>
                <p>It is desired that you have no contacts or negotiations with General Giraud.</p>
                <closer>
                    <signed>[<hi rendition="#small-caps">Welles</hi>]</signed>
                </closer>
            </div>
