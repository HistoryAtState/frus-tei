    <text>
        <body>
            <div xml:id="d402">

                <pb facs="0406" n="400" sameAs="frus:frus1942v02/pg400"/>

                <note rend="inline" type="source">012.3/7904a: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Consul General at Algiers (Cole)</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1942-10-20T00:00:00-04:00">October 20,
                            1942—midnight.</date>
                    </dateline>
                </opener>
                <p>343. For Murphy. Your 691.<anchor n="99" xml:id="d402-f1"/> You are requested to
                    forward the following message to Admiral Darlan from Admiral Leahy: <pb
                        facs="0407" n="401" xml:id="pg401"/>
                    <quote rend="blockquote">
                        <p>“I hope you will accept my sympathy in your son’s illness, as well as our
                            hopes for his complete and early recovery.”</p>
                    </quote>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
