                <pb facs="0424" n="418" sameAs="frus:frus1942v02/pg418"/>

                <opener>
                    <seg rendition="#center">[Enclosure 6—Translation]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">General Henri Giraud to
                        the Personal Representative of President Roosevelt
                            (Murphy)</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <date calendar="gregorian" when="1942-10-28">
                            <hi rendition="#small-caps">October</hi> 28, 1942</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Counselor of Embassy</hi>: You have been good
                    enough to write me, as of today’s date, the following letter.</p>
                <p>[Here follows the text of Enclosure 1, <ref target="#pg413">page 413</ref>.]</p>
                <p>I have the honor to acknowledge the receipt of this communication, of which I
                    take due note.</p>
                <closer>
                    <signed>H[<hi rendition="#small-caps">enri</hi>] G[<hi rendition="#small-caps"
                            >iraud</hi>]</signed>
                </closer>
            </div>
        </body>
    </text>
