            <div xml:id="d334">

                <pb facs="0355" n="349" sameAs="frus:frus1942v02/pg349"/>

                <note rend="inline" type="source">123M956/387: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Consul General at Algiers (Cole)</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1942-08-01T15:00:00-04:00">August 1, 1942—3
                            p.m.</date>
                    </dateline>
                </opener>
                <p>229. For Robert D. Murphy. You are directed proceed Department for consultation
                    as soon as possible. [Here follow travel orders.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Welles</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
