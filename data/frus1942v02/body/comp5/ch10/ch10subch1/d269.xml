                <pb facs="0290" n="284" sameAs="frus:frus1942v02/pg284"/>

                <note rend="inline" type="source">740.0011 European War 1939/21085a: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Consul General at Algiers (Cole)</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1942-04-16T16:00:00-04:00">April 16, 1942—4
                            p.m.</date>
                    </dateline>
                </opener>
                <p>104. For Murphy. I am giving consideration to your air mail letter of March 14
                    which I have just received, and will telegraph you again as soon as
                    possible.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Welles</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
