    <text>
        <body>
            <div xml:id="d500">

                <pb facs="0507" n="501" sameAs="frus:frus1942v02/pg501"/>

                <note rend="inline" type="source">851R.20/49a: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Chargé in the United Kingdom (Matthews)</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1942-12-30T21:00:00-04:00">December 30,
                            1942—9 p.m.</date>
                    </dateline>
                </opener>
                <p>6662. A draft telegram<anchor n="19" xml:id="d500-f1"/> outlining our position in
                    North Africa was presented to the White House this morning.</p>
                <p>To clear any possible misunderstanding the contents of such a telegram should not
                    be communicated to anyone until further specific instructions are received.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d500-f1" n="19" xml:id="d500-f1-content">
                <p>
                    <hi rendition="#italic">Supra</hi>.</p>
            </note>
