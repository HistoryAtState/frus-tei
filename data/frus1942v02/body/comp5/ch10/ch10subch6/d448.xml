    <text>
        <body>
            <div xml:id="d448">

                <pb facs="0454" n="448" xml:id="pg448"/>

                <note rend="inline" type="source">851.01/784: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the United Kingdom (Winant) to the
                        Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1942-11-18T22:00:00+01:00">November 18,
                            1942—10 p.m.</date>
                        <lb/> [Received November 18—9:44 p.m.]</dateline>
                </opener>
                <p>6494. Personal to the Secretary. Re my 6451, November 17, 3 p.m.,<anchor n="74"
                        xml:id="d448-f1"/> the President’s statement<anchor n="75" xml:id="d448-f2"
                    /> has cleared the Darlan situation here.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Winant</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d448-f1" n="74" xml:id="d448-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d448-f2" n="75" xml:id="d448-f2-content">
                <p>For statement released to the press by the White House November 17, 1942, see
                    Department of State <hi rendition="#italic">Bulletin</hi>, November 21, 1942, p.
                    935.</p>
            </note>
