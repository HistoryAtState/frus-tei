            <div xml:id="d430">

                <pb facs="0438" n="432" sameAs="frus:frus1942v02/pg432"/>

                <note rend="inline" type="source">125.1333/326: Telegram</note>
                <head>
                    <hi rendition="#italic">The Consul General at Algiers (Cole) to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Algiers</hi></placeName>, <date
                            calendar="gregorian" when="1942-11-09">November 9,
                        1942</date>.<lb/>[Received December 5—7:41 a.m.]</dateline>
                </opener>
                <p>3. Entire staff of Consulate General at Algiers safe and well. Individual
                    inquiries indicate all American residents of whom Consulate General has record
                    also safe and well.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Cole</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
