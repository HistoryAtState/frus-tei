    <text>
        <body>
            <div xml:id="d425">

                <pb facs="0435" n="429" sameAs="frus:frus1942v02/pg429"/>

                <note rend="inline" type="source">740.0011 European War 1939/25297a: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Chargé in France (Tuck)</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1942-11-07T23:00:00-04:00">November 7,
                            1942—11 p.m.</date>
                    </dateline>
                </opener>
                <p>685. Personal for the Chargé d’Affaires. Report to the Department immediately
                    upon delivery to Marshal Pétain<anchor n="49" xml:id="d425-f1"/> of the
                    unenciphered <pb facs="0436" n="430" xml:id="pg430"/> message<anchor n="50"
                        xml:id="d425-f2"/> which you have received for him from the President.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d425-f1" n="49" xml:id="d425-f1-content">
                <p>Marshal Henri Philippe Pétain, French Chief of State.</p>
            </note>
            <note corresp="#d425-f2" n="50" xml:id="d425-f2-content">
                <p>Department of State <hi rendition="#italic">Bulletin</hi>, November 14, 1942, p.
