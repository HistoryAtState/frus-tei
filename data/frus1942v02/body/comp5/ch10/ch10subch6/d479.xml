    <text>
        <body>
            <div xml:id="d479">

                <pb facs="0487" n="481" sameAs="frus:frus1942v02/pg481"/>

                <note rend="inline" type="source">851R.01/49a</note>
                <head>
                    <hi rendition="#italic">The Under Secretary of State (Welles) to President Roosevelt
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1942-12-15">December 15,
                        1942</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. President</hi>: With reference to the
                    message which Admiral Leahy delivered to me from you this afternoon, I am
                    transmitting herewith the suggested message to be sent by the War Department to
                    General Eisenhower.</p>
                <p>If this meets with your approval<anchor n="5" xml:id="d479-f1"/> I shall arrange
                    to have it sent off by the War Department as soon as possible.</p>
                <p>Believe me</p>
                <p>Faithfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Sumner Welles</hi>
                    </signed>
                </closer>



                <xi:include href="d479-a1.xml" xpointer="d479-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d479-f1" n="5" xml:id="d479-f1-content">
                <p>Approved by President Roosevelt.</p>
            </note>
        </listAnnotation>
    </standOff>
