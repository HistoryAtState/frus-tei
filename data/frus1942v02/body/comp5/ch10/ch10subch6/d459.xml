                <pb facs="0466" n="460" sameAs="frus:frus1942v02/pg460"/>

                <note rend="inline" type="source">851T.00/59a: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Consul at Dakar
                        (Flexer)</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1942-11-25">November 25,
                        1942</date>.</dateline>
                </opener>
                <p>119. Please report in clear in so far as you can what the situation is and
                    developments as they occur.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
