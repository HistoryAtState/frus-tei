            <div xml:id="d435">

                <pb facs="0443" n="437" sameAs="frus:frus1942v02/pg437"/>

                <note rend="inline" type="source">851R.01/12a</note>
                <head>
                    <hi rendition="#italic">The Under Secretary of State (Welles) to the Chief of Staff, United States Army (Marshall)</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1942-11-13">November 13, 1942</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear General Marshall</hi>: The President has
                    asked me to bring to your personal attention the proposed telegram which I am
                    attaching herewith which, in accordance with his desire, is to be sent to Mr.
                    Murphy in Algiers.</p>
                <p>Will you let me know if you see any objection to this proposed message?</p>
                <p>Believe me</p>
                <p>Yours very sincerely,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Sumner Welles</hi>
                    </signed>
                </closer>


                <xi:include href="d435-a1.xml" xpointer="d435-a1"/>
            </div>
        </body>
    </text>
