    <text>
        <body>
            <div xml:id="d49">

                <pb facs="0055" n="49" sameAs="frus:frus1942v02/pg49"/>

                <note rend="inline" type="source">702.60D11/165</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Finnish Minister</hi> (<hi rendition="#italic"
                            >Procopé</hi>)<anchor n="66" xml:id="d49-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1942-03-07">March 7, 1942</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Minister</hi>: In view of the statement
                    in your note of March 4, 1942<anchor n="67" xml:id="d49-f2"/> that Finnish
                    citizens in American service in Finland are not subjected to other restrictions
                    than other Finnish citizens, I am prepared to agree to withdraw the limitations
                    imposed upon American citizens in Finnish employ in this country set forth in
                    the Department’s note of January 27, 1942.</p>
                <p>I hope this will ease your situation.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Sumner Welles</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d49-f1" n="66" type="source" xml:id="d49-f1-content">
                <p>This note was acknowledged with “very sincere gratitude” by the Minister on March
                    9, 1942.</p>
            </note>
            <note corresp="#d49-f2" n="67" xml:id="d49-f2-content">
                <p>Not printed; this was a personal letter from the Minister to Mr. Welles.</p>
            </note>
        </listAnnotation>
    </standOff>
