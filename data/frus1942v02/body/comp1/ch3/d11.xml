            <div xml:id="d11">

                <pb facs="0015" n="9" sameAs="frus:frus1942v02/pg9"/>

                <note rend="inline" type="source">855A.24/29: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in the United Kingdom</hi> (<hi
                            rendition="#italic">Winant</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1942-06-09">June 9, 1942</date>.</dateline>
                </opener>
                <p>2627. Your 2798, 20th. With reference your “3” Department agrees that parallel
                    approach is preferable procedure.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
