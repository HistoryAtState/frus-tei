    <text>
        <body>
            <div xml:id="d741">

                <pb facs="0753" n="747" sameAs="frus:frus1942v02/pg747"/>

                <note rend="inline" type="source">868.48/2057</note>
                <head>
                    <hi rendition="#italic">The Greek Minister (Diamantopoulos) to the Acting Secretary of
                            State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 540</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1942-03-06">March 6, 1942</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I have the honor to
                    transmit herewith a message received from His Majesty the King of the Hellenes
                    for the President of the United States, and should appreciate if you kindly have
                    it forwarded to its high destination.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>C. <hi rendition="#small-caps">Diamantopoulos</hi>
                    </signed>
                </closer>


                <xi:include href="d741-a1.xml" xpointer="d741-a1"/>
            </div>
