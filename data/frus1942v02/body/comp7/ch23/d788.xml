    <text>
        <body>
            <div xml:id="d788">

                <pb facs="0798" n="792" sameAs="frus:frus1942v02/pg792"/>

                <note rend="inline" type="source">868.48/3349: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in Sweden (Greene) to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Stockholm</hi></placeName>, <date
                            calendar="gregorian" when="1942-11-23T18:00:00+01:00">November 23,
                            1942—6 p.m.</date>
                        <lb/> [Received November 23—2:49 p.m.]</dateline>
                </opener>
                <p>3329. British Minister and I are submitting <hi rendition="#italic"
                        >aides-mémoire</hi> to Swedish Government this afternoon in sense of
                    Department’s 988, November 13, midnight,<anchor n="62" xml:id="d788-f1"/>
                    British Minister taking up in addition question of payment of freight and
                    certain details concerning safe conduct including marking of vessels.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Greene</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
