            <div xml:id="errata">

                <pb facs="0978" n="935" sameAs="frus:frus1977-80v18/pg935"/>

                <head>Errata</head>
                <p>The following change has been made to <hi rendition="#italic">Foreign
                        Relations</hi>, 1977–1980, Volume XVIII, Middle East Region; Arabian
                    Peninsula. Please be aware that printed volumes have not been revised.
                    <!--Revised information is in italic.-->
                </p>
                <list type="simple">
                    <item>
                        <hi rendition="#bold">1. <ref target="#preface">Preface</ref>, Page IX (date
                            of correction: November 8, 2017)</hi>
                    </item>
                    <item>The citation to “<hi rendition="#italic">Foreign Relations</hi>,
                        1977–1980, Volume XI, Iran: Hostage Crisis” has been changed to “<hi
                            rendition="#italic">Foreign Relations</hi>, Volume XI, <ref
                            target="frus:frus1977-80v11p1">Part 1</ref> and <ref
                            target="frus:frus1977-80v11p2">Part 2</ref>, Iran: Hostage
                        Crisis.”</item>
                </list>
            </div>
        </body>
    </text>
