                        </list>
                    </item>
                    <item>
                        <list>
                            <label rendition="#italic">Treasury</label>
                            <item>
                                Robert Carswell**</item>
                            <item>
                                Anthony Solomon**</item>
                            <item>Robert Mundheim**</item>
                        </list>
                    </item>
                    <item>
                        <list>
                            <label rendition="#italic">White House</label>
                            <item>
                                Jody Powell
                            </item>
                            <item>
                                Lloyd Cutler**</item>
                            <item>Hedley Donovan</item>
                            <item>
                                Zbigniew Brzezinski
                            </item>
                            <item>
                                David Aaron
                            </item>
                        </list>
                    </item>
                    <item>
                        <list>
                            <label rendition="#italic">NSC</label>
                            <item>Colonel William Odom</item>
                            <item>
