                <pb facs="0181" n="138" xml:id="pg138"/>

                <head>37. Summary of Conclusions of a Special Coordination Committee Meeting<anchor
                        n="1" xml:id="d37-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            from="1979-12-13T09:00:00-05:00" to="1979-12-13T09:55:00-05:00">December
                            13, 1979, 9–9:55 a.m.</date>
                    </dateline>
                </opener>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>Iran</item>
                </list>
                <list subtype="participants" type="description">
                    <label>PARTICIPANT</label>
                    <item>
                        <list>
                            <label rendition="#italic">State</label>
                            <item>
                                Warren Christopher
                            </item>
                            <item>
                                David Newsom
                            </item>
                            <item>
                                Harold Saunders
                            </item>
                        </list>
                    </item>
                    <item>
                        <list>
                            <label rendition="#italic">Defense</label>
                            <item>
                                W. Graham Claytor
                            </item>
                        </list>
                    </item>
                    <item>
                        <list>
                            <label rendition="#italic">JCS</label>
                            <item>General David Jones
                            </item>
                            <item>General John Pustay
                            </item>
                        </list>
                    </item>
                    <item>
                        <list>
                            <label rendition="#italic">CIA</label>
                            <item>Admiral Stansfield Turner
                            </item>
                            <item>
                                Frank Carlucci
                            </item>
                        </list>
