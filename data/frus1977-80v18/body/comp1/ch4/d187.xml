                <pb facs="0655" n="612" xml:id="pg612"/>

                <head>187. Summary of Conclusions of a Special Coordination Committee Meeting<anchor
                        n="1" xml:id="d187-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            from="1979-03-06T09:30:00-05:00" to="1979-03-06T11:00:00-05:00">March 6,
                            1979, 9:30–11 a.m.</date>
                    </dateline>
                </opener>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>Sensitive Collection and Covert Action Proposals (S)</item>
                </list>
                <list subtype="participants" type="description">
                    <label>PARTICIPANTS</label>
                    <item>
                        <list>
                            <label>Vice President**</label>
