                <pb facs="0714" n="671" sameAs="frus:frus1977-80v18/pg671"/>

                <head>208. Summary of Conclusions of a Special Coordination Committee Meeting<anchor
                        n="1" xml:id="d208-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            from="1980-02-06T09:00:00-05:00" to="1980-02-06T10:05:00-05:00">February
                            6, 1980, 9–10:05 a.m.</date>
                    </dateline>
                </opener>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>Pakistan/Saudi Arabia</item>
                </list>
                <list subtype="participants" type="description">
