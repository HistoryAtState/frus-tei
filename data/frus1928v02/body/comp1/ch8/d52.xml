    <text>
        <body>
            <div xml:id="d52">

                <pb facs="0213" n="95" sameAs="frus:frus1928v02/pg95"/>

                <note rend="inline" type="source">711.4215 Air Pollution/82</note>
                <head><hi rendition="#italic">The Minister in Canada</hi> (<hi
                            rendition="#italic">Phillips</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><seg rendition="#center">[Extract]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Ottawa</hi></placeName>, <date calendar="gregorian"
                            when="1928-07-27"><hi rendition="#italic">July 27,
                        1928</hi></date>.<lb/>[Received July 30.]</dateline>
                    <seg rendition="#float-left">No. 548</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith
                    enclosed copy of a note received from the Department of External Affairs dated
                    July 26, 1928, with regard to the terms of reference to the International Joint
                    Commission of the Trail Smelter question.</p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>I have [etc.]</p>
                <closer>For the Minister:<lb/><signed><hi rendition="#small-caps">La Verne
                            Baldwin</hi></signed><lb/><hi rendition="#italic">Secretary of
                        Legation</hi></closer>


                <xi:include href="d52-a1.xml" xpointer="d52-a1"/>
            </div>
        </body>
    </text>
