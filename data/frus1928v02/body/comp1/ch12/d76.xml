                <pb facs="0232" n="114" sameAs="frus:frus1928v02/pg114"/>

                <note rend="inline" type="source">611.424 Milk/39: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Consul General at
                        Montreal</hi> (<hi rendition="#italic">Halstead</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1928-09-04"><hi rendition="#italic">September 4,
                        1928</hi></date>.</dateline></opener>
                <p>Embargo on milk and its products from Montreal and vicinity lifted by Department
                    of Agriculture September 4.</p>
                <closer><signed><hi rendition="#small-caps">Clark</hi></signed></closer>
            </div>
        </body>
