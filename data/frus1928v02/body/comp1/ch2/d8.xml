            <div xml:id="d8">

                <pb facs="0125" n="7" sameAs="frus:frus1928v02/pg7"/>

                <note rend="inline" type="source">711.428/1180</note>
                <head><hi rendition="#italic">The American Member of the International Fisheries
                        Commission</hi> (<hi rendition="#italic"
                        >O’Malley</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1928-05-31"><hi rendition="#italic">May 31,
                        1928</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. Secretary</hi>: I am transmitting herewith
                    the formal report of the International Fisheries Commission—United States and
                    Canada—covering its investigation of the halibut fishery of the North
                    Pacific.</p>
                <p>I am also enclosing a suggested press release which you may use if you so
                    desire.</p>
                <p>Very truly yours,</p>
                <closer><signed><hi rendition="#small-caps">Henry O’Malley</hi></signed></closer>


                <xi:include href="d8-a1.xml" xpointer="d8-a1"/>
            </div>
