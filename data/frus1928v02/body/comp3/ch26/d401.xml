    <text>
        <body>
            <div xml:id="d401">

                <pb facs="0539" n="421" sameAs="frus:frus1928v02/pg421"/>

                <note rend="inline" type="source">711.93/184</note>
                <head><hi rendition="#italic">The Chief of the Division of Far Eastern Affairs</hi>
                        (<hi rendition="#italic">Hornbeck</hi>) <hi
                        rendition="#italic">to the Special Representative of the Chinese Nationalist
                        Government</hi> (<hi rendition="#italic">C. C.
                        Wu</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1928-07-27"><hi rendition="#italic">July 27,
                        1928</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Dr. Wu</hi>: Under instruction from the
                    Secretary of State, it gives me pleasure to acknowledge the receipt of your
                    communication of July 11, 1928, on the subject of treaties and agreements
                    forming at present the basis of the relations between China and the United
                    States, and I am happy to be able to inform you that the American Minister to
                    China, on behalf of the Secretary of State, has transmitted to the Minister for
                    Foreign Affairs of the Nationalist Government <pb facs="0540" n="422"
                        xml:id="pg422"/> at Nanking a statement, of date July 24, 1928, a copy of
                    which is attached, setting forth the attitude of the American Government.<anchor
                        n="23" xml:id="d401-f1"/></p>
                <p>Yours sincerely,</p>
                <closer><signed><hi rendition="#small-caps">Stanley K.
                    Hornbeck</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d401-f1" n="23" xml:id="d401-f1-content">
                <p>See telegrams No. 230, July 20, to the Minister in China, and No. 566, July 24,
                    from the Minister in China, <ref target="#pg464">pp. 464</ref> and <ref
                        target="#pg473">473</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
