                <pb facs="0670" n="552" sameAs="frus:frus1928v02/pg552"/>

                <note rend="inline" type="source">493.11/1378: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">MacMurray</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1928-10-12T19:00:00+08:00"><hi rendition="#italic">October 12,
                                1928—7 p.m.</hi></date><lb/>[Received October 12—9:10
                        a.m.]</dateline></opener>
                <p>769. Legation’s 744, October 3, 6 p.m., third paragraph. I have paid to Lo
                    Chia-lun installment for September.</p>
                <closer><signed><hi rendition="#small-caps">MacMurray</hi></signed></closer>
            </div>
        </body>
    </text>
