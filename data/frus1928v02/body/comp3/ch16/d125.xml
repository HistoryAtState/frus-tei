                <pb facs="0311" n="193" sameAs="frus:frus1928v02/pg193"/>

                <note rend="inline" type="source">611.9331/94½: Telegram</note>
                <head><hi rendition="#italic">President Coolidge to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Superior, Wisconsin</hi></placeName>, <date calendar="gregorian"
                            when="1928-08-11"><hi rendition="#italic">August 11,
                        1928</hi>.</date><lb/>[Received August 11—9:50 p.m.]</dateline></opener>
                <p>Letter 10th regarding Chinese treaty received. You may acknowledge that signing
                    of treaty is a recognition of the Nationalist Government.</p>
                <closer><signed><hi rendition="#small-caps">Calvin Coolidge</hi></signed></closer>
            </div>
        </body>
    </text>
