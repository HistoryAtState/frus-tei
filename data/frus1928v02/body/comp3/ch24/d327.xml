                <pb facs="0470" n="352" sameAs="frus:frus1928v02/pg352"/>

                <note rend="inline" type="source">493.11 N 15/196: Telegram</note>
                <head><hi rendition="#italic">The Chargé in China</hi> (<hi
                            rendition="#italic">Perkins</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><seg rendition="#center">[Extract]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1928-08-28T13:00:00+08:00"><hi rendition="#italic">August 28,
                                1928—1 p.m.</hi></date><lb/>[Received August 28—9:40
                        a.m.]</dateline></opener>
                <p>664. 1. Following from Spiker: <quote rend="blockquote">
                        <p>“August 27, 4 p.m. Inaugural and very conciliatory meeting of the
                            Sino-American Joint Commission held this morning. All the sessions to be
                            held in Shanghai until consideration of consular property losses
                            necessitates visit to Nanking. …”</p>
                    </quote></p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <closer><signed><hi rendition="#small-caps">Perkins</hi></signed></closer>
            </div>
        </body>
