    <text>
        <body>
            <div xml:id="d297">

                <pb facs="0451" n="333" sameAs="frus:frus1928v02/pg333"/>

                <note rend="inline" type="source">893.00 Nanking/246: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Consul General at Shanghai</hi> (<hi
                            rendition="#italic">Cunningham</hi>)</head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1928-03-31T13:00:00-05:00"><hi rendition="#italic">March 31,
                                1928—1 p.m.</hi></date></dateline></opener>
                <p>For the Minister: Minister’s telegrams March 30, 3 p.m. and 8 p.m.</p>
                <list>
                    <label>1.</label>
                    <item>Very much gratified, the Department extends to you congratulations upon
                        successful outcome of your efforts.</item>
                    <pb facs="0452" n="334" xml:id="pg334"/>
                    <label>2.</label>
                    <item>It is assumed that you will remain temporarily in Shanghai.</item>
                    <label>3.</label>
                    <item>There will be sent to you shortly the Department’s comments in regard to
                        the proposed notes and replies.</item>
                </list>
                <closer><signed><hi rendition="#small-caps">Kellogg</hi></signed></closer>
            </div>
        </body>
    </text>
