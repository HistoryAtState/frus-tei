    <text>
        <body>
            <div xml:id="d189">

                <pb facs="0366" n="248" sameAs="frus:frus1928v02/pg248"/>

                <note rend="inline" type="source">393.116/376: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">MacMurray</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1928-07-24T12:00:00+08:00"><hi rendition="#italic">July 24,
                                1928—noon</hi></date>.<lb/>[Received July 24—6:26
                    a.m.]</dateline></opener>
                <p>563. Following from Paxton: <quote rend="blockquote">
                        <p>“July 23, 9 a.m. Yesterday evening I was informed that Gin-ling College
                            had been three times demanded as headquarters for Yen Hsi-shan during
                            the Fifth Plenary Conference.”<anchor n="84" xml:id="d189-f1"/></p>
                    </quote></p>
                <closer><signed><hi rendition="#small-caps">MacMurray</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d189-f1" n="84" xml:id="d189-f1-content">
                <p>Fifth plenary session of Central Executive Committee of the Kuomintang,
                    Nationalist Government.</p>
            </note>
        </listAnnotation>
    </standOff>
