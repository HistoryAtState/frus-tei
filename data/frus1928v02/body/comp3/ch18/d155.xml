    <text>
        <body>
            <div xml:id="d155">

                <pb facs="0338" n="220" sameAs="frus:frus1928v02/pg220"/>

                <note rend="inline" type="source">393.11/801: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">MacMurray</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1928-05-07T17:00:00+08:00"><hi rendition="#italic">May 7, 1928—5
                                p.m.</hi></date><lb/>[Received May 7—7:26 a.m.]</dateline></opener>
                <p>318. Tsingtau reports arrival of mail from Price<anchor n="40" xml:id="d155-f1"/>
                    this morning by Japanese military train and that up to May 6, 6 a.m. it was
                    believed that no Americans were injured or American property looted.</p>
                <closer><signed><hi rendition="#small-caps">MacMurray</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d155-f1" n="40" xml:id="d155-f1-content">
                <p>Ernest B. Price, consul at Tsinan.</p>
            </note>
        </listAnnotation>
    </standOff>
