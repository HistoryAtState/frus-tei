    <text>
        <body>
            <div xml:id="d427">

                <pb facs="0574" n="456" sameAs="frus:frus1928v02/pg456"/>

                <note rend="inline" type="source">711.93/191</note>
                <head><hi rendition="#italic">President Coolidge to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Superior, Wis.</hi></placeName>, <date calendar="gregorian"
                            when="1928-07-12"><hi rendition="#italic">July 12,
                        1928</hi></date>.<lb/>[Received July 16.]</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I approve the program
                    which you set out in your letter of July 11th regarding the matter of the treaty
                    negotiations with China.</p>
                <p>Very truly yours,</p>
                <closer><signed><hi rendition="#small-caps">Calvin Coolidge</hi></signed></closer>
            </div>
        </body>
    </text>
