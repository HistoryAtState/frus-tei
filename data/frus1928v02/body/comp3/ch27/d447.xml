            <div xml:id="d447">

                <pb facs="0596" n="478" sameAs="frus:frus1928v02/pg478"/>

                <note rend="inline" type="source">611.9331/75: Telegram</note>
                <head><hi rendition="#italic">The Secretary to the President</hi> (<hi rendition="#italic">Sanders</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Superior, Wis.</hi></placeName>, <date calendar="gregorian"
                            when="1928-07-26T16:30:00-05:00"><hi rendition="#italic">July 26,
                                1928—4:30 p.m.</hi></date><lb/>[Received July
                    26—?]</dateline></opener>
                <p>The President has approved and signed full powers for Minister MacMurray
                    transmitted with your letter 25th. Will be returned in pouch tomorrow.</p>
                <closer><signed><hi rendition="#small-caps">Everett Sanders</hi></signed></closer>
            </div>
        </body>
    </text>
