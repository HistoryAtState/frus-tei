    <text>
        <body>
            <div xml:id="d371">

                <pb facs="0502" n="384" sameAs="frus:frus1928v02/pg384"/>

                <note rend="inline" type="source">693.003/808: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Chargé in China</hi>
                        (<hi rendition="#italic">Mayer</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1928-03-08T18:00:00-05:00"><hi rendition="#italic">March 8, 1928—6
                                p.m.</hi></date></dateline></opener>
                <p>87. Your 142, March 6, 5 p.m.</p>
                <list>
                    <label>1.</label>
                    <item>Department is prepared to approve 5 per cent ad valorem basis for disputed
                        items. Commerce Department concurs.</item>
                    <label>2.</label>
                    <item>Department assumes duty paying value will be determined as provided in
                        Rule 1 attached to the Revised Import Tariff of 1922.<anchor n="75"
                            xml:id="d371-f1"/> If otherwise inform Department.</item>
                </list>
                <closer><signed><hi rendition="#small-caps">Kellogg</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d371-f1" n="75" xml:id="d371-f1-content">
                <p>See <hi rendition="#italic">The China Year Book</hi>, 1923, pp. 525, 544.</p>
            </note>
