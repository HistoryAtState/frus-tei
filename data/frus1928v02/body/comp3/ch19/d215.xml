            <div xml:id="d215">

                <pb facs="0383" n="265" xml:id="pg265"/>

                <note rend="inline" type="source">393.11/793: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the American Southern
                        Baptist Mission Board</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1928-05-02"><hi rendition="#italic">May 2,
                        1928</hi></date>.</dateline></opener>
                <p>Department urges that you telegraph Dr. and Mrs. Gaston and Miss Cynthia A.
                    Miller at Laichowfu, Shantung Province, China, to withdraw as advised by the
                    American Consul at Chefoo from their station to Chefoo.</p>
                <closer><signed><hi rendition="#small-caps">Frank B. Kellogg</hi></signed></closer>
            </div>
        </body>
    </text>
