            <div xml:id="d725">

                <pb facs="0844" n="726" xml:id="pg726"/>

                <note rend="inline" type="source">811.841/298: Telegram</note>
                <head><hi rendition="#italic">The Minister in Norway</hi> (<hi rendition="#italic"
                        >Swenson</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Oslo</hi></placeName>, <date calendar="gregorian"
                            when="1926-10-05T12:00:00+01:00"><hi rendition="#italic">October 5,
                                1926—noon</hi>.</date><lb/>[Received 3:15 p.m.]</dateline></opener>
                <p>23. Referring to the Department’s No. 11, October 4, 4 p.m. Tonnage duties in
                    Norwegian ports are uniform for all countries including Norway.</p>
                <closer><signed><hi rendition="#small-caps">Swenson</hi></signed></closer>
            </div>
        </body>
    </text>
