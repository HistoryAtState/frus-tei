            <div xml:id="d898">

                <pb facs="1037" n="919" sameAs="frus:frus1928v02/pg919"/>

                <note rend="inline" type="source">862.4061 Motion Pictures/15</note>
                <head><hi rendition="#italic">The Ambassador in Germany</hi> (<hi rendition="#italic">Schurman</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><seg rendition="#center">[Extract]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Berlin</hi></placeName>, <date calendar="gregorian"
                            when="1928-12-22"><hi rendition="#italic">December 22,
                        1928</hi></date>.<lb/>[Received January 10, 1929.]</dateline>
                    <seg rendition="#float-left">No. 4198</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In confirmation of my telegram No. 260 of
                    December 21, 1928, relative to the new German regulations governing the
                    importation <pb facs="1038" n="920" xml:id="pg920"/> of foreign films, I have
                    the honor to transmit herewith a copy of the aforesaid regulations and a
                    translation prepared by the Commercial Attaché.</p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Jacob Gould
                    Schurman</hi></signed></closer>


                <xi:include href="d898-a1.xml" xpointer="d898-a1"/>
            </div>
