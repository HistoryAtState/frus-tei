    <text>
        <body>
            <div xml:id="d831">

                <pb facs="0976" n="858" xml:id="pg858"/>

                <note rend="inline" type="source">811.111 Zizianoff, Nina Princess</note>
                <head><hi rendition="#italic">The Consul General at Paris</hi> (<hi
                        rendition="#italic">Gaulin</hi>) <hi rendition="#italic">to the Secretary of
                        State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1928-03-05"><hi rendition="#italic">March 5,
                        1928</hi></date>.<lb/>[Received March 15.]</dateline>
                    <seg rendition="#float-left">No. 727</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to enclose copies and
                    translations of the judgment rendered by the Court of Appeals, on January 28,
                    1928, in the suit of Princess Zizianoff against Consul Donald F. Bigelow.</p>
                <p>The matter is now pending in the Court of Cassation, but the date of hearing has
                    not yet been set.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">A. Gaulin</hi></signed></closer>


                <xi:include href="d831-a1.xml" xpointer="d831-a1"/>
            </div>
        </body>
    </text>
