            <div xml:id="d830">

                <pb facs="0974" n="856" sameAs="frus:frus1928v02/pg856"/>

                <note rend="inline" type="source">811.111 Zizianoff, Nina Princess</note>
                <head><hi rendition="#italic">The Chargé in France</hi> (<hi
                            rendition="#italic">Whitehouse</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><seg rendition="#center">[Extract]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1928-01-13"><hi rendition="#italic">January 13,
                        1928</hi></date>.<lb/>[Received January 27.]</dateline>
                    <seg rendition="#float-left">No. 8215</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to the Department’s
                    Instruction No. 2526 of December 1, 1927 … I have the honor to transmit herewith
                    a copy and translation of the reply of the French Ministry for Foreign Affairs
                    to the note which I sent on December 15, 1927, in compliance <pb facs="0975"
                        n="857" xml:id="pg857"/> with the Department’s aforementioned Instruction,
                    regarding the suit brought by Princess Zizianoff against Mr. Donald F.
                    Bigelow.</p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Sheldon
                    Whitehouse</hi></signed></closer>


                <xi:include href="d830-a1.xml" xpointer="d830-a1"/>
            </div>
        </body>
