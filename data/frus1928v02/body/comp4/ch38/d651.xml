    <text>
        <body>
            <div xml:id="d651">

                <pb facs="0750" n="632" xml:id="pg632"/>

                <note rend="inline" type="source">821.6363 Barco/156½: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Minister in
                        Colombia</hi> (<hi rendition="#italic">Piles</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1928-08-28T18:00:00-04:00"><hi rendition="#italic">August 28,
                                1928—6 p.m.</hi></date></dateline></opener>
                <p>46. On account of Folsom’s telegram to his company latter prefers not to instruct
                    him to make written statement. Accordingly take no further action on
                    instructions contained in Department’s 45, August 25, noon.</p>
                <closer><signed><hi rendition="#small-caps">Castle</hi></signed></closer>
            </div>
        </body>
