                <pb facs="0709" n="591" sameAs="frus:frus1928v02/pg591"/>

                <note rend="inline" type="source">821.6363/363: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Minister in Colombia</hi> (<hi rendition="#italic"
                            >Piles</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1928-02-21T18:00:00-05:00"><hi rendition="#italic">February 21,
                                1928—6 p.m.</hi></date></dateline></opener>
                <p>10. Your 12, February 20, 10 a.m. and 13, February 20, 5 p.m.<anchor n="1a"
                        xml:id="d588-f1"/> Colombian Minister, who has been attending Habana
                    conference, is not expected in Washington before March 1st. In these
                    circumstances you should not delay your interview with the President.</p>
                <closer><signed><hi rendition="#small-caps">Kellogg</hi></signed></closer>
            </div>
        </body>
    </text>
