    <text>
        <body>
            <div xml:id="d115">

                <pb facs="0332" n="307" sameAs="frus:frus1969-76v22/pg307"/>

                <head>115. Memorandum From the Deputy U.S. Negotiator (Bell) to Multiple
                        Recipients<anchor n="1" xml:id="d115-f1"/></head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            when="1976-03-19">March 19, 1976</date>.</dateline>
                </opener>
                <p rendition="#center"><hi rendition="#roman">U.S.-PANAMA TREATY
                    NEGOTIATIONS</hi></p>
                <p rendition="#center"><hi rendition="#roman">Future Scenario</hi></p>
                <p>The White House requested, on an informal basis, the Negotiators’ thoughts on how
                    the negotiating process may go in coming months. Ambassador Bunker concurred in forwarding the
                    attached.</p>
                <closer><signed>S. Morey Bell<anchor n="2"
                            xml:id="d115-f2"/>
                    </signed>
                    <hi rendition="#italic">Minister</hi>
                    <lb/>
                    <hi rendition="#italic">Deputy U.S. Negotiator</hi></closer>



                <xi:include href="d115-a1.xml" xpointer="d115-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d115-f1" n="1" type="source" xml:id="d115-f1-content">
                <p>Source: National Archives, RG 59, Ambassador
                        Bunker’s Correspondence, Lot 78D300,
                    Box 3, General. Secret; Exdis.</p>
            </note>
            <note corresp="#d115-f2" n="2" xml:id="d115-f2-content">
                <p>Bell initialed “SMB” above this typed signature.</p>
            </note>
        </listAnnotation>
    </standOff>
