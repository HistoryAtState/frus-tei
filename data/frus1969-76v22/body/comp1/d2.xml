    <text>
        <body>
            <div xml:id="d2">

                <pb facs="0027" n="2" xml:id="pg2"/>

                <head>2. Briefing Memorandum From the Assistant Secretary of State for
                    Inter-American Affairs (Meyer) to
                    Secretary of State Rogers<anchor n="1"
                        xml:id="d2-f1"/></head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            when="1973-01-17">January 17, 1973</date>.</dateline>
                </opener>
                <p rendition="#center">Panama Canal Treaty Negotiations</p>
                <p>In accordance with your request,<anchor n="2" xml:id="d2-f2"/> there is attached
                    a talking points paper on the Panama Canal Treaty negotiations.</p>



                <xi:include href="d2-a1.xml" xpointer="d2-a1"/>
                <xi:include href="d2-a2.xml" xpointer="d2-a2"/>
            </div>
        </body>
    </text>
