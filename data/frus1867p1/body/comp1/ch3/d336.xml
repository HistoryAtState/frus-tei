    <text>
        <body>
            <div xml:id="d336">

                <pb facs="0463" n="395" sameAs="frus:frus1867p1/pg395"/>

                <head>Mr. Clay to Mr.
                        Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 163]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">St. Petersburg</hi>,</placeName>
                        <date calendar="gregorian" when="1867-11-21"><hi rendition="#italic"
                                >November</hi> 21, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I herein transmit to you a memorandum
                    descriptive of the Russian imperial system of Russian America, (portage.)
                    division of property, &amp;c, marked AA.</p>
                <closer>
                    <signed>C. M. CLAY.</signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>



                <xi:include href="d336-a1.xml" xpointer="d336-a1"/>
