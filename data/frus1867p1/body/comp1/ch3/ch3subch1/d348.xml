    <text>
        <body>
            <div xml:id="d348">

                <pb facs="0472" n="404" xml:id="pg404"/>

                <opener>
                    <seg rendition="#center">[Translation.]</seg>
                </opener>
                <head>Mr. de Stoeckl to Mr.
                        Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#italic">Washington,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1867-08-13"><hi rendition="#italic"
                                >August</hi> 13, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Mr. Secretary of State:</hi> I have the honor to
                    remit to you herewith copy of the instructions given to Captain Pestchouroff,
                    commissioner of the Imperial government for the transfer of the territory which
                    formed the Russian colonies of the northwest of the American continent.</p>
                <p>Please accept, Mr. Secretary of State the assurance of my very high
                    consideration.</p>
                <closer>
                    <signed>STOECKL.</signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c</hi>.</p>
                </postscript>


                <xi:include href="d348-a1.xml" xpointer="d348-a1"/>
