    <text>
        <body>
            <div xml:id="d341">

                <pb facs="0468" n="400" sameAs="frus:frus1867p1/pg400"/>

                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <head>Mr. de Stoeckl to Mr. Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">New York</hi>,</placeName>
                        <date calendar="gregorian" when="1867-05-15"><hi rendition="#italic"
                                >May</hi> 15, 1867</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">William H. Seward:</hi>
                </p>
                <p>Just received the following telegram from St. Petersburg:</p>
                <p>“Treaty ratified. Bodisco carries it back and leaves immediately.</p>
                <p rendition="#right">“GORTOHACOW.”</p>
                <p>I shall be in Washington tomorrow.</p>
                <closer>
                    <signed>STOECKL.</signed>
                </closer>
            </div>
        </body>
    </text>
