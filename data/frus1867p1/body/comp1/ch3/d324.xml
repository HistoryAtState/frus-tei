    <text>
        <body>
            <div xml:id="d324">

                <pb facs="0456" n="388" sameAs="frus:frus1867p1/pg388"/>

                <head>Mr. Seward to Mr.
                        Clay</head>
                <opener>
                    <seg rendition="#float-left">No. 241.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1867-04-01"><hi rendition="#italic"
                                >April</hi> 1, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit for your information a copy of a
                    treaty stipulating for the cession of Russian America to the United States,
                    which instrument was signed, here on the 30th ultimo by Mr. Stoeckl and myself,
                    and has been laid before the Senate by the President.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed>
                </closer>
                <postscript>
                    <p><hi rendition="#small-caps">Cassius M. Clay</hi>, Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c</hi>.</p>
                </postscript>


                <xi:include href="d324-a1.xml" xpointer="d324-a1"/>
            </div>
