    <text>
        <body>
            <div xml:id="d315">

                <pb facs="0449" n="[381]" sameAs="frus:frus1867p1/pg381"/>

                <head>Mr. Seward to Mr. Fox</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>
                        <date calendar="gregorian" when="1866-12-20"><hi rendition="#italic"
                                >December</hi> 20, 1866</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have received your communication of the
                    17th instant, and its accompaniments-, which M. Pogodin, requested you to
                    present to some national institute or museum in this city. I have placed them
                    among the archives of the department, and I beg that you will accept my thanks
                    for your kindness in allowing me the privilege of disposing of these interesting
                    autographs.</p>
                <p>I am, sir, your obedient servant.</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed>
                </closer>
                <postscript>
                    <p>G. V. Fox, Esq, <hi rendition="#italic">Portsmouth, New Hampshire.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
