    <text>
        <body>
            <div xml:id="d248">

                <pb facs="0304" n="236" xml:id="pg236"/>

                <head>Mr. Dix to Mr. Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 55.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">Paris,</hi></placeName>
                        <date calendar="gregorian" when="1867-03-15"><hi rendition="#italic"
                                >March</hi> 15, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to transmit to the
                    department a copy of Galignani’s messenger of the 14th instant, containing a
                    translation of the proposed laws on the press.</p>
                <p>I am, with great respect, your obedient servant,</p>
                <closer>
                    <signed>JOHN A. DIX.</signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>


                <xi:include href="d248-a1.xml" xpointer="d248-a1"/>
