    <text>
        <body>
            <div xml:id="d301">

                <pb facs="0372" n="304" sameAs="frus:frus1867p1/pg304"/>

                <head>Mr. Dix to M. Moustier</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">Paris,</hi></placeName>
                        <date calendar="gregorian" when="1867-06-14"><hi rendition="#italic"
                                >June</hi> 14, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to inform you that Mr.
                    Samuel B. Ruggles is authorized by my government to attend the international
                    conference in regard to the uniformity of coinage, to be held at Paris on the
                    17th instant. The despatch giving me this information was received this morning
                    and I hasten to communicate it</p>
                <p>I have the honor, &amp;c., &amp;c.,</p>
                <closer>
                    <signed>JOHN A. DIX.</signed>
                </closer>
                <postscript>
                    <p>His Excellency the <hi rendition="#small-caps">Marquis de Moustier</hi>, <hi
                            rendition="#italic">Minister of Foreign Affairs.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
