    <text>
        <body>
            <div xml:id="d237">

                <pb facs="0284" n="216" sameAs="frus:frus1867p1/pg216"/>

                <head>Mr. Dix to Mr.
                        Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 6.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">Paris,</hi></placeName>
                        <date calendar="gregorian" when="1867-01-08"><hi rendition="#italic"
                                >January</hi> 8, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir:</hi> I enclose a translation of an extract
                    copied from a Havre letter into the Moniteur of this morning, showing the
                    friendly construction put upon the recent arrangement, which was the subject of
                    your despatch by the Atlantic telegraph, in the commercial districts of
                    France.</p>
                <p>I am, very respectfully, your obedient servant,</p>
                <closer>
                    <signed>JOHN A. DIX.</signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>


                <xi:include href="d237-a1.xml" xpointer="d237-a1"/>
