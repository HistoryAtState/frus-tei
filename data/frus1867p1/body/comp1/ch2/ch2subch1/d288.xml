    <text>
        <body>
            <div xml:id="d288">

                <pb facs="0361" n="293" sameAs="frus:frus1867p1/pg293"/>

                <opener>
                    <seg rendition="#center">[Translation.]</seg>
                </opener>
                <head>M. Berthemy to Mr. Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <date calendar="gregorian" when="1867-08-08"><hi rendition="#italic"
                                >August</hi> 8, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Dear Mr. Seward:</hi> In conformity with the wish you
                    were pleased to express, I send you enclosed an extract from a despatch from the
                    Marquis de Moustier, relative to the protection of French interests in Mexico;
                    and I join here to, with all thanks, the interesting letter from Mr. Hall.</p>
                <p>Please accept, dear Mr. Seward, the assurance of my best regards.</p>
                <closer>
                    <signed>BERTHEMY.</signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward,</hi> &amp;<hi
                            rendition="#italic">c</hi>., &amp;<hi rendition="#italic">c</hi>.,
                            &amp;<hi rendition="#italic">c</hi>.</p>
                </postscript>


                <xi:include href="d288-a1.xml" xpointer="d288-a1"/>
