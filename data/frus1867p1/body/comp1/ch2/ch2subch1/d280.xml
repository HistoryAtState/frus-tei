    <text>
        <body>
            <div xml:id="d280">

                <pb facs="0357" n="289" xml:id="pg289"/>

                <head>Mr. Seward to M. Berthemy</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1866-12-28"><hi rendition="#italic"
                                >December</hi> 28, 1866.</date></dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to state that, in
                    accordance with a proposition made by his Majesty’s government, through the
                    Marquis de Montholon, to the government of the United States, the President has
                    this day issued a proclamation, to take effect on the 1st day of January, 1867,
                    removing the imposition of discriminating tonnage dues upon French vessels
                    coming into ports of the United States.</p>
                <p>Accept, sir, a renewed assurance of my very high consideration.</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed>
                </closer>
                <postscript>
                    <p><hi rendition="#small-caps">M. Berthemy,</hi> &amp;<hi rendition="#italic"
                            >c</hi>., &amp;<hi rendition="#italic">c</hi>., &amp;<hi
                            rendition="#italic">c</hi>.</p>
                </postscript>


                <xi:include href="d280-a1.xml" xpointer="d280-a1"/>
