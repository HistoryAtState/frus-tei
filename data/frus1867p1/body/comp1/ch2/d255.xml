    <text>
        <body>
            <div xml:id="d255">

                <pb facs="0310" n="242" sameAs="frus:frus1867p1/pg242"/>

                <opener>
                    <seg rendition="#center">[Telegram per cable.]</seg>
                </opener>
                <head>Mr. Dix to Mr. Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">Paris,</hi></placeName>
                        <date calendar="gregorian" when="1867-06-01"><hi rendition="#italic"
                                >June</hi> 1, 1867</date>.</dateline>
                </opener>
                <p>By special request of the Emperor I use the telegraph to express his earnest wish
                    that the government of the United States will exert all its influence to have
                    Maximilian spared by his captors.</p>
                <closer>
                    <signed>JOHN A. DIX.</signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>
            </div>
        </body>
