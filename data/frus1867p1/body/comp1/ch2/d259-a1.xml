    <text>
        <body>
            <div xml:id="d259-a1">

                <pb facs="0318" n="250" sameAs="frus:frus1867p1/pg250"/>

                <opener>
                    <seg rendition="#center">[Translation.]</seg>
                </opener>
                <head>Baron de Budberg to Mr. Dix</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1867-06-08"><hi rendition="#italic"
                                >June</hi> 8, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">General:</hi> I hastened to make known to the
                    Emperor, my august sovereign, the desire expressed by the citizens of the United
                    States sojourning in Paris to present an address to his Imperial Majesty in
                    regard to the attack of the 6th June.</p>
                <pb facs="0319" n="251" xml:id="pg251"/>
                <p>The Emperor is deeply impressed by the measure, of which you have kindly made
                    yourself the organ of communication, and has deigned to direct me to receive the
                    address in his name.</p>
                <p>Accept, general, the assurances of my high consideration.</p>
                <closer>
                    <signed>BUDBERG, <hi rendition="#italic">The Ambassador of Russia.</hi></signed>
                </closer>
                <postscript>
                    <p>General <hi rendition="#small-caps">Dix</hi>, &amp;<hi rendition="#italic"
                            >c</hi>., &amp;<hi rendition="#italic">c</hi>., &amp;<hi
                            rendition="#italic">c</hi>.</p>
                </postscript>
            </div>
        </body>
    </text>
