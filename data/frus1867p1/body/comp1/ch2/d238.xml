    <text>
        <body>
            <div xml:id="d238">

                <pb facs="0284" n="216" sameAs="frus:frus1867p1/pg216"/>

                <head>Mr. Seward to Mr.
                        Dix</head>
                <opener>
                    <seg rendition="#float-left">No. 8.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1867-01-11"><hi rendition="#italic"
                                >January</hi> 11, 1867.</date></dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir:</hi> I transmit herewith, for your information
                    and use, a copy of the proceedings consequent upon the delivery to Mrs. Mary
                    Lincoln of the gold medal presented by citizens of France.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed>
                </closer>
                <postscript>
                    <p><hi rendition="#small-caps">John A. Dix</hi>, Esq, &amp;<hi
                            rendition="#italic">c</hi>., &amp;<hi rendition="#italic">c</hi>.,
                            &amp;<hi rendition="#italic">c</hi>.</p>
                </postscript>
            </div>
        </body>
    </text>
