            <div xml:id="d150-a2">

                <pb facs="0221" n="153" xml:id="pg153"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <p>
                    <hi rendition="#small-caps">City and county of New York, ss:</hi>
                </p>
                <p>David M. Nagle and his wife, Maria D. Nagle, of the city of Brooklyn, county of
                    Kings, State of New York, being duly sworn, depose and say that their son,
                    Colonel William J. Nagle, now a prisoner in Kilmainham jail, Dublin, Ireland,
                    under the assumption of being connected with the Fenian organization, was born
                    in Niagara county, State of New York.</p>
                <closer>
                    <signed>D. M. NAGLE.</signed>
                    <lb/>
                    <signed>MARIA D. NAGLE.</signed>
                </closer>
                <closer>
                    <dateline rendition="#float-left">Sworn before me <date calendar="gregorian"
                            when="1867-09-18">this 18th day of September, A. D.
                        1867</date>.</dateline>
                    <signed><hi rendition="#small-caps">[seal.]</hi> JACOB E. HOWARD, <hi
                            rendition="#italic">Notary Public.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
