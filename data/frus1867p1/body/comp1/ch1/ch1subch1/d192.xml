    <text>
        <body>
            <div xml:id="d192">

                <pb facs="0249" n="181" sameAs="frus:frus1867p1/pg181"/>

                <head>Mr. Seward to Sir
                        F.Bruce</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1866-12-08">
                            <hi rendition="#italic">December 8, 1866.</hi>
                        </date>
                    </dateline>
                </opener>
                <p><hi rendition="#small-caps">My Dear Sir Frederick:</hi> I have the pleasure of
                    acknowledging the receipt of your letter of this date, and of expressing my
                    gratification at the intelligence it gives of the course of proceedings proposed
                    in regard to the Fenian prisoners, as well as your friendly assurances on the
                    subject.</p>
                <p>I join you in the hope that no disturbance may occur on the frontier; I am sure
                    that there will be practiced by our officials all possible diligence to prevent
                    it.</p>
                <p>Very faithfully yours,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD,</signed>
                </closer>
                <postscript>
                    <p>Hon. Sir <hi rendition="#small-caps">Frederick W. A. Bruce</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
