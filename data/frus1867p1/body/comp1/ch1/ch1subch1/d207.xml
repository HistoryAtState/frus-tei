    <text>
        <body>
            <div xml:id="d207">

                <pb facs="0268" n="200" sameAs="frus:frus1867p1/pg200"/>

                <head>Sir F. Bruce to Mr. Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1867-05-27"><hi rendition="#italic"
                                >May</hi> 27, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">My dear Mr. Seward:</hi> I have just heard by
                    telegraph from Lord Stanley that the capital sentences on Burke and McCafferty
                    have been commuted to imprisonment for life.</p>
                <p>Yours faithfully,</p>
                <closer>
                    <signed>FREDERICK WRIGHT BRUCE.</signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d207-a1.xml" xpointer="d207-a1"/>
