    <text>
        <body>
            <div xml:id="d211">

                <pb facs="0270" n="202" sameAs="frus:frus1867p1/pg202"/>

                <head>Mr. Hunter to Sir F.
                        Bruce</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi>,</placeName>, <date
                            calendar="gregorian" when="1867-07-24"><hi rendition="#italic">July</hi>
                            24, 1867.</date></dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir:</hi> Having submitted to the Secretary of the
                    Navy the communication of the 3d instant addressed to this department by
                    yourself on the subject of the signal code of the navy of the United States, I
                    have the honor to enclose, in reply, a copy of a letter of the 15th instant from
                    the Secretary of the Navy, and of the paper which accompanied it.</p>
                <p>I have the honor to be, with the highest consideration, sir, your obedient
                    servant,</p>
                <closer>
                    <signed>W. HUNTER, <hi rendition="#italic">Acting Secretary.</hi></signed>
                </closer>
                <postscript>
                    <p>Hon. Sir <hi rendition="#small-caps">Frederick Wright Bruce,</hi> &amp;<hi
                            rendition="#italic">c</hi>., &amp;<hi rendition="#italic">c</hi>.,
                            &amp;<hi rendition="#italic">c</hi>.</p>
                </postscript>
            </div>
        </body>
    </text>
