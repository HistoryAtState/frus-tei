                <pb facs="0271" n="203" sameAs="frus:frus1867p1/pg203"/>

                <opener>
                    <seg rendition="#center">[Telegram per cable.]</seg>
                </opener>
                <head>Sir F. Bruce to Lord Stanley</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1867-08-22"><hi rendition="#italic"
                                >August</hi> 22, 1867</date>.</dateline>
                </opener>
                <p>Right Hon. Lord <hi rendition="#small-caps">Stanley,</hi> &amp;<hi
                        rendition="#italic">c</hi>., &amp;<hi rendition="#italic">c</hi>., &amp;<hi
                        rendition="#italic">c</hi>.<hi rendition="#italic">:</hi></p>
                <p>I think it advisable to release Nagle and Warren.</p>
                <closer>
                    <signed>BRUCE.</signed>
                </closer>
            </div>
        </body>
    </text>
