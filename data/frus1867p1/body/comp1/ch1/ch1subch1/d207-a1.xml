    <text>
        <body>
            <div xml:id="d207-a1">

                <pb facs="0268" n="200" sameAs="frus:frus1867p1/pg200"/>

                <opener>
                    <seg rendition="#center">[Telegram per cable.]</seg>
                </opener>
                <head> Sir F. Bruce to Lord
                        Stanley</head>
                <p>Seward, in name of President, earnestly recommends no execution in Fenian
                    cases.</p>
                <closer>
                    <signed>BRUCE.</signed>
                </closer>
            </div>
