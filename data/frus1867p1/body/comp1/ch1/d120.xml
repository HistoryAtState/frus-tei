    <text>
        <body>
            <div xml:id="d120">

                <pb facs="0193" n="125" sameAs="frus:frus1867p1/pg125"/>

                <head>Mr. Seward to Mr. Adams</head>
                <opener>
                    <seg rendition="#float-left">No. 2043.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1867-08-20"><hi rendition="#italic"
                                >August</hi> 20, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir:</hi> I enclose a copy of a letter of the 31st
                    ultimo from J. J. Rogers, esq., of New York, in regard to the arrest and
                    imprisonment in Ireland of Mr. Augustine E. Costello, an American citizen.</p>
                <p>You are instructed to take such measures as you may think proper for securing the
                    early release of Mr. Costello.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed>
                </closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d120-a1.xml" xpointer="d120-a1"/>
            </div>
