                <opener>
                    <seg rendition="#center">[Telegram per cable.]</seg>
                </opener>
                <head>Mr. Adams to Mr.
                        Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">London,</hi></placeName>
                        <date calendar="gregorian" when="1867-08-23"><hi rendition="#italic"
                                >August</hi> 23, 1867</date>.</dateline>
                </opener>
                <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi rendition="#italic"
                        >Secretary of State, Washington, D. C.:</hi></p>
                <p>Measures already taken for the object desired.</p>
                <closer>
                    <signed>CHARLES FRANCIS ADAMS.</signed>
                </closer>
            </div>
        </body>
