                <opener>
                    <seg rendition="#center">[Telegram per cable.]</seg>
                </opener>
                <head>Mr. Seward to Mr.
                        Adams</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State,Washington,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1867-11-15"><hi rendition="#italic"
                                >November</hi> 15, 1867,</date>
                    </dateline>
                </opener>
                <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., &amp;<hi
                        rendition="#italic">c</hi>., &amp;<hi rendition="#italic">c</hi>., &amp;<hi
                        rendition="#italic">c.</hi></p>
                <p>Delay judgment or execution Warren’s case.</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed>
                </closer>
            </div>
        </body>
