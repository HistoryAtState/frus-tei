        <body>
            <div xml:id="d110-a1-a5">

                <pb facs="0187" n="119" sameAs="frus:frus1867p1/pg119"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <p><hi rendition="#small-caps">State of Tennessee</hi>, <hi rendition="#italic"
                        >Shelby County:</hi></p>
                <p>I, John Donovan, clerk of the criminal court of Memphis, do hereby certify that
                    the foregoing declaration of intention of Owen Dwyer to become a citizen of the
                    United States of America, is a true and perfect copy of the record of the same
                    now in my office.</p>
                <closer>
                    <dateline rendition="#float-left">In testimony whereof I have hereunto set my
                        hand and affixed the seal of said court, at office, in the city of
                            <placeName>Memphis</placeName>, <date calendar="gregorian"
                            when="1867-04-12">this 12th day of April, 1867</date>.</dateline>
                    <lb/>
                    <signed><hi rendition="#small-caps">[seal.]</hi> JOHN DONOVAN, <hi
                            rendition="#italic">Clerk.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
