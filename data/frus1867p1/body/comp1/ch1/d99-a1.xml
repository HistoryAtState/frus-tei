    <text>
        <body>
            <div xml:id="d99-a1">

                <pb facs="0180" n="112" sameAs="frus:frus1867p1/pg112"/>

                <head>Mr. Nagle to Mr.
                        Seward</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>284 <hi rendition="#small-caps">Pacific Street</hi>
                            <hi rendition="#italic">Brooklyn,</hi></placeName>
                        <date calendar="gregorian" when="1867-07-04"><hi rendition="#italic">
                                July</hi> 4, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Dear Sir:</hi> I respectfully beg leave to enclose
                    for your consideration a copy of Colonel William J. Nagle’s letter recently
                    addressed to me.</p>
                <p>All my children were born in this State—five sons and three daughters.</p>
                <p>I remain, very truly, your obedient servant,</p>
                <closer>
                    <signed>D. M. NAGLE.</signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State.</hi></p>
                </postscript>


                <xi:include href="d99-a1-a1.xml" xpointer="d99-a1-a1"/>
            </div>
