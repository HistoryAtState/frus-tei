    <text>
        <body>
            <div xml:id="d105">

                <pb facs="0183" n="115" sameAs="frus:frus1867p1/pg115"/>

                <head>Mr. Seward to Mr.
                        Adams</head>
                <opener>
                    <seg rendition="#float-left">No. 2017.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1867-07-13"><hi rendition="#italic"
                                >July</hi> 13, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir:</hi> I enclose a copy of a letter of the 10th
                    instant from Mr. Hugh Dunigan, of New York, regarding the arrest and
                    imprisonment of Patrick Kane, in Ireland, charged with being a Fenian.</p>
                <p>I will thank you to do what you properly can in behalf of the prisoner.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed>
                </closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d105-a1.xml" xpointer="d105-a1"/>
            </div>
