                <pb facs="0207" n="139" xml:id="pg139"/>

                <note rend="inline" type="source">[Telegram per cable. ]</note>
                <head>Mr. Seward to Mr. Adams</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State,Washington,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1867-09-13"><hi rendition="#italic"
                                >September</hi> 13, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                        rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                <p>Collector of customs at New York reports the Fenian episode of your 1428a mere
                    sensational fiction.</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed>
                </closer>
            </div>
        </body>
