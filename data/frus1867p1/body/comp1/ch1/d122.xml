    <text>
        <body>
            <div xml:id="d122">

                <pb facs="0195" n="127" xml:id="pg127"/>

                <head>Mr. Adams to Mr. Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 1427.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">London,</hi></placeName>
                        <date calendar="gregorian" when="1867-08-23"><hi rendition="#italic"
                                >August</hi> 23, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to transmit herewith a
                    printed copy of the Queen’s speech on the prorogation of Parliament, which took
                    place in due form on the 21st instant.</p>
                <p>I have the honor to be, sir, your obedient servant,</p>
                <closer>
                    <signed>CHARLES FRANCIS ADAMS.</signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>


                <xi:include href="d122-a1.xml" xpointer="d122-a1"/>
