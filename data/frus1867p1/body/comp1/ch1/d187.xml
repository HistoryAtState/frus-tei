    <text>
        <body>
            <div xml:id="d187">

                <pb facs="0248" n="180" sameAs="frus:frus1867p1/pg180"/>

                <head>Mr. Seward to Mr.
                        Adams</head>
                <opener>
                    <seg rendition="#float-left">No. 2103.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1867-12-02"><hi rendition="#italic"
                                >December</hi> 2, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir:</hi> You will be expected to give to Lord
                    Stanley a copy of my No. 2102. I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed>
                </closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Frangís Adams,</hi> Esq., &amp;<hi
                            rendition="#italic">c.</hi>, &amp;<hi rendition="#italic">c</hi>.,
                            &amp;<hi rendition="#italic">c.</hi></p>
                </postscript>
            </div>
