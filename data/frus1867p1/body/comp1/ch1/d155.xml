    <text>
        <body>
            <div xml:id="d155">

                <pb facs="0225" n="157" sameAs="frus:frus1867p1/pg157"/>

                <head>Mr. Seward to Mr. Adams</head>
                <opener>
                    <seg rendition="#float-left">No. 2072.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1867-10-08"><hi rendition="#italic"
                                >October</hi> 8, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have received your despatch of the 23d
                    ultimo, No. 1457, informing me of the transfer of Colonels Nagle and Warren from
                    Kilmainham jail to Mountjoy prison.</p>
                <p>Thanking you for your attention in keeping me informed upon the subject, I trust
                    that you will follow these cases up with renewed urgency.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM IL SEWARD</signed>
                </closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
