    <text>
        <body>
            <div xml:id="d110">

                <pb facs="0185" n="117" sameAs="frus:frus1867p1/pg117"/>

                <head>Mr. Seward to Mr.
                        Adams</head>
                <opener>
                    <seg rendition="#float-left">No. 2031.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1867-08-06"><hi rendition="#italic"
                                >August</hi> 6, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir:</hi> Herewith I transmit a copy of a letter,
                    together with its accompaniments, which, on the 26th of July, was addressed to
                    this department by Bernard <pb facs="0186" n="118" xml:id="pg118"/> Dwyer, esq.,
                    on behalf of his brother, Owen Dwyer, who has been arrested at Carlisle Pier,
                    England, on a charge of complicity in the Fenian movement in that country.</p>
                <p>You will acquaint yourself with the facts of this case, and will demand his
                    release or interpose your good offices in behalf of the accused, as the
                    circumstances shall, in your judgment, warrant.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed>
                </closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams</hi>, &amp;<hi
                            rendition="#italic">c.</hi>,&amp;<hi rendition="#italic">c.</hi>,
                            &amp;<hi rendition="#italic">c.</hi></p>
                </postscript>


                <xi:include href="d110-a1.xml" xpointer="d110-a1"/>
            </div>
