    <text>
        <body>
            <div xml:id="d179">

                <pb facs="0244" n="176" sameAs="frus:frus1867p1/pg176"/>

                <opener>
                    <seg rendition="#center">[Telegram per cable.]</seg>
                </opener>
                <head>Mr. Seward to Mr. Adams</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1867-11-01"><hi rendition="#italic"
                                >November 1</hi>9, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., &amp;<hi
                        rendition="#italic">c</hi>., &amp;<hi rendition="#italic">c</hi>., &amp;<hi
                        rendition="#italic">c.:</hi></p>
                <p>Solicit clemency for O’Brien and McCondon, sentenced at Manchester.</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed>
                </closer>
            </div>
        </body>
