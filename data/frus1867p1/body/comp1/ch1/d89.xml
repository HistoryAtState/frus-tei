    <text>
        <body>
            <div xml:id="d89">

                <pb facs="0169" n="101" sameAs="frus:frus1867p1/pg101"/>

                <head>Mr. Seward to Mr.
                        Adams</head>
                <opener>
                    <seg rendition="#float-left">No. 1999.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1867-06-12"><hi rendition="#italic"
                                >June</hi> 12, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have received your despatch of the 21st
                    ultimo, No. 1370, relating a conversation between yourself and a Mr. Holmes in
                    regard to the Mexican bondholders.</p>
                <p>I have to inform you in reply that the President does not think it necessary to
                    charge you with any duty connected with this subject.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed>
                </closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams</hi>, Esq., <hi
                            rendition="#italic">&amp;c. &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
