    <text>
        <body>
            <div xml:id="d46">

                <pb facs="0137" n="69" sameAs="frus:frus1867p1/pg69"/>

                <head>Mr. Stanton to Mr. Seward.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">War Department</hi>, <hi
                                rendition="#italic">Washington City</hi>,</placeName>
                        <date calendar="gregorian" when="1867-03-20"><hi rendition="#italic"
                                >March</hi> 20, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit, for the
                    consideration of the Department of State, a copy of a communication, dated March
                    4, received from the commanding general of the military department of Dakota,
                    respecting the pursuit of hostile Indians in her Britannic Majesty’s
                    dominions.</p>
                <p>Very respectfully, your obedient servant,</p>
                <closer>
                    <signed>EDWIN M. STANTON, <hi rendition="#italic">Secretary of
                        War.</hi></signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State</hi>.</p>
                </postscript>
            </div>
        </body>
