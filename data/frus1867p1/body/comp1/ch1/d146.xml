                <pb facs="0212" n="144" sameAs="frus:frus1867p1/pg144"/>

                <opener>
                    <seg rendition="#center">[Telegram per cable.]</seg>
                </opener>
                <head>Mr. Seward to Mr. Adams</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1867-09-20"><hi rendition="#italic"
                                >September</hi> 20, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                        rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                <p>Obtain definite answer about Warren and Nagle.</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed>
                </closer>
            </div>
        </body>
