                <pb facs="0636" n="568" xml:id="pg568"/>

                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <head>Mr. F. W. Seward to Count Wydenbruck.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1867-06-22"><hi rendition="#italic"
                                >June</hi> 22, 1867</date>.</dateline>
                </opener>
                <p>To Count <hi rendition="#small-caps">Wydenbruck</hi>, <hi rendition="#italic"
                        >Oakland, Alleghany county, Maryland :</hi></p>
                <p>Your telegram of yesterday received, and its request complied with.</p>
                <closer>
                    <signed>F. W. SEWARD.</signed>
                </closer>
            </div>
        </body>
