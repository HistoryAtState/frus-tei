                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <head>Mr. Seward to Count Wydenhruck.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1867-06-21"><hi rendition="#italic"
                                >June</hi> 21, 1867</date>.</dateline>
                </opener>
                <p>The good offices requested by the Emperor of Austria have been rendered.</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed>
                </closer>
                <postscript>
                    <p>Count <hi rendition="#small-caps">Wydenbruck</hi>, <hi rendition="#italic"
                            >&amp;c., &amp;c., &amp;c</hi>.</p>
                </postscript>
