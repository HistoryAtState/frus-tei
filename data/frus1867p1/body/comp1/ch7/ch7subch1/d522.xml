    <text>
        <body>
            <div xml:id="d522">

                <pb facs="0641" n="573" xml:id="pg573"/>

                <head>Mr. Seward to Baron Frankenstein.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1867-11-20"><hi rendition="#italic"
                                >November</hi> 20, 1867.</date></dateline>
                </opener>
                <p>Mr. Seward presents his compliments to Baron Pranckenstein, and has the honor to
                    enclose herewith, for his information, a copy of a telegram of yesterday’s date,
                    which has been received from the acting consul general of the United States at
                    Havana.</p>


                <xi:include href="d522-a1.xml" xpointer="d522-a1"/>
