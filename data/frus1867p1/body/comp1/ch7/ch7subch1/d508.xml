    <text>
        <body>
            <div xml:id="d508">

                <pb facs="0636" n="568" sameAs="frus:frus1867p1/pg568"/>

                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <head>Count Wydenbruck to Mr. Seward.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Oakland, Md.,</hi>
                        </placeName>
                        <date calendar="gregorian" when="1867-06-30"><hi rendition="#italic"
                                >June</hi> 30, 1867</date>.</dateline>
                </opener>
                <p>I received yesterday from Mexico the official news that the unfortunate emperor
                    Maximilian was shot June nineteenth, (19th,) seven (7) morning.</p>
                <closer>
                    <signed>WYDENBRUCK.</signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
