    <text>
        <body>
            <div xml:id="d637">

                <pb facs="0779" n="711" sameAs="frus:frus1867p1/pg711"/>

                <opener>
                    <seg rendition="#center">[Extract.]</seg>
                </opener>
                <head> Mr. Campbell to Mr. Seward. </head>
                <opener>
                    <seg rendition="#float-left">No. 54.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">Stockholm</hi></placeName>, <date
                            calendar="gregorian" when="1867-03-08"><hi rendition="#italic"
                                >March</hi> 8, 1867.</date></dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to transmit by the same
                    mail that will convey this despatch a manuscript on Norwegian emigration,
                    prepared by Thomas Bennett, a citizen of Christiania, from reliable sources. * *
                    * * *</p>
                <p>I have the honor to be, sir, with great respect, your obedient servant,</p>
                <closer>
                    <signed>JAMES H. CAMPBELL.</signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>



                <xi:include href="d637-a1.xml" xpointer="d637-a1"/>
            </div>
