    <text>
        <body>
            <div xml:id="d461-a1">

                <pb facs="0598" n="530" sameAs="frus:frus1867p1/pg530"/>

                <head>Mr. Clarke to Mr. Seward.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Office of the Metropolitan Board of
                                Health,</hi>
                            <hi rendition="#italic">No.</hi> 301 <hi rendition="#italic">Mott
                                street, New York,</hi></placeName>
                        <date calendar="gregorian" when="1867-09-27"><hi rendition="#italic"
                                >September</hi> 27, 1867</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I am directed by the Metropolitan Board of
                    Health to forward to you the enclosed copy of a communication from Dr. Elisha
                    Harris, corresponding secretary, and to inform you that it is the opinion of
                    this board that the statements contained therein in respect to the health of the
                    ports of the United States are reliable and correct.</p>
                <p>I have the honor to be, very respectfully, your obedient servant,</p>
                <closer>
                    <signed>EMMONS CLARKE, <hi rendition="#italic">Secretary</hi>.</signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>


                <xi:include href="d461-a1-a1.xml" xpointer="d461-a1-a1"/>
            </div>
