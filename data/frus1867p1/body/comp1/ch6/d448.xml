    <text>
        <body>
            <div xml:id="d448">

                <pb facs="0587" n="519" sameAs="frus:frus1867p1/pg519"/>

                <head>Mr. Hale to Mr.
                        Seward</head>
                <opener>
                    <seg rendition="#float-left">No. 78.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States of
                                America</hi>, <hi rendition="#italic">Madrid</hi></placeName>, <date
                            calendar="gregorian" when="1867-01-21"><hi rendition="#italic"
                                >January</hi> 21, 1867.</date></dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor herewith to enclose a
                    circular, which I received from the Spanish minister of state yesterday,
                    relative to some recent modifications of their very stringent quarantine
                    regulations hitherto enforced by the Spanish government.</p>
                <p>With much respect, I have the honor to be your most obedient servant,</p>
                <closer>
                    <signed>JOHN P. HALE.</signed>
                </closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">William H. Seward</hi>, <hi
                            rendition="#italic">Secretary of State, Washington, D. C.</hi></p>
                </postscript>


                <xi:include href="d448-a1.xml" xpointer="d448-a1"/>
            </div>
