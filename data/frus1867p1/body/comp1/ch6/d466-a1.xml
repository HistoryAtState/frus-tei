    <text>
        <body>
            <div xml:id="d466-a1">

                <pb facs="0606" n="538" sameAs="frus:frus1867p1/pg538"/>

                <opener>
                    <seg rendition="#center">[Translation.]</seg>
                </opener>
                <head>Royal Decree.</head>
                <p>In view of the reasons suggested by the minister of finance, in accordance with
                    the advice of the council of ministers, I decree as follows :</p>
                <p><hi rendition="#small-caps">Single article.</hi> Machinery, iron work, apparatus
                    and mechanism of foreign construction destined for agricultural uses, or such as
                    may serve for distributing the benefits and improving the products of husbandry,
                    shall pay one per cent, on their value under the national flag, and one-fifth
                    additional under a foreign flag.</p>
                <closer>
                    <dateline rendition="#float-left">Done at the palace <date calendar="gregorian"
                            when="1867-10-18">the 18th day of October, 1867</date>.</dateline>
                    <lb/> Under the royal rubric.<lb/><signed>MANUEL GARCIA BARZANALLANA, <hi
                            rendition="#italic">Minister of Finance</hi>.</signed></closer>
            </div>
        </body>
    </text>
