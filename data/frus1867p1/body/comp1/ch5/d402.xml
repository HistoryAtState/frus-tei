    <text>
        <body>
            <div xml:id="d402">

                <pb facs="0539" n="471" xml:id="pg471"/>

                <head>Mr. Seward to Mr.
                        Burlingame</head>
                <opener>
                    <seg rendition="#float-left">No. 195.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1867-04-05"><hi rendition="#italic"
                                >April</hi> 5, 1867.</date></dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to instruction from this
                    department, No. 174, of the 13th of October last, I will thank you to purchase
                    the most advantageous bills on London, payable to the order of the Secretary of
                    State of the United States, with the surplus of the Chinese indemnity, and remit
                    the bills directly to this department.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed>
                </closer>
                <postscript>
                    <p><hi rendition="#small-caps">Anson Burlingame</hi>, Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
