    <text>
        <body>
            <div xml:id="d861">

                <pb facs="0896" n="888" sameAs="frus:frus1938v01/pg888"/>

                <note rend="inline" type="source">500.C111/1068: Telegram</note>
                <head><hi rendition="#italic">The Minister in Switzerland</hi> (<hi
                        rendition="#italic">Harrison</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Geneva</hi></placeName>, <date calendar="gregorian"
                            when="1938-09-12T10:00:00+01:00">September 12, 1938—10
                        a.m.</date><lb/>[Received September 12—6:35 a.m.]</dateline>
                </opener>
                <p>1092. Avenol<anchor n="5" xml:id="d861-f1"/> informs me in confidence that as now
                    planned and in order to avoid embarrassment item 27 on the agenda concerning <pb
                        facs="0897" n="889" xml:id="pg889"/> bombing from the air will be referred
                    to the Bureau of Disarmament conference.</p>
                <closer><signed><hi rendition="#small-caps">Harrison</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d861-f1" n="5" xml:id="d861-f1-content">
                <p>Joseph Avenol, Secretary General of the League of Nations.</p>
            </note>
        </listAnnotation>
    </standOff>
