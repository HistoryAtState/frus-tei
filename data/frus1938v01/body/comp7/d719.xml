    <text>
        <body>
            <div xml:id="d719">

                <pb facs="0752" n="744" sameAs="frus:frus1938v01/pg744"/>

                <note rend="inline" type="source">840.48 Refugees/227: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Italy</hi> (<hi rendition="#italic"
                        >Phillips</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Rome</hi></placeName>, <date calendar="gregorian"
                            when="1938-05-11T18:00:00+01:00">May 11, 1938—6
                        p.m.</date><lb/>[Received May 11—2:25 p.m.]</dateline>
                </opener>
                <p>105. Myron Taylor<anchor n="8" xml:id="d719-f1"/> asks me to say that he awaits
                    further information and instructions.</p>
                <closer><signed><hi rendition="#small-caps">Phillips</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d719-f1" n="8" xml:id="d719-f1-content">
                <p>Mr. Taylor had sailed for Europe on April 30.</p>
            </note>
        </listAnnotation>
    </standOff>
