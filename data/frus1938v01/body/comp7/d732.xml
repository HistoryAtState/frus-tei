    <text>
        <body>
            <div xml:id="d732">

                <pb facs="0761" n="753" xml:id="pg753"/>

                <note rend="inline" type="source">840.48 Refugees/445: Telegram (part air)</note>
                <head><hi rendition="#italic">The Minister in Denmark</hi> (<hi rendition="#italic"
                        >Owsley</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Copenhagen</hi></placeName>, <date calendar="gregorian"
                            when="1938-07-02T13:00:00+01:00">July 2, 1938—1
                        p.m.</date><lb/>[Received July 4—6:28 a.m.]</dateline>
                </opener>
                <p>24. My telegram No. 14, April 5, noon.<anchor n="19" xml:id="d732-f1"/>
                    Government of Iceland regrets that it cannot participate in the conference
                    regarding political refugees. Embassy at Paris informed.</p>
                <closer><signed><hi rendition="#small-caps">Owsley</hi></signed></closer>
            </div>
        </body>
    </text>
