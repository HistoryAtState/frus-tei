    <text>
        <body>
            <div xml:id="d771">

                <pb facs="0802" n="794" sameAs="frus:frus1938v01/pg794"/>

                <note rend="inline" type="source">840.48 Refugees/798½</note>
                <head><hi rendition="#italic">The British Ambassador</hi> (<hi rendition="#italic"
                        >Lindsay</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1938-10-07">October 7, 1938</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Dear Mr. Secretary of State</hi>: I beg to enclose
                    herewith a message to the President from Mr. Neville Chamberlain, on the subject
                    of Refugees from Germany and I shall be grateful if you will forward it to its
                    destination.</p>
                <p>Very sincerely yours,</p>
                <closer><signed>R. C. <hi rendition="#small-caps">Lindsay</hi></signed></closer>


                <xi:include href="d771-a1.xml" xpointer="d771-a1"/>
