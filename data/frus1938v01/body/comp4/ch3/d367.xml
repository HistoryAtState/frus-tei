            <div xml:id="d367">

                <pb facs="0364" n="356" sameAs="frus:frus1938v01/pg356"/>

                <note rend="inline" type="source">711.00111 Lic. <hi rendition="#superscript"
                        >Douglas/52</hi> Aircraft Co. Inc./5: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Counselor of Embassy in
                        Spain</hi> (<hi rendition="#italic">Thurston</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1938-06-30T12:00:00-04:00">June 30, 1938—noon</date>.</dateline>
                </opener>
                <p>454. Your no. 991, June 28, 5 p.m. The laws prohibiting the exportation of arms
                    to Spain contain no provisions under which exceptions to the prohibition could
                    be granted.</p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
