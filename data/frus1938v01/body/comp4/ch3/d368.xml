    <text>
        <body>
            <div xml:id="d368">

                <pb facs="0364" n="356" sameAs="frus:frus1938v01/pg356"/>

                <note rend="inline" type="source">711.00111 Unlawful Shipments/223: Telegram</note>
                <head><hi rendition="#italic">The Counselor of Embassy in Spain</hi> (<hi rendition="#italic">Thurston</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Barcelona</hi></placeName>, <date calendar="gregorian"
                            when="1938-07-01T10:00:00+02:00">July 1, 1938—10
                        a.m.</date><lb/>[Received July 1—8:35 a.m.]</dateline>
                </opener>
                <p>996. My 986.<anchor n="30" xml:id="d368-f1"/> Mr. Krieger<anchor n="31"
                        xml:id="d368-f2"/> has ascertained from a member of the Spanish Air Force
                    that about 40 Grumman planes are now here. Also that an [unknown?] number of
                    Northrop monoplanes of a new model have just arrived.</p>
                <closer><signed><hi rendition="#small-caps">Thurston</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d368-f1" n="30" xml:id="d368-f1-content">
                <p>June 23, 5 p.m., <ref target="#pg352">p. 352</ref>.</p>
            </note>
            <note corresp="#d368-f2" n="31" xml:id="d368-f2-content">
                <p>William Krieger, clerk in the American Embassy in Spain.</p>
            </note>
        </listAnnotation>
    </standOff>
