                <pb facs="0456" n="448" sameAs="frus:frus1938v01/pg448"/>

                <note rend="inline" type="source">863.00/1442½</note>
                <head><hi rendition="#italic">The British Ambassador</hi> (<hi rendition="#italic"
                        >Lindsay</hi>) <hi rendition="#italic">to the Under Secretary of State</hi>
                        (<hi rendition="#italic">Welles</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1938-03-16">March 16, 1938</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Dear Mr. Welles</hi>: I enclose a confirmatory copy
                    of a message just received from London which has already been conveyed to Mr.
                    Pierrepont Moffat of your Department by telephone.</p>
                <p>I am instructed to communicate this message to the United States Government.</p>
                <p>Yours sincerely,</p>
                <closer><signed>R. C. <hi rendition="#small-caps">Lindsay</hi></signed></closer>


                <xi:include href="d465-a1.xml" xpointer="d465-a1"/>
