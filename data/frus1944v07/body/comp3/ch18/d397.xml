            <div xml:id="d397">

                <pb facs="0454" n="440" sameAs="frus:frus1944v07/pg440"/>

                <note rend="inline" type="source">123 B 632/602: Circular telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Diplomatic Representatives
                        in the American Republics Except Bolivia </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-01-22T20:00:00-04:00">January 22, 1944—8
                            p.m.</date>
                    </dateline>
                </opener>
                <p>Ambassador Boal has been instructed to return to the United States as soon as
                    possible after my statement on the Bolivian question.<anchor n="41"
                        xml:id="d397-f1"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
