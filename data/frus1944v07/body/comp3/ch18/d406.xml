            <div xml:id="d406">

                <pb facs="0461" n="447" sameAs="frus:frus1944v07/pg447"/>

                <note rend="inline" type="source">824.01/515: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Bolivia</hi> (<hi rendition="#italic"
                            >Boal</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-02-02T20:00:00-04:00">February 2, 1944—8
                            p.m.</date>
                    </dateline>
                </opener>
                <p>164. Reference is made to your 392 of February l.<anchor n="58" xml:id="d406-f1"
                    /> The Department perceives no reason why you should avoid an informal,
                    unofficial meeting with Villarroel but make no commitments.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
