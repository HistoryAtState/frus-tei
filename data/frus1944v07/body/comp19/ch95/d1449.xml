    <text>
        <body>
            <div xml:id="d1449">

                <pb facs="1557" n="1543" sameAs="frus:frus1944v07/pg1543"/>

                <note rend="inline" type="source">823.24/8–1144: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Peru</hi> (<hi rendition="#italic"
                        >White</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Lima</hi></placeName>, <date
                            calendar="gregorian" when="1944-08-11T18:00:00-05:00">August 11, 1944—6
                            p.m.</date>
                        <lb/> [Received 11 p.m.]</dateline>
                </opener>
                <p>1026. Embassy informed official sources there is a tendency toward increasing
                    re-exports of American merchandise from Peru to Argentina. Case now pending
                    involves 300 tons paraffin. Department’s urgent instructions requested.<anchor
                        n="*" xml:id="d1449-f1"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">White</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1449-f1" n="*" xml:id="d1449-f1-content">
                <p>Advising Finance Ministry. [Footnote in the original.]</p>
            </note>
        </listAnnotation>
    </standOff>
