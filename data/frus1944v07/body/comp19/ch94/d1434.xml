            </note>
            <note corresp="#d1434-f2" n="59" xml:id="d1434-f2-content">
                <p>Warren G. Libbey, Foreign Economic Administration representative in Lima.</p>
            </note>
            <note corresp="#d1434-f3" n="60" xml:id="d1434-f3-content">
                <p>United States Commercial Company.</p>
            </note>
        </listAnnotation>
