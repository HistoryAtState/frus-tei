    <text>
        <body>
            <div xml:id="d1477">

                <pb facs="1594" n="1580" sameAs="frus:frus1944v07/pg1580"/>

                <note rend="inline" type="source">823.51/1550a: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Peru</hi> (<hi rendition="#italic"
                            >White</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-05-16T18:00:00-04:00">May 16, 1944—6
                            p.m.</date>
                    </dateline>
                </opener>
                <p>513. For Rogers from Munro.<anchor n="58" xml:id="d1477-f1"/> We agree with you
                    that proposal is totally unacceptable. We will cable about procedure after
                    further consultation with Department. [Munro.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1477-f1" n="58" xml:id="d1477-f1-content">
                <p>Dana G. Munro, President of the Foreign Bondholders Protective Council.</p>
            </note>
        </listAnnotation>
    </standOff>
