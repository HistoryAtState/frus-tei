    <text>
        <body>
            <div xml:id="d787">

                <pb facs="0840" n="826" sameAs="frus:frus1944v07/pg826"/>

                <note rend="inline" type="source">103.9169 Bogotá: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Colombia</hi> (<hi rendition="#italic"
                            >Lane</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-04-29T17:00:00-04:00">April 29, 1944—5
                            p.m.</date>
                    </dateline>
                </opener>
                <p>583. From FEA, for La Spina.<anchor n="66" xml:id="d787-f1"/> Suggest Embassy and
                    Certifying Agency continue processing Import Recommendations as heretofore as
                    approved ones will receive due consideration even if positive list which is not
                    yet ready for consideration is made effective July 1. This answers A–320, April
                    8 [<hi rendition="#italic">6</hi>]. [FEA.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d787-f1" n="66" xml:id="d787-f1-content">
                <p>Albert F. La Spina, field representative of the Foreign Economic Administration
                    and special assistant to the Ambassador in Colombia.</p>
            </note>
        </listAnnotation>
    </standOff>
