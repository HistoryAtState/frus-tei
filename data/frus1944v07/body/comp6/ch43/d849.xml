    <text>
        <body>
            <div xml:id="d849">

                <pb facs="0891" n="877" sameAs="frus:frus1944v07/pg877"/>

                <note rend="inline" type="source">810.5051/7–2244: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        Colombia</hi> (<hi rendition="#italic">Lane</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-07-31T11:00:00-04:00">July 31, 1944—11
                            a.m.</date>
                    </dateline>
                </opener>
                <p>942. Your 1301 July 22.<anchor n="62" xml:id="d849-f1"/> Urge Foreign Minister to
                    take action to have embargo removed on the ground that the funds of the Rubber
                    Development Corporation, an agency of this Government, should be regarded as
                    immune.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stettinius</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
