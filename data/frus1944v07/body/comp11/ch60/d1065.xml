    <text>
        <body>
            <div xml:id="d1065">

                <pb facs="1101" n="1087" sameAs="frus:frus1944v07/pg1087"/>

                <note rend="inline" type="source">816.00/1222: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in El Salvador</hi> (<hi
                        rendition="#italic">Thurston</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">San Salvador</hi>
                        </placeName> [<date ana="#date_undated-inferred-from-document-content"
                            calendar="gregorian" notAfter="1944-04-02T20:55:00-06:00"
                            notBefore="1944-04-02T00:00:00-06:00">undated</date>].<lb/>[Received
                        April 2, 1944—8:55 p.m.]</dateline>
                </opener>
                <p>Revolutionary movement began San Salvador 4 o’clock this afternoon April 2.
                    Captain Massey<anchor n="1" xml:id="d1065-f1"/> requests War Department be
                    informed.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Thurston</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1065-f1" n="1" xml:id="d1065-f1-content">
                <p>Capt. G. B. Massey, Acting Military Attaché.</p>
