                        <row>
                            <cell>
                                <hi rendition="#italic">Items</hi>
                            </cell>
                            <cell>
                                <hi rendition="#italic">Quantity</hi>
                            </cell>
                            <cell/>
                        </row>
                        <row>
                            <cell>Mortar 81 mm with mount</cell>
                            <cell role="num">12</cell>
                            <cell/>
