                <pb facs="0411" n="397" sameAs="frus:frus1944v07/pg397"/>

                <note rend="inline" type="source">811.91235/66a: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in
                        Argentina</hi> (<hi rendition="#italic">Armour</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-03-17T23:00:00-04:00">March 17, 1944—11
                            p.m.</date>
                    </dateline>
                </opener>
                <p>442. UP reports that Argentine Government has placed ban on all incoming or
                    outgoing messages and has instructed telephone and radio companies not to accept
                    UP messages. Please investigate and report by urgent telegram.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
