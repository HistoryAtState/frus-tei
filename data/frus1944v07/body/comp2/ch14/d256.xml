    <text>
        <body>
            <div xml:id="d256">

                <pb facs="0310" n="296" sameAs="frus:frus1944v07/pg296"/>

                <note rend="inline" type="source">835.01/202: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Argentina</hi> (<hi rendition="#italic">Armour</hi>) <hi rendition="#italic"
                        >to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Buenos Aires</hi></placeName>, <date
                            calendar="gregorian" when="1944-03-08">March 8,
                        1944</date>.<lb/>[Received March 8—5:38 p.m.]</dateline>
                </opener>
                <p>675. Foreign Office announces that Paraguayan Ambassador informed Acting Minister
                    of Foreign Affairs<anchor n="82" xml:id="d256-f1"/> this morning that relations
                    of his Government with Argentine Government were continuing without interruption
                    since there was no reason to consider that they had ever been suspended.</p>
                <p>Repeated to Asunción.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Armour</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d256-f1" n="82" xml:id="d256-f1-content">
                <p>Gen. Diego I. Mason.</p>
            </note>
        </listAnnotation>
    </standOff>
