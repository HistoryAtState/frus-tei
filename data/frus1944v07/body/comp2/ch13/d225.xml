            <div xml:id="d225">

                <pb facs="0279" n="265" sameAs="frus:frus1944v07/pg265"/>

                <note rend="inline" type="source">800.20235/431c: Airgram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Argentina</hi> (<hi rendition="#italic"
                            >Armour</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-03-27T14:45:00-04:00">March 27,
                            1944—2:45 p.m.</date>
                    </dateline>
                </opener>
                <p>A–293. The following circular airgram has been sent to all the other American
                    Republics and is being transmitted solely for your information:</p>
                <p>[Here follows text of circular airgram of March 21, 1944, 7:30 p.m., printed on
                        <ref target="#pg301">page 301</ref>.]</p>
                <p>Repeated to LaPaz, Asunción, and Santiago.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
