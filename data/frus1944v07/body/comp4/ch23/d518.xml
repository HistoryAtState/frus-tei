                    <hi rendition="#italic">Post</hi>, <ref target="#pg567">p. 567</ref>.</p>
            </note>
            <note corresp="#d518-f3" n="25" xml:id="d518-f3-content">
                <p>Gen. Robert L. Walsh.</p>
            </note>
        </listAnnotation>
